

_platform = "poll"

detect_platform: str = ()
  f = io.popen("uname -s 2>/dev/null", "r")
  if f != nil
    out = f:read("*a")
    f:close()
    if out != nil
      if out:find("Darwin") != nil
        return "kqueue"
      if out:find("Linux") != nil
        return "inotify"
  "poll"

_platform = detect_platform()


EVFILT_VNODE = 0 - 4

EV_ADD = 1
EV_DELETE = 2
EV_ENABLE = 4
EV_DISABLE = 8
EV_ONESHOT = 16
EV_CLEAR = 32

NOTE_DELETE = 1
NOTE_WRITE = 2
NOTE_EXTEND = 4
NOTE_ATTRIB = 8
NOTE_LINK = 16
NOTE_RENAME = 32
NOTE_REVOKE = 64

O_RDONLY = 0


IN_ACCESS = 1
IN_MODIFY = 2
IN_ATTRIB = 4
IN_CLOSE_WRITE = 8
IN_CLOSE_NOWRITE = 16
IN_OPEN = 32
IN_MOVED_FROM = 64
IN_MOVED_TO = 128
IN_CREATE = 256
IN_DELETE = 512
IN_DELETE_SELF = 1024
IN_MOVE_SELF = 2048
IN_UNMOUNT = 8192
IN_Q_OVERFLOW = 16384
IN_IGNORED = 32768
IN_ALL_EVENTS = 4095
IN_CLOEXEC = 524288
IN_NONBLOCK = 16384

IN_INIT_CLOEXEC = 524288
IN_INIT_NONBLOCK = 16384


@ffi("kqueue")
ffi_kqueue: i64 = ()
  void
@ffi("kevent")
ffi_kevent: i64 = (kq: i64, changelist: any, nchanges: i64, eventlist: any, nevents: i64, timeout: any)
  void
@ffi("open")
ffi_open: i64 = (path: str, flags: i64)
  void
@ffi("close")
ffi_close: i64 = (fd: i64)
  void

@ffi("inotify_init1")
ffi_inotify_init1: i64 = (flags: i64)
  void
@ffi("inotify_add_watch")
ffi_inotify_add_watch: i64 = (fd: i64, path: str, mask: i64)
  void
@ffi("inotify_rm_watch")
ffi_inotify_rm_watch: i64 = (fd: i64, wd: i64)
  void
@ffi("read")
ffi_read: i64 = (fd: i64, buf: any, count: i64)
  void

@ffi("malloc")
ffi_malloc: any = (size: i64)
  void
@ffi("free")
ffi_free: void = (ptr: any)
  void
@ffi("memset")
ffi_memset: void = (ptr: any, val: i64, size: i64)
  void
@ffi("memcpy")
ffi_memcpy: void = (dst: any, src: any, size: i64)
  void


flags_from_mask: int = (mask: str)
  if mask == nil or mask == ""
    return 0
  result = 0
  rest = mask
  while true
    pos = rest:find("|", 1, true)
    token
    if pos == nil
      token = rest
      rest = ""
    else
      token = rest:sub(1, pos - 1)
      rest = rest:sub(pos + 1)
    token = token:gsub("^%s+", "")
    token = token:gsub("%s+$", "")
    if _platform == "kqueue"
      if token == "delete"
        result = result | NOTE_DELETE
      else(token == "write")
        result = result | NOTE_WRITE
      else(token == "extend")
        result = result | NOTE_EXTEND
      else(token == "attrib")
        result = result | NOTE_ATTRIB
      else(token == "link")
        result = result | NOTE_LINK
      else(token == "rename")
        result = result | NOTE_RENAME
      else(token == "revoke")
        result = result | NOTE_REVOKE
      else(token == "all")
        result = result | NOTE_DELETE | NOTE_WRITE | NOTE_EXTEND | NOTE_ATTRIB | NOTE_LINK | NOTE_RENAME | NOTE_REVOKE
    else(_platform == "inotify")
      if token == "access"
        result = result | IN_ACCESS
      else(token == "modify" or token == "write")
        result = result | IN_MODIFY
      else(token == "attrib")
        result = result | IN_ATTRIB
      else(token == "close_write")
        result = result | IN_CLOSE_WRITE
      else(token == "close_nowrite")
        result = result | IN_CLOSE_NOWRITE
      else(token == "open")
        result = result | IN_OPEN
      else(token == "moved_from")
        result = result | IN_MOVED_FROM
      else(token == "moved_to")
        result = result | IN_MOVED_TO
      else(token == "create")
        result = result | IN_CREATE
      else(token == "delete")
        result = result | IN_DELETE
      else(token == "delete_self")
        result = result | IN_DELETE_SELF
      else(token == "move_self" or token == "rename")
        result = result | IN_MOVE_SELF
      else(token == "all")
        result = result | IN_ALL_EVENTS
    else
      if token == "write" or token == "delete" or token == "rename" or token == "attrib" or token == "all"
        result = result | 1
    if rest == ""
      break
  result



KEVENT_SIZE = 32

write_u16: void = (buf: any, offset: int, val: int)
  b0 = val & 255
  b1 = val >> 8 & 255
  ptr = buf
  tmp = ffi_malloc(2)
  if tmp != nil
    ffi_memset(tmp, 0, 2)
    s = b0:char(b1)
    ffi_memcpy(tmp, s, 2)
    ffi_memcpy(ptr + offset, tmp, 2)
    ffi_free(tmp)

write_u32: void = (buf: any, offset: int, val: int)
  b0 = val & 255
  b1 = val >> 8 & 255
  b2 = val >> 16 & 255
  b3 = val >> 24 & 255
  s = b0:char(b1, b2, b3)
  ffi_memcpy(buf + offset, s, 4)

write_u64: void = (buf: any, offset: int, val: int)
  bytes = {}
  v = val
  if v < 0
    for i = 0, 7
      byte_val = v >> (i * 8) & 255
      bytes[i + 1] = byte_val:char()
  else
    for i = 0, 7
      byte_val = v >> (i * 8) & 255
      bytes[i + 1] = byte_val:char()
  s = bytes:concat()
  ffi_memcpy(buf + offset, s, 8)

read_u32: int = (buf: any, offset: int)
  0

build_kevent: any = (ident: int, filter: int, flags: int, fflags: int)
  buf = ffi_malloc(KEVENT_SIZE)
  if buf == nil
    return nil
  ffi_memset(buf, 0, KEVENT_SIZE)
  write_u64(buf, 0, ident)
  write_u16(buf, 8, filter)
  write_u16(buf, 10, flags)
  write_u32(buf, 12, fflags)
  buf

create: int = ()
  if _platform == "kqueue"
    kq = ffi_kqueue()
    if kq < 0
      return -1
    return kq
  else(_platform == "inotify")
    fd = ffi_inotify_init1(IN_INIT_CLOEXEC)
    if fd < 0
      return -1
    return fd
  else
    return 0

add_watch: int = (kq: int, path: str, mask: int)
  if _platform == "kqueue"
    fd = ffi_open(path, O_RDONLY)
    if fd < 0
      return -1
    change = build_kevent(fd, EVFILT_VNODE, EV_ADD | EV_CLEAR, mask)
    if change == nil
      ffi_close(fd)
      return -1
    ret = ffi_kevent(kq, change, 1, nil, 0, nil)
    ffi_free(change)
    if ret < 0
      ffi_close(fd)
      return -1
    return fd
  else(_platform == "inotify")
    wd = ffi_inotify_add_watch(kq, path, mask)
    if wd < 0
      return -1
    return wd
  else
    return 0

remove_watch: void = (kq: int, fd: int)
  if _platform == "kqueue"
    change = build_kevent(fd, EVFILT_VNODE, EV_DELETE, 0)
    if change != nil
      ffi_kevent(kq, change, 1, nil, 0, nil)
      ffi_free(change)
    ffi_close(fd)
  else(_platform == "inotify")
    ffi_inotify_rm_watch(kq, fd)

poll: any = (kq: int, timeout_ms: int)
  if _platform == "kqueue"
    max_events = 16
    eventlist = ffi_malloc(KEVENT_SIZE * max_events)
    if eventlist == nil
      return nil
    ffi_memset(eventlist, 0, KEVENT_SIZE * max_events)

    ts = ffi_malloc(16)
    if ts == nil
      ffi_free(eventlist)
      return nil
    ffi_memset(ts, 0, 16)
    sec = 0
    if timeout_ms > 0
      sec = timeout_ms / 1000
      nsec = timeout_ms % 1000 * 1000000
      write_u64(ts, 0, sec)
      write_u64(ts, 8, nsec)

    timeout_ptr = ts
    if timeout_ms == 0
      timeout_ptr = nil

    n = ffi_kevent(kq, nil, 0, eventlist, max_events, timeout_ptr)
    ffi_free(ts)

    if n <= 0
      ffi_free(eventlist)
      return nil

    events = {}
    for i = 0, n - 1
      offset = i * KEVENT_SIZE
      tmp = "0":rep(KEVENT_SIZE)
      ffi_memcpy(tmp, eventlist + offset, KEVENT_SIZE)

      ident = 0
      for b = 0, 7
        byte_val = tmp:byte(b + 1)
        ident = ident | byte_val << (b * 8)

      fflags = 0
      for b = 0, 3
        byte_val = tmp:byte(12 + b + 1)
        fflags = fflags | byte_val << (b * 8)

      events[events:len() + 1] = { fd = ident, flags = fflags }
    ffi_free(eventlist)
    return events
  else(_platform == "inotify")


    buf_size = 4096
    buf = ffi_malloc(buf_size)
    if buf == nil
      return nil
    ffi_memset(buf, 0, buf_size)

    n = ffi_read(kq, buf, buf_size)
    if n <= 0
      ffi_free(buf)
      return nil

    data = "0":rep(n)
    ffi_memcpy(data, buf, n)
    ffi_free(buf)

    events = {}
    pos = 1
    while pos <= n
      if pos + 15 > n
        break

      wd = 0
      for b = 0, 3
        wd = wd | data:byte(pos + b) << (b * 8)

      mask = 0
      for b = 0, 3
        mask = mask | data:byte(pos + 4 + b) << (b * 8)

      name_len = 0
      for b = 0, 3
        name_len = name_len | data:byte(pos + 12 + b) << (b * 8)

      if wd > 0
        events[events:len() + 1] = { fd = wd, flags = mask }

      pos = pos + 16 + name_len

    if events:len() == 0
      return nil
    return events
  else

    return nil

close: void = (kq: int)
  if _platform == "kqueue"
    ffi_close(kq)
  else(_platform == "inotify")
    ffi_close(kq)


get_mtime: str = (path: str)
  if path == nil
    return ""
  f = io.popen("stat -f%m '" .. path:gsub("'", "'\\''") .. "' 2>/dev/null", "r")
  if f == nil
    f = io.popen("stat -c %Y '" .. path:gsub("'", "'\\''") .. "' 2>/dev/null", "r")
    if f == nil
      return ""
  out = f:read("*a")
  f:close()
  if out == nil
    return ""
  out = out:gsub("%s+$", "")
  out = out:gsub("^%s+", "")
  out

poll_watch: void = (path: str, callback: any, interval_ms: int)
  if path == nil
    return
  if callback == nil
    return
  if interval_ms == nil or interval_ms <= 0
    interval_ms = 1000

  last_mtime = get_mtime(path)
  last_exists = last_mtime != ""

  while true
    sec = interval_ms / 1000.0
    os.execute("sleep " .. sec:to(str))

    cur_mtime = get_mtime(path)
    cur_exists = cur_mtime != ""

    if cur_exists and last_exists
      if cur_mtime != last_mtime
        cont = callback({ path = path, event = "modified" })
        if cont == false
          return
        last_mtime = cur_mtime
    else(cur_exists and not last_exists)
      cont = callback({ path = path, event = "created" })
      if cont == false
        return
      last_mtime = cur_mtime
    else(not cur_exists and last_exists)
      cont = callback({ path = path, event = "deleted" })
      if cont == false
        return
      last_mtime = ""

    last_exists = cur_exists


platform: str = ()
  _platform
