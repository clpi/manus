# fn — functional programming utilities
# Higher-order functions and data transformations.
# Note: closure-returning combinators are not supported by the compiler;
# this module focuses on functions that compose without creating new closures.

# identity: return its argument unchanged.
identity: any = (x: any)
  x

# constant: return the value (for use as a function body).
constant: any = (v: any)
  v

# noop: a function that does nothing.
noop: void = {}

# foldl: left fold over a list.
foldl: any = (list: any, init: any, fn_ref: any)
  acc = init
  if list == nil
    return acc
  i = 1
  while i <= list:len()
    acc = fn_ref(acc, list[i])
    i = i + 1
  acc

# foldr: right fold over a list.
foldr: any = (list: any, init: any, fn_ref: any)
  acc = init
  if list == nil
    return acc
  i = list:len()
  while i >= 1
    acc = fn_ref(list[i], acc)
    i = i - 1
  acc

# map_filter: apply fn and keep only non-nil results.
map_filter: any = (list: any, fn_ref: any)
  out = {}
  if list == nil
    return out
  i = 1
  while i <= list:len()
    result = fn_ref(list[i])
    if result != nil
      out[out:len() + 1] = result
    i = i + 1
  out

# group_by: partition list into groups keyed by fn's return value.
group_by: any = (list: any, fn_ref: any)
  groups = {}
  if list == nil
    return groups
  i = 1
  while i <= list:len()
    key = fn_ref(list[i])
    if groups[key] == nil
      groups[key] = {}
    groups[key](groups[key]:len() + 1) = list[i]
    i = i + 1
  groups

# unique_by: deduplicate list by fn's return value (first occurrence wins).
unique_by: any = (list: any, fn_ref: any)
  seen = {}
  out = {}
  if list == nil
    return out
  i = 1
  while i <= list:len()
    key = fn_ref(list[i])
    if seen[key] == nil
      seen[key] = true
      out[out:len() + 1] = list[i]
    i = i + 1
  out

# take_while: take elements from the front while predicate holds.
take_while: any = (list: any, fn_ref: any)
  out = {}
  if list == nil
    return out
  i = 1
  while i <= list:len()
    if not fn_ref(list[i])
      break
    out[out:len() + 1] = list[i]
    i = i + 1
  out

# drop_while: drop elements from the front while predicate holds.
drop_while: any = (list: any, fn_ref: any)
  out = {}
  if list == nil
    return out
  dropping = true
  i = 1
  while i <= list:len()
    if dropping and fn_ref(list[i])
    else
      # skip
      dropping = false
      out[out:len() + 1] = list[i]
    i = i + 1
  out

# chunk: split list into sub-lists of size n.
chunk: any = (list: any, n: i64)
  out = {}
  if list == nil or n == nil or n < 1
    return out
  i = 1
  while i <= list:len()
    group = {}
    j = 0
    while j < n and i + j <= list:len()
      group[group:len() + 1] = list[i + j]
      j = j + 1
    out[out:len() + 1] = group
    i = i + n
  out

# interleave: weave elements from two lists alternately.
interleave: any = (a: any, b: any)
  out = {}
  if a == nil
    a = {}
  if b == nil
    b = {}
  n = a:len()
  if b:len() > n
    n = b:len()
  i = 1
  while i <= n
    if i <= a:len()
      out[out:len() + 1] = a[i]
    if i <= b:len()
      out[out:len() + 1] = b[i]
    i = i + 1
  out

# transpose: transpose a list of lists (rows to columns).
transpose: any = (matrix: any)
  if matrix == nil or matrix:len() == 0
    return {}
  cols = matrix[1]:len()
  out = {}
  c = 1
  while c <= cols
    col = {}
    r = 1
    while r <= matrix:len()
      if matrix[r] != nil and matrix[r]:len() >= c
        col[col:len() + 1] = matrix[r](c)
      r = r + 1
    out[out:len() + 1] = col
    c = c + 1
  out

# count_by: count elements grouped by fn's return value.
count_by: any = (list: any, fn_ref: any)
  counts = {}
  if list == nil
    return counts
  i = 1
  while i <= list:len()
    key = fn_ref(list[i])
    if counts[key] == nil
      counts[key] = 0
    counts[key] = counts[key] + 1
    i = i + 1
  counts

# flatten: flatten a list of lists one level deep.
flatten: any = (list: any)
  out = {}
  if list == nil
    return out
  i = 1
  while i <= list:len()
    item = list[i]
    if type(item) == "table"
      j = 1
      while j <= item:len()
        out[out:len() + 1] = item[j]
        j = j + 1
    else
      out[out:len() + 1] = item
    i = i + 1
  out

# partition: split list into {matching, non_matching} by predicate.
partition: any = (list: any, fn_ref: any)
  yes = {}
  no = {}
  if list == nil
    return { yes, no }
  i = 1
  while i <= list:len()
    if fn_ref(list[i])
      yes[yes:len() + 1] = list[i]
    else
      no[no:len() + 1] = list[i]
    i = i + 1
  out = {}
  out[1] = yes
  out[2] = no
  out

# min_by: find the element that minimizes fn's return value.
min_by: any = (list: any, fn_ref: any)
  if list == nil or list:len() == 0
    return nil
  best = list[1]
  best_val = fn_ref(best)
  i = 2
  while i <= list:len()
    val = fn_ref(list[i])
    if val < best_val
      best = list[i]
      best_val = val
    i = i + 1
  best

# max_by: find the element that maximizes fn's return value.
max_by: any = (list: any, fn_ref: any)
  if list == nil or list:len() == 0
    return nil
  best = list[1]
  best_val = fn_ref(best)
  i = 2
  while i <= list:len()
    val = fn_ref(list[i])
    if val > best_val
      best = list[i]
      best_val = val
    i = i + 1
  best

# sort_by: sort list by fn's return value.
# Bubble sort to avoid closure capture issues in the codegen.
sort_by = (list: any, fn_ref: any)
  if list == nil
    return
  n = list:len()
  i = 1
  while i < n
    j = 1
    while j <= n - i
      a = fn_ref(list[j])
      b = fn_ref(list[j + 1])
      if a > b
        duostage0 = j + 1
        duostage1 = list[j + 1]
        duostage2 = list[j]
        list[j] = duostage1
        list[duostage0] = duostage2

      j = j + 1
    i = i + 1

# GAP: pipe/pipe3/negate/curry2 cannot be expressed in Duo today.
# Each needs a returned lambda to CAPTURE the enclosing function's parameters
# (f1/f2/fn_ref) and then CALL them. Two independent compiler gaps block that:
#   1. a lambda does not capture an enclosing PARAMETER # the generated C says
#      "use of undeclared identifier 'f2'";
#   2. a function arriving as a parameter is not callable at all.
# They were also written as NESTED BARE DECLARATIONS, which do not parse (GR-001
# is file-scope), and pipe/pipe3 both named their inner function `composed`,
# which collides at module scope ("redefinition of std_fn__composed__lua").
#
# Why they are stubbed rather than left as they were: while they failed to
# PARSE, `emit_embedded_module` failed for the whole file, so std.fn was
# unusable # and std.iter and std.go, which require it, were down purely as
# collateral. Three modules were unreachable to protect four functions that
# could not run under any spelling. They return nil until the capture gap
# closes, so the rest of the module is reachable.
pipe: any = (f1: any, f2: any)
  nil

pipe3: any = (f1: any, f2: any, f3: any)
  nil

negate: any = (fn_ref: any)
  nil

curry2: any = (fn_ref: any)
  nil

# clamp: clamp value between min and max.
clamp: any = (v: any, lo: any, hi: any)
  if v < lo
    return lo
  if v > hi
    return hi
  v
