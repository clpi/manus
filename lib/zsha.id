wordbytes: str = (v: i64)
  string.char(v >> 24 & 255) .. string.char(v >> 16 & 255) .. string.char(v >> 8 & 255) .. string.char(v & 255)

shahash: str = (s: str)
  if s == nil
    s = ""
  K = {
    1116352408,
    1899447441,
    3049323471,
    3921009573,
    961987163,
    1508970993,
    2453635748,
    2870763221,
    3624381080,
    310598401,
    607225278,
    1426881987,
    1925078388,
    2162078206,
    2614888103,
    3248222580,
    3835390401,
    4022224774,
    264347078,
    604807628,
    770255983,
    1249150122,
    1555081692,
    1996064986,
    2554220882,
    2821834349,
    2952996808,
    3210313671,
    3336571891,
    3584528711,
    113926993,
    338241895,
    666307205,
    773529912,
    1294757372,
    1396182291,
    1695183700,
    1986661051,
    2177026350,
    2456956037,
    2730485921,
    2820302411,
    3259730800,
    3345764771,
    3516065817,
    3600352804,
    4094571909,
    275423344,
    430227734,
    506948616,
    659060556,
    883997877,
    958139571,
    1322822218,
    1537002063,
    1747873779,
    1955562222,
    2024104815,
    2227730452,
    2361852424,
    2428436474,
    2756734187,
    3204031479,
    3329325298
  }
  msg = s .. string.char(128)
  while msg:len() % 64 != 56
    msg = msg .. string.char(0)
  bits = s:len() * 8
  msg = msg .. string.char(0) .. string.char(0) .. string.char(0)
  msg = msg .. string.char(bits / 16777216 % 256) .. string.char(bits / 65536 % 256) .. string.char(bits / 256 % 256) .. string.char(bits % 256)
  hv0 = 1779033703
  hv1 = 3144134277
  hv2 = 1013904242
  hv3 = 2773480762
  hv4 = 1359893119
  hv5 = 2600822924
  hv6 = 528734635
  hv7 = 1541459225
  block = 0
  blocks = msg:len() / 64
  while block < blocks
    w = {}
    j = 0
    while j < 16
      off = block * 64 + j * 4 + 1
      w[j + 1] = msg:byte(off) * 16777216 + msg:byte(off + 1) * 65536 + msg:byte(off + 2) * 256 + msg:byte(off + 3)
      w[j + 1] = w[j + 1] % 2 ^ 32
      j = j + 1
    j = 16
    while j < 64
      wt = w[j - 14 + 1]
      s0 = (wt >> 7 | wt << 25) % 2 ^ 32 ~ (wt >> 18 | wt << 14) % 2 ^ 32 ~ wt >> 3
      wt2 = w[j - 15 + 1]
      s1 = (wt2 >> 17 | wt2 << 15) % 2 ^ 32 ~ (wt2 >> 19 | wt2 << 13) % 2 ^ 32 ~ wt2 >> 10
      w[j + 1] = (w[j + 1] + s0 + w[j - 7 + 1] + s1) % 2 ^ 32
      j = j + 1
    a = hv0
    b = hv1
    c = hv2
    d = hv3
    e = hv4
    f = hv5
    g = hv6
    h = hv7
    j = 0
    while j < 64
      S1 = (e >> 6 | e << 26) % 2 ^ 32 ~ (e >> 11 | e << 21) % 2 ^ 32 ~ (e >> 25 | e << 7) % 2 ^ 32
      ch = e & f | ~e & g
      temp1 = (h + S1 + ch + K(j + 1) + w[j + 1]) % 2 ^ 32
      S0 = (a >> 2 | a << 30) % 2 ^ 32 ~ (a >> 13 | a << 19) % 2 ^ 32 ~ (a >> 22 | a << 10) % 2 ^ 32
      maj = a & b | a & c | b & c
      temp2 = (S0 + maj) % 2 ^ 32
      h = g
      g = f
      f = e
      e = (d + temp1) % 2 ^ 32
      d = c
      c = b
      b = a
      a = (temp1 + temp2) % 2 ^ 32
      j = j + 1
    hv0 = (hv0 + a) % 2 ^ 32
    hv1 = (hv1 + b) % 2 ^ 32
    hv2 = (hv2 + c) % 2 ^ 32
    hv3 = (hv3 + d) % 2 ^ 32
    hv4 = (hv4 + e) % 2 ^ 32
    hv5 = (hv5 + f) % 2 ^ 32
    hv6 = (hv6 + g) % 2 ^ 32
    hv7 = (hv7 + h) % 2 ^ 32
    block = block + 1
  wordbytes(hv0) .. wordbytes(hv1) .. wordbytes(hv2) .. wordbytes(hv3) .. wordbytes(hv4) .. wordbytes(hv5) .. wordbytes(hv6) .. wordbytes(hv7)
hexdigit: str = (v: i64)
  digits = "0123456789abcdef"
  digits:sub(v + 1, v + 1)

hexpair: str = (v: i64)
  hexdigit(v >> 4) .. hexdigit(v & 15)


main: i64 = ()
  h = shahash("abc")
  i = 1
  while i <= 32
    stdout:write(hexpair(h:byte(i)))
    i = i + 1
  stdout:write("\n")
  0
