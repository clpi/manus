# std.toml — TOML parser with section support

parse_value(s: str): any
    if s == nil return nil end
    if s:len() >= 2 and s:sub(1, 1) == '"' and s:sub(s:len(), s:len()) == '"'
        return s:sub(2, s:len() - 1)
    end
    if s == "true" return true end
    if s == "false" return false end
    num = tonumber(s)
    if num != nil return num end
    s
end

parse(data: str): any
    if data == nil return {} end
    res = {}
    current = res
    current_path = {}
    lines = data:split("\n")
    for _, line in lines
        line = line:trim()
        if line:len() > 0 and line:sub(1, 1) != "#"
            if line:sub(1, 1) == "["
                section_name = line:sub(2, line:len() - 1)
                section_name = section_name:trim()
                current = res
                current_path = {}
                parts = section_name:split(".")
                for _, part in parts
                    part = part:trim()
                    if current[part] == nil
                        current[part] = {}
                    end
                    current_path[current_path:len() + 1] = part
                    current = current[part]
                end
            else
                eq_pos = nil
                for j = 1, line:len()
                    if line:byte(j) == 61
                        eq_pos = j
                        break
                    end
                end
                if eq_pos != nil
                    key = line:sub(1, eq_pos - 1):trim()
                    val_str = line:sub(eq_pos + 1):trim()
                    current[key] = parse_value(val_str)
                end
            end
        end
    end
    res
end

