# index/suffix/array — suffix array for substring search
# Home topology: index/suffix/array.id projects the array table for suffix search.

build: any = (data: str)
    if data == nil return {data = "", sa = {}} 
    n = data:len()
    sa = {}
    for i = 1, n
        sa[i] = i
    # Sort suffixes using insertion sort (simple, adequate for small-medium data)
    for i = 1, n
        j = i
        while j > 1
            a = data:sub(sa[j - 1])
            b = data:sub(sa[j])
            if a <= b break 
            sa[j - 1], sa[j] = sa[j], sa[j - 1]
            j -= 1
    {data = data, sa = sa}

lookup: any = (store: any, pattern: str)
    data = store.data
    sa = store.sa
    n = data:len()
    plen = pattern:len()
    if plen == 0 or n == 0 return {} 
    results = {}
    # Binary search for first occurrence
    lo = 1
    hi = n
    while lo <= hi
        mid = (lo + hi) / 2:floor()
        suffix = data:sub(sa[mid])
        cmp = 0
        if suffix:len() < plen
            if suffix < pattern
                cmp = -1
            else
                cmp = 1
        else
            prefix = suffix:sub(1, plen)
            if prefix < pattern
                cmp = -1
            elseif prefix > pattern
                cmp = 1
        if cmp < 0
            lo = mid + 1
        else
            hi = mid - 1
    start = lo
    hi = n
    while lo <= hi
        mid = (lo + hi) / 2:floor()
        suffix = data:sub(sa[mid])
        cmp = 0
        if suffix:len() < plen
            if suffix > pattern
                cmp = 1
            else
                cmp = -1
        else
            prefix = suffix:sub(1, plen)
            if prefix > pattern
                cmp = 1
            elseif prefix < pattern
                cmp = -1
        if cmp <= 0
            lo = mid + 1
        else
            hi = mid - 1
    endpos = lo - 1
    for i = start, endpos
        results[results:len() + 1] = sa[i] - 1
    results

findall: any = (store: any, pattern: str)
    lookup(store, pattern)

contains: bool = (store: any, pattern: str)
    lookup(store, pattern):len() > 0
