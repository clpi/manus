# argparse — Command-line argument parser

argparse_key(s: str): str
    s or "":gsub("^%-+", "")
end

add_positional(parser, name: str, help: str, options: any)
    parser.positionals[parser:len().positionals + 1] = {
        name = name,
        help = help or "",
        required = options and options.required,
    }
end

add_flag(parser, short_or_long: str, long_or_help: str, help: str)
    short_opt = nil
    long_opt = nil
    desc = help
    if long_or_help and long_or_help:sub(1, 1) == "-"
        short_opt = short_or_long
        long_opt = long_or_help
    else
        long_opt = short_or_long
        desc = long_or_help
    end
    parser.flags[parser:len().flags + 1] = {
        key = argparse_key(long_opt or short_opt),
        short = short_opt,
        long = long_opt,
        help = desc or "",
    }
end

add_option(parser, short_or_long: str, long_or_help: str, help: str)
    short_opt = nil
    long_opt = nil
    desc = help
    if long_or_help and long_or_help:sub(1, 1) == "-"
        short_opt = short_or_long
        long_opt = long_or_help
    else
        long_opt = short_or_long
        desc = long_or_help
    end
    parser.options[parser:len().options + 1] = {
        key = argparse_key(long_opt or short_opt),
        short = short_opt,
        long = long_opt,
        help = desc or "",
    }
end

parse_with(parser, args: any): any
    if args == nil args = {} end
    opts = { rest_args = {} }
    positional_idx = 1
    i = 1
    stop_options = false

    while i <= args:len()
        v = args[i]
        if v == "--" and not stop_options
            stop_options = true
            i += 1
        elseif not stop_options and v:sub(1, 2) == "--"
            name = v:sub(3)
            eq = name:find("=")
            if eq
                key = name:sub(1, eq - 1)
                val = name:sub(eq + 1)
                opts[key] = val
                i += 1
            else
                matched = false
                for _, opt in parser.options
                    if opt.long == v
                        if i + 1 <= args:len() and args[i + 1]:sub(1, 1) != "-"
                            opts[opt.key] = args[i + 1]
                            i += 2
                        else
                            opts[opt.key] = nil
                            i += 1
                        end
                        matched = true
                        break
                    end
                end
                if not matched
                    for _, fl in parser.flags
                        if fl.long == v
                            opts[fl.key] = true
                            matched = true
                            i += 1
                            break
                        end
                    end
                end
                if not matched
                    opts[name] = true
                    i += 1
                end
            end
        elseif not stop_options and v:sub(1, 1) == "-" and v:len() > 1
            name = v:sub(2, 2)
            rest = v:sub(3)
            short_opt = "-" .. name
            matched = false
            for _, opt in parser.options
                if opt.short == short_opt
                    if rest:len() > 0
                        opts[opt.key] = rest
                        i += 1
                    elseif i + 1 <= args:len() and args[i + 1]:sub(1, 1) != "-"
                        opts[opt.key] = args[i + 1]
                        i += 2
                    else
                        opts[opt.key] = nil
                        i += 1
                    end
                    matched = true
                    break
                end
            end
            if not matched
                for _, fl in parser.flags
                    if fl.short == short_opt
                        opts[fl.key] = true
                        matched = true
                        i += 1
                        break
                    end
                end
            end
            if not matched
                if rest:len() > 0 and i + 1 <= args:len() and args[i + 1]:sub(1, 1) != "-"
                    opts[name] = args[i + 1]
                    i += 2
                else
                    opts[name] = true
                    i += 1
                end
            end
        else
            if positional_idx <= parser:len().positionals
                def = parser.positionals[positional_idx]
                opts[def.name] = v
                positional_idx += 1
            else
                opts.rest_args[opts:len().rest_args + 1] = v
            end
            i += 1
        end
    end

    while positional_idx <= parser:len().positionals
        def = parser.positionals[positional_idx]
        if opts[def.name] == nil
            opts[def.name] = nil
        end
        positional_idx += 1
    end

    opts
end

new(name: str, description: str): any
    parser = {
        name = name,
        description = description,
        positionals = {},
        flags = {},
        options = {},
    }
    parser
end

parse(args: any): any
    new("", "").parse(args)
end

