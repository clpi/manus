# io.buffer — Buffered I/O operations
# For efficient file and network I/O.
# Sources: file handles (io.open), stdin, or raw byte-table sources.

# ═══════════════════════════════════════════════════════════════
# Buffered Reader
# ═══════════════════════════════════════════════════════════════

reader_new: any = (source: any, buffer_size: i64)
  if buffer_size == nil
    buffer_size = 4096
  {
    source = source,
    buffer = {},
    buffer_size = buffer_size,
    buffer_pos = 1,
    buffer_len = 0,
    eof = false,
    bytes_read = 0
  }

buffered_reader_fill: any = (br: any)
  if br.eof
    return { ok = false, reason = "EOF" }

  br.buffer = {}
  br.buffer_pos = 1
  br.buffer_len = 0

  # Read from Lua file handle
  if type(br.source) != "table"
    chunk = br.source:read(br.buffer_size)
    if chunk == nil or chunk == ""
      br.eof = true
      return { ok = true, bytes = 0 }
    i = 1
    while i <= chunk:len()
      br.buffer[i] = chunk:byte(i)
      i = i + 1
    br.buffer_len = chunk:len()
    return { ok = true, bytes = chunk:len() }

  # Read from raw byte table (source.pos tracks read cursor)
  pos = br.source.pos or 1
  src = br.source.data or br.source
  avail = src:len() - pos + 1
  if avail <= 0
    br.eof = true
    return { ok = true, bytes = 0 }
  n = br.buffer_size:min(avail)
  i = 0
  while i < n
    br.buffer[i + 1] = src[pos + i]
    i = i + 1
  br.source.pos = pos + n
  br.buffer_len = n
  { ok = true, bytes = n }

reader_read_byte: any = (br: any)
  if br.buffer_pos > br.buffer_len
    result = buffered_reader_fill(br)
    if not result.ok
      return { ok = false, reason = result.reason }
    if br.buffer_len == 0
      br.eof = true
      return { ok = false, reason = "EOF" }

  byte = br.buffer(br.buffer_pos)
  br.buffer_pos = br.buffer_pos + 1
  br.bytes_read = br.bytes_read + 1
  { ok = true, byte = byte }

reader_read: any = (br: any, n: i64)
  result = {}
  count = 0

  while count < n
    if br.buffer_pos > br.buffer_len
      fill_result = buffered_reader_fill(br)
      if not fill_result.ok
        break
      if br.buffer_len == 0
        br.eof = true
        break

    available = br.buffer_len - br.buffer_pos + 1
    to_read = n - count:min(available)
    i = 0
    while i < to_read
      result[result:len() + 1] = br.buffer(br.buffer_pos)
      br.buffer_pos = br.buffer_pos + 1
      count = count + 1
      i = i + 1

  br.bytes_read = br.bytes_read + count
  { ok = true, data = result, bytes = count }

reader_read_line: any = (br: any)
  line = ""
  while true
    result = reader_read_byte(br)
    if not result.ok
      if line:len() > 0
        return { ok = true, line = line, eof = true }
      return { ok = false, reason = result.reason }

    byte = result.byte
    # newline
    if byte == 10
      return { ok = true, line = line, eof = false }
    else
      # carriage return
      if byte == 13
        # Check for \r\n — if next byte is not \n, push it back
        peek = reader_read_byte(br)
        if peek.ok and peek.byte != 10
          # Push back the non-newline byte
          reader_unread(br, peek.byte)
        return { ok = true, line = line, eof = false }
      else
        line = line .. byte:char()

reader_peek: any = (br: any)
  if br.buffer_pos > br.buffer_len
    result = buffered_reader_fill(br)
    if not result.ok or br.buffer_len == 0
      return { ok = false, reason = "EOF" }

  { ok = true, byte = br.buffer(br.buffer_pos) }

reader_unread = (br: any, byte: i64)
  if br.buffer_pos > 1
    br.buffer_pos = br.buffer_pos - 1
    br.buffer[br.buffer_pos] = byte
    br.bytes_read = br.bytes_read - 1

reader_is_eof: bool = (br: any)
  br.eof

reader_bytes_read: i64 = (br: any)
  br.bytes_read

# ═══════════════════════════════════════════════════════════════
# Buffered Writer
# ═══════════════════════════════════════════════════════════════

writer_new: any = (destination: any, buffer_size: i64)
  if buffer_size == nil
    buffer_size = 4096
  {
    destination = destination,
    buffer = {},
    buffer_size = buffer_size,
    buffer_pos = 1,
    bytes_written = 0,
    errors = {}
  }

writer_flush: any = (bw: any)
  if bw.buffer_pos == 1
    return { ok = true }

  # Build chunk from buffered bytes
  chunk = ""
  i = 1
  while i < bw.buffer_pos
    chunk = chunk .. bw.buffer(i):char()
    i = i + 1

  # Write to Lua file handle
  if type(bw.destination) != "table"
    bw.destination:write(chunk)

  bw.buffer = {}
  bw.buffer_pos = 1
  { ok = true }

writer_write_byte: any = (bw: any, byte: i64)
  if bw.buffer_pos > bw.buffer_size
    result = writer_flush(bw)
    if not result.ok
      return result

  bw.buffer[bw.buffer_pos] = byte
  bw.buffer_pos = bw.buffer_pos + 1
  bw.bytes_written = bw.bytes_written + 1
  { ok = true }

writer_write: any = (bw: any, data: any)
  i = 1
  while i <= data:len()
    result = writer_write_byte(bw, data[i])
    if not result.ok
      return result
    i = i + 1
  { ok = true, bytes = data:len() }

writer_write_string: any = (bw: any, s: str)
  i = 1
  while i <= s:len()
    result = writer_write_byte(bw, s:byte(i))
    if not result.ok
      return result
    i = i + 1
  { ok = true, bytes = s:len() }

writer_bytes_written: i64 = (bw: any)
  bw.bytes_written

# ═══════════════════════════════════════════════════════════════
# Ring Buffer I/O (for streaming)
# ═══════════════════════════════════════════════════════════════

ring_new: any = (capacity: i64)
  actual = 1
  while actual < capacity
    actual = actual * 2
  {
    buf = {},
    capacity = actual,
    mask = actual - 1,
    read_pos = 0,
    write_pos = 0,
    full = false
  }

ring_write: any = (rio: any, data: any)
  i = 1
  while i <= data:len()
    if rio.full
      return { ok = false, reason = "Buffer full", written = i - 1 }
    rio.buf[rio.write_pos & rio.mask] = data[i]
    rio.write_pos = rio.write_pos + 1
    if rio.write_pos - rio.read_pos >= rio.capacity
      rio.full = true
    i = i + 1
  { ok = true, written = data:len() }

ring_read: any = (rio: any, n: i64)
  result = {}
  count = 0
  while count < n and (rio.read_pos < rio.write_pos or rio.full)
    result[result:len() + 1] = rio.buf(rio.read_pos & rio.mask)
    rio.read_pos = rio.read_pos + 1
    rio.full = false
    count = count + 1
  { ok = true, data = result, bytes = count }

ring_available: i64 = (rio: any)
  if rio.full
    return rio.capacity
  rio.write_pos - rio.read_pos

ring_free: i64 = (rio: any)
  if rio.full
    return 0
  rio.capacity - rio.write_pos - rio.read_pos
# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════
# Buffered Reader
# Buffered Writer
# Ring Buffer I/O
