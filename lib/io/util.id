
all: str = (fh: any)
    if fh == nil return ""
    out = {}
    while true
        chunk = fh:read(4096)
        if chunk == nil break
        out[out:len() + 1] = chunk
    out:concat()

read: str = (path: str)
    if path == nil return ""
    f = io.open(path, "r")
    if f == nil return "", "file not found: " .. path
    data = all(f)
    f:close()
    return data, nil

write: any = (path: str, data: str)
    if path == nil return false, "nil path"
    if data == nil data = ""
    f = io.open(path, "w")
    if f == nil return false, "cannot open: " .. path
    f:write(data)
    f:close()
    return true, nil

append: any = (path: str, data: str)
    if path == nil return false, "nil path"
    if data == nil data = ""
    f = io.open(path, "a")
    if f == nil return false, "cannot open: " .. path
    f:write(data)
    f:close()
    return true, nil

list: any = (dir: str)
    if dir == nil return {}
    f = io.popen("ls -1 " .. dir .. " 2>/dev/null", "r")
    if f == nil return {}
    out = {}
    for line in f:lines()
        out[out:len() + 1] = line
    f:close()
    out

temp: any = ()
    rng = rand
    hex = ""
    blob = rng.bytes(8)
    i = 1
    while i <= 8
        hex = hex .. "%02x":format(blob:byte(i))
        i += 1
    path = "/tmp/duo_" .. to(str)(os.time()) .. "_" .. hex
    f = io.open(path, "w+")
    return {fh = f, path = path}

scratch: str = ()
    ""

discard: any = ()
    return {n = 0, write: any = (self: any, s: str)
        self.n = self.n + s:len()
        self
    }

wrap: any = (fh: any)
    fh.close = (self: any) nil
    fh
