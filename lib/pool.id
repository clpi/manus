clock = time
new: any = (factory: any, destroyer: any, opts: any)
  if opts == nil
    opts = {}
  {
    factory = factory,
    destroyer = destroyer,
    resources = {},
    busy = {},
    waiters = {},
    min = opts.min or 0,
    max = opts.max or 16,
    idle = opts.idle_timeout or 300,
    age = opts.max_age or 3600,
    health = opts.health_check,
    born = {},
    used = {},
    created = 0,
    destroyed = 0
  }
get: any = (p: any)
  while p.resources:len() > 0
    res = p.resources:remove()
    age = clock.now() - (p.used[res] or clock.now())
    if p.idle > 0 and age > p.idle
      destroy(p, res)
    else if has(.health)(p) and not p.health(res)
      destroy(p, res)
    else
      p.busy[res] = true
      p.used[res] = clock.now()
      return res
  total = 0
  for _ in p.busy
    total = total + 1
  total = total + p.resources:len()
  if total < p.max
    res = p.factory()
    p.created = p.created + 1
    p.born[res] = clock.now()
    p.used[res] = clock.now()
    p.busy[res] = true
    return res
  slot = {
    val = nil,
    done = false
  }
  p.waiters[p.waiters:len() + 1] = slot
  while not slot.done
    coroutine.yield()
  slot.val
put = (p: any, res: any)
  if res == nil
    return
  p.busy[res] = nil
  age = clock.now() - (p.born[res] or 0)
  if p.age > 0 and age > p.age
    destroy(p, res)
    wake(p)
    return
  if p.waiters:len() > 0
    slot = p.waiters:remove(1)
    slot.val = res
    slot.done = true
    p.busy[res] = true
    p.used[res] = clock.now()
    return
  p.resources[p.resources:len() + 1] = res
  p.used[res] = clock.now()
probe: any = (p: any)
  while p.resources:len() > 0
    res = p.resources:remove()
    age = clock.now() - (p.used[res] or clock.now())
    if p.idle > 0 and age > p.idle
      destroy(p, res)
    else if has(.health)(p) and not p.health(res)
      destroy(p, res)
    else
      p.busy[res] = true
      p.used[res] = clock.now()
      return res
  total = 0
  for _ in p.busy
    total = total + 1
  total = total + p.resources:len()
  if total < p.max
    res = p.factory()
    p.created = p.created + 1
    p.born[res] = clock.now()
    p.used[res] = clock.now()
    p.busy[res] = true
    return res
  nil
release = (p: any, res: any)
  put(p, res)
stats: any = (p: any)
  idle = 0
  for _ in p.resources
    idle = idle + 1
  active = 0
  for _ in p.busy
    active = active + 1
  waiting = p.waiters:len()
  {
    idle = idle,
    active = active,
    waiting = waiting,
    total = idle + active,
    max = p.max,
    min = p.min,
    created = p.created,
    destroyed = p.destroyed
  }
drain = (p: any)
  while p.resources:len() > 0
    destroy(p, p.resources:remove())
  i = 1
  while i <= p.waiters:len()
    p.waiters[i].done = true
    p.waiters[i].val = nil
    i = i + 1
  p.waiters = {}
resize = (p: any, cap: i64)
  p.max = cap
destroy = (p: any, res: any)
  p.destroyed = p.destroyed + 1
  p.born[res] = nil
  p.used[res] = nil
  if p.destroyer
    p.destroyer(res)
wake = (p: any)
  if p.waiters:len() == 0
    return
  slot = p.waiters:remove(1)
  res = p.factory()
  p.created = p.created + 1
  p.born[res] = clock.now()
  p.used[res] = clock.now()
  p.busy[res] = true
  slot.val = res
  slot.done = true
