

str_join: str = (parts: any, sep: str)
    result = ""
    for i, part in parts
        if i > 1
            result = result .. sep
        result = result .. part
    result


from_header: str = (header: str, opts: any)
    "/* from_header: use from_header_source() with @run at module scope */"

from_source: str = (source: str, opts: any)
    if opts == nil opts = {}
    prefix = opts.prefix or ""
    includes = opts.include or nil
    excludes = opts.excludes or {}
    exclude_set = {}
    for _, e in excludes
        exclude_set[e] = true

    functions = parse_c_declarations(source, prefix, exclude_set, includes)
    parts = {}
    for _, func in functions
        parts[parts:len() + 1] = emit_ffi_binding(func)
    str_join(parts, "\n")


parse_c_declarations: any = (source: str, prefix: str, excludes: any, includes: any)
    funcs = {}
    lines = source:split("\n")
    for _, line in lines
        line = line:gsub("^%s+", "")
        line = line:gsub("%s+$", "")
        if line:sub(1, 1) != "#"
           and line:sub(1, 2) != "//"
           and not line:match("^typedef")
           and not line:match("^struct ")
           and not line:match("^enum ")
           and not line:match("^union ")
           and not line:match("^#")
            ret_type, name, params = line:match("^(%S+)%s+(%w+)%s*%((.-)%)%s*;")
            if ret_type and name
                if prefix == "" or name:sub(1, prefix:len()) == prefix
                    if not excludes[name]
                        include_match = true
                        if includes
                            include_match = false
                            for _, inc in includes
                                if name:sub(1, inc:len()) == inc
                                    include_match = true
                                    break
                        if include_match
                            funcs[funcs:len() + 1] = {
                                name = name,
                                ret_type = ret_type,
                                params = parse_c_params(params),
                            }
    funcs

parse_c_params: any = (params_str: str)
    if params_str == "void" or params_str == "" return {}
    params = {}
    parts = params_str:split(",")
    for _, part in parts
        part = part:gsub("^%s+", "")
        part = part:gsub("%s+$", "")
        tokens = {}
        for token in part:gmatch("%S+")
            tokens[tokens:len() + 1] = token
        if tokens:len() >= 2
            name = tokens[tokens:len()]
            type_parts = {}
            for j = 1, tokens:len() - 1
                type_parts[type_parts:len() + 1] = tokens[j]
            typ = str_join(type_parts, " ")
            params[params:len() + 1] = {
                c_type = typ,
                name = name,
                is_pointer = typ:find("*") != nil,
                is_const = typ:find("const") != nil,
            }
        else(tokens:len() == 1)
            params[params:len() + 1] = {
                c_type = tokens[1],
                name = "arg" .. to(str)(params:len() + 1),
                is_pointer = false,
                is_const = false,
            }
    params


c_type_to_duo: str = (c_type: str, is_pointer: bool)
    base = c_type:gsub("%*", "")
    base = base:gsub("const ", "")
    base = base:gsub("^%s+", "")
    base = base:gsub("%s+$", "")

    if is_pointer
        if base == "char" return "str"
        if base == "void" return "any"
        return "any"

    type_map = {
        ["int"] = "i64", ["unsigned int"] = "i64", ["long"] = "i64",
        ["long long"] = "i64", ["unsigned long"] = "i64", ["unsigned long long"] = "i64",
        ["short"] = "i64", ["unsigned short"] = "i64",
        ["char"] = "i64", ["unsigned char"] = "i64",
        ["int8_t"] = "i64", ["int16_t"] = "i64", ["int32_t"] = "i64", ["int64_t"] = "i64",
        ["uint8_t"] = "i64", ["uint16_t"] = "i64", ["uint32_t"] = "i64", ["uint64_t"] = "i64",
        ["size_t"] = "i64", ["float"] = "f64", ["double"] = "f64",
        ["long double"] = "f64", ["_Bool"] = "bool", ["bool"] = "bool", ["void"] = "void",
    }
    type_map[base] or "any"

c_ret_type_to_duo: str = (c_type: str)
    cleaned = c_type:gsub("^%s+", "")
    cleaned = cleaned:gsub("%s+$", "")
    if cleaned == "void" return "void"
    if cleaned:find("*") return "any"
    c_type_to_duo(cleaned, false)


emit_ffi_binding: str = (func: any)
    duo_params = {}
    for _, p in func.params
        duo_type = c_type_to_duo(p.c_type, p.is_pointer)
        duo_params[duo_params:len() + 1] = p.name .. ": " .. duo_type
    duo_ret = c_ret_type_to_duo(func.ret_type)
    params_str = duo_params:len() > 0 and str_join(duo_params, ", ") or ""

    call_args = build_c_call_args(func.params)
    sig = "@ffi(\"" .. func.name .. "\")\nfun " .. func.name:lower() .. "(" .. params_str .. "): " .. duo_ret
    body = "    @comp.c.call(\"" .. func.name .. "\"" .. (func.params:len() > 0 and ", " or "") .. call_args .. ")"
    sig .. "\n" .. body .. "\nend"

build_c_call_args: str = (params: any)
    args = {}
    for _, p in params
        args[args:len() + 1] = p.name
    str_join(args, ", ")


bind_sqlite: str = ()
    from_header("sqlite3.h", {
        prefix = "sqlite3_",
        excludes = {"sqlite3_aggregate_context", "sqlite3_set_auxdata"},
    })

bind_cjson: str = ()
    from_header("cJSON.h", {})

bind_sdl2: str = ()
    from_header("SDL2/SDL.h", {
        prefix = "SDL_",
        excludes = {"SDL_main", "SDL_malloc", "SDL_calloc", "SDL_realloc", "SDL_free"},
    })

bind_opengl: str = ()
    from_header("GL/gl.h", {})

M = {
    from_header = from_header,
    from_source = from_source,
    parse_c_declarations = parse_c_declarations,
    parse_c_params = parse_c_params,
    c_type_to_duo = c_type_to_duo,
    c_ret_type_to_duo = c_ret_type_to_duo,
    emit_ffi_binding = emit_ffi_binding,
    bind_sqlite = bind_sqlite,
    bind_cjson = bind_cjson,
    bind_sdl2 = bind_sdl2,
    bind_opengl = bind_opengl,
    str_join = str_join,
}
M
