# std.atomic — atomic operations on table-backed memory
# Uses compare swap for CAS-based mutexes and hardware spinwait for CPU yielding.


store(t: any, key: any, value: any): any
    old = t[key]
    t[key] = value
    old
end

compare_swap(t: any, key: any, expected: any, new_value: any): any
    old = t[key]
    if old == expected
        t[key] = new_value
        return true, new_value
    end
    return false, old
end

fetch_add(t: any, key: any, delta: any): any
    old = t[key]
    if type(old) == "number"
        t[key] = old + delta
    else
        t[key] = delta
    end
    old
end

fetch_sub(t: any, key: any, delta: any): any
    old = t[key]
    if type(old) == "number"
        t[key] = old - delta
    else
        t[key] = -delta
    end
    old
end

inc(t: any, key: any): any
    old = t[key]
    if type(old) == "number"
        t[key] = old + 1
    else
        t[key] = 1
    end
    old
end

dec(t: any, key: any): any
    old = t[key]
    if type(old) == "number"
        t[key] = old - 1
    else
        t[key] = -1
    end
    old
end

mutex_new(): any
    { locked = false, owner = nil, count = 0 }
end

lock(m: any): void
    while true
        ok, _ = compare_swap(m, "locked", false, true)
        if ok
            m.owner = "current"
            m.count = 1
            return
        end
        hardware.spinwait()
    end
end

unlock(m: any): void
    m.owner = nil
    m.count = 0
    m.locked = false
end

try_lock(m: any): bool
    ok, _ = compare_swap(m, "locked", false, true)
    if ok
        m.owner = "current"
        m.count = 1
        return true
    end
    false
end

is_locked(m: any): bool
    m.locked
end

signal(sp: any): void
    if sp == nil return end
    sp.notify = true
end
