# wasm — WebAssembly binary format decoder/encoder
# This module provides WASM module parsing, validation, and manipulation.
# Used by ward (Duo's WASM runtime) and tools that generate/transform WASM.

# WASM magic and version
WASM_MAGIC = 0x0061736D
WASM_VERSION = 0x01000000

# Section IDs
SECTION_CUSTOM = 0
SECTION_TYPE = 1
SECTION_IMPORT = 2
SECTION_FUNCTION = 3
SECTION_TABLE = 4
SECTION_MEMORY = 5
SECTION_GLOBAL = 6
SECTION_EXPORT = 7
SECTION_START = 8
SECTION_ELEMENT = 9
SECTION_CODE = 10
SECTION_DATA = 11
SECTION_DATA_COUNT = 12

# Value types
TYPE_I32 = 0x7F
TYPE_I64 = 0x7E
TYPE_F32 = 0x7D
TYPE_F64 = 0x7C
TYPE_V128 = 0x7B
TYPE_FUNC = 0x60
TYPE_EMPTY = 0x40

# External kinds
IMPORT_FUNC = 0
IMPORT_TABLE = 1
IMPORT_MEMORY = 2
IMPORT_GLOBAL = 3
IMPORT_TAG = 4

# ═══════════════════════════════════════════════════════════════
# Binary reader
# ═══════════════════════════════════════════════════════════════

reader_new: any = (data: any)
    {data = data, pos = 1, len = data:len()}

reader_u8: any = (r: any)
    if r.pos > r.len return nil 
    b = r.data[r.pos]
    r.pos += 1
    b

reader_u32: any = (r: any)
    result = 0
    shift = 0
    while true
        b = reader_u8(r)
        if b == nil return nil 
        result |= ((b & 0x7F) << shift)
        shift += 7
        if (b & 0x80) == 0 break 
    result

# Unsigned LEB128, 64-bit. Called by reader_init_expr for the F64 case and
# defined NOWHERE — `use of undeclared identifier 'reader_u64'` took down
# std.wasm and, with it, every std.wasm.* module (decode, instruction,
# opcode_lookup, opcodes, ward_mvp_opcodes, wasi): seven of the thirty-eight
# unreachable modules, one missing function.
#
# Mirrors reader_u32 deliberately. NOTE the pre-existing discrepancy this does
# NOT change: both call sites are commented "read raw bits", but the WASM
# binary format stores f32/f64 constants as FIXED-WIDTH IEEE bytes, while
# reader_u32 (and now this) decode LEB128. Fixing that is a semantic change
# needing a real WASM fixture to validate, so it stays a separate concern from
# the missing definition.
reader_u64: any = (r: any)
    result = 0
    shift = 0
    while true
        b = reader_u8(r)
        if b == nil return nil 
        result |= ((b & 0x7F) << shift)
        shift += 7
        if (b & 0x80) == 0 break 
    result

reader_i32: any = (r: any)
    result = 0
    shift = 0
    b = 0
    while true
        b = reader_u8(r)
        if b == nil return nil 
        result |= ((b & 0x7F) << shift)
        shift += 7
        if (b & 0x80) == 0 break 
    # Sign extend
    if shift < 32 and (b & 0x40) != 0
        result |= (~0 << shift)
    result

reader_i64: any = (r: any)
    result = 0
    shift = 0
    b = 0
    while true
        b = reader_u8(r)
        if b == nil return nil 
        result |= ((b & 0x7F) << shift)
        shift += 7
        if (b & 0x80) == 0 break 
    if shift < 64 and (b & 0x40) != 0
        result |= (~0 << shift)
    result

reader_bytes: any = (r: any, n: i64)
    out = {}
    i = 0
    while i < n
        b = reader_u8(r)
        if b == nil return nil 
        out[out:len() + 1] = b
        i += 1
    out

reader_string: str = (r: any)
    len = reader_u32(r)
    if len == nil return "" 
    bytes = reader_bytes(r, len)
    parts = {}
    i = 1
    while i <= bytes:len()
        parts[parts:len() + 1] = bytes[i]:char()
        i += 1
    parts:concat()

reader_skip = (r: any, n: i64)
    r.pos += n

reader_remaining: i64 = (r: any)
    r.len - r.pos + 1

# ═══════════════════════════════════════════════════════════════
# Module parsing
# ═══════════════════════════════════════════════════════════════

module_decode: any = (data: any)
    r = reader_new(data)

    # Read header
    magic = reader_u32(r)
    if magic != WASM_MAGIC
        return nil, "invalid WASM magic number"
    version = reader_u32(r)
    if version != WASM_VERSION
        return nil, "unsupported WASM version"

    mod = {
        types = {},
        imports = {},
        functions = {},
        tables = {},
        memories = {},
        globals = {},
        exports = {},
        start = nil,
        elements = {},
        codes = {},
        datas = {},
        data_count = nil,
    }

    # Parse sections
    while reader_remaining(r) > 0
        section_id = reader_u8(r)
        if section_id == nil break 
        section_size = reader_u32(r)
        if section_size == nil break 
        section_start = r.pos

        if section_id == SECTION_TYPE
            count = reader_u32(r)
            i = 0
            while i < count
                func_type = reader_u8(r)  # should be TYPE_FUNC (0x60)
                param_count = reader_u32(r)
                params = {}
                j = 0
                while j < param_count
                    params[params:len() + 1] = reader_u8(r)
                    j += 1
                result_count = reader_u32(r)
                results = {}
                j = 0
                while j < result_count
                    results[results:len() + 1] = reader_u8(r)
                    j += 1
                mod.types[mod.types:len() + 1] = {params = params, results = results}
                i += 1
        else(section_id == SECTION_IMPORT)
            count = reader_u32(r)
            i = 0
            while i < count
                module_name = reader_string(r)
                field_name = reader_string(r)
                kind = reader_u8(r)
                import_entry = {module = module_name, field = field_name, kind = kind}
                if kind == IMPORT_FUNC
                    import_entry.type_idx = reader_u32(r)
                else(kind == IMPORT_TABLE)
                    elem_type = reader_u8(r)
                    limits = reader_limits(r)
                    import_entry.table = {elem_type = elem_type, limits = limits}
                else(kind == IMPORT_MEMORY)
                    limits = reader_limits(r)
                    import_entry.memory = {limits = limits}
                else(kind == IMPORT_GLOBAL)
                    val_type = reader_u8(r)
                    mutability = reader_u8(r)
                    import_entry.global = {type = val_type, mutable = mutability == 1}
                mod.imports[mod.imports:len() + 1] = import_entry
                i += 1
        else(section_id == SECTION_FUNCTION)
            count = reader_u32(r)
            i = 0
            while i < count
                type_idx = reader_u32(r)
                mod.functions[mod.functions:len() + 1] = {type_idx = type_idx}
                i += 1
        else(section_id == SECTION_MEMORY)
            count = reader_u32(r)
            i = 0
            while i < count
                limits = reader_limits(r)
                mod.memories[mod.memories:len() + 1] = {limits = limits}
                i += 1
        else(section_id == SECTION_GLOBAL)
            count = reader_u32(r)
            i = 0
            while i < count
                val_type = reader_u8(r)
                mutability = reader_u8(r)
                init_expr = reader_init_expr(r)
                mod.globals[mod.globals:len() + 1] = {
                    type = val_type,
                    mutable = mutability == 1,
                    init = init_expr,
                }
                i += 1
        else(section_id == SECTION_EXPORT)
            count = reader_u32(r)
            i = 0
            while i < count
                name = reader_string(r)
                kind = reader_u8(r)
                index = reader_u32(r)
                mod.exports[mod.exports:len() + 1] = {name = name, kind = kind, index = index}
                i += 1
        else(section_id == SECTION_START)
            mod.start = reader_u32(r)
        else(section_id == SECTION_CODE)
            count = reader_u32(r)
            i = 0
            while i < count
                body_size = reader_u32(r)
                body_start = r.pos
                local_count = reader_u32(r)
                locals = {}
                j = 0
                while j < local_count
                    n = reader_u32(r)
                    val_type = reader_u8(r)
                    locals[locals:len() + 1] = {count = n, type = val_type}
                    j += 1
                # Read bytecode until end marker (0x0B)
                bytecode = {}
                while r.pos < body_start + body_size
                    opcode = reader_u8(r)
                    if opcode == nil break 
                    bytecode[bytecode:len() + 1] = opcode
                    if opcode == 0x0B break # end marker
                mod.codes[mod.codes:len() + 1] = {
                    locals = locals,
                    bytecode = bytecode,
                    size = body_size,
                }
                i += 1
        else(section_id == SECTION_DATA)
            count = reader_u32(r)
            i = 0
            while i < count
                mem_idx = reader_u32(r)
                offset_expr = reader_init_expr(r)
                data_len = reader_u32(r)
                data_bytes = reader_bytes(r, data_len)
                mod.datas[mod.datas:len() + 1] = {
                    memory_index = mem_idx,
                    offset = offset_expr,
                    data = data_bytes,
                }
                i += 1
        else(section_id == SECTION_DATA_COUNT)
            mod.data_count = reader_u32(r)

        # Skip to end of section (if size was given)
        r.pos = section_start + section_size

    mod

# Read limits (flags + min + max)
reader_limits(r: any): any
    flags = reader_u8(r)
    min = reader_u32(r)
    max = nil
    if (flags & 1) == 1
        max = reader_u32(r)
    {min = min, max = max, has_max = (flags & 1) == 1}

# Read init expression (constant expression)
reader_init_expr: any = (r: any)
    opcode = reader_u8(r)
    value = nil
    if opcode == TYPE_I32
        value = reader_i32(r)
    else(opcode == TYPE_I64)
        value = reader_i64(r)
    else(opcode == TYPE_F32)
        value = reader_u32(r)  # read raw bits
    else(opcode == TYPE_F64)
        value = reader_u64(r)  # read raw bits
    reader_u8(r)  # END opcode (0x0B)
    {opcode = opcode, value = value}

# ═══════════════════════════════════════════════════════════════
# Module inspection
# ═══════════════════════════════════════════════════════════════

module_func_count: i64 = (mod: any)
    mod.functions:len()

module_memory_count: i64 = (mod: any)
    mod.memories:len()

module_export_names: any = (mod: any)
    names = {}
    i = 1
    while i <= mod.exports:len()
        names[names:len() + 1] = mod.exports[i].name
        i += 1
    names

module_import_count: i64 = (mod: any)
    mod.imports:len()

module_type_count: i64 = (mod: any)
    mod.types:len()

module_code_size: i64 = (mod: any)
    total = 0
    i = 1
    while i <= mod.datas:len()
        total += mod.datas[i].data:len()
        i += 1
    total

# ═══════════════════════════════════════════════════════════════
# Module validation
# ═══════════════════════════════════════════════════════════════

module_validate: any = (mod: any)
    errors = {}

    # Check type indices
    i = 1
    while i <= mod.functions:len()
        idx = mod.functions[i].type_idx
        if idx >= mod.types:len()
            errors[errors:len() + 1] = "function " .. i:to(str) .. " references invalid type index " .. idx:to(str)
        i += 1

    # Check export names are unique
    seen = {}
    i = 1
    while i <= mod.exports:len()
        name = mod.exports[i].name
        if seen[name]
            errors[errors:len() + 1] = "duplicate export name: " .. name
        seen[name] = true
        i += 1

    # Check memory limits
    i = 1
    while i <= mod.memories:len()
        mem = mod.memories[i]
        if mem.limits.max != nil and mem.limits.min > mem.limits.max
            errors[errors:len() + 1] = "memory " .. i:to(str) .. " min > max"
        i += 1

    {valid = errors:len() == 0, errors = errors}

# ═══════════════════════════════════════════════════════════════
# Module serialization (encode to binary)
# ═══════════════════════════════════════════════════════════════

module_encode: any = (mod: any)
    writer = {}

    # Header
    writer_bytes(writer, std.bit.leb128_encode_u(WASM_MAGIC))
    writer_bytes(writer, std.bit.leb128_encode_u(WASM_VERSION))

    # Type section
    if mod.types:len() > 0
        section = {}
        writer_bytes(section, std.bit.leb128_encode_u(mod.types:len()))
        i = 1
        while i <= mod.types:len()
            t = mod.types[i]
            writer_bytes(section, {TYPE_FUNC})
            writer_bytes(section, std.bit.leb128_encode_u(t.params:len()))
            for p in t.params writer_bytes(section, {p}) 
            writer_bytes(section, std.bit.leb128_encode_u(t.results:len()))
            for r in t.results writer_bytes(section, {r}) 
            i += 1
        write_section(writer, SECTION_TYPE, section)

    writer_data = {}
    i = 1
    while i <= writer:len()
        for b in writer[i]
            writer_data[writer_data:len() + 1] = b
        i += 1
    writer_data

writer_bytes = (writer: any, bytes: any)
    writer[writer:len() + 1] = bytes

write_section = (writer: any, id: i64, content: any)
    writer_bytes(writer, {id})
    writer_bytes(writer, std.bit.leb128_encode_u(content:len()))
    writer_bytes(writer, content)

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

M = {}
M.decode = module_decode
M.encode = module_encode
M.validate = module_validate
M.func_count = module_func_count
M.memory_count = module_memory_count
M.export_names = module_export_names
M.import_count = module_import_count
M.type_count = module_type_count
M.code_size = module_code_size
M.MAGIC = WASM_MAGIC
M.VERSION = WASM_VERSION
# Literals, not references to the SECTION_* constants above. A file-scope
# constant referenced from inside a NESTED TABLE of the export table emits a
# bare undeclared identifier when the module is embedded — third instance of
# this compiler gap today, after lib/net/ws.id's opcode table and
# lib/encoding/protobuf.id's WIRE table, where it is reduced to a
# two-file repro.
M.SECTION = {
    CUSTOM = 0,
    TYPE = 1,
    IMPORT = 2,
    FUNCTION = 3,
    TABLE = 4,
    MEMORY = 5,
    GLOBAL = 6,
    EXPORT = 7,
    START = 8,
    ELEMENT = 9,
    CODE = 10,
    DATA = 11,
    DATA_COUNT = 12,
}
M.TYPE = {
    I32 = 0x7F,
    I64 = 0x7E,
    F32 = 0x7D,
    F64 = 0x7C,
    FUNC = 0x60,
    EMPTY = 0x40,
}
M
