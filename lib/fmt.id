# fmt — formatting utilities

int: str = (v: any)
  if v == nil
    return "nil"
  v:to(str)

float: str = (v: any, precision: i64)
  if v == nil
    return "nil"
  if precision == nil
    "%g":format(v)
  "%." .. precision:to(str) .. "f":format(v)

boolean: str = (v: any)
  if v == nil
    return "false"
  # A guard, not `if v "true" else "false" end`. The endless one-liner clause
  # must be SELF-DELIMITED, and `v "true"` reads as PARENLESS
  # APPLICATION # it called `v("true")` and returned that. Because `v` is
  # `any` the bogus call TYPE-CHECKS, so unlike strconv's `b: bool` version
  # this compiled and shipped: boolean(true) returned "false".
  if v
    return "true"
  "false"

hex: str = (v: any)
  if v == nil
    return "nil"
  "0x%X":format(v)

bin: str = (v: any)
  if v == nil
    return "nil"
  digits = {}
  n = v
  if n == 0
    "0b0"
  while n > 0
    digits:insert(1, to(str)(n % 2))
    n = n / 2:floor()
  "0b" .. digits:concat()

trim: str = (s: str, chars: str)
  if s == nil
    return ""
  if chars == nil
    string("match")(s, "^%s*(.-)%s*$")
  string("match")(s, "^[" .. chars .. "]*(.-)[" .. chars .. "]*$")

pad: str = (s: str, width: i64, pad_char: str)
  if s == nil
    s = ""
  if pad_char == nil
    pad_char = " "
  len = s:len()
  w = width
  if w == nil or w <= len
    return s
  pad_str = pad_char:rep(w - len)
  s .. pad_str

trunc: str = (s: str, width: i64)
  if s == nil
    return ""
  if width == nil
    return s
  len = s:len()
  if len <= width
    return s
  s:sub(1, width)

format: str = (fmt: str, args: any)
  if fmt == nil
    return ""
  if args == nil
    args = {}
  out = ""
  i = 1
  arg_idx = 1
  while i <= fmt:len()
    if fmt:sub(i, i) == "{"
      j = fmt:find("}", i, true)
      if j
        spec = fmt:sub(i + 1, j - 1)
        v = args[arg_idx]
        if spec == ""
          out = out .. v:to(str)
        else
          if spec:sub(1, 2) == ":."
            prec = spec:sub(3:to(i64))
            if prec and v:to(i64)
              out = out .. "%." .. prec:to(str) .. "f":format(v)
            else
              out = out .. v:to(str)
          else
            out = out .. v:to(str)
        arg_idx = arg_idx + 1
        i = j + 1
      else
        out = out .. fmt:sub(i, i)
        i = i + 1
    else
      out = out .. fmt:sub(i, i)
      i = i + 1
  out

println = (fmt_str: str, ...args)
  s = format(fmt_str, args)
  stdout:write(s)
  stdout:write("\n")

bytes: str = (size: any)
  if size == nil
    return "0 B"
  if size < 1024
    return size:to(str) .. " B"
  else
    if size < 1024 * 1024
      return "%.1f KB":format(size / 1024)
    else
      if size < 1024 * 1024 * 1024
        return "%.1f MB":format(size / 1024 * 1024)
      else
        return "%.2f GB":format(size / 1024 * 1024 * 1024)

join: str = (parts: any, sep: str)
  if parts == nil
    return ""
  if sep == nil
    sep = ", "
  strs = {}
  i = 1
  while i <= parts:len()
    strs[strs:len() + 1] = to(str)(parts[i])
    i = i + 1
  strs:concat(sep)

repr: str = (v: any)
  if v == nil
    return "nil"
  t = type(v)
  if t == "string"
    return "\"" .. v:gsub("\"", "\\\"") .. "\""
  else
    if t == "boolean"
      if v
        return "true"
      else
        return "false"
    else
      if t == "number"
        return v:to(str)
      else
        if t == "table"
          parts = {}
          n = v:len()
          if n > 0
            i = 1
            while i <= n
              parts[parts:len() + 1] = repr(v[i])
              i = i + 1
            return "{" .. parts:concat(", ") .. "}"
          else
            for k, val in v
              parts[parts:len() + 1] = k:to(str) .. "=" .. repr(val)
            return "{" .. parts:concat(", ") .. "}"
        else
          return v:to(str)
