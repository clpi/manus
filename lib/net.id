# net — TCP/UDP sockets + HTTP client/server
# Architecture: When the module variable is named "net", the duo codegen emits
# direct C calls (duo_net_tcp_connect, duo_net_http_get, etc.) for zero-overhead
# networking. This fallback uses curl for HTTP and stubs for raw sockets.
# A native C binding via FFI is planned (see duo_gap_analysis.md).

# Parse a URL into {scheme, host, port, path}
parse_url(url: str): any
    scheme = "http"
    rest = url
    if rest:sub(1, 7) == "http://"
        rest = rest:sub(8)
    elseif rest:sub(1, 8) == "https://"
        scheme = "https"
        rest = rest:sub(9)
    end
    default_port = 80
    if scheme == "https" default_port = 443 end
    host = rest
    path = "/"
    slash_pos = rest:find("/")
    if slash_pos
        host = rest:sub(1, slash_pos - 1)
        path = rest:sub(slash_pos)
    end
    colon_pos = host:find(":")
    port = default_port
    if colon_pos
        port = host:sub(colon_pos + 1:to(i64)) or default_port
        host = host:sub(1, colon_pos - 1)
    end
    {scheme = scheme, host = host, port = port, path = path}
end

# HTTP GET via curl (fallback when variable not named "net")
http_get(url: str): str
    # Sanitize URL to prevent shell injection
    safe_url = url:gsub("[;&|`$]", "")
    f = io.popen("curl -sL --max-time 30 -- " .. safe_url, "r")
    if f == nil return "" end
    body = f:read("*a") or ""
    f:close()
    return body
end

# HTTP POST via curl (fallback)
http_post(url: str, body: str, content_type: str): str
    ct = content_type
    if ct == nil ct = "application/x-www-form-urlencoded" end
    if body == nil body = "" end
    # Sanitize URL and escape body for shell
    safe_url = url:gsub("[;&|`$]", "")
    escaped = body:gsub("'", "'\\''")
    cmd = "curl -sL --max-time 30 -X POST"
        .. " -H 'Content-Type: " .. ct .. "'"
        .. " --data '" .. escaped .. "' -- " .. safe_url
    f = io.popen(cmd, "r")
    if f == nil return "" end
    resp = f:read("*a") or ""
    f:close()
    return resp
end

# HTTP request returning {body, status} via curl
http_request(method: str, url: str, body: str, headers: any): any
    # Sanitize URL to prevent shell injection
    safe_url = url:gsub("[;&|`$]", "")
    cmd = "curl -si --max-time 30 -X " .. method
    if headers
        for k, v in headers
            # Also sanitize header values
            safe_k = k:gsub("[;&|`$']", "")
            safe_v = v:to(str):gsub("[;&|`$']", "")
            cmd = cmd .. " -H '" .. safe_k .. ": " .. safe_v .. "'"
        end
    end
    if body and body != ""
        escaped = body:gsub("'", "'\\''")
        cmd = cmd .. " --data '" .. escaped .. "'"
    end
    cmd = cmd .. " -- " .. safe_url
    f = io.popen(cmd, "r")
    if f == nil return {body = "", status = 0} end
    raw = f:read("*a") or ""
    f:close()
    status = tonumber(string["match"](raw, "HTTP/%d+%.%d+ (%d+)")) or 0
    sep = raw:find("\r\n\r\n", 1, true)
    resp_b = raw
    if sep
        resp_b = raw:sub(sep + 4)
    end
    {body = resp_b, status = status}
end

# Raw TCP connect — stub (real impl via codegen interception when var = "net")
connect(host: str, port: i64): any
    nil  # intercepted: duo_net_tcp_connect(host, port)
end

# TCP listen — stub
listen(host: str, port: i64, backlog: i64): any
    nil  # intercepted: duo_net_tcp_listen(host, port, backlog)
end

# TCP accept — stub
accept(srv_fd: any): any
    nil  # intercepted: duo_net_tcp_accept(srv_fd)
end

# TCP send — stub
send(fd: any, data: str): i64
    0 - 1   # intercepted: duo_net_tcp_send(fd, data)
end

# TCP recv — stub
recv(fd: any, maxlen: i64): any
    nil     # intercepted: duo_net_tcp_recv(fd, maxlen)
end

# TCP close — stub
close(fd: any): void
    # intercepted: duo_net_tcp_close(fd)
end

# UDP socket — stub
