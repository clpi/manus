
parse_url: any = (url: str)
  scheme = "http"
  rest = url
  if rest:sub(1, 7) == "http://"
    rest = rest:sub(8)
  else(rest:sub(1, 8) == "https://")
    scheme = "https"
    rest = rest:sub(9)
  default_port = 80
  if scheme == "https"
    default_port = 443
  host = rest
  path = "/"
  slash_pos = rest:find("/")
  if slash_pos
    host = rest:sub(1, slash_pos - 1)
    path = rest:sub(slash_pos)
  colon_pos = host:find(":")
  port = default_port
  if colon_pos
    port = host:sub(colon_pos + 1:to(i64)) or default_port
    host = host:sub(1, colon_pos - 1)
  { scheme = scheme, host = host, port = port, path = path }

http_get: str = (url: str)
  safe_url = url:gsub("[;&|`$]", "")
  f = io.popen("curl -sL --max-time 30 -- " .. safe_url, "r")
  if f == nil
    return ""
  body = f:read("*a") or ""
  f:close()
  return body

http_post: str = (url: str, body: str, content_type: str)
  ct = content_type
  if ct == nil
    ct = "application/x-www-form-urlencoded"
  if body == nil
    body = ""
  safe_url = url:gsub("[;&|`$]", "")
  escaped = body:gsub("'", "'\\''")
  cmd = "curl -sL --max-time 30 -X POST" .. " -H 'Content-Type: " .. ct .. "'" .. " --data '" .. escaped .. "' -- " .. safe_url
  f = io.popen(cmd, "r")
  if f == nil
    return ""
  resp = f:read("*a") or ""
  f:close()
  return resp

http_request: any = (method: str, url: str, body: str, headers: any)
  safe_url = url:gsub("[;&|`$]", "")
  cmd = "curl -si --max-time 30 -X " .. method
  if headers
    for k, v in headers
      safe_k = k:gsub("[;&|`$']", "")
      safe_v = v:to(str):gsub("[;&|`$']", "")
      cmd = cmd .. " -H '" .. safe_k .. ": " .. safe_v .. "'"
  if body and body != ""
    escaped = body:gsub("'", "'\\''")
    cmd = cmd .. " --data '" .. escaped .. "'"
  cmd = cmd .. " -- " .. safe_url
  f = io.popen(cmd, "r")
  if f == nil
    return { body = "", status = 0 }
  raw = f:read("*a") or ""
  f:close()
  status = string("match")(raw, "HTTP/%d+%.%d+ (%d+)"):to(i64) or 0
  sep = raw:find("\r\n\r\n", 1, true)
  resp_b = raw
  if sep
    resp_b = raw:sub(sep + 4)
  { body = resp_b, status = status }

connect: any = (host: str, port: i64)
  nil

listen: any = (host: str, port: i64, backlog: i64)
  nil

accept: any = (srv_fd: any)
  nil

send: i64 = (fd: any, data: str)
  0 - 1

recv: any = (fd: any, maxlen: i64)
  nil

close = (fd: any)
  void

udp_socket: any = (host: str, port: i64)
  nil

udp_sendto: i64 = (fd: any, data: str, host: str, port: i64)
  0 - 1

udp_recvfrom: any = (fd: any, maxlen: i64)
  nil

http_serve = (port: i64, handler: any)
  srv = listen("0.0.0.0", port, 128)
  if srv == nil
    stdout:write("net.http_serve: listen failed on port " .. port:to(str) .. "\n")
  stdout:write("net: listening on :" .. port:to(str) .. "\n")
  while true
    cli = accept(srv)
    if cli == nil
      break
    raw = recv(cli, 16384)
    if raw != nil
      method = ""
      req_path = ""
      method, req_path = string("match")(raw, "^(%u+) (/[^ ]*)")
      if method == nil
        method = "GET"
      if req_path == nil
        req_path = "/"
      resp_body = handler(method, req_path, raw) or ""
      response: str = "HTTP/1.0 200 OK\r\n" .. "Content-Type: text/plain\r\n" .. "Content-Length: " .. to(str)(resp_body:len()) .. "\r\n" .. "Connection: close\r\n\r\n" .. resp_body
      send(cli, response)
    close(cli)
  close(srv)

dns_resolve: any = (host: str)
  nil
