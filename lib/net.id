udp_sendto(fd: any, data: str, host: str, port: i64): i64
    0 - 1   # intercepted: duo_net_udp_sendto(fd, data, host, port)
end

# UDP recvfrom — stub
udp_recvfrom(fd: any, maxlen: i64): any
    nil  # intercepted: duo_net_udp_recvfrom(fd, maxlen)
end

# Simple blocking HTTP server (requires native socket support via codegen path)
# handler(method, path, raw_request): response_body string
http_serve(port: i64, handler: any): void
    srv = listen("0.0.0.0", port, 128)
    if srv == nil
        io:write("net.http_serve: listen failed on port " .. port:to(str) .. "\n")
    end
    io:write("net: listening on :" .. port:to(str) .. "\n")
    while true
        cli = accept(srv)
        if cli == nil break end
        raw = recv(cli, 16384)
        if raw != nil
            method = ""
            req_path = ""
            method, req_path = string["match"](raw, "^(%u+) (/[^ ]*)")
            if method == nil method = "GET" end
            if req_path == nil req_path = "/" end
            resp_body = handler(method, req_path, raw) or ""
            response: str = "HTTP/1.0 200 OK\r\n"
                .. "Content-Type: text/plain\r\n"
                .. "Content-Length: " .. to(str)(resp_body:len()) .. "\r\n"
                .. "Connection: close\r\n\r\n"
                .. resp_body
            send(cli, response)
        end
        close(cli)
    end
    close(srv)
end

# DNS resolve — codegen-intercepted to use getaddrinfo
dns_resolve(host: str): any
    nil  # intercepted: duo_net_dns_resolve(host)
end

