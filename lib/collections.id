# collections — basic data structures over Duo tables

list_new(): any
    {}

list_push(list: any, value: any): void
    list:insert(value)

list_pop(list: any): any
    list:remove()

list_get(list: any, index: i64): any
    list[index]

list_list: any:len(): i64
    return list:len()

stack_new(): any
    {}

stack_push(stack: any, value: any): void
    stack:insert(value)

stack_pop(stack: any): any
    stack:remove()

queue_new(): any
    {}

queue_enqueue(q: any, value: any): void
    q:insert(value)

queue_dequeue(q: any): any
    n = q:len()
    if n == 0
        nil
    q:remove(1)

map_new(): any
    {}

map_set(m: any, key: any, value: any): void
    m[key] = value

map_get(m: any, key: any): any
    m[key]

map_has(m: any, key: any): bool
    m[key] != nil

set_new(): any
    {}

set_add(s: any, value: any): void
    s[value] = true

set_has(s: any, value: any): bool
    s[value] != nil

is_array(t: any): bool
    if type(t) != "table" return false 
    if t[1] == nil return true 
    i = 2
    while t[i] != nil i += 1 
    for k, _ in t
        if type(k) != "number" return false 
        if k < 1 return false 
    true

remove_at(list: any, index: i64): any
    list:remove(index)

list_insert(list: any, index: i64, value: any): void
    list:insert(index, value)

list_clear(list: any): void
    if list == nil return 
    i = list:len()
    while i > 0
        list:remove(i)
        i -= 1

map_delete(m: any, key: any): void
    if m == nil return 
    m[key] = nil

map_keys(m: any): any
    out = {}
    if m == nil return out 
    for k, _ in m
        out:insert(k)
    out

map_values(m: any): any
    out = {}
    if m == nil return out 
    for _, v in m
        out:insert(v)
    out

set_remove(s: any, value: any): void
    if s == nil return 
    s[value] = nil

set_clear(s: any): void
    if s == nil return 
    for k, _ in s
        s[k] = nil

set_union(s1: any, s2: any): any
    out = {}
    if s1 != nil
        for k, _ in s1 out[k] = true 
    if s2 != nil
        for k, _ in s2 out[k] = true 
    out

set_intersection(s1: any, s2: any): any
    out = {}
    if s1 == nil or s2 == nil return out 
    for k, _ in s1
        if s2[k] != nil out[k] = true 
    out

set_difference(s1: any, s2: any): any
    out = {}
    if s1 == nil return out 
    for k, _ in s1
        if s2 == nil or s2[k] == nil out[k] = true 
    out

