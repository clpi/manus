
std_inspect_sort_strings = (arr: any)
    if arr == nil return 
    n = arr:len()
    i = 1
    while i <= n
        j = i
        while j > 1 and arr[j] < arr[j - 1]
            tmp = arr[j]
            arr[j] = arr[j - 1]
            arr[j - 1] = tmp
            j -= 1
        i += 1

std_inspect_hash: str = (value: any)
    if value == nil return "nil" 
    t = type(value)
    if t != "table" return t .. ":" .. value:to(str) 
    parts = {}
    ks = {}
    kn = 0
    for k, v in value
        kn = kn + 1
        ks[kn] = k:to(str)
    std_inspect_sort_strings(ks)
    i = 1
    pn = 0
    while i <= kn
        key = ks[i]
        val = value[key:to(i64)]
        if val == nil val = value[key] 
        pn = pn + 1
        parts[pn] = key .. "=" .. std_inspect_hash(val)
        i += 1
    "\{" .. parts:concat(",") .. "\}"

tostring: str = (value: any, indent: any, seen: any)
    if indent == nil indent = 0 
    if seen == nil seen = {} 
    if value == nil return "nil" 
    t = type(value)
    if t == "string"
        return '"' .. value .. '"'
    if t == "number"
        return value:to(str)
    if t == "boolean"
        if value return "true" 
        return "false"
    if t == "function"
        return "<function>"
    if t != "table"
        return value:to(str)
    ptr = value:to(str)
    if seen[ptr] != nil return "<circular>" 
    seen[ptr] = true
    n = value:len()
    if n > 0
        parts = {}
        pn = 0
        i = 1
        while i <= n
            pn = pn + 1
            parts[pn] = tostring(value[i], indent + 1, seen)
            i += 1
        prefix = "  ":rep(indent)
        inner_prefix = "  ":rep(indent + 1)
        if pn <= 4 and indent < 2
            return "[" .. parts:concat(", ") .. "]"
        return "[\n" .. inner_prefix .. parts:concat(",\n" .. inner_prefix) .. "\n" .. prefix .. "]"
    pairs_list = {}
    qn = 0
    for k, v in value
        qn = qn + 1
        pairs_list[qn] = {k = k, v = v}
    if qn == 0 return "\{\}" 
    parts = {}
    pn = 0
    i = 1
    while i <= qn
        pair = pairs_list[i]
        key_str = pair.k:to(str)
        if type(pair.k) == "string"
            key_str = pair.k
        val_str = tostring(pair.v, indent + 1, seen)
        pn = pn + 1
        parts[pn] = key_str .. " = " .. val_str
        i += 1
    prefix = "  ":rep(indent)
    inner_prefix = "  ":rep(indent + 1)
    if pn <= 3 and indent < 2
        return "\{" .. parts:concat(", ") .. "\}"
    return "\{\n" .. inner_prefix .. parts:concat(",\n" .. inner_prefix) .. "\n" .. prefix .. "\}"

std_inspect_diff = (a: any, b: any, prefix: any, diffs: any)
    if a == nil and b == nil return 
    if a == nil or b == nil
        if a == nil
            diffs[diffs:len() + 1] = {path = prefix, kind = "added", new = b}
        else
            diffs[diffs:len() + 1] = {path = prefix, kind = "removed", old = a}
        return
    if type(a) != type(b)
        diffs[diffs:len() + 1] = {path = prefix, kind = "changed", old = a, new = b}
        return
    if type(a) != "table"
        if a != b
            diffs[diffs:len() + 1] = {path = prefix, kind = "changed", old = a, new = b}
        return
    for k, v in a
        path = k
        if prefix != "" path = prefix .. "." .. k:to(str) 
        if b[k] == nil
            diffs[diffs:len() + 1] = {path = path, kind = "removed", old = v}
        else
            std_inspect_diff(v, b[k], path, diffs)
    for k, v in b
        if a[k] == nil
            path = k
            if prefix != "" path = prefix .. "." .. k:to(str) 
            diffs[diffs:len() + 1] = {path = path, kind = "added", new = v}

deep_equal: bool = (a: any, b: any)
    if a == b return true 
    if a == nil or b == nil return false 
    if type(a) != type(b) return false 
    if type(a) != "table" return false 
    na = a:len()
    nb = b:len()
    if na != nb return false 
    if na > 0
        i = 1
        while i <= na
            if not deep_equal(a[i], b[i]) return false 
            i += 1
        for ka, _va in a
            if type(ka) != "number"
                if not deep_equal(a[ka], b[ka]) return false 
        for kb, _vb in b
            if a[kb] == nil return false 
        return true
    for kc, vc in a
        if not deep_equal(vc, b[kc]) return false 
    for kd, _vd in b
        if a[kd] == nil return false 
    true

deep_hash: str = (value: any)
    std_inspect_hash(value)

diff: any = (a: any, b: any, prefix: any)
    if prefix == nil prefix = "" 
    diffs = {}
    std_inspect_diff(a, b, prefix, diffs)
    diffs

diff_summary: str = (a: any, b: any)
    diffs = diff(a, b)
    if diffs:len() == 0 return "no differences" 
    parts = {}
    pn = 0
    i = 1
    while i <= diffs:len()
        d = diffs[i]
        line = d.kind .. " " .. d.path
        if d.kind == "changed"
            line = line .. ": " .. d.old:to(str) .. " -> " .. d.new:to(str)
        else(d.kind == "added")
            line = line .. ": " .. d.new:to(str)
        else(d.kind == "removed")
            line = line .. ": " .. d.old:to(str)
        pn = pn + 1
        parts[pn] = line
        i += 1
    to(str)(diffs:len()) .. " difference(s):\n" .. parts:concat("\n")

type_name(value: any): str
    if value == nil return "nil" 
    t = type(value)
    if t == "table"
        n = value:len()
        if n > 0 return "array[" .. n:to(str) .. "]" 
        count = 0
        for _ck, _cv in value
            count += 1
        if count > 0 return "table[" .. count:to(str) .. "]" 
        return "table"
    return t

size: i64 = (value: any)
    if value == nil return 0 
    t = type(value)
    if t == "string" return value:len() 
    if t == "table"
        n = value:len()
        if n > 0 return n 
        count = 0
        for _ck, _cv in value
            count += 1
        return count
    return 1

keys_of: any = (t: any)
    out = {}
    kn = 0
    if t == nil or type(t) != "table" return out 
    for kk, _kv in t
        kn = kn + 1
        out[kn] = kk:to(str)
    std_inspect_sort_strings(out)
    out

summary: str = (value: any)
    if value == nil return "nil" 
    t = type(value)
    if t != "table" return t .. ": " .. value:to(str) 
    n = value:len()
    if n > 0
        return "array(" .. n:to(str) .. " elements)"
    count = 0
    first_key = nil
    for k, v in value
        count += 1
        if first_key == nil first_key = k:to(str) 
    if count == 0 return "empty table" 
    if count <= 3
        return "table(" .. count:to(str) .. " keys: " .. first_key .. " ...)"
    return "table(" .. count:to(str) .. " keys)"

caller_info: any = (level: any)
    if level == nil level = 2 
    info = debug.getinfo(level)
    if info == nil return nil 
    {
        name = info.name,
        source = info.source,
        linedefined = info.linedefined,
        currentline = info.currentline,
        what = info.what
    }

stack_trace: str = (level: any, max_depth: any, pretty: any)
    if level == nil level = 2 
    if max_depth == nil max_depth = 20 
    color_ok = false
    if pretty
        pcall_ok, env_val = pcall(env, "NO_COLOR")
        if pcall_ok and env_val != nil and env_val != ""
            color_ok = false
        else
            color_ok = true
    if color_ok
        C_RESET  = "\x1b[0m"
        C_DIM    = "\x1b[2m"
        C_ITALIC = "\x1b[3m"
        C_UNDER  = "\x1b[4m"
        C_CYAN   = "\x1b[36m"
        C_MAGENTA= "\x1b[35m"
        C_YELLOW = "\x1b[33m"
    lines = {}
    ln = 0
    i = level
    while i < level + max_depth
        info = debug.getinfo(i, "Snl")
        if info == nil break 
        fname = info.name
        if fname == nil or fname == "" fname = "?" 
        src = info.short_src
        if src == nil src = info.source 
        if src == nil src = "?" 
        if color_ok
            frame = "  " .. C_DIM .. "↳ " .. C_RESET ..
                    C_MAGENTA .. C_ITALIC .. fname .. "()" .. C_RESET
            loc = src
            if info.currentline and info.currentline > 0
                loc = src .. C_DIM .. ":" .. C_RESET .. C_YELLOW .. info.currentline:to(str) .. C_RESET
            frame = frame .. "  " .. C_DIM .. "⟨" .. C_RESET ..
                    C_UNDER .. loc .. C_RESET .. C_DIM .. "⟩" .. C_RESET
        else
            frame = fname .. "()"
            if info.currentline and info.currentline > 0
                frame = frame .. " [" .. src .. ":" .. info.currentline:to(str) .. "]"
            else
                frame = frame .. " [" .. src .. "]"
        ln = ln + 1
        lines[ln] = frame
        i += 1
    lines:concat("\n")

