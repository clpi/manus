# diff — Structural diff algorithms
# Myers O(ND) text diff, LCS, and hierarchical table diff.
# Critical for: config management, CRDTs, code review, data sync,
# ML model versioning, and version control systems.

# ═══════════════════════════════════════════════════════════════
# LCS: longest common subsequence
# ═══════════════════════════════════════════════════════════════

lcs: any = (a: any, b: any)
    la = a:len()
    lb = b:len()
    prev = {}
    curr = {}
    j = 0
    while j <= lb
        prev[j + 1] = 0
        j += 1
    i = 1
    while i <= la
        curr[1] = 0
        j = 1
        while j <= lb
            if a[i] == b[j]
                curr[j + 1] = prev[j] + 1
            else
                left = curr[j]
                up = prev[j + 1]
                if left > up curr[j + 1] = left else curr[j + 1] = up 
            j += 1
        tmp = prev
        prev = curr
        curr = tmp
        i += 1
    # backtrack
    out = {}
    i = la
    j = lb
    while i > 0 and j > 0
        if a[i] == b[j]
            out[out:len() + 1] = {op = "equal", old = i, new = j, value = a[i]}
            i -= 1
            j -= 1
        else
            if i == 1
                row_prev = {}
                k = 0
                while k <= lb
                    row_prev[k + 1] = 0
                    k += 1
            else
                row_prev = prev
            if i > 0 and j > 0 and row_prev[j + 1] >= curr[j]
                j -= 1
            else
                i -= 1
    ops = {}
    k = out:len()
    while k >= 1
        ops[ops:len() + 1] = out[k]
        k -= 1
    ops

# lcs_length: return just the length of the LCS (faster, no backtrack).
lcs_length: i64 = (a: any, b: any)
    la = a:len()
    lb = b:len()
    prev = {}
    curr = {}
    j = 0
    while j <= lb
        prev[j + 1] = 0
        j += 1
    i = 1
    while i <= la
        curr[1] = 0
        j = 1
        while j <= lb
            if a[i] == b[j]
                curr[j + 1] = prev[j] + 1
            else
                left = curr[j]
                up = prev[j + 1]
                if left > up curr[j + 1] = left else curr[j + 1] = up 
            j += 1
        tmp = prev
        prev = curr
        curr = tmp
        i += 1
    prev[lb + 1]

# ═══════════════════════════════════════════════════════════════
# Myers diff: edit script (insert/delete) for sequences
# ═══════════════════════════════════════════════════════════════

myers: any = (a: any, b: any)
    la = a:len()
    lb = b:len()
    max = la + lb
    if max == 0 return {} 
    v = {}
    trace = {}
    d = 0
    while d <= max
        k = 0 - d
        while k <= d
            if k == 0 - d or (k != d and (v[k - 1] or 0) < (v[k + 1] or 0))
                x = v[k + 1] or 0
            else
                x = (v[k - 1] or 0) + 1
            y = x - k
            while x < la and y < lb and a[x + 1] == b[y + 1]
                x += 1
                y += 1
            v[k] = x
            if x >= la and y >= lb
                return myers_backtrack(a, b, trace, la, lb)
            k += 2
        snap = {}
        for sk, sv in v
            snap[sk] = sv
        trace[trace:len() + 1] = snap
        d += 1
    {}

myers_backtrack: any = (a: any, b: any, trace: any, x: any, y: any)
    edits = {}
    d = trace:len()
    while d > 0
        snap = trace[d]
        k = x - y
        if k == 0 - d or (k != d and (snap[k - 1] or 0) < (snap[k + 1] or 0))
            prev_x = snap[k + 1] or 0
        else
            prev_x = (snap[k - 1] or 0) + 1
        prev_y = prev_x - k
        while x > prev_x and y > prev_y
            edits[edits:len() + 1] = {op = "equal", value = a[x]}
            x -= 1
            y -= 1
        if d > 1
            if x == prev_x
                edits[edits:len() + 1] = {op = "insert", value = b[y]}
                y -= 1
            else
                edits[edits:len() + 1] = {op = "delete", value = a[x]}
                x -= 1
        d -= 1
    out = {}
    i = edits:len()
    while i >= 1
        out[out:len() + 1] = edits[i]
        i -= 1
    out

# ═══════════════════════════════════════════════════════════════
# Unified diff: produce human-readable line diff
# ═══════════════════════════════════════════════════════════════

unified: any = (old_lines: any, new_lines: any)
    ops = myers(old_lines, new_lines)
    out = {}
    i = 1
    while i <= ops:len()
        op = ops[i]
        if op.op == "equal"
            out[out:len() + 1] = " " .. op.value
        else if op.op == "delete"
            out[out:len() + 1] = "-" .. op.value
        else if op.op == "insert"
            out[out:len() + 1] = "+" .. op.value
        i += 1
    out

# ═══════════════════════════════════════════════════════════════
# Table diff: hierarchical structural diff for nested tables
# ═══════════════════════════════════════════════════════════════

table_diff: any = (old: any, new_: any)
    diffs = {}
    table_diff_into(old, new_, "", diffs)
    diffs

table_diff_into = (old: any, new_: any, path: str, diffs: any)
    if old == nil and new_ == nil return 
    if old == nil
        diffs[diffs:len() + 1] = {op = "add", path = path, value = new_}
        return
    if new_ == nil
        diffs[diffs:len() + 1] = {op = "remove", path = path}
        return
    if type(old) != type(new_)
        diffs[diffs:len() + 1] = {op = "replace", path = path, old = old, new = new_}
        return
    if type(old) != "table"
        if old != new_
            diffs[diffs:len() + 1] = {op = "replace", path = path, old = old, new = new_}
        return
    visited = {}
    for k, v in old
        nk = new_[k]
        p = path
        if type(k) == "number"
            p = p .. "[" .. k:to(str) .. "]"
        else
            if p != "" p = p .. "." 
            p = p .. k:to(str)
        visited[k] = true
        table_diff_into(v, nk, p, diffs)
    for k, v in new_
        if not visited[k]
            p = path
            if type(k) == "number"
                p = p .. "[" .. k:to(str) .. "]"
            else
                if p != "" p = p .. "." 
                p = p .. k:to(str)
            diffs[diffs:len() + 1] = {op = "add", path = p, value = v}

# ═══════════════════════════════════════════════════════════════
# Utility: count additions, removals, replacements
# ═══════════════════════════════════════════════════════════════

stats: any = (diffs: any)
    adds = 0
    removes = 0
    replaces = 0
    i = 1
    while i <= diffs:len()
        if diffs[i].op == "add" adds += 1
        else if diffs[i].op == "remove" removes += 1
        else if diffs[i].op == "replace" replaces += 1
        i += 1
    {adds = adds, removes = removes, replaces = replaces, total = adds + removes + replaces}

# has_changes: return true if the diff list is non-empty.
has_changes: bool = (diffs: any)
    diffs:len() > 0
