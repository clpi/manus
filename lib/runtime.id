# runtime — runtime information (mirrors Go's runtime package)

# NumCPU returns the number of logical CPUs.
num_cpu: i64 = ()
    f = io.popen("sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 1", "r")
    if f == nil return 1
    out = f:read("*a")
    f:close()
    if out == nil or out == "" return 1
    return out:to(i64) or 1

# Caller returns information about the caller of the calling function.
caller: any = (skip: i64)
    debug_mod = debug
    info = debug_mod.getinfo(skip + 1)
    if info == nil return nil
    return {pc = info.short_src, fn = info.short_src, call = info.linedefined, line = info.currentline, name = info.name}

# GC runs the garbage collector.
gc = ()
    collectgarbage("collect")

# GOMAXPROCS sets and returns the max number of CPUs.
gomaxprocs: i64 = (n: i64)
    old = num_cpu()
    if n > 0
        # This is a no-op in single-threaded Duo.
    end
    old

# Version returns the Duo version string.
version: str = ()
    "duo-0.1.0"

# MemStats returns memory allocation statistics.
mem_stats: any = ()
    m = collectgarbage("count")
    return {alloc = m * 1024, sys = m * 1024}

# Stack returns the stack trace.
stack: str = ()
    debug_mod = debug
    debug_mod.traceback()

