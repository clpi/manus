
new: any = (message: any)
  return { message = message, cause = nil, kind = "error" }

newf: any = (fmt: any)
  return { message = fmt:to(str), cause = nil, kind = "error" }

wrap: any = (err: any, message: str)
  if err == nil
    return new(message)
  { message = message, cause = err, kind = "wrapped" }

wrapf: any = (err: any, fmt: any)
  msg = fmt:to(str)
  if err == nil
    return new(msg)
  return { message = msg, cause = err, kind = "wrapped" }

is: bool = (err: any, target: any)
  if err == nil
    return false
  if target == nil
    return false
  cur = err
  while cur != nil
    if cur == target
      return true
    if cur.message == target.message and cur.kind == target.kind
      return true
    cur = cur.cause
  false

as: any = (err: any, kind: str)
  if err == nil
    return nil
  cur = err
  while cur != nil
    if cur.kind == kind
      return cur
    cur = cur.cause
  nil

unwrap: any = (err: any)
  if err == nil
    return nil
  err.cause

message: any = (err: any)
  if err == nil
    return nil
  if type(err) == "string"
    return err
  err.message

join: any = (...errs)
  parts = {}
  n = 0
  for _, e in errs
    if e != nil
      msg = e.message
      if msg == nil
        msg = e:to(str)
      n = n + 1
      parts[n] = msg
  if n == 0
    return nil
  { message = parts:concat("; "), cause = nil, kind = "joined" }

to_str: str = (err: any)
  if err == nil
    return ""
  if type(err) == "string"
    return err
  msg = err.message
  if msg == nil
    msg = err:to(str)
  if has(.cause)(err)
    msg = msg .. " -> " .. to_str(err.cause)
  msg
