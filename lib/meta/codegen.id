# meta.codegen — compile-time C code generation helpers
# Use with @meta.define.derive, @meta.fields.map, @meta.loop, @meta.map, and @c.emit
# to turn O(1) descriptions into O(n) generated code.

# Expand a template once per field name in a comptime field table.
# fields: result of @fields(T) — each entry has .name and .type
# tmpl: string with %n=field name, %t=field type, %i=index
fields_map: str = (fields: any, tmpl: str)
  acc = ""
  for i, f in fields
    row = tmpl
    row = row:gsub("%n", f.name)
    row = row:gsub("%t", f.type)
    row = row:gsub("%i", to(str)(i - 1))
    acc = acc .. row
  acc

# Generate C struct typedef from field descriptors (for @c.emit injection).
c_struct: str = (name: str, fields: any)
  lines = { "typedef struct " .. name .. " {" }
  for _, f in fields
    lines[lines:len() + 1] = "    " .. f.type .. " " .. f.name .. ";"
  lines[lines:len() + 1] = "} " .. name .. ";"
  lines:concat("\n")

# Generate field-wise hash combine (FNV-style) for @derive(Hash) style macros.
c_hash_combine: str = (type_name: str, fields: any)
  acc = "static uint64_t " .. type_name .. "_hash(const " .. type_name .. "* v) {\n"
  acc = acc .. "    uint64_t h = 14695981039346656037ULL;\n"
  for _, f in fields
    if f.type == "int64_t" or f.type == "integer" or f.type == "i64"
      acc = acc .. "    h ^= (uint64_t)v->" .. f.name .. "; h *= 1099511628211ULL;\n"
    else
      acc = acc .. "    h ^= (uint64_t)(*(uint64_t*)&v->" .. f.name .. "); h *= 1099511628211ULL;\n"
  acc = acc .. "    return h;\n}\n"
  acc

# Generate getters: one static inline per field.
c_getters: str = (type_name: str, fields: any)
  fields_map(fields, "static inline %t get_%n(const " .. type_name .. "* self) { return self->%n; }\n")

# Canonical @meta.map callback: emit a C comment per matching type.
c_type_comment: str = meta
"/* " .. meta.name .. " */\n"

# Canonical @meta.map callback: semicolon-separated type registry line.
type_registry_line: str = meta
meta.name .. ";"

# Canonical @meta.product callback: cross-product type pair signature.
type_pair_line: str = (a, b)
  a.name .. "x" .. b.name .. ";"

# Document @meta.expand / @meta.pow / @meta.ceiling stacking.
# Usage:
#   @c.emit(@meta.pow("Concept", DeriveApi))
#   @c.emit(@meta.ceiling("ConceptA", DeriveApi, "ConceptB"))
#   @meta.emit.derive("Concept", DeriveApi)
expand_hint: str = ()
  "@meta.pow(concept, derive[, map_fn])"

ceiling_hint: str = ()
  "@meta.ceiling(concept_a, derive, concept_b)"

burst_hint: str = ()
  "@meta.burst(concept_a, derive, concept_b) — derive.all + emit.omni"

transcend_hint: str = ()
  "@meta.transcend(concept_a, derive, concept_b, concept_c) — burst + cubic derive.tensor"

infinity_hint: str = ()
  "@meta.infinity(concept_a, derive, concept_b, concept_c, concept_d) — transcend + quartic derive.nfold"

nfold_hint: str = ()
  "@meta.nfold({ concepts... }, fn) — O(types^k); @meta.derive.nfold({ ... }, Derive)"

str_contains_hint: str = ()
  "needle in haystack — ordinary text relation with native and compile-time realizations"

str_prefix_suffix_hint: str = ()
  "@meta.str.starts.with(s, prefix) / @meta.str.ends.with(s, suffix) — native C predicates / comptime fold"

template_hint: str = ()
  "@comp.template(instances, body[, fn]) — O(n) parametric axis; $0/$1/$name/$ctype placeholders"

generate_hint: str = ()
  "@comp.generate(spec, body[, fn]) — comma-list alias or ops×types constraint cartesian"

scheme_hint: str = ()
  "@comp.scheme(declarations, template[, fn]) — pipe-separated type/fn units; $kind/$fields/$params"

scheme_clauses_hint: str = ()
  "@comp.scheme.clauses(\"name: body; name2: body2\"[, fn]) — O(clauses) named clause emission"

grammar_hint: str = ()
  "@comp.grammar(spec, fn) — EBNF → O(b^d) expansion fragments"

weave_hint: str = ()
  "@comp.weave(module, concept, fn) — cross-module concept sweep O(N×M)"

each_hint: str = ()
  "@comp.each(source, fn) / @comp.chain(source, fn) — split combinator output; chain generate→each, power→each, etc."

chain_hint: str = ()
  "@comp.chain(source, fn) — alias of @comp.each; composition glue for exponential combinator algebra"

# Canonical @meta.tensor callback: triple cross-product signature line.
type_triple_line: str = (a, b, c)
  a.name .. "x" .. b.name .. "x" .. c.name .. ";"

M =
  fields_map = fields_map
  c_struct = c_struct
  c_hash_combine = c_hash_combine
  c_getters = c_getters
  c_type_comment = c_type_comment
  type_registry_line = type_registry_line
  type_pair_line = type_pair_line
  expand_hint = expand_hint
  ceiling_hint = ceiling_hint
  burst_hint = burst_hint
  transcend_hint = transcend_hint
  infinity_hint = infinity_hint
  nfold_hint = nfold_hint
  str_contains_hint = str_contains_hint
  str_prefix_suffix_hint = str_prefix_suffix_hint
  template_hint = template_hint
  generate_hint = generate_hint
  scheme_hint = scheme_hint
  scheme_clauses_hint = scheme_clauses_hint
  grammar_hint = grammar_hint
  weave_hint = weave_hint
  each_hint = each_hint
  chain_hint = chain_hint
  type_triple_line = type_triple_line
