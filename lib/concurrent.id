# concurrent — high-level concurrency primitives (Requirement 20.9)
# Builds on sync's scheduler.  Provides go/wait/select/all patterns.

# Projections for channel operations
send = sync.send
recv = sync.recv

# Spawn a task and return a future channel (capacity 1) for its result.
# result shape: {ok=bool, val=any, err=any}
go(fn: any, ...args): any
    fut = sync.channel(1)
    args = {args}
    closure: void = ()
        ok, result = pcall(fn, args:unpack())
        if ok
            send(fut, {ok = true, val = result})
        else
            send(fut, {ok = false, err = result})
        end
    end
    sync.spawn(closure)
    fut
end

# Await a future (blocks/yields until result available).
wait(fut: any): any
    r = recv(fut)
    if r == nil return nil end
    if r.ok
        r.val
    else
        error(r.err, 2)
    end
end

# Run N tasks concurrently; return table of results in order.
all(tasks: any, ...args): any
    futs = {}
    # tasks can be a list, or varargs
    if type(tasks) == "function"
        args = {args}
        futs[1] = go(tasks, args:unpack())
    else
        for _, t in tasks
            if type(t) == "function"
                futs[futs:len() + 1] = go(t)
            elseif type(t) == "table" and t[1]
                futs[futs:len() + 1] = go(t[1], t:unpack(2))
            end
        end
    end
    sync.run()
    results = {}
    for _, fut in futs
        results[results:len() + 1] = wait(fut)
    end
    results
end

# Race: return the first completed future's result.
race(futs: any): any
    winner = sync.channel(1)
    for i, fut in futs
        clo: void = ()
            val = sync.recv(fut)
            sync.peek(winner)  # drain if already won
            send(winner, {idx = i, val = val})
        end
        sync.spawn(clo)
    end
    sync.run()
    sync.peek(winner)
end

# Select: poll channels round-robin until one has data.
# cases = {{ch=channel, fn=handler}, ...}
# Returns when one case fires; calls its fn with the value.
select(cases: any): any
    while true
        for _, c in cases
            val = sync.peek(c.ch)
            if val != nil
                if c.fn c.fn(val) end
                return val, c.ch
            end
        end
        sync.yield()
    end
end

# Semaphore: counting semaphore built on a buffered channel.
semaphore(n: i64): any
    s = sync.channel(n)
    for _ = 1, n send(s, true) end
    {
        acquire: any = ()sync.recv(s),
        release: void = ()send(s, true),
        probe: bool = ()sync.peek(s) != nil,
    }
end

# WaitGroup: wait for N tasks to complete.
waitgroup(n: i64): any
    ch = sync.channel(n)
    return {
        done: void = ()send(ch, true),
        wait: void = ()
            for _ = 1, n sync.recv(ch) end
        end,
    }
end

# SCOPE: a module's top-level bindings ARE its surface, so these
# self-assignments (`go = go`) published nothing that was not already public.
# They were also const violations — the binding exists by the time the line is
# reached — which took the whole module down. The re-exports below are kept
# because they bind a DIFFERENT name to a sync.* member; the identity lines are
# deleted.
spawn = sync.spawn
run = sync.run
yield = sync.yield
channel = sync.channel
send = sync.send
recv = sync.recv
