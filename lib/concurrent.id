
send = sync.send
recv = sync.recv

go: any = (fn: any, ...args)
    fut = sync.channel(1)
    args = {args}
    closure: void = ()
        ok, result = pcall(fn, args:unpack())
        if ok
            send(fut, {ok = true, val = result})
        else
            send(fut, {ok = false, err = result})
    sync.spawn(closure)
    fut

wait: any = (fut: any)
    r = recv(fut)
    if r == nil return nil 
    if r.ok
        r.val
    else
        error(r.err, 2)

all: any = (tasks: any, ...args)
    futs = {}
    if type(tasks) == "function"
        args = {args}
        futs[1] = go(tasks, args:unpack())
    else
        for _, t in tasks
            if type(t) == "function"
                futs[futs:len() + 1] = go(t)
            else(type(t) == "table" and t[1])
                futs[futs:len() + 1] = go(t[1], t:unpack(2))
    sync.run()
    results = {}
    for _, fut in futs
        results[results:len() + 1] = wait(fut)
    results

race(futs: any): any
    winner = sync.channel(1)
    for i, fut in futs
        clo: void = ()
            val = sync.recv(fut)
            sync.peek(winner)
            send(winner, {idx = i, val = val})
        sync.spawn(clo)
    sync.run()
    sync.peek(winner)

select: any = (cases: any)
    while true
        for _, c in cases
            val = sync.peek(c.ch)
            if val != nil
                if c.fn c.fn(val) 
                return val, c.ch
        sync.yield()

semaphore: any = (n: i64)
    s = sync.channel(n)
    for _ = 1, n send(s, true) 
    {
        acquire = (): any sync.recv(s),
        release = (): void send(s, true),
        probe = (): bool sync.peek(s) != nil,
    }

waitgroup: any = (n: i64)
    ch = sync.channel(n)
    return {
        done = (): void send(ch, true),
        wait: void = ()
            for _ = 1, n sync.recv(ch) 
        end,
    }

spawn = sync.spawn
run = sync.run
yield = sync.yield
channel = sync.channel
send = sync.send
recv = sync.recv
