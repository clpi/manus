    "examples/boring/search/binary.id",
    "examples/boring/mat/mul.id",
    "examples/layout/guard.id",
    "examples/layout/loop/body.id",
    "examples/demand/result.id",
    "examples/demand/swap.id",
    "examples/demand/tail.id",
    "examples/pack/consume.id",
    "examples/projection/descriptor.id",
    "examples/read/stream.id",
    "examples/native/record.id",
    "examples/hash/agreement.id",
    "examples/control/default.id",
    "examples/conversion/level.id",
    "examples/table/str/split.id",
    "examples/table/float/render.id"
  }

M =
  discover = discover
  scaling_ladder = scaling_ladder
  hook_index = hook_index
  dedupe_policy = dedupe_policy
  gaps_file = gaps_file
  gaps_index = gaps_index
  coordination_file = coordination_file
  canonical_index_file = canonical_index_file
  grammar_spec_file = grammar_spec_file
  grammar_index = grammar_index
  multiplier_for = multiplier_for
  build_gates = build_gates
  native_policy = native_policy
  recipes = recipes
  gap_blocked = gap_blocked
  smoke_targets = smoke_targets
