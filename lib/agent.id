# lib/agent — hooks for agentic development on Idol (compiler dev + end-user apps)
# Primary surface: @comp.* (@meta.* / @compiler.* are aliases). Comptime strings
# fold to native C during bootstrap; prefer canonical Idol teaching under examples/.

discover: str = ()
  "comp.map comp.sweep comp.derive comp.product comp.tensor comp.nfold comp.burst comp.power comp.choose comp.permute\n" .. "comp.template comp.generate comp.scheme comp.grammar comp.weave comp.each comp.pipeline\n" .. "comp.agent.catalog comp.agent.ladder comp.agent.hooks comp.agent.dedupe comp.agent.gaps comp.agent.grammar\n" .. "meta.* and compiler.* are compatibility aliases; prefer comp.*"

scaling_ladder: str = ()
  "map:O(n)\n" .. "derive:O(n*f)\n" .. "product:O(n^2)\n" .. "tensor:O(n^3)\n" .. "nfold:O(n^k)\n" .. "power:O(2^n)\n" .. "choose:O(n choose k)\n" .. "permute:O(n!)\n" .. "grammar:O(b^d)\n" .. "each:composition glue"

hook_index: str = ()
  ".agents/AGENT_CANONICAL.md — single router for all agents\n" .. ".agents/AGENT_COORDINATION.md — coordination buffer and Cross-Agent Gap Buffer\n" .. "idol_agent_session_start / idol_coordination_update / idol_agent_gaps_update\n" .. "lib/agent — recipes, build_gates, native_policy, multiplier_for, smoke_targets\n" .. "Host scripting remains bootstrap debt; prefer Idol sources under tools/ and scripts/"

dedupe_policy: str = ()
  "1. Read .agents/AGENT_COORDINATION.md and claim before editing\n" .. "2. Search idol_meta_catalog before adding directives or bootstrap modules\n" .. "3. Extend lib/agent, tools/mcp/, and existing @comp.* hooks; do not fork parallel buffers\n" .. "4. Serialize builds with scripts/idol_lock.id\n" .. "5. Use idol_coordination_update and idol_agent_gaps_update for coordination"

gaps_file: str = ()
  ".agents/AGENT_COORDINATION.md#cross-agent-gap-buffer"

gaps_index: str = ()
  "Cross-Agent Gap Buffer: .agents/AGENT_COORDINATION.md#cross-agent-gap-buffer\n" .. "Categories: perf native meta script agent backend\n" .. "MCP: idol_agent_gaps_read / idol_agent_gaps_update (duo_* legacy aliases retained)\n" .. "Policy: file expressiveness, native-lowering, scripting, backend, and coordination gaps before one-off work"

coordination_file: str = ()
  ".agents/AGENT_COORDINATION.md"

canonical_index_file: str = ()
  ".agents/AGENT_CANONICAL.md"

grammar_spec_file: str = ()
  "docs/GRAMMAR_SPEC.md"

grammar_index: str = ()
  "docs/GRAMMAR_SPEC.md — canonical GR-* rules\n" .. "GR-001 bare typed function declarations; fun/function deprecated in .id\n" .. "GR-002 if-expressions\n" .. "GR-004 quoted table keys without brackets\n" .. "MCP: idol_grammar_spec_read / idol_grammar_spec_update (bootstrap duo_* aliases)"

multiplier_for: str = (goal: str)
  g = goal:lower()
  if g:find("trait") or g:find("derive") or g:find("impl")
    return "@comp.derive / @comp.derive.all / @comp.derive.bundle — O(types×fields)"
  if g:find("pair") or g:find("cartesian") or g:find("product")
    return "@comp.product / @comp.derive.product — O(types²)"
  if g:find("triple") or g:find("tensor")
    return "@comp.tensor / @comp.derive.tensor — O(types³)"
  if g:find("subset") or g:find("powerset") or g:find("power")
    return "@comp.power / @comp.derive.power — O(2^n)"
  if g:find("combination") or g:find("choose") or g:find("fixed subset")
    return "@comp.choose / @comp.derive.choose — O(n choose k), controlled exponential subset generation"
  if g:find("permute") or g:find("order")
    return "@comp.permute / @comp.derive.permute — O(n!)"
  if g:find("compose") or g:find("chain") or g:find("nest") or g:find("combine") or g:find("glue")
    return "@comp.each(src, fn) / @comp.chain(src, fn) — composition glue: split any combinator output into fragments, re-expand each; chains any two combinators (closes the algebra)"
  if g:find("module") or g:find("file") or g:find("emit")
    return "@comp.burst → @comp.transcend → @comp.infinity → @comp.hyper"
  if g:find("pipeline") or g:find("fuse")
    return "@comp.pipeline({ variants = ... }) — typed kernel family"
  if g:find("rewrite") or g:find("rule")
    return "@comp.rewrite / @comp.rewrite.bundle — pattern → infinite instances"
  if g:find("template") or g:find("parametric")
    return "@comp.template / @comp.generate — O(n) or O(ops×types) native C fragments; chain with @comp.each"
  if g:find("scheme") or g:find("declarative")
    return "@comp.scheme(declarations, template) — pipe-separated type/fn units → O(units) C"
  if g:find("grammar") or g:find("ebnf") or g:find("language")
    return "@comp.grammar(spec, fn) — O(b^d) EBNF expansion"
  if g:find("weave") or g:find("cross-module") or g:find("cross module")
    return "@comp.weave(module, concept, fn) — O(N×M) cross-module concept sweep"
  if g:find("dedupe") or g:find("duplicate") or g:find("coord")
    return "@comp.agent.dedupe() + read .agents/AGENT_COORDINATION.md; claim before edit"
  if g:find("gap") or g:find("script") or g:find("ergonomic")
    return "@comp.agent.gaps() + .agents/AGENT_COORDINATION.md#cross-agent-gap-buffer; record finding before adding one-off tooling"
  "@comp.map / @comp.sweep — O(types); stack @comp.ceiling / @comp.omni for quadratic+"

build_gates: str = ()
  "tier0: ./zig-out/bin/idol run scripts/public_safety_scan.id && scripts/idol_lock.sh -- ./zig-out/bin/idol run scripts/agent_smoke.id\n" .. "tier1: scripts/idol_lock.sh -- zig build unit-test --summary all\n" .. "tier2: scripts/idol_lock.sh -- zig build test\n" .. "tier3: scripts/idol_lock.sh -- zig build bench  (claim benchmarks/perf; never parallel tier3)"

native_policy: str = ()
  "NO lua_Value intermediaries on typed/comptime paths\n" .. "Hot paths: i64, f64, bool, str, typed records → direct C scalars/structs\n" .. "@comp.* / @meta.* fold at compile time; runtime output is native C\n" .. "Comptime callbacks: @comp.compile.only or comptime-only detection\n" .. "@comp.embed.json / @comp.wasm: module directives → const uint8_t[] globals\n" .. "Ultimate target: optimal machine code, not C-as-ceiling (LTO/PGO/@asm/@device)"

recipes: str = ()
  "N types one macro: @comp.derive.all(\"Concept\", MyDerive)\n" .. "N×M type pairs: @comp.derive.product(\"A\", \"B\", MyDerive)\n" .. "Max file emit: @comp.burst(\"A\", MyDerive, \"B\")\n" .. "User macro: @comp.define.derive(\"Name\", fun generate(meta): str ... end)\n" .. "Bundle traits: @comp.derive.bundle(\"Numeric\") on type\n" .. "Fixed-size subsets: @comp.choose(\"Concept\", 2, fn) — controlled O(n choose k) expansion\n" .. "Pipeline family: @comp.pipeline({ variants = \"name:ctype:init | ...\" })\n" .. "Compose combinators: @comp.each(@comp.power(\"C\", fn), fn2) — chains two exponential stages\n" .. "Constraint cartesian: @comp.generate({ ops/types/template block }) — O(ops×types)\n" .. "Declarative scheme: @comp.scheme(\"type T {...} | fn f(...): T\", template)\n" .. "Generate→each: @comp.each(@comp.generate(spec, body), fn) — re-expand each cartesian fragment\n" .. "Scheme→each: @comp.each(@comp.scheme(decls, tmpl), fn) — declarative units → fragments\n" .. "Full stack: examples/parity/each.id — scheme/generate → each parity\n" .. "Parallel comptime: @comp.compile.thread\n" .. "Coordination: .agents/AGENT_COORDINATION.md; @comp.agent.dedupe(); claim before edit\n" .. "Gaps ledger: .agents/AGENT_COORDINATION.md#cross-agent-gap-buffer; @comp.agent.gaps(); MCP idol_agent_gaps_*\n" .. "Coordination lock: scripts/idol_lock.id"

# GAP-blocked teaching fixtures (idol check fails; owned by other gates):
#   examples/pack/apply.id      — GAP-092 brace/descriptor rows
#   examples/pack/merge.id      — correlated-pack syntax
