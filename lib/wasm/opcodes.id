TYPES = { "i32", "i64", "f32", "f64" }
TYPE_COUNT = 4

INT_CMP = { "eqz", "eq", "ne", "lt_s", "lt_u", "gt_s", "gt_u", "le_s", "le_u", "ge_s", "ge_u" }
FLT_CMP = { "eq", "ne", "lt", "gt", "le", "ge" }
INT_ALU = { "clz", "ctz", "popcnt", "add", "sub", "mul", "div_s", "div_u", "rem_s", "rem_u", "and", "or", "xor", "shl", "shr_s", "shr_u", "rotl", "rotr" }
FLT_ALU = { "abs", "neg", "ceil", "floor", "trunc", "nearest", "sqrt", "add", "sub", "mul", "div", "min", "max", "copysign" }

CMP_BASE = { 69, 80, 91, 97 }
ALU_BASE = { 103, 121, 139, 153 }
CMP_SIZE = { 11, 11, 6, 6 }
ALU_SIZE = { 18, 18, 14, 14 }

CONV_BASE = { 167, 172, 178, 183 }
CONV_I32 = { "wrap_i64", "trunc_f32_s", "trunc_f32_u", "trunc_f64_s", "trunc_f64_u" }
CONV_I64 = { "extend_i32_s", "extend_i32_u", "trunc_f32_s", "trunc_f32_u", "trunc_f64_s", "trunc_f64_u" }
CONV_F32 = { "convert_i32_s", "convert_i32_u", "convert_i64_s", "convert_i64_u", "demote_f64" }
CONV_F64 = { "convert_i32_s", "convert_i32_u", "convert_i64_s", "convert_i64_u", "promote_f32" }

REINTERPRET_BASE = 188

float: i64 = (ty: str)
  if ty == "f32" or ty == "f64"
    return 1
  0

type_index: i64 = (ty: str)
  i: i64 = 1
  while i <= TYPE_COUNT
    if TYPES[i] == ty
      return i
    i += 1
  0

cmp_index: i64 = (ty: str, name: str)
  i: i64 = 1
  if ty:float() == 1
    while i <= 6
      if FLT_CMP[i] == name
        return i - 1
      i += 1
    return -1
  while i <= 11
    if INT_CMP[i] == name
      return i - 1
    i += 1
  -1

alu_index: i64 = (ty: str, name: str)
  i: i64 = 1
  if ty:float() == 1
    while i <= 14
      if FLT_ALU[i] == name
        return i - 1
      i += 1
    return -1
  while i <= 18
    if INT_ALU[i] == name
      return i - 1
    i += 1
  -1

op: i64 = (ty: str, name: str)
  k: i64 = type_index(ty)
  if k == 0
    return -1
  c: i64 = cmp_index(ty, name)
  if c >= 0
    return CMP_BASE[k] + c
  a: i64 = alu_index(ty, name)
  if a >= 0
    return ALU_BASE[k] + a
  end
  -1

cmp_lo: i64 = (ty: str)
  k: i64 = type_index(ty)
  if k == 0
    return -1
  CMP_BASE[k]

cmp_hi: i64 = (ty: str)
  k: i64 = type_index(ty)
  if k == 0
    return -1
  CMP_BASE[k] + CMP_SIZE[k] - 1

alu_lo: i64 = (ty: str)
  k: i64 = type_index(ty)
  if k == 0
    return -1
  ALU_BASE[k]

alu_hi: i64 = (ty: str)
  k: i64 = type_index(ty)
  if k == 0
    return -1
  ALU_BASE[k] + ALU_SIZE[k] - 1

convert_op: i64 = (target: str, name: str)
  k: i64 = type_index(target)
  if k == 0
    return -1
  i: i64 = 1
  if k == 1
    while i <= 5
      if CONV_I32[i] == name
        return CONV_BASE[k] + i - 1
      i += 1
    return -1
  if k == 2
    while i <= 6
      if CONV_I64[i] == name
        return CONV_BASE[k] + i - 1
      i += 1
    return -1
  if k == 3
    while i <= 5
      if CONV_F32[i] == name
        return CONV_BASE[k] + i - 1
      i += 1
    return -1
  while i <= 5
    if CONV_F64[i] == name
      return CONV_BASE[k] + i - 1
    i += 1
  -1

reinterpret_op: i64 = (ty: str)
  k: i64 = type_index(ty)
  if k == 0
    return -1
  REINTERPRET_BASE + k - 1
