# wasm.instruction — Wasm instruction semantic descriptors.
#
# CANONICAL OWNER: src/wasm_semantic.zig (compiler catalog + tests).
# Do NOT add parallel opcode constant tables here. Ward should req this module
# and use semantic ids (wasm.i32.add) instead of duplicating OP_* constants.
#
# P9-05: decoder/validator tables generated in src/wasm_semantic.zig + wasm_semantic_gen.zig

SEMANTIC_OWNER = "src/wasm_semantic.zig"
GENERATOR_OWNER = "src/wasm_semantic_gen.zig"
schema = "wasm-instruction-v0"
MVP_FEATURE = "wasm1.0-mvp"
OPCODE_TABLE_SIZE = 256
DECODER_TABLE_OWNER = "src/wasm_semantic.zig:mvp_opcode_index"
LOOKUP_TABLE_OWNER = "lib/wasm/opcode_lookup.id"

# Bounded MVP count (must match wasm_semantic.zig mvp_instructions.len).
MVP_INSTRUCTION_COUNT = 63

semantic_owner: str = ()
  SEMANTIC_OWNER

generator_owner: str = ()
  GENERATOR_OWNER

schema_version: str = ()
  schema

mvp_feature: str = ()
  MVP_FEATURE

mvp_instruction_count: i64 = ()
  MVP_INSTRUCTION_COUNT

opcode_table_size: i64 = ()
  OPCODE_TABLE_SIZE

decoder_table_owner: str = ()
  DECODER_TABLE_OWNER

lookup_table_owner: str = ()
  LOOKUP_TABLE_OWNER

# Representative semantic ids for tooling smoke (not a duplicate opcode table).
EXAMPLE_IDS = {
  "wasm.unreachable",
  "wasm.i32.const",
  "wasm.i32.add",
  "wasm.i32.load",
  "wasm.call",
  "wasm.return"
}
