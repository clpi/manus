filetype_unknown(): u8
    0
end

filetype_block_device(): u8
    1
end

filetype_character_device(): u8
    2
end

filetype_directory(): u8
    3
end

filetype_regular_file(): u8
    4
end

filetype_socket_dgram(): u8
    5
end

filetype_socket_stream(): u8
    6
end

filetype_symlink(): u8
    7
end

# WASI dircookie (directory entry cookie)
dircookie_start(): u64
    0
end

# WASI clockid constants
clockid_realtime(): u32
    0
end

clockid_monotonic(): u32
    1
end

clockid_process_cputime_id(): u32
    2
end

clockid_thread_cputime_id(): u32
    3
end

# WASI event types for poll_oneoff
eventtype_clock(): u8
    0
end

eventtype_fd_read(): u8
    1
end

eventtype_fd_write(): u8
    2
end

# WASI advice constants
advice_normal(): u8
    0
end

advice_sequential(): u8
    1
end

advice_random(): u8
    2
end

advice_willneed(): u8
    3
end

advice_dontneed(): u8
    4
end

advice_noreuse(): u8
    5
end

# WASI whence (seek origin)
whence_set(): u8
    0
end

whence_cur(): u8
    1
end

whence_end(): u8
    2
end

# WASI signal constants
signal_hup(): u8
    1
end

signal_int(): u8
    2
end

signal_quit(): u8
    3
end

signal_ill(): u8
    4
end

signal_abrt(): u8
    6
end

signal_kill(): u8
    9
end

signal_term(): u8
    15
