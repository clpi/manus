# wasm.wasi — WASI (WebAssembly System Interface) type definitions and bindings
# Maps WASI preview1/preview2 types to Duo-native types for WASM targets.

# WASI errno constants
errno_success(): u16
    0
end

errno_badf(): u16
    8
end

errno_exist(): u16
    20
end

errno_noent(): u16
    44
end

errno_perm(): u16
    63
end

errno_inval(): u16
    28
end

errno_notdir(): u16
    54
end

errno_overflow(): u16
    61
end

# WASI file descriptor types
fd_stdin(): i32
    0
end

fd_stdout(): i32
    1
end

fd_stderr(): i32
    2
end

# WASI rights (capability flags)
right_fd_read(): u64
    1
end

right_fd_write(): u64
    2
end

right_fd_seek(): u64
    4
end

right_fd_fdstat_get(): u64
    16
end

right_poll_oneoff(): u64
    256
end

right_sock_accept(): u64
    65536
end

# WASI lookup flags
lookupflags_symlink_follow(): u32
    1
end

# WASI oflags (open flags)
oflags_creat(): u16
    1
end

oflags_directory(): u16
    2
end

oflags_excl(): u16
    4
end

oflags_trunc(): u16
    8
end

