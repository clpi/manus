# WASI exit code type
exit_success(): u32
    0
end

exit_failure(): u32
    1
end

# WASI dirent type (directory entry)
dirent_type(buf: any, offset: i64): i64
    # dirent structure: u64 d_next, u64 d_ino, u32 d_namlen, u8 d_type, [namlen]u8 name
    # d_type is at offset 16 from start of dirent
    if buf == nil return 0 end
    buf[offset + 16] or 0
end

dirent_name_buf: any, offset: i64:len(): i64
    if buf == nil return 0 end
    buf[offset + 12] or 0
end

# WASI iovec structure helpers
iovec_new(buf: any, buf_len: i64): any
    { buf = buf, buf_len = buf_len }
end

# WASI ciovec structure helpers
ciovec_new(buf: str): any
    { buf = buf, buf_len = buf:len() }
end

# WASI timestamp (nanosecond) utilities
timestamp_now(): u64
    0
end

timestamp_second(): u64
    1000000000
end

timestamp_millisecond(): u64
    1000000
end

timestamp_microsecond(): u64
    1000
end

# WASI prestat helpers (preopened directory descriptor)
prestat_dir_fd(prestat: any): i32
    if prestat == nil return -1 end
    prestat.fd or -1
end

# WASI subscription helpers
subscription_clock(id: u64, timeout: u64, precision: u64, flags: u16): any
    {
        userdata = id,
        type = eventtype_clock(),
        clock_id = clockid_monotonic(),
        timeout = timeout,
        precision = precision,
        flags = flags,
    }
end

subscription_fd_read(fd: i32): any
    {
        userdata = 0,
        type = eventtype_fd_read(),
        fd = fd,
    }
end

