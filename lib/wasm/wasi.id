dirent_type: i64 = (buf: any, offset: i64)
    if buf == nil return 0 
    buf[offset + 16] or 0

dirent_name_len: i64 = (buf: any, offset: i64)
    if buf == nil return 0
    buf[offset + 12] or 0

iovec_new: any = (buf: any, buf_len: i64)
    { buf = buf, buf_len = buf_len }

ciovec_new: any = (buf: str)
    { buf = buf, buf_len = buf:len() }

timestamp_now: u64 = ()
    0

timestamp_second: u64 = ()
    1000000000

timestamp_millisecond: u64 = ()
    1000000

timestamp_microsecond: u64 = ()
    1000

prestat_dir_fd: i32 = (prestat: any)
    if prestat == nil return -1 
    prestat.fd or -1

subscription_clock: any = (id: u64, timeout: u64, precision: u64, flags: u16)
    {
        userdata = id,
        type = eventtype_clock(),
        clock_id = clockid_monotonic(),
        timeout = timeout,
        precision = precision,
        flags = flags,
    }

subscription_fd_read: any = (fd: i32)
    {
        userdata = 0,
        type = eventtype_fd_read(),
        fd = fd,
    }

