# math.stats — Statistical functions
# For ML training metrics and data analysis.

# ═══════════════════════════════════════════════════════════════
# Descriptive Statistics
# ═══════════════════════════════════════════════════════════════

stats_mean: f64 = (data: any)
  if data:len() == 0
    return 0.0
  sum = 0
  for v in data
    sum = sum + v
  sum / data:len()

stats_median: f64 = (data: any)
  if data:len() == 0
    return 0.0
  sorted = {}
  for v in data
    sorted(sorted:len() + 1) = v
  sorted:sort()

  n = sorted:len()
  if n % 2 == 1
    return sorted(n / 2:floor() + 1)
  else
    return (sorted[n / 2] + sorted[n / 2 + 1]) / 2

stats_mode: any = (data: any)
  if data:len() == 0
    return nil

  counts = {}
  for v in data
    counts[v] = (counts[v] or 0) + 1

  max_count = 0
  mode = nil
  for v, count in counts
    if count > max_count
      max_count = count
      mode = v
  { value = mode, count = max_count }

stats_variance: f64 = (data: any, population: bool)
  n = data:len()
  if n == 0
    return 0.0

  mean = stats_mean(data)
  sum_sq = 0
  for v in data
    diff = v - mean
    sum_sq = sum_sq + diff * diff

  if population
    return sum_sq / n
  else
    return sum_sq / (n - 1)

stats_std_dev: f64 = (data: any, population: bool)
  stats_variance(data, population):sqrt()

stats_standardize: any = (data: any)
  mean = stats_mean(data)
  std = stats_std_dev(data, false)
  if std < 0.0000000001
    std = 1

  result = {}
  for v in data
    result(result:len() + 1) = (v - mean) / std
  result

# ═══════════════════════════════════════════════════════════════
# Percentiles & Quartiles
# ═══════════════════════════════════════════════════════════════

stats_percentile: f64 = (data: any, p: f64)
  if data:len() == 0
    return 0.0
  sorted = {}
  for v in data
    sorted(sorted:len() + 1) = v
  sorted:sort()

  k = p / 100 * (sorted:len() - 1)
  f = k:floor()
  c = k:ceil()
  if f == c
    return sorted[f + 1]
  d0 = sorted[f + 1] * (c - k)
  d1 = sorted[c + 1] * (k - f)
  d0 + d1

stats_quartiles: any = (data: any)
  {
    q1 = stats_percentile(data, 25),
    q2 = stats_percentile(data, 50),
    q3 = stats_percentile(data, 75)
  }

stats_iqr: f64 = (data: any)
  q = stats_quartiles(data)
  q.q3 - q.q1

# ═══════════════════════════════════════════════════════════════
# Covariance & Correlation
# ═══════════════════════════════════════════════════════════════

stats_covariance: f64 = (x: any, y: any)
  n = x:len()
  if n == 0 or n != y:len()
    return 0.0

  mean_x = stats_mean(x)
  mean_y = stats_mean(y)

  sum = 0
  for i = 1, n
    sum = sum + (x[i] - mean_x) * (y[i] - mean_y)
  sum / (n - 1)

stats_correlation: f64 = (x: any, y: any)
  cov = stats_covariance(x, y)
  std_x = stats_std_dev(x, false)
  std_y = stats_std_dev(y, false)

  if std_x < 0.0000000001 or std_y < 0.0000000001
    return 0.0
  cov / std_x * std_y

# ═══════════════════════════════════════════════════════════════
# Distribution Functions
# ═══════════════════════════════════════════════════════════════

stats_normal_pdf: f64 = (x: f64, mean: f64, std: f64)
  if std < 0.0000000001
    return 0.0
  z = (x - mean) / std
  1 / std * 2 * math.pi:sqrt() * -0.5 * z * z:exp()

stats_normal_cdf: f64 = (x: f64, mean: f64, std: f64)
  if std < 0.0000000001
    return x >= mean and 1.0 or 0.0
  z = (x - mean) / std
  0.5 * (1 + math.erf(z / 2:sqrt()))

stats_uniform_pdf: f64 = (x: f64, a: f64, b: f64)
  if x < a or x > b
    return 0.0
  1 / (b - a)

stats_uniform_cdf: f64 = (x: f64, a: f64, b: f64)
  if x < a
    return 0.0
  if x > b
    return 1.0
  (x - a) / (b - a)

# ═══════════════════════════════════════════════════════════════
# Histogram
# ═══════════════════════════════════════════════════════════════

stats_histogram: any = (data: any, bins: i64)
  if data:len() == 0
    return { bins = {}, edges = {} }
  if bins == nil
    bins = 10

  min_val = data[1]
  max_val = data[1]
  for v in data
    if v < min_val
      min_val = v
    if v > max_val
      max_val = v

  if min_val == max_val
    return {
      bins = { data:len() },
      edges = { min_val, max_val }
    }

  bin_width = (max_val - min_val) / bins
  counts = {}
  for i = 1, bins
    counts[i] = 0

  for v in data
    bin = (v - min_val) / bin_width:floor() + 1
    if bin > bins
      bin = bins
    counts[bin] = counts[bin] + 1

  edges = {}
  for i = 0, bins
    edges[i + 1] = min_val + i * bin_width

  { bins = counts, edges = edges }

# ═══════════════════════════════════════════════════════════════
# Summary Statistics
# ═══════════════════════════════════════════════════════════════

stats_summary: any = (data: any)
  if data:len() == 0
    return { count = 0 }

  sorted = {}
  for v in data
    sorted(sorted:len() + 1) = v
  sorted:sort()

  {
    count = data:len(),
    min = sorted[1],
    max = sorted(sorted:len()),
    mean = stats_mean(data),
    median = stats_median(data),
    std = stats_std_dev(data, false),
    variance = stats_variance(data, false),
    q1 = stats_percentile(data, 25),
    q3 = stats_percentile(data, 75)
  }

# ═══════════════════════════════════════════════════════════════
# Outlier Detection
# ═══════════════════════════════════════════════════════════════

stats_outliers_iqr: any = (data: any)
  q = stats_quartiles(data)
  iqr = q.q3 - q.q1
  lower = q.q1 - 1.5 * iqr
  upper = q.q3 + 1.5 * iqr

  outliers = {}
  for v in data
    if v < lower or v > upper
      outliers(outliers:len() + 1) = v
  { lower = lower, upper = upper, outliers = outliers }

stats_outliers_zscore: any = (data: any, threshold: f64)
  if threshold == nil
    threshold = 3
  mean = stats_mean(data)
  std = stats_std_dev(data, false)
  if std < 0.0000000001
    return { outliers = {} }

  outliers = {}
  for v in data
    z = (v - mean) / std:abs()
    if z > threshold
      outliers(outliers:len() + 1) =
        value = v
        zscore = z
  { outliers = outliers }

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

M = {}
# Descriptive
M.mean = stats_mean
M.median = stats_median
M.mode = stats_mode
M.variance = stats_variance
M.std_dev = stats_std_dev
M.standardize = stats_standardize
# Percentiles
M.percentile = stats_percentile
M.quartiles = stats_quartiles
M.iqr = stats_iqr
# Correlation
M.covariance = stats_covariance
M.correlation = stats_correlation
# Distributions
M.normal_pdf = stats_normal_pdf
M.normal_cdf = stats_normal_cdf
M.uniform_pdf = stats_uniform_pdf
M.uniform_cdf = stats_uniform_cdf
# Histogram
M.histogram = stats_histogram
# Summary
M.summary = stats_summary
# Outliers
M.outliers_iqr = stats_outliers_iqr
M.outliers_zscore = stats_outliers_zscore
M
