descend: any = (f: any, df: any, x0: f64, lr: f64, iterations: i64)
  x = x0
  history = {
    x
  }
  i = 0
  while i < iterations
    grad = df(x)
    x = x - lr * grad
    history(history:len() + 1) = x
    i = i + 1
  {
    x = x,
    fx = f(x),
    history = history,
    iterations = iterations
  }
adam: any = (f: any, df: any, x0: f64, lr: f64, beta1: f64, beta2: f64, epsilon: f64, iterations: i64)
  if beta1 == nil
    beta1 = 0.9
  if beta2 == nil
    beta2 = 0.999
  if epsilon == nil
    epsilon = 0.00000001
  x = x0
  m = 0
  v = 0
  history = {
    x
  }
  i = 1
  while i <= iterations
    grad = df(x)
    m = beta1 * m + (1 - beta1) * grad
    v = beta2 * v + (1 - beta2) * grad * grad
    mh = m / (1 - beta1 ^ i)
    vh = v / (1 - beta2 ^ i)
    x = x - lr * mh / (vh:sqrt() + epsilon)
    history(history:len() + 1) = x
    i = i + 1
  {
    x = x,
    fx = f(x),
    history = history,
    iterations = iterations
  }
nelder: any = (f: any, x0: any, alpha: f64, gamma: f64, rho: f64, sigma: f64, iterations: i64)
  if alpha == nil
    alpha = 1.0
  if gamma == nil
    gamma = 2.0
  if rho == nil
    rho = 0.5
  if sigma == nil
    sigma = 0.5
  n = x0:len()
  simplex = {}
  simplex(1) = {
    point = x0,
    value = f(x0)
  }
  i = 1
  while i <= n
    point = {}
    j = 1
    while j <= n
      if j == i
        point(j) = x0(j) + 0.05
      else
        point(j) = x0(j)
      j = j + 1
    simplex(simplex:len() + 1) = {
      point = point,
      value = f(point)
    }
    i = i + 1
  iter = 0
  while iter < iterations
    simplex:sort((a: any, b: any) -> any
      a.value < b.value
    )
    best = simplex(1)
    worst = simplex(n + 1)
    centroid = {}
    i = 1
    while i <= n
      centroid(i) = 0
      j = 1
      while j <= n
        centroid(i) = centroid(i) + simplex(j).point(i)
        j = j + 1
      centroid(i) = centroid(i) / n
      i = i + 1
    reflected = {}
    i = 1
    while i <= n
      reflected(i) = centroid(i) + alpha * (centroid(i) - worst.point(i))
      i = i + 1
    rval = f(reflected)
    if rval < simplex(n).value and rval >= best.value
      simplex(n + 1) = {
        point = reflected,
        value = rval
      }
    else(rval < best.value)
      expanded = {}
      i = 1
      while i <= n
        expanded(i) = centroid(i) + gamma * (reflected(i) - centroid(i))
        i = i + 1
      eval = f(expanded)
      if eval < rval
        simplex(n + 1) = {
          point = expanded,
          value = eval
        }
      else
        simplex(n + 1) = {
          point = reflected,
          value = rval
        }
    else
      contracted = {}
      i = 1
      while i <= n
        contracted(i) = centroid(i) + rho * (worst.point(i) - centroid(i))
        i = i + 1
      cval = f(contracted)
      if cval < worst.value
        simplex(n + 1) = {
          point = contracted,
          value = cval
        }
      else
        i = 2
        while i <= n + 1
          j = 1
          while j <= n
            simplex(i).point(j) = best.point(j) + sigma * (simplex(i).point(j) - best.point(j))
            j = j + 1
          simplex(i).value = f(simplex(i).point)
          i = i + 1
    iter = iter + 1
  simplex:sort((a: any, b: any) -> any
    a.value < b.value
  )
  {
    x = simplex(1).point,
    fx = simplex(1).value,
    iterations = iterations
  }
grid: any = (f: any, ranges: any, steps: i64)
  g = {}
  for name, range in ranges
    lo = range(1)
    hi = range(2)
    step = (hi - lo) / (steps - 1)
    points = {}
    i = 0
    while i < steps
      points(points:len() + 1) = lo + i * step
      i = i + 1
    g(name) = points
  best = nil
  bestv = 1000000000000000000000000000000.0
  results = {}
  names = {}
  for name in ranges
    names(names:len() + 1) = name
  if names:len() == 1
    for v in g(names(1))
      params = {
        [names(1)] = v
      }
      value = f(params)
      results(results:len() + 1) = {
        params = params,
        value = value
      }
      if value < bestv
        bestv = value
        best = params
  else(names:len() == 2)
    for v1 in g(names(1))
      for v2 in g(names(2))
        params = {
          [names(1)] = v1,
          [names(2)] = v2
        }
        value = f(params)
        results(results:len() + 1) = {
          params = params,
          value = value
        }
        if value < bestv
          bestv = value
          best = params
  {
    best = best,
    bestv = bestv,
    results = results
  }
random: any = (f: any, ranges: any, iterations: i64)
  best = nil
  bestv = 1000000000000000000000000000000.0
  results = {}
  i = 0
  while i < iterations
    params = {}
    for name, range in ranges
      lo = range(1)
      hi = range(2)
      params(name) = lo + math.random() * (hi - lo)
    value = f(params)
    results(results:len() + 1) = {
      params = params,
      value = value
    }
    if value < bestv
      bestv = value
      best = params
    i = i + 1
  {
    best = best,
    bestv = bestv,
    results = results
  }
line: f64 = (f: any, x: f64, direction: f64, alpha: f64, beta: f64, limit: i64)
  if alpha == nil
    alpha = 0.5
  if beta == nil
    beta = 0.8
  if limit == nil
    limit = 20
  t = 1.0
  fx = f(x)
  i = 0
  while i < limit
    if f(x + t * direction) <= fx + alpha * t * direction
      return t
    t = beta * t
    i = i + 1
  t
