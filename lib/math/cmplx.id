# math.cmplx — complex number support (mirrors Go's math/cmplx)
# Complex numbers as tables {re, im}.

new: any = (re: any, im: any)
  { re = re, im = im }

add: any = (a: any, b: any)
  { re = a.re + b.re, im = a.im + b.im }

sub: any = (a: any, b: any)
  { re = a.re - b.re, im = a.im - b.im }

mul: any = (a: any, b: any)
  { re = a.re * b.re - a.im * b.im, im = a.re * b.im + a.im * b.re }

div: any = (a: any, b: any)
  denom = b.re * b.re + b.im * b.im
  return { re = (a.re * b.re + a.im * b.im) / denom, im = (a.im * b.re - a.re * b.im) / denom }

neg: any = (a: any)
  { re = -a.re, im = -a.im }

conj: any = (a: any)
  { re = a.re, im = -a.im }

abs: any = (a: any)
  a.re * a.re + a.im * a.im:sqrt()

phase: any = (a: any)
  math.atan2(a.im, a.re)

polar: any = (r: any, theta: any)
  { re = r * theta:cos(), im = r * theta:sin() }

rect: any = (r: any, theta: any)
  polar(r, theta)

exp: any = (a: any)
  er = a.re:exp()
  return { re = er * a.im:cos(), im = er * a.im:sin() }

log: any = (a: any)
  r = abs(a)
  theta = phase(a)
  return { re = r:log(), im = theta }

sin: any = (a: any)
  { re = a.re:sin() * a.im:cosh(), im = a.re:cos() * math.sinh(a.im) }

cos: any = (a: any)
  { re = a.re:cos() * a.im:cosh(), im = -a.re:sin() * math.sinh(a.im) }

tan: any = (a: any)
  s = sin(a)
  c = cos(a)
  div(s, c)

sqrt: any = (a: any)
  if a.im == 0 and a.re >= 0
    return { re = a.re:sqrt(), im = 0 }
  r = abs(a)
  return { re = (r + a.re) / 2:sqrt(), im = a.im:sign() * (r - a.re) / 2:sqrt() }

pow: any = (a: any, b: any)
  if b.im == 0 and b.re == b.re:floor()
    n = b.re
    result =
      re = 1
      im = 0
    base =
      re = a.re
      im = a.im
    if n < 0
      base = div({ re = 1, im = 0 }, base)
      n = -n
    for _ = 1, n
      result = mul(result, base)
    return result
  exp(mul(b, log(a)))

nan: bool = (a: any)
  a.re != a.re or a.im != a.im

inf: bool = (a: any)
  a.re == math.huge or a.re == -math.huge or a.im == math.huge or a.im == -math.huge
