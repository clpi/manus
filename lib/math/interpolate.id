# std.math.interpolate — Interpolation and easing functions
# For animations, transitions, and smooth value generation.

# ═══════════════════════════════════════════════════════════════
# Linear Interpolation
# ═══════════════════════════════════════════════════════════════

lerp(a: f64, b: f64, t: f64): f64
    a + (b - a) * t
end

lerp_clamped(a: f64, b: f64, t: f64): f64
    t = 0:max(1:min(t))
    a + (b - a) * t
end

inverse_lerp(a: f64, b: f64, value: f64): f64
    if b - a:abs() < 1e-10 return 0.0 end
    (value - a) / (b - a)
end

remap(value: f64, from_min: f64, from_max: f64, to_min: f64, to_max: f64): f64
    t = inverse_lerp(from_min, from_max, value)
    lerp(to_min, to_max, t)
end

# ═══════════════════════════════════════════════════════════════
# Vector Interpolation
# ═══════════════════════════════════════════════════════════════

lerp_vec2(a: any, b: any, t: f64): any
    {
        x = lerp(a.x, b.x, t),
        y = lerp(a.y, b.y, t),
    }
end

lerp_vec3(a: any, b: any, t: f64): any
    {
        x = lerp(a.x, b.x, t),
        y = lerp(a.y, b.y, t),
        z = lerp(a.z, b.z, t),
    }
end

lerp_vec4(a: any, b: any, t: f64): any
    {
        x = lerp(a.x, b.x, t),
        y = lerp(a.y, b.y, t),
        z = lerp(a.z, b.z, t),
        w = lerp(a.w, b.w, t),
    }
end

lerp_color(a: any, b: any, t: f64): any
    {
        r = lerp(a.r, b.r, t):floor(),
        g = lerp(a.g, b.g, t):floor(),
        b = lerp(a.b, b.b, t):floor(),
    }
end

# ═══════════════════════════════════════════════════════════════
# Spline Interpolation
# ═══════════════════════════════════════════════════════════════

cubic_lerp(a: f64, b: f64, c: f64, d: f64, t: f64): f64
    t2 = t * t
    t3 = t2 * t
    a * (-0.5 * t3 + t2 - 0.5 * t)
        + b * (1.5 * t3 - 2.5 * t2 + 1)
        + c * (-1.5 * t3 + 2 * t2 + 0.5 * t)
        + d * (0.5 * t3 - 0.5 * t2)
end

catmull_rom(points: any, t: f64): f64
    n = points:len()
    if n < 4 return 0.0 end

    segment = t * (n - 1)
    idx = segment:floor()
    frac = segment - idx

    if idx < 0 idx = 0 end
    if idx > n - 4 idx = n - 4 end

    p0 = points[idx + 1]
    p1 = points[idx + 2]
    p2 = points[idx + 3]
    p3 = points[idx + 4]

    cubic_lerp(p0, p1, p2, p3, frac)
end

# ═══════════════════════════════════════════════════════════════
# Easing Functions
# ═══════════════════════════════════════════════════════════════

ease_linear(t: f64): f64
    t
end

ease_in_quad(t: f64): f64
    t * t
end

ease_out_quad(t: f64): f64
    t * (2 - t)
end

ease_in_out_quad(t: f64): f64
    if t < 0.5
        2 * t * t
    else
        -1 + (4 - 2 * t) * t
    end
end

ease_in_cubic(t: f64): f64
    t * t * t
end

ease_out_cubic(t: f64): f64
    t -= 1
    t * t * t + 1
end

ease_in_out_cubic(t: f64): f64
    if t < 0.5
        4 * t * t * t
    else
        (t - 1) * (2 * t - 2) * (2 * t - 2) + 1
    end
end

ease_in_quart(t: f64): f64
    t * t * t * t
end

ease_out_quart(t: f64): f64
    t -= 1
    1 - t * t * t * t
end

ease_in_out_quart(t: f64): f64
    if t < 0.5
        8 * t * t * t * t
    else
        t -= 1
        1 - 8 * t * t * t * t
    end
end

ease_in_expo(t: f64): f64
    if t == 0 return 0.0 end
    2:pow(10 * (t - 1))
end

ease_out_expo(t: f64): f64
    if t == 1 return 1.0 end
    1 - 2:pow(-10 * t)
end

ease_in_out_expo(t: f64): f64
    if t == 0 return 0.0 end
    if t == 1 return 1.0 end
    if t < 0.5
        0.5 * 2:pow(20 * t - 10)
    else
        1 - 0.5 * 2:pow(-20 * t + 10)
    end
end

ease_in_sine(t: f64): f64
    1 - t * math.pi / 2:cos()
end

ease_out_sine(t: f64): f64
    t * math.pi / 2:sin()
end

ease_in_out_sine(t: f64): f64
    -0.5 * (math.pi * t:cos() - 1)
end

ease_in_back(t: f64): f64
    s = 1.70158
    t * t * ((s + 1) * t - s)
end

ease_out_back(t: f64): f64
    s = 1.70158
    t -= 1
    t * t * ((s + 1) * t + s) + 1
end

ease_in_out_back(t: f64): f64
    s = 1.70158 * 1.525
    if t < 0.5
        0.5 * (2 * t) * (2 * t) * ((s + 1) * 2 * t - s)
    else
        t = 2 * t - 2
        0.5 * (t * t * ((s + 1) * t + s) + 2)
    end
end

ease_in_elastic(t: f64): f64
    if t == 0 return 0.0 end
    if t == 1 return 1.0 end
    -2:pow(10 * t - 10) * (t * 10 - 10.75) * (2 * math.pi / 3):sin()
end

ease_out_elastic(t: f64): f64
    if t == 0 return 0.0 end
    if t == 1 return 1.0 end
    2:pow(-10 * t) * (t * 10 - 0.75) * (2 * math.pi / 3):sin() + 1
end

ease_in_out_elastic(t: f64): f64
    if t == 0 return 0.0 end
    if t == 1 return 1.0 end
    if t < 0.5
        -0.5 * 2:pow(20 * t - 10) * (20 * t - 11.125) * (2 * math.pi / 4.5):sin()
    else
        0.5 * 2:pow(-20 * t + 10) * (20 * t - 11.125) * (2 * math.pi / 4.5):sin() + 1
    end
end

ease_out_bounce(t: f64): f64
    if t < 1 / 2.75
        7.5625 * t * t
    elseif t < 2 / 2.75
        t -= 1.5 / 2.75
        7.5625 * t * t + 0.75
    elseif t < 2.5 / 2.75
        t -= 2.25 / 2.75
        7.5625 * t * t + 0.9375
    else
        t -= 2.625 / 2.75
        7.5625 * t * t + 0.984375
    end
end

ease_in_bounce(t: f64): f64
    1 - ease_out_bounce(1 - t)
end

ease_in_out_bounce(t: f64): f64
    if t < 0.5
        0.5 * ease_in_bounce(2 * t)
    else
        0.5 * ease_out_bounce(2 * t - 1) + 0.5
    end
end

# ═══════════════════════════════════════════════════════════════
# Spring Interpolation
# ═══════════════════════════════════════════════════════════════

spring_interpolate(t: f64, damping: f64, frequency: f64): f64
    if damping == nil damping = 0.5 end
    if frequency == nil frequency = 3 end

    decay = -damping * t * 10:exp()
    oscillation = frequency * t * math.pi * 2:cos()
    1 - decay * oscillation
end

spring_overshoot(t: f64, overshoot: f64): f64
    if overshoot == nil overshoot = 1.70158 end
    t -= 1
    t * t * ((overshoot + 1) * t + overshoot) + 1
end

# ═══════════════════════════════════════════════════════════════
# Bezier Curves
# ═══════════════════════════════════════════════════════════════

bezier_quadratic(p0: f64, p1: f64, p2: f64, t: f64): f64
    mt = 1 - t
    mt * mt * p0 + 2 * mt * t * p1 + t * t * p2
end

bezier_cubic(p0: f64, p1: f64, p2: f64, p3: f64, t: f64): f64
    mt = 1 - t
    mt * mt * mt * p0 + 3 * mt * mt * t * p1 + 3 * mt * t * t * p2 + t * t * t * p3
end

# ═══════════════════════════════════════════════════════════════
# Smooth Step
# ═══════════════════════════════════════════════════════════════

smoothstep(edge0: f64, edge1: f64, x: f64): f64
    t = 0:max(1:min((x - edge0) / (edge1 - edge0)))
    t * t * (3 - 2 * t)
end

smootherstep(edge0: f64, edge1: f64, x: f64): f64
    t = 0:max(1:min((x - edge0) / (edge1 - edge0)))
    t * t * t * (t * (6 * t - 15) + 10)
end

smoothstep_derivative(edge0: f64, edge1: f64, x: f64): f64
    t = 0:max(1:min((x - edge0) / (edge1 - edge0)))
    6 * t * (1 - t) / (edge1 - edge0)
end

# ═══════════════════════════════════════════════════════════════
# Noise Interpolation
# ═══════════════════════════════════════════════════════════════

fade(t: f64): f64
    t * t * t * (t * (t * 6 - 15) + 10)
end

lerp_noise(a: f64, b: f64, t: f64): f64
    a + t * (b - a)
end

