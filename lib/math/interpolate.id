# math.interpolate — Interpolation and easing functions
# For animations, transitions, and smooth value generation.

# ═══════════════════════════════════════════════════════════════
# Linear Interpolation
# ═══════════════════════════════════════════════════════════════

lerp: f64 = (a: f64, b: f64, t: f64)
    a + (b - a) * t

clamp: f64 = (a: f64, b: f64, t: f64)
    t = 0:max(1:min(t))
    a + (b - a) * t

unlerp: f64 = (a: f64, b: f64, value: f64)
    if b - a:abs() < 1e-10 return 0.0
    (value - a) / (b - a)

remap: f64 = (value: f64, flo: f64, fhi: f64, tlo: f64, thi: f64)
    t = unlerp(flo, fhi, value)
    lerp(tlo, thi, t)

# ═══════════════════════════════════════════════════════════════
# Vector Interpolation
# ═══════════════════════════════════════════════════════════════

mix = {}
mix.v2 = (a: any, b: any, t: f64): any
    {
        x = lerp(a.x, b.x, t),
        y = lerp(a.y, b.y, t),
    }

mix.v3 = (a: any, b: any, t: f64): any
    {
        x = lerp(a.x, b.x, t),
        y = lerp(a.y, b.y, t),
        z = lerp(a.z, b.z, t),
    }

mix.v4 = (a: any, b: any, t: f64): any
    {
        x = lerp(a.x, b.x, t),
        y = lerp(a.y, b.y, t),
        z = lerp(a.z, b.z, t),
        w = lerp(a.w, b.w, t),
    }

mix.color = (a: any, b: any, t: f64): any
    {
        r = lerp(a.r, b.r, t):floor(),
        g = lerp(a.g, b.g, t):floor(),
        b = lerp(a.b, b.b, t):floor(),
    }

# ═══════════════════════════════════════════════════════════════
# Spline Interpolation
# ═══════════════════════════════════════════════════════════════

cubic: f64 = (a: f64, b: f64, c: f64, d: f64, t: f64)
    t2 = t * t
    t3 = t2 * t
    a * (-0.5 * t3 + t2 - 0.5 * t)
        + b * (1.5 * t3 - 2.5 * t2 + 1)
        + c * (-1.5 * t3 + 2 * t2 + 0.5 * t)
        + d * (0.5 * t3 - 0.5 * t2)

catmull: f64 = (points: any, t: f64)
    n = points:len()
    if n < 4 return 0.0

    segment = t * (n - 1)
    idx = segment:floor()
    frac = segment - idx

    if idx < 0 idx = 0
    if idx > n - 4 idx = n - 4

    p0 = points[idx + 1]
    p1 = points[idx + 2]
    p2 = points[idx + 3]
    p3 = points[idx + 4]

    cubic(p0, p1, p2, p3, frac)

# ═══════════════════════════════════════════════════════════════
# Easing Functions
# ═══════════════════════════════════════════════════════════════

ease = {}
ease.linear = (t: f64): f64
    t

ease.inquad = (t: f64): f64
    t * t

ease.outquad = (t: f64): f64
    t * (2 - t)

ease.inoutquad = (t: f64): f64
    if t < 0.5
        2 * t * t
    else
        -1 + (4 - 2 * t) * t

ease.incubic = (t: f64): f64
    t * t * t

ease.outcubic = (t: f64): f64
    t -= 1
    t * t * t + 1

ease.inoutcubic = (t: f64): f64
    if t < 0.5
        4 * t * t * t
    else
        (t - 1) * (2 * t - 2) * (2 * t - 2) + 1

ease.inquart = (t: f64): f64
    t * t * t * t

ease.outquart = (t: f64): f64
    t -= 1
    1 - t * t * t * t

ease.inoutquart = (t: f64): f64
    if t < 0.5
        8 * t * t * t * t
    else
        t -= 1
        1 - 8 * t * t * t * t

ease.inexpo = (t: f64): f64
    if t == 0 return 0.0
    2:pow(10 * (t - 1))

ease.outexpo = (t: f64): f64
    if t == 1 return 1.0
    1 - 2:pow(-10 * t)

ease.inoutexpo = (t: f64): f64
    if t == 0 return 0.0
    if t == 1 return 1.0
    if t < 0.5
        0.5 * 2:pow(20 * t - 10)
    else
        1 - 0.5 * 2:pow(-20 * t + 10)

ease.insine = (t: f64): f64
    1 - t * math.pi / 2:cos()

ease.outsine = (t: f64): f64
    t * math.pi / 2:sin()

ease.inoutsine = (t: f64): f64
    -0.5 * (math.pi * t:cos() - 1)

ease.inback = (t: f64): f64
    s = 1.70158
    t * t * ((s + 1) * t - s)

ease.outback = (t: f64): f64
    s = 1.70158
    t -= 1
    t * t * ((s + 1) * t + s) + 1

ease.inoutback = (t: f64): f64
    s = 1.70158 * 1.525
    if t < 0.5
        0.5 * (2 * t) * (2 * t) * ((s + 1) * 2 * t - s)
    else
        t = 2 * t - 2
        0.5 * (t * t * ((s + 1) * t + s) + 2)

ease.inelastic = (t: f64): f64
    if t == 0 return 0.0
    if t == 1 return 1.0 end
    -2:pow(10 * t - 10) * (t * 10 - 10.75) * (2 * math.pi / 3):sin()

ease.outelastic = (t: f64): f64
    if t == 0 return 0.0
    if t == 1 return 1.0
    2:pow(-10 * t) * (t * 10 - 0.75) * (2 * math.pi / 3):sin() + 1

ease.inoutelastic = (t: f64): f64
    if t == 0 return 0.0
    if t == 1 return 1.0
    if t < 0.5
        -0.5 * 2:pow(20 * t - 10) * (20 * t - 11.125) * (2 * math.pi / 4.5):sin()
    else
        0.5 * 2:pow(-20 * t + 10) * (20 * t - 11.125) * (2 * math.pi / 4.5):sin() + 1

ease.outbounce = (t: f64): f64
    if t < 1 / 2.75
        7.5625 * t * t
    else(t < 2 / 2.75)
        t -= 1.5 / 2.75
        7.5625 * t * t + 0.75
    else(t < 2.5 / 2.75)
        t -= 2.25 / 2.75
        7.5625 * t * t + 0.9375
    else
        t -= 2.625 / 2.75
        7.5625 * t * t + 0.984375

ease.inbounce = (t: f64): f64
    1 - ease.outbounce(1 - t)

ease.inoutbounce = (t: f64): f64
    if t < 0.5
        0.5 * ease.inbounce(2 * t)
    else
        0.5 * ease.outbounce(2 * t - 1) + 0.5

# ═══════════════════════════════════════════════════════════════
# Spring Interpolation
# ═══════════════════════════════════════════════════════════════

spring = {}
spring.step = (t: f64, damping: f64, frequency: f64): f64
    if damping == nil damping = 0.5
    if frequency == nil frequency = 3

    decay = -damping * t * 10:exp()
    oscillation = frequency * t * math.pi * 2:cos()
    1 - decay * oscillation

spring.over = (t: f64, overshoot: f64): f64
    if overshoot == nil overshoot = 1.70158
    t -= 1
    t * t * ((overshoot + 1) * t + overshoot) + 1

# ═══════════════════════════════════════════════════════════════
# Bezier Curves
# ═══════════════════════════════════════════════════════════════

bezier = {}
bezier.quad = (p0: f64, p1: f64, p2: f64, t: f64): f64
    mt = 1 - t
    mt * mt * p0 + 2 * mt * t * p1 + t * t * p2

bezier.cubic = (p0: f64, p1: f64, p2: f64, p3: f64, t: f64): f64
    mt = 1 - t
    mt * mt * mt * p0 + 3 * mt * mt * t * p1 + 3 * mt * t * t * p2 + t * t * t * p3

# ═══════════════════════════════════════════════════════════════
# Smooth Step
# ═══════════════════════════════════════════════════════════════

smoothstep: f64 = (edge0: f64, edge1: f64, x: f64)
    t = 0:max(1:min((x - edge0) / (edge1 - edge0)))
    t * t * (3 - 2 * t)

smoother: f64 = (edge0: f64, edge1: f64, x: f64)
    t = 0:max(1:min((x - edge0) / (edge1 - edge0)))
    t * t * t * (t * (6 * t - 15) + 10)

slope: f64 = (edge0: f64, edge1: f64, x: f64)
    t = 0:max(1:min((x - edge0) / (edge1 - edge0)))
    6 * t * (1 - t) / (edge1 - edge0)

# ═══════════════════════════════════════════════════════════════
# Noise Interpolation
# ═══════════════════════════════════════════════════════════════

fade: f64 = (t: f64)
    t * t * t * (t * (t * 6 - 15) + 10)

noise: f64 = (a: f64, b: f64, t: f64)
    a + t * (b - a)

