

vec2_new: any = (x: f64, y: f64)
    {x = x, y = y}

vec2_add: any = (a: any, b: any)
    {x = a.x + b.x, y = a.y + b.y}

vec2_sub: any = (a: any, b: any)
    {x = a.x - b.x, y = a.y - b.y}

vec2_scale: any = (v: any, s: f64)
    {x = v.x * s, y = v.y * s}

vec2_dot: f64 = (a: any, b: any)
    a.x * b.x + a.y * b.y

vec2_cross: f64 = (a: any, b: any)
    a.x * b.y - a.y * b.x

vec2_length: f64 = (v: any)
    v.x * v.x + v.y * v.y:sqrt()

vec2_length_squared: f64 = (v: any)
    v.x * v.x + v.y * v.y

vec2_normalize: any = (v: any)
    len = vec2_length(v)
    if len < 1e-10 return {x = 0, y = 0} 
    vec2_scale(v, 1.0 / len)

vec2_distance: f64 = (a: any, b: any)
    vec2_length(vec2_sub(b, a))

vec2_distance_squared: f64 = (a: any, b: any)
    vec2_length_squared(vec2_sub(b, a))

vec2_lerp: any = (a: any, b: any, t: f64)
    {
        x = a.x + (b.x - a.x) * t,
        y = a.y + (b.y - a.y) * t,
    }

vec2_rotate: any = (v: any, angle: f64)
    c = angle:cos()
    s = angle:sin()
    {
        x = v.x * c - v.y * s,
        y = v.x * s + v.y * c,
    }

vec2_perpendicular: any = (v: any)
    {x = -v.y, y = v.x}

vec2_angle: f64 = (a: any, b: any)
    math.atan2(b.y - a.y, b.x - a.x)


point_new: any = (x: f64, y: f64)
    {x = x, y = y}

segment_new: any = (p1: any, p2: any)
    {p1 = p1, p2 = p2}

segment_length: f64 = (seg: any)
    vec2_distance(seg.p1, seg.p2)

segment_midpoint: any = (seg: any)
    {
        x = (seg.p1.x + seg.p2.x) / 2,
        y = (seg.p1.y + seg.p2.y) / 2,
    }

line_new: any = (point: any, direction: any)
    {point = point, direction = direction}

line_from_points: any = (p1: any, p2: any)
    {
        point = p1,
        direction = vec2_normalize(vec2_sub(p2, p1)),
    }

ray_new: any = (origin: any, direction: any)
    {origin = origin, direction = direction}

circle_new: any = (center: any, radius: f64)
    {center = center, radius = radius}

circle_area: f64 = (c: any)
    math.pi * c.radius * c.radius

circle_perimeter: f64 = (c: any)
    2 * math.pi * c.radius

rect_new: any = (x: f64, y: f64, width: f64, height: f64)
    {
        x = x, y = y,
        width = width, height = height,
    }

rect_area: f64 = (r: any)
    r.width * r.height

rect_perimeter: f64 = (r: any)
    2 * (r.width + r.height)

rect_contains_point: bool = (r: any, p: any)
    p.x >= r.x and p.x <= r.x + r.width and
    p.y >= r.y and p.y <= r.y + r.height

rect_intersects: bool = (a: any, b: any)
    a.x < b.x + b.width and a.x + a.width > b.x and
    a.y < b.y + b.height and a.y + a.height > b.y

polygon_new: any = (vertices: any)
    {vertices = vertices}

polygon_area: f64 = (poly: any)
    area = 0
    n = poly.vertices:len()
    i = 1
    while i <= n
        j = (i % n) + 1
        area += poly.vertices[i].x * poly.vertices[j].y
        area -= poly.vertices[j].x * poly.vertices[i].y
        i += 1
    area:abs() / 2

polygon_perimeter: f64 = (poly: any)
    perimeter = 0
    n = poly.vertices:len()
    i = 1
    while i <= n
        j = (i % n) + 1
        perimeter += vec2_distance(poly.vertices[i], poly.vertices[j])
        i += 1
    perimeter

polygon_contains_point: bool = (poly: any, p: any)
    inside = false
    n = poly.vertices:len()
    i = 1
    while i <= n
        j = (i % n) + 1
        if ((poly.vertices[i].y > p.y) != (poly.vertices[j].y > p.y)) and
           (p.x < (poly.vertices[j].x - poly.vertices[i].x) * (p.y - poly.vertices[i].y) / (poly.vertices[j].y - poly.vertices[i].y) + poly.vertices[i].x)
            inside = not inside
        i += 1
    inside


vec3_new: any = (x: f64, y: f64, z: f64)
    {x = x, y = y, z = z}

vec3_add: any = (a: any, b: any)
    {x = a.x + b.x, y = a.y + b.y, z = a.z + b.z}

vec3_sub: any = (a: any, b: any)
    {x = a.x - b.x, y = a.y - b.y, z = a.z - b.z}

vec3_scale: any = (v: any, s: f64)
    {x = v.x * s, y = v.y * s, z = v.z * s}

vec3_dot: f64 = (a: any, b: any)
    a.x * b.x + a.y * b.y + a.z * b.z

vec3_cross: any = (a: any, b: any)
    {
        x = a.y * b.z - a.z * b.y,
        y = a.z * b.x - a.x * b.z,
        z = a.x * b.y - a.y * b.x,
    }

vec3_length: f64 = (v: any)
    v.x * v.x + v.y * v.y + v.z * v.z:sqrt()

vec3_normalize: any = (v: any)
    len = vec3_length(v)
    if len < 1e-10 return {x = 0, y = 0, z = 0} 
    vec3_scale(v, 1.0 / len)

vec3_distance: f64 = (a: any, b: any)
    vec3_length(vec3_sub(b, a))

vec3_lerp: any = (a: any, b: any, t: f64)
    {
        x = a.x + (b.x - a.x) * t,
        y = a.y + (b.y - a.y) * t,
        z = a.z + (b.z - a.z) * t,
    }

plane_new: any = (normal: any, distance: f64)
    {normal = normal, distance = distance}

plane_from_points: any = (p1: any, p2: any, p3: any)
    normal = vec3_normalize(vec3_cross(vec3_sub(p2, p1), vec3_sub(p3, p1)))
    dist = vec3_dot(normal, p1)
    {normal = normal, distance = dist}

plane_distance_to_point: f64 = (plane: any, p: any)
    vec3_dot(plane.normal, p) - plane.distance

aabb_new: any = (min: any, max: any)
    {min = min, max = max}

aabb_center: any = (box: any)
    {
        x = (box.min.x + box.max.x) / 2,
        y = (box.min.y + box.max.y) / 2,
        z = (box.min.z + box.max.z) / 2,
    }

aabb_size: any = (box: any)
    vec3_sub(box.max, box.min)

aabb_contains_point: bool = (box: any, p: any)
    p.x >= box.min.x and p.x <= box.max.x and
    p.y >= box.min.y and p.y <= box.max.y and
    p.z >= box.min.z and p.z <= box.max.z

aabb_intersects: bool = (a: any, b: any)
    a.min.x <= b.max.x and a.max.x >= b.min.x and
    a.min.y <= b.max.y and a.max.y >= b.min.y and
    a.min.z <= b.max.z and a.max.z >= b.min.z

sphere_new: any = (center: any, radius: f64)
    {center = center, radius = radius}

sphere_contains_point: bool = (s: any, p: any)
    vec3_distance(s.center, p) <= s.radius

sphere_intersects_sphere: bool = (a: any, b: any)
    vec3_distance(a.center, b.center) <= a.radius + b.radius


line_segment_intersection: any = (p1: any, p2: any, p3: any, p4: any)
    d1 = vec2_sub(p2, p1)
    d2 = vec2_sub(p4, p3)
    cross = d1.x * d2.y - d1.y * d2.x

    if cross:abs() < 1e-10 return nil 

    t = ((p3.x - p1.x) * d2.y - (p3.y - p1.y) * d2.x) / cross
    u = ((p3.x - p1.x) * d1.y - (p3.y - p1.y) * d1.x) / cross

    if t >= 0 and t <= 1 and u >= 0 and u <= 1
        {
            point = {x = p1.x + t * d1.x, y = p1.y + t * d1.y},
            t = t,
            u = u,
        }

ray_sphere_intersection: any = (ray_origin: any, ray_dir: any, sphere: any)
    oc = vec3_sub(ray_origin, sphere.center)
    a = vec3_dot(ray_dir, ray_dir)
    b = 2 * vec3_dot(oc, ray_dir)
    c = vec3_dot(oc, oc) - sphere.radius * sphere.radius
    discriminant = b * b - 4 * a * c

    if discriminant < 0 return nil 

    t = (-b - discriminant:sqrt()) / (2 * a)
    if t < 0
        t = (-b + discriminant:sqrt()) / (2 * a)
    if t < 0 return nil 

    point = vec3_add(ray_origin, vec3_scale(ray_dir, t))
    {t = t, point = point}

ray_plane_intersection: any = (ray_origin: any, ray_dir: any, plane: any)
    denom = vec3_dot(plane.normal, ray_dir)
    if denom:abs() < 1e-10 return nil 

    t = (plane.distance - vec3_dot(plane.normal, ray_origin)) / denom
    if t < 0 return nil 

    point = vec3_add(ray_origin, vec3_scale(ray_dir, t))
    {t = t, point = point}


triangle_new: any = (v0: any, v1: any, v2: any)
    {v0 = v0, v1 = v1, v2 = v2}

triangle_area: f64 = (tri: any)
    e1 = vec3_sub(tri.v1, tri.v0)
    e2 = vec3_sub(tri.v2, tri.v0)
    0.5 * vec3_length(vec3_cross(e1, e2))

triangle_normal: any = (tri: any)
    e1 = vec3_sub(tri.v1, tri.v0)
    e2 = vec3_sub(tri.v2, tri.v0)
    vec3_normalize(vec3_cross(e1, e2))

triangle_centroid: any = (tri: any)
    {
        x = (tri.v0.x + tri.v1.x + tri.v2.x) / 3,
        y = (tri.v0.y + tri.v1.y + tri.v2.y) / 3,
        z = (tri.v0.z + tri.v1.z + tri.v2.z) / 3,
    }

triangle_barycentric: any = (tri: any, p: any)
    v0 = vec3_sub(tri.v1, tri.v0)
    v1 = vec3_sub(tri.v2, tri.v0)
    v2 = vec3_sub(p, tri.v0)

    d00 = vec3_dot(v0, v0)
    d01 = vec3_dot(v0, v1)
    d11 = vec3_dot(v1, v1)
    d20 = vec3_dot(v2, v0)
    d21 = vec3_dot(v2, v1)

    denom = d00 * d11 - d01 * d01
    if denom:abs() < 1e-10 return nil 

    v = (d11 * d20 - d01 * d21) / denom
    w = (d00 * d21 - d01 * d20) / denom
    u = 1 - v - w

    {u = u, v = v, w = w}


vec2 = {
    new = vec2_new,
    add = vec2_add,
    sub = vec2_sub,
    scale = vec2_scale,
    dot = vec2_dot,
    cross = vec2_cross,
    length = vec2_length,
    length_squared = vec2_length_squared,
    normalize = vec2_normalize,
    distance = vec2_distance,
    distance_squared = vec2_distance_squared,
    lerp = vec2_lerp,
    rotate = vec2_rotate,
    perpendicular = vec2_perpendicular,
    angle = vec2_angle,
}

vec3 = {
    new = vec3_new,
    add = vec3_add,
    sub = vec3_sub,
    scale = vec3_scale,
    dot = vec3_dot,
    cross = vec3_cross,
    length = vec3_length,
    normalize = vec3_normalize,
    distance = vec3_distance,
    lerp = vec3_lerp,
}

