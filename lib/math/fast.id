# math.fast — branchless and intrinsic-backed math primitives
#
# Typed i64/float helpers that lower to branchless C or single-instruction
# intrinsics (@popcount, @clz, @ctz, @rotl).

# Guards, not `if a < b a else b end`. The endless one-liner clause must be
# SELF-DELIMITED, and the trailing `b a` reads as PARENLESS
# APPLICATION # the clause became `a < b(a)`, calling the operand.
#
# `fast_abs` below (`if x < 0 0 - x else x end`) is SAFE: its body begins with
# a numeric literal, so there is no application to mis-parse. The hazard is
# specifically a clause ending in a bare name followed by a body beginning
# with one.
fast_min: i64 = (a: i64, b: i64)
    if a < b
        return a
    b

fast_max: i64 = (a: i64, b: i64)
    if a > b
        return a
    b

minf: float = (a: float, b: float)
    if a < b
        return a
    b

maxf: float = (a: float, b: float)
    if a > b
        return a
    b

fast_abs: i64 = (x: i64)
    return if x < 0 0 - x else x 

absf: float = (x: float)
    return if x < 0.0 0.0 - x else x 

fast_clamp: i64 = (x: i64, lo: i64, hi: i64)
    return if x < lo lo else if x > hi hi else x 

clampf: float = (x: float, lo: float, hi: float)
    return if x < lo lo else if x > hi hi else x 

sign: i64 = (x: i64)
    (x > 0) - (x < 0)

signf: i64 = (x: float)
    if x > 0.0
        return 1
    if x < 0.0
        return -1
    return 0

lerp: float = (a: float, b: float, t: float)
    a + (b - a) * t

lerpi: i64 = (a: i64, b: i64, numer: i64, denom: i64)
    a + (b - a) * numer // denom

fast_popcount: i64 = (x: i64)
    @popcount(x)

fast_clz: i64 = (x: i64)
    return if x == 0 64 else @clz(x) 

fast_ctz: i64 = (x: i64)
    return if x == 0 64 else @ctz(x) 

fast_bit_length: i64 = (x: i64)
    return if x == 0 0 else 64 - @clz(x) 

fast_rotl: i64 = (x: i64, k: i64)
    kk = k & 63
    @rotl(x, kk)

fast_rotr: i64 = (x: i64, k: i64)
    kk = k & 63
    @comp.bit.rotr(x, kk)

ceil2: i64 = (x: i64)
    if x <= 1 return 1 
    v = x - 1
    v |= (v >> 1)
    v |= (v >> 2)
    v |= (v >> 4)
    v |= (v >> 8)
    v |= (v >> 16)
    v |= (v >> 32)
    v + 1

fast_is_pow2: bool = (x: i64)
    x > 0 and (x & (x - 1)) == 0

ceil: i64 = (a: i64, b: i64)
    (a + b - 1) // b

avg: i64 = (a: i64, b: i64)
    (a & b) + (((a | b) - (a & b)) >> 1)

satadd: i64 = (a: i64, b: i64)
    r = a + b
    return if r < a 9223372036854775807 else r 

satsub: i64 = (a: i64, b: i64)
    r = a - b
    return if r > a 0 else r 

mod: i64 = (a: i64, b: i64)
    r = a % b
    if r >= 0 return r 
    mag = b
    if b < 0 mag = 0 - b 
    r + mag

fast_gcd: i64 = (a: i64, b: i64)
    if a < 0 a = 0 - a 
    if b < 0 b = 0 - b 
    while b != 0
        temp = b
        b = a % b
        a = temp
    a

lcm: i64 = (a: i64, b: i64)
    if a == 0 or b == 0 return 0 
    (a // fast_gcd(a, b)) * b
