
M = {}


chacha20_quarter = (state: any, a: i64, b: i64, c: i64, d: i64)
  state[a] = state[a] + state[b]
  state[d] = state[d] ~ state[a]
  state[d] = state[d] << 16 | state[d] >> 16

  state[c] = state[c] + state[d]
  state[b] = state[b] ~ state[c]
  state[b] = state[b] << 12 | state[b] >> 20

  state[a] = state[a] + state[b]
  state[d] = state[d] ~ state[a]
  state[d] = state[d] << 8 | state[d] >> 24

  state[c] = state[c] + state[d]
  state[b] = state[b] ~ state[c]
  state[b] = state[b] << 7 | state[b] >> 25

chacha20_block: any = (key: any, counter: i64, nonce: any)
  state = {
    1702391905,
    1852055603,
    841835129,
    1952784491
  }
  i = 0
  while i < 8
    off = i * 4
    state[state:len() + 1] = key:byte(off + 1) | key:byte(off + 2) << 8 | key:byte(off + 3) << 16 | key:byte(off + 4) << 24
    i = i + 1
  state[state:len() + 1] = counter & 4294967295
  i = 0
  while i < 3
    off = i * 4
    state[state:len() + 1] = nonce:byte(off + 1) | nonce:byte(off + 2) << 8 | nonce:byte(off + 3) << 16 | nonce:byte(off + 4) << 24
    i = i + 1

  working = {}
  for i = 1, 16
    working[i] = state[i]

  round = 0
  while round < 10
    chacha20_quarter(working, 1, 5, 9, 13)
    chacha20_quarter(working, 2, 6, 10, 14)
    chacha20_quarter(working, 3, 7, 11, 15)
    chacha20_quarter(working, 4, 8, 12, 16)
    chacha20_quarter(working, 1, 6, 11, 16)
    chacha20_quarter(working, 2, 7, 12, 13)
    chacha20_quarter(working, 3, 8, 9, 14)
    chacha20_quarter(working, 4, 5, 10, 15)
    round = round + 1

  result = {}
  i = 1
  while i <= 16
    val = (working[i] + state[i]) & 4294967295
    result[result:len() + 1] = val & 255:char()
    result[result:len() + 1] = val >> 8 & 255:char()
    result[result:len() + 1] = val >> 16 & 255:char()
    result[result:len() + 1] = val >> 24 & 255:char()
    i = i + 1
  return result:concat()

chacha20_crypt: str = (key: str, nonce: str, data: str)
  out = {}
  pos = 1
  counter = 1
  nonce12 = nonce
  while nonce12:len() < 12
    nonce12 = nonce12 .. 0:char()

  while pos <= data:len()
    block = chacha20_block(key, counter, nonce12)
    i = 1
    while i <= 64 and pos <= data:len()
      out[out:len() + 1] = data:byte(pos) ~ block:byte(i):char()
      pos = pos + 1
      i = i + 1
    counter = counter + 1
  return out:concat()


hmac_drbg_new: any = (entropy: str, nonce: str, personalization: str)
  V = 0:char():rep(32)
  K = 0:char():rep(32)

  entropy_input = entropy .. nonce .. personalization

  K = crypto.hmac.hmac_sha256_bytes(K, V .. 0:char() .. entropy_input)
  V = crypto.hmac.hmac_sha256_bytes(K, V)

  K = crypto.hmac.hmac_sha256_bytes(K, V .. 1:char() .. entropy_input)
  V = crypto.hmac.hmac_sha256_bytes(K, V)

  {
    v = V,
    k = K,
    reseed_counter = 0
  }

hmac_drbg_generate: str = (state: any, num_bytes: i64)
  temp = {}
  remaining = num_bytes

  while remaining > 0
    state.v = crypto.hmac.hmac_sha256_bytes(state.k, state.v)

    take = remaining
    if take > 32
      take = 32
    temp[temp:len() + 1] = state.v:sub(1, take)
    remaining = remaining - take

  state.reseed_counter = state.reseed_counter + 1
  return temp:concat()

hmac_drbg_reseed = (state: any, entropy: str)
  state.k = crypto.hmac.hmac_sha256_bytes(state.k, state.v .. 0:char() .. entropy)
  state.v = crypto.hmac.hmac_sha256_bytes(state.k, state.v)

  state.k = crypto.hmac.hmac_sha256_bytes(state.k, state.v .. 1:char() .. entropy)
  state.v = crypto.hmac.hmac_sha256_bytes(state.k, state.v)

  state.reseed_counter = 0


random_bytes: str = (n: i64)
  handle = io.popen("cat /dev/urandom 2>/dev/null | head -c " .. n)
  if handle
    data = handle:read(n) or ""
    handle:close()
    if data:len() == n
      return data
  time_seed = to(str)(os.clock()) .. to(str)(os.time()) .. to(str)(1:random(999999))
  key = {}
  i = 1
  while i <= 32
    if i <= time_seed:len()
      key[i] = time_seed:byte(i)
    else
      key[i] = (i * 7 + 13) % 256
    i = i + 1
  nonce = {}
  i = 1
  while i <= 12
    if i <= time_seed:len()
      nonce[i] = time_seed:byte((i - 1) % time_seed:len() + 1) ~ i
    else
      nonce[i] = (i * 11 + 3) % 256
    i = i + 1
  key_str = key:concat("")
  nonce_str = nonce:concat("")
  return chacha20_crypt(key_str, nonce_str, 0:char():rep(n))

random_int: i64 = (min: i64, max: i64)
  range = max - min + 1
  bytes = random_bytes(8)
  val = 0
  i = 0
  while i < 8
    val = val << 8 | bytes:byte(i + 1)
    i = i + 1
  return min + val % range

random_float: f64 = ()
  bytes = random_bytes(8)
  val = 0
  i = 0
  while i < 8
    val = val << 8 | bytes:byte(i + 1)
    i = i + 1
  return val / 18446744073709552000.0


M.chacha20_crypt = chacha20_crypt
M.chacha20_block = chacha20_block
M.hmac_drbg_new = hmac_drbg_new
M.hmac_drbg_generate = hmac_drbg_generate
M.hmac_drbg_reseed = hmac_drbg_reseed
M.random_bytes = random_bytes
M.random_int = random_int
M.random_float = random_float
