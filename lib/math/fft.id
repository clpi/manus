

complex_new: any = (re: f64, im: f64)
  { re = re, im = im }

complex_add: any = (a: any, b: any)
  { re = a.re + b.re, im = a.im + b.im }

complex_sub: any = (a: any, b: any)
  { re = a.re - b.re, im = a.im - b.im }

complex_mul: any = (a: any, b: any)
  {
    re = a.re * b.re - a.im * b.im,
    im = a.re * b.im + a.im * b.re
  }

complex_scale: any = (a: any, s: f64)
  { re = a.re * s, im = a.im * s }

complex_conjugate: any = (a: any)
  { re = a.re, im = -a.im }

complex_abs: f64 = (a: any)
  a.re * a.re + a.im * a.im:sqrt()

complex_phase: f64 = (a: any)
  math.atan2(a.im, a.re)


fft: any = (x: any)
  n = x:len()
  if n == 0
    return {}

  if n & (n - 1) != 0
    new_n = 1
    while new_n < n
      new_n = new_n * 2
    padded = {}
    i = 1
    while i <= n
      padded[i] = x[i]
      i = i + 1
    while padded:len() < new_n
      padded[padded:len() + 1] =
        re = 0
        im = 0
    x = padded
    n = new_n

  if n == 1
    return x

  j = 0
  i = 1
  while i < n
    bit = n >> 1
    while j & bit != 0
      j = j ~ bit
      bit = bit >> 1
    j = j ~ bit

    if i < j
      temp = x[i + 1]
      x[i + 1] = x[j + 1]
      x[j + 1] = temp
    i = i + 1

  length = 2
  while length <= n
    half = length >> 1
    angle = -2 * math.pi / length
    wlen = complex_new(angle:cos(), angle:sin())

    i = 0
    while i < n
      w =
        re = 1
        im = 0
      j = 0
      while j < half
        u = x[i + j + 1]
        t = complex_mul(w, x[i + j + half + 1])
        x[i + j + 1] = complex_add(u, t)
        x[i + j + half + 1] = complex_sub(u, t)
        w = complex_mul(w, wlen)
        j = j + 1
      i = i + length
    length = length * 2

  x


ifft: any = (x: any)
  n = x:len()
  if n == 0
    return {}

  conjugated = {}
  i = 1
  while i <= n
    conjugated[i] = complex_conjugate(x[i])
    i = i + 1

  result = fft(conjugated)

  scaled = {}
  i = 1
  while i <= n
    scaled[i] = complex_scale(complex_conjugate(result[i]), 1.0 / n)
    i = i + 1
  scaled


rfft: any = (signal: any)
  n = signal:len()
  complex_input = {}
  i = 1
  while i <= n
    complex_input[i] = complex_new(signal[i], 0)
    i = i + 1
  fft(complex_input)

irfft: any = (spectrum: any, n: i64)
  if n == nil
    n = spectrum:len()
  result = ifft(spectrum)
  signal = {}
  i = 1
  while i <= n
    signal[i] = result[i].re
    i = i + 1
  signal


power_spectrum: any = (spectrum: any)
  ps = {}
  i = 1
  while i <= spectrum:len()
    ps[i] = complex_abs(spectrum[i]) ^ 2
    i = i + 1
  ps

magnitude_spectrum: any = (spectrum: any)
  mag = {}
  i = 1
  while i <= spectrum:len()
    mag[i] = complex_abs(spectrum[i])
    i = i + 1
  mag

phase_spectrum: any = (spectrum: any)
  phase = {}
  i = 1
  while i <= spectrum:len()
    phase[i] = complex_phase(spectrum[i])
    i = i + 1
  phase


convolve: any = (a: any, b: any)
  n = a:len() + b:len() - 1

  fft_size = 1
  while fft_size < n
    fft_size = fft_size * 2

  fa = {}
  fb = {}
  i = 1
  while i <= fft_size
    if i <= a:len()
      fa[i] = complex_new(a[i], 0)
    else
      fa[i] =
        re = 0
        im = 0
    if i <= b:len()
      fb[i] = complex_new(b[i], 0)
    else
      fb[i] =
        re = 0
        im = 0
    i = i + 1

  fa_fft = fft(fa)
  fb_fft = fft(fb)

  product = {}
  i = 1
  while i <= fft_size
    product[i] = complex_mul(fa_fft(i), fb_fft(i))
    i = i + 1

  result = ifft(product)

  output = {}
  i = 1
  while i <= a:len() + b:len() - 1
    output[i] = result[i].re
    i = i + 1
  output


correlate: any = (a: any, b: any)
  b_rev = {}
  i = b:len()
  while i >= 1
    b_rev[b_rev:len() + 1] = b[i]
    i = i - 1
  convolve(a, b_rev)

autocorrelate: any = (x: any)
  correlate(x, x)


dft: any = (x: any)
  n = x:len()
  result = {}
  k = 0
  while k < n
    sum =
      re = 0
      im = 0
    j = 0
    while j < n
      angle = -2 * math.pi * k * j / n
      w = complex_new(angle:cos(), angle:sin())
      sum = complex_add(sum, complex_mul(x[j + 1], w))
      j = j + 1
    result[k + 1] = sum
    k = k + 1
  result

idft: any = (x: any)
  n = x:len()
  result = {}
  k = 0
  while k < n
    sum =
      re = 0
      im = 0
    j = 0
    while j < n
      angle = 2 * math.pi * k * j / n
      w = complex_new(angle:cos(), angle:sin())
      sum = complex_add(sum, complex_mul(x[j + 1], w))
      j = j + 1
    result[k + 1] = complex_scale(sum, 1.0 / n)
    k = k + 1
  result
