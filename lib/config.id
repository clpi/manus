

deep_get: any = (t: any, key: any)
  if t == nil
    return nil
  parts = key:split(".")
  current = t
  i = 1
  while i <= parts:len()
    if current == nil
      return nil
    current = current(parts(i))
    i = i + 1
  current

deep_has: bool = (t: any, key: any)
  deep_get(t, key) != nil

deep_set = (t: any, key: any, value: any)
  parts = key:split(".")
  current = t
  i = 1
  while i < parts:len()
    if current(parts(i)) == nil
      current(parts(i)) = {}
    current = current(parts(i))
    i = i + 1
  current(parts(parts:len())) = value

deep_merge_into = (dst: any, src: any)
  if src == nil
    return
  for k, v in src
    if type(v) == "table" and type(dst(k)) == "table"
      deep_merge_into(dst(k), v)
    else
      dst(k) = v

collect_keys = (seen: any, out: any, t: any, prefix: any)
  if t == nil
    return
  for k, v in t
    full_key = k
    if prefix:len() > 0
      full_key = prefix .. "." .. k
    if seen(full_key) == nil
      seen(full_key) = true
      if type(v) != "table"
        out(out:len() + 1) = full_key
      else
        collect_keys(seen, out, v, full_key)

deep_copy_flat = (dst: any, prefix: any, src: any)
  if src == nil
    return
  for k, v in src
    full_key = k
    if prefix:len() > 0
      full_key = prefix .. "." .. k
    if type(v) == "table"
      deep_copy_flat(dst, full_key, v)
    else
      if dst(full_key) == nil
        dst(full_key) = v


new: any = (defaults: any)
  if defaults == nil
    defaults = {}
  cfg = {}
  cfg.defaults = defaults
  cfg.values = {}
  cfg.env_prefix = ""
  cfg


get: any = (cfg: any, key: any)
  val = deep_get(cfg.values, key)
  if val != nil
    return val
  deep_get(cfg.defaults, key)

get_or: any = (cfg: any, key: any, fallback: any)
  val = get(cfg, key)
  if val != nil
    return val
  fallback

set = (cfg: any, key: any, value: any)
  deep_set(cfg.values, key, value)

has: bool = (cfg: any, key: any)
  if deep_has(cfg.values, key)
    return true
  deep_has(cfg.defaults, key)


merge = (cfg: any, overlay: any)
  deep_merge_into(cfg.values, overlay)

merge_defaults = (cfg: any, overlay: any)
  deep_merge_into(cfg.defaults, overlay)


set_env_prefix = (cfg: any, prefix: str)
  cfg.env_prefix = prefix

load_env = (cfg: any)
  env_data = env()
  if env_data == nil
    return
  prefix = cfg.env_prefix
  if prefix != nil and prefix:len() > 0
    prefix = prefix .. "_"
  else
    prefix = ""
  prefix_len = prefix:len()
  for k, v in env_data
    if prefix_len > 0
      if k:sub(1, prefix_len) == prefix
        rest = k:sub(prefix_len + 1)
        dot_key = rest:lower()
        dot_key = dot_key:gsub("_", ".")
        deep_set(cfg.values, dot_key, v)


keys: any = (cfg: any)
  seen = {}
  out = {}
  collect_keys(seen, out, cfg.values, "")
  collect_keys(seen, out, cfg.defaults, "")
  out

to_table: any = (cfg: any)
  result = {}
  deep_copy_flat(result, "", cfg.defaults)
  deep_copy_flat(result, "", cfg.values)
  result


require_keys: any = (cfg: any, keys: any)
  missing = {}
  i = 1
  n = 0
  while i <= keys:len()
    if !has(cfg, keys(i))
      n = n + 1
      missing(n) = keys(i)
    i = i + 1
  missing

validate_not_nil: any = (cfg: any, key: any)
  if get(cfg, key) != nil
    return nil
  "missing required config key: " .. key


tostring: str = (cfg: any)
  parts = {}
  all_keys = keys(cfg)
  i = 1
  n = 0
  while i <= all_keys:len()
    val = get(cfg, all_keys(i))
    n = n + 1
    parts(n) = all_keys(i) .. " = " .. val:to(str)
    i = i + 1
  parts:sort()
  parts:concat("\n")
