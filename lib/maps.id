
clone: any = (m: any)
    if m == nil return {} 
    out = {}
    for k, v in m
        out[k] = v
    out

copy: i64 = (dst: any, src: any)
    if dst == nil return 0 
    if src == nil return 0 
    count = 0
    for k, v in src
        dst[k] = v
        count += 1
    count

delete: any = (m: any, k: any)
    if m == nil return nil 
    v = m[k]
    m[k] = nil
    v

equal: bool = (m1: any, m2: any)
    if m1 == nil and m2 == nil return true 
    if m1 == nil or m2 == nil return false 
    c1 = 0
    for _k, _v in m1 do c1 += 1 
    c2 = 0
    for _k, _v in m2 do c2 += 1 
    if c1 != c2 return false 
    for k, v in m1
        if m2[k] != v return false 
    true

equal_func: bool = (m1: any, m2: any, eq: any)
    if m1 == nil and m2 == nil return true 
    if m1 == nil or m2 == nil return false 
    c1 = 0
    for _k, _v in m1 do c1 += 1 
    c2 = 0
    for _k, _v in m2 do c2 += 1 
    if c1 != c2 return false 
    for k, v in m1
        v2 = m2[k]
        if v2 == nil return false 
        if not eq(v, v2) return false 
    true

keys: any = (m: any)
    if m == nil return {} 
    out = {}
    for k, _ in m do out[out:len() + 1] = k 
    out

values: any = (m: any)
    if m == nil return {} 
    out = {}
    for _, v in m do out[out:len() + 1] = v 
    out

entries: any = (m: any)
    if m == nil return {} 
    out = {}
    for k, v in m do out[out:len() + 1] = {key = k, value = v} 
    out

has: bool = (m: any, k: any)
    if m == nil return false 
    m[k] != nil

get: any = (m: any, k: any, dflt: any)
    if m == nil return dflt 
    v = m[k]
    if v == nil return dflt 
    v

set: any = (m: any, k: any, v: any)
    if m == nil m = {} 
    m[k] = v
    m

size: i64 = (m: any)
    if m == nil return 0 
    c = 0
    for _k, _v in m do c += 1 
    c

merge: any = (dst: any, src: any)
    if dst == nil dst = {} 
    if src == nil return dst 
    for k, v in src
        if dst[k] == nil dst[k] = v 
    dst

merge_overwrite: any = (dst: any, src: any)
    if dst == nil dst = {} 
    if src == nil return dst 
    for k, v in src
        dst[k] = v
    dst

