# os home — world table projection only.
# No @c.emit. No lua. Use os.args[n], os.env[key], io:read(path) at call sites.

read_file(path: str): any
    if path == nil
        return ""
    io:read(path)
end

write_file(path: str, data: any): bool
    if path == nil
        return false
    if data == nil
        return false
    io:write(data)
    true
end

getenv(name: str): any
    if name == nil
        return ""
    v = os.env[name]
    if v == nil
        return ""
    v
end

args(): any
    os.args
end
