        return false

    depth = 1
    bracket = 0
    brace = 0
    typed = false
    comma = false
    outer = 0
    names = 0
    inside = 0
    literal = false
    record = false
    infix = false
    closing = 0
    previous = token.kindeof
    while depth > 0
        if index < 0 or index >= count
            return false
        encoded = fact[index * 2 + 1]
        kind = encoded & 255
        line = (encoded >> 8) & 268435455
        if kind == token.kindeof
            return false
        if depth == 1 and bracket == 0 and brace == 0 and token.grammarrole.roleliteral(kind)
            literal = true
        if kind == token.kinddots
            typed = true
        if kind == token.kindcomma and depth == 1
            if previous == token.kindeof
                return false
            comma = true
        if kind == token.kindcolon and depth == 1 and bracket == 0 and brace == 0 and previous == token.kindname
            part = token.kindeof
            following = token.kindeof
            if index + 1 < count
                part = fact[(index + 1) * 2 + 1] & 255
            if index + 2 < count
                following = fact[(index + 2) * 2 + 1] & 255
            if !((part == token.kindname or token.grammarrole.roledescriptor(part)) and following == token.kindlparen)
                typed = true
        if kind == token.kindfun or kind == token.kindfunction
            if depth == 1 and bracket == 0 and brace == 0 and !typed
                return false
        if kind == token.kindlparen
            depth += 1
        elseif kind == token.kindrparen
            depth -= 1
            if depth == 0
                closing = line
        elseif kind == token.kindlbracket
            bracket += 1
        elseif kind == token.kindrbracket
            if bracket > 0
                bracket -= 1
        elseif kind == token.kindlbrace
            if depth == 1 and bracket == 0 and brace == 0
                record = true
            brace += 1
        elseif kind == token.kindrbrace
            if brace > 0
                brace -= 1
        if depth == 1 and bracket == 0 and brace == 0 and kind != token.kindlparen and kind != token.kindrparen
            outer += 1
            if kind == token.kindname
                names += 1
            if token.grammarrole.roleassoc(kind) != 0
                infix = true
        if depth > 0
            inside += 1
        previous = kind
        index += 1

    after = token.kindeof
    line = 0
    column = 0
    if index >= 0 and index < count
        encoded = fact[index * 2 + 1]
        after = encoded & 255
        line = (encoded >> 8) & 268435455
        column = encoded >> 36
    if literal and !typed
        return false
    if infix and !typed
        return false
    if record and !typed
        return false
    result = false
    if after == token.kindcolon
        shape = token.kindeof
        following = token.kindeof
        if index + 1 < count
            shape = fact[(index + 1) * 2 + 1] & 255
        if index + 2 < count
            following = fact[(index + 2) * 2 + 1] & 255
        result = (shape == token.kindname or token.grammarrole.roledescriptor(shape)) and following != token.kindlparen
    if result
        return true
    if typed or after == token.kindarrow or after == token.kindassign
        return true
    if allow and comma
        if after == token.kindeof
            return false
        if after == token.kindcolon
            return result
        if token.grammarrole.roleassoc(after) != 0 or after == token.kinddot
            return false
        return true
    if after == token.kindcolon
        return result
    if token.grammarrole.roleassoc(after) != 0 or after == token.kindcomma
        return false
    if outer == 1 and names == 1 and !typed and !comma
        if !allow
            return false
        if line != closing
            if inside != 1
                return false
            if offside == 0
                return false
            if column <= offside
                return false
            if before == token.kindif or before == token.kindelseif or before == token.kindelse or before == token.kindwhile or before == token.kinduntil or before == token.kindfor or before == token.kindmatch
                return false
    if !allow and !typed
        return false
    if outer == 0 and !allow
        return false
    token.grammarrole.rolebodystart(after)

return_starts_value_lx: i64 = (fact: []i64, count: i64, start: i64, return_line: i64, idol_mode: bool)
    if start < 0 or start >= count
        return 0
    encoded = fact[start * 2 + 1]
    kind = encoded & 255
    nxt_line = (encoded >> 8) & 268435455
    if kind == token.kindend or kind == token.kindelse or kind == token.kindelseif or kind == token.kinduntil or kind == token.kindcatch or kind == token.kindeof or kind == token.kindsemi
        return 0
    if idol_mode and nxt_line != return_line
        return 0
    if idol_mode and !token.grammarrole.rolebeginexpr(kind)
        return 2
    1

_clause: i64 = (fact: []i64, count: i64, start: i64)
    if start < 0 or start >= count
        return 0
    encoded = fact[start * 2 + 1]
    kind = encoded & 255
    lexeme = fact[start * 2 + 2]
    face = 435727459076
    if kind == token.kindname and lexeme == face
        return 2
    if kind == token.kindelse
        return 3
    if !token.grammarrole.rolepattern(kind)
        return 0

    firstline = (encoded >> 8) & 268435455
    depth = 0
    index = start
    while index < count
        encoded = fact[index * 2 + 1]
        kind = encoded & 255
        line = (encoded >> 8) & 268435455
        index += 1
        if kind == token.kindeof or kind == token.kindend or kind == token.kindsemi
            return 0
        if depth == 0 and line != firstline
            return 0
        if kind == token.kindlparen or kind == token.kindlbrace or kind == token.kindlbracket
            depth += 1
        elseif kind == token.kindrparen or kind == token.kindrbrace or kind == token.kindrbracket
            if depth == 0
                return 0
            depth -= 1
        elseif kind == token.kindthen or kind == token.kinddo or kind == token.kindfatarrow
            if depth == 0
                return 1
    0

_ordinal: i64 = (row: str, kind: i64)
    if kind < 0 or kind >= row:len()
        return -1
    code = row:byte(kind + 1)
    if code == 46
        return -1
    if code < 65 or code > 90
        return -1
    code - 65

_layout_verdict: i64 = (offside: bool, open_col: i64, body_col: i64, terminator: bool, line: i64, col: i64)
    if !offside
        return 0
    if col <= open_col
        return 1
    if body_col == 0
        return (col << 8)
    if col == body_col
        return 0
    if terminator
        return 1
    2

