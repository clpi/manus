# compiler.parser — SH-04: a recursive-descent parser in Duo.
#
# Three layers, in increasing fidelity to the production `src/parser.zig`:
#
#   L1  Character-driven expression parser (precedence climbing, mutual
#       recursion, ABI-register record result). This is the part the direct
#       ARM64 backend can lower today, and `eval` (below) is its exported
#       proof entry point — keep it pristine.
#   L2  Token-driven expression parser over the `compiler.lexer` token
#       stream (`next`/`peek`), the interface `src/parser.zig` itself uses.
#   L3  Statement-level recursive descent over the same token stream that
#       produces s-expression syntax-graph projections (the spine of P16-WS5,
#       the syntax graph). This layer moved SH-04 off seed_only.
#
# Bounded-subset grammar (L3), documented against `docs/GRAMMAR_SPEC.md`:
#
#   program := stmt*
#   stmt    := 'fun' NAME '(' params ')' (':' type)? (('=' expr)? block | block)
#            |  NAME '(' params ')' ...            (bare decl — requires a ':'
#            |                                     annotation in params/return;
#            |                                     untyped bare decls need 'fun')
#            |  'if' expr (stmt|elseif|else)* 'end'
#            |  'while' expr stmt* 'end'
#            |  'return' expr?
#            |  '@' directive                       (prefix @)
#            |  NAME ('='|'+='|'-='|'*='|'/='|'%='|'^=') expr
#            |  expr
#   params  := (param (',' param)*)?
#   param   := NAME (':' type)?
#   type    := (NAME | i8..u64 | f32|f64|bool|void|str) ('.' ...)*
#   expr    := or | or 'or' or ...
#            | and 'and' and | cmp (('=='|'!='|'<='|'>='|'<'|'>') cmp)?
#            | add (('+'|'-'|'..') add)* | term (('*'|'/'|'//'|'%') term)*
#            | unary ('-'|'not') unary | postfix
#            | primary ( '(' args ')' | '.' NAME | '@' NAME | STRING )*
#   primary := INT | FLOAT | STRING | NAME | true|false|nil
#            | '(' expr ')' | '{' desc '}' | 'if' expr ... 'end'
#
# s-expression projections (the syntax-graph spine):
#
#   program := (program <stmt>...)
#   name    := <source text>
#   literal := <source text>                 42, 3.5, "hi", true, false, nil
#   binop   := (+ l r) (- l r) (* l r) (/ l r) (// l r) (% l r) (.. l r)
#              (= l r) (!= l r) (< l r) (<= l r) (> l r) (>= l r)
#              (and l r) (or l r) (!x)    (== and != both project as '=')
#   call    := (call <callee> <arg>...)      string-literal sugar included
#   dot     := (dot <base> <name>)
#   assign  := (assign <name> <expr>)        (+= etc.) → (assign-op <op> ...)
#   fun     := (fun <name> (params (param n t)...) (ret <type>)? <body>...)
#   if      := (if <cond> <stmt>... (elseif <cond> <stmt>...)* (else <stmt>...)?)
#   while   := (while <cond> <stmt>...)
#   return  := (return) | (return <expr>)
#   at      := (at <name> <name-or-literal>...)      @comp.c.export("x")
#   anchor  := (anchor <expr> <name>)                postfix foo@bar
#   desc    := (desc <key> <value>...)               { x = 1, y = 2 }
#
# Errors: any grammar violation sets `lx.has_error` and projects a `(error)`
# marker; `parse_status` reports 0 (clean) vs 1 (rejected) so the compile-fail
# corpus is a binary differential. Unsupported-but-valid Duo (match, enum,
# type, @comp.define...) rejects too — that is the bounded-subset boundary.

# A parse result: the value produced, and the position after it.
Res: { val: i64, pos: i64 }

is_digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

skip_spaces: i64 = (src: str, pos: i64)
    n = src:len()
    i = pos
    while i <= n and src:byte(i) == 32
        i += 1
    i

# factor := NUMBER | '(' expr ')'
#
# Mutual recursion with parse_expr: `factor` calls `expr` for a parenthesised
# group, and `expr` calls `factor` through `term`. Proving that mutual recursion
# lowers natively is half the point of this file — a recursive-descent parser is
# nothing but a cycle of such calls.
parse_factor: Res = (src: str, pos: i64)
    n = src:len()
    i = skip_spaces(src, pos)
    if i > n
        return { val = 0, pos = i }
    c = src:byte(i)
    if c == 40
        inner: Res = parse_expr(src, i + 1)
        j = skip_spaces(src, inner.pos)
        if j <= n and src:byte(j) == 41
            return { val = inner.val, pos = j + 1 }
        return { val = inner.val, pos = j }
    acc = 0
    j = i
    while j <= n and is_digit(src:byte(j)) == 1
        acc = acc * 10 + src:byte(j) - 48
        j += 1
    { val = acc, pos = j }

# term := factor (('*' | '/') factor)*
parse_term: Res = (src: str, pos: i64)
    n = src:len()
    left: Res = parse_factor(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = src:byte(i)
        if op == 42
            rhs: Res = parse_factor(src, i + 1)
            acc = acc * rhs.val
            i = skip_spaces(src, rhs.pos)
        if op == 47
            rhs2: Res = parse_factor(src, i + 1)
            acc = acc / rhs2.val
            i = skip_spaces(src, rhs2.pos)
        if op != 42 and op != 47
            return { val = acc, pos = i }
    { val = acc, pos = i }

# expr := term (('+' | '-') term)*
parse_expr: Res = (src: str, pos: i64)
    n = src:len()
    left: Res = parse_term(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = src:byte(i)
        if op == 43
            rhs: Res = parse_term(src, i + 1)
            acc += rhs.val
            i = skip_spaces(src, rhs.pos)
        if op == 45
            rhs2: Res = parse_term(src, i + 1)
            acc -= rhs2.val
            i = skip_spaces(src, rhs2.pos)
        if op != 43 and op != 45
            return { val = acc, pos = i }
    { val = acc, pos = i }


# Native entry point. `parse_expr` returns a record, and a cross-module record
# return has no C ABI export form yet, so a direct-backend caller cannot use it.
# Returning just the value keeps the whole parser reachable from natively
# lowered code: the caller gets an i64 through x0 and the record never crosses
# the module boundary.
# GAP (FF-1): this one declaration stays in the bare form because
# `@comp.c.export` does not attach to a value-form binding — it degrades into a
# runtime call to an undefined `__c_export`. Minimal repro and status in
# the gap register (GAP-12). Every other declaration in this file is
# canonical `name = (params): ret`.
eval: i64 = (src: str)
    r = parse_expr(src, 1)
    return r.val


# ── SH-04 step 2: the same grammar, driven by the TOKEN STREAM ──────────────
#
# Everything above parses characters. That is what kept SH-04 at seed_only:
# a real parser consumes the lexer's tokens, and `std.compiler.lexer` is
# already proven token-for-token equal to `src/lexer.zig` (SH-03). These
# functions are the same precedence-climbing grammar re-expressed over
# `lexer.next` / `lexer.peek`, which is the interface `src/parser.zig` itself
# uses (`pk` / `adv`).
#
#   expr := term (('+' | '-') term)*
#   term := factor (('*' | '/') factor)*
#   factor := INT_LIT | '(' expr ')'
#
# Operator dispatch is on `token.KIND_*` rather than on raw bytes, so adding a
# grammar level is a token-kind edit, not a character comparison.

# `lx: lexer` RESOLVES and `t: token` DOES NOT, and the difference is the whole
# remaining gap. This comment used to claim both failed and that `any` was the
# workaround; re-measured at 2843fad3, `lx: lexer` reaches the emitter and only
# `token` (used by `is_member_name` below) is still an unknown name. `any` is
# never made explicit — inference resolves to a concrete representation or the
# precheck refuses — so the three relations below now say `lexer`, and the one
# genuinely-unresolved cross-home type name is what the ledger reports.

# factor := INT_LIT | '(' expr ')'
# Mutual recursion with parse_expr_tok, exactly as in the character version.
parse_factor_tok: i64 = (lx: lexer)
    t = lexer.next(lx)
    if t.kind == token.kindintlit
        return t.int_val
    if t.kind == token.kindlparen
        v = parse_expr_tok(lx)
        c = lexer.peek(lx)
        if c.kind == token.kindrparen
            _d = lexer.next(lx)
        return v
    0

# term := factor (('*' | '/') factor)*
parse_term_tok: i64 = (lx: lexer)
    acc = parse_factor_tok(lx)
    cont = 1
    while cont == 1
        p = lexer.peek(lx)
        if p.kind == token.kindstar
            _a = lexer.next(lx)
            acc = acc * parse_factor_tok(lx)
        elseif p.kind == token.kindslash
            _b = lexer.next(lx)
            rhs = parse_factor_tok(lx)
            if rhs != 0
                acc = acc / rhs
        else
            cont = 0
    acc

# expr := term (('+' | '-') term)*
parse_expr_tok: i64 = (lx: lexer)
    acc = parse_term_tok(lx)
    cont = 1
    while cont == 1
        p = lexer.peek(lx)
        if p.kind == token.kindplus
            _a = lexer.next(lx)
            acc += parse_term_tok(lx)
        elseif p.kind == token.kindminus
            _b = lexer.next(lx)
            acc -= parse_term_tok(lx)
        else
            cont = 0
    acc

# Token-driven entry point: lex, then parse the token stream.
eval_tokens: i64 = (src: str, family: i64)
    lx = lexer.new(src, "<expr>", family)
    parse_expr_tok(lx)


# ── SH-04 step 3 (L3): statement-level descent + s-expression projections ──
#
# Grammar and projection formats are documented at the top of this file. The
# functions below are a single mutually recursive family: `proj_stmt` dispatches
# on the token kind, block parsers (`proj_body` / `proj_body_until_else`) loop
# `proj_stmt` until a block terminator, and `proj_expr` climbs precedence.
# Everything rides `lexer.next` / `lexer.peek` — no token array, no allocation
# beyond the strings being built.

is_assign_kind: bool = (k: i64)
    if k == token.kindassign or k == token.kindplusassign or k == token.kindminusassign
        return true
    if k == token.kindstarassign or k == token.kindslashassign or k == token.kindpercentassign
        return true
    if k == token.kindcaretassign
        return true
    false

is_type_kind: bool = (k: i64)
    if k == token.kindname
        return true
    if k >= token.kindi8 and k <= token.kindstr
        return true
    false

is_string_kind: bool = (k: i64)
    k == token.kindtextlit or k == token.kindbyteslit or k == token.kindcompattextlit or k == token.kindcompatlongtextlit

# Mark the parse failed. `lx` is the lexer (a table on this path), so the flag
# persists through the recursion and is readable by `parse_status`.
# A parser must terminate on ANY input, including truncated and malformed
# source. Every loop below calls a sub-parser that is *supposed* to consume a
# token; when one does not # at EOF, or on a token no arm handles # the loop
# spins forever with no diagnostic and no output. Comparing the cursor across
# the call makes termination structural instead of depending on every arm being
# right, which is the assumption that actually failed: parsing lib/trace.id
# did not finish in 10 minutes and no single construct reproduced it in
# isolation.
# Progress is `pos` AND `has_peeked` together, never `pos` alone.
#
# `lexer.peek` lexes ahead: it advances `pos` and sets `has_peeked`. Consuming
# that token then clears `has_peeked` WITHOUT moving `pos` again. So a
# one-token statement — `break`, a bare name — leaves `pos` untouched and a
# pos-only check calls it a stall. That fired on every `break` in the corpus
# and cost 33 files when I put the same check in proj_if.
stalled: bool = (lx: lexer, before: i64, peeked: bool)
    # Never at EOF. There the peek cannot advance `pos` and there is no token
    # left to clear `has_peeked`, so a FINAL one-token statement looks stalled
    # and gets dropped: a file whose last line is a bare name and which lacks a
    # trailing newline lost that statement. Every enclosing loop already
    # terminates on EOF, so refusing to fire here cannot reintroduce a spin.
    if token_view.kindat(lx) == token.kindeof
        return false
    lx.pos == before and lx.has_peeked == peeked

# A member name is an ordinary identifier even when the lexer classes it as a
# keyword: `a:match(p)`, `t.type`, `x:next()`. Data always wins the name, so the
# check is spelling, not token class — `match` lexes as its own kind and every
# `:match(...)` call in the corpus was rejected because of it.
is_member_name: bool = (t: token)
    if t.text:len() == 0
        return false
    c: i64 = t.text:byte(1)
    is_ident_start_byte(c)

is_ident_start_byte: bool = (c: i64)
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

markerr = (lx: lexer)
    # Record WHERE the parse first went wrong, not just that it did. A bare
    # boolean makes `parse_status` a yes/no oracle, which is enough to gate a
    # 55-case corpus and useless for driving coverage up: with 201 of 245
    # lib/std files rejected, the only question that matters is which construct
    # stopped each one. Only the first is kept — later marks are downstream of
    # the first and would just name recovery noise.
    if !lx.has_error
        lx.error_loc = lexer.peek(lx).loc
    lx.has_error = true

# Line of the first parse failure, or 0 when the source parses clean.
parse_error_line: i64 = (src: str, file: str, family: i64)
    lx: lexer = lexer.new(src, file, family)
    _p = proj_program_lx(lx)
    if lx.has_error
        return lx.error_loc.line
    0

# `;` is a separator, not a statement. Skipped by the block loops rather than
# by proj_stmt: proj_stmt returns "" to mean "end of block", so a trailing `x =
# 1;` would consume the `;`, hit EOF, return "" and be reported as an error.
skipsemi = (lx: lexer)
    while token_view.kindat(lx) == token.kindsemi
        _s = lexer.next(lx)

# Two-token lookahead, via the lexer's own save/restore state.
peek2: token = (lx: lexer)
    st = lexer.save_state(lx)
    _a = lexer.next(lx)
    t = lexer.peek(lx)
    lexer.restore_state(lx, st)
    t

# GAP-134 callable/header slice. The production entry below observes the compact
# producer pack; the cursor relation is retained only as the artifact oracle.
is_infix_kind: bool = (k: i64)
    token.grammarrole.roleassoc(k) != 0

can_start_body_kind: bool = (k: i64)
    token.grammarrole.rolebodystart(k)

is_descriptor_kind: bool = (k: i64)
    token.grammarrole.roledescriptor(k) or is_type_kind(k)


# Cursor immediately after `:`. True when the next two identities are `name (`
# — a subject face call rather than a type slot.
colon_is_method_call_lx: bool = (lx: lexer)
    # `paren_header_signal_lx` has consumed the colon; observe the member and the token
    # after it, then restore the exact post-colon cursor.
    st = lexer.save_state(lx)
    m = lexer.peek(lx)
    p2 = peek2(lx)
    is_ty = m.kind == token.kindname or is_descriptor_kind(m.kind)
    is_call = p2.kind == token.kindlparen
    lexer.restore_state(lx, st)
    is_ty and is_call

# Production callable-header recognition over the immutable producer pack.
# Each token contributes metadata (kind[8], line[28], column[27]) followed by a
# raw short-lexeme fact. `start` is the zero-based producer coordinate; one
# physical padding slot preserves Idol's one-based sequence projection at C ABI.
header_signal_lx: bool = (fact: []i64, count: i64, start: i64, allow: bool, offside: i64, before: i64)
    if start < 0 or start >= count
        return false
    encoded = fact[start * 2 + 1]
    if (encoded & 255) != token.kindlparen
        return false
    index = start + 1
    if index < count and (fact[index * 2 + 1] & 255) == token.kindlparen
        return false

    depth = 1
    bracket = 0
    brace = 0
    typed = false
    comma = false
    outer = 0
    names = 0
    inside = 0
    literal = false
    record = false
    infix = false
    closing = 0
    previous = token.kindeof
    while depth > 0
        if index < 0 or index >= count
            return false
        encoded = fact[index * 2 + 1]
        kind = encoded & 255
        line = (encoded >> 8) & 268435455
        if kind == token.kindeof
            return false
        if depth == 1 and bracket == 0 and brace == 0 and token.grammarrole.roleliteral(kind)
            literal = true
        if kind == token.kinddots
            typed = true
        if kind == token.kindcomma and depth == 1
            if previous == token.kindeof
                return false
            comma = true
        if kind == token.kindcolon and depth == 1 and bracket == 0 and brace == 0 and previous == token.kindname
            part = token.kindeof
            following = token.kindeof
            if index + 1 < count
                part = fact[(index + 1) * 2 + 1] & 255
            if index + 2 < count
                following = fact[(index + 2) * 2 + 1] & 255
            if !((part == token.kindname or token.grammarrole.roledescriptor(part)) and following == token.kindlparen)
                typed = true
        if kind == token.kindfun or kind == token.kindfunction
            if depth == 1 and bracket == 0 and brace == 0 and !typed
                return false
        if kind == token.kindlparen
            depth += 1
        elseif kind == token.kindrparen
            depth -= 1
            if depth == 0
                closing = line
        elseif kind == token.kindlbracket
            bracket += 1
        elseif kind == token.kindrbracket
            if bracket > 0
                bracket -= 1
        elseif kind == token.kindlbrace
            if depth == 1 and bracket == 0 and brace == 0
                record = true
            brace += 1
        elseif kind == token.kindrbrace
            if brace > 0
                brace -= 1
        if depth == 1 and bracket == 0 and brace == 0 and kind != token.kindlparen and kind != token.kindrparen
            outer += 1
            if kind == token.kindname
                names += 1
            if token.grammarrole.roleassoc(kind) != 0
                infix = true
        if depth > 0
            inside += 1
        previous = kind
        index += 1

    after = token.kindeof
    line = 0
    column = 0
    if index >= 0 and index < count
        encoded = fact[index * 2 + 1]
        after = encoded & 255
        line = (encoded >> 8) & 268435455
        column = encoded >> 36
    if literal and !typed
        return false
    if infix and !typed
        return false
    if record and !typed
        return false
    result = false
    if after == token.kindcolon
        shape = token.kindeof
        following = token.kindeof
        if index + 1 < count
            shape = fact[(index + 1) * 2 + 1] & 255
        if index + 2 < count
            following = fact[(index + 2) * 2 + 1] & 255
        result = (shape == token.kindname or token.grammarrole.roledescriptor(shape)) and following != token.kindlparen
    if result
        return true
    if typed or after == token.kindarrow or after == token.kindassign
        return true
    if allow and comma
        if after == token.kindeof
            return false
        if after == token.kindcolon
            return result
        if token.grammarrole.roleassoc(after) != 0 or after == token.kinddot
            return false
        return true
    if after == token.kindcolon
        return result
    if token.grammarrole.roleassoc(after) != 0 or after == token.kindcomma
        return false
    if outer == 1 and names == 1 and !typed and !comma
        if !allow
            return false
        if line != closing
            if inside != 1
                return false
            if offside == 0
                return false
            if column <= offside
                return false
            if before == token.kindif or before == token.kindelseif or before == token.kindelse or before == token.kindwhile or before == token.kinduntil or before == token.kindfor or before == token.kindmatch
                return false
    if !allow and !typed
        return false
    if outer == 0 and !allow
        return false
    token.grammarrole.rolebodystart(after)

# Production return-value decision over the immutable producer pack.
# `start` is the zero-based producer coordinate of the token immediately
# after the `return` keyword. `return_line` is the line of the `return`
# keyword itself. Returns:
#   0 — no value (the next kind is a line-terminator, or `.id` mode saw a
#       cross-line next token, or `start` is past the pack)
#   1 — a value expression follows
#   2 — the next kind cannot begin an expression in `.id` mode; the host
#       carries that into a diagnostic
# The 0/1/2 split lets the host emit its own diagnostic on the 2 path
# without re-decoding the producer pack; the 0 path is silent because
# `return` followed by `end` / `else` / `elseif` / `until` / `catch` /
# `eof` / `semi` is the bare `return` form and not an error.
return_starts_value_lx: i64 = (fact: []i64, count: i64, start: i64, return_line: i64, idol_mode: bool)
    if start < 0 or start >= count
        return 0
    encoded = fact[start * 2 + 1]
    kind = encoded & 255
    nxt_line = (encoded >> 8) & 268435455
    if kind == token.kindend or kind == token.kindelse or kind == token.kindelseif or kind == token.kinduntil or kind == token.kindcatch or kind == token.kindeof or kind == token.kindsemi
        return 0
    if idol_mode and nxt_line != return_line
        return 0
    if idol_mode and !token.grammarrole.rolebeginexpr(kind)
        return 2
    1

# Production match-arm classification over the immutable producer pack.
# Each token contributes metadata followed by one raw short-lexeme fact. The
# host copies at most six producer bytes and a length marker; it assigns no word
# role. This relation owns contextual `case` as well as nesting/separator rules.
# Returns 0 (not an arm), 1 (ordinary pattern), 2 (`case` face), or 3 (`else`).
_clause: i64 = (fact: []i64, count: i64, start: i64)
    if start < 0 or start >= count
        return 0
    encoded = fact[start * 2 + 1]
    kind = encoded & 255
    lexeme = fact[start * 2 + 2]
    # Physical short-word encoding: length 4, then the producer bytes c/a/s/e.
    # 435727459076 = 4 | 99<<8 | 97<<16 | 115<<24 | 101<<32.
    # The artifact derives this fact by tokenizing `case`; a producer change
    # therefore fails the executable clause probe rather than silently drifting.
    face = 435727459076
    # Contextual `case` precedes rolepattern deliberately: its token identity is
    # `name`, while the parser relation — not Zig — assigns the contextual face.
    if kind == token.kindname and lexeme == face
        return 2
    if kind == token.kindelse
        return 3
    if !token.grammarrole.rolepattern(kind)
        return 0

    firstline = (encoded >> 8) & 268435455
    depth = 0
    index = start
    while index < count
        encoded = fact[index * 2 + 1]
        kind = encoded & 255
        line = (encoded >> 8) & 268435455
        index += 1
        if kind == token.kindeof or kind == token.kindend or kind == token.kindsemi
            return 0
        if depth == 0 and line != firstline
            return 0
        if kind == token.kindlparen or kind == token.kindlbrace or kind == token.kindlbracket
            depth += 1
        elseif kind == token.kindrparen or kind == token.kindrbrace or kind == token.kindrbracket
            if depth == 0
                return 0
            depth -= 1
        elseif kind == token.kindthen or kind == token.kinddo or kind == token.kindfatarrow
            if depth == 0
                return 1
    0

# Owner-projected ordinal row. `.` is absence; `A` is ordinal zero. The row is
# a physical projection of token.id's one relation order, not another order.
_ordinal: i64 = (row: str, kind: i64)
    if kind < 0 or kind >= row:len()
        return -1
    code = row:byte(kind + 1)
    if code == 46
        return -1
    if code < 65 or code > 90
        return -1
    code - 65

# Layout verdict at a statement boundary — keep the body open, close the
# block, or refuse the line as a mis-indent. The relation consumes the
# physical frame the opener left behind plus the event's settled terminator
# fact and current line/column, and returns a packed i64:
#
#     bits 0..1   verdict (0 = keep, 1 = close, 2 = misindent)
#     bits 8..35  body_col (only meaningful when verdict = keep and the
#                 block's body column was not yet established; the host
#                 `layout_verdict` mutated `f.body_col` on that path, and
#                 the relation returns the updated value so the Zig frame
#                 can adopt it without re-deciding)
#
# The rule sequence is: no offside frame ⇒ always keep; column left of
# the opener ⇒ close; body column not yet established ⇒ set it from this
# token and keep; exact body column ⇒ keep; terminator identity ⇒ close;
# ordinary identity ⇒ misindent. The host `layout_verdict` carried the
# same sequence; the whole-pack event now supplies the terminator bit.
_layout_verdict: i64 = (offside: bool, open_col: i64, body_col: i64, terminator: bool, line: i64, col: i64)
    if !offside
        return 0
    if col <= open_col
        return 1
    if body_col == 0
        return (col << 8)
    if col == body_col
        return 0
    if terminator
        return 1
    2

# Static parser facts for the complete immutable producer pack. One output word
# per token: bits 0..4 direct statement face; bits 5..8 source-family admission;
# bit 9 member; bit 10 boundary; bits 11..12 branch face (1 elseif, 2 else);
# bit 13 return; bit 14 end; bit 15 layout terminator; bit 16 empty terminator.
# Lane two carries clause bits 0..1, return bits 2..3, callable-header bits 4..5,
# and the contextual `type` alias head in bit 6. A qualifying callable header
# propagates the bare declaration head to bit 7 on its starting name coordinate.
# Bit 8 carries assignment-body recognition, bits 9..12 carry the attributed
# declaration face, and bits 13..63 carry the exclusive matching-parenthesis
# boundary.
# Capacity refusal precedes every mutation.
event: i64 = (fact: []i64, count: i64, out: []i64, capacity: i64, idol: bool)
    if count < 0 or capacity < 0 or count > capacity / 2
        return -1
    statements: str = token.grammarrole.statement()
    admissions: str = token.grammarrole.admission()
    members: str = token.grammarrole.member()
    boundaries: str = token.grammarrole.boundary()
    branches: str = token.grammarrole.branch()
    terminators: str = token.grammarrole.layoutterminator()
    empties: str = token.grammarrole.emptybodyterminator()
    prefixes: str = token.grammarrole.prefix()
    demands: str = token.grammarrole.demand()
    leads: str = token.grammarrole.lead()
    literals: str = token.grammarrole.literal()
    quoteds: str = token.grammarrole.quoted()
    relations: str = token.grammarrole.relation()
    unaries: str = token.grammarrole.unary()
    before = 0
    opener = 0
    prior = token.kindeof
    index = 0
    while index < count
        encoded = fact[index * 2 + 1]
        kind = encoded & 255
        line = (encoded >> 8) & 268435455
        dispatch: i64 = 0
        if kind >= 0 and kind < statements:len()
            statementmark: i64 = statements:byte(kind + 1)
            if statementmark >= 65 and statementmark <= 87
                dispatch = statementmark - 65
        admission: i64 = 0
        if kind >= 0 and kind < admissions:len()
            admissionmark: i64 = admissions:byte(kind + 1)
            if admissionmark >= 65 and admissionmark <= 73
                choice = admissionmark - 65
                if choice == 1 or idol
                    admission = choice
        member: i64 = 0
        if kind >= 0 and kind < members:len() and members:byte(kind + 1) == 49
            member = 1
        boundaryface: i64 = 0
        if kind >= 0 and kind < boundaries:len() and boundaries:byte(kind + 1) == 49
            boundaryface = 1
        branchface: i64 = 0
        if kind >= 0 and kind < branches:len() and branches:byte(kind + 1) == 49
            if kind == token.kindelseif
                branchface = 1
            else
                branchface = 2
        returns: i64 = 0
        if kind == token.kindreturn
            returns = 1
        ending: i64 = 0
        if kind == token.kindend
            ending = 1
        terminator: i64 = 0
        if kind >= 0 and kind < terminators:len() and terminators:byte(kind + 1) == 49
            terminator = 1
        empty: i64 = 0
        if kind >= 0 and kind < empties:len() and empties:byte(kind + 1) == 49
            empty = 1
        primitive: i64 = 0
        if kind >= 0 and token.grammarrole.roledescriptor(kind)
            primitive = 1
        primary: i64 = 0
        if kind == token.kindname or kind == token.kindintlit or kind == token.kindfloatlit or kind == token.kindstar or kind == token.kindquestion
            primary = 1
        literal: i64 = 0
        if kind >= 0 and kind < literals:len() and literals:byte(kind + 1) == 49
            literal = 1
        quoted: i64 = 0
        if kind >= 0 and kind < quoteds:len() and quoteds:byte(kind + 1) == 49
            quoted = 1
        prefixface: i64 = 0
        if kind >= 0 and kind < prefixes:len() and prefixes:byte(kind + 1) == 49
            prefixface = 1
        demandface: i64 = 0
        if kind >= 0 and kind < demands:len() and demands:byte(kind + 1) == 49
            demandface = 1
        visible = kind >= 0 and kind < token.kindshebang
        if visible and line != before
            opener = encoded >> 36
        leadface: i64 = 0
        if visible and line != before and kind < leads:len() and leads:byte(kind + 1) == 49
            leadface = 1
        infix: i64 = 0
        unaryface: i64 = 0
        glueface: i64 = 0
        updateface: i64 = 0
        layouttype: i64 = 0
        if kind >= 0 and kind < statements:len()
            relation = _ordinal(relations, kind)
            unary = _ordinal(unaries, kind)
            if unary >= 0
                unaryface = unary + 1
            if token.grammarrole._roleglue(kind) and relation >= 0
                glueface = relation + 1
            if token.grammarrole._roleupdate(kind) and relation >= 0
                updateface = relation + 1
            if token.grammarrole._roleinfix(kind) and relation >= 0
                prec: i64 = token.grammarrole.roleprecedence(kind)
                assoc: i64 = token.grammarrole.roleassoc(kind)
                if prec > 0 and assoc > 0
                    right = prec
                    if assoc == 1
                        right = prec + 1
                    if assoc == 2
                        right = prec - 1
                    infix = relation | (prec << 8) | (right << 16)
        if primitive == 1 or kind == token.kindstar or kind == token.kindquestion or kind == token.kindlbracket or kind == token.kindlbrace
            layouttype = 1
        if kind == token.kindname
            word = fact[index * 2 + 2]
            first = (word >> 8) & 255
            if first >= 65 and first <= 90
                layouttype = 1
        # The try-body consumer has three actions: parse an ordinary statement,
        # stop at one of the six layout terminators, or parse return and stop.
        # Preserve the settled action in the existing return/terminator bits so
        # no third event lane or downstream token-kind switch is needed.
        attempt = 0
        if terminator == 1
            attempt = 1
        if returns == 1
            attempt = 2
        returns = attempt >> 1
        terminator = attempt & 1
        out[index] = dispatch | (admission << 5) | (member << 9) | (boundaryface << 10) | (branchface << 11) | (returns << 13) | (ending << 14) | (terminator << 15) | (empty << 16) | (primitive << 17) | (literal << 18) | (quoted << 19) | (prefixface << 20) | (demandface << 21) | (leadface << 22) | (infix << 23) | (unaryface << 47) | (glueface << 52) | (updateface << 57) | (primary << 61) | (layouttype << 62)
        clauseface = _clause(fact, count, index)
        returnface = return_starts_value_lx(fact, count, index, before, idol)
        head = 0
        if kind == token.kindname and fact[index * 2 + 2] == 435678704644
            following = token.kindeof
            if index + 1 < count
                following = fact[(index + 1) * 2 + 1] & 255
            if following != token.kindlparen
                head = 1
        assignment = 0
        if kind == token.kindname
            cursor = index + 1
            while cursor + 1 < count and (fact[cursor * 2 + 1] & 255) == token.kinddot and (fact[(cursor + 1) * 2 + 1] & 255) == token.kindname
                cursor += 2
            if cursor < count
                candidate = fact[cursor * 2 + 1]
                face = candidate & 255
                if face == token.kindassign or token.grammarrole._roleupdate(face)
                    assignment = 1
                elseif token.grammarrole._roleglue(face) and cursor + 1 < count
                    following = fact[(cursor + 1) * 2 + 1]
                    if (following & 255) == token.kindassign
                        line = (candidate >> 8) & 268435455
                        column = candidate >> 36
                        width = fact[cursor * 2 + 2] & 255
                        nextline = (following >> 8) & 268435455
                        nextcolumn = following >> 36
                        if nextline == line and nextcolumn == column + width
                            assignment = 1
        declaration = 0
        if kind == token.kindfunction or kind == token.kindfun
            declaration = 1
        elseif kind == token.kindasync
            declaration = 2
        elseif kind == token.kindenum
            declaration = 3
        elseif kind == token.kindconcept
            declaration = 4
        elseif kind == token.kindalias
            declaration = 5
        elseif kind == token.kindlocal
            declaration = 6
        elseif kind == token.kindglobal
            declaration = 11
        elseif kind == token.kindfor
            declaration = 7
        elseif kind == token.kindat
            declaration = 12
        elseif kind == token.kindname
            following = token.kindeof
            if index + 1 < count
                following = fact[(index + 1) * 2 + 1] & 255
            if head == 1 or following == token.kindcolon
                declaration = 8
        if prior == token.kindlt and kind == token.kindname
            declaration = 9
        elseif prior == token.kindlt and kind == token.kindconst
            declaration = 10
        if !visible
            declaration = 15
        delimiter = 0
        if kind == token.kindlparen
            depth = 1
            probe = index + 1
            while probe < count and depth > 0
                part = fact[probe * 2 + 1] & 255
                if part == token.kindlparen
                    depth += 1
                elseif part == token.kindrparen
                    depth -= 1
                probe += 1
            if depth == 0
                delimiter = probe
        offside: i64 = 0
        if idol
            offside = opener
        headerplain: i64 = 0
        headercomma: i64 = 0
        if kind == token.kindlparen
            if header_signal_lx(fact, count, index, false, offside, prior)
                headerplain = 1
            if header_signal_lx(fact, count, index, true, offside, prior)
                headercomma = 1
        out[count + index] = clauseface | (returnface << 2) | (headerplain << 4) | (headercomma << 5) | (head << 6) | (assignment << 8) | (declaration << 9) | (delimiter << 13)
        if headerplain == 1 and index > 0
            start = index - 1
            if (fact[start * 2 + 1] & 255) == token.kindname
                if start >= 2 and (fact[(start - 1) * 2 + 1] & 255) == token.kindcolon and (fact[(start - 2) * 2 + 1] & 255) == token.kindname
                    start -= 2
                while start >= 2 and (fact[(start - 1) * 2 + 1] & 255) == token.kinddot and (fact[(start - 2) * 2 + 1] & 255) == token.kindname
                    start -= 2
                out[count + start] = out[count + start] | (1 << 7)
        if visible
            before = line
            prior = kind
        index += 1
    count

# One complete block-boundary relation. With `opening`, it returns the physical
# layout frame: bit 0 offside, bit 2 inline, bits 8..35 opener column, and bits
# 36..63 body column. Otherwise bits 0..1 are the loop action (0 parse statement,
# 1 close, 2 misindent, 3 parse return and close); bits 2..3 carry the clause face;
# bits 4..6 carry written closure; bits 8..35 carry the possibly established body
# column. Static token facts travel in the one whole-pack `event` output.
boundary: i64 = (opening: bool, count: i64, offside: bool, open_line: i64, open: i64, body: i64, edge: i64, line: i64, before: i64, col: i64, idol: bool)
    if opening
        if !idol
            return 0
        if open_line == 0 or open == 0
            return 0
        if ((edge >> 15) & 1) == 1
            return open << 8
        if line == open_line
            return 1 | (1 << 2) | (open << 8)
        if line > open_line and col > open
            return 1 | (open << 8) | (col << 36)
        return open << 8
    column = body
    ending = ((edge >> 14) & 1) == 1
    closing: i64 = 4
    if ending
        closing = 1
        if offside and line != before and col > open
            closing = 2
        if offside and line != before and col < open
            closing = 0
    elseif offside
        closing = 0
    elseif idol
        closing = 3
    sealed = closing << 4
    branchface = (edge >> 11) & 3
    if branchface > 2
        branchface = 0
    branch = branchface > 0
    face: i64 = 0
    if branch and (!offside or col >= open)
        face = branchface
    if count > 0 and line != before
        terminator = ((edge >> 15) & 1) == 1
        verdict = _layout_verdict(offside, open, body, terminator, line, col)
        action = verdict & 3
        if action != 0
            return action | (face << 2) | sealed | (column << 8)
        if body == 0
            column = (verdict >> 8) & 268435455
    if ((edge >> 10) & 1) == 1
        return 1 | (face << 2) | sealed | (column << 8)
    if branch
        if !offside or col <= open
            return 1 | (face << 2) | sealed | (column << 8)
        return (face << 2) | sealed | (column << 8)
    if ((edge >> 13) & 1) == 1
        return 3 | sealed | (column << 8)
    sealed | (column << 8)

# Cursor on `(`. `offside_col` 0 disables layout discrimination for the
# single-name `(a)` shape; otherwise it is the statement-line opener column.
# `prev_before_lp` is the token kind immediately before this `(`, or EOF when
# unknown — used to exclude `if (flag)` / `while (flag)` condition groups.
paren_header_signal_lx: bool = (lx: lexer, allow: bool, offside: i64, before: i64)
    if token_view.kindat(lx) != token.kindlparen
        return false
    st = lexer.save_state(lx)
    lp = lexer.next(lx)
    if token_view.kindat(lx) == token.kindlparen
        lexer.restore_state(lx, st)
        return false
    depth = 1
    bracket_depth = 0
    brace_depth = 0
    typed_or_vararg = false
    has_comma = false
    depth1_tokens = 0
    depth1_names = 0
    inner_tokens = 0
    has_literal_arg = false
    has_table_literal_arg = false
    has_infix_operator = false
    rparen_line = 0
    prev_kind = token.kindeof
    while depth > 0
        t = lexer.next(lx)
        if t.kind == token.kindeof
            lexer.restore_state(lx, st)
            return false
        if depth == 1 and bracket_depth == 0 and brace_depth == 0 and token.grammarrole.roleliteral(t.kind)
            has_literal_arg = true
        if t.kind == token.kinddots
            typed_or_vararg = true
        if t.kind == token.kindcomma and depth == 1
            if prev_kind == token.kindeof
                lexer.restore_state(lx, st)
                return false
            has_comma = true
        if t.kind == token.kindcolon and depth == 1 and bracket_depth == 0 and brace_depth == 0 and prev_kind == token.kindname
            if !colon_is_method_call_lx(lx)
                typed_or_vararg = true
        if t.kind == token.kindfun or t.kind == token.kindfunction
            if depth == 1 and bracket_depth == 0 and brace_depth == 0 and !typed_or_vararg
                lexer.restore_state(lx, st)
                return false
        if t.kind == token.kindlparen
            depth += 1
        elseif t.kind == token.kindrparen
            depth -= 1
            if depth == 0
                rparen_line = t.loc.line
        elseif t.kind == token.kindlbracket
            bracket_depth += 1
        elseif t.kind == token.kindrbracket
            if bracket_depth > 0
                bracket_depth -= 1
        elseif t.kind == token.kindlbrace
            if depth == 1 and bracket_depth == 0 and brace_depth == 0
                has_table_literal_arg = true
            brace_depth += 1
        elseif t.kind == token.kindrbrace
            if brace_depth > 0
                brace_depth -= 1
        if depth == 1 and bracket_depth == 0 and brace_depth == 0 and t.kind != token.kindlparen and t.kind != token.kindrparen
            depth1_tokens += 1
            if t.kind == token.kindname
                depth1_names += 1
            if is_infix_kind(t.kind)
                has_infix_operator = true
        if depth > 0
            inner_tokens += 1
        prev_kind = t.kind
    after = lexer.peek(lx)
    if has_literal_arg and !typed_or_vararg
        lexer.restore_state(lx, st)
        return false
    if has_infix_operator and !typed_or_vararg
        lexer.restore_state(lx, st)
        return false
    if has_table_literal_arg and !typed_or_vararg
        lexer.restore_state(lx, st)
        return false
    result = false
    if after.kind == token.kindcolon
        colon = lexer.save_state(lx)
        lexer.next(lx)
        ty = lexer.peek(lx)
        ty2 = peek2(lx)
        result = (ty.kind == token.kindname or is_descriptor_kind(ty.kind)) and ty2.kind != token.kindlparen
        lexer.restore_state(lx, colon)
    if result
        lexer.restore_state(lx, st)
        return true
    if typed_or_vararg or after.kind == token.kindarrow or after.kind == token.kindassign
        lexer.restore_state(lx, st)
        return true
    if allow and has_comma
        if after.kind == token.kindeof
            lexer.restore_state(lx, st)
            return false
        if after.kind == token.kindcolon
            lexer.restore_state(lx, st)
            return result
        if is_infix_kind(after.kind) or after.kind == token.kinddot
            lexer.restore_state(lx, st)
            return false
        lexer.restore_state(lx, st)
        return true
    if after.kind == token.kindcolon
        lexer.restore_state(lx, st)
        return result
    if is_infix_kind(after.kind) or after.kind == token.kindcomma
        lexer.restore_state(lx, st)
        return false
    if depth1_tokens == 1 and depth1_names == 1 and !typed_or_vararg and !has_comma
        if !allow
            lexer.restore_state(lx, st)
            return false
        if after.loc.line != rparen_line
            if inner_tokens != 1
                lexer.restore_state(lx, st)
                return false
            if offside == 0
                lexer.restore_state(lx, st)
                return false
            if after.loc.col <= offside
                lexer.restore_state(lx, st)
                return false
            if before == token.kindif or before == token.kindelseif or before == token.kindelse or before == token.kindwhile or before == token.kinduntil or before == token.kindfor or before == token.kindmatch
                lexer.restore_state(lx, st)
                return false
    if !allow and !typed_or_vararg
        lexer.restore_state(lx, st)
        return false
    if depth1_tokens == 0 and !allow
        lexer.restore_state(lx, st)
        return false
    if can_start_body_kind(after.kind)
        lexer.restore_state(lx, st)
        return true
    lexer.restore_state(lx, st)
    false

# Bare declaration path: NAME '(' ... — cursor on NAME.
statement_header_signal_lx: bool = (lx: lexer, name: token, allow_untyped_comma: bool)
    st = lexer.save_state(lx)
    _n = lexer.next(lx)
    if token_view.kindat(lx) != token.kindlparen
        lexer.restore_state(lx, st)
        return false
    found = paren_header_signal_lx(lx, allow_untyped_comma, name.loc.col, token.kindeof)
    lexer.restore_state(lx, st)
    found

# Join two projection fragments with a space, omitting empty fragments so no
# trailing-space artifacts leak into the sexpr.
join: str = (a: str, b: str)
    if a == "" return b
    if b == "" return a
    a .. " " .. b

# Re-quote a string-literal token text (the lexer strips the quotes).
quote: str = (s: str)
    "\"" .. s .. "\""

# Lookahead scan: does the parenthesised group at the cursor contain a `:`
# at depth 1 (a type annotation)? That is what separates a declaration
# `f(a: i64)` from a call `f(x)`.
# Does the group at the cursor open a value-form function (FF-1) rather than a
# parenthesised expression? Cursor is on `(`.
#
# Two signals, the same pair the declaration discriminator uses: a parameter
# annotation inside the group, or a `:` immediately after the closing paren.
# `(a + b) * c` has neither and stays an expression.
is_lambda_head: bool = (lx: lexer)
    # Typed/untyped-annotation signals only — not the full header recognizer.
    # Keeps `(a, b)` in the bare-lambda arm separate from `(x: t): r`.
    lp = lexer.peek(lx)
    paren_header_signal_lx(lx, false, lp.loc.col, token.kindeof)

# The unannotated value-form: `() f(1)` and `(a, b) a < b`.
#
# Neither spelling is a legal parenthesised expression — `()` is empty and
# `(a, b)` has a top-level comma — so recognising them costs no ambiguity.
# `(a)` deliberately stays an expression: it is a real parenthesised value and
# guessing lambda there would break arithmetic everywhere.
is_bare_lambda_head: bool = (lx: lexer)
    st = lexer.save_state(lx)
    _lp = lexer.next(lx)
    names = 0
    commas = 0
    plain = true
    empty = false
    rparen_line = 0
    if token_view.kindat(lx) == token.kindrparen
        empty = true
    depth = 1
    while depth > 0
        t = lexer.next(lx)
        if t.kind == token.kindeof
            plain = false
            break
        if t.kind == token.kindrparen
            depth -= 1
            if depth == 0
                rparen_line = t.loc.line
        elseif t.kind == token.kindlparen
            depth += 1
            plain = false
        elseif t.kind == token.kindname
            names += 1
        elseif t.kind == token.kindcomma
            commas += 1
        else
            plain = false
    offside_single = false
    if plain and names == 1 and commas == 0 and !empty and lx.stmt_col != 0
        after = lexer.peek(lx)
        if after.kind != token.kindeof and after.loc.line != rparen_line and after.loc.col > lx.stmt_col
            offside_single = true
    lexer.restore_state(lx, st)
    if empty
        return true
    if offside_single
        return true
    plain and commas > 0 and names == commas + 1

# Is the parenthesised group after the name a PARAMETER LIST (a declaration)
# rather than an argument list (a call)? GR-001 says the discriminator is a
# type annotation on a parameter.
#
# Two wrong versions preceded this one, and both were found by the corpus
# number rather than by reading:
#
#   * The original arrived with the cursor on the NAME and consumed it as if it
#     were the `(`, so every parameter colon sat at depth 2 and only a RETURN
#     colon was ever seen. `f(d: i64): i64` was recognised; `f(d: i64)` — no
#     return type — parsed as a call and swallowed its whole body.
#   * Fixing only the off-by-one made ANY depth-1 colon count, so a call whose
#     argument is a typed lambda, `f(x, (y: i64): i64 ...)`, matched on the
#     lambda's return colon. Coverage went 58 -> 46.
#
# So match the shape precisely: a colon directly after a NAME that sits at the
# start of a parameter slot — right after `(` or after a `,` at depth 1.
params_have_colon: bool = (lx: lexer)
    st = lexer.save_state(lx)
    _n = lexer.next(lx)
    _lp = lexer.next(lx)
    depth = 1
    at_slot_start = true
    found = false
    while depth > 0
        t = lexer.next(lx)
        if t.kind == token.kindeof break
        if t.kind == token.kindlparen
            depth += 1
            at_slot_start = false
        elseif t.kind == token.kindrparen
            depth -= 1
            at_slot_start = false
        elseif t.kind == token.kindcomma and depth == 1
            at_slot_start = true
        elseif t.kind == token.kindname and depth == 1 and at_slot_start
            if token_view.kindat(lx) == token.kindcolon
                _c = lexer.next(lx)
                # gap[046]: a FACE CALL in argument position spells the same
                # three tokens a typed parameter does — NAME ':' NAME — so
                # `f(a:b(1))` matched here and was projected as a declaration
                # of `f`, which then failed. It only ever showed up as a
                # REJECTED FILE, never as a wrong projection, and lib/std has
                # no statement-level call carrying a face argument, so the
                # 257/257 ratchet was blind to it while ward's
                # `assert(data:sub(1, 4) == "GGUF", ...)` was one of its three
                # rejections.
                #
                # What follows the colon separates them: a parameter's type is
                # a type name (`a: i64`, `a: point`), while a face call's
                # method name is immediately applied (`a:b(`). Only the
                # applied form is excluded, and it is excluded by CONTINUING
                # the scan rather than by answering false — a bare declaration
                # whose first parameter type is applied still matches on its
                # return colon below.
                if token_view.kindat(lx) == token.kindname and peek2(lx).kind == token.kindlparen
                    at_slot_start = false
                else
                    found = true
                    break
            else
                at_slot_start = false
        else
            at_slot_start = false
    # GR-001 needs at least ONE type annotation, and a RETURN type counts:
    # `f(a, b): i64 ... end` is a declaration with unannotated parameters. The
    # original predicate matched this by accident (its off-by-one only ever saw
    # return colons); dropping it cost 12 files, so it is explicit now. The
    # colon must follow the CLOSING paren, which is why a call carrying a typed
    # lambda does not match — that colon is inside the group.
    if !found and depth == 0
        rk = token_view.kindat(lx)
        if rk == token.kindcolon or rk == token.kindarrow
            found = true
    lexer.restore_state(lx, st)
    found

# One parameter: NAME (':' type)?.
proj_param: str = (lx: lexer)
    n = lexer.next(lx)
    p = "(param " .. n.text
    if token_view.kindat(lx) == token.kindcolon
        _c = lexer.next(lx)
        p = p .. " " .. proj_type(lx)
    p .. ")"

# Comma-separated parameter list, consuming the closing ')'.
proj_params: str = (lx: lexer)
    acc = ""
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindrparen
            _r = lexer.next(lx)
            return acc
        if t.kind == token.kindeof
            markerr(lx)
            return acc
        before: i64 = lx.pos
        peeked = lx.has_peeked
        acc = join(acc, proj_param(lx))
        if stalled(lx, before, peeked)
            markerr(lx)
            return acc
        if token_view.kindat(lx) == token.kindcomma
            _c = lexer.next(lx)

# Type reference: primitive keyword kinds or a NAME (record type).
# ONE type, optionally dotted: `i64`, `lexer`, `str`.
#
# This used to loop while the next token was a type kind, and `is_type_kind`
# accepts kindname — so a return type ran on into the body and swallowed its
# first token. `add(a: i64): i64 a end` projected `(ret i64 a)` with the body
# gone. It survived because the only typed cases in the corpus used the
# `= expr` body form, where `=` is not a type kind and stopped the run; every
# block-bodied typed function was mis-parsed.
# proj_params expects the `(` already consumed; this is the entry for callers
# holding the cursor on it.
proj_params_from_lparen: str = (lx: lexer)
    _lp = lexer.next(lx)
    proj_params(lx)

# One type ATOM: a dotted name (`str`, `str`, `lexer`) or a parenthesised
# tuple (`(str, i64)`). No `|` here — the union level is above, so the
# recursion cannot make `|` bind tighter than a comma.
proj_type_atom: str = (lx: lexer)
    t = lexer.peek(lx)
    # A TUPLE return type. `gguf.read(string)` in tools/wasm/src/nn/init.id is
    # spelled `(str, i64)` and was the next production-parser-accepts /
    # self-hosted-parser-rejects file after `then`, so this closes the last
    # `tools` divergence that is not a deny-list construct.
    if t.kind == token.kindlparen
        lexer.next(lx)
        acc = "(tuple"
        more = true
        while more
            inner = proj_type(lx)
            if inner == ""
                markerr(lx)
                more = false
            else
                acc = "{acc} {inner}"
                if token_view.kindat(lx) == token.kindcomma
                    lexer.next(lx)
                else
                    if token_view.kindat(lx) != token.kindrparen
                        markerr(lx)
                    else
                        lexer.next(lx)
                    more = false
        return "{acc})"
    if is_type_kind(t.kind) == false
        return ""
    _n = lexer.next(lx)
    acc = t.text
    while token_view.kindat(lx) == token.kinddot
        _d = lexer.next(lx)
        seg = lexer.peek(lx)
        if is_type_kind(seg.kind) == false
            markerr(lx)
            return acc
        _s = lexer.next(lx)
        acc = acc .. "." .. seg.text
    acc

# type := atom ('|' atom)*
#
# `: t | error` is the result discipline the whole language is
# built on — and gap[046] measured it at ZERO: no uses in lib/std, and no
# production in either half of the self-hosted parser. It is written here and
# nowhere else because `|` reads two ways and POSITION is the only thing that
# separates them: infix `|` in expression space is bitwise-or (proj_bor), and
# `|` in TYPE space is the union edge. proj_type is only ever entered from a
# type position — after a `:` copula, inside a tuple, after a parameter name —
# so consuming `|` here cannot reach an expression. That is H-1 stated as a
# parser rule: the colour follows the EDGE, not the glyph.
#
# Projected `(union t error)` rather than `(| t error)` on purpose. Sharing the
# binop spelling would make `f(): i64 | error` and `f(): i64` .. `| error`
# project identically, and the whole point of writing the production is that a
# failure position is structurally visible.
proj_type: str = (lx: lexer)
    acc = proj_type_atom(lx)
    if acc != "" and token_view.kindat(lx) == token.kindpipe
        s = "(union {acc}"
        more = true
        while more and token_view.kindat(lx) == token.kindpipe
            lexer.next(lx)
            nxt = proj_type_atom(lx)
            if nxt == ""
                markerr(lx)
                more = false
            else
                s = "{s} {nxt}"
        acc = "{s})"
    acc

# Statements until 'end' (consumed). 'else'/'elseif' do not terminate here.
# A body ends at `end` OR at a DEDENT, and `end` is the retired half.
#
# This used to end only at `end`, which made the self-hosted parser require the
# form §0.7 DELETED and reject the form the law mandates. Measured before the
# repair, and the asymmetry is the tell:
#
#     f = (x: i64): i64      + offside body    status 1   REJECTED
#     f = (x: i64): i64      + `end`           status 0
#     f = (x)                + offside body    status 0
#     f = (x: i64): i64 | error  either form   status 1   REJECTED
#
# So the canonical spelling of a typed callable — the commonest shape in
# idiomatic idol, and the only one `: t | error` can be written in — did not
# parse. lib/std reported 257/257 the whole time because lib/std still writes
# `end`: the ratchet was green on a corpus written in the retired dialect.
#
# The repair is NNS (A2): no new token, no lexer change. The parser already
# carries `loc.line` and `loc.col` on every token and already uses them for the
# bodiless-declaration rule above. A body is the run of statements indented
# past its opener, so the first body token's column IS the base, and a later
# token left of it has dedented out.
#
# EOF closes an end-less body rather than erroring — with `end` deleted there is
# no other terminator at the end of a file. The `acc == ""` guard keeps a
# genuinely truncated body an error: a body that parsed nothing before EOF is
# still a defect, and that is what `mark_error` is for.
proj_body: str = (lx: lexer)
    acc = ""
    base: i64 = 0
    while true
        skipsemi(lx)
        t = lexer.peek(lx)
        if t.kind == token.kindend
            _e = lexer.next(lx)
            return acc
        if t.kind == token.kindeof
            if acc == ""
                markerr(lx)
            return acc
        if base == 0
            base = t.loc.col
        if t.loc.col < base
            return acc
        before: i64 = lx.pos
        peeked = lx.has_peeked
        acc = join(acc, proj_stmt(lx))
        if stalled(lx, before, peeked)
            markerr(lx)
            return acc

# A block that MUST close with `end`, so EOF is a REJECTION rather than a
# terminator.
#
# proj_body treats EOF as a close, which is right for an offside body: with
# `end` deleted (§0.7) the last body in a file has no other terminator. `do`
# is not that shape. It is an explicit Lua-form block whose only terminator is
# `end`, and routing it through proj_body meant `do x = 1` — truncated,
# unterminated — parsed CLEAN. That is a P1 `zigrej` divergence: the
# production parser rejects it, this one accepted it, and over-acceptance
# moves the coverage ratchet the good way so nothing was watching. It was
    # already convicting the parser corpus proof (exit 117, its
# seventeenth compile-fail row) at HEAD before this session touched anything.
proj_block: str = (lx: lexer)
    acc = ""
    more = true
    while more
        skipsemi(lx)
        t = lexer.peek(lx)
        if t.kind == token.kindend
            lexer.next(lx)
            more = false
        elseif t.kind == token.kindeof
            markerr(lx)
            more = false
        else
            before: i64 = lx.pos
            peeked = lx.has_peeked
            acc = join(acc, proj_stmt(lx))
            if stalled(lx, before, peeked)
                markerr(lx)
                more = false
    acc

# Statements until 'end', 'else' or 'elseif' — for if/else block parsing.
proj_body_until_else: str = (lx: lexer)
    acc = ""
    while true
        skipsemi(lx)
        t = lexer.peek(lx)
        if t.kind == token.kindelse or t.kind == token.kindelseif or t.kind == token.kindend or t.kind == token.kindeof
            return acc
        before: i64 = lx.pos
        peeked = lx.has_peeked
        acc = join(acc, proj_stmt(lx))
        if stalled(lx, before, peeked)
            markerr(lx)
            return acc

# fun NAME '(' params ')' (':' type)? (('=' expr) | body) ...
# `first` is the peeked token: either the 'fun'/'function' keyword (consumed,
# then the NAME is read) or the bare-declaration NAME itself.
proj_fun_decl: str = (lx: lexer, first: token)
    if first.kind == token.kindfun or first.kind == token.kindfunction
        _k = lexer.next(lx)
        n = lexer.next(lx)
    else
        n = lexer.next(lx)
    _lp = lexer.next(lx)
    params = proj_params(lx)
    s = "(fun " .. n.text .. " (params"
    if params != ""
        s = s .. " " .. params
    s = s .. ")"
    if ret_intro(lx)
        s = s .. " (ret " .. proj_type(lx) .. ")"
    if token_view.kindat(lx) == token.kindassign
        _e = lexer.next(lx)
        e = proj_expr(lx)
        t = lexer.next(lx)
        if t.kind != token.kindend
            markerr(lx)
        return s .. " " .. e .. ")"
    # A BODILESS declaration: `@ffi("SSL_CTX_new")` then
    # `ssl_ctx_new(method: any): any` and nothing else. It has no body and no
    # `end`, so calling proj_body sent it hunting to EOF and took the rest of
    # the file with it — four modules (tls, onnx, sqlite, regex) failed
    # entirely on this.
    #
    # Layout is the signal, as everywhere else: a body is indented, so a token
    # on a later line at column 1 is the next top-level construct, not this
    # declaration's body.
    nxt = lexer.peek(lx)
    if nxt.kind == token.kindeof
        return s .. ")"
    if nxt.loc.line != first.loc.line and nxt.loc.col == 1 and nxt.kind != token.kindend
        return s .. ")"
    s .. " " .. proj_body(lx) .. ")"

# fun '(' params ')' (':' type)? body 'end' — anonymous, expression position.
proj_fun_expr: str = (lx: lexer)
    _f = lexer.next(lx)
    if token_view.kindat(lx) != token.kindlparen
        markerr(lx)
        return "(error)"
    _lp = lexer.next(lx)
    params = proj_params(lx)
    s = "(lambda (params"
    if params != ""
        s = s .. " " .. params
    s = s .. ")"
    if ret_intro(lx)
        s = s .. " (ret " .. proj_type(lx) .. ")"
    body = proj_body(lx)
    if body != ""
        return s .. " " .. body .. ")"
    s .. ")"

# `then` is optional exactly the way `do` is, and for a stronger reason than
# tolerance: `duo fmt` EMITS it. `do_fmt` in src/main.zig is
# `Parser.parse_module` fed to `PrettyPrinter.printModule` and nothing else, so
# the formatter's output is the production AST's own canonical rendering — and
# it renders `if ready run() end` as `if ready then / run() / end`. A parser
# that means to REPLACE src/parser.zig cannot reject what src/parser.zig's own
# printer writes.
#
# gap[046] §3 filed `then` under "the parser is right and the source is stale"
# because §1 deny-lists it. That reading is wrong and the two-oracle
# differential is what overturned it: deny-list status governs what a human
# should type, not what a parser must read. Measured — `then` alone was 6 of
# the 9 files where the production parser accepted and this one rejected.
skipthen = (lx: lexer)
    if token_view.kindat(lx) == token.kindthen
        lexer.next(lx)

# The RETURN-TYPE introducer, either spelling, consumed. `:` is the copula and
# the canonical form; `->` is §1 deny-listed and is read anyway, for the same
# reason `then` is.
#
# The evidence is stronger here than for `then`, and it is the single biggest
# number this session produced. P2 CANONICAL CLOSURE measured across the repo
# said the self-hosted parser could read 258/258 lib/std files but could NOT
# read `duo fmt`'s rendering of 249 of them. One construct accounts for
# essentially all of it: src/pretty.zig prints every return type as `-> T`,
# and it does so in `--canonical` mode too —
#
#     $ duo fmt #canonical hex.id
#     encode(s: str) -> str
#
# so the production toolchain's own canonical output is unreadable by its
# intended replacement. Both spellings project `(ret T)` with no marker of
# which was written, because they name the SAME edge and a projection that
# distinguished them would make the formatter's output a different tree from
# its input.
#
# This is NOT a licence to write `->`. §1 governs what goes in a .id file and
# the deny list still holds there; it has never governed what a parser must
# READ, and conflating the two is what left gap[046] recording `->` as "the
# source is stale" when the source in question was machine-generated. The
# other repair — teaching src/pretty.zig to print `: T` under `--canonical` —
# is the right one long-term and is src/**, so it is specified rather than
# made. Both should land; only one of them is mine.
ret_intro: bool = (lx: lexer)
    k = token_view.kindat(lx)
    hit = k == token.kindcolon or k == token.kindarrow
    if hit
        lexer.next(lx)
    hit

# if expr ... ('elseif' expr ...)* ('else' ...)? 'end'
proj_if: str = (lx: lexer)
    _i = lexer.next(lx)
    cond = proj_expr(lx)
    skipthen(lx)
    s = "(if " .. cond
    while true
        skipsemi(lx)
        t = lexer.peek(lx)
        if t.kind == token.kindelseif
            _e = lexer.next(lx)
            c2 = proj_expr(lx)
            skipthen(lx)
            s = s .. " (elseif " .. c2
            b = proj_body_until_else(lx)
            if b != ""
                s = s .. " " .. b
            s = s .. ")"
        elseif t.kind == token.kindelse
            _e = lexer.next(lx)
            s = s .. " (else"
            b = proj_body_until_else(lx)
            if b != ""
                s = s .. " " .. b
            s = s .. ")"
        elseif t.kind == token.kindend
            _e = lexer.next(lx)
            return s .. ")"
        elseif t.kind == token.kindeof
            markerr(lx)
            return s .. ")"
        else
            # No `stalled` guard here, deliberately. `lexer.peek` lexes ahead
            # and advances `pos`, so for a one-token statement the cursor has
            # already moved before proj_stmt runs and the check fires
            # spuriously — it cost 33 files (184 -> 151) when I added it. The
            # arms above already consume or return on every terminator, so this
            # loop cannot spin the way the accumulating loops could.
            s = s .. " " .. proj_stmt(lx)

# while expr ... 'end'
proj_while: str = (lx: lexer)
    _w = lexer.next(lx)
    cond = proj_expr(lx)
    # `while c do ... end` — proj_for already tolerated the optional `do`;
    # proj_while did not, so one `do` swallowed the loop's `end` and left the
    # enclosing function unterminated to the end of the file. That is why so
    # many blockers reported at EOF with nothing wrong at the reported line.
    skipdo(lx)
    body = proj_body(lx)
    s = "(while " .. cond
    if body != ""
        s = s .. " " .. body
    s .. ")"

# `do` is optional in .id and mandatory in .lua; the lexer feeds both, so the
# loop forms accept it and drop it rather than projecting it.
skipdo = (lx: lexer)
    if token_view.kindat(lx) == token.kinddo
        _d = lexer.next(lx)

# for NAME '=' expr ',' expr (',' expr)? body 'end'   # numeric
# for NAME (',' NAME)* 'in' expr body 'end'           # generic
#
# Projected as '(for NAME (range A B [S]) body...)' and
# '(forin (names N...) EXPR body...)'. The `range` grouping is what keeps an
# optional step unambiguous: without it, a three-expression header and a
# two-expression header followed by a body statement project identically.
proj_for: str = (lx: lexer)
    _f = lexer.next(lx)
    n1 = lexer.next(lx)
    if n1.kind != token.kindname
        markerr(lx)
        return "(for (error))"
    if token_view.kindat(lx) == token.kindassign
        _a = lexer.next(lx)
        start = proj_expr(lx)
        if token_view.kindat(lx) != token.kindcomma
            markerr(lx)
            return "(for (error))"
        _c = lexer.next(lx)
        rng = "(range " .. start .. " " .. proj_expr(lx)
        if token_view.kindat(lx) == token.kindcomma
            _c2 = lexer.next(lx)
            rng = rng .. " " .. proj_expr(lx)
        rng = rng .. ")"
        skipdo(lx)
        body = proj_body(lx)
        s = "(for " .. n1.text .. " " .. rng
        if body != ""
            s = s .. " " .. body
        return s .. ")"
    names = n1.text
    while token_view.kindat(lx) == token.kindcomma
        _c = lexer.next(lx)
        nx = lexer.next(lx)
        if nx.kind != token.kindname
            markerr(lx)
            return "(forin (error))"
        names = names .. " " .. nx.text
    if token_view.kindat(lx) != token.kindin
        markerr(lx)
        return "(forin (error))"
    _i = lexer.next(lx)
    seq = proj_expr(lx)
    skipdo(lx)
    body = proj_body(lx)
    s = "(forin (names " .. names .. ") " .. seq
    if body != ""
        s = s .. " " .. body
    s .. ")"

# return expr?
proj_return: str = (lx: lexer)
    _r = lexer.next(lx)
    t = lexer.peek(lx)
    if t.kind == token.kindend or t.kind == token.kindelse or t.kind == token.kindelseif or t.kind == token.kindeof
        return "(return)"
    # `return nil, Error.Truncated` — correlated packs are the error idiom, so
    # a single-value return would reject most failure paths in the stdlib.
    vals = proj_expr(lx)
    while token_view.kindat(lx) == token.kindcomma
        _c = lexer.next(lx)
        vals = vals .. " " .. proj_expr(lx)
    "(return " .. vals .. ")"

# NAME ('=' | op-assign) expr
proj_assign: str = (lx: lexer, t: token)
    _n = lexer.next(lx)
    op = lexer.next(lx)
    rhs = proj_expr(lx)
    if op.kind == token.kindassign
        return "(assign " .. t.text .. " " .. rhs .. ")"
    "(assign-op " .. op.text .. " " .. t.text .. " " .. rhs .. ")"

# ('local'|'global') NAME (':' type)? ('=' expr)?
proj_decl: str = (lx: lexer)
    kw = lexer.next(lx)
    n = lexer.next(lx)
    if n.kind != token.kindname
        markerr(lx)
        return "(error)"
    s = "(" .. kw.text .. " " .. n.text
    if token_view.kindat(lx) == token.kindcolon
        _c = lexer.next(lx)
        s = s .. " " .. proj_type(lx)
    if token_view.kindat(lx) == token.kindassign
        _a = lexer.next(lx)
        s = s .. " " .. proj_expr(lx)
    s .. ")"

# repeat body 'until' expr
#
# The body is read with proj_stmt rather than proj_body because `repeat` closes
# on `until`, not `end`. proj_stmt returns "" at `end`/`else`/`elseif`, which
# would spin here, so an empty projection is treated as the error it is.
proj_repeat: str = (lx: lexer)
    _r = lexer.next(lx)
    acc = ""
    while true
        skipsemi(lx)
        t = lexer.peek(lx)
        if t.kind == token.kinduntil
            _u = lexer.next(lx)
            s = "(repeat"
            if acc != ""
                s = s .. " " .. acc
            return s .. " (until " .. proj_expr(lx) .. "))"
        if t.kind == token.kindeof
            markerr(lx)
            return "(repeat (error))"
        st = proj_stmt(lx)
        if st == ""
            markerr(lx)
            return "(repeat (error))"
        acc = join(acc, st)

# A statement starting with a NAME whose target is not a bare name:
# `t[i] = v`, `t.f = v`, `a, b = 1, 2`, or a plain expression statement.
#
# The target is parsed as a postfix expression and the assignment operator is
# checked afterwards, rather than being predicted from lookahead — the target
# grammar is exactly the postfix grammar, so duplicating it would be the only
# other option and the two copies would drift.
proj_target_or_expr: str = (lx: lexer)
    # Save first: if no assignment operator follows, this was never a target,
    # it was the head of an ordinary expression statement. Returning the
    # postfix alone truncated it — `a.x * b.x + a.y * b.y` as a statement
    # projected `(dot a x)` and dropped the rest. Rewind and let proj_expr
    # parse the whole thing rather than trying to resume mid-expression.
    st = lexer.save_state(lx)
    first = proj_postfix(lx)
    if token_view.kindat(lx) == token.kindcomma
        targets = first
        while token_view.kindat(lx) == token.kindcomma
            _c = lexer.next(lx)
            targets = targets .. " " .. proj_postfix(lx)
        if !is_assign_kind(token_view.kindat(lx))
            # A trailing `buf:sub(1, n), nil` is a demand-returned PACK.
            # My first attempt projected EVERY comma list as one, which also
            # accepted a bare `a, b` mid-body — a corpus rejection — and coverage
            # fell 184 -> 151. The tail test is local after all: a pack is the
            # body's value, so `end` must follow it. A top-level `a, b` (EOF
            # follows, no consumer) stays rejected.
            #
            # REWIND before projecting the pack, rather than reusing `targets`.
            # The list above was read with proj_postfix because it was
            # SPECULATED to be an assignment target list, and a pack's elements
            # are full expressions: `s, pos + 8 + len` — the return of
            # `gguf.read(string)` in tools/wasm/src/nn/init.id — parsed `pos`
            # as the second target, met `+`, and rejected. Reusing `targets`
            # would be resuming mid-expression, which is the same defect the
            # save at the top of this function exists to avoid; tail_pack
            # re-reads the whole list under the expression grammar and keeps
            # the `end` requirement that makes a bare `a, b` still reject.
            lexer.restore_state(lx, st)
            return tail_pack(lx, proj_expr(lx))
        op = lexer.next(lx)
        if op.kind != token.kindassign
            markerr(lx)
            return "(error)"
        vals = proj_expr(lx)
        while token_view.kindat(lx) == token.kindcomma
            _c2 = lexer.next(lx)
            vals = vals .. " " .. proj_expr(lx)
        return "(assign-multi (targets " .. targets .. ") (values " .. vals .. "))"
    if is_assign_kind(token_view.kindat(lx))
        op = lexer.next(lx)
        rhs = proj_expr(lx)
        if op.kind == token.kindassign
            return "(assign " .. first .. " " .. rhs .. ")"
        return "(assign-op " .. op.text .. " " .. first .. " " .. rhs .. ")"
    lexer.restore_state(lx, st)
    proj_expr(lx)

# '@' directive: dotted names, then optional parenthesised arguments.
proj_directive: str = (lx: lexer)
    at = lexer.next(lx)
    s = "(at"
    # A directive ends with its line. Without this the loop kept eating NAMEs
    # and swallowed the declaration it annotates: `@comp.c.export("duo_str_sub")`
    # on one line and `sub(s: str, ...)` on the next parsed as ONE directive,
    # taking the whole function with it. Every attribute-carrying declaration in
    # lib/std failed this way.
    line = at.loc.line
    while true
        t = lexer.peek(lx)
        if t.loc.line != line
            return s .. ")"
        if t.kind == token.kindname
            _n = lexer.next(lx)
            s = s .. " " .. t.text
        elseif t.kind == token.kinddot
            _d = lexer.next(lx)
        elseif t.kind == token.kindlparen
            s = join(s, proj_arglist(lx))
        elseif is_string_kind(t.kind)
            _n = lexer.next(lx)
            s = s .. " " .. quote(t.text)
        else
            return s .. ")"

# '(' arg (',' arg)* ')'
proj_arglist: str = (lx: lexer)
    _lp = lexer.next(lx)
    acc = ""
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindrparen
            _r = lexer.next(lx)
            return acc
        if t.kind == token.kindeof
            markerr(lx)
            return acc
        before: i64 = lx.pos
        peeked = lx.has_peeked
        acc = join(acc, proj_expr(lx))
        if stalled(lx, before, peeked)
            markerr(lx)
            return acc
        if token_view.kindat(lx) == token.kindcomma
            _c = lexer.next(lx)

# '{' key (('=' | value)) (',' ...)* '}' — descriptor / table literal.
proj_desc_body: str = (lx: lexer)
    s = "(desc"
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindrbrace
            _r = lexer.next(lx)
            return s .. ")"
        if t.kind == token.kindeof
            markerr(lx)
            return s .. ")"
        # A NAME is only a key when `=` or `:` follows it; `{ a, b }` is two
        # positional elements that happen to be names. Deciding on the NAME
        # alone consumed the name and then projected the *next* element as its
        # value, silently shifting every entry.
        keyed = false
        if t.kind == token.kindname
            k2 = peek2(lx)
            if k2.kind == token.kindassign or k2.kind == token.kindcolon
                keyed = true
        # A STRING-literal key in the unbracketed `k = v` slot:
        # `{ "what is metaprogramming" = [[ ... ]] }`. Not Lua-legal and not
        # how the corpus usually spells a computed key, but the production
        # parser accepts it and tools/mcp/duo_shared.id uses it, so the
        # self-hosted parser has to read it too — P1 acceptance agreement is
        # about the incumbent's grammar, not about the one I would design. It
        # projects as `(key "..." v)`, identical to the bracketed spelling,
        # because they denote the same edge.
        strkey = false
        if is_string_kind(t.kind)
            k2 = peek2(lx)
            if k2.kind == token.kindassign
                strkey = true
        # `{ [0] = "trace", [k] = v }` — a computed key.
        if t.kind == token.kindlbracket
            _lb = lexer.next(lx)
            k = proj_expr(lx)
            rb = lexer.next(lx)
            if rb.kind != token.kindrbracket
                markerr(lx)
                return s .. ")"
            if token_view.kindat(lx) == token.kindassign
                _e = lexer.next(lx)
            s = s .. " (key " .. k .. " " .. proj_expr(lx) .. ")"
        elseif strkey
            lexer.next(lx)
            lexer.next(lx)
            k = quote(t.text)
            v = proj_expr(lx)
            s = "{s} (key {k} {v})"
        elseif keyed
            _n = lexer.next(lx)
            _e = lexer.next(lx)
            s = s .. " " .. t.text
            v = proj_expr(lx)
            if v != ""
                s = s .. " " .. v
        else
            before: i64 = lx.pos
            peeked = lx.has_peeked
            s = s .. " (item " .. proj_expr(lx) .. ")"
            if stalled(lx, before, peeked)
                markerr(lx)
                return s .. ")"
        if token_view.kindat(lx) == token.kindcomma
            _c = lexer.next(lx)

# Precedence-climbing expression projection, highest level first.
proj_expr: str = (lx: lexer)
    left = proj_and(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindor
            _o = lexer.next(lx)
            left = "(or " .. left .. " " .. proj_and(lx) .. ")"
        else
            return left

proj_and: str = (lx: lexer)
    left = proj_cmp(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindand
            _a = lexer.next(lx)
            left = "(and " .. left .. " " .. proj_cmp(lx) .. ")"
        else
            return left

# A CHAIN of comparisons, left-associated, not a single non-associative one.
#
# The level used to read exactly one comparison and return, so
# `a > b != c > d` — the XOR-of-two-tests idiom, and the shape of the
# point-in-polygon test in lib/math/geometry.id and the sign compare in
# tools/wasm/src/engine.id — parsed `(> a b)` and left `!=` unconsumed for the
# statement level to reject. Both files parse under `src/parser.zig`, so it was
# a P2 CANONICAL CLOSURE divergence found by re-reading the formatter's output.
#
# HONEST LIMIT, recorded rather than papered over: §0a CHAIN-CMP rules that
# `a < b < c` is ONE fact — a conjunctive chain evaluating its shared operands
# once — and this projection does not carry that. It emits the incumbent's
# left-associated tree, `(< (< a b) c)`, because matching the incumbent is what
# the differential measures and because a `(chain ...)` node would move every
# comparison row already pinned in the corpus proof. The conjunctive reading is
# a SEMANTIC ruling that belongs to the layer above the projection, and naming
# it here is cheaper than discovering later that the parser silently decided
# it. The two files above are genuine boolean-XOR uses, where left association
# is also the intended meaning.
# The comparison operator a token kind names, or "" for every other kind.
# Split out so the level below is a plain `while`: with the ladder inline the
# loop needed a mid-body `return` to escape, and the escape was the only thing
# the ladder's `else` arm did.
cmp_op: str = (k: i64)
    op = ""
    if k == token.kindeq
        op = "="
    elseif k == token.kindneq
        # `!=` used to fold into `=` here, so `a != b` and `a == b` projected
        # to the identical s-expression and no proof could tell them apart.
        op = "!="
    elseif k == token.kindleq
        op = "<="
    elseif k == token.kindgeq
        op = ">="
    elseif k == token.kindlt
        op = "<"
    elseif k == token.kindgt
        op = ">"
    op

proj_cmp: str = (lx: lexer)
    left = proj_bor(lx)
    op = cmp_op(token_view.kindat(lx))
    while op != ""
        lexer.next(lx)
        right = proj_bor(lx)
        left = "({op} {left} {right})"
        op = cmp_op(token_view.kindat(lx))
    left

# Bitwise levels, Lua precedence: `|` < `~` < `&` < shift < `..`/`+`.
# Four levels rather than one because a single level would left-associate
# `a & b | c` as `(a & b) | c` only by luck of token order; Ward's decoders are
# full of mixed masks and shifts and would be silently mis-parsed.
proj_bor: str = (lx: lexer)
    left = proj_bxor(lx)
    while token_view.kindat(lx) == token.kindpipe
        _o = lexer.next(lx)
        left = "(| " .. left .. " " .. proj_bxor(lx) .. ")"
    left

proj_bxor: str = (lx: lexer)
    left = proj_band(lx)
    while token_view.kindat(lx) == token.kindtilde
        _o = lexer.next(lx)
        left = "(~ " .. left .. " " .. proj_band(lx) .. ")"
    left

proj_band: str = (lx: lexer)
    left = proj_shift(lx)
    while token_view.kindat(lx) == token.kindamp
        _o = lexer.next(lx)
        left = "(& " .. left .. " " .. proj_shift(lx) .. ")"
    left

proj_shift: str = (lx: lexer)
    left = proj_add(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindlshift
            _o = lexer.next(lx)
            left = "(<< " .. left .. " " .. proj_add(lx) .. ")"
        elseif t.kind == token.kindrshift
            _o = lexer.next(lx)
            left = "(>> " .. left .. " " .. proj_add(lx) .. ")"
        else
            return left

proj_add: str = (lx: lexer)
    left = proj_term(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindplus
            _o = lexer.next(lx)
            left = "(+ " .. left .. " " .. proj_term(lx) .. ")"
        elseif t.kind == token.kindminus
            _o = lexer.next(lx)
            left = "(- " .. left .. " " .. proj_term(lx) .. ")"
        elseif t.kind == token.kindconcat
            _o = lexer.next(lx)
            left = "(.. " .. left .. " " .. proj_term(lx) .. ")"
        else
            return left

proj_term: str = (lx: lexer)
    left = proj_unary(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindstar
            _o = lexer.next(lx)
            left = "(* " .. left .. " " .. proj_unary(lx) .. ")"
        elseif t.kind == token.kindslash
            _o = lexer.next(lx)
            left = "(/ " .. left .. " " .. proj_unary(lx) .. ")"
        elseif t.kind == token.kindidiv
            _o = lexer.next(lx)
            left = "(// " .. left .. " " .. proj_unary(lx) .. ")"
        elseif t.kind == token.kindpercent
            _o = lexer.next(lx)
            left = "(% " .. left .. " " .. proj_unary(lx) .. ")"
        else
            return left

proj_unary: str = (lx: lexer)
    t = lexer.peek(lx)
    if t.kind == token.kindminus
        _o = lexer.next(lx)
        return "(- " .. proj_unary(lx) .. ")"
    if t.kind == token.kindnot
        _o = lexer.next(lx)
        return "(!" .. proj_unary(lx) .. ")"
    if t.kind == token.kindhash
        _o = lexer.next(lx)
        return "(len " .. proj_unary(lx) .. ")"
    # Prefix `~` is bitwise NOT. It shares a token with the infix XOR handled in
    # proj_bxor; position decides, which is why the infix level cannot simply
    # consume it.
    if t.kind == token.kindtilde
        _o = lexer.next(lx)
        return "(bnot " .. proj_unary(lx) .. ")"
    proj_pow(lx)

# '^' binds tighter than unary minus and is right-associative, so `-a ^ b`
# is `-(a ^ b)` and `a ^ b ^ c` is `a ^ (b ^ c)`. Recursing into proj_unary on
# the right gives both.
proj_pow: str = (lx: lexer)
    base = proj_postfix(lx)
    if token_view.kindat(lx) == token.kindcaret
        _o = lexer.next(lx)
        return "(^ " .. base .. " " .. proj_unary(lx) .. ")"
    base

proj_postfix: str = (lx: lexer)
    base = proj_primary(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindlparen
            base = "(call " .. join(base, proj_arglist(lx)) .. ")"
        elseif is_string_kind(t.kind)
            _s = lexer.next(lx)
            base = "(call " .. base .. " " .. quote(t.text) .. ")"
        elseif t.kind == token.kinddot
            _d = lexer.next(lx)
            n = lexer.next(lx)
            base = "(dot " .. base .. " " .. n.text .. ")"
        elseif t.kind == token.kindlbracket
            _lb = lexer.next(lx)
            idx = proj_expr(lx)
            rb = lexer.next(lx)
            if rb.kind != token.kindrbracket
                markerr(lx)
                return "(error)"
            base = "(index " .. base .. " " .. idx .. ")"
        elseif t.kind == token.kindcolon
            # `obj:m(args)`. The receiver is projected separately from the
            # name so a later pass can see the implicit self without
            # re-deriving it from a dotted path.
            _c = lexer.next(lx)
            m = lexer.next(lx)
            if !is_member_name(m)
                markerr(lx)
                return "(error)"
            head = "(method " .. base .. " " .. m.text
            if is_string_kind(token_view.kindat(lx))
                sl = lexer.next(lx)
                base = head .. " " .. quote(sl.text) .. ")"
            else
                if token_view.kindat(lx) != token.kindlparen
                    markerr(lx)
                    return "(error)"
                # `join`, not concatenation: a no-argument call must project as
                # `(method obj m)`, not `(method obj m )`.
                base = join(head, proj_arglist(lx)) .. ")"
        elseif t.kind == token.kindat
            _a = lexer.next(lx)
            an = lexer.next(lx)
            base = "(anchor " .. base .. " " .. an.text .. ")"
        else
            return base

proj_primary: str = (lx: lexer)
    t = lexer.peek(lx)
    if t.kind == token.kindintlit or t.kind == token.kindfloatlit
        _n = lexer.next(lx)
        return t.text
    if is_string_kind(t.kind)
        _n = lexer.next(lx)
        return quote(t.text)
    if t.kind == token.kindname or t.kind == token.kindtrue or t.kind == token.kindfalse or t.kind == token.kindnil
        _n = lexer.next(lx)
        return t.text
    # Type names are ordinary values. LAW-STRATA spells specialization as
    # `store(i32)("x")`, so `i32` has to parse in expression position like any
    # other binding; lexing it as a keyword is a tokenization detail, not a
    # semantic category.
    if is_type_kind(t.kind)
        _n = lexer.next(lx)
        return t.text
    if t.kind == token.kindif
        return proj_if(lx)
    if t.kind == token.kinddots
        _d = lexer.next(lx)
        return "(varargs)"
    # `@` directives appear in expression position too: `return @c.emit(...)`,
    # `@as(i64, x)`. Same projection as the statement form.
    if t.kind == token.kindat
        return proj_directive(lx)
    # A leading `.` is a lens on the ambient subject: `.pos`, `map(.name)`.
    if t.kind == token.kinddot
        _d = lexer.next(lx)
        n = lexer.next(lx)
        if n.kind != token.kindname
            markerr(lx)
            return "(error)"
        return "(lens " .. n.text .. ")"
    if t.kind == token.kindfun or t.kind == token.kindfunction
        return proj_fun_expr(lx)
    # The compact value form has a single-expression body and NO `end`:
    # `f = (x) g(x)`, `spawn(() run(c))`. The annotated form is a block that
    # closes with `end`. Same construct, two body shapes, so they are parsed
    # separately rather than by guessing where the body stops.
    # Annotated first: `(): void` has empty parens, so the bare test matches it
    # too, and taking the bare path meant the `: void` was never read and the
    # body was parsed as a single expression instead of a block.
    if t.kind == token.kindlparen and is_bare_lambda_head(lx) and !is_lambda_head(lx)
        head_line = t.loc.line
        params = proj_params_from_lparen(lx)
        # Layout decides the body shape, which is the canon's own rule: a
        # one-liner is a single expression and closes at the newline; a body
        # that starts on the next line is a block and closes with `end`.
        # `create(()\n    fn(1)\nend)` is the block form.
        if lexer.peek(lx).loc.line != head_line
            body = proj_body(lx)
            if params != ""
                return "(lambda (params " .. params .. ") " .. body .. ")"
            if body != ""
                return "(lambda (params) " .. body .. ")"
            return "(lambda (params))"
        body = proj_expr(lx)
        if params != ""
            return "(lambda (params " .. params .. ") " .. body .. ")"
        return "(lambda (params) " .. body .. ")"
    if t.kind == token.kindlparen and is_lambda_head(lx)
        # FF-1: `(x: t): r ... end` with no keyword. This is the canonical
        # function form, and the parser could not read it — including in
        # lib/compiler/parser.id itself after its own FF-1 migration.
        head_line = t.loc.line
        params = proj_params_from_lparen(lx)
        s2 = "(lambda (params"
        if params != ""
            s2 = s2 .. " " .. params
        s2 = s2 .. ")"
        if ret_intro(lx)
            s2 = s2 .. " (ret " .. proj_type(lx) .. ")"
        # LAYOUT picks the body shape here too, not the presence of
        # annotations. `fh.close = (self: any) nil` is annotated AND a
        # one-liner; assuming annotated implied a block made proj_body hunt an
        # `end` that is not there, consume to EOF, and leave the enclosing
        # function unterminated — while still projecting a correct-looking
        # lambda, so only the error flag showed it.
        if lexer.peek(lx).loc.line == head_line
            e2 = proj_expr(lx)
            # The one-line form appears both ways: `(self: any) nil` with no
            # terminator and `(a: i64): i64 a end` with one. Take the `end` when
            # it is there rather than leaving it to dangle into the enclosing
            # block.
            # ...but only an `end` on the SAME line. `less = (a: any, b: any) a < b`
            # sits inside an `if`, and its terminator is on the next line and
            # belongs to the `if`. Eating that closed the wrong block and ran the
            # enclosing function to EOF.
            if token_view.kindat(lx) == token.kindend and lexer.peek(lx).loc.line == head_line
                _e = lexer.next(lx)
            return s2 .. " " .. e2 .. ")"
        body = proj_body(lx)
        if body != ""
            return s2 .. " " .. body .. ")"
        return s2 .. ")"
    if t.kind == token.kindlparen
        _lp = lexer.next(lx)
        e = proj_expr(lx)
        c = lexer.next(lx)
        if c.kind == token.kindrparen
            return e
        markerr(lx)
        return "(error)"
    if t.kind == token.kindlbrace
        _lb = lexer.next(lx)
        return proj_desc_body(lx)
    # `[float]` — a sequence type in field position, e.g. `wq: [float]`.
    if t.kind == token.kindlbracket
        _lb = lexer.next(lx)
        inner = proj_expr(lx)
        rb = lexer.next(lx)
        if rb.kind != token.kindrbracket
            markerr(lx)
            return "(error)"
        return "(seq " .. inner .. ")"
    # LAST refusal: an identifier-spelled keyword in CALL position is a name —
    # `type(nv)`, `error(msg)`. `type` has its own token kind because of
    # `type X = { ... }`, so every call to the builtin was a parse failure.
    #
    # It must come after every keyword-specific arm above, not before: placed
    # earlier it swallowed `fun(a) a end` as a call to `fun` and cost 3 files.
    if is_member_name(t) and peek2(lx).kind == token.kindlparen
        _n = lexer.next(lx)
        return t.text
    _n = lexer.next(lx)
    markerr(lx)
    "(error)"

# One statement. Returns "" only for block terminators (which the block
# parsers consume) and EOF.
# After an expression statement, a comma list that closes at `end` is a
# demand-returned pack: `buf:sub(1, n), nil`. The `end` is what makes it
# a tail — a comma list anywhere else is an error, which keeps a bare `a, b`
# rejected.
tail_pack: str = (lx: lexer, first: str)
    if token_view.kindat(lx) != token.kindcomma
        return first
    acc = first
    while token_view.kindat(lx) == token.kindcomma
        _c = lexer.next(lx)
        acc = acc .. " " .. proj_expr(lx)
    if token_view.kindat(lx) == token.kindend
        return "(pack " .. acc .. ")"
    markerr(lx)
    "(error)"

# concept NAME <signature>* end — a protocol's required surface. Each entry is
# a declaration HEADER with no body, so it cannot go through proj_fun_decl: the
# bodiless rule there keys on column 1, and these are indented.
proj_concept: str = (lx: lexer)
    _c = lexer.next(lx)
    n = lexer.next(lx)
    if !is_member_name(n)
        markerr(lx)
        return "(concept (error))"
    s = "(concept " .. n.text
    while true
        t = lexer.peek(lx)
        if t.kind == token.kindend
            _e = lexer.next(lx)
            return s .. ")"
        if t.kind == token.kindeof
            markerr(lx)
            return s .. ")"
        # A `fun`-prefixed signature. The corpus writes concept members bare
        # (`alloc(self, bytes: i64): any`), but `duo fmt` re-emits every one of
        # them as `fun alloc(self, bytes: i64) -> any`, so the printer's own
        # output for lib/mem.id was unreadable here — a P2 CANONICAL
        # CLOSURE failure with the identical shape as `->` itself. Skipping the
        # keyword costs nothing: the signature grammar after it is the same.
        if token_view.kindat(lx) == token.kindfun or token_view.kindat(lx) == token.kindfunction
            lexer.next(lx)
        nm = lexer.next(lx)
        if !is_member_name(nm)
            markerr(lx)
            return s .. ")"
        if token_view.kindat(lx) != token.kindlparen
            markerr(lx)
            return s .. ")"
        _lp = lexer.next(lx)
        params = proj_params(lx)
        sig = "(sig " .. nm.text .. " (params"
        if params != ""
            sig = sig .. " " .. params
        sig = sig .. ")"
        if ret_intro(lx)
            sig = sig .. " (ret " .. proj_type(lx) .. ")"
        s = s .. " " .. sig .. ")"

proj_stmt: str = (lx: lexer)
    t = lexer.peek(lx)
    lx.stmt_col = t.loc.col
    if t.kind == token.kindeof
        return ""
    if t.kind == token.kindend or t.kind == token.kindelse or t.kind == token.kindelseif
        return ""
    if t.kind == token.kindfun or t.kind == token.kindfunction
        return proj_fun_decl(lx, t)
    if t.kind == token.kindif
        return proj_if(lx)
    if t.kind == token.kindwhile
        return proj_while(lx)
    if t.kind == token.kindfor
        return proj_for(lx)
    if t.kind == token.kindreturn
        return proj_return(lx)
    if t.kind == token.kindat
        return proj_directive(lx)
    if t.kind == token.kindbreak
        _b = lexer.next(lx)
        return "(break)"
    if t.kind == token.kindrepeat
        return proj_repeat(lx)
    if t.kind == token.kindconcept
        return proj_concept(lx)
    # Retired: statement-initial `type X = …` and `(typedecl … (type …))` alias
    # projections (GAP-049; law.md descriptor axis). `type` is an ordinary name;
    # descriptors declare as `Name: { … }` or nominal `Name: T` once parser hole
    # gap[097] closes. Do not reintroduce typedecl or `(type …)` wrappers here.
    if t.kind == token.kinddo
        _d = lexer.next(lx)
        body = proj_block(lx)
        if body != ""
            return "(do " .. body .. ")"
        return "(do)"
    # `const` rides proj_decl with `local`/`global` because the three have one
    # shape — binder NAME (':' type)? ('=' expr)? — and proj_decl already names
    # the projection after `kw.text`, so `const k = 5` projects `(const k 5)`
    # with no new arm. gap[046] §6 ranked const and defer last on cheapness
    # grounds and that was right: this is the whole change.
    if t.kind == token.kindlocal or t.kind == token.kindglobal or t.kind == token.kindconst
        return proj_decl(lx)
    # `defer <stmt>` — one statement, deferred to scope exit. Projected with the
    # deferred statement NESTED rather than flattened, because a flat
    # `(defer) (call close h)` is the same two top-level statements as an
    # undeferred call and the whole meaning of the construct is the edge
    # between them. That is the same defect class as the `nn { }` tear-off in
    # gap[046] §3: acceptance with the structure thrown away.
    if t.kind == token.kinddefer
        lexer.next(lx)
        inner = proj_stmt(lx)
        return "(defer {inner})"
    if t.kind == token.kindname
        t2 = peek2(lx)
        if t2.kind == token.kindcolon
            # `n: i64 = 5` — a binding carrying its shape. `:` is IS, `=` is
            # HOLDS, and the statement level has to read both.
            #
            # Speculative, because `obj:m(1, 2)` starts identically: NAME then
            # `:`. Only the `=` after the type tells them apart, so commit to
            # the binding reading only once it appears and otherwise rewind to
            # the expression path. Committing early turned every method-call
            # statement into a broken binding.
            bst = lexer.save_state(lx)
            _n = lexer.next(lx)
            _c = lexer.next(lx)
            # `span: { start: u32, ... }`. `:` is IS, so a brace on the right
            # is a DESCRIPTOR declaration, not a typed binding — this is the
            # primary data-declaration form and the parser had no production
            # for it at all.
            #
            # It USED TO ACCEPT A STAGED `@{ ... }` in the same slot, peeking
            # for `kindat` and swallowing it before the brace test, so both
            # spellings projected the identical `(descriptor ...)`.
            # `law.injection.only` rules the sigil EXCLUSIVELY world-deriving
            # and fd85e7b8 made the Zig parser refuse the descriptor reading —
            # which left the two frontiers disagreeing about the law, with this
            # one silently accepting what the other names as a world injection.
            # The sigil is not consumed here any more; `@` in this slot falls
            # to `proj_type` and the statement fails, which is the answer the
            # other frontier already gives.
            dt = lexer.peek(lx)
            if dt.kind == token.kindlbrace
                _lb = lexer.next(lx)
                return "(descriptor " .. t.text .. " " .. proj_desc_body(lx) .. ")"
            ty = proj_type(lx)
            if token_view.kindat(lx) == token.kindassign
                _a = lexer.next(lx)
                return "(bind " .. t.text .. " " .. ty .. " " .. proj_expr(lx) .. ")"
            lexer.restore_state(lx, bst)
            # tail_pack, not a bare proj_expr. This is the rewind path, taken
            # when NAME `:` turned out to be a receiver face rather than a
            # binding shape, and it was the ONE arm of the NAME dispatch that
            # did not offer the comma continuation the other three do. So
            # `b:sub(1, n), nil` — a demand-returned pack whose first element
            # is a face — parsed `b:sub(1, n)`, returned with the comma still
            # unread, and the block loop rejected the statement. `b, nil` and
            # `b:sub(1, n), nil` were accepted the whole time, which is
            # why this read as a face defect rather than a missing production
            # (gap[029]).
            return tail_pack(lx, proj_expr(lx))
        if t2.kind == token.kindlparen
            if statement_header_signal_lx(lx, t, false)
                return proj_fun_decl(lx, t)
            return tail_pack(lx, proj_expr(lx))
        if is_assign_kind(t2.kind)
            return proj_assign(lx, t)
        if t2.kind == token.kinddot or t2.kind == token.kindlbracket or t2.kind == token.kindcomma
            return proj_target_or_expr(lx)
        return tail_pack(lx, proj_expr(lx))
    tail_pack(lx, proj_expr(lx))

# Whole-program projection: '(program <stmt>...)'.
proj_program_lx: str = (lx: lexer)
    acc = ""
    while true
        skipsemi(lx)
        t = lexer.peek(lx)
        if t.kind == token.kindeof
            if acc == ""
                return "(program)"
            return "(program " .. acc .. ")"
        before: i64 = lx.pos
        peeked = lx.has_peeked
        s = proj_stmt(lx)
        if s == "" or stalled(lx, before, peeked)
            markerr(lx)
            return "(program " .. acc .. ")"
        acc = join(acc, s)

# Public entries: s-expression projection and a clean/reject differential.
proj_program: str = (src: str, file: str, family: i64)
    lx: lexer = lexer.new(src, file, family)
    proj_program_lx(lx)

parse_status: i64 = (src: str, file: str, family: i64)
    lx: lexer = lexer.new(src, file, family)
    _p = proj_program_lx(lx)
    if lx.has_error
        return 1
    0
