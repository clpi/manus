    "peel|first|when|alias,unaligned|count|0"

ops: str = ()
    "add|number|observe|graph|f32|1|add|number|observe|graph|f64|4|add|number|observe|graph|i32|6|add|number|observe|graph|i64|12|sub|number|observe|graph|f32|2|sub|number|observe|graph|f64|15|sub|number|observe|graph|i32|7|sub|number|observe|graph|i64|13|mul|number|observe|graph|f32|3|mul|number|observe|graph|f64|5|mul|number|observe|graph|i32|8|saxpy|number|observe|graph|f32|9|sum|number|observe|graph|f32|10|"

opinfo: i64 = (op: str, ty: str)
    if op == "add"
        if ty == "f32"
            return 1
        if ty == "f64"
            return 4
        if ty == "i32"
            return 6
        if ty == "i64"
            return 12
        return 0
    if op == "sub"
        if ty == "f32"
            return 2
        if ty == "f64"
            return 15
        if ty == "i32"
            return 7
        if ty == "i64"
            return 13
        return 0
    if op == "mul"
        if ty == "f32"
            return 3
        if ty == "f64"
            return 5
        if ty == "i32"
            return 8
        return 0
    if op == "saxpy"
        if ty == "f32"
            return 9
        return 0
    if op == "sum"
        if ty == "f32"
            return 10
        return 0
    0

abi: str = (code: i64)
    if code == 1
        return "x0|d|x1|a|x2|b|x3|n|ret|void"
    if code == 2
        return "x0|d|x1|a|x2|b|x3|n|ret|void"
    if code == 3
        return "x0|d|x1|a|x2|b|x3|n|ret|void"
