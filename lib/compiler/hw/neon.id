slpabi: str = ()
    "x0|d|x1|a|x2|b|ret|void"

cost: str = (desc: str, ilp: i64, trip: i64)
    kind = cut(desc, 124, 0)
    if kind == "slp"
        return scost(desc)
    ty = cut(desc, 124, 1)
    op = cut(desc, 124, 2)
    code = opinfo(op, ty)
    if code == 0
        return "no|op"
    if gated(code) == 1
        return "no|gate"
    if ilp != 1 and ilp != 2
        return "no|ilp"
    if kind == "red"
        ilp = 1
    if trip >= 0 and shouldvec(trip, ty, ilp) == 0
        return "no|trip"
    "go|" .. dec(code) .. "|" .. dec(ilp)

scost: str = (desc: str)
    ty = cut(desc, 124, 1)
    op = cut(desc, 124, 2)
    k = num(cut(desc, 124, 7))
    code = opinfo(op, ty)
    if code == 0
        return "no|op"
    if sgated(code) == 1
        return "no|gate"
    v = vflen(ty)
    if k < v
        return "no|k"
    if k - (k / v) * v != 0
        return "no|align"
    "go|" .. dec(code) .. "|" .. dec(k)

hooks: str = ()
    "|vscan|vcost|vemit|vproof|sscan|scost|semit|"

entry: str = (name: str)
    if name == "vscan"
        return "call|compiler.hw.neon.scan|(src: str, type: str)|neon.main|loop|stride-one-recognition"
    if name == "vcost"
        return "call|compiler.hw.neon.cost|(desc: str, ilp: i64, trip: i64)|neon.main|loop|epilogue-threshold"
    if name == "vemit"
        return "call|compiler.hw.neon.emit|(desc: str, ilp: i64, mode: i64)|neon.main|loop|neon-emission"
    if name == "vproof"
        return "call|compiler.hw.neon.proof|()|bench.neon.proof|loop|encoder-differential"
    if name == "sscan"
        return "call|compiler.hw.neon.sscan|(src: str, type: str)|neon.main|straightline|slp-recognition"
    if name == "scost"
        return "call|compiler.hw.neon.scost|(desc: str)|neon.main|straightline|slp-profitability"
    if name == "semit"
        return "call|compiler.hw.neon.semit|(desc: str)|neon.main|straightline|slp-emission"
    ""
parsered: str = (s: str, rhs: str, v: str, bnd: str, ty: str)
    op = 0
    pos = 0
    q = 1
    while q <= rhs:len()
        c = rhs:byte(q)
        if c == 43 or c == 42
            if pos == 0
                pos = q
                op = c
        q = q + 1
    if pos == 0
        return ""
    l = ntrim(rhs:sub(1, pos - 1))
    r = ntrim(rhs:sub(pos + 1, rhs:len()))
    if l != s
        return ""
    a = splitidx(r, v)
    if a == ""
        return ""
    if a == s
        return ""
    if op != 43
        return ""
    if opinfo("sum", ty) == 0
        return ""
    "red|" .. ty .. "|sum|" .. a .. "|" .. bnd

parsevec: str = (d: str, rhs: str, v: str, bnd: str, ty: str)
    lhs = d .. "[" .. v .. "]"
    apos = 0
    q = 1
    while q <= rhs:len()
        c = rhs:byte(q)
        if c == 43 or c == 45
            if apos == 0
                apos = q
        q = q + 1
    if apos != 0 and rhs:byte(apos) == 43
        p1 = ntrim(rhs:sub(1, apos - 1))
        p2 = ntrim(rhs:sub(apos + 1, rhs:len()))
        t1 = splitmul(p1, v)
        if t1 != "" and p2 == lhs
            if opinfo("saxpy", ty) == 0
                return ""
            sc = cut(t1, 124, 0)
            x = cut(t1, 124, 1)
            return "vec|" .. ty .. "|saxpy|" .. d .. "|" .. x .. "|" .. sc .. "|" .. bnd
        t2 = splitmul(p2, v)
        if t2 != "" and p1 == lhs
            if opinfo("saxpy", ty) == 0
                return ""
            sc = cut(t2, 124, 0)
            x = cut(t2, 124, 1)
            return "vec|" .. ty .. "|saxpy|" .. d .. "|" .. x .. "|" .. sc .. "|" .. bnd
    op = 0
    pos = 0
    q = 1
    while q <= rhs:len()
        c = rhs:byte(q)
        if c == 43 or c == 45 or c == 42
            if pos == 0
                pos = q
                op = c
        q = q + 1
    if pos == 0
        return ""
    p1 = ntrim(rhs:sub(1, pos - 1))
    p2 = ntrim(rhs:sub(pos + 1, rhs:len()))
    a = splitidx(p1, v)
    b = splitidx(p2, v)
    if a == "" or b == ""
        return ""
    if a == b or d == a or d == b
        return ""
    on = ""
    if op == 43
        on = "add"
    if op == 45
        on = "sub"
    if op == 42
        on = "mul"
    if on == ""
        return ""
    if opinfo(on, ty) == 0
        return ""
    "vec|" .. ty .. "|" .. on .. "|" .. d .. "|" .. a .. "|" .. b .. "|" .. bnd

parsebody: str = (comp: str, v: str, bnd: str, ty: str)
    eq = findbyte(comp, 61)
    if eq == 0
        return ""
    lhs = ntrim(comp:sub(1, eq - 1))
    rhs = ntrim(comp:sub(eq + 1, comp:len()))
    if isname(lhs) == 1
        return parsered(lhs, rhs, v, bnd, ty)
    d = splitidx(lhs, v)
    if d == ""
        return ""
    parsevec(d, rhs, v, bnd, ty)

scan: str = (src: str, ty: str)
    if ty != "f32" and ty != "f64" and ty != "i32" and ty != "i64"
        return ""
    n = lcount(src)
    h = 0 - 1
    k = 0
    while k < n
        ln = ntrim(lget(src, k))
        if ln:len() > 6 and ln:sub(1, 6) == "while "
            h = k
        k = k + 1
    if h < 0
        return ""
    if h == 0
        return ""
    ln = ntrim(lget(src, h))
    rest = ntrim(ln:sub(7, ln:len()))
    lt = findbyte(rest, 60)
    if lt == 0
        return ""
    v = ntrim(rest:sub(1, lt - 1))
    bnd = ntrim(rest:sub(lt + 1, rest:len()))
    if isname(v) == 0
        return ""
    if isname(bnd) == 0 and isnum(bnd) == 0
        return ""
    prev = ntrim(lget(src, h - 1))
    if prev != v .. " = 0"
        return ""
    comp = ""
    k = h + 1
    while k < n
        ln = ntrim(lget(src, k))
        if ln:len() > 0
            if comp == ""
                comp = ln
            else
                if ln != v .. " = " .. v .. " + 1"
                    return ""
                return parsebody(comp, v, bnd, ty)
        k = k + 1
    ""

splitnum: str = (s: str)
    n = s:len()
    if n < 4
        return ""
    if s:byte(n) != 93
        return ""
    q = n - 1
    while q >= 1 and s:byte(q) != 91
        q = q - 1
    if q < 2
        return ""
    nm = s:sub(1, q - 1)
    dg = s:sub(q + 1, n - 1)
    if isname(nm) == 0
        return ""
    if isnum(dg) == 0
        return ""
    nm .. "|" .. dg

slpstmt: str = (ln: str)
    eq = findbyte(ln, 61)
    if eq == 0
        return ""
    lhs = ntrim(ln:sub(1, eq - 1))
    rhs = ntrim(ln:sub(eq + 1, ln:len()))
    dl = splitnum(lhs)
    if dl == ""
        return ""
    op = 0
    pos = 0
    depth = 0
    q = 1
    while q <= rhs:len()
        c = rhs:byte(q)
        if c == 91
            depth = depth + 1
        else
            if c == 93
                depth = depth - 1
            else
                if depth == 0
                    if c == 43 or c == 45 or c == 42
                        if pos == 0
                            pos = q
                            op = c
        q = q + 1
    if pos == 0
        return ""
    p1 = ntrim(rhs:sub(1, pos - 1))
    p2 = ntrim(rhs:sub(pos + 1, rhs:len()))
    a = splitnum(p1)
    b = splitnum(p2)
    if a == "" or b == ""
        return ""
    on = ""
    if op == 43
        on = "add"
    if op == 45
        on = "sub"
    if op == 42
        on = "mul"
    if on == ""
        return ""
    dname = cut(dl, 124, 0)
    didx = num(cut(dl, 124, 1))
    aname = cut(a, 124, 0)
    aidx = num(cut(a, 124, 1))
    bname = cut(b, 124, 0)
    bidx = num(cut(b, 124, 1))
    if didx != aidx or didx != bidx
        return ""
    dname .. "|" .. aname .. "|" .. bname .. "|" .. on .. "|" .. dec(didx)

sscan: str = (src: str, ty: str)
    if ty != "f32" and ty != "f64" and ty != "i32" and ty != "i64"
        return ""
    n = lcount(src)
    s = 0
    d0 = ""
    a0 = ""
    b0 = ""
    on0 = ""
    c0 = 0
    k = 0
    while k < n
        ln = ntrim(lget(src, k))
        if ln:len() > 0
            p = slpstmt(ln)
            if p == ""
                return ""
            d = cut(p, 124, 0)
            a = cut(p, 124, 1)
            b = cut(p, 124, 2)
            on = cut(p, 124, 3)
            ix = num(cut(p, 124, 4))
            if s == 0
                d0 = d
                a0 = a
                b0 = b
                on0 = on
                c0 = ix
            else
                if d != d0 or a != a0 or b != b0 or on != on0
                    return ""
                if ix != c0 + s
                    return ""
            s = s + 1
        k = k + 1
    if s == 0
        return ""
    v = vflen(ty)
    if s < v
        return ""
    if s - (s / v) * v != 0
        return ""
    if opinfo(on0, ty) == 0
        return ""
    "slp|" .. ty .. "|" .. on0 .. "|" .. d0 .. "|" .. a0 .. "|" .. b0 .. "|" .. dec(c0) .. "|" .. dec(s)

emitvec: str = (desc: str, ilp: i64, mode: i64)
    ty = cut(desc, 124, 1)
    op = cut(desc, 124, 2)
    code = opinfo(op, ty)
    v = vflen(ty)
    step = v * ilp
    gate = step * 2
    c = ""
    p1 = 0
    loop = 0
    epi = 0
    if mode == 0
        c = nput(c, cmpi(3, gate))
        p1 = epos(c)
        c = nput(c, bcond(3, 0))
        loop = epos(c)
        r = 0
        while r < ilp
            va = r * 2
            vb = r * 2 + 1
            c = nput(c, vld(code, va, 1))
            c = nput(c, vld(code, vb, 2))
            c = nput(c, vop(code, va, va, vb))
            c = nput(c, vst(code, va, 0))
            r = r + 1
        c = nput(c, subs(3, 3, step))
        c = nput(c, cmpi(3, step))
        c = nput(c, bcond(2, loop - epos(c)))
        epi = epos(c)
        c = patch(c, p1, bcond(3, epi - p1))
    p2 = epos(c)
    c = nput(c, cbz(3, 0))
    eloop = epos(c)
    c = nput(c, sld(code, 4, 1))
    c = nput(c, sld(code, 5, 2))
    c = nput(c, sop(code, 4, 4, 5))
    c = nput(c, sst(code, 4, 0))
    c = nput(c, subs(3, 3, 1))
    c = nput(c, bcond(1, eloop - epos(c)))
    done = epos(c)
    c = nput(c, ret())
    c = patch(c, p2, cbz(3, done - p2))
    c

emitsax: str = (desc: str, ilp: i64, mode: i64)
    v = 4
    step = v * ilp
    gate = step * 2
    c = ""
    p1 = 0
    loop = 0
    epi = 0
    if mode == 0
        c = nput(c, cmpi(2, gate))
        p1 = epos(c)
        c = nput(c, bcond(3, 0))
        loop = epos(c)
        r = 0
        while r < ilp
            va = r * 2 + 1
            vb = r * 2 + 2
            c = nput(c, ld1x(va, 0))
            c = nput(c, ld1s(vb, 1))
            c = nput(c, fmla4(va, vb, 0))
            c = nput(c, st1s(va, 0))
            r = r + 1
        c = nput(c, subs(2, 2, step))
        c = nput(c, cmpi(2, step))
        c = nput(c, bcond(2, loop - epos(c)))
        epi = epos(c)
        c = patch(c, p1, bcond(3, epi - p1))
    p2 = epos(c)
    c = nput(c, cbz(2, 0))
    eloop = epos(c)
    c = nput(c, ldrs(1, 1))
    c = nput(c, ldrs(2, 0))
    c = nput(c, smulf(1, 1, 0))
    c = nput(c, saddf(2, 2, 1))
    c = nput(c, subi(0, 0, 4))
    c = nput(c, strs(2, 0))
    c = nput(c, subs(2, 2, 1))
    c = nput(c, bcond(1, eloop - epos(c)))
    done = epos(c)
    c = nput(c, ret())
    c = patch(c, p2, cbz(2, done - p2))
    c

emitred: str = (desc: str, mode: i64)
    c = nput("", movi2(0))
    p1 = 0
    loop = 0
    epi = 0
    if mode == 0
        c = nput(c, cmpi(1, 8))
        p1 = epos(c)
        c = nput(c, bcond(3, 0))
        loop = epos(c)
        c = nput(c, ld1s(1, 0))
        c = nput(c, faddv(0, 0, 1))
        c = nput(c, subs(1, 1, 4))
        c = nput(c, cmpi(1, 4))
        c = nput(c, bcond(2, loop - epos(c)))
        c = nput(c, faddpv(0, 0, 0))
        c = nput(c, faddpv(0, 0, 0))
        epi = epos(c)
        c = patch(c, p1, bcond(3, epi - p1))
    p2 = epos(c)
    c = nput(c, cbz(1, 0))
    eloop = epos(c)
    c = nput(c, ldrs(1, 0))
    c = nput(c, saddf(0, 0, 1))
    c = nput(c, subs(1, 1, 1))
    c = nput(c, bcond(1, eloop - epos(c)))
    done = epos(c)
    c = nput(c, ret())
    c = patch(c, p2, cbz(1, done - p2))
    c

emit: str = (desc: str, ilp: i64, mode: i64)
    kind = cut(desc, 124, 0)
    if kind == "red"
        return emitred(desc, mode)
    if kind == "slp"
        return semit(desc)
    op = cut(desc, 124, 2)
    if op == "saxpy"
        return emitsax(desc, ilp, mode)
    emitvec(desc, ilp, mode)

semit: str = (desc: str)
    ty = cut(desc, 124, 1)
    op = cut(desc, 124, 2)
    k = num(cut(desc, 124, 7))
    code = opinfo(op, ty)
    v = vflen(ty)
    g = k / v
    c = ""
    r = 0
    while r < g
        c = nput(c, vld(code, 0, 1))
        c = nput(c, vld(code, 1, 2))
        c = nput(c, vop(code, 0, 0, 1))
        c = nput(c, vst(code, 0, 0))
        r = r + 1
    c = nput(c, ret())
    c

proof: str = ()
    out = ""
    out = out .. "ld1s|ld1 {v0.4s}, [x0], #16|" .. whex(ld1s(0, 0)) .. "\n"
    out = out .. "ld1x|ld1 {v0.4s}, [x0]|" .. whex(ld1x(0, 0)) .. "\n"
    out = out .. "st1s|st1 {v2.4s}, [x3], #16|" .. whex(st1s(2, 3)) .. "\n"
    out = out .. "ld1d|ld1 {v1.2d}, [x2], #16|" .. whex(ld1d(1, 2)) .. "\n"
    out = out .. "st1d|st1 {v3.2d}, [x4], #16|" .. whex(st1d(3, 4)) .. "\n"
    out = out .. "faddv|fadd v0.4s, v0.4s, v1.4s|" .. whex(faddv(0, 0, 1)) .. "\n"
    out = out .. "fsubv|fsub v4.4s, v5.4s, v6.4s|" .. whex(fsubv(4, 5, 6)) .. "\n"
    out = out .. "fmulv|fmul v7.4s, v8.4s, v9.4s|" .. whex(fmulv(7, 8, 9)) .. "\n"
    out = out .. "faddd|fadd v2.2d, v2.2d, v3.2d|" .. whex(faddd(2, 2, 3)) .. "\n"
    out = out .. "fsubd|fsub v6.2d, v7.2d, v8.2d|" .. whex(fsubd(6, 7, 8)) .. "\n"
    out = out .. "fmuld|fmul v10.2d, v11.2d, v12.2d|" .. whex(fmuld(10, 11, 12)) .. "\n"
    out = out .. "faddpv|faddp v1.4s, v2.4s, v3.4s|" .. whex(faddpv(1, 2, 3)) .. "\n"
    out = out .. "fmla4|fmla v3.4s, v4.4s, v0.s[0]|" .. whex(fmla4(3, 4, 0)) .. "\n"
    out = out .. "vaddi|add v0.4s, v1.4s, v2.4s|" .. whex(vaddi(0, 1, 2)) .. "\n"
    out = out .. "vsubi|sub v3.4s, v4.4s, v5.4s|" .. whex(vsubi(3, 4, 5)) .. "\n"
    out = out .. "vmuli|mul v6.4s, v7.4s, v8.4s|" .. whex(vmuli(6, 7, 8)) .. "\n"
    out = out .. "vaddl|add v9.2d, v10.2d, v11.2d|" .. whex(vaddl(9, 10, 11)) .. "\n"
    out = out .. "vsubl|sub v3.2d, v4.2d, v5.2d|" .. whex(vsubl(3, 4, 5)) .. "\n"
    out = out .. "saddf|fadd s0, s1, s2|" .. whex(saddf(0, 1, 2)) .. "\n"
    out = out .. "ssubf|fsub s3, s4, s5|" .. whex(ssubf(3, 4, 5)) .. "\n"
    out = out .. "smulf|fmul s6, s7, s8|" .. whex(smulf(6, 7, 8)) .. "\n"
    out = out .. "saddd|fadd d9, d10, d11|" .. whex(saddd(9, 10, 11)) .. "\n"
    out = out .. "ssubd|fsub d9, d10, d11|" .. whex(ssubd(9, 10, 11)) .. "\n"
    out = out .. "smuld|fmul d12, d13, d14|" .. whex(smuld(12, 13, 14)) .. "\n"
    out = out .. "ldrs|ldr s0, [x0], #4|" .. whex(ldrs(0, 0)) .. "\n"
    out = out .. "ldrd|ldr d1, [x2], #8|" .. whex(ldrd(1, 2)) .. "\n"
    out = out .. "strs|str s2, [x3], #4|" .. whex(strs(2, 3)) .. "\n"
    out = out .. "strd|str d3, [x4], #8|" .. whex(strd(3, 4)) .. "\n"
    out = out .. "ldrw|ldr w4, [x5], #4|" .. whex(ldrw(4, 5)) .. "\n"
    out = out .. "ldrx|ldr x6, [x7], #8|" .. whex(ldrx(6, 7)) .. "\n"
    out = out .. "strw|str w8, [x9], #4|" .. whex(strw(8, 9)) .. "\n"
    out = out .. "strx|str x10, [x11], #8|" .. whex(strx(10, 11)) .. "\n"
    out = out .. "addw|add w0, w1, w2|" .. whex(addw(0, 1, 2)) .. "\n"
    out = out .. "subw|sub w3, w4, w5|" .. whex(subw(3, 4, 5)) .. "\n"
    out = out .. "mulw|mul w6, w7, w8|" .. whex(mulw(6, 7, 8)) .. "\n"
    out = out .. "addx|add x9, x10, x11|" .. whex(addx(9, 10, 11)) .. "\n"
    out = out .. "subx|sub x0, x1, x2|" .. whex(subx(0, 1, 2)) .. "\n"
    out = out .. "mulx|mul x3, x4, x5|" .. whex(mulx(3, 4, 5)) .. "\n"
    out = out .. "movi2|movi v5.2d, #0|" .. whex(movi2(5)) .. "\n"
    out = out .. "subs|subs x3, x3, #4|" .. whex(subs(3, 3, 4)) .. "\n"
    out = out .. "subi|sub x6, x6, #4|" .. whex(subi(6, 6, 4)) .. "\n"
    out = out .. "cmpi|cmp x3, #8|" .. whex(cmpi(3, 8)) .. "\n"
    out = out .. "bcond|b.hs #12|" .. whex(bcond(2, 3)) .. "\n"
    out = out .. "cbz|cbz x5, #12|" .. whex(cbz(5, 3)) .. "\n"
    out = out .. "cbnz|cbnz x6, #12|" .. whex(cbnz(6, 3)) .. "\n"
    out = out .. "ret|ret|" .. whex(ret()) .. "\n"
    out

main: i64 = ()
    src = stdin:read()
    first = ntrim(lget(src, 0))
    if first == "proof"
        stdout:write(proof())
        return 0
    ty = ""
    ilp = 0
    trip = 0 - 1
    body = ""
    n = lcount(src)
    k = 0
    while k < n
        ln = ntrim(lget(src, k))
        if ln:len() > 5 and ln:sub(1, 5) == "type "
            ty = ntrim(ln:sub(6, ln:len()))
        else
            if ln:len() > 4 and ln:sub(1, 4) == "ilp "
                ilp = num(ntrim(ln:sub(5, ln:len())))
            else
                if ln:len() > 5 and ln:sub(1, 5) == "trip "
                    trip = num(ntrim(ln:sub(6, ln:len())))
                else
                    body = body .. ln .. "\n"
        k = k + 1
    desc = scan(body, ty)
    if desc == ""
        desc = sscan(body, ty)
    if desc == ""
        stdout:write("no|scan")
        return 0
    kind = cut(desc, 124, 0)
    if kind == "slp"
        dec2 = scost(desc)
        if dec2:sub(1, 3) != "go|"
            stdout:write(dec2)
            return 0
        stdout:write(semit(desc))
        return 0
    if ilp == 0
        ilp = 2
        if kind == "red"
            ilp = 1
    dec2 = cost(desc, ilp, trip)
    if dec2 == "no|trip"
        stdout:write(emit(desc, ilp, 1))
        return 0
    if dec2 == "no|gate"
        stdout:write(emit(desc, ilp, 1))
        return 0
    if dec2:sub(1, 3) != "go|"
        stdout:write(dec2)
        return 0
    ilp2 = num(cut(dec2, 124, 2))
    stdout:write(emit(desc, ilp2, 0))
    0
