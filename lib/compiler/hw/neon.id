hex: str = (v: i64)
    digits = "0123456789abcdef"
    d = (v & 15) + 1
    digits:sub(d, d)

pair: str = (v: i64)
    hex(v >> 4) .. hex(v)

nword: str = (v: i64)
    pair(v) .. pair(v >> 8) .. pair(v >> 16) .. pair(v >> 24)

whex: str = (v: i64)
    pair(v >> 24) .. pair(v >> 16) .. pair(v >> 8) .. pair(v)

dec: str = (v: i64)
    if v == 0
        return "0"
    neg = 0
    if v < 0
        neg = 1
        v = 0 - v
    out = ""
    x = v
    while x > 0
        out = hex(x - (x / 10) * 10) .. out
        x = x / 10
    if neg == 1
        return "-" .. out
    out

num: i64 = (s: str)
    v = 0
    i = 1
    n = s:len()
    neg = 0
    if n > 0 and s:byte(1) == 45
        neg = 1
        i = 2
    while i <= n
        v = v * 10 + s:byte(i) - 48
        i = i + 1
    if neg == 1
        return 0 - v
    v

isnum: i64 = (s: str)
    n = s:len()
    if n == 0
        return 0
    i = 1
    if s:byte(1) == 45
        i = 2
        if n == 1
            return 0
    while i <= n
        c = s:byte(i)
        if c < 48 or c > 57
            return 0
        i = i + 1
    1

isname: i64 = (s: str)
    n = s:len()
    if n == 0
        return 0
    c = s:byte(1)
    if c < 97 or c > 122
        return 0
    i = 2
    while i <= n
        c = s:byte(i)
        if c < 97 or c > 122
            if c < 48 or c > 57
                return 0
        i = i + 1
    1

ntrim: str = (s: str)
    n = s:len()
    a = 1
    while a <= n and s:byte(a) == 32
        a = a + 1
    b = n
    while b >= a and s:byte(b) == 32
        b = b - 1
    if b < a
        return ""
    s:sub(a, b)

cut: str = (s: str, sep: i64, idx: i64)
    cur = 0
    i = 1
    a = 1
    n = s:len()
    while i <= n + 1
        hit = 0
        if i > n or s:byte(i) == sep
            hit = 1
        if hit == 1 and cur == idx
            return s:sub(a, i - 1)
        if hit == 1
            cur = cur + 1
            a = i + 1
        i = i + 1
    ""

at: i64 = (vals: str, idx: i64)
    cur = 0
    i = 1
    n = vals:len()
    while i <= n
        if cur == idx
            j = i
            while j <= n and vals:byte(j) != 124
                j = j + 1
            return num(vals:sub(i, j - 1))
        if vals:byte(i) == 124
            cur = cur + 1
        i = i + 1
    0

nput: str = (c: str, w: i64)
    c .. nword(w)

epos: i64 = (c: str)
    c:len() >> 3

patch: str = (c: str, p: i64, w: i64)
    a = p * 8
    pre = ""
    if a > 0
        pre = c:sub(1, a)
    post = ""
    if a + 9 <= c:len()
        post = c:sub(a + 9, c:len())
    pre .. nword(w) .. post

lcount: i64 = (s: str)
    n = 0
    i = 1
    while i <= s:len()
        if s:byte(i) == 10
            n = n + 1
        i = i + 1
    if s:len() > 0 and s:byte(s:len()) != 10
        n = n + 1
    n

lget: str = (s: str, k: i64)
    n = s:len()
    i = 1
    cur = 0
    a = 1
    while i <= n + 1
        if i > n or s:byte(i) == 10
            if cur == k
                return s:sub(a, i - 1)
            cur = cur + 1
            a = i + 1
        i = i + 1
    ""

findbyte: i64 = (s: str, b: i64)
    i = 1
    while i <= s:len()
        if s:byte(i) == b
            return i
        i = i + 1
    0

splitidx: str = (s: str, v: str)
    n = s:len()
    m = v:len()
    if n < m + 3
        return ""
    if s:byte(n) != 93
        return ""
    if s:sub(n - m - 1, n) != "[" .. v .. "]"
        return ""
    nm = s:sub(1, n - m - 2)
    if isname(nm) == 0
        return ""
    nm

splitmul: str = (p: str, v: str)
    st = findbyte(p, 42)
    if st == 0
        return ""
    l = ntrim(p:sub(1, st - 1))
    r = ntrim(p:sub(st + 1, p:len()))
    if isname(l) == 0
        return ""
    x = splitidx(r, v)
    if x == ""
        return ""
    l .. "|" .. x
ldst1: i64 = (ld: i64, size: i64, rn: i64, vt: i64)
    201326592 | 1073741824 | 8388608 | (ld << 22) | 2031616 | 28672 | (size << 10) | (rn << 5) | vt

ld1s: i64 = (t: i64, n: i64)
    ldst1(1, 2, n, t)

ld1x: i64 = (t: i64, n: i64)
    1279293440 | (n << 5) | t

st1s: i64 = (t: i64, n: i64)
    ldst1(0, 2, n, t)

ld1d: i64 = (t: i64, n: i64)
    ldst1(1, 3, n, t)

st1d: i64 = (t: i64, n: i64)
    ldst1(0, 3, n, t)

fvec: i64 = (u29: i64, u23: i64, sz: i64, opc: i64, m: i64, n: i64, d: i64)
    234881024 | 1073741824 | (u29 << 29) | (u23 << 23) | (sz << 22) | 2097152 | (m << 16) | (opc << 11) | 1024 | (n << 5) | d

faddv: i64 = (d: i64, n: i64, m: i64)
    fvec(0, 0, 0, 26, m, n, d)

fsubv: i64 = (d: i64, n: i64, m: i64)
    fvec(0, 1, 0, 26, m, n, d)

fmulv: i64 = (d: i64, n: i64, m: i64)
    fvec(1, 0, 0, 27, m, n, d)

faddd: i64 = (d: i64, n: i64, m: i64)
    fvec(0, 0, 1, 26, m, n, d)

fsubd: i64 = (d: i64, n: i64, m: i64)
    fvec(0, 1, 1, 26, m, n, d)

fmuld: i64 = (d: i64, n: i64, m: i64)
    fvec(1, 0, 1, 27, m, n, d)

faddpv: i64 = (d: i64, n: i64, m: i64)
    fvec(1, 0, 0, 26, m, n, d)

fmla4: i64 = (d: i64, n: i64, m: i64)
    251658240 | 1073741824 | 8388608 | (m << 16) | 4096 | (n << 5) | d

ivec: i64 = (u: i64, size: i64, opc: i64, m: i64, n: i64, d: i64)
    234881024 | 1073741824 | (u << 29) | (size << 22) | 2097152 | (m << 16) | (opc << 11) | 1024 | (n << 5) | d

vaddi: i64 = (d: i64, n: i64, m: i64)
    ivec(0, 2, 16, m, n, d)

vsubi: i64 = (d: i64, n: i64, m: i64)
    ivec(1, 2, 16, m, n, d)

vmuli: i64 = (d: i64, n: i64, m: i64)
    ivec(0, 2, 19, m, n, d)

vaddl: i64 = (d: i64, n: i64, m: i64)
    ivec(0, 3, 16, m, n, d)

vsubl: i64 = (d: i64, n: i64, m: i64)
    ivec(1, 3, 16, m, n, d)

fsca: i64 = (sz: i64, opc: i64, m: i64, n: i64, d: i64)
    505413632 | (sz << 22) | 2097152 | (m << 16) | (opc << 10) | (n << 5) | d

saddf: i64 = (d: i64, n: i64, m: i64)
    fsca(0, 10, m, n, d)

ssubf: i64 = (d: i64, n: i64, m: i64)
    fsca(0, 14, m, n, d)

smulf: i64 = (d: i64, n: i64, m: i64)
    fsca(0, 2, m, n, d)

saddd: i64 = (d: i64, n: i64, m: i64)
    fsca(1, 10, m, n, d)

ssubd: i64 = (d: i64, n: i64, m: i64)
    fsca(1, 14, m, n, d)

smuld: i64 = (d: i64, n: i64, m: i64)
    fsca(1, 2, m, n, d)

ldst: i64 = (size: i64, vv: i64, opc: i64, im: i64, rn: i64, rt: i64)
    (size << 30) | 939524096 | (vv << 26) | (opc << 22) | (im << 12) | 1024 | (rn << 5) | rt

ldrs: i64 = (t: i64, n: i64)
    ldst(2, 1, 1, 4, n, t)

strs: i64 = (t: i64, n: i64)
    ldst(2, 1, 0, 4, n, t)

ldrd: i64 = (t: i64, n: i64)
    ldst(3, 1, 1, 8, n, t)

strd: i64 = (t: i64, n: i64)
    ldst(3, 1, 0, 8, n, t)

ldrw: i64 = (t: i64, n: i64)
    ldst(2, 0, 1, 4, n, t)

strw: i64 = (t: i64, n: i64)
    ldst(2, 0, 0, 4, n, t)

ldrx: i64 = (t: i64, n: i64)
    ldst(3, 0, 1, 8, n, t)

strx: i64 = (t: i64, n: i64)
    ldst(3, 0, 0, 8, n, t)

addw: i64 = (d: i64, n: i64, m: i64)
    184549376 | (m << 16) | (n << 5) | d

subw: i64 = (d: i64, n: i64, m: i64)
    1258291200 | (m << 16) | (n << 5) | d

mulw: i64 = (d: i64, n: i64, m: i64)
