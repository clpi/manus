subs: i64 = (rd: i64, rn: i64, im: i64)
    4043309056 | ((im & 4095) << 10) | (rn << 5) | rd

subi: i64 = (rd: i64, rn: i64, v: i64)
    3506438144 | ((v & 4095) << 10) | (rn << 5) | rd

cmpi: i64 = (rn: i64, im: i64)
    4043309056 | ((im & 4095) << 10) | (rn << 5) | 31

bcond: i64 = (cd: i64, off: i64)
    1409286144 | ((off & 524287) << 5) | cd

cbz: i64 = (t: i64, off: i64)
    3019898880 | (off << 5) | t

cbnz: i64 = (t: i64, off: i64)
    3036676096 | (off << 5) | t

ret: i64 = ()
    3596551104
vop: i64 = (code: i64, d: i64, n: i64, m: i64)
    if code == 1
        return faddv(d, n, m)
    if code == 2
        return fsubv(d, n, m)
    if code == 3
        return fmulv(d, n, m)
    if code == 4
        return faddd(d, n, m)
    if code == 5
        return fmuld(d, n, m)
    if code == 6
        return vaddi(d, n, m)
    if code == 7
        return vsubi(d, n, m)
    if code == 8
        return vmuli(d, n, m)
    if code == 12
        return vaddl(d, n, m)
    if code == 13
        return vsubl(d, n, m)
    if code == 15
        return fsubd(d, n, m)
    0

sop: i64 = (code: i64, d: i64, n: i64, m: i64)
    if code == 1
        return saddf(d, n, m)
    if code == 2
        return ssubf(d, n, m)
    if code == 3
        return smulf(d, n, m)
    if code == 4
        return saddd(d, n, m)
    if code == 5
        return smuld(d, n, m)
    if code == 6
        return addw(d, n, m)
    if code == 7
        return subw(d, n, m)
    if code == 8
        return mulw(d, n, m)
    if code == 12
        return addx(d, n, m)
    if code == 13
        return subx(d, n, m)
    if code == 15
        return ssubd(d, n, m)
    0

vld: i64 = (code: i64, t: i64, n: i64)
    if code == 4 or code == 5 or code == 15
        return ld1d(t, n)
    if code == 12 or code == 13
        return ld1d(t, n)
    ld1s(t, n)

vst: i64 = (code: i64, t: i64, n: i64)
    if code == 4 or code == 5 or code == 15
        return st1d(t, n)
    if code == 12 or code == 13
        return st1d(t, n)
    st1s(t, n)

sld: i64 = (code: i64, t: i64, n: i64)
    if code == 4 or code == 5 or code == 15
        return ldrd(t, n)
    if code == 6 or code == 7 or code == 8
        return ldrw(t, n)
    if code == 12 or code == 13
        return ldrx(t, n)
    ldrs(t, n)

sst: i64 = (code: i64, t: i64, n: i64)
    if code == 4 or code == 5 or code == 15
        return strd(t, n)
    if code == 6 or code == 7 or code == 8
        return strw(t, n)
    if code == 12 or code == 13
        return strx(t, n)
    strs(t, n)

target: str = ()
    "isa|neon|width|128|fixed|1|scalable|0|vf4s|4|vf2d|2|vf4i|4|vf2l|2|minfactor|2|epifactor|2|peel|0|peelwhen|alias,unaligned|ilp|1,2|pipes|2|slp|adjacent-index|slpvf|vflen|slpmin|vflen"

gates: str = ()
    "gated|4,15,12|why|2wide-loop-loses-at-scale|detail|f64-i64-2wide-0.89x-0.98x-at-8M-vs-4wide-1.4x-2.2x|keep|4wide-f32-i32-saxpy-sum|sgated|4,15,12|why|2wide-slp-unmeasured|rgated|14,16|why|2wide-reduction-unmeasured"

gated: i64 = (code: i64)
    if code == 4
        return 1
    if code == 15
        return 1
    if code == 12
        return 1
    0

sgated: i64 = (code: i64)
    if code == 4
        return 1
    if code == 15
        return 1
    if code == 12
        return 1
    0

rgated: i64 = (code: i64)
    if code == 14
        return 1
    if code == 16
        return 1
    0

vflen: i64 = (ty: str)
    if ty == "f32"
        return 4
    if ty == "i32"
        return 4
    if ty == "f64"
        return 2
    if ty == "i64"
        return 2
    0

minlen: i64 = (ty: str, ilp: i64)
    2 * vflen(ty) * ilp

shouldvec: i64 = (trip: i64, ty: str, ilp: i64)
    v = vflen(ty)
    if v == 0
        return 0
    if trip >= 2 * v * ilp
        return 1
    0

