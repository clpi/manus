
safe: str = (text: str)
  out = ""
  i = 1
  n = text:len()
  while i <= n
    b = text:byte(i)
    keep = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95
    if keep
      out = "{out}{text:sub(i, i)}"
    else
      out = "{out}_"
    i += 1
  out

entry: str = ()
  "main"

mangles: bool = (name: str)
  if name == "main"
    return false
  true

module: str = (home: str, name: str)
  "idol_{safe(home)}__{safe(name)}"

symbol: str = (home: str, name: str)
  if mangles(name)
    return module(home, name)
  entry()
