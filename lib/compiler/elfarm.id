hex: str = (v: i64)
    digits = "0123456789abcdef"
    d = (v & 15) + 1
    digits:sub(d, d)

pair: str = (v: i64)
    hex(v >> 4) .. hex(v)

half: str = (v: i64)
    pair(v) .. pair(v >> 8)

word: str = (v: i64)
    pair(v) .. pair(v >> 8) .. pair(v >> 16) .. pair(v >> 24)

quad: str = (v: i64)
    word(v) .. word(v >> 32)

align: i64 = (v: i64, a: i64)
    r = v & (a - 1)
    if r == 0
        return v
    (v + a) - r

pad: str = (n: i64)
    out = ""
    i = 0
    while i < n
        out = out .. "00"
        i = i + 1
    out

clean: str = (h: str)
    n = h:len()
    a = 1
    while a <= n and h:byte(a) <= 32
        a = a + 1
    while n >= a and h:byte(n) <= 32
        n = n - 1
    if n < a
        return ""
    h:sub(a, n)

elfhex: str = (obj: str)
    n = obj:len() - 470
    code = ""
    if n >= 2
        code = obj:sub(417, 416 + n)
    codesize = code:len() / 2
    textoff = 120
    textsize = codesize + 12
    symoff = align(textoff + textsize, 8)
    stroff = symoff + 72
    shstroff = stroff + 17
    shoff = align(shstroff + 33, 8)
    filesz = shoff + 320
    base = 4194304
    entry = base + textoff
    out = ""
    out = out .. "7f454c4602010100"
    out = out .. "0000000000000000"
    out = out .. half(2)
    out = out .. half(183)
    out = out .. word(1)
    out = out .. quad(entry)
    out = out .. quad(64)
    out = out .. quad(shoff)
    out = out .. word(0)
    out = out .. half(64)
    out = out .. half(56)
    out = out .. half(1)
    out = out .. half(64)
    out = out .. half(5)
    out = out .. half(4)
    out = out .. word(1)
    out = out .. word(5)
    out = out .. quad(0)
    out = out .. quad(base)
    out = out .. quad(base)
    out = out .. quad(filesz)
    out = out .. quad(filesz)
    out = out .. quad(65536)
    out = out .. word(2483027971)
    out = out .. word(3531606952)
    out = out .. word(3556769793)
    out = out .. code
    out = out .. pad(symoff - textoff - textsize)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. word(1)
    out = out .. pair(16)
    out = out .. pair(0)
    out = out .. half(1)
    out = out .. quad(entry)
    out = out .. quad(12)
    out = out .. word(8)
    out = out .. pair(16)
    out = out .. pair(0)
    out = out .. half(1)
    out = out .. quad(entry + 12)
    out = out .. quad(codesize)
    out = out .. "00"
    out = out .. "5f7374617274"
    out = out .. "00"
    out = out .. "69646f6c6d61696e"
    out = out .. "00"
    out = out .. "00"
    out = out .. "2e74657874"
    out = out .. "00"
    out = out .. "2e73796d746162"
    out = out .. "00"
    out = out .. "2e737472746162"
    out = out .. "00"
    out = out .. "2e7368737472746162"
    out = out .. "00"
    out = out .. pad(shoff - shstroff - 33)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. word(1)
    out = out .. word(1)
    out = out .. quad(6)
    out = out .. quad(entry)
    out = out .. quad(textoff)
    out = out .. quad(textsize)
    out = out .. word(0)
    out = out .. word(0)
    out = out .. quad(4)
    out = out .. quad(0)
    out = out .. word(7)
    out = out .. word(2)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(symoff)
    out = out .. quad(72)
    out = out .. word(3)
    out = out .. word(1)
    out = out .. quad(8)
    out = out .. quad(24)
    out = out .. word(15)
    out = out .. word(3)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(stroff)
    out = out .. quad(17)
    out = out .. word(0)
    out = out .. word(0)
    out = out .. quad(1)
    out = out .. quad(0)
    out = out .. word(23)
    out = out .. word(3)
    out = out .. quad(0)
    out = out .. quad(0)
    out = out .. quad(shstroff)
    out = out .. quad(33)
    out = out .. word(0)
    out = out .. word(0)
    out = out .. quad(1)
    out = out .. quad(0)
    out

main: i64 = ()
    obj = clean(stdin:read())
    out = elfhex(obj)
    stdout:write(out)
    0
