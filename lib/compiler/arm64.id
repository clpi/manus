# SH-11 — the ARM64 encoder.
#
# SH-11 is the direct native backend row, host-implemented in
# src/native_backend.zig. This is its Duo side.
#
# This header used to say SH-11 "has no Duo implementation" and that ward's
# encoder "is not reusable from here". Both were wrong, and the second one was
# load-bearing: it is what kept 700 lines of working Duo ARM64 emission parked
# in a downstream WASM runtime while this file stopped at arithmetic. The
# encoders are not reusable as CODE — ward's are welded to its operand stack —
# but the encodings transcribe fine, which is the whole of what was needed.
# See the lift note below.
#
# WHAT MAKES THIS CHECKABLE, and it is the strongest oracle available anywhere
# in this stack: the system assembler already knows every encoding. So the
# proof assembles the SAME instruction with `xcrun clang` and compares the four
# bytes it produces against the four bytes this encoder produces.
#
#     "add x0, x1, x2" -> clang -> object -> otool -> 0x8b020020
#                      \
#                       -> encode_add_reg(0, 1, 2) -> 0x8b020020
#
# Nothing about that comparison can be fudged by me. A hand-written table of
# expected encodings is a transcription of the ARM manual by the same person
# who transcribed it into the encoder, and it agrees with the transcription
# error. The assembler does not.
#
# Scope: 46 encoders — the register-register integer forms, plus the loads,
# stores, immediates, branches and frame pairs lifted from ward. Not yet here:
# any floating-point or SIMD form, PC-relative addressing (adrp/adr, which a
# real code emitter needs for constants and symbols), and the load/store pair
# forms other than the pre/post-index stack push and pop.
#
# The proof lives in compiler.arm64check, not in this file: a stdlib module
# that shells out to a C toolchain merely to be imported is a liability.

# ARM64 is little-endian and fixed-width: every instruction is exactly 4 bytes.
# The encoder returns the 32-bit word; byte order is the caller's concern, and
# the proof handles it explicitly rather than burying it here.

# Data-processing (register): sf=1 for the 64-bit forms.
#   ADD Xd, Xn, Xm  =  0x8B000000 | Rm<<16 | Rn<<5 | Rd
encode_add_reg: i64 = (d: i64, n: i64, m: i64)
    0x8B000000 | (m << 16) | (n << 5) | d
end

#   SUB Xd, Xn, Xm  =  0xCB000000 | ...
encode_sub_reg: i64 = (d: i64, n: i64, m: i64)
    0xCB000000 | (m << 16) | (n << 5) | d
end

#   MUL Xd, Xn, Xm is MADD Xd, Xn, Xm, XZR — Ra=31 in bits 10..14
encode_mul_reg: i64 = (d: i64, n: i64, m: i64)
    0x9B000000 | (m << 16) | (31 << 10) | (n << 5) | d
end

#   AND Xd, Xn, Xm
encode_and_reg: i64 = (d: i64, n: i64, m: i64)
    0x8A000000 | (m << 16) | (n << 5) | d
end

#   ORR Xd, Xn, Xm
encode_orr_reg: i64 = (d: i64, n: i64, m: i64)
    0xAA000000 | (m << 16) | (n << 5) | d
end

#   EOR Xd, Xn, Xm
encode_eor_reg: i64 = (d: i64, n: i64, m: i64)
    0xCA000000 | (m << 16) | (n << 5) | d
end

# MOV Xd, Xm is ORR Xd, XZR, Xm — the alias the assembler prints back as `mov`
encode_mov_reg: i64 = (d: i64, m: i64)
    encode_orr_reg(d, 31, m)
end

#   MOVZ Xd, #imm16 (no shift)
encode_movz: i64 = (d: i64, imm: i64)
    0xD2800000 | ((imm & 0xFFFF) << 5) | d
end

#   RET (Xn defaults to X30)
encode_ret: i64 = ()
    0xD65F0000 | (30 << 5)
end

# ─────────────────────────────────────────────────────────────────────────
# LIFTED FROM ward's JIT (tools/wasm/src/wasm/jit_arm64.id), 2026-08-08.
#
# ward is a WASM runtime, not this compiler's backend, and its encoders are
# entangled with its operand-stack layout — so nothing is *shared*, it is
# transcribed. What transfers is the encoding knowledge, which ward earned by
# executing the bytes: its JIT runs the wasm i32/i64 suites on real hardware,
# so a wrong base word there is a wrong ANSWER, not a wrong-looking listing.
#
# Every form below is re-proved here against the system assembler anyway
# (std.compiler.arm64check), because "ward runs it" and "this is the encoding
# the assembler agrees with" are different claims and only the second one is
# checkable from this file. 9 encoders became 46, checked by 50 cases, and all
# 50 agreed on the first run — a statement about ward's encoders having been
# executed, not about care taken transcribing them.
#
# The gap this closes: the register-register set above cannot express a
# function. No loads, no stores, no immediates, no branches, no frame. Those
# are the four layers between "an encoder" and "a backend", and they are
# exactly what ward already has.

# ── Immediates ──────────────────────────────────────────────────────────
#   MOVZ Xd, #imm16, LSL #(16*hw)   —   hw in 0..3
encode_movz_shift: i64 = (d: i64, imm: i64, hw: i64)
    0xD2800000 | (hw << 21) | ((imm & 0xFFFF) << 5) | d
end

#   MOVK Xd, #imm16, LSL #(16*hw)  — keeps the other 48 bits
encode_movk: i64 = (d: i64, imm: i64, hw: i64)
    0xF2800000 | (hw << 21) | ((imm & 0xFFFF) << 5) | d
end

#   MOVN Xd, #imm16, LSL #(16*hw)  — the negative-constant form
encode_movn: i64 = (d: i64, imm: i64, hw: i64)
    0x92800000 | (hw << 21) | ((imm & 0xFFFF) << 5) | d
end

#   ADD Xd, Xn, #imm12
encode_add_imm: i64 = (d: i64, n: i64, imm: i64)
    0x91000000 | ((imm & 0xFFF) << 10) | (n << 5) | d
end

#   SUB Xd, Xn, #imm12
encode_sub_imm: i64 = (d: i64, n: i64, imm: i64)
    0xD1000000 | ((imm & 0xFFF) << 10) | (n << 5) | d
end

# ── Loads and stores ────────────────────────────────────────────────────
# The unsigned-offset forms scale the immediate by the access size, so the
# byte offset is shifted right by 3 for a 64-bit access. An unaligned offset
# is not encodable in this form at all; the caller owns that.
#   LDR Xt, [Xn, #off]
encode_ldr_imm: i64 = (t: i64, n: i64, off: i64)
    0xF9400000 | ((off >> 3) << 10) | (n << 5) | t
end

#   STR Xt, [Xn, #off]
encode_str_imm: i64 = (t: i64, n: i64, off: i64)
    0xF9000000 | ((off >> 3) << 10) | (n << 5) | t
end

#   LDR Xt, [Xn, Xm, LSL #3]  — the scaled index form an array read lowers to
encode_ldr_reg: i64 = (t: i64, n: i64, m: i64)
    0xF8607800 | (m << 16) | (n << 5) | t
end

#   STR Xt, [Xn, Xm, LSL #3]
encode_str_reg: i64 = (t: i64, n: i64, m: i64)
    0xF8207800 | (m << 16) | (n << 5) | t
end

#   LDRB Wt, [Xn, #off]  — string.byte lowers to exactly this
encode_ldrb_imm: i64 = (t: i64, n: i64, off: i64)
    0x39400000 | ((off & 0xFFF) << 10) | (n << 5) | t
end

#   STRB Wt, [Xn, #off]
encode_strb_imm: i64 = (t: i64, n: i64, off: i64)
    0x39000000 | ((off & 0xFFF) << 10) | (n << 5) | t
end

#   LDRB Wt, [Xn, Xm]  — unscaled register index; byte access needs no shift
encode_ldrb_reg: i64 = (t: i64, n: i64, m: i64)
    0x38606800 | (m << 16) | (n << 5) | t
end

# ── Frame ───────────────────────────────────────────────────────────────
# imm7 counts 8-byte units and is signed, which is why the pre-index push
# encodes -16 as 0x7E. `>>` on the negative offset happens to land on the
# same seven bits either way; the assembler is what settles it.
#   STP Xt, Xt2, [Xn, #imm]!
encode_stp_pre: i64 = (t: i64, t2: i64, n: i64, imm: i64)
    0xA9800000 | (((imm >> 3) & 0x7F) << 15) | (t2 << 10) | (n << 5) | t
end

#   LDP Xt, Xt2, [Xn], #imm
encode_ldp_post: i64 = (t: i64, t2: i64, n: i64, imm: i64)
    0xA8C00000 | (((imm >> 3) & 0x7F) << 15) | (t2 << 10) | (n << 5) | t
end

# ── Compare and select ──────────────────────────────────────────────────
#   CMP Xn, Xm is SUBS XZR, Xn, Xm
encode_cmp_reg: i64 = (n: i64, m: i64)
    0xEB000000 | (m << 16) | (n << 5) | 31
end

#   CMP Xn, #imm12 is SUBS XZR, Xn, #imm
encode_cmp_imm: i64 = (n: i64, imm: i64)
    0xF1000000 | ((imm & 0xFFF) << 10) | (n << 5) | 31
end

# CSET Xd, <cond> is CSINC Xd, XZR, XZR, <inverted cond>. ward flips the low
# bit with xor; spelled out here because the flip is the whole subtlety and a
# reader should not have to know that condition codes are paired.
_invert_cond: i64 = (cond: i64)
    if cond % 2 == 0
        return cond + 1
    end
    cond - 1
end

encode_cset: i64 = (d: i64, cond: i64)
    0x9A9F07E0 | ((_invert_cond(cond) & 0xF) << 12) | d
end

#   CSEL Xd, Xn, Xm, <cond>
encode_csel: i64 = (d: i64, n: i64, m: i64, cond: i64)
    0x9A800000 | (m << 16) | (cond << 12) | (n << 5) | d
end

# ── Branches (offsets are in INSTRUCTIONS, not bytes) ───────────────────
encode_b: i64 = (off: i64)
    0x14000000 | (off & 0x03FFFFFF)
end

# BL — the call. Neither emitter had one: ward never calls out of JIT-ed code,
# and the encoder above stops at arithmetic. A self-hosted backend cannot.
encode_bl: i64 = (off: i64)
    0x94000000 | (off & 0x03FFFFFF)
end

encode_blr: i64 = (n: i64)
    0xD63F0000 | (n << 5)
end

encode_bcond: i64 = (cond: i64, off: i64)
    0x54000000 | ((off & 0x7FFFF) << 5) | cond
end

encode_cbz: i64 = (n: i64, off: i64)
    0xB4000000 | ((off & 0x7FFFF) << 5) | n
end

encode_cbnz: i64 = (n: i64, off: i64)
    0xB5000000 | ((off & 0x7FFFF) << 5) | n
end

# ── Remaining data-processing ───────────────────────────────────────────
#   SDIV / UDIV Xd, Xn, Xm
encode_sdiv: i64 = (d: i64, n: i64, m: i64)
    0x9AC00C00 | (m << 16) | (n << 5) | d
end

encode_udiv: i64 = (d: i64, n: i64, m: i64)
    0x9AC00800 | (m << 16) | (n << 5) | d
end

#   MSUB Xd, Xn, Xm, Xa  =  Xa - Xn*Xm. Remainder is sdiv then msub.
encode_msub: i64 = (d: i64, n: i64, m: i64, a: i64)
    0x9B008000 | (m << 16) | (a << 10) | (n << 5) | d
end

#   MADD Xd, Xn, Xm, Xa
encode_madd: i64 = (d: i64, n: i64, m: i64, a: i64)
    0x9B000000 | (m << 16) | (a << 10) | (n << 5) | d
end

# Variable shifts. shr_s is ASRV and shr_u is LSRV — the pair ward's BIN table
# maps in the order that reads backwards (0x87 -> ASRV, 0x88 -> LSRV).
encode_lslv: i64 = (d: i64, n: i64, m: i64)
    0x9AC02000 | (m << 16) | (n << 5) | d
end

encode_lsrv: i64 = (d: i64, n: i64, m: i64)
    0x9AC02400 | (m << 16) | (n << 5) | d
end

encode_asrv: i64 = (d: i64, n: i64, m: i64)
    0x9AC02800 | (m << 16) | (n << 5) | d
end

encode_rorv: i64 = (d: i64, n: i64, m: i64)
    0x9AC02C00 | (m << 16) | (n << 5) | d
end

#   NEG Xd, Xm is SUB Xd, XZR, Xm. asm_for below already emits the mnemonic;
#   until now there was no encoding behind it.
encode_neg: i64 = (d: i64, m: i64)
    encode_sub_reg(d, 31, m)
end

#   SXTW Xd, Wn — sign-extend a 32-bit value into 64 bits
encode_sxtw: i64 = (d: i64, n: i64)
    0x93407C00 | (n << 5) | d
end

#   MOV Wd, Wm — a W-form move zero-extends, which IS the 32-bit widening
encode_uxtw: i64 = (d: i64, m: i64)
    0x2A0003E0 | (m << 16) | d
end

#   SXTB / SXTH Xd, Wn
encode_sxtb: i64 = (d: i64, n: i64)
    0x93401C00 | (n << 5) | d
end

encode_sxth: i64 = (d: i64, n: i64)
    0x93403C00 | (n << 5) | d
end

# The instruction word as 8 lowercase hex digits, most significant first —
# the form `otool -t` prints. The proof compares like with like rather than
# reformatting one side into the other, because a formatting mismatch that
# happens to cancel is exactly the kind of agreement that proves nothing.
word_to_hex: str = (w: i64)
    digits = "0123456789abcdef"
    out = ""
    i: i64 = 7
    while i >= 0
        d: i64 = (w >> (i * 4)) & 0xF
        out = out .. digits:sub(d + 1, d + 1)
        i -= 1
    end
    out
end

# ─────────────────────────────────────────────────────────────────────────
# Expression codegen: a whole function, not one instruction.
#
# Single-instruction encoding is only half a backend. This lowers a closed
# integer expression to a complete ARM64 function body using a register stack
# (x9..x15, all caller-saved), so the proof can ASSEMBLE, LINK AND RUN it and
# compare the result to SH-08's folder — the same differential as SH-10, on the
# other backend.
#
# Emitting assembly text rather than object bytes is deliberate at this stage:
# the system assembler is a better oracle than a hand-rolled Mach-O writer is a
# deliverable, and SH-12 (object writers) is where the byte layout belongs. The
# encodings above are what a direct emitter would use; this proves the SHAPE of
# the lowering is right before the container work starts.

global _asm: str = ""
global _reg: i64 = 9
global _src2: str = ""
global _p2: i64 = 1
global _bad2: bool = false

_emit: void = (line: str)
    _asm = _asm .. "    " .. line .. "\n"
end

_at2: i64 = ()
    if _p2 > _src2:len()
        return 0
    end
    _src2:byte(_p2)
end

_ws2: void = ()
    while _p2 <= _src2:len() and (_at2() == 32 or _at2() == 9)
        _p2 += 1
    end
end

_eat2: bool = (a: i64)
    _ws2()
    if _at2() != a
        return false
    end
    _p2 += 1
    true
end

# Each level leaves its result in a freshly allocated register and returns it.
_g_prim: i64 = ()
    _ws2()
    if _eat2(40)
        r: i64 = _g_expr()
        if !_eat2(41)
            _bad2 = true
        end
        return r
    end
    if _eat2(45)
        r2: i64 = _g_prim()
        _emit("neg x" .. r2:to(str) .. ", x" .. r2:to(str))
        return r2
    end
    v: i64 = 0
    if !(_at2() >= 48 and _at2() <= 57)
        _bad2 = true
        return _reg
    end
    while _p2 <= _src2:len() and _at2() >= 48 and _at2() <= 57
        v = v * 10 + (_at2() - 48)
        _p2 += 1
    end
    d: i64 = _reg
    _reg += 1
    if _reg > 15
        _bad2 = true
    end
    _emit("mov x" .. d:to(str) .. ", #" .. v:to(str))
    d
end

_g_term: i64 = ()
    left: i64 = _g_prim()
    while true
        _ws2()
        if _eat2(42)
            r: i64 = _g_prim()
            _emit("mul x" .. left:to(str) .. ", x" .. left:to(str) .. ", x" .. r:to(str))
            _reg -= 1
        elseif _eat2(47)
            r2: i64 = _g_prim()
            _emit("sdiv x" .. left:to(str) .. ", x" .. left:to(str) .. ", x" .. r2:to(str))
            _reg -= 1
        else
            return left
        end
    end
end

_g_expr: i64 = ()
    left: i64 = _g_term()
    while true
        _ws2()
        if _eat2(43)
            r: i64 = _g_term()
            _emit("add x" .. left:to(str) .. ", x" .. left:to(str) .. ", x" .. r:to(str))
            _reg -= 1
        elseif _eat2(45)
            r2: i64 = _g_term()
            _emit("sub x" .. left:to(str) .. ", x" .. left:to(str) .. ", x" .. r2:to(str))
            _reg -= 1
        else
            return left
        end
    end
end

# A complete assembly unit exporting `_duo_eval`, returning the expression's
# value in x0 per the ARM64 C ABI.
asm_for: str = (expr: str)
    _asm = ""
    _reg = 9
    _src2 = expr
    _p2 = 1
    _bad2 = false
    r: i64 = _g_expr()
    _ws2()
    if _bad2 or _p2 <= _src2:len()
        return ""
    end
    body = _asm .. "    mov x0, x" .. r:to(str) .. "\n    ret\n"
    ".text\n.global _duo_eval\n.align 2\n_duo_eval:\n" .. body
end
