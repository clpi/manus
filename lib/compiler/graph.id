# Name-reference census, seed. NOT the semantic graph; SH-07 blocked, see gaps/GAP-125.md.
#
# Nodes are top-level binding names token-scanned from column 1; edges are
# same-spelled name references. That is a spelling census, not semantic
# authority: it carries no applications, no canonical relation identity,
# no subject roles, no required or reachable world edges, no demand, no
# effects, and no provenance.
#
# TODAY/DELTA. This bootstrap reference scan still treats `_`-prefixed names as
# private and a file's top-level names as a surface. Those are source-name
# approximations, not language law. Home/reachability facts must replace this
# query before it becomes semantic authority.
#
# SH-07 stays blocked until parsed structured applications normalize into
# graph facts that support home-rename-invariant WORLDGATE and SUBJECTGATE.
# The one query this census answers that no other pass can is dead-private
# in-degree: a `_`-prefixed top-level name never referenced in its file.
#
# Limits, stated: nodes are top-level only, and a reference is a NAME token not
# in member position. Nested scopes, shadowing and indirect reference through a
# table field are refinements, not corrections.

has: bool = (set: str, name: str)
  needle = "|" .. name .. "|"
  hn: i64 = set:len()
  nn: i64 = needle:len()
  i: i64 = 1
  while i + nn - 1 <= hn
    j: i64 = 0
    hit = true
    while j < nn
      if set:byte(i + j) != needle:byte(j + 1)
        hit = false
        j = nn
      j = j + 1
    if hit
      return true
    i = i + 1
  false

add: str = (set: str, name: str)
  if has(set, name)
    return set
  set .. name .. "|"

# Top-level binding names, as "|a|b|". A binding is at top level when its name
# token sits in column 1 — the same layout signal the parser uses to recognise
# a bodiless declaration.
nodes: str = (src: str, file: str, family: i64)
  lx: lexer = lexer.new(src, file, family)
  acc = "|"
  while true
    t = lexer.next(lx)
    if t.kind == token.kindeof
      break
    if t.kind == token.kindname and t.loc.col == 1
      nxt = lexer.peek(lx)
      if nxt.kind == token.kindassign or nxt.kind == token.kindlparen or nxt.kind == token.kindcolon
        acc = add(acc, t.text)
  acc

# Private nodes with in-degree 0: declared `_name`, never referenced in the
# file that declares them, and unreachable from outside it by policy.
dead: i64 = (src: str, file: str, family: i64, report: bool)
  declared = nodes(src, file, family)
  lx: lexer = lexer.new(src, file, family)
  used = "|"
  kind: i64 = 0
  col: i64 = 0
  while true
    t = lexer.next(lx)
    if t.kind == token.kindeof
      break
    # gap[025]: a RECEIVER FACE is a reference. `self:_fail(2)` calls the
    # top-level `_fail`, so excluding names after `:` made every converted
    # call site invisible and reported live privates as unreachable.
    #
    # `.` stays excluded: `a.b` is field access, not a call face.
    #
    # The residual error is in the SAFE direction. A genuine member call
    # `a:m()` now also marks a same-named top-level binding as used, so the
    # query can MISS a dead private — it can no longer invent one, which is
    # the failure that would delete live code.
    if t.kind == token.kindname and kind != token.kinddot
      # a declaration site is not a use of itself
      decl = t.loc.col == 1
      if !decl
        used = add(used, t.text)
    kind = t.kind
    col = t.loc.col

  # walk the declared set and count private names never used
  n: i64 = declared:len()
  count: i64 = 0
  start: i64 = 2
  i: i64 = 2
  while i <= n
    if declared:byte(i) == 124
      if i > start
        name = declared:sub(start, i - 1)
        if name:len() > 1 and name:byte(1) == 95 and !has(used, name)
          count = count + 1
          if report
            print("  dead private " .. file .. ": " .. name)
      start = i + 1
    i = i + 1
  count
