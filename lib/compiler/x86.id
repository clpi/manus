hex: str = (v: i64)
    digits = "0123456789abcdef"
    d = (v & 15) + 1
    digits:sub(d, d)

pair: str = (v: i64)
    hex(v >> 4) .. hex(v)

word: str = (v: i64)
    pair(v) .. pair(v >> 8) .. pair(v >> 16) .. pair(v >> 24)

quad: str = (v: i64)
    word(v) .. word(v >> 32)

half: str = (v: i64)
    pair(v) .. pair(v >> 8)

rex: str = (w: i64, r: i64, b: i64)
    v = 64 | (w << 3) | (r << 2) | b
    if v == 64
        return ""
    pair(v)

modrm: i64 = (m: i64, g: i64, o: i64)
    (m << 6) | ((g & 7) << 3) | (o & 7)

rbit: i64 = (r: i64)
    (r >> 3) & 1

low: i64 = (r: i64)
    r & 7

cqo: str = ()
    pair(72) .. pair(153)

movri: str = (d: i64, v: i64)
    b = rbit(d)
    o = 184 + low(d)
    if v >= 0 and v < 4294967296
        return rex(0, 0, b) .. pair(o) .. word(v)
    rex(1, 0, b) .. pair(o) .. quad(v)

movrr: str = (d: i64, s: i64)
    rex(1, rbit(s), rbit(d)) .. pair(137) .. pair(modrm(3, s, d))

addrr: str = (d: i64, s: i64)
    rex(1, rbit(s), rbit(d)) .. pair(1) .. pair(modrm(3, s, d))

addri: str = (d: i64, v: i64)
    b = rbit(d)
    m = modrm(3, 0, d)
    if v >= 0 - 128 and v < 128
        return rex(1, 0, b) .. pair(131) .. pair(m) .. pair(v)
    rex(1, 0, b) .. pair(129) .. pair(m) .. word(v)

subrr: str = (d: i64, s: i64)
    rex(1, rbit(s), rbit(d)) .. pair(41) .. pair(modrm(3, s, d))

subri: str = (d: i64, v: i64)
    b = rbit(d)
    m = modrm(3, 5, d)
    if v >= 0 - 128 and v < 128
        return rex(1, 0, b) .. pair(131) .. pair(m) .. pair(v)
    rex(1, 0, b) .. pair(129) .. pair(m) .. word(v)

mulrr: str = (d: i64, s: i64)
    rex(1, rbit(d), rbit(s)) .. pair(15) .. pair(175) .. pair(modrm(3, d, s))

mulri: str = (d: i64, v: i64)
    b = rbit(d)
    m = modrm(3, d, d)
    if v >= 0 - 128 and v < 128
        return rex(1, b, b) .. pair(107) .. pair(m) .. pair(v)
    rex(1, b, b) .. pair(105) .. pair(m) .. word(v)

shlri: str = (d: i64, v: i64)
    rex(1, 0, rbit(d)) .. pair(193) .. pair(modrm(3, 4, d)) .. pair(v)

divrr: str = (d: i64, s: i64)
    pre = ""
    if d != 0
        pre = movrr(0, d)
    post = ""
    if d != 0
        post = movrr(d, 0)
    pre .. cqo() .. rex(1, 0, rbit(s)) .. pair(247) .. pair(modrm(3, 7, s)) .. post

cmprr: str = (a: i64, b: i64)
    rex(1, rbit(b), rbit(a)) .. pair(57) .. pair(modrm(3, b, a))

cmpri: str = (a: i64, v: i64)
    b = rbit(a)
    m = modrm(3, 7, a)
    if v >= 0 - 128 and v < 128
        return rex(1, 0, b) .. pair(131) .. pair(m) .. pair(v)
    if a == 0
        return rex(1, 0, 0) .. pair(61) .. word(v)
    rex(1, 0, b) .. pair(129) .. pair(m) .. word(v)

jcc: str = (c: i64, off: i64)
    if off >= 0 - 128 and off < 128
        return pair(112 + c) .. pair(off)
    pair(15) .. pair(128 + c) .. word(off)

jccn: str = (c: i64, off: i64)
    pair(15) .. pair(128 + c) .. word(off)

jmp: str = (off: i64)
    if off >= 0 - 128 and off < 128
        return pair(235) .. pair(off)
    pair(233) .. word(off)

jmpn: str = (off: i64)
    pair(233) .. word(off)

ret: str = ()
    pair(195)

syscall: str = ()
    pair(15) .. pair(5)

rexx: str = (w: i64, r: i64, x: i64, b: i64)
    v = 64 | (w << 3) | (r << 2) | (x << 1) | b
    if v == 64
        return ""
    pair(v)

imul1: str = (s: i64)
    rex(1, 0, rbit(s)) .. pair(247) .. pair(modrm(3, 5, s))

sarri: str = (d: i64, v: i64)
    rex(1, 0, rbit(d)) .. pair(193) .. pair(modrm(3, 7, d)) .. pair(v)

shrri: str = (d: i64, v: i64)
    rex(1, 0, rbit(d)) .. pair(193) .. pair(modrm(3, 5, d)) .. pair(v)

leasib: str = (d: i64, b: i64, x: i64, s: i64)
    sc = 0
    if s == 2
        sc = 1
    if s == 4
        sc = 2
    if s == 8
        sc = 3
    m = 0
    tail = ""
    if low(b) == 5
        m = 1
        tail = pair(0)
    sb = (sc << 6) | (low(x) << 3) | low(b)
    rexx(1, rbit(d), rbit(x), rbit(b)) .. pair(141) .. pair(modrm(m, d, 4)) .. pair(sb) .. tail

memop: str = (op: i64, r: i64, b: i64, v: i64)
    m = 0
    tail = ""
    if v != 0 or low(b) == 5
        m = 1
        tail = pair(v)
        if v >= 128 or v < 0 - 128
            m = 2
            tail = word(v)
    sib = ""
    if low(b) == 4
        sib = pair(36)
    rex(1, rbit(r), rbit(b)) .. pair(op) .. pair(modrm(m, r, b)) .. sib .. tail

movrm: str = (d: i64, b: i64, v: i64)
    memop(139, d, b, v)

movmr: str = (b: i64, v: i64, s: i64)
    memop(137, s, b, v)

push: str = (r: i64)
    rex(0, 0, rbit(r)) .. pair(80 + low(r))

pop: str = (r: i64)
    rex(0, 0, rbit(r)) .. pair(88 + low(r))

vex: str = (m: i64, w: i64, v: i64, l: i64, pp: i64, r: i64, x: i64, b: i64)
    vf = 15
    if v >= 0
        vf = 15 - v
    if m == 1 and w == 0 and x == 0 and b == 0
        b2 = ((1 - r) << 7) | (vf << 3) | (l << 2) | pp
        return pair(197) .. pair(b2)
    b2 = ((1 - r) << 7) | ((1 - x) << 6) | ((1 - b) << 5) | m
    b3 = (w << 7) | (vf << 3) | (l << 2) | pp
    pair(196) .. pair(b2) .. pair(b3)

vpaddq: str = (d: i64, a: i64, b: i64, l: i64)
    vex(1, 0, a, l, 1, rbit(d), 0, rbit(b)) .. pair(212) .. pair(modrm(3, d, b))

vpxor: str = (d: i64, a: i64, b: i64)
    vex(1, 0, a, 0, 1, rbit(d), 0, rbit(b)) .. pair(239) .. pair(modrm(3, d, b))

vmovdqa: str = (d: i64, s: i64)
    vex(1, 0, 0 - 1, 0, 1, rbit(d), 0, rbit(s)) .. pair(111) .. pair(modrm(3, d, s))

shlx: str = (d: i64, a: i64, b: i64)
    vex(2, 1, a, 0, 1, rbit(d), 0, rbit(b)) .. pair(247) .. pair(modrm(3, d, b))

shrx: str = (d: i64, a: i64, b: i64)
    vex(2, 1, a, 0, 3, rbit(d), 0, rbit(b)) .. pair(247) .. pair(modrm(3, d, b))

sarx: str = (d: i64, a: i64, b: i64)
    vex(2, 1, a, 0, 2, rbit(d), 0, rbit(b)) .. pair(247) .. pair(modrm(3, d, b))

mulx: str = (d: i64, h: i64, s: i64)
    vex(2, 1, h, 0, 3, rbit(d), 0, rbit(s)) .. pair(246) .. pair(modrm(3, d, s))

pext: str = (d: i64, s: i64, m: i64)
    vex(2, 1, s, 0, 2, rbit(d), 0, rbit(m)) .. pair(245) .. pair(modrm(3, d, m))

pdep: str = (d: i64, s: i64, m: i64)
    vex(2, 1, s, 0, 3, rbit(d), 0, rbit(m)) .. pair(245) .. pair(modrm(3, d, m))

vec: str = (a: str, h: str)
    a .. " | " .. h .. "\n"

main: i64 = ()
    neg5 = 0 - 5
    neg1 = 0 - 1
    out = vec("movl $60, %eax", movri(0, 60))
    out = out .. vec("movabsq $1234605616436508552, %r9", movri(9, 1234605616436508552))
    out = out .. vec("movq %r12, %r13", movrr(13, 12))
    out = out .. vec("addq %rsi, %rdi", addrr(7, 6))
    out = out .. vec("addq $5, %rax", addri(0, 5))
    out = out .. vec("addq $1000, %rbx", addri(3, 1000))
    out = out .. vec("addq $-5, %r14", addri(14, neg5))
    out = out .. vec("subq %rcx, %rdx", subrr(2, 1))
    out = out .. vec("subq $300, %r8", subri(8, 300))
    out = out .. vec("imulq %r10, %r11", mulrr(11, 10))
    out = out .. vec("imulq $7, %r12, %r12", mulri(12, 7))
    out = out .. vec("imulq $100000, %rax, %rax", mulri(0, 100000))
    out = out .. vec("shlq $3, %rdi", shlri(7, 3))
    out = out .. vec("movq %rbx, %rax; cqo; idivq %r10; movq %rax, %rbx", divrr(3, 10))
    out = out .. vec("cmpq %rdi, %rsi", cmprr(6, 7))
    out = out .. vec("cmpq $100000, %rax", cmpri(0, 100000))
    out = out .. vec("cmpq $-1, %r15", cmpri(15, neg1))
    out = out .. vec("jne 1f; 1:", jcc(5, 0))
    out = out .. vec("jl 1f; .rept 200; nop; .endr; 1:", jcc(12, 200))
    out = out .. vec("jmp 1f; 1:", jmp(0))
    out = out .. vec("jmp 1f; .rept 300; nop; .endr; 1:", jmp(300))
    out = out .. vec("ret", ret())
    out = out .. vec("syscall", syscall())
    out = out .. vec("imulq %r11", imul1(11))
    out = out .. vec("sarq $3, %rdx", sarri(2, 3))
    out = out .. vec("shrq $63, %r10", shrri(10, 63))
    out = out .. vec("leaq (%r12,%r12,2), %r13", leasib(13, 12, 12, 2))
    out = out .. vec("leaq (%rbp,%rbp,8), %rax", leasib(0, 5, 5, 8))
    out = out .. vec("movq (%rbx), %rax", movrm(0, 3, 0))
    out = out .. vec("movq %rcx, 8(%rbp)", movmr(5, 8, 1))
    out = out .. vec("movq -16(%r12), %r8", movrm(8, 12, 0 - 16))
    out = out .. vec("pushq %r8", push(8))
    out = out .. vec("popq %r15", pop(15))
    out = out .. vec("vpaddq %xmm2, %xmm1, %xmm0", vpaddq(0, 1, 2, 0))
    out = out .. vec("vpaddq %ymm6, %ymm5, %ymm7", vpaddq(7, 5, 6, 1))
    out = out .. vec("vpxor %xmm9, %xmm8, %xmm10", vpxor(10, 8, 9))
    out = out .. vec("vmovdqa %xmm3, %xmm4", vmovdqa(4, 3))
    out = out .. vec("vmovdqa %xmm4, %xmm3", vmovdqa(3, 4))
    out = out .. vec("shlx %rax, %rcx, %rdx", shlx(2, 0, 1))
    out = out .. vec("shrx %r9, %r8, %r10", shrx(10, 9, 8))
    out = out .. vec("sarx %rdi, %rsi, %rax", sarx(0, 7, 6))
    out = out .. vec("mulx %rax, %rdx, %rcx", mulx(1, 2, 0))
    out = out .. vec("pdep %r10, %r11, %r12", pdep(12, 11, 10))
    stdout:write(out)
    0
