lineat: str = (s: str, k: i64)
    n = s:len()
    i = 1
    cur = 0
    a = 1
    while i <= n + 1
        if i > n or s:byte(i) == 10
            if cur == k
                return s:sub(a, i - 1)
            cur = cur + 1
            a = i + 1
        i = i + 1
    ""

linecount: i64 = (s: str)
    n = 0
    i = 1
    while i <= s:len()
        if s:byte(i) == 10
            n = n + 1
        i = i + 1
    if s:len() > 0 and s:byte(s:len()) != 10
        n = n + 1
    n

trim: str = (s: str)
    a = 1
    n = s:len()
    while a <= n and s:byte(a) == 32
        a = a + 1
    b = n
    while b >= a and s:byte(b) == 32
        b = b - 1
    if b < a
        return ""
    s:sub(a, b)

contains: i64 = (s: str, pat: str)
    n = s:len()
    m = pat:len()
    if m == 0
        return 1
    if m > n
        return 0
    i = 1
    while i <= n - m + 1
        match = 1
        j = 1
        while j <= m
            if s:byte(i + j - 1) != pat:byte(j)
                match = 0
            j = j + 1
        if match == 1
            return 1
        i = i + 1
    0

popcount: str = (src: str)
    lc = linecount(src)
    out = ""
    k = 0
    while k < lc
        t0 = trim(lineat(src, k))
        matched = 0
        varname = ""
        if k + 5 < lc
            t1 = trim(lineat(src, k + 1))
            t2 = trim(lineat(src, k + 2))
            t3 = trim(lineat(src, k + 3))
            t4 = trim(lineat(src, k + 4))
            t5 = trim(lineat(src, k + 5))
            c1 = contains(t0, "6148914691236517205")
            c2 = contains(t1, "3689348814741910323")
            c3 = contains(t2, "1085102592571150095")
            c4 = contains(t3, "/ 256")
            c5 = contains(t4, "/ 65536")
            c6 = contains(t5, "/ 4294967296")
            if c1 == 1 and c2 == 1 and c3 == 1 and c4 == 1 and c5 == 1 and c6 == 1
                eq = 1
                n0 = t0:len()
                while eq <= n0 and t0:byte(eq) != 61
                    eq = eq + 1
                if eq <= n0
                    varname = trim(t0:sub(1, eq - 1))
                    matched = 1
        if matched == 1
            out = out .. varname .. " = __popcount_neon(" .. varname .. ")"
            out = out .. "\\n"
            k = k + 6
        else
            out = out .. lineat(src, k)
            out = out .. "\\n"
        k = k + 1
    out
