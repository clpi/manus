# Structural owner for one semantic application.
#
# Identities are supplied by the graph. This module preserves their complete
# shape; it does not mint, authenticate, project, or observe them.

identity: {
    meaning: i64
    content: i64
    incarnation: i64
}

pack: {
    identity: identity
    values: identity
    labels: identity
    positions: identity
    descriptors: identity
    constants: identity
    provenance: identity
}

application: {
    identity: identity
    relation: identity
    subject: identity
    arguments: pack
    result: pack
    descriptor: identity
    facts: identity
    world: identity
    effects: identity
    witness: identity
    provenance: identity
    demand: identity
}
