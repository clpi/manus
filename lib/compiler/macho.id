

_u8: str = (v: i64)
  digits = "0123456789abcdef"
  b: i64 = v & 255
  hi: i64 = b >> 4 & 15
  lo: i64 = b & 15
  digits:sub(hi + 1, hi + 1) .. digits:sub(lo + 1, lo + 1)

_u16: str = (v: i64)
  _u8(v) .. _u8(v >> 8)

_u32: str = (v: i64)
  _u8(v) .. _u8(v >> 8) .. _u8(v >> 16) .. _u8(v >> 24)

_u64: str = (v: i64)
  _u32(v) .. _u32(v >> 32)

_name16: str = (s: str)
  out = ""
  i: i64 = 1
  while i <= 16
    if i <= s:len()
      out = out .. _u8(s:byte(i))
    else
      out = out .. _u8(0)
    i = i + 1
  out

object_hex: str = (symbol: str, code: str)
  hdr: i64 = 32
  seg: i64 = 72 + 80
  sym: i64 = 24
  sizeofcmds: i64 = seg + sym
  code_off: i64 = hdr + sizeofcmds
  code_len: i64 = code:len() // 2
  sym_off: i64 = code_off + code_len
  nsyms: i64 = 1
  str_off: i64 = sym_off + 16 * nsyms
  strtab = _u8(0)
  si: i64 = 1
  strtab = strtab .. _u8(95)
  while si <= symbol:len()
    strtab = strtab .. _u8(symbol:byte(si))
    si = si + 1
  strtab = strtab .. _u8(0)
  str_len: i64 = strtab:len() // 2

  out = ""
  out = out .. _u32(4277009103)
  out = out .. _u32(16777228)
  out = out .. _u32(0)
  out = out .. _u32(1)
  out = out .. _u32(2)
  out = out .. _u32(sizeofcmds)
  out = out .. _u32(0)
  out = out .. _u32(0)

  out = out .. _u32(25)
  out = out .. _u32(seg)
  out = out .. _name16("")
  out = out .. _u64(0)
  out = out .. _u64(code_len)
  out = out .. _u64(code_off)
  out = out .. _u64(code_len)
  out = out .. _u32(7)
  out = out .. _u32(7)
  out = out .. _u32(1)
  out = out .. _u32(0)

  out = out .. _name16("__text")
  out = out .. _name16("__TEXT")
  out = out .. _u64(0)
  out = out .. _u64(code_len)
  out = out .. _u32(code_off)
  out = out .. _u32(2)
  out = out .. _u32(0)
  out = out .. _u32(0)
  out = out .. _u32(2147484672)
  out = out .. _u32(0)
  out = out .. _u32(0)
  out = out .. _u32(0)

  out = out .. _u32(2)
  out = out .. _u32(sym)
  out = out .. _u32(sym_off)
  out = out .. _u32(nsyms)
  out = out .. _u32(str_off)
  out = out .. _u32(str_len)

  out = out .. code

  out = out .. _u32(1)
  out = out .. _u8(15)
  out = out .. _u8(1)
  out = out .. _u16(0)
  out = out .. _u64(0)

  out .. strtab
