-- Structural schema for one semantic application.
--
-- This file declares the information a production graph must mint and retain.
-- It does not create identities or prove that the current compiler carries
-- them. Arguments and facts remain identities so their native containers can
-- move to the compiler substrate without changing application meaning.

identity: {
    meaning: i64
    content: i64
    incarnation: i64
}

application: {
    identity: identity
    relation: identity
    subject: identity
    arguments: identity
    result: identity
    descriptor: identity
    facts: identity
    world: identity
    effects: identity
    witness: identity
    provenance: identity
    demand: identity
}

projection: {
    application: identity
    relation: identity
    subject: identity
    operands: identity
    result: identity
    descriptor: identity
    facts: identity
    demand: identity
    provenance: identity
}
