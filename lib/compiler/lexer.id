# std.compiler.lexer
# Duo-native lexer implementation

# Slice is the subject's :sub / :len. Do not alias `str` into a binding —
# C emit materializes that as a text literal and then table-walks `.sub`.

Loc: {
    file: str,
    line: i64,
    col: i64
}

Tok: {
    kind: i64,
    loc: Loc,
    text: str,
    int_val: i64,
    float_val: f64
}

State: {
    pos: i64,
    start: i64,
    line: i64,
    col: i64,
    has_peeked: bool,
    peeked_token: Tok
}

Lexer: {
    src: str,
    pos: i64,
    start: i64,
    line: i64,
    col: i64,
    file: str,
    family: i64,
    has_peeked: bool,
    peeked_token: Tok,
    has_error: bool,
    error_loc: Loc,
    error_code: i64,
    hint_count: i64,
    hint_0: str,
    hint_1: str,
    hint_2: str,
    hint_3: str,
    hint_4: str,
    hint_5: str,
    hint_6: str,
    hint_7: str
}

new(src: str, file: str, family: i64): Lexer
    dummy_loc: Loc = { file = "", line = 0, col = 0 }
    dummy_tok: Tok = { kind = 0, loc = dummy_loc, text = "", int_val = 0, float_val = 0.0 }
    # Family is an operand (`law.family.one`). Path is provenance only.
    return {
        src = src,
        pos = 1,
        start = 1,
        line = 1,
        col = 1,
        file = file,
        family = family,
        has_peeked = false,
        peeked_token = dummy_tok,
        has_error = false,
        error_loc = dummy_loc,
        error_code = 0,
        hint_count = 0,
        hint_0 = "",
        hint_1 = "",
        hint_2 = "",
        hint_3 = "",
        hint_4 = "",
        hint_5 = "",
        hint_6 = "",
        hint_7 = "",
    }
end

cur_loc(self: Lexer): Loc
    return { file = self.file, line = self.line, col = self.col }
end

has_pending_hints(self: Lexer): bool
    self.hint_count > 0
end

consume_hints(self: Lexer): any
    hints = {}
    i = 0
    while i < self.hint_count
        if i == 0 hints[hints:len() + 1] = self.hint_0
        elseif i == 1 hints[hints:len() + 1] = self.hint_1
        elseif i == 2 hints[hints:len() + 1] = self.hint_2
        elseif i == 3 hints[hints:len() + 1] = self.hint_3
        elseif i == 4 hints[hints:len() + 1] = self.hint_4
        elseif i == 5 hints[hints:len() + 1] = self.hint_5
        elseif i == 6 hints[hints:len() + 1] = self.hint_6
        elseif i == 7 hints[hints:len() + 1] = self.hint_7
        end
        i += 1
    end
    self.hint_count = 0
    self.hint_0 = ""
    self.hint_1 = ""
    self.hint_2 = ""
    self.hint_3 = ""
    self.hint_4 = ""
    self.hint_5 = ""
    self.hint_6 = ""
    self.hint_7 = ""
    hints
end

peek_char(self: Lexer): i64
    if self.pos > self.src:len() return 0 end
    self.src:byte(self.pos)
end

peek_char2(self: Lexer): i64
    if self.pos + 1 > self.src:len() return 0 end
    self.src:byte(self.pos + 1)
end

adv(self: Lexer)
    if self.pos > self.src:len() return end
    c = self.src:byte(self.pos)
    self.pos = self.pos + 1
    if c == 10
        self.line = self.line + 1
        self.col = 1
    else
        self.col = self.col + 1
    end
end

is_digit(c: i64): bool
    (c >= 48 and c <= 57)
end

is_alpha(c: i64): bool
    ((c >= 65 and c <= 90) or (c >= 97 and c <= 122))
end

is_alnum(c: i64): bool
    is_alpha(c) or is_digit(c)
end

is_hex(c: i64): bool
    is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
end


# Keyword ordinals are token's. Spelling → ordinal here so generated C
# does not walk a `std` table or call a missing home.
lookup(w: str): i64
    if w == "and"
        return 4
    if w == "break"
        return 5
    if w == "continue"
        return 6
    if w == "do"
        return 7
    if w == "else"
        return 8
    if w == "elseif"
        return 9
    if w == "end"
        return 10
    if w == "false"
        return 11
    if w == "for"
        return 12
    if w == "function"
        return 13
    if w == "fun"
        return 14
    if w == "global"
        return 15
    if w == "goto"
        return 16
    if w == "if"
        return 17
    if w == "in"
        return 18
    if w == "local"
        return 19
    if w == "nil"
        return 20
    if w == "not"
        return 21
    if w == "or"
        return 22
    if w == "repeat"
        return 23
    if w == "return"
        return 24
    if w == "then"
        return 25
    if w == "true"
        return 26
    if w == "until"
        return 27
    if w == "while"
        return 28
    if w == "const"
        return 29
    if w == "enum"
        return 30
    if w == "i8"
        return 31
    if w == "i16"
        return 32
    if w == "i32"
        return 33
    if w == "i64"
        return 34
    if w == "u8"
        return 35
    if w == "u16"
        return 36
    if w == "u32"
        return 37
    if w == "u64"
        return 38
    if w == "f32"
        return 39
    if w == "f64"
        return 40
    if w == "bool"
        return 41
    if w == "void"
        return 42
    if w == "str"
        return 43
    if w == "match"
        return 44
    if w == "try"
        return 45
    if w == "catch"
        return 46
    if w == "defer"
        return 47
    if w == "async"
        return 48
    if w == "await"
        return 49
    if w == "concept"
        return 50
    if w == "alias"
        return 51
    if w == "private"
        return 52
    if w == "extends"
        return 53
    if w == "macro"
        return 54
    if w == "comptime"
        return 55
    if w == "by"
        return 56
    if w == "let"
        return 57
    0

# GAP-145: distinct literal identities keyed by quote and source-family fact,
# never by delimiter text or path suffix. family 1 = canon, 2 = compat.
classify_quote(family: i64, quote: i64): i64
    if quote == 34
        return 105
    end
    if quote == 39
        if family == 1
            return 106
        end
        return 107
    end
    107
end

long_bracket_level(self: Lexer): i64
    i = self.pos
    if i > self.src:len() or self.src:byte(i) != 91 return -1 end
    i += 1
    lvl = 0
    while i <= self.src:len() and self.src:byte(i) == 61
        lvl += 1
        i += 1
    end
    if i > self.src:len() or self.src:byte(i) != 91 return -1 end
    lvl
end

# GAP-017: a lexer error is a REJECTION the caller can count, not a process
# abort. `error(...)` killed the whole run, so one bad file truncated any corpus
# walk and silently shrank the denominator — and it made production dispatch
# impossible, because routing the compiler through this lexer would have turned
# every malformed source into a bare abort with no location.
#
# Codes mirror src/lexer.zig's LexError order so the host maps them directly:
#   1 UnterminatedString  2 UnterminatedLongString  3 InvalidEscape
#   4 UnexpectedChar
# First error wins: later failures are consequences of the first, and reporting
# the last one points at the wrong place.
_fail(self: Lexer, code: i64)
    if !self.has_error
        self.has_error = true
        self.error_code = code
        self.error_loc = self:cur_loc()
    end
end

skip_long(self: Lexer, level: i64)
    self:adv()
    i = 0
    while i < level
        self:adv()
        i += 1
    end
    self:adv()
    while self.pos <= self.src:len()
        if self:peek_char() == 93
            eq = 0
            self:adv()
            while self:peek_char() == 61
                self:adv()
                eq += 1
            end
            if eq == level and self:peek_char() == 93
                self:adv()
                return
            end
        else
            self:adv()
        end
    end
    self:_fail(2)
end

skip_ws(self: Lexer)
    while self.pos <= self.src:len()
        c = self:peek_char()
        if c == 32 or c == 9 or c == 13 or c == 10
            self:adv()
        else
            break
        end
    end
end

read_long_str(self: Lexer, level: i64): str
    self:adv()
    i = 0
    while i < level
        self:adv()
        i += 1
    end
    self:adv()
    if self:peek_char() == 10
        self:adv()
    elseif self:peek_char() == 13
        self:adv()
        if self:peek_char() == 10
            self:adv()
        end
    end
    start = self.pos
    self.start = start
    while self.pos <= self.src:len()
        if self:peek_char() == 93
            close_start = self.pos
            self:adv()
            eq = 0
            while self:peek_char() == 61
                self:adv()
                eq += 1
            end
            if eq == level and self:peek_char() == 93
                content = self.src:sub( start, close_start - 1)
                self:adv()
                return content
            end
        else
            self:adv()
        end
    end
    self:_fail(2)
    ""
end

read_str(self: Lexer, quote: i64): str
    self:adv()
    start = self.pos
    self.start = start
    while self.pos <= self.src:len()
        c = self:peek_char()
        if c == quote
            s = self.src:sub( start, self.pos - 1)
            self:adv()
            return s
        end
        if c == 10 or c == 13
            self:_fail(1)
            return ""
        end
        if c == 92
            self:adv()
            if self.pos > self.src:len()
                self:_fail(1)
                return ""
            end
            esc = self:peek_char()
            if esc == 120
                self:adv()
                if self.pos > self.src:len() or !is_hex(self:peek_char())
                    self:_fail(3)
                    return ""
                end
                self:adv()
                if self.pos <= self.src:len() and is_hex(self:peek_char())
                    self:adv()
                end
            elseif esc == 117
                self:adv()
                if self:peek_char() != 123
                    self:_fail(3)
                    return ""
                end
                self:adv()
                has_digit = false
                while self.pos <= self.src:len() and self:peek_char() != 125
                    if !is_hex(self:peek_char())
                        self:_fail(3)
                        return ""
                    end
                    has_digit = true
                    self:adv()
                end
                if !has_digit or self.pos > self.src:len() or self:peek_char() != 125
                    self:_fail(3)
                    return ""
                end
                self:adv()
            elseif esc == 122
                self:adv()
                while self.pos <= self.src:len()
                    ws = self:peek_char()
                    if ws == 32 or ws == 9 or ws == 13 or ws == 10
                        self:adv()
                    else
                        break
                    end
                end
            elseif esc == 13
                self:adv()
                if self.pos <= self.src:len() and self:peek_char() == 10
                    self:adv()
                end
            else
                self:adv()
            end
        else
            self:adv()
        end
    end
    self:_fail(1)
    ""
end

# GAP-023/024: exact decimal and hex to i64, never through f64.
#
# `to(i64)("4810305713451201937")` yields 4810305713451201536 — the value is
# 63 bits and an f64 mantissa carries 53, so the conversion rounds to a
# multiple of 512. That is a SILENT wrong number in a token, and it made the
# Duo lexer disagree with src/lexer.zig on every integer literal above 2^53:
# the two fingerprint proofs were the only programs that had one, which is why
# they were the only two that regressed under production dispatch.
#
# Digits accumulate in i64 directly. Values beyond i64 wrap rather than
# rejecting; that is the same shape the rest of the compiler carries today and
# is recorded in GAP-024 rather than fixed here.
_int_of(text: str): i64
    n: i64 = text:len()
    if n > 2 and text:byte(1) == 48 and (text:byte(2) == 120 or text:byte(2) == 88)
        # gap[042]: ACCUMULATE UNSIGNED, for the same reason the decimal path
        # below does. gap[024] fixed only the decimal accumulator; this one
        # stayed `i64`, so `v * 16` on any hex literal at or above 2^63 was
        # signed overflow and the compiler ABORTED lexing the file:
        #
        #     panic: signed integer overflow: 576460752303423488 * 16 cannot
        #     be represented in type 'int64_t'
        #
        # `lib/heap.id` writes `0xcbf29ce484222325` (the FNV-1a offset
        # basis) and `0xFFFFFFFFFFFFFFFF`; `lib/encoding/varint.id` and
        # `lib/ml/gguf.id` write `0x8000000000000000`. src/lexer.zig
        # already treats a hex literal as a BIT PATTERN — it retries as u64
        # and bitcasts — so accumulating unsigned here is what makes the two
        # lexers agree rather than a new convention.
        v: u64 = 0
        i: i64 = 3
        while i <= n
            c: i64 = text:byte(i)
            d: i64 = 0
            if c >= 48 and c <= 57
                d = c - 48
            elseif c >= 97 and c <= 102
                d = c - 87
            elseif c >= 65 and c <= 70
                d = c - 55
            else
                return v
            end
            v = v * 16 + d
            i += 1
        end
        return v
    end
    # gap[024]: ACCUMULATE UNSIGNED. This was `v: i64`, and `v * 10` on a
    # literal above i64 max is signed overflow # undefined behaviour that the
    # generated C traps on, so the COMPILER ABORTED (SIGABRT) rather than
    # lexing the file:
    #
    #     panic: signed integer overflow: 1363643836025834967 * 10 cannot be
    #     represented in type 'int64_t'
    #
    # reached from `print(tostring(13636438360258349679))` # the u64 form of
    # the text fingerprint, an ordinary literal a program is entitled to write.
    # Unsigned multiplication wraps rather than trapping, so the accumulator
    # carries the full 64-bit range and the value lands in int_val with the
    # same bits the host lexer's parseInt(u64) produces.
    v: u64 = 0
    i: i64 = 1
    while i <= n
        c: i64 = text:byte(i)
        if c < 48 or c > 57 return v end
        v = v * 10 + (c - 48)
        i += 1
    end
    v
end

read_num(self: Lexer): Tok
    l = self:cur_loc()
    start = self.pos
    is_float = false
    
    c1 = self:peek_char()
    c2 = self:peek_char2()
    if c1 == 48 and (c2 == 120 or c2 == 88)
        self:adv()
        self:adv()
        while is_hex(self:peek_char())
            self:adv()
        end
        if self:peek_char() == 46
            is_float = true
            self:adv()
            while is_hex(self:peek_char())
            self:adv()
        end
        end
        p = self:peek_char()
        if p == 112 or p == 80
            is_float = true
            self:adv()
            sgn = self:peek_char()
            if sgn == 43 or sgn == 45
                self:adv()
            end
            while is_digit(self:peek_char())
                self:adv()
            end
        end
    else
        while is_digit(self:peek_char())
            self:adv()
        end
        if self:peek_char() == 46
            n = self:peek_char2()
            if is_digit(n)
                is_float = true
                self:adv()
                while is_digit(self:peek_char())
            self:adv()
        end
            end
        end
        e = self:peek_char()
        if e == 101 or e == 69
            is_float = true
            self:adv()
            sgn = self:peek_char()
            if sgn == 43 or sgn == 45
                self:adv()
            end
            while is_digit(self:peek_char())
                self:adv()
            end
        end
    end
    
    text = self.src:sub( start, self.pos - 1)
    # `to(f64)`/`to(i64)`, NOT `tonumber(text) or 0.0`. The `or` truncated the
    # float: `tonumber("1.5")` is 1.5, and `tonumber("1.5") or 0.0` is **1**.
    # Measured 2026-08-07, filed as GAP-021.
    #
    # Nothing caught it for as long as it existed, because float_val is the one
    # token field no differential reads — the kind fingerprint hashes kinds, the
    # text fingerprint hashes text. Every float literal in the language lexed to
    # its integer part, silently. That is why duo_lexer_tokenize_full carries the
    # field: dispatch on tokenize_text would have shipped this.
    #
    # The fallback is dropped rather than re-spelled: this branch is reached only
    # after read_number has already scanned a well-formed literal, so `or 0.0`
    # was defending an unreachable case while corrupting the reachable one.
    if is_float
        return { kind = 2, loc = l, text = text, int_val = 0, float_val = to(f64)(text) }
    else
        return { kind = 1, loc = l, text = text, int_val = _int_of(text), float_val = 0.0 }
    end
end

next_tok(self: Lexer): Tok
    if self.pos == 1 and self:peek_char() == 35 and self:peek_char2() == 33
        l = self:cur_loc()
        start = self.pos
        while self.pos <= self.src:len() and self:peek_char() != 10
            self:adv()
        end
        text = self.src:sub(start, self.pos - 1)
        return { kind = 110, loc = l, text = text, int_val = 0, float_val = 0.0 }
    end
    self:skip_ws()
    self.start = self.pos
    if self.pos > self.src:len()
        return { kind = 109, loc = self:cur_loc(), text = "", int_val = 0, float_val = 0.0 }
    end
    
    l = self:cur_loc()
    c = self:peek_char()
    
    if is_digit(c) or (c == 46 and is_digit(self:peek_char2()))
        return self:read_num()
    end
    
    if is_alpha(c) or c == 95
        start = self.pos
        while self.pos <= self.src:len()
            p = self:peek_char()
            if is_alnum(p) or p == 95
                self:adv()
            else
                break
            end
        end
        text = self.src:sub( start, self.pos - 1)
        kind = lookup(text)
        if kind == 0
            kind = 0
        end
        return { kind = kind, loc = l, text = text, int_val = 0, float_val = 0.0 }
    end
    
    if c == 39 or c == 34
        lit_kind = classify_quote(self.family, c)
        s = self:read_str(c)
        return { kind = lit_kind, loc = l, text = s, int_val = 0, float_val = 0.0 }
    end
    
    if c == 91
        lvl = self:long_bracket_level()
        if lvl >= 0
            s = self:read_long_str(lvl)
            return { kind = 108, loc = l, text = s, int_val = lvl, float_val = 0.0 }
        end
    end
    
    if c == 35 and self.family == 1
        start = self.pos
        while self.pos <= self.src:len() and self:peek_char() != 10
            self:adv()
        end
        text = self.src:sub(start, self.pos - 1)
        return { kind = 111, loc = l, text = text, int_val = 0, float_val = 0.0 }
    end

    if c == 45 and self:peek_char2() == 45
        start = self.pos
        self:adv()
        self:adv()
        lvl = self:long_bracket_level()
        if lvl >= 0
            self:skip_long(lvl)
            text = self.src:sub(start, self.pos - 1)
            return { kind = 113, loc = l, text = text, int_val = 0, float_val = 0.0 }
        end
        is_triple = (self.pos <= self.src:len() and self:peek_char() == 45)
        if is_triple
            self:adv()
        end
        body = self.pos
        while self.pos <= self.src:len() and self:peek_char() != 10
            self:adv()
        end
        if is_triple and self.hint_count < 8
            if body <= self.src:len() and self.src:byte(body) == 64
                h = self.src:sub(body + 1, self.pos - 1)
                if self.hint_count == 0 self.hint_0 = h
                elseif self.hint_count == 1 self.hint_1 = h
                elseif self.hint_count == 2 self.hint_2 = h
                elseif self.hint_count == 3 self.hint_3 = h
                elseif self.hint_count == 4 self.hint_4 = h
                elseif self.hint_count == 5 self.hint_5 = h
                elseif self.hint_count == 6 self.hint_6 = h
                elseif self.hint_count == 7 self.hint_7 = h
                end
                self.hint_count = self.hint_count + 1
            end
        end
        text = self.src:sub(start, self.pos - 1)
        return { kind = 112, loc = l, text = text, int_val = 0, float_val = 0.0 }
    end
    
    self:adv()
    p = self.pos
    
    if c == 43
        if self:peek_char() == 61
            self:adv()
            return { kind = 99, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 64, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 42
        if self:peek_char() == 61
            self:adv()
            return { kind = 101, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 66, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 37
        if self:peek_char() == 61
            self:adv()
            return { kind = 103, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 68, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 94
        if self:peek_char() == 61
            self:adv()
            return { kind = 104, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 69, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 35
        if self:peek_char() == 35
            self:adv()
            return { kind = 87, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 70, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 38
        return { kind = 71, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 124
        if self.pos <= self.src:len() and self.src:byte(self.pos) == 62
            self.pos = self.pos + 1
            return { kind = 97, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 72, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 40
        return { kind = 58, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 41
        return { kind = 59, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 91
        return { kind = 60, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 93
        return { kind = 61, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 123
        return { kind = 62, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 125
        return { kind = 63, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 59
        return { kind = 77, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 44
        return { kind = 79, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 45
        if self:peek_char() == 61
            self:adv()
            return { kind = 100, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 62
            self:adv()
            return { kind = 96, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 65, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 47
        if self:peek_char() == 61
            self:adv()
            return { kind = 102, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 47
            self:adv()
            return { kind = 94, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 67, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 46
        if self:peek_char() == 46
            self:adv()
            if self:peek_char() == 46
                self:adv()
                return { kind = 86, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
            end
            return { kind = 85, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 80, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 61
        if self:peek_char() == 61
            self:adv()
            return { kind = 88, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 62
            self:adv()
            return { kind = 98, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 75, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 126
        # `~` is XOR and nothing else. It used to swallow a following `=` and
        # report inequality (kind 89), which is Lua's spelling, not this
        # language's: inequality is `!=`. Eagerly gluing the `=` here was also
        # what made `x ~= 1` silently a DISCARDED COMPARISON where xor-assign
        # was meant. Emitting the bare tilde lets the grammar's adjacency rule
        # form `~=` as a compound assignment, exactly as it already forms
        # `>>=`, `<<=`, `|=` and `&=`.
        return { kind = 76, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 60
        if self:peek_char() == 61
            self:adv()
            return { kind = 90, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 60
            self:adv()
            return { kind = 92, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 73, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 62
        if self:peek_char() == 61
            self:adv()
            return { kind = 91, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 62
            self:adv()
            return { kind = 93, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 74, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 58
        if self:peek_char() == 58
            self:adv()
            return { kind = 95, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 78, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 64
        return { kind = 81, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 63
        return { kind = 82, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 33
        if self:peek_char() == 61
            self:adv()
            return { kind = 89, loc = l, text = self.src:sub( p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = 83, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 96
        if self.family == 1
            self:_fail(4)
            return { kind = 109, loc = l, text = "", int_val = 0, float_val = 0.0 }
        end
        return { kind = 84, loc = l, text = self.src:sub( p - 1, p - 1), int_val = 0, float_val = 0.0 }
    else
        self:_fail(4)
        return { kind = 109, loc = l, text = "", int_val = 0, float_val = 0.0 }
    end
end

next(self: Lexer): Tok
    if self.has_peeked
        tok = self.peeked_token
        self.has_peeked = false
        return tok
    end
    return self:next_tok()
end

peek(self: Lexer): Tok
    if !self.has_peeked
        self.peeked_token = self:next_tok()
        self.has_peeked = true
    end
    self.peeked_token
end

save_state(self: Lexer): State
    return {
        pos = self.pos,
        start = self.start,
        line = self.line,
        col = self.col,
        has_peeked = self.has_peeked,
        peeked_token = self.peeked_token,
    }
end

restore_state(self: Lexer, state: State)
    self.pos = state.pos
    self.start = state.start
    self.line = state.line
    self.col = state.col
    self.has_peeked = state.has_peeked
    self.peeked_token = state.peeked_token
end

# ── sovereign tokenize surface ───────────────────────────────────────────────
#
# Two entries, because two is all the power needs: a streaming primitive the host
# tokenizer loop consumes, and the differential that proves this lexer agrees with
# the production one token-for- Everything else (counts, kinds at an index,
# spans) derives from `step` in the caller, and deriving it there is also the only
# way to keep it O(n) — a `kind_at(index)` entry must re-lex per call.
#
# Both lower through DNIR to native machine code: no C backend, no runtime helper.
# The native symbol is the function name.

# Lex one token at 1-based byte offset `pos`; return `kind * 2^40 + next_pos`.
# Feed `next_pos` back to walk the stream in O(n). Packing keeps this a single
# scalar, so no aggregate crosses the boundary.
#
# `kind` is at most 105 and `next_pos` is a byte offset, so the product cannot
# overflow i64 for any source a compiler will see.
# Whole-file tokenize in ONE call, writing into a host-provided buffer.
#
# This is the shape production dispatch needs, and `duo_lexer_step` is not it.
# Step rebuilds a `Lexer` at a byte offset, which discards `has_peeked` /
# `peeked_token` and the hint state the type carries, so a step-driven walk
# silently mis-lexes context-sensitive shapes (bisected to the `=` in
# `fun add(a: i64): i64 =`). Here a single `Lexer` runs the whole file, so the
# stream is state-faithful by construction, and it is O(n) with no cursor ABI.
#
# `out` is a host address (see `mem.addr` / `mem.ptr_from_addr`); tokens are
# written as four i64 fields — kind, line, col, int_val — and the return is the
# token count including the terminating EOF, or -1 if `cap` is too small.
# Whole-file tokenize carrying TEXT as well, into two host-provided buffers.
#
# `duo_lexer_tokenize_all` is enough to fingerprint a stream but not to DRIVE a
# parser: the host also needs each token's text, and text is not a slice of the
# source once escapes are processed, so start/end offsets cannot recover it.
# Here the caller supplies a second arena; each token records (offset, length)
# into it. The arena belongs to the HOST, which keeps the no-writable-__DATA
# constraint in this file's header intact — nothing is allocated on the Duo
# side beyond what std.str already does.
#
# Six i64 per token: kind, line, col, int_val, text_off, text_len.
# Returns the token count including EOF, or -1 if either buffer is too small.
duo_lexer_tokenize_text(src: str, file: str, family: i64, out: i64, cap: i64, txt: i64, txtcap: i64): i64
    lex = new(src, file, family)
    buf = mem.ptr_from_addr(i64, out)
    tbuf = mem.ptr_from_addr(i64, txt)
    n: i64 = 0
    toff: i64 = 0
    while n < cap
        tok = next_tok(lex)
        tlen: i64 = lex.pos - lex.start
        if tok.kind == 105 or tok.kind == 106 or tok.kind == 107
            tlen = tlen - 1
        end
        if tok.kind == 108
            tlen = tlen - 2 - tok.int_val
        end
        if tlen < 0
            tlen = 0
        end
        if toff + tlen > txtcap return -1 end
        k: i64 = 0
        while k < tlen
            mem.write_byte(tbuf, toff + k, tok.text:byte(k + 1))
            k += 1
        end
        mem.write_i64(buf, (n * 6) * 8, tok.kind)
        mem.write_i64(buf, (n * 6 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 6 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 6 + 3) * 8, tok.int_val)
        mem.write_i64(buf, (n * 6 + 4) * 8, toff)
        mem.write_i64(buf, (n * 6 + 5) * 8, tlen)
        toff += tlen
        n += 1
        if tok.kind == 109 return n end
    end
    -1
end

# The PRODUCTION DISPATCH entry: everything the host `Token` carries, in one
# pass. `tokenize_text` is one field short of that — it drops `float_val`, so a
# host driven by it would silently mis-read every float literal while every
# kind-based differential stayed green. That is the same shape as the token-TEXT
# gap this file already records, so the field is carried rather than recomputed.
#
# Positional seven-i64 records are SCHEMA-ONE debt. Host RECORD_SLOTS and
# slot decode are a second copy of this law. Deletion: producer-projected
# record or immutable token view — not a named Zig slot map.
#     0 kind   1 line   2 col   3 int_val   4 source offset   5 text length   6 float value
#
# Returns the token count, or -1 if `cap` is too small. The final two arguments
# remain only to preserve the bootstrap ABI while consumers migrate; token text
# is no longer copied through them. A short read that looks like a short file is
# the one failure a parser cannot detect.
# The rejection's location, for a host that has just been handed a negative
# code. Re-lexes: this is the cold path, taken once per failed file.
duo_lexer_error_line(src: str, file: str, family: i64): i64
    lex = new(src, file, family)
    n: i64 = 0
    while n < 10000000
        tok = next_tok(lex)
        n += 1
        if lex.has_error return lex.error_loc.line end
        if tok.kind == 109 return 0 end
    end
    0
end

duo_lexer_tokenize_full(src: str, file: str, family: i64, out: i64, cap: i64, txt: i64, txtcap: i64): i64
    lex = new(src, file, family)
    buf = mem.ptr_from_addr(i64, out)
    n: i64 = 0
    toff: i64 = 0
    while n < cap
        tok = next_tok(lex)
        # Cursor span, not tok.text:len(). dump-c lowers :len() to strlen
        # on the native char* field — a full walk of every token on the
        # compile hot path. start/pos already bound the published bytes:
        # quoted content excludes the closer still sitting in pos.
        toff = lex.start - 1
        tlen: i64 = lex.pos - lex.start
        if tok.kind == 105 or tok.kind == 106 or tok.kind == 107
            tlen = tlen - 1
        end
        if tok.kind == 108
            tlen = tlen - 2 - tok.int_val
        end
        if tlen < 0
            tlen = 0
        end
        mem.write_i64(buf, (n * 7) * 8, tok.kind)
        mem.write_i64(buf, (n * 7 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 7 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 7 + 3) * 8, tok.int_val)
        mem.write_i64(buf, (n * 7 + 4) * 8, toff)
        mem.write_i64(buf, (n * 7 + 5) * 8, tlen)
        mem.write_f64(buf, (n * 7 + 6) * 8, tok.float_val)
        n += 1
        # GAP-017: a rejection is returned, not raised. Negative codes offset
        # by 100 so they cannot collide with -1 (buffer too small) are
        # MAGIC-CODE-ZERO debt. Deletion: carry rejection-id, never -101…-105.
        if lex.has_error return 0 - 100 - lex.error_code end
        if tok.kind == 109 return n end
    end
    -1
end

duo_lexer_tokenize_all(src: str, file: str, family: i64, out: i64, cap: i64): i64
    lex = new(src, file, family)
    buf = mem.ptr_from_addr(i64, out)
    n: i64 = 0
    while n < cap
        tok = next_tok(lex)
        mem.write_i64(buf, (n * 4) * 8, tok.kind)
        mem.write_i64(buf, (n * 4 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 4 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 4 + 3) * 8, tok.int_val)
        n += 1
        if lex.has_error return 0 - 100 - lex.error_code end
        if tok.kind == 109 return n end
    end
    -1
end

duo_lexer_step(src: str, file: str, family: i64, pos: i64): i64
    lex = new(src, file, family)
    lex.pos = pos
    tok = next_tok(lex)
    tok.kind * 1099511627776 + lex.pos
end

# Token-kind fingerprint: mixes every token including the terminating EOF.
# Agrees bit-for-bit with `src/lexer_differential.zig:fingerprintSource`
# (`h = h * 31 + kind`), which is what makes it a differential against the
# production lexer rather than a self-consistency check.
#
# u64, not i64: a hash must wrap, and signed overflow is UB in lowered code.
# Token-TEXT fingerprint, the companion to `duo_lexer_kind_fingerprint`.
#
# The kind fingerprint hashes only `tok.kind`, so text equivalence with
# `src/lexer.zig` was never differenced — a lexer could return the wrong bytes
# for every string literal and the corpus proof would stay green. That gap let
# me both mis-diagnose and then mis-"fix" the escape contract in one session.
#
# Mixes the LENGTH before the bytes so that concatenation cannot alias: "ab"
# then "c" must not hash like "a" then "bc". Includes the terminating EOF
# (length 0), matching `lexer_differential.textFingerprintSource`.
duo_lexer_text_fingerprint(src: str, file: str, family: i64): u64
    lex = new(src, file, family)
    h: u64 = 0
    while true
        tok = next_tok(lex)
        tl: i64 = tok.text:len()
        h = h * 31 + tl
        bi: i64 = 1
        while bi <= tl
            h = h * 31 + tok.text:byte(bi)
            bi += 1
        end
        if tok.kind == 109 return h end
    end
    h
end

duo_lexer_kind_fingerprint(src: str, file: str, family: i64): u64
    lex = new(src, file, family)
    h: u64 = 0
    while true
        tok = next_tok(lex)
        h = h * 31 + tok.kind
        if tok.kind == 109 return h end
    end
    h
end

# ── producer-projected schema (SCHEMA-ONE, MAGIC-CODE-ZERO) ───────────────
# Host must not independently know slot positions, rejection codes, or token
# kind ordinals. Query these facts instead of hardcoding.

recordslots(): i64
    7
end

fieldkind(): i64
    0
end

fieldline(): i64
    1
end

fieldcol(): i64
    2
end

fieldint(): i64
    3
end

fieldoff(): i64
    4
end

fieldlen(): i64
    5
end

fieldfloat(): i64
    6
end

rejectioncount(): i64
    5
end

rejectioncode(i: i64): i64
    if i == 1 return -101 end
    if i == 2 return -102 end
    if i == 3 return -103 end
    if i == 4 return -104 end
    if i == 5 return -105 end
    -1
end

rejectionname(code: i64): str
    if code == -101 return "UnterminatedString" end
    if code == -102 return "UnterminatedLongString" end
    if code == -103 return "InvalidEscape" end
    if code == -104 return "UnexpectedChar" end
    if code == -105 return "InsufficientIndent" end
    ""
end

kindcount(): i64
    114
end

kindname(i: i64): str
    if i == 0 return "name" end
    if i == 1 return "int_lit" end
    if i == 2 return "float_lit" end
