    if i == 4 return -104
    if i == 5 return -105 end
    -1

rejectionname: str = (code: i64)
    if code == -101 return "UnterminatedString"
    if code == -102 return "UnterminatedLongString"
    if code == -103 return "InvalidEscape"
    if code == -104 return "UnexpectedChar"
    if code == -105 return "InsufficientIndent"
    ""

