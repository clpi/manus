    if i == 101 return "star_assign"
    if i == 102 return "slash_assign"
    if i == 103 return "percent_assign"
    if i == 104 return "caret_assign"
    if i == 105 return "text_lit"
    if i == 106 return "bytes_lit"
    if i == 107 return "compat_text_lit"
    if i == 108 return "long_text_lit"
    if i == 109 return "eof"
    if i == 110 return "shebang"
    if i == 111 return "comment"
    if i == 112 return "compat_comment"
    if i == 113 return "compat_long_comment"
    ""
