# compiler.lexer
# Duo-native lexer implementation

# Slice is the subject's :sub / :len. Do not alias `str` into a binding —
# C emit materializes that as a text literal and then table-walks `.sub`.

loc: {
    file: str,
    line: i64,
    col: i64
}

token: {
    kind: i64,
    loc: loc,
    # Compatibility projection for the historical Idol parser. `next_tok`
    # publishes exact source coordinates and leaves this empty unless a local
    # semantic consumer already required text. `next` materializes it only for
    # the old parser boundary; production dispatch consumes `off` / `len`.
    text: str,
    off: i64,
    len: i64,
    int_val: i64,
    float_val: f64
}

state: {
    pos: i64,
    start: i64,
    line: i64,
    col: i64,
    has_peeked: bool,
    peeked_token: token
}

lexer: {
    src: str,
    # Bootstrap bridge: `str` is still a pointer-only physical view, so `:len()`
    # walks the source bytes. Carry the exact extent beside that borrowed view.
    # law.bridge.death: delete this field when `str` realizes as pointer + extent
    # and `:len()` consumes the view fact in constant time.
    extent: i64,
    pos: i64,
    start: i64,
    line: i64,
    col: i64,
    file: str,
    family: i64,
    has_peeked: bool,
    peeked_token: token,
    has_error: bool,
    error_loc: loc,
    error_code: i64,
    # Column of the statement currently being projected. Expression-level layout
    # rules (bare `(a)` lambda heads) compare against this, not the `(` column.
    stmt_col: i64
}

new: lexer = (src: str, file: str, family: i64)
    dummy_loc: loc = { file = "", line = 0, col = 0 }
    dummy_tok: token = { kind = 0, loc = dummy_loc, text = "", off = 0, len = 0, int_val = 0, float_val = 0.0 }
    # Family is an operand (`law.family.one`). Path is provenance only.
    return {
        src = src,
        extent = src:len(),
        pos = 1,
        start = 1,
        line = 1,
        col = 1,
        file = file,
        family = family,
        has_peeked = false,
        peeked_token = dummy_tok,
        has_error = false,
        error_loc = dummy_loc,
        error_code = 0,
        stmt_col = 0,
    }

cur_loc: loc = (self: lexer)
    return { file = self.file, line = self.line, col = self.col }

peek_char: i64 = (self: lexer)
    if self.pos > self.extent return 0
    self.src:byte(self.pos)

peek_char2: i64 = (self: lexer)
    if self.pos + 1 > self.extent return 0
    self.src:byte(self.pos + 1)

adv(self: lexer)
    if self.pos > self.extent return
    c = self.src:byte(self.pos)
    self.pos = self.pos + 1
    if c == 10
        self.line = self.line + 1
        self.col = 1
    else
        self.col = self.col + 1

is_digit: bool = (c: i64)
    (c >= 48 and c <= 57)

is_alpha: bool = (c: i64)
    ((c >= 65 and c <= 90) or (c >= 97 and c <= 122))

is_alnum: bool = (c: i64)
    is_alpha(c) or is_digit(c)

is_hex: bool = (c: i64)
    is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)


# Compare one already-bounded source span with a fixed word. `lookup` derives
# the extent once from the token and contracts the candidate set by extent, so
# this hot edge neither materializes text nor measures any string repeatedly.
word: bool = (self: lexer, start: i64, n: i64, pattern: str)
    i: i64 = 1
    while i <= n
        if self.src:byte(start + i - 1) != pattern:byte(i) return false
        i += 1
    true

# Keyword ordinals are token's. Spelling → ordinal here so generated C
# does not walk a `std` table or call a missing home.
lookup: i64 = (self: lexer, start: i64, stop: i64)
    n: i64 = stop - start + 1
    if n == 2
        if self:word(start, n, "by") return 56
        if self:word(start, n, "do") return 7
        if self:word(start, n, "i8") return 31
        if self:word(start, n, "if") return 17
        if self:word(start, n, "in") return 18
        if self:word(start, n, "or") return 22
        if self:word(start, n, "u8") return 35
    elseif n == 3
        if self:word(start, n, "and") return 4
        if self:word(start, n, "end") return 10
        if self:word(start, n, "f32") return 39
        if self:word(start, n, "f64") return 40
        if self:word(start, n, "for") return 12
        if self:word(start, n, "fun") return 14
        if self:word(start, n, "i16") return 32
        if self:word(start, n, "i32") return 33
        if self:word(start, n, "i64") return 34
        if self:word(start, n, "let") return 57
        if self:word(start, n, "nil") return 20
        if self:word(start, n, "not") return 21
        if self:word(start, n, "str") return 43
        if self:word(start, n, "try") return 45
        if self:word(start, n, "u16") return 36
        if self:word(start, n, "u32") return 37
        if self:word(start, n, "u64") return 38
    elseif n == 4
        if self:word(start, n, "bool") return 41
        if self:word(start, n, "else") return 8
        if self:word(start, n, "enum") return 30
        if self:word(start, n, "goto") return 16
        if self:word(start, n, "then") return 25
        if self:word(start, n, "true") return 26
        if self:word(start, n, "void") return 42
    elseif n == 5
        # Retired keyword `alias` — ordinary identifier under current law.
        if self:word(start, n, "async") return 48
        if self:word(start, n, "await") return 49
        if self:word(start, n, "break") return 5
        if self:word(start, n, "catch") return 46
        if self:word(start, n, "const") return 29
        if self:word(start, n, "defer") return 47
        if self:word(start, n, "false") return 11
        if self:word(start, n, "local") return 19
        if self:word(start, n, "macro") return 54
        if self:word(start, n, "match") return 44
        if self:word(start, n, "until") return 27
        if self:word(start, n, "while") return 28
    elseif n == 6
        if self:word(start, n, "elseif") return 9
        if self:word(start, n, "global") return 15
        if self:word(start, n, "repeat") return 23
        if self:word(start, n, "return") return 24
    elseif n == 7
        if self:word(start, n, "concept") return 50
        if self:word(start, n, "extends") return 53
        if self:word(start, n, "private") return 52
    elseif n == 8
        if self:word(start, n, "comptime") return 55
        if self:word(start, n, "continue") return 6
        if self:word(start, n, "function") return 13
    0

# GAP-145: distinct literal identities keyed by quote and source-family fact,
# never by delimiter text or path suffix. family 1 = canon, 2 = compat.
classify_quote: i64 = (family: i64, quote: i64)
    if quote == 34
        return 105
    if quote == 39
        if family == 1
            return 106
        return 107
    107

long_bracket_level: i64 = (self: lexer)
    i = self.pos
    if i > self.extent or self.src:byte(i) != 91 return -1
    i += 1
    lvl = 0
    while i <= self.extent and self.src:byte(i) == 61
        lvl += 1
        i += 1
    if i > self.extent or self.src:byte(i) != 91 return -1
    lvl

# GAP-017: a lexer error is a REJECTION the caller can count, not a process
# abort. `error(...)` killed the whole run, so one bad file truncated any corpus
# walk and silently shrank the denominator — and it made production dispatch
# impossible, because routing the compiler through this lexer would have turned
# every malformed source into a bare abort with no location.
#
# Codes mirror src/lexer.zig's LexError order so the host maps them directly:
#   1 UnterminatedString  2 UnterminatedLongString  3 InvalidEscape
#   4 UnexpectedChar
# First error wins: later failures are consequences of the first, and reporting
# the last one points at the wrong place.
_fail(self: lexer, code: i64)
    if !self.has_error
        self.has_error = true
        self.error_code = code
        self.error_loc = self:cur_loc()

skip_long(self: lexer, level: i64)
    self:adv()
    i = 0
    while i < level
        self:adv()
        i += 1
    self:adv()
    while self.pos <= self.extent
        if self:peek_char() == 93
            eq = 0
            self:adv()
            while self:peek_char() == 61
                self:adv()
                eq += 1
            if eq == level and self:peek_char() == 93
                self:adv()
                return
        else
            self:adv()
    self:_fail(2)

skip_ws(self: lexer)
    while self.pos <= self.extent
        c = self:peek_char()
        if c == 32 or c == 9 or c == 13 or c == 10
            self:adv()
        else
            break

read_long_str(self: lexer, level: i64)
    self:adv()
    i = 0
    while i < level
        self:adv()
        i += 1
    self:adv()
    if self:peek_char() == 10
        self:adv()
    elseif self:peek_char() == 13
        self:adv()
        if self:peek_char() == 10
            self:adv()
    self.start = self.pos
    while self.pos <= self.extent
        if self:peek_char() == 93
            self:adv()
            eq = 0
            while self:peek_char() == 61
                self:adv()
                eq += 1
            if eq == level and self:peek_char() == 93
                self:adv()
                return
        else
            self:adv()
    self:_fail(2)

read_str(self: lexer, quote: i64)
    self:adv()
    self.start = self.pos
    while self.pos <= self.extent
        c = self:peek_char()
        if c == quote
            self:adv()
            return
        if c == 10 or c == 13
            self:_fail(1)
            return
        if c == 92
            self:adv()
            if self.pos > self.extent
                self:_fail(1)
                return
            esc = self:peek_char()
            if esc == 120
                self:adv()
                if self.pos > self.extent or !is_hex(self:peek_char())
                    self:_fail(3)
                    return
                self:adv()
                if self.pos <= self.extent and is_hex(self:peek_char())
                    self:adv()
            elseif esc == 117
                self:adv()
                if self:peek_char() != 123
                    self:_fail(3)
                    return
                self:adv()
                has_digit = false
                while self.pos <= self.extent and self:peek_char() != 125
                    if !is_hex(self:peek_char())
                        self:_fail(3)
                        return
                    has_digit = true
                    self:adv()
                if !has_digit or self.pos > self.extent or self:peek_char() != 125
                    self:_fail(3)
                    return
                self:adv()
            elseif esc == 122
                self:adv()
                while self.pos <= self.extent
                    ws = self:peek_char()
                    if ws == 32 or ws == 9 or ws == 13 or ws == 10
                        self:adv()
                    else
                        break
            elseif esc == 13
                self:adv()
                if self.pos <= self.extent and self:peek_char() == 10
                    self:adv()
            else
                self:adv()
        else
            self:adv()
    self:_fail(1)

# One token identity with two physical projections. `off` / `len` are exact
# source facts consumed by production. `text` is a temporary compatibility
# view retained only for the historical Idol parser until it consumes spans.
span: token = (kind: i64, loc: loc, text: str, off: i64, len: i64, integer: i64, decimal: f64)
    at: loc = { file = loc.file, line = loc.line, col = loc.col }
    { kind = kind, loc = at, text = text, off = off, len = len, int_val = integer, float_val = decimal }

# GAP-023/024: exact decimal and hex to i64, never through f64.
#
# `to(i64)("4810305713451201937")` yields 4810305713451201536 — the value is
# 63 bits and an f64 mantissa carries 53, so the conversion rounds to a
# multiple of 512. That is a SILENT wrong number in a token, and it made the
# Duo lexer disagree with src/lexer.zig on every integer literal above 2^53:
# the two fingerprint proofs were the only programs that had one, which is why
# they were the only two that regressed under production dispatch.
#
# Digits accumulate in i64 directly. Values beyond i64 wrap rather than
# rejecting; that is the same shape the rest of the compiler carries today and
# is recorded in GAP-024 rather than fixed here.
_int_of: i64 = (self: lexer, start: i64, stop: i64)
    n: i64 = stop - start + 1
    if n > 2 and self.src:byte(start) == 48 and (self.src:byte(start + 1) == 120 or self.src:byte(start + 1) == 88)
        # gap[042]: ACCUMULATE UNSIGNED, for the same reason the decimal path
        # below does. gap[024] fixed only the decimal accumulator; this one
        # stayed `i64`, so `v * 16` on any hex literal at or above 2^63 was
        # signed overflow and the compiler ABORTED lexing the file:
        #
        #     panic: signed integer overflow: 576460752303423488 * 16 cannot
        #     be represented in type 'int64_t'
        #
        # `lib/heap.id` writes `0xcbf29ce484222325` (the FNV-1a offset
        # basis) and `0xFFFFFFFFFFFFFFFF`; `lib/encoding/varint.id` and
        # `lib/ml/gguf.id` write `0x8000000000000000`. src/lexer.zig
        # already treats a hex literal as a BIT PATTERN — it retries as u64
        # and bitcasts — so accumulating unsigned here is what makes the two
        # lexers agree rather than a new convention.
        v: u64 = 0
        i: i64 = start + 2
        while i <= stop
            c: i64 = self.src:byte(i)
            d: i64 = 0
            if c >= 48 and c <= 57
                d = c - 48
            elseif c >= 97 and c <= 102
                d = c - 87
            elseif c >= 65 and c <= 70
                d = c - 55
            else
                return v
            v = v * 16 + d
            i += 1
        return v
    # gap[024]: ACCUMULATE UNSIGNED. This was `v: i64`, and `v * 10` on a
    # literal above i64 max is signed overflow # undefined behaviour that the
    # generated C traps on, so the COMPILER ABORTED (SIGABRT) rather than
    # lexing the file:
    #
    #     panic: signed integer overflow: 1363643836025834967 * 10 cannot be
    #     represented in type 'int64_t'
    #
    # reached from `print(tostring(13636438360258349679))` # the u64 form of
    # the text fingerprint, an ordinary literal a program is entitled to write.
    # Unsigned multiplication wraps rather than trapping, so the accumulator
    # carries the full 64-bit range and the value lands in int_val with the
    # same bits the host lexer's parseInt(u64) produces.
    v: u64 = 0
    i: i64 = start
    while i <= stop
        c: i64 = self.src:byte(i)
        if c < 48 or c > 57 return v
        v = v * 10 + (c - 48)
        i += 1
    v

read_num: token = (self: lexer)
    l = self:cur_loc()
    start = self.pos
    is_float = false
    
    c1 = self:peek_char()
    c2 = self:peek_char2()
    if c1 == 48 and (c2 == 120 or c2 == 88)
        self:adv()
        self:adv()
        while is_hex(self:peek_char())
            self:adv()
        if self:peek_char() == 46
            is_float = true
            self:adv()
            while is_hex(self:peek_char())
            self:adv()
        end
        p = self:peek_char()
        if p == 112 or p == 80
            is_float = true
            self:adv()
            sgn = self:peek_char()
            if sgn == 43 or sgn == 45
                self:adv()
            while is_digit(self:peek_char())
                self:adv()
    else
        while is_digit(self:peek_char())
            self:adv()
        if self:peek_char() == 46
            n = self:peek_char2()
            if is_digit(n)
                is_float = true
                self:adv()
                while is_digit(self:peek_char())
            self:adv()
        end
        e = self:peek_char()
        if e == 101 or e == 69
            is_float = true
            self:adv()
            sgn = self:peek_char()
            if sgn == 43 or sgn == 45
                self:adv()
            while is_digit(self:peek_char())
                self:adv()
    
    # `to(f64)`/`to(i64)`, NOT `tonumber(text) or 0.0`. The `or` truncated the
    # float: `tonumber("1.5")` is 1.5, and `tonumber("1.5") or 0.0` is **1**.
    # Measured 2026-08-07, filed as GAP-021.
    #
    # Nothing caught it for as long as it existed, because float_val is the one
    # token field no differential reads — the kind fingerprint hashes kinds, the
    # text fingerprint hashes text. Every float literal in the language lexed to
    # its integer part, silently. That is why duo_lexer_tokenize_full carries the
    # field: dispatch on tokenize_text would have shipped this.
    #
    # The fallback is dropped rather than re-spelled: this branch is reached only
    # after read_number has already scanned a well-formed literal, so `or 0.0`
    # was defending an unreachable case while corrupting the reachable one.
    if is_float
        # The current numeric conversion boundary consumes terminated text.
        # Keep this one local materialization until conversion consumes a span.
        text = self.src:sub(start, self.pos - 1)
        return span(2, l, text, start - 1, self.pos - start, 0, to(f64)(text))
    span(1, l, "", start - 1, self.pos - start, self:_int_of(start, self.pos - 1), 0.0)

next_tok: token = (self: lexer)
    if self.pos == 1 and self:peek_char() == 35 and self:peek_char2() == 33
        l = self:cur_loc()
        start = self.pos
        while self.pos <= self.extent and self:peek_char() != 10
            self:adv()
        return span(110, l, "", start - 1, self.pos - start, 0, 0.0)
    self:skip_ws()
    self.start = self.pos
    if self.pos > self.extent
        eof = self:cur_loc()
        return span(109, eof, "", self.pos - 1, 0, 0, 0.0)
    
    l = self:cur_loc()
    c = self:peek_char()
    
    if is_digit(c) or (c == 46 and is_digit(self:peek_char2()))
        return self:read_num()
    
    if is_alpha(c) or c == 95
        start = self.pos
        while self.pos <= self.extent
            p = self:peek_char()
            if is_alnum(p) or p == 95
                self:adv()
            else
                break
        kind = self:lookup(start, self.pos - 1)
        if kind == 0
            kind = 0
        return span(kind, l, "", start - 1, self.pos - start, 0, 0.0)
    
    if c == 39 or c == 34
        lit_kind = classify_quote(self.family, c)
        self:read_str(c)
        if self.has_error
            return span(lit_kind, l, "", self.start - 1, 0, 0, 0.0)
        return span(lit_kind, l, "", self.start - 1, self.pos - self.start - 1, 0, 0.0)
    
    if c == 91
        lvl = self:long_bracket_level()
        if lvl >= 0
            self:read_long_str(lvl)
            if self.has_error
                return span(108, l, "", self.start - 1, 0, lvl, 0.0)
            return span(108, l, "", self.start - 1, self.pos - self.start - 2 - lvl, lvl, 0.0)
    
    if c == 35 and self.family == 1
        start = self.pos
        while self.pos <= self.extent and self:peek_char() != 10
            self:adv()
        return span(111, l, "", start - 1, self.pos - start, 0, 0.0)

    if c == 45 and self:peek_char2() == 45
        start = self.pos
        self:adv()
        self:adv()
        lvl = self:long_bracket_level()
        if lvl >= 0
            self:skip_long(lvl)
            return span(113, l, "", start - 1, self.pos - start, 0, 0.0)
        is_triple = (self.pos <= self.extent and self:peek_char() == 45)
        if is_triple
            self:adv()
        while self.pos <= self.extent and self:peek_char() != 10
            self:adv()
        return span(112, l, "", start - 1, self.pos - start, 0, 0.0)
    
    self:adv()
    p = self.pos
    
    if c == 43
        if self:peek_char() == 61
            self:adv()
            return span(99, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(64, l, "", p - 2, 1, 0, 0.0)
    elseif c == 42
        if self:peek_char() == 61
            self:adv()
            return span(101, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(66, l, "", p - 2, 1, 0, 0.0)
    elseif c == 37
        if self:peek_char() == 61
            self:adv()
            return span(103, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(68, l, "", p - 2, 1, 0, 0.0)
    elseif c == 94
        if self:peek_char() == 61
            self:adv()
            return span(104, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(69, l, "", p - 2, 1, 0, 0.0)
    elseif c == 35
        if self:peek_char() == 35
            self:adv()
            return span(87, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(70, l, "", p - 2, 1, 0, 0.0)
    elseif c == 38
        return span(71, l, "", p - 2, 1, 0, 0.0)
    elseif c == 124
        if self.pos <= self.extent and self.src:byte(self.pos) == 62
            self.pos = self.pos + 1
            return span(97, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(72, l, "", p - 2, 1, 0, 0.0)
    elseif c == 40
        return span(58, l, "", p - 2, 1, 0, 0.0)
    elseif c == 41
        return span(59, l, "", p - 2, 1, 0, 0.0)
    elseif c == 91
        return span(60, l, "", p - 2, 1, 0, 0.0)
    elseif c == 93
        return span(61, l, "", p - 2, 1, 0, 0.0)
    elseif c == 123
        return span(62, l, "", p - 2, 1, 0, 0.0)
    elseif c == 125
        return span(63, l, "", p - 2, 1, 0, 0.0)
    elseif c == 59
        return span(77, l, "", p - 2, 1, 0, 0.0)
    elseif c == 44
        return span(79, l, "", p - 2, 1, 0, 0.0)
    elseif c == 45
        if self:peek_char() == 61
            self:adv()
            return span(100, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        if self:peek_char() == 62
            self:adv()
            return span(96, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(65, l, "", p - 2, 1, 0, 0.0)
    elseif c == 47
        if self:peek_char() == 61
            self:adv()
            return span(102, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        if self:peek_char() == 47
            self:adv()
            return span(94, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(67, l, "", p - 2, 1, 0, 0.0)
    elseif c == 46
        if self:peek_char() == 46
            self:adv()
            if self:peek_char() == 46
                self:adv()
                return span(86, l, "", p - 2, self.pos - p + 1, 0, 0.0)
            return span(85, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(80, l, "", p - 2, 1, 0, 0.0)
    elseif c == 61
        if self:peek_char() == 61
            self:adv()
            return span(88, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        if self:peek_char() == 62
            self:adv()
            return span(98, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(75, l, "", p - 2, 1, 0, 0.0)
    elseif c == 126
        # `~` is XOR and nothing else. It used to swallow a following `=` and
        # report inequality (kind 89), which is Lua's spelling, not this
        # language's: inequality is `!=`. Eagerly gluing the `=` here was also
        # what made `x ~= 1` silently a DISCARDED COMPARISON where xor-assign
        # was meant. Emitting the bare tilde lets the grammar's adjacency rule
        # form `~=` as a compound assignment, exactly as it already forms
        # `>>=`, `<<=`, `|=` and `&=`.
        return span(76, l, "", p - 2, 1, 0, 0.0)
    elseif c == 60
        if self:peek_char() == 61
            self:adv()
            return span(90, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        if self:peek_char() == 60
            self:adv()
            return span(92, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(73, l, "", p - 2, 1, 0, 0.0)
    elseif c == 62
        if self:peek_char() == 61
            self:adv()
            return span(91, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        if self:peek_char() == 62
            self:adv()
            return span(93, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(74, l, "", p - 2, 1, 0, 0.0)
    elseif c == 58
        if self:peek_char() == 58
            self:adv()
            return span(95, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(78, l, "", p - 2, 1, 0, 0.0)
    elseif c == 64
        return span(81, l, "", p - 2, 1, 0, 0.0)
    elseif c == 63
        return span(82, l, "", p - 2, 1, 0, 0.0)
    elseif c == 33
        if self:peek_char() == 61
            self:adv()
            return span(89, l, "", p - 2, self.pos - p + 1, 0, 0.0)
        return span(83, l, "", p - 2, 1, 0, 0.0)
    elseif c == 96
        if self.family == 1
            self:_fail(4)
            return span(109, l, "", p - 2, 0, 0, 0.0)
        return span(84, l, "", p - 2, 1, 0, 0.0)
    else
        self:_fail(4)
        return span(109, l, "", p - 2, 0, 0, 0.0)

next: token = (self: lexer)
    if self.has_peeked
        tok = self.peeked_token
        self.has_peeked = false
        return tok
    tok = self:next_tok()
    if tok.len > 0 and tok.text:len() == 0
        tok.text = self.src:sub(tok.off + 1, tok.off + tok.len)
    tok

peek: token = (self: lexer)
    if !self.has_peeked
        self.peeked_token = self:next()
        self.has_peeked = true
    self.peeked_token

save_state: state = (self: lexer)
    return {
        pos = self.pos,
        start = self.start,
        line = self.line,
        col = self.col,
        has_peeked = self.has_peeked,
        peeked_token = self.peeked_token,
    }

restore_state(self: lexer, state: state)
    self.pos = state.pos
    self.start = state.start
    self.line = state.line
    self.col = state.col
    self.has_peeked = state.has_peeked
    self.peeked_token = state.peeked_token

# ── sovereign tokenize surface ───────────────────────────────────────────────
#
# Whole-file tokenize in ONE call, writing into a host-provided buffer.
#
# This is the shape production dispatch needs, and `duo_lexer_step` is not it.
# Step rebuilds a `lexer` at a byte offset, which discards `has_peeked` /
# `peeked_token`, so a step-driven walk
# silently mis-lexes context-sensitive shapes (bisected to the `=` in
# `fun add(a: i64): i64 =`). Here a single `lexer` runs the whole file, so the
# stream is state-faithful by construction, and it is O(n) with no cursor ABI.
#
# The PRODUCTION DISPATCH entry: everything the host `Token` carries, in one
# pass. Exact source coordinates are token facts, not cursor state reconstructed
# here. The host projects its temporary text view from those coordinates.
#
# Positional seven-i64 records are SCHEMA-ONE debt. Host RECORD_SLOTS and
# slot decode are a second copy of this law. Deletion: producer-projected
# record or immutable token view — not a named Zig slot map.
#     0 kind   1 line   2 col   3 int_val   4 source offset   5 text length   6 float value
#
# Returns the token count, or -1 if `cap` is too small. The final two arguments
# remain only to preserve the bootstrap ABI while consumers migrate; token text
# is no longer copied through them. A short read that looks like a short file is
# the one failure a parser cannot detect.
# The rejection's location, for a host that has just been handed a negative
# code. Re-lexes: this is the cold path, taken once per failed file.
duo_lexer_error_line: i64 = (src: str, file: str, family: i64)
    lex = new(src, file, family)
    n: i64 = 0
    while n < 10000000
        tok = next_tok(lex)
        n += 1
        if lex.has_error return lex.error_loc.line
        if tok.kind == 109 return 0
    0

duo_lexer_tokenize_full: i64 = (src: str, file: str, family: i64, out: i64, cap: i64, txt: i64, txtcap: i64)
    lex = new(src, file, family)
    buf = mem.ptr_from_addr(i64, out)
    n: i64 = 0
    while n < cap
        tok = next_tok(lex)
        mem.write_i64(buf, (n * 7) * 8, tok.kind)
        mem.write_i64(buf, (n * 7 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 7 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 7 + 3) * 8, tok.int_val)
        mem.write_i64(buf, (n * 7 + 4) * 8, tok.off)
        mem.write_i64(buf, (n * 7 + 5) * 8, tok.len)
        mem.write_f64(buf, (n * 7 + 6) * 8, tok.float_val)
        n += 1
        # GAP-017: a rejection is returned, not raised. Negative codes offset
        # by 100 so they cannot collide with -1 (buffer too small) are
        # MAGIC-CODE-ZERO debt. Deletion: carry rejection-id, never -101…-105.
        if lex.has_error return 0 - 100 - lex.error_code
        if tok.kind == 109 return n
    -1

duo_lexer_tokenize_all: i64 = (src: str, file: str, family: i64, out: i64, cap: i64)
    lex = new(src, file, family)
    buf = mem.ptr_from_addr(i64, out)
    n: i64 = 0
    while n < cap
        tok = next_tok(lex)
        mem.write_i64(buf, (n * 4) * 8, tok.kind)
        mem.write_i64(buf, (n * 4 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 4 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 4 + 3) * 8, tok.int_val)
        n += 1
        if lex.has_error return 0 - 100 - lex.error_code
        if tok.kind == 109 return n
    -1

duo_lexer_step: i64 = (src: str, file: str, family: i64, pos: i64)
    lex = new(src, file, family)
    lex.pos = pos
    tok = next_tok(lex)
    tok.kind * 1099511627776 + lex.pos

# Token-kind fingerprint: mixes every token including the terminating EOF.
# Agrees bit-for-bit with `src/lexer_differential.zig:fingerprintSource`
# (`h = h * 31 + kind`), which is what makes it a differential against the
# production lexer rather than a self-consistency check.
#
# u64, not i64: a hash must wrap, and signed overflow is UB in lowered code.
# Token-TEXT fingerprint, the companion to `duo_lexer_kind_fingerprint`.
#
# The kind fingerprint hashes only `tok.kind`, so text equivalence with
# `src/lexer.zig` was never differenced — a lexer could return the wrong bytes
# for every string literal and the corpus proof would stay green. That gap let
# me both mis-diagnose and then mis-"fix" the escape contract in one session.
#
# Mixes the LENGTH before the bytes so that concatenation cannot alias: "ab"
# then "c" must not hash like "a" then "bc". Includes the terminating EOF
# (length 0), matching `lexer_differential.textFingerprintSource`.
duo_lexer_text_fingerprint: u64 = (src: str, file: str, family: i64)
    lex = new(src, file, family)
    h: u64 = 0
    while true
        tok = next_tok(lex)
        h = h * 31 + tok.len
        bi: i64 = 0
        while bi < tok.len
            h = h * 31 + src:byte(tok.off + bi + 1)
            bi += 1
        if tok.kind == 109 return h
    h

duo_lexer_kind_fingerprint: u64 = (src: str, file: str, family: i64)
    lex = new(src, file, family)
    h: u64 = 0
    while true
        tok = next_tok(lex)
        h = h * 31 + tok.kind
        if tok.kind == 109 return h
    h

# ── producer-projected schema (SCHEMA-ONE, MAGIC-CODE-ZERO) ───────────────
# Host must not independently know slot positions, rejection codes, or token
# kind ordinals. Query these facts instead of hardcoding.

# Source-law ingress precedes lexing semantically. These queries live in this
# executed producer only as the current bootstrap projection boundary: the host
# asks the selected producer which physical source forms it admits instead of
# maintaining its own `.id` / `.lua` roster. `sourceformlaw` is identity;
# suffix is ingress provenance only and never selects meaning downstream.
sourceformcount: i64 = ()
    2

sourceformlaw: str = (i: i64)
    if i == 1 return "idol"
    if i == 2 return "lua"
    ""

sourceformsuffix: str = (i: i64)
    if i == 1 return ".id"
    if i == 2 return ".lua"
    ""

sourceformcanonical: bool = (i: i64)
    i == 1

# Corpus/home admission is source ingress, not lexer meaning. It lives beside
# the source-form projection only for the current executable bootstrap: this
# producer now answers the complete law + provenance question and the host
# supplies only a filesystem-normalized provenance path. The roles are corpus
# roles, not language/world/runtime identities.
sourceentrycount: i64 = ()
    39

sourceentryrole: str = (i: i64)
    if i >= 1 and i <= 3 return "negative"
    if i == 5 or i == 6 or i == 7 return "generated"
    if i == 9 or i == 10 or i == 27 return "compatibility"
    if i >= 11 and i <= 26 return "canonical"
    if i >= 1 and i <= 39 return "foreign"
    ""

sourceentrypattern: str = (i: i64)
    if i == 1 return "examples/compile_fail/"
    if i == 2 return "examples/native_differential/unsupported/"
    if i == 3 return "error_test.id"
    if i == 4 return "examples/native_differential/"
    if i == 5 return "lib/token/classify.id"
    if i == 6 return "lib/wasm/opcode_lookup.id"
    if i == 7 return "lib/wasm/ward_mvp_opcodes.id"
    if i == 8 return "examples/wasm/"
    if i == 9 return "examples/lua"
    if i == 10 return "examples/test_lua"
    if i == 11 return "examples/json/"
    if i == 12 return "examples/conversion/"
    if i == 13 return "examples/projection/"
    if i == 14 return "examples/infer/"
    if i == 15 return "examples/demand/"
    if i == 16 return "examples/hash/"
    if i == 17 return "examples/native/"
    if i == 18 return "examples/control/"
    if i == 19 return "examples/nominal/"
    if i == 20 return "examples/layout/"
    if i == 21 return "examples/pack/"
    if i == 22 return "examples/anchor/"
    if i == 23 return "examples/case/"
    if i == 24 return "examples/read/"
    if i == 25 return "examples/boring/"
    if i == 26 return "examples/table/"
    if i == 27 return "examples/luahost/"
    if i == 28 return "examples/parity/"
    if i == 29 return "examples/host/"
    if i == 30 return "examples/world/"
    if i == 31 return "examples/tailslot/"
    if i == 32 return "examples/shc/"
    if i == 33 return "examples/cfloor/"
    if i == 34 return "examples/benchmark.id"
    if i == 35 return "examples/mandelbrot.id"
    if i == 36 return "vendor/"
    if i == 37 return "test.id"
    if i == 38 return "test2.id"
    if i == 39 return "examples/"
    ""

sourceequal: bool = (left: str, right: str)
    n: i64 = left:len()
    if n != right:len() return false
    i: i64 = 1
    while i <= n
        if left:byte(i) != right:byte(i) return false
        i += 1
    true

sourcerangeequal: bool = (text: str, start: i64, pattern: str)
    n: i64 = pattern:len()
    if start < 1 or start + n - 1 > text:len() return false
    i: i64 = 1
    while i <= n
        if text:byte(start + i - 1) != pattern:byte(i) return false
        i += 1
    true

sourceends: bool = (text: str, suffix: str)
    n: i64 = text:len()
    m: i64 = suffix:len()
    if m > n return false
    sourcerangeequal(text, n - m + 1, suffix)

sourcepathmatches: bool = (path: str, pattern: str)
    n: i64 = path:len()
    m: i64 = pattern:len()
    if sourceequal(path, pattern) return true
    if n >= m and sourcerangeequal(path, 1, pattern)
        if pattern:byte(m) == 47 return true
        if n > m and path:byte(m + 1) == 47 return true
    if n > m and path:byte(n - m) == 47
        return sourcerangeequal(path, n - m + 1, pattern)
    false

sourcepathrole: str = (path: str)
    best: str = ""
    bestlen: i64 = 0
    i: i64 = 1
    while i <= sourceentrycount()
        pattern = sourceentrypattern(i)
        n: i64 = pattern:len()
        if n >= bestlen and sourcepathmatches(path, pattern)
            best = sourceentryrole(i)
            bestlen = n
        i += 1
    best

sourcepathformlaw: str = (path: str)
    i: i64 = 1
    while i <= sourceformcount()
        if sourceends(path, sourceformsuffix(i)) return sourceformlaw(i)
        i += 1
    ""

sourcepathformprovenance: str = (path: str)
    i: i64 = 1
    while i <= sourceformcount()
        if sourceends(path, sourceformsuffix(i))
            if sourceformcanonical(i) return "canonical"
            return "foreign"
        i += 1
    "unknown"

sourcefactlaw: str = (path: str, role: str)
    if sourceequal(role, "canonical") or sourceequal(role, "generated") return "idol"
    if sourceequal(role, "compatibility") return "lua"
    discovered = sourcepathformlaw(path)
    if sourceequal(role, "negative") or sourceequal(role, "foreign")
        if sourceequal(discovered, "lua") return "lua"
        return "idol"
    discovered

sourcefactprovenance: str = (path: str, role: str)
    if sourceequal(role, "canonical") or sourceequal(role, "generated") return "canonical"
    if sourceequal(role, "compatibility") or sourceequal(role, "foreign") return "foreign"
    if sourceequal(role, "negative")
        if sourceequal(sourcepathformlaw(path), "lua") return "foreign"
        return "canonical"
    sourcepathformprovenance(path)

recordslots: i64 = ()
    7

fieldkind: i64 = ()
    0

fieldline: i64 = ()
    1

fieldcol: i64 = ()
    2

fieldint: i64 = ()
    3

fieldoff: i64 = ()
    4

fieldlen: i64 = ()
    5

fieldfloat: i64 = ()
    6

rejectioncount: i64 = ()
    5

rejectioncode: i64 = (i: i64)
    if i == 1 return -101
    if i == 2 return -102
    if i == 3 return -103
    if i == 4 return -104
    if i == 5 return -105 end
    -1

rejectionname: str = (code: i64)
    if code == -101 return "UnterminatedString"
    if code == -102 return "UnterminatedLongString"
    if code == -103 return "InvalidEscape"
    if code == -104 return "UnexpectedChar"
    if code == -105 return "InsufficientIndent"
    ""

kindcount: i64 = ()
    114

kindname: str = (i: i64)
    if i == 0 return "name"
    if i == 1 return "int_lit"
    if i == 2 return "float_lit"
    if i == 3 return ""
    if i == 4 return "and"
    if i == 5 return "break"
    if i == 6 return "continue"
    if i == 7 return "do"
    if i == 8 return "else"
    if i == 9 return "elseif"
    if i == 10 return "end"
    if i == 11 return "false"
    if i == 12 return "for"
    if i == 13 return "function"
    if i == 14 return "fun"
    if i == 15 return "global"
    if i == 16 return "goto"
    if i == 17 return "if"
    if i == 18 return "in"
    if i == 19 return "local"
    if i == 20 return "nil"
    if i == 21 return "not"
    if i == 22 return "or"
    if i == 23 return "repeat"
    if i == 24 return "return"
    if i == 25 return "then"
    if i == 26 return "true"
    if i == 27 return "until"
    if i == 28 return "while"
    if i == 29 return "const"
    if i == 30 return "enum"
    if i == 31 return "i8"
    if i == 32 return "i16"
    if i == 33 return "i32"
    if i == 34 return "i64"
    if i == 35 return "u8"
    if i == 36 return "u16"
    if i == 37 return "u32"
    if i == 38 return "u64"
    if i == 39 return "f32"
    if i == 40 return "f64"
    if i == 41 return "bool"
    if i == 42 return "void"
    if i == 43 return "str"
    if i == 44 return "match"
