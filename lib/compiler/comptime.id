# SH-08 — the compile-time evaluator, seed.
#
# The evaluator's first obligation is constant folding: a closed expression of
# literals must evaluate, at compile time, to what the language says it means.
# This does that for the integer subset, on the same precedence ladder the
# parser uses.
#
# HOW IT IS CHECKED, and why that matters more than the code. The expected
# values in the comptime proof are not numbers I typed — each
# is the SAME expression, written in Duo, evaluated by the host compiler:
#
#     check("2 + 3 * 4", 2 + 3 * 4)
#
# So a fixture cannot encode my arithmetic mistakes, only a real disagreement
# between this evaluator and the host. That is a differential oracle, the same
# instrument that proved the Duo lexer token-for-token equal to src/lexer.zig,
# and it is worth more than a hand-written table here because precedence is
# exactly where a hand-written table agrees with the bug.
#
# WHY IT SCANS BYTES rather than using std.compiler.lexer. Two attempts went
# through the lexer and neither survived the module boundary: a
# `{ lx = lexer.new(...) }` state table passed as `any` crashed at startup
# (exit 128, no output — a typed record does not survive being boxed into an
# untyped field), and threading `lx: lexer` directly compiled the parameter as
# `int64_t`, because that type does not resolve in this module. Both are real
# findings; neither is worth blocking a folder on. A closed integer expression
# needs digits, operators and parens, so it scans them.
#
# Cursor state is module-level: folding is not reentrant, and threading an
# index through nine mutually recursive levels is the only alternative without
# multi-value returns.
#
# Scope: integer literals (decimal and 0x hex), + - * / % ^ & | ~ << >>, unary
# minus and `~`, and parentheses. No names and no calls — folding a name needs
# the binder's scope model, which is SH-06's increment, not this one's.

global _src: str = ""
global _pos: i64 = 1
global _bad: bool = false

_at: i64 = ()
  if _pos > _src:len()
    return 0
  _src:byte(_pos)

_skip_ws = ()
  while _pos <= _src:len()
    c = _at()
    if c == 32
      _pos = _pos + 1
    if c == 9
      _pos = _pos + 1
    if c == 10
      _pos = _pos + 1
    if c != 32 and c != 9 and c != 10
      return

_is_digit: bool = (c: i64)
  c >= 48 and c <= 57

_hex_val: i64 = (c: i64)
  if c >= 48 and c <= 57
    return c - 48
  if c >= 97 and c <= 102
    return c - 87
  if c >= 65 and c <= 70
    return c - 55
  0 - 1

# Consume the operator at the cursor. `b == 0` means a one-byte operator, and
# it refuses when the byte actually begins a two-byte one, so `<` never eats
# the first half of `<<`.
_eat: bool = (a: i64, b: i64)
  _skip_ws()
  if _at() != a
    return false
  if b == 0
    nxt: i64 = 0
    if _pos + 1 <= _src:len()
      nxt = _src:byte(_pos + 1)
    if a == 60 and nxt == 60
      return false
    if a == 62 and nxt == 62
      return false
    _pos = _pos + 1
    return true
  if _pos + 1 > _src:len()
    return false
  if _src:byte(_pos + 1) != b
    return false
  _pos = _pos + 2
  true

_number: i64 = ()
  _skip_ws()
  if _at() == 48 and _pos + 1 <= _src:len()
    n2: i64 = _src:byte(_pos + 1)
    if n2 == 120 or n2 == 88
      _pos = _pos + 2
      v: i64 = 0
      more: i64 = 1
      while more == 1 and _pos <= _src:len()
        hv = _hex_val(_at())
        if hv < 0
          more = 0
        if more == 1
          v = v * 16 + hv
          _pos = _pos + 1
      return v
  if not _is_digit(_at())
    _bad = true
    return 0
  v2: i64 = 0
  c0 = _at()
  if c0 < 48
    _bad = true
    return 0
  if c0 > 57
    _bad = true
    return 0
  more2: i64 = 1
  while more2 == 1 and _pos <= _src:len()
    c = _at()
    if c < 48
      more2 = 0
    if c > 57
      more2 = 0
    if more2 == 1
      v2 = v2 * 10 + c - 48
      _pos = _pos + 1
  v2

_prim: i64 = ()
  _skip_ws()
  if _eat(45, 0)
    return 0 - _prim()
  if _at() == 126
    _pos = _pos + 1
    return ~_prim()
  if _eat(40, 0)
    v: i64 = _expr()
    if not _eat(41, 0)
      _bad = true
    return v
  _number()

# `^` binds tighter than unary minus and is right-associative
_pow: i64 = ()
  base: i64 = _prim()
  if _eat(94, 0)
    e: i64 = _pow()
    r: i64 = 1
    i: i64 = 0
    while i < e
      r = r * base
      i = i + 1
    return r
  base

_term: i64 = ()
  left: i64 = _pow()
  while true
    if _eat(42, 0)
      left = left * _pow()
    else
      if _eat(47, 0)
        d: i64 = _pow()
        if d == 0
          _bad = true
          return 0
        left = left / d
      else
        if _eat(37, 0)
          m: i64 = _pow()
          if m == 0
            _bad = true
            return 0
          left = left % m
        else
          return left

_addsub: i64 = ()
  left: i64 = _term()
  while true
    if _eat(43, 0)
      left = left + _term()
    else
      if _eat(45, 0)
        left = left - _term()
      else
        return left

_shift: i64 = ()
  left: i64 = _addsub()
  while true
    if _eat(60, 60)
      left = left << _addsub()
    else
      if _eat(62, 62)
        left = left >> _addsub()
      else
        return left

_band: i64 = ()
  left: i64 = _shift()
  while _eat(38, 0)
    left = left & _shift()
  left

_bxor: i64 = ()
  left: i64 = _band()
  # `~` here is INFIX xor; the prefix form is handled in _prim, and position
  # separates them exactly as it does in the parser.
  while true
    _skip_ws()
    if _at() != 126
      return left
    _pos = _pos + 1
    left = left ~ _band()

_expr: i64 = ()
  left: i64 = _bxor()
  while _eat(124, 0)
    left = left | _bxor()
  left

# Reset is its own function because a `bool` assignment inside a body whose
# declared return is `i64` is reported as a return-type mismatch — the last
# statement is not the last expression, but the check reads it that way.
_reset = (src: str)
  _src = src
  _pos = 1
  _bad = false

fold: i64 = (src: str)
  _reset(src)
  _expr()

# Did the last fold consume the whole input without failing? Lets a caller tell
# a legitimate 0 from a refusal.
foldable: bool = (src: str)
  _reset(src)
  _v: i64 = _expr()
  _skip_ws()
  if _bad
    return false
  _pos > _src:len()
