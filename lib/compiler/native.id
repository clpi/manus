hex: str = (v: i64)
    digits = "0123456789abcdef"
    d = (v & 15) + 1
    digits:sub(d, d)

pair: str = (v: i64)
    hex(v >> 4) .. hex(v)

word: str = (v: i64)
    pair(v) .. pair(v >> 8) .. pair(v >> 16) .. pair(v >> 24)

quad: str = (v: i64)
    word(v) .. word(v >> 32)

field: str = (s: str)
    out = ""
    i = 1
    while i <= 16
        if i <= s:len()
            out = out .. pair(s:byte(i))
        else
            out = out .. "00"
        i = i + 1
    out

movz: i64 = (rd: i64, imm: i64)
    3531603968 | ((imm & 65535) << 5) | rd

movk: i64 = (rd: i64, imm: i64, hw: i64)
    4068474880 | (hw << 21) | ((imm & 65535) << 5) | rd

add: i64 = (rd: i64, rn: i64, rm: i64)
    2332033024 | (rm << 16) | (rn << 5) | rd

addsh: i64 = (rd: i64, rn: i64, rm: i64, sh: i64)
    2332033024 | (rm << 16) | (sh << 10) | (rn << 5) | rd

subs: i64 = (rd: i64, rn: i64, im: i64)
    4043309056 | ((im & 4095) << 10) | (rn << 5) | rd

minus: i64 = (rd: i64, rn: i64, rm: i64)
    3405774848 | (rm << 16) | (rn << 5) | rd

mul: i64 = (rd: i64, rn: i64, rm: i64)
    2600468480 | (rm << 16) | (31 << 10) | (rn << 5) | rd

div: i64 = (rd: i64, rn: i64, rm: i64)
    2596277248 | (rm << 16) | (rn << 5) | rd

addi: i64 = (rd: i64, rn: i64, v: i64)
    2432696320 | ((v & 4095) << 10) | (rn << 5) | rd

subi: i64 = (rd: i64, rn: i64, v: i64)
    3506438144 | ((v & 4095) << 10) | (rn << 5) | rd

lsl: i64 = (rd: i64, rn: i64, s: i64)
    3544186880 | (((64 - s) & 63) << 16) | ((63 - s) << 10) | (rn << 5) | rd

powtwo: i64 = (v: i64)
    if v < 2
        return 0 - 1
    sh = 0
    p = 1
    while p < v
        p = p * 2
        sh = sh + 1
    if p == v
        return sh
    0 - 1

mov: i64 = (rd: i64, rm: i64)
    2852126720 | (rm << 16) | (31 << 5) | rd

band: i64 = (rd: i64, rn: i64, rm: i64)
    2315255808 | (rm << 16) | (rn << 5) | rd

cmp: i64 = (rn: i64, rm: i64)
    3942645760 | (rm << 16) | (rn << 5) | 31

jump: i64 = (off: i64)
    335544320 | (off & 67108863)

bcond: i64 = (cond: i64, off: i64)
    1409286144 | ((off & 524287) << 5) | cond

ret: i64 = ()
    3596551104

udf: i64 = ()
    3556769792

stx: i64 = (rt: i64, rn: i64, off: i64)
    4177526784 | ((off >> 3) << 10) | (rn << 5) | rt

ldx: i64 = (rt: i64, rn: i64, off: i64)
    4185915392 | ((off >> 3) << 10) | (rn << 5) | rt

digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

num: i64 = (s: str)
    v = 0
    i = 1
    n = s:len()
    neg = 0
    if n > 0 and s:byte(1) == 45
        neg = 1
        i = 2
    while i <= n
        v = v * 10 + s:byte(i) - 48
        i = i + 1
    if neg == 1
        return 0 - v
    v

dec: str = (v: i64)
    if v == 0
        return "0"
    neg = 0
    if v < 0
        neg = 1
        v = 0 - v
    out = ""
    x = v
    while x > 0
        out = hex(x - (x / 10) * 10) .. out
        x = x / 10
    if neg == 1
        return "-" .. out
    out

trim: str = (s: str)
    n = s:len()
    a = 1
    while a <= n and s:byte(a) == 32
        a = a + 1
    b = n
    while b >= a and s:byte(b) == 32
        b = b - 1
    if b < a
        return ""
    s:sub(a, b)

find: i64 = (hay: str, key: str)
    pat = key .. "|"
    n = hay:len()
    m = pat:len()
    i = 1
    idx = 0
    while i + m - 1 <= n
        if hay:sub(i, i + m - 1) == pat
            return idx
        if hay:byte(i) == 124
            idx = idx + 1
        i = i + 1
    0 - 1

at: i64 = (vals: str, idx: i64)
    cur = 0
    i = 1
    n = vals:len()
    while i <= n
        if cur == idx
            j = i
            while j <= n and vals:byte(j) != 124
                j = j + 1
            return num(vals:sub(i, j - 1))
        if vals:byte(i) == 124
            cur = cur + 1
        i = i + 1
    0

reg: i64 = (names: str, name: str)
    19 + find(names, name)

put: str = (c: str, w: i64)
    c .. word(w)

patch: str = (c: str, p: i64, w: i64)
    a = p * 8
    pre = ""
    if a > 0
        pre = c:sub(1, a)
    post = ""
    if a + 9 <= c:len()
        post = c:sub(a + 9, c:len())
    pre .. word(w) .. post

imm: str = (c: str, r: i64, v: i64)
    c = c .. word(movz(r, v & 65535))
    h1 = (v >> 16) & 65535
    if h1 != 0
        c = c .. word(movk(r, h1, 1))
    h2 = (v >> 32) & 65535
    if h2 != 0
        c = c .. word(movk(r, h2, 2))
    h3 = (v >> 48) & 65535
    if h3 != 0
        c = c .. word(movk(r, h3, 3))
    c

term: str = (c: str, t: str, r: i64, names: str)
    expr(c, t, r, 11, names)

strip: str = (t: str)
    n = t:len()
    if n < 2
        return t
    if t:byte(1) != 40 or t:byte(n) != 41
        return t
    d = 0
    i = 1
    while i <= n
        b = t:byte(i)
        if b == 40
            d = d + 1
        else
            if b == 41
                d = d - 1
        if d == 0 and i < n
            return t
        i = i + 1
    t:sub(2, n - 1)

hasop: i64 = (t: str)
    d = 0
    i = 1
    n = t:len()
    while i <= n
        b = t:byte(i)
        if b == 40
            d = d + 1
        else
            if b == 41
                d = d - 1
            else
                if d == 0
                    if b == 38 or b == 42 or b == 43 or b == 45 or b == 47
                        return 1
        i = i + 1
    0

simple: i64 = (t: str)
    if isnum(t) == 1
        return 1
    if hasop(t) == 1
        return 0
    if t:len() == 0
        return 0
    if t:byte(1) == 40
        return 0
    1

splitop: str = (t: str)
    oppos = 0
    op = 0
    opp = 4
    d = 0
    q = 1
    n = t:len()
    while q <= n
        oc = t:byte(q)
        if oc == 40
            d = d + 1
        else
            if oc == 41
                d = d - 1
            else
                if d == 0
                    p = 0
                    if oc == 38
                        p = 1
                    else
                        if oc == 43 or oc == 45
                            p = 2
                        else
                            if oc == 42 or oc == 47
                                p = 3
                    if p > 0 and p <= opp
                        oppos = q
                        op = oc
                        opp = p
        q = q + 1
    dec(oppos) .. "|" .. dec(op)

spilln: i64 = (base: i64)
    (base - 11) >> 1

spillb: i64 = (n: i64)
    b = (n + 1) * 8
    b + ((16 - (b & 15)) & 15)

spillpush: str = (c: str, base: i64)
    n = spilln(base)
    b = spillb(n)
    c = c .. word(subi(31, 31, b))
    i = 0
    while i < n
        c = c .. word(stx(11 + (i * 2), 31, 8 + (i * 8)))
        i = i + 1
    c

spillpop: str = (c: str, base: i64, r: i64)
    n = spilln(base)
    b = spillb(n)
    i = 0
    while i < n
        c = c .. word(ldx(11 + (i * 2), 31, 8 + (i * 8)))
        i = i + 1
    c = c .. word(ldx(r, 31, 0))
    c .. word(addi(31, 31, b))

deepexpr: str = (c: str, r: i64, a: str, o: i64, e: str, base: i64, names: str)
    c = spillpush(c, base)
    c = calc(c, 11, a, o, e, 11, names)
    c = c .. word(stx(11, 31, 0))
    c = spillpop(c, base, r)
    c

expr: str = (c: str, t: str, r: i64, base: i64, names: str)
    t = trim(t)
    if isnum(t) == 1
        return imm(c, r, num(t))
    s = strip(t)
    if s != t
        return expr(c, s, r, base, names)
    if hasop(t) == 0
        return c .. word(mov(r, reg(names, t)))
    sp = splitop(t)
    oppos = at(sp, 0)
    op = at(sp, 1)
    a = trim(t:sub(1, oppos - 1))
    e = trim(t:sub(oppos + 1, t:len()))
    if base > 17
        return deepexpr(c, r, a, op, e, base, names)
    calc(c, r, a, op, e, base, names)

foldop: i64 = (a: i64, o: i64, b: i64)
    if o == 43
        return a + b
    if o == 45
        return a - b
    if o == 42
        return a * b
    if o == 38
        return a & b
    0

simpadd: i64 = (a: i64, isa: i64, b: i64, isb: i64)
    if isa == 1 and a == 0
        return 1
    if isb == 1 and b == 0
        return 2
    0

simpmul: i64 = (a: i64, isa: i64, b: i64, isb: i64)
    if isa == 1 and a == 0
        return 3
    if isb == 1 and b == 0
        return 3
    if isa == 1 and a == 1
        return 2
    if isb == 1 and b == 1
        return 1
    0

mulred: str = (c: str, rd: i64, n: str, v: i64, names: str)
    sh = powtwo(v)
    if sh > 0
        return c .. word(lsl(rd, reg(names, n), sh))
    if v == 3
        return c .. word(addsh(rd, reg(names, n), reg(names, n), 1))
    if v == 5
        return c .. word(addsh(rd, reg(names, n), reg(names, n), 2))
    if v == 7
        t = c .. word(lsl(10, reg(names, n), 3))
        return t .. word(minus(rd, 10, reg(names, n)))
    if v == 9
        return c .. word(addsh(rd, reg(names, n), reg(names, n), 3))
    ""

divmagic: str = (dd: i64)
    ad = dd
    if ad < 0
        ad = 0 - ad
    tw = 0 - 9223372036854775807 - 1
    tm = tw - 1
    qd = tm / ad
    pr = qd * ad
    rm = tm - pr
    an = tm - rm
    p = 63
    t1 = tw / an
    q1 = 0 - t1
    pr = q1 * an
    r1 = tw - pr
    t2 = tw / ad
    q2 = 0 - t2
    pr = q2 * ad
    r2 = tw - pr
    fin = 0
    while fin == 0
        p = p + 1
        q1 = q1 * 2
        r1d = an - r1
        if r1 >= r1d
            q1 = q1 + 1
            r1 = r1 - r1d
        else
            r1 = r1 * 2
        q2 = q2 * 2
        r2 = r2 * 2
        if r2 >= ad
            q2 = q2 + 1
            r2 = r2 - ad
        dl = ad - r2
        if q1 < dl
            fin = 0
        else
            if q1 == dl and r1 == 0
                fin = 0
            else
                fin = 1
    mg = q2 + 1
    sh = p - 64
    dec(mg) .. "|" .. dec(sh)

divscan: str = (src: str)
    out = ""
    lc = rows(src)
    k = 0
    while k < lc
        t = row(src, k)
        q = 1
        while q <= t:len()
            if t:byte(q) == 47
                r = q + 1
                while r <= t:len() and t:byte(r) == 32
                    r = r + 1
                d0 = r
                while r <= t:len() and digit(t:byte(r)) == 1
                    r = r + 1
                if r > d0
                    v = num(t:sub(d0, r - 1))
                    if v > 1 and v < 4294967296 and powtwo(v) == 0 - 1
                        ds = dec(v)
                        if hassub("|" .. out, "|" .. ds .. "|") == 0
                            out = out .. ds .. "|"
                q = r
            else
                q = q + 1
        k = k + 1
    out

purecount: i64 = (src: str, k: i64, lc: i64, ind: i64, lhs: str)
    bind = 0
    k2 = k + 1
    while k2 < lc and bind == 0
        r2 = row(src, k2)
        t2 = trim(r2)
        if t2:len() > 0
            if indent(r2) > ind
                bind = indent(r2)
            else
                k2 = lc
        if k2 < lc
            k2 = k2 + 1
    if bind == 0
        return 0
    p = 1
    found = 0
    inc = lhs .. " = " .. lhs .. " + 1"
    k2 = k + 1
    while k2 < lc and p == 1
        r2 = row(src, k2)
        t2 = trim(r2)
        if t2:len() > 0
            if indent(r2) > ind
                if indent(r2) == bind and t2 == inc
                    found = 1
                else
                    if hassub(t2, lhs) == 1
                        p = 0
            else
                k2 = lc
        if k2 < lc
            k2 = k2 + 1
    if found == 0
        p = 0
    p

hassub: i64 = (hay: str, key: str)
    n = hay:len()
    m = key:len()
    i = 1
    while i + m - 1 <= n
        if hay:sub(i, i + m - 1) == key
            return 1
        i = i + 1
    0

calc: str = (c: str, rd: i64, a: str, o: i64, e: str, base: i64, names: str)
    sa = simple(a)
    se = simple(e)
    if sa == 0 or se == 0
        c = expr(c, a, base, base + 2, names)
        c = expr(c, e, base + 1, base + 2, names)
        if o == 43
            return c .. word(add(rd, base, base + 1))
        if o == 45
            return c .. word(minus(rd, base, base + 1))
        if o == 42
            return c .. word(mul(rd, base, base + 1))
        if o == 38
            return c .. word(band(rd, base, base + 1))
        c .. word(div(rd, base, base + 1))
    an = isnum(a)
    en = isnum(e)
    av = 0
    ev = 0
    if an == 1
        av = num(a)
    if en == 1
        ev = num(e)
    if an == 1 and en == 1 and o != 47
        return imm(c, rd, foldop(av, o, ev))
    skip = 0
    if o == 43
        s = simpadd(av, an, ev, en)
        if s == 1
            return term(c, e, rd, names)
        if s == 2
            return term(c, a, rd, names)
    if o == 42
        s = simpmul(av, an, ev, en)
        if s == 1
            return term(c, a, rd, names)
        if s == 2
            return term(c, e, rd, names)
        if s == 3
            return imm(c, rd, 0)
    if o == 45
        if en == 1 and ev == 0
            return term(c, a, rd, names)
        if an == 0 and en == 0 and a == e
            return imm(c, rd, 0)
    if o == 43 and an == 1 and en == 0 and av < 4096
        return c .. word(addi(rd, reg(names, e), av))
    if o == 43 and an == 0 and en == 1 and ev < 4096
        return c .. word(addi(rd, reg(names, a), ev))
    if o == 45 and an == 0 and en == 1 and ev < 4096
        return c .. word(subi(rd, reg(names, a), ev))
    if o == 42 and an == 0 and en == 1
        m = mulred(c, rd, a, ev, names)
        if m:len() > 0
            return m
    if o == 42 and an == 1 and en == 0
        m = mulred(c, rd, e, av, names)
        if m:len() > 0
            return m
    if o == 47 and en == 1 and an == 0
        dd = ev
        ra = reg(names, a)
        if dd == 1
            return c .. word(mov(rd, ra))
        if dd == 0 - 1
            return c .. word(minus(rd, 31, ra))
        ad = dd
        if ad < 0
            ad = 0 - ad
        if ad > 0 and ad < 4294967296
            pw = powtwo(ad)
            if pw > 0
                c = c .. word(2470445056 | (63 << 16) | (63 << 10) | (ra << 5) | 9)
                c = c .. word(3544186880 | ((64 - pw) << 16) | (63 << 10) | (9 << 5) | 9)
                c = c .. word(add(9, ra, 9))
                c = c .. word(2470445056 | (pw << 16) | (63 << 10) | (9 << 5) | 9)
                if dd < 0
                    return c .. word(minus(rd, 31, 9))
                return c .. word(mov(rd, 9))
            ms = divmagic(dd)
            mg = at(ms, 0)
            sh = at(ms, 1)
            mgnm = "divmg:" .. dec(dd)
            if hasname(names, mgnm) == 1
                mr = reg(names, mgnm)
                c = c .. word(2604662784 | (ra << 16) | (mr << 5) | rd)
                if mg < 0
                    c = c .. word(add(rd, rd, ra))
                if sh > 0
                    c = c .. word(2470445056 | (sh << 16) | (63 << 10) | (rd << 5) | rd)
                c = c .. word((2332033024 | (1 << 22) | (63 << 10) | (rd << 16) | (rd << 5) | rd))
                if dd < 0
                    return c .. word(minus(rd, 31, rd))
                return c
            c = imm(c, 9, mg)
            c = c .. word(2604662784 | (9 << 16) | (ra << 5) | 10)
            if mg < 0
                c = c .. word(add(10, 10, ra))
            if sh > 0
                c = c .. word(2470445056 | (sh << 16) | (63 << 10) | (10 << 5) | 10)
            c = c .. word((2332033024 | (1 << 22) | (63 << 10) | (10 << 16) | (10 << 5) | 10))
            if dd < 0
                return c .. word(minus(rd, 31, 10))
            return c .. word(mov(rd, 10))
    ra = 0
    rb = 0
    if an == 1
        c = imm(c, 9, av)
        ra = 9
    else
        ra = reg(names, a)
    if en == 1
        c = imm(c, 10, ev)
        rb = 10
    else
        rb = reg(names, e)
    if o == 43
        return c .. word(add(rd, ra, rb))
    if o == 45
        return c .. word(minus(rd, ra, rb))
    if o == 42
        return c .. word(mul(rd, ra, rb))
    if o == 38
        return c .. word(band(rd, ra, rb))
    c .. word(div(rd, ra, rb))

indent: i64 = (s: str)
    n = s:len()
    i = 1
    while i <= n and s:byte(i) == 32
        i = i + 1
    i - 1

rows: i64 = (s: str)
    n = 0
    i = 1
    while i <= s:len()
        if s:byte(i) == 10
            n = n + 1
        i = i + 1
    if s:len() > 0 and s:byte(s:len()) != 10
        n = n + 1
    n

row: str = (s: str, k: i64)
    n = s:len()
    i = 1
    cur = 0
    a = 1
    while i <= n + 1
        if i > n or s:byte(i) == 10
            if cur == k
                return s:sub(a, i - 1)
            cur = cur + 1
            a = i + 1
        i = i + 1
    ""

pop: str = (s: str, n: i64)
    out = ""
    i = 0
    while i < n - 1
        out = out .. dec(at(s, i)) .. "|"
        i = i + 1
    out

isnum: i64 = (s: str)
    n = s:len()
    if n == 0
        return 0
    i = 1
    while i <= n
        if digit(s:byte(i)) == 0
            return 0
        i = i + 1
    return 1

isname: i64 = (s: str)
    n = s:len()
    if n == 0
        return 0
    i = 1
    while i <= n
        c = s:byte(i)
        if c < 97 or c > 122
            return 0
        i = i + 1
    return 1

hasname: i64 = (lst: str, name: str)
    m = name:len()
    n = lst:len()
    i = 1
    while i <= n
        j = i
        while j <= n and lst:byte(j) != 124
            j = j + 1
        if j - i == m and lst:sub(i, j - 1) == name
            return 1
        i = j + 1
    return 0

varnum: i64 = (env: str, name: str)
    m = name:len()
    n = env:len()
    i = 1
    f = 0
    while i <= n
        j = i
        while j <= n and env:byte(j) != 124
            j = j + 1
        if j - i == m and env:sub(i, j - 1) == name
            return f / 7 + 1
        f = f + 1
        i = j + 1
    return 0

vfield: i64 = (vi: i64, f: i64)
    return (vi - 1) * 7 + f

eset: str = (env: str, idx: i64, v: i64)
    out = ""
    cur = 0
    i = 1
    n = env:len()
    a = 1
    while i <= n
        if env:byte(i) == 124
            if cur == idx
                out = out .. dec(v) .. "|"
            else
                out = out .. env:sub(a, i - 1) .. "|"
            cur = cur + 1
            a = i + 1
        i = i + 1
    if a <= n
        if cur == idx
            out = out .. dec(v) .. "|"
        else
            out = out .. env:sub(a, n) .. "|"
    return out

fldn: i64 = (s: str)
    n = 0
    i = 1
    while i <= s:len()
        if s:byte(i) == 124
            n = n + 1
        i = i + 1
    return n

fld: str = (s: str, idx: i64)
    cur = 0
    i = 1
    a = 1
    n = s:len()
    while i <= n + 1
        if i > n or s:byte(i) == 124
            if cur == idx
                return s:sub(a, i - 1)
            cur = cur + 1
            a = i + 1
        i = i + 1
    return ""

ctset: str = (env: str, v: str, kind: i64, val: i64)
    if hasname(env, v) == 0
        env = env .. v .. "|0|0|0|0|0|0|"
    vi = varnum(env, v)
    env = eset(env, vfield(vi, 1), kind)
    env = eset(env, vfield(vi, 2), val)
    env = eset(env, vfield(vi, 3), 0)
    env = eset(env, vfield(vi, 4), 0)
    env = eset(env, vfield(vi, 5), 0)
    return env

ctcopy: str = (env: str, v: str, w: i64)
    if hasname(env, v) == 0
        env = env .. v .. "|0|0|0|0|0|0|"
    vi = varnum(env, v)
    f = 1
    while f <= 6
        env = eset(env, vfield(vi, f), at(env, vfield(w, f)))
        f = f + 1
    return env

ctunknown: str = (env: str)
    nv = fldn(env) / 7
    vi = 1
    while vi <= nv
        env = eset(env, vfield(vi, 1), 1)
        vi = vi + 1
    return env

ctscan: str = (src: str, k: i64, lc: i64, ind: i64)
    env = ""
    j = 0
    while j < k
        r = row(src, j)
        t = trim(r)
        if t:len() > 0 and indent(r) <= ind
            if t:len() > 5 and t:sub(1, 5) == "while"
                env = ctunknown(env)
            else
                hc = 0
                q = 1
                while q <= t:len()
                    if t:byte(q) == 58
                        hc = 1
                    q = q + 1
                if hc == 0
                    eqp = 0
                    q = 1
                    while q <= t:len()
                        if t:byte(q) == 61 and eqp == 0
                            eqp = q
                        q = q + 1
                    if eqp > 0
                        v = trim(t:sub(1, eqp - 1))
                        rhs = trim(t:sub(eqp + 1, t:len()))
                        if isname(v) == 1
                            if isnum(rhs) == 1
                                env = ctset(env, v, 0, num(rhs))
                            else
                                env = ctset(env, v, 1, 0)
        j = j + 1
    return env

ctend: i64 = (src: str, j: i64, lc: i64, ind: i64)
    e = j + 1
    while e < lc
        r = row(src, e)
        if trim(r):len() > 0 and indent(r) <= ind
            return e
        e = e + 1
    return lc

isinc: i64 = (rhs: str, ctr: str)
    oppos = 0
    q = 1
    while q <= rhs:len()
        if rhs:byte(q) == 43 and oppos == 0
            oppos = q
        q = q + 1
    if oppos == 0
        return 0
    a = trim(rhs:sub(1, oppos - 1))
    e = trim(rhs:sub(oppos + 1, rhs:len()))
    if a == ctr and isnum(e) == 1 and num(e) > 0
        return 1
    return 0

stepof: i64 = (rhs: str, ctr: str)
    oppos = 0
    q = 1
    while q <= rhs:len()
        if rhs:byte(q) == 43 and oppos == 0
            oppos = q
        q = q + 1
    e = trim(rhs:sub(oppos + 1, rhs:len()))
    return num(e)

ctstep: i64 = (src: str, b: i64, ej: i64, lc: i64, ctr: str)
    cnt = 0
    st = 0
    j = b
    while j < ej
        t = trim(row(src, j))
        if t:len() > 0
            eqp = 0
            q = 1
            while q <= t:len()
                if t:byte(q) == 61 and eqp == 0
                    eqp = q
                q = q + 1
            if eqp > 0
                v = trim(t:sub(1, eqp - 1))
                rhs = trim(t:sub(eqp + 1, t:len()))
                if v == ctr and isinc(rhs, ctr) == 1
                    cnt = cnt + 1
                    st = stepof(rhs, ctr)
        j = j + 1
    if cnt == 1
        return st
    return 0

ctacc: str = (env: str, v: str, d: i64, rs: str)
    if hasname(env, v) == 0
        return ""
    vi = varnum(env, v)
    if at(env, vfield(vi, 1)) != 0
        return ""
    env = eset(env, vfield(vi, 3), at(env, vfield(vi, 3)) + d)
    return rs .. ";" .. env

ctcs: str = (env: str, v: str, c: i64, rs: str)
    if hasname(env, v) == 0
        return ""
    vi = varnum(env, v)
    if at(env, vfield(vi, 1)) != 0
        return ""
    env = eset(env, vfield(vi, 4), at(env, vfield(vi, 4)) + c)
    return rs .. ";" .. env

ctw: str = (env: str, v: str, w: str, sgn: i64, octr: str, rs: str)
    if hasname(env, v) == 0
        return ""
    if hasname(env, w) == 0
        return ""
    if hasname(octr, w) == 1
        return ""
    vi = varnum(env, v)
    wi = varnum(env, w)
    if at(env, vfield(vi, 1)) != 0
        return ""
    kw = at(env, vfield(wi, 1))
    if kw != 0 and kw != 3
        return ""
    if at(env, vfield(wi, 4)) != 0 or at(env, vfield(wi, 5)) != 0
        return ""
    env = eset(env, vfield(vi, 3), at(env, vfield(vi, 3)) + sgn * at(env, vfield(wi, 2)))
    env = eset(env, vfield(vi, 5), at(env, vfield(vi, 5)) + sgn * at(env, vfield(wi, 3)))
    rs = rs .. w .. "|"
    return rs .. ";" .. env

ctrow: str = (env: str, v: str, rhs: str, ctr: str, octr: str, rs: str, uc: str)
    if isname(v) == 0
        return ""
    if isnum(rhs) == 1
        if hasname(uc, v) == 1 or hasname(rs, v) == 1
            return ""
        env = ctset(env, v, 3, num(rhs))
        return rs .. ";" .. env
    if isname(rhs) == 1
        w = rhs
        if w == ctr or hasname(octr, w) == 1
            return ""
        if hasname(env, w) == 0
            return ""
        wi = varnum(env, w)
        env = ctcopy(env, v, wi)
        rs = rs .. w .. "|"
        return rs .. ";" .. env
    oppos = 0
    op = 0
    q = 1
    while q <= rhs:len()
        oc = rhs:byte(q)
        if oc == 43 or oc == 45
            if oppos == 0
                oppos = q
                op = oc
        q = q + 1
    if oppos == 0
        return ""
    a = trim(rhs:sub(1, oppos - 1))
    e = trim(rhs:sub(oppos + 1, rhs:len()))
    ac = isnum(a)
    ec = isnum(e)
    if ac == 1 and ec == 1
        if hasname(uc, v) == 1 or hasname(rs, v) == 1
            return ""
        env = ctset(env, v, 3, foldop(num(a), op, num(e)))
        return rs .. ";" .. env
    if op == 43
        if a == v and ec == 1
            return ctacc(env, v, num(e), rs)
        if e == v and ac == 1
            return ctacc(env, v, num(a), rs)
        if a == v and e == ctr
            return ctcs(env, v, 1, rs)
        if e == v and a == ctr
            return ctcs(env, v, 1, rs)
        if a == v and isname(e) == 1 and e != ctr
            return ctw(env, v, e, 1, octr, rs)
        if e == v and isname(a) == 1 and a != ctr
            return ctw(env, v, a, 1, octr, rs)
        return ""
    if a == v and e == v
        if hasname(uc, v) == 1 or hasname(rs, v) == 1
            return ""
        env = ctset(env, v, 3, 0)
        return rs .. ";" .. env
    if a == v and ec == 1
        return ctacc(env, v, 0 - num(e), rs)
    if a == v and e == ctr
        return ctcs(env, v, 0 - 1, rs)
    if a == v and isname(e) == 1 and e != ctr
        return ctw(env, v, e, 0 - 1, octr, rs)
    return ""

ctapply: str = (env: str, sm: str)
    nf = fldn(sm)
    f = 0
    while f < nf
        nm = fld(sm, f)
        mode = at(sm, f + 1)
        vv = at(sm, f + 2)
        if hasname(env, nm) == 0
            env = env .. nm .. "|3|0|0|0|0|0|"
        vi = varnum(env, nm)
        kind = at(env, vfield(vi, 1))
        if kind != 0 and kind != 3
            return ""
        if mode == 0
            if kind == 0
                env = eset(env, vfield(vi, 3), at(env, vfield(vi, 3)) + vv)
            else
                env = eset(env, vfield(vi, 2), at(env, vfield(vi, 2)) + vv)
        else
            env = eset(env, vfield(vi, 1), 3)
            env = eset(env, vfield(vi, 2), vv)
            env = eset(env, vfield(vi, 3), 0)
            env = eset(env, vfield(vi, 4), 0)
            env = eset(env, vfield(vi, 5), 0)
        f = f + 7
    return env

ctbody: str = (src: str, b: i64, ej: i64, lc: i64, env: str, ctr: str, octr: str)
    rs = ""
    uc = ""
    j = b
    while j < ej
        r = row(src, j)
        t = trim(r)
        if t:len() == 0
            j = j + 1
        else
            if t:len() > 6 and t:sub(1, 5) == "while" and t:byte(6) == 32
                ej2 = ctend(src, j, lc, indent(r))
                lt = 0
                q = 1
                while q <= t:len()
                    if t:byte(q) == 60 and lt == 0
                        lt = q
                    q = q + 1
                if lt == 0
                    return ""
                lhs2 = trim(t:sub(1, lt - 1))
                if isname(lhs2) == 0
                    return ""
                sm = ctnest(src, j, ej2, lc, env, octr .. ctr .. "|", 0)
                if sm == ""
                    return ""
                env = ctapply(env, sm)
                if env == ""
                    return ""
                uc = uc .. lhs2 .. "|"
                j = ej2
            else
                eqp = 0
                q = 1
                while q <= t:len()
                    if t:byte(q) == 61 and eqp == 0
                        eqp = q
                    q = q + 1
                if eqp == 0
                    return ""
                v = trim(t:sub(1, eqp - 1))
                rhs = trim(t:sub(eqp + 1, t:len()))
                if v == ctr
                    if isinc(rhs, ctr) == 0
                        return ""
                else
                    p = ctrow(env, v, rhs, ctr, octr, rs, uc)
                    if p == ""
                        return ""
                    semi = 0
                    q = 1
                    while q <= p:len()
                        if p:byte(q) == 59 and semi == 0
                            semi = q
                        q = q + 1
                    rs = p:sub(1, semi - 1)
                    env = p:sub(semi + 1, p:len())
                j = j + 1
    return env

ctfin: str = (env: str, ctr: str, a: i64, n: i64, s: i64)
    tri = (n * (n - 1)) / 2
    nv = fldn(env) / 7
    vi = 1
    while vi <= nv
        nm = fld(env, vfield(vi, 0))
        kind = at(env, vfield(vi, 1))
        if nm == ctr
            env = eset(env, vfield(vi, 1), 0)
            env = eset(env, vfield(vi, 2), a + n * s)
        else
            if kind == 0
                vv = at(env, vfield(vi, 2))
                d = at(env, vfield(vi, 3))
                cs = at(env, vfield(vi, 4))
                qs = at(env, vfield(vi, 5))
                fv = vv + n * d + cs * (n * a + s * tri) + qs * tri
                env = eset(env, vfield(vi, 2), fv)
            else
                if kind == 3 and n == 0
                    env = eset(env, vfield(vi, 2), at(env, vfield(vi, 6)))
        vi = vi + 1
    return env

ctsum: str = (env: str, ctr: str, a: i64, n: i64, s: i64)
    out = ""
    if n > 0
        tri = (n * (n - 1)) / 2
        nv = fldn(env) / 7
        vi = 1
        while vi <= nv
            nm = fld(env, vfield(vi, 0))
            kind = at(env, vfield(vi, 1))
            if nm == ctr
                out = out .. nm .. "|3|" .. dec(a + n * s) .. "|0|0|0|0|"
            else
                if kind == 0
                    d = at(env, vfield(vi, 3))
                    cs = at(env, vfield(vi, 4))
                    qs = at(env, vfield(vi, 5))
                    dd = n * d + cs * (n * a + s * tri) + qs * tri
                    if dd != 0
                        out = out .. nm .. "|0|" .. dec(dd) .. "|0|0|0|0|"
                else
                    if kind == 3
                        out = out .. nm .. "|3|" .. dec(at(env, vfield(vi, 2))) .. "|0|0|0|0|"
            vi = vi + 1
    if out == ""
        return " "
    return out

ctnest: str = (src: str, j: i64, ej: i64, lc: i64, env: str, octr: str, top: i64)
    t = trim(row(src, j))
    if t:len() > 6 and t:sub(1, 5) == "while"
        t = trim(t:sub(7, t:len()))
    lt = 0
    q = 1
    while q <= t:len()
        if t:byte(q) == 60 and lt == 0
            lt = q
        q = q + 1
    if lt == 0
        return ""
    lhs = trim(t:sub(1, lt - 1))
    rhs = trim(t:sub(lt + 1, t:len()))
    if isname(lhs) == 0 or isnum(rhs) == 0
        return ""
    if hasname(octr, lhs) == 1
        return ""
    b = num(rhs)
    if hasname(env, lhs) == 0
        return ""
    vi = varnum(env, lhs)
    kind = at(env, vfield(vi, 1))
    if kind != 0 and kind != 3
        return ""
    a = at(env, vfield(vi, 2))
    s = ctstep(src, j + 1, ej, lc, lhs)
    if s == 0
        return ""
    env2 = ctbody(src, j + 1, ej, lc, env, lhs, octr)
    if env2 == ""
        return ""
    n = 0
    if b > a
        n = (b - a + s - 1) / s
    if top == 1
        return ctfin(env2, lhs, a, n, s)
    return ctsum(env2, lhs, a, n, s)

cttry: str = (src: str, k: i64, lc: i64, ind: i64, lhs: str, rhs: str)
    if isname(lhs) == 0
        return ""
    env = ctscan(src, k, lc, ind)
    ej = ctend(src, k, lc, ind)
    fin = ctnest(src, k, ej, lc, env, "", 1)
    if fin == ""
        return ""
    out = dec(ej) .. "|"
    nv = fldn(fin) / 7
    vi = 1
    while vi <= nv
        kind = at(fin, vfield(vi, 1))
        if kind != 1
            fv = at(fin, vfield(vi, 2))
            ev = at(fin, vfield(vi, 6))
            if fv != ev
                out = out .. fld(fin, vfield(vi, 0)) .. "|" .. dec(fv) .. "|"
        vi = vi + 1
    return out

main: i64 = ()
    src = stdin:read()
    src = compiler.opt.licm.licm(src)
    names = ""
    code = ""
    mgs = divscan(src)
    mp = 1
    while mp <= mgs:len()
        mq = mp
        while mq <= mgs:len() and mgs:byte(mq) != 124
            mq = mq + 1
        if mq > mp
            ds = mgs:sub(mp, mq - 1)
            nm = "divmg:" .. ds
            names = names .. nm .. "|"
            code = imm(code, reg(names, nm), at(divmagic(num(ds)), 0))
        mp = mq + 1
    wjmp = ""
    wrl = ""
    wrr = ""
    wind = ""
    wcd = ""
    wopen = 0
    pendname = ""
    pendkind = 0
    pendval = 0
    fix2 = "target=reassoc layer=emit merge=add,subneg,mul flush=read,write,loop,final arith=mod2p64 exclude=div,subreassoc,crossvar canon=egraph-distinct"
    fix3 = "target=div layer=calc algo=hd10-signed-division domain=absdivisor-lt-2p32 emit=smulh,addsub,asr,lsrcorr special=d1-mov,dneg1-neg,pow2-biasshift negdiv=posmagic-negate fallback=sdiv verify=exhaustive32-sampled64 magichoist=prologue-hiddenvar-divmg-colon-unforgeable accum=rd fusecorr=add-rd-rd-rd-lsr63"
    lc = rows(src)
    k = 0
    while k < lc
        raw = row(src, k)
        t = trim(raw)
        if t:len() == 0
            k = k + 1
        else
            ind = indent(raw)
            while wopen > 0 and at(wind, wopen - 1) >= ind
                if pendname != ""
                    prd = reg(names, pendname)
                    if pendkind == 0
                        pv = pendval
                        if pv != 0
                            if pv > 0 and pv < 4096
                                code = code .. word(addi(prd, prd, pv))
                            else
                                if pv < 0 and pv > 0 - 4096
                                    code = code .. word(subi(prd, prd, 0 - pv))
                                else
                                    code = imm(code, 9, pv)
                                    code = code .. word(add(prd, prd, 9))
                    else
                        pv = pendval
                        pm = mulred(code, prd, pendname, pv, names)
                        if pm:len() > 0
                            code = pm
                        else
                            code = imm(code, 10, pv)
                            code = code .. word(mul(prd, prd, 10))
                pendname = ""
                jp = at(wjmp, wopen - 1)
                rl = at(wrl, wopen - 1)
                rr = at(wrr, wopen - 1)
                cd = at(wcd, wopen - 1)
                tp = code:len() / 8
                if cd == 1
                    code = code .. word(subs(rr, rr, 1))
                    code = code .. word(bcond(1, jp - (tp + 1)))
                else
                    bp = jp + 1
                    code = patch(code, jp, jump(tp - jp))
                    code = code .. word(cmp(rl, rr))
                    code = code .. word(bcond(11, bp - (tp + 1)))
                wjmp = pop(wjmp, wopen)
                wrl = pop(wrl, wopen)
                wrr = pop(wrr, wopen)
                wind = pop(wind, wopen)
                wcd = pop(wcd, wopen)
                wopen = wopen - 1
            if t:len() > 6 and t:sub(1, 5) == "while" and t:byte(6) == 32
                rest = t:sub(7, t:len())
                lt = 0
                q = 1
                while q <= rest:len()
                    if rest:byte(q) == 60 and lt == 0
                        lt = q
                    q = q + 1
                lhs = trim(rest:sub(1, lt - 1))
                rhs = trim(rest:sub(lt + 1, rest:len()))
                cts = ""
                if wopen == 0 and isnum(rhs) == 1
                    cts = cttry(src, k, lc, ind, lhs, rhs)
                if cts != ""
                    ej = at(cts, 0)
                    nf = fldn(cts)
                    f = 1
                    while f < nf
                        nm = fld(cts, f)
                        vv = at(cts, f + 1)
                        if hasname(names, nm) == 0
                            names = names .. nm .. "|"
                        code = imm(code, reg(names, nm), vv)
                        f = f + 2
                    k = ej - 1
                else
                    rl = reg(names, lhs)
                    rr = 0
                    cd = 0
                    if digit(rhs:byte(1)) == 1
                        br = 11 + wopen
                        code = imm(code, br, num(rhs))
                        rr = br
                        if num(rhs) != 0 and purecount(src, k, lc, ind, lhs) == 1
                            pk = k - 1
                            while pk >= 0 and trim(row(src, pk)):len() == 0
                                pk = pk - 1
                            if pk >= 0 and trim(row(src, pk)) == lhs .. " = 0"
                                cd = 1
                    else
                        rr = reg(names, rhs)
                    jp = code:len() / 8
                    if cd == 0
                        code = code .. word(jump(0))
                    wjmp = wjmp .. dec(jp) .. "|"
                    wrl = wrl .. dec(rl) .. "|"
                    wrr = wrr .. dec(rr) .. "|"
                    wind = wind .. dec(ind) .. "|"
                    wcd = wcd .. dec(cd) .. "|"
                    wopen = wopen + 1
            else
                eq = 0
                q = 1
                while q <= t:len()
                    if t:byte(q) == 61 and eq == 0
                        eq = q
                    q = q + 1
                if eq > 0
                    name = trim(t:sub(1, eq - 1))
                    rhs = trim(t:sub(eq + 1, t:len()))
                    hascolon = 0
                    cn = 1
                    while cn <= name:len()
                        if name:byte(cn) == 58
                            hascolon = 1
                        cn = cn + 1
                    if hascolon == 0
                        if find(names, name) == 0 - 1
                            names = names .. name .. "|"
                        rd = reg(names, name)
                        skip = 0
                        if wopen > 0 and at(wcd, wopen - 1) == 1 and rd == at(wrl, wopen - 1)
                            skip = 1
                        if skip == 0
                            sp = splitop(rhs)
                            oppos = at(sp, 0)
                            op = at(sp, 1)
                            if oppos == 0
                                if pendname != ""
                                    prd = reg(names, pendname)
                                    if pendkind == 0
                                        pv = pendval
                                        if pv != 0
                                            if pv > 0 and pv < 4096
                                                code = code .. word(addi(prd, prd, pv))
                                            else
                                                if pv < 0 and pv > 0 - 4096
                                                    code = code .. word(subi(prd, prd, 0 - pv))
                                                else
                                                    code = imm(code, 9, pv)
                                                    code = code .. word(add(prd, prd, 9))
                                    else
                                        pv = pendval
                                        pm = mulred(code, prd, pendname, pv, names)
                                        if pm:len() > 0
                                            code = pm
                                        else
                                            code = imm(code, 10, pv)
                                            code = code .. word(mul(prd, prd, 10))
                                pendname = ""
                                code = term(code, rhs, rd, names)
                            else
                            a = trim(rhs:sub(1, oppos - 1))
                            e = trim(rhs:sub(oppos + 1, rhs:len()))
                            skind = 0 - 1
                            sval = 0
                            if a == name and isnum(e)
                                if op == 43
                                    skind = 0
                                    sval = num(e)
                                else
                                    if op == 45
                                        skind = 0
                                        sval = 0 - num(e)
                                    else
                                        if op == 42
                                            skind = 1
                                            sval = num(e)
                            else
                                if e == name and isnum(a)
                                    if op == 43
                                        skind = 0
                                        sval = num(a)
                                    else
                                        if op == 42 and num(a) != 0
                                            skind = 1
                                            sval = num(a)
                            if skind < 0
                                if pendname != ""
                                    prd = reg(names, pendname)
                                    if pendkind == 0
                                        pv = pendval
                                        if pv != 0
                                            if pv > 0 and pv < 4096
                                                code = code .. word(addi(prd, prd, pv))
                                            else
                                                if pv < 0 and pv > 0 - 4096
                                                    code = code .. word(subi(prd, prd, 0 - pv))
                                                else
                                                    code = imm(code, 9, pv)
                                                    code = code .. word(add(prd, prd, 9))
                                    else
                                        pv = pendval
                                        pm = mulred(code, prd, pendname, pv, names)
                                        if pm:len() > 0
                                            code = pm
                                        else
                                            code = imm(code, 10, pv)
                                            code = code .. word(mul(prd, prd, 10))
                                pendname = ""
                                code = calc(code, rd, a, op, e, 11, names)
                            else
                                if skind == 0 and sval == 0
                                    nop = 1
                                else
                                    if skind == 1 and sval == 1
                                        nop = 1
                                    else
                                        if pendname == name and pendkind == skind
                                            if skind == 0
                                                pendval = pendval + sval
                                                if pendval == 0
                                                    pendname = ""
                                            else
                                                pendval = pendval * sval
                                                if pendval == 1
                                                    pendname = ""
                                        else
                                            if pendname != ""
                                                prd = reg(names, pendname)
                                                if pendkind == 0
                                                    pv = pendval
                                                    if pv != 0
                                                        if pv > 0 and pv < 4096
                                                            code = code .. word(addi(prd, prd, pv))
                                                        else
                                                            if pv < 0 and pv > 0 - 4096
                                                                code = code .. word(subi(prd, prd, 0 - pv))
                                                            else
                                                                code = imm(code, 9, pv)
                                                                code = code .. word(add(prd, prd, 9))
                                                else
                                                    pv = pendval
                                                    pm = mulred(code, prd, pendname, pv, names)
                                                    if pm:len() > 0
                                                        code = pm
                                                    else
                                                        code = imm(code, 10, pv)
                                                        code = code .. word(mul(prd, prd, 10))
                                            pendname = ""
                                            pendname = name
                                            pendkind = skind
