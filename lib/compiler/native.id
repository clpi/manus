hex: str = (v: i64)
    digits = "0123456789abcdef"
    d = (v & 15) + 1
    digits:sub(d, d)

pair: str = (v: i64)
    hex(v >> 4) .. hex(v)

word: str = (v: i64)
    pair(v) .. pair(v >> 8) .. pair(v >> 16) .. pair(v >> 24)

quad: str = (v: i64)
    word(v) .. word(v >> 32)

field: str = (s: str)
    out = ""
    i = 1
    while i <= 16
        if i <= s:len()
            out = out .. pair(s:byte(i))
        else
            out = out .. "00"
        i = i + 1
    out

movz: i64 = (rd: i64, imm: i64)
    3531603968 | ((imm & 65535) << 5) | rd

movk: i64 = (rd: i64, imm: i64, hw: i64)
    4068474880 | (hw << 21) | ((imm & 65535) << 5) | rd

add: i64 = (rd: i64, rn: i64, rm: i64)
    2332033024 | (rm << 16) | (rn << 5) | rd

addsh: i64 = (rd: i64, rn: i64, rm: i64, sh: i64)
    2332033024 | (rm << 16) | (sh << 10) | (rn << 5) | rd

subs: i64 = (rd: i64, rn: i64, im: i64)
    4043309056 | ((im & 4095) << 10) | (rn << 5) | rd

minus: i64 = (rd: i64, rn: i64, rm: i64)
    3405774848 | (rm << 16) | (rn << 5) | rd

mul: i64 = (rd: i64, rn: i64, rm: i64)
    2600468480 | (rm << 16) | (31 << 10) | (rn << 5) | rd

div: i64 = (rd: i64, rn: i64, rm: i64)
    2596277248 | (rm << 16) | (rn << 5) | rd

addi: i64 = (rd: i64, rn: i64, v: i64)
    2432696320 | ((v & 4095) << 10) | (rn << 5) | rd

subi: i64 = (rd: i64, rn: i64, v: i64)
    3506438144 | ((v & 4095) << 10) | (rn << 5) | rd

lsl: i64 = (rd: i64, rn: i64, s: i64)
    3544186880 | (((64 - s) & 63) << 16) | ((63 - s) << 10) | (rn << 5) | rd

powtwo: i64 = (v: i64)
    if v < 2
        return 0 - 1
    sh = 0
    p = 1
    while p < v
        p = p * 2
        sh = sh + 1
    if p == v
        return sh
    0 - 1

mov: i64 = (rd: i64, rm: i64)
    2852126720 | (rm << 16) | (31 << 5) | rd

cmp: i64 = (rn: i64, rm: i64)
    3942645760 | (rm << 16) | (rn << 5) | 31

jump: i64 = (off: i64)
    335544320 | (off & 67108863)

bcond: i64 = (cond: i64, off: i64)
    1409286144 | ((off & 524287) << 5) | cond

ret: i64 = ()
    3596551104

digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

num: i64 = (s: str)
    v = 0
    i = 1
    n = s:len()
    while i <= n
        v = v * 10 + s:byte(i) - 48
        i = i + 1
    v

dec: str = (v: i64)
    if v == 0
        return "0"
    out = ""
    x = v
    while x > 0
        out = hex(x - (x / 10) * 10) .. out
        x = x / 10
    out

trim: str = (s: str)
    n = s:len()
    a = 1
    while a <= n and s:byte(a) == 32
        a = a + 1
    b = n
    while b >= a and s:byte(b) == 32
        b = b - 1
    if b < a
        return ""
    s:sub(a, b)

find: i64 = (hay: str, key: str)
    pat = key .. "|"
    n = hay:len()
    m = pat:len()
    i = 1
    idx = 0
    while i + m - 1 <= n
        if hay:sub(i, i + m - 1) == pat
            return idx
        if hay:byte(i) == 124
            idx = idx + 1
        i = i + 1
    0 - 1

at: i64 = (vals: str, idx: i64)
    cur = 0
    i = 1
    n = vals:len()
    while i <= n
        if cur == idx
            j = i
            while j <= n and vals:byte(j) != 124
                j = j + 1
            return num(vals:sub(i, j - 1))
        if vals:byte(i) == 124
            cur = cur + 1
        i = i + 1
    0

reg: i64 = (names: str, name: str)
    19 + find(names, name)

put: str = (c: str, w: i64)
    c .. word(w)

patch: str = (c: str, p: i64, w: i64)
    a = p * 8
    pre = ""
    if a > 0
        pre = c:sub(1, a)
    post = ""
    if a + 9 <= c:len()
        post = c:sub(a + 9, c:len())
    pre .. word(w) .. post

imm: str = (c: str, r: i64, v: i64)
    c = c .. word(movz(r, v & 65535))
    hi = (v >> 16) & 65535
    if hi != 0
        c = c .. word(movk(r, hi, 1))
    c

term: str = (c: str, t: str, r: i64, names: str)
    if digit(t:byte(1)) == 1
        return imm(c, r, num(t))
    c .. word(mov(r, reg(names, t)))

foldop: i64 = (a: i64, o: i64, b: i64)
    if o == 43
        return a + b
    if o == 45
        return a - b
    if o == 42
        return a * b
    0

simpadd: i64 = (a: i64, isa: i64, b: i64, isb: i64)
    if isa == 1 and a == 0
        return 1
    if isb == 1 and b == 0
        return 2
    0

simpmul: i64 = (a: i64, isa: i64, b: i64, isb: i64)
    if isa == 1 and a == 0
        return 3
    if isb == 1 and b == 0
        return 3
    if isa == 1 and a == 1
        return 2
    if isb == 1 and b == 1
        return 1
    0

mulred: str = (c: str, rd: i64, n: str, v: i64, names: str)
    sh = powtwo(v)
    if sh > 0
        return c .. word(lsl(rd, reg(names, n), sh))
    if v == 3
        return c .. word(addsh(rd, reg(names, n), reg(names, n), 1))
    if v == 5
        return c .. word(addsh(rd, reg(names, n), reg(names, n), 2))
    if v == 7
        t = c .. word(lsl(10, reg(names, n), 3))
        return t .. word(minus(rd, 10, reg(names, n)))
    if v == 9
        return c .. word(addsh(rd, reg(names, n), reg(names, n), 3))
    ""

purecount: i64 = (src: str, k: i64, lc: i64, ind: i64, lhs: str)
    bind = 0
    k2 = k + 1
    while k2 < lc and bind == 0
        r2 = row(src, k2)
        t2 = trim(r2)
        if t2:len() > 0
            if indent(r2) > ind
                bind = indent(r2)
            else
                k2 = lc
        if k2 < lc
            k2 = k2 + 1
    if bind == 0
        return 0
    p = 1
    found = 0
    inc = lhs .. " = " .. lhs .. " + 1"
    k2 = k + 1
    while k2 < lc and p == 1
        r2 = row(src, k2)
        t2 = trim(r2)
        if t2:len() > 0
            if indent(r2) > ind
                if indent(r2) == bind and t2 == inc
                    found = 1
                else
                    if hassub(t2, lhs) == 1
                        p = 0
            else
                k2 = lc
        if k2 < lc
            k2 = k2 + 1
    if found == 0
        p = 0
    p

hassub: i64 = (hay: str, key: str)
    n = hay:len()
    m = key:len()
    i = 1
    while i + m - 1 <= n
        if hay:sub(i, i + m - 1) == key
            return 1
        i = i + 1
    0

calc: str = (c: str, rd: i64, a: str, o: i64, e: str, names: str)
    aconst = digit(a:byte(1))
    econst = digit(e:byte(1))
    av = 0
    ev = 0
    if aconst == 1
        av = num(a)
    if econst == 1
        ev = num(e)
    if aconst == 1 and econst == 1 and o != 47
        return imm(c, rd, foldop(av, o, ev))
    skip = 0
    if o == 43
        s = simpadd(av, aconst, ev, econst)
        if s == 1
            return term(c, e, rd, names)
        if s == 2
            return term(c, a, rd, names)
    if o == 42
        s = simpmul(av, aconst, ev, econst)
        if s == 1
            return term(c, a, rd, names)
        if s == 2
            return term(c, e, rd, names)
        if s == 3
            return imm(c, rd, 0)
    if o == 45
        if econst == 1 and ev == 0
            return term(c, a, rd, names)
        if aconst == 0 and econst == 0 and a == e
            return imm(c, rd, 0)
    if o == 43 and aconst == 1 and econst == 0 and av < 4096
        return c .. word(addi(rd, reg(names, e), av))
    if o == 43 and aconst == 0 and econst == 1 and ev < 4096
        return c .. word(addi(rd, reg(names, a), ev))
    if o == 45 and aconst == 0 and econst == 1 and ev < 4096
        return c .. word(subi(rd, reg(names, a), ev))
    if o == 42 and aconst == 0 and econst == 1
        m = mulred(c, rd, a, ev, names)
        if m:len() > 0
            return m
    if o == 42 and aconst == 1 and econst == 0
        m = mulred(c, rd, e, av, names)
        if m:len() > 0
            return m
    ra = 0
    rb = 0
    if aconst == 1
        c = imm(c, 9, av)
        ra = 9
    else
        ra = reg(names, a)
    if econst == 1
        c = imm(c, 10, ev)
        rb = 10
    else
        rb = reg(names, e)
    if o == 43
        return c .. word(add(rd, ra, rb))
    if o == 45
        return c .. word(minus(rd, ra, rb))
    if o == 42
        return c .. word(mul(rd, ra, rb))
    c .. word(div(rd, ra, rb))

indent: i64 = (s: str)
    n = s:len()
    i = 1
    while i <= n and s:byte(i) == 32
        i = i + 1
    i - 1

rows: i64 = (s: str)
    n = 0
    i = 1
    while i <= s:len()
        if s:byte(i) == 10
            n = n + 1
        i = i + 1
    if s:len() > 0 and s:byte(s:len()) != 10
        n = n + 1
    n

row: str = (s: str, k: i64)
    n = s:len()
    i = 1
    cur = 0
    a = 1
    while i <= n + 1
        if i > n or s:byte(i) == 10
            if cur == k
                return s:sub(a, i - 1)
            cur = cur + 1
            a = i + 1
        i = i + 1
    ""

pop: str = (s: str, n: i64)
    out = ""
    i = 0
    while i < n - 1
        out = out .. dec(at(s, i)) .. "|"
        i = i + 1
    out

main: i64 = ()
    src = stdin:read()
    names = ""
    code = ""
    wjmp = ""
    wrl = ""
    wrr = ""
    wind = ""
    wcd = ""
    wopen = 0
    lc = rows(src)
    k = 0
    while k < lc
        raw = row(src, k)
        t = trim(raw)
        if t:len() == 0
            k = k + 1
        else
            ind = indent(raw)
            while wopen > 0 and at(wind, wopen - 1) >= ind
                jp = at(wjmp, wopen - 1)
                rl = at(wrl, wopen - 1)
                rr = at(wrr, wopen - 1)
                cd = at(wcd, wopen - 1)
                tp = code:len() / 8
                if cd == 1
                    code = code .. word(subs(rr, rr, 1))
                    code = code .. word(bcond(1, jp - (tp + 1)))
                else
                    bp = jp + 1
                    code = patch(code, jp, jump(tp - jp))
                    code = code .. word(cmp(rl, rr))
                    code = code .. word(bcond(11, bp - (tp + 1)))
                wjmp = pop(wjmp, wopen)
                wrl = pop(wrl, wopen)
                wrr = pop(wrr, wopen)
                wind = pop(wind, wopen)
                wcd = pop(wcd, wopen)
                wopen = wopen - 1
            if t:len() > 6 and t:sub(1, 5) == "while" and t:byte(6) == 32
                rest = t:sub(7, t:len())
                lt = 0
                q = 1
                while q <= rest:len()
                    if rest:byte(q) == 60 and lt == 0
                        lt = q
                    q = q + 1
                lhs = trim(rest:sub(1, lt - 1))
                rhs = trim(rest:sub(lt + 1, rest:len()))
                rl = reg(names, lhs)
                rr = 0
                cd = 0
                if digit(rhs:byte(1)) == 1
                    br = 11 + wopen
                    code = imm(code, br, num(rhs))
                    rr = br
                    if num(rhs) != 0 and purecount(src, k, lc, ind, lhs) == 1
                        pk = k - 1
                        while pk >= 0 and trim(row(src, pk)):len() == 0
                            pk = pk - 1
                        if pk >= 0 and trim(row(src, pk)) == lhs .. " = 0"
                            cd = 1
                else
                    rr = reg(names, rhs)
                jp = code:len() / 8
                if cd == 0
                    code = code .. word(jump(0))
                wjmp = wjmp .. dec(jp) .. "|"
                wrl = wrl .. dec(rl) .. "|"
                wrr = wrr .. dec(rr) .. "|"
                wind = wind .. dec(ind) .. "|"
                wcd = wcd .. dec(cd) .. "|"
                wopen = wopen + 1
            else
                eq = 0
                q = 1
                while q <= t:len()
                    if t:byte(q) == 61 and eq == 0
                        eq = q
                    q = q + 1
                if eq > 0
                    name = trim(t:sub(1, eq - 1))
                    rhs = trim(t:sub(eq + 1, t:len()))
                    hascolon = 0
                    cn = 1
                    while cn <= name:len()
                        if name:byte(cn) == 58
                            hascolon = 1
                        cn = cn + 1
                    if hascolon == 0
                        if find(names, name) == 0 - 1
                            names = names .. name .. "|"
                        rd = reg(names, name)
                        skip = 0
                        if wopen > 0 and at(wcd, wopen - 1) == 1 and rd == at(wrl, wopen - 1)
                            skip = 1
                        if skip == 0
                            oppos = 0
                            op = 0
                            q = 1
                            while q <= rhs:len()
                                oc = rhs:byte(q)
                                if oc == 43 or oc == 45 or oc == 42 or oc == 47
                                    if oppos == 0
                                        oppos = q
                                        op = oc
                                q = q + 1
                            if oppos == 0
                                code = term(code, rhs, rd, names)
                            else
                            a = trim(rhs:sub(1, oppos - 1))
                            e = trim(rhs:sub(oppos + 1, rhs:len()))
                            code = calc(code, rd, a, op, e, names)
                else
                    oppos = 0
                    op = 0
                    q = 1
                    while q <= t:len()
                        oc = t:byte(q)
                        if oc == 43 or oc == 45 or oc == 42 or oc == 47
                            if oppos == 0
                                oppos = q
                                op = oc
                        q = q + 1
                    if oppos == 0
                        code = term(code, t, 0, names)
                    else
                        a = trim(t:sub(1, oppos - 1))
                        e = trim(t:sub(oppos + 1, t:len()))
                        code = calc(code, 0, a, op, e, names)
                    code = code .. word(ret())
                    k = lc
            k = k + 1
    codesize = code:len() / 2
    symoff = 208 + codesize
    stroff = symoff + 16
    head = word(4277009103)
    head = head .. word(16777228)
    head = head .. word(0)
    head = head .. word(1)
    head = head .. word(2)
    head = head .. word(176)
    head = head .. word(0)
    head = head .. word(0)
    head = head .. word(25)
    head = head .. word(152)
    head = head .. field("")
    head = head .. quad(0)
    head = head .. quad(codesize)
    head = head .. quad(208)
    head = head .. quad(codesize)
    head = head .. word(7)
    head = head .. word(7)
    head = head .. word(1)
    head = head .. word(0)
    head = head .. field("__text")
    head = head .. field("__TEXT")
    head = head .. quad(0)
    head = head .. quad(codesize)
    head = head .. word(208)
    head = head .. word(2)
    head = head .. word(0)
    head = head .. word(0)
    head = head .. word(2147484672)
    head = head .. word(0)
    head = head .. word(0)
    head = head .. word(0)
    head = head .. word(2)
    head = head .. word(24)
    head = head .. word(symoff)
    head = head .. word(1)
    head = head .. word(stroff)
    head = head .. word(11)
    head = head .. code
    head = head .. word(1)
    head = head .. pair(15)
    head = head .. pair(1)
    head = head .. pair(0)
    head = head .. pair(0)
    head = head .. quad(0)
    head = head .. "005f69646f6c6d61696e00"
    stdout:write(head)
    0
