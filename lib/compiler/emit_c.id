

translate: str = (src: str)
    n: i64 = src:len()
    out = ""
    i: i64 = 1
    while i <= n
        c: i64 = src:byte(i)
        if c == 94
            return ""
        end
        if c == 126
            j: i64 = i - 1
            while j >= 1 and src:byte(j) == 32
                j -= 1
            end
            prev: i64 = 0
            if j >= 1
                prev = src:byte(j)
            end
            infix = (prev >= 48 and prev <= 57) or prev == 41
                or (prev >= 97 and prev <= 122) or (prev >= 65 and prev <= 90)
            if infix
                out = out .. "^"
            else
                out = out .. "~"
            end
            i += 1
        else
            out = out .. src:sub(i, i)
            i += 1
        end
    end
    out
end

program: str = (expr: str)
    body = translate(expr)
    if body == ""
        return ""
    end
    "include:len() <stdio.h>\nint main(void) { printf(\"%lld\\n\", (long long)("
        .. body .. ")); return 0; }\n"
end

ok: bool = (expr: str)
    prog = program(expr)
    if prog == ""
        return false
    end
    true
end

eval: i64 = (expr: str)
    prog = program(expr)
    if prog == ""
        return 0 - 1
    end
    base = "/tmp/duo_emit_c_" .. to(str)(os.time())
    src = base .. ".c"
    exe = base .. ".out"
    fh = io.open(src, "w")
    if !fh
        return 0 - 1
    end
    fh:write(prog)
    fh:close()
    cc = os.env["DUO_EMIT_CC"]
    if cc == nil
        cc = "xcrun cc"
    end
    if !os.execute(cc .. " -O0 -o " .. exe .. " " .. src .. " 2>/dev/null")
        os.remove(src)
        return 0 - 1
    end
    out = os.capture(exe)
    os.remove(src)
    os.remove(exe)
    to(i64)(out)
end
