# compiler.monolith — capability probe only (NOT compiler-B architecture).
# Cross-module references don't work, so everything is inlined for diagnosis.
#
# v2: adds tokenizer, token-level parser, comparison operators.

# ── Character classifiers ───────────────────────────────────────────────────

is_digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

is_alpha: i64 = (c: i64)
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        return 1
    0

is_alnum: i64 = (c: i64)
    if is_digit(c) == 1 or is_alpha(c) == 1
        return 1
    0

# ── Packed integer encoding ─────────────────────────────────────────────────

BASE = 4294967296

pk: i64 = (val: i64, pos: i64)
    val * BASE + pos

val_of: i64 = (packed: i64)
    q = 0
    x = packed
    while x >= BASE
        x = x - BASE
        q += 1
    q

pos_of: i64 = (packed: i64)
    packed - val_of(packed) * BASE

# ── Token kinds ─────────────────────────────────────────────────────────────

KIND_EOF = 0
KIND_INT = 1
KIND_NAME = 2
KIND_LPAREN = 3
KIND_RPAREN = 4
KIND_PLUS = 5
KIND_MINUS = 6
KIND_STAR = 7
KIND_SLASH = 8
KIND_EQ = 9
KIND_NEQ = 10
KIND_LT = 11
KIND_GT = 12
KIND_LEQ = 13
KIND_GEQ = 14
KIND_TRUE = 26
KIND_FALSE = 27

# ── Tokenizer ───────────────────────────────────────────────────────────────

skip_spaces: i64 = (src: str, pos: i64)
    n = src:len()
    i = pos
    while i <= n and src:byte(i) == 32
        i += 1
    i

read_name: i64 = (src: str, pos: i64)
    n = src:len()
    i = pos
    while i <= n and is_alnum(src:byte(i)) == 1
        i += 1
    pk(i - pos, i)

read_number: i64 = (src: str, pos: i64)
    n = src:len()
    acc = 0
    i = pos
    while i <= n and is_digit(src:byte(i)) == 1
        acc = acc * 10 + src:byte(i) - 48
        i += 1
    pk(acc, i)

classify_keyword: i64 = (src: str, start: i64, len: i64)
    c = src:byte(start)
    if c == 105 and len == 2
        if src:byte(start + 1) == 102
            return 16
    if c == 116 and len == 4
        if src:byte(start + 1) == 114 and src:byte(start + 2) == 117 and src:byte(start + 3) == 101
            return 26
    if c == 102 and len == 5
        if src:byte(start + 1) == 97 and src:byte(start + 2) == 108 and src:byte(start + 3) == 115 and src:byte(start + 4) == 101
            return 27
    2
# Read the next token. Returns packed(kind, pos_after).
next_tok: i64 = (src: str, pos: i64)
    i = skip_spaces(src, pos)
    n = src:len()
    if i > n
        return pk(KIND_EOF, i)
    c = src:byte(i)
    if c == 40
        return pk(KIND_LPAREN, i + 1)
    if c == 41
        return pk(KIND_RPAREN, i + 1)
    if c == 43
        return pk(KIND_PLUS, i + 1)
    if c == 45
        return pk(KIND_MINUS, i + 1)
    if c == 42
        return pk(KIND_STAR, i + 1)
    if c == 47
        return pk(KIND_SLASH, i + 1)
    if c == 61
        if i + 1 <= n and src:byte(i + 1) == 61
            return pk(KIND_EQ, i + 2)
        return pk(KIND_EOF, i + 1)
    if c == 33
        if i + 1 <= n and src:byte(i + 1) == 61
            return pk(KIND_NEQ, i + 2)
        return pk(KIND_EOF, i + 1)
    if c == 60
        if i + 1 <= n and src:byte(i + 1) == 61
            return pk(KIND_LEQ, i + 2)
        return pk(KIND_LT, i + 1)
    if c == 62
        if i + 1 <= n and src:byte(i + 1) == 61
            return pk(KIND_GEQ, i + 2)
        return pk(KIND_GT, i + 1)
    if is_digit(c) == 1
        num = read_number(src, i)
        return pk(KIND_INT, pos_of(num))
    if is_alpha(c) == 1
        name = read_name(src, i)
        name_len = val_of(name)
        name_end = pos_of(name)
        kw = classify_keyword(src, i, name_len)
        return pk(kw, name_end)
    pk(KIND_EOF, i + 1)

# ── Character-level expression parser (L1) ───────────────────────────────────

parse_factor: i64 = (src: str, pos: i64)
    n = src:len()
    i = skip_spaces(src, pos)
    if i > n
        return pk(0, i)
    c = src:byte(i)
    if c == 40
        inner = parse_expr(src, i + 1)
        iv = val_of(inner)
        ip = pos_of(inner)
        j = skip_spaces(src, ip)
        if j <= n and src:byte(j) == 41
            return pk(iv, j + 1)
        return pk(iv, j)
    acc = 0
    j = i
    while j <= n and is_digit(src:byte(j)) == 1
        acc = acc * 10 + src:byte(j) - 48
        j += 1
    pk(acc, j)

parse_term: i64 = (src: str, pos: i64)
    n = src:len()
    left = parse_factor(src, pos)
    acc = val_of(left)
    i = skip_spaces(src, pos_of(left))
    while i <= n
        op = src:byte(i)
        if op == 42
            rhs = parse_factor(src, i + 1)
            acc = acc * val_of(rhs)
            i = skip_spaces(src, pos_of(rhs))
        if op == 47
            rhs2 = parse_factor(src, i + 1)
            acc = acc / val_of(rhs2)
            i = skip_spaces(src, pos_of(rhs2))
        if op != 42 and op != 47
            return pk(acc, i)
    pk(acc, i)

parse_expr: i64 = (src: str, pos: i64)
    n = src:len()
    left = parse_term(src, pos)
    acc = val_of(left)
    i = skip_spaces(src, pos_of(left))
    while i <= n
        op = src:byte(i)
        if op == 43
            rhs = parse_term(src, i + 1)
            acc += val_of(rhs)
            i = skip_spaces(src, pos_of(rhs))
        if op == 45
            rhs2 = parse_term(src, i + 1)
            acc -= val_of(rhs2)
            i = skip_spaces(src, pos_of(rhs2))
        if op != 43 and op != 45
            return pk(acc, i)
    pk(acc, i)

# ── Token-level expression parser (L2) ──────────────────────────────────────

# Parse a primary expression: INT | '(' expr ')' | TRUE | FALSE
parse_primary: i64 = (src: str, pos: i64)
    tok = next_tok(src, pos)
    kind = val_of(tok)
    after = pos_of(tok)
    if kind == KIND_INT
        num = read_number(src, skip_spaces(src, pos))
        return pk(val_of(num), after)
    if kind == KIND_LPAREN
        inner = parse_expr_tok(src, after)
        iv = val_of(inner)
        ip = pos_of(inner)
        tok2 = next_tok(src, ip)
        if val_of(tok2) == KIND_RPAREN
            return pk(iv, pos_of(tok2))
        return pk(iv, ip)
    if kind == KIND_TRUE
        return pk(1, after)
    if kind == KIND_FALSE
        return pk(0, after)
    pk(0, after)

# term := primary (('*' | '/') primary)*
# Does NOT consume non-matching tokens — leaves them for parse_expr_tok.
parse_term_tok: i64 = (src: str, pos: i64)
    left = parse_primary(src, pos)
    acc = val_of(left)
    i = pos_of(left)
    cont = 1
    while cont == 1
        tok = next_tok(src, i)
        kind = val_of(tok)
        if kind == KIND_STAR
            i = pos_of(tok)
            rhs = parse_primary(src, i)
            acc = acc * val_of(rhs)
            i = pos_of(rhs)
        if kind == KIND_SLASH
            i = pos_of(tok)
            rhs2 = parse_primary(src, i)
            rv = val_of(rhs2)
            if rv != 0
                acc = acc / rv
            i = pos_of(rhs2)
        if kind != KIND_STAR and kind != KIND_SLASH
            cont = 0
    pk(acc, i)

# expr := term (('+' | '-') term)*
# Does NOT consume non-matching tokens.
parse_expr_tok: i64 = (src: str, pos: i64)
    left = parse_term_tok(src, pos)
    acc = val_of(left)
    i = pos_of(left)
    cont = 1
    while cont == 1
        tok = next_tok(src, i)
        kind = val_of(tok)
        if kind == KIND_PLUS
            i = pos_of(tok)
            rhs = parse_term_tok(src, i)
            acc += val_of(rhs)
            i = pos_of(rhs)
        if kind == KIND_MINUS
            i = pos_of(tok)
            rhs2 = parse_term_tok(src, i)
            acc -= val_of(rhs2)
            i = pos_of(rhs2)
        if kind != KIND_PLUS and kind != KIND_MINUS
            cont = 0
    pk(acc, i)

# ── Comparison operators ─────────────────────────────────────────────────────

# cmp := expr (('==' | '!=' | '<' | '>' | '<=' | '>=') expr)?
parse_cmp: i64 = (src: str, pos: i64)
    left = parse_expr_tok(src, pos)
    lv = val_of(left)
    i = pos_of(left)
    tok = next_tok(src, i)
    kind = val_of(tok)
    if kind == KIND_EQ
        i = pos_of(tok)
        rhs = parse_expr_tok(src, i)
        if lv == val_of(rhs)
            return pk(1, pos_of(rhs))
        return pk(0, pos_of(rhs))
    if kind == KIND_NEQ
        i = pos_of(tok)
        rhs = parse_expr_tok(src, i)
        if lv != val_of(rhs)
            return pk(1, pos_of(rhs))
        return pk(0, pos_of(rhs))
    if kind == KIND_LT
        i = pos_of(tok)
        rhs = parse_expr_tok(src, i)
        if lv < val_of(rhs)
            return pk(1, pos_of(rhs))
        return pk(0, pos_of(rhs))
    if kind == KIND_GT
        i = pos_of(tok)
        rhs = parse_expr_tok(src, i)
        if lv > val_of(rhs)
            return pk(1, pos_of(rhs))
        return pk(0, pos_of(rhs))
    if kind == KIND_LEQ
        i = pos_of(tok)
        rhs = parse_expr_tok(src, i)
        if lv <= val_of(rhs)
            return pk(1, pos_of(rhs))
        return pk(0, pos_of(rhs))
    if kind == KIND_GEQ
        i = pos_of(tok)
        rhs = parse_expr_tok(src, i)
        if lv >= val_of(rhs)
            return pk(1, pos_of(rhs))
        return pk(0, pos_of(rhs))
    pk(lv, pos_of(left))

# ── Entry points ─────────────────────────────────────────────────────────────

eval: i64 = (src: str)
    val_of(parse_expr(src, 1))

eval_tok: i64 = (src: str)
    val_of(parse_expr_tok(src, 1))

eval_cmp: i64 = (src: str)
    val_of(parse_cmp(src, 1))

# ── Self-tests ───────────────────────────────────────────────────────────────

main: i64 = ()
    a = eval("1 + 2 * 3")
    b = eval("(1 + 2) * 3")
    c = eval("10 / 2 + 3")
    d = eval("42")
    e = eval("1 + 2 + 3 + 4")
    ok = 0
    if a == 7
        ok += 1
    if b == 9
        ok += 1
    if c == 8
        ok += 1
    if d == 42
        ok += 1
    if e == 10
        ok += 1

    f = eval_tok("1 + 2 * 3")
    g = eval_tok("(1 + 2) * 3")
    h = eval_tok("42")
    if f == 7
        ok += 1
    if g == 9
        ok += 1
    if h == 42
        ok += 1

    i = eval_cmp("1 + 2 == 3")
    j = eval_cmp("5 != 3")
    k = eval_cmp("10 > 5")
    if i == 1
        ok += 1
    if j == 1
        ok += 1
    if k == 1
        ok += 1
    ok