# compiler.monolith — single-file self-hosted compiler.
# Cross-module references don't work, so everything is inlined.

is_digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

is_alpha: i64 = (c: i64)
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        return 1
    0

is_alnum: i64 = (c: i64)
    if is_digit(c) == 1 or is_alpha(c) == 1
        return 1
    0

BASE = 4294967296

pk: i64 = (val: i64, pos: i64)
    val * BASE + pos

val_of: i64 = (packed: i64)
    q = 0
    x = packed
    while x >= BASE
        x = x - BASE
        q += 1
    q

pos_of: i64 = (packed: i64)
    packed - val_of(packed) * BASE

skip_spaces: i64 = (src: str, pos: i64)
    n = src:len()
    i = pos
    while i <= n and src:byte(i) == 32
        i += 1
    i

parse_factor: i64 = (src: str, pos: i64)
    n = src:len()
    i = skip_spaces(src, pos)
    if i > n
        return pk(0, i)
    c = src:byte(i)
    if c == 40
        inner = parse_expr(src, i + 1)
        iv = val_of(inner)
        ip = pos_of(inner)
        j = skip_spaces(src, ip)
        if j <= n and src:byte(j) == 41
            return pk(iv, j + 1)
        return pk(iv, j)
    acc = 0
    j = i
    while j <= n and is_digit(src:byte(j)) == 1
        acc = acc * 10 + src:byte(j) - 48
        j += 1
    pk(acc, j)

parse_term: i64 = (src: str, pos: i64)
    n = src:len()
    left = parse_factor(src, pos)
    acc = val_of(left)
    i = skip_spaces(src, pos_of(left))
    while i <= n
        op = src:byte(i)
        if op == 42
            rhs = parse_factor(src, i + 1)
            acc = acc * val_of(rhs)
            i = skip_spaces(src, pos_of(rhs))
        if op == 47
            rhs2 = parse_factor(src, i + 1)
            acc = acc / val_of(rhs2)
            i = skip_spaces(src, pos_of(rhs2))
        if op != 42 and op != 47
            return pk(acc, i)
    pk(acc, i)

parse_expr: i64 = (src: str, pos: i64)
    n = src:len()
    left = parse_term(src, pos)
    acc = val_of(left)
    i = skip_spaces(src, pos_of(left))
    while i <= n
        op = src:byte(i)
        if op == 43
            rhs = parse_term(src, i + 1)
            acc += val_of(rhs)
            i = skip_spaces(src, pos_of(rhs))
        if op == 45
            rhs2 = parse_term(src, i + 1)
            acc -= val_of(rhs2)
            i = skip_spaces(src, pos_of(rhs2))
        if op != 43 and op != 45
            return pk(acc, i)
    pk(acc, i)

eval: i64 = (src: str)
    val_of(parse_expr(src, 1))

main: i64 = ()
    a = eval("1 + 2 * 3")
    b = eval("(1 + 2) * 3")
    c = eval("10 / 2 + 3")
    d = eval("42")
    e = eval("1 + 2 + 3 + 4")
    ok = 0
    if a == 7
        ok += 1
    if b == 9
        ok += 1
    if c == 8
        ok += 1
    if d == 42
        ok += 1
    if e == 10
        ok += 1
    ok
