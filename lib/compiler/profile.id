
has: bool = (hay: str, needle: str)
  hn: i64 = hay:len()
  nn: i64 = needle:len()
  i: i64 = 1
  while i + nn - 1 <= hn
    j: i64 = 0
    hit = true
    while j < nn
      if hay:byte(i + j) != needle:byte(j + 1)
        hit = false
        j = nn
      j = j + 1
    if hit
      return true
    i = i + 1
  false

dynamic: bool = (src: str)
  if has(src, ": any")
    return true
  if has(src, "{")
    return true
  if has(src, "...")
    return true
  if has(src, ": str")
    return true
  false

profile: str = (src: str)
  if dynamic(src)
    return "dynamic"
  "freestanding"
