-- Structural contract for seed -> compiler B -> compiler C.
--
-- The synthetic controls below validate lineage and parity relationships only.
-- They do not authenticate an identity, observe a compiler, or prove B/C. A
-- production graph and execution world must mint every supplied identity.

identity: {
    meaning: i64
    content: i64
    incarnation: i64
}

lineage: {
    application: identity
    producer: identity
    source: identity
    backend: identity
    output: identity
}

trace: {
    witness: identity
    world: identity
    provenance: identity
    lineage: lineage
    semantic: identity
    behavior: identity
    diagnostic: identity
}

stage: {
    application: identity
    producer: identity
    source: identity
    backend: identity
    world: identity
    output: identity
    witness: identity
    provenance: identity
    trace: trace
}

chain: {
    seed: identity
    first: stage
    second: stage
}

capability: {
    relation: identity
    descriptor: identity
    witness: identity
}

basis: {
    bytes: capability
    view: capability
    string: capability
    arena: capability
    vector: capability
    map: capability
    intern: capability
    bitset: capability
    source: capability
    span: capability
    read: capability
    diagnostic: capability
}

-- Graph-minted coordinates are identities: incarnation binds an exact row,
-- content binds equivalent observations, and meaning binds one semantic role.
same: bool = (subject: i64, other: i64)
    subject == other

renew: identity = (subject: identity, incarnation: i64)
    identity{
        meaning = subject.meaning
        content = subject.content
        incarnation = incarnation
    }

shape: bool = (subject: chain)
    subject.first.application.incarnation:same(subject.first.trace.lineage.application.incarnation)
        and subject.first.producer.incarnation:same(subject.first.trace.lineage.producer.incarnation)
        and subject.first.source.incarnation:same(subject.first.trace.lineage.source.incarnation)
        and subject.first.backend.incarnation:same(subject.first.trace.lineage.backend.incarnation)
        and subject.first.output.incarnation:same(subject.first.trace.lineage.output.incarnation)
        and subject.first.world.incarnation:same(subject.first.trace.world.incarnation)
        and subject.first.witness.incarnation:same(subject.first.trace.witness.incarnation)
        and subject.first.provenance.incarnation:same(subject.first.trace.provenance.incarnation)
        and subject.second.application.incarnation:same(subject.second.trace.lineage.application.incarnation)
        and subject.second.producer.incarnation:same(subject.second.trace.lineage.producer.incarnation)
        and subject.second.source.incarnation:same(subject.second.trace.lineage.source.incarnation)
        and subject.second.backend.incarnation:same(subject.second.trace.lineage.backend.incarnation)
        and subject.second.output.incarnation:same(subject.second.trace.lineage.output.incarnation)
        and subject.second.world.incarnation:same(subject.second.trace.world.incarnation)
        and subject.second.witness.incarnation:same(subject.second.trace.witness.incarnation)
        and subject.second.provenance.incarnation:same(subject.second.trace.provenance.incarnation)
        and subject.first.producer.incarnation:same(subject.seed.incarnation)
        and subject.second.producer.incarnation:same(subject.first.output.incarnation)
        and subject.first.source.content:same(subject.second.source.content)
        and subject.first.backend.content:same(subject.second.backend.content)
        and subject.first.world.content:same(subject.second.world.content)
        and subject.first.output.meaning:same(subject.second.output.meaning)
        and subject.first.application.incarnation != subject.second.application.incarnation
        and subject.first.output.incarnation != subject.second.output.incarnation
        and subject.first.trace.semantic.content:same(subject.second.trace.semantic.content)
        and subject.first.trace.behavior.content:same(subject.second.trace.behavior.content)
        and subject.first.trace.diagnostic.content:same(subject.second.trace.diagnostic.content)

known: identity = (subject: i64)
    identity{ meaning = subject, content = subject + 100, incarnation = subject + 200 }

main: i64 = ()
    seed = 1:known()
    source = 10:known()
    copy = source:renew(13)
    backend = 20:known()
    target = backend:renew(23)
    world = 30:known()
    realm = world:renew(33)
    alpha = 40:known()
    beta = 41:known()
    artifact = 50:known()
    product: identity = identity{
        meaning = artifact.meaning
        content = 151
        incarnation = 252
    }
    witness = 60:known()
    token = 61:known()
    origin = 70:known()
    history = 71:known()
    semantic = 80:known()
    sense = semantic:renew(83)
    behavior = 90:known()
    action = behavior:renew(93)
    diagnostic = 100:known()
    report = diagnostic:renew(103)
    left: lineage = lineage{
        application = alpha
        producer = seed
        source = source
        backend = backend
        output = artifact
    }
    right: lineage = lineage{
        application = beta
        producer = artifact
        source = copy
        backend = target
        output = product
    }
    x: trace = trace{
        witness = witness
        world = world
        provenance = origin
        lineage = left
        semantic = semantic
        behavior = behavior
        diagnostic = diagnostic
    }
    y: trace = trace{
        witness = token
        world = realm
        provenance = history
        lineage = right
        semantic = sense
        behavior = action
        diagnostic = report
    }
    first: stage = stage{
        application = alpha
        producer = seed
        source = source
        backend = backend
        world = world
        output = artifact
        witness = witness
        provenance = origin
        trace = x
    }
    second: stage = stage{
        application = beta
        producer = artifact
        source = copy
        backend = target
        world = realm
        output = product
        witness = token
        provenance = history
        trace = y
    }
    candidate: chain = chain{ seed = seed, first = first, second = second }

    call: stage = first
    call.trace.lineage.application = 210:known()
    misapplied: chain = chain{ seed = seed, first = call, second = second }

    maker: stage = first
    maker.trace.lineage.producer = 211:known()
    misproduced: chain = chain{ seed = seed, first = maker, second = second }

    input: stage = first
    input.trace.lineage.source = 212:known()
    missourced: chain = chain{ seed = seed, first = input, second = second }

    engine: stage = first
    engine.trace.lineage.backend = 213:known()
    mistargeted: chain = chain{ seed = seed, first = engine, second = second }

    result: stage = first
    result.trace.lineage.output = 214:known()
    misissued: chain = chain{ seed = seed, first = result, second = second }

    place: stage = first
    place.trace.world = 215:known()
    misplaced: chain = chain{ seed = seed, first = place, second = second }

    proof: stage = first
    proof.trace.witness = 216:known()
    miswitnessed: chain = chain{ seed = seed, first = proof, second = second }

    record: stage = first
    record.trace.provenance = 217:known()
    mistraced: chain = chain{ seed = seed, first = record, second = second }

    request: stage = second
    request.trace.lineage.application = 218:known()
    detached: chain = chain{ seed = seed, first = first, second = request }

    creator: stage = second
    creator.trace.lineage.producer = 219:known()
    unmade: chain = chain{ seed = seed, first = first, second = creator }

    material: stage = second
    material.trace.lineage.source = 220:known()
    unsourced: chain = chain{ seed = seed, first = first, second = material }

    compiler: stage = second
    compiler.trace.lineage.backend = 221:known()
    untargeted: chain = chain{ seed = seed, first = first, second = compiler }

    delivery: stage = second
    delivery.trace.lineage.output = 222:known()
    unissued: chain = chain{ seed = seed, first = first, second = delivery }

    domain: stage = second
    domain.trace.world = 223:known()
    unworlded: chain = chain{ seed = seed, first = first, second = domain }

    testimony: stage = second
    testimony.trace.witness = 224:known()
    unwitnessed: chain = chain{ seed = seed, first = first, second = testimony }

    recording: stage = second
    recording.trace.provenance = 225:known()
    unproven: chain = chain{ seed = seed, first = first, second = recording }

    fork: stage = second
    fork.source = 110:known()
    fork.trace.lineage.source = fork.source
    forked: chain = chain{ seed = seed, first = first, second = fork }

    orphan: stage = second
    orphan.producer = 120:known()
    orphan.trace.lineage.producer = orphan.producer
    orphaned: chain = chain{ seed = seed, first = first, second = orphan }

    foreign: stage = second
    foreign.backend = 130:known()
    foreign.trace.lineage.backend = foreign.backend
    targeted: chain = chain{ seed = seed, first = first, second = foreign }

    echo: stage = second
    echo.output = artifact
    echo.trace.lineage.output = echo.output
    echoed: chain = chain{ seed = seed, first = first, second = echo }

    replay: stage = second
    replay.application = alpha
    replay.trace.lineage.application = replay.application
    replayed: chain = chain{ seed = seed, first = first, second = replay }

    altered: stage = second
    altered.output = 140:known()
    altered.trace.lineage.output = altered.output
    changed: chain = chain{ seed = seed, first = first, second = altered }

    meaning: stage = second
    meaning.trace.semantic = 150:known()
    shifted: chain = chain{ seed = seed, first = first, second = meaning }

    motion: stage = second
    motion.trace.behavior = 160:known()
    moved: chain = chain{ seed = seed, first = first, second = motion }

    notice: stage = second
    notice.trace.diagnostic = 170:known()
    reported: chain = chain{ seed = seed, first = first, second = notice }

    elsewhere: stage = second
    elsewhere.world = 200:known()
    elsewhere.trace.world = elsewhere.world
    displaced: chain = chain{ seed = seed, first = first, second = elsewhere }

    code = 0
    if not candidate:shape()
        code = 1
    if forked:shape()
        code = 2
    if orphaned:shape()
        code = 3
    if targeted:shape()
        code = 4
    if echoed:shape()
        code = 5
    if replayed:shape()
        code = 6
    if changed:shape()
        code = 7
    if shifted:shape()
        code = 8
    if moved:shape()
        code = 9
    if reported:shape()
        code = 10
    if displaced:shape()
        code = 11
    if misapplied:shape()
        code = 12
    if misproduced:shape()
        code = 13
    if missourced:shape()
        code = 14
    if mistargeted:shape()
        code = 15
    if misissued:shape()
        code = 16
    if misplaced:shape()
        code = 17
    if miswitnessed:shape()
        code = 18
    if mistraced:shape()
        code = 19
    if detached:shape()
        code = 20
    if unmade:shape()
        code = 21
    if unsourced:shape()
        code = 22
    if untargeted:shape()
        code = 23
    if unissued:shape()
        code = 24
    if unworlded:shape()
        code = 25
    if unwitnessed:shape()
        code = 26
    if unproven:shape()
        code = 27
    if code == 0
        print("bootstrap lineage shape accepted; evidence unauthenticated; compiler B and C unobserved")
    code
