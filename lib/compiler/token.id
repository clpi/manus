# std.compiler.token
# Token descriptors for the Duo-native lexer


loc: {
    file: str,
    line: i64,
    col: i64
}

KIND_NAME = 0
KIND_INT_LIT = 1
KIND_FLOAT_LIT = 2
# Slot 3 is unpublished. Not an identity. Do not renumber 4–113.

# Keywords from classify.id
KIND_AND = 4
KIND_BREAK = 5
KIND_CONTINUE = 6
KIND_DO = 7
KIND_ELSE = 8
KIND_ELSEIF = 9
KIND_END = 10
KIND_FALSE = 11
KIND_FOR = 12
KIND_FUNCTION = 13
KIND_FUN = 14
KIND_GLOBAL = 15
KIND_GOTO = 16
KIND_IF = 17
KIND_IN = 18
KIND_LOCAL = 19
KIND_NIL = 20
KIND_NOT = 21
KIND_OR = 22
KIND_REPEAT = 23
KIND_RETURN = 24
KIND_THEN = 25
KIND_TRUE = 26
KIND_UNTIL = 27
KIND_WHILE = 28
KIND_CONST = 29
KIND_ENUM = 30
KIND_I8 = 31
KIND_I16 = 32
KIND_I32 = 33
KIND_I64 = 34
KIND_U8 = 35
KIND_U16 = 36
KIND_U32 = 37
KIND_U64 = 38
KIND_F32 = 39
KIND_F64 = 40
KIND_BOOL = 41
KIND_VOID = 42
KIND_STR = 43
KIND_MATCH = 44
KIND_TRY = 45
KIND_CATCH = 46
KIND_DEFER = 47
KIND_ASYNC = 48
KIND_AWAIT = 49
KIND_CONCEPT = 50
KIND_ALIAS = 51
KIND_PRIVATE = 52
KIND_EXTENDS = 53
KIND_MACRO = 54
KIND_COMPTIME = 55
KIND_BY = 56
KIND_LET = 57

# Single-char punctuation
KIND_LPAREN = 58
KIND_RPAREN = 59
KIND_LBRACKET = 60
KIND_RBRACKET = 61
KIND_LBRACE = 62
KIND_RBRACE = 63
KIND_PLUS = 64
KIND_MINUS = 65
KIND_STAR = 66
KIND_SLASH = 67
KIND_PERCENT = 68
KIND_CARET = 69
KIND_HASH = 70
KIND_AMP = 71
KIND_PIPE = 72
KIND_LT = 73
KIND_GT = 74
KIND_ASSIGN = 75
KIND_TILDE = 76
KIND_SEMI = 77
KIND_COLON = 78
KIND_COMMA = 79
KIND_DOT = 80
KIND_AT = 81
KIND_QUESTION = 82
KIND_BANG = 83
KIND_BACKTICK = 84

# Multi-char operators
KIND_CONCAT = 85
KIND_DOTS = 86
KIND_HASH_HASH = 87
KIND_EQ = 88
KIND_NEQ = 89
KIND_LEQ = 90
KIND_GEQ = 91
KIND_LSHIFT = 92
KIND_RSHIFT = 93
KIND_IDIV = 94
KIND_DCOLON = 95
KIND_ARROW = 96
KIND_PIPE_GT = 97
KIND_FAT_ARROW = 98
KIND_PLUS_ASSIGN = 99
KIND_MINUS_ASSIGN = 100
KIND_STAR_ASSIGN = 101
KIND_SLASH_ASSIGN = 102
KIND_PERCENT_ASSIGN = 103
KIND_CARET_ASSIGN = 104
KIND_TEXT_LIT = 105
KIND_BYTES_LIT = 106
KIND_COMPAT_TEXT_LIT = 107
KIND_COMPAT_LONG_TEXT_LIT = 108
KIND_EOF = 109
KIND_SHEBANG = 110
KIND_COMMENT = 111
KIND_COMPAT_COMMENT = 112
KIND_COMPAT_LONG_COMMENT = 113

token: {
    kind: i64,
    loc: loc,
    text: str,
    int_val: i64,
    float_val: f64
}

is_type_keyword(kind: i64): bool
    (kind >= KIND_I8 and kind <= KIND_STR)
end
