kindwhile = 28
kindconst = 29
kindenum = 30
kindi8 = 31
kindi16 = 32
kindi32 = 33
kindi64 = 34
kindu8 = 35
kindu16 = 36
kindu32 = 37
kindu64 = 38
kindf32 = 39
kindf64 = 40
