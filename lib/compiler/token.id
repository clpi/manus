
loc: { file: str, line: i64, col: i64 }

kindname = 0
kindintlit = 1
kindfloatlit = 2

kindand = 4
kindbreak = 5
kindcontinue = 6
kinddo = 7
kindelse = 8
kindelseif = 9
kindend = 10
kindfalse = 11
kindfor = 12
kindfunction = 13
kindfun = 14
kindglobal = 15
kindgoto = 16
kindif = 17
kindin = 18
kindlocal = 19
