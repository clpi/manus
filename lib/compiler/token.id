kindawait = 49
kindconcept = 50
kindalias = 51
kindprivate = 52
kindextends = 53
kindmacro = 54
kindcomptime = 55
kindby = 56
kindlet = 57

kindlparen = 58
kindrparen = 59
kindlbracket = 60
kindrbracket = 61
kindlbrace = 62
kindrbrace = 63
kindplus = 64
kindminus = 65
kindstar = 66
kindslash = 67
kindpercent = 68
kindcaret = 69
