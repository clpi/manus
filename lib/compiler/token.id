kindbacktick = 84

kindconcat = 85
kinddots = 86
kindhashhash = 87
kindeq = 88
kindneq = 89
kindleq = 90
kindgeq = 91
kindlshift = 92
kindrshift = 93
kindidiv = 94
kinddcolon = 95
kindarrow = 96
