# compiler.token
# Token descriptors for the Duo-native lexer

loc: { file: str, line: i64, col: i64 }

kindname = 0
kindintlit = 1
kindfloatlit = 2
# Slot 3 is unpublished. Not an identity. Do not renumber 4–113.

# Keywords from classify.id
kindand = 4
kindbreak = 5
kindcontinue = 6
kinddo = 7
kindelse = 8
kindelseif = 9
kindend = 10
kindfalse = 11
kindfor = 12
kindfunction = 13
kindfun = 14
kindglobal = 15
kindgoto = 16
kindif = 17
kindin = 18
kindlocal = 19
kindnil = 20
kindnot = 21
kindor = 22
kindrepeat = 23
kindreturn = 24
kindthen = 25
kindtrue = 26
kinduntil = 27
kindwhile = 28
kindconst = 29
kindenum = 30
kindi8 = 31
kindi16 = 32
kindi32 = 33
kindi64 = 34
kindu8 = 35
kindu16 = 36
kindu32 = 37
kindu64 = 38
kindf32 = 39
kindf64 = 40
kindbool = 41
kindvoid = 42
kindstr = 43
kindmatch = 44
kindtry = 45
kindcatch = 46
kinddefer = 47
kindasync = 48
kindawait = 49
kindconcept = 50
kindalias = 51
kindprivate = 52
kindextends = 53
kindmacro = 54
kindcomptime = 55
kindby = 56
kindlet = 57

# Single-char punctuation
kindlparen = 58
kindrparen = 59
kindlbracket = 60
kindrbracket = 61
kindlbrace = 62
kindrbrace = 63
kindplus = 64
kindminus = 65
kindstar = 66
kindslash = 67
kindpercent = 68
kindcaret = 69
kindhash = 70
kindamp = 71
kindpipe = 72
kindlt = 73
kindgt = 74
kindassign = 75
kindtilde = 76
kindsemi = 77
kindcolon = 78
kindcomma = 79
kinddot = 80
kindat = 81
kindquestion = 82
kindbang = 83
kindbacktick = 84

# Multi-char operators
kindconcat = 85
kinddots = 86
kindhashhash = 87
kindeq = 88
kindneq = 89
kindleq = 90
kindgeq = 91
kindlshift = 92
kindrshift = 93
kindidiv = 94
kinddcolon = 95
kindarrow = 96
kindpipegt = 97
kindfatarrow = 98
kindplusassign = 99
kindminusassign = 100
kindstarassign = 101
kindslashassign = 102
kindpercentassign = 103
kindcaretassign = 104
kindtextlit = 105
kindbyteslit = 106
kindcompattextlit = 107
kindcompatlongtextlit = 108
kindeof = 109
kindshebang = 110
kindcomment = 111
kindcompatcomment = 112
kindcompatlongcomment = 113

token: { kind: i64, loc: loc, text: str, int_val: i64, float_val: f64 }

# ---------------------------------------------------------------------------
# GRAMMAR-ROLE FACTS — the one executable owner (GAP-134, law.grammar.one).
# Keyed by producer slot identity, never by spelling.
# ---------------------------------------------------------------------------

# may this identity open an expression
rolebeginexpr: bool = (kind: i64)
  if (kind >= kindname and kind <= kindfloatlit) or kind == kindfalse or kind == kindnil
    return true
  if kind == kindnot or kind == kindtrue or kind == kindawait
    return true
  if kind == kindcomptime or kind == kindlparen or kind == kindlbrace
    return true
  if kind == kindminus or kind == kindhash or kind == kindtilde
    return true
  if kind == kindat or kind == kindbang or kind == kinddots
    return true
  if kind == kindhashhash or kind == kindpipe or kind == kinddot
    return true
  if kind == kindcolon or kind == kindif or kind == kindmatch
    return true
  if kind == kindfunction or kind == kindfun or roledescriptor(kind)
    return true
  if (kind >= kindtextlit and kind <= kindcompatlongtextlit)
    return true
  false

# prefix (unary) position
roleprefix: bool = (kind: i64)
  if kind == kindnot or kind == kindawait or kind == kindcomptime
    return true
  if kind == kindlparen or kind == kindminus or kind == kindhash
    return true
  if kind == kindtilde or kind == kindbang or kind == kindhashhash
    return true
  false

# postfix position
rolepostfix: bool = (kind: i64)
  if kind == kinddot
    return true
  false

# parameter-slot marker
roleparameter: bool = (kind: i64)
  if kind == kindcolon
    return true
  false

# literal payload identity
roleliteral: bool = (kind: i64)
  if kind == kindintlit or kind == kindfloatlit or (kind >= kindtextlit and kind <= kindcompatlongtextlit)
    return true
  false

# quoted payload identity (text / bytes / compat)
rolequoted: bool = (kind: i64)
  if (kind >= kindtextlit and kind <= kindcompatlongtextlit)
    return true
  false

# projection face (dot / bracket / colon)
roleprojection: bool = (kind: i64)
  if kind == kindlbracket or kind == kindcolon or kind == kinddot
    return true
  false

# may this identity open a callable body
rolebodystart: bool = (kind: i64)
  if (kind >= kindname and kind <= kindfloatlit) or (kind >= kindbreak and kind <= kinddo) or (kind >= kindfalse and kind <= kindfun)
    return true
  if kind == kindif or kind == kindnil or kind == kindnot
    return true
  if kind == kindreturn or kind == kindtrue or kind == kindwhile
    return true
  if kind == kindmatch or kind == kindlparen or kind == kindlbrace
    return true
  if kind == kindminus or kind == kindhash or kind == kindpipe
    return true
  if kind == kindat or (kind >= kindtextlit and kind <= kindcompatlongtextlit)
    return true
  false

# primitive descriptor identity
roledescriptor: bool = (kind: i64)
  if (kind >= kindi8 and kind <= kindstr)
    return true
  false

# match-pattern start
rolepattern: bool = (kind: i64)
  if (kind >= kindname and kind <= kindfloatlit) or kind == kindfalse or kind == kindnil
    return true
  if kind == kindtrue or kind == kindlbracket or kind == kindlbrace
    return true
  if kind == kindminus or kind == kinddots or (kind >= kindtextlit and kind <= kindcompatlongtextlit)
    return true
  false

# canonical tooling may not WRITE this spelling
rolecompatonly: bool = (kind: i64)
  if kind == kindand or kind == kinddo or (kind >= kindelseif and kind <= kindfalse)
    return true
  if kind == kindfunction or kind == kindfun or kind == kindlocal
    return true
  if kind == kindnil or kind == kindor or kind == kindthen
    return true
  if kind == kindtrue or kind == kindconst or kind == kindlet
    return true
  if kind == kindhash or kind == kindbacktick or kind == kindconcat
    return true
  if kind == kindhashhash or kind == kindcompattextlit or kind == kindcompatlongtextlit
    return true
  if kind == kindcompatcomment or kind == kindcompatlongcomment
    return true
  false

# ---------------------------------------------------------------------------
# RELATION IDENTITY — one operation ontology, several source faces.
#
# `a + b`, `a += b` and the adjacency-glued `a >>= b` are THREE SOURCE FACES
# of ONE relation. They therefore read ONE fact: `_relationname`. A face is a
# separate fact (`_roleinfix` / `_roleupdate` / `_roleglue`) because it says WHERE
# the relation is applied, never WHICH relation it is. "." means this identity
# denotes no relation; it is not a relation spelled ".".
# ---------------------------------------------------------------------------

# The relation ontology itself, in one order. The host enum generated from
# this row IS the physical encoding of these identities; the AST layer only
# aliases it, because relation identity is not the tree's to own
# (gate/layers.manifest). A name here that no slot claims fails the
# bijection control in src/grammar_roles.zig.
_relationorder = "add sub mul div idiv mod pow band bor bxor lshift rshift concat eq neq lt gt leq geq and or contains matmul pipeline "

# The prefix relations, same ownership.
_prefixorder = "neg not len bnot compile "

_relationname: str = (kind: i64)
  if kind == kindplus or kind == kindplusassign
    return "add"
  if kind == kindminus or kind == kindminusassign
    return "sub"
  if kind == kindstar or kind == kindstarassign
    return "mul"
  if kind == kindslash or kind == kindslashassign
    return "div"
  if kind == kindpercent or kind == kindpercentassign
    return "mod"
  if kind == kindcaret or kind == kindcaretassign
    return "pow"
  if kind == kindidiv
    return "idiv"
  if kind == kindamp
    return "band"
  if kind == kindpipe
    return "bor"
  if kind == kindtilde
    return "bxor"
  if kind == kindlshift
    return "lshift"
  if kind == kindrshift
    return "rshift"
  if kind == kindconcat
    return "concat"
  if kind == kindeq
    return "eq"
  if kind == kindneq
    return "neq"
  if kind == kindlt
    return "lt"
  if kind == kindgt
    return "gt"
  if kind == kindleq
    return "leq"
  if kind == kindgeq
    return "geq"
  if kind == kindand
    return "and"
  if kind == kindor
    return "or"
  if kind == kindin
    return "contains"
  if kind == kindat
    return "matmul"
  if kind == kindpipegt
    return "pipeline"
  "."

# Prefix relation of this identity. `-` and `~` carry BOTH a prefix and an
# infix relation, which is why the two are separate facts and not one map.
_unaryname: str = (kind: i64)
  if kind == kindnot or kind == kindbang
    return "not"
  if kind == kindhash
    return "len"
  if kind == kindhashhash or kind == kindcomptime
    return "compile"
  if kind == kindminus
    return "neg"
  if kind == kindtilde
    return "bnot"
  "."

# infix face: this identity applies its relation between two operands
_roleinfix: bool = (kind: i64)
  if kind == kindor or kind == kindand or kind == kindin
    return true
  if kind == kindlt or kind == kindgt or (kind >= kindeq and kind <= kindgeq)
    return true
  if kind == kindpipe or kind == kindtilde or kind == kindamp
    return true
  if kind == kindlshift or kind == kindrshift or kind == kindconcat
    return true
  if (kind >= kindplus and kind <= kindcaret) or kind == kindidiv
    return true
  if kind == kindat or kind == kindpipegt
    return true
  false

# compound-update face carried by ONE identity (`+=`)
_roleupdate: bool = (kind: i64)
  if kind >= kindplusassign and kind <= kindcaretassign
    return true
  false

# compound-update face formed by an ADJACENT `=` (`>>=` is `>>` then `=`).
# The lexer mints no token for these, so the face is a grammar fact.
_roleglue: bool = (kind: i64)
  if kind == kindrshift or kind == kindlshift or kind == kindpipe
    return true
  if kind == kindamp or kind == kindtilde
    return true
  false

# CANNOT END AN EXPRESSION, so whatever follows is an operand.
#
# The dual of `rolebeginexpr`, and the other half of one ruling: that fact
# says what an identity can BEGIN, this one says what it cannot END, and
# between them they decide where an expression stops. Not derivable from the
# infix and prefix faces — `(`, `[`, `,`, `:`, `->`, `=>`, `if`, `while`,
# `until`, `return` and `by` demand an operand without applying a relation.
# ONE CHARACTER PER PRODUCER SLOT, "1" where the identity demands an operand.
# A ZERO-PARAMETER relation because that is the only new module-scope
# declaration form that is lawful in both directions today: a parameterised
# one is refused by `gate/vocabulary.sh`, and the underscore-private name it
# offers instead is refused by `gate/idiom.id` under LAW-ONE. Restore the
# parameter when GAP-224 lifts the freeze.
demand(): str
  out = ""
  kind = 0
  while kind < roleslotcount
    bit = "0"
    if kind >= kindplus and kind <= kindtilde
      bit = "1"
    if kind >= kindcolon and kind <= kindat
      bit = "1"
    if kind >= kindhashhash and kind <= kindidiv
      bit = "1"
    if kind >= kindarrow and kind <= kindcaretassign
      bit = "1"
    if kind == kindlparen or kind == kindlbracket or kind == kindbang
      bit = "1"
    if kind == kindconcat or kind == kindand or kind == kindelseif
      bit = "1"
    if kind == kindif or kind == kindin or kind == kindnot
      bit = "1"
    if kind == kindor or kind == kindreturn or kind == kinduntil
      bit = "1"
    if kind == kindwhile or kind == kindby
      bit = "1"
    out = "{out}{bit}"
    kind += 1
  out

# A LINE-LEADING occurrence of this identity opens an expression instead of
# continuing the one above. Only an identity with both an infix and a
# line-leading reading is ambiguous at the head of a line; a line-leading `*`
# can only be a continuation. `-` and `~` carry a prefix relation, `@` carries
# the attribute face, and all three are infix.
# Same row shape, same reason for the shape.
lead(): str
  out = ""
  kind = 0
  while kind < roleslotcount
    bit = "0"
    if kind == kindminus or kind == kindtilde or kind == kindat
      bit = "1"
    out = "{out}{bit}"
    kind += 1
  out

# Pratt binding power
roleprecedence: i64 = (kind: i64)
  if kind == kindcaret
    return 23
  if (kind >= kindstar and kind <= kindpercent) or kind == kindat or kind == kindidiv
    return 19
  if kind == kindplus or kind == kindminus
    return 17
  if kind == kindconcat
    return 16
  if kind == kindlshift or kind == kindrshift
    return 13
  if kind == kindamp
    return 11
  if kind == kinddot
    return 10
  if kind == kindnot or kind == kindtilde or kind == kindbang
    return 9
  if kind == kindpipe
    return 7
  if kind == kindin or kind == kindlt or kind == kindgt
    return 6
  if (kind >= kindeq and kind <= kindgeq)
    return 6
  if kind == kindand
    return 4
  if kind == kindor
    return 2
  if kind == kindassign or kind == kindpipegt or (kind >= kindplusassign and kind <= kindcaretassign)
    return 1
  0

# associativity: 0 none, 1 left, 2 right, 3 nonassoc
roleassoc: i64 = (kind: i64)
  if kind == kindin or kind == kindlt or kind == kindgt
    return 3
  if (kind >= kindeq and kind <= kindgeq)
    return 3
  if kind == kindcaret or kind == kindassign or kind == kindconcat
    return 2
  if (kind >= kindplusassign and kind <= kindcaretassign)
    return 2
  if kind == kindand or kind == kindor or (kind >= kindplus and kind <= kindpercent)
    return 1
  if kind == kindamp or kind == kindpipe or kind == kindtilde
    return 1
  if kind == kindat or (kind >= kindlshift and kind <= kindidiv) or kind == kindpipegt
    return 1
  0

# Host bridge spelling per physical producer slot. Provenance only:
# recognition keys on the ordinal, never on this text. "." is the
# unpublished slot that must never acquire a role.
kindzig = "name int_lit float_lit . kw_and kw_break kw_continue kw_do kw_else kw_elseif kw_end kw_false kw_for kw_function kw_fun kw_global kw_goto kw_if kw_in kw_local kw_nil kw_not kw_or kw_repeat kw_return kw_then kw_true kw_until kw_while kw_const kw_enum kw_i8 kw_i16 kw_i32 kw_i64 kw_u8 kw_u16 kw_u32 kw_u64 kw_f32 kw_f64 kw_bool kw_void kw_str kw_match kw_try kw_catch kw_defer kw_async kw_await kw_concept kw_alias kw_private kw_extends kw_macro kw_comptime kw_by kw_let lparen rparen lbracket rbracket lbrace rbrace plus minus star slash percent caret hash amp pipe lt gt assign tilde semi colon comma dot at question bang backtick concat dots hash_hash eq neq leq geq lshift rshift idiv dcolon arrow pipe_gt fat_arrow plus_assign minus_assign star_assign slash_assign percent_assign caret_assign text_lit bytes_lit compat_text_lit compat_long_text_lit eof shebang comment compat_comment compat_long_comment "

# ---------------------------------------------------------------------------
# GENERATED PROJECTIONS (GAP-134 bridge, law.bridge.death).
#
# The facts above are the ONE executable grammar-role owner. Everything below
# only writes them out. `src/grammar_role_table.zig` is the host bridge the
# production parser reads; `lib/token/grammarrole.id` is the Idol projection.
# Delete this section when the host consumes the owner without a Zig table.
#
#   idol run lib/compiler/token.id
# ---------------------------------------------------------------------------

roleslotcount = 114
roleidentitycount = 113

assocname: str = (kind: i64)
  a = roleassoc(kind)
  if a == 1
    return "left"
  if a == 2
    return "right"
  if a == 3
    return "nonassoc"
  "none"

# The nth space-separated _word of a row. One splitter for every ordered row
# in this file: slot spellings, relation order, prefix order.
_word: str = (row: str, n: i64)
  size = row:len()
  i = 1
  seen = 0
  start = 1
  out = ""
  while i <= size
    if row:byte(i) == 32
      if seen == n
        out = row:sub(start, i - 1)
      seen += 1
      start = i + 1
    i += 1
  out

# Host bridge spelling for one physical slot. Provenance, never recognition.
_zigname: str = (kind: i64)
  _word(kindzig, kind)

# How many words an ordered row carries.
_wordcount: i64 = (row: str)
  size = row:len()
  i = 1
  seen = 0
  while i <= size
    if row:byte(i) == 32
      seen += 1
    i += 1
  seen

# One generated host enum over an ordered relation row.
_zigenum: str = (name: str, row: str)
  s = "pub const {name} = enum \{\n"
  n = _wordcount(row)
  k = 0
  while k < n
    s = "{s}    {_zigescape(_word(row, k))},\n"
    k += 1
  "{s}\};\n\n"

# Host-bridge spelling of one relation identity. Two relation names collide
# with a host keyword and take the escaped face there; the identity is the
# same either way, and the escape is provenance, not a second name.
_zigescape: str = (name: str)
  if name == "and" or name == "or"
    return "@\"{name}\""
  name

zigrow: str = (kind: i64)
  z = _zigname(kind)
  if z == "."
    return "    .\{ .kind = null \},\n"
  # Source spelling per physical producer slot — the grammar fact
  # `src/lexer.zig` `spelling()` used to own in a 60-arm switch with a fallback
  # into `src/token_semantic.zig`. Two producers answered "how is this identity
  # written"; this is the one that stays (`law.fact.producer.one`). Recognition
  # still keys on the ordinal: this row is what a diagnostic PRINTS and what a
  # projection consumer MATCHES, never what the lexer decides from.
  #
  # Slot 3 is the unpublished producer slot and its field is EMPTY (two spaces
  # after `float`), not `.` — `.` is the real spelling of `dot` at slot 80, and
  # a sentinel that collides with a live spelling is how a spelling-keyed
  # consumer silently resolves to the wrong identity.
  #
  # THE ROW AND ITS READER LIVE IN THIS BODY, and the field scan below repeats
  # `zigname`'s. That duplication is deliberate and measured: `gate/vocabulary.sh`
  # refuses every new module-scope declaration in `.id` outright, and the only
  # alternatives it names are underscore-private names — which `gate/idiom.id`
  # `under()` forbids in `.id` source — nested bindings, and body-only changes.
  # A shared `pick(row, kind)` is a new module-scope relation and cannot be
  # committed; a nested binding can. Fold the two scans together when the
  # vocabulary freeze lifts.
  row = "name integer float  and break continue do else elseif end false for function fun global goto if in local nil not or repeat return then true until while const enum i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 bool void str match try catch defer async await concept alias private extends macro comptime by let ( ) [ ] \{ \} + - * / % ^ # & | < > = ~ ; : , . @ ? ! ` .. ... ## == != <= >= << >> // :: -> |> => += -= *= /= %= ^= text bytes compat_text compat_long_text <eof> #! # -- --[[ "
  n = row:len()
  i = 1
  seen = 0
  start = 1
  spell = ""
  while i <= n
    if row:byte(i) == 32
      if seen == kind
        spell = row:sub(start, i - 1)
      seen += 1
      start = i + 1
    i += 1
  s = "    .\{ .kind = .{z}, .spell = \"{spell}\""
  if rolebeginexpr(kind)
    s = "{s}, .begin_expr = true"
  if roleprefix(kind)
    s = "{s}, .prefix = true"
  if rolepostfix(kind)
    s = "{s}, .postfix = true"
  if roleparameter(kind)
    s = "{s}, .parameter = true"
  if roleliteral(kind)
    s = "{s}, .literal_kind = true"
  if roleprojection(kind)
    s = "{s}, .projection = true"
  if rolebodystart(kind)
    s = "{s}, .body_start = true"
  if rolequoted(kind)
    s = "{s}, .quoted = true"
  if roledescriptor(kind)
    s = "{s}, .descriptor = true"
  if rolepattern(kind)
    s = "{s}, .pattern = true"
  if roleprecedence(kind) != 0
    s = "{s}, .precedence = {roleprecedence(kind)}"
  if roleassoc(kind) != 0
    s = "{s}, .assoc = .{assocname(kind)}"
  if rolecompatonly(kind)
    s = "{s}, .compat_only = true"
  r = _relationname(kind)
  if r != "."
    s = "{s}, .relation = .{_zigescape(r)}"
  u = _unaryname(kind)
  if u != "."
    s = "{s}, .unary = .{_zigescape(u)}"
  if _roleinfix(kind)
    s = "{s}, .infix = true"
  if _roleupdate(kind)
    s = "{s}, .update = true"
  if _roleglue(kind)
    s = "{s}, .glue = true"
  if demand():sub(kind + 1, kind + 1) == "1"
    s = "{s}, .demands_operand = true"
  if lead():sub(kind + 1, kind + 1) == "1"
    s = "{s}, .opens_line = true"
  "{s} \},\n"

zigbody: str = ()
  # A module constant reaches interpolation only through a local
  # binding: `"{roleslotcount}"` refuses DNB001 concat, `n = …` then
  # `"{n}"` does not. Bootstrap subset limit, not a grammar fact.
  slots = roleslotcount
  ids = roleidentitycount
  eof = kindeof
  s = "// GENERATED from lib/compiler/token.id — do not edit by hand.\n"
  s = "{s}// Regenerate: idol run lib/compiler/token.id\n"
  s = "{s}// One executable grammar-fact owner (law.grammar.one). This table is\n"
  s = "{s}// a bridge (law.bridge.death), not an authority: change a role in the\n"
  s = "{s}// Idol owner and regenerate. Editing this file by hand is a second\n"
  s = "{s}// producer of one grammar fact.\n"
  s = "{s}const lexer = @import(\"lexer.zig\");\n\n"
  s = "{s}// Relation identity lives in the TOKEN layer. src/ast.zig ALIASES these\n"
  s = "{s}// two enums; it does not restate them. gate/layers.manifest: the AST\n"
  s = "{s}// layer owns shape and no semantic relation identity.\n"
  s = "{s}{_zigenum(\"Relation\", _relationorder)}"
  s = "{s}{_zigenum(\"Prefix\", _prefixorder)}"
  s = "{s}pub const Associativity = enum(u8) \{\n"
  s = "{s}    none = 0,\n    left = 1,\n    right = 2,\n    nonassoc = 3,\n\};\n\n"
  s = "{s}pub const RoleRow = struct \{\n"
  s = "{s}    kind: ?lexer.TokenKind = null,\n"
  s = "{s}    spell: []const u8 = \"\",\n"
  s = "{s}    begin_expr: bool = false,\n"
  s = "{s}    prefix: bool = false,\n"
  s = "{s}    postfix: bool = false,\n"
  s = "{s}    parameter: bool = false,\n"
  s = "{s}    literal_kind: bool = false,\n"
  s = "{s}    projection: bool = false,\n"
  s = "{s}    body_start: bool = false,\n"
  s = "{s}    quoted: bool = false,\n"
  s = "{s}    descriptor: bool = false,\n"
  s = "{s}    pattern: bool = false,\n"
  s = "{s}    precedence: i8 = 0,\n"
  s = "{s}    assoc: Associativity = .none,\n"
  s = "{s}    compat_only: bool = false,\n"
  s = "{s}    relation: ?Relation = null,\n"
  s = "{s}    unary: ?Prefix = null,\n"
  s = "{s}    infix: bool = false,\n"
  s = "{s}    update: bool = false,\n"
  s = "{s}    glue: bool = false,\n"
  s = "{s}    demands_operand: bool = false,\n"
  s = "{s}    opens_line: bool = false,\n"
  s = "{s}\};\n\n"
  s = "{s}pub const slot_count: usize = {slots};\n"
  s = "{s}pub const identity_count: usize = {ids};\n"
  s = "{s}pub const kind_eof: usize = {eof};\n\n"
  s = "{s}pub const rows = [slot_count]RoleRow\{\n"
  k = 0
  while k < roleslotcount
    s = "{s}{zigrow(k)}"
    k += 1
  "{s}\};\n"

rolebit: i64 = (which: i64, kind: i64)
  if which == 0 and rolebeginexpr(kind)
    return 1
  if which == 1 and roleprefix(kind)
    return 1
  if which == 2 and rolepostfix(kind)
    return 1
  if which == 3 and roleparameter(kind)
    return 1
  if which == 4 and roleliteral(kind)
    return 1
  if which == 5 and rolequoted(kind)
    return 1
  if which == 6 and roleprojection(kind)
    return 1
  if which == 7 and rolebodystart(kind)
    return 1
  if which == 8 and roledescriptor(kind)
    return 1
  if which == 9 and rolepattern(kind)
    return 1
  if which == 10 and rolecompatonly(kind)
    return 1
  if which == 11
    return roleprecedence(kind)
  if which == 12
    return roleassoc(kind)
  if which == 13 and _roleinfix(kind)
    return 1
  if which == 14 and _roleupdate(kind)
    return 1
  if which == 15 and _roleglue(kind)
    return 1
  0

# Relation identities as one space-separated slot row. "." is "no relation",
# the same unpublished face `kindzig` uses; recognition keys on the ordinal.
_nametext: str = (name: str, which: i64)
  s = "{name} = \""
  k = 0
  while k < roleslotcount
    if which == 0
      s = "{s}{_relationname(k)} "
    else
      s = "{s}{_unaryname(k)} "
    k += 1
  "{s}\"\n"

tabletext: str = (name: str, which: i64)
  s = "{name} = \{\n"
  k = 0
  while k < roleslotcount
    s = "{s}  {rolebit(which, k)},\n"
    k += 1
  "{s}\}\n"

idbody: str = ()
  slots = roleslotcount
  ids = roleidentitycount
  eof = kindeof
  s = "# GENERATED from lib/compiler/token.id — do not edit by hand.\n"
  s = "{s}# Regenerate: idol run lib/compiler/token.id\n"
  s = "{s}# Grammar-role projection of the one Idol grammar-fact owner.\n\n"
  s = "{s}roleidentitycount = {ids}\n"
  s = "{s}rolecount = {slots}\n"
  s = "{s}kindeof = {eof}\n"
  s = "{s}{tabletext(\"beginexpr\", 0)}"
  s = "{s}{tabletext(\"prefix\", 1)}"
  s = "{s}{tabletext(\"postfix\", 2)}"
  s = "{s}{tabletext(\"parameter\", 3)}"
  s = "{s}{tabletext(\"literalkind\", 4)}"
  s = "{s}{tabletext(\"quoted\", 5)}"
  s = "{s}{tabletext(\"projection\", 6)}"
  s = "{s}{tabletext(\"bodystart\", 7)}"
  s = "{s}{tabletext(\"descriptor\", 8)}"
  s = "{s}{tabletext(\"pattern\", 9)}"
  s = "{s}{tabletext(\"compatonly\", 10)}"
  s = "{s}{tabletext(\"precedence\", 11)}"
  s = "{s}{tabletext(\"assoc\", 12)}"
  s = "{s}{tabletext(\"_infix\", 13)}"
  s = "{s}{tabletext(\"_update\", 14)}"
  s = "{s}{tabletext(\"_glue\", 15)}"
  s = "{s}{_nametext(\"_relationtext\", 0)}"
  s = "{s}{_nametext(\"_unarytext\", 1)}"
  s = "{s}\nrolebeginexpr: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and beginexpr[kind + 1] > 0\n"
  s = "{s}\nroleprefix: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and prefix[kind + 1] > 0\n"
  s = "{s}\nrolepostfix: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and postfix[kind + 1] > 0\n"
  s = "{s}\nroleparameter: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and parameter[kind + 1] > 0\n"
  s = "{s}\nroleliteral: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and literalkind[kind + 1] > 0\n"
  s = "{s}\nrolequoted: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and quoted[kind + 1] > 0\n"
  s = "{s}\nrolebodystart: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and bodystart[kind + 1] > 0\n"
  s = "{s}\nroledescriptor: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and descriptor[kind + 1] > 0\n"
  s = "{s}\nrolepattern: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and pattern[kind + 1] > 0\n"
  s = "{s}\nrolecompatonly: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and compatonly[kind + 1] > 0\n"
  s = "{s}\nroleprecedence: i64 = (kind: i64)\n  if kind < 0 or kind >= rolecount\n    0\n  else\n    precedence[kind + 1]\n"
  s = "{s}\nroleassoc: i64 = (kind: i64)\n  if kind < 0 or kind >= rolecount\n    0\n  else\n    assoc[kind + 1]\n"
  s = "{s}\n_roleinfix: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and _infix[kind + 1] > 0\n"
  s = "{s}\n_roleupdate: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and _update[kind + 1] > 0\n"
  s = "{s}\n_roleglue: bool = (kind: i64)\n  kind >= 0 and kind < rolecount and _glue[kind + 1] > 0\n"
  # These two carry the SAME zero-parameter row shape they have in the owner,
  # for the same reason: a generated column-1 table plus a parameterised
  # accessor is a new module-scope declaration and the freeze admits none.
  s = "{s}\ndemand(): str\n  \"{demand()}\"\n"
  s = "{s}\nlead(): str\n  \"{lead()}\"\n"
  s = "{s}\n_slotword: str = (row: str, kind: i64)\n"
  s = "{s}  n = row:len()\n  i = 1\n  seen = 0\n  start = 1\n  out = \".\"\n"
  s = "{s}  while i <= n\n    if row:byte(i) == 32\n      if seen == kind\n        out = row:sub(start, i - 1)\n"
  s = "{s}      seen += 1\n      start = i + 1\n    i += 1\n  out\n"
  s = "{s}\n_rolerelation: str = (kind: i64)\n  _slotword(_relationtext, kind)\n"
  s = "{s}\n_roleunary: str = (kind: i64)\n  _slotword(_unarytext, kind)\n"
  s

spill: bool = (path: str, body: str)
  f = io.open(path, "w")
  if !f
    return false
  f:write(body)
  f:close()
  true

_project: i64 = ()
  zigout = "src/grammar_role_table.zig"
  idout = "lib/token/grammarrole.id"
  if !spill(zigout, zigbody())
    print("grammar role: FAIL — cannot write {zigout}")
    return 1
  if !spill(idout, idbody())
    print("grammar role: FAIL — cannot write {idout}")
    return 1
  print("wrote {zigout}")
  print("wrote {idout}")
  0

_project()
