
typename: str = (desc: str)
  "duo_{desc}"

named: str = (desc: str, fields: str)
  ty: str = typename(desc)
  "((" .. ty .. "){" .. fields .. "})"

positional: str = (desc: str, values: str)
  ty: str = typename(desc)
  "((" .. ty .. "){" .. values .. "})"

field: str = (name: str, value: str)
  ".{name} = {value}"

emits: bool = (desc: str)
  if desc == ""
    return false
  true
