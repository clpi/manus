# env home — os.env table projection. No @c.emit. No lua.

get: str = (name: str)
  v = os.env(name)
  if v == nil
    ""
  v or fun(name: str, fallback: str) -> str

    v = get(name)
    if v:len() == 0
      fallback
    v
  end

has: bool = (name: str)
  v = os.env(name)
  v != nil and v:len() > 0
