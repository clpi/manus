# env home — os.env table projection. No @c.emit. No lua.

get(name: str): str
    v = os.env[name]
    if v == nil
        ""
    v

or(name: str, fallback: str): str
    v = get(name)
    if v:len() == 0
        fallback
    v

has(name: str): bool
    v = os.env[name]
    v != nil and v:len() > 0
