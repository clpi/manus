# std.ml.distill — Knowledge distillation
# For compressing large models into smaller ones for edge deployment.

# ═══════════════════════════════════════════════════════════════
# Distillation Config
# ═══════════════════════════════════════════════════════════════

distill_config_new(): any
    {
        temperature = 4.0,
        alpha = 0.7,
        hard_label_weight = 0.3,
        soft_label_weight = 0.7,
        feature_matching = false,
        feature_layers = {},
        feature_weight = 0.5,
    }
end

distill_config_set_temperature(config: any, temperature: f64): any
    config.temperature = temperature
    config
end

distill_config_set_alpha(config: any, alpha: f64): any
    config.alpha = alpha
    config
end

distill_config_set_weights(config: any, soft_weight: f64, hard_weight: f64): any
    config.soft_label_weight = soft_weight
    config.hard_label_weight = hard_weight
    config
end

distill_config_set_feature_matching(config: any, enabled: bool, layers: any, weight: f64): any
    config.feature_matching = enabled
    config.feature_layers = layers or {}
    config.feature_weight = weight or 0.5
    config
end

# ═══════════════════════════════════════════════════════════════
# Distillation Loss
# ═══════════════════════════════════════════════════════════════

distill_soft_loss(student_logits: any, teacher_logits: any, temperature: f64): f64
    # KL divergence between softened distributions
    student_probs = softmax_temperature(student_logits, temperature)
    teacher_probs = softmax_temperature(teacher_logits, temperature)

    kl = 0
    for i = 1, student_probs:len()
        if teacher_probs[i] > 1e-10
            kl += teacher_probs[i] * teacher_probs[i] / student_probs[i]:log()
        end
    end

    kl * temperature * temperature
end

distill_hard_loss(student_logits: any, labels: any): f64
    # Cross-entropy loss
    loss = 0
    for i = 1, student_logits:len()
        if labels[i] == 1
            loss -= student_logits[i]:max(1e-10):log()
        end
    end
    loss
end

distill_combined_loss(student_logits: any, teacher_logits: any, labels: any, config: any): f64
    soft_loss = distill_soft_loss(student_logits, teacher_logits, config.temperature)
    hard_loss = distill_hard_loss(student_logits, labels)

    config.soft_label_weight * soft_loss + config.hard_label_weight * hard_loss
end

# ═══════════════════════════════════════════════════════════════
# Feature Matching Loss
# ═══════════════════════════════════════════════════════════════

distill_feature_loss(student_features: any, teacher_features: any): f64
    loss = 0
    count = 0

    for layer_name, student_feat in student_features
        teacher_feat = teacher_features[layer_name]
        if teacher_feat
            # MSE loss between feature maps
            for i = 1, student_feat:len()
                diff = student_feat[i] - teacher_feat[i]
                loss += diff * diff
                count += 1
            end
        end
    end

    if count > 0 loss / count else 0 end
end

# ═══════════════════════════════════════════════════════════════
# Attention Transfer
# ═══════════════════════════════════════════════════════════════

distill_attention_transfer(student_attention: any, teacher_attention: any): f64
    loss = 0
    count = 0

    for layer_name, student_attn in student_attention
        teacher_attn = teacher_attention[layer_name]
        if teacher_attn
            # Normalize attention maps
            student_norm = normalize_attention(student_attn)
            teacher_norm = normalize_attention(teacher_attn)

            # MSE loss
            for i = 1, student_norm:len()
                diff = student_norm[i] - teacher_norm[i]
                loss += diff * diff
                count += 1
            end
        end
    end

    if count > 0 loss / count else 0 end
end

normalize_attention(attention: any): any
    # Normalize attention map to unit norm
    norm = 0
    for v in attention
        norm += v * v
    end
    norm = norm:sqrt()

    if norm < 1e-10 return attention end

    normalized = {}
    for i = 1, attention:len()
        normalized[i] = attention[i] / norm
    end
    normalized
end

# ═══════════════════════════════════════════════════════════════
# Layer-wise Distillation
# ═══════════════════════════════════════════════════════════════

distill_layer_mapping(student_layers: i64, teacher_layers: i64): any
    # Create mapping from student layers to teacher layers
    mapping = {}
    ratio = teacher_layers / student_layers

    i = 0
    while i < student_layers
        teacher_idx = i * ratio:floor() + 1
        if teacher_idx > teacher_layers teacher_idx = teacher_layers end
        mapping[i + 1] = teacher_idx
        i += 1
    end
    mapping
end

distill_layer_loss(student_outputs: any, teacher_outputs: any, mapping: any): f64
    loss = 0
    count = 0

    for student_layer, teacher_layer in mapping
        student_out = student_outputs[student_layer]
        teacher_out = teacher_outputs[teacher_layer]

        if student_out and teacher_out
            for i = 1, student_out:len()
                diff = student_out[i] - teacher_out[i]
                loss += diff * diff
                count += 1
            end
        end
    end

    if count > 0 loss / count else 0 end
end

# ═══════════════════════════════════════════════════════════════
# Self-Distillation
# ═══════════════════════════════════════════════════════════════

distill_self_distillation_loss(logits: any, labels: any, temperature: f64): f64
    # Self-distillation: use soft labels from same model
    soft_probs = softmax_temperature(logits, temperature)
    hard_loss = distill_hard_loss(logits, labels)

    # Compute cross-entropy between soft probs and hard labels
    # KL divergence: sum(soft_probs * log(soft_probs / target_probs))
    # For self-distillation, target is the hard label distribution
    n = logits:len()
    soft_loss = 0.0
    i = 1
    while i <= n
        if soft_probs[i] > 1e-10
            # Weight by hard label probability (1 for correct class, 0 for others)
            if i == labels
                soft_loss -= soft_probs[i]:log()
            end
        end
        i += 1
    end

    # Combined loss: alpha * soft + (1-alpha) * hard
    alpha = 0.7
    alpha * soft_loss + (1 - alpha) * hard_loss
end

# ═══════════════════════════════════════════════════════════════
# Progressive Distillation
# ═══════════════════════════════════════════════════════════════

distill_progressive_config(stages: i64): any
    configs = {}
    i = 1
    while i <= stages
        # Temperature increases with each stage
        temp = 2.0 + (i - 1) * 2.0
        config = distill_config_new()
        config = distill_config_set_temperature(config, temp)
        configs[i] = config
        i += 1
    end
    {
        stages = stages,
        configs = configs,
    }
end

# ═══════════════════════════════════════════════════════════════
# Utility Functions
# ═══════════════════════════════════════════════════════════════

softmax_temperature(logits: any, temperature: f64): any
    scaled = {}
    for i = 1, logits:len()
        scaled[i] = logits[i] / temperature
    end

    max_logit = -1e30
    for v in scaled
        if v > max_logit max_logit = v end
    end

    exp_sum = 0
    probs = {}
    for i = 1, scaled:len()
        exp_val = scaled[i] - max_logit:exp()
        probs[i] = exp_val
        exp_sum += exp_val
    end

    for i = 1, probs:len()
        probs[i] = probs[i] / exp_sum
    end
    probs
end

distill_accuracy(student_logits: any, labels: any): f64
    correct = 0
    total = 0

    for i = 1, student_logits:len()
        max_idx = 1
        max_val = student_logits[i][1]
        j = 2
        while j <= student_logits:len()[i]
            if student_logits[i][j] > max_val
                max_val = student_logits[i][j]
                max_idx = j
            end
            j += 1
        end
        if labels[i] == max_idx
            correct += 1
        end
        total += 1
    end

    total > 0 and correct / total or 0
end

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

M = {}
# Config
M.config_new = distill_config_new
M.config_set_temperature = distill_config_set_temperature
M.config_set_alpha = distill_config_set_alpha
M.config_set_weights = distill_config_set_weights
M.config_set_feature_matching = distill_config_set_feature_matching
# Losses
M.soft_loss = distill_soft_loss
M.hard_loss = distill_hard_loss
M.combined_loss = distill_combined_loss
M.feature_loss = distill_feature_loss
# Attention
M.attention_transfer = distill_attention_transfer
M.normalize_attention = normalize_attention
# Layer-wise
M.layer_mapping = distill_layer_mapping
M.layer_loss = distill_layer_loss
# Progressive
M.progressive_config = distill_progressive_config
# Utilities
M.softmax_temperature = softmax_temperature
M.accuracy = distill_accuracy
M
