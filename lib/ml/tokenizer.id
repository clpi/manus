

bpe_new: any = ()
  {
    type = "bpe",
    vocab = {},
    merges = {},
    inverse_vocab = {},
    vocab_size = 0
  }

bpe_add_token: i64 = (bpe: any, token: str)
  if bpe.vocab(token) != nil
    return bpe.vocab(token)
  bpe.vocab_size = bpe.vocab_size + 1
  bpe.vocab[token] = bpe.vocab_size
  bpe.inverse_vocab[bpe.vocab_size] = token
  bpe.vocab_size

bpe_learn = (bpe: any, corpus: any, num_merges: i64)
  freqs = {}
  i = 1
  while i <= corpus:len()
    ch = corpus:sub(i, i)
    if freqs[ch] == nil
      freqs[ch] = 0
    freqs[ch] = freqs[ch] + 1
    i = i + 1

  for ch in freqs
    bpe_add_token(bpe, ch)

  words = {}
  i = 1
  while i <= corpus:len()
    ch = corpus:sub(i, i)
    words[words:len() + 1] = bpe.vocab(ch)
    i = i + 1

  merge_count = 0
  while merge_count < num_merges
    adj_pairs = {}
    i = 1
    while i < words:len()
      pair = words[i] .. "," .. words[i + 1]
      if adj_pairs[pair] == nil
        adj_pairs[pair] = 0
      adj_pairs[pair] = adj_pairs[pair] + 1
      i = i + 1

    best_pair = nil
    best_count = 0
    for pair, count in adj_pairs
      if count > best_count
        best_pair = pair
        best_count = count

    if best_pair == nil
      break

    merge_count = merge_count + 1
    bpe.merges[merge_count] = best_pair

    parts = {}
    idx = 1
    while idx <= best_pair:len()
      if best_pair:sub(idx, idx) == ","
        break
      parts[parts:len() + 1] = best_pair:sub(idx, idx)
      idx = idx + 1
    left = parts:concat()
    right = best_pair:sub(idx + 1)
    new_token = left .. right
    bpe_add_token(bpe, new_token)

    new_words = {}
    i = 1
    while i <= words:len()
      if i < words:len()
        pair = words[i] .. "," .. words[i + 1]
        if pair == best_pair
          new_words[new_words:len() + 1] = bpe.vocab(new_token)
          i = i + 2
        else
          new_words[new_words:len() + 1] = words[i]
          i = i + 1
      else
        new_words[new_words:len() + 1] = words[i]
        i = i + 1
    words = new_words

bpe_encode: any = (bpe: any, text: str)
  tokens = {}
  i = 1
  while i <= text:len()
    ch = text:sub(i, i)
    if bpe.vocab(ch) != nil
      tokens[tokens:len() + 1] = bpe.vocab(ch)
    else
      unk = bpe.vocab("[UNK]")
      if unk == nil
        unk = 0
      tokens[tokens:len() + 1] = unk
    i = i + 1

  for merge in bpe.merges
    parts = {}
    idx = 1
    while idx <= merge:len()
      if merge:sub(idx, idx) == ","
        break
      parts[parts:len() + 1] = merge:sub(idx, idx)
      idx = idx + 1
    left = parts:concat()
    right = merge:sub(idx + 1)
    new_token = left .. right
    left_id = bpe.vocab(left)
    right_id = bpe.vocab(right)
    new_id = bpe.vocab(new_token)

    if left_id and right_id and new_id
      merged = {}
      i = 1
      while i <= tokens:len()
        if i < tokens:len() and tokens[i] == left_id and tokens[i + 1] == right_id
          merged[merged:len() + 1] = new_id
          i = i + 2
        else
          merged[merged:len() + 1] = tokens[i]
          i = i + 1
      tokens = merged

  tokens

bpe_decode: str = (bpe: any, tokens: any)
  parts = {}
  i = 1
  while i <= tokens:len()
    token = bpe.inverse_vocab(tokens[i])
    if token == nil
      token = "?"
    parts[parts:len() + 1] = token
    i = i + 1
  parts:concat()


wordpiece_encode: any = (vocab: any, text: str, max_word_len: i64)
  if max_word_len == nil
    max_word_len = 200
  tokens = {}

  words = {}
  word = ""
  i = 1
  while i <= text:len()
    ch = text:sub(i, i)
    if ch == " " or ch == "\t" or ch == "\n"
      if word:len() > 0
        words[words:len() + 1] = word
        word = ""
    else
      word = word .. ch
    i = i + 1
  if word:len() > 0
    words[words:len() + 1] = word

  for w in words
    word_tokens = {}
    chars = w
    while chars:len() > 0
      found = false
      end_pos = chars:len()
      while end_pos > 0
        sub = chars:sub(1, end_pos)
        if end_pos == chars:len()
          if vocab[sub] != nil
            word_tokens[word_tokens:len() + 1] = sub
            chars = chars:sub(end_pos + 1)
            found = true
            break
        else
          sub_with_prefix = "##" .. sub
          if vocab[sub_with_prefix] != nil
            word_tokens[word_tokens:len() + 1] = sub_with_prefix
            chars = chars:sub(end_pos + 1)
            found = true
            break
        end_pos = end_pos - 1
      if not found
        word_tokens[word_tokens:len() + 1] = "[UNK]"
        break
    for t in word_tokens
      tokens[tokens:len() + 1] = t

  tokens


simple_tokenize: any = (text: str)
  tokens = {}
  current = ""
  i = 1
  while i <= text:len()
    ch = text:sub(i, i)
    is_punct = ch == "." or ch == "," or ch == "!" or ch == "?" or ch == ";" or ch == ":" or ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "{" or ch == "}" or ch == "\"" or ch == "'"

    if ch == " " or ch == "\t" or ch == "\n"
      if current:len() > 0
        tokens[tokens:len() + 1] = current
        current = ""
    else
      if is_punct
        if current:len() > 0
          tokens[tokens:len() + 1] = current
          current = ""
        tokens[tokens:len() + 1] = ch
      else
        current = current .. ch
    i = i + 1
  if current:len() > 0
    tokens[tokens:len() + 1] = current
  tokens


token_frequencies: any = (tokens: any)
  freq = {}
  for t in tokens
    if freq[t] == nil
      freq[t] = 0
    freq[t] = freq[t] + 1
  freq

top_k_tokens: any = (tokens: any, k: i64)
  freq = token_frequencies(tokens)
  sorted = {}
  for t, count in freq
    sorted[sorted:len() + 1] =
      token = t
      count = count
  i = 1
  while i <= sorted:len() and i <= k
    max_idx = i
    j = i + 1
    while j <= sorted:len()
      if sorted[j].count > sorted[max_idx].count
        max_idx = j
      j = j + 1
    if max_idx != i
      duostage0 = sorted[max_idx]
      duostage1 = sorted[i]
      sorted[i] = duostage0
      sorted[max_idx] = duostage1

    i = i + 1
  result = {}
  i = 1
  while i <= k and i <= sorted:len()
    result[result:len() + 1] = sorted[i]
    i = i + 1
  result
