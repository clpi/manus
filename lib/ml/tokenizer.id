# std.ml.tokenizer — Tokenization algorithms (BPE, WordPiece, SentencePiece)
# Essential for LLM inference in ward and ML pipelines.

# ═══════════════════════════════════════════════════════════════
# Byte Pair Encoding (BPE)
# ═══════════════════════════════════════════════════════════════

bpe_new(): any
    {
        type = "bpe",
        vocab = {},
        merges = {},
        inverse_vocab = {},
        vocab_size = 0,
    }
end

# Add a token to the vocabulary
bpe_add_token(bpe: any, token: str): i64
    if bpe.vocab[token] != nil
        return bpe.vocab[token]
    end
    bpe.vocab_size = bpe.vocab_size + 1
    bpe.vocab[token] = bpe.vocab_size
    bpe.inverse_vocab[bpe.vocab_size] = token
    bpe.vocab_size
end

# Learn BPE merges from a corpus
bpe_learn(bpe: any, corpus: any, num_merges: i64): void
    # Initialize vocabulary with individual characters
    freqs = {}
    i = 1
    while i <= corpus:len()
        ch = corpus:sub(i, i)
        if freqs[ch] == nil freqs[ch] = 0 end
        freqs[ch] = freqs[ch] + 1
        i += 1
    end

    # Add all characters to vocabulary
    for ch in freqs
        bpe_add_token(bpe, ch)
    end

    # Build initial word representations (list of token IDs)
    words = {}
    i = 1
    while i <= corpus:len()
        ch = corpus:sub(i, i)
        words[words:len() + 1] = bpe.vocab[ch]
        i += 1
    end

    # Perform merges
    merge_count = 0
    while merge_count < num_merges
        # Count adjacent adj_pairs
        adj_pairs = {}
        i = 1
        while i < words:len()
            pair = words[i] .. "," .. words[i + 1]
            if adj_pairs[pair] == nil adj_pairs[pair] = 0 end
            adj_pairs[pair] = adj_pairs[pair] + 1
            i += 1
        end

        # Find most frequent pair
        best_pair = nil
        best_count = 0
        for pair, count in adj_pairs
            if count > best_count
                best_pair = pair
                best_count = count
            end
        end

        if best_pair == nil break end

        # Record merge
        merge_count += 1
        bpe.merges[merge_count] = best_pair

        # Create new token
        parts = {}
        idx = 1
        while idx <= best_pair:len()
            if best_pair:sub(idx, idx) == ","
                break
            end
            parts[parts:len() + 1] = best_pair:sub(idx, idx)
            idx += 1
        end
        left = parts:concat()
        right = best_pair:sub(idx + 1)
        new_token = left .. right
        bpe_add_token(bpe, new_token)

        # Apply merge to words
        new_words = {}
        i = 1
        while i <= words:len()
            if i < words:len()
                pair = words[i] .. "," .. words[i + 1]
                if pair == best_pair
                    new_words[new_words:len() + 1] = bpe.vocab[new_token]
                    i += 2
                    # continue
                else
                    new_words[new_words:len() + 1] = words[i]
                    i += 1
                end
            else
                new_words[new_words:len() + 1] = words[i]
                i += 1
            end
        end
        words = new_words
    end
end

# Encode text using learned BPE
bpe_encode(bpe: any, text: str): any
    # Start with character tokens
    tokens = {}
    i = 1
    while i <= text:len()
        ch = text:sub(i, i)
        if bpe.vocab[ch] != nil
            tokens[tokens:len() + 1] = bpe.vocab[ch]
        else
            # Unknown character, use [UNK]
            unk = bpe.vocab["[UNK]"]
            if unk == nil unk = 0 end
            tokens[tokens:len() + 1] = unk
        end
        i += 1
    end

    # Apply merges
    for merge in bpe.merges
        parts = {}
        idx = 1
        while idx <= merge:len()
            if merge:sub(idx, idx) == "," break end
            parts[parts:len() + 1] = merge:sub(idx, idx)
            idx += 1
        end
        left = parts:concat()
        right = merge:sub(idx + 1)
        new_token = left .. right
        left_id = bpe.vocab[left]
        right_id = bpe.vocab[right]
        new_id = bpe.vocab[new_token]

        if left_id and right_id and new_id
            merged = {}
            i = 1
            while i <= tokens:len()
                if i < tokens:len() and tokens[i] == left_id and tokens[i + 1] == right_id
                    merged[merged:len() + 1] = new_id
                    i += 2
                else
                    merged[merged:len() + 1] = tokens[i]
                    i += 1
                end
            end
            tokens = merged
        end
    end

    tokens
end

# Decode token IDs back to text
bpe_decode(bpe: any, tokens: any): str
    parts = {}
    i = 1
    while i <= tokens:len()
        token = bpe.inverse_vocab[tokens[i]]
        if token == nil token = "?" end
        parts[parts:len() + 1] = token
        i += 1
    end
    parts:concat()
end

# ═══════════════════════════════════════════════════════════════
# WordPiece (used in BERT)
# ═══════════════════════════════════════════════════════════════

wordpiece_encode(vocab: any, text: str, max_word_len: i64): any
    if max_word_len == nil max_word_len = 200 end
    tokens = {}

    # Split by whitespace
    words = {}
    word = ""
    i = 1
    while i <= text:len()
        ch = text:sub(i, i)
        if ch == " " or ch == "\t" or ch == "\n"
            if word:len() > 0
                words[words:len() + 1] = word
                word = ""
            end
        else
            word = word .. ch
        end
        i += 1
    end
    if word:len() > 0
        words[words:len() + 1] = word
    end

    # Tokenize each word
    for w in words
        # Add [CLS] and [SEP] for BERT-style
        word_tokens = {}
        chars = w
        # Try to find longest match from end
        while chars:len() > 0
            found = false
            end_pos = chars:len()
            while end_pos > 0
                sub = chars:sub(1, end_pos)
                if end_pos == chars:len()
                    # Whole word or prefix
                    if vocab[sub] != nil
                        word_tokens[word_tokens:len() + 1] = sub
                        chars = chars:sub(end_pos + 1)
                        found = true
                        break
                    end
                else
                    # Subword with ##
                    sub_with_prefix = "##" .. sub
                    if vocab[sub_with_prefix] != nil
                        word_tokens[word_tokens:len() + 1] = sub_with_prefix
                        chars = chars:sub(end_pos + 1)
                        found = true
                        break
                    end
                end
                end_pos -= 1
            end
            if not found
                # Unknown token
                word_tokens[word_tokens:len() + 1] = "[UNK]"
                break
            end
        end
        for t in word_tokens
            tokens[tokens:len() + 1] = t
        end
    end

    tokens
end

# ═══════════════════════════════════════════════════════════════
# Simple tokenizer (whitespace + punctuation splitting)
# ═══════════════════════════════════════════════════════════════

simple_tokenize(text: str): any
    tokens = {}
    current = ""
    i = 1
    while i <= text:len()
        ch = text:sub(i, i)
        # Check if punctuation
        is_punct = ch == "." or ch == "," or ch == "!" or ch == "?"
            or ch == ";" or ch == ":" or ch == "(" or ch == ")"
            or ch == "[" or ch == "]" or ch == "{" or ch == "}"
            or ch == '"' or ch == "'"

        if ch == " " or ch == "\t" or ch == "\n"
            if current:len() > 0
                tokens[tokens:len() + 1] = current
                current = ""
            end
        elseif is_punct
            if current:len() > 0
                tokens[tokens:len() + 1] = current
                current = ""
            end
            tokens[tokens:len() + 1] = ch
        else
            current = current .. ch
        end
        i += 1
    end
    if current:len() > 0
        tokens[tokens:len() + 1] = current
    end
    tokens
end

# ═══════════════════════════════════════════════════════════════
# Token counting and frequency analysis
# ═══════════════════════════════════════════════════════════════

token_frequencies(tokens: any): any
    freq = {}
    for t in tokens
        if freq[t] == nil freq[t] = 0 end
        freq[t] = freq[t] + 1
    end
    freq
end

top_k_tokens(tokens: any, k: i64): any
    freq = token_frequencies(tokens)
    sorted = {}
    for t, count in freq
        sorted[sorted:len() + 1] = {token = t, count = count}
    end
    # Simple selection sort for top k
    i = 1
    while i <= sorted:len() and i <= k
        max_idx = i
        j = i + 1
        while j <= sorted:len()
            if sorted[j].count > sorted[max_idx].count
                max_idx = j
            end
            j += 1
        end
        if max_idx != i
            sorted[i], sorted[max_idx] = sorted[max_idx], sorted[i]
        end
        i += 1
    end
    result = {}
    i = 1
    while i <= k and i <= sorted:len()
        result[result:len() + 1] = sorted[i]
        i += 1
    end
    result
end

