config_new: any = ()
  {
    warmup_runs = 10,
    num_runs = 100,
    batch_sizes = {
      1,
      2,
      4,
      8,
      16,
      32
    },
    measure_memory = true,
    measure_latency = true,
    measure_throughput = true,
    measure_first_token = true,
    output_dir = "./benchmarks"
  }
result_new: any = (model_name: str, batch_size: i64)
  {
    model_name = model_name,
    batch_size = batch_size,
    latencies = {},
    first_token_latency = 0,
    throughput = 0,
    memory_used = 0,
    memory_peak = 0,
    tokens_per_second = 0
  }
result_add_latency = (result: any, latency: f64)
  result.latencies(result.latencies:len() + 1) = latency
result_calculate_stats = (result: any)
  n = result.latencies:len()
  if n == 0
    return
  sorted = {
    result.latencies:unpack()
  }
  sorted:sort()
  sum = 0
  for v in sorted
    sum = sum + v
  result.mean_latency = sum / n
  result.median_latency = sorted(n / 2:floor() + 1)
  result.p95_latency = sorted(n * 0.95:floor() + 1)
  result.p99_latency = sorted(n * 0.99:floor() + 1)
  result.min_latency = sorted(1)
  result.max_latency = sorted(n)
  if result.mean_latency > 0
    result.throughput = result.batch_size / result.mean_latency
    result.tokens_per_second = result.throughput
runner_new: any = (config: any)
  {
    config = config,
    results = {}
  }
runner_run: any = (runner: any, model_fn: any, input_generator: any)
  config = runner.config
  results = {}
  batch_idx = 1
  while batch_idx <= config.batch_sizes:len()
    batch_size = config.batch_sizes(batch_idx)
    result = result_new("model", batch_size)
    i = 0
    while i < config.warmup_runs
      input = input_generator(batch_size)
      model_fn(input)
      i = i + 1
    i = 0
    while i < config.num_runs
      start_time = os.clock()
      input = input_generator(batch_size)
      output = model_fn(input)
      end_time = os.clock()
      result_add_latency(result, end_time - start_time)
      i = i + 1
    result_calculate_stats(result)
    results(batch_idx) = result
    batch_idx = batch_idx + 1
  runner.results = results
  results
throughput: any = (model_fn: any, input_generator: any, batch_size: i64, duration: f64)
  i = 0
  while i < 5
    input = input_generator(batch_size)
    model_fn(input)
    i = i + 1
  start_time = os.clock()
  tokens = 0
  runs = 0
  while os.clock() - start_time < duration
    input = input_generator(batch_size)
    output = model_fn(input)
    tokens = tokens + batch_size
    runs = runs + 1
  elapsed = os.clock() - start_time
  {
    batch_size = batch_size,
    total_tokens = tokens,
    total_runs = runs,
    elapsed = elapsed,
    tokens_per_second = tokens / elapsed,
    runs_per_second = runs / elapsed
  }
latency: any = (model_fn: any, input_generator: any, batch_size: i64, num_runs: i64)
  i = 0
  while i < 5
    input = input_generator(batch_size)
    model_fn(input)
    i = i + 1
  latencies = {}
  i = 0
  while i < num_runs
    start_time = os.clock()
    input = input_generator(batch_size)
    model_fn(input)
    end_time = os.clock()
    latencies(latencies:len() + 1) = end_time - start_time
    i = i + 1
  latencies:sort()
  sum = 0
  for v in latencies
    sum = sum + v
  {
    batch_size = batch_size,
    num_runs = num_runs,
    mean = sum / num_runs,
    median = latencies(num_runs / 2:floor() + 1),
    p95 = latencies(num_runs * 0.95:floor() + 1),
    p99 = latencies(num_runs * 0.99:floor() + 1),
    min = latencies(1),
    max = latencies(num_runs)
  }
memory: any = (model_fn: any, input_generator: any, batch_size: i64)
  input = input_generator(batch_size)
  output = model_fn(input)
  input_size = 0
  if input and input.data
    input_size = input.data:len() * 4
  output_size = 0
  if output and output.data
    output_size = output.data:len() * 4
  {
    batch_size = batch_size,
    input_size = input_size,
    output_size = output_size,
    estimated_total = input_size + output_size
  }
compare: any = (results: any)
  comparison = {}
  for name, result in results
    comparison(name) =
      mean_latency = result.mean_latency or 0
      throughput = result.throughput or 0
      tokens_per_second = result.tokens_per_second or 0
  comparison
rank: any = (results: any, metric: str)
  ranked = {}
  for name, result in results
    ranked(ranked:len() + 1) =
      name = name
      value = result(metric) or 0
  ranked:sort(fun(a: any, b: any) -> any
    a.value > b.value
  end)
  ranked
report: str = (results: any)
  lines = {}
  lines(lines:len() + 1) = "=== Benchmark Report ==="
  lines(lines:len() + 1) = ""
  for name, result in results
    lines(lines:len() + 1) = "Model: " .. name
    lines(lines:len() + 1) = "  Batch Size: " .. result.batch_size:to(str)
    lines(lines:len() + 1) = "  Mean Latency: " .. result.mean_latency:to(str) .. "s"
    lines(lines:len() + 1) = "  Median Latency: " .. result.median_latency:to(str) .. "s"
    lines(lines:len() + 1) = "  P95 Latency: " .. result.p95_latency:to(str) .. "s"
    lines(lines:len() + 1) = "  P99 Latency: " .. result.p99_latency:to(str) .. "s"
    lines(lines:len() + 1) = "  Throughput: " .. result.throughput:to(str) .. " batches/s"
    lines(lines:len() + 1) = "  Tokens/sec: " .. result.tokens_per_second:to(str)
    lines(lines:len() + 1) = ""
  lines:concat("\n")
