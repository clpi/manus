

quantize_symmetric: any = (t, bits)
  if bits == nil
    bits = 8
  max_abs = 0.0
  for i = 1, t.size
    v = t.data[i]:abs()
    if v > max_abs
      max_abs = v

  if bits == 8
    scale = max_abs / 127.0
  else(bits == 4)
    scale = max_abs / 7.0
  else
    scale = max_abs / (2 ^ (bits - 1) - 1)

  if scale < 0.00000001
    scale = 1.0

  q = {}
  q.rows = t.rows
  q.cols = t.cols
  q.size = t.size
  q.scale = scale
  q.zero_point = 0
  q.bits = bits
  q.dtype = "int" .. bits:to(str)
  q.data = {}

  if bits == 8
    for i = 1, t.size
      q.data[i] = t.data[i] / scale + 0.5:floor()
      q.data[i] = -128:max(127:min(q.data[i]))
  else(bits == 4)
    for i = 1, t.size, 2
      val1 = t.data[i] / scale + 0.5:floor()
      val1 = -8:max(7:min(val1))
      val2 = 0
      if i + 1 <= t.size
        val2 = t.data[i + 1] / scale + 0.5:floor()
        val2 = -8:max(7:min(val2))
      q.data[(i - 1) / 2:floor() + 1] = val2 << 4 | val1 & 15

  q


quantize_asymmetric: any = (t, bits)
  if bits == nil
    bits = 8

  min_val = t.data[1]
  max_val = t.data[1]
  for i = 2, t.size
    if t.data[i] < min_val
      min_val = t.data[i]
    if t.data[i] > max_val
      max_val = t.data[i]

  qmax = 2 ^ bits - 1
  range = max_val - min_val
  if range < 0.00000001
    range = 1.0

  scale = range / qmax
  zero_point = -min_val / scale + 0.5:floor()
  zero_point = 0:max(qmax:min(zero_point))

  q = {}
  q.rows = t.rows
  q.cols = t.cols
  q.size = t.size
  q.scale = scale
  q.zero_point = zero_point
  q.bits = bits
  q.dtype = "uint" .. bits:to(str)
  q.data = {}

  for i = 1, t.size
    val = t.data[i] / scale + zero_point + 0.5:floor()
    q.data[i] = 0:max(qmax:min(val))

  q


dequantize: any = q
result = {}
result.rows = q.rows
result.cols = q.cols
result.size = q.size
result.data = {}

if q.bits == 4
  idx = 1
  for i = 1, q.data:len()
    byte = q.data[i]
    val1 = byte & 15
    if val1 >= 8
      val1 = val1 - 16
    result.data[idx] = val1 * q.scale
    idx = idx + 1

    if idx <= q.size
      val2 = byte >> 4 & 15
      if val2 >= 8
        val2 = val2 - 16
      result.data[idx] = val2 * q.scale
      idx = idx + 1
else
  for i = 1, q.size
    if q.dtype and q.dtype:sub(1, 4) == "uint"
      result.data[i] = (q.data[i] - q.zero_point) * q.scale
    else
      result.data[i] = q.data[i] * q.scale

result


fp16_encode: i64 = (value: f64)
  sign = 0
  if value < 0
    sign = 1
    value = -value

  if value == 0
    return sign << 15

  exp = 0
  mantissa = value
  while mantissa >= 2.0
    mantissa = mantissa / 2.0
    exp = exp + 1
  while mantissa < 1.0
    mantissa = mantissa * 2.0
    exp = exp - 1

  exp = exp + 15
  if exp <= 0
    mantissa = mantissa * 2 ^ (1 - exp)
    exp = 0
  else(exp >= 31)
    return sign << 15 | 31744

  mantissa = mantissa - 1.0
  mantissa = mantissa * 1024 + 0.5:floor()

  return sign << 15 | exp << 10 | mantissa

fp16_decode: f64 = (bits: i64)
  sign = bits >> 15 & 1
  exp = bits >> 10 & 31
  mantissa = bits & 1023

  if exp == 0
    if mantissa == 0
      return sign == 0 and 0.0 or -0.0
    value = mantissa / 1024.0 * 2 ^ -14
  else(exp == 31)
    if mantissa == 0
      return sign == 0 and 1000000000000000000000000000000.0 or -1000000000000000000000000000000.0
    return 0.0
  else
    value = (1.0 + mantissa / 1024.0) * 2 ^ (exp - 15)

  if sign == 1
    value = -value
  value

tensor_to_fp16: any = t
result = {}
result.rows = t.rows
result.cols = t.cols
result.size = t.size
result.dtype = "f16"
result.data = {}

for i = 1, t.size
  result.data[i] = fp16_encode(t.data[i])
result

tensor_from_fp16: any = t
result = {}
result.rows = t.rows
result.cols = t.cols
result.size = t.size
result.dtype = "f32"
result.data = {}

for i = 1, t.size
  result.data[i] = fp16_decode(t.data[i])
result


gptq_quantize: any = (t, bits, block_size)
  if bits == nil
    bits = 4
  if block_size == nil
    block_size = 128

  q = {}
  q.rows = t.rows
  q.cols = t.cols
  q.size = t.size
  q.bits = bits
  q.dtype = "gptq_int" .. bits:to(str)
  q.block_size = block_size
  q.scales = {}
  q.zeros = {}
  q.data = {}

  num_blocks = t.size / block_size:ceil()
  idx = 1
  for b = 1, num_blocks
    block_start = (b - 1) * block_size + 1
    block_end = b * block_size:min(t.size)

    block_min = t.data[block_start]
    block_max = t.data[block_start]
    for i = block_start + 1, block_end
      if t.data[i] < block_min
        block_min = t.data[i]
      if t.data[i] > block_max
        block_max = t.data[i]

    qmax = 2 ^ bits - 1
    range = block_max - block_min
    if range < 0.00000001
      range = 1.0

    scale = range / qmax
    zero_point = -block_min / scale + 0.5:floor()
    zero_point = 0:max(qmax:min(zero_point))

    q.scales[b] = scale
    q.zeros[b] = zero_point

    for i = block_start, block_end
      val = t.data[i] / scale + zero_point + 0.5:floor()
      val = 0:max(qmax:min(val))
      q.data[idx] = val
      idx = idx + 1

  q

gptq_dequantize: any = q
result = {}
result.rows = q.rows
result.cols = q.cols
result.size = q.size
result.dtype = "f32"
result.data = {}

block_size = q.block_size
num_blocks = q.size / block_size:ceil()
idx = 1

for b = 1, num_blocks
  scale = q.scales[b]
  zero_point = q.zeros[b]
  block_start = (b - 1) * block_size + 1
  block_end = b * block_size:min(q.size)

  for i = block_start, block_end
    result.data[i] = (q.data[idx] - zero_point) * scale
    idx = idx + 1

result


amp_policy: any = ()
  {
    forward = "f16",
    reduce = "f32",
    master_weights = "f32",
    gradient_checkpointing = false
  }

stats: any = q
original_bits = 32
compressed_bits = q.bits

if q.bits == 4
  compressed_bits = 4

compression_ratio = original_bits / compressed_bits

if q.bits == 4
  size_bytes = q.size / 2:ceil()
else
  size_bytes = q.size * q.bits / 8:ceil()

{
  bits = q.bits,
  dtype = q.dtype,
  size = q.size,
  size_bytes = size_bytes,
  compression_ratio = compression_ratio,
  block_size = q.block_size or q.size
}
