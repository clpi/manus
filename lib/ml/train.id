
sgd: any = (model, optimizer, lr)
  if lr == nil
    lr = optimizer.lr
  for i = 1, model.depth
    layer = model.layers(i)
    if layer.type == "linear" and layer.dw != nil
      for j = 1, layer.weight.size
        layer.weight.data[j] = layer.weight.data(j) - lr * layer.dw.data(j)
      for j = 1, layer.bias.size
        layer.bias.data[j] = layer.bias.data(j) - lr * layer.db.data(j)
  return model

@profile
step: f64 = (model, x, target, lr)
  if lr == nil
    lr = 0.01
  tape = ml.autodiff.tape_new()
  pred = ml.nn.forward(model, x)
  loss = ml.nn.cross(pred, target)
  grad = ml.autodiff.backward(tape, loss)
  return loss

fit: any = (model, batches, epochs, lr)
  if epochs == nil
    epochs = 1
  for e = 1, epochs
    total = 0.0
    for i = 1, batches:len()
      b = batches[i]
      total = total + step(model, b.x, b.y, lr)
    print("epoch %d loss %.4f":format(e, total / batches:len()))
  return model
