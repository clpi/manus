# ml.export — Model export (ONNX, PyTorch, etc.)
# For saving trained models to standard formats.

# ═══════════════════════════════════════════════════════════════
# ONNX Export
# ═══════════════════════════════════════════════════════════════

onnx_graph_new: any = (name: str)
  {
    name = name,
    nodes = {},
    inputs = {},
    outputs = {},
    initializers = {}
  }

onnx_graph_add_node = (graph: any, op_type: str, inputs: any, outputs: any, name: str)
  graph.nodes(graph.nodes:len() + 1) =
    op_type = op_type
    inputs = inputs
    outputs = outputs
    name = name or "node_" .. to(str)(graph.nodes:len())

onnx_graph_add_input = (graph: any, name: str, shape: any, dtype: str)
  graph.inputs(graph.inputs:len() + 1) =
    name = name
    shape = shape
    dtype = dtype or "float32"

onnx_graph_add_output = (graph: any, name: str, shape: any, dtype: str)
  graph.outputs(graph.outputs:len() + 1) =
    name = name
    shape = shape
    dtype = dtype or "float32"

onnx_graph_add_initializer = (graph: any, name: str, shape: any, data: any)
  graph.initializers(graph.initializers:len() + 1) =
    name = name
    shape = shape
    data = data

onnx_model_new: any = (graph: any, opset: i64)
  {
    graph = graph,
    opset = opset or 17,
    ir_version = 8,
    producer_name = "duo",
    producer_version = "1.0"
  }

onnx_model_encode: any = (model: any)
  # Encode model as JSON (ONNX protobuf would require a protobuf encoder)
  # This JSON representation captures the full graph structure for interoperability
  graph_summary =
    name = model.graph.name
    nodes = {}
    inputs = model.graph.inputs
    outputs = model.graph.outputs
  for node in model.graph.nodes
    graph_summary.nodes(graph_summary.nodes:len() + 1) =
      op_type = node.op_type
      inputs = node.inputs
      outputs = node.outputs
      name = node.name
  payload =
    ir_version = model.ir_version
    opset_import = { { version = model.opset } }
    producer_name = model.producer_name
    producer_version = model.producer_version
    graph = graph_summary
  encoding.json.encode(payload)

onnx_model_save: any = (model: any, path: str)
  data = onnx_model_encode(model)
  f = io.open(path, "w")
  if f == nil
    return { ok = false, error = "Cannot create file: " .. path }
  f:write(data)
  f:close()
  { ok = true, path = path, size = data:len() }

# ═══════════════════════════════════════════════════════════════
# PyTorch Export (state dict)
# ═══════════════════════════════════════════════════════════════

pytorch_state_dict_new: any = ()
  {
    tensors = {},
    metadata = {}
  }

pytorch_state_dict_add = (state_dict: any, name: str, tensor: any)
  state_dict.tensors(name) = tensor

pytorch_state_dict_save: any = (state_dict: any, path: str)
  # Encode state dict as JSON
  payload =
    tensors = {}
    metadata = state_dict.metadata
  for name, tensor in state_dict.tensors
    payload.tensors(name) =
      shape = tensor.shape or {}
      dtype = tensor.dtype or "f32"
      data_len = tensor.size or 0
  encoded = encoding.json.encode(payload)
  f = io.open(path, "w")
  if f == nil
    return { ok = false, error = "Cannot create file: " .. path }
  f:write(encoded)
  f:close()
  { ok = true, path = path, size = encoded:len() }

# ═══════════════════════════════════════════════════════════════
# SafeTensors Export
# ═══════════════════════════════════════════════════════════════

safetensors_new: any = ()
  {
    tensors = {},
    metadata = {}
  }

safetensors_add_tensor = (st: any, name: str, tensor: any, dtype: str)
  st.tensors(name) =
    data = tensor
    dtype = dtype or "f32"
    shape = tensor.shape or { tensor.size }

safetensors_encode: any = (st: any)
  # SafeTensors format: JSON header mapping tensor names to dtype/shape/offsets
  header = {}
  offset = 0
  for name, tensor in st.tensors
    header[name] =
      dtype = tensor.dtype
      shape = tensor.shape
      data_offsets = { offset, offset + tensor.size }
    offset = offset + tensor.size
  header_json = encoding.json.encode(header)
  {
    format = "safetensors",
    header = header_json,
    header_size = header_json:len(),
    data_size = offset
  }

safetensors_save: any = (st: any, path: str)
  data = safetensors_encode(st)
  f = io.open(path, "w")
  if f == nil
    return { ok = false, error = "Cannot create file: " .. path }
  # Write 8-byte header length prefix, then header JSON
  header_len = data.header_size
  f:write(string.pack("<I8", header_len))
  f:write(data.header)
  f:close()
  { ok = true, path = path, size = 8 + data.header_size + data.data_size }

# ═══════════════════════════════════════════════════════════════
# GGUF Export
# ═══════════════════════════════════════════════════════════════

gguf_writer_new: any = (quantization: str)
  {
    tensors = {},
    metadata = {},
    quantization = quantization or "f16"
  }

gguf_writer_add_tensor = (gw: any, name: str, tensor: any, shape: any)
  gw.tensors(name) =
    data = tensor
    shape = shape

gguf_writer_add_metadata = (gw: any, key: str, value: any)
  gw.metadata(key) = value

gguf_writer_encode: any = (gw: any)
  # GGUF header as JSON (simplified; real GGUF uses binary format)
  payload =
    format = "gguf"
    version = 3
    quantization = gw.quantization
    tensors = {}
    metadata = gw.metadata
  for name, tensor in gw.tensors
    payload.tensors(name) =
      shape = tensor.shape
  encoded = encoding.json.encode(payload)
  {
    format = "gguf",
    version = 3,
    data = encoded,
    size = encoded:len()
  }

gguf_writer_save: any = (gw: any, path: str)
  data = gguf_writer_encode(gw)
  f = io.open(path, "w")
  if f == nil
    return { ok = false, error = "Cannot create file: " .. path }
  f:write(data.data)
  f:close()
  { ok = true, path = path, size = data.size }

# ═══════════════════════════════════════════════════════════════
# Model Conversion
# ═══════════════════════════════════════════════════════════════

convert_onnx_to_safetensors: any = (onnx_model: any)
  st = safetensors_new()
  for init in onnx_model.graph.initializers
    safetensors_add_tensor(st, init.name, init.data, "f32")
  st

convert_pytorch_to_onnx: any = (state_dict: any, input_shapes: any)
  graph = onnx_graph_new("model")
  for name, tensor in state_dict.tensors
    onnx_graph_add_initializer(graph, name, tensor.shape, tensor.data)
  onnx_model_new(graph)

convert_gguf_to_safetensors: any = (gguf_model: any)
  st = safetensors_new()
  for name, tensor in gguf_model.tensors
    safetensors_add_tensor(st, name, tensor.data, "f32")
  st
# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════
