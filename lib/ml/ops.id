# ml.ops — High-level ML ops; hot paths delegate to ml.* intrinsics

# Native kernels (zero-arg checksum benchmarks / fused paths)
gemm(): f64
    return ml.matmul_256()

conv(): f64
    return ml.conv2d()

sm(): f64
    return ml.softmax_1k()

attn(): f64
    return ml.attention()

mlp(): f64
    return ml.mlp_forward()

gauss(): f64
    return ml.gelu_1k()

ln(): f64
    return ml.layernorm_1k()

inner(): f64
    return ml.dot_1m()

corr(): f64
    return ml.conv1d()

# User-facing tensor ops (stdlib path; compiler may fuse later)
@hot
matmul(a, b): any
    return ml.tensor.matmul(a, b)

@hot
softmax(t): any
    return ml.tensor.softmax(t)

gelu(t): any
    result = ml.tensor.zeros(t.rows, t.cols)
    for i = 1, t.size
        v = t.data[i]
        inner = 0.044715 * v * v * v + v
        result.data[i] = 0.5 * v * (1.0 + math.tanh(0.7978845608 * inner))
    return result

layernorm(t, eps): any
    if eps == nil eps = 1e-5 
    n = t.size
    mean = 0.0
    for i = 1, n mean += t.data[i] 
    mean /= n
    var = 0.0
    for i = 1, n
        d = t.data[i] - mean
        var += d * d
    rstd = 1.0 / var / n + eps:sqrt()
    result = ml.tensor.zeros(t.rows, t.cols)
    for i = 1, n
        result.data[i] = (t.data[i] - mean) * rstd
    return result

dot(a, b): f64
    assert(a.size == b.size, "dot size mismatch")
    sum = 0.0
    for i = 1, a.size
        sum += a.data[i] * b.data[i]
    return sum
