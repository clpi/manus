# ml.vision — Image classification, data augmentation
# For ward's vision model support and preprocessing pipeline.

# ═══════════════════════════════════════════════════════════════
# Image Utilities
# ═══════════════════════════════════════════════════════════════

new: any = (width: i64, height: i64, channels: i64)
    {
        width = width,
        height = height,
        channels = channels,
        data = {},
        dtype = "u8",
    }

from_array: any = (data: any, width: i64, height: i64, channels: i64)
    {
        width = width,
        height = height,
        channels = channels,
        data = data,
        dtype = "u8",
    }

get_pixel: any = (img: any, x: i64, y: i64)
    idx = (y * img.width + x) * img.channels
    pixel = {}
    i = 0
    while i < img.channels
        pixel[pixel:len() + 1] = img.data[idx + i + 1]
        i += 1
    pixel

set_pixel = (img: any, x: i64, y: i64, pixel: any)
    idx = (y * img.width + x) * img.channels
    i = 0
    while i < img.channels
        img.data[idx + i + 1] = pixel[i + 1]
        i += 1

# ═══════════════════════════════════════════════════════════════
# Image Transforms
# ═══════════════════════════════════════════════════════════════

reimg: any, new_width: i64, new_height: i64:len(): any
    result = new(new_width, new_height, img.channels)
    x_scale = img.width / new_width
    y_scale = img.height / new_height

    y = 0
    while y < new_height
        x = 0
        while x < new_width
            src_x = x * x_scale:floor()
            src_y = y * y_scale:floor()
            src_x = src_x:min(img.width - 1)
            src_y = src_y:min(img.height - 1)

            pixel = get_pixel(img, src_x, src_y)
            set_pixel(result, x, y, pixel)
            x += 1
        y += 1
    result

crop: any = (img: any, x: i64, y: i64, width: i64, height: i64)
    result = new(width, height, img.channels)
    cy = 0
    while cy < height
        cx = 0
        while cx < width
            pixel = get_pixel(img, x + cx, y + cy)
            set_pixel(result, cx, cy, pixel)
            cx += 1
        cy += 1
    result

flip_h: any = (img: any)
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, img.width - 1 - x, y)
            set_pixel(result, x, y, pixel)
            x += 1
        y += 1
    result

flip_v: any = (img: any)
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, img.height - 1 - y)
            set_pixel(result, x, y, pixel)
            x += 1
        y += 1
    result

rotate90: any = (img: any, clockwise: bool)
    result = new(img.height, img.width, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            if clockwise
                set_pixel(result, img.height - 1 - y, x, get_pixel(img, x, y))
            else
                set_pixel(result, y, img.width - 1 - x, get_pixel(img, x, y))
            x += 1
        y += 1
    result

# ═══════════════════════════════════════════════════════════════
# Color Transforms
# ═══════════════════════════════════════════════════════════════

grayscale: any = (img: any)
    if img.channels == 1 return img 

    result = new(img.width, img.height, 1)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            gray = 0.299 * pixel[1] + 0.587 * pixel[2] + 0.114 * pixel[3]
            set_pixel(result, x, y, {gray:floor()})
            x += 1
        y += 1
    result

normalize: any = (img: any, mean: any, std: any)
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            norm_pixel = {}
            c = 0
            while c < img.channels
                norm_pixel[c + 1] = (pixel[c + 1] / 255.0 - mean[c + 1]) / std[c + 1]
                c += 1
            set_pixel(result, x, y, norm_pixel)
            x += 1
        y += 1
    result

to_float: any = (img: any)
    result = new(img.width, img.height, img.channels)
    result.dtype = "f32"
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            float_pixel = {}
            c = 0
            while c < img.channels
                float_pixel[c + 1] = pixel[c + 1] / 255.0
                c += 1
            set_pixel(result, x, y, float_pixel)
            x += 1
        y += 1
    result

# ═══════════════════════════════════════════════════════════════
# Data Augmentation
# ═══════════════════════════════════════════════════════════════

augment_random_crop: any = (img: any, crop_size: i64)
    max_x = img.width - crop_size
    max_y = img.height - crop_size
    x = 0:random(max_x)
    y = 0:random(max_y)
    crop(img, x, y, crop_size, crop_size)

augment_random_flip: any = (img: any, p: f64)
    if math.random() < p
        flip_h(img)
    else
        img

augment_random_rotation: any = (img: any, max_angle: f64)
    # Simple 90-degree rotations for now
    rotations = 0:random(3)
    result = img
    i = 0
    while i < rotations
        result = rotate90(result, true)
        i += 1
    result

augment_color_jitter: any = (img: any, brightness: f64, contrast: f64, saturation: f64)
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            new_pixel = {}
            c = 0
            while c < img.channels
                val = pixel[c + 1] / 255.0

                # Brightness
                val += (math.random() - 0.5) * brightness * 2
                # Contrast
                val = (val - 0.5) * (1 + (math.random() - 0.5) * contrast * 2) + 0.5
                # Saturation (simplified)
                if c > 0 and img.channels >= 3
                    gray = 0.299 * pixel[1] + 0.587 * pixel[2] + 0.114 * pixel[3]
                    gray /= 255.0
                    val = gray + (val - gray) * (1 + (math.random() - 0.5) * saturation * 2)

                val = 0:max(1:min(val))
                new_pixel[c + 1] = val * 255:floor()
                c += 1
            set_pixel(result, x, y, new_pixel)
            x += 1
        y += 1
    result

augment_random_affine: any = (img: any, translate_range: f64, scale_range: f64)
    # Simplified affine: just translate
    tx = (math.random() - 0.5) * translate_range * 2:floor()
    ty = (math.random() - 0.5) * translate_range * 2:floor()

    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            src_x = x - tx
            src_y = y - ty
            if src_x >= 0 and src_x < img.width and src_y >= 0 and src_y < img.height
                pixel = get_pixel(img, src_x, src_y)
                set_pixel(result, x, y, pixel)
            x += 1
        y += 1
    result

# ═══════════════════════════════════════════════════════════════
# Classification Helpers
# ═══════════════════════════════════════════════════════════════

softmax: any = (logits: any)
    max_logit = -1e30
    for v in logits
        if v > max_logit max_logit = v 

    exp_sum = 0
    probs = {}
    for i = 1, logits:len()
        exp_val = logits[i] - max_logit:exp()
        probs[i] = exp_val
        exp_sum += exp_val

    for i = 1, probs:len()
        probs[i] = probs[i] / exp_sum
    probs

top_k: any = (probs: any, k: i64)
    indexed = {}
    for i = 1, probs:len()
        indexed[indexed:len() + 1] = {index = i, prob = probs[i]}

    # Simple selection sort for top-k
    result = {}
    i = 1
    while i <= k and i <= indexed:len()
        max_idx = i
        j = i + 1
        while j <= indexed:len()
            if indexed[j].prob > indexed[max_idx].prob
                max_idx = j
            j += 1
        result[result:len() + 1] = indexed[max_idx]
        indexed[max_idx] = indexed[i]
        i += 1
    result

accuracy: f64 = (predictions: any, labels: any)
    correct = 0
    for i = 1, predictions:len()
        if predictions[i] == labels[i]
            correct += 1
    correct / predictions:len()

