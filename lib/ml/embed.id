# ml.embed — Token embeddings, positional encodings, and RoPE
# Essential for transformer-based models (LLMs, ViTs, etc.)

# ═══════════════════════════════════════════════════════════════
# Token Embedding
# ═══════════════════════════════════════════════════════════════

token_embedding: any = (vocab_size: i64, embed_dim: i64)
  scale = 1.0 / embed_dim:sqrt()
  weights = ml.tensor.zeros(vocab_size, embed_dim)
  for i = 1, weights.size
    weights.data(i) = (math.random() * 2 - 1) * scale
  {
    type = "token_embedding",
    vocab_size = vocab_size,
    embed_dim = embed_dim,
    weights = weights
  }

@hot
token_embed_forward: any = (layer: any, token_ids: any)
  # token_ids: {batch_size, seq_len} or 1D array
  batch = 1
  seq_len = token_ids:len()
  if type(token_ids(1)) == "table"
    batch = token_ids:len()
    seq_len = token_ids:len()(1)
  result = ml.tensor.zeros(batch * seq_len, layer.embed_dim)
  for i = 1, batch * seq_len
    id = token_ids(i)
    for j = 1, layer.embed_dim
      result.data((i - 1) * layer.embed_dim + j) = layer.weights.data((id - 1) * layer.embed_dim + j)
  ml.tensor.reshape(result, batch * seq_len, layer.embed_dim)

# ═══════════════════════════════════════════════════════════════
# Sinusoidal Positional Encoding (original Transformer)
# ═══════════════════════════════════════════════════════════════

sinusoidal_encoding: any = (max_len: i64, embed_dim: i64)
  pe = ml.tensor.zeros(max_len, embed_dim)
  for pos = 0, max_len - 1
    for i = 0, embed_dim / 2:floor() - 1
      freq = 1.0 / 10000:pow(2 * i / embed_dim)
      pe.data(pos * embed_dim + 2 * i + 1) = pos * freq:sin()
      if 2 * i + 2 <= embed_dim
        pe.data(pos * embed_dim + 2 * i + 2) = pos * freq:cos()
  {
    type = "sinusoidal",
    max_len = max_len,
    embed_dim = embed_dim,
    weights = pe
  }

sinusoidal_forward: any = (layer: any, seq_len: i64)
  ml.tensor.slice(layer.weights, 1, seq_len, 1, layer.embed_dim)

# ═══════════════════════════════════════════════════════════════
# Learned Positional Embedding
# ═══════════════════════════════════════════════════════════════

learned_positional_embedding: any = (max_len: i64, embed_dim: i64)
  {
    type = "learned_positional",
    max_len = max_len,
    embed_dim = embed_dim,
    weights = ml.tensor.rand(max_len, embed_dim)
  }

learned_positional_forward: any = (layer: any, positions: any)
  # positions: list of 0-based position indices
  seq_len = positions:len()
  result = ml.tensor.zeros(seq_len, layer.embed_dim)
  for i = 1, seq_len
    # 1-indexed
    pos = positions(i) + 1
    for j = 1, layer.embed_dim
      result.data((i - 1) * layer.embed_dim + j) = layer.weights.data((pos - 1) * layer.embed_dim + j)
  result

# ═══════════════════════════════════════════════════════════════
# Rotary Position Embedding (RoPE) — used in LLaMA, GPT-NeoX, etc.
# ═══════════════════════════════════════════════════════════════

rope_embedding: any = (dim: i64, base: f64, max_seq_len: i64)
  if base == nil
    base = 10000.0
  if max_seq_len == nil
    max_seq_len = 8192

  # Precompute frequencies
  freqs = ml.tensor.zeros(max_seq_len, dim)
  for pos = 0, max_seq_len - 1
    for i = 0, dim / 2:floor() - 1
      freq = 1.0 / base:pow(2 * i / dim)
      angle = pos * freq
      freqs.data(pos * dim + 2 * i + 1) = angle:cos()
      freqs.data(pos * dim + 2 * i + 2) = angle:sin()

  {
    type = "rope",
    dim = dim,
    base = base,
    max_seq_len = max_seq_len,
    freqs = freqs
  }

@hot
rope_forward: any = (layer: any, x: any, offset: i64)
  # x: [seq_len, dim]
  # Applies rotary embedding in-place conceptually
  seq_len = x.rows
  dim = x.cols
  result = ml.tensor.zeros(seq_len, dim)

  for pos = 0, seq_len - 1
    abs_pos = pos + (offset or 0)
    for i = 0, dim / 2:floor() - 1
      cos_val = layer.freqs.data(abs_pos * dim + 2 * i + 1)
      sin_val = layer.freqs.data(abs_pos * dim + 2 * i + 2)
      x0 = x.data(pos * dim + 2 * i + 1)
      x1 = x.data(pos * dim + 2 * i + 2)
      result.data(pos * dim + 2 * i + 1) = x0 * cos_val - x1 * sin_val
      result.data(pos * dim + 2 * i + 2) = x0 * sin_val + x1 * cos_val
  result

# ═══════════════════════════════════════════════════════════════
# ALiBi (Attention with Linear Biases) — used in BLOOM, MPT
# ═══════════════════════════════════════════════════════════════

alibi_encoding: any = (heads: i64, max_seq_len: i64)
  # Precompute slope for each head
  slopes = {}
  for i = 1, heads
    base = 2:pow(-8 * i / heads)
    slopes(i) = base

  # Precompute bias matrix
  biases = ml.tensor.zeros(heads, max_seq_len)
  for h = 1, heads
    for pos = 0, max_seq_len - 1
      biases.data((h - 1) * max_seq_len + pos + 1) = -slopes(h) * pos

  {
    type = "alibi",
    heads = heads,
    max_seq_len = max_seq_len,
    slopes = slopes,
    biases = biases
  }

alibi_forward: any = (layer: any, scores: any, seq_len: i64)
  # scores: [heads, seq_len, seq_len]
  # Add ALiBi bias to attention scores
  result = ml.tensor.copy(scores)
  for h = 1, layer.heads
    for i = 1, seq_len
      for j = 1, seq_len
        if j <= i
          # Linear bias: -slope * |i - j|
          result.data((h - 1) * seq_len * seq_len + (i - 1) * seq_len + j) = result.data((h - 1) * seq_len * seq_len + (i - 1) * seq_len + j) + layer.biases.data((h - 1) * layer.max_seq_len + i - j:abs() + 1)
  result

# ═══════════════════════════════════════════════════════════════
# Embedding + Position + LayerNorm (complete embedding layer)
# ═══════════════════════════════════════════════════════════════

embedding_layer: any = (vocab_size: i64, embed_dim: i64, max_seq_len: i64, pos_encoding: str)
  if pos_encoding == nil
    pos_encoding = "rope"
  token_emb = token_embedding(vocab_size, embed_dim)
  pos_emb = nil

  if pos_encoding == "rope"
    pos_emb = rope_embedding(embed_dim, 10000, max_seq_len)
  else(pos_encoding == "sinusoidal")
    pos_emb = sinusoidal_encoding(max_seq_len, embed_dim)
  else(pos_encoding == "learned")
    pos_emb = learned_positional_embedding(max_seq_len, embed_dim)

  {
    type = "embedding",
    vocab_size = vocab_size,
    embed_dim = embed_dim,
    max_seq_len = max_seq_len,
    pos_encoding = pos_encoding,
    token = token_emb,
    pos = pos_emb
  }

@hot
embedding_forward: any = (layer: any, token_ids: any, offset: i64)
  # Token embeddings
  x = token_embed_forward(layer.token, token_ids)
  # Position embeddings
  if has(.pos)(layer)
    if layer.pos_encoding == "rope"
      x = rope_forward(layer.pos, x, offset)
    else(layer.pos_encoding == "sinusoidal")
      pos_enc = sinusoidal_forward(layer.pos, x.rows)
      x = ml.tensor.add(x, pos_enc)
    else(layer.pos_encoding == "learned")
      positions = {}
      for i = 0, x.rows - 1
        positions(positions:len() + 1) = i
      pos_enc = learned_positional_forward(layer.pos, positions)
      x = ml.tensor.add(x, pos_enc)
  x
# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════
