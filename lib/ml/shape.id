
matmul = (ar: any, ac: any, br: any, bc: any)
  assert(ac == br, string.format("matmul shape mismatch: (%d,%d) @ (%d,%d)", ar, ac, br, bc))

broadcast = (ar: any, ac: any, br: any, bc: any)
  ok = ar == br and ac == bc or ar == 1 and ac == bc or ar == br and ac == 1 or ar == 1 and bc == 1
  assert(ok, "broadcast incompatible shapes")

numel: i64 = (rows, cols)
  return rows * cols

mnist: any = ()
  return {
    input = { rows = 784, cols = 1 },
    hidden = { rows = 256, cols = 1 },
    latent = { rows = 128, cols = 1 },
    output = { rows = 10, cols = 1 }
  }

block: any = (heads, dim)
  return {
    heads = heads,
    dim = dim,
    hd = dim / heads,
    fd = dim * 4
  }
