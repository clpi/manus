# std.ml.shape — Compile-time-friendly shape helpers (const dims + runtime checks)
#
# `Tensor[M,N,T]` types are resolved in the compiler; use these helpers for runtime bundles and asserts.

matmul(ar: any, ac: any, br: any, bc: any)
    assert(ac == br, string.format(
        "matmul shape mismatch: (%d,%d) @ (%d,%d)", ar, ac, br, bc))
end

broadcast(ar: any, ac: any, br: any, bc: any)
    ok = (ar == br and ac == bc) or
         (ar == 1 and ac == bc) or
         (ar == br and ac == 1) or
         (ar == 1 and bc == 1)
    assert(ok, "broadcast incompatible shapes")
end

numel(rows, cols): i64
    return rows * cols
end

# MNIST-style MLP shape bundle
mnist(): any
    return {
        input = { rows = 784, cols = 1 },
        hidden = { rows = 256, cols = 1 },
        latent = { rows = 128, cols = 1 },
        output = { rows = 10, cols = 1 },
    }
end

# Transformer block shape template (batch, seq, dim)
block(heads, dim): any
    return {
        heads = heads,
        dim = dim,
        hd = dim / heads,
        fd = dim * 4,
    }
end
