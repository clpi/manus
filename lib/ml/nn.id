# ml.nn — Neural network layers and training

# ═══════════════════════════════════════════════════════════════
# Layer definitions
# ═══════════════════════════════════════════════════════════════

linear(in_features: i64, out_features: i64): any
    # Xavier initialization
    scale = 1.0 / in_features:sqrt()
    weight = ml.tensor.rand(in_features, out_features)
    # Apply Xavier scaling
    r = 0
    while r < in_features
        c = 0
        while c < out_features
            weight.data[r * out_features + c] = (weight.data[r * out_features + c] - 0.5) * 2 * scale
            c += 1
        r += 1
    return {
        type = "linear",
        weight = weight,
        bias = ml.tensor.zeros(1, out_features),
        in_features = in_features,
        out_features = out_features,
        # Gradient storage (allocated on first backward)
        grad_weight = nil,
        grad_bias = nil,
        # Cache for backward pass
        input_cache = nil,
    }

relu(): any
    return {
        type = "relu",
        mask_cache = nil,
    }

gelu(): any
    return { type = "gelu" }

softmax(): any
    return {
        type = "softmax",
        output_cache = nil,
    }

dropout(rate: f64): any
    return {
        type = "dropout",
        rate = rate,
        training = true,
    }

# ═══════════════════════════════════════════════════════════════
# Model construction
# ═══════════════════════════════════════════════════════════════

sequential(...): any
    layers = {...}
    return {
        type = "sequential",
        layers = layers,
        n_layers = layers:len(),
    }

# Alias for `nn { ... }` design doc syntax (varargs table today)
build = sequential

# MNIST classifier preset
mnist_classifier(): any
    return sequential(
        linear(784, 256),
        relu(),
        linear(256, 128),
        relu(),
        linear(128, 10),
        softmax()
    )

# ═══════════════════════════════════════════════════════════════
# Forward pass
# ═══════════════════════════════════════════════════════════════

@hot
forward_linear(layer, x): any
    # Cache input for backward pass
    layer.input_cache = x
    # y = x @ W + b
    y = ml.tensor.matmul(x, layer.weight)
    return ml.tensor.add(y, layer.bias)

@hot
forward_relu(layer, x): any
    return ml.tensor.relu(x)

@hot
forward_gelu(layer, x): any
    Ops = ops
    return Ops.gelu(x)

@hot
forward_softmax(layer, x): any
    out = ml.tensor.softmax(x)
    layer.output_cache = out
    return out

forward_dropout(layer, x): any
    # During training, randomly zero out elements
    if not layer.training return x
    
    rate = layer.rate or 0.5
    scale = 1.0 / (1.0 - rate)
    
    # Use CSPRNG for truly random dropout mask each call
    crypto_rand = rand
    mask_bytes = crypto_rand.bytes(x.rows * x.cols / 8:ceil())
    
    result = ml.tensor.zeros(x.rows, x.cols)
    i = 0
    while i < x.rows * x.cols
        # Extract bit from mask bytes
        byte_idx = i / 8:floor()
        bit_idx = i % 8
        mask_byte = mask_bytes:byte(byte_idx + 1) or 0
        bit_set = (mask_byte >> bit_idx) & 1
        if bit_set == 1
            result.data[i] = x.data[i] * scale
        i += 1
    result

forward_layer(layer, x): any
    if layer.type == "linear" return forward_linear(layer, x)
    if layer.type == "relu" return forward_relu(layer, x)
    if layer.type == "gelu" return forward_gelu(layer, x)
    if layer.type == "softmax" return forward_softmax(layer, x)
    if layer.type == "dropout" return forward_dropout(layer, x)
    return x

forward(model, x): any
    h = x
    for i = 1, model.n_layers
        h = forward_layer(model.layers[i], h)
    return h

# ═══════════════════════════════════════════════════════════════
# Loss functions
# ═══════════════════════════════════════════════════════════════

cross_entropy(pred, target): f64
    # Simplified: assumes pred is softmax output, target is class index per row
    loss = 0.0
    for i = 1, pred.rows
        idx = ml.tensor.get(target, i, 1)
        p = ml.tensor.get(pred, i, idx)
        if p < 1e-7 p = 1e-7
        loss -= p:log()
    return loss / pred.rows

mse_loss(pred, target): f64
    diff = ml.tensor.add(pred, ml.tensor.mul_scalar(target, -1))
    sum = 0.0
    for i = 1, diff.size
        v = diff.data[i]
        sum += v * v
    return sum / diff.size

# ═══════════════════════════════════════════════════════════════
# Optimizer (SGD with momentum)
# ═══════════════════════════════════════════════════════════════

sgd(lr: any, momentum: any)
    if momentum == nil momentum = 0.0
    return {
        type = "sgd",
        lr = lr,
        momentum = momentum,
        velocities = {},
    }

adam(lr: any, beta1: any, beta2: any, eps: any)
    if beta1 == nil beta1 = 0.9
    if beta2 == nil beta2 = 0.999
    if eps == nil eps = 1e-8
    return {
        type = "adam",
        lr = lr,
        beta1 = beta1,
        beta2 = beta2,
        eps = eps,
        t = 0,
        m = {},
        v = {},
    }

