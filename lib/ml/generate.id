# ml.generate — Text generation for LLMs
# For ward's text generation pipeline and inference.

# ═══════════════════════════════════════════════════════════════
# Generation Config
# ═══════════════════════════════════════════════════════════════

config_new: any = ()
  {
    max_tokens = 512,
    temperature = 1.0,
    top_k = 50,
    top_p = 0.9,
    repetition_penalty = 1.1,
    frequency_penalty = 0.0,
    presence_penalty = 0.0,
    stop = {},
    seed = nil,
    logprobs = false
  }

config_set_max_tokens: any = (config: any, max_tokens: i64)
  config.max_tokens = max_tokens
  config

config_set_temperature: any = (config: any, temperature: f64)
  config.temperature = temperature
  config

config_set_top_k: any = (config: any, top_k: i64)
  config.top_k = top_k
  config

config_set_top_p: any = (config: any, top_p: f64)
  config.top_p = top_p
  config

config_set_stop: any = (config: any, stop: any)
  config.stop = stop
  config

config_set_seed: any = (config: any, seed: i64)
  config.seed = seed
  config

# ═══════════════════════════════════════════════════════════════
# Sampling Strategies
# ═══════════════════════════════════════════════════════════════

sample_greedy: i64 = (logits: any)
  max_idx = 1
  max_val = logits[1]
  i = 2
  while i <= logits:len()
    if logits[i] > max_val
      max_val = logits[i]
      max_idx = i
    i = i + 1
  max_idx

sample_temperature: i64 = (logits: any, temperature: f64)
  if temperature < 0.01
    return sample_greedy(logits)

  # Apply temperature
  scaled = {}
  for i = 1, logits:len()
    scaled[i] = logits[i] / temperature

  # Softmax
  probs = softmax(scaled)

  # Sample from distribution
  return sample_from_probs(probs)

sample_top_k: i64 = (logits: any, k: i64, temperature: f64)
  if temperature < 0.01
    return sample_greedy(logits)

  # Find top k
  indexed = {}
  for i = 1, logits:len()
    indexed(indexed:len() + 1) =
      idx = i
      logit = logits[i]

  # Sort by logit descending
  indexed:sort((a: any, b: any) -> any
    a.logit > b.logit
  )

  # Keep top k
  top_k = {}
  i = 1
  while i <= k and i <= indexed:len()
    top_k(top_k:len() + 1) = indexed[i]
    i = i + 1

  # Apply temperature to top k
  scaled = {}
  for item in top_k
    scaled(scaled:len() + 1) = item.logit / temperature

  # Softmax
  probs = softmax(scaled)

  # Sample
  chosen = sample_from_probs(probs)
  top_k[chosen].idx

sample_top_p: i64 = (logits: any, top_p: f64, temperature: f64)
  if temperature < 0.01
    return sample_greedy(logits)

  # Sort logits
  indexed = {}
  for i = 1, logits:len()
    indexed(indexed:len() + 1) =
      idx = i
      logit = logits[i]
  indexed:sort((a: any, b: any) -> any
    a.logit > b.logit
  )

  # Apply temperature and softmax
  scaled = {}
  for item in indexed
    scaled(scaled:len() + 1) = item.logit / temperature
  probs = softmax(scaled)

  # Accumulate until top_p
  cumulative = 0
  cutoff = 0
  i = 1
  while i <= probs:len()
    cumulative = cumulative + probs[i]
    if cumulative >= top_p
      cutoff = i
      break
    i = i + 1

  if cutoff == 0
    cutoff = probs:len()

  # Renormalize and sample
  truncated_probs = {}
  i = 1
  while i <= cutoff
    truncated_probs[i] = probs[i]
    i = i + 1

  chosen = sample_from_probs(truncated_probs)
  indexed[chosen].idx

sample_beam_search: any = (logits: any, beams: i64, sequence: any)
  # Beam search: maintain top-k candidates across decoding steps
  # sequence is the accumulated token history for each beam
  if sequence == nil
    # First step: initialize beams from first logits
    beam_scores = {}
    for i = 1, beams
      beam_scores[i] =
        score = 0
        tokens = {}

    indexed = {}
    for i = 1, logits:len()
      indexed(indexed:len() + 1) =
        idx = i
        logit = logits[i]
    indexed:sort((a: any, b: any) -> any
      a.logit > b.logit
    )

    i = 1
    while i <= beams and i <= indexed:len()
      beam_scores[i].tokens(1) = indexed[i].idx
      beam_scores[i].score = indexed[i].logit
      i = i + 1
    return beam_scores

  # Subsequent steps: expand each beam, keep top beams
  all_candidates = {}
  for beam_idx = 1, sequence:len()
    beam = sequence[beam_idx]
    # Expand this beam with top candidates
    indexed = {}
    for i = 1, logits:len()
      indexed(indexed:len() + 1) =
        idx = i
        logit = logits[i]
    indexed:sort((a: any, b: any) -> any
      a.logit > b.logit
    )

    top_n = beams:min(indexed:len())
    i = 1
    while i <= top_n
      new_tokens = {}
      for t in beam.tokens
        new_tokens(new_tokens:len() + 1) = t
      new_tokens(new_tokens:len() + 1) = indexed[i].idx
      all_candidates(all_candidates:len() + 1) =
        score = beam.score + indexed[i].logit
        tokens = new_tokens
      i = i + 1

  # Sort all candidates by score and keep top beams
  all_candidates:sort((a: any, b: any) -> any
    a.score > b.score
  )
  result = {}
  i = 1
  while i <= beams and i <= all_candidates:len()
    result[i] = all_candidates[i]
    i = i + 1
  result

# ═══════════════════════════════════════════════════════════════
# Repetition Penalty
# ═══════════════════════════════════════════════════════════════

apply_repetition_penalty: any = (logits: any, generated: any, penalty: f64)
  if penalty <= 1.0
    return logits

  result = {}
  for i = 1, logits:len()
    result[i] = logits[i]

  for token in generated
    if result[token + 1] > 0
      result[token + 1] = result[token + 1] / penalty
    else
      result[token + 1] = result[token + 1] * penalty

  result

apply_frequency_penalty: any = (logits: any, token_counts: any, penalty: f64)
  if penalty == 0.0
    return logits

  result = {}
  for i = 1, logits:len()
    count = token_counts(i) or 0
    result[i] = logits[i] - penalty * count
  result

apply_presence_penalty: any = (logits: any, generated: any, penalty: f64)
  if penalty == 0.0
    return logits

  result = {}
  for i = 1, logits:len()
    result[i] = logits[i]

  for token in generated
    if result[token + 1] > 0
      result[token + 1] = result[token + 1] - penalty

  result

# ═══════════════════════════════════════════════════════════════
# Stop Conditions
# ═══════════════════════════════════════════════════════════════

check_stop_tokens: bool = (generated: any, stop_tokens: any)
  if stop_tokens:len() == 0
    return false
  # Check if any stop token appears at the end
  for stop in stop_tokens
    stop_len = stop:len()
    if generated:len() >= stop_len
      matched = true
      i = 1
      while i <= stop_len
        if generated(generated:len() - stop_len + i) != stop[i]
          matched = false
          break
        i = i + 1
      if matched
        return true
  false

check_stop_strings: bool = (generated_text: str, stop_strings: any)
  for stop in stop_strings
    if generated_text:find(stop, 1, true)
      return true
  false

# ═══════════════════════════════════════════════════════════════
# Utility Functions
# ═══════════════════════════════════════════════════════════════

softmax: any = (logits: any)
  max_logit = -1000000000000000000000000000000.0
  for v in logits
    if v > max_logit
      max_logit = v

  exp_sum = 0
  probs = {}
  for i = 1, logits:len()
    exp_val = logits[i] - max_logit:exp()
    probs[i] = exp_val
    exp_sum = exp_sum + exp_val

  for i = 1, probs:len()
    probs[i] = probs[i] / exp_sum
  probs

sample_from_probs: i64 = (probs: any)
  r = math.random()
  cumulative = 0
  for i = 1, probs:len()
    cumulative = cumulative + probs[i]
    if r <= cumulative
      return i
  probs:len()

top_k_logits: any = (logits: any, k: i64)
  indexed = {}
  for i = 1, logits:len()
    indexed(indexed:len() + 1) =
      idx = i
      logit = logits[i]
  indexed:sort((a: any, b: any) -> any
    a.logit > b.logit
  )

  result = {}
  i = 1
  while i <= k and i <= indexed:len()
    result(result:len() + 1) = indexed[i]
    i = i + 1
  result
# ═══════════════════════════════════════════════════════════════
