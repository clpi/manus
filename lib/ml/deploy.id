
static_binary_opts: any = ()
    return {
        target = "native",
        optimize = "O3",
        lto = true,
        strip = true,
        notes = "duo compile app.id -o app -O3",
    }

wasm_opts: any = ()
    return {
        target = "wasm32-wasi",
        simd = true,
        notes = "duo compile app.id --target wasm32-wasi -o app.wasm",
    }

edge_pipeline(model): any
    return {
        type = "edge_pipeline",
        quant = ml.quant.amp_policy(),
        device = ml.device.wasm_simd(),
        steps = { "quantize", "strip", "wasm" },
        model = model,
    }

export_onnx: any = (model, path)
    graph = std.ml.export.onnx_graph_new(model.name or "model")
    for layer in model.layers
        if layer.type == "linear"
            std.ml.export.onnx_graph_add_node(graph, "MatMul", {layer.name .. "_input", layer.name .. "_weight"}, {layer.name .. "_output"}, layer.name)
            std.ml.export.onnx_graph_add_initializer(graph, layer.name .. "_weight", {layer.in_features, layer.out_features}, layer.weight)
            if layer.bias
                std.ml.export.onnx_graph_add_node(graph, "Add", {layer.name .. "_output", layer.name .. "_bias"}, {layer.name .. "_final"}, layer.name .. "_add_bias")
                std.ml.export.onnx_graph_add_initializer(graph, layer.name .. "_bias", {layer.out_features}, layer.bias)
        else(layer.type == "relu")
            std.ml.export.onnx_graph_add_node(graph, "Relu", {layer.name .. "_input"}, {layer.name .. "_output"}, layer.name)
        else(layer.type == "softmax")
            std.ml.export.onnx_graph_add_node(graph, "Softmax", {layer.name .. "_input"}, {layer.name .. "_output"}, layer.name)
        else(layer.type == "embedding")
            std.ml.export.onnx_graph_add_initializer(graph, layer.name .. "_weight", {layer.vocab_size, layer.embed_dim}, layer.weight)
            std.ml.export.onnx_graph_add_node(graph, "Gather", {layer.name .. "_weight", layer.name .. "_input"}, {layer.name .. "_output"}, layer.name)
    std.ml.export.onnx_graph_add_input(graph, "input", {nil}, "float32")
    std.ml.export.onnx_graph_add_output(graph, "output", {nil}, "float32")
    onnx_model = std.ml.export.onnx_model_new(graph, model.opset or 17)
    std.ml.export.onnx_model_save(onnx_model, path)

load_safetensors: any = (path: str)
    f = path:open("rb")
    if f == nil
        return {ok = false, error = "Cannot open file: " .. path}

    len_bytes = f:read(8)
    if len_bytes == nil or len_bytes:len() < 8
        f:close()
        return {ok = false, error = "Invalid safetensors: missing header length"}

    header_len = 0
    i = 1
    while i <= 8
        header_len += len_bytes:byte(i) * (2 ^ ((i - 1) * 8))
        i += 1

    header_json = f:read(header_len)
    f:close()
    if header_json == nil
        return {ok = false, error = "Invalid safetensors: cannot read header"}

    header = std.encoding.json.decode(header_json)
    if header == nil
        return {ok = false, error = "Invalid safetensors: bad header JSON"}

    tensors = {}
    for name, entry in header
        if type(entry) == "table" and entry.dtype
            tensors[name] = {
                dtype = entry.dtype,
                shape = entry.shape,
                data_offsets = entry.data_offsets,
            }

    {ok = true, path = path, tensors = tensors, header = header}

