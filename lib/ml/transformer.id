# std.ml.transformer — Transformer blocks (attention + FFN) for LLM-style workloads

block(heads, dim): any
    spec = std.ml.shape.block(heads, dim)
    return {
        type = "transformer_block",
        heads = spec.heads,
        dim = spec.dim,
        hd = spec.hd,
        fd = spec.fd,
        attn = { type = "attention", heads = heads },
        up = { type = "linear", input = dim, output = spec.fd },
        down = { type = "linear", input = spec.fd, output = dim },
    }
end

stack(layers, heads, dim): any
    blocks = {}
    for i = 1, layers
        blocks[i] = block(heads, dim)
    end
    return {
        type = "transformer",
        layers = layers,
        heads = heads,
        dim = dim,
        blocks = blocks,
    }
end

# Hot path: native attention kernel checksum (pairs with ml.attention)
@hot
attn(): f64
    return ml.attention()
end

# Reference FFN (compiler may fuse linear+gelu+linear later)
feed(block, x): any
    h = std.ml.tensor.matmul(x, block.up.weight)
    h = std.ml.ops.gelu(h)
    return std.ml.tensor.matmul(h, block.down.weight)
end

step(block, x): any
    # Residual + attention: native kernel validates hot path; full MHA in stdlib later
    _ = attn()
    h = x
    return std.ml.tensor.add(h, feed(block, h))
end

forward(model, x): any
    h = x
    for i = 1, model.layers
        h = step(model.blocks[i], h)
    end
    return h
end
