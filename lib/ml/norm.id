# std.ml.norm — Normalization layers (BatchNorm, RMSNorm, GroupNorm, InstanceNorm)

# ═══════════════════════════════════════════════════════════════
# Batch Normalization
# ═══════════════════════════════════════════════════════════════

batchnorm(num_features: i64, eps: f64, momentum: f64): any
    if eps == nil eps = 1e-5 end
    if momentum == nil momentum = 0.1 end
    {
        type = "batchnorm",
        num_features = num_features,
        eps = eps,
        momentum = momentum,
        weight = std.ml.tensor.ones(1, num_features),
        bias = std.ml.tensor.zeros(1, num_features),
        running_mean = std.ml.tensor.zeros(1, num_features),
        running_var = std.ml.tensor.ones(1, num_features),
        training = true,
        # Gradient storage
        grad_weight = nil,
        grad_bias = nil,
        input_cache = nil,
        # Per-batch statistics
        batch_mean = nil,
        batch_var = nil,
        x_normalized = nil,
    }
end

@hot
batchnorm_forward(layer: any, x: any): any
    n = x.rows
    d = x.cols

    if layer.training
        # Compute batch mean
        mean = std.ml.tensor.zeros(1, d)
        for j = 1, d
            s = 0
            for i = 1, n
                s += x.data[(i - 1) * d + j]
            end
            mean.data[j] = s / n
        end

        # Compute batch variance
        variance = std.ml.tensor.zeros(1, d)
        for j = 1, d
            s = 0
            for i = 1, n
                diff = x.data[(i - 1) * d + j] - mean.data[j]
                s += diff * diff
            end
            variance.data[j] = s / n
        end

        # Update running statistics
        for j = 1, d
            layer.running_mean.data[j] = (1 - layer.momentum) * layer.running_mean.data[j] + layer.momentum * mean.data[j]
            layer.running_var.data[j] = (1 - layer.momentum) * layer.running_var.data[j] + layer.momentum * variance.data[j]
        end

        layer.batch_mean = mean
        layer.batch_var = variance
    else
        mean = layer.running_mean
        variance = layer.running_var
    end

    # Normalize
    result = std.ml.tensor.zeros(n, d)
    layer.x_normalized = std.ml.tensor.zeros(n, d)
    for j = 1, d
        inv_std = 1.0 / variance.data[j] + layer.eps:sqrt()
        for i = 1, n
            x_norm = (x.data[(i - 1) * d + j] - mean.data[j]) * inv_std
            layer.x_normalized.data[(i - 1) * d + j] = x_norm
            result.data[(i - 1) * d + j] = x_norm * layer.weight.data[j] + layer.bias.data[j]
        end
    end

    layer.input_cache = x
    result
end

batchnorm_backward(layer: any, grad_out: any): any
    n = grad_out.rows
    d = grad_out.cols
    dx = std.ml.tensor.zeros(n, d)

    if layer.grad_weight == nil
        layer.grad_weight = std.ml.tensor.zeros(1, d)
        layer.grad_bias = std.ml.tensor.zeros(1, d)
    end

    for j = 1, d
        inv_std = 1.0 / layer.batch_var.data[j] + layer.eps:sqrt()

        # Gradient w.r.t. weight and bias
        dg = 0
        db = 0
        for i = 1, n
            dg += grad_out.data[(i - 1) * d + j] * layer.x_normalized.data[(i - 1) * d + j]
            db += grad_out.data[(i - 1) * d + j]
        end
        layer.grad_weight.data[j] = dg
        layer.grad_bias.data[j] = db

        # Gradient w.r.t. input
        dx_mean = 0
        dx_norm_sum = 0
        for i = 1, n
            dx_mean += grad_out.data[(i - 1) * d + j]
            dx_norm_sum += grad_out.data[(i - 1) * d + j] * layer.x_normalized.data[(i - 1) * d + j]
        end
        dx_mean /= n
        dx_norm_sum /= n

        for i = 1, d
            x_norm = layer.x_normalized.data[(i - 1) * d + j]
            dx.data[(i - 1) * d + j] = (grad_out.data[(i - 1) * d + j] - dx_mean - x_norm * dx_norm_sum) * inv_std * layer.weight.data[j]
        end
    end
    dx
end

# ═══════════════════════════════════════════════════════════════
# RMS Normalization (used in LLMs like LLaMA)
# ═══════════════════════════════════════════════════════════════

rmsnorm(dim: i64, eps: f64): any
    if eps == nil eps = 1e-6 end
    {
        type = "rmsnorm",
        dim = dim,
        eps = eps,
        weight = std.ml.tensor.ones(1, dim),
        grad_weight = nil,
        input_cache = nil,
    }
end

@hot
rmsnorm_forward(layer: any, x: any): any
    n = x.rows
    d = x.cols
    result = std.ml.tensor.zeros(n, d)

    for i = 1, n
        # Compute RMS
        sum_sq = 0
        for j = 1, d
            v = x.data[(i - 1) * d + j]
            sum_sq += v * v
        end
        rms = sum_sq / d + layer.eps:sqrt()

        # Normalize and scale
        for j = 1, d
            result.data[(i - 1) * d + j] = (x.data[(i - 1) * d + j] / rms) * layer.weight.data[j]
        end
    end

    layer.input_cache = x
    result
end

# ═══════════════════════════════════════════════════════════════
# Group Normalization
# ═══════════════════════════════════════════════════════════════

groupnorm(num_channels: i64, num_groups: i64, eps: f64): any
    if eps == nil eps = 1e-5 end
    {
        type = "groupnorm",
        num_channels = num_channels,
        num_groups = num_groups,
        eps = eps,
        weight = std.ml.tensor.ones(1, num_channels),
        bias = std.ml.tensor.zeros(1, num_channels),
        grad_weight = nil,
        grad_bias = nil,
    }
end

groupnorm_forward(layer: any, x: any): any
    n = x.rows
    d = x.cols
    channels_per_group = d / layer.num_groups
    result = std.ml.tensor.zeros(n, d)

    for g = 1, layer.num_groups
        start_ch = (g - 1) * channels_per_group + 1
        end_ch = g * channels_per_group

        # Compute group mean
        mean = 0
        count = 0
        for i = 1, n
            for j = start_ch, end_ch
                mean += x.data[(i - 1) * d + j]
                count += 1
            end
        end
        mean /= count

        # Compute group variance
        var = 0
        for i = 1, n
            for j = start_ch, end_ch
                diff = x.data[(i - 1) * d + j] - mean
                var += diff * diff
            end
        end
        var /= count

        # Normalize
        inv_std = 1.0 / var + layer.eps:sqrt()
        for i = 1, n
            for j = start_ch, end_ch
                idx = (i - 1) * d + j
                result.data[idx] = (x.data[idx] - mean) * inv_std * layer.weight.data[j] + layer.bias.data[j]
            end
        end
    end

    layer.input_cache = x
    result
end

# ═══════════════════════════════════════════════════════════════
# Layer Normalization
# ═══════════════════════════════════════════════════════════════

layernorm(dim: i64, eps: f64): any
    if eps == nil eps = 1e-5 end
    {
        type = "layernorm",
        dim = dim,
        eps = eps,
        weight = std.ml.tensor.ones(1, dim),
        bias = std.ml.tensor.zeros(1, dim),
        grad_weight = nil,
        grad_bias = nil,
    }
end

@hot
layernorm_forward(layer: any, x: any): any
    n = x.rows
    d = x.cols
    result = std.ml.tensor.zeros(n, d)

    for i = 1, n
        # Mean
        mean = 0
        for j = 1, d
            mean += x.data[(i - 1) * d + j]
        end
        mean /= d

        # Variance
        var = 0
        for j = 1, d
            diff = x.data[(i - 1) * d + j] - mean
            var += diff * diff
        end
        var /= d

        # Normalize and scale
        inv_std = 1.0 / var + layer.eps:sqrt()
        for j = 1, d
            idx = (i - 1) * d + j
            result.data[idx] = (x.data[idx] - mean) * inv_std * layer.weight.data[j] + layer.bias.data[j]
        end
    end

    layer.input_cache = x
    result
end

