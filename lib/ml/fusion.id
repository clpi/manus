# ml.fusion — Kernel fusion rules (compile-time rewrite targets)

# Adjacent op patterns the compiler should merge (documented contract for @trace)
rules: any = ()
    return {
        { pattern = { "linear", "relu" }, fused = "fused_linear_relu" },
        { pattern = { "linear", "gelu" }, fused = "fused_linear_gelu" },
        { pattern = { "matmul", "add" }, fused = "fused_matmul_bias" },
        { pattern = { "softmax", "cross_entropy" }, fused = "fused_softmax_ce" },
        { pattern = { "layernorm", "linear" }, fused = "fused_ln_linear" },
    }

can_fuse: bool = (layer_a, layer_b)
    if layer_a.type == "linear" and layer_b.type == "relu" return true
    if layer_a.type == "linear" and layer_b.type == "gelu" return true
    return false

fuse_sequential: any = (model)
    if model.type != "sequential" return model
    fused = {}
    i = 1
    fi = 0
    while i <= model.n_layers
        a = model.layers[i]
        b = nil
        if i < model.n_layers b = model.layers[i + 1]
        if b != nil and can_fuse(a, b)
            fi += 1
            fused[fi] = {
                type = "fused",
                ops = { a.type, b.type },
                a = a,
                b = b,
            }
            i += 2
        else
            fi += 1
            fused[fi] = a
            i += 1
    return { type = "sequential", layers = fused, n_layers = fi }

