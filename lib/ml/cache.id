# ml.cache — Model inference cache
# For caching model outputs and reducing redundant computation.

# ═══════════════════════════════════════════════════════════════
# Cache Configuration
# ═══════════════════════════════════════════════════════════════

config_new: any = ()
    {
        max_size = 1000,
        ttl = 300,  # seconds
        eviction_policy = "lru",  # "lru", "lfu", "fifo"
        enable_hash_keys = true,
        compression = false,
    }

config_set_max_size: any = (config: any, max_size: i64)
    config.max_size = max_size
    config

config_set_ttl: any = (config: any, ttl: i64)
    config.ttl = ttl
    config

config_set_eviction: any = (config: any, policy: str)
    config.eviction_policy = policy
    config

# ═══════════════════════════════════════════════════════════════
# Inference Cache
# ═══════════════════════════════════════════════════════════════

cache_new: any = (config: any)
    {
        config = config,
        entries = {},
        access_order = {},
        hit_count = 0,
        miss_count = 0,
    }

cache_key: str = (model_name: str, input_hash: str)
    model_name .. ":" .. input_hash

cache_get: any = (cache: any, key: str)
    entry = cache.entries[key]
    if entry == nil
        cache.miss_count = cache.miss_count + 1
        return nil

    # Check TTL
    if os.clock() - entry.timestamp > cache.config.ttl
        cache_evict(cache, key)
        cache.miss_count = cache.miss_count + 1
        return nil

    # Update access
    entry.access_count = entry.access_count + 1
    entry.last_access = os.clock()
    cache.hit_count = cache.hit_count + 1

    # Move to front of access order
    for i, k in cache.access_order
        if k == key
            cache.access_order:remove(i)
            break
    cache.access_order:insert(1, key)

    entry.value

cache_set = (cache: any, key: str, value: any)
    # Check if already exists
    if cache.entries[key]
        cache.entries[key].value = value
        cache.entries[key].timestamp = os.clock()
        cache.entries[key].access_count = cache.entries[key].access_count + 1
        return

    # Evict if at capacity
    if cache:len().entries >= cache.config.max_size
        inference_cache_evict_oldest(cache)

    # Add new entry
    cache.entries[key] = {
        value = value,
        timestamp = os.clock(),
        access_count = 1,
        last_access = os.clock(),
    }
    cache.access_order:insert(1, key)

cache_evict = (cache: any, key: str)
    cache.entries[key] = nil
    for i, k in cache.access_order
        if k == key
            cache.access_order:remove(i)
            break

inference_cache_evict_oldest = (cache: any)
    if cache:len().access_order == 0 return 
    key = cache.access_order[cache:len().access_order]
    cache_evict(cache, key)

cache_clear = (cache: any)
    cache.entries = {}
    cache.access_order = {}

cache_stats: any = (cache: any)
    total = cache.hit_count + cache.miss_count
    {
        size = cache:len().entries,
        max_size = cache.config.max_size,
        hit_count = cache.hit_count,
        miss_count = cache.miss_count,
        hit_rate = total > 0 and cache.hit_count / total or 0,
    }

# ═══════════════════════════════════════════════════════════════
# Attention Cache (for KV cache in transformers)
# ═══════════════════════════════════════════════════════════════

attention_cache_new: any = (max_seq_len: i64, num_heads: i64, head_dim: i64)
    {
        max_seq_len = max_seq_len,
        num_heads = num_heads,
        head_dim = head_dim,
        keys = {},
        values = {},
        current_len = 0,
    }

attention_cache_append = (cache: any, layer_idx: i64, keys: any, values: any)
    if cache.keys[layer_idx] == nil
        cache.keys[layer_idx] = {}
        cache.values[layer_idx] = {}

    cache.keys[layer_idx][cache:len().keys[layer_idx] + 1] = keys
    cache.values[layer_idx][cache:len().values[layer_idx] + 1] = values
    cache.current_len = cache.current_len + 1

attention_cache_get: any = (cache: any, layer_idx: i64)
    {
        keys = cache.keys[layer_idx] or {},
        values = cache.values[layer_idx] or {},
    }

attention_cache_reset = (cache: any)
    cache.keys = {}
    cache.values = {}
    cache.current_len = 0

attention_cache_is_full: bool = (cache: any)
    cache.current_len >= cache.max_seq_len

# ═══════════════════════════════════════════════════════════════
# Embedding Cache
# ═══════════════════════════════════════════════════════════════

embedding_cache_new: any = (max_entries: i64)
    {
        max_entries = max_entries,
        embeddings = {},
        access_order = {},
    }

embedding_cache_get: any = (cache: any, token_id: i64)
    entry = cache.embeddings[token_id]
    if entry == nil return nil 

    # Update access order
    for i, id in cache.access_order
        if id == token_id
            cache.access_order:remove(i)
            break
    cache.access_order:insert(1, token_id)

    entry.embedding

embedding_cache_set = (cache: any, token_id: i64, embedding: any)
    if cache.embeddings[token_id]
        cache.embeddings[token_id].embedding = embedding
        return

    # Evict if full
    if cache:len().access_order >= cache.max_entries
        oldest = cache.access_order[cache:len().access_order]
        cache.embeddings[oldest] = nil
        cache.access_order:remove()

    cache.embeddings[token_id] = {
        embedding = embedding,
        timestamp = os.clock(),
    }
    cache.access_order:insert(1, token_id)

embedding_cache_stats: any = (cache: any)
    {
        size = cache:len().access_order,
        max_size = cache.max_entries,
    }

# ═══════════════════════════════════════════════════════════════
# Result Cache (for caching function results)
# ═══════════════════════════════════════════════════════════════

result_cache_new: any = (max_size: i64, ttl: i64)
    {
        max_size = max_size or 100,
        ttl = ttl or 60,
        results = {},
    }

result_cache_get: any = (cache: any, key: str)
    entry = cache.results[key]
    if entry == nil return nil 

    if os.clock() - entry.timestamp > cache.ttl
        cache.results[key] = nil
        return nil

    entry.value

result_cache_set = (cache: any, key: str, value: any)
    # Evict oldest if full
    count = 0
    for _ in cache.results
        count += 1
    if count >= cache.max_size
        oldest_key = nil
        oldest_time = 1e30
        for k, v in cache.results
            if v.timestamp < oldest_time
                oldest_time = v.timestamp
                oldest_key = k
        if oldest_key cache.results[oldest_key] = nil 

    cache.results[key] = {
        value = value,
        timestamp = os.clock(),
    }

result_cache_clear = (cache: any)
    cache.results = {}

# ═══════════════════════════════════════════════════════════════
