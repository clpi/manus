# GAP-157 — std is not semantic architecture (docs/spec/world.md).

taint: i64 = (text: str)
    if text:len() == 0
        0
    else if text:match("std%.[a-z]")
        1
    else if text:match("req \"std")
        2
    else if text:match("require \"std")
        3
    else if text:match("sym_")
        4
    else if text:match("duo_fn_")
        5
    else if text:match("bitcast")
        6
    else if text:match("unpack@view")
        7
    else if text:match("bit%.")
        8
    else if text:match("f64_to_bits")
        9
    else if text:match("viewedges")
        10
    else if text:match("fs:")
        11
    else if text:match("io:read%(") or text:match("io%.read%(")
        12
    else if text:match("== nil")
        13
    else if text:match("!= nil")
        14
    else if text:match("len: bool = %(path")
        17
    else if text:match("audit: bool = %(path") or text:match("hit: bool = %(path")
        18
    else if text:match("from%(path%) = %(pattern")
        19
    else if text:match("if not ")
        20
    else if text:match(" and not ") or text:match(" or not ") or text:match("%(not ")
        21
    else
        0

main: i64 = ()
    code: i64 = 0
    if !census.forbidden:match("|std|")
        code = 1
    if census.worlds:match("|std|")
        code = 2
    if census.worlds:match("|proc|")
        code = 3
    if taint("lib/semantic/ingest.id":read()) != 0
        code = 4
    if taint("lib/semantic/vocabulary.id":read()) != 0
        code = 5
    if taint("lib/semantic/ffi.id":read()) != 0
        code = 6
    if taint("lib/semantic/gate.id":read()) != 0
        code = 27
    if taint("scripts/proof/remove.id":read()) != 0
        code = 7
    if taint("scripts/proof/mkdir.id":read()) != 0
        code = 8
    if taint("scripts/proof/worldreach.id":read()) != 0
        code = 9
    if taint("scripts/proof/record.id":read()) != 0
        code = 10
    if code == 0 and taint("scripts/proof/audit.id":read()) != 0
        code = 17
    if code == 0 and taint("scripts/proof/bit.id":read()) != 0
        code = 13
    if code == 0 and !census.relations:match("|link|")
        code = 11
    if code == 0 and census.relations:match("|symbol|")
        code = 12
    if code == 0 and !census.descriptors:match("|bit|")
        code = 14
    if code == 0 and !census.view(edges):match("|bit/f64|")
        code = 15
    if code == 0 and !census.view(edges):match("|i64/bit|")
        code = 16
    if code == 0
        print("semantic zerostd: pass")
    code
