# GAP-124 application record — projection pack schema (PROJECTION-ONE step 4).
# law.projection.pack · docs/spec/application-record.md
#
# Full field catalog and read/to samples live in the spec — tables before main
# currently break the bootstrap parser; restore inline samples when GAP-134 lands.

packfields: i64 = 13

check: i64 = ()
  if packfields < 13
    1
  else
    0

main: i64 = ()
  code = check()
  if code == 0
    print("semantic application: pass")
  code
