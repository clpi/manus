# Gate boundary relations — curry slots for proof and migration gates only.
# Not world relations; path/world/diff symbols live in the curry slot, not strings.

len =
  world = ""
  possessed = false
  callable = true
  operation = false
  class = "gate"
  slot = "path"
audit =
  world = ""
  possessed = false
  callable = true
  operation = false
  class = "gate"
  slot = "path"
hit =
  world = ""
  possessed = false
  callable = true
  operation = false
  class = "gate"
  slot = "path"
scan =
  world = ""
  possessed = false
  callable = true
  operation = false
  class = "gate"
  slot = "diff"
dot =
  world = ""
  possessed = false
  callable = true
  operation = false
  class = "gate"
  slot = "world"

main: i64 = ()
  code: i64 = 0
  if len("class") != "gate"
    code = 1
  if code == 0 and audit("slot") != "path"
    code = 2
  if code == 0 and hit("callable") != true
    code = 3
  if code == 0 and scan("slot") != "diff"
    code = 4
  if code == 0 and dot("slot") != "world"
    code = 5
  if code == 0
    print("semantic gate: pass")
  code
