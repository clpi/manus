# GAP-124 verdict relations — one file, five scalar gates.
# scripts/canon.id mirrors this proof core for the scripts home.

valid: i64 = 0
migrate: i64 = 1
missing: i64 = 2
invalid: i64 = 3

world: i64 = (need: i64, reach: i64)
  if need & reach == need
    valid
  else
    invalid

subject: i64 = (possessed: bool, callable: bool, operation: bool)
  if possessed
    if callable
      if operation
        migrate
      else
        valid
    else
      valid
  else
    valid

vocab: i64 = (known: bool, duplicate: bool, qualifier: bool, foreign: bool)
  if duplicate
    invalid
  else
    if qualifier
      migrate
    else
      if foreign
        missing
      else
        if known
          valid
        else
          missing

sentinel: i64 = (cases: bool, literal: bool, routing: bool)
  if cases
    if literal
      if routing
        invalid
      else
        valid
    else
      valid
  else
    valid

control: i64 = (equivalent: bool, admitted: bool, freedom: bool)
  if equivalent
    if admitted
      if freedom
        migrate
      else
        invalid
    else
      missing
  else
    valid
