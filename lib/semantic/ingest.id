# GAP-124 ingestion — collect world-home facts into one resident table.
#
# World files remain authoritative; this module is the graph-facing collector.
# No relationid slots; spelling is table key, world is qualifying fact content.

resident = {
    read = io.read
    write = io.write
    run = process.run
    capture = process.capture
    open = process.open
    close = process.close
    exists = fs.exists
    list = fs.list
    stat = fs.stat
    remove = fs.remove
    mkdir = fs.mkdir
    copy = fs.copy
    mkdirall = fs.mkdirall
    encode = json.encode
    decode = json.decode
    parse = json.parse
    connect = net.connect
    send = net.send
    recv = net.recv
    listen = net.listen
    accept = net.accept
    call = mcp.call
    notify = mcp.notify
    alloc = mem.alloc
    free = mem.free
    retain = mem.retain
    release = mem.release
    suspend = coroutine.suspend
    resume = coroutine.resume
    yield = coroutine.yield
    trace = debug.trace
    breakpoint = debug.breakpoint
    compile = jit.compile
    extern = ffi.extern
    link = ffi.link
    load = simd.load
    store = simd.store
    lane = simd.lane
    len = seq.len
    sub = seq.sub
    find = seq.find
    each = seq.each
    sort = seq.sort
    eq = seq.eq
    ord = seq.ord
    hash = seq.hash
    push = seq.push
    pop = seq.pop
    get = seq.get
    set = seq.set
    at = seq.at
    format = seq.format
    split = seq.split
    join = seq.join
    byte = seq.byte
    to = seq.to
    from = seq.from
    add = seq.add
    mul = seq.mul
    div = seq.div
    mod = seq.mod
    iter = seq.iter
    derive = seq.derive
    compose = seq.compose
    project = seq.project
    realize = seq.realize
}

resident["match"] = keyword.reserved["match"]
resident["and"] = keyword.reserved["and"]
resident["or"] = keyword.reserved["or"]
resident["not"] = keyword.reserved["not"]

# Edge census: world/spelling tokens for graph owner ingestion.
edges = "|io/read|io/write|process/run|process/capture|process/open|process/close|fs/exists|fs/list|fs/stat|fs/remove|fs/mkdir|fs/copy|fs/mkdirall|json/encode|json/decode|json/parse|net/connect|net/send|net/recv|net/listen|net/accept|mcp/call|mcp/notify|mem/alloc|mem/free|mem/retain|mem/release|coroutine/suspend|coroutine/resume|coroutine/yield|debug/trace|debug/breakpoint|jit/compile|ffi/extern|ffi/link|simd/load|simd/store|simd/lane|seq/len|seq/sub|seq/find|seq/each|seq/sort|seq/eq|seq/ord|seq/hash|seq/push|seq/pop|seq/get|seq/set|seq/at|seq/format|seq/split|seq/join|seq/byte|seq/to|seq/from|seq/add|seq/mul|seq/div|seq/mod|seq/iter|seq/derive|seq/compose|seq/project|seq/realize|seq/match|seq/and|seq/or|seq/not|"
view(edges) = ()
    "|bit/f64|f64/bit|bit/f32|f32/bit|i64/bit|"

sync: i64 = ()
    code: i64 = 0
    if resident["read"]["world"] != "io"
        code = 1
    if resident["encode"]["world"] != "json"
        code = 2
    if resident["exists"]["world"] != "fs"
        code = 3
    if resident["len"]["world"] != ""
        code = 4
    if !edges:match("|io/read|")
        code = 5
    if !edges:match("|json/encode|")
        code = 6
    if !edges:match("|seq/match|")
        code = 7
    if !edges:match("|seq/realize|")
        code = 8
    if !view(edges):match("|bit/f64|")
        code = 11
    if !view(edges):match("|i64/bit|")
        code = 12
    if !census.view(edges):match("|bit/f64|")
        code = 13
    if census.worlds:match("|std|")
        code = 9
    if !census.forbidden:match("|std|")
        code = 10
    code

main: i64 = ()
    code = sync()
    if code == 0
        print("semantic ingest: pass")
    code
