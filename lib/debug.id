# debug — debugging utilities

traceback(message: str, level: int): str
    debug.traceback(message, level)

getinfo(f: any, what: str): any
    debug.getinfo(f, what)

getlocal(f: any, local_: int): any
    debug.getlocal(f, local_)

getupvalue(f: any, up: int): any
    debug.getupvalue(f, up)

setlocal(thread: any, level: int, local_: int, value: any): any
    debug.setlocal(thread, level, local_, value)

setupvalue(f: any, up: int, value: any): any
    debug.setupvalue(f, up, value)

