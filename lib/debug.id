# debug — debugging utilities

traceback: str = (message: str, level: int)
  debug.traceback(message, level)

getinfo: any = (f: any, what: str)
  debug.getinfo(f, what)

getlocal: any = (f: any, local_: int)
  debug.getlocal(f, local_)

getupvalue: any = (f: any, up: int)
  debug.getupvalue(f, up)

setlocal: any = (thread: any, level: int, local_: int, value: any)
  debug.setlocal(thread, level, local_, value)

setupvalue: any = (f: any, up: int, value: any)
  debug.setupvalue(f, up, value)
