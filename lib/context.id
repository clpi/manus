
background_ctx: any = ()
  { deadline = nil, cancelled = false, parent = nil, key = "background", done = false }

todo_ctx: any = ()
  { deadline = nil, cancelled = false, parent = nil, key = "todo", done = false }

with_cancel: any = (parent: any)
  if parent == nil
    parent = background_ctx()
  { deadline = parent.deadline, cancelled = false, parent = parent, done = false }

with_deadline: any = (parent: any, deadline: any)
  if parent == nil
    parent = background_ctx()
  d = deadline
  if has(.deadline)(parent) and parent.deadline < d
    d = parent.deadline
  { deadline = d, cancelled = false, parent = parent, done = false }

with_timeout: any = (parent: any, timeout: any)
  t = time
  now = t.now()
  with_deadline(parent, now + timeout)

with_value: any = (parent: any, key: any, value: any)
  if parent == nil
    parent = background_ctx()
  child =
    deadline = parent.deadline
    cancelled = false
    parent = parent
    done = false
  child[key] = value
  child

cancel = (ctx: any)
  if ctx == nil
    return
  ctx.cancelled = true
  ctx.done = true

is_cancelled: bool = (ctx: any)
  if ctx == nil
    return false
  cur = ctx
  while cur != nil
    if cur.cancelled
      return true
    cur = cur.parent
  false

deadline: any = (ctx: any)
  if ctx == nil
    return nil
  cur = ctx
  while cur != nil
    if has(.deadline)(cur)
      return cur.deadline
    cur = cur.parent
  nil

done: any = (ctx: any)
  if ctx == nil
    return false
  if is_cancelled(ctx)
    return true
  d = deadline(ctx)
  if d != nil
    t = time
    if t.now() >= d
      return true
  false

err: any = (ctx: any)
  if ctx == nil
    return nil
  if is_cancelled(ctx)
    return "context canceled"
  d = deadline(ctx)
  if d != nil
    t = time
    if t.now() >= d
      return "context deadline exceeded"
  nil

value: any = (ctx: any, key: any)
  if ctx == nil
    return nil
  cur = ctx
  while cur != nil
    v = cur(key)
    if v != nil
      return v
    cur = cur.parent
  nil

background = background_ctx()
todo = todo_ctx()
