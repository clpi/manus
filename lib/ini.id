# ini — INI file parser

parse(data: str): any
    lines = data:split("\n")
    res = {}
    current_section = res
    
    for _, line in lines
        line = line:trim()
        if line:len() > 0 and line:sub(1, 1) != ";" and line:sub(1, 1) != "#"
            if line:sub(1, 1) == "[" and line:sub(line:len(), line:len()) == "]"
                sec_name = line:sub(2, line:len() - 1)
                res[sec_name] = {}
                current_section = res[sec_name]
            else
                parts = line:split("=")
                if parts:len() >= 2
                    key = parts[1]:trim()
                    val = parts[2]:trim()
                    current_section[key] = val
                end
            end
        end
    end
    res
end

