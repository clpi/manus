
pid: str = ()
  f = io.open("/proc/self/stat", "r")
  if f
    line = f:read("*l")
    f:close()
    if line
      space_idx = line:find(" ")
      if space_idx
        return line:sub(1, space_idx - 1)
  handle = io.popen("echo $$", "r")
  if handle
    result = handle:read("*l")
    handle:close()
    if result
      return result
  "0"

spawn: i64 = (cmd: str)
  handle = io.popen(cmd .. " 2>&1 & echo $!", "r")
  if handle
    pid_str = handle:read("*l")
    handle:close()
    if pid_str
      return pid_str:to(i64) or 0
  0

kill = (pid: str)
  os.execute("kill " .. pid:to(str) .. " 2>/dev/null")

wait = (pid: str)
  os.execute("wait " .. pid:to(str) .. " 2>/dev/null")
