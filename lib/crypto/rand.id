# std.crypto.rand — cryptographic random number generation (uses /dev/urandom)

@comp.c.include("fcntl.h")
@comp.c.include("unistd.h")

bytes(n: i64): any
    if n == nil or n <= 0 return {} end
    out = {}
    @comp.c.emit([[{
        int fd = open("/dev/urandom", O_RDONLY);
        if (fd >= 0) {
            for (int i = 1; i <= n; i++) {
                uint8_t b;
                if (read(fd, &b, 1) == 1) {
                    lua_table_set_raw(out, lua_val_from_int(i), lua_val_from_int((int64_t)b));
                }
            }
            close(fd);
        }
    }]])
    out
end

hex(n: i64): str
    if n == nil or n <= 0 return "" end
    b = bytes(n)
    res = ""
    for i = 1, n
        res = res .. "%02x":format(b[i])
    end
    res
end

int(max: i64): i64
    if max == nil or max <= 0 return 0 end
    r: i64 = 0
    @comp.c.emit([[{
        int fd = open("/dev/urandom", O_RDONLY);
        if (fd >= 0) { read(fd, &r, sizeof(r)); close(fd); }
    }]])
    r % max
end

prime(bits: i64): i64
    2
end

read(buf: any): i64
    if buf == nil return 0 end
    n: i64 = buf:len()
    b = bytes(n)
    for i = 1, n
        buf[i] = b[i]
    end
    n
end

