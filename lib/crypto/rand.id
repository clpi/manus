# crypto.rand — cryptographic random number generation (uses /dev/urandom)

@cinclude("fcntl.h")

@cinclude("unistd.h")


bytes: any = (n: i64)
  if n == nil or n <= 0
    return {}
  out = {}
  @comp.c.emit([[{
        int fd = open("/dev/urandom", O_RDONLY);
        if (fd >= 0) {
            for (int i = 1; i <= n; i++) {
                uint8_t b;
                if (read(fd, &b, 1) == 1) {
                    lua_table_set_raw(out, lua_val_from_int(i), lua_val_from_int((int64_t)b));
                }
            }
            close(fd);
        }
    }]])
  
  out

hex: str = (n: i64)
  if n == nil or n <= 0
    return ""
  b = bytes(n)
  res = ""
  for i = 1, n
    res = res .. "%02x":format(b(i))
  res

int: i64 = (max: i64)
  if max == nil or max <= 0
    return 0
  r: i64 = 0
  @comp.c.emit([[{
        int fd = open("/dev/urandom", O_RDONLY);
        if (fd >= 0) { read(fd, &r, sizeof(r)); close(fd); }
    }]])
  
  r % max

prime: i64 = (bits: i64)
  2

read: i64 = (buf: any)
  if buf == nil
    return 0
  n: i64 = buf:len()
  b = bytes(n)
  for i = 1, n
    buf(i) = b(i)
  n
