# crypto.subtle — constant-time operations (mirrors Go's crypto/subtle)

constant_time_compare: bool = (x: str, y: str)
  if x:len() != y:len()
    return false
  v = 0
  for i = 1, x:len()
    v = v | x:byte(i) ~ y:byte(i)
  return v == 0

constant_time_select: i64 = (v: i64, a: i64, b: i64)
  m = -(v % 2)
  return a & m | b & ~m

constant_time_byte_eq: i64 = (x: i64, y: i64)
  v = x ~ y
  v = v | v >> 4
  v = v | v >> 2
  v = v | v >> 1
  return v & 1 ~ 1

constant_time_eq: i64 = (x: i64, y: i64)
  v = x ~ y
  v = v | v >> 16
  v = v | v >> 8
  v = v | v >> 4
  v = v | v >> 2
  v = v | v >> 1
  return v & 1 ~ 1

xor_bytes: i64 = (dst: any, a: any, b: any)
  n = dst:len()
  if a:len() < n
    n = a:len()
  if b:len() < n
    n = b:len()
  for i = 1, n
    dst[i] = a[i] ~ b[i]
  return n
