# Round constants
RCON = {
  1,
  2,
  4,
  8,
  16,
  32,
  64,
  128,
  27,
  54
}

# Galois field multiplication
aes_gmul: i64 = (a: i64, b: i64)
  p = 0
  i = 0
  while i < 8
    if b & 1 != 0
      p = p ~ a
    hi = a & 128
    a = a << 1 & 255
    if hi != 0
      a = a ~ 27
    b = b >> 1
    i = i + 1
  p

# ═══════════════════════════════════════════════════════════════
# Key Expansion
# ═══════════════════════════════════════════════════════════════

key_expansion: any = (key: any, key_len: i64)
  if key_len == 16
    nk = 4
    nr = 10
  elseif key_len == 24
    nk = 6
    nr = 12
  else
    nk = 8
    nr = 14
  
w = {}
  i = 0
  while i < nk
    w[i] = { key[i * 4 + 1], key[i * 4 + 2], key[i * 4 + 3], key[i * 4 + 4] }
    i = i + 1
  
i = nk
  while i < 4 * (nr + 1)
    temp = { w[i - 1][1], w[i - 1][2], w[i - 1][3], w[i - 1][4] }
    
if i % nk == 0
      # RotWord + SubWord + Rcon
      temp = {
        SBOX[temp[2] + 1] ~ RCON[i / nk],
        SBOX[temp[3] + 1],
        SBOX[temp[4] + 1],
        SBOX[temp[1] + 1]
      }
    elseif nk > 6 and i % nk == 4
      # SubWord only for AES-256
      temp = {
        SBOX[temp[1] + 1],
        SBOX[temp[2] + 1],
        SBOX[temp[3] + 1],
        SBOX[temp[4] + 1]
      }
    
w[i] = {}
    j = 0
    while j < 4
      w[i][j + 1] = w[i - nk][j + 1] ~ temp[j + 1]
      j = j + 1
    i = i + 1
  
{ round_keys = w, num_rounds = nr }

# ═══════════════════════════════════════════════════════════════
# AES Block Operations
# ═══════════════════════════════════════════════════════════════

aes_sub_bytes: void = (state: any)
  i = 0
  while i < 16
    state[i] = SBOX[state[i] + 1]
    i = i + 1

aes_inv_sub_bytes: void = (state: any)
  i = 0
  while i < 16
    state[i] = AES_INV_SBOX[state[i] + 1]
    i = i + 1

aes_inv_shift_rows: void = (state: any)
  # Row 1: shift right by 1
  temp = state[13]
  state[13] = state[9]
  state[9] = state[5]
  state[5] = state[1]
  state[1] = temp
  
# Row 2: shift right by 2
  temp = state[2]
  state[2] = state[10]
  state[10] = temp
  temp = state[6]
  state[6] = state[14]
  state[14] = temp
  
# Row 3: shift right by 3
  temp = state[3]
  state[3] = state[7]
  state[7] = state[11]
  state[11] = state[15]
  state[15] = temp

aes_inv_mix_columns: void = (state: any)
  col = 0
  while col < 4
    s0 = state[col * 4]
    s1 = state[col * 4 + 1]
    s2 = state[col * 4 + 2]
    s3 = state[col * 4 + 3]
    
state[col * 4] = aes_gmul(s0, 14) ~ aes_gmul(s1, 11) ~ aes_gmul(s2, 13) ~ aes_gmul(s3, 9)
    state[col * 4 + 1] = aes_gmul(s0, 9) ~ aes_gmul(s1, 14) ~ aes_gmul(s2, 11) ~ aes_gmul(s3, 13)
    state[col * 4 + 2] = aes_gmul(s0, 13) ~ aes_gmul(s1, 9) ~ aes_gmul(s2, 14) ~ aes_gmul(s3, 11)
    state[col * 4 + 3] = aes_gmul(s0, 11) ~ aes_gmul(s1, 13) ~ aes_gmul(s2, 9) ~ aes_gmul(s3, 14)
    col = col + 1

aes_shift_rows: void = (state: any)
  # Row 1: shift left by 1
  temp = state[1]
  state[1] = state[5]
  state[5] = state[9]
  state[9] = state[13]
  state[13] = temp
  
# Row 2: shift left by 2
  temp = state[2]
  state[2] = state[10]
  state[10] = temp
  temp = state[6]
  state[6] = state[14]
  state[14] = temp
  
# Row 3: shift left by 3
  temp = state[15]
  state[15] = state[11]
  state[11] = state[7]
  state[7] = state[3]
  state[3] = temp

aes_mix_columns: void = (state: any)
  col = 0
  while col < 4
    s0 = state[col * 4]
    s1 = state[col * 4 + 1]
    s2 = state[col * 4 + 2]
    s3 = state[col * 4 + 3]
    
state[col * 4] = aes_gmul(s0, 2) ~ aes_gmul(s1, 3) ~ s2 ~ s3
    state[col * 4 + 1] = s0 ~ aes_gmul(s1, 2) ~ aes_gmul(s2, 3) ~ s3
    state[col * 4 + 2] = s0 ~ s1 ~ aes_gmul(s2, 2) ~ aes_gmul(s3, 3)
    state[col * 4 + 3] = aes_gmul(s0, 3) ~ s1 ~ s2 ~ aes_gmul(s3, 2)
    col = col + 1

aes_add_round_key: void = (state: any, w: any, round: i64)
  i = 0
  while i < 16
    state[i] = state[i] ~ w[round * 4 + i / 4][i % 4 + 1]
    i = i + 1

# ═══════════════════════════════════════════════════════════════
# AES Encrypt Block (single 16-byte block)
# ═══════════════════════════════════════════════════════════════

encrypt_block: any = (block: any, expanded_key: any)
  state = {}
  i = 0
  while i < 16
    state[i] = block[i]
    i = i + 1
  
w = expanded_key.round_keys
  nr = expanded_key.num_rounds
  
# Initial round key addition
  aes_add_round_key(state, w, 0)
  
# Main rounds
  round = 1
  while round < nr
    aes_sub_bytes(state)
    aes_shift_rows(state)
    aes_mix_columns(state)
    aes_add_round_key(state, w, round)
    round = round + 1
  
# Final round (no MixColumns)
  aes_sub_bytes(state)
  aes_shift_rows(state)
  aes_add_round_key(state, w, nr)
  
state

# ═══════════════════════════════════════════════════════════════
# AES Decrypt Block
# ═══════════════════════════════════════════════════════════════

decrypt_block: any = (block: any, expanded_key: any)
  state = {}
  i = 0
  while i < 16
    state[i] = block[i]
    i = i + 1
  
w = expanded_key.round_keys
  nr = expanded_key.num_rounds
  
aes_add_round_key(state, w, nr)
  
round = nr - 1
  while round >= 1
    aes_inv_shift_rows(state)
    aes_inv_sub_bytes(state)
    aes_add_round_key(state, w, round)
    if round > 1
      aes_inv_mix_columns(state)
    round = round - 1
  
aes_inv_shift_rows(state)
  aes_inv_sub_bytes(state)
  aes_add_round_key(state, w, 0)
  
state

# ═══════════════════════════════════════════════════════════════
# AES-CBC Mode
# ═══════════════════════════════════════════════════════════════

cbc_encrypt: any = (plaintext: any, key: any, iv: any)
  key_len = key:len()
  expanded = key_expansion(key, key_len)
  
# PKCS7 padding
  pad_len = 16 - plaintext:len() % 16
  padded = {}
  for i = 1, plaintext:len()
    padded[padded:len() + 1] = plaintext[i]
  i = 0
  while i < pad_len
    padded[padded:len() + 1] = pad_len
    i = i + 1
  
ciphertext = {}
  prev = iv
  
block_idx = 1
  while block_idx <= padded:len()
    block = {}
    i = 0
    while i < 16
      block[i] = padded[block_idx + i] ~ prev[i + 1]
      i = i + 1
    
encrypted = encrypt_block(block, expanded)
    for i = 0, 15
      ciphertext[ciphertext:len() + 1] = encrypted[i]
    # Convert to 1-based for consistent XOR in next iteration
    prev = {}
    for i = 0, 15
      prev[i + 1] = encrypted[i]
    block_idx = block_idx + 16
  
ciphertext

cbc_decrypt: any = (ciphertext: any, key: any, iv: any)
  key_len = key:len()
  expanded = key_expansion(key, key_len)
  
plaintext = {}
  prev = iv
  
block_idx = 1
  while block_idx <= ciphertext:len()
    block = {}
    i = 0
    while i < 16
      block[i] = ciphertext[block_idx + i]
      i = i + 1
    
decrypted = decrypt_block(block, expanded)
    for i = 0, 15
      plaintext[plaintext:len() + 1] = decrypted[i] ~ prev[i + 1]
    # Convert current ciphertext block to 1-based for next iteration
    prev = {}
    for i = 0, 15
      prev[i + 1] = block[i]
    block_idx = block_idx + 16
  
# Remove PKCS7 padding
  if plaintext:len() > 0
    pad = plaintext[plaintext:len()]
    if pad >= 1 and pad <= 16
      i = plaintext:len() - pad + 1
      while i <= plaintext:len()
        if plaintext[i] != pad
          return plaintext
        i = i + 1
      # Valid padding, trim
      new_len = plaintext:len() - pad
      trimmed = {}
      i = 1
      while i <= new_len
        trimmed[i] = plaintext[i]
        i = i + 1
      return trimmed
  plaintext

# ═══════════════════════════════════════════════════════════════
# AES-CTR Mode (stream cipher)
# ═══════════════════════════════════════════════════════════════

ctr_crypt: any = (data: any, key: any, nonce: any)
  key_len = key:len()
  expanded = key_expansion(key, key_len)
  
counter = {}
  i = 0
  while i < 16
    counter[i] = nonce[i + 1] or 0
    i = i + 1
  
output = {}
  block_idx = 0
  while block_idx < data:len()
    keystream = encrypt_block(counter, expanded)
    
byte_idx = 0
    while byte_idx < 16 and block_idx + byte_idx < data:len()
      output[output:len() + 1] = data[block_idx + byte_idx + 1] ~ keystream[byte_idx]
      byte_idx = byte_idx + 1
    
# Increment counter
    i = 15
    while i >= 0
      counter[i] = (counter[i] + 1) & 255
      if counter[i] != 0
        break
      i = i - 1
    
block_idx = block_idx + 16
  
output

# ═══════════════════════════════════════════════════════════════
# Utility functions
# ═══════════════════════════════════════════════════════════════

string_to_bytes: any = (s: str)
  bytes = {}
  i = 1
  while i <= s:len()
    bytes[bytes:len() + 1] = s:byte(i)
    i = i + 1
  bytes

bytes_to_string: str = (bytes: any)
  parts = {}
  i = 1
  while i <= bytes:len()
    parts[parts:len() + 1] = bytes[i]:char()
    i = i + 1
  parts:concat()
