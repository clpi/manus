
h = hash

hmac: str = (hash: any, key: str, message: str, block: i64)
  if block == nil
    block = 64
  if key:len() > block
    key = hash(key)
  while key:len() < block
    key = key .. 0:char()
  inner = ""
  outer = ""
  i = 1
  while i <= block
    k = key:byte(i)
    inner = (inner .. k) ~ 54:char()
    outer = (outer .. k) ~ 92:char()
    i = i + 1
  digest = hash(inner .. message)
  hash(outer .. digest)

hmac_sha256: str = (key: str, message: str)
  hmac(crypto.sha256, key, message, 64)

hmac_sha256_bytes: str = (key: str, message: str)
  hex = hmac_sha256(key, message)
  bytes = {}
  i = 1
  while i <= 64
    val = tonumber(hex:sub(i, i + 1), 16)
    bytes[bytes:len() + 1] = val:char()
    i = i + 2
  return bytes:concat()

hmac_sha1: str = (key: str, message: str)
  hmac(crypto.sha1, key, message, 64)

hmac_md5: str = (key: str, message: str)
  hmac(h.md5, key, message, 64)

hmac_fnv1a: str = (key: str, message: str)
  hmac(h.fnv1a, key, message, 64)

equal: bool = (a: str, b: str)
  if a:len() != b:len()
    return false
  result = 0
  i = 1
  while i <= a:len()
    result = result | a:byte(i) ~ b:byte(i)
    i = i + 1
  result == 0
