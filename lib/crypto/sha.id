# std.crypto_sha — SHA-1 and SHA-256 hash implementations
# These are pure-Duo implementations of SHA-1 and SHA-256. They operate on
# byte strings and produce hex-encoded digests.
# Note: rotate-right (ror) is inlined at each call site because duo's typed
# local functions expect int64_t, while table indexing yields lua_Value.

# SHA-1 implementation

# sha1: compute SHA-1 digest of string s, return as 40-char hex string.
sha1(s: str): str
    if s == nil s = "" end
    # padding: append 0x80, then zeros, then 64-bit length
    msg = s .. 0x80:char()
    while msg:len() % 64 != 56
        msg = msg .. 0:char()
    end
    # append length in bits as big-endian 64-bit
    bits = s:len() * 8
    # high 32 bits (usually 0 for small inputs)
    msg = msg .. 0:char(0, 0, 0)
    # low 32 bits
    msg = msg .. string.char(
        (bits / 16777216) % 256,
        (bits / 65536) % 256,
        (bits / 256) % 256,
        bits % 256
    )
    # initial hash values
    h0 = 0x67452301
    h1 = 0xEFCDAB89
    h2 = 0x98BADCFE
    h3 = 0x10325476
    h4 = 0xC3D2E1F0
    # process each 64-byte block
    block = 0
    blocks = msg:len() / 64
    while block < blocks
        w = {}
        j = 0
        while j < 16
            off = block * 64 + j * 4 + 1
            w[j + 1] = msg:byte(off) * 16777216 + msg:byte(off + 1) * 65536 + msg:byte(off + 2) * 256 + msg:byte(off + 3)
            w[j + 1] = w[j + 1] % (2^32)
            j += 1
        end
        j = 16
        while j < 80
            v = w[j - 3] ~ w[j - 8] ~ w[j - 14] ~ w[j - 16]
            w[j + 1] = ((v << 1) | (v >> 31)) % (2^32)
            j += 1
        end
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        j = 0
        while j < 80
            f = 0
            k = 0
            if j < 20
                f = (b & c) | ((~b) & d)
                k = 0x5A827999
            elseif j < 40
                f = b ~ c ~ d
                k = 0x6ED9EBA1
            elseif j < 60
                f = (b & c) | (b & d) | (c & d)
                k = 0x8F1BBCDC
            else
                f = b ~ c ~ d
                k = 0xCA62C1D6
            end
            temp = (((a << 5) | (a >> 27)) + f + e + k + w[j + 1]) % (2^32)
            e = d
            d = c
            c = ((b << 30) | (b >> 2)) % (2^32)
            b = a
            a = temp
            j += 1
        end
        h0 = (h0 + a) % (2^32)
        h1 = (h1 + b) % (2^32)
        h2 = (h2 + c) % (2^32)
        h3 = (h3 + d) % (2^32)
        h4 = (h4 + e) % (2^32)
        block += 1
    end
    "%08x%08x%08x%08x%08x":format(h0, h1, h2, h3, h4)
end

# SHA-256 implementation

# sha256: compute SHA-256 digest of string s, return as 64-char hex string.
sha256(s: str): str
    if s == nil s = "" end
    # SHA-256 constants
    K = {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    }
    # padding
    msg = s .. 0x80:char()
    while msg:len() % 64 != 56
        msg = msg .. 0:char()
    end
    bits = s:len() * 8
    msg = msg .. 0:char(0, 0, 0)
    msg = msg .. string.char(
        (bits / 16777216) % 256,
        (bits / 65536) % 256,
        (bits / 256) % 256,
        bits % 256
    )
    # initial hash values
    hv0 = 0x6a09e667
    hv1 = 0xbb67ae85
    hv2 = 0x3c6ef372
    hv3 = 0xa54ff53a
    hv4 = 0x510e527f
    hv5 = 0x9b05688c
    hv6 = 0x1f83d9ab
    hv7 = 0x5be0cd19
    block = 0
    blocks = msg:len() / 64
    while block < blocks
        w = {}
        j = 0
        while j < 16
            off = block * 64 + j * 4 + 1
            w[j + 1] = msg:byte(off) * 16777216 + msg:byte(off + 1) * 65536 + msg:byte(off + 2) * 256 + msg:byte(off + 3)
            w[j + 1] = w[j + 1] % (2^32)
            j += 1
        end
        j = 16
        while j < 64
            # s0 = ror(w[j-14+1], 7) ^ ror(w[j-14+1], 18) ^ (w[j-14+1] >> 3)
            wt = w[j - 14 + 1]
            s0 = (((wt >> 7) | (wt << 25)) % (2^32)) ~ (((wt >> 18) | (wt << 14)) % (2^32)) ~ (wt >> 3)
            # s1 = ror(w[j-15+1], 17) ^ ror(w[j-15+1], 19) ^ (w[j-15+1] >> 10)
            wt2 = w[j - 15 + 1]
            s1 = (((wt2 >> 17) | (wt2 << 15)) % (2^32)) ~ (((wt2 >> 19) | (wt2 << 13)) % (2^32)) ~ (wt2 >> 10)
            w[j + 1] = (w[j + 1] + s0 + w[j - 7 + 1] + s1) % (2^32)
            j += 1
        end
        a = hv0
        b = hv1
        c = hv2
        d = hv3
        e = hv4
        f = hv5
        g = hv6
        h = hv7
        j = 0
        while j < 64
            # S1 = ror(e, 6) ^ ror(e, 11) ^ ror(e, 25)
            S1 = (((e >> 6) | (e << 26)) % (2^32)) ~ (((e >> 11) | (e << 21)) % (2^32)) ~ (((e >> 25) | (e << 7)) % (2^32))
            ch = (e & f) | ((~e) & g)
            temp1 = (h + S1 + ch + K[j + 1] + w[j + 1]) % (2^32)
            # S0 = ror(a, 2) ^ ror(a, 13) ^ ror(a, 22)
            S0 = (((a >> 2) | (a << 30)) % (2^32)) ~ (((a >> 13) | (a << 19)) % (2^32)) ~ (((a >> 22) | (a << 10)) % (2^32))
            maj = (a & b) | (a & c) | (b & c)
            temp2 = (S0 + maj) % (2^32)
            h = g
            g = f
            f = e
            e = (d + temp1) % (2^32)
            d = c
            c = b
            b = a
            a = (temp1 + temp2) % (2^32)
            j += 1
        end
        hv0 = (hv0 + a) % (2^32)
        hv1 = (hv1 + b) % (2^32)
        hv2 = (hv2 + c) % (2^32)
        hv3 = (hv3 + d) % (2^32)
        hv4 = (hv4 + e) % (2^32)
        hv5 = (hv5 + f) % (2^32)
        hv6 = (hv6 + g) % (2^32)
        hv7 = (hv7 + h) % (2^32)
        block += 1
    end
    "%08x%08x%08x%08x%08x%08x%08x%08x":format(hv0, hv1, hv2, hv3, hv4, hv5, hv6, hv7)
end

# sha1_hex: alias for sha1 (returns hex).
sha1_hex(s: str): str
    sha1(s)
end

# sha256_hex: alias for sha256.
sha256_hex(s: str): str
    sha256(s)
end

