
reader: any = (fh: any, size: i64)
  if size == nil or size <= 0
    size = 4096
  { fh = fh, buf = "", pos = 1, size = size, err = nil }

fill: any = (r: any)
  chunk = r.fh:read(r.size)
  if chunk == nil
    r.err = "EOF"
    return r
  r.buf = r.buf:sub(r.pos) .. chunk
  r.pos = 1
  r

line: any = (r: any)
  while true
    remaining = r.buf:sub(r.pos)
    nl = remaining:find("\n", 1, true)
    if nl != nil
      line = remaining:sub(1, nl - 1)
      if line:len() > 0 and line:sub(line:len(), line:len()) == "\r"
        line = line:sub(1, line:len() - 1)
      r.pos = r.pos + nl
      return line, true
    was = r.buf:sub(r.pos):len()
    fill(r)
    if has(.err)(r)
      left = r.buf:sub(r.pos)
      if left:len() > 0
        r.pos = r.buf:len() + 1
        return left, true
      return "", false
  return "", false

read: any = (r: any, n: i64)
  while r.buf:sub(r.pos):len() < n
    fill(r)
    if has(.err)(r)
      left = r.buf:sub(r.pos)
      if left:len() > 0
        r.pos = r.buf:len() + 1
        return left, true
      return "", false
  data = r.buf:sub(r.pos, r.pos + n - 1)
  r.pos = r.pos + n
  return data, true

text: any = (r: any, n: i64)
  read(r, n)

byte: any = (r: any)
  while r.pos > r.buf:len()
    fill(r)
    if has(.err)(r)
      return 0, false
  b = r.buf:byte(r.pos)
  r.pos = r.pos + 1
  return b, true

unread: any = (r: any)
  if r.pos > 1
    r.pos = r.pos - 1
  r

peek: any = (r: any, n: i64)
  while r.buf:sub(r.pos):len() < n
    fill(r)
    if has(.err)(r)
      break
  r.buf:sub(r.pos, r.pos + n - 1)


scanner: any = (fh: any, delim: str)
  if delim == nil
    delim = "\n"
  { fh = fh, buf = "", pos = 1, delim = delim, done = false, size = 4096 }

scan: bool = (s: any)
  if s.done
    return false
  while true
    remaining = s.buf:sub(s.pos)
    pos = remaining:find(s.delim, 1, true)
    if pos != nil
      s.token = remaining:sub(1, pos - 1)
      s.pos = s.pos + pos + s.delim:len() - 1
      return true
    chunk = s.fh:read(s.size)
    if chunk == nil
      s.done = true
      left = s.buf:sub(s.pos)
      if left:len() > 0
        s.token = left
        s.pos = s.buf:len() + 1
        return true
      return false
    s.buf = s.buf:sub(s.pos) .. chunk
    s.pos = 1
  false

token: str = (s: any)
  s.token

bytes: str = (s: any)
  s.token


writer: any = (fh: any, size: i64)
  if size == nil or size <= 0
    size = 4096
  { fh = fh, buf = "", size = size }

flush: any = (w: any)
  if w.buf:len() > 0
    w.fh:write(w.buf)
    w.buf = ""
  w

write: any = (w: any, s: str)
  w.buf = w.buf .. s
  if w.buf:len() >= w.size
    flush(w)
  w

put: any = (w: any, b: i64)
  w.buf = w.buf .. b:char()
  if w.buf:len() >= w.size
    flush(w)
  w

close: any = (w: any)
  flush(w)
  w.fh:close()
  w
