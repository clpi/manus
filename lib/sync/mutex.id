
mutex: any = ()
  { locked = false }

lock = (m: any)
  while m.locked
    co = coroutine
    co.yield()
  m.locked = true

unlock = (m: any)
  m.locked = false

probe: bool = (m: any)
  if m.locked
    return false
  m.locked = true
  true

rwmutex: any = ()
  { writers = 0, readers = 0, writing = false }

rlock = (m: any)
  while m.writing
    co = coroutine
    co.yield()
  m.readers = m.readers + 1

runlock = (m: any)
  m.readers = m.readers - 1
  if m.readers < 0
    m.readers = 0

wlock = (m: any)
  while m.writing or m.readers > 0
    co = coroutine
    co.yield()
  m.writing = true

wunlock = (m: any)
  m.writing = false
