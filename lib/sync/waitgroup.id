
waitgroup: any = ()
  { count = 0 }

add = (wg: any, delta: i64)
  if delta == nil
    delta = 1
  wg.count = wg.count + delta

done = (wg: any)
  wg.count = wg.count - 1
  if wg.count < 0
    wg.count = 0

wait: bool = (wg: any)
  wg.count == 0

block = (wg: any)
  while wg.count > 0
    co = coroutine
    co.yield()

count: i64 = (wg: any)
  wg.count
