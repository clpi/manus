# sync_waitgroup — WaitGroup (mirrors Go's sync.WaitGroup)
# In Duo (cooperative concurrency), a WaitGroup tracks pending tasks and
# allows waiting for all to complete. Since Duo has cooperative async, the
# "wait" is a busy-check loop yielding to the scheduler.

# waitgroup: create a new WaitGroup.
waitgroup: any = ()
  { count = 0 }

# add: increment the wait counter by delta (default 1).
add = (wg: any, delta: i64)
  if delta == nil
    delta = 1
  wg.count = wg.count + delta

# done: decrement the wait counter by 1.
done = (wg: any)
  wg.count = wg.count - 1
  if wg.count < 0
    wg.count = 0

# wait: return true when all tasks are done (count == 0).
# In cooperative mode, this is non-blocking; the caller should check repeatedly.
wait: bool = (wg: any)
  wg.count == 0

# block: block until count == 0, yielding between checks.
block = (wg: any)
  while wg.count > 0
    # yield to scheduler if available
    co = coroutine
    co.yield()

# count: return the current pending count.
count: i64 = (wg: any)
  wg.count
