# os.signal — Signal handling for runtime
# Used by ward to handle process signals and clean shutdown.

# ═══════════════════════════════════════════════════════════════
# Signal Constants
# ═══════════════════════════════════════════════════════════════

SIGHUP = 1
SIGINT = 2
SIGQUIT = 3
SIGKILL = 9
SIGUSR1 = 10
SIGUSR2 = 12
SIGPIPE = 13
SIGALRM = 14
SIGTERM = 15
SIGSTOP = 17
SIGCONT = 19
SIGCHLD = 20
SIGTSTP = 20
SIGTTIN = 21
SIGTTOU = 22
SIGPROF = 27
SIGWINCH = 28

# ═══════════════════════════════════════════════════════════════
# Signal Handler Registry
# ═══════════════════════════════════════════════════════════════

handler_new: any = ()
  {
    handlers = {},
    default_handlers = {},
    signal_queue = {},
    blocked = {}
  }

register = (handler: any, sig: i64, callback: any)
  handler.handlers(sig) = callback

unregister = (handler: any, sig: i64)
  handler.handlers(sig) = nil

block = (handler: any, sig: i64)
  handler.blocked(sig) = true

unblock = (handler: any, sig: i64)
  handler.blocked(sig) = nil

emit = (handler: any, sig: i64)
  if handler.blocked(sig)
    handler.signal_queue(handler.signal_queue:len() + 1) = sig
    return

  if handler.handlers(sig)
    handler.handlers(sig)(sig)

process_queue = (handler: any)
  while handler.signal_queue:len() > 0
    sig = handler.signal_queue(1)
    handler.signal_queue:remove(1)
    if not handler.blocked(sig) and handler.handlers(sig)
      handler.handlers(sig)(sig)

# ═══════════════════════════════════════════════════════════════
# Signal Utilities
# ═══════════════════════════════════════════════════════════════

name: str = (sig: i64)
  names = {
    [SIGHUP] = "SIGHUP",
    [SIGINT] = "SIGINT",
    [SIGQUIT] = "SIGQUIT",
    [SIGKILL] = "SIGKILL",
    [SIGUSR1] = "SIGUSR1",
    [SIGUSR2] = "SIGUSR2",
    [SIGPIPE] = "SIGPIPE",
    [SIGALRM] = "SIGALRM",
    [SIGTERM] = "SIGTERM",
    [SIGSTOP] = "SIGSTOP",
    [SIGCONT] = "SIGCONT",
    [SIGCHLD] = "SIGCHLD",
    [SIGTSTP] = "SIGTSTP",
    [SIGTTIN] = "SIGTTIN",
    [SIGTTOU] = "SIGTTOU",
    [SIGPROF] = "SIGPROF",
    [SIGWINCH] = "SIGWINCH"
  }
  names(sig) or "UNKNOWN"

from_name: i64 = (name: str)
  names = {
    HUP = SIGHUP,
    INT = SIGINT,
    QUIT = SIGQUIT,
    KILL = SIGKILL,
    USR1 = SIGUSR1,
    USR2 = SIGUSR2,
    PIPE = SIGPIPE,
    ALRM = SIGALRM,
    TERM = SIGTERM,
    STOP = SIGSTOP,
    CONT = SIGCONT,
    CHLD = SIGCHLD,
    TSTP = SIGTSTP,
    TTIN = SIGTTIN,
    TTOU = SIGTTOU,
    PROF = SIGPROF,
    WINCH = SIGWINCH
  }
  # Remove SIG prefix if present
  clean = name
  if name:sub(1, 3) == "SIG"
    clean = name:sub(4)
  names(clean) or 0

is_fatal: bool = (sig: i64)
  sig == SIGKILL or sig == SIGTERM or sig == SIGHUP

is_stop: bool = (sig: i64)
  sig == SIGSTOP or sig == SIGTSTP or sig == SIGTTIN or sig == SIGTTOU

is_continue: bool = (sig: i64)
  sig == SIGCONT

# ═══════════════════════════════════════════════════════════════
# Graceful Shutdown Handler
# ═══════════════════════════════════════════════════════════════

shutdown_new: any = ()
  {
    handler = handler_new(),
    shutdown_hooks = {},
    is_shutting_down = false,
    shutdown_timeout = 30
  }

shutdown_register = (sh: any, callback: any)
  sh.shutdown_hooks(sh.shutdown_hooks:len() + 1) = callback

shutdown_trigger = (sh: any)
  if sh.is_shutting_down
    return
  sh.is_shutting_down = true

  # Run hooks in reverse order
  i = sh.shutdown_hooks:len()
  while i >= 1
    sh.shutdown_hooks(i)()
    i = i - 1

shutdown_is_active: bool = (sh: any)
  sh.is_shutting_down

shutdown_setup = (sh: any)
  # Register signal handlers for graceful shutdown
  register(sh.handler, SIGTERM, fun(sig)
    print("Received SIGTERM, shutting down...")
    shutdown_trigger(sh)
  end)

  register(sh.handler, SIGINT, fun(sig)
    print("Received SIGINT, shutting down...")
    shutdown_trigger(sh)
  end)

  register(sh.handler, SIGHUP, fun(sig)
    print("Received SIGHUP, reloading...")
  end)
