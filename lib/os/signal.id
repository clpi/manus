# os.signal — Signal handling for runtime
# Used by ward to handle process signals and clean shutdown.

# ═══════════════════════════════════════════════════════════════
# Signal Constants
# ═══════════════════════════════════════════════════════════════

SIGHUP = 1
SIGINT = 2
SIGQUIT = 3
SIGKILL = 9
SIGUSR1 = 10
SIGUSR2 = 12
SIGPIPE = 13
SIGALRM = 14
SIGTERM = 15
SIGSTOP = 17
SIGCONT = 19
SIGCHLD = 20
SIGTSTP = 20
SIGTTIN = 21
SIGTTOU = 22
SIGPROF = 27
SIGWINCH = 28

# ═══════════════════════════════════════════════════════════════
# Signal Handler Registry
# ═══════════════════════════════════════════════════════════════

handler_new(): any
    {
        handlers = {},
        default_handlers = {},
        signal_queue = {},
        blocked = {},
    }
end

register(handler: any, sig: i64, callback: any): void
    handler.handlers[sig] = callback
end

unregister(handler: any, sig: i64): void
    handler.handlers[sig] = nil
end

block(handler: any, sig: i64): void
    handler.blocked[sig] = true
end

unblock(handler: any, sig: i64): void
    handler.blocked[sig] = nil
end

emit(handler: any, sig: i64): void
    if handler.blocked[sig]
        handler.signal_queue[handler:len().signal_queue + 1] = sig
        return
    end

    if handler.handlers[sig]
        handler.handlers[sig](sig)
    end
end

process_queue(handler: any): void
    while handler:len().signal_queue > 0
        sig = handler.signal_queue[1]
        handler.signal_queue:remove(1)
        if not handler.blocked[sig] and handler.handlers[sig]
            handler.handlers[sig](sig)
        end
    end
end

# ═══════════════════════════════════════════════════════════════
# Signal Utilities
# ═══════════════════════════════════════════════════════════════

name(sig: i64): str
    names = {
        [SIGHUP] = "SIGHUP",
        [SIGINT] = "SIGINT",
        [SIGQUIT] = "SIGQUIT",
        [SIGKILL] = "SIGKILL",
        [SIGUSR1] = "SIGUSR1",
        [SIGUSR2] = "SIGUSR2",
        [SIGPIPE] = "SIGPIPE",
        [SIGALRM] = "SIGALRM",
        [SIGTERM] = "SIGTERM",
        [SIGSTOP] = "SIGSTOP",
        [SIGCONT] = "SIGCONT",
        [SIGCHLD] = "SIGCHLD",
        [SIGTSTP] = "SIGTSTP",
        [SIGTTIN] = "SIGTTIN",
        [SIGTTOU] = "SIGTTOU",
        [SIGPROF] = "SIGPROF",
        [SIGWINCH] = "SIGWINCH",
    }
    names[sig] or "UNKNOWN"
end

from_name(name: str): i64
    names = {
        HUP = SIGHUP,
        INT = SIGINT,
        QUIT = SIGQUIT,
        KILL = SIGKILL,
        USR1 = SIGUSR1,
        USR2 = SIGUSR2,
        PIPE = SIGPIPE,
        ALRM = SIGALRM,
        TERM = SIGTERM,
        STOP = SIGSTOP,
        CONT = SIGCONT,
        CHLD = SIGCHLD,
        TSTP = SIGTSTP,
        TTIN = SIGTTIN,
        TTOU = SIGTTOU,
        PROF = SIGPROF,
        WINCH = SIGWINCH,
    }
    # Remove SIG prefix if present
    clean = name
    if name:sub(1, 3) == "SIG"
        clean = name:sub(4)
    end
    names[clean] or 0
end

is_fatal(sig: i64): bool
    sig == SIGKILL or sig == SIGTERM or sig == SIGHUP
end

is_stop(sig: i64): bool
    sig == SIGSTOP or sig == SIGTSTP or sig == SIGTTIN or sig == SIGTTOU
end

is_continue(sig: i64): bool
    sig == SIGCONT
end

# ═══════════════════════════════════════════════════════════════
# Graceful Shutdown Handler
# ═══════════════════════════════════════════════════════════════

shutdown_new(): any
    {
        handler = handler_new(),
        shutdown_hooks = {},
        is_shutting_down = false,
        shutdown_timeout = 30,
    }
end

shutdown_register(sh: any, callback: any): void
    sh.shutdown_hooks[sh:len().shutdown_hooks + 1] = callback
end

shutdown_trigger(sh: any): void
    if sh.is_shutting_down return end
    sh.is_shutting_down = true

    # Run hooks in reverse order
    i = sh:len().shutdown_hooks
    while i >= 1
        sh.shutdown_hooks[i]()
        i -= 1
    end
end

shutdown_is_active(sh: any): bool
    sh.is_shutting_down
end

shutdown_setup(sh: any): void
    # Register signal handlers for graceful shutdown
    register(sh.handler, SIGTERM, function(sig)
        print("Received SIGTERM, shutting down...")
        shutdown_trigger(sh)
    end)

    register(sh.handler, SIGINT, function(sig)
        print("Received SIGINT, shutting down...")
        shutdown_trigger(sh)
    end)

    register(sh.handler, SIGHUP, function(sig)
        print("Received SIGHUP, reloading...")
    end)
end

