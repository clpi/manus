echo = (msg: str)
  print(msg)

run: i64 = (cmd: str)
  rc = os.execute(cmd)
  if rc == nil
    return -1
  if rc == true
    return 0
  if rc:to(str) == "0"
    return 0
  1

status: i64 = (cmd: str)
  to(i64)(capture("( " .. cmd .. " ) >/dev/null 2>&1; echo $?"))

ok: bool = (cmd: str)
  run(cmd) == 0

must = (cmd: str)
  if !ok(cmd)
    echo("FAIL: " .. cmd)
    os.exit(1)

capture: str = (cmd: str)
  h = io.popen(cmd .. " 2>/dev/null", "r")
  if h == nil
    return ""
  body = h:read("*a")
  h:close()
  if body == nil
    return ""
  body

idol_bin: str = ()
  "./zig-out/bin/idol"

idol_run = (path: str, bin: str)
  echo("agent-smoke: idol run " .. path)
  must(bin .. " run " .. path)

idol_run_all = (paths: any, bin: str)
  for _, path in paths
    idol_run(path, bin)

zig_build = ()
  if os.env("DUO_ALREADY_BUILT") == "1"
    echo("agent-smoke: zig build skipped (DUO_ALREADY_BUILT)")
    return
  must("zig build")

zig_test_file = (path: str)
  must("zig test " .. path)


getenv: str = (name: str, fallback: str)
  v = env(name)
  if v == nil
    return fallback
  if v == ""
    return fallback
  v

getenv_or: str = (name: str)
  v = env(name)
  if v == nil
    return ""
  v

env_set = (name: str, value: str)
  env(name) = value


path_join: str = (a: str, b: str)
  if a == ""
    return b
  if b == ""
    return a
  sep = "/"
  if a:sub(-1) == sep
    return a .. b
  a .. sep .. b

path_basename: str = (p: str)
  pos = 0
  for i = p:len(), 1, -1
    if p:sub(i, i) == "/"
      pos = i
      break
  if pos == 0
    return p
  p:sub(pos + 1)

path_dirname: str = (p: str)
  pos = 0
  for i = p:len(), 1, -1
    if p:sub(i, i) == "/"
      pos = i
      break
  if pos == 0
    return "."
  if pos == 1
    return "/"
  p:sub(1, pos - 1)

path_ext: str = (p: str)
  base = path_basename(p)
  pos = 0
  for i = base:len(), 1, -1
    if base:sub(i, i) == "."
      pos = i
      break
  if pos == 0
    return ""
  base:sub(pos)

path_stem: str = (p: str)
  base = path_basename(p)
  ext = path_ext(base)
  if ext == ""
    return base
  base:sub(1, base:len() - ext:len())


fs_exists: bool = (p: str)
  ok("test -e '" .. p .. "'")

fs_is_file: bool = (p: str)
  ok("test -f '" .. p .. "'")

fs_is_dir: bool = (p: str)
  ok("test -d '" .. p .. "'")

fs_read: str = (p: str)
  h = io.open(p, "r")
  if h == nil
    return ""
  body = h:read("*a")
  h:close()
  if body == nil
    return ""
  body

fs_write = (p: str, content: str)
  must("printf '%s' '" .. content:gsub("'", "'\\''") .. "' > '" .. p .. "'")

fs_mkdir = (p: str)
  must("mkdir -p '" .. p .. "'")

fs_glob: any = (pattern: str)
  out = {}
  text = capture("ls -1 " .. pattern .. " 2>/dev/null")
  line = ""
  n = text:len()
  i = 1
  while i <= n + 1
    boundary = false
    if i > n
      boundary = true
    else
      if text:byte(i) == 10
        boundary = true
    if boundary
      if line:len() > 0
        out[out:len() + 1] = line
      line = ""
    else
      line = line .. text:sub(i, i)
    i = i + 1
  return out

fs_cp = (src: str, dst: str)
  must("cp -R '" .. src .. "' '" .. dst .. "'")

fs_mv = (src: str, dst: str)
  must("mv '" .. src .. "' '" .. dst .. "'")

fs_rm = (path: str)
  must("rm -rf '" .. path .. "'")

chomp: str = (s: str)
  n = s:len()
  while n > 0 and s:byte(n) == 10
    n = n - 1
  s:sub(1, n)

fs_tmp: str = ()
  chomp(capture("mktemp 2>/dev/null"))

fs_tmpdir: str = ()
  chomp(capture("mktemp -d 2>/dev/null"))


pipe: str = (cmd1: str, cmd2: str)
  capture(cmd1 .. " | " .. cmd2)

pipe_ok: bool = (cmd1: str, cmd2: str)
  ok(cmd1 .. " | " .. cmd2)

args: any = ()
  os.args

arg: str = (n: i64, fallback: str)
  a = args()
  if a == nil or n < 1 or n > a:len()
    return fallback
  return a[n]


exec: any = (cmd: str)
  out = capture(cmd .. " 2>&1")
  code = status(cmd)
  { output = out, code = code }

M =
  echo = echo
  run = run
  exec = exec
  ok = ok
  must = must
  capture = capture
  idol_bin = idol_bin
  idol_run = idol_run
  idol_run_all = idol_run_all
  zig_build = zig_build
  zig_test_file = zig_test_file
  getenv = getenv
  getenv_or = getenv_or
  env_set = env_set
  path_join = path_join
  path_basename = path_basename
  path_dirname = path_dirname
  path_ext = path_ext
  path_stem = path_stem
  fs_exists = fs_exists
  fs_is_file = fs_is_file
  fs_is_dir = fs_is_dir
  fs_read = fs_read
  fs_write = fs_write
  fs_mkdir = fs_mkdir
  fs_glob = fs_glob
  fs_cp = fs_cp
  fs_mv = fs_mv
  fs_rm = fs_rm
  fs_tmp = fs_tmp
  fs_tmpdir = fs_tmpdir
  exists = fs_exists
  is_file = fs_is_file
  is_dir = fs_is_dir
  read = fs_read
  write = fs_write
  cat = fs_read
  mkdir = fs_mkdir
  glob = fs_glob
  cp = fs_cp
  mv = fs_mv
  rm = fs_rm
  tmp = fs_tmp
  tmpdir = fs_tmpdir
  pipe = pipe
  pipe_ok = pipe_ok
  args = args
  arg = arg
