table_new: any = ()
  {}
table_get: any = (m: any, key: any)
  m(key)
table_set = (m: any, key: any, value: any)
  m(key) = value
table_has: bool = (m: any, key: any)
  m(key) != nil
wrap: any = (fn: any)
  cache = {}
  return (x: any) -> any
    if cache(x) == nil
      cache(x) = fn(x)
    cache(x)
clear = (m: any)
  for k, _ in m
    m(k) = nil
