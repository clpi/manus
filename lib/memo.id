table_new: any = ()
  {}
table_get: any = (m: any, key: any)
  m[key]
table_set: void = (m: any, key: any, value: any)
  m[key] = value
table_has: bool = (m: any, key: any)
  m[key] != nil
wrap: any = (fn: any)
  cache = {}
  return fun(x: any) -> any
    if cache[x] == nil
      cache[x] = fn(x)
    cache[x]
  end
clear: void = (m: any)
  for k, _ in m
    m[k] = nil
