# metrics — Observability: counters, gauges, histograms, timers
# For profiling ward runtime, ML inference, and application monitoring.

# ═══════════════════════════════════════════════════════════════
# Counter (monotonically increasing)
# ═══════════════════════════════════════════════════════════════

counter_new: any = (name: str, help: str)
  {
    type = "counter",
    name = name,
    help = help,
    value = 0,
    labels = {}
  }

counter_inc = (c: any, amount: f64)
  if amount == nil
    amount = 1
  c.value = c.value + amount

counter_get: f64 = (c: any)
  c.value

counter_reset = (c: any)
  c.value = 0

# ═══════════════════════════════════════════════════════════════
# Gauge (can go up and down)
# ═══════════════════════════════════════════════════════════════

gauge_new: any = (name: str, help: str)
  {
    type = "gauge",
    name = name,
    help = help,
    value = 0
  }

gauge_set = (g: any, value: f64)
  g.value = value

gauge_inc = (g: any, amount: f64)
  if amount == nil
    amount = 1
  g.value = g.value + amount

gauge_dec = (g: any, amount: f64)
  if amount == nil
    amount = 1
  g.value = g.value - amount

gauge_get: f64 = (g: any)
  g.value

# ═══════════════════════════════════════════════════════════════
# Histogram (value distribution)
# ═══════════════════════════════════════════════════════════════

histogram_new: any = (name: str, help: str, buckets: any)
  if buckets == nil
    buckets = { 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0 }
  bucket_counts = {}
  for i = 1, buckets:len()
    bucket_counts(i) = 0
  {
    type = "histogram",
    name = name,
    help = help,
    buckets = buckets,
    bucket_counts = bucket_counts,
    count = 0,
    sum = 0,
    min = 1000000000000000000000000000000.0,
    max = -1000000000000000000000000000000.0
  }

histogram_observe = (h: any, value: f64)
  h.count = h.count + 1
  h.sum = h.sum + value
  if value < h.min
    h.min = value
  if value > h.max
    h.max = value

  for i = 1, h:len().buckets
    if value <= h.buckets(i)
      h.bucket_counts(i) = h.bucket_counts(i) + 1

histogram_get: any = (h: any)
  {
    count = h.count,
    sum = h.sum,
    mean = h.count > 0 and h.sum / h.count or 0,
    min = h.count > 0 and h.min or 0,
    max = h.count > 0 and h.max or 0,
    buckets = h.buckets,
    bucket_counts = h.bucket_counts
  }

histogram_quantile: f64 = (h: any, q: f64)
  if h.count == 0
    return 0.0
  target = h.count * q:floor()
  cumulative = 0
  for i = 1, h:len().buckets
    cumulative = cumulative + h.bucket_counts(i)
    if cumulative >= target
      return h.buckets(i)
  h.buckets(h:len().buckets)

histogram_reset = (h: any)
  h.count = 0
  h.sum = 0
  h.min = 1000000000000000000000000000000.0
  h.max = -1000000000000000000000000000000.0
  for i = 1, h:len().buckets
    h.bucket_counts(i) = 0

# ═══════════════════════════════════════════════════════════════
# Timer (measure elapsed time)
# ═══════════════════════════════════════════════════════════════

timer_new: any = (name: str)
  {
    type = "timer",
    name = name,
    histogram = histogram_new(name .. "_duration_seconds", "Duration in seconds"),
    total_time = 0,
    call_count = 0,
    start_time = nil
  }

timer_start = (t: any)
  t.start_time = os.clock()

timer_stop: f64 = (t: any)
  if t.start_time == nil
    return 0.0
  elapsed = os.clock() - t.start_time
  t.total_time = t.total_time + elapsed
  t.call_count = t.call_count + 1
  histogram_observe(t.histogram, elapsed)
  t.start_time = nil
  elapsed

timer_elapsed: f64 = (t: any)
  if t.start_time == nil
    return 0.0
  os.clock() - t.start_time

timer_get: any = (t: any)
  {
    name = t.name,
    total_time = t.total_time,
    call_count = t.call_count,
    mean_time = t.call_count > 0 and t.total_time / t.call_count or 0,
    histogram = histogram_get(t.histogram)
  }

# ═══════════════════════════════════════════════════════════════
# Registry (collect all metrics)
# ═══════════════════════════════════════════════════════════════

registry_new: any = ()
  {
    counters = {},
    gauges = {},
    histograms = {},
    timers = {}
  }

registry_register_counter: any = (reg: any, name: str, help: str)
  c = counter_new(name, help)
  reg.counters(name) = c
  c

registry_register_gauge: any = (reg: any, name: str, help: str)
  g = gauge_new(name, help)
  reg.gauges(name) = g
  g

registry_register_histogram: any = (reg: any, name: str, help: str, buckets: any)
  h = histogram_new(name, help, buckets)
  reg.histograms(name) = h
  h

registry_register_timer: any = (reg: any, name: str)
  t = timer_new(name)
  reg.timers(name) = t
  t

registry_summary: any = (reg: any)
  summary = {}
  for name, c in reg.counters
    summary(name) =
      type = "counter"
      value = c.value
  for name, g in reg.gauges
    summary(name) =
      type = "gauge"
      value = g.value
  for name, h in reg.histograms
    summary(name) =
      type = "histogram"
      value = histogram_get(h)
  for name, t in reg.timers
    summary(name) =
      type = "timer"
      value = timer_get(t)
  summary
# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════
# Counter
# Gauge
# Histogram
