digit: i64 = (ch: i64)
  v: i64 = ch - 48
  if v > 9
    v = ch - 87
  v

hex: i64 = (s: str)
  v: i64 = 0
  j: i64 = 1
  while j <= s:len()
    v = v << 4 | digit(s:byte(j))
    j = j + 1
  v

place: i64 = (fact: str, ops: any)
  at = fact:split("@")
  span = at(2):split(":")
  lo: i64 = to(i64)(span(2))
  v: i64 = ops(at(1))
  v << lo

width: i64 = (fact: str)
  at = fact:split("@")
  span = at(2):split(":")
  hi: i64 = to(i64)(span(1))
  lo: i64 = to(i64)(span(2))
  hi - lo + 1

holds: str = (fact: str)
  at = fact:split("@")
  at(1)

name: str = (row: str)
  parts = row:split("|")
  parts(1)

layout: str = (row: str)
  parts = row:split("|")
  parts(3)

encode: i64 = (row: str, ops: any)
  parts = row:split("|")
  word: i64 = hex(parts(2))
  lay: str = parts(3)
  if lay:len() > 0
    for i, fact in lay:split(" ")
      word = word | place(fact, ops)
  word

slot: str = (k: str, ops: any)
  out: str = ""
  if k == "s"
    out = to(str)(ops("i") * 8)
  else
    if k == "h"
      out = to(str)(ops("h") * 16)
    else
      if k == "c"
        out = conds()(ops("c") + 1)
      else
        out = to(str)(ops(k))
  out

text: str = (row: str, ops: any)
  parts = row:split("|")
  form: str = parts(4)
  out: str = ""
  j: i64 = 1
  while j <= form:len()
    ch: str = form:sub(j, j)
    if ch == "%"
      out = out .. slot(form:sub(j + 1, j + 1), ops)
      j = j + 2
    else
      out = out .. ch
      j = j + 1
  out
