# regex — PCRE2 regular expression bindings via @ffi
# Usage: duo compile myapp.id #link pcre2-8
# This module provides compile, match, find, find_all, replace, and helpers
# using the PCRE2 C library (libpcre2-8, the 8-bit code unit width variant).
#
# Ovector reads are native: see _read_size_t below. No C shim to link.

# ===========================================================================
# PCRE2 FFI declarations (bodyless — extern C symbols)
# ===========================================================================

@ffi("pcre2_compile_8")
pcre2_compile_8(pattern: str, length: int, options: int, errcode: any, erroffset: any, context: any): any

@ffi("pcre2_match_data_create_from_pattern_8")
pcre2_match_data_create_from_pattern_8(code: any, context: any): any

@ffi("pcre2_match_8")
pcre2_match_8(code: any, subject: str, length: int, startoffset: int, options: int, match_data: any, context: any): int

@ffi("pcre2_get_ovector_pointer_8")
pcre2_get_ovector_pointer_8(match_data: any): any

@ffi("pcre2_match_data_free_8")
pcre2_match_data_free_8(match_data: any): void

@ffi("pcre2_code_free_8")
pcre2_code_free_8(code: any): void

@ffi("pcre2_substring_replace_byname_8")
pcre2_substring_replace_byname_8(code: any, subject: str, length: int, replacement: str, rlength: int, buffer: any, outlen: any, context: any): int

@ffi("pcre2_get_error_message_8")
pcre2_get_error_message_8(errcode: int, buffer: str, buf_size: int): int

# PCRE2's ovector is an array of PCRE2_SIZE (size_t), laid out as pairs:
# [start0, end0, start1, end1, ...]. This reads one element by index.
#
# This used to be an @ffi binding to a C shim (lib/duo_regex_shim.c),
# because Duo could not dereference a raw pointer at an index from user-level
# code. It can now: a `*i64` parameter indexed with `p[i]` lowers to the C
# `p[i]` directly, with no boxing — the same lowering
# examples/native_indexing pins in the property-11 codegen suite. The shim and
# the manual "compile this .c alongside your program" step are both gone.
_read_size_t: i64 = (p: *i64, i: i64)
    return p[i]

# ===========================================================================
# PCRE2 constants (option flags)
# ===========================================================================

PCRE2_CASELESS  = 0x00000008
PCRE2_MULTILINE = 0x00000400
PCRE2_DOTALL    = 0x00000020
PCRE2_EXTENDED = 0x00000080
PCRE2_ANCHORED = 0x00000010
PCRE2_UTF      = 0x00080000
PCRE2_UCP      = 0x00020000
PCRE2_NOTEMPTY = 0x00000004

# ===========================================================================
# Helpers
# ===========================================================================

# error_message: convert a PCRE2 error code to a human-readable string.
error_message: str = (errcode: int)
    buf = " ":rep(256)
    rc = pcre2_get_error_message_8(errcode, buf, 256)
    if rc < 0
        return "PCRE2 error " .. errcode:to(str)
    buf:sub(1, rc)

# read_ovector_pair: read a single (start, end) pair from the ovector pointer
# at the given pair index.  pcre2_match returns the number of pairs; each
# pair is two PCRE2_SIZE (size_t) values: [start, end].
# pair_index 0 = whole match, 1+ = capture groups.
read_ovector_pair: any = (ovptr: any, pair_index: int)
    s_off = pair_index * 2
    e_off = s_off + 1
    s_val = _read_size_t(ovptr, s_off)
    e_val = _read_size_t(ovptr, e_off)
    return {start = s_val, end_ = e_val}

# quote: escape special regex characters in s so it matches literally.
quote: str = (s: str)
    out = ""
    i = 1
    n = s:len()
    while i <= n
        ch = s:sub(i, i)
        # Escape: . + * ? ( ) [ ] { } ^ $ | \ -
        if ch == "." or ch == "+" or ch == "*" or ch == "?" or
           ch == "(" or ch == ")" or ch == "[" or ch == "]" or
           ch == "{" or ch == "}" or ch == "^" or ch == "$" or
           ch == "|" or ch == "\\" or ch == "-"
            out = out .. "\\" .. ch
        else
            out = out .. ch
        i += 1
    out

# ===========================================================================
# Public API
# ===========================================================================

# compile: compile a regex pattern with given option flags.
# Returns the pcre2_code* handle, or nil on error.
compile: any = (pattern: str, options: int)
    # errcode and erroffset are output parameters (int* in C).
    # We pass table cells that the FFI layer treats as pointer-to-int.
    errcode_buf = {0}
    erroffset_buf = {0}
    plen = pattern:len()
    code = pcre2_compile_8(pattern, plen, options, errcode_buf, erroffset_buf, nil)
    if code == nil
        return nil
    code

# match: match subject against compiled code starting at startoffset.
# Returns a table of {start=n, end_=m} pairs (one per capture group + whole),
# or nil if no match.
regex_match: any = (code: any, subject: str, startoffset: int)
    if code == nil return nil
    md = pcre2_match_data_create_from_pattern_8(code, nil)
    if md == nil return nil
    slen = subject:len()
    rc = pcre2_match_8(code, subject, slen, startoffset, 0, md, nil)
    if rc < 0
        pcre2_match_data_free_8(md)
        return nil
    # rc = number of pairs (0 = match only with no groups, 1+ = capture groups)
    npairs = rc
    if npairs == 0 npairs = 1
    ovptr = pcre2_get_ovector_pointer_8(md)
    result = {}
    i = 0
    while i < npairs
        pair = read_ovector_pair(ovptr, i)
        result[result:len() + 1] = pair
        i += 1
    pcre2_match_data_free_8(md)
    result

# match_str: convenience — returns the first matched substring or nil.
match_str: any = (code: any, subject: str)
    m = regex_match(code, subject, 0)
    if m == nil return nil
    if m:len() == 0 return nil
    p = m[1]
    if p.start == nil or p.end_ == nil return nil
    # PCRE2 offsets are 0-based byte offsets; convert to 1-based Lua string
    s = p.start + 1
    e = p.end_
    if e <= s return ""
    subject:sub(s, e - 1)

# find: find the first match in subject starting from init (1-based).
# Returns {start=n, end_=m} with 1-based positions, or nil.
find: any = (code: any, subject: str, init: int)
    if code == nil return nil
    if init == nil init = 1
    # Convert 1-based Lua init to 0-based PCRE2 startoffset
    startoffset = init - 1
    if startoffset < 0 startoffset = 0
    m = regex_match(code, subject, startoffset)
    if m == nil return nil
    if m:len() == 0 return nil
    p = m[1]
    if p.start == nil return nil
    # Convert 0-based PCRE2 offsets to 1-based; end_ is exclusive (0-based)
    # which equals inclusive end (1-based)
    s = p.start + 1
    e = p.end_
    return {start = s, end_ = e}

# find_all: find all non-overlapping matches in subject.
# Returns a table of {start, end_} pairs.
find_all: any = (code: any, subject: str)
    if code == nil return {}
    results = {}
    slen = subject:len()
    startoffset = 0
    while startoffset <= slen
        md = pcre2_match_data_create_from_pattern_8(code, nil)
        if md == nil break
        rc = pcre2_match_8(code, subject, slen, startoffset, 0, md, nil)
        if rc < 0
            pcre2_match_data_free_8(md)
            break
        ovptr = pcre2_get_ovector_pointer_8(md)
        pair = read_ovector_pair(ovptr, 0)
        pcre2_match_data_free_8(md)
        s0 = pair.start
        e0 = pair.end_
        # Convert to 1-based; end_ is exclusive 0-based = 1-based inclusive end
        results[results:len() + 1] = {start = s0 + 1, end_ = e0}
        # Advance past this match; avoid infinite loop on empty match
        if e0 > startoffset
            startoffset = e0
        else
            startoffset += 1
    results

# replace: global replacement.  Replaces all matches of code in subject
# with replacement string.  Returns the resulting string.
# Uses a manual scan + string assembly rather than pcre2_substring_replace_byname
# (which does single replacement and needs a pre-allocated buffer).
replace: str = (code: any, subject: str, replacement: str)
    if code == nil return subject
    slen = subject:len()
    results = find_all(code, subject)
    if results:len() == 0 return subject
    out = ""
    last = 1
    i = 1
    while i <= results:len()
        r = results[i]
        s = r.start
        e = r.end_
        # Append text before this match (1-based, up to s-1)
        if s > last
            out = out .. subject:sub(last, s - 1)
        # Append replacement
        out = out .. replacement
        # Advance last past the match (end_ is exclusive 0-based = 1-based inclusive end)
        last = e + 1
        i += 1
    # Append trailing text
    if last <= slen
        out = out .. subject:sub(last)
    out

# free: free a compiled pattern handle.
free = (code: any)
    if code != nil
        pcre2_code_free_8(code)

# ===========================================================================
# Module export
# ===========================================================================

M = {}
M.compile = compile
M["match"] = regex_match
M.match_str = match_str
M.find = find
M.find_all = find_all
M.replace = replace
M.free = free
M.error_message = error_message
M.quote = quote
M.PCRE2_CASELESS = PCRE2_CASELESS
M.PCRE2_MULTILINE = PCRE2_MULTILINE
M.PCRE2_DOTALL = PCRE2_DOTALL
M.PCRE2_EXTENDED = PCRE2_EXTENDED
M.PCRE2_ANCHORED = PCRE2_ANCHORED
M.PCRE2_UTF = PCRE2_UTF
M.PCRE2_UCP = PCRE2_UCP
M.PCRE2_NOTEMPTY = PCRE2_NOTEMPTY
M