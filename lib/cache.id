

simple_new: any = ()
    {data = {}, order = {}, hits = 0, misses = 0}

simple_get: any = (c: any, key: str)
    if c == nil return nil 
    val = c.data[key]
    if val != nil
        c.hits = c.hits + 1
        return val
    c.misses = c.misses + 1
    nil

simple_set = (c: any, key: str, value: any)
    if c == nil return 
    if c.data[key] == nil
        c.order[c.order:len() + 1] = key
    c.data[key] = value

simple_has: bool = (c: any, key: str)
    if c == nil return false 
    c.data[key] != nil

simple_delete = (c: any, key: str)
    if c == nil return 
    c.data[key] = nil
    new_order = {}
    i = 1
    while i <= c.order:len()
        if c.order[i] != key
            new_order[new_order:len() + 1] = c.order[i]
        i += 1
    c.order = new_order

simple_clear = (c: any)
    if c == nil return 
    c.data = {}
    c.order = {}
    c.hits = 0
    c.misses = 0

simple_size: i64 = (c: any)
    if c == nil return 0 
    c.order:len()

simple_stats: any = (c: any)
    if c == nil return {hits = 0, misses = 0, hit_rate = 0} 
    total = c.hits + c.misses
    rate = 0
    if total > 0 rate = c.hits / total 
    {hits = c.hits, misses = c.misses, hit_rate = rate}


ttl_new: any = (default_ttl: i64)
    if default_ttl == nil default_ttl = 60 
    {data = {}, timestamps = {}, ttl = default_ttl, hits = 0, misses = 0}

std_cache_ttl_delete = (c: any, key: str)
    if c == nil return 
    c.data[key] = nil
    c.timestamps[key] = nil

ttl_get: any = (c: any, key: str)
    if c == nil return nil 
    val = c.data[key]
    if val == nil
        c.misses = c.misses + 1
        return nil
    ts = c.timestamps[key]
    if ts != nil
        age = os.clock() - ts
        if age > c.ttl
            std_cache_ttl_delete(c, key)
            c.misses = c.misses + 1
            return nil
    c.hits = c.hits + 1
    val

ttl_set = (c: any, key: str, value: any, custom_ttl: i64)
    if c == nil return 
    c.data[key] = value
    c.timestamps[key] = os.clock()

ttl_has: bool = (c: any, key: str)
    if c == nil return false 
    val = c.data[key]
    if val == nil return false 
    ts = c.timestamps[key]
    if ts != nil and (os.clock() - ts) > c.ttl
        std_cache_ttl_delete(c, key)
        return false
    true

ttl_delete = (c: any, key: str)
    std_cache_ttl_delete(c, key)

ttl_clear = (c: any)
    if c == nil return 
    c.data = {}
    c.timestamps = {}
    c.hits = 0
    c.misses = 0

ttl_purge_expired: i64 = (c: any)
    if c == nil return 0 
    removed = 0
    now = os.clock()
    keys_to_remove = {}
    for tk, _tv in c.data
        ts = c.timestamps[tk]
        if ts != nil and (now - ts) > c.ttl
            keys_to_remove[keys_to_remove:len() + 1] = tk
    i = 1
    while i <= keys_to_remove:len()
        std_cache_ttl_delete(c, keys_to_remove[i])
        removed += 1
        i += 1
    removed

ttl_size: i64 = (c: any)
    if c == nil return 0 
    n = 0
    for _ck, _cv in c.data
        n += 1
    n


std_cache_lru_touch = (c: any, key: str)
    new_order = {}
    i = 1
    while i <= c.order:len()
        if c.order[i] != key
            new_order[new_order:len() + 1] = c.order[i]
        i += 1
    new_order[new_order:len() + 1] = key
    c.order = new_order

std_cache_lru_remove_order = (c: any, key: str)
    new_order = {}
    i = 1
    while i <= c.order:len()
        if c.order[i] != key
            new_order[new_order:len() + 1] = c.order[i]
        i += 1
    c.order = new_order

lru_new: any = (capacity: i64)
    if capacity == nil capacity = 128 
    {data = {}, order = {}, capacity = capacity, hits = 0, misses = 0}

lru_get: any = (c: any, key: str)
    if c == nil return nil 
    val = c.data[key]
    if val != nil
        c.hits = c.hits + 1
        std_cache_lru_touch(c, key)
        return val
    c.misses = c.misses + 1
    nil

lru_set = (c: any, key: str, value: any)
    if c == nil return 
    if c.data[key] != nil
        c.data[key] = value
        std_cache_lru_touch(c, key)
        return
    while c.order:len() >= c.capacity
        oldest = c.order[1]
        c.data[oldest] = nil
        new_order = {}
        j = 2
        while j <= c.order:len()
            new_order[new_order:len() + 1] = c.order[j]
            j += 1
        c.order = new_order
    c.data[key] = value
    c.order[c.order:len() + 1] = key

lru_has: bool = (c: any, key: str)
    if c == nil return false 
    c.data[key] != nil

lru_delete = (c: any, key: str)
    if c == nil return 
    c.data[key] = nil
    std_cache_lru_remove_order(c, key)

lru_clear = (c: any)
    if c == nil return 
    c.data = {}
    c.order = {}
    c.hits = 0
    c.misses = 0

lru_size: i64 = (c: any)
    if c == nil return 0 
    c.order:len()

lru_evict: any = (c: any)
    if c == nil or c.order:len() == 0 return nil 
    oldest = c.order[1]
    val = c.data[oldest]
    c.data[oldest] = nil
    new_order = {}
    j = 2
    while j <= c.order:len()
        new_order[new_order:len() + 1] = c.order[j]
        j += 1
    c.order = new_order
    val

lru_stats: any = (c: any)
    if c == nil return {hits = 0, misses = 0, hit_rate = 0, size = 0, capacity = 0} 
    total = c.hits + c.misses
    rate = 0
    if total > 0 rate = c.hits / total 
    {hits = c.hits, misses = c.misses, hit_rate = rate, size = c.order:len(), capacity = c.capacity}

