
work: { line: str } = (line: str)
  { line = line }

command: { line: str } = (line: str)
  work(line)

verdict: str = (status: i64)
  if status == 0
    "ok"
  "failed"

run: { outcome: str, status: i64 } = (line: str)
  code = os.execute(line)
  { outcome = verdict(code), status = code }

evidence: str = (line: str)
  gatecap(line)

capture: str = (line: str)
  evidence(line)

trim: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

read: str = (w: { line: str })
  evidence(w.line)

halt = (code: i64)
  os.exit(code)

main: i64 = ()
  w = command("printf ok")
  r = run(w.line)
  if r.outcome != "ok"
    return 1
  e = trim(evidence(w.line))
  if e != "ok"
    return 2
  r2 = run("false")
  if r2.outcome != "failed"
    return 3
  if r2.status != 1
    return 4
  0
