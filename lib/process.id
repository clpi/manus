# process home — structured command + open across process boundary.
# No popen. No @c. No lua. Never io.popen / io:popen spellings.
#
# Canonical capture path:
#   c = command("git status")
#   stream = c:open("r")
#   text = stream:read("*a")

command: any = (line: str)
    { line = line }

capture: str = (shellline: str)
    c = command(shellline)
    stream = c:open("r")
    if stream == nil
        return ""
    out = ""
    line = stream:read()
    while line != nil
        out = "{out}{line}\n"
        line = stream:read()
    stream:close()
    out

run: i64 = (shellline: str)
    if os.execute(shellline)
        return 0
    1

chomp: str = (text: str)
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32
            break
        n -= 1
    text:sub(1, n)

exit: void = (code: i64)
    os.exit(code)
