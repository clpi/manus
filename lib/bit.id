
popcount: i64 = (x: i64)
  n = x
  count = 0
  while n != 0
    count = count + (n & 1)
    n = (n >> 1) & 9223372036854775807
  count

clz: i64 = (x: i64)
  if x == 0
    return 64
  n = 0
  mask = 1 << 63
  while x & mask == 0
    n = n + 1
    mask = mask >> 1
  n

ctz: i64 = (x: i64)
  if x == 0
    return 64
  n = 0
  while x & 1 == 0
    n = n + 1
    x = x >> 1
  n

bit_length: i64 = (x: i64)
  if x == 0
    return 0
  64 - clz(x)

rotl: i64 = (x: i64, k: i64)
  k = k & 63
  if k == 0
    return x
  x << k | (x >> (64 - k)) & ((1 << k) - 1)

rotr: i64 = (x: i64, k: i64)
  k = k & 63
  if k == 0
    return x
  (x >> k) & ((1 << (64 - k)) - 1) | x << (64 - k)

reverse: i64 = (x: i64)
  r = 0
  i = 0
  while i < 64
    r = r | (x >> i & 1) << (63 - i)
    i = i + 1
  r

reverse_bytes: i64 = (x: i64)
  (x & 255) << 56 | (x & 65280) << 40 | (x & 16711680) << 24 | (x & 4278190080) << 8 | x >> 8 & 4278190080 | x >> 24 & 16711680 | x >> 40 & 65280 | x >> 56 & 255

mask_of: i64 = (width: i64)
  if width >= 64
    return -1
  (1 << width) - 1

extract: i64 = (x: i64, hi: i64, lo: i64)
  (x >> lo) & mask_of(hi - lo + 1)

insert: i64 = (x: i64, hi: i64, lo: i64, value: i64)
  mask = mask_of(hi - lo + 1)
  cleared = x & ~(mask << lo)
  cleared | (value & mask) << lo

set_bit: i64 = (x: i64, pos: i64)
  x | 1 << pos

clear_bit: i64 = (x: i64, pos: i64)
  x & ~(1 << pos)

toggle_bit: i64 = (x: i64, pos: i64)
  x ~ 1 << pos

test_bit: bool = (x: i64, pos: i64)
  x & 1 << pos != 0

popcount_range: i64 = (x: i64, hi: i64, lo: i64)
  popcount(extract(x, hi, lo))

next_pow2: i64 = (x: i64)
  if x <= 1
    return 1
  x = x - 1
  x = x | x >> 1
  x = x | x >> 2
  x = x | x >> 4
  x = x | x >> 8
  x = x | x >> 16
  x = x | x >> 32
  x + 1

prev_pow2: i64 = (x: i64)
  if x <= 1
    return 1
  1 << (bit_length(x) - 1)

leb128_encode_u: any = (value: i64)
  bytes = {}
  repeat
    byte = value & 127
    value = value >> 7
    if value != 0
      byte = byte | 128
    bytes[bytes:len() + 1] = byte
  until value == 0
  bytes

leb128_decode_u: any = (bytes: any, pos: i64)
  result = 0
  shift = 0
  i = pos
  while true
    byte = bytes[i]
    result = result | (byte & 127) << shift
    shift = shift + 7
    if byte & 128 == 0
      break
    i = i + 1
  { value = result, next = i + 1 }

leb128_encode_s: any = (value: i64)
  bytes = {}
  more = true
  while more
    byte = value & 127
    value = value >> 7
    if value == 0 and byte & 64 == 0 or value == -1 and byte & 64 != 0
      more = false
    else
      byte = byte | 128
    bytes[bytes:len() + 1] = byte
  bytes

leb128_decode_s: any = (bytes: any, pos: i64)
  result = 0
  shift = 0
  i = pos
  while true
    byte = bytes[i]
    result = result | (byte & 127) << shift
    shift = shift + 7
    if byte & 128 == 0
      if shift < 64 and byte & 64 != 0
        result = result | ~0 << shift
      break
    i = i + 1
  { value = result, next = i + 1 }

and_bytes: any = (a: any, b: any)
  out = {}
  n = a:len()
  if b:len() < n
    n = b:len()
  i = 1
  while i <= n
    out[out:len() + 1] = a[i] & b[i]
    i = i + 1
  out

or_bytes: any = (a: any, b: any)
  out = {}
  n = a:len()
  if b:len() < n
    n = b:len()
  i = 1
  while i <= n
    out[out:len() + 1] = a[i] | b[i]
    i = i + 1
  out

xor_bytes: any = (a: any, b: any)
  out = {}
  n = a:len()
  if b:len() < n
    n = b:len()
  i = 1
  while i <= n
    out[out:len() + 1] = a[i] ^ b[i]
    i = i + 1
  out

not_bytes: any = (a: any)
  out = {}
  i = 1
  while i <= a:len()
    out[out:len() + 1] = ~a[i] & 255
    i = i + 1
  out


f64_to_bits: i64 = (x: f64)

  @comp.bit.bitcast(x, "int64_t")
  
f64_from_bits: f64 = (b: i64)

  @comp.bit.bitcast(b, "double")
  
f32_to_bits: i64 = (x: f64)
  y: f32 = x

  @comp.bit.bitcast(y, "uint32_t")
  
f32_from_bits: f64 = (b: i64)
  y: u32 = b
  @comp.bit.bitcast(y, "float")
