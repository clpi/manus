# container — container types (mirrors Go's container/heap, list, ring)
# Provides a binary min-heap, a doubly-linked list, and a circular ring.

# ===== Heap (min-heap) =====

# new_heap: create an empty min-heap. `less` defines the priority order.
# less(a, b) => true when a should be popped before b (higher priority).
new_heap(less: any): any
    if less == nil
        less = (a: any, b: any) a < b
    {data = {}, less = less}

# heap_up: sift up the element at index i.
heap_up(h: any, i: any): void
    while i > 1
        parent = i / 2
        if h.less(h.data[i], h.data[parent])
            tmp = h.data[i]
            h.data[i] = h.data[parent]
            h.data[parent] = tmp
            i = parent
        else
            break

# heap_down: sift down the element at index i.
heap_down(h: any, i: any): void
    n = h.data:len()
    while true
        left = i * 2
        right = left + 1
        smallest = i
        if left <= n and h.less(h.data[left], h.data[smallest])
            smallest = left
        if right <= n and h.less(h.data[right], h.data[smallest])
            smallest = right
        if smallest == i break 
        tmp = h.data[i]
        h.data[i] = h.data[smallest]
        h.data[smallest] = tmp
        i = smallest

# heap_push: insert a value into the heap.
heap_push(h: any, v: any): void
    h.data[h.data:len() + 1] = v
    heap_up(h, h.data:len())

# heap_pop: remove and return the minimum element. Returns nil if empty.
heap_pop(h: any): any
    n = h.data:len()
    if n == 0 return nil 
    min = h.data[1]
    h.data[1] = h.data[n]
    h.data[n] = nil
    if n > 1 heap_down(h, 1) 
    min

# heap_peek: return the minimum element without removing it.
heap_peek(h: any): any
    h.data[1]

# heap_len: return the number of elements in the heap.
heap_h: any:len(): i64
    h.data:len()

# ===== Doubly-linked list =====

# new_list: create an empty doubly-linked list.
new_list(): any
    {head = nil, tail = nil, len = 0}

# list_push_back: insert value at the tail. Returns the new node.
list_push_back(l: any, v: any): any
    node = {value = v, prev = l.tail, next = nil}
    if l.tail == nil
        l.head = node
        l.tail = node
    else
        l.tail.next = node
        l.tail = node
    l.len = l.len + 1
    node

# list_push_front: insert value at the head. Returns the new node.
list_push_front(l: any, v: any): any
    node = {value = v, prev = nil, next = l.head}
    if l.head == nil
        l.head = node
        l.tail = node
    else
        l.head.prev = node
        l.head = node
    l.len = l.len + 1
    node

# list_remove: remove a node from the list.
list_remove(l: any, node: any): any
    if node == nil return nil 
    if has(.prev)(node)
        node.prev.next = node.next
    else
        l.head = node.next
    if has(.next)(node)
        node.next.prev = node.prev
    else
        l.tail = node.prev
    l.len = l.len - 1
    node.value

# list_pop_back: remove and return the tail value.
list_pop_back(l: any): any
    if l.tail == nil return nil 
    list_remove(l, l.tail)

# list_pop_front: remove and return the head value.
list_pop_front(l: any): any
    if l.head == nil return nil 
    list_remove(l, l.head)

# list_front: return the head value without removing.
list_front(l: any): any
    if l.head == nil return nil 
    l.head.value

# list_back: return the tail value without removing.
list_back(l: any): any
    if l.tail == nil return nil 
    l.tail.value

# list_len: return the number of elements.
list_l: any:len(): i64
    l.len

# list_foreach: iterate over all elements, calling fn(value).
list_foreach(l: any, fn: any): void
    node = l.head
    while node != nil
        fn(node.value)
        node = node.next

# list_insert_before: insert value before the given node.
list_insert_before(l: any, mark: any, v: any): any
    if mark == nil return list_push_back(l, v) 
    node = {value = v, prev = mark.prev, next = mark}
    if has(.prev)(mark)
        mark.prev.next = node
    else
        l.head = node
    mark.prev = node
    l.len = l.len + 1
    node

# list_insert_after: insert value after the given node.
list_insert_after(l: any, mark: any, v: any): any
    if mark == nil return list_push_front(l, v) 
    node = {value = v, prev = mark, next = mark.next}
    if has(.next)(mark)
        mark.next.prev = node
    else
        l.tail = node
    mark.next = node
    l.len = l.len + 1
    node

# ===== Ring (circular buffer) =====

# new_ring: create a ring with n slots.
new_ring(n: any): any
    if n == nil or n < 1 n = 1 
    # create n linked nodes
    head = {value = nil, next = nil}
    cur = head
    i = 1
    while i < n
        cur.next = {value = nil, next = nil}
        cur = cur.next
        i += 1
    cur.next = head  # close the circle
    {current = head, len = n}

# ring_set: set the value of the current ring position.
ring_set(r: any, v: any): void
    r.current.value = v

# ring_value: get the value of the current ring position.
ring_value(r: any): any
    r.current.value

# ring_next: advance the ring to the next position.
ring_next(r: any): any
    r.current = r.current.next
    r.current

# ring_prev: move the ring to the previous position.
ring_prev(r: any): any
    # since it is singly linked, traverse the full circle
    start = r.current
    cur = r.current.next
    while cur.next != start
        cur = cur.next
    r.current = cur
    r.current

# ring_do: call fn on each position in the ring.
ring_do(r: any, fn: any): void
    start = r.current
    fn(r.current.value)
    cur = r.current.next
    while cur != start
        fn(cur.value)
        cur = cur.next

# ring_len: return the number of slots in the ring.
ring_r: any:len(): i64
    r.len

