

new_heap: any = (less: any)
    if less == nil
        less = (a: any, b: any) a < b
    {data = {}, less = less}

heap_up = (h: any, i: any)
    while i > 1
        parent = i / 2
        if h.less(h.data[i], h.data[parent])
            tmp = h.data[i]
            h.data[i] = h.data[parent]
            h.data[parent] = tmp
            i = parent
        else
            break

heap_down = (h: any, i: any)
    n = h.data:len()
    while true
        left = i * 2
        right = left + 1
        smallest = i
        if left <= n and h.less(h.data[left], h.data[smallest])
            smallest = left
        if right <= n and h.less(h.data[right], h.data[smallest])
            smallest = right
        if smallest == i break 
        tmp = h.data[i]
        h.data[i] = h.data[smallest]
        h.data[smallest] = tmp
        i = smallest

heap_push = (h: any, v: any)
    h.data[h.data:len() + 1] = v
    heap_up(h, h.data:len())

heap_pop: any = (h: any)
    n = h.data:len()
    if n == 0 return nil 
    min = h.data[1]
    h.data[1] = h.data[n]
    h.data[n] = nil
    if n > 1 heap_down(h, 1) 
    min

heap_peek: any = (h: any)
    h.data[1]

heap_len: i64 = (h: any)
    h.data:len()


new_list: any = ()
    {head = nil, tail = nil, len = 0}

list_push_back: any = (l: any, v: any)
    node = {value = v, prev = l.tail, next = nil}
    if l.tail == nil
        l.head = node
        l.tail = node
    else
        l.tail.next = node
        l.tail = node
    l.len = l.len + 1
    node

list_push_front: any = (l: any, v: any)
    node = {value = v, prev = nil, next = l.head}
    if l.head == nil
        l.head = node
        l.tail = node
    else
        l.head.prev = node
        l.head = node
    l.len = l.len + 1
    node

list_remove: any = (l: any, node: any)
    if node == nil return nil 
    if has(.prev)(node)
        node.prev.next = node.next
    else
        l.head = node.next
    if has(.next)(node)
        node.next.prev = node.prev
    else
        l.tail = node.prev
    l.len = l.len - 1
    node.value

list_pop_back: any = (l: any)
    if l.tail == nil return nil 
    list_remove(l, l.tail)

list_pop_front: any = (l: any)
    if l.head == nil return nil 
    list_remove(l, l.head)

list_front: any = (l: any)
    if l.head == nil return nil 
    l.head.value

list_back: any = (l: any)
    if l.tail == nil return nil 
    l.tail.value

list_len: i64 = (l: any)
    l.len

list_foreach = (l: any, fn: any)
    node = l.head
    while node != nil
        fn(node.value)
        node = node.next

list_insert_before: any = (l: any, mark: any, v: any)
    if mark == nil return list_push_back(l, v) 
    node = {value = v, prev = mark.prev, next = mark}
    if has(.prev)(mark)
        mark.prev.next = node
    else
        l.head = node
    mark.prev = node
    l.len = l.len + 1
    node

list_insert_after: any = (l: any, mark: any, v: any)
    if mark == nil return list_push_front(l, v) 
    node = {value = v, prev = mark, next = mark.next}
    if has(.next)(mark)
        mark.next.prev = node
    else
        l.tail = node
    mark.next = node
    l.len = l.len + 1
    node


new_ring: any = (n: any)
    if n == nil or n < 1 n = 1 
    head = {value = nil, next = nil}
    cur = head
    i = 1
    while i < n
        cur.next = {value = nil, next = nil}
        cur = cur.next
        i += 1
    cur.next = head
    {current = head, len = n}

ring_set = (r: any, v: any)
    r.current.value = v

ring_value: any = (r: any)
    r.current.value

ring_next: any = (r: any)
    r.current = r.current.next
    r.current

ring_prev: any = (r: any)
    start = r.current
    cur = r.current.next
    while cur.next != start
        cur = cur.next
    r.current = cur
    r.current

ring_do = (r: any, fn: any)
    start = r.current
    fn(r.current.value)
    cur = r.current.next
    while cur != start
        fn(cur.value)
        cur = cur.next

ring_len: i64 = (r: any)
    r.len

