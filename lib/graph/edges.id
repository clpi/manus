syns: any = ()
  {
    fetch = "get",
    retrieve = "get",
    obtain = "get",
    plus = "add",
    length = "len",
    size = "len",
    "peek_char" = "peek",
  }

canon: str = (name: str)
  hit = syns()[name]
  if hit
    return hit
  name

known: bool = (name: str)
  edges()[name] != nil or syns()[name] != nil
