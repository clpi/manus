
parse_value: any = (data: str, start: i64, indent: i64)
  i = start
  len = data:len()
  while i <= len and (data:byte(i) == 32 or data:byte(i) == 9)
    i = i + 1
  current_indent = i - start
  if current_indent < indent
    return nil, i, nil
  line_start = i
  while i <= len and data:byte(i) != 10 and data:byte(i) != 13
    i = i + 1
  line = data:sub(line_start, i - 1)
  if data:byte(i) == 10
    i = i + 1
  if data:byte(i) == 13
    i = i + 1
  if line:sub(1, 1) == "#" or line:sub(1, 3) == "---"
    return parse_value(data, i, indent)
  if line:len() == 0
    return parse_value(data, i, indent)
  colon_pos = nil
  for j = 1, line:len()
    if line:byte(j) == 58
      after = line:sub(j + 1)
      if after:sub(1, 1) == " " or after:len() == 0
        colon_pos = j
        break
  if colon_pos != nil
    key = line:sub(1, colon_pos - 1):trim()
    val_str = line:sub(colon_pos + 1):trim()
    if val_str:len() == 0
      nested = {}
      while true
        nv, ni, ns = parse_value(data, i, current_indent + 1)
        if nv == nil and ns == nil
          break
        if type(nv) == "table" and nv._key != nil
          nkey = nv._key
          nval = nv._value
        else
          nkey = nv
          nval = ns
        nested[nkey] = nval
        i = ni
      return { _key = key, _value = nested }, i, nested
    else
      val = val_str
      if val_str:len() >= 2 and (val_str:sub(1, 1) == "\"" and val_str:sub(val_str:len(), val_str:len()) == "\"" or val_str:sub(1, 1) == "'" and val_str:sub(val_str:len(), val_str:len()) == "'")
        val = val_str:sub(2, val_str:len() - 1)
      else
        if val_str == "true"
          val = true
        else
          if val_str == "false"
            val = false
          else
            if val_str == "null" or val_str == "~"
              val = nil
            else
              num = val_str:to(i64)
              if num != nil
                val = num
      return { _key = key, _value = val }, i, val
  else
    if line:sub(1, 2) == "- " or line:sub(1, 2) == "-"
      item_val = line:sub(2):trim()
      if item_val:len() == 0
        item_val = nil
      if item_val != nil and item_val:len() >= 2 and item_val:sub(1, 1) == "\"" and item_val:sub(item_val:len(), item_val:len()) == "\""
        item_val = item_val:sub(2, item_val:len() - 1)
      return item_val, i, nil
    else
      val = line
      if val:len() >= 2 and (val:sub(1, 1) == "\"" and val:sub(val:len(), val:len()) == "\"" or val:sub(1, 1) == "'" and val:sub(val:len(), val:len()) == "'")
        val = val:sub(2, val:len() - 1)
      num = val:to(i64)
      if num != nil
        val = num
      return val, i, nil

parse: any = (data: str)
  if data == nil
    return nil
  res = {}
  i = 1
  while i <= data:len()
    kv, ni, val = parse_value(data, i, 0)
    if kv == nil
      if val == nil
        break
      res[res:len() + 1] = kv
      i = ni
    else
      if type(kv) == "table" and kv._key != nil
        res[kv._key] = kv._value
      i = ni
  res
