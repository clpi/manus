stopwatch_new: any = ()
  {
    start_time = nil,
    elapsed = 0,
    running = false,
    laps = {}
  }
stopwatch_start = (sw: any)
  if sw.running
    return
  sw.start_time = os.clock()
  sw.running = true
stopwatch_stop: f64 = (sw: any)
  if not sw.running
    return sw.elapsed
  sw.elapsed = sw.elapsed + os.clock() - sw.start_time
  sw.running = false
  sw.elapsed
stopwatch_reset = (sw: any)
  sw.start_time = nil
  sw.elapsed = 0
  sw.running = false
  sw.laps = {}
stopwatch_elapsed: f64 = (sw: any)
  if not sw.running
    return sw.elapsed
  sw.elapsed + os.clock() - sw.start_time
stopwatch_lap: f64 = (sw: any)
  if not sw.running
    return 0.0
  lap_time = os.clock() - sw.start_time
  sw.laps[sw:len().laps + 1] = lap_time
  sw.start_time = os.clock()
  lap_time
stopwatch_laps: any = (sw: any)
  sw.laps
stopwatch_avg_lap: f64 = (sw: any)
  if sw:len().laps == 0
    return 0.0
  total = 0
  for lap in sw.laps
    total = total + lap
  total / sw:len().laps
scoped_timer_new: any = (name: str)
  sw = stopwatch_new()
  stopwatch_start(sw)
  {
    name = name,
    stopwatch = sw
  }
scoped_timer_stop: f64 = (st: any)
  elapsed = stopwatch_stop(st.stopwatch)
  elapsed
scoped_timer_elapsed: f64 = (st: any)
  stopwatch_elapsed(st.stopwatch)
profiler_new: any = ()
  {
    sections = {}
  }
profiler_start = (profiler: any, name: str)
  if profiler.sections[name] == nil
    profiler.sections[name] = {
      total = 0,
      count = 0,
      min = 1000000000000000000000000000000.0,
      max = -1000000000000000000000000000000.0,
      start_time = nil
    }
  profiler.sections[name].start_time = os.clock()
profiler_stop = (profiler: any, name: str)
  section = profiler.sections[name]
  if section == nil or section.start_time == nil
    return
  elapsed = os.clock() - section.start_time
  section.total = section.total + elapsed
  section.count = section.count + 1
  if elapsed < section.min
    section.min = elapsed
  if elapsed > section.max
    section.max = elapsed
  section.start_time = nil
profiler_stats: any = (profiler: any, name: str)
  section = profiler.sections[name]
  if section == nil
    return nil
  {
    name = name,
    total = section.total,
    count = section.count,
    avg = section.count > 0 and section.total / section.count or 0,
    min = section.count > 0 and section.min or 0,
    max = section.count > 0 and section.max or 0
  }
profiler_report: any = (profiler: any)
  report = {}
  for name, section in profiler.sections
    report[report:len() + 1] = profiler_stats(profiler, name)
  report:sort(fun(a: any, b: any) -> any
    a.total > b.total
  end)
  report
profiler_reset = (profiler: any)
  profiler.sections = {}
benchmark: any = (func: any, iterations: i64)
  if iterations == nil
    iterations = 1000
  i = 0
  while i < iterations:min(100)
    func()
    i = i + 1
  times = {}
  i = 0
  while i < iterations
    start = os.clock()
    func()
    elapsed = os.clock() - start
    times[times:len() + 1] = elapsed
    i = i + 1
  times:sort()
  total = 0
  for t in times
    total = total + t
  {
    iterations = iterations,
    total = total,
    avg = total / iterations,
    median = times[iterations / 2:floor() + 1],
    min = times[1],
    max = times[iterations],
    p95 = times[iterations * 0.95:floor() + 1],
    p99 = times[iterations * 0.99:floor() + 1],
    ops_per_sec = iterations / total
  }
