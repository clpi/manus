# unicode — Unicode character classification (mirrors Go's unicode package)
# Provides basic rune/byte classification: IsDigit, IsLetter, IsSpace, etc.
# Since Duo operates on byte strings, these functions take a byte value (0-255)
# and classify based on ASCII/Latin-1 ranges. Full Unicode would require UTF-8
# decoding (see std.utf8 for multi-byte support).

# is_digit: report whether b is an ASCII digit ('0'-'9').
is_digit(b: any): bool
    b >= 48 and b <= 57

# is_letter: report whether b is an ASCII letter (a-z, A-Z).
is_letter(b: any): bool
    (b >= 65 and b <= 90) or (b >= 97 and b <= 122)

# is_upper: report whether b is an ASCII uppercase letter.
is_upper(b: any): bool
    b >= 65 and b <= 90

# is_lower: report whether b is an ASCII lowercase letter.
is_lower(b: any): bool
    b >= 97 and b <= 122

# is_space: report whether b is a whitespace byte.
is_space(b: any): bool
    b == 32 or b == 9 or b == 10 or b == 13 or b == 11 or b == 12

# is_print: report whether b is a printable ASCII character (0x20-0x7E).
is_print(b: any): bool
    b >= 32 and b <= 126

# is_control: report whether b is a control character (0x00-0x1F or 0x7F).
is_control(b: any): bool
    b < 32 or b == 127

# is_punct: report whether b is an ASCII punctuation character.
is_punct(b: any): bool
    (b >= 33 and b <= 47) or (b >= 58 and b <= 64) or (b >= 91 and b <= 96) or (b >= 123 and b <= 126)

# is_hex_digit: report whether b is a hexadecimal digit (0-9, a-f, A-F).
is_hex_digit(b: any): bool
    (b >= 48 and b <= 57) or (b >= 65 and b <= 70) or (b >= 97 and b <= 102)

# is_alnum: report whether b is a letter or digit.
is_alnum(b: any): bool
    is_letter(b) or is_digit(b)

# to_upper: convert byte b to uppercase if it is a lowercase letter.
to_upper(b: any): i64
    if b >= 97 and b <= 122 return b - 32
    b

# to_lower: convert byte b to lowercase if it is an uppercase letter.
to_lower(b: any): i64
    if b >= 65 and b <= 90 return b + 32
    b

# to_title: convert byte b to title case (same as upper for ASCII).
to_title(b: any): i64
    to_upper(b)

# ----- Range-based classification on strings -----

# is_digit_str: report whether s consists entirely of ASCII digits.
is_digit_str(s: str): bool
    if s == nil or s == "" return false
    i = 1
    while i <= s:len()
        if not is_digit(s:byte(i)) return false
        i += 1
    true

# is_letter_str: report whether s consists entirely of ASCII letters.
is_letter_str(s: str): bool
    if s == nil or s == "" return false
    i = 1
    while i <= s:len()
        if not is_letter(s:byte(i)) return false
        i += 1
    true

# is_alnum_str: report whether s consists entirely of ASCII letters and digits.
is_alnum_str(s: str): bool
    if s == nil or s == "" return false
    i = 1
    while i <= s:len()
        if not is_alnum(s:byte(i)) return false
        i += 1
    true

# is_space_str: report whether s consists entirely of whitespace.
is_space_str(s: str): bool
    if s == nil or s == "" return false
    i = 1
    while i <= s:len()
        if not is_space(s:byte(i)) return false
        i += 1
    true

# is_hex_str: report whether s consists entirely of hex digits.
is_hex_str(s: str): bool
    if s == nil or s == "" return false
    i = 1
    while i <= s:len()
        if not is_hex_digit(s:byte(i)) return false
        i += 1
    true

# is_identifier: report whether s is a valid identifier (letter or _ followed by alnum or _).
is_identifier(s: str): bool
    if s == nil or s == "" return false
    b = s:byte(1)
    if not is_letter(b) and b != 95 return false
    i = 2
    while i <= s:len()
        b = s:byte(i)
        if not is_alnum(b) and b != 95 return false
        i += 1
    true

