
is_digit: bool = (b: any)
  b >= 48 and b <= 57

is_letter: bool = (b: any)
  b >= 65 and b <= 90 or b >= 97 and b <= 122

is_upper: bool = (b: any)
  b >= 65 and b <= 90

is_lower: bool = (b: any)
  b >= 97 and b <= 122

is_space: bool = (b: any)
  b == 32 or b == 9 or b == 10 or b == 13 or b == 11 or b == 12

is_print: bool = (b: any)
  b >= 32 and b <= 126

is_control: bool = (b: any)
  b < 32 or b == 127

is_punct: bool = (b: any)
  b >= 33 and b <= 47 or b >= 58 and b <= 64 or b >= 91 and b <= 96 or b >= 123 and b <= 126

is_hex_digit: bool = (b: any)
  b >= 48 and b <= 57 or b >= 65 and b <= 70 or b >= 97 and b <= 102

is_alnum: bool = (b: any)
  is_letter(b) or is_digit(b)

to_upper: i64 = (b: any)
  if b >= 97 and b <= 122
    return b - 32
  b

to_lower: i64 = (b: any)
  if b >= 65 and b <= 90
    return b + 32
  b

to_title: i64 = (b: any)
  to_upper(b)


is_digit_str: bool = (s: str)
  if s == nil or s == ""
    return false
  i = 1
  while i <= s:len()
    if not is_digit(s:byte(i))
      return false
    i = i + 1
  true

is_letter_str: bool = (s: str)
  if s == nil or s == ""
    return false
  i = 1
  while i <= s:len()
    if not is_letter(s:byte(i))
      return false
    i = i + 1
  true

is_alnum_str: bool = (s: str)
  if s == nil or s == ""
    return false
  i = 1
  while i <= s:len()
    if not is_alnum(s:byte(i))
      return false
    i = i + 1
  true

is_space_str: bool = (s: str)
  if s == nil or s == ""
    return false
  i = 1
  while i <= s:len()
    if not is_space(s:byte(i))
      return false
    i = i + 1
  true

is_hex_str: bool = (s: str)
  if s == nil or s == ""
    return false
  i = 1
  while i <= s:len()
    if not is_hex_digit(s:byte(i))
      return false
    i = i + 1
  true

is_identifier: bool = (s: str)
  if s == nil or s == ""
    return false
  b = s:byte(1)
  if not is_letter(b) and b != 95
    return false
  i = 2
  while i <= s:len()
    b = s:byte(i)
    if not is_alnum(b) and b != 95
      return false
    i = i + 1
  true
