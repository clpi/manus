-- std.path.filepath — cross-platform path manipulation (mirrors Go's path/filepath package)

-- Separator is the OS-specific path separator.
separator = "/"

-- ListSeparator is the OS-specific path list separator.
list_separator = ":"

-- IsSeparator reports whether c is a directory separator.
fun is_separator(c: str): bool
    if c == "/" or c == "\\" then return true end
    false
end

-- Clean returns the shortest path name equivalent of path.
fun clean(path: str): str
    if path == "" then return "." end
    -- Normalize separators.
    result = string.gsub(path, "\\", "/")
    -- Handle . and ..
    parts = {}
    i = 1
    len = string.len(result)
    while i <= len do
        nxt = string.find(result, "/", i, true)
        if nxt == nil then
            part = string.sub(result, i)
            parts[#parts + 1] = part
            break
        end
        part = string.sub(result, i, nxt - 1)
        parts[#parts + 1] = part
        i = nxt + 1
    end
    stack = {}
    for _, part in ipairs(parts) do
        if part == ".." then
            table.remove(stack)
        elseif part ~= "." and part ~= "" then
            stack[#stack + 1] = part
        end
    end
    if #stack == 0 then return "." end
    table.concat(stack, "/")
end

-- Ext returns the file name extension.
fun ext(path: str): str
    dot = string.find(path, "%.")
    if dot == nil then return "" end
    string.sub(path, dot)
end

-- Base returns the last element of path.
fun base(path: str): str
    dot = string.len(path)
    while dot > 1 and string.sub(path, dot, dot) == "/" do
        dot = dot - 1
    end
    last = dot
    while dot > 1 and string.sub(path, dot - 1, dot - 1) ~= "/" do
        dot = dot - 1
    end
    string.sub(path, dot, last)
end

-- Dir returns the directory part of path.
fun dir(path: str): str
    dot = string.len(path)
    while dot > 1 and string.sub(path, dot, dot) == "/" do
        dot = dot - 1
    end
    while dot > 1 and string.sub(path, dot - 1, dot - 1) ~= "/" do
        dot = dot - 1
    end
    if dot <= 1 then return "." end
    string.sub(path, 1, dot - 1)
end

-- IsAbs reports whether path is absolute.
fun is_abs(path: str): bool
    if string.sub(path, 1, 1) == "/" then return true end
    if string.len(path) >= 2 and string.sub(path, 2, 2) == ":" then return true end
    false
end

M = {}
M.separator = separator
M.list_separator = list_separator
M.is_separator = is_separator
M.clean = clean
M.ext = ext
M.base = base
M.dir = dir
M.is_abs = is_abs
M