-- std.path.filepath — cross-platform path manipulation (mirrors Go's path/filepath package)

-- Separator is the OS-specific path separator.
separator = "/"

-- ListSeparator is the OS-specific path list separator.
list_separator = ":"

-- IsSeparator reports whether c is a directory separator.
is_separator(c: str): bool
    if c == "/" or c == "\\" return true end
    false
end

-- Clean returns the shortest path name equivalent of path.
clean(path: str): str
    if path == "" return "." end
    -- Normalize separators.
    result = string.gsub(path, "\\", "/")
    -- Handle . and ..
    parts = {}
    i = 1
    len = string.len(result)
    while i <= len do
        nxt = string.find(result, "/", i, true)
        if nxt == nil
            part = string.sub(result, i)
            parts[#parts + 1] = part
            break
        end
        part = string.sub(result, i, nxt - 1)
        parts[#parts + 1] = part
        i = nxt + 1
    end
    stack = {}
    for _, part in parts do
        if part == ".."
            table.remove(stack)
        elseif part != "." and part != ""
            stack[#stack + 1] = part
        end
    end
    if #stack == 0 return "." end
    table.concat(stack, "/")
end

-- Ext returns the file name extension.
ext(path: str): str
    dot = string.find(path, "%.")
    if dot == nil return "" end
    string.sub(path, dot)
end

-- Base returns the last element of path.
base(path: str): str
    dot = string.len(path)
    while dot > 1 and string.sub(path, dot, dot) == "/" do
        dot -= 1
    end
    last = dot
    while dot > 1 and string.sub(path, dot - 1, dot - 1) != "/" do
        dot -= 1
    end
    string.sub(path, dot, last)
end

-- Dir returns the directory part of path.
dir(path: str): str
    dot = string.len(path)
    while dot > 1 and string.sub(path, dot, dot) == "/" do
        dot -= 1
    end
    while dot > 1 and string.sub(path, dot - 1, dot - 1) != "/" do
        dot -= 1
    end
    if dot <= 1 return "." end
    string.sub(path, 1, dot - 1)
end

-- IsAbs reports whether path is absolute.
is_abs(path: str): bool
    if string.sub(path, 1, 1) == "/" return true end
    if string.len(path) >= 2 and string.sub(path, 2, 2) == ":" return true end
    false
end

