-- std.cmp — Ordered comparison utilities (mirrors Go 1.21 cmp package)
-- Provides comparison functions for ordered types.

compare(a: any, b: any): i64
    if a < b return -1 end
    if a > b return 1 end
    0
end

less(a: any, b: any): bool
    a < b
end

ordered(a: any, b: any): i64
    compare(a, b)
end

min(a: any, b: any): any
    if a < b a else b end
end

max(a: any, b: any): any
    if a > b a else b end
end

clamp(val: any, lo: any, hi: any): any
    if val < lo return lo end
    if val > hi return hi end
    val
end

M = {}
M.compare = compare
M.less = less
M.ordered = ordered
M.min = min
M.max = max
M.clamp = clamp
M
