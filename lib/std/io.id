# io home — subject-first handle relations only.
# No @c.emit. No lua. Namespace io.method() is forbidden — use io:read / handle:read.

read(file: any, arg: any): any
    file:read(arg)
end

write(file: any, arg: any): any
    file:write(arg)
end

close(file: any): void
    file:close()
end

flush(file: any): void
    file:flush()
end

read_bytes(file: any, n: int): str
    file:read(n)
end

write_bytes(file: any, data: str): void
    file:write(data)
end

read_line(file: any): any
    file:read("*l")
end

read_all(file: any): any
    file:read("*a")
end
