-- std.io — input/output utilities
-- Binary I/O: io.read(n) reads exactly n bytes from stdin (LSP Content-Length framing)
-- io.read("*l") reads a line, io.read("*a") reads all remaining input

-- Write a diagnostic to STANDARD ERROR, unbuffered.
--
-- There was no stderr surface here at all, so a Duo program that wanted to
-- report a failure had to `print` it -- onto the same stream as its RESULT. A
-- caller then cannot tell a failure from a value without parsing prose, which
-- is how a WASM runtime that REFUSED to execute a module went on looking like
-- one that had executed it and got -1 (ext/ward, `run_body`).
--
-- Raw C rather than `io.stderr:write` so it survives native-scalar lowering: a
-- module compiled with no boxed values has no `io` table to index, and the
-- error path is exactly where a program must not depend on the slow path
-- existing. `str` lowers to a C string, the same way `os.read_file` hands
-- `path` straight to `fopen`.
err(msg: str): void
    @c.emit("(void)(fputs(msg, stderr), fflush(stderr))")
end

open(filename: str, mode: str): any
    io.open(filename, mode)
end

popen(prog: str, mode: str): any
    io.popen(prog, mode)
end

read(file: any, arg: any): any
    file:read(arg)
end

write(file: any, arg: any): any
    file:write(arg)
end

close(file: any): void
    file:close()
end

flush(file: any): void
    file:flush()
end

lines(filename: str): any
    io.lines(filename)
end

input(file: any): any
    io.input(file)
end

output(file: any): any
    io.output(file)
end

tmpfile(): any
    io.tmpfile()
end

type(obj: any): any
    io.type(obj)
end

-- read_bytes: read exactly n bytes from a file or stdin.
-- For LSP JSON-RPC: read header with read("*l"), extract Content-Length,
-- then read_bytes(len) to get the body.
read_bytes(file: any, n: int): str
    file:read(n)
end

-- write_bytes: write a string/bytes to a file or stdout.
write_bytes(file: any, data: str): void
    file:write(data)
end

-- read_line: convenience to read one line from a file.
-- Returns `any`, not `str`: `file:read("*l")` yields nil at EOF, and declaring
-- `str` coerced that nil into the four-character string "nil". Every caller
-- testing `line == nil` then looped forever — this is what made the Duo MCP
-- servers hang instead of completing a handshake.
read_line(file: any): any
    file:read("*l")
end

-- read_all: same — nil at EOF must survive as nil.
read_all(file: any): any
    file:read("*a")
end

