fun std_memo_table_new()
    return {}
end

fun std_memo_table_get(m, key)
    return m[key]
end

fun std_memo_table_set(m, key, value)
    m[key] = value
end

fun std_memo_table_has(m, key)
    return m[key] ~= nil
end

fun std_memo_wrap(fn)
    cache = {}
    return fun(x)
        if cache[x] == nil then
            cache[x] = fn(x)
        end
        return cache[x]
    end
end

fun std_memo_clear(m)
    for k, _ in pairs(m)
        m[k] = nil
    end
end

M = {}
M.table_new = std_memo_table_new
M.table_get = std_memo_table_get
M.table_set = std_memo_table_set
M.table_has = std_memo_table_has
M.wrap = std_memo_wrap
M.clear = std_memo_clear
return M