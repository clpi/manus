-- std.strconv — string conversion utilities (mirrors Go's strconv package)
-- Provides numeric-to-string and string-to-numeric conversions with base
-- support, quote/unescape helpers, and boolean formatting.

-- ----- Number to string -----

-- format_int: format integer v as a string in the given base (2-36).
format_int(v: any, base: any): str
    if base == nil or base < 2 base = 10 end
    if base > 36 base = 36 end
    if v == 0 return "0" end
    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    neg = false
    n = v
    if n < 0
        neg = true
        n = 0 - n
    end
    out = {}
    while n > 0
        out[rawlen(out) + 1] = string.sub(digits, (n % base) + 1, (n % base) + 1)
        n = math.floor(n / base)
    end
    s = ""
    i = rawlen(out)
    while i >= 1
        s = s .. out[i]
        i -= 1
    end
    if neg s = "-" .. s end
    s
end

-- itoa: convenience for format_int(v, 10).
itoa(v: any): str
    format_int(v, 10)
end

-- format_float: format float v with 'g', 'f', or 'e' verb and precision.
format_float(v: any, fmt: str, prec: any): str
    if v == nil return "0" end
    if fmt == nil fmt = "g" end
    if prec == nil or prec < 0 prec = 0 - 1 end
    if fmt == "e"
        if prec < 0
            string.format("%e", v)
        else
            string.format("%." .. to(str)(prec) .. "e", v)
        end
    elseif fmt == "f"
        if prec < 0
            string.format("%f", v)
        else
            string.format("%." .. to(str)(prec) .. "f", v)
        end
    else
        -- 'g' or default
        if prec < 0
            string.format("%g", v)
        else
            string.format("%." .. to(str)(prec) .. "g", v)
        end
    end
end

-- ----- String to number -----

-- parse_int: interpret s as an integer in the given base. Returns (value, ok).
parse_int(s: str, base: any): any
    if s == nil or s == "" return 0, false end
    s = string.gsub(s, "^%s+", "")
    s = string.gsub(s, "%s+$", "")
    neg = false
    if string.sub(s, 1, 1) == "-"
        neg = true
        s = string.sub(s, 2)
    elseif string.sub(s, 1, 1) == "+"
        s = string.sub(s, 2)
    end
    if base == nil or base == 0
        base = 10
        if string.sub(s, 1, 2) == "0x" or string.sub(s, 1, 2) == "0X"
            base = 16
            s = string.sub(s, 3)
        elseif string.sub(s, 1, 1) == "0" and string.len(s) > 1
            base = 8
            s = string.sub(s, 2)
        end
    end
    if base < 2 or base > 36 return 0, false end
    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    val = 0
    i = 1
    while i <= string.len(s)
        ch = string.lower(string.sub(s, i, i))
        pos = string.find(digits, ch, 1, true)
        if pos == nil return 0, false end
        d = pos - 1
        if d >= base return 0, false end
        val = val * base + d
        i += 1
    end
    if neg val = 0 - val end
    return val, true
end

-- atoi: convenience for parse_int(s, 10).
atoi(s: str): any
    parse_int(s, 10)
end

-- parse_float: interpret s as a floating-point number. Returns (value, ok).
parse_float(s: str): any
    if s == nil or s == "" return 0.0, false end
    s = string.gsub(s, "^%s+", "")
    s = string.gsub(s, "%s+$", "")
    -- accept optional sign
    neg = false
    if string.sub(s, 1, 1) == "-"
        neg = true
        s = string.sub(s, 2)
    elseif string.sub(s, 1, 1) == "+"
        s = string.sub(s, 2)
    end
    -- match numeric pattern: digits . digits [eE [+-] digits]
    -- Use Lua pattern to validate
    m = string["match"](s, "^(%d+%.?%d*[eE]?[+-]?%d*)$")
    if m == nil
        m = string["match"](s, "^(%d*%.%d+[eE]?[+-]?%d*)$")
    end
    if m == nil return 0.0, false end
    v = tonumber(s)
    if v == nil return 0.0, false end
    if neg v = 0 - v end
    return v, true
end

-- parse_bool: interpret s as a boolean. Returns (value, ok).
parse_bool(s: str): any
    if s == nil return false, false end
    s = string.lower(s)
    if s == "1" or s == "t" or s == "true" return true, true end
    if s == "0" or s == "f" or s == "false" return false, true end
    return false, false
end

-- ----- Quote / unquote -----

-- quote: return a double-quoted, safely-escaped string literal.
quote(s: str): str
    if s == nil return "\"\"" end
    out = {"\""}
    i = 1
    while i <= string.len(s)
        ch = string.sub(s, i, i)
        b = string.byte(s, i)
        if ch == "\\"
            out[rawlen(out) + 1] = "\\\\"
        elseif ch == "\""
            out[rawlen(out) + 1] = "\\\""
        elseif ch == "\n"
            out[rawlen(out) + 1] = "\\n"
        elseif ch == "\r"
            out[rawlen(out) + 1] = "\\r"
        elseif ch == "\t"
            out[rawlen(out) + 1] = "\\t"
        elseif b < 32
            out[rawlen(out) + 1] = string.format("\\x%02X", b)
        else
            out[rawlen(out) + 1] = ch
        end
        i += 1
    end
    out[rawlen(out) + 1] = "\""
    table.concat(out)
end

-- unquote: remove surrounding quotes and interpret escape sequences.
unquote(s: str): str
    if s == nil return "" end
    n = string.len(s)
    if n < 2 return s end
    first = string.sub(s, 1, 1)
    last = string.sub(s, n, n)
    inner = s
    if (first == "\"" and last == "\"") or (first == "'" and last == "'")
        inner = string.sub(s, 2, n - 1)
    end
    out = {}
    i = 1
    while i <= string.len(inner)
        ch = string.sub(inner, i, i)
        if ch == "\\" and i < string.len(inner)
            nxt = string.sub(inner, i + 1, i + 1)
            if nxt == "n"
                out[rawlen(out) + 1] = "\n"
            elseif nxt == "t"
                out[rawlen(out) + 1] = "\t"
            elseif nxt == "r"
                out[rawlen(out) + 1] = "\r"
            elseif nxt == "\\"
                out[rawlen(out) + 1] = "\\"
            elseif nxt == "\""
                out[rawlen(out) + 1] = "\""
            elseif nxt == "'"
                out[rawlen(out) + 1] = "'"
            elseif nxt == "0"
                out[rawlen(out) + 1] = string.char(0)
            else
                out[rawlen(out) + 1] = nxt
            end
            i += 2
        else
            out[rawlen(out) + 1] = ch
            i += 1
        end
    end
    table.concat(out)
end

-- append_bool: format a boolean as "true" or "false".
format_bool(b: bool): str
    -- A guard, not `if b "true" else "false" end`. In the endless one-liner
    -- form the clause must be SELF-DELIMITED (Pass 48 2.4), and `b "true"`
    -- reads as PARENLESS APPLICATION -- the emitted C was
    -- `b(lua_val_from_literal("true", ...))`, i.e. calling a bool
    -- ("called object type 'bool' is not a function"), which took the module
    -- down.
    if b
        return "true"
    end
    "false"
end

