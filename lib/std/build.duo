-- std.build — build system and environment info

fun info(): any
    return {
        compiler = "duo",
        version = "0.1.0",
        host = os.getenv("HOSTNAME") or "unknown",
        timestamp = os.date("%Y-%m-%dT%H:%M:%S"),
    }
end

fun platform(): str
    os.getenv("OSTYPE") or "unknown"
end

fun arch(): str
    arch = os.getenv("HOSTTYPE") or os.getenv("MACHTYPE") or "unknown"
    arch
end

fun target(): str
    string.format("%s-%s", arch(), platform())
end

fun is_debug(): bool
    os.getenv("DEBUG") == "1"
end

fun env(): str
    os.getenv("BUILD_ENV") or "development"
end

M = {}
M.info = info
M.platform = platform
M.arch = arch
M.target = target
M.is_debug = is_debug
M.env = env
M
