-- std.text.transformer — Text transformation utilities
-- For NLP preprocessing and text normalization in ward's ML pipeline.

-- ═══════════════════════════════════════════════════════════════
-- Text Normalization
-- ═══════════════════════════════════════════════════════════════

lower(s: str): str
    result = ""
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c >= 65 and c <= 90  -- A-Z
            result = result .. string.char(c + 32)
        else
            result = result .. string.char(c)
        end
        i += 1
    end
    result
end

upper(s: str): str
    result = ""
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c >= 97 and c <= 122  -- a-z
            result = result .. string.char(c - 32)
        else
            result = result .. string.char(c)
        end
        i += 1
    end
    result
end

title(s: str): str
    capitalize_next = true
    result = ""
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10  -- whitespace
            capitalize_next = true
            result = result .. string.char(c)
        elseif capitalize_next and c >= 97 and c <= 122
            result = result .. string.char(c - 32)
            capitalize_next = false
        else
            result = result .. string.char(c)
            capitalize_next = false
        end
        i += 1
    end
    result
end

capitalize(s: str): str
    if #s == 0 return s end
    first = string.byte(s, 1)
    if first >= 97 and first <= 122
        return string.char(first - 32) .. string.sub(s, 2)
    end
    s
end

-- ═══════════════════════════════════════════════════════════════
-- Whitespace Handling
-- ═══════════════════════════════════════════════════════════════

trim(s: str): str
    -- Trim leading whitespace
    start = 1
    while start <= #s
        c = string.byte(s, start)
        if c != 32 and c != 9 and c != 10 and c != 13 break end
        start += 1
    end

    -- Trim trailing whitespace
    finish = #s
    while finish >= start
        c = string.byte(s, finish)
        if c != 32 and c != 9 and c != 10 and c != 13 break end
        finish -= 1
    end

    string.sub(s, start, finish)
end

trim_left(s: str): str
    start = 1
    while start <= #s
        c = string.byte(s, start)
        if c != 32 and c != 9 and c != 10 and c != 13 break end
        start += 1
    end
    string.sub(s, start)
end

trim_right(s: str): str
    finish = #s
    while finish >= 1
        c = string.byte(s, finish)
        if c != 32 and c != 9 and c != 10 and c != 13 break end
        finish -= 1
    end
    string.sub(s, 1, finish)
end

compress_whitespace(s: str): str
    result = ""
    in_whitespace = false
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13
            if not in_whitespace
                result = result .. " "
                in_whitespace = true
            end
        else
            result = result .. string.char(c)
            in_whitespace = false
        end
        i += 1
    end
    result
end

normalize_whitespace(s: str): str
    compress_whitespace(trim(s))
end

-- ═══════════════════════════════════════════════════════════════
-- Text Cleaning (for NLP)
-- ═══════════════════════════════════════════════════════════════

remove_accents(s: str): str
    -- Simple accent removal (ASCII approximation)
    accents = {
        ["á"] = "a", ["à"] = "a", ["ä"] = "a", ["â"] = "a", ["ã"] = "a",
        ["é"] = "e", ["è"] = "e", ["ë"] = "e", ["ê"] = "e",
        ["í"] = "i", ["ì"] = "i", ["ï"] = "i", ["î"] = "i",
        ["ó"] = "o", ["ò"] = "o", ["ö"] = "o", ["ô"] = "o", ["õ"] = "o",
        ["ú"] = "u", ["ù"] = "u", ["ü"] = "u", ["û"] = "u",
        ["ñ"] = "n", ["ç"] = "c",
        ["Á"] = "A", ["À"] = "A", ["Ä"] = "A", ["Â"] = "A", ["Ã"] = "A",
        ["É"] = "E", ["È"] = "E", ["Ë"] = "E", ["Ê"] = "E",
        ["Í"] = "I", ["Ì"] = "I", ["Ï"] = "I", ["Î"] = "I",
        ["Ó"] = "O", ["Ò"] = "O", ["Ö"] = "O", ["Ô"] = "O", ["Õ"] = "O",
        ["Ú"] = "U", ["Ù"] = "U", ["Ü"] = "U", ["Û"] = "U",
        ["Ñ"] = "N", ["Ç"] = "C",
    }

    result = ""
    i = 1
    while i <= #s
        -- Try to match multi-byte characters
        found = false
        for pattern, replacement in accents
            plen = #pattern
            if string.sub(s, i, i + plen - 1) == pattern
                result = result .. replacement
                i += plen
                found = true
                break
            end
        end
        if not found
            result = result .. string.char(string.byte(s, i))
            i += 1
        end
    end
    result
end

remove_punctuation(s: str): str
    result = ""
    i = 1
    while i <= #s
        c = string.byte(s, i)
        -- Keep alphanumeric and spaces
        if (c >= 48 and c <= 57) or  -- 0-9
           (c >= 65 and c <= 90) or  -- A-Z
           (c >= 97 and c <= 122) or -- a-z
           c == 32              -- space
            result = result .. string.char(c)
        end
        i += 1
    end
    result
end

collapse_whitespace(s: str): str
    normalize_whitespace(s)
end

normalize_unicode(s: str): str
    -- Simple Unicode normalization (NFKD approximation)
    -- Remove combining characters, normalize forms
    remove_accents(s)
end

-- ═══════════════════════════════════════════════════════════════
-- Text Analysis
-- ═══════════════════════════════════════════════════════════════

word_count(s: str): i64
    if #s == 0 return 0 end
    count = 1
    in_word = true
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13
            if in_word
                count += 1
                in_word = false
            end
        else
            in_word = true
        end
        i += 1
    end
    if not in_word count -= 1 end
    count
end

char_count(s: str): i64
    #s
end

sentence_count(s: str): i64
    count = 0
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c == 46 or c == 33 or c == 63  -- . ! ?
            count += 1
        end
        i += 1
    end
    count
end

avg_word_length(s: str): f64
    words = split_words(s)
    if #words == 0 return 0.0 end
    total = 0
    for word in words
        total += #word
    end
    total / #words
end

-- ═══════════════════════════════════════════════════════════════
-- Text Splitting
-- ═══════════════════════════════════════════════════════════════

split_lines(s: str): any
    lines = {}
    current = ""
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c == 10  -- newline
            lines[#lines + 1] = current
            current = ""
        elseif c == 13  -- carriage return
            -- Skip, handle \r\n
        else
            current = current .. string.char(c)
        end
        i += 1
    end
    if #current > 0
        lines[#lines + 1] = current
    end
    lines
end

split_words(s: str): any
    words = {}
    current = ""
    i = 1
    while i <= #s
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13
            if #current > 0
                words[#words + 1] = current
                current = ""
            end
        else
            current = current .. string.char(c)
        end
        i += 1
    end
    if #current > 0
        words[#words + 1] = current
    end
    words
end

split_sentences(s: str): any
    sentences = {}
    current = ""
    i = 1
    while i <= #s
        c = string.byte(s, i)
        current = current .. string.char(c)
        if c == 46 or c == 33 or c == 63  -- . ! ?
            sentences[#sentences + 1] = trim(current)
            current = ""
        end
        i += 1
    end
    if string.len(trim(current)) > 0
        sentences[#sentences + 1] = trim(current)
    end
    sentences
end

split_tokens(s: str, max_length: i64): any
    words = split_words(s)
    tokens = {}
    current = ""
    for word in words
        if #current + #word + 1 > max_length
            if #current > 0
                tokens[#tokens + 1] = current
                current = word
            else
                tokens[#tokens + 1] = word
            end
        else
            if #current > 0
                current = current .. " " .. word
            else
                current = word
            end
        end
    end
    if #current > 0
        tokens[#tokens + 1] = current
    end
    tokens
end

-- ═══════════════════════════════════════════════════════════════
-- Text Search & Replace
-- ═══════════════════════════════════════════════════════════════

replace(s: str, old: str, new: str): str
    result = ""
    i = 1
    old_len = #old
    while i <= #s
        if string.sub(s, i, i + old_len - 1) == old
            result = result .. new
            i += old_len
        else
            result = result .. string.char(string.byte(s, i))
            i += 1
        end
    end
    result
end

replace_all(s: str, old: str, new: str): str
    replace(s, old, new)
end

count_occurrences(s: str, pattern: str): i64
    count = 0
    i = 1
    pat_len = #pattern
    while i <= #s
        if string.sub(s, i, i + pat_len - 1) == pattern
            count += 1
            i += pat_len
        else
            i += 1
        end
    end
    count
end

-- ═══════════════════════════════════════════════════════════════
-- Text Encoding Detection (simplified)
-- ═══════════════════════════════════════════════════════════════

is_ascii(s: str): bool
    i = 1
    while i <= #s
        if string.byte(s, i) > 127 return false end
        i += 1
    end
    true
end

is_utf8(s: str): bool
    -- Simplified check
    is_ascii(s)
end

