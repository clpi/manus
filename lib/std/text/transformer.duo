-- std.text.transformer — Text transformation utilities
-- For NLP preprocessing and text normalization in ward's ML pipeline.

-- ═══════════════════════════════════════════════════════════════
-- Text Normalization
-- ═══════════════════════════════════════════════════════════════

fun text_lower(s: str): str
    result = ""
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c >= 65 and c <= 90 then  -- A-Z
            result = result .. string.char(c + 32)
        else
            result = result .. string.char(c)
        end
        i += 1
    end
    result
end

fun text_upper(s: str): str
    result = ""
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c >= 97 and c <= 122 then  -- a-z
            result = result .. string.char(c - 32)
        else
            result = result .. string.char(c)
        end
        i += 1
    end
    result
end

fun text_title(s: str): str
    capitalize_next = true
    result = ""
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10 then  -- whitespace
            capitalize_next = true
            result = result .. string.char(c)
        elseif capitalize_next and c >= 97 and c <= 122 then
            result = result .. string.char(c - 32)
            capitalize_next = false
        else
            result = result .. string.char(c)
            capitalize_next = false
        end
        i += 1
    end
    result
end

fun text_capitalize(s: str): str
    if string.len(s) == 0 then return s end
    first = string.byte(s, 1)
    if first >= 97 and first <= 122 then
        return string.char(first - 32) .. string.sub(s, 2)
    end
    s
end

-- ═══════════════════════════════════════════════════════════════
-- Whitespace Handling
-- ═══════════════════════════════════════════════════════════════

fun text_trim(s: str): str
    -- Trim leading whitespace
    start = 1
    while start <= string.len(s)
        c = string.byte(s, start)
        if c ~= 32 and c ~= 9 and c ~= 10 and c ~= 13 then break end
        start += 1
    end

    -- Trim trailing whitespace
    finish = string.len(s)
    while finish >= start
        c = string.byte(s, finish)
        if c ~= 32 and c ~= 9 and c ~= 10 and c ~= 13 then break end
        finish -= 1
    end

    string.sub(s, start, finish)
end

fun text_trim_left(s: str): str
    start = 1
    while start <= string.len(s)
        c = string.byte(s, start)
        if c ~= 32 and c ~= 9 and c ~= 10 and c ~= 13 then break end
        start += 1
    end
    string.sub(s, start)
end

fun text_trim_right(s: str): str
    finish = string.len(s)
    while finish >= 1
        c = string.byte(s, finish)
        if c ~= 32 and c ~= 9 and c ~= 10 and c ~= 13 then break end
        finish -= 1
    end
    string.sub(s, 1, finish)
end

fun text_compress_whitespace(s: str): str
    result = ""
    in_whitespace = false
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13 then
            if not in_whitespace then
                result = result .. " "
                in_whitespace = true
            end
        else
            result = result .. string.char(c)
            in_whitespace = false
        end
        i += 1
    end
    result
end

fun text_normalize_whitespace(s: str): str
    text_compress_whitespace(text_trim(s))
end

-- ═══════════════════════════════════════════════════════════════
-- Text Cleaning (for NLP)
-- ═══════════════════════════════════════════════════════════════

fun text_remove_accents(s: str): str
    -- Simple accent removal (ASCII approximation)
    accents = {
        ["á"] = "a", ["à"] = "a", ["ä"] = "a", ["â"] = "a", ["ã"] = "a",
        ["é"] = "e", ["è"] = "e", ["ë"] = "e", ["ê"] = "e",
        ["í"] = "i", ["ì"] = "i", ["ï"] = "i", ["î"] = "i",
        ["ó"] = "o", ["ò"] = "o", ["ö"] = "o", ["ô"] = "o", ["õ"] = "o",
        ["ú"] = "u", ["ù"] = "u", ["ü"] = "u", ["û"] = "u",
        ["ñ"] = "n", ["ç"] = "c",
        ["Á"] = "A", ["À"] = "A", ["Ä"] = "A", ["Â"] = "A", ["Ã"] = "A",
        ["É"] = "E", ["È"] = "E", ["Ë"] = "E", ["Ê"] = "E",
        ["Í"] = "I", ["Ì"] = "I", ["Ï"] = "I", ["Î"] = "I",
        ["Ó"] = "O", ["Ò"] = "O", ["Ö"] = "O", ["Ô"] = "O", ["Õ"] = "O",
        ["Ú"] = "U", ["Ù"] = "U", ["Ü"] = "U", ["Û"] = "U",
        ["Ñ"] = "N", ["Ç"] = "C",
    }

    result = ""
    i = 1
    while i <= string.len(s)
        -- Try to match multi-byte characters
        found = false
        for pattern, replacement in accents
            plen = string.len(pattern)
            if string.sub(s, i, i + plen - 1) == pattern then
                result = result .. replacement
                i += plen
                found = true
                break
            end
        end
        if not found then
            result = result .. string.char(string.byte(s, i))
            i += 1
        end
    end
    result
end

fun text_remove_punctuation(s: str): str
    result = ""
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        -- Keep alphanumeric and spaces
        if (c >= 48 and c <= 57) or  -- 0-9
           (c >= 65 and c <= 90) or  -- A-Z
           (c >= 97 and c <= 122) or -- a-z
           c == 32 then              -- space
            result = result .. string.char(c)
        end
        i += 1
    end
    result
end

fun text_collapse_whitespace(s: str): str
    text_normalize_whitespace(s)
end

fun text_normalize_unicode(s: str): str
    -- Simple Unicode normalization (NFKD approximation)
    -- Remove combining characters, normalize forms
    text_remove_accents(s)
end

-- ═══════════════════════════════════════════════════════════════
-- Text Analysis
-- ═══════════════════════════════════════════════════════════════

fun text_word_count(s: str): i64
    if string.len(s) == 0 then return 0 end
    count = 1
    in_word = true
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13 then
            if in_word then
                count += 1
                in_word = false
            end
        else
            in_word = true
        end
        i += 1
    end
    if not in_word then count -= 1 end
    count
end

fun text_char_count(s: str): i64
    string.len(s)
end

fun text_sentence_count(s: str): i64
    count = 0
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c == 46 or c == 33 or c == 63 then  -- . ! ?
            count += 1
        end
        i += 1
    end
    count
end

fun text_avg_word_length(s: str): f64
    words = text_split_words(s)
    if #words == 0 then return 0 end
    total = 0
    for word in words
        total += string.len(word)
    end
    total / #words
end

-- ═══════════════════════════════════════════════════════════════
-- Text Splitting
-- ═══════════════════════════════════════════════════════════════

fun text_split_lines(s: str): any
    lines = {}
    current = ""
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c == 10 then  -- newline
            lines[#lines + 1] = current
            current = ""
        elseif c == 13 then  -- carriage return
            -- Skip, handle \r\n
        else
            current = current .. string.char(c)
        end
        i += 1
    end
    if string.len(current) > 0 then
        lines[#lines + 1] = current
    end
    lines
end

fun text_split_words(s: str): any
    words = {}
    current = ""
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        if c == 32 or c == 9 or c == 10 or c == 13 then
            if string.len(current) > 0 then
                words[#words + 1] = current
                current = ""
            end
        else
            current = current .. string.char(c)
        end
        i += 1
    end
    if string.len(current) > 0 then
        words[#words + 1] = current
    end
    words
end

fun text_split_sentences(s: str): any
    sentences = {}
    current = ""
    i = 1
    while i <= string.len(s)
        c = string.byte(s, i)
        current = current .. string.char(c)
        if c == 46 or c == 33 or c == 63 then  -- . ! ?
            sentences[#sentences + 1] = text_trim(current)
            current = ""
        end
        i += 1
    end
    if string.len(text_trim(current)) > 0 then
        sentences[#sentences + 1] = text_trim(current)
    end
    sentences
end

fun text_split_tokens(s: str, max_length: i64): any
    words = text_split_words(s)
    tokens = {}
    current = ""
    for word in words
        if string.len(current) + string.len(word) + 1 > max_length then
            if string.len(current) > 0 then
                tokens[#tokens + 1] = current
                current = word
            else
                tokens[#tokens + 1] = word
            end
        else
            if string.len(current) > 0 then
                current = current .. " " .. word
            else
                current = word
            end
        end
    end
    if string.len(current) > 0 then
        tokens[#tokens + 1] = current
    end
    tokens
end

-- ═══════════════════════════════════════════════════════════════
-- Text Search & Replace
-- ═══════════════════════════════════════════════════════════════

fun text_replace(s: str, old: str, new: str): str
    result = ""
    i = 1
    old_len = string.len(old)
    while i <= string.len(s)
        if string.sub(s, i, i + old_len - 1) == old then
            result = result .. new
            i += old_len
        else
            result = result .. string.char(string.byte(s, i))
            i += 1
        end
    end
    result
end

fun text_replace_all(s: str, old: str, new: str): str
    text_replace(s, old, new)
end

fun text_count_occurrences(s: str, pattern: str): i64
    count = 0
    i = 1
    pat_len = string.len(pattern)
    while i <= string.len(s)
        if string.sub(s, i, i + pat_len - 1) == pattern then
            count += 1
            i += pat_len
        else
            i += 1
        end
    end
    count
end

-- ═══════════════════════════════════════════════════════════════
-- Text Encoding Detection (simplified)
-- ═══════════════════════════════════════════════════════════════

fun text_is_ascii(s: str): bool
    i = 1
    while i <= string.len(s)
        if string.byte(s, i) > 127 then return false end
        i += 1
    end
    true
end

fun text_is_utf8(s: str): bool
    -- Simplified check
    text_is_ascii(s)
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Normalization
M.lower = text_lower
M.upper = text_upper
M.title = text_title
M.capitalize = text_capitalize
-- Whitespace
M.trim = text_trim
M.trim_left = text_trim_left
M.trim_right = text_trim_right
M.compress_whitespace = text_compress_whitespace
M.normalize_whitespace = text_normalize_whitespace
-- Cleaning
M.remove_accents = text_remove_accents
M.remove_punctuation = text_remove_punctuation
M.collapse_whitespace = text_collapse_whitespace
M.normalize_unicode = text_normalize_unicode
-- Analysis
M.word_count = text_word_count
M.char_count = text_char_count
M.sentence_count = text_sentence_count
M.avg_word_length = text_avg_word_length
-- Splitting
M.split_lines = text_split_lines
M.split_words = text_split_words
M.split_sentences = text_split_sentences
M.split_tokens = text_split_tokens
-- Search
M.replace = text_replace
M.replace_all = text_replace_all
M.count_occurrences = text_count_occurrences
-- Encoding
M.is_ascii = text_is_ascii
M.is_utf8 = text_is_utf8
M
