-- std.text_scanner — text scanning (mirrors Go's text/scanner)
-- Provides a simple tokenizer for source-like text: identifiers, numbers,
-- strings, punctuation, and comments.

-- Token kinds
EOF = -1
IDENT = 1
INT = 2
FLOAT = 3
STRING = 4
CHAR = 5
PUNCT = 6
COMMENT = 7
NEWLINE = 8
WS = 9

-- new_scanner: create a scanner over source string s.
fun new_scanner(s: str): any
    {src = s, pos = 1, tok = "", kind = 0, line = 1, col = 1}
end

-- is_ident_start: report whether byte b can start an identifier.
fun is_ident_start(b: i64): bool
    (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95
end

-- is_ident_part: report whether byte b can continue an identifier.
fun is_ident_part(b: i64): bool
    is_ident_start(b) or (b >= 48 and b <= 57)
end

-- is_digit: report whether byte b is a digit.
fun is_digit(b: i64): bool
    b >= 48 and b <= 57
end

-- scan_ident: scan an identifier starting at current position.
fun scan_ident(sc: any): any
    start = sc.pos
    while sc.pos <= string.len(sc.src) and is_ident_part(string.byte(sc.src, sc.pos))
        sc.pos = sc.pos + 1
    end
    sc.tok = string.sub(sc.src, start, sc.pos - 1)
    sc.kind = IDENT
    sc
end

-- scan_number: scan an integer or float.
fun scan_number(sc: any): any
    start = sc.pos
    is_float = false
    while sc.pos <= string.len(sc.src) and is_digit(string.byte(sc.src, sc.pos))
        sc.pos = sc.pos + 1
    end
    -- check for decimal point
    if sc.pos <= string.len(sc.src) and string.byte(sc.src, sc.pos) == 46 then
        is_float = true
        sc.pos = sc.pos + 1
        while sc.pos <= string.len(sc.src) and is_digit(string.byte(sc.src, sc.pos))
            sc.pos = sc.pos + 1
        end
    end
    -- check for exponent
    if sc.pos <= string.len(sc.src) then
        b = string.byte(sc.src, sc.pos)
        if b == 101 or b == 69 then  -- 'e' or 'E'
            is_float = true
            sc.pos = sc.pos + 1
            if sc.pos <= string.len(sc.src) then
                b = string.byte(sc.src, sc.pos)
                if b == 43 or b == 45 then sc.pos = sc.pos + 1 end  -- + or -
            end
            while sc.pos <= string.len(sc.src) and is_digit(string.byte(sc.src, sc.pos))
                sc.pos = sc.pos + 1
            end
        end
    end
    sc.tok = string.sub(sc.src, start, sc.pos - 1)
    if is_float then
        sc.kind = FLOAT
    else
        sc.kind = INT
    end
    sc
end

-- scan_string: scan a quoted string. Supports " and ' delimiters.
fun scan_string(sc: any): any
    quote = string.byte(sc.src, sc.pos)
    sc.pos = sc.pos + 1
    start = sc.pos
    while sc.pos <= string.len(sc.src)
        b = string.byte(sc.src, sc.pos)
        if b == quote then
            sc.tok = string.sub(sc.src, start, sc.pos - 1)
            sc.pos = sc.pos + 1
            sc.kind = STRING
            return sc
        end
        if b == 92 then  -- backslash escape
            sc.pos = sc.pos + 2
        else
            sc.pos = sc.pos + 1
        end
    end
    -- unterminated string
    sc.tok = string.sub(sc.src, start)
    sc.kind = STRING
    sc
end

-- scan_comment: scan a line comment starting with -- or //.
fun scan_comment(sc: any): any
    start = sc.pos
    sc.pos = sc.pos + 2  -- skip prefix
    while sc.pos <= string.len(sc.src) and string.byte(sc.src, sc.pos) ~= 10
        sc.pos = sc.pos + 1
    end
    sc.tok = string.sub(sc.src, start, sc.pos - 1)
    sc.kind = COMMENT
    sc
end

-- scan: advance to the next token. Returns the token kind (or EOF).
fun scan(sc: any): i64
    if sc.pos > string.len(sc.src) then
        sc.tok = ""
        sc.kind = EOF
        return EOF
    end
    -- skip whitespace but track newlines
    while sc.pos <= string.len(sc.src)
        b = string.byte(sc.src, sc.pos)
        if b == 32 or b == 9 then
            sc.pos = sc.pos + 1
        elseif b == 10 then
            sc.line = sc.line + 1
            sc.pos = sc.pos + 1
            sc.tok = "\n"
            sc.kind = NEWLINE
            return NEWLINE
        else
            break
        end
    end
    if sc.pos > string.len(sc.src) then
        sc.tok = ""
        sc.kind = EOF
        return EOF
    end
    b = string.byte(sc.src, sc.pos)
    -- comment
    if b == 45 and sc.pos + 1 <= string.len(sc.src) and string.byte(sc.src, sc.pos + 1) == 45 then
        return scan_comment(sc)
    end
    if b == 47 and sc.pos + 1 <= string.len(sc.src) and string.byte(sc.src, sc.pos + 1) == 47 then
        return scan_comment(sc)
    end
    -- identifier
    if is_ident_start(b) then
        return scan_ident(sc)
    end
    -- number
    if is_digit(b) then
        return scan_number(sc)
    end
    -- string
    if b == 34 or b == 39 then  -- " or '
        return scan_string(sc)
    end
    -- punctuation (single char)
    sc.tok = string.sub(sc.src, sc.pos, sc.pos)
    sc.kind = PUNCT
    sc.pos = sc.pos + 1
    PUNCT
end

-- token_text: return the current token text.
fun token_text(sc: any): str
    sc.tok
end

-- token_kind: return the current token kind.
fun token_kind(sc: any): i64
    sc.kind
end

M = {}
M.EOF = EOF
M.IDENT = IDENT
M.INT = INT
M.FLOAT = FLOAT
M.STRING = STRING
M.CHAR = CHAR
M.PUNCT = PUNCT
M.COMMENT = COMMENT
M.NEWLINE = NEWLINE
M.WS = WS
M.new_scanner = new_scanner
M.scan = scan
M.scan_ident = scan_ident
M.scan_number = scan_number
M.scan_string = scan_string
M.scan_comment = scan_comment
M.token_text = token_text
M.token_kind = token_kind
M