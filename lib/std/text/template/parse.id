# std.text.template.parse — Template AST and parser (mirrors Go's text/template/parse)

new_node(kind: any)
    return {kind = kind, children = {}, text = "", pos = 0}
end

parse(template: any)
    if template == nil return new_node("module") end
    root = new_node("module")
    i = 1
    n = #template
    while i <= n
        d1, d2, before = template:find("^(.-){[{]", i)
        if before != nil
            pos = #before
            before = before:gsub("^{", "", 1)
            if #before > 0
                text_node = new_node("text")
                text_node.text = before
                root.children[root.children:len() + 1] = text_node
            end
            i = template:find("{", i + 1)
            if i == nil break end
            d3, d4, expr = template:find("{{(.-)}}", i)
            if expr != nil
                action_node = new_node("action")
                action_node.text = expr
                root.children[root.children:len() + 1] = action_node
                d5, ni = template:find("}}", i)
                if ni i = ni + 1 end
            else
                text_node = new_node("text")
                text_node.text = template:sub(i, i)
                root.children[root.children:len() + 1] = text_node
                i += 1
            end
        else
            text_node = new_node("text")
            text_node.text = template:sub(i)
            root.children[root.children:len() + 1] = text_node
            break
        end
    end
    return root
end

