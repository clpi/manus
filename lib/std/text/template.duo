-- std.text_template — simple text templating (mirrors Go's text/template)
-- Provides {{.Field}} substitution and {{range}}/{{end}} blocks over a data
-- table. This is a minimal implementation covering the most common patterns.

-- execute: render a template string against a data table.
-- Supports: {{.key}} for field access, {{range .key}}...{{end}} for iteration,
-- and {{if .key}}...{{end}} for conditional blocks.
execute(tmpl: str, data: any): str
    if tmpl == nil return "" end
    if data == nil data = {} end
    return render(tmpl, data)
end

-- render: internal recursive renderer.
render(tmpl: str, data: any): str
    out = {}
    i = 1
    n = string.len(tmpl)
    while i <= n
        -- look for {{ 
        if i + 1 <= n and string.sub(tmpl, i, i + 1) == "{{"
            close = string.find(tmpl, "}}", i + 2, true)
            if close == nil
                out[rawlen(out) + 1] = string.sub(tmpl, i)
                break
            end
            expr = string.gsub(string.sub(tmpl, i + 2, close - 1), "^%s+", "")
            expr = string.gsub(expr, "%s+$", "")
            result = eval_expr(expr, data)
            out[rawlen(out) + 1] = to(str)(result)
            i = close + 2
        else
            out[rawlen(out) + 1] = string.sub(tmpl, i, i)
            i += 1
        end
    end
    table.concat(out)
end

-- eval_expr: evaluate a template expression against data.
eval_expr(expr: str, data: any): any
    -- handle range
    if string.sub(expr, 1, 6) == "range "
        -- this is handled in the block parser, not here
        return ""
    end
    -- handle if
    if string.sub(expr, 1, 3) == "if "
        return ""
    end
    -- handle end
    if expr == "end" return "" end
    -- handle field access: .key or .key.subkey
    if string.sub(expr, 1, 1) == "."
        path = string.sub(expr, 2)
        return resolve_path(path, data)
    end
    -- literal
    expr
end

-- resolve_path: resolve a dotted path against a data table.
resolve_path(path: str, data: any): any
    if path == "" return data end
    -- split on .
    parts = {}
    rest = path
    while true
        dot = string.find(rest, ".", 1, true)
        if dot == nil
            parts[rawlen(parts) + 1] = rest
            break
        end
        parts[rawlen(parts) + 1] = string.sub(rest, 1, dot - 1)
        rest = string.sub(rest, dot + 1)
    end
    cur = data
    i = 1
    while i <= rawlen(parts)
        if cur == nil return "" end
        cur = cur[parts[i]]
        i += 1
    end
    if cur == nil return "" end
    cur
end

-- execute_blocks: render with range/if block support.
-- This handles {{range .key}}...{{end}} and {{if .key}}...{{end}}.
execute_blocks(tmpl: str, data: any): str
    if tmpl == nil return "" end
    if data == nil data = {} end
    render_blocks(tmpl, data, 1)
end

-- render_blocks: render with block support, returns the rendered string.
render_blocks(tmpl: str, data: any, start: i64): str
    out = {}
    i = start
    n = string.len(tmpl)
    while i <= n
        if i + 1 <= n and string.sub(tmpl, i, i + 1) == "{{"
            close = string.find(tmpl, "}}", i + 2, true)
            if close == nil
                out[rawlen(out) + 1] = string.sub(tmpl, i)
                break
            end
            expr = string.gsub(string.sub(tmpl, i + 2, close - 1), "^%s+", "")
            expr = string.gsub(expr, "%s+$", "")
            -- range block
            if string.sub(expr, 1, 6) == "range "
                key = string.gsub(string.sub(expr, 7), "^%.", "")
                collection = data[key]
                -- find matching {{end}}
                depth = 1
                j = close + 2
                block_start = j
                block_end = nil
                while j <= n
                    if j + 1 <= n and string.sub(tmpl, j, j + 1) == "{{"
                        c2 = string.find(tmpl, "}}", j + 2, true)
                        if c2 != nil
                            inner = string.gsub(string.sub(tmpl, j + 2, c2 - 1), "^%s+", "")
                            inner = string.gsub(inner, "%s+$", "")
                            if string.sub(inner, 1, 6) == "range "
                                depth += 1
                            elseif inner == "end"
                                depth -= 1
                                if depth == 0
                                    block_end = j
                                    break
                                end
                            end
                            j = c2 + 2
                        else
                            j += 1
                        end
                    else
                        j += 1
                    end
                end
                if block_end != nil and collection != nil
                    block_text = string.sub(tmpl, block_start, block_end - 1)
                    k = 1
                    if type(collection) == "table"
                        -- iterate array part
                        while k <= rawlen(collection)
                            out[rawlen(out) + 1] = render_blocks(block_text, collection[k], 1)
                            k += 1
                        end
                        -- also iterate hash parts
                        for hk, hv in collection
                            if type(hk) != "number"
                                item = hv
                                if type(hv) != "table"
                                    item = {value = hv, key = hk}
                                end
                                out[rawlen(out) + 1] = render_blocks(block_text, item, 1)
                            end
                        end
                    end
                end
                i = block_end + 2
                if block_end == nil i = n + 1 end
            elseif string.sub(expr, 1, 3) == "if "
                key = string.gsub(string.sub(expr, 4), "^%.", "")
                cond = data[key]
                -- find matching {{end}}
                depth = 1
                j = close + 2
                block_start = j
                block_end = nil
                while j <= n
                    if j + 1 <= n and string.sub(tmpl, j, j + 1) == "{{"
                        c2 = string.find(tmpl, "}}", j + 2, true)
                        if c2 != nil
                            inner = string.gsub(string.sub(tmpl, j + 2, c2 - 1), "^%s+", "")
                            inner = string.gsub(inner, "%s+$", "")
                            if string.sub(inner, 1, 3) == "if "
                                depth += 1
                            elseif inner == "end"
                                depth -= 1
                                if depth == 0
                                    block_end = j
                                    break
                                end
                            end
                            j = c2 + 2
                        else
                            j += 1
                        end
                    else
                        j += 1
                    end
                end
                if block_end != nil and cond != nil and cond != false
                    block_text = string.sub(tmpl, block_start, block_end - 1)
                    out[rawlen(out) + 1] = render_blocks(block_text, data, 1)
                end
                i = block_end + 2
                if block_end == nil i = n + 1 end
            else
                result = eval_expr(expr, data)
                out[rawlen(out) + 1] = to(str)(result)
                i = close + 2
            end
        else
            out[rawlen(out) + 1] = string.sub(tmpl, i, i)
            i += 1
        end
    end
    table.concat(out)
end

M = {}
M.execute = execute_blocks
M.render = render
M.execute_blocks = execute_blocks
M