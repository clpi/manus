-- std.trace — beautiful, semantically-formatted trace & debug output
--
-- Design:
--   * Every event is signed with a beautiful Unicode glyph and colored
--     by severity. Bold/italic/dim/underline/strikethrough/reverse
--     carry semantic meaning (see LEGEND below).
--   * Spans can be opened/closed and timed.
--   * Field values are colored by Lua TYPE so a glance reveals shape.
--   * Source locations are underline; function names are magenta-italic;
--     timestamps are dim; slow durations are bold-yellow.
--   * Honors NO_COLOR / DUO_COLOR env vars.
--
-- LEGEND of formatting semantics:
--   bold       = essential payload (msg, error text, slow span durs)
--   italic     = identity (function names, type names, nil)
--   dim        = ancillary (timestamps, caller meta, trace level)
--   underline  = location references (file:line, field keys)
--   strikethrough = deleted/removed (in diffs, deprecated values)
--   reverse    = breakpoint / attention-grab (fatal banner, divider)
--   color      = severity / type class
--
-- NOTE: this module is intentionally self-contained — it does not
-- `req` other stdlib modules at top level. The current codegen drops
-- top-level `local x = req "stdlib"` bindings when a stdlib module is
-- inlined under `duo run`; inlining ANSI codes + tty detection here
-- keeps std.trace compilable today. When that codegen gap is fixed,
-- trace.duo can switch back to `local color = req "std.color"` etc.

global M = {}

-- ─── ANSI codes (inline copy of std.color) ─────────────────────────
M.RESET      = "\x1b[0m"
M.BOLD       = "\x1b[1m"
M.DIM        = "\x1b[2m"
M.ITALIC     = "\x1b[3m"
M.UNDERLINE  = "\x1b[4m"
M.BLINK      = "\x1b[5m"
M.REVERSE    = "\x1b[7m"
M.STRIKE     = "\x1b[9m"

M.BLACK      = "\x1b[30m"
M.RED        = "\x1b[31m"
M.GREEN      = "\x1b[32m"
M.YELLOW     = "\x1b[33m"
M.BLUE       = "\x1b[34m"
M.MAGENTA    = "\x1b[35m"
M.CYAN       = "\x1b[36m"
M.WHITE      = "\x1b[37m"

M.BRIGHT_BLACK   = "\x1b[90m"
M.BRIGHT_RED     = "\x1b[91m"
M.BRIGHT_GREEN   = "\x1b[92m"
M.BRIGHT_YELLOW  = "\x1b[93m"
M.BRIGHT_BLUE    = "\x1b[94m"
M.BRIGHT_MAGENTA = "\x1b[95m"
M.BRIGHT_CYAN    = "\x1b[96m"
M.BRIGHT_WHITE   = "\x1b[97m"

M.BG_BLACK   = "\x1b[40m"
M.BG_RED     = "\x1b[41m"
M.BG_GREEN   = "\x1b[42m"
M.BG_YELLOW  = "\x1b[43m"
M.BG_BLUE    = "\x1b[44m"
M.BG_MAGENTA = "\x1b[45m"
M.BG_CYAN    = "\x1b[46m"
M.BG_WHITE   = "\x1b[47m"

-- ─── Glyphs ────────────────────────────────────────────────────────
M.G_TRACE      = "∘"
M.G_DEBUG      = "⊙"
M.G_INFO       = "✦"
M.G_WARN       = "▲"
M.G_ERROR      = "✕"
M.G_FATAL      = "☠"

M.G_SPAN_BEGIN = "┌─"
M.G_SPAN_END   = "└─"
M.G_ARROW      = "⤳"
M.G_DUR        = "⊹"
M.G_KV_SEP     = "="
M.G_PIPE       = "│"
M.G_BULLET     = "•"
M.G_DOT        = "·"
M.G_CROSS      = "┼"
M.G_ELLIPSIS   = "⋯"
M.G_DASH       = "─"
M.G_EQUIV      = "≡"
M.G_PROPEL     = "▸"
M.G_RETURN     = "◂"
M.G_CHECK      = "✓"
M.G_CROSS_MARK = "✗"
M.G_WARN_MARK  = "⚠"
M.G_INFO_MARK  = "ℹ"
M.G_POINTER    = "→"
M.G_SEED       = "⊕"
M.G_SNAPSHOT   = "◎"
M.G_LOCK       = "🔒"
M.G_UNLOCK     = "🔓"
M.G_STAR       = "★"
M.G_DIAMOND    = "◆"
M.G_SQUARE     = "■"
M.G_CIRCLE     = "●"
M.G_TRIANGLE   = "▲"
M.G_HEXAGON    = "⬡"

-- ─── Box-drawing palette ──────────────────────────────────────────
M.BOX_TL = "╭"   -- top-left rounded
M.BOX_TR = "╮"   -- top-right rounded
M.BOX_BL = "╰"   -- bottom-left rounded
M.BOX_BR = "╯"   -- bottom-right rounded
M.BOX_ML = "├"   -- mid-left
M.BOX_MR = "┤"   -- mid-right
M.BOX_H  = "─"   -- horizontal
M.BOX_V  = "│"   -- vertical
M.BOX_C  = "┼"   -- cross
M.BOX_TL_SQUARE = "┌"
M.BOX_TR_SQUARE = "┐"
M.BOX_BL_SQUARE = "└"
M.BOX_BR_SQUARE = "┘"

-- ─── Levels ────────────────────────────────────────────────────────
M.LV_TRACE = 0
M.LV_DEBUG = 1
M.LV_INFO  = 2
M.LV_WARN  = 3
M.LV_ERROR = 4
M.LV_FATAL = 5

M.level_value = {
    trace = M.LV_TRACE, debug = M.LV_DEBUG, info = M.LV_INFO,
    warn = M.LV_WARN, error = M.LV_ERROR, fatal = M.LV_FATAL,
}
M.level_name = {
    [0] = "trace", [1] = "debug", [2] = "info",
    [3] = "warn", [4] = "error", [5] = "fatal",
}

global trace_level = M.LV_INFO
global trace_show_caller = true
global trace_show_ts = true
global trace_spans = {}
global trace_color = true

-- ─── tty detection ────────────────────────────────────────────────
tty(): bool
    ok, val = pcall(os.getenv, "DUO_COLOR")
    if ok and val != nil and val != "" and val != "0"
        return true
    end
    ok2, val2 = pcall(os.getenv, "NO_COLOR")
    if ok2 and val2 != nil and val2 != ""
        return false
    end
    return true
end

-- ─── Low-level style wrappers ────────────────────────────────────

s(prefix: str, text: str, suffix: str): str
    if prefix == nil prefix = "" end
    if suffix == nil suffix = M.RESET end
    if not tty()
        return tostring(text)
    end
    return prefix .. tostring(text) .. suffix
end

bold(text: str): str
    return M.BOLD .. tostring(text) .. M.RESET
end

dim(text: str): str
    return M.DIM .. tostring(text) .. M.RESET
end

italic(text: str): str
    return M.ITALIC .. tostring(text) .. M.RESET
end

underline(text: str): str
    return M.UNDERLINE .. tostring(text) .. M.RESET
end

strikethrough(text: str): str
    return M.STRIKE .. tostring(text) .. M.RESET
end

reverse(text: str): str
    return M.REVERSE .. tostring(text) .. M.RESET
end

blink(text: str): str
    return M.BLINK .. tostring(text) .. M.RESET
end

red(text: str): str
    return M.RED .. tostring(text) .. M.RESET
end

green(text: str): str
    return M.GREEN .. tostring(text) .. M.RESET
end

yellow(text: str): str
    return M.YELLOW .. tostring(text) .. M.RESET
end

blue(text: str): str
    return M.BLUE .. tostring(text) .. M.RESET
end

magenta(text: str): str
    return M.MAGENTA .. tostring(text) .. M.RESET
end

cyan(text: str): str
    return M.CYAN .. tostring(text) .. M.RESET
end

bright_red(text: str): str
    return M.BRIGHT_RED .. tostring(text) .. M.RESET
end

bright_green(text: str): str
    return M.BRIGHT_GREEN .. tostring(text) .. M.RESET
end

bright_yellow(text: str): str
    return M.BRIGHT_YELLOW .. tostring(text) .. M.RESET
end

bright_blue(text: str): str
    return M.BRIGHT_BLUE .. tostring(text) .. M.RESET
end

bright_magenta(text: str): str
    return M.BRIGHT_MAGENTA .. tostring(text) .. M.RESET
end

bright_cyan(text: str): str
    return M.BRIGHT_CYAN .. tostring(text) .. M.RESET
end

bright_white(text: str): str
    return M.BRIGHT_WHITE .. tostring(text) .. M.RESET
end

gray(text: str): str
    return M.BRIGHT_BLACK .. tostring(text) .. M.RESET
end

-- ─── Compound semantic styles ─────────────────────────────────────
-- These combine attributes for specific semantic roles.
-- Each one paints a single concept — use them to build readable output.

sem_success(text: str): str
    return M.BOLD .. M.GREEN .. tostring(text) .. M.RESET
end

sem_failure(text: str): str
    return M.BOLD .. M.RED .. tostring(text) .. M.RESET
end

sem_caution(text: str): str
    return M.BOLD .. M.YELLOW .. tostring(text) .. M.RESET
end

sem_identity(text: str): str
    return M.ITALIC .. M.MAGENTA .. tostring(text) .. M.RESET
end

sem_location(text: str): str
    return M.UNDERLINE .. tostring(text) .. M.RESET
end

sem_meta(text: str): str
    return M.DIM .. tostring(text) .. M.RESET
end

sem_payload(text: str): str
    return M.BOLD .. tostring(text) .. M.RESET
end

sem_deleted(text: str): str
    return M.STRIKE .. M.RED .. tostring(text) .. M.RESET
end

sem_added(text: str): str
    return M.BOLD .. M.GREEN .. tostring(text) .. M.RESET
end

sem_changed_old(text: str): str
    return M.DIM .. M.RED .. tostring(text) .. M.RESET
end

sem_changed_new(text: str): str
    return M.BOLD .. M.GREEN .. tostring(text) .. M.RESET
end

sem_type(text: str): str
    return M.ITALIC .. M.CYAN .. tostring(text) .. M.RESET
end

sem_constant(text: str): str
    return M.BOLD .. M.BRIGHT_CYAN .. tostring(text) .. M.RESET
end

sem_hex(text: str): str
    return M.BRIGHT_BLACK .. M.UNDERLINE .. tostring(text) .. M.RESET
end

sem_size(text: str): str
    return M.BRIGHT_YELLOW .. tostring(text) .. M.RESET
end

sem_percent(text: str): str
    return M.BRIGHT_MAGENTA .. tostring(text) .. M.RESET
end

sem_time_fast(text: str): str
    return M.DIM .. M.GREEN .. tostring(text) .. M.RESET
end

sem_time_normal(text: str): str
    return M.YELLOW .. tostring(text) .. M.RESET
end

sem_time_slow(text: str): str
    return M.BOLD .. M.RED .. tostring(text) .. M.RESET
end

sem_attention(text: str): str
    return M.REVERSE .. M.BOLD .. tostring(text) .. M.RESET
end

sem_deprecated(text: str): str
    return M.STRIKE .. M.DIM .. tostring(text) .. M.RESET
end

sem_key(text: str): str
    return M.UNDERLINE .. M.CYAN .. tostring(text) .. M.RESET
end

sem_nil(text: str): str
    return M.DIM .. M.ITALIC .. tostring(text) .. M.RESET
end

sem_string_val(text: str): str
    return M.GREEN .. tostring(text) .. M.RESET
end

sem_number_val(text: str): str
    return M.YELLOW .. tostring(text) .. M.RESET
end

sem_bool_val(text: str): str
    return M.MAGENTA .. tostring(text) .. M.RESET
end

sem_table_val(text: str): str
    return M.CYAN .. tostring(text) .. M.RESET
end

sem_function_val(text: str): str
    return M.ITALIC .. M.CYAN .. tostring(text) .. M.RESET
end

sem_breakpoint(text: str): str
    return M.REVERSE .. M.RED .. M.BOLD .. tostring(text) .. M.RESET
end

sem_banner_line(text: str): str
    return M.BOLD .. M.CYAN .. tostring(text) .. M.RESET
end

sem_frame(text: str): str
    return M.BRIGHT_BLACK .. tostring(text) .. M.RESET
end

sem_numbering(text: str): str
    return M.DIM .. M.BRIGHT_BLACK .. tostring(text) .. M.RESET
end

sem_diff_hunk(text: str): str
    return M.BOLD .. M.BRIGHT_WHITE .. tostring(text) .. M.RESET
end

sem_context_line(text: str): str
    return M.DIM .. tostring(text) .. M.RESET
end

-- ─── Value formatting ─────────────────────────────────────────────
tbl_summary(t: any): str
    if t == nil return "nil" end
    n = rawlen(t)
    if n > 0
        return "array(" .. tostring(n) .. ")"
    end
    count = 0
    first = ""
    for k, _v in t
        count += 1
        if count == 1 first = tostring(k) end
    end
    if count == 0 return "{}" end
    if count <= 3
        return "{" .. first .. ", ...}"
    end
    return "{" .. tostring(count) .. " keys}"
end

pretty_val(value: any): str
    if value == nil
        return sem_nil("nil")
    end
    t = type(value)
    if t:find("string") == 1
        return sem_string_val('"' .. tostring(value) .. '"')
    elseif t:find("number") == 1
        return sem_number_val(tostring(value))
    elseif t:find("boolean") == 1
        return sem_bool_val(tostring(value))
    elseif t:find("function") == 1
        return sem_function_val("⟪fn⟫")
    elseif t:find("table") == 1
        n = rawlen(value)
        if n > 0
            return sem_table_val("⟦array " .. tostring(n) .. "⟧")
        end
        return sem_table_val(italic("{" .. tbl_summary(value) .. "}"))
    end
    return tostring(value)
end

pretty_kv(k: str, v: any): str
    return sem_key(tostring(k)) .. dim(" " .. M.G_KV_SEP .. " ") .. pretty_val(v)
end

-- ─── Contextual formatters ───────────────────────────────────────

_to_hex(n: int): str
    digits = "0123456789abcdef"
    if n == 0 return "0" end
    result = ""
    while n > 0
        d = math.floor(n % 16) + 1
        result = string.sub(digits, d, d) .. result
        n = math.floor(n / 16)
    end
    return result
end

fmt_hex(value: any): str
    n = tonumber(value)
    if n == nil return tostring(value) end
    neg = false
    if n < 0 neg = true; n = -n end
    hex = _to_hex(math.floor(n))
    if neg hex = "-" .. hex end
    return sem_hex("0x" .. hex)
end

fmt_size(bytes: any): str
    n = tonumber(bytes)
    if n == nil return tostring(bytes) end
    if n < 1024
        return sem_size(tostring(n) .. "B")
    elseif n < 1048576
        whole = math.floor(n / 1024)
        frac = math.floor((n - whole * 1024) * 10 / 1024)
        return sem_size(tostring(whole) .. "." .. tostring(frac) .. "KB")
    elseif n < 1073741824
        whole = math.floor(n / 1048576)
        frac = math.floor((n - whole * 1048576) * 10 / 1048576)
        return sem_size(tostring(whole) .. "." .. tostring(frac) .. "MB")
    else
        whole = math.floor(n / 1073741824)
        frac = math.floor((n - whole * 1073741824) * 10 / 1073741824)
        return sem_size(tostring(whole) .. "." .. tostring(frac) .. "GB")
    end
end

fmt_pct(value: any): str
    n = tonumber(value)
    if n == nil return tostring(value) end
    whole = math.floor(n)
    frac = math.floor((n - whole) * 100 + 0.5)
    if frac >= 100 frac = 99 end
    frac_str = tostring(frac)
    if frac < 10 frac_str = "0" .. tostring(frac) end
    return sem_percent(tostring(whole) .. "." .. frac_str .. "%")
end

fmt_count(n: any): str
    num = tonumber(n)
    if num == nil return tostring(n) end
    return sem_number_val(tostring(num))
end

fmt_bool(b: any): str
    if b return sem_added("true") end
    return sem_deleted("false")
end

fmt_nil(): str
    return sem_nil("nil")
end

fmt_ref(id: any): str
    return sem_hex(tostring(id))
end

fmt_path(path: str): str
    return sem_location(tostring(path))
end

-- ─── Caller info ───────────────────────────────────────────────────
caller(level: int): str
    info = debug.getinfo(level, "Snl")
    if info == nil return "" end
    name_part = info.name
    if name_part == nil or name_part == ""
        name_part = "?"
    end
    src = info.short_src
    if src == nil src = info.source end
    if src == nil src = "?" end
    loc = src
    if info.currentline and info.currentline > 0
        loc = src .. dim(":") .. yellow(tostring(info.currentline))
    end
    return sem_identity(name_part) .. dim(" " .. M.G_ARROW .. " ") .. sem_location(loc)
end

-- ─── Timestamp ─────────────────────────────────────────────────────
ts(): str
    secs = os.time()
    ms = math.floor((os.clock() * 1000) % 1000)
    frac = "." .. tostring(ms)
    if ms < 10 frac = ".00" .. tostring(ms)
    elseif ms < 100 frac = ".0" .. tostring(ms)
    end
    return sem_meta(os.date("%H:%M:%S", secs) .. frac)
end

-- ─── Level tag ─────────────────────────────────────────────────────
level_tag(level: int): str
    glyph = M.G_TRACE
    tag = "trace"
    if level == M.LV_DEBUG
        glyph = M.G_DEBUG; tag = "debug"
    elseif level == M.LV_INFO
        glyph = M.G_INFO;  tag = " info"
    elseif level == M.LV_WARN
        glyph = M.G_WARN;  tag = " warn"
    elseif level == M.LV_ERROR
        glyph = M.G_ERROR; tag = "error"
    elseif level == M.LV_FATAL
        glyph = M.G_FATAL; tag = "fatal"
    end
    body = glyph .. " " .. tag
    if level == M.LV_TRACE return dim(body) end
    if level == M.LV_DEBUG return blue(body) end
    if level == M.LV_INFO return sem_success(body) end
    if level == M.LV_WARN return sem_caution(body) end
    if level == M.LV_ERROR return sem_failure(body) end
    if level == M.LV_FATAL
        return sem_breakpoint(body)
    end
    return body
end

-- ─── Span indent ───────────────────────────────────────────────────
span_indent(): str
    n = rawlen(trace_spans)
    if n <= 0 return "" end
    rep = string.rep(M.G_PIPE .. " ", n)
    if rep == nil or rep == "" return "" end
    return dim(rep)
end

-- ─── Duration formatting with speed coloring ──────────────────────
_fmt_dur(ms: float): str
    whole = math.floor(ms)
    frac = math.floor((ms - whole) * 100)
    frac_str = tostring(frac)
    if frac < 10 frac_str = "0" .. tostring(frac) end
    raw = tostring(whole) .. "." .. frac_str .. "ms"
    if ms < 1
        return sem_time_fast(raw)
    elseif ms < 16
        return sem_time_normal(raw)
    else
        return sem_time_slow(raw)
    end
end

-- ─── Emit ──────────────────────────────────────────────────────────
emit(level: int, msg: str, fields: any, skip: int): void
    if level < trace_level return end
    parts = {}
    parts[rawlen(parts) + 1] = level_tag(level)
    if trace_show_ts
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if trace_show_caller
        c = caller(skip + 1)
        if c != ""
            parts[rawlen(parts) + 1] = dim("(") .. c .. dim(")")
        end
    end
    parts[rawlen(parts) + 1] = span_indent()
    if msg != nil and msg != ""
        parts[rawlen(parts) + 1] = sem_payload(msg)
    end
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
end

-- ─── Public API ─────────────────────────────────────────────────
set_level(level: any): void
    if type(level) == "string"
        v = M.level_value[string.lower(level)]
        if v != nil
            trace_level = v
        end
        return
    end
    if type(level) == "number"
        if level >= M.LV_TRACE and level <= M.LV_FATAL
            trace_level = level
        end
    end
end

get_level(): str
    return M.level_name[trace_level] or "info"
end

show_caller(on: bool): void
    trace_show_caller = on and true or false
end

show_timestamp(on: bool): void
    trace_show_ts = on and true or false
end

set_color(on: bool): void
    trace_color = on and true or false
end

trace(msg: str, fields: any): void
    emit(M.LV_TRACE, msg, fields, 2)
end

_debug(msg: str, fields: any): void
    emit(M.LV_DEBUG, msg, fields, 2)
end

info(msg: str, fields: any): void
    emit(M.LV_INFO, msg, fields, 2)
end

warn(msg: str, fields: any): void
    emit(M.LV_WARN, msg, fields, 2)
end

error(msg: str, fields: any): void
    emit(M.LV_ERROR, msg, fields, 2)
end

fatal(msg: str, fields: any): void
    emit(M.LV_FATAL, msg, fields, 2)
end

-- ─── Spans ────────────────────────────────────────────────────────
span(name: str, fields: any): any
    h = {
        name = name or "span",
        start = os.clock(),
        depth = rawlen(trace_spans) + 1,
    }
    trace_spans[rawlen(trace_spans) + 1] = h
    ind = dim(string.rep(M.G_PIPE .. " ", h.depth - 1))
    parts = {}
    parts[rawlen(parts) + 1] = magenta(M.G_SPAN_BEGIN)
    parts[rawlen(parts) + 1] = sem_identity(name or "span")
    parts[rawlen(parts) + 1] = dim(M.G_ARROW)
    if trace_show_ts
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if trace_show_caller
        c = caller(2)
        if c != ""
            parts[rawlen(parts) + 1] .. dim("(") .. c .. dim(")")
        end
    end
    parts[rawlen(parts) + 1] = ind
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
    return h
end

span_end(h: any, fields: any): void
    if h == nil return end
    n = rawlen(trace_spans)
    while n > 0
        if trace_spans[n] == h
            table.remove(trace_spans, n)
            break
        end
        n -= 1
    end
    dur_s = os.clock() - h.start
    dur_ms = dur_s * 1000
    dur_str = _fmt_dur(dur_ms)
    ind = dim(string.rep(M.G_PIPE .. " ", (h.depth - 1)))
    parts = {}
    parts[rawlen(parts) + 1] = magenta(M.G_SPAN_END)
    parts[rawlen(parts) + 1] = italic(h.name)
    parts[rawlen(parts) + 1] = dim(M.G_DUR)
    parts[rawlen(parts) + 1] = dur_str
    parts[rawlen(parts) + 1] = ind
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
end

-- ─── Assertion / check helpers ────────────────────────────────────

assert_ok(condition: bool, msg: str): void
    if condition
        print(sem_success(M.G_CHECK .. " " .. tostring(msg or "ok")))
    else
        print(sem_failure(M.G_CROSS_MARK .. " " .. tostring(msg or "assertion failed")))
    end
end

assert_eq(actual: any, expected: any, msg: str): void
    if actual == expected
        print(sem_success(M.G_CHECK .. " " .. tostring(msg or "eq")))
    else
        parts = {}
        parts[rawlen(parts) + 1] = sem_failure(M.G_CROSS_MARK .. " " .. tostring(msg or "eq"))
        parts[rawlen(parts) + 1] = dim("expected")
        parts[rawlen(parts) + 1] = sem_changed_new(pretty_val(expected))
        parts[rawlen(parts) + 1] = dim("got")
        parts[rawlen(parts) + 1] = sem_changed_old(pretty_val(actual))
        print(table.concat(parts, " "))
    end
end

-- ─── Structured diff ──────────────────────────────────────────────

diff_line(kind: str, key: str, old_val: any, new_val: any): str
    prefix = ""
    line = ""
    if kind == "added"
        prefix = dim(green(M.G_PROPEL .. " "))
        line = sem_added("+" .. key) .. " " .. pretty_val(new_val)
    elseif kind == "removed"
        prefix = dim(red(M.G_RETURN .. " "))
        line = sem_deleted("-" .. key) .. " " .. pretty_val(old_val)
    elseif kind == "changed"
        prefix = dim(yellow(M.G_CROSS .. " "))
        line = sem_changed_old("-" .. key .. " " .. pretty_val(old_val)) ..
               "\n" .. dim("  ") ..
               sem_changed_new("+" .. key .. " " .. pretty_val(new_val))
    else
        prefix = dim(M.G_DOT .. " ")
        line = sem_context_line(key .. " " .. pretty_val(old_val))
    end
    return prefix .. line
end

print_diff(label: str, diffs: any): void
    if label == nil label = "diff" end
    n = rawlen(diffs)
    if n == 0
        print(sem_success(M.G_CHECK .. " " .. bold(label) .. " " .. dim("— no differences")))
        return
    end
    print(sem_diff_hunk(M.BOX_TL .. M.G_DIAMOND .. " " .. bold(label) ..
          " " .. dim(M.G_DASH) .. dim(string.rep(M.G_DASH, 38))))
    i = 1
    while i <= n
        d = diffs[i]
        print(M.BOX_V .. " " .. diff_line(d.kind, d.path, d.old, d.new))
        i += 1
    end
    print(dim(M.BOX_BL .. string.rep(M.G_DASH, 50)))
    print(dim("  " .. tostring(n) .. " difference(s)"))
end

-- ─── Checkpoint / milestone markers ───────────────────────────────

checkpoint(label: str): void
    ind = span_indent()
    parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = sem_constant(M.G_SNAPSHOT)
    parts[rawlen(parts) + 1] = sem_payload(tostring(label or "checkpoint"))
    if trace_show_ts
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if trace_show_caller
        c = caller(2)
        if c != ""
            parts[rawlen(parts) + 1] = dim("(") .. c .. dim(")")
        end
    end
    print(table.concat(parts, " "))
end

milestone(label: str, value: any): void
    ind = span_indent()
    parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = sem_constant(M.G_STAR)
    parts[rawlen(parts) + 1] = sem_identity(tostring(label or "milestone"))
    if value != nil
        parts[rawlen(parts) + 1] = dim(M.G_ARROW)
        parts[rawlen(parts) + 1] = pretty_val(value)
    end
    if trace_show_ts
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    print(table.concat(parts, " "))
end

-- ─── Variable watch ───────────────────────────────────────────────

watch(name: str, value: any): void
    ind = span_indent()
    parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = dim(M.G_SEED)
    parts[rawlen(parts) + 1] = sem_key(tostring(name))
    parts[rawlen(parts) + 1] = dim("→")
    parts[rawlen(parts) + 1] = pretty_val(value)
    if trace_show_ts
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    print(table.concat(parts, " "))
end

-- ─── Event timeline entry ────────────────────────────────────────

event(name: str, fields: any): void
    ind = span_indent()
    parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = sem_type(M.G_PROPEL .. " " .. tostring(name))
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    if trace_show_ts
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    print(table.concat(parts, " "))
end

-- ─── Section / divider helpers ────────────────────────────────────

banner(title: str, subtitle: str): void
    if title == nil title = "trace" end
    if tty()
        w = 50
        title_len = #title
        pad = w - title_len - 4
        if pad < 2 pad = 2 end
        print(sem_banner_line(M.BOX_TL .. string.rep(M.BOX_H, 2) .. " " .. title .. " " ..
              string.rep(M.BOX_H, pad) .. M.BOX_TR))
        if subtitle != nil and subtitle != ""
            print(dim(M.BOX_V .. "  " .. subtitle .. string.rep(" ", w - 2 - #subtitle) .. M.BOX_V))
        end
        print(dim(M.BOX_BL .. string.rep(M.BOX_H, w) .. M.BOX_BR))
    else
        print("=== " .. title .. " ===")
        if subtitle != nil and subtitle != ""
            print("    " .. subtitle)
        end
    end
end

divider(): void
    print(span_indent() .. dim(string.rep(M.BOX_H, 60)))
end

double_divider(): void
    print(span_indent() .. dim(string.rep("═", 60)))
end

section(title: str): void
    ind = span_indent()
    w = 50
    title_len = #title
    pad = w - title_len - 3
    if pad < 2 pad = 2 end
    print(ind .. dim(" ") .. sem_banner_line(M.G_DIAMOND .. " " .. title) ..
          dim(" " .. string.rep(M.BOX_H, pad)))
end

-- ─── Legend ───────────────────────────────────────────────────────

legend(): void
    print(bold(italic("trace legend:")))
    print("")
    print("  " .. level_tag(M.LV_TRACE) .. "  " .. dim("fine-grained, usually off"))
    print("  " .. level_tag(M.LV_DEBUG) .. "  " .. dim("development detail"))
    print("  " .. level_tag(M.LV_INFO)  .. "  " .. dim("general progress"))
    print("  " .. level_tag(M.LV_WARN)  .. "  " .. dim("something suspicious"))
    print("  " .. level_tag(M.LV_ERROR) .. "  " .. dim("failure, recoverable"))
    print("  " .. level_tag(M.LV_FATAL) .. "  " .. dim("unrecoverable"))
    print("")
    print("  " .. M.G_SPAN_BEGIN .. "/" .. M.G_SPAN_END ..
          " " .. dim("span begin/end    ") .. M.G_DUR .. " measured duration")
    print("  " .. M.G_SNAPSHOT .. " checkpoint    " ..
          M.G_STAR .. " milestone    " .. M.G_SEED .. " watch    " ..
          M.G_PROPEL .. " event")
    print("")
    print("  " .. bold("bold") .. " = essential payload    " ..
          italic("italic") .. " = identity / type    " ..
          dim("dim") .. " = ancillary meta")
    print("  " .. underline("underline") .. " = location / field key    " ..
          strikethrough("strikethrough") .. " = deleted / deprecated    " ..
          reverse("reverse") .. " = attention")
    print("")
    print("  " .. sem_success("success") .. "    " ..
          sem_failure("failure") .. "    " ..
          sem_caution("caution") .. "    " ..
          sem_hex("0xDEAD") .. " hex    " ..
          sem_size("1.2MB") .. " size    " ..
          sem_percent("87.5%") .. " percent")
    print("")
    print("  " .. sem_time_fast("<1ms") .. " fast    " ..
          sem_time_normal("~8ms") .. " normal    " ..
          sem_time_slow(">16ms") .. " slow    " ..
          "color = severity + Lua type class")
    print("")
    print("  value types: " ..
          sem_string_val('"string"') .. "  " ..
          sem_number_val("42") .. "  " ..
          sem_bool_val("true") .. "  " ..
          sem_nil("nil") .. "  " ..
          sem_table_val("{…}") .. "  " ..
          sem_function_val("⟪fn⟫"))
end

-- ─── Recursive pretty printer for dump() ───────────────────────────
_seen(seen: any, value: any): bool
    if seen == nil return false end
    i = 1
    n = rawlen(seen)
    while i <= n
        if seen[i] == value return true end
        i += 1
    end
    return false
end

_seen_add(seen: any, value: any): void
    seen[rawlen(seen) + 1] = value
end

pretty_repr(value: any, depth: int, seen: any): str
    if depth == nil depth = 0 end
    if seen == nil seen = {} end
    if value == nil return "nil" end
    t = type(value)
    if t:find("string") == 1
        return '"' .. tostring(value) .. '"'
    elseif t:find("number") == 1
        return tostring(value)
    elseif t:find("boolean") == 1
        return tostring(value)
    elseif t:find("function") == 1
        return "<function>"
    elseif t:find("table") != 1
        return tostring(value)
    end
    if _seen(seen, value) return "<circular>" end
    _seen_add(seen, value)
    n = rawlen(value)
    parts = {}
    if n > 0
        i = 1
        while i <= n
            parts[rawlen(parts) + 1] = string.rep("  ", depth + 1) ..
                pretty_repr(value[i], depth + 1, seen)
            i += 1
        end
        if rawlen(parts) <= 3
            return "[" .. table.concat(parts, ", ") .. "]"
        end
        return "[\n" .. table.concat(parts, ",\n") .. "\n" ..
            string.rep("  ", depth) .. "]"
    end
    for k, v in value
        parts[rawlen(parts) + 1] = string.rep("  ", depth + 1) ..
            tostring(k) .. " = " .. pretty_repr(v, depth + 1, seen)
    end
    if rawlen(parts) == 0 return "{}" end
    return "{\n" .. table.concat(parts, "\n") .. "\n" ..
        string.rep("  ", depth) .. "}"
end

dump(label: str, value: any): void
    if label == nil label = "dump" end
    ind = span_indent()
    header = ind .. cyan(M.G_BULLET) .. " " .. bold(label) ..
        dim(" ⟜ ") .. pretty_val(value)
    print(header)
    if value != nil and type(value) == "table"
        rendered = pretty_repr(value, 1, nil)
        i = 1
        n = #rendered
        line_start = 1
        line_num = 1
        while i <= n
            ch = string.sub(rendered, i, i)
            if ch == "\n"
                seg = string.sub(rendered, line_start, i - 1)
                if seg != ""
                    print(dim(M.BOX_V .. " ") .. sem_numbering(tostring(line_num) .. " ") .. cyan(seg))
                    line_num += 1
                end
                line_start = i + 1
            end
            i += 1
        end
        if line_start <= n
            print(dim(M.BOX_V .. " ") .. sem_numbering(tostring(line_num) .. " ") ..
                  cyan(string.sub(rendered, line_start)))
        end
    end
end

-- ─── Compact value table ──────────────────────────────────────────

table_print(label: str, t: any): void
    if t == nil or type(t) != "table"
        dump(label, t)
        return
    end
    ind = span_indent()
    n = rawlen(t)
    if n > 0
        print(ind .. bold(label) .. dim(" [" .. tostring(n) .. " items]"))
        i = 1
        while i <= n
            print(ind .. dim(M.G_PIPE .. " ") .. sem_numbering(tostring(i) .. " ") .. pretty_val(t[i]))
            i += 1
        end
    else
        print(ind .. bold(label) .. dim(" {"))
        for k, v in t
            print(ind .. dim(M.G_PIPE .. " ") .. sem_key(tostring(k)) ..
                  dim(" = ") .. pretty_val(v))
        end
        print(ind .. dim("}"))
    end
end

