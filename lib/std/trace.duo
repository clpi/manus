-- std.trace — beautiful, semantically-formatted trace & debug output
--
-- Design:
--   * Every event is signed with a beautiful Unicode glyph and colored
--     by severity. Bold/italic/dim/underline/strikethrough/reverse
--     carry semantic meaning (see LEGEND below).
--   * Spans can be opened/closed and timed.
--   * Field values are colored by Lua TYPE so a glance reveals shape.
--   * Source locations are underline; function names are magenta-italic;
--     timestamps are dim; slow durations are bold-yellow.
--   * Honors NO_COLOR / DUO_COLOR env vars.
--
-- LEGEND of formatting semantics:
--   bold       = essential payload (msg, error text, slow span durs)
--   italic     = identity (function names, type names, nil)
--   dim        = ancillary (timestamps, caller meta, trace level)
--   underline  = location references (file:line, field keys)
--   strikethrough = deleted/removed (in diffs, deprecated values)
--   reverse    = breakpoint / attention-grab (fatal banner, divider)
--   color      = severity / type class
--
-- NOTE: this module is intentionally self-contained — it does not
-- `req` other stdlib modules at top level. The current codegen drops
-- top-level `local x = req "stdlib"` bindings when a stdlib module is
-- inlined under `duo run`; inlining ANSI codes + tty detection here
-- keeps std.trace compilable today. When that codegen gap is fixed,
-- trace.duo can switch back to `local color = req "std.color"` etc.

global M = {}

-- ─── ANSI codes (inline copy of std.color) ─────────────────────────
M.RESET      = "\x1b[0m"
M.BOLD       = "\x1b[1m"
M.DIM        = "\x1b[2m"
M.ITALIC     = "\x1b[3m"
M.UNDERLINE  = "\x1b[4m"
M.BLINK      = "\x1b[5m"
M.REVERSE    = "\x1b[7m"
M.STRIKE     = "\x1b[9m"

M.BLACK      = "\x1b[30m"
M.RED        = "\x1b[31m"
M.GREEN      = "\x1b[32m"
M.YELLOW     = "\x1b[33m"
M.BLUE       = "\x1b[34m"
M.MAGENTA    = "\x1b[35m"
M.CYAN       = "\x1b[36m"
M.WHITE      = "\x1b[37m"

M.BRIGHT_BLACK   = "\x1b[90m"
M.BRIGHT_RED     = "\x1b[91m"
M.BRIGHT_GREEN   = "\x1b[92m"
M.BRIGHT_YELLOW  = "\x1b[93m"
M.BRIGHT_BLUE    = "\x1b[94m"
M.BRIGHT_MAGENTA = "\x1b[95m"
M.BRIGHT_CYAN    = "\x1b[96m"
M.BRIGHT_WHITE   = "\x1b[97m"

M.BG_BLACK   = "\x1b[40m"
M.BG_RED     = "\x1b[41m"
M.BG_GREEN   = "\x1b[42m"
M.BG_YELLOW  = "\x1b[43m"
M.BG_BLUE    = "\x1b[44m"
M.BG_MAGENTA = "\x1b[45m"
M.BG_CYAN    = "\x1b[46m"
M.BG_WHITE   = "\x1b[47m"

-- ─── Glyphs ────────────────────────────────────────────────────────
M.G_TRACE      = "∘"
M.G_DEBUG      = "⊙"
M.G_INFO       = "✦"
M.G_WARN       = "▲"
M.G_ERROR      = "✕"
M.G_FATAL      = "☠"

M.G_SPAN_BEGIN = "┌─"
M.G_SPAN_END   = "└─"
M.G_ARROW      = "⤳"
M.G_DUR        = "⊹"
M.G_KV_SEP     = "="
M.G_PIPE       = "│"
M.G_BULLET     = "•"
M.G_DOT        = "·"
M.G_CROSS      = "┼"
M.G_ELLIPSIS   = "⋯"
M.G_DASH       = "─"
M.G_EQUIV      = "≡"
M.G_PROPEL     = "▸"
M.G_RETURN     = "◂"
M.G_CHECK      = "✓"
M.G_CROSS_MARK = "✗"
M.G_WARN_MARK  = "⚠"
M.G_INFO_MARK  = "ℹ"
M.G_POINTER    = "→"
M.G_SEED       = "⊕"
M.G_SNAPSHOT   = "◎"
M.G_LOCK       = "🔒"
M.G_UNLOCK     = "🔓"
M.G_STAR       = "★"
M.G_DIAMOND    = "◆"
M.G_SQUARE     = "■"
M.G_CIRCLE     = "●"
M.G_TRIANGLE   = "▲"
M.G_HEXAGON    = "⬡"

-- ─── Box-drawing palette ──────────────────────────────────────────
M.BOX_TL = "╭"   -- top-left rounded
M.BOX_TR = "╮"   -- top-right rounded
M.BOX_BL = "╰"   -- bottom-left rounded
M.BOX_BR = "╯"   -- bottom-right rounded
M.BOX_ML = "├"   -- mid-left
M.BOX_MR = "┤"   -- mid-right
M.BOX_H  = "─"   -- horizontal
M.BOX_V  = "│"   -- vertical
M.BOX_C  = "┼"   -- cross
M.BOX_TL_SQUARE = "┌"
M.BOX_TR_SQUARE = "┐"
M.BOX_BL_SQUARE = "└"
M.BOX_BR_SQUARE = "┘"

-- ─── Levels ────────────────────────────────────────────────────────
M.LV_TRACE = 0
M.LV_DEBUG = 1
M.LV_INFO  = 2
M.LV_WARN  = 3
M.LV_ERROR = 4
M.LV_FATAL = 5

M.level_value = {
    trace = M.LV_TRACE, debug = M.LV_DEBUG, info = M.LV_INFO,
    warn = M.LV_WARN, error = M.LV_ERROR, fatal = M.LV_FATAL,
}
M.level_name = {
    [0] = "trace", [1] = "debug", [2] = "info",
    [3] = "warn", [4] = "error", [5] = "fatal",
}

global __trace_level = M.LV_INFO
global __trace_show_caller = true
global __trace_show_ts = true
global __trace_spans = {}
global __trace_color = true

-- ─── tty detection ────────────────────────────────────────────────
fun tty(): bool
    local ok, val = pcall(os.getenv, "DUO_COLOR")
    if ok and val ~= nil and val ~= "" and val ~= "0" then
        return true
    end
    local ok2, val2 = pcall(os.getenv, "NO_COLOR")
    if ok2 and val2 ~= nil and val2 ~= "" then
        return false
    end
    return true
end

-- ─── Low-level style wrappers ────────────────────────────────────

fun s(prefix: str, text: str, suffix: str): str
    if prefix == nil then prefix = "" end
    if suffix == nil then suffix = M.RESET end
    if not tty() then
        return tostring(text)
    end
    return prefix .. tostring(text) .. suffix
end

fun bold(text: str): str
    return M.BOLD .. tostring(text) .. M.RESET
end

fun dim(text: str): str
    return M.DIM .. tostring(text) .. M.RESET
end

fun italic(text: str): str
    return M.ITALIC .. tostring(text) .. M.RESET
end

fun underline(text: str): str
    return M.UNDERLINE .. tostring(text) .. M.RESET
end

fun strikethrough(text: str): str
    return M.STRIKE .. tostring(text) .. M.RESET
end

fun reverse(text: str): str
    return M.REVERSE .. tostring(text) .. M.RESET
end

fun blink(text: str): str
    return M.BLINK .. tostring(text) .. M.RESET
end

fun red(text: str): str
    return M.RED .. tostring(text) .. M.RESET
end

fun green(text: str): str
    return M.GREEN .. tostring(text) .. M.RESET
end

fun yellow(text: str): str
    return M.YELLOW .. tostring(text) .. M.RESET
end

fun blue(text: str): str
    return M.BLUE .. tostring(text) .. M.RESET
end

fun magenta(text: str): str
    return M.MAGENTA .. tostring(text) .. M.RESET
end

fun cyan(text: str): str
    return M.CYAN .. tostring(text) .. M.RESET
end

fun bright_red(text: str): str
    return M.BRIGHT_RED .. tostring(text) .. M.RESET
end

fun bright_green(text: str): str
    return M.BRIGHT_GREEN .. tostring(text) .. M.RESET
end

fun bright_yellow(text: str): str
    return M.BRIGHT_YELLOW .. tostring(text) .. M.RESET
end

fun bright_blue(text: str): str
    return M.BRIGHT_BLUE .. tostring(text) .. M.RESET
end

fun bright_magenta(text: str): str
    return M.BRIGHT_MAGENTA .. tostring(text) .. M.RESET
end

fun bright_cyan(text: str): str
    return M.BRIGHT_CYAN .. tostring(text) .. M.RESET
end

fun bright_white(text: str): str
    return M.BRIGHT_WHITE .. tostring(text) .. M.RESET
end

fun gray(text: str): str
    return M.BRIGHT_BLACK .. tostring(text) .. M.RESET
end

-- ─── Compound semantic styles ─────────────────────────────────────
-- These combine attributes for specific semantic roles.
-- Each one paints a single concept — use them to build readable output.

fun sem_success(text: str): str
    return M.BOLD .. M.GREEN .. tostring(text) .. M.RESET
end

fun sem_failure(text: str): str
    return M.BOLD .. M.RED .. tostring(text) .. M.RESET
end

fun sem_caution(text: str): str
    return M.BOLD .. M.YELLOW .. tostring(text) .. M.RESET
end

fun sem_identity(text: str): str
    return M.ITALIC .. M.MAGENTA .. tostring(text) .. M.RESET
end

fun sem_location(text: str): str
    return M.UNDERLINE .. tostring(text) .. M.RESET
end

fun sem_meta(text: str): str
    return M.DIM .. tostring(text) .. M.RESET
end

fun sem_payload(text: str): str
    return M.BOLD .. tostring(text) .. M.RESET
end

fun sem_deleted(text: str): str
    return M.STRIKE .. M.RED .. tostring(text) .. M.RESET
end

fun sem_added(text: str): str
    return M.BOLD .. M.GREEN .. tostring(text) .. M.RESET
end

fun sem_changed_old(text: str): str
    return M.DIM .. M.RED .. tostring(text) .. M.RESET
end

fun sem_changed_new(text: str): str
    return M.BOLD .. M.GREEN .. tostring(text) .. M.RESET
end

fun sem_type(text: str): str
    return M.ITALIC .. M.CYAN .. tostring(text) .. M.RESET
end

fun sem_constant(text: str): str
    return M.BOLD .. M.BRIGHT_CYAN .. tostring(text) .. M.RESET
end

fun sem_hex(text: str): str
    return M.BRIGHT_BLACK .. M.UNDERLINE .. tostring(text) .. M.RESET
end

fun sem_size(text: str): str
    return M.BRIGHT_YELLOW .. tostring(text) .. M.RESET
end

fun sem_percent(text: str): str
    return M.BRIGHT_MAGENTA .. tostring(text) .. M.RESET
end

fun sem_time_fast(text: str): str
    return M.DIM .. M.GREEN .. tostring(text) .. M.RESET
end

fun sem_time_normal(text: str): str
    return M.YELLOW .. tostring(text) .. M.RESET
end

fun sem_time_slow(text: str): str
    return M.BOLD .. M.RED .. tostring(text) .. M.RESET
end

fun sem_attention(text: str): str
    return M.REVERSE .. M.BOLD .. tostring(text) .. M.RESET
end

fun sem_deprecated(text: str): str
    return M.STRIKE .. M.DIM .. tostring(text) .. M.RESET
end

fun sem_key(text: str): str
    return M.UNDERLINE .. M.CYAN .. tostring(text) .. M.RESET
end

fun sem_nil(text: str): str
    return M.DIM .. M.ITALIC .. tostring(text) .. M.RESET
end

fun sem_string_val(text: str): str
    return M.GREEN .. tostring(text) .. M.RESET
end

fun sem_number_val(text: str): str
    return M.YELLOW .. tostring(text) .. M.RESET
end

fun sem_bool_val(text: str): str
    return M.MAGENTA .. tostring(text) .. M.RESET
end

fun sem_table_val(text: str): str
    return M.CYAN .. tostring(text) .. M.RESET
end

fun sem_function_val(text: str): str
    return M.ITALIC .. M.CYAN .. tostring(text) .. M.RESET
end

fun sem_breakpoint(text: str): str
    return M.REVERSE .. M.RED .. M.BOLD .. tostring(text) .. M.RESET
end

fun sem_banner_line(text: str): str
    return M.BOLD .. M.CYAN .. tostring(text) .. M.RESET
end

fun sem_frame(text: str): str
    return M.BRIGHT_BLACK .. tostring(text) .. M.RESET
end

fun sem_numbering(text: str): str
    return M.DIM .. M.BRIGHT_BLACK .. tostring(text) .. M.RESET
end

fun sem_diff_hunk(text: str): str
    return M.BOLD .. M.BRIGHT_WHITE .. tostring(text) .. M.RESET
end

fun sem_context_line(text: str): str
    return M.DIM .. tostring(text) .. M.RESET
end

-- ─── Value formatting ─────────────────────────────────────────────
fun tbl_summary(t: any): str
    if t == nil then return "nil" end
    local n = rawlen(t)
    if n > 0 then
        return "array(" .. tostring(n) .. ")"
    end
    local count = 0
    local first = ""
    for k, _v in t
        count += 1
        if count == 1 then first = tostring(k) end
    end
    if count == 0 then return "{}" end
    if count <= 3 then
        return "{" .. first .. ", ...}"
    end
    return "{" .. tostring(count) .. " keys}"
end

fun pretty_val(value: any): str
    if value == nil then
        return sem_nil("nil")
    end
    local t = type(value)
    if t:find("string") == 1 then
        return sem_string_val('"' .. tostring(value) .. '"')
    elseif t:find("number") == 1 then
        return sem_number_val(tostring(value))
    elseif t:find("boolean") == 1 then
        return sem_bool_val(tostring(value))
    elseif t:find("function") == 1 then
        return sem_function_val("⟪fn⟫")
    elseif t:find("table") == 1 then
        local n = rawlen(value)
        if n > 0 then
            return sem_table_val("⟦array " .. tostring(n) .. "⟧")
        end
        return sem_table_val(italic("{" .. tbl_summary(value) .. "}"))
    end
    return tostring(value)
end

fun pretty_kv(k: str, v: any): str
    return sem_key(tostring(k)) .. dim(" " .. M.G_KV_SEP .. " ") .. pretty_val(v)
end

-- ─── Contextual formatters ───────────────────────────────────────

fun _to_hex(n: int): str
    local digits = "0123456789abcdef"
    if n == 0 then return "0" end
    local result = ""
    while n > 0
        local d = math.floor(n % 16) + 1
        result = string.sub(digits, d, d) .. result
        n = math.floor(n / 16)
    end
    return result
end

fun fmt_hex(value: any): str
    local n = tonumber(value)
    if n == nil then return tostring(value) end
    local neg = false
    if n < 0 then neg = true; n = -n end
    local hex = _to_hex(math.floor(n))
    if neg then hex = "-" .. hex end
    return sem_hex("0x" .. hex)
end

fun fmt_size(bytes: any): str
    local n = tonumber(bytes)
    if n == nil then return tostring(bytes) end
    if n < 1024 then
        return sem_size(tostring(n) .. "B")
    elseif n < 1048576 then
        local whole = math.floor(n / 1024)
        local frac = math.floor((n - whole * 1024) * 10 / 1024)
        return sem_size(tostring(whole) .. "." .. tostring(frac) .. "KB")
    elseif n < 1073741824 then
        local whole = math.floor(n / 1048576)
        local frac = math.floor((n - whole * 1048576) * 10 / 1048576)
        return sem_size(tostring(whole) .. "." .. tostring(frac) .. "MB")
    else
        local whole = math.floor(n / 1073741824)
        local frac = math.floor((n - whole * 1073741824) * 10 / 1073741824)
        return sem_size(tostring(whole) .. "." .. tostring(frac) .. "GB")
    end
end

fun fmt_pct(value: any): str
    local n = tonumber(value)
    if n == nil then return tostring(value) end
    local whole = math.floor(n)
    local frac = math.floor((n - whole) * 100 + 0.5)
    if frac >= 100 then frac = 99 end
    local frac_str = tostring(frac)
    if frac < 10 then frac_str = "0" .. tostring(frac) end
    return sem_percent(tostring(whole) .. "." .. frac_str .. "%")
end

fun fmt_count(n: any): str
    local num = tonumber(n)
    if num == nil then return tostring(n) end
    return sem_number_val(tostring(num))
end

fun fmt_bool(b: any): str
    if b then return sem_added("true") end
    return sem_deleted("false")
end

fun fmt_nil(): str
    return sem_nil("nil")
end

fun fmt_ref(id: any): str
    return sem_hex(tostring(id))
end

fun fmt_path(path: str): str
    return sem_location(tostring(path))
end

-- ─── Caller info ───────────────────────────────────────────────────
fun caller(level: int): str
    local info = debug.getinfo(level, "Snl")
    if info == nil then return "" end
    local name_part = info.name
    if name_part == nil or name_part == "" then
        name_part = "?"
    end
    local src = info.short_src
    if src == nil then src = info.source end
    if src == nil then src = "?" end
    local loc = src
    if info.currentline and info.currentline > 0 then
        loc = src .. dim(":") .. yellow(tostring(info.currentline))
    end
    return sem_identity(name_part) .. dim(" " .. M.G_ARROW .. " ") .. sem_location(loc)
end

-- ─── Timestamp ─────────────────────────────────────────────────────
fun ts(): str
    local secs = os.time()
    local ms = math.floor((os.clock() * 1000) % 1000)
    local frac = "." .. tostring(ms)
    if ms < 10 then frac = ".00" .. tostring(ms)
    elseif ms < 100 then frac = ".0" .. tostring(ms)
    end
    return sem_meta(os.date("%H:%M:%S", secs) .. frac)
end

-- ─── Level tag ─────────────────────────────────────────────────────
fun level_tag(level: int): str
    local glyph = M.G_TRACE
    local tag = "trace"
    if level == M.LV_DEBUG then
        glyph = M.G_DEBUG; tag = "debug"
    elseif level == M.LV_INFO then
        glyph = M.G_INFO;  tag = " info"
    elseif level == M.LV_WARN then
        glyph = M.G_WARN;  tag = " warn"
    elseif level == M.LV_ERROR then
        glyph = M.G_ERROR; tag = "error"
    elseif level == M.LV_FATAL then
        glyph = M.G_FATAL; tag = "fatal"
    end
    local body = glyph .. " " .. tag
    if level == M.LV_TRACE then return dim(body) end
    if level == M.LV_DEBUG then return blue(body) end
    if level == M.LV_INFO  then return sem_success(body) end
    if level == M.LV_WARN  then return sem_caution(body) end
    if level == M.LV_ERROR then return sem_failure(body) end
    if level == M.LV_FATAL then
        return sem_breakpoint(body)
    end
    return body
end

-- ─── Span indent ───────────────────────────────────────────────────
fun span_indent(): str
    local n = rawlen(__trace_spans)
    if n <= 0 then return "" end
    local rep = string.rep(M.G_PIPE .. " ", n)
    if rep == nil or rep == "" then return "" end
    return dim(rep)
end

-- ─── Duration formatting with speed coloring ──────────────────────
fun _fmt_dur(ms: float): str
    local whole = math.floor(ms)
    local frac = math.floor((ms - whole) * 100)
    local frac_str = tostring(frac)
    if frac < 10 then frac_str = "0" .. tostring(frac) end
    local raw = tostring(whole) .. "." .. frac_str .. "ms"
    if ms < 1 then
        return sem_time_fast(raw)
    elseif ms < 16 then
        return sem_time_normal(raw)
    else
        return sem_time_slow(raw)
    end
end

-- ─── Emit ──────────────────────────────────────────────────────────
fun emit(level: int, msg: str, fields: any, skip: int): void
    if level < __trace_level then return end
    local parts = {}
    parts[rawlen(parts) + 1] = level_tag(level)
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if __trace_show_caller then
        local c = caller(skip + 1)
        if c ~= "" then
            parts[rawlen(parts) + 1] = dim("(") .. c .. dim(")")
        end
    end
    parts[rawlen(parts) + 1] = span_indent()
    if msg ~= nil and msg ~= "" then
        parts[rawlen(parts) + 1] = sem_payload(msg)
    end
    if fields ~= nil and type(fields) == "table" then
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
end

-- ─── Public API ─────────────────────────────────────────────────
fun set_level(level: any): void
    if type(level) == "string" then
        local v = M.level_value[string.lower(level)]
        if v ~= nil then
            __trace_level = v
        end
        return
    end
    if type(level) == "number" then
        if level >= M.LV_TRACE and level <= M.LV_FATAL then
            __trace_level = level
        end
    end
end

fun get_level(): str
    return M.level_name[__trace_level] or "info"
end

fun show_caller(on: bool): void
    __trace_show_caller = on and true or false
end

fun show_timestamp(on: bool): void
    __trace_show_ts = on and true or false
end

fun set_color(on: bool): void
    __trace_color = on and true or false
end

fun trace(msg: str, fields: any): void
    emit(M.LV_TRACE, msg, fields, 2)
end

fun _debug(msg: str, fields: any): void
    emit(M.LV_DEBUG, msg, fields, 2)
end

fun info(msg: str, fields: any): void
    emit(M.LV_INFO, msg, fields, 2)
end

fun warn(msg: str, fields: any): void
    emit(M.LV_WARN, msg, fields, 2)
end

fun error(msg: str, fields: any): void
    emit(M.LV_ERROR, msg, fields, 2)
end

fun fatal(msg: str, fields: any): void
    emit(M.LV_FATAL, msg, fields, 2)
end

-- ─── Spans ────────────────────────────────────────────────────────
fun span(name: str, fields: any): any
    local h = {
        name = name or "span",
        start = os.clock(),
        depth = rawlen(__trace_spans) + 1,
    }
    __trace_spans[rawlen(__trace_spans) + 1] = h
    local ind = dim(string.rep(M.G_PIPE .. " ", h.depth - 1))
    local parts = {}
    parts[rawlen(parts) + 1] = magenta(M.G_SPAN_BEGIN)
    parts[rawlen(parts) + 1] = sem_identity(name or "span")
    parts[rawlen(parts) + 1] = dim(M.G_ARROW)
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if __trace_show_caller then
        local c = caller(2)
        if c ~= "" then
            parts[rawlen(parts) + 1] .. dim("(") .. c .. dim(")")
        end
    end
    parts[rawlen(parts) + 1] = ind
    if fields ~= nil and type(fields) == "table" then
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
    return h
end

fun span_end(h: any, fields: any): void
    if h == nil then return end
    local n = rawlen(__trace_spans)
    while n > 0
        if __trace_spans[n] == h then
            table.remove(__trace_spans, n)
            break
        end
        n -= 1
    end
    local dur_s = os.clock() - h.start
    local dur_ms = dur_s * 1000
    local dur_str = _fmt_dur(dur_ms)
    local ind = dim(string.rep(M.G_PIPE .. " ", (h.depth - 1)))
    local parts = {}
    parts[rawlen(parts) + 1] = magenta(M.G_SPAN_END)
    parts[rawlen(parts) + 1] = italic(h.name)
    parts[rawlen(parts) + 1] = dim(M.G_DUR)
    parts[rawlen(parts) + 1] = dur_str
    parts[rawlen(parts) + 1] = ind
    if fields ~= nil and type(fields) == "table" then
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
end

-- ─── Assertion / check helpers ────────────────────────────────────

fun assert_ok(condition: bool, msg: str): void
    if condition then
        print(sem_success(M.G_CHECK .. " " .. tostring(msg or "ok")))
    else
        print(sem_failure(M.G_CROSS_MARK .. " " .. tostring(msg or "assertion failed")))
    end
end

fun assert_eq(actual: any, expected: any, msg: str): void
    if actual == expected then
        print(sem_success(M.G_CHECK .. " " .. tostring(msg or "eq")))
    else
        local parts = {}
        parts[rawlen(parts) + 1] = sem_failure(M.G_CROSS_MARK .. " " .. tostring(msg or "eq"))
        parts[rawlen(parts) + 1] = dim("expected")
        parts[rawlen(parts) + 1] = sem_changed_new(pretty_val(expected))
        parts[rawlen(parts) + 1] = dim("got")
        parts[rawlen(parts) + 1] = sem_changed_old(pretty_val(actual))
        print(table.concat(parts, " "))
    end
end

-- ─── Structured diff ──────────────────────────────────────────────

fun diff_line(kind: str, key: str, old_val: any, new_val: any): str
    local prefix = ""
    local line = ""
    if kind == "added" then
        prefix = dim(green(M.G_PROPEL .. " "))
        line = sem_added("+" .. key) .. " " .. pretty_val(new_val)
    elseif kind == "removed" then
        prefix = dim(red(M.G_RETURN .. " "))
        line = sem_deleted("-" .. key) .. " " .. pretty_val(old_val)
    elseif kind == "changed" then
        prefix = dim(yellow(M.G_CROSS .. " "))
        line = sem_changed_old("-" .. key .. " " .. pretty_val(old_val)) ..
               "\n" .. dim("  ") ..
               sem_changed_new("+" .. key .. " " .. pretty_val(new_val))
    else
        prefix = dim(M.G_DOT .. " ")
        line = sem_context_line(key .. " " .. pretty_val(old_val))
    end
    return prefix .. line
end

fun print_diff(label: str, diffs: any): void
    if label == nil then label = "diff" end
    local n = rawlen(diffs)
    if n == 0 then
        print(sem_success(M.G_CHECK .. " " .. bold(label) .. " " .. dim("— no differences")))
        return
    end
    print(sem_diff_hunk(M.BOX_TL .. M.G_DIAMOND .. " " .. bold(label) ..
          " " .. dim(M.G_DASH) .. dim(string.rep(M.G_DASH, 38))))
    local i = 1
    while i <= n
        local d = diffs[i]
        print(M.BOX_V .. " " .. diff_line(d.kind, d.path, d.old, d.new))
        i += 1
    end
    print(dim(M.BOX_BL .. string.rep(M.G_DASH, 50)))
    print(dim("  " .. tostring(n) .. " difference(s)"))
end

-- ─── Checkpoint / milestone markers ───────────────────────────────

fun checkpoint(label: str): void
    local ind = span_indent()
    local parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = sem_constant(M.G_SNAPSHOT)
    parts[rawlen(parts) + 1] = sem_payload(tostring(label or "checkpoint"))
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if __trace_show_caller then
        local c = caller(2)
        if c ~= "" then
            parts[rawlen(parts) + 1] = dim("(") .. c .. dim(")")
        end
    end
    print(table.concat(parts, " "))
end

fun milestone(label: str, value: any): void
    local ind = span_indent()
    local parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = sem_constant(M.G_STAR)
    parts[rawlen(parts) + 1] = sem_identity(tostring(label or "milestone"))
    if value ~= nil then
        parts[rawlen(parts) + 1] = dim(M.G_ARROW)
        parts[rawlen(parts) + 1] = pretty_val(value)
    end
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    print(table.concat(parts, " "))
end

-- ─── Variable watch ───────────────────────────────────────────────

fun watch(name: str, value: any): void
    local ind = span_indent()
    local parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = dim(M.G_SEED)
    parts[rawlen(parts) + 1] = sem_key(tostring(name))
    parts[rawlen(parts) + 1] = dim("→")
    parts[rawlen(parts) + 1] = pretty_val(value)
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    print(table.concat(parts, " "))
end

-- ─── Event timeline entry ────────────────────────────────────────

fun event(name: str, fields: any): void
    local ind = span_indent()
    local parts = {}
    parts[rawlen(parts) + 1] = ind
    parts[rawlen(parts) + 1] = sem_type(M.G_PROPEL .. " " .. tostring(name))
    if fields ~= nil and type(fields) == "table" then
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    print(table.concat(parts, " "))
end

-- ─── Section / divider helpers ────────────────────────────────────

fun banner(title: str, subtitle: str): void
    if title == nil then title = "trace" end
    if tty() then
        local w = 50
        local title_len = #title
        local pad = w - title_len - 4
        if pad < 2 then pad = 2 end
        print(sem_banner_line(M.BOX_TL .. string.rep(M.BOX_H, 2) .. " " .. title .. " " ..
              string.rep(M.BOX_H, pad) .. M.BOX_TR))
        if subtitle ~= nil and subtitle ~= "" then
            print(dim(M.BOX_V .. "  " .. subtitle .. string.rep(" ", w - 2 - #subtitle) .. M.BOX_V))
        end
        print(dim(M.BOX_BL .. string.rep(M.BOX_H, w) .. M.BOX_BR))
    else
        print("=== " .. title .. " ===")
        if subtitle ~= nil and subtitle ~= "" then
            print("    " .. subtitle)
        end
    end
end

fun divider(): void
    print(span_indent() .. dim(string.rep(M.BOX_H, 60)))
end

fun double_divider(): void
    print(span_indent() .. dim(string.rep("═", 60)))
end

fun section(title: str): void
    local ind = span_indent()
    local w = 50
    local title_len = #title
    local pad = w - title_len - 3
    if pad < 2 then pad = 2 end
    print(ind .. dim(" ") .. sem_banner_line(M.G_DIAMOND .. " " .. title) ..
          dim(" " .. string.rep(M.BOX_H, pad)))
end

-- ─── Legend ───────────────────────────────────────────────────────

fun legend(): void
    print(bold(italic("trace legend:")))
    print("")
    print("  " .. level_tag(M.LV_TRACE) .. "  " .. dim("fine-grained, usually off"))
    print("  " .. level_tag(M.LV_DEBUG) .. "  " .. dim("development detail"))
    print("  " .. level_tag(M.LV_INFO)  .. "  " .. dim("general progress"))
    print("  " .. level_tag(M.LV_WARN)  .. "  " .. dim("something suspicious"))
    print("  " .. level_tag(M.LV_ERROR) .. "  " .. dim("failure, recoverable"))
    print("  " .. level_tag(M.LV_FATAL) .. "  " .. dim("unrecoverable"))
    print("")
    print("  " .. M.G_SPAN_BEGIN .. "/" .. M.G_SPAN_END ..
          " " .. dim("span begin/end    ") .. M.G_DUR .. " measured duration")
    print("  " .. M.G_SNAPSHOT .. " checkpoint    " ..
          M.G_STAR .. " milestone    " .. M.G_SEED .. " watch    " ..
          M.G_PROPEL .. " event")
    print("")
    print("  " .. bold("bold") .. " = essential payload    " ..
          italic("italic") .. " = identity / type    " ..
          dim("dim") .. " = ancillary meta")
    print("  " .. underline("underline") .. " = location / field key    " ..
          strikethrough("strikethrough") .. " = deleted / deprecated    " ..
          reverse("reverse") .. " = attention")
    print("")
    print("  " .. sem_success("success") .. "    " ..
          sem_failure("failure") .. "    " ..
          sem_caution("caution") .. "    " ..
          sem_hex("0xDEAD") .. " hex    " ..
          sem_size("1.2MB") .. " size    " ..
          sem_percent("87.5%") .. " percent")
    print("")
    print("  " .. sem_time_fast("<1ms") .. " fast    " ..
          sem_time_normal("~8ms") .. " normal    " ..
          sem_time_slow(">16ms") .. " slow    " ..
          "color = severity + Lua type class")
    print("")
    print("  value types: " ..
          sem_string_val('"string"') .. "  " ..
          sem_number_val("42") .. "  " ..
          sem_bool_val("true") .. "  " ..
          sem_nil("nil") .. "  " ..
          sem_table_val("{…}") .. "  " ..
          sem_function_val("⟪fn⟫"))
end

-- ─── Recursive pretty printer for dump() ───────────────────────────
fun _seen(seen: any, value: any): bool
    if seen == nil then return false end
    local i = 1
    local n = rawlen(seen)
    while i <= n
        if seen[i] == value then return true end
        i += 1
    end
    return false
end

fun _seen_add(seen: any, value: any): void
    seen[rawlen(seen) + 1] = value
end

fun pretty_repr(value: any, depth: int, seen: any): str
    if depth == nil then depth = 0 end
    if seen == nil then seen = {} end
    if value == nil then return "nil" end
    local t = type(value)
    if t:find("string") == 1 then
        return '"' .. tostring(value) .. '"'
    elseif t:find("number") == 1 then
        return tostring(value)
    elseif t:find("boolean") == 1 then
        return tostring(value)
    elseif t:find("function") == 1 then
        return "<function>"
    elseif t:find("table") ~= 1 then
        return tostring(value)
    end
    if _seen(seen, value) then return "<circular>" end
    _seen_add(seen, value)
    local n = rawlen(value)
    local parts = {}
    if n > 0 then
        local i = 1
        while i <= n
            parts[rawlen(parts) + 1] = string.rep("  ", depth + 1) ..
                pretty_repr(value[i], depth + 1, seen)
            i += 1
        end
        if rawlen(parts) <= 3 then
            return "[" .. table.concat(parts, ", ") .. "]"
        end
        return "[\n" .. table.concat(parts, ",\n") .. "\n" ..
            string.rep("  ", depth) .. "]"
    end
    for k, v in value
        parts[rawlen(parts) + 1] = string.rep("  ", depth + 1) ..
            tostring(k) .. " = " .. pretty_repr(v, depth + 1, seen)
    end
    if rawlen(parts) == 0 then return "{}" end
    return "{\n" .. table.concat(parts, "\n") .. "\n" ..
        string.rep("  ", depth) .. "}"
end

fun dump(label: str, value: any): void
    if label == nil then label = "dump" end
    local ind = span_indent()
    local header = ind .. cyan(M.G_BULLET) .. " " .. bold(label) ..
        dim(" ⟜ ") .. pretty_val(value)
    print(header)
    if value ~= nil and type(value) == "table" then
        local rendered = pretty_repr(value, 1, nil)
        local i = 1
        local n = #rendered
        local line_start = 1
        local line_num = 1
        while i <= n
            local ch = string.sub(rendered, i, i)
            if ch == "\n" then
                local seg = string.sub(rendered, line_start, i - 1)
                if seg ~= "" then
                    print(dim(M.BOX_V .. " ") .. sem_numbering(tostring(line_num) .. " ") .. cyan(seg))
                    line_num += 1
                end
                line_start = i + 1
            end
            i += 1
        end
        if line_start <= n then
            print(dim(M.BOX_V .. " ") .. sem_numbering(tostring(line_num) .. " ") ..
                  cyan(string.sub(rendered, line_start)))
        end
    end
end

-- ─── Compact value table ──────────────────────────────────────────

fun table_print(label: str, t: any): void
    if t == nil or type(t) ~= "table" then
        dump(label, t)
        return
    end
    local ind = span_indent()
    local n = rawlen(t)
    if n > 0 then
        print(ind .. bold(label) .. dim(" [" .. tostring(n) .. " items]"))
        local i = 1
        while i <= n
            print(ind .. dim(M.G_PIPE .. " ") .. sem_numbering(tostring(i) .. " ") .. pretty_val(t[i]))
            i += 1
        end
    else
        print(ind .. bold(label) .. dim(" {"))
        for k, v in t
            print(ind .. dim(M.G_PIPE .. " ") .. sem_key(tostring(k)) ..
                  dim(" = ") .. pretty_val(v))
        end
        print(ind .. dim("}"))
    end
end

