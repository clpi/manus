-- std.sort — sorting utilities (mirrors Go's sort package)
-- Provides generic sort, stable sort, binary search, and convenience wrappers
-- for ascending/descending order on homogeneous array-like tables.

-- Insertion sort for small ranges (stable).
std_sort_insertion(arr: any, lo: any, hi: any, less: any): void
    i = lo + 1
    while i <= hi
        key = arr[i]
        j = i
        while j > lo and less(key, arr[j - 1])
            arr[j] = arr[j - 1]
            j -= 1
        end
        arr[j] = key
        i += 1
    end
end

-- Median-of-three pivot selection.
std_sort_median3(arr: any, lo: any, hi: any, less: any): any
    mid = lo + (hi - lo) / 2
    if less(arr[mid], arr[lo])
        tmp = arr[lo]; arr[lo] = arr[mid]; arr[mid] = tmp
    end
    if less(arr[hi], arr[lo])
        tmp = arr[lo]; arr[lo] = arr[hi]; arr[hi] = tmp
    end
    if less(arr[hi], arr[mid])
        tmp = arr[mid]; arr[mid] = arr[hi]; arr[hi] = tmp
    end
    arr[mid]
end

-- Partition for quicksort (Lomuto scheme).
std_sort_partition(arr: any, lo: any, hi: any, less: any): any
    pivot = std_sort_median3(arr, lo, hi, less)
    -- move pivot to hi-1
    tmp = arr[hi - 1]; arr[hi - 1] = arr[lo + (hi - lo) / 2]; arr[lo + (hi - lo) / 2] = tmp
    pivot = arr[hi - 1]
    i = lo
    j = hi - 1
    while true
        i += 1
        while less(arr[i], pivot) do i += 1 end
        j -= 1
        while less(pivot, arr[j]) do j -= 1 end
        if i >= j break end
        tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp
    end
    -- place pivot
    tmp = arr[i]; arr[i] = arr[hi - 1]; arr[hi - 1] = tmp
    i
end

-- Introsort-style quicksort with insertion-sort cutoff.
std_sort_quicksort(arr: any, lo: any, hi: any, less: any): void
    while hi - lo > 24
        p = std_sort_partition(arr, lo, hi, less)
        if p - lo < hi - p
            std_sort_quicksort(arr, lo, p - 1, less)
            lo = p + 1
        else
            std_sort_quicksort(arr, p + 1, hi, less)
            hi = p - 1
        end
    end
    if hi - lo > 1
        std_sort_insertion(arr, lo, hi, less)
    end
end

-- sort: sort the array portion of `arr` in-place using `less` comparator.
-- less(a, b) should return true when a should come before b.
sort(arr: any, less: any): void
    if arr == nil return end
    n = rawlen(arr)
    if n < 2 return end
    std_sort_quicksort(arr, 1, n, less)
end

-- stable: sort stably (insertion sort, O(n^2) but correct for all inputs).
stable(arr: any, less: any): void
    if arr == nil return end
    n = rawlen(arr)
    if n < 2 return end
    std_sort_insertion(arr, 1, n, less)
end

-- Ascending integer sort.
std_sort_less_int(a: any, b: any): bool
    return a < b
end

-- Descending integer sort.
std_sort_greater_int(a: any, b: any): bool
    return a > b
end

ints(arr: any): void
    if arr == nil return end
    n = rawlen(arr)
    if n < 2 return end
    std_sort_quicksort(arr, 1, n, std_sort_less_int)
end

ints_desc(arr: any): void
    if arr == nil return end
    n = rawlen(arr)
    if n < 2 return end
    std_sort_quicksort(arr, 1, n, std_sort_greater_int)
end

std_sort_less_str(a: any, b: any): bool
    return to(str)(a) < to(str)(b)
end

strings(arr: any): void
    if arr == nil return end
    n = rawlen(arr)
    if n < 2 return end
    std_sort_quicksort(arr, 1, n, std_sort_less_str)
end

-- is_sorted: returns true if arr is sorted according to less.
is_sorted(arr: any, less: any): bool
    if arr == nil return true end
    n = rawlen(arr)
    i = 2
    while i <= n
        if less(arr[i], arr[i - 1]) return false end
        i += 1
    end
    true
end

-- search: binary search for the smallest index i in [lo, hi) where f(i) is true.
search(n: any, f: any): any
    lo = 0
    hi = n
    while lo < hi
        mid = lo + (hi - lo) / 2
        if f(mid + 1)
            hi = mid
        else
            lo = mid + 1
        end
    end
    lo
end

-- search_sorted: binary search for value v in a sorted arr.
-- Returns 1-based index or -1. Uses iterative search (no closures).
search_sorted(arr: any, v: any, less: any): any
    if arr == nil return 0 - 1 end
    n = rawlen(arr)
    lo = 0
    hi = n
    while lo < hi
        mid = lo + (hi - lo) / 2
        if less(v, arr[mid + 1])
            hi = mid
        elseif less(arr[mid + 1], v)
            lo = mid + 1
        else
            return mid + 1
        end
    end
    0 - 1
end

-- reverse: reverse the array portion of arr in-place.
reverse(arr: any): void
    if arr == nil return end
    n = rawlen(arr)
    i = 1
    j = n
    while i < j
        tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp
        i += 1
        j -= 1
    end
end

-- swap: swap two indices.
swap(arr: any, i: any, j: any): void
    tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp
end

-- slice: sort a sub-range [from, to] of arr.
slice(arr: any, from: any, to: any, less: any): void
    if arr == nil return end
    if from < 1 from = 1 end
    if to > rawlen(arr) to = rawlen(arr) end
    if to - from < 1 return end
    std_sort_quicksort(arr, from, to, less)
end

M = {}
M.sort = sort
M.stable = stable
M.ints = ints
M.ints_desc = ints_desc
M.strings = strings
M.is_sorted = is_sorted
M.search = search
M.search_sorted = search_sorted
M.reverse = reverse
M.swap = swap
M.slice = slice
M