-- std.hex — Hexadecimal encoding and decoding utilities

global crypto = req "std.crypto"

encode(s: str): str
    crypto.hex_encode(s)
end

decode(s: str): str
    if s == nil return "" end
    out = {}
    for i = 1, #s, 2
        byte_str = s:sub(i, i + 1)
        table.insert(out, string.char(tonumber(byte_str, 16)))
    end
    table.concat(out)
end

