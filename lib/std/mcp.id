# std.mcp — Model Context Protocol SDK for Duo.
# Provides a pure Duo implementation of the MCP stdio transport (JSON-RPC 2.0).

global M = {}
M.tools = {}

mcp_read_message(): any
    # MCP stdio transport = newline-delimited JSON-RPC: one JSON object per
    # line, no embedded newlines (Model Context Protocol spec). This is NOT
    # LSP Content-Length framing — every real MCP client (Claude Code, Cursor,
    # …) sends newline-delimited JSON, so the prior framed transport never
    # completed a handshake. Blank lines are skipped; EOF (nil) terminates.
    while true
        line = io:read_line(io:input())
        if line == nil return nil end
        line = line:gsub("[\r\n]", "")
        if line != "" break end
    end
    json:decode(line)
end

mcp_send_message(obj: any): void
    # MCP stdio: one compact JSON object per line. json.encode emits no
    # embedded newlines, so the trailing "\n" is the sole delimiter.
    body = json:encode(obj)
    io:write_bytes(io:output(), body .. "\n")
    io:flush(io:output())
end

mcp_send_response(id: any, result: any): void
    mcp_send_message({
        jsonrpc = "2.0",
        id = id,
        result = result
    })
end

mcp_send_error(id: any, code: int, message: str): void
    mcp_send_message({
        jsonrpc = "2.0",
        id = id,
        error = {
            code = code,
            message = message
        }
    })
end

mcp_handle_initialize(msg: any): void
    mcp_send_response(msg.id, {
        protocolVersion = "2024-11-05",
        capabilities = {
            # MCP requires `capabilities.tools` to be an OBJECT. A bare `{}`
            # would encode as `[]` and clients reject the handshake shape.
            tools = json:empty_object
        },
        serverInfo = {
            name = "duo-mcp",
            version = "0.1.0"
        }
    })
end

mcp_handle_tools_list(msg: any): void
    tools_list = {}
    for name, tool in M.tools
        # JSON Schema requires `properties` to be an object. A tool declaring
        # `properties = {}` would encode as `[]` and fail client-side schema
        # validation, so the tool never surfaces. Normalize here rather than
        # at every tool definition.
        schema = tool.inputSchema
        if schema != nil and schema.properties != nil and next(schema.properties) == nil
            schema.properties = json:empty_object
        end
        tools_list[#tools_list + 1] = {
            name = name,
            description = tool.description,
            inputSchema = schema
        }
    end
    mcp_send_response(msg.id, {
        tools = tools_list
    })
end

mcp_handle_tools_call(msg: any): void
    params = msg.params
    name = params.name
    args = params.arguments
    tool = M.tools[name]
    if tool == nil
        mcp_send_error(msg.id, -32601, "Tool not found: " .. name)
        return
    end
    
    res = tool.handler(args)
    if type(res) == "string"
        mcp_send_response(msg.id, {
            content = {
                {
                    type = "text",
                    text = res
                }
            }
        })
    elseif type(res) == "table" and res.isError
        mcp_send_response(msg.id, {
            isError = true,
            content = {
                {
                    type = "text",
                    text = res.message
                }
            }
        })
    else
        mcp_send_response(msg.id, {
            content = {
                {
                    type = "text",
                    text = json:encode(res)
                }
            }
        })
    end
end

mcp_serve(): void
    while true
        msg = mcp_read_message()
        if msg == nil
            break
        end
        if msg.method == "initialize"
            mcp_handle_initialize(msg)
        elseif msg.method == "tools/list"
            mcp_handle_tools_list(msg)
        elseif msg.method == "tools/call"
            mcp_handle_tools_call(msg)
        elseif msg.method == "notifications/initialized"
            # nothing to do
        elseif msg.method == "ping"
            mcp_send_response(msg.id, {})
        elseif has(.id)(msg)
            mcp_send_error(msg.id, -32601, "Method not found: " .. msg.method:to(str))
        end
    end
end

mcp_register_tool(name: str, p2: any, p3: any, p4: any): void
    # Accept two calling conventions:
    #   3-arg: register_tool(name, inputSchema_with_description, handler)
    #   4-arg: register_tool(name, description, inputSchema, handler)
    # Distinguish by type, not nil: Duo codegen leaves missing trailing args as
    # non-nil garbage, so `p4 != nil` misfires on the 3-arg form and stores garbage
    # as the handler (tools/call then crashes). `type(p4)=="function"` is unambiguous.
    if type(p4) == "function"
        M.tools[name] = { name = name, description = p2 or "", inputSchema = p3, handler = p4 }
    else
        M.tools[name] = { name = name, description = p2.description or "", inputSchema = p2, handler = p3 }
    end
end

M.serve = mcp_serve
M.register_tool = mcp_register_tool
M
