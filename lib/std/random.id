# std.random — Random number generation and utilities

# seed: seed the random number generator.
seed(s: int): void
    math.randomseed(s)
end

# float: return a random float in [0, 1).
float(): float
    math.random()
end

# int: return a random integer in [min, max] (inclusive).
# If only one argument, returns random int in [1, max].
int(min: int, max: int): int
    if max == nil
        min:random()
    else
        min:random(max)
    end
end

# rand_bool: return a random boolean (50/50).
rand_bool(): bool
    math.random() < 0.5
end

# bool_weighted: return a random boolean with the given probability of true.
bool_weighted(p: float): bool
    math.random() < p
end

# choice: return a random element from a list.
choice(list: any): any
    if list == nil or list:len() == 0 return nil end
    list[1:random(list:len())]
end

# sample: return n unique random elements from a list (without replacement).
sample(list: any, n: i64): any
    out = {}
    if list == nil or n <= 0 return out end
    len = list:len()
    if n > len n = len end
    indices = {}
    i = 1
    while i <= len
        indices[i] = i
        i += 1
    end
    picked = 0
    while picked < n
        swap_idx = picked + 1:random(len)
        tmp = indices[picked + 1]
        indices[picked + 1] = indices[swap_idx]
        indices[swap_idx] = tmp
        out[out:len() + 1] = list[indices[picked + 1]]
        picked += 1
    end
    out
end

# pick_n: alias for sample (more idiomatic name).
pick_n(list: any, n: i64): any
    sample(list, n)
end

# weighted_choice: choose from items with corresponding weights.
# items: list of values, weights: parallel list of numeric weights.
weighted_choice(items: any, weights: any): any
    if items == nil or weights == nil return nil end
    len = items:len()
    if len == 0 return nil end
    if weights:len() != len return nil end
    total = 0
    i = 1
    while i <= len
        total += weights[i]
        i += 1
    end
    r = math.random() * total
    cumulative = 0
    i = 1
    while i <= len
        cumulative += weights[i]
        if r <= cumulative return items[i] end
        i += 1
    end
    items[len]
end

# range: return a list of integers from start to stop (exclusive), with optional step.
range(start: i64, stop: i64, step: i64): any
    out = {}
    if step == nil step = 1 end
    if step == 0 return out end
    if step > 0
        i = start
        while i < stop
            out[out:len() + 1] = i
            i += step
        end
    else
        i = start
        while i > stop
            out[out:len() + 1] = i
            i += step
        end
    end
    out
end

# gauss: return a random number from a normal distribution (Box-Muller).
gauss(mean: float, stddev: float): float
    if mean == nil mean = 0 end
    if stddev == nil stddev = 1 end
    u1 = math.random()
    u2 = math.random()
    while u1 == 0
        u1 = math.random()
    end
    z = -2 * u1:log():sqrt() * 2 * math.pi * u2:cos()
    mean + stddev * z
end

# shuffle: shuffle a list in-place (Fisher-Yates).
shuffle(list: any): void
    if list == nil return end
    n = list:len()
    while n > 1
        k = 1:random(n)
        tmp = list[n]
        list[n] = list[k]
        list[k] = tmp
        n -= 1
    end
end

# coin: flip a coin, return "heads" or "tails".
coin(): str
    if math.random() < 0.5 return "heads" end
    "tails"
end

# uuid_v4ish: generate a random UUID-like string (not cryptographically secure).
uuid_v4ish(): str
    hex_chars = "0123456789abcdef"
    parts = {}
    i = 1
    while i <= 36
        if i == 9 or i == 14 or i == 19 or i == 24
            parts[i] = "-"
        elseif i == 15
            parts[i] = "4"
        elseif i == 20
            idx = 1:random(4)
            if idx == 1 parts[i] = "8"
            elseif idx == 2 parts[i] = "9"
            elseif idx == 3 parts[i] = "a"
            else parts[i] = "b"
            end
        else
            # Use single random call to get one hex character
            idx = 1:random(16)
            parts[i] = hex_chars:sub(idx, idx)
        end
        i += 1
    end
    result = ""
    i = 1
    while i <= 36
        result = result .. parts[i]
        i += 1
    end
    result
end

