-- std.utf8 — utf-8 utilities

char(codepoint: int): str
    utf8.char(codepoint)
end

codes(s: str): any
    utf8.codes(s)
end

codepoint(s: str, i: int, j: int): any
    utf8.codepoint(s, i, j)
end

len(s: str, i: int, j: int): any
    utf8.len(s, i, j)
end

offset(s: str, n: int, i: int): any
    utf8.offset(s, n, i)
end

M = {}
M.char = char
M.charpattern = utf8.charpattern
M.codes = codes
M.codepoint = codepoint
M.len = len
M.offset = offset
M
