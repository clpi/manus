-- std.mproc — multi-process utilities

fun pid(): str
    os.getenv("$$")
end

fun spawn(cmd: str): i64
    rc = os.execute(cmd .. " &")
    rc
end

fun kill(pid: str): void
    os.execute("kill " .. tostring(pid) .. " 2>/dev/null")
end

fun mproc_wait(pid: str): void
    os.execute("wait " .. tostring(pid) .. " 2>/dev/null")
end

M = {}
M.pid = pid
M.spawn = spawn
M.kill = kill
M.wait = mproc_wait
M