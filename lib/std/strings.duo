-- std.str — string building, interpolation, and advanced manipulation
-- Complements std.string with builder patterns and template interpolation.

-- ---- Builder ----

-- new_builder: create a string builder (a table of string parts).
new_builder(): any
    {parts = {}, count = 0}
end

-- builder_write: append a string to the builder.
builder_write(b: any, s: any): void
    if s == nil s = "nil" end
    b.count = b.count + 1
    b.parts[b.count] = s
end

-- builder_write_line: append a string and a newline.
builder_write_line(b: any, s: any): void
    builder_write(b, s)
    builder_write(b, "\n")
end

-- builder_write_fmt: append a formatted string (using tostring on args).
builder_write_fmt(b: any, fmt: str, a1: any, a2: any, a3: any, a4: any, a5: any): void
    result = fmt
    if a1 != nil result = std.string.gsub(result, "{1}", to(str)(a1)) end
    if a2 != nil result = std.string.gsub(result, "{2}", to(str)(a2)) end
    if a3 != nil result = std.string.gsub(result, "{3}", to(str)(a3)) end
    if a4 != nil result = std.string.gsub(result, "{4}", to(str)(a4)) end
    if a5 != nil result = std.string.gsub(result, "{5}", to(str)(a5)) end
    builder_write(b, result)
end

-- builder_len: return the total length of all parts.
builder_len(b: any): i64
    total = 0
    i = 1
    while i <= b.count
        total += std.string.len(b.parts[i])
        i += 1
    end
    total
end

-- builder_reset: clear the builder.
builder_reset(b: any): void
    b.parts = {}
    b.count = 0
end

-- builder_to_string: concatenate all parts into a single std.string.
builder_to_string(b: any): str
    table.concat(b.parts)
end

-- ---- Template Interpolation ----

-- interp: replace {name} placeholders in template with values from a table.
-- Example: interp("Hello {name}!", {name = "World"}) -> "Hello World!"
interp(template: str, values: any): str
    if values == nil return template end
    result = template
    for key, val in values
        result = std.string.gsub(result, "{" .. to(str)(key) .. "}", to(str)(val))
    end
    result
end

-- interp_indexed: replace {1}, {2}, ... placeholders with positional arguments.
interp_indexed(template: str, a1: any, a2: any, a3: any, a4: any, a5: any): str
    result = template
    if a1 != nil result = std.string.gsub(result, "{1}", to(str)(a1)) end
    if a2 != nil result = std.string.gsub(result, "{2}", to(str)(a2)) end
    if a3 != nil result = std.string.gsub(result, "{3}", to(str)(a3)) end
    if a4 != nil result = std.string.gsub(result, "{4}", to(str)(a4)) end
    if a5 != nil result = std.string.gsub(result, "{5}", to(str)(a5)) end
    result
end

-- ---- Case Conversion ----

-- is_upper_char: check if a single-char string is an uppercase letter.
is_upper_char(c: any): bool
    result = std.string.find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c, 1, true)
    if result != nil return true end
    false
end

-- is_lower_char: check if a single-char string is a lowercase letter.
is_lower_char(c: any): bool
    result = std.string.find("abcdefghijklmnopqrstuvwxyz", c, 1, true)
    if result != nil return true end
    false
end

-- to_snake: convert "CamelCase" or "camelCase" to "camel_case".
to_snake(s: str): str
    if s == nil return "" end
    len = std.string.len(s)
    result = ""
    i = 1
    while i <= len
        c = std.string.sub(s, i, i)
        is_upper = std.string.lower(c) != c
        if is_upper
            if i > 1
                prev = std.string.sub(s, i - 1, i - 1)
                is_sep = false
                if prev == "_" or prev == " " or prev == "-" is_sep = true end
                if not is_sep
                    next_char = ""
                    if i < len next_char = std.string.sub(s, i + 1, i + 1) end
                    is_lower_prev = false
                    if std.string.lower(prev) == prev and prev != std.string.upper(prev) is_lower_prev = true end
                    if is_lower_prev
                        result = result .. "_"
                    else
                        if std.string.len(next_char) > 0
                            is_lower_next = false
                            if std.string.lower(next_char) == next_char and next_char != std.string.upper(next_char) is_lower_next = true end
                            if is_lower_next
                                result = result .. "_"
                            end
                        end
                    end
                end
            end
            result = result .. std.string.lower(c)
        elseif c == " " or c == "-"
            result = result .. "_"
        else
            result = result .. c
        end
        i += 1
    end
    result
end

-- to_camel: convert "snake_case" or "kebab-case" to "camelCase".
to_camel(s: str): str
    if s == nil return "" end
    result = ""
    capitalize_next = false
    len = std.string.len(s)
    i = 1
    while i <= len
        c = std.string.sub(s, i, i)
        if c == "_" or c == "-"
            capitalize_next = true
        elseif capitalize_next
            result = result .. std.string.upper(c)
            capitalize_next = false
        else
            result = result .. c
        end
        i += 1
    end
    result
end

-- to_pascal: like to_camel but first letter is also capitalized.
to_pascal(s: str): str
    camel = to_camel(s)
    if std.string.len(camel) == 0 return "" end
    first = std.string.upper(std.string.sub(camel, 1, 1))
    first .. std.string.sub(camel, 2)
end

-- to_kebab: convert "camelCase" or "snake_case" to "kebab-case".
to_kebab(s: str): str
    std.string.gsub(to_snake(s), "_", "-")
end

-- ---- Padding & Alignment ----

-- center: center a string in a field of given width, padded with fill character.
center(s: str, width: i64, fill: str): str
    if fill == nil fill = " " end
    len = std.string.len(s)
    if len >= width return s end
    pad = width - len
    left = math.floor(pad / 2)
    right = pad - left
    result = ""
    i = 0
    while i < left
        result = result .. fill
        i += 1
    end
    result = result .. s
    i = 0
    while i < right
        result = result .. fill
        i += 1
    end
    result
end

-- repeat_char: repeat a character n times.
repeat_char(c: str, n: i64): str
    result = ""
    i = 0
    while i < n
        result = result .. c
        i += 1
    end
    result
end

-- ---- Wrapping ----

-- word_wrap: wrap text at the given width, breaking at spaces.
word_wrap(s: str, width: i64): str
    if s == nil return "" end
    if width <= 0 return s end
    words = std.string.split(s, " ")
    result = ""
    line_len = 0
    i = 1
    while i <= rawlen(words)
        word = words[i]
        wlen = std.string.len(word)
        if line_len == 0
            result = result .. word
            line_len = wlen
        elseif line_len + 1 + wlen <= width
            result = result .. " " .. word
            line_len += 1 + wlen
        else
            result = result .. "\n" .. word
            line_len = wlen
        end
        i += 1
    end
    result
end

-- truncate: truncate string to max_len, appending suffix if truncated.
truncate(s: str, max_len: i64, suffix: str): str
    if suffix == nil suffix = "..." end
    if s == nil return "" end
    if std.string.len(s) <= max_len return s end
    cut = max_len - std.string.len(suffix)
    if cut < 0 cut = 0 end
    std.string.sub(s, 1, cut) .. suffix
end

-- ---- Encoding Helpers ----

-- is_empty: return true if the string is nil or has zero length.
is_empty(s: str): bool
    if s == nil return true end
    std.string.len(s) == 0
end

-- is_blank: return true if the string is nil or contains only whitespace.
is_blank(s: str): bool
    if s == nil return true end
    trimmed = std.string.gsub(s, "%s+", "")
    std.string.len(trimmed) == 0
end

-- count_sub: count non-overlapping occurrences of substr in s.
count_sub(s: str, substr: str): i64
    if s == nil or substr == nil return 0 end
    count = 0
    pos = 1
    while true
        start_idx = std.string.find(s, substr, pos, true)
        if start_idx == nil break end
        count += 1
        pos = start_idx + std.string.len(substr)
    end
    count
end

-- has_prefix: return true if s starts with prefix.
has_prefix(s: str, prefix: str): bool
    if s == nil or prefix == nil return false end
    std.string.sub(s, 1, std.string.len(prefix)) == prefix
end

-- has_suffix: return true if s ends with suffix.
has_suffix(s: str, suffix: str): bool
    if s == nil or suffix == nil return false end
    slen = std.string.len(s)
    suffix_len = std.string.len(suffix)
    if suffix_len > slen return false end
    std.string.sub(s, slen - suffix_len + 1) == suffix
end

-- ---- Quoting ----

-- quote: wrap string in double quotes, escaping special characters.
quote(s: str): str
    if s == nil return "\"\"" end
    escaped = std.string.gsub(s, "\\", "\\\\")
    escaped = std.string.gsub(escaped, "\"", "\\\"")
    escaped = std.string.gsub(escaped, "\n", "\\n")
    escaped = std.string.gsub(escaped, "\t", "\\t")
    escaped = std.string.gsub(escaped, "\r", "\\r")
    "\"" .. escaped .. "\""
end

-- single_quote: wrap string in single quotes, escaping as needed.
single_quote(s: str): str
    if s == nil return "''" end
    escaped = std.string.gsub(s, "\\", "\\\\")
    escaped = std.string.gsub(escaped, "'", "\\'")
    "'" .. escaped .. "'"
end

-- ---- Splitting ----

-- split_lines: split a string into lines (handles \n, \r\n, \r).
split_lines(s: str): any
    if s == nil return {} end
    normalized = std.string.gsub(s, "\r\n", "\n")
    normalized = std.string.gsub(normalized, "\r", "\n")
    std.string.split(normalized, "\n")
end

-- split_trimmed: split and trim each part.
split_trimmed(s: str, sep: str): any
    parts = std.string.split(s, sep)
    out = {}
    i = 1
    while i <= rawlen(parts)
        trimmed = std.string.gsub(parts[i], "^%s+", "")
        trimmed = std.string.gsub(trimmed, "%s+$", "")
        if std.string.len(trimmed) > 0
            out[rawlen(out) + 1] = trimmed
        end
        i += 1
    end
    out
end

