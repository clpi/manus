-- std.maps — map (table) helper utilities (mirrors Go 1.21 maps package)

fun std_maps_clone(m: any): any
    if m == nil then return {} end
    out = {}
    for k, v in pairs(m)
        out[k] = v
    end
    out
end

fun std_maps_copy(dst: any, src: any): i64
    if dst == nil then return 0 end
    if src == nil then return 0 end
    count = 0
    for k, v in pairs(src)
        dst[k] = v
        count += 1
    end
    count
end

fun std_maps_delete_key(m: any, k: any): any
    if m == nil then return nil end
    v = m[k]
    m[k] = nil
    v
end

fun std_maps_equal(m1: any, m2: any): bool
    if m1 == nil and m2 == nil then return true end
    if m1 == nil or m2 == nil then return false end
    c1 = 0
    for _ in pairs(m1) do c1 += 1 end
    c2 = 0
    for _ in pairs(m2) do c2 += 1 end
    if c1 ~= c2 then return false end
    for k, v in pairs(m1)
        if m2[k] ~= v then return false end
    end
    true
end

fun std_maps_equal_func(m1: any, m2: any, eq: any): bool
    if m1 == nil and m2 == nil then return true end
    if m1 == nil or m2 == nil then return false end
    c1 = 0
    for _ in pairs(m1) do c1 += 1 end
    c2 = 0
    for _ in pairs(m2) do c2 += 1 end
    if c1 ~= c2 then return false end
    for k, v in pairs(m1)
        v2 = m2[k]
        if v2 == nil then return false end
        if not eq(v, v2) then return false end
    end
    true
end

fun std_maps_keys(m: any): any
    if m == nil then return {} end
    out = {}
    for k in pairs(m) do out[rawlen(out) + 1] = k end
    out
end

fun std_maps_values(m: any): any
    if m == nil then return {} end
    out = {}
    for _, v in pairs(m) do out[rawlen(out) + 1] = v end
    out
end

fun std_maps_entries(m: any): any
    if m == nil then return {} end
    out = {}
    for k, v in pairs(m) do out[rawlen(out) + 1] = {key = k, value = v} end
    out
end

fun std_maps_has(m: any, k: any): bool
    if m == nil then return false end
    m[k] ~= nil
end

fun std_maps_get(m: any, k: any, dflt: any): any
    if m == nil then return dflt end
    v = m[k]
    if v == nil then return dflt end
    v
end

fun std_maps_set(m: any, k: any, v: any): any
    if m == nil then m = {} end
    m[k] = v
    m
end

fun std_maps_size(m: any): i64
    if m == nil then return 0 end
    c = 0
    for _ in pairs(m) do c += 1 end
    c
end

fun std_maps_merge(dst: any, src: any): any
    if dst == nil then dst = {} end
    if src == nil then return dst end
    for k, v in pairs(src)
        if dst[k] == nil then dst[k] = v end
    end
    dst
end

fun std_maps_merge_overwrite(dst: any, src: any): any
    if dst == nil then dst = {} end
    if src == nil then return dst end
    for k, v in pairs(src)
        dst[k] = v
    end
    dst
end

M = {}
M.clone = std_maps_clone
M.copy = std_maps_copy
M.delete = std_maps_delete_key
M.equal = std_maps_equal
M.equal_func = std_maps_equal_func
M.keys = std_maps_keys
M.values = std_maps_values
M.entries = std_maps_entries
M.has = std_maps_has
M.get = std_maps_get
M.set = std_maps_set
M.size = std_maps_size
M.merge = std_maps_merge
M.merge_overwrite = std_maps_merge_overwrite
M