-- std.fn — functional programming utilities
-- Higher-order functions and data transformations.
-- Note: closure-returning combinators are not supported by the compiler;
-- this module focuses on functions that compose without creating new closures.

-- identity: return its argument unchanged.
fun identity(x: any): any
    x
end

-- constant: return the value (for use as a function body).
fun constant_val(v: any): any
    v
end

-- noop: a function that does nothing.
fun noop(): void
end

-- foldl: left fold over a list.
fun foldl(list: any, init: any, fn_ref: any): any
    acc = init
    if list == nil then return acc end
    i = 1
    while i <= rawlen(list)
        acc = fn_ref(acc, list[i])
        i = i + 1
    end
    acc
end

-- foldr: right fold over a list.
fun foldr(list: any, init: any, fn_ref: any): any
    acc = init
    if list == nil then return acc end
    i = rawlen(list)
    while i >= 1
        acc = fn_ref(list[i], acc)
        i = i - 1
    end
    acc
end

-- map_filter: apply fn and keep only non-nil results.
fun map_filter(list: any, fn_ref: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        result = fn_ref(list[i])
        if result ~= nil then
            out[rawlen(out) + 1] = result
        end
        i = i + 1
    end
    out
end

-- group_by: partition list into groups keyed by fn's return value.
fun group_by(list: any, fn_ref: any): any
    groups = {}
    if list == nil then return groups end
    i = 1
    while i <= rawlen(list)
        key = fn_ref(list[i])
        if groups[key] == nil then groups[key] = {} end
        groups[key][rawlen(groups[key]) + 1] = list[i]
        i = i + 1
    end
    groups
end

-- unique_by: deduplicate list by fn's return value (first occurrence wins).
fun unique_by(list: any, fn_ref: any): any
    seen = {}
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        key = fn_ref(list[i])
        if seen[key] == nil then
            seen[key] = true
            out[rawlen(out) + 1] = list[i]
        end
        i = i + 1
    end
    out
end

-- take_while: take elements from the front while predicate holds.
fun take_while(list: any, fn_ref: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        if not fn_ref(list[i]) then break end
        out[rawlen(out) + 1] = list[i]
        i = i + 1
    end
    out
end

-- drop_while: drop elements from the front while predicate holds.
fun drop_while(list: any, fn_ref: any): any
    out = {}
    if list == nil then return out end
    dropping = true
    i = 1
    while i <= rawlen(list)
        if dropping and fn_ref(list[i]) then
            -- skip
        else
            dropping = false
            out[rawlen(out) + 1] = list[i]
        end
        i = i + 1
    end
    out
end

-- chunk: split list into sub-lists of size n.
fun chunk(list: any, n: any): any
    out = {}
    if list == nil or n == nil or n < 1 then return out end
    i = 1
    while i <= rawlen(list)
        group = {}
        j = 0
        while j < n and i + j <= rawlen(list)
            group[rawlen(group) + 1] = list[i + j]
            j = j + 1
        end
        out[rawlen(out) + 1] = group
        i = i + n
    end
    out
end

-- interleave: weave elements from two lists alternately.
fun interleave(a: any, b: any): any
    out = {}
    if a == nil then a = {} end
    if b == nil then b = {} end
    n = rawlen(a)
    if rawlen(b) > n then n = rawlen(b) end
    i = 1
    while i <= n
        if i <= rawlen(a) then out[rawlen(out) + 1] = a[i] end
        if i <= rawlen(b) then out[rawlen(out) + 1] = b[i] end
        i = i + 1
    end
    out
end

-- transpose: transpose a list of lists (rows to columns).
fun transpose(matrix: any): any
    if matrix == nil or rawlen(matrix) == 0 then return {} end
    cols = rawlen(matrix[1])
    out = {}
    c = 1
    while c <= cols
        col = {}
        r = 1
        while r <= rawlen(matrix)
            if matrix[r] ~= nil and rawlen(matrix[r]) >= c then
                col[rawlen(col) + 1] = matrix[r][c]
            end
            r = r + 1
        end
        out[rawlen(out) + 1] = col
        c = c + 1
    end
    out
end

-- count_by: count elements grouped by fn's return value.
fun count_by(list: any, fn_ref: any): any
    counts = {}
    if list == nil then return counts end
    i = 1
    while i <= rawlen(list)
        key = fn_ref(list[i])
        if counts[key] == nil then counts[key] = 0 end
        counts[key] = counts[key] + 1
        i = i + 1
    end
    counts
end

-- flatten: flatten a list of lists one level deep.
fun flatten(list: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        item = list[i]
        if type(item) == "table" then
            j = 1
            while j <= rawlen(item)
                out[rawlen(out) + 1] = item[j]
                j = j + 1
            end
        else
            out[rawlen(out) + 1] = item
        end
        i = i + 1
    end
    out
end

-- partition: split list into {matching, non_matching} by predicate.
fun partition(list: any, fn_ref: any): any
    yes = {}
    no = {}
    if list == nil then return {yes, no} end
    i = 1
    while i <= rawlen(list)
        if fn_ref(list[i]) then
            yes[rawlen(yes) + 1] = list[i]
        else
            no[rawlen(no) + 1] = list[i]
        end
        i = i + 1
    end
    out = {}
    out[1] = yes
    out[2] = no
    out
end

-- min_by: find the element that minimizes fn's return value.
fun min_by(list: any, fn_ref: any): any
    if list == nil or rawlen(list) == 0 then return nil end
    best = list[1]
    best_val = fn_ref(best)
    i = 2
    while i <= rawlen(list)
        val = fn_ref(list[i])
        if val < best_val then
            best = list[i]
            best_val = val
        end
        i = i + 1
    end
    best
end

-- max_by: find the element that maximizes fn's return value.
fun max_by(list: any, fn_ref: any): any
    if list == nil or rawlen(list) == 0 then return nil end
    best = list[1]
    best_val = fn_ref(best)
    i = 2
    while i <= rawlen(list)
        val = fn_ref(list[i])
        if val > best_val then
            best = list[i]
            best_val = val
        end
        i = i + 1
    end
    best
end

-- sort_by: sort list by fn's return value.
fun sort_by(list: any, fn_ref: any): void
    if list == nil then return end
    table.sort(list, function(a, b): bool fn_ref(a) < fn_ref(b) end)
end

M = {}
M.identity = identity
M.constant = constant_val
M.noop = noop
M.foldl = foldl
M.foldr = foldr
M.map_filter = map_filter
M.group_by = group_by
M.unique_by = unique_by
M.take_while = take_while
M.drop_while = drop_while
M.chunk = chunk
M.interleave = interleave
M.transpose = transpose
M.count_by = count_by
M.flatten = flatten
M.partition = partition
M.min_by = min_by
M.max_by = max_by
M.sort_by = sort_by
M
