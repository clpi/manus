-- std.fn — functional programming utilities
-- Higher-order functions and data transformations.
-- Note: closure-returning combinators are not supported by the compiler;
-- this module focuses on functions that compose without creating new closures.

-- identity: return its argument unchanged.
identity(x: any): any
    x
end

-- constant: return the value (for use as a function body).
constant_val(v: any): any
    v
end

-- noop: a function that does nothing.
noop(): void
end

-- foldl: left fold over a list.
foldl(list: any, init: any, fn_ref: any): any
    acc = init
    if list == nil return acc end
    i = 1
    while i <= rawlen(list)
        acc = fn_ref(acc, list[i])
        i += 1
    end
    acc
end

-- foldr: right fold over a list.
foldr(list: any, init: any, fn_ref: any): any
    acc = init
    if list == nil return acc end
    i = rawlen(list)
    while i >= 1
        acc = fn_ref(list[i], acc)
        i -= 1
    end
    acc
end

-- map_filter: apply fn and keep only non-nil results.
map_filter(list: any, fn_ref: any): any
    out = {}
    if list == nil return out end
    i = 1
    while i <= rawlen(list)
        result = fn_ref(list[i])
        if result != nil
            out[rawlen(out) + 1] = result
        end
        i += 1
    end
    out
end

-- group_by: partition list into groups keyed by fn's return value.
group_by(list: any, fn_ref: any): any
    groups = {}
    if list == nil return groups end
    i = 1
    while i <= rawlen(list)
        key = fn_ref(list[i])
        if groups[key] == nil groups[key] = {} end
        groups[key][rawlen(groups[key]) + 1] = list[i]
        i += 1
    end
    groups
end

-- unique_by: deduplicate list by fn's return value (first occurrence wins).
unique_by(list: any, fn_ref: any): any
    seen = {}
    out = {}
    if list == nil return out end
    i = 1
    while i <= rawlen(list)
        key = fn_ref(list[i])
        if seen[key] == nil
            seen[key] = true
            out[rawlen(out) + 1] = list[i]
        end
        i += 1
    end
    out
end

-- take_while: take elements from the front while predicate holds.
take_while(list: any, fn_ref: any): any
    out = {}
    if list == nil return out end
    i = 1
    while i <= rawlen(list)
        if not fn_ref(list[i]) break end
        out[rawlen(out) + 1] = list[i]
        i += 1
    end
    out
end

-- drop_while: drop elements from the front while predicate holds.
drop_while(list: any, fn_ref: any): any
    out = {}
    if list == nil return out end
    dropping = true
    i = 1
    while i <= rawlen(list)
        if dropping and fn_ref(list[i])
            -- skip
        else
            dropping = false
            out[rawlen(out) + 1] = list[i]
        end
        i += 1
    end
    out
end

-- chunk: split list into sub-lists of size n.
chunk(list: any, n: i64): any
    out = {}
    if list == nil or n == nil or n < 1 return out end
    i = 1
    while i <= rawlen(list)
        group = {}
        j = 0
        while j < n and i + j <= rawlen(list)
            group[rawlen(group) + 1] = list[i + j]
            j += 1
        end
        out[rawlen(out) + 1] = group
        i += n
    end
    out
end

-- interleave: weave elements from two lists alternately.
interleave(a: any, b: any): any
    out = {}
    if a == nil a = {} end
    if b == nil b = {} end
    n = rawlen(a)
    if rawlen(b) > n n = rawlen(b) end
    i = 1
    while i <= n
        if i <= rawlen(a) out[rawlen(out) + 1] = a[i] end
        if i <= rawlen(b) out[rawlen(out) + 1] = b[i] end
        i += 1
    end
    out
end

-- transpose: transpose a list of lists (rows to columns).
transpose(matrix: any): any
    if matrix == nil or rawlen(matrix) == 0 return {} end
    cols = rawlen(matrix[1])
    out = {}
    c = 1
    while c <= cols
        col = {}
        r = 1
        while r <= rawlen(matrix)
            if matrix[r] != nil and rawlen(matrix[r]) >= c
                col[rawlen(col) + 1] = matrix[r][c]
            end
            r += 1
        end
        out[rawlen(out) + 1] = col
        c += 1
    end
    out
end

-- count_by: count elements grouped by fn's return value.
count_by(list: any, fn_ref: any): any
    counts = {}
    if list == nil return counts end
    i = 1
    while i <= rawlen(list)
        key = fn_ref(list[i])
        if counts[key] == nil counts[key] = 0 end
        counts[key] = counts[key] + 1
        i += 1
    end
    counts
end

-- flatten: flatten a list of lists one level deep.
flatten(list: any): any
    out = {}
    if list == nil return out end
    i = 1
    while i <= rawlen(list)
        item = list[i]
        if type(item) == "table"
            j = 1
            while j <= rawlen(item)
                out[rawlen(out) + 1] = item[j]
                j += 1
            end
        else
            out[rawlen(out) + 1] = item
        end
        i += 1
    end
    out
end

-- partition: split list into {matching, non_matching} by predicate.
partition(list: any, fn_ref: any): any
    yes = {}
    no = {}
    if list == nil return {yes, no} end
    i = 1
    while i <= rawlen(list)
        if fn_ref(list[i])
            yes[rawlen(yes) + 1] = list[i]
        else
            no[rawlen(no) + 1] = list[i]
        end
        i += 1
    end
    out = {}
    out[1] = yes
    out[2] = no
    out
end

-- min_by: find the element that minimizes fn's return value.
min_by(list: any, fn_ref: any): any
    if list == nil or rawlen(list) == 0 return nil end
    best = list[1]
    best_val = fn_ref(best)
    i = 2
    while i <= rawlen(list)
        val = fn_ref(list[i])
        if val < best_val
            best = list[i]
            best_val = val
        end
        i += 1
    end
    best
end

-- max_by: find the element that maximizes fn's return value.
max_by(list: any, fn_ref: any): any
    if list == nil or rawlen(list) == 0 return nil end
    best = list[1]
    best_val = fn_ref(best)
    i = 2
    while i <= rawlen(list)
        val = fn_ref(list[i])
        if val > best_val
            best = list[i]
            best_val = val
        end
        i += 1
    end
    best
end

-- sort_by: sort list by fn's return value.
-- Bubble sort to avoid closure capture issues in the codegen.
sort_by(list: any, fn_ref: any): void
    if list == nil return end
    n = rawlen(list)
    i = 1
    while i < n
        j = 1
        while j <= n - i
            a = fn_ref(list[j])
            b = fn_ref(list[j + 1])
            if a > b
                list[j], list[j + 1] = list[j + 1], list[j]
            end
            j += 1
        end
        i += 1
    end
end

-- pipe: compose functions left-to-right (pipe(f, g)(x) = g(f(x))).
pipe(f1: any, f2: any): any
    composed(x: any): any
        f2(f1(x))
    end
    composed
end

-- pipe3: compose three functions.
pipe3(f1: any, f2: any, f3: any): any
    composed(x: any): any
        f3(f2(f1(x)))
    end
    composed
end

-- negate: return a function that negates the predicate.
negate(fn_ref: any): any
    negated(x: any): any
        not fn_ref(x)
    end
    negated
end

-- curry2: convert a 2-arg function to a chain of 1-arg calls.
curry2(fn_ref: any): any
    curried(a: any): any
        partial(b: any): any
            fn_ref(a, b)
        end
        partial
    end
    curried
end

-- clamp: clamp value between min and max.
clamp_val(v: any, lo: any, hi: any): any
    if v < lo return lo end
    if v > hi return hi end
    v
end

M = {}
M.identity = identity
M.constant = constant_val
M.noop = noop
M.foldl = foldl
M.foldr = foldr
M.map_filter = map_filter
M.group_by = group_by
M.unique_by = unique_by
M.take_while = take_while
M.drop_while = drop_while
M.chunk = chunk
M.interleave = interleave
M.transpose = transpose
M.count_by = count_by
M.flatten = flatten
M.partition = partition
M.min_by = min_by
M.max_by = max_by
M.sort_by = sort_by
M.pipe = pipe
M.pipe3 = pipe3
M.negate = negate
M.curry2 = curry2
M.clamp = clamp_val
M
