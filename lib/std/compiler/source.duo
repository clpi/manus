-- std.compiler.source — Duo-native source substrate (§7 Phase 1; Pass 16 WS1/WS2)
-- Parity: src/source_cursor.zig bytecursor (1-based pos, line/col on \n)
-- Note: mutating cursor_* on req'd records requires record-by-ref codegen at call sites.

loc: {
    file: str,
    line: i64,
    col: i64
}

bytecursor: {
    bytes: str,
    pos: i64,
    file: str,
    line: i64,
    col: i64
}

type stableid = i64

idgen: {
    next: stableid
}

formatloc(loc: loc): str
    loc.file .. ":" .. loc.line:to(str) .. ":" .. loc.col:to(str)
end

cursornew(bytes: str, file: str): bytecursor
    { bytes = bytes, pos = 1, file = file, line = 1, col = 1 }
end

cursoreof(c: bytecursor): bool
    c.pos > #c.bytes
end

cursorpeek(c: bytecursor): i64
    if cursoreof(c)
        return 0
    end
    c.bytes:byte(c.pos)
end

cursorpeek2(c: bytecursor): i64
    if c.pos + 1 > #c.bytes
        return 0
    end
    c.bytes:byte(c.pos + 1)
end

cursorremaining(c: bytecursor): i64
    n = #c.bytes - c.pos + 1
    if n < 0
        return 0
    end
    n
end

cursoradvance(c: bytecursor): i64
    if cursoreof(c)
        return 0
    end
    ch = c.bytes:byte(c.pos)
    c.pos = c.pos + 1
    if ch == 10
        c.line = c.line + 1
        c.col = 1
    else
        c.col = c.col + 1
    end
    ch
end

cursorloc(c: bytecursor): loc
    { file = c.file, line = c.line, col = c.col }
end

idgennew(start: stableid): idgen
    { next = start }
end

idgennext(g: idgen): stableid
    id = g.next
    g.next = g.next + 1
    id
end

M = {
    formatloc = formatloc,
    cursornew = cursornew,
    cursoreof = cursoreof,
    cursorpeek = cursorpeek,
    cursorpeek2 = cursorpeek2,
    cursorremaining = cursorremaining,
    cursoradvance = cursoradvance,
    cursorloc = cursorloc,
    idgennew = idgennew,
    idgennext = idgennext,
}
