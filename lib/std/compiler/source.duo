-- std.compiler.source — Duo-native source substrate (§7 Phase 1; Pass 16 WS1/WS2)
-- Parity: src/source_cursor.zig ByteCursor (1-based pos, line/col on \n)
-- Note: mutating cursor_* on req'd records requires record-by-ref codegen at call sites.

Loc: {
    file: str,
    line: i64,
    col: i64
}

ByteCursor: {
    bytes: str,
    pos: i64,
    file: str,
    line: i64,
    col: i64
}

type StableId = i64

IdGen: {
    next: StableId
}

format_loc(loc: Loc): str
    loc.file .. ":" .. loc.line:to(str) .. ":" .. loc.col:to(str)
end

cursor_new(bytes: str, file: str): ByteCursor
    { bytes = bytes, pos = 1, file = file, line = 1, col = 1 }
end

cursor_eof(c: ByteCursor): bool
    c.pos > #c.bytes
end

cursor_peek(c: ByteCursor): i64
    if cursor_eof(c)
        return 0
    end
    c.bytes:byte(c.pos)
end

cursor_peek2(c: ByteCursor): i64
    if c.pos + 1 > #c.bytes
        return 0
    end
    c.bytes:byte(c.pos + 1)
end

cursor_remaining(c: ByteCursor): i64
    n = #c.bytes - c.pos + 1
    if n < 0
        return 0
    end
    n
end

cursor_advance(c: ByteCursor): i64
    if cursor_eof(c)
        return 0
    end
    ch = c.bytes:byte(c.pos)
    c.pos = c.pos + 1
    if ch == 10
        c.line = c.line + 1
        c.col = 1
    else
        c.col = c.col + 1
    end
    ch
end

cursor_loc(c: ByteCursor): Loc
    { file = c.file, line = c.line, col = c.col }
end

id_gen_new(start: StableId): IdGen
    { next = start }
end

id_gen_next(g: IdGen): StableId
    id = g.next
    g.next = g.next + 1
    id
end

M = {
    format_loc = format_loc,
    cursor_new = cursor_new,
    cursor_eof = cursor_eof,
    cursor_peek = cursor_peek,
    cursor_peek2 = cursor_peek2,
    cursor_remaining = cursor_remaining,
    cursor_advance = cursor_advance,
    cursor_loc = cursor_loc,
    id_gen_new = id_gen_new,
    id_gen_next = id_gen_next,
}
