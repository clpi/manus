-- SH-12 — object writers, seed: a Mach-O ARM64 relocatable object, in Duo.
--
-- SH-12 is "Mach-O partial; ELF/COFF open" with no Duo implementation. This
-- writes a real `.o` — header, segment command, section, symbol table, string
-- table — that the SYSTEM LINKER accepts.
--
-- THE ORACLE is the strongest one available for a container format and the
-- reason to build it in this order: the object is handed to `xcrun clang`,
-- linked against a C `main` that calls the symbol, and RUN. If any field is
-- wrong — a bad offset, a mis-sized load command, a symbol table the linker
-- cannot read — it does not link, or it links and crashes. There is no way for
-- a wrong object to print the right number.
--
-- SH-11 proved the instruction encodings against the assembler and the lowering
-- against execution; this proves the CONTAINER. Together they are a native
-- backend with no assembler in the path.
--
-- Layout, 64-bit little-endian throughout:
--   mach_header_64        32 bytes
--   LC_SEGMENT_64        72 + 80 (one section)
--   LC_SYMTAB            24
--   code
--   nlist_64 per symbol  16
--   string table

-- BYTES ARE HEX, not raw string bytes. A Duo `str` is a NUL-terminated C
-- string, so `string.char(0)` truncates it — a first attempt at this emitted 60
-- bytes of a 243-byte object and `nm` rejected the result. Binary data cannot
-- travel through `str`, and there is no byte-buffer-to-file API, so the writer
-- produces lowercase hex and the caller converts it (`xxd -r -p`). Filed as the
-- gap it is; the layout below is the deliverable and it is unaffected.


_u8 = (v: i64): str
    digits = "0123456789abcdef"
    b: i64 = v & 0xFF
    hi: i64 = (b >> 4) & 0xF
    lo: i64 = b & 0xF
    string.sub(digits, hi + 1, hi + 1) .. string.sub(digits, lo + 1, lo + 1)
end

_u16 = (v: i64): str
    _u8(v) .. _u8(v >> 8)
end

_u32 = (v: i64): str
    _u8(v) .. _u8(v >> 8) .. _u8(v >> 16) .. _u8(v >> 24)
end

_u64 = (v: i64): str
    _u32(v) .. _u32(v >> 32)
end

-- A fixed-width, NUL-padded name field (segname/sectname are char[16]).
_name16 = (s: str): str
    out = ""
    i: i64 = 1
    while i <= 16
        if i <= #s
            out = out .. _u8(s:byte(i))
        else
            out = out .. _u8(0)
        end
        i += 1
    end
    out
end

-- Instruction words -> little-endian code bytes, as hex. ARM64 is fixed-width 4.
words_to_bytes = (words: any): str
    out = ""
    i: i64 = 1
    while i <= #words
        out = out .. _u32(words[i])
        i += 1
    end
    out
end

-- Build a complete relocatable object exporting one global symbol at offset 0.
--
-- Offsets are computed, never hardcoded: header 32 + segment 152 + symtab 24
-- gives the code offset, and every later offset follows from the code size.
-- Hardcoding them is exactly the bug the link step would catch, so the code
-- says how they are derived.
object_hex = (symbol: str, code: str): str
    hdr: i64 = 32
    seg: i64 = 72 + 80
    sym: i64 = 24
    sizeofcmds: i64 = seg + sym
    code_off: i64 = hdr + sizeofcmds
    code_len: i64 = #code // 2
    sym_off: i64 = code_off + code_len
    nsyms: i64 = 1
    str_off: i64 = sym_off + 16 * nsyms
    -- string table: leading NUL, then "_symbol", then NUL
    -- string table bytes: leading NUL, "_symbol", trailing NUL
    strtab = _u8(0)
    si: i64 = 1
    strtab = strtab .. _u8(95)
    while si <= #symbol
        strtab = strtab .. _u8(symbol:byte(si))
        si += 1
    end
    strtab = strtab .. _u8(0)
    str_len: i64 = #strtab // 2

    out = ""
    -- mach_header_64
    out = out .. _u32(0xFEEDFACF)          -- magic
    out = out .. _u32(0x0100000C)          -- CPU_TYPE_ARM64
    out = out .. _u32(0)                   -- CPU_SUBTYPE_ARM64_ALL
    out = out .. _u32(1)                   -- MH_OBJECT
    out = out .. _u32(2)                   -- ncmds
    out = out .. _u32(sizeofcmds)
    out = out .. _u32(0)                   -- flags
    out = out .. _u32(0)                   -- reserved

    -- LC_SEGMENT_64
    out = out .. _u32(0x19)                -- LC_SEGMENT_64
    out = out .. _u32(seg)                 -- cmdsize
    out = out .. _name16("")               -- segname: empty in an object
    out = out .. _u64(0)                   -- vmaddr
    out = out .. _u64(code_len)            -- vmsize
    out = out .. _u64(code_off)            -- fileoff
    out = out .. _u64(code_len)            -- filesize
    out = out .. _u32(7)                   -- maxprot rwx
    out = out .. _u32(7)                   -- initprot
    out = out .. _u32(1)                   -- nsects
    out = out .. _u32(0)                   -- flags

    -- section_64 __text,__TEXT
    out = out .. _name16("__text")
    out = out .. _name16("__TEXT")
    out = out .. _u64(0)                   -- addr
    out = out .. _u64(code_len)            -- size
    out = out .. _u32(code_off)            -- offset
    out = out .. _u32(2)                   -- align 2^2 = 4
    out = out .. _u32(0)                   -- reloff
    out = out .. _u32(0)                   -- nreloc
    out = out .. _u32(0x80000400)          -- PURE_INSTRUCTIONS|SOME_INSTRUCTIONS
    out = out .. _u32(0)                   -- reserved1
    out = out .. _u32(0)                   -- reserved2
    out = out .. _u32(0)                   -- reserved3

    -- LC_SYMTAB
    out = out .. _u32(0x02)                -- LC_SYMTAB
    out = out .. _u32(sym)                 -- cmdsize
    out = out .. _u32(sym_off)
    out = out .. _u32(nsyms)
    out = out .. _u32(str_off)
    out = out .. _u32(str_len)

    -- code
    out = out .. code

    -- nlist_64: the exported symbol, defined in section 1 at offset 0
    out = out .. _u32(1)                   -- n_strx: past the leading NUL
    out = out .. _u8(0x0F)                 -- n_type: N_SECT | N_EXT
    out = out .. _u8(1)                    -- n_sect: 1-based
    out = out .. _u16(0)                   -- n_desc
    out = out .. _u64(0)                   -- n_value

    out .. strtab
end
