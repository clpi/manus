-- std.compiler.lexer
-- Duo-native lexer implementation

-- Native string slicing: string.sub allocates, and the direct backend emits
-- only read-only __TEXT. std.str exports the allocation as a @comp.c.export
-- primitive, so a qualified call lowers to a relocation instead (SH-03).
global strm = req "std.str"

Loc: {
    file: str,
    line: i64,
    col: i64
}

Tok: {
    kind: i64,
    loc: Loc,
    text: str,
    int_val: i64,
    float_val: f64
}

State: {
    pos: i64,
    start: i64,
    line: i64,
    col: i64,
    has_peeked: bool,
    peeked_token: Tok
}

Lexer: {
    src: str,
    pos: i64,
    start: i64,
    line: i64,
    col: i64,
    file: str,
    has_peeked: bool,
    peeked_token: Tok,
    has_error: bool,
    error_loc: Loc,
    error_code: i64,
    hint_count: i64,
    hint_0: str,
    hint_1: str,
    hint_2: str,
    hint_3: str,
    hint_4: str,
    hint_5: str,
    hint_6: str,
    hint_7: str
}

new(src: str, file: str): Lexer
    dummy_loc: Loc = { file = "", line = 0, col = 0 }
    dummy_tok: Tok = { kind = 0, loc = dummy_loc, text = "", int_val = 0, float_val = 0.0 }
    return {
        src = src,
        pos = 1,
        start = 1,
        line = 1,
        col = 1,
        file = file,
        has_peeked = false,
        peeked_token = dummy_tok,
        has_error = false,
        error_loc = dummy_loc,
        error_code = 0,
        hint_count = 0,
        hint_0 = "",
        hint_1 = "",
        hint_2 = "",
        hint_3 = "",
        hint_4 = "",
        hint_5 = "",
        hint_6 = "",
        hint_7 = "",
    }
end

cur_loc(self: Lexer): Loc
    return { file = self.file, line = self.line, col = self.col }
end

has_pending_hints(self: Lexer): bool
    self.hint_count > 0
end

consume_hints(self: Lexer): any
    hints = {}
    i = 0
    while i < self.hint_count
        if i == 0 hints[#hints + 1] = self.hint_0
        elseif i == 1 hints[#hints + 1] = self.hint_1
        elseif i == 2 hints[#hints + 1] = self.hint_2
        elseif i == 3 hints[#hints + 1] = self.hint_3
        elseif i == 4 hints[#hints + 1] = self.hint_4
        elseif i == 5 hints[#hints + 1] = self.hint_5
        elseif i == 6 hints[#hints + 1] = self.hint_6
        elseif i == 7 hints[#hints + 1] = self.hint_7
        end
        i = i + 1
    end
    self.hint_count = 0
    self.hint_0 = ""
    self.hint_1 = ""
    self.hint_2 = ""
    self.hint_3 = ""
    self.hint_4 = ""
    self.hint_5 = ""
    self.hint_6 = ""
    self.hint_7 = ""
    hints
end

peek_char(self: Lexer): i64
    if self.pos > #self.src return 0 end
    self.src:byte(self.pos)
end

peek_char2(self: Lexer): i64
    if self.pos + 1 > #self.src return 0 end
    self.src:byte(self.pos + 1)
end

adv(self: Lexer)
    if self.pos > #self.src return end
    c = self.src:byte(self.pos)
    self.pos = self.pos + 1
    if c == 10
        self.line = self.line + 1
        self.col = 1
    else
        self.col = self.col + 1
    end
end

is_digit(c: i64): bool
    (c >= 48 and c <= 57)
end

is_alpha(c: i64): bool
    ((c >= 65 and c <= 90) or (c >= 97 and c <= 122))
end

is_alnum(c: i64): bool
    is_alpha(c) or is_digit(c)
end

is_hex(c: i64): bool
    is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
end

is_canonical_source(file: str): bool
    n = #file
    if n < 3 return false end
    return file:byte(n - 2) == 46 and file:byte(n - 1) == 105 and file:byte(n) == 100
end

-- GAP-145: distinct literal identities keyed by quote and source law, never by
-- delimiter text alone. Canonical `.id` uses `"` text and `'` bytes; historical
-- and foreign inputs keep compatibility provenance on single quotes and long
-- strings.
classify_quote(file: str, quote: i64): i64
    if quote == 34
        return std.compiler.token.KIND_TEXT_LIT
    end
    if quote == 39
        if is_canonical_source(file)
            return std.compiler.token.KIND_BYTES_LIT
        end
        return std.compiler.token.KIND_COMPAT_TEXT_LIT
    end
    std.compiler.token.KIND_COMPAT_TEXT_LIT
end

hash_operator_allowed(file: str): bool
    not is_canonical_source(file)
end

backtick_allowed(file: str): bool
    not is_canonical_source(file)
end

long_bracket_level(self: Lexer): i64
    i = self.pos
    if i > #self.src or self.src:byte(i) != 91 return -1 end
    i = i + 1
    lvl = 0
    while i <= #self.src and self.src:byte(i) == 61
        lvl = lvl + 1
        i = i + 1
    end
    if i > #self.src or self.src:byte(i) != 91 return -1 end
    lvl
end

-- GAP-017: a lexer error is a REJECTION the caller can count, not a process
-- abort. `error(...)` killed the whole run, so one bad file truncated any corpus
-- walk and silently shrank the denominator — and it made production dispatch
-- impossible, because routing the compiler through this lexer would have turned
-- every malformed source into a bare abort with no location.
--
-- Codes mirror src/lexer.zig's LexError order so the host maps them directly:
--   1 UnterminatedString  2 UnterminatedLongString  3 InvalidEscape
--   4 UnexpectedChar
-- First error wins: later failures are consequences of the first, and reporting
-- the last one points at the wrong place.
_fail(self: Lexer, code: i64)
    if not self.has_error
        self.has_error = true
        self.error_code = code
        self.error_loc = self:cur_loc()
    end
end

skip_long(self: Lexer, level: i64)
    self:adv()
    i = 0
    while i < level
        self:adv()
        i = i + 1
    end
    self:adv()
    while self.pos <= #self.src
        if self:peek_char() == 93
            eq = 0
            self:adv()
            while self:peek_char() == 61
                self:adv()
                eq = eq + 1
            end
            if eq == level and self:peek_char() == 93
                self:adv()
                return
            end
        else
            self:adv()
        end
    end
    self:_fail(2)
end

skip_ws(self: Lexer)
    while self.pos <= #self.src
        c = self:peek_char()
        if c == 32 or c == 9 or c == 13 or c == 10
            self:adv()
        elseif c == 35 and self.pos == 1 and self:peek_char2() == 33
            -- C0 law.comment.one: byte-zero `#!` is launch provenance only.
            while self.pos <= #self.src and self:peek_char() != 10
                self:adv()
            end
        elseif c == 35 and is_canonical_source(self.file)
            -- Canonical `#` comments; `#!` elsewhere stays comment, not shebang.
            while self.pos <= #self.src and self:peek_char() != 10
                self:adv()
            end
        elseif c == 45 and self:peek_char2() == 45
            self.pos = self.pos + 2
            self.col = self.col + 2
            lvl = self:long_bracket_level()
            if lvl >= 0
                self:skip_long(lvl)
            else
                is_triple = (self.pos <= #self.src and self:peek_char() == 45)
                if is_triple
                    self:adv()
                end
                start = self.pos
                while self.pos <= #self.src and self:peek_char() != 10
                    self:adv()
                end
                if is_triple and self.hint_count < 8
                    comment_text = strm.sub(self.src, start, self.pos - 1)
                    if #comment_text > 0 and comment_text:byte(1) == 64
                        h = strm.sub(comment_text, 2, -1)
                        if self.hint_count == 0 self.hint_0 = h
                        elseif self.hint_count == 1 self.hint_1 = h
                        elseif self.hint_count == 2 self.hint_2 = h
                        elseif self.hint_count == 3 self.hint_3 = h
                        elseif self.hint_count == 4 self.hint_4 = h
                        elseif self.hint_count == 5 self.hint_5 = h
                        elseif self.hint_count == 6 self.hint_6 = h
                        elseif self.hint_count == 7 self.hint_7 = h
                        end
                        self.hint_count = self.hint_count + 1
                    end
                end
            end
        else
            break
        end
    end
end

read_long_str(self: Lexer, level: i64): str
    self:adv()
    i = 0
    while i < level
        self:adv()
        i = i + 1
    end
    self:adv()
    if self:peek_char() == 10
        self:adv()
    elseif self:peek_char() == 13
        self:adv()
        if self:peek_char() == 10
            self:adv()
        end
    end
    start = self.pos
    self.start = start
    while self.pos <= #self.src
        if self:peek_char() == 93
            close_start = self.pos
            self:adv()
            eq = 0
            while self:peek_char() == 61
                self:adv()
                eq = eq + 1
            end
            if eq == level and self:peek_char() == 93
                content = strm.sub(self.src, start, close_start - 1)
                self:adv()
                return content
            end
        else
            self:adv()
        end
    end
    self:_fail(2)
    ""
end

read_str(self: Lexer, quote: i64): str
    self:adv()
    start = self.pos
    self.start = start
    while self.pos <= #self.src
        c = self:peek_char()
        if c == quote
            s = strm.sub(self.src, start, self.pos - 1)
            self:adv()
            return s
        end
        if c == 10 or c == 13
            self:_fail(1)
            return ""
        end
        if c == 92
            self:adv()
            if self.pos > #self.src
                self:_fail(1)
                return ""
            end
            esc = self:peek_char()
            if esc == 120
                self:adv()
                if self.pos > #self.src or not is_hex(self:peek_char())
                    self:_fail(3)
                    return ""
                end
                self:adv()
                if self.pos <= #self.src and is_hex(self:peek_char())
                    self:adv()
                end
            elseif esc == 117
                self:adv()
                if self:peek_char() != 123
                    self:_fail(3)
                    return ""
                end
                self:adv()
                has_digit = false
                while self.pos <= #self.src and self:peek_char() != 125
                    if not is_hex(self:peek_char())
                        self:_fail(3)
                        return ""
                    end
                    has_digit = true
                    self:adv()
                end
                if not has_digit or self.pos > #self.src or self:peek_char() != 125
                    self:_fail(3)
                    return ""
                end
                self:adv()
            elseif esc == 122
                self:adv()
                while self.pos <= #self.src
                    ws = self:peek_char()
                    if ws == 32 or ws == 9 or ws == 13 or ws == 10
                        self:adv()
                    else
                        break
                    end
                end
            elseif esc == 13
                self:adv()
                if self.pos <= #self.src and self:peek_char() == 10
                    self:adv()
                end
            else
                self:adv()
            end
        else
            self:adv()
        end
    end
    self:_fail(1)
    ""
end

-- GAP-023/024: exact decimal and hex to i64, never through f64.
--
-- `to(i64)("4810305713451201937")` yields 4810305713451201536 — the value is
-- 63 bits and an f64 mantissa carries 53, so the conversion rounds to a
-- multiple of 512. That is a SILENT wrong number in a token, and it made the
-- Duo lexer disagree with src/lexer.zig on every integer literal above 2^53:
-- the two fingerprint proofs were the only programs that had one, which is why
-- they were the only two that regressed under production dispatch.
--
-- Digits accumulate in i64 directly. Values beyond i64 wrap rather than
-- rejecting; that is the same shape the rest of the compiler carries today and
-- is recorded in GAP-024 rather than fixed here.
_int_of(text: str): i64
    n: i64 = #text
    if n > 2 and text:byte(1) == 48 and (text:byte(2) == 120 or text:byte(2) == 88)
        -- gap[042]: ACCUMULATE UNSIGNED, for the same reason the decimal path
        -- below does. gap[024] fixed only the decimal accumulator; this one
        -- stayed `i64`, so `v * 16` on any hex literal at or above 2^63 was
        -- signed overflow and the compiler ABORTED lexing the file:
        --
        --     panic: signed integer overflow: 576460752303423488 * 16 cannot
        --     be represented in type 'int64_t'
        --
        -- `lib/std/heap.id` writes `0xcbf29ce484222325` (the FNV-1a offset
        -- basis) and `0xFFFFFFFFFFFFFFFF`; `lib/std/encoding/varint.id` and
        -- `lib/std/ml/gguf.id` write `0x8000000000000000`. src/lexer.zig
        -- already treats a hex literal as a BIT PATTERN — it retries as u64
        -- and bitcasts — so accumulating unsigned here is what makes the two
        -- lexers agree rather than a new convention.
        v: u64 = 0
        i: i64 = 3
        while i <= n
            c: i64 = text:byte(i)
            d: i64 = 0
            if c >= 48 and c <= 57
                d = c - 48
            elseif c >= 97 and c <= 102
                d = c - 87
            elseif c >= 65 and c <= 70
                d = c - 55
            else
                return v
            end
            v = v * 16 + d
            i += 1
        end
        return v
    end
    -- gap[024]: ACCUMULATE UNSIGNED. This was `v: i64`, and `v * 10` on a
    -- literal above i64 max is signed overflow -- undefined behaviour that the
    -- generated C traps on, so the COMPILER ABORTED (SIGABRT) rather than
    -- lexing the file:
    --
    --     panic: signed integer overflow: 1363643836025834967 * 10 cannot be
    --     represented in type 'int64_t'
    --
    -- reached from `print(tostring(13636438360258349679))` -- the u64 form of
    -- the text fingerprint, an ordinary literal a program is entitled to write.
    -- Unsigned multiplication wraps rather than trapping, so the accumulator
    -- carries the full 64-bit range and the value lands in int_val with the
    -- same bits the host lexer's parseInt(u64) produces.
    v: u64 = 0
    i: i64 = 1
    while i <= n
        c: i64 = text:byte(i)
        if c < 48 or c > 57 return v end
        v = v * 10 + (c - 48)
        i += 1
    end
    v
end

read_num(self: Lexer): Tok
    l = self:cur_loc()
    start = self.pos
    is_float = false
    
    c1 = self:peek_char()
    c2 = self:peek_char2()
    if c1 == 48 and (c2 == 120 or c2 == 88)
        self:adv()
        self:adv()
        while is_hex(self:peek_char())
            self:adv()
        end
        if self:peek_char() == 46
            is_float = true
            self:adv()
            while is_hex(self:peek_char())
            self:adv()
        end
        end
        p = self:peek_char()
        if p == 112 or p == 80
            is_float = true
            self:adv()
            sgn = self:peek_char()
            if sgn == 43 or sgn == 45
                self:adv()
            end
            while is_digit(self:peek_char())
                self:adv()
            end
        end
    else
        while is_digit(self:peek_char())
            self:adv()
        end
        if self:peek_char() == 46
            n = self:peek_char2()
            if is_digit(n)
                is_float = true
                self:adv()
                while is_digit(self:peek_char())
            self:adv()
        end
            end
        end
        e = self:peek_char()
        if e == 101 or e == 69
            is_float = true
            self:adv()
            sgn = self:peek_char()
            if sgn == 43 or sgn == 45
                self:adv()
            end
            while is_digit(self:peek_char())
                self:adv()
            end
        end
    end
    
    text = strm.sub(self.src, start, self.pos - 1)
    -- `to(f64)`/`to(i64)`, NOT `tonumber(text) or 0.0`. The `or` truncated the
    -- float: `tonumber("1.5")` is 1.5, and `tonumber("1.5") or 0.0` is **1**.
    -- Measured 2026-08-07, filed as GAP-021.
    --
    -- Nothing caught it for as long as it existed, because float_val is the one
    -- token field no differential reads — the kind fingerprint hashes kinds, the
    -- text fingerprint hashes text. Every float literal in the language lexed to
    -- its integer part, silently. That is why duo_lexer_tokenize_full carries the
    -- field: dispatch on tokenize_text would have shipped this.
    --
    -- The fallback is dropped rather than re-spelled: this branch is reached only
    -- after read_number has already scanned a well-formed literal, so `or 0.0`
    -- was defending an unreachable case while corrupting the reachable one.
    if is_float
        return { kind = std.compiler.token.KIND_FLOAT_LIT, loc = l, text = text, int_val = 0, float_val = to(f64)(text) }
    else
        return { kind = std.compiler.token.KIND_INT_LIT, loc = l, text = text, int_val = _int_of(text), float_val = 0.0 }
    end
end

next_tok(self: Lexer): Tok
    self:skip_ws()
    self.start = self.pos
    if self.pos > #self.src
        return { kind = std.compiler.token.KIND_EOF, loc = self:cur_loc(), text = "", int_val = 0, float_val = 0.0 }
    end
    
    l = self:cur_loc()
    c = self:peek_char()
    
    if is_digit(c) or (c == 46 and is_digit(self:peek_char2()))
        return self:read_num()
    end
    
    if is_alpha(c) or c == 95
        start = self.pos
        while self.pos <= #self.src
            p = self:peek_char()
            if is_alnum(p) or p == 95
                self:adv()
            else
                break
            end
        end
        text = strm.sub(self.src, start, self.pos - 1)
        kind = std.token.classify.classify(text)
        if kind == 0
            kind = std.compiler.token.KIND_NAME
        end
        return { kind = kind, loc = l, text = text, int_val = 0, float_val = 0.0 }
    end
    
    if c == 39 or c == 34
        lit_kind = classify_quote(self.file, c)
        s = self:read_str(c)
        return { kind = lit_kind, loc = l, text = s, int_val = 0, float_val = 0.0 }
    end
    
    if c == 91
        lvl = self:long_bracket_level()
        if lvl >= 0
            s = self:read_long_str(lvl)
            return { kind = std.compiler.token.KIND_COMPAT_LONG_TEXT_LIT, loc = l, text = s, int_val = 0, float_val = 0.0 }
        end
    end
    
    if c == 35 and not hash_operator_allowed(self.file)
        self:_fail(4)
        return { kind = std.compiler.token.KIND_EOF, loc = l, text = "", int_val = 0, float_val = 0.0 }
    end
    
    if c == 96 and not backtick_allowed(self.file)
        self:_fail(4)
        return { kind = std.compiler.token.KIND_EOF, loc = l, text = "", int_val = 0, float_val = 0.0 }
    end
    
    self:adv()
    p = self.pos
    
    if c == 43
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_PLUS_ASSIGN, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_PLUS, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 42
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_STAR_ASSIGN, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_STAR, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 37
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_PERCENT_ASSIGN, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_PERCENT, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 94
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_CARET_ASSIGN, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_CARET, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 35
        if self:peek_char() == 35
            self:adv()
            return { kind = std.compiler.token.KIND_HASH_HASH, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_HASH, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 38
        return { kind = std.compiler.token.KIND_AMP, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 124
        if self.pos <= #self.src and self.src:byte(self.pos) == 62
            self.pos = self.pos + 1
            return { kind = std.compiler.token.KIND_PIPE_GT, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_PIPE, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 40
        return { kind = std.compiler.token.KIND_LPAREN, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 41
        return { kind = std.compiler.token.KIND_RPAREN, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 91
        return { kind = std.compiler.token.KIND_LBRACKET, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 93
        return { kind = std.compiler.token.KIND_RBRACKET, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 123
        return { kind = std.compiler.token.KIND_LBRACE, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 125
        return { kind = std.compiler.token.KIND_RBRACE, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 59
        return { kind = std.compiler.token.KIND_SEMI, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 44
        return { kind = std.compiler.token.KIND_COMMA, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 45
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_MINUS_ASSIGN, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 62
            self:adv()
            return { kind = std.compiler.token.KIND_ARROW, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_MINUS, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 47
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_SLASH_ASSIGN, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 47
            self:adv()
            return { kind = std.compiler.token.KIND_IDIV, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_SLASH, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 46
        if self:peek_char() == 46
            self:adv()
            if self:peek_char() == 46
                self:adv()
                return { kind = std.compiler.token.KIND_DOTS, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
            end
            return { kind = std.compiler.token.KIND_CONCAT, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_DOT, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 61
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_EQ, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 62
            self:adv()
            return { kind = std.compiler.token.KIND_FAT_ARROW, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_ASSIGN, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 126
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_NEQ, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_TILDE, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 60
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_LEQ, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 60
            self:adv()
            return { kind = std.compiler.token.KIND_LSHIFT, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_LT, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 62
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_GEQ, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        if self:peek_char() == 62
            self:adv()
            return { kind = std.compiler.token.KIND_RSHIFT, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_GT, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 58
        if self:peek_char() == 58
            self:adv()
            return { kind = std.compiler.token.KIND_DCOLON, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_COLON, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 64
        return { kind = std.compiler.token.KIND_AT, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 63
        return { kind = std.compiler.token.KIND_QUESTION, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 33
        if self:peek_char() == 61
            self:adv()
            return { kind = std.compiler.token.KIND_NEQ, loc = l, text = strm.sub(self.src, p - 1, self.pos - 1), int_val = 0, float_val = 0.0 }
        end
        return { kind = std.compiler.token.KIND_BANG, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    elseif c == 96
        return { kind = std.compiler.token.KIND_BACKTICK, loc = l, text = strm.sub(self.src, p - 1, p - 1), int_val = 0, float_val = 0.0 }
    else
        self:_fail(4)
        return { kind = std.compiler.token.KIND_EOF, loc = l, text = "", int_val = 0, float_val = 0.0 }
    end
end

next(self: Lexer): Tok
    if self.has_peeked
        tok = self.peeked_token
        self.has_peeked = false
        return tok
    end
    return self:next_tok()
end

peek(self: Lexer): Tok
    if not self.has_peeked
        self.peeked_token = self:next_tok()
        self.has_peeked = true
    end
    self.peeked_token
end

save_state(self: Lexer): State
    return {
        pos = self.pos,
        start = self.start,
        line = self.line,
        col = self.col,
        has_peeked = self.has_peeked,
        peeked_token = self.peeked_token,
    }
end

restore_state(self: Lexer, state: State)
    self.pos = state.pos
    self.start = state.start
    self.line = state.line
    self.col = state.col
    self.has_peeked = state.has_peeked
    self.peeked_token = state.peeked_token
end

-- ── Pass 16 MP4-B02 — sovereign tokenize surface ──────────────────────────────
--
-- Two entries, because two is all the power needs: a streaming primitive the host
-- tokenizer loop consumes, and the differential that proves this lexer agrees with
-- the production one token-for-std.compiler.token. Everything else (counts, kinds at an index,
-- spans) derives from `step` in the caller, and deriving it there is also the only
-- way to keep it O(n) — a `kind_at(index)` entry must re-lex per call.
--
-- Both lower through DNIR to native machine code: no C backend, no runtime helper.
-- `@c.export` sets the wasm export name; the native symbol is the Duo function
-- name, so each is named exactly what the ABI must see.

-- Lex one token at 1-based byte offset `pos`; return `kind * 2^40 + next_pos`.
-- Feed `next_pos` back to walk the stream in O(n). Packing keeps this a single
-- scalar, so no aggregate crosses the boundary.
--
-- `kind` is at most 105 and `next_pos` is a byte offset, so the product cannot
-- overflow i64 for any source a compiler will see.
-- Whole-file tokenize in ONE call, writing into a host-provided buffer.
--
-- This is the shape production dispatch needs, and `duo_lexer_step` is not it.
-- Step rebuilds a `Lexer` at a byte offset, which discards `has_peeked` /
-- `peeked_token` and the hint state the type carries, so a step-driven walk
-- silently mis-lexes context-sensitive shapes (bisected to the `=` in
-- `fun add(a: i64): i64 =`). Here a single `Lexer` runs the whole file, so the
-- stream is state-faithful by construction, and it is O(n) with no cursor ABI.
--
-- `out` is a host address (see `mem.addr` / `mem.ptr_from_addr`); tokens are
-- written as four i64 fields — kind, line, col, int_val — and the return is the
-- token count including the terminating EOF, or -1 if `cap` is too small.
-- Whole-file tokenize carrying TEXT as well, into two host-provided buffers.
--
-- `duo_lexer_tokenize_all` is enough to fingerprint a stream but not to DRIVE a
-- parser: the host also needs each token's text, and text is not a slice of the
-- source once escapes are processed, so start/end offsets cannot recover it.
-- Here the caller supplies a second arena; each token records (offset, length)
-- into it. The arena belongs to the HOST, which keeps the no-writable-__DATA
-- constraint in this file's header intact — nothing is allocated on the Duo
-- side beyond what std.str already does.
--
-- Six i64 per token: kind, line, col, int_val, text_off, text_len.
-- Returns the token count including EOF, or -1 if either buffer is too small.
@c.export("duo_lexer_tokenize_text")
duo_lexer_tokenize_text(src: str, file: str, out: i64, cap: i64, txt: i64, txtcap: i64): i64
    lex = new(src, file)
    buf = mem.ptr_from_addr(i64, out)
    tbuf = mem.ptr_from_addr(i64, txt)
    n: i64 = 0
    toff: i64 = 0
    while n < cap
        tok = next_tok(lex)
        tlen: i64 = strm.len(tok.text)
        if toff + tlen > txtcap return -1 end
        k: i64 = 0
        while k < tlen
            mem.write_byte(tbuf, toff + k, tok.text:byte(k + 1))
            k += 1
        end
        mem.write_i64(buf, (n * 6) * 8, tok.kind)
        mem.write_i64(buf, (n * 6 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 6 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 6 + 3) * 8, tok.int_val)
        mem.write_i64(buf, (n * 6 + 4) * 8, toff)
        mem.write_i64(buf, (n * 6 + 5) * 8, tlen)
        toff = toff + tlen
        n += 1
        if tok.kind == std.compiler.token.KIND_EOF return n end
    end
    -1
end

-- The PRODUCTION DISPATCH entry: everything the host `Token` carries, in one
-- pass. `tokenize_text` is one field short of that — it drops `float_val`, so a
-- host driven by it would silently mis-read every float literal while every
-- kind-based differential stayed green. That is the same shape as the token-TEXT
-- gap this file already records, so the field is carried rather than recomputed.
--
-- Seven slots per token, byte offsets, `float_val` written as f64 bits:
--     0 kind   1 line   2 col   3 int_val   4 source offset   5 text length   6 float value
--
-- Returns the token count, or -1 if `cap` is too small. The final two arguments
-- remain only to preserve the bootstrap ABI while consumers migrate; token text
-- is no longer copied through them. A short read that looks like a short file is
-- the one failure a parser cannot detect.
-- The rejection's location, for a host that has just been handed a negative
-- code. Re-lexes: this is the cold path, taken once per failed file.
@c.export("duo_lexer_error_line")
duo_lexer_error_line(src: str, file: str): i64
    lex = new(src, file)
    n: i64 = 0
    while n < 10000000
        tok = next_tok(lex)
        n += 1
        if lex.has_error return lex.error_loc.line end
        if tok.kind == std.compiler.token.KIND_EOF return 0 end
    end
    0
end

@c.export("duo_lexer_tokenize_full")
duo_lexer_tokenize_full(src: str, file: str, out: i64, cap: i64, txt: i64, txtcap: i64): i64
    lex = new(src, file)
    buf = mem.ptr_from_addr(i64, out)
    n: i64 = 0
    toff: i64 = 0
    while n < cap
        tok = next_tok(lex)
        tlen: i64 = strm.len(tok.text)
        toff = lex.start - 1
        mem.write_i64(buf, (n * 7) * 8, tok.kind)
        mem.write_i64(buf, (n * 7 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 7 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 7 + 3) * 8, tok.int_val)
        mem.write_i64(buf, (n * 7 + 4) * 8, toff)
        mem.write_i64(buf, (n * 7 + 5) * 8, tlen)
        mem.write_f64(buf, (n * 7 + 6) * 8, tok.float_val)
        n += 1
        -- GAP-017: a rejection is returned, not raised. Negative codes are
        -- offset by 100 so they cannot collide with -1 (buffer too small):
        -- -101 UnterminatedString, -102 UnterminatedLongString,
        -- -103 InvalidEscape, -104 UnexpectedChar.
        if lex.has_error return 0 - 100 - lex.error_code end
        if tok.kind == std.compiler.token.KIND_EOF return n end
    end
    -1
end

@c.export("duo_lexer_tokenize_all")
duo_lexer_tokenize_all(src: str, file: str, out: i64, cap: i64): i64
    lex = new(src, file)
    buf = mem.ptr_from_addr(i64, out)
    n: i64 = 0
    while n < cap
        tok = next_tok(lex)
        mem.write_i64(buf, (n * 4) * 8, tok.kind)
        mem.write_i64(buf, (n * 4 + 1) * 8, tok.loc.line)
        mem.write_i64(buf, (n * 4 + 2) * 8, tok.loc.col)
        mem.write_i64(buf, (n * 4 + 3) * 8, tok.int_val)
        n += 1
        if lex.has_error return 0 - 100 - lex.error_code end
        if tok.kind == std.compiler.token.KIND_EOF return n end
    end
    -1
end

@c.export("duo_lexer_step")
duo_lexer_step(src: str, file: str, pos: i64): i64
    lex = new(src, file)
    lex.pos = pos
    tok = next_tok(lex)
    tok.kind * 1099511627776 + lex.pos
end

-- Token-kind fingerprint: mixes every token including the terminating EOF.
-- Agrees bit-for-bit with `src/lexer_differential.zig:fingerprintSource`
-- (`h = h * 31 + kind`), which is what makes it a differential against the
-- production lexer rather than a self-consistency check.
--
-- u64, not i64: a hash must wrap, and signed overflow is UB in lowered code.
-- Token-TEXT fingerprint, the companion to `duo_lexer_kind_fingerprint`.
--
-- The kind fingerprint hashes only `tok.kind`, so text equivalence with
-- `src/lexer.zig` was never differenced — a lexer could return the wrong bytes
-- for every string literal and the corpus proof would stay green. That gap let
-- me both mis-diagnose and then mis-"fix" the escape contract in one session.
--
-- Mixes the LENGTH before the bytes so that concatenation cannot alias: "ab"
-- then "c" must not hash like "a" then "bc". Includes the terminating EOF
-- (length 0), matching `lexer_differential.textFingerprintSource`.
@c.export("duo_lexer_text_fingerprint")
duo_lexer_text_fingerprint(src: str, file: str): u64
    lex = new(src, file)
    h: u64 = 0
    while true
        tok = next_tok(lex)
        tl: i64 = #tok.text
        h = h * 31 + tl
        bi: i64 = 1
        while bi <= tl
            h = h * 31 + tok.text:byte(bi)
            bi += 1
        end
        if tok.kind == std.compiler.token.KIND_EOF return h end
    end
    h
end

@c.export("duo_lexer_kind_fingerprint")
duo_lexer_kind_fingerprint(src: str, file: str): u64
    lex = new(src, file)
    h: u64 = 0
    while true
        tok = next_tok(lex)
        h = h * 31 + tok.kind
        if tok.kind == std.compiler.token.KIND_EOF return h end
    end
    h
end
