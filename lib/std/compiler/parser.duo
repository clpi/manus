-- std.compiler.parser — SH-04: a recursive-descent parser in Duo.
--
-- Three layers, in increasing fidelity to the production `src/parser.zig`:
--
--   L1  Character-driven expression parser (precedence climbing, mutual
--       recursion, ABI-register record result). This is the part the direct
--       ARM64 backend can lower today, and `eval` (below) is its exported
--       proof entry point — keep it pristine.
--   L2  Token-driven expression parser over the `std.compiler.lexer` token
--       stream (`next`/`peek`), the interface `src/parser.zig` itself uses.
--   L3  Statement-level recursive descent over the same token stream that
--       produces s-expression syntax-graph projections (the spine of P16-WS5,
--       the syntax graph). This layer moved SH-04 off seed_only.
--
-- Bounded-subset grammar (L3), documented against `docs/GRAMMAR_SPEC.md`:
--
--   program := stmt*
--   stmt    := 'fun' NAME '(' params ')' (':' type)? (('=' expr)? block | block)
--            |  NAME '(' params ')' ...            (bare decl — requires a ':'
--            |                                     annotation in params/return;
--            |                                     untyped bare decls need 'fun')
--            |  'if' expr (stmt|elseif|else)* 'end'
--            |  'while' expr stmt* 'end'
--            |  'return' expr?
--            |  '@' directive                       (prefix @)
--            |  NAME ('='|'+='|'-='|'*='|'/='|'%='|'^=') expr
--            |  expr
--   params  := (param (',' param)*)?
--   param   := NAME (':' type)?
--   type    := (NAME | i8..u64 | f32|f64|bool|void|str) ('.' ...)*
--   expr    := or | or 'or' or ...
--            | and 'and' and | cmp (('=='|'!='|'<='|'>='|'<'|'>') cmp)?
--            | add (('+'|'-'|'..') add)* | term (('*'|'/'|'//'|'%') term)*
--            | unary ('-'|'not') unary | postfix
--            | primary ( '(' args ')' | '.' NAME | '@' NAME | STRING )*
--   primary := INT | FLOAT | STRING | NAME | true|false|nil
--            | '(' expr ')' | '{' desc '}' | 'if' expr ... 'end'
--
-- s-expression projections (the syntax-graph spine):
--
--   program := (program <stmt>...)
--   name    := <source text>
--   literal := <source text>                 42, 3.5, "hi", true, false, nil
--   binop   := (+ l r) (- l r) (* l r) (/ l r) (// l r) (% l r) (.. l r)
--              (= l r) (!= l r) (< l r) (<= l r) (> l r) (>= l r)
--              (and l r) (or l r) (not x)    (== and != both project as '=')
--   call    := (call <callee> <arg>...)      string-literal sugar included
--   dot     := (dot <base> <name>)
--   assign  := (assign <name> <expr>)        (+= etc.) → (assign-op <op> ...)
--   fun     := (fun <name> (params (param n t)...) (ret <type>)? <body>...)
--   if      := (if <cond> <stmt>... (elseif <cond> <stmt>...)* (else <stmt>...)?)
--   while   := (while <cond> <stmt>...)
--   return  := (return) | (return <expr>)
--   at      := (at <name> <name-or-literal>...)      @comp.c.export("x")
--   anchor  := (anchor <expr> <name>)                postfix foo@bar
--   desc    := (desc <key> <value>...)               { x = 1, y = 2 }
--
-- Errors: any grammar violation sets `lx.has_error` and projects a `(error)`
-- marker; `parse_status` reports 0 (clean) vs 1 (rejected) so the compile-fail
-- corpus is a binary differential. Unsupported-but-valid Duo (match, enum,
-- type, @comp.define...) rejects too — that is the bounded-subset boundary.

-- A parse result: the value produced, and the position after it.
Res: @{ val: i64, pos: i64 }

is_digit = (c: i64): i64
    if c >= 48 and c <= 57
        return 1
    end
    0
end

skip_spaces = (src: str, pos: i64): i64
    n = #src
    i = pos
    while i <= n and string.byte(src, i) == 32
        i = i + 1
    end
    i
end

-- factor := NUMBER | '(' expr ')'
--
-- Mutual recursion with parse_expr: `factor` calls `expr` for a parenthesised
-- group, and `expr` calls `factor` through `term`. Proving that mutual recursion
-- lowers natively is half the point of this file — a recursive-descent parser is
-- nothing but a cycle of such calls.
parse_factor = (src: str, pos: i64): Res
    n = #src
    i = skip_spaces(src, pos)
    if i > n
        return { val = 0, pos = i }
    end
    c = string.byte(src, i)
    if c == 40
        inner: Res = parse_expr(src, i + 1)
        j = skip_spaces(src, inner.pos)
        if j <= n and string.byte(src, j) == 41
            return { val = inner.val, pos = j + 1 }
        end
        return { val = inner.val, pos = j }
    end
    acc = 0
    j = i
    while j <= n and is_digit(string.byte(src, j)) == 1
        acc = acc * 10 + string.byte(src, j) - 48
        j = j + 1
    end
    { val = acc, pos = j }
end

-- term := factor (('*' | '/') factor)*
parse_term = (src: str, pos: i64): Res
    n = #src
    left: Res = parse_factor(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = string.byte(src, i)
        if op == 42
            rhs: Res = parse_factor(src, i + 1)
            acc = acc * rhs.val
            i = skip_spaces(src, rhs.pos)
        end
        if op == 47
            rhs2: Res = parse_factor(src, i + 1)
            acc = acc / rhs2.val
            i = skip_spaces(src, rhs2.pos)
        end
        if op != 42 and op != 47
            return { val = acc, pos = i }
        end
    end
    { val = acc, pos = i }
end

-- expr := term (('+' | '-') term)*
parse_expr = (src: str, pos: i64): Res
    n = #src
    left: Res = parse_term(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = string.byte(src, i)
        if op == 43
            rhs: Res = parse_term(src, i + 1)
            acc = acc + rhs.val
            i = skip_spaces(src, rhs.pos)
        end
        if op == 45
            rhs2: Res = parse_term(src, i + 1)
            acc = acc - rhs2.val
            i = skip_spaces(src, rhs2.pos)
        end
        if op != 43 and op != 45
            return { val = acc, pos = i }
        end
    end
    { val = acc, pos = i }
end


-- Native entry point. `parse_expr` returns a record, and a cross-module record
-- return has no C ABI export form yet, so a direct-backend caller cannot use it.
-- Returning just the value keeps the whole parser reachable from natively
-- lowered code: the caller gets an i64 through x0 and the record never crosses
-- the module boundary.
@comp.c.export("duo_parse_eval")
eval(src: str): i64
    r = parse_expr(src, 1)
    return r.val
end


-- ── SH-04 step 2: the same grammar, driven by the TOKEN STREAM ──────────────
--
-- Everything above parses characters. That is what kept SH-04 at seed_only:
-- a real parser consumes the lexer's tokens, and `std.compiler.lexer` is
-- already proven token-for-token equal to `src/lexer.zig` (SH-03). These
-- functions are the same precedence-climbing grammar re-expressed over
-- `lexer.next` / `lexer.peek`, which is the interface `src/parser.zig` itself
-- uses (`pk` / `adv`).
--
--   expr := term (('+' | '-') term)*
--   term := factor (('*' | '/') factor)*
--   factor := INT_LIT | '(' expr ')'
--
-- Operator dispatch is on `token.KIND_*` rather than on raw bytes, so adding a
-- grammar level is a token-kind edit, not a character comparison.

lexer = req "std.compiler.lexer"
token = req "std.compiler.token"

-- factor := INT_LIT | '(' expr ')'
-- Mutual recursion with parse_expr_tok, exactly as in the character version.
parse_factor_tok(lx: any): i64
    t = lexer.next(lx)
    if t.kind == token.KIND_INT_LIT
        return t.int_val
    end
    if t.kind == token.KIND_LPAREN
        v = parse_expr_tok(lx)
        c = lexer.peek(lx)
        if c.kind == token.KIND_RPAREN
            _d = lexer.next(lx)
        end
        return v
    end
    0
end

-- term := factor (('*' | '/') factor)*
parse_term_tok(lx: any): i64
    acc = parse_factor_tok(lx)
    cont = 1
    while cont == 1
        p = lexer.peek(lx)
        if p.kind == token.KIND_STAR
            _a = lexer.next(lx)
            acc = acc * parse_factor_tok(lx)
        elseif p.kind == token.KIND_SLASH
            _b = lexer.next(lx)
            rhs = parse_factor_tok(lx)
            if rhs != 0
                acc = acc / rhs
            end
        else
            cont = 0
        end
    end
    acc
end

-- expr := term (('+' | '-') term)*
parse_expr_tok(lx: any): i64
    acc = parse_term_tok(lx)
    cont = 1
    while cont == 1
        p = lexer.peek(lx)
        if p.kind == token.KIND_PLUS
            _a = lexer.next(lx)
            acc = acc + parse_term_tok(lx)
        elseif p.kind == token.KIND_MINUS
            _b = lexer.next(lx)
            acc = acc - parse_term_tok(lx)
        else
            cont = 0
        end
    end
    acc
end

-- Token-driven entry point: lex, then parse the token stream.
eval_tokens(src: str): i64
    lx = lexer.new(src, "<expr>")
    parse_expr_tok(lx)
end


-- ── SH-04 step 3 (L3): statement-level descent + s-expression projections ──
--
-- Grammar and projection formats are documented at the top of this file. The
-- functions below are a single mutually recursive family: `proj_stmt` dispatches
-- on the token kind, block parsers (`proj_body` / `proj_body_until_else`) loop
-- `proj_stmt` until a block terminator, and `proj_expr` climbs precedence.
-- Everything rides `lexer.next` / `lexer.peek` — no token array, no allocation
-- beyond the strings being built.

is_assign_kind(k: i64): bool
    if k == token.KIND_ASSIGN or k == token.KIND_PLUS_ASSIGN or k == token.KIND_MINUS_ASSIGN
        return true
    end
    if k == token.KIND_STAR_ASSIGN or k == token.KIND_SLASH_ASSIGN or k == token.KIND_PERCENT_ASSIGN
        return true
    end
    if k == token.KIND_CARET_ASSIGN
        return true
    end
    false
end

is_type_kind(k: i64): bool
    if k == token.KIND_NAME
        return true
    end
    if k >= token.KIND_I8 and k <= token.KIND_STR
        return true
    end
    false
end

-- Mark the parse failed. `lx` is the lexer (a table on this path), so the flag
-- persists through the recursion and is readable by `parse_status`.
mark_error(lx: Lexer)
    lx.has_error = true
end

-- Two-token lookahead, via the lexer's own save/restore state.
peek2(lx: Lexer): Tok
    st = lexer.save_state(lx)
    _a = lexer.next(lx)
    t = lexer.peek(lx)
    lexer.restore_state(lx, st)
    t
end

-- Join two projection fragments with a space, omitting empty fragments so no
-- trailing-space artifacts leak into the sexpr.
join(a: str, b: str): str
    if a == "" return b end
    if b == "" return a end
    a .. " " .. b
end

-- Re-quote a string-literal token text (the lexer strips the quotes).
quote(s: str): str
    "\"" .. s .. "\""
end

-- Lookahead scan: does the parenthesised group at the cursor contain a `:`
-- at depth 1 (a type annotation)? That is what separates a declaration
-- `f(a: i64)` from a call `f(x)`.
params_have_colon(lx: Lexer): bool
    st = lexer.save_state(lx)
    _lp = lexer.next(lx)
    depth = 1
    found = false
    while depth > 0
        t = lexer.next(lx)
        if t.kind == token.KIND_EOF break end
        if t.kind == token.KIND_LPAREN
            depth = depth + 1
        elseif t.kind == token.KIND_RPAREN
            depth = depth - 1
        elseif t.kind == token.KIND_COLON and depth == 1
            found = true
            break
        end
    end
    lexer.restore_state(lx, st)
    found
end

-- One parameter: NAME (':' type)?.
proj_param(lx: Lexer): str
    n = lexer.next(lx)
    p = "(param " .. n.text
    if lexer.peek(lx).kind == token.KIND_COLON
        _c = lexer.next(lx)
        p = p .. " " .. proj_type(lx)
    end
    p .. ")"
end

-- Comma-separated parameter list, consuming the closing ')'.
proj_params(lx: Lexer): str
    acc = ""
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_RPAREN
            _r = lexer.next(lx)
            return acc
        end
        if t.kind == token.KIND_EOF
            mark_error(lx)
            return acc
        end
        acc = join(acc, proj_param(lx))
        if lexer.peek(lx).kind == token.KIND_COMMA
            _c = lexer.next(lx)
        end
    end
end

-- Type reference: primitive keyword kinds or a NAME (record type).
proj_type(lx: Lexer): str
    acc = ""
    while true
        t = lexer.peek(lx)
        if is_type_kind(t.kind) == false
            return acc
        end
        _n = lexer.next(lx)
        acc = join(acc, t.text)
        if lexer.peek(lx).kind == token.KIND_DOT
            _d = lexer.next(lx)
        end
    end
end

-- Statements until 'end' (consumed). 'else'/'elseif' do not terminate here.
proj_body(lx: Lexer): str
    acc = ""
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_END
            _e = lexer.next(lx)
            return acc
        end
        if t.kind == token.KIND_EOF
            mark_error(lx)
            return acc
        end
        acc = join(acc, proj_stmt(lx))
    end
end

-- Statements until 'end', 'else' or 'elseif' — for if/else block parsing.
proj_body_until_else(lx: Lexer): str
    acc = ""
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_ELSE or t.kind == token.KIND_ELSEIF or t.kind == token.KIND_END or t.kind == token.KIND_EOF
            return acc
        end
        acc = join(acc, proj_stmt(lx))
    end
end

-- fun NAME '(' params ')' (':' type)? (('=' expr) | body) ...
-- `first` is the peeked token: either the 'fun'/'function' keyword (consumed,
-- then the NAME is read) or the bare-declaration NAME itself.
proj_fun_decl(lx: Lexer, first: Tok): str
    if first.kind == token.KIND_FUN or first.kind == token.KIND_FUNCTION
        _k = lexer.next(lx)
        n = lexer.next(lx)
    else
        n = lexer.next(lx)
    end
    _lp = lexer.next(lx)
    params = proj_params(lx)
    s = "(fun " .. n.text .. " (params"
    if params != ""
        s = s .. " " .. params
    end
    s = s .. ")"
    if lexer.peek(lx).kind == token.KIND_COLON
        _c = lexer.next(lx)
        s = s .. " (ret " .. proj_type(lx) .. ")"
    end
    if lexer.peek(lx).kind == token.KIND_ASSIGN
        _e = lexer.next(lx)
        e = proj_expr(lx)
        t = lexer.next(lx)
        if t.kind != token.KIND_END
            mark_error(lx)
        end
        return s .. " " .. e .. ")"
    end
    s .. " " .. proj_body(lx) .. ")"
end

-- if expr ... ('elseif' expr ...)* ('else' ...)? 'end'
proj_if(lx: Lexer): str
    _i = lexer.next(lx)
    cond = proj_expr(lx)
    s = "(if " .. cond
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_ELSEIF
            _e = lexer.next(lx)
            c2 = proj_expr(lx)
            s = s .. " (elseif " .. c2
            b = proj_body_until_else(lx)
            if b != ""
                s = s .. " " .. b
            end
            s = s .. ")"
        elseif t.kind == token.KIND_ELSE
            _e = lexer.next(lx)
            s = s .. " (else"
            b = proj_body_until_else(lx)
            if b != ""
                s = s .. " " .. b
            end
            s = s .. ")"
        elseif t.kind == token.KIND_END
            _e = lexer.next(lx)
            return s .. ")"
        elseif t.kind == token.KIND_EOF
            mark_error(lx)
            return s .. ")"
        else
            s = s .. " " .. proj_stmt(lx)
        end
    end
end

-- while expr ... 'end'
proj_while(lx: Lexer): str
    _w = lexer.next(lx)
    cond = proj_expr(lx)
    body = proj_body(lx)
    s = "(while " .. cond
    if body != ""
        s = s .. " " .. body
    end
    s .. ")"
end

-- `do` is optional in .duo and mandatory in .lua; the lexer feeds both, so the
-- loop forms accept it and drop it rather than projecting it.
skip_do(lx: Lexer)
    if lexer.peek(lx).kind == token.KIND_DO
        _d = lexer.next(lx)
    end
end

-- for NAME '=' expr ',' expr (',' expr)? body 'end'   -- numeric
-- for NAME (',' NAME)* 'in' expr body 'end'           -- generic
--
-- Projected as '(for NAME (range A B [S]) body...)' and
-- '(forin (names N...) EXPR body...)'. The `range` grouping is what keeps an
-- optional step unambiguous: without it, a three-expression header and a
-- two-expression header followed by a body statement project identically.
proj_for(lx: Lexer): str
    _f = lexer.next(lx)
    n1 = lexer.next(lx)
    if n1.kind != token.KIND_NAME
        mark_error(lx)
        return "(for (error))"
    end
    if lexer.peek(lx).kind == token.KIND_ASSIGN
        _a = lexer.next(lx)
        start = proj_expr(lx)
        if lexer.peek(lx).kind != token.KIND_COMMA
            mark_error(lx)
            return "(for (error))"
        end
        _c = lexer.next(lx)
        rng = "(range " .. start .. " " .. proj_expr(lx)
        if lexer.peek(lx).kind == token.KIND_COMMA
            _c2 = lexer.next(lx)
            rng = rng .. " " .. proj_expr(lx)
        end
        rng = rng .. ")"
        skip_do(lx)
        body = proj_body(lx)
        s = "(for " .. n1.text .. " " .. rng
        if body != ""
            s = s .. " " .. body
        end
        return s .. ")"
    end
    names = n1.text
    while lexer.peek(lx).kind == token.KIND_COMMA
        _c = lexer.next(lx)
        nx = lexer.next(lx)
        if nx.kind != token.KIND_NAME
            mark_error(lx)
            return "(forin (error))"
        end
        names = names .. " " .. nx.text
    end
    if lexer.peek(lx).kind != token.KIND_IN
        mark_error(lx)
        return "(forin (error))"
    end
    _i = lexer.next(lx)
    seq = proj_expr(lx)
    skip_do(lx)
    body = proj_body(lx)
    s = "(forin (names " .. names .. ") " .. seq
    if body != ""
        s = s .. " " .. body
    end
    s .. ")"
end

-- return expr?
proj_return(lx: Lexer): str
    _r = lexer.next(lx)
    t = lexer.peek(lx)
    if t.kind == token.KIND_END or t.kind == token.KIND_ELSE or t.kind == token.KIND_ELSEIF or t.kind == token.KIND_EOF
        return "(return)"
    end
    "(return " .. proj_expr(lx) .. ")"
end

-- NAME ('=' | op-assign) expr
proj_assign(lx: Lexer, t: Tok): str
    _n = lexer.next(lx)
    op = lexer.next(lx)
    rhs = proj_expr(lx)
    if op.kind == token.KIND_ASSIGN
        return "(assign " .. t.text .. " " .. rhs .. ")"
    end
    "(assign-op " .. op.text .. " " .. t.text .. " " .. rhs .. ")"
end

-- '@' directive: dotted names, then optional parenthesised arguments.
proj_directive(lx: Lexer): str
    _a = lexer.next(lx)
    s = "(at"
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_NAME
            _n = lexer.next(lx)
            s = s .. " " .. t.text
        elseif t.kind == token.KIND_DOT
            _d = lexer.next(lx)
        elseif t.kind == token.KIND_LPAREN
            s = join(s, proj_arglist(lx))
        elseif t.kind == token.KIND_STRING_LIT
            _n = lexer.next(lx)
            s = s .. " " .. quote(t.text)
        else
            return s .. ")"
        end
    end
end

-- '(' arg (',' arg)* ')'
proj_arglist(lx: Lexer): str
    _lp = lexer.next(lx)
    acc = ""
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_RPAREN
            _r = lexer.next(lx)
            return acc
        end
        if t.kind == token.KIND_EOF
            mark_error(lx)
            return acc
        end
        acc = join(acc, proj_expr(lx))
        if lexer.peek(lx).kind == token.KIND_COMMA
            _c = lexer.next(lx)
        end
    end
end

-- '{' key (('=' | value)) (',' ...)* '}' — descriptor / table literal.
proj_desc_body(lx: Lexer): str
    s = "(desc"
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_RBRACE
            _r = lexer.next(lx)
            return s .. ")"
        end
        if t.kind == token.KIND_EOF
            mark_error(lx)
            return s .. ")"
        end
        if t.kind == token.KIND_NAME
            _n = lexer.next(lx)
            s = s .. " " .. t.text
            if lexer.peek(lx).kind == token.KIND_ASSIGN or lexer.peek(lx).kind == token.KIND_COLON
                _e = lexer.next(lx)
            end
            v = proj_expr(lx)
            if v != ""
                s = s .. " " .. v
            end
        else
            mark_error(lx)
            return s .. ")"
        end
        if lexer.peek(lx).kind == token.KIND_COMMA
            _c = lexer.next(lx)
        end
    end
end

-- Precedence-climbing expression projection, highest level first.
proj_expr(lx: Lexer): str
    left = proj_and(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_OR
            _o = lexer.next(lx)
            left = "(or " .. left .. " " .. proj_and(lx) .. ")"
        else
            return left
        end
    end
end

proj_and(lx: Lexer): str
    left = proj_cmp(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_AND
            _a = lexer.next(lx)
            left = "(and " .. left .. " " .. proj_cmp(lx) .. ")"
        else
            return left
        end
    end
end

proj_cmp(lx: Lexer): str
    left = proj_add(lx)
    t = lexer.peek(lx)
    op = "?"
    if t.kind == token.KIND_EQ or t.kind == token.KIND_NEQ
        op = "="
    elseif t.kind == token.KIND_LEQ
        op = "<="
    elseif t.kind == token.KIND_GEQ
        op = ">="
    elseif t.kind == token.KIND_LT
        op = "<"
    elseif t.kind == token.KIND_GT
        op = ">"
    else
        return left
    end
    _o = lexer.next(lx)
    "(" .. op .. " " .. left .. " " .. proj_add(lx) .. ")"
end

proj_add(lx: Lexer): str
    left = proj_term(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_PLUS
            _o = lexer.next(lx)
            left = "(+ " .. left .. " " .. proj_term(lx) .. ")"
        elseif t.kind == token.KIND_MINUS
            _o = lexer.next(lx)
            left = "(- " .. left .. " " .. proj_term(lx) .. ")"
        elseif t.kind == token.KIND_CONCAT
            _o = lexer.next(lx)
            left = "(.. " .. left .. " " .. proj_term(lx) .. ")"
        else
            return left
        end
    end
end

proj_term(lx: Lexer): str
    left = proj_unary(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_STAR
            _o = lexer.next(lx)
            left = "(* " .. left .. " " .. proj_unary(lx) .. ")"
        elseif t.kind == token.KIND_SLASH
            _o = lexer.next(lx)
            left = "(/ " .. left .. " " .. proj_unary(lx) .. ")"
        elseif t.kind == token.KIND_IDIV
            _o = lexer.next(lx)
            left = "(// " .. left .. " " .. proj_unary(lx) .. ")"
        elseif t.kind == token.KIND_PERCENT
            _o = lexer.next(lx)
            left = "(% " .. left .. " " .. proj_unary(lx) .. ")"
        else
            return left
        end
    end
end

proj_unary(lx: Lexer): str
    t = lexer.peek(lx)
    if t.kind == token.KIND_MINUS
        _o = lexer.next(lx)
        return "(- " .. proj_unary(lx) .. ")"
    end
    if t.kind == token.KIND_NOT
        _o = lexer.next(lx)
        return "(not " .. proj_unary(lx) .. ")"
    end
    proj_postfix(lx)
end

proj_postfix(lx: Lexer): str
    base = proj_primary(lx)
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_LPAREN
            base = "(call " .. join(base, proj_arglist(lx)) .. ")"
        elseif t.kind == token.KIND_STRING_LIT
            _s = lexer.next(lx)
            base = "(call " .. base .. " " .. quote(t.text) .. ")"
        elseif t.kind == token.KIND_DOT
            _d = lexer.next(lx)
            n = lexer.next(lx)
            base = "(dot " .. base .. " " .. n.text .. ")"
        elseif t.kind == token.KIND_AT
            _a = lexer.next(lx)
            an = lexer.next(lx)
            base = "(anchor " .. base .. " " .. an.text .. ")"
        else
            return base
        end
    end
end

proj_primary(lx: Lexer): str
    t = lexer.peek(lx)
    if t.kind == token.KIND_INT_LIT or t.kind == token.KIND_FLOAT_LIT
        _n = lexer.next(lx)
        return t.text
    end
    if t.kind == token.KIND_STRING_LIT
        _n = lexer.next(lx)
        return quote(t.text)
    end
    if t.kind == token.KIND_NAME or t.kind == token.KIND_TRUE or t.kind == token.KIND_FALSE or t.kind == token.KIND_NIL
        _n = lexer.next(lx)
        return t.text
    end
    if t.kind == token.KIND_IF
        return proj_if(lx)
    end
    if t.kind == token.KIND_LPAREN
        _lp = lexer.next(lx)
        e = proj_expr(lx)
        c = lexer.next(lx)
        if c.kind == token.KIND_RPAREN
            return e
        end
        mark_error(lx)
        return "(error)"
    end
    if t.kind == token.KIND_LBRACE
        _lb = lexer.next(lx)
        return proj_desc_body(lx)
    end
    _n = lexer.next(lx)
    mark_error(lx)
    "(error)"
end

-- One statement. Returns "" only for block terminators (which the block
-- parsers consume) and EOF.
proj_stmt(lx: Lexer): str
    t = lexer.peek(lx)
    if t.kind == token.KIND_EOF
        return ""
    end
    if t.kind == token.KIND_END or t.kind == token.KIND_ELSE or t.kind == token.KIND_ELSEIF
        return ""
    end
    if t.kind == token.KIND_FUN or t.kind == token.KIND_FUNCTION
        return proj_fun_decl(lx, t)
    end
    if t.kind == token.KIND_IF
        return proj_if(lx)
    end
    if t.kind == token.KIND_WHILE
        return proj_while(lx)
    end
    if t.kind == token.KIND_FOR
        return proj_for(lx)
    end
    if t.kind == token.KIND_RETURN
        return proj_return(lx)
    end
    if t.kind == token.KIND_AT
        return proj_directive(lx)
    end
    if t.kind == token.KIND_NAME
        t2 = peek2(lx)
        if t2.kind == token.KIND_LPAREN
            if params_have_colon(lx)
                return proj_fun_decl(lx, t)
            end
            return proj_expr(lx)
        end
        if is_assign_kind(t2.kind)
            return proj_assign(lx, t)
        end
        return proj_expr(lx)
    end
    proj_expr(lx)
end

-- Whole-program projection: '(program <stmt>...)'.
proj_program_lx(lx: Lexer): str
    acc = ""
    while true
        t = lexer.peek(lx)
        if t.kind == token.KIND_EOF
            if acc == ""
                return "(program)"
            end
            return "(program " .. acc .. ")"
        end
        s = proj_stmt(lx)
        if s == ""
            mark_error(lx)
            return "(program " .. acc .. ")"
        end
        acc = join(acc, s)
    end
end

-- Public entries: s-expression projection and a clean/reject differential.
proj_program(src: str, file: str): str
    lx: Lexer = lexer.new(src, file)
    proj_program_lx(lx)
end

parse_status(src: str, file: str): i64
    lx: Lexer = lexer.new(src, file)
    _p = proj_program_lx(lx)
    if lx.has_error
        return 1
    end
    0
end
