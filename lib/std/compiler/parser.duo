-- std.compiler.parser — SH-04 seed: a recursive-descent expression parser in Duo.
--
-- This is the core shape of `src/parser.zig`: precedence climbing over a token
-- stream with recursive descent through the grammar levels, reduced to the
-- arithmetic subset that the direct backend can lower today.
--
--   expr   := term   (('+' | '-') term)*
--   term   := factor (('*' | '/') factor)*
--   factor := NUMBER | '(' expr ')'
--
-- Mutual recursion between `parse_expr` and `parse_factor` is the point: a
-- recursive-descent parser is nothing but a cycle of such calls, and this proves
-- the cycle lowers to native ARM64. Results ride the ABI registers as a 2-field
-- record, so no step allocates.
--
-- What is NOT here yet, and is what keeps SH-04 at seed_only: statements,
-- declarations, types, attributes, and the token-stream interface to
-- std.compiler.lexer. This parses characters, not tokens.

-- A parse result: the value produced, and the position after it.
Res: @{ val: i64, pos: i64 }

is_digit = (c: i64): i64
    if c >= 48 and c <= 57
        return 1
    end
    0
end

skip_spaces = (src: str, pos: i64): i64
    n = #src
    i = pos
    while i <= n and string.byte(src, i) == 32
        i = i + 1
    end
    i
end

-- factor := NUMBER | '(' expr ')'
--
-- Mutual recursion with parse_expr: `factor` calls `expr` for a parenthesised
-- group, and `expr` calls `factor` through `term`. Proving that mutual recursion
-- lowers natively is half the point of this file — a recursive-descent parser is
-- nothing but a cycle of such calls.
parse_factor = (src: str, pos: i64): Res
    n = #src
    i = skip_spaces(src, pos)
    if i > n
        return { val = 0, pos = i }
    end
    c = string.byte(src, i)
    if c == 40
        inner: Res = parse_expr(src, i + 1)
        j = skip_spaces(src, inner.pos)
        if j <= n and string.byte(src, j) == 41
            return { val = inner.val, pos = j + 1 }
        end
        return { val = inner.val, pos = j }
    end
    acc = 0
    j = i
    while j <= n and is_digit(string.byte(src, j)) == 1
        acc = acc * 10 + string.byte(src, j) - 48
        j = j + 1
    end
    { val = acc, pos = j }
end

-- term := factor (('*' | '/') factor)*
parse_term = (src: str, pos: i64): Res
    n = #src
    left: Res = parse_factor(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = string.byte(src, i)
        if op == 42
            rhs: Res = parse_factor(src, i + 1)
            acc = acc * rhs.val
            i = skip_spaces(src, rhs.pos)
        end
        if op == 47
            rhs2: Res = parse_factor(src, i + 1)
            acc = acc / rhs2.val
            i = skip_spaces(src, rhs2.pos)
        end
        if op != 42 and op != 47
            return { val = acc, pos = i }
        end
    end
    { val = acc, pos = i }
end

-- expr := term (('+' | '-') term)*
parse_expr = (src: str, pos: i64): Res
    n = #src
    left: Res = parse_term(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = string.byte(src, i)
        if op == 43
            rhs: Res = parse_term(src, i + 1)
            acc = acc + rhs.val
            i = skip_spaces(src, rhs.pos)
        end
        if op == 45
            rhs2: Res = parse_term(src, i + 1)
            acc = acc - rhs2.val
            i = skip_spaces(src, rhs2.pos)
        end
        if op != 43 and op != 45
            return { val = acc, pos = i }
        end
    end
    { val = acc, pos = i }
end


-- Native entry point. `parse_expr` returns a record, and a cross-module record
-- return has no C ABI export form yet, so a direct-backend caller cannot use it.
-- Returning just the value keeps the whole parser reachable from natively
-- lowered code: the caller gets an i64 through x0 and the record never crosses
-- the module boundary.
@comp.c.export("duo_parse_eval")
eval(src: str): i64
    r = parse_expr(src, 1)
    return r.val
end
