# std.ml.embed — Token embeddings, positional encodings, and RoPE
# Essential for transformer-based models (LLMs, ViTs, etc.)

# ═══════════════════════════════════════════════════════════════
# Token Embedding
# ═══════════════════════════════════════════════════════════════

token_embedding(vocab_size: i64, embed_dim: i64): any
    scale = 1.0 / embed_dim:sqrt()
    weights = std.ml.tensor.zeros(vocab_size, embed_dim)
    for i = 1, weights.size
        weights.data[i] = (math.random() * 2 - 1) * scale
    end
    {
        type = "token_embedding",
        vocab_size = vocab_size,
        embed_dim = embed_dim,
        weights = weights,
    }
end

@hot
token_embed_forward(layer: any, token_ids: any): any
    # token_ids: {batch_size, seq_len} or 1D array
    batch = 1
    seq_len = #token_ids
    if type(token_ids[1]) == "table"
        batch = #token_ids
        seq_len = #token_ids[1]
    end
    result = std.ml.tensor.zeros(batch * seq_len, layer.embed_dim)
    for i = 1, batch * seq_len
        id = token_ids[i]
        for j = 1, layer.embed_dim
            result.data[(i-1)*layer.embed_dim + j] = layer.weights.data[(id-1)*layer.embed_dim + j]
        end
    end
    std.ml.tensor.reshape(result, batch * seq_len, layer.embed_dim)
end

# ═══════════════════════════════════════════════════════════════
# Sinusoidal Positional Encoding (original Transformer)
# ═══════════════════════════════════════════════════════════════

sinusoidal_encoding(max_len: i64, embed_dim: i64): any
    pe = std.ml.tensor.zeros(max_len, embed_dim)
    for pos = 0, max_len - 1
        for i = 0, embed_dim / 2:floor() - 1
            freq = 1.0 / 10000:pow((2 * i) / embed_dim)
            pe.data[pos * embed_dim + 2 * i + 1] = pos * freq:sin()
            if 2 * i + 2 <= embed_dim
                pe.data[pos * embed_dim + 2 * i + 2] = pos * freq:cos()
            end
        end
    end
    {
        type = "sinusoidal",
        max_len = max_len,
        embed_dim = embed_dim,
        weights = pe,
    }
end

sinusoidal_forward(layer: any, seq_len: i64): any
    std.ml.tensor.slice(layer.weights, 1, seq_len, 1, layer.embed_dim)
end

# ═══════════════════════════════════════════════════════════════
# Learned Positional Embedding
# ═══════════════════════════════════════════════════════════════

learned_positional_embedding(max_len: i64, embed_dim: i64): any
    {
        type = "learned_positional",
        max_len = max_len,
        embed_dim = embed_dim,
        weights = std.ml.tensor.rand(max_len, embed_dim),
    }
end

learned_positional_forward(layer: any, positions: any): any
    # positions: list of 0-based position indices
    seq_len = #positions
    result = std.ml.tensor.zeros(seq_len, layer.embed_dim)
    for i = 1, seq_len
        pos = positions[i] + 1  # 1-indexed
        for j = 1, layer.embed_dim
            result.data[(i-1)*layer.embed_dim + j] = layer.weights.data[(pos-1)*layer.embed_dim + j]
        end
    end
    result
end

# ═══════════════════════════════════════════════════════════════
# Rotary Position Embedding (RoPE) — used in LLaMA, GPT-NeoX, etc.
# ═══════════════════════════════════════════════════════════════

rope_embedding(dim: i64, base: f64, max_seq_len: i64): any
    if base == nil base = 10000.0 end
    if max_seq_len == nil max_seq_len = 8192 end

    # Precompute frequencies
    freqs = std.ml.tensor.zeros(max_seq_len, dim)
    for pos = 0, max_seq_len - 1
        for i = 0, dim / 2:floor() - 1
            freq = 1.0 / base:pow((2 * i) / dim)
            angle = pos * freq
            freqs.data[pos * dim + 2 * i + 1] = angle:cos()
            freqs.data[pos * dim + 2 * i + 2] = angle:sin()
        end
    end

    {
        type = "rope",
        dim = dim,
        base = base,
        max_seq_len = max_seq_len,
        freqs = freqs,
    }
end

@hot
rope_forward(layer: any, x: any, offset: i64): any
    # x: [seq_len, dim]
    # Applies rotary embedding in-place conceptually
    seq_len = x.rows
    dim = x.cols
    result = std.ml.tensor.zeros(seq_len, dim)

    for pos = 0, seq_len - 1
        abs_pos = pos + (offset or 0)
        for i = 0, dim / 2:floor() - 1
            cos_val = layer.freqs.data[abs_pos * dim + 2 * i + 1]
            sin_val = layer.freqs.data[abs_pos * dim + 2 * i + 2]
            x0 = x.data[pos * dim + 2 * i + 1]
            x1 = x.data[pos * dim + 2 * i + 2]
            result.data[pos * dim + 2 * i + 1] = x0 * cos_val - x1 * sin_val
            result.data[pos * dim + 2 * i + 2] = x0 * sin_val + x1 * cos_val
        end
    end
    result
end

# ═══════════════════════════════════════════════════════════════
# ALiBi (Attention with Linear Biases) — used in BLOOM, MPT
# ═══════════════════════════════════════════════════════════════

alibi_encoding(heads: i64, max_seq_len: i64): any
    # Precompute slope for each head
    slopes = {}
    for i = 1, heads
        base = 2:pow(-8 * i / heads)
        slopes[i] = base
    end

    # Precompute bias matrix
    biases = std.ml.tensor.zeros(heads, max_seq_len)
    for h = 1, heads
        for pos = 0, max_seq_len - 1
            biases.data[(h-1) * max_seq_len + pos + 1] = -slopes[h] * pos
        end
    end

    {
        type = "alibi",
        heads = heads,
        max_seq_len = max_seq_len,
        slopes = slopes,
        biases = biases,
    }
end

alibi_forward(layer: any, scores: any, seq_len: i64): any
    # scores: [heads, seq_len, seq_len]
    # Add ALiBi bias to attention scores
    result = std.ml.tensor.copy(scores)
    for h = 1, layer.heads
        for i = 1, seq_len
            for j = 1, seq_len
                if j <= i
                    # Linear bias: -slope * |i - j|
                    result.data[(h-1)*seq_len*seq_len + (i-1)*seq_len + j] =
                        result.data[(h-1)*seq_len*seq_len + (i-1)*seq_len + j] +
                        layer.biases.data[(h-1)*layer.max_seq_len + i - j:abs() + 1]
                end
            end
        end
    end
    result
end

# ═══════════════════════════════════════════════════════════════
# Embedding + Position + LayerNorm (complete embedding layer)
# ═══════════════════════════════════════════════════════════════

embedding_layer(vocab_size: i64, embed_dim: i64, max_seq_len: i64, pos_encoding: str): any
    if pos_encoding == nil pos_encoding = "rope" end
    token_emb = token_embedding(vocab_size, embed_dim)
    pos_emb = nil

    if pos_encoding == "rope"
        pos_emb = rope_embedding(embed_dim, 10000, max_seq_len)
    elseif pos_encoding == "sinusoidal"
        pos_emb = sinusoidal_encoding(max_seq_len, embed_dim)
    elseif pos_encoding == "learned"
        pos_emb = learned_positional_embedding(max_seq_len, embed_dim)
    end

    {
        type = "embedding",
        vocab_size = vocab_size,
        embed_dim = embed_dim,
        max_seq_len = max_seq_len,
        pos_encoding = pos_encoding,
        token = token_emb,
        pos = pos_emb,
    }
end

@hot
embedding_forward(layer: any, token_ids: any, offset: i64): any
    # Token embeddings
    x = token_embed_forward(layer.token, token_ids)
    # Position embeddings
    if has(.pos)(layer)
        if layer.pos_encoding == "rope"
            x = rope_forward(layer.pos, x, offset)
        elseif layer.pos_encoding == "sinusoidal"
            pos_enc = sinusoidal_forward(layer.pos, x.rows)
            x = std.ml.tensor.add(x, pos_enc)
        elseif layer.pos_encoding == "learned"
            positions = {}
            for i = 0, x.rows - 1
                positions[#positions + 1] = i
            end
            pos_enc = learned_positional_forward(layer.pos, positions)
            x = std.ml.tensor.add(x, pos_enc)
        end
    end
    x
end

