# std.ml.export — Model export (ONNX, PyTorch, etc.)
# For saving trained models to standard formats.

# ═══════════════════════════════════════════════════════════════
# ONNX Export
# ═══════════════════════════════════════════════════════════════

onnx_graph_new(name: str): any
    {
        name = name,
        nodes = {},
        inputs = {},
        outputs = {},
        initializers = {},
    }
end

onnx_graph_add_node(graph: any, op_type: str, inputs: any, outputs: any, name: str): void
    graph.nodes[graph:len().nodes + 1] = {
        op_type = op_type,
        inputs = inputs,
        outputs = outputs,
        name = name or "node_" .. to(str)(graph:len().nodes),
    }
end

onnx_graph_add_input(graph: any, name: str, shape: any, dtype: str): void
    graph.inputs[graph:len().inputs + 1] = {
        name = name,
        shape = shape,
        dtype = dtype or "float32",
    }
end

onnx_graph_add_output(graph: any, name: str, shape: any, dtype: str): void
    graph.outputs[graph:len().outputs + 1] = {
        name = name,
        shape = shape,
        dtype = dtype or "float32",
    }
end

onnx_graph_add_initializer(graph: any, name: str, shape: any, data: any): void
    graph.initializers[graph:len().initializers + 1] = {
        name = name,
        shape = shape,
        data = data,
    }
end

onnx_model_new(graph: any, opset: i64): any
    {
        graph = graph,
        opset = opset or 17,
        ir_version = 8,
        producer_name = "duo",
        producer_version = "1.0",
    }
end

onnx_model_encode(model: any): any
    # Encode model as JSON (ONNX protobuf would require a protobuf encoder)
    # This JSON representation captures the full graph structure for interoperability
    graph_summary = {
        name = model.graph.name,
        nodes = {},
        inputs = model.graph.inputs,
        outputs = model.graph.outputs,
    }
    for node in model.graph.nodes
        graph_summary.nodes[graph_summary:len().nodes + 1] = {
            op_type = node.op_type,
            inputs = node.inputs,
            outputs = node.outputs,
            name = node.name,
        }
    end
    payload = {
        ir_version = model.ir_version,
        opset_import = {{version = model.opset}},
        producer_name = model.producer_name,
        producer_version = model.producer_version,
        graph = graph_summary,
    }
    std.encoding.json.encode(payload)
end

onnx_model_save(model: any, path: str): any
    data = onnx_model_encode(model)
    f = std.io.open(path, "w")
    if f == nil
        return {ok = false, error = "Cannot create file: " .. path}
    end
    std.io.write(f, data)
    std.io.close(f)
    {ok = true, path = path, size = data:len()}
end

# ═══════════════════════════════════════════════════════════════
# PyTorch Export (state dict)
# ═══════════════════════════════════════════════════════════════

pytorch_state_dict_new(): any
    {
        tensors = {},
        metadata = {},
    }
end

pytorch_state_dict_add(state_dict: any, name: str, tensor: any): void
    state_dict.tensors[name] = tensor
end

pytorch_state_dict_save(state_dict: any, path: str): any
    # Encode state dict as JSON
    payload = {tensors = {}, metadata = state_dict.metadata}
    for name, tensor in state_dict.tensors
        payload.tensors[name] = {
            shape = tensor.shape or {},
            dtype = tensor.dtype or "f32",
            data_len = tensor.size or 0,
        }
    end
    encoded = std.encoding.json.encode(payload)
    f = std.io.open(path, "w")
    if f == nil
        return {ok = false, error = "Cannot create file: " .. path}
    end
    std.io.write(f, encoded)
    std.io.close(f)
    {ok = true, path = path, size = encoded:len()}
end

# ═══════════════════════════════════════════════════════════════
# SafeTensors Export
# ═══════════════════════════════════════════════════════════════

safetensors_new(): any
    {
        tensors = {},
        metadata = {},
    }
end

safetensors_add_tensor(st: any, name: str, tensor: any, dtype: str): void
    st.tensors[name] = {
        data = tensor,
        dtype = dtype or "f32",
        shape = tensor.shape or {tensor.size},
    }
end

safetensors_encode(st: any): any
    # SafeTensors format: JSON header mapping tensor names to dtype/shape/offsets
    header = {}
    offset = 0
    for name, tensor in st.tensors
        header[name] = {
            dtype = tensor.dtype,
            shape = tensor.shape,
            data_offsets = {offset, offset + tensor.size},
        }
        offset += tensor.size
    end
    header_json = std.encoding.json.encode(header)
    {
        format = "safetensors",
        header = header_json,
        header_size = header_json:len(),
        data_size = offset,
    }
end

safetensors_save(st: any, path: str): any
    data = safetensors_encode(st)
    f = std.io.open(path, "w")
    if f == nil
        return {ok = false, error = "Cannot create file: " .. path}
    end
    # Write 8-byte header length prefix, then header JSON
    header_len = data.header_size
    std.io.write(f, string.pack("<I8", header_len))
    std.io.write(f, data.header)
    std.io.close(f)
    {ok = true, path = path, size = 8 + data.header_size + data.data_size}
end

# ═══════════════════════════════════════════════════════════════
# GGUF Export
# ═══════════════════════════════════════════════════════════════

gguf_writer_new(quantization: str): any
    {
        tensors = {},
        metadata = {},
        quantization = quantization or "f16",
    }
end

gguf_writer_add_tensor(gw: any, name: str, tensor: any, shape: any): void
    gw.tensors[name] = {
        data = tensor,
        shape = shape,
    }
end

gguf_writer_add_metadata(gw: any, key: str, value: any): void
    gw.metadata[key] = value
end

gguf_writer_encode(gw: any): any
    # GGUF header as JSON (simplified; real GGUF uses binary format)
    payload = {
        format = "gguf",
        version = 3,
        quantization = gw.quantization,
        tensors = {},
        metadata = gw.metadata,
    }
    for name, tensor in gw.tensors
        payload.tensors[name] = {
            shape = tensor.shape,
        }
    end
    encoded = std.encoding.json.encode(payload)
    {
        format = "gguf",
        version = 3,
        data = encoded,
        size = encoded:len(),
    }
end

gguf_writer_save(gw: any, path: str): any
    data = gguf_writer_encode(gw)
    f = std.io.open(path, "w")
    if f == nil
        return {ok = false, error = "Cannot create file: " .. path}
    end
    std.io.write(f, data.data)
    std.io.close(f)
    {ok = true, path = path, size = data.size}
end

# ═══════════════════════════════════════════════════════════════
# Model Conversion
# ═══════════════════════════════════════════════════════════════

convert_onnx_to_safetensors(onnx_model: any): any
    st = safetensors_new()
    for init in onnx_model.graph.initializers
        safetensors_add_tensor(st, init.name, init.data, "f32")
    end
    st
end

convert_pytorch_to_onnx(state_dict: any, input_shapes: any): any
    graph = onnx_graph_new("model")
    for name, tensor in state_dict.tensors
        onnx_graph_add_initializer(graph, name, tensor.shape, tensor.data)
    end
    onnx_model_new(graph)
end

convert_gguf_to_safetensors(gguf_model: any): any
    st = safetensors_new()
    for name, tensor in gguf_model.tensors
        safetensors_add_tensor(st, name, tensor.data, "f32")
    end
    st
end

