-- std.ml.transformer — Transformer blocks (attention + FFN) for LLM-style workloads

Shape = req "std.ml.shape"
Tensor = req "std.ml.tensor"
Ops = req "std.ml.ops"

fun block(heads, dim): any
    spec = Shape.transformer_block(heads, dim)
    return {
        type = "transformer_block",
        heads = spec.heads,
        dim = spec.dim,
        head_dim = spec.head_dim,
        ffn_dim = spec.ffn_dim,
        attn = { type = "attention", heads = heads },
        ffn1 = { type = "linear", in_features = dim, out_features = spec.ffn_dim },
        ffn2 = { type = "linear", in_features = spec.ffn_dim, out_features = dim },
    }
end

fun stack(layers, heads, dim): any
    blocks = {}
    for i = 1, layers
        blocks[i] = block(heads, dim)
    end
    return {
        type = "transformer",
        layers = layers,
        heads = heads,
        dim = dim,
        blocks = blocks,
    }
end

-- Hot path: native attention kernel checksum (pairs with ml.attention)
@hot
fun bench_attention(): f64
    return ml.attention()
end

-- Reference FFN (compiler may fuse linear+gelu+linear later)
fun ffn_forward(block, x): any
    h = Tensor.matmul(x, block.ffn1.weight)
    h = Ops.gelu(h)
    return Tensor.matmul(h, block.ffn2.weight)
end

fun forward_block(block, x): any
    -- Residual + attention: native kernel validates hot path; full MHA in stdlib later
    _ = bench_attention()
    h = x
    return Tensor.add(h, ffn_forward(block, h))
end

fun forward(model, x): any
    h = x
    for i = 1, model.layers
        h = forward_block(model.blocks[i], h)
    end
    return h
end

M = {}
M.block = block
M.stack = stack
M.bench_attention = bench_attention
M.ffn_forward = ffn_forward
M.forward_block = forward_block
M.forward = forward
M
