config_new(): any
  {
    warmup_runs = 10,
    num_runs = 100,
    batch_sizes = {
      1,
      2,
      4,
      8,
      16,
      32
    },
    measure_memory = true,
    measure_latency = true,
    measure_throughput = true,
    measure_first_token = true,
    output_dir = "./benchmarks"
  }
end
result_new(model_name: str, batch_size: i64): any
  {
    model_name = model_name,
    batch_size = batch_size,
    latencies = {},
    first_token_latency = 0,
    throughput = 0,
    memory_used = 0,
    memory_peak = 0,
    tokens_per_second = 0
  }
end
result_add_latency(result: any, latency: f64): void
  result.latencies[#result.latencies + 1] = latency
end
result_calculate_stats(result: any): void
  n = #result.latencies
  if n == 0
    return
  end
  sorted = {
    table.unpack(result.latencies)
  }
  table.sort(sorted)
  sum = 0
  for v in sorted
    sum = sum + v
  end
  result.mean_latency = sum / n
  result.median_latency = sorted[math.floor(n / 2) + 1]
  result.p95_latency = sorted[math.floor(n * 0.95) + 1]
  result.p99_latency = sorted[math.floor(n * 0.99) + 1]
  result.min_latency = sorted[1]
  result.max_latency = sorted[n]
  if result.mean_latency > 0
    result.throughput = result.batch_size / result.mean_latency
    result.tokens_per_second = result.throughput
  end
end
runner_new(config: any): any
  {
    config = config,
    results = {}
  }
end
runner_run(runner: any, model_fn: any, input_generator: any): any
  config = runner.config
  results = {}
  batch_idx = 1
  while batch_idx <= #config.batch_sizes
    batch_size = config.batch_sizes[batch_idx]
    result = result_new("model", batch_size)
    i = 0
    while i < config.warmup_runs
      input = input_generator(batch_size)
      model_fn(input)
      i = i + 1
    end
    i = 0
    while i < config.num_runs
      start_time = os.clock()
      input = input_generator(batch_size)
      output = model_fn(input)
      end_time = os.clock()
      result_add_latency(result, end_time - start_time)
      i = i + 1
    end
    result_calculate_stats(result)
    results[batch_idx] = result
    batch_idx = batch_idx + 1
  end
  runner.results = results
  results
end
throughput(model_fn: any, input_generator: any, batch_size: i64, duration: f64): any
  i = 0
  while i < 5
    input = input_generator(batch_size)
    model_fn(input)
    i = i + 1
  end
  start_time = os.clock()
  tokens = 0
  runs = 0
  while os.clock() - start_time < duration
    input = input_generator(batch_size)
    output = model_fn(input)
    tokens = tokens + batch_size
    runs = runs + 1
  end
  elapsed = os.clock() - start_time
  {
    batch_size = batch_size,
    total_tokens = tokens,
    total_runs = runs,
    elapsed = elapsed,
    tokens_per_second = tokens / elapsed,
    runs_per_second = runs / elapsed
  }
end
latency(model_fn: any, input_generator: any, batch_size: i64, num_runs: i64): any
  i = 0
  while i < 5
    input = input_generator(batch_size)
    model_fn(input)
    i = i + 1
  end
  latencies = {}
  i = 0
  while i < num_runs
    start_time = os.clock()
    input = input_generator(batch_size)
    model_fn(input)
    end_time = os.clock()
    latencies[#latencies + 1] = end_time - start_time
    i = i + 1
  end
  table.sort(latencies)
  sum = 0
  for v in latencies
    sum = sum + v
  end
  {
    batch_size = batch_size,
    num_runs = num_runs,
    mean = sum / num_runs,
    median = latencies[math.floor(num_runs / 2) + 1],
    p95 = latencies[math.floor(num_runs * 0.95) + 1],
    p99 = latencies[math.floor(num_runs * 0.99) + 1],
    min = latencies[1],
    max = latencies[num_runs]
  }
end
memory(model_fn: any, input_generator: any, batch_size: i64): any
  input = input_generator(batch_size)
  output = model_fn(input)
  input_size = 0
  if input and input.data
    input_size = #input.data * 4
  end
  output_size = 0
  if output and output.data
    output_size = #output.data * 4
  end
  {
    batch_size = batch_size,
    input_size = input_size,
    output_size = output_size,
    estimated_total = input_size + output_size
  }
end
compare(results: any): any
  comparison = {}
  for name, result in results
    comparison[name] = {
      mean_latency = result.mean_latency or 0,
      throughput = result.throughput or 0,
      tokens_per_second = result.tokens_per_second or 0
    }
  end
  comparison
end
rank(results: any, metric: str): any
  ranked = {}
  for name, result in results
    ranked[#ranked + 1] = {
      name = name,
      value = result[metric] or 0
    }
  end
  table.sort(ranked, (a: any, b: any): any
    a.value > b.value
  end)
  ranked
end
report(results: any): str
  lines = {}
  lines[#lines + 1] = "=== Benchmark Report ==="
  lines[#lines + 1] = ""
  for name, result in results
    lines[#lines + 1] = "Model: " .. name
    lines[#lines + 1] = "  Batch Size: " .. result.batch_size:to(str)
    lines[#lines + 1] = "  Mean Latency: " .. result.mean_latency:to(str) .. "s"
    lines[#lines + 1] = "  Median Latency: " .. result.median_latency:to(str) .. "s"
    lines[#lines + 1] = "  P95 Latency: " .. result.p95_latency:to(str) .. "s"
    lines[#lines + 1] = "  P99 Latency: " .. result.p99_latency:to(str) .. "s"
    lines[#lines + 1] = "  Throughput: " .. result.throughput:to(str) .. " batches/s"
    lines[#lines + 1] = "  Tokens/sec: " .. result.tokens_per_second:to(str)
    lines[#lines + 1] = ""
  end
  table.concat(lines, "\n")
end
