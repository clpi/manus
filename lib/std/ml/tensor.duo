-- std.ml.tensor — Tensor type for ML workloads
-- Uses mem.* intrinsics for direct memory access.

-- ═══════════════════════════════════════════════════════════════
-- Tensor creation (uses Duo's mem.* for raw allocation)
-- ═══════════════════════════════════════════════════════════════

fun tensor_zeros(rows, cols)
    t = {}
    t.rows = rows
    t.cols = cols
    t.size = rows * cols
    t.data = {}
    for i = 1, rows * cols
        t.data[i] = 0.0
    end
    return t
end

fun tensor_ones(rows, cols)
    t = tensor_zeros(rows, cols)
    for i = 1, t.size
        t.data[i] = 1.0
    end
    return t
end

fun tensor_from(data)
    n = #data
    t = {}
    t.rows = 1
    t.cols = n
    t.size = n
    t.data = {}
    for i = 1, n
        t.data[i] = data[i]
    end
    return t
end

fun tensor_rand(rows, cols)
    t = tensor_zeros(rows, cols)
    for i = 1, t.size
        t.data[i] = math.random() * 2 - 1  -- [-1, 1]
    end
    return t
end

-- ═══════════════════════════════════════════════════════════════
-- Tensor operations
-- ═══════════════════════════════════════════════════════════════

fun tensor_add(a, b)
    assert(a.size == b.size, "tensor size mismatch in add")
    result = tensor_zeros(a.rows, a.cols)
    for i = 1, a.size
        result.data[i] = a.data[i] + b.data[i]
    end
    return result
end

fun tensor_mul_scalar(t, s)
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        result.data[i] = t.data[i] * s
    end
    return result
end

@hot
fun tensor_matmul(a, b)
    M = a.rows
    K = a.cols
    N = b.cols
    assert(K == b.rows, "matmul dimension mismatch")
    result = tensor_zeros(M, N)
    -- ikj loop order: better cache locality on B (same as ml.matmul_256 / BLAS)
    for i = 1, M
        for k = 1, K
            aik = a.data[(i - 1) * K + k]
            for j = 1, N
                result.data[(i - 1) * N + j] = result.data[(i - 1) * N + j] + aik * b.data[(k - 1) * N + j]
            end
        end
    end
    return result
end

fun tensor_relu(t)
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        if t.data[i] > 0
            result.data[i] = t.data[i]
        else
            result.data[i] = 0.0
        end
    end
    return result
end

@hot
fun tensor_softmax(t)
    result = tensor_zeros(t.rows, t.cols)
    for row = 1, t.rows
        -- Find max for numerical stability
        max_val = t.data[(row-1)*t.cols + 1]
        for i = 2, t.cols
            v = t.data[(row-1)*t.cols + i]
            if v > max_val max_val = v end
        end
        -- Exp and sum
        sum = 0.0
        for i = 1, t.cols
            result.data[(row-1)*t.cols + i] = math.exp(t.data[(row-1)*t.cols + i] - max_val)
            sum += result.data[(row-1)*t.cols + i]
        end
        -- Normalize
        for i = 1, t.cols
            result.data[(row-1)*t.cols + i] = result.data[(row-1)*t.cols + i] / sum
        end
    end
    return result
end

fun tensor_transpose(t)
    result = tensor_zeros(t.cols, t.rows)
    for i = 1, t.rows
        for j = 1, t.cols
            result.data[(j - 1) * t.rows + i] = t.data[(i - 1) * t.cols + j]
        end
    end
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- Accessors
-- ═══════════════════════════════════════════════════════════════

fun tensor_get(t, row, col)
    return t.data[(row-1)*t.cols + col]
end

fun tensor_set(t, row, col, val)
    t.data[(row-1)*t.cols + col] = val
end

fun tensor_shape(t)
    return { t.rows, t.cols }
end

fun tensor_tostring(t)
    return "Tensor(" .. tostring(t.rows) .. "x" .. tostring(t.cols) .. ")"
end

-- ═══════════════════════════════════════════════════════════════
-- Extended operations
-- ═══════════════════════════════════════════════════════════════

fun tensor_sub(a, b): any
    assert(a.size == b.size, "tensor size mismatch in sub")
    result = tensor_zeros(a.rows, a.cols)
    for i = 1, a.size
        result.data[i] = a.data[i] - b.data[i]
    end
    result
end

fun tensor_mul(a, b): any
    assert(a.size == b.size, "tensor size mismatch in mul")
    result = tensor_zeros(a.rows, a.cols)
    for i = 1, a.size
        result.data[i] = a.data[i] * b.data[i]
    end
    result
end

fun tensor_div(a, b): any
    assert(a.size == b.size, "tensor size mismatch in div")
    result = tensor_zeros(a.rows, a.cols)
    for i = 1, a.size
        result.data[i] = a.data[i] / b.data[i]
    end
    result
end

fun tensor_neg(t): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        result.data[i] = -t.data[i]
    end
    result
end

fun tensor_sum(t): f64
    s = 0
    for i = 1, t.size
        s += t.data[i]
    end
    s
end

fun tensor_mean(t): f64
    tensor_sum(t) / t.size
end

fun tensor_var(t, eps): any
    if eps == nil then eps = 1e-8 end
    m = tensor_mean(t)
    s = 0
    for i = 1, t.size
        d = t.data[i] - m
        s += d * d
    end
    s / t.size + eps
end

fun tensor_std(t, eps): any
    math.sqrt(tensor_var(t, eps))
end

fun tensor_max(t): f64
    best = t.data[1]
    for i = 2, t.size
        if t.data[i] > best then best = t.data[i] end
    end
    best
end

fun tensor_min(t): f64
    best = t.data[1]
    for i = 2, t.size
        if t.data[i] < best then best = t.data[i] end
    end
    best
end

fun tensor_argmax(t): i64
    best_idx = 1
    best_val = t.data[1]
    for i = 2, t.size
        if t.data[i] > best_val then
            best_val = t.data[i]
            best_idx = i
        end
    end
    best_idx
end

fun tensor_argmin(t): i64
    best_idx = 1
    best_val = t.data[1]
    for i = 2, t.size
        if t.data[i] < best_val then
            best_val = t.data[i]
            best_idx = i
        end
    end
    best_idx
end

fun tensor_clamp(t, lo, hi): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        v = t.data[i]
        if v < lo then v = lo end
        if v > hi then v = hi end
        result.data[i] = v
    end
    result
end

fun tensor_abs(t): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        v = t.data[i]
        if v < 0 then v = -v end
        result.data[i] = v
    end
    result
end

fun tensor_log(t): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        result.data[i] = math.log(t.data[i])
    end
    result
end

fun tensor_exp(t): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        result.data[i] = math.exp(t.data[i])
    end
    result
end

fun tensor_sqrt(t): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        result.data[i] = math.sqrt(t.data[i])
    end
    result
end

-- Broadcast add (handles shapes that can be broadcast)
fun tensor_broadcast_add(a, b): any
    if a.rows == b.rows and a.cols == b.cols then
        return tensor_add(a, b)
    end
    if a.rows == 1 and a.cols == b.cols then
        result = tensor_zeros(b.rows, b.cols)
        for i = 1, b.size
            result.data[i] = a.data[((i - 1) % a.cols) + 1] + b.data[i]
        end
        return result
    end
    if a.rows == b.rows and b.cols == 1 then
        result = tensor_zeros(a.rows, a.cols)
        for i = 1, a.size
            result.data[i] = a.data[i] + b.data[((i - 1) % a.rows) + 1]
        end
        return result
    end
    assert(false, "incompatible shapes for broadcast")
end

-- Reshape (returns new tensor with same data, different shape)
fun tensor_reshape(t, new_rows, new_cols): any
    assert(new_rows * new_cols == t.size, "reshape size mismatch")
    {
        rows = new_rows,
        cols = new_cols,
        size = t.size,
        data = t.data,
    }
end

-- Slice: extract sub-tensor
fun tensor_slice(t, row_start, row_end, col_start, col_end): any
    if row_start == nil then row_start = 1 end
    if row_end == nil then row_end = t.rows end
    if col_start == nil then col_start = 1 end
    if col_end == nil then col_end = t.cols end
    new_rows = row_end - row_start + 1
    new_cols = col_end - col_start + 1
    result = tensor_zeros(new_rows, new_cols)
    for r = 0, new_rows - 1
        for c = 0, new_cols - 1
            result.data[r * new_cols + c + 1] = t.data[(row_start + r - 1) * t.cols + (col_start + c)]
        end
    end
    result
end

-- Concatenate tensors along rows (vertical stack)
fun tensor_vstack(tensors: any): any
    if #tensors == 0 then return tensor_zeros(0, 0) end
    total_rows = 0
    cols = tensors[1].cols
    for t in tensors
        total_rows += t.rows
        assert(t.cols == cols, "vstack column mismatch")
    end
    result = tensor_zeros(total_rows, cols)
    offset = 0
    for t in tensors
        for i = 1, t.size
            result.data[offset + i] = t.data[i]
        end
        offset += t.size
    end
    result
end

-- Concatenate tensors along columns (horizontal stack)
fun tensor_hstack(tensors: any): any
    if #tensors == 0 then return tensor_zeros(0, 0) end
    rows = tensors[1].rows
    total_cols = 0
    for t in tensors
        total_cols += t.cols
        assert(t.rows == rows, "hstack row mismatch")
    end
    result = tensor_zeros(rows, total_cols)
    for r = 1, rows
        col_offset = 0
        for t in tensors
            for c = 1, t.cols
                result.data[(r - 1) * total_cols + col_offset + c] = t.data[(r - 1) * t.cols + c]
            end
            col_offset += t.cols
        end
    end
    result
end

-- Eye: identity matrix
fun tensor_eye(n: i64): any
    t = tensor_zeros(n, n)
    for i = 1, n
        t.data[(i - 1) * n + i] = 1.0
    end
    t
end

-- Diagonal: create diagonal matrix from vector
fun tensor_diag(v): any
    n = v.size
    t = tensor_zeros(n, n)
    for i = 1, n
        t.data[(i - 1) * n + i] = v.data[i]
    end
    t
end

-- Arange: create tensor with evenly spaced values
fun tensor_arange(start, stop, step): any
    if step == nil then step = 1 end
    values = {}
    v = start
    while v < stop
        values[#values + 1] = v
        v += step
    end
    tensor_from(values)
end

-- Linspace: create tensor with n evenly spaced values
fun tensor_linspace(start, stop, n): any
    t = tensor_zeros(1, n)
    if n == 1 then
        t.data[1] = start
        return t
    end
    step = (stop - start) / (n - 1)
    for i = 1, n
        t.data[i] = start + (i - 1) * step
    end
    t
end

-- Fill: create tensor filled with a value
fun tensor_fill(rows, cols, value): any
    t = tensor_zeros(rows, cols)
    for i = 1, t.size
        t.data[i] = value
    end
    t
end

-- Copy: deep copy a tensor
fun tensor_copy(t): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        result.data[i] = t.data[i]
    end
    result
end

-- Flatten to 1D vector
fun tensor_flatten(t): any
    tensor_zeros(1, t.size)
    result = tensor_zeros(1, t.size)
    for i = 1, t.size
        result.data[i] = t.data[i]
    end
    result
end

-- Norm (L2)
fun tensor_norm(t): f64
    s = 0
    for i = 1, t.size
        s += t.data[i] * t.data[i]
    end
    math.sqrt(s)
end

-- Normalize (L2 normalize)
fun tensor_normalize(t): any
    n = tensor_norm(t)
    if n < 1e-10 then n = 1 end
    tensor_mul_scalar(t, 1.0 / n)
end

-- Cosine similarity between two vectors
fun tensor_cosine_similarity(a, b): f64
    dot = 0
    for i = 1, a.size
        dot += a.data[i] * b.data[i]
    end
    dot / (tensor_norm(a) * tensor_norm(b) + 1e-10)
end

-- Cross product (for 3D vectors)
fun tensor_cross(a, b): any
    assert(a.size == 3 and b.size == 3, "cross product requires 3D vectors")
    result = tensor_zeros(1, 3)
    result.data[1] = a.data[2] * b.data[3] - a.data[3] * b.data[2]
    result.data[2] = a.data[3] * b.data[1] - a.data[1] * b.data[3]
    result.data[3] = a.data[1] * b.data[2] - a.data[2] * b.data[1]
    result
end

-- Cumulative sum along axis (axis=1 for rows, axis=2 for cols)
fun tensor_cumsum(t, axis): any
    if axis == nil then axis = 1 end
    result = tensor_zeros(t.rows, t.cols)
    if axis == 1 then
        for c = 1, t.cols
            s = 0
            for r = 1, t.rows
                s += t.data[(r - 1) * t.cols + c]
                result.data[(r - 1) * t.cols + c] = s
            end
        end
    else
        for r = 1, t.rows
            s = 0
            for c = 1, t.cols
                s += t.data[(r - 1) * t.cols + c]
                result.data[(r - 1) * t.cols + c] = s
            end
        end
    end
    result
end

-- Sort (returns sorted 1D tensor)
fun tensor_sort(t): any
    values = {}
    for i = 1, t.size
        values[i] = t.data[i]
    end
    table.sort(values)
    result = tensor_zeros(1, t.size)
    for i = 1, t.size
        result.data[i] = values[i]
    end
    result
end

-- Unique values
fun tensor_unique(t): any
    seen = {}
    values = {}
    for i = 1, t.size
        v = t.data[i]
        if seen[v] == nil then
            seen[v] = true
            values[#values + 1] = v
        end
    end
    table.sort(values)
    result = tensor_zeros(1, #values)
    for i = 1, #values
        result.data[i] = values[i]
    end
    result
end

-- Where (conditional selection)
fun tensor_where(condition, x, y): any
    assert(condition.size == x.size and x.size == y.size, "where size mismatch")
    result = tensor_zeros(x.rows, x.cols)
    for i = 1, condition.size
        if condition.data[i] ~= 0 then
            result.data[i] = x.data[i]
        else
            result.data[i] = y.data[i]
        end
    end
    result
end

-- Any (returns true if any element is non-zero)
fun tensor_any(t): bool
    for i = 1, t.size
        if t.data[i] ~= 0 then return true end
    end
    false
end

-- All (returns true if all elements are non-zero)
fun tensor_all(t): bool
    for i = 1, t.size
        if t.data[i] == 0 then return false end
    end
    true
end

-- Count non-zero elements
fun tensor_nonzero_count(t): i64
    n = 0
    for i = 1, t.size
        if t.data[i] ~= 0 then n += 1 end
    end
    n
end

-- Clamp gradient (for autodiff)
fun tensor_clamp_grad(t, lo, hi): any
    result = tensor_zeros(t.rows, t.cols)
    for i = 1, t.size
        if t.data[i] >= lo and t.data[i] <= hi then
            result.data[i] = 1
        else
            result.data[i] = 0
        end
    end
    result
end

-- Dropout mask (returns mask tensor)
fun tensor_dropout_mask(rows, cols, rate): any
    mask = tensor_zeros(rows, cols)
    for i = 1, mask.size
        if math.random() > rate then
            mask.data[i] = 1.0 / (1.0 - rate)
        end
    end
    mask
end

-- Scaled dot-product attention (for transformer)
fun tensor_scaled_dot_attention(q, k, v): any
    dk = math.sqrt(k.cols)
    -- Attention scores: Q @ K^T / sqrt(dk)
    scores = tensor_matmul(q, tensor_transpose(k))
    scores = tensor_mul_scalar(scores, 1.0 / dk)
    -- Softmax
    attn = tensor_softmax(scores)
    -- Output: attention @ V
    tensor_matmul(attn, v)
end

-- Multi-head attention
fun tensor_multi_head_attention(q, k, v, heads): any
    assert(q.cols % heads == 0, "dim must be divisible by heads")
    head_dim = q.cols / heads

    -- Split into heads, apply attention to each, then concatenate
    head_outputs = {}
    h = 0
    while h < heads
        -- Extract head slices: columns [h*head_dim+1, (h+1)*head_dim]
        q_head = tensor_zeros(q.rows, head_dim)
        k_head = tensor_zeros(k.rows, head_dim)
        v_head = tensor_zeros(v.rows, head_dim)

        -- Copy columns for this head
        r = 0
        while r < q.rows
            c = 0
            while c < head_dim
                q_head.data[r * head_dim + c] = q.data[r * q.cols + h * head_dim + c]
                k_head.data[r * head_dim + c] = k.data[r * k.cols + h * head_dim + c]
                v_head.data[r * head_dim + c] = v.data[r * v.cols + h * head_dim + c]
                c += 1
            end
            r += 1
        end

        -- Apply attention for this head
        head_outputs[h + 1] = tensor_scaled_dot_attention(q_head, k_head, v_head)
        h += 1
    end

    -- Concatenate all head outputs
    result = tensor_zeros(q.rows, q.cols)
    h = 0
    while h < heads
        head = head_outputs[h + 1]
        r = 0
        while r < q.rows
            c = 0
            while c < head_dim
                result.data[r * q.cols + h * head_dim + c] = head.data[r * head_dim + c]
                c += 1
            end
            r += 1
        end
        h += 1
    end

    result
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Creation
M.zeros = tensor_zeros
M.ones = tensor_ones
M.from = tensor_from
M.rand = tensor_rand
M.fill = tensor_fill
M.eye = tensor_eye
M.diag = tensor_diag
M.arange = tensor_arange
M.linspace = tensor_linspace
-- Arithmetic
M.add = tensor_add
M.sub = tensor_sub
M.mul = tensor_mul
M.div = tensor_div
M.neg = tensor_neg
M.mul_scalar = tensor_mul_scalar
M.matmul = tensor_matmul
-- Statistics
M.sum = tensor_sum
M.mean = tensor_mean
M.var = tensor_var
M.std = tensor_std
M.max = tensor_max
M.min = tensor_min
M.argmax = tensor_argmax
M.argmin = tensor_argmin
-- Element-wise
M.relu = tensor_relu
M.softmax = tensor_softmax
M.log = tensor_log
M.exp = tensor_exp
M.sqrt = tensor_sqrt
M.abs = tensor_abs
M.clamp = tensor_clamp
-- Shape operations
M.get = tensor_get
M.set = tensor_set
M.shape = tensor_shape
M.transpose = tensor_transpose
M.reshape = tensor_reshape
M.slice = tensor_slice
M.vstack = tensor_vstack
M.hstack = tensor_hstack
M.flatten = tensor_flatten
M.copy = tensor_copy
-- Linear algebra
M.norm = tensor_norm
M.normalize = tensor_normalize
M.cosine_similarity = tensor_cosine_similarity
M.cross = tensor_cross
-- Aggregation
M.cumsum = tensor_cumsum
M.sort = tensor_sort
M.unique = tensor_unique
-- Selection
M.where = tensor_where
M.any = tensor_any
M.all = tensor_all
M.nonzero_count = tensor_nonzero_count
-- Broadcast
M.broadcast_add = tensor_broadcast_add
-- Gradient ops
M.clamp_grad = tensor_clamp_grad
M.dropout_mask = tensor_dropout_mask
-- Attention
M.scaled_dot_attention = tensor_scaled_dot_attention
M.multi_head_attention = tensor_multi_head_attention
M.tostring = tensor_tostring
M

