-- std.ml.vision — Image classification, data augmentation
-- For ward's vision model support and preprocessing pipeline.

-- ═══════════════════════════════════════════════════════════════
-- Image Utilities
-- ═══════════════════════════════════════════════════════════════

fun image_new(width: i64, height: i64, channels: i64): any
    {
        width = width,
        height = height,
        channels = channels,
        data = {},
        dtype = "u8",
    }
end

fun image_from_array(data: any, width: i64, height: i64, channels: i64): any
    {
        width = width,
        height = height,
        channels = channels,
        data = data,
        dtype = "u8",
    }
end

fun image_get_pixel(img: any, x: i64, y: i64): any
    idx = (y * img.width + x) * img.channels
    pixel = {}
    i = 0
    while i < img.channels
        pixel[#pixel + 1] = img.data[idx + i + 1]
        i += 1
    end
    pixel
end

fun image_set_pixel(img: any, x: i64, y: i64, pixel: any): void
    idx = (y * img.width + x) * img.channels
    i = 0
    while i < img.channels
        img.data[idx + i + 1] = pixel[i + 1]
        i += 1
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Image Transforms
-- ═══════════════════════════════════════════════════════════════

fun image_resize(img: any, new_width: i64, new_height: i64): any
    result = image_new(new_width, new_height, img.channels)
    x_scale = img.width / new_width
    y_scale = img.height / new_height

    y = 0
    while y < new_height
        x = 0
        while x < new_width
            src_x = math.floor(x * x_scale)
            src_y = math.floor(y * y_scale)
            src_x = math.min(src_x, img.width - 1)
            src_y = math.min(src_y, img.height - 1)

            pixel = image_get_pixel(img, src_x, src_y)
            image_set_pixel(result, x, y, pixel)
            x += 1
        end
        y += 1
    end
    result
end

fun image_crop(img: any, x: i64, y: i64, width: i64, height: i64): any
    result = image_new(width, height, img.channels)
    cy = 0
    while cy < height
        cx = 0
        while cx < width
            pixel = image_get_pixel(img, x + cx, y + cy)
            image_set_pixel(result, cx, cy, pixel)
            cx += 1
        end
        cy += 1
    end
    result
end

fun image_flip_h(img: any): any
    result = image_new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = image_get_pixel(img, img.width - 1 - x, y)
            image_set_pixel(result, x, y, pixel)
            x += 1
        end
        y += 1
    end
    result
end

fun image_flip_v(img: any): any
    result = image_new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = image_get_pixel(img, x, img.height - 1 - y)
            image_set_pixel(result, x, y, pixel)
            x += 1
        end
        y += 1
    end
    result
end

fun image_rotate90(img: any, clockwise: bool): any
    result = image_new(img.height, img.width, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            if clockwise then
                image_set_pixel(result, img.height - 1 - y, x, image_get_pixel(img, x, y))
            else
                image_set_pixel(result, y, img.width - 1 - x, image_get_pixel(img, x, y))
            end
            x += 1
        end
        y += 1
    end
    result
end

-- ═══════════════════════════════════════════════════════════════
-- Color Transforms
-- ═══════════════════════════════════════════════════════════════

fun image_grayscale(img: any): any
    if img.channels == 1 then return img end

    result = image_new(img.width, img.height, 1)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = image_get_pixel(img, x, y)
            gray = 0.299 * pixel[1] + 0.587 * pixel[2] + 0.114 * pixel[3]
            image_set_pixel(result, x, y, {math.floor(gray)})
            x += 1
        end
        y += 1
    end
    result
end

fun image_normalize(img: any, mean: any, std: any): any
    result = image_new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = image_get_pixel(img, x, y)
            norm_pixel = {}
            c = 0
            while c < img.channels
                norm_pixel[c + 1] = (pixel[c + 1] / 255.0 - mean[c + 1]) / std[c + 1]
                c += 1
            end
            image_set_pixel(result, x, y, norm_pixel)
            x += 1
        end
        y += 1
    end
    result
end

fun image_to_float(img: any): any
    result = image_new(img.width, img.height, img.channels)
    result.dtype = "f32"
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = image_get_pixel(img, x, y)
            float_pixel = {}
            c = 0
            while c < img.channels
                float_pixel[c + 1] = pixel[c + 1] / 255.0
                c += 1
            end
            image_set_pixel(result, x, y, float_pixel)
            x += 1
        end
        y += 1
    end
    result
end

-- ═══════════════════════════════════════════════════════════════
-- Data Augmentation
-- ═══════════════════════════════════════════════════════════════

fun augment_random_crop(img: any, crop_size: i64): any
    max_x = img.width - crop_size
    max_y = img.height - crop_size
    x = math.random(0, max_x)
    y = math.random(0, max_y)
    image_crop(img, x, y, crop_size, crop_size)
end

fun augment_random_flip(img: any, p: f64): any
    if math.random() < p then
        image_flip_h(img)
    else
        img
    end
end

fun augment_random_rotation(img: any, max_angle: f64): any
    -- Simple 90-degree rotations for now
    rotations = math.random(0, 3)
    result = img
    i = 0
    while i < rotations
        result = image_rotate90(result, true)
        i += 1
    end
    result
end

fun augment_color_jitter(img: any, brightness: f64, contrast: f64, saturation: f64): any
    result = image_new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = image_get_pixel(img, x, y)
            new_pixel = {}
            c = 0
            while c < img.channels
                val = pixel[c + 1] / 255.0

                -- Brightness
                val += (math.random() - 0.5) * brightness * 2
                -- Contrast
                val = (val - 0.5) * (1 + (math.random() - 0.5) * contrast * 2) + 0.5
                -- Saturation (simplified)
                if c > 0 and img.channels >= 3 then
                    gray = 0.299 * pixel[1] + 0.587 * pixel[2] + 0.114 * pixel[3]
                    gray /= 255.0
                    val = gray + (val - gray) * (1 + (math.random() - 0.5) * saturation * 2)
                end

                val = math.max(0, math.min(1, val))
                new_pixel[c + 1] = math.floor(val * 255)
                c += 1
            end
            image_set_pixel(result, x, y, new_pixel)
            x += 1
        end
        y += 1
    end
    result
end

fun augment_random_affine(img: any, translate_range: f64, scale_range: f64): any
    -- Simplified affine: just translate
    tx = math.floor((math.random() - 0.5) * translate_range * 2)
    ty = math.floor((math.random() - 0.5) * translate_range * 2)

    result = image_new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            src_x = x - tx
            src_y = y - ty
            if src_x >= 0 and src_x < img.width and src_y >= 0 and src_y < img.height then
                pixel = image_get_pixel(img, src_x, src_y)
                image_set_pixel(result, x, y, pixel)
            end
            x += 1
        end
        y += 1
    end
    result
end

-- ═══════════════════════════════════════════════════════════════
-- Classification Helpers
-- ═══════════════════════════════════════════════════════════════

fun classification_softmax(logits: any): any
    max_logit = -1e30
    for v in logits
        if v > max_logit then max_logit = v end
    end

    exp_sum = 0
    probs = {}
    for i = 1, #logits
        exp_val = math.exp(logits[i] - max_logit)
        probs[i] = exp_val
        exp_sum += exp_val
    end

    for i = 1, #probs
        probs[i] = probs[i] / exp_sum
    end
    probs
end

fun classification_top_k(probs: any, k: i64): any
    indexed = {}
    for i = 1, #probs
        indexed[#indexed + 1] = {index = i, prob = probs[i]}
    end

    -- Simple selection sort for top-k
    result = {}
    i = 1
    while i <= k and i <= #indexed
        max_idx = i
        j = i + 1
        while j <= #indexed
            if indexed[j].prob > indexed[max_idx].prob then
                max_idx = j
            end
            j += 1
        end
        result[#result + 1] = indexed[max_idx]
        indexed[max_idx] = indexed[i]
        i += 1
    end
    result
end

fun classification_accuracy(predictions: any, labels: any): f64
    correct = 0
    for i = 1, #predictions
        if predictions[i] == labels[i] then
            correct += 1
        end
    end
    correct / #predictions
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Image
M.new = image_new
M.from_array = image_from_array
M.get_pixel = image_get_pixel
M.set_pixel = image_set_pixel
-- Transforms
M.resize = image_resize
M.crop = image_crop
M.flip_h = image_flip_h
M.flip_v = image_flip_v
M.rotate90 = image_rotate90
-- Color
M.grayscale = image_grayscale
M.normalize = image_normalize
M.to_float = image_to_float
-- Augmentation
M.augment_random_crop = augment_random_crop
M.augment_random_flip = augment_random_flip
M.augment_random_rotation = augment_random_rotation
M.augment_color_jitter = augment_color_jitter
M.augment_random_affine = augment_random_affine
-- Classification
M.softmax = classification_softmax
M.top_k = classification_top_k
M.accuracy = classification_accuracy
M
