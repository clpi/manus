# std.ml.optim — Optimizers and learning rate schedulers

Tensor = tensor

# ═══════════════════════════════════════════════════════════════
# Optimizers
# ═══════════════════════════════════════════════════════════════

# SGD with optional momentum and weight decay
sgd(lr: f64, momentum: f64, weight_decay: f64): any
    if momentum == nil momentum = 0 end
    if weight_decay == nil weight_decay = 0 end
    {
        type = "sgd",
        lr = lr,
        momentum = momentum,
        weight_decay = weight_decay,
        velocities = {},
        step_count = 0,
    }
end

# Adam optimizer
adam(lr: f64, beta1: f64, beta2: f64, eps: f64, weight_decay: f64): any
    if beta1 == nil beta1 = 0.9 end
    if beta2 == nil beta2 = 0.999 end
    if eps == nil eps = 1e-8 end
    if weight_decay == nil weight_decay = 0 end
    {
        type = "adam",
        lr = lr,
        beta1 = beta1,
        beta2 = beta2,
        eps = eps,
        weight_decay = weight_decay,
        m = {},
        v = {},
        step_count = 0,
    }
end

# AdamW optimizer (decoupled weight decay)
adamw(lr: f64, beta1: f64, beta2: f64, eps: f64, weight_decay: f64): any
    if beta1 == nil beta1 = 0.9 end
    if beta2 == nil beta2 = 0.999 end
    if eps == nil eps = 1e-8 end
    if weight_decay == nil weight_decay = 0.01 end
    {
        type = "adamw",
        lr = lr,
        beta1 = beta1,
        beta2 = beta2,
        eps = eps,
        weight_decay = weight_decay,
        m = {},
        v = {},
        step_count = 0,
    }
end

# AdaGrad
adagrad(lr: f64, eps: f64, weight_decay: f64): any
    if eps == nil eps = 1e-8 end
    if weight_decay == nil weight_decay = 0 end
    {
        type = "adagrad",
        lr = lr,
        eps = eps,
        weight_decay = weight_decay,
        accum = {},
        step_count = 0,
    }
end

# RMSprop
rmsprop(lr: f64, alpha: f64, eps: f64, momentum: f64, weight_decay: f64): any
    if alpha == nil alpha = 0.99 end
    if eps == nil eps = 1e-8 end
    if momentum == nil momentum = 0 end
    if weight_decay == nil weight_decay = 0 end
    {
        type = "rmsprop",
        lr = lr,
        alpha = alpha,
        eps = eps,
        momentum = momentum,
        weight_decay = weight_decay,
        cache = {},
        velocity = {},
        step_count = 0,
    }
end

# LAMB (Layer-wise Adaptive Moments for Batch training)
lamb(lr: f64, beta1: f64, beta2: f64, eps: f64, weight_decay: f64): any
    if beta1 == nil beta1 = 0.9 end
    if beta2 == nil beta2 = 0.999 end
    if eps == nil eps = 1e-6 end
    if weight_decay == nil weight_decay = 0.01 end
    {
        type = "lamb",
        lr = lr,
        beta1 = beta1,
        beta2 = beta2,
        eps = eps,
        weight_decay = weight_decay,
        m = {},
        v = {},
        step_count = 0,
    }
end

# ═══════════════════════════════════════════════════════════════
# Optimizer step
# ═══════════════════════════════════════════════════════════════

@hot
optimizer_step(opt: any, params: any, grads: any): void
    opt.step_count = opt.step_count + 1

    if opt.type == "sgd"
        step_sgd(opt, params, grads)
    elseif opt.type == "adam"
        step_adam(opt, params, grads)
    elseif opt.type == "adamw"
        step_adamw(opt, params, grads)
    elseif opt.type == "adagrad"
        step_adagrad(opt, params, grads)
    elseif opt.type == "rmsprop"
        step_rmsprop(opt, params, grads)
    elseif opt.type == "lamb"
        step_lamb(opt, params, grads)
    end
end

step_sgd(opt: any, params: any, grads: any): void
    for i = 1, #params
        p = params[i]
        g = grads[i]
        key = p:to(str)

        if opt.momentum != 0
            if opt.velocities[key] == nil
                opt.velocities[key] = Tensor.zeros(p.rows, p.cols)
            end
            v = opt.velocities[key]
            for j = 1, p.size
                v.data[j] = opt.momentum * v.data[j] + g.data[j]
                p.data[j] = p.data[j] - opt.lr * v.data[j]
            end
        else
            for j = 1, p.size
                p.data[j] = p.data[j] - opt.lr * g.data[j]
            end
        end
    end
end

@hot
step_adam(opt: any, params: any, grads: any): void
    bc1 = 1 - opt.beta1:pow(opt.step_count)
    bc2 = 1 - opt.beta2:pow(opt.step_count)

    for i = 1, #params
        p = params[i]
        g = grads[i]
        key = p:to(str)

        if opt.m[key] == nil
            opt.m[key] = Tensor.zeros(p.rows, p.cols)
            opt.v[key] = Tensor.zeros(p.rows, p.cols)
        end
        m = opt.m[key]
        v = opt.v[key]

        for j = 1, p.size
            m.data[j] = opt.beta1 * m.data[j] + (1 - opt.beta1) * g.data[j]
            v.data[j] = opt.beta2 * v.data[j] + (1 - opt.beta2) * g.data[j] * g.data[j]
            m_hat = m.data[j] / bc1
            v_hat = v.data[j] / bc2
            p.data[j] = p.data[j] - opt.lr * m_hat / (v_hat:sqrt() + opt.eps)
        end
    end
end

@hot
step_adamw(opt: any, params: any, grads: any): void
    bc1 = 1 - opt.beta1:pow(opt.step_count)
    bc2 = 1 - opt.beta2:pow(opt.step_count)

    for i = 1, #params
        p = params[i]
        g = grads[i]
        key = p:to(str)

        if opt.m[key] == nil
            opt.m[key] = Tensor.zeros(p.rows, p.cols)
            opt.v[key] = Tensor.zeros(p.rows, p.cols)
        end
        m = opt.m[key]
        v = opt.v[key]

        for j = 1, p.size
            # Decoupled weight decay
            p.data[j] = p.data[j] * (1 - opt.lr * opt.weight_decay)
            m.data[j] = opt.beta1 * m.data[j] + (1 - opt.beta1) * g.data[j]
            v.data[j] = opt.beta2 * v.data[j] + (1 - opt.beta2) * g.data[j] * g.data[j]
            m_hat = m.data[j] / bc1
            v_hat = v.data[j] / bc2
            p.data[j] = p.data[j] - opt.lr * m_hat / (v_hat:sqrt() + opt.eps)
        end
    end
end

step_adagrad(opt: any, params: any, grads: any): void
    for i = 1, #params
        p = params[i]
        g = grads[i]
        key = p:to(str)

        if opt.accum[key] == nil
            opt.accum[key] = Tensor.zeros(p.rows, p.cols)
        end
        acc = opt.accum[key]

        for j = 1, p.size
            acc.data[j] = acc.data[j] + g.data[j] * g.data[j]
            p.data[j] = p.data[j] - opt.lr * g.data[j] / (acc.data[j]:sqrt() + opt.eps)
        end
    end
end

step_rmsprop(opt: any, params: any, grads: any): void
    for i = 1, #params
        p = params[i]
        g = grads[i]
        key = p:to(str)

        if opt.cache[key] == nil
            opt.cache[key] = Tensor.zeros(p.rows, p.cols)
            opt.velocity[key] = Tensor.zeros(p.rows, p.cols)
        end
        cache = opt.cache[key]
        vel = opt.velocity[key]

        for j = 1, p.size
            cache.data[j] = opt.alpha * cache.data[j] + (1 - opt.alpha) * g.data[j] * g.data[j]
            vel.data[j] = opt.momentum * vel.data[j] + opt.lr * g.data[j] / (cache.data[j]:sqrt() + opt.eps)
            p.data[j] = p.data[j] - vel.data[j]
        end
    end
end

step_lamb(opt: any, params: any, grads: any): void
    bc1 = 1 - opt.beta1:pow(opt.step_count)
    bc2 = 1 - opt.beta2:pow(opt.step_count)

    for i = 1, #params
        p = params[i]
        g = grads[i]
        key = p:to(str)

        if opt.m[key] == nil
            opt.m[key] = Tensor.zeros(p.rows, p.cols)
            opt.v[key] = Tensor.zeros(p.rows, p.cols)
        end
        m = opt.m[key]
        v = opt.v[key]

        # Adam update
        for j = 1, p.size
            m.data[j] = opt.beta1 * m.data[j] + (1 - opt.beta1) * g.data[j]
            v.data[j] = opt.beta2 * v.data[j] + (1 - opt.beta2) * g.data[j] * g.data[j]
        end

        # Compute trust ratio
        weight_norm = 0
        for j = 1, p.size
            weight_norm += p.data[j] * p.data[j]
        end
        weight_norm = weight_norm:sqrt()

        update_norm = 0
        for j = 1, p.size
            m_hat = m.data[j] / bc1
            v_hat = v.data[j] / bc2
            update = m_hat / (v_hat:sqrt() + opt.eps) + opt.weight_decay * p.data[j]
            update_norm += update * update
        end
        update_norm = update_norm:sqrt()

        ratio = weight_norm / (update_norm + opt.eps)

        for j = 1, p.size
            m_hat = m.data[j] / bc1
            v_hat = v.data[j] / bc2
            p.data[j] = p.data[j] - opt.lr * ratio * (m_hat / (v_hat:sqrt() + opt.eps) + opt.weight_decay * p.data[j])
        end
    end
end

# ═══════════════════════════════════════════════════════════════
# Learning Rate Schedulers
# ═══════════════════════════════════════════════════════════════

# Step decay: multiply lr by gamma every step_size epochs
step_scheduler(initial_lr: f64, step_size: i64, gamma: f64): any
    {
        type = "step",
        initial_lr = initial_lr,
        step_size = step_size,
        gamma = gamma,
        last_epoch = 0,
    }
end

# Exponential decay: lr = initial_lr * gamma^epoch
exponential_scheduler(initial_lr: f64, gamma: f64): any
    {
        type = "exponential",
        initial_lr = initial_lr,
        gamma = gamma,
        last_epoch = 0,
    }
end

# Cosine annealing
cosine_scheduler(initial_lr: f64, T_max: i64, eta_min: f64): any
    if eta_min == nil eta_min = 0 end
    {
        type = "cosine",
        initial_lr = initial_lr,
        T_max = T_max,
        eta_min = eta_min,
        last_epoch = 0,
    }
end

# Warmup + cosine decay (used in transformer training)
warmup_cosine(warmup_steps: i64, total_steps: i64, peak_lr: f64, min_lr: f64): any
    if min_lr == nil min_lr = 0 end
    {
        type = "warmup_cosine",
        warmup_steps = warmup_steps,
        total_steps = total_steps,
        peak_lr = peak_lr,
        min_lr = min_lr,
        step = 0,
    }
end

# Linear warmup then constant
warmup_constant(warmup_steps: i64, peak_lr: f64): any
    {
        type = "warmup_constant",
        warmup_steps = warmup_steps,
        peak_lr = peak_lr,
        step = 0,
    }
end

# One cycle policy (super-convergence)
one_cycle(max_lr: f64, total_steps: i64, pct_start: f64): any
    if pct_start == nil pct_start = 0.3 end
    {
        type = "one_cycle",
        max_lr = max_lr,
        total_steps = total_steps,
        pct_start = pct_start,
        step = 0,
    }
end

# Get current learning rate
scheduler_get_lr(scheduler: any): f64
    scheduler.step = scheduler.step + 1
    step = scheduler.step

    if scheduler.type == "step"
        epochs = step / scheduler.step_size:floor()
        return scheduler.initial_lr * scheduler.gamma:pow(epochs)

    elseif scheduler.type == "exponential"
        return scheduler.initial_lr * scheduler.gamma:pow(step)

    elseif scheduler.type == "cosine"
        t = step / scheduler.T_max
        return scheduler.eta_min + 0.5 * (scheduler.initial_lr - scheduler.eta_min) * (1 + math.pi * t:cos())

    elseif scheduler.type == "warmup_cosine"
        if step < scheduler.warmup_steps
            return scheduler.peak_lr * step / scheduler.warmup_steps
        end
        progress = (step - scheduler.warmup_steps) / (scheduler.total_steps - scheduler.warmup_steps)
        return scheduler.min_lr + 0.5 * (scheduler.peak_lr - scheduler.min_lr) * (1 + math.pi * progress:cos())

    elseif scheduler.type == "warmup_constant"
        if step < scheduler.warmup_steps
            return scheduler.peak_lr * step / scheduler.warmup_steps
        end
        return scheduler.peak_lr

    elseif scheduler.type == "one_cycle"
        div = scheduler.total_steps * scheduler.pct_start
        if step <= div
            return scheduler.max_lr * step / div
        end
        progress = (step - div) / (scheduler.total_steps - div)
        return scheduler.max_lr * 0.5 * (1 + math.pi * progress:cos())
    end

    scheduler.initial_lr
end

# ═══════════════════════════════════════════════════════════════
# Gradient clipping
# ═══════════════════════════════════════════════════════════════

clip_grad_norm(params: any, grads: any, max_norm: f64): f64
    total_norm = 0
    for i = 1, #params
        g = grads[i]
        for j = 1, g.size
            total_norm += g.data[j] * g.data[j]
        end
    end
    total_norm = total_norm:sqrt()

    if total_norm > max_norm
        scale = max_norm / total_norm
        for i = 1, #params
            g = grads[i]
            for j = 1, g.size
                g.data[j] = g.data[j] * scale
            end
        end
    end

    total_norm
end

clip_grad_value(grads: any, max_value: f64): void
    for i = 1, #grads
        g = grads[i]
        for j = 1, g.size
            if g.data[j] > max_value
                g.data[j] = max_value
            elseif g.data[j] < -max_value
                g.data[j] = -max_value
            end
        end
    end
end

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

M = {}
# Optimizers
M.sgd = sgd
M.adam = adam
M.adamw = adamw
M.adagrad = adagrad
M.rmsprop = rmsprop
M.lamb = lamb
M.step = optimizer_step
# Schedulers
M.step_scheduler = step_scheduler
M.exponential_scheduler = exponential_scheduler
M.cosine_scheduler = cosine_scheduler
M.warmup_cosine = warmup_cosine
M.warmup_constant = warmup_constant
M.one_cycle = one_cycle
M.get_lr = scheduler_get_lr
# Gradient ops
M.clip_grad_norm = clip_grad_norm
M.clip_grad_value = clip_grad_value
M
