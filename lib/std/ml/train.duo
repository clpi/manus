-- std.ml.train — Training loop helpers (forward / loss / backward / step)

sgd_step(model, optimizer, lr): any
    if lr == nil lr = optimizer.lr end
    for i = 1, model.n_layers
        layer = model.layers[i]
        if layer.type == "linear" and layer.grad_weight != nil
            for j = 1, layer.weight.size
                layer.weight.data[j] = layer.weight.data[j] -
                    lr * layer.grad_weight.data[j]
            end
            for j = 1, layer.bias.size
                layer.bias.data[j] = layer.bias.data[j] -
                    lr * layer.grad_bias.data[j]
            end
        end
    end
    return model
end

-- One supervised step with cross-entropy on softmax output
@profile
train_step(model, x, target, lr): f64
    if lr == nil lr = 0.01 end
    tape = std.ml.autodiff.tape_new()
    pred = std.ml.nn.forward(model, x)
    loss = std.ml.nn.cross_entropy(pred, target)
    -- Backward pass: compute gradients via autodiff tape
    grad = std.ml.autodiff.backward(tape, loss)
    return loss
end

-- Epoch over a list of { x, y } batches
fit(model, batches, epochs, lr): any
    if epochs == nil epochs = 1 end
    for e = 1, epochs
        total = 0.0
        for i = 1, #batches
            b = batches[i]
            total += train_step(model, b.x, b.y, lr)
        end
        print(string.format("epoch %d loss %.4f", e, total / #batches))
    end
    return model
end

