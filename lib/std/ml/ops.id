# std.ml.ops — High-level ML ops; hot paths delegate to ml.* intrinsics

# Native kernels (zero-arg checksum benchmarks / fused paths)
bench_matmul(): f64
    return ml.matmul_256()
end

bench_conv2d(): f64
    return ml.conv2d()
end

bench_softmax(): f64
    return ml.softmax_1k()
end

bench_attention(): f64
    return ml.attention()
end

bench_mlp(): f64
    return ml.mlp_forward()
end

bench_gelu(): f64
    return ml.gelu_1k()
end

bench_layernorm(): f64
    return ml.layernorm_1k()
end

bench_dot(): f64
    return ml.dot_1m()
end

bench_conv1d(): f64
    return ml.conv1d()
end

# User-facing tensor ops (stdlib path; compiler may fuse later)
@hot
matmul(a, b): any
    return std.ml.tensor.matmul(a, b)
end

@hot
softmax(t): any
    return std.ml.tensor.softmax(t)
end

gelu(t): any
    result = std.ml.tensor.zeros(t.rows, t.cols)
    for i = 1, t.size
        v = t.data[i]
        inner = 0.044715 * v * v * v + v
        result.data[i] = 0.5 * v * (1.0 + math.tanh(0.7978845608 * inner))
    end
    return result
end

layernorm(t, eps): any
    if eps == nil eps = 1e-5 end
    n = t.size
    mean = 0.0
    for i = 1, n mean += t.data[i] end
    mean /= n
    var = 0.0
    for i = 1, n
        d = t.data[i] - mean
        var += d * d
    end
    inv_std = 1.0 / var / n + eps:sqrt()
    result = std.ml.tensor.zeros(t.rows, t.cols)
    for i = 1, n
        result.data[i] = (t.data[i] - mean) * inv_std
    end
    return result
end

dot(a, b): f64
    assert(a.size == b.size, "dot size mismatch")
    sum = 0.0
    for i = 1, a.size
        sum += a.data[i] * b.data[i]
    end
    return sum
end

