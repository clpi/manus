# std.ml.vision — Image classification, data augmentation
# For ward's vision model support and preprocessing pipeline.

# ═══════════════════════════════════════════════════════════════
# Image Utilities
# ═══════════════════════════════════════════════════════════════

new(width: i64, height: i64, channels: i64): any
    {
        width = width,
        height = height,
        channels = channels,
        data = {},
        dtype = "u8",
    }
end

from_array(data: any, width: i64, height: i64, channels: i64): any
    {
        width = width,
        height = height,
        channels = channels,
        data = data,
        dtype = "u8",
    }
end

get_pixel(img: any, x: i64, y: i64): any
    idx = (y * img.width + x) * img.channels
    pixel = {}
    i = 0
    while i < img.channels
        pixel[#pixel + 1] = img.data[idx + i + 1]
        i += 1
    end
    pixel
end

set_pixel(img: any, x: i64, y: i64, pixel: any): void
    idx = (y * img.width + x) * img.channels
    i = 0
    while i < img.channels
        img.data[idx + i + 1] = pixel[i + 1]
        i += 1
    end
end

# ═══════════════════════════════════════════════════════════════
# Image Transforms
# ═══════════════════════════════════════════════════════════════

reimg: any, new_width: i64, new_height: i64:len(): any
    result = new(new_width, new_height, img.channels)
    x_scale = img.width / new_width
    y_scale = img.height / new_height

    y = 0
    while y < new_height
        x = 0
        while x < new_width
            src_x = x * x_scale:floor()
            src_y = y * y_scale:floor()
            src_x = src_x:min(img.width - 1)
            src_y = src_y:min(img.height - 1)

            pixel = get_pixel(img, src_x, src_y)
            set_pixel(result, x, y, pixel)
            x += 1
        end
        y += 1
    end
    result
end

crop(img: any, x: i64, y: i64, width: i64, height: i64): any
    result = new(width, height, img.channels)
    cy = 0
    while cy < height
        cx = 0
        while cx < width
            pixel = get_pixel(img, x + cx, y + cy)
            set_pixel(result, cx, cy, pixel)
            cx += 1
        end
        cy += 1
    end
    result
end

flip_h(img: any): any
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, img.width - 1 - x, y)
            set_pixel(result, x, y, pixel)
            x += 1
        end
        y += 1
    end
    result
end

flip_v(img: any): any
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, img.height - 1 - y)
            set_pixel(result, x, y, pixel)
            x += 1
        end
        y += 1
    end
    result
end

rotate90(img: any, clockwise: bool): any
    result = new(img.height, img.width, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            if clockwise
                set_pixel(result, img.height - 1 - y, x, get_pixel(img, x, y))
            else
                set_pixel(result, y, img.width - 1 - x, get_pixel(img, x, y))
            end
            x += 1
        end
        y += 1
    end
    result
end

# ═══════════════════════════════════════════════════════════════
# Color Transforms
# ═══════════════════════════════════════════════════════════════

grayscale(img: any): any
    if img.channels == 1 return img end

    result = new(img.width, img.height, 1)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            gray = 0.299 * pixel[1] + 0.587 * pixel[2] + 0.114 * pixel[3]
            set_pixel(result, x, y, {gray:floor()})
            x += 1
        end
        y += 1
    end
    result
end

normalize(img: any, mean: any, std: any): any
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            norm_pixel = {}
            c = 0
            while c < img.channels
                norm_pixel[c + 1] = (pixel[c + 1] / 255.0 - mean[c + 1]) / std[c + 1]
                c += 1
            end
            set_pixel(result, x, y, norm_pixel)
            x += 1
        end
        y += 1
    end
    result
end

to_float(img: any): any
    result = new(img.width, img.height, img.channels)
    result.dtype = "f32"
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            float_pixel = {}
            c = 0
            while c < img.channels
                float_pixel[c + 1] = pixel[c + 1] / 255.0
                c += 1
            end
            set_pixel(result, x, y, float_pixel)
            x += 1
        end
        y += 1
    end
    result
end

# ═══════════════════════════════════════════════════════════════
# Data Augmentation
# ═══════════════════════════════════════════════════════════════

augment_random_crop(img: any, crop_size: i64): any
    max_x = img.width - crop_size
    max_y = img.height - crop_size
    x = 0:random(max_x)
    y = 0:random(max_y)
    crop(img, x, y, crop_size, crop_size)
end

augment_random_flip(img: any, p: f64): any
    if math.random() < p
        flip_h(img)
    else
        img
    end
end

augment_random_rotation(img: any, max_angle: f64): any
    # Simple 90-degree rotations for now
    rotations = 0:random(3)
    result = img
    i = 0
    while i < rotations
        result = rotate90(result, true)
        i += 1
    end
    result
end

augment_color_jitter(img: any, brightness: f64, contrast: f64, saturation: f64): any
    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            pixel = get_pixel(img, x, y)
            new_pixel = {}
            c = 0
            while c < img.channels
                val = pixel[c + 1] / 255.0

                # Brightness
                val += (math.random() - 0.5) * brightness * 2
                # Contrast
                val = (val - 0.5) * (1 + (math.random() - 0.5) * contrast * 2) + 0.5
                # Saturation (simplified)
                if c > 0 and img.channels >= 3
                    gray = 0.299 * pixel[1] + 0.587 * pixel[2] + 0.114 * pixel[3]
                    gray /= 255.0
                    val = gray + (val - gray) * (1 + (math.random() - 0.5) * saturation * 2)
                end

                val = 0:max(1:min(val))
                new_pixel[c + 1] = val * 255:floor()
                c += 1
            end
            set_pixel(result, x, y, new_pixel)
            x += 1
        end
        y += 1
    end
    result
end

augment_random_affine(img: any, translate_range: f64, scale_range: f64): any
    # Simplified affine: just translate
    tx = (math.random() - 0.5) * translate_range * 2:floor()
    ty = (math.random() - 0.5) * translate_range * 2:floor()

    result = new(img.width, img.height, img.channels)
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            src_x = x - tx
            src_y = y - ty
            if src_x >= 0 and src_x < img.width and src_y >= 0 and src_y < img.height
                pixel = get_pixel(img, src_x, src_y)
                set_pixel(result, x, y, pixel)
            end
            x += 1
        end
        y += 1
    end
    result
end

# ═══════════════════════════════════════════════════════════════
# Classification Helpers
# ═══════════════════════════════════════════════════════════════

softmax(logits: any): any
    max_logit = -1e30
    for v in logits
        if v > max_logit max_logit = v end
    end

    exp_sum = 0
    probs = {}
    for i = 1, #logits
        exp_val = logits[i] - max_logit:exp()
        probs[i] = exp_val
        exp_sum += exp_val
    end

    for i = 1, #probs
        probs[i] = probs[i] / exp_sum
    end
    probs
end

top_k(probs: any, k: i64): any
    indexed = {}
    for i = 1, #probs
        indexed[#indexed + 1] = {index = i, prob = probs[i]}
    end

    # Simple selection sort for top-k
    result = {}
    i = 1
    while i <= k and i <= #indexed
        max_idx = i
        j = i + 1
        while j <= #indexed
            if indexed[j].prob > indexed[max_idx].prob
                max_idx = j
            end
            j += 1
        end
        result[#result + 1] = indexed[max_idx]
        indexed[max_idx] = indexed[i]
        i += 1
    end
    result
end

accuracy(predictions: any, labels: any): f64
    correct = 0
    for i = 1, #predictions
        if predictions[i] == labels[i]
            correct += 1
        end
    end
    correct / #predictions
end

