# std.ml.shape — Compile-time-friendly shape helpers (const dims + runtime checks)
#
# `Tensor[M,N,T]` types are resolved in the compiler; use these helpers for runtime bundles and asserts.

assert_matmul(a_rows: any, a_cols: any, b_rows: any, b_cols: any)
    assert(a_cols == b_rows, string.format(
        "matmul shape mismatch: (%d,%d) @ (%d,%d)", a_rows, a_cols, b_rows, b_cols))
end

assert_broadcast(a_rows: any, a_cols: any, b_rows: any, b_cols: any)
    ok = (a_rows == b_rows and a_cols == b_cols) or
         (a_rows == 1 and a_cols == b_cols) or
         (a_rows == b_rows and a_cols == 1) or
         (a_rows == 1 and b_cols == 1)
    assert(ok, "broadcast incompatible shapes")
end

numel(rows, cols): i64
    return rows * cols
end

# MNIST-style MLP shape bundle
mnist_mlp(): any
    return {
        input = { rows = 784, cols = 1 },
        hidden1 = { rows = 256, cols = 1 },
        hidden2 = { rows = 128, cols = 1 },
        output = { rows = 10, cols = 1 },
    }
end

# Transformer block shape template (batch, seq, dim)
transformer_block(heads, dim): any
    return {
        heads = heads,
        dim = dim,
        head_dim = dim / heads,
        ffn_dim = dim * 4,
    }
end

