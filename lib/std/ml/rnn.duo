-- std.ml.rnn — Recurrent neural network layers (SimpleRNN, GRU, LSTM)
-- For sequence modeling tasks: time series, speech, NLP.

Tensor = req "std.ml.tensor"

-- ═══════════════════════════════════════════════════════════════
-- Simple RNN
-- ═══════════════════════════════════════════════════════════════

simple_rnn(input_size: i64, hidden_size: i64, activation: str): any
    if activation == nil activation = "tanh" end
    scale = 1.0 / math.sqrt(hidden_size)
    {
        type = "simple_rnn",
        input_size = input_size,
        hidden_size = hidden_size,
        activation = activation,
        w_ih = Tensor.zeros(input_size, hidden_size),
        w_hh = Tensor.zeros(hidden_size, hidden_size),
        b_ih = Tensor.zeros(1, hidden_size),
        b_hh = Tensor.zeros(1, hidden_size),
        state = nil,
    }
end

@hot
simple_rnn_forward(layer: any, x: any, state: any): any
    -- x: [seq_len, input_size]
    seq_len = x.rows
    h = state or Tensor.zeros(1, layer.hidden_size)
    outputs = Tensor.zeros(seq_len, layer.hidden_size)

    for t = 1, seq_len
        -- h = activation(x_t @ W_ih + b_ih + h_{t-1} @ W_hh + b_hh)
        input_gate = Tensor.zeros(1, layer.hidden_size)
        for j = 1, layer.hidden_size
            s = layer.b_ih.data[j] + layer.b_hh.data[j]
            for k = 1, layer.input_size
                s += x.data[(t-1)*layer.input_size + k] * layer.w_ih.data[(k-1)*layer.hidden_size + j]
            end
            for k = 1, layer.hidden_size
                s += h.data[(k-1)] * layer.w_hh.data[(k-1)*layer.hidden_size + j]
            end
            if layer.activation == "tanh"
                input_gate.data[j] = math.tanh(s)
            elseif layer.activation == "relu"
                input_gate.data[j] = math.max(0, s)
            else
                input_gate.data[j] = math.tanh(s)
            end
        end
        h = input_gate
        for j = 1, layer.hidden_size
            outputs.data[(t-1)*layer.hidden_size + j] = h.data[j]
        end
    end
    layer.state = h
    outputs
end

-- ═══════════════════════════════════════════════════════════════
-- GRU (Gated Recurrent Unit)
-- ═══════════════════════════════════════════════════════════════

gru(input_size: i64, hidden_size: i64): any
    scale = 1.0 / math.sqrt(hidden_size)
    {
        type = "gru",
        input_size = input_size,
        hidden_size = hidden_size,
        -- Update gate: W_z, U_z, b_z
        w_iz = Tensor.zeros(input_size, hidden_size),
        w_hz = Tensor.zeros(hidden_size, hidden_size),
        b_iz = Tensor.zeros(1, hidden_size),
        b_hz = Tensor.zeros(1, hidden_size),
        -- Reset gate: W_r, U_r, b_r
        w_ir = Tensor.zeros(input_size, hidden_size),
        w_hr = Tensor.zeros(hidden_size, hidden_size),
        b_ir = Tensor.zeros(1, hidden_size),
        b_hr = Tensor.zeros(1, hidden_size),
        -- New gate: W_n, U_n, b_n
        w_in = Tensor.zeros(input_size, hidden_size),
        w_hn = Tensor.zeros(hidden_size, hidden_size),
        b_in = Tensor.zeros(1, hidden_size),
        b_hn = Tensor.zeros(1, hidden_size),
        state = nil,
    }
end

@hot
gru_forward(layer: any, x: any, state: any): any
    seq_len = x.rows
    h = state or Tensor.zeros(1, layer.hidden_size)
    outputs = Tensor.zeros(seq_len, layer.hidden_size)

    for t = 1, seq_len
        z = sigmoid_vec(gru_gate(x, t, h, layer.w_iz, layer.w_hz, layer.b_iz, layer.b_hz, layer.input_size, layer.hidden_size))
        r = sigmoid_vec(gru_gate(x, t, h, layer.w_ir, layer.w_hr, layer.b_ir, layer.b_hr, layer.input_size, layer.hidden_size))

        -- New gate: tanh(W_in * x + U_in * (r * h) + b_in + b_hn)
        h_candidate = Tensor.zeros(1, layer.hidden_size)
        for j = 1, layer.hidden_size
            s = layer.b_in.data[j] + layer.b_hn.data[j]
            for k = 1, layer.input_size
                s += x.data[(t-1)*layer.input_size + k] * layer.w_in.data[(k-1)*layer.hidden_size + j]
            end
            for k = 1, layer.hidden_size
                s += r.data[k] * h.data[k] * layer.w_hn.data[(k-1)*layer.hidden_size + j]
            end
            h_candidate.data[j] = math.tanh(s)
        end

        -- h = (1 - z) * h_candidate + z * h
        for j = 1, layer.hidden_size
            h.data[j] = (1 - z.data[j]) * h_candidate.data[j] + z.data[j] * h.data[j]
            outputs.data[(t-1)*layer.hidden_size + j] = h.data[j]
        end
    end
    layer.state = h
    outputs
end

gru_gate(x: any, t: i64, h: any, w_i: any, w_h: any, b_i: any, b_h: any, input_size: i64, hidden_size: i64): any
    result = Tensor.zeros(1, hidden_size)
    for j = 1, hidden_size
        s = b_i.data[j] + b_h.data[j]
        for k = 1, input_size
            s += x.data[(t-1)*input_size + k] * w_i.data[(k-1)*hidden_size + j]
        end
        for k = 1, hidden_size
            s += h.data[k] * w_h.data[(k-1)*hidden_size + j]
        end
        result.data[j] = s
    end
    result
end

sigmoid_vec(v: any): any
    result = Tensor.zeros(v.rows, v.cols)
    for i = 1, v.size
        result.data[i] = 1.0 / (1.0 + math.exp(-v.data[i]))
    end
    result
end

-- ═══════════════════════════════════════════════════════════════
-- LSTM (Long Short-Term Memory)
-- ═══════════════════════════════════════════════════════════════

lstm(input_size: i64, hidden_size: i64): any
    scale = 1.0 / math.sqrt(hidden_size)
    {
        type = "lstm",
        input_size = input_size,
        hidden_size = hidden_size,
        -- Input gate
        w_ii = Tensor.zeros(input_size, hidden_size),
        w_hi = Tensor.zeros(hidden_size, hidden_size),
        b_ii = Tensor.zeros(1, hidden_size),
        b_hi = Tensor.zeros(1, hidden_size),
        -- Forget gate
        w_if = Tensor.zeros(input_size, hidden_size),
        w_hf = Tensor.zeros(hidden_size, hidden_size),
        b_if = Tensor.zeros(1, hidden_size),
        b_hf = Tensor.zeros(1, hidden_size),
        -- Cell gate
        w_ic = Tensor.zeros(input_size, hidden_size),
        w_hc = Tensor.zeros(hidden_size, hidden_size),
        b_ic = Tensor.zeros(1, hidden_size),
        b_hc = Tensor.zeros(1, hidden_size),
        -- Output gate
        w_io = Tensor.zeros(input_size, hidden_size),
        w_ho = Tensor.zeros(hidden_size, hidden_size),
        b_io = Tensor.zeros(1, hidden_size),
        b_ho = Tensor.zeros(1, hidden_size),
        state = nil,
        cell = nil,
    }
end

@hot
lstm_forward(layer: any, x: any, state: any, cell: any): any
    seq_len = x.rows
    h = state or Tensor.zeros(1, layer.hidden_size)
    c = cell or Tensor.zeros(1, layer.hidden_size)
    outputs = Tensor.zeros(seq_len, layer.hidden_size)

    for t = 1, seq_len
        -- Input gate
        i_gate = sigmoid_vec(lstm_gate(x, t, h, layer.w_ii, layer.w_hi, layer.b_ii, layer.b_hi, layer.input_size, layer.hidden_size))
        -- Forget gate
        f_gate = sigmoid_vec(lstm_gate(x, t, h, layer.w_if, layer.w_hf, layer.b_if, layer.b_hf, layer.input_size, layer.hidden_size))
        -- Cell gate (candidate)
        c_gate = Tensor.zeros(1, layer.hidden_size)
        for j = 1, layer.hidden_size
            s = layer.b_ic.data[j] + layer.b_hc.data[j]
            for k = 1, layer.input_size
                s += x.data[(t-1)*layer.input_size + k] * layer.w_ic.data[(k-1)*layer.hidden_size + j]
            end
            for k = 1, layer.hidden_size
                s += h.data[k] * layer.w_hc.data[(k-1)*layer.hidden_size + j]
            end
            c_gate.data[j] = math.tanh(s)
        end
        -- Output gate
        o_gate = sigmoid_vec(lstm_gate(x, t, h, layer.w_io, layer.w_ho, layer.b_io, layer.b_ho, layer.input_size, layer.hidden_size))

        -- Update cell state: c = f * c + i * c_gate
        for j = 1, layer.hidden_size
            c.data[j] = f_gate.data[j] * c.data[j] + i_gate.data[j] * c_gate.data[j]
        end

        -- Update hidden state: h = o * tanh(c)
        for j = 1, layer.hidden_size
            h.data[j] = o_gate.data[j] * math.tanh(c.data[j])
            outputs.data[(t-1)*layer.hidden_size + j] = h.data[j]
        end
    end
    layer.state = h
    layer.cell = c
    outputs
end

lstm_gate(x: any, t: i64, h: any, w_i: any, w_h: any, b_i: any, b_h: any, input_size: i64, hidden_size: i64): any
    result = Tensor.zeros(1, hidden_size)
    for j = 1, hidden_size
        s = b_i.data[j] + b_h.data[j]
        for k = 1, input_size
            s += x.data[(t-1)*input_size + k] * w_i.data[(k-1)*hidden_size + j]
        end
        for k = 1, hidden_size
            s += h.data[k] * w_h.data[(k-1)*hidden_size + j]
        end
        result.data[j] = s
    end
    result
end

-- ═══════════════════════════════════════════════════════════════
-- Bidirectional RNN
-- ═══════════════════════════════════════════════════════════════

bidirectional(rnn_layer: any): any
    {
        type = "bidirectional",
        forward = rnn_layer,
        backward = rnn_layer,  -- separate weights needed in practice
        hidden_size = rnn_layer.hidden_size,
        output_size = rnn_layer.hidden_size * 2,
    }
end

bidirectional_forward(layer: any, x: any): any
    -- Forward pass
    fwd = simple_rnn_forward(layer.forward, x, nil)
    -- Backward pass (reverse input)
    seq_len = x.rows
    rev = Tensor.zeros(seq_len, x.cols)
    for t = 1, seq_len
        for j = 1, x.cols
            rev.data[(t-1)*x.cols + j] = x.data[(seq_len-t)*x.cols + j]
        end
    end
    bwd = simple_rnn_forward(layer.backward, rev, nil)
    -- Reverse bwd to align with fwd
    bwd_rev = Tensor.zeros(seq_len, bwd.cols)
    for t = 1, seq_len
        for j = 1, bwd.cols
            bwd_rev.data[(t-1)*bwd.cols + j] = bwd.data[(seq_len-t)*bwd.cols + j]
        end
    end
    -- Concatenate
    Tensor.hstack({fwd, bwd_rev})
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
M.simple_rnn = simple_rnn
M.simple_rnn_forward = simple_rnn_forward
M.gru = gru
M.gru_forward = gru_forward
M.lstm = lstm
M.lstm_forward = lstm_forward
M.bidirectional = bidirectional
M.bidirectional_forward = bidirectional_forward
M.sigmoid_vec = sigmoid_vec
M
