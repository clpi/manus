-- std.datetime — date and time parsing, formatting, and arithmetic
-- Uses Lua's os.date/os.time as the underlying engine.
-- A datetime is a table: {year, month, day, hour, min, sec, wday, yday, isdst}

math = req "std.math"

-- ---- Constants ----

global DT_MONTH_NAMES = {}
DT_MONTH_NAMES[1] = "January"
DT_MONTH_NAMES[2] = "February"
DT_MONTH_NAMES[3] = "March"
DT_MONTH_NAMES[4] = "April"
DT_MONTH_NAMES[5] = "May"
DT_MONTH_NAMES[6] = "June"
DT_MONTH_NAMES[7] = "July"
DT_MONTH_NAMES[8] = "August"
DT_MONTH_NAMES[9] = "September"
DT_MONTH_NAMES[10] = "October"
DT_MONTH_NAMES[11] = "November"
DT_MONTH_NAMES[12] = "December"

global DT_MONTH_ABBR = {}
DT_MONTH_ABBR[1] = "Jan"
DT_MONTH_ABBR[2] = "Feb"
DT_MONTH_ABBR[3] = "Mar"
DT_MONTH_ABBR[4] = "Apr"
DT_MONTH_ABBR[5] = "May"
DT_MONTH_ABBR[6] = "Jun"
DT_MONTH_ABBR[7] = "Jul"
DT_MONTH_ABBR[8] = "Aug"
DT_MONTH_ABBR[9] = "Sep"
DT_MONTH_ABBR[10] = "Oct"
DT_MONTH_ABBR[11] = "Nov"
DT_MONTH_ABBR[12] = "Dec"

global DT_DAY_NAMES = {}
DT_DAY_NAMES[1] = "Sunday"
DT_DAY_NAMES[2] = "Monday"
DT_DAY_NAMES[3] = "Tuesday"
DT_DAY_NAMES[4] = "Wednesday"
DT_DAY_NAMES[5] = "Thursday"
DT_DAY_NAMES[6] = "Friday"
DT_DAY_NAMES[7] = "Saturday"

global DT_DAY_ABBR = {}
DT_DAY_ABBR[1] = "Sun"
DT_DAY_ABBR[2] = "Mon"
DT_DAY_ABBR[3] = "Tue"
DT_DAY_ABBR[4] = "Wed"
DT_DAY_ABBR[5] = "Thu"
DT_DAY_ABBR[6] = "Fri"
DT_DAY_ABBR[7] = "Sat"

global DT_DAYS_PER_MONTH = {}
DT_DAYS_PER_MONTH[1] = 31
DT_DAYS_PER_MONTH[2] = 28
DT_DAYS_PER_MONTH[3] = 31
DT_DAYS_PER_MONTH[4] = 30
DT_DAYS_PER_MONTH[5] = 31
DT_DAYS_PER_MONTH[6] = 30
DT_DAYS_PER_MONTH[7] = 31
DT_DAYS_PER_MONTH[8] = 31
DT_DAYS_PER_MONTH[9] = 30
DT_DAYS_PER_MONTH[10] = 31
DT_DAYS_PER_MONTH[11] = 30
DT_DAYS_PER_MONTH[12] = 31

global DT_SECS_PER_MINUTE = 60
global DT_SECS_PER_HOUR = 3600
global DT_SECS_PER_DAY = 86400
global DT_SECS_PER_WEEK = 604800

-- ---- Constructors ----
dt_new(year: any, month: any, day: any, hour: any, min: any, sec: any): any
    d = {}
    d.year = year
    d.month = month
    d.day = day
    if hour != nil d.hour = hour else d.hour = 0 end
    if min != nil d.min = min else d.min = 0 end
    if sec != nil d.sec = sec else d.sec = 0 end
    d.wday = 0
    d.yday = 0
    d.isdst = false
    d
end

dt_now(): any
    os.date("*t")
end

dt_utc(): any
    os.date("!*t")
end

dt_from_timestamp(ts: int): any
    os.date("*t", ts)
end

dt_to_timestamp(d: any): int
    os.time(d)
end

-- ---- Queries ----

dt_is_leap_year(year: i64): bool
    if year % 400 == 0 return true end
    if year % 100 == 0 return false end
    if year % 4 == 0 return true end
    false
end

dt_days_in_month(year: i64, month: i64): i64
    if month == 2 and dt_is_leap_year(year) return 29 end
    DT_DAYS_PER_MONTH[month]
end

dt_days_in_year(year: i64): i64
    if dt_is_leap_year(year) return 366 end
    365
end

dt_weekday_name(d: any): str
    DT_DAY_NAMES[d.wday]
end

dt_weekday_abbr(d: any): str
    DT_DAY_ABBR[d.wday]
end

dt_month_name(d: any): str
    DT_MONTH_NAMES[d.month]
end

dt_month_abbr(d: any): str
    DT_MONTH_ABBR[d.month]
end

dt_is_weekend(d: any): bool
    d.wday == 1 or d.wday == 7
end

-- ---- Arithmetic ----

dt_add(d: any, secs: int): any
    ts = os.time(d)
    os.date("*t", ts + secs)
end

dt_add_days(d: any, n: i64): any
    dt_add(d, n * DT_SECS_PER_DAY)
end

dt_add_hours(d: any, n: i64): any
    dt_add(d, n * DT_SECS_PER_HOUR)
end

dt_add_minutes(d: any, n: i64): any
    dt_add(d, n * DT_SECS_PER_MINUTE)
end

dt_add_months(d: any, n: i64): any
    total_month = d.month + n
    new_year = d.year + math.floor(total_month / 12)
    new_month = total_month % 12
    if new_month <= 0
        new_month += 12
        new_year -= 1
    end
    max_day = dt_days_in_month(new_year, new_month)
    new_day = d.day
    if new_day > max_day new_day = max_day end
    r = {}
    r.year = new_year
    r.month = new_month
    r.day = new_day
    r.hour = d.hour
    r.min = d.min
    r.sec = d.sec
    r.wday = 0
    r.yday = 0
    r.isdst = false
    r
end

dt_add_years(d: any, n: i64): any
    dt_add_months(d, n * 12)
end

dt_diff(a: any, b: any): int
    os.time(a) - os.time(b)
end

dt_diff_days(a: any, b: any): i64
    dt_diff(a, b) // DT_SECS_PER_DAY
end

dt_diff_hours(a: any, b: any): i64
    dt_diff(a, b) // DT_SECS_PER_HOUR
end

-- ---- Formatting ----
dt_pad2(n: i64): str
    if n < 10 return "0" .. tostring(n) end
    tostring(n)
end

dt_format(d: any, layout: str): str
    r = layout
    year4 = tostring(d.year)
    year2 = string.sub(year4, string.len(year4) - 1)
    r = string.gsub(r, "YYYY", year4)
    r = string.gsub(r, "YY", year2)
    r = string.gsub(r, "MM", dt_pad2(d.month))
    r = string.gsub(r, "DD", dt_pad2(d.day))
    r = string.gsub(r, "HH", dt_pad2(d.hour))
    r = string.gsub(r, "mm", dt_pad2(d.min))
    r = string.gsub(r, "ss", dt_pad2(d.sec))
    r = string.gsub(r, "WWW", DT_DAY_ABBR[d.wday])
    r = string.gsub(r, "WWWW", DT_DAY_NAMES[d.wday])
    h12 = d.hour % 12
    if h12 == 0 h12 = 12 end
    r = string.gsub(r, "hh", dt_pad2(h12))
    if d.hour < 12
        r = string.gsub(r, "AMPM", "AM")
        r = string.gsub(r, "ampm", "am")
    else
        r = string.gsub(r, "AMPM", "PM")
        r = string.gsub(r, "ampm", "pm")
    end
    r
end

dt_iso8601(d: any): str
    dt_format(d, "YYYY-MM-DDTHH:mm:ss")
end

dt_date_only(d: any): str
    dt_format(d, "YYYY-MM-DD")
end

dt_time_only(d: any): str
    dt_format(d, "HH:mm:ss")
end

dt_rfc2822(d: any): str
    p = DT_DAY_ABBR[d.wday] .. ", "
    p = p .. tostring(d.day) .. " "
    p = p .. DT_MONTH_ABBR[d.month] .. " "
    p = p .. tostring(d.year) .. " "
    p = p .. dt_pad2(d.hour) .. ":"
    p = p .. dt_pad2(d.min) .. ":"
    p = p .. dt_pad2(d.sec) .. " +0000"
    p
end

dt_human_relative(d: any): str
    secs = dt_diff(dt_now(), d)
    future = false
    if secs < 0
        secs = 0 - secs
        future = true
    end
    if secs < 60 return "just now" end
    if secs < 3600
        mins = math.floor(secs / 60)
        if future return "in " .. tostring(mins) .. " minutes" end
        return tostring(mins) .. " minutes ago"
    end
    if secs < 86400
        hrs = math.floor(secs / 3600)
        if future return "in " .. tostring(hrs) .. " hours" end
        return tostring(hrs) .. " hours ago"
    end
    day_count = math.floor(secs / 86400)
    if day_count == 1
        if future return "tomorrow" end
        return "yesterday"
    end
    if day_count < 30
        if future return "in " .. tostring(day_count) .. " days" end
        return tostring(day_count) .. " days ago"
    end
    months = math.floor(day_count / 30)
    if months < 12
        if future return "in " .. tostring(months) .. " months" end
        return tostring(months) .. " months ago"
    end
    years = math.floor(months / 12)
    if future return "in " .. tostring(years) .. " years" end
    tostring(years) .. " years ago"
end

-- ---- Parsing ----
-- Parse helpers return two values via Duo multi-return.
-- The codegen handles multi-return for direct call sites.
-- We pre-declare variables so the codegen emits proper C declarations.

dt_parse_digit2(s: str, pos: any): any
    val = tonumber(string.sub(s, pos, pos)) * 10 + tonumber(string.sub(s, pos + 1, pos + 1))
    return val, pos + 2
end

dt_parse_digit4(s: str, pos: any): any
    val = tonumber(string.sub(s, pos, pos)) * 1000
    val += tonumber(string.sub(s, pos + 1, pos + 1)) * 100
    val += tonumber(string.sub(s, pos + 2, pos + 2)) * 10
    val += tonumber(string.sub(s, pos + 3, pos + 3))
    return val, pos + 4
end

dt_parse_iso8601(s: str): any
    if string.len(s) < 10 return nil end
    year = 0
    pos = 1
    year, pos = dt_parse_digit4(s, 1)
    if string.sub(s, pos, pos) != "-" return nil end
    month = 0
    month, pos = dt_parse_digit2(s, pos + 1)
    if string.sub(s, pos, pos) != "-" return nil end
    day = 0
    day, pos = dt_parse_digit2(s, pos + 1)
    hour = 0
    minute = 0
    second = 0
    if string.len(s) >= pos + 2
        sep = string.sub(s, pos, pos)
        if sep == "T" or sep == " "
            hour, pos = dt_parse_digit2(s, pos + 1)
            if string.sub(s, pos, pos) == ":"
                minute, pos = dt_parse_digit2(s, pos + 1)
            end
            if string.sub(s, pos, pos) == ":"
                second, pos = dt_parse_digit2(s, pos + 1)
            end
        end
    end
    dt_new(year, month, day, hour, minute, second)
end

dt_parse_date(s: str): any
    dt_parse_iso8601(s .. "T00:00:00")
end

dt_parse_time(s: str): any
    hour = 0
    pos = 1
    hour, pos = dt_parse_digit2(s, 1)
    minute = 0
    second = 0
    if string.sub(s, pos, pos) == ":"
        minute, pos = dt_parse_digit2(s, pos + 1)
    end
    if string.sub(s, pos, pos) == ":"
        second, pos = dt_parse_digit2(s, pos + 1)
    end
    dt_new(0, 1, 1, hour, minute, second)
end

-- ---- Comparison ----

dt_before(a: any, b: any): bool
    os.time(a) < os.time(b)
end

dt_after(a: any, b: any): bool
    os.time(a) > os.time(b)
end

dt_equal(a: any, b: any): bool
    os.time(a) == os.time(b)
end

dt_min_dt(a: any, b: any): any
    if dt_before(a, b) return a end
    b
end

dt_max_dt(a: any, b: any): any
    if dt_after(a, b) return a end
    b
end

-- ---- Range & Truncation ----
dt_start_of_day(d: any): any
    dt_new(d.year, d.month, d.day, 0, 0, 0)
end

dt_end_of_day(d: any): any
    dt_new(d.year, d.month, d.day, 23, 59, 59)
end

dt_start_of_month(d: any): any
    dt_new(d.year, d.month, 1, 0, 0, 0)
end

dt_end_of_month(d: any): any
    last_day = dt_days_in_month(d.year, d.month)
    dt_new(d.year, d.month, last_day, 23, 59, 59)
end

dt_start_of_year(d: any): any
    dt_new(d.year, 1, 1, 0, 0, 0)
end

dt_end_of_year(d: any): any
    dt_new(d.year, 12, 31, 23, 59, 59)
end

dt_truncate(d: any, precision: str): any
    if precision == "hour"
        return dt_new(d.year, d.month, d.day, d.hour, 0, 0)
    end
    if precision == "minute"
        return dt_new(d.year, d.month, d.day, d.hour, d.min, 0)
    end
    d
end

M = {}
M.new = dt_new
M.now = dt_now
M.utc = dt_utc
M.from_timestamp = dt_from_timestamp
M.to_timestamp = dt_to_timestamp
M.is_leap_year = dt_is_leap_year
M.days_in_month = dt_days_in_month
M.days_in_year = dt_days_in_year
M.weekday_name = dt_weekday_name
M.weekday_abbr = dt_weekday_abbr
M.month_name = dt_month_name
M.month_abbr = dt_month_abbr
M.is_weekend = dt_is_weekend
M.add = dt_add
M.add_days = dt_add_days
M.add_hours = dt_add_hours
M.add_minutes = dt_add_minutes
M.add_months = dt_add_months
M.add_years = dt_add_years
M.diff = dt_diff
M.diff_days = dt_diff_days
M.diff_hours = dt_diff_hours
M.format = dt_format
M.iso8601 = dt_iso8601
M.date_only = dt_date_only
M.time_only = dt_time_only
M.rfc2822 = dt_rfc2822
M.human_relative = dt_human_relative
M.parse_iso8601 = dt_parse_iso8601
M.parse_date = dt_parse_date
M.parse_time = dt_parse_time
M.before = dt_before
M.after = dt_after
M.equal = dt_equal
M.min = dt_min_dt
M.max = dt_max_dt
M.start_of_day = dt_start_of_day
M.end_of_day = dt_end_of_day
M.start_of_month = dt_start_of_month
M.end_of_month = dt_end_of_month
M.start_of_year = dt_start_of_year
M.end_of_year = dt_end_of_year
M.truncate = dt_truncate
M.SECS_PER_MINUTE = DT_SECS_PER_MINUTE
M.SECS_PER_HOUR = DT_SECS_PER_HOUR
M.SECS_PER_DAY = DT_SECS_PER_DAY
M.SECS_PER_WEEK = DT_SECS_PER_WEEK
M
