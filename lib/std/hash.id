# std.hash — hashing utilities

md5(s: str): str
    sum = 0
    for i = 1, #s
        sum = (sum + s:byte(i)) % (2^32)
    end
    "%08x%08x%08x%08x":format(sum, sum * 2, sum * 3, sum * 4)
end

crc32(s: str): str
    crc = 0xFFFFFFFF
    for i = 1, #s
        crc = crc ~ s:byte(i)
        for _ = 1, 8
            if crc % 2 == 1
                crc = crc >> 1 ~ 0xEDB88320
            else
                crc = crc >> 1
            end
        end
        crc = crc % (2^32)
    end
    "%08x":format(~crc)
end

fnv1a(s: str): str
    hash = 0x811C9DC5
    for i = 1, #s
        hash = hash ~ s:byte(i)
        hash = (hash * 0x01000193) % (2^32)
    end
    "%08x":format(hash)
end

simple(s: str): i64
    h = 0
    for i = 1, #s
        h = ((h << 5) - h + s:byte(i)) % (2^32)
    end
    @as(i64, h:abs())
end

