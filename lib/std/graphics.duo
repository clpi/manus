-- std.graphics — color, geometry, and render pipeline primitives
-- Targets: game engines, visualization, ML result rendering, image processing

-- ═══════════════════════════════════════════════════════════════
-- Color
-- ═══════════════════════════════════════════════════════════════

color_rgb(r: f64, g: f64, b: f64): any
    {r = r, g = g, b = b, a = 1.0}
end

color_rgba(r: f64, g: f64, b: f64, a: f64): any
    {r = r, g = g, b = b, a = a}
end

color_hex(hex_str: str): any
    s = hex_str
    if string.sub(s, 1, 1) == "#" s = string.sub(s, 2) end
    if string.len(s) == 6
        r = tonumber(string.sub(s, 1, 2), 16) / 255
        g = tonumber(string.sub(s, 3, 4), 16) / 255
        b = tonumber(string.sub(s, 5, 6), 16) / 255
        return {r = r, g = g, b = b, a = 1.0}
    end
    if string.len(s) == 8
        r = tonumber(string.sub(s, 1, 2), 16) / 255
        g = tonumber(string.sub(s, 3, 4), 16) / 255
        b = tonumber(string.sub(s, 5, 6), 16) / 255
        a = tonumber(string.sub(s, 7, 8), 16) / 255
        return {r = r, g = g, b = b, a = a}
    end
    {r = 0, g = 0, b = 0, a = 1.0}
end

color_to_hex(c: any): str
    ri = math.floor(c.r * 255 + 0.5)
    gi = math.floor(c.g * 255 + 0.5)
    bi = math.floor(c.b * 255 + 0.5)
    string.format("#%02x%02x%02x", ri, gi, bi)
end

color_lerp(a: any, b: any, t: f64): any
    {
        r = a.r + (b.r - a.r) * t,
        g = a.g + (b.g - a.g) * t,
        b = a.b + (b.b - a.b) * t,
        a = a.a + (b.a - a.a) * t,
    }
end

color_mul(c: any, s: f64): any
    {r = c.r * s, g = c.g * s, b = c.b * s, a = c.a * s}
end

color_add(a: any, b: any): any
    {r = a.r + b.r, g = a.g + b.g, b = a.b + b.b, a = a.a + b.a}
end

color_clamp(c: any): any
    {
        r = std.math.clamp(c.r, 0, 1),
        g = std.math.clamp(c.g, 0, 1),
        b = std.math.clamp(c.b, 0, 1),
        a = std.math.clamp(c.a, 0, 1),
    }
end

-- Convert RGB to HSV
color_to_hsv(c: any): any
    r, g, b = c.r, c.g, c.b
    max_val = math.max(r, math.max(g, b))
    min_val = math.min(r, math.min(g, b))
    d = max_val - min_val
    h = 0
    s = 0
    v = max_val
    if max_val != 0 s = d / max_val end
    if d != 0
        if max_val == r
            h = (g - b) / d
            if g < b h += 6 end
        elseif max_val == g
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h /= 6
    end
    {h = h, s = s, v = v}
end

-- Convert HSV to RGB
color_from_hsv(h: f64, s: f64, v: f64): any
    i = math.floor(h * 6)
    f = h * 6 - i
    p = v * (1 - s)
    q = v * (1 - f * s)
    t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 return {r = v, g = t, b = p, a = 1.0} end
    if i == 1 return {r = q, g = v, b = p, a = 1.0} end
    if i == 2 return {r = p, g = v, b = t, a = 1.0} end
    if i == 3 return {r = p, g = q, b = v, a = 1.0} end
    if i == 4 return {r = t, g = p, b = v, a = 1.0} end
    {r = v, g = p, b = q, a = 1.0}
end

-- Named colors
COLORS = {
    red = {r = 1, g = 0, b = 0, a = 1},
    green = {r = 0, g = 1, b = 0, a = 1},
    blue = {r = 0, g = 0, b = 1, a = 1},
    white = {r = 1, g = 1, b = 1, a = 1},
    black = {r = 0, g = 0, b = 0, a = 1},
    yellow = {r = 1, g = 1, b = 0, a = 1},
    cyan = {r = 0, g = 1, b = 1, a = 1},
    magenta = {r = 1, g = 0, b = 1, a = 1},
    orange = {r = 1, g = 0.5, b = 0, a = 1},
    purple = {r = 0.5, g = 0, b = 0.5, a = 1},
    gray = {r = 0.5, g = 0.5, b = 0.5, a = 1},
    transparent = {r = 0, g = 0, b = 0, a = 0},
}

-- ═══════════════════════════════════════════════════════════════
-- Geometry: 2D vectors and shapes
-- ═══════════════════════════════════════════════════════════════

vec2(x: f64, y: f64): any
    {x = x, y = y}
end

vec2_add(a: any, b: any): any
    {x = a.x + b.x, y = a.y + b.y}
end

vec2_sub(a: any, b: any): any
    {x = a.x - b.x, y = a.y - b.y}
end

vec2_mul(v: any, s: f64): any
    {x = v.x * s, y = v.y * s}
end

vec2_dot(a: any, b: any): f64
    a.x * b.x + a.y * b.y
end

vec2_length(v: any): f64
    math.sqrt(v.x * v.x + v.y * v.y)
end

vec2_normalize(v: any): any
    len = vec2_length(v)
    if len < 1e-10 return {x = 0, y = 0} end
    {x = v.x / len, y = v.y / len}
end

vec2_distance(a: any, b: any): f64
    vec2_length(vec2_sub(a, b))
end

vec2_lerp(a: any, b: any, t: f64): any
    {x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t}
end

-- 2D Rectangle
rect(x: f64, y: f64, w: f64, h: f64): any
    {x = x, y = y, w = w, h = h}
end

rect_contains(r: any, px: f64, py: f64): bool
    px >= r.x and px <= r.x + r.w and py >= r.y and py <= r.y + r.h
end

rect_intersects(a: any, b: any): bool
    a.x < b.x + b.w and a.x + a.w > b.x and a.y < b.y + b.h and a.y + a.h > b.y
end

rect_area(r: any): f64
    r.w * r.h
end

rect_center(r: any): any
    {x = r.x + r.w / 2, y = r.y + r.h / 2}
end

-- Circle
circle(cx: f64, cy: f64, r: f64): any
    {cx = cx, cy = cy, r = r}
end

circle_contains(c: any, px: f64, py: f64): bool
    dx = px - c.cx
    dy = py - c.cy
    dx * dx + dy * dy <= c.r * c.r
end

circle_area(c: any): f64
    math.pi * c.r * c.r
end

circle_perimeter(c: any): f64
    2 * math.pi * c.r
end

-- ═══════════════════════════════════════════════════════════════
-- Transform (2D affine: translation + rotation + scale)
-- ═══════════════════════════════════════════════════════════════

transform_new(): any
    {tx = 0, ty = 0, sx = 1, sy = 1, rotation = 0}
end

transform_translate(t: any, dx: f64, dy: f64): any
    t.tx = t.tx + dx
    t.ty = t.ty + dy
    t
end

transform_rotate(t: any, angle: f64): any
    t.rotation = t.rotation + angle
    t
end

transform_scale(t: any, sx: f64, sy: f64): any
    t.sx = t.sx * sx
    t.sy = t.sy * sy
    t
end

transform_apply(t: any, px: f64, py: f64): any
    cos_r = math.cos(t.rotation)
    sin_r = math.sin(t.rotation)
    rx = px * t.sx
    ry = py * t.sy
    {
        x = rx * cos_r - ry * sin_r + t.tx,
        y = rx * sin_r + ry * cos_r + t.ty,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Canvas (simple rasterizer for ML visualization / image gen)
-- ═══════════════════════════════════════════════════════════════

canvas_new(width: i64, height: i64): any
    pixels = {}
    total = width * height
    i = 1
    while i <= total
        pixels[i] = {r = 1, g = 1, b = 1, a = 1}
        i += 1
    end
    {width = width, height = height, pixels = pixels}
end

canvas_clear(canvas: any, color: any): void
    total = canvas.width * canvas.height
    i = 1
    while i <= total
        canvas.pixels[i] = color
        i += 1
    end
end

canvas_set_pixel(canvas: any, x: i64, y: i64, color: any): void
    if x < 0 or x >= canvas.width or y < 0 or y >= canvas.height return end
    canvas.pixels[y * canvas.width + x + 1] = color
end

canvas_get_pixel(canvas: any, x: i64, y: i64): any
    if x < 0 or x >= canvas.width or y < 0 or y >= canvas.height return nil end
    canvas.pixels[y * canvas.width + x + 1]
end

-- Draw a filled rectangle
canvas_fill_rect(canvas: any, x: i64, y: i64, w: i64, h: i64, color: any): void
    dy = 0
    while dy < h
        dx = 0
        while dx < w
            canvas_set_pixel(canvas, x + dx, y + dy, color)
            dx += 1
        end
        dy += 1
    end
end

-- Draw a line (Bresenham's algorithm)
canvas_line(canvas: any, x0: i64, y0: i64, x1: i64, y1: i64, color: any): void
    dx = math.abs(x1 - x0)
    dy = -math.abs(y1 - y0)
    sx = 1
    if x0 > x1 sx = -1 end
    sy = 1
    if y0 > y1 sy = -1 end
    err = dx + dy
    x, y = x0, y0
    while true
        canvas_set_pixel(canvas, x, y, color)
        if x == x1 and y == y1 break end
        e2 = 2 * err
        if e2 >= dy
            err += dy
            x += sx
        end
        if e2 <= dx
            err += dx
            y += sy
        end
    end
end

-- Draw a circle (Midpoint circle algorithm)
canvas_circle(canvas: any, cx: i64, cy: i64, r: i64, color: any): void
    x = r
    y = 0
    err = 1 - r
    while x >= y
        canvas_set_pixel(canvas, cx + x, cy + y, color)
        canvas_set_pixel(canvas, cx + y, cy + x, color)
        canvas_set_pixel(canvas, cx - y, cy + x, color)
        canvas_set_pixel(canvas, cx - x, cy + y, color)
        canvas_set_pixel(canvas, cx - x, cy - y, color)
        canvas_set_pixel(canvas, cx - y, cy - x, color)
        canvas_set_pixel(canvas, cx + y, cy - x, color)
        canvas_set_pixel(canvas, cx + x, cy - y, color)
        y += 1
        if err < 0
            err += 2 * y + 1
        else
            x -= 1
            err += 2 * (y - x) + 1
        end
    end
end

-- Convert canvas to PPM format (for easy viewing)
canvas_to_ppm(canvas: any): str
    out = "P6\n" .. tostring(canvas.width) .. " " .. tostring(canvas.height) .. "\n255\n"
    i = 1
    while i <= canvas.width * canvas.height
        c = canvas.pixels[i]
        out = out .. string.char(math.floor(c.r * 255))
            .. string.char(math.floor(c.g * 255))
            .. string.char(math.floor(c.b * 255))
        i += 1
    end
    out
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Color
M.color_rgb = color_rgb
M.color_rgba = color_rgba
M.color_hex = color_hex
M.color_to_hex = color_to_hex
M.color_lerp = color_lerp
M.color_mul = color_mul
M.color_add = color_add
M.color_clamp = color_clamp
M.color_to_hsv = color_to_hsv
M.color_from_hsv = color_from_hsv
M.COLORS = COLORS
-- Vec2
M.vec2 = vec2
M.vec2_add = vec2_add
M.vec2_sub = vec2_sub
M.vec2_mul = vec2_mul
M.vec2_dot = vec2_dot
M.vec2_length = vec2_length
M.vec2_normalize = vec2_normalize
M.vec2_distance = vec2_distance
M.vec2_lerp = vec2_lerp
-- Shapes
M.rect = rect
M.rect_contains = rect_contains
M.rect_intersects = rect_intersects
M.rect_area = rect_area
M.rect_center = rect_center
M.circle = circle
M.circle_contains = circle_contains
M.circle_area = circle_area
M.circle_perimeter = circle_perimeter
-- Transform
M.transform_new = transform_new
M.transform_translate = transform_translate
M.transform_rotate = transform_rotate
M.transform_scale = transform_scale
M.transform_apply = transform_apply
-- Canvas
M.canvas_new = canvas_new
M.canvas_clear = canvas_clear
M.canvas_set_pixel = canvas_set_pixel
M.canvas_get_pixel = canvas_get_pixel
M.canvas_fill_rect = canvas_fill_rect
M.canvas_line = canvas_line
M.canvas_circle = canvas_circle
M.canvas_to_ppm = canvas_to_ppm
M
