fun exec(cmd: str): i64
    rc = os.execute(cmd)
    if rc == nil then
        -1
    end
    rc
end

fun capture(cmd: str): str
    f = io.popen(cmd, "r")
    if f == nil then
        ""
    end
    out = ""
    line = f:read()
    while line ~= nil
        out = out .. line .. "\n"
        line = f:read()
    end
    f:close()
    out
end

M = {}
M.exec = exec
M.capture = capture
M
