-- std.proc — process utilities

fun std_proc_exec(cmd: str)
    rc = os.execute(cmd)
    if rc == nil then
        -1
    end
    rc
end

fun std_proc_capture(cmd: str): str
    f = io.popen(cmd, "r")
    if f == nil then
        ""
    end
    out = ""
    line = f:read()
    while line ~= nil
        out = out .. line .. "\n"
        line = f:read()
    end
    f:close()
    out
end

M = {}
M.exec = std_proc_exec
M.capture = std_proc_capture
M