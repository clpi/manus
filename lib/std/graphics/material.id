# std.graphics.material — Material and texture management
# For ward's graphics pipeline and rendering.

# ═══════════════════════════════════════════════════════════════
# Texture
# ═══════════════════════════════════════════════════════════════

texture_new(width: i64, height: i64, channels: i64): any
    data = {}
    size = width * height * channels
    i = 1
    while i <= size
        data[i] = 0
        i += 1
    end
    {
        width = width,
        height = height,
        channels = channels,
        data = data,
        format = "rgba",
        filter = "linear",
        wrap = "repeat",
    }
end

texture_from_data(data: any, width: i64, height: i64, channels: i64): any
    {
        width = width,
        height = height,
        channels = channels,
        data = data,
        format = channels == 4 and "rgba" or "rgb",
        filter = "linear",
        wrap = "repeat",
    }
end

texture_get_pixel(tex: any, x: i64, y: i64): any
    x = x % tex.width
    y = y % tex.height
    idx = (y * tex.width + x) * tex.channels
    pixel = {}
    i = 1
    while i <= tex.channels
        pixel[i] = tex.data[idx + i]
        i += 1
    end
    pixel
end

texture_set_pixel(tex: any, x: i64, y: i64, pixel: any): void
    x = x % tex.width
    y = y % tex.height
    idx = (y * tex.width + x) * tex.channels
    i = 1
    while i <= tex.channels
        tex.data[idx + i] = pixel[i]
        i += 1
    end
end

texture_sample(tex: any, u: f64, v: f64): any
    x = u * tex.width:floor() % tex.width
    y = v * tex.height:floor() % tex.height
    texture_get_pixel(tex, x, y)
end

texture_retex: any, new_width: i64, new_height: i64:len(): any
    new_tex = texture_new(new_width, new_height, tex.channels)
    x_scale = tex.width / new_width
    y_scale = tex.height / new_height

    y = 0
    while y < new_height
        x = 0
        while x < new_width
            src_x = x * x_scale:floor()
            src_y = y * y_scale:floor()
            pixel = texture_get_pixel(tex, src_x, src_y)
            texture_set_pixel(new_tex, x, y, pixel)
            x += 1
        end
        y += 1
    end
    new_tex
end

texture_flip_h(tex: any): any
    new_tex = texture_new(tex.width, tex.height, tex.channels)
    y = 0
    while y < tex.height
        x = 0
        while x < tex.width
            pixel = texture_get_pixel(tex, tex.width - 1 - x, y)
            texture_set_pixel(new_tex, x, y, pixel)
            x += 1
        end
        y += 1
    end
    new_tex
end

texture_flip_v(tex: any): any
    new_tex = texture_new(tex.width, tex.height, tex.channels)
    y = 0
    while y < tex.height
        x = 0
        while x < tex.width
            pixel = texture_get_pixel(tex, x, tex.height - 1 - y)
            texture_set_pixel(new_tex, x, y, pixel)
            x += 1
        end
        y += 1
    end
    new_tex
end

# ═══════════════════════════════════════════════════════════════
# Procedural Textures
# ═══════════════════════════════════════════════════════════════

texture_checkerboard(size: i64, square_size: i64): any
    tex = texture_new(size, size, 3)
    y = 0
    while y < size
        x = 0
        while x < size
            is_white = ((x / square_size) + (y / square_size)) % 2 == 0
            if is_white
                texture_set_pixel(tex, x, y, {255, 255, 255})
            else
                texture_set_pixel(tex, x, y, {0, 0, 0})
            end
            x += 1
        end
        y += 1
    end
    tex
end

texture_gradient(size: i64, color1: any, color2: any): any
    tex = texture_new(size, size, 3)
    y = 0
    while y < size
        x = 0
        while x < size
            t = x / size
            r = color1[1] + (color2[1] - color1[1]) * t:floor()
            g = color1[2] + (color2[2] - color1[2]) * t:floor()
            b = color1[3] + (color2[3] - color1[3]) * t:floor()
            texture_set_pixel(tex, x, y, {r, g, b})
            x += 1
        end
        y += 1
    end
    tex
end

# ═══════════════════════════════════════════════════════════════
# Material
# ═══════════════════════════════════════════════════════════════

material_new(name: str): any
    {
        name = name,
        albedo = {r = 0.8, g = 0.8, b = 0.8},
        metallic = 0.0,
        roughness = 0.5,
        ao = 1.0,
        emissive = {r = 0, g = 0, b = 0},
        emissive_strength = 0,
        albedo_texture = nil,
        metallic_roughness_texture = nil,
        normal_texture = nil,
        ao_texture = nil,
        emissive_texture = nil,
        double_sided = false,
        alpha_mode = "opaque",  # "opaque", "mask", "blend"
        alpha_cutoff = 0.5,
    }
end

material_set_albedo(mat: any, r: f64, g: f64, b: f64): void
    mat.albedo = {r = r, g = g, b = b}
end

material_set_metallic(mat: any, metallic: f64, roughness: f64): void
    mat.metallic = metallic
    mat.roughness = roughness
end

material_set_emissive(mat: any, r: f64, g: f64, b: f64, strength: f64): void
    mat.emissive = {r = r, g = g, b = b}
    mat.emissive_strength = strength
end

material_set_texture(mat: any, texture_type: str, texture: any): void
    if texture_type == "albedo"
        mat.albedo_texture = texture
    elseif texture_type == "metallic_roughness"
        mat.metallic_roughness_texture = texture
    elseif texture_type == "normal"
        mat.normal_texture = texture
    elseif texture_type == "ao"
        mat.ao_texture = texture
    elseif texture_type == "emissive"
        mat.emissive_texture = texture
    end
end

# ═══════════════════════════════════════════════════════════════
# Material Library
# ═══════════════════════════════════════════════════════════════

library_new(): any
    {
        materials = {},
        default_materials = {},
    }
end

library_add(lib: any, name: str, material: any): void
    lib.materials[name] = material
end

library_get(lib: any, name: str): any
    lib.materials[name] or lib.default_materials["default"]
end

library_remove(lib: any, name: str): void
    lib.materials[name] = nil
end

library_list(lib: any): any
    names = {}
    for name in lib.materials
        names[names:len() + 1] = name
    end
    names
end

# Default materials
default_white(): any
    mat = material_new("default_white")
    mat.albedo = {r = 1, g = 1, b = 1}
    mat
end

default_gray(): any
    mat = material_new("default_gray")
    mat.albedo = {r = 0.5, g = 0.5, b = 0.5}
    mat
end

default_black(): any
    mat = material_new("default_black")
    mat.albedo = {r = 0, g = 0, b = 0}
    mat
end

metal(color: any): any
    mat = material_new("metal")
    mat.albedo = color or {r = 0.8, g = 0.8, b = 0.8}
    mat.metallic = 1.0
    mat.roughness = 0.2
    mat
end

plastic(color: any): any
    mat = material_new("plastic")
    mat.albedo = color or {r = 0.8, g = 0.2, b = 0.2}
    mat.metallic = 0.0
    mat.roughness = 0.5
    mat
end

rubber(color: any): any
    mat = material_new("rubber")
    mat.albedo = color or {r = 0.2, g = 0.2, b = 0.2}
    mat.metallic = 0.0
    mat.roughness = 1.0
    mat
end

glass(): any
    mat = material_new("glass")
    mat.albedo = {r = 1, g = 1, b = 1}
    mat.metallic = 0.0
    mat.roughness = 0.0
    mat.alpha_mode = "blend"
    mat
end

emissive(color: any, strength: f64): any
    mat = material_new("emissive")
    mat.albedo = {r = 0, g = 0, b = 0}
    mat.emissive = color or {r = 1, g = 1, b = 1}
    mat.emissive_strength = strength or 1.0
    mat
end

# ═══════════════════════════════════════════════════════════════
# PBR Shading (simplified)
# ═══════════════════════════════════════════════════════════════

pbr_shade(material: any, normal: any, light_dir: any, view_dir: any): any
    # Simplified PBR shading
    n_dot_l = 0:max(normal.x * light_dir.x + normal.y * light_dir.y + normal.z * light_dir.z)

    # Diffuse
    diffuse = {
        r = material.albedo.r * n_dot_l,
        g = material.albedo.g * n_dot_l,
        b = material.albedo.b * n_dot_l,
    }

    # Specular (simplified)
    half_dir = {
        x = light_dir.x + view_dir.x,
        y = light_dir.y + view_dir.y,
        z = light_dir.z + view_dir.z,
    }
    len = half_dir.x * half_dir.x + half_dir.y * half_dir.y + half_dir.z * half_dir.z:sqrt()
    if len > 0
        half_dir.x = half_dir.x / len
        half_dir.y = half_dir.y / len
        half_dir.z = half_dir.z / len
    end

    n_dot_h = 0:max(normal.x * half_dir.x + normal.y * half_dir.y + normal.z * half_dir.z)
    spec = n_dot_h:pow(32 * (1 - material.roughness))

    specular = {
        r = spec * material.metallic,
        g = spec * material.metallic,
        b = spec * material.metallic,
    }

    # Combine
    {
        r = 1:min(diffuse.r + specular.r),
        g = 1:min(diffuse.g + specular.g),
        b = 1:min(diffuse.b + specular.b),
    }
end

