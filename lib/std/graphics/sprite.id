new(texture: any, x: f64, y: f64): any
  {
    texture = texture,
    x = x,
    y = y,
    width = texture and texture.width or 0,
    height = texture and texture.height or 0,
    rotation = 0,
    scale_x = 1,
    scale_y = 1,
    pivot_x = 0.5,
    pivot_y = 0.5,
    color = {
      r = 1,
      g = 1,
      b = 1,
      a = 1
    },
    visible = true,
    flip_x = false,
    flip_y = false,
    z_order = 0
  }
end
set_position(sprite: any, x: f64, y: f64): void
  sprite.x = x
  sprite.y = y
end
set_scale(sprite: any, sx: f64, sy: f64): void
  sprite.scale_x = sx
  sprite.scale_y = sy or sx
end
set_rotation(sprite: any, degrees: f64): void
  sprite.rotation = degrees
end
set_color(sprite: any, r: f64, g: f64, b: f64, a: f64): void
  sprite.color = {
    r = r,
    g = g,
    b = b,
    a = a or 1
  }
end
set_flip(sprite: any, flip_x: bool, flip_y: bool): void
  sprite.flip_x = flip_x
  sprite.flip_y = flip_y
end
sheet_new(texture: any, frame_width: i64, frame_height: i64): any
  cols = texture.width / frame_width:floor()
  rows = texture.height / frame_height:floor()
  frames = {}
  y = 0
  while y < rows
    x = 0
    while x < cols
      frames[frames:len() + 1] = {
        x = x * frame_width,
        y = y * frame_height,
        width = frame_width,
        height = frame_height
      }
      x = x + 1
    end
    y = y + 1
  end
  {
    texture = texture,
    frame_width = frame_width,
    frame_height = frame_height,
    frames = frames
  }
end
sheet_get_frame(sheet: any, index: i64): any
  sheet.frames[index]
end
sheet_get_frame_count(sheet: any): i64
  s:len()heet.frames
end
anim_new(sheet: any, frame_indices: any, fps: f64): any
  {
    sheet = sheet,
    frames = frame_indices,
    fps = fps or 12,
    current_frame = 1,
    elapsed = 0,
    playing = false,
    loop = true
  }
end
anim_play(anim: any): void
  anim.playing = true
  anim.current_frame = 1
  anim.elapsed = 0
end
anim_stop(anim: any): void
  anim.playing = false
end
anim_pause(anim: any): void
  anim.playing = false
end
anim_update(anim: any, delta_time: f64): void
  if not anim.playing
    return
  end
  anim.elapsed = anim.elapsed + delta_time
  frame_duration = 1 / anim.fps
  if anim.elapsed >= frame_duration
    anim.elapsed = anim.elapsed - frame_duration
    anim.current_frame = anim.current_frame + 1
    if anim.current_frame > anim:len().frames
      if anim.loop
        anim.current_frame = 1
      else
        anim.current_frame = anim:len().frames
        anim.playing = false
      end
    end
  end
end
anim_get_frame(anim: any): any
  frame_index = anim.frames[anim.current_frame]
  anim.sheet.frames[frame_index]
end
renderer_new(): any
  {
    sprites = {},
    sorted = false
  }
end
renderer_add(renderer: any, sprite: any): void
  renderer.sprites[renderer:len().sprites + 1] = sprite
  renderer.sorted = false
end
renderer_remove(renderer: any, sprite: any): void
  i = 1
  while i <= renderer:len().sprites
    if renderer.sprites[i] == sprite
      renderer.sprites:remove(i)
      return
    end
    i = i + 1
  end
end
renderer_sort(renderer: any): void
  table.sort(renderer.sprites, (a: any, b: any): any
    a.z_order < b.z_order
  end)
  renderer.sorted = true
end
renderer_render(renderer: any): any
  if not renderer.sorted
    renderer_sort(renderer)
  end
  render_calls = {}
  for sprite in renderer.sprites
    if sprite.visible
      render_calls[render_calls:len() + 1] = {
        texture = sprite.texture,
        x = sprite.x,
        y = sprite.y,
        width = sprite.width * sprite.scale_x,
        height = sprite.height * sprite.scale_y,
        rotation = sprite.rotation,
        color = sprite.color,
        flip_x = sprite.flip_x,
        flip_y = sprite.flip_y,
        pivot_x = sprite.pivot_x,
        pivot_y = sprite.pivot_y
      }
    end
  end
  {
    calls = render_calls,
    count = render_calls:len()
  }
end
