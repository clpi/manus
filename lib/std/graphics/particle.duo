-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Particle
M.particle_new = particle_new
-- Emitter Config
M.emitter_config_new = emitter_config_new
M.emitter_config_set_position = emitter_config_set_position
M.emitter_config_set_spread = emitter_config_set_spread
M.emitter_config_set_speed = emitter_config_set_speed
M.emitter_config_set_lifetime = emitter_config_set_lifetime
M.emitter_config_set_colors = emitter_config_set_colors
M.emitter_config_set_rate = emitter_config_set_rate
M.emitter_config_set_burst = emitter_config_set_burst
M.emitter_config_set_gravity = emitter_config_set_gravity
-- Emitter
M.emitter_new = emitter_new
M.emitter_emit = emitter_emit
M.emitter_update = emitter_update
M.emitter_get_particles = emitter_get_particles
M.emitter_clear = emitter_clear
M.emitter_set_active = emitter_set_active
M.emitter_particle_count = emitter_particle_count
-- System
M.system_new = particle_system_new
M.system_add_emitter = particle_system_add_emitter
M.system_update = particle_system_update
M.system_get_all_particles = particle_system_get_all_particles
M.system_clear = particle_system_clear
M.system_total_count = particle_system_total_count
-- Presets
M.fire = emitter_fire
M.smoke = emitter_smoke
M.rain = emitter_rain
M.sparkle = emitter_sparkle
M
