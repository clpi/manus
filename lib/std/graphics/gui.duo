-- std.graphics.gui — Immediate-mode GUI
-- For debug UIs and tool interfaces in ward.

-- ═══════════════════════════════════════════════════════════════
-- GUI State
-- ═══════════════════════════════════════════════════════════════

fun gui_state_new(): any
    {
        mouse_x = 0,
        mouse_y = 0,
        mouse_pressed = false,
        mouse_down = false,
        mouse_released = false,
        hot_item = nil,
        active_item = nil,
        last_z_index = 0,
        layout = {
            x = 0,
            y = 0,
            width = 0,
            height = 0,
            item_spacing = 4,
            group_spacing = 8,
        },
        draw_commands = {},
    }
end

fun gui_state_set_mouse(state: any, x: f64, y: f64, pressed: bool, down: bool, released: bool): void
    state.mouse_x = x
    state.mouse_y = y
    state.mouse_pressed = pressed
    state.mouse_down = down
    state.mouse_released = released
end

-- ═══════════════════════════════════════════════════════════════
-- GUI ID
-- ═══════════════════════════════════════════════════════════════

fun gui_id_hash(str: str): i64
    hash = 5381
    i = 1
    while i <= #str
        hash = ((hash * 33) + string.byte(str, i)) % 2147483647
        i += 1
    end
    hash
end

-- ═══════════════════════════════════════════════════════════════
-- GUI Drawing
-- ═══════════════════════════════════════════════════════════════

fun gui_draw_rect(state: any, x: f64, y: f64, w: f64, h: f64, color: any): void
    state.draw_commands[#state.draw_commands + 1] = {
        type = "rect",
        x = x,
        y = y,
        width = w,
        height = h,
        color = color,
    }
end

fun gui_draw_text(state: any, text: str, x: f64, y: f64, color: any): void
    state.draw_commands[#state.draw_commands + 1] = {
        type = "text",
        text = text,
        x = x,
        y = y,
        color = color,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- GUI Widgets
-- ═══════════════════════════════════════════════════════════════

fun gui_label(state: any, text: str): void
    gui_draw_text(state, text, state.layout.x, state.layout.y, {r = 1, g = 1, b = 1, a = 1})
    state.layout.y = state.layout.y + 16 + state.layout.item_spacing
end

fun gui_button(state: any, label: str): bool
    id = gui_id_hash(label)
    x = state.layout.x
    y = state.layout.y
    w = 100
    h = 24

    -- Check hover
    hover = x <= state.mouse_x and state.mouse_x <= x + w and
            y <= state.mouse_y and state.mouse_y <= y + h

    -- Check click
    clicked = false
    if hover and state.mouse_pressed then
        state.active_item = id
    end

    if state.active_item == id and state.mouse_released and hover then
        clicked = true
        state.active_item = nil
    end

    -- Draw
    if state.active_item == id and hover then
        gui_draw_rect(state, x, y, w, h, {r = 0.3, g = 0.3, b = 0.8, a = 1})
    elseif hover then
        gui_draw_rect(state, x, y, w, h, {r = 0.4, g = 0.4, b = 0.4, a = 1})
    else
        gui_draw_rect(state, x, y, w, h, {r = 0.2, g = 0.2, b = 0.2, a = 1})
    end

    gui_draw_text(state, label, x + 8, y + 4, {r = 1, g = 1, b = 1, a = 1})

    state.layout.y = state.layout.y + h + state.layout.item_spacing
    clicked
end

fun gui_checkbox(state: any, label: str, value: bool): bool
    id = gui_id_hash(label)
    x = state.layout.x
    y = state.layout.y
    box_size = 16

    -- Toggle on click
    if state.mouse_pressed then
        if x <= state.mouse_x and state.mouse_x <= x + box_size and
           y <= state.mouse_y and state.mouse_y <= y + box_size then
            value = not value
        end
    end

    -- Draw box
    if value then
        gui_draw_rect(state, x, y, box_size, box_size, {r = 0.2, g = 0.6, b = 0.2, a = 1})
    else
        gui_draw_rect(state, x, y, box_size, box_size, {r = 0.3, g = 0.3, b = 0.3, a = 1})
    end

    -- Draw label
    gui_draw_text(state, label, x + box_size + 8, y + 2, {r = 1, g = 1, b = 1, a = 1})

    state.layout.y = state.layout.y + box_size + state.layout.item_spacing
    value
end

fun gui_slider(state: any, label: str, value: f64, min: f64, max: f64): f64
    id = gui_id_hash(label)
    x = state.layout.x
    y = state.layout.y
    w = 150
    h = 16

    -- Handle drag
    if state.mouse_pressed then
        if x <= state.mouse_x and state.mouse_x <= x + w and
           y <= state.mouse_y and state.mouse_y <= y + h then
            state.active_item = id
        end
    end

    if state.active_item == id then
        ratio = math.max(0, math.min(1, (state.mouse_x - x) / w))
        value = min + ratio * (max - min)
    end

    if state.active_item == id and state.mouse_released then
        state.active_item = nil
    end

    -- Draw track
    gui_draw_rect(state, x, y, w, h, {r = 0.2, g = 0.2, b = 0.2, a = 1})

    -- Draw fill
    ratio = (value - min) / (max - min)
    gui_draw_rect(state, x, y, w * ratio, h, {r = 0.3, g = 0.5, b = 0.8, a = 1})

    -- Draw handle
    handle_x = x + w * ratio - 4
    gui_draw_rect(state, handle_x, y - 2, 8, h + 4, {r = 0.8, g = 0.8, b = 0.8, a = 1})

    -- Draw label
    gui_draw_text(state, label .. ": " .. tostring(math.floor(value)), x + w + 8, y + 2, {r = 1, g = 1, b = 1, a = 1})

    state.layout.y = state.layout.y + h + state.layout.item_spacing
    value
end

fun gui_text_input(state: any, label: str, text: str): str
    id = gui_id_hash(label)
    x = state.layout.x
    y = state.layout.y
    w = 200
    h = 24

    -- Focus on click
    if state.mouse_pressed then
        if x <= state.mouse_x and state.mouse_x <= x + w and
           y <= state.mouse_y and state.mouse_y <= y + h then
            state.active_item = id
        elseif state.active_item == id then
            state.active_item = nil
        end
    end

    -- Draw background
    if state.active_item == id then
        gui_draw_rect(state, x, y, w, h, {r = 0.1, g = 0.1, b = 0.3, a = 1})
    else
        gui_draw_rect(state, x, y, w, h, {r = 0.15, g = 0.15, b = 0.15, a = 1})
    end

    -- Draw text
    gui_draw_text(state, text, x + 4, y + 4, {r = 1, g = 1, b = 1, a = 1})

    -- Draw label
    gui_draw_text(state, label, x, y - 16, {r = 0.7, g = 0.7, b = 0.7, a = 1})

    state.layout.y = state.layout.y + h + state.layout.item_spacing + 16
    text
end

-- ═══════════════════════════════════════════════════════════════
-- GUI Layout
-- ═══════════════════════════════════════════════════════════════

fun gui_begin_group(state: any, x: f64, y: f64): void
    state.layout.x = x
    state.layout.y = y
end

fun gui_end_group(state: any): void
    state.layout.y = state.layout.y + state.layout.group_spacing
end

fun gui_get_draw_commands(state: any): any
    commands = state.draw_commands
    state.draw_commands = {}
    commands
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
M.state_new = gui_state_new
M.state_set_mouse = gui_state_set_mouse
M.label = gui_label
M.button = gui_button
M.checkbox = gui_checkbox
M.slider = gui_slider
M.text_input = gui_text_input
M.begin_group = gui_begin_group
M.end_group = gui_end_group
M.get_draw_commands = gui_get_draw_commands
M
