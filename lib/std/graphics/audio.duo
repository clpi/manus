-- std.graphics.audio — Audio playback and spatial audio
-- For sound effects and music in ward's runtime.

-- ═══════════════════════════════════════════════════════════════
-- Audio Config
-- ═══════════════════════════════════════════════════════════════

fun audio_config_new(): any
    {
        sample_rate = 44100,
        channels = 2,
        buffer_size = 1024,
        format = "f32",
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Audio Buffer
-- ═══════════════════════════════════════════════════════════════

fun audio_buffer_new(config: any): any
    {
        config = config,
        data = {},
        duration = 0,
    }
end

fun audio_buffer_load(buffer: any, path: str): any
    -- In production, would decode audio file
    {
        ok = false,
        error = "not implemented",
    }
end

fun audio_buffer_get_duration(buffer: any): f64
    buffer.duration
end

-- ═══════════════════════════════════════════════════════════════
-- Audio Source
-- ═══════════════════════════════════════════════════════════════

fun audio_source_new(buffer: any): any
    {
        buffer = buffer,
        playing = false,
        paused = false,
        loop = false,
        volume = 1.0,
        pitch = 1.0,
        position = {x = 0, y = 0, z = 0},
        velocity = {x = 0, y = 0, z = 0},
        direction = {x = 0, y = 0, z = 1},
        reference_distance = 1,
        max_distance = 100,
        rolloff = 1,
        gain = 1,
        spatial = true,
    }
end

fun audio_source_play(source: any): void
    source.playing = true
    source.paused = false
end

fun audio_source_pause(source: any): void
    source.paused = true
end

fun audio_source_stop(source: any): void
    source.playing = false
    source.paused = false
end

fun audio_source_set_volume(source: any, volume: f64): void
    source.volume = math.max(0, math.min(1, volume))
end

fun audio_source_set_pitch(source: any, pitch: f64): void
    source.pitch = math.max(0.5, math.min(2, pitch))
end

fun audio_source_set_loop(source: any, loop: bool): void
    source.loop = loop
end

fun audio_source_set_position(source: any, x: f64, y: f64, z: f64): void
    source.position = {x = x, y = y, z = z}
end

fun audio_source_set_spatial(source: any, spatial: bool): void
    source.spatial = spatial
end

-- ═══════════════════════════════════════════════════════════════
-- Audio Listener
-- ═══════════════════════════════════════════════════════════════

fun audio_listener_new(): any
    {
        position = {x = 0, y = 0, z = 0},
        velocity = {x = 0, y = 0, z = 0},
        direction = {x = 0, y = 0, z = -1},
        up = {x = 0, y = 1, z = 0},
        gain = 1,
    }
end

fun audio_listener_set_position(listener: any, x: f64, y: f64, z: f64): void
    listener.position = {x = x, y = y, z = z}
end

fun audio_listener_set_orientation(listener: any, direction: any, up: any): void
    listener.direction = direction
    listener.up = up
end

fun audio_listener_set_gain(listener: any, gain: f64): void
    listener.gain = math.max(0, math.min(1, gain))
end

-- ═══════════════════════════════════════════════════════════════
-- Audio System
-- ═══════════════════════════════════════════════════════════════

fun audio_system_new(config: any): any
    {
        config = config,
        listener = audio_listener_new(),
        sources = {},
        master_volume = 1,
        muted = false,
    }
end

fun audio_system_create_source(system: any, buffer: any): any
    source = audio_source_new(buffer)
    system.sources[#system.sources + 1] = source
    source
end

fun audio_system_destroy_source(system: any, source: any): void
    i = 1
    while i <= #system.sources
        if system.sources[i] == source then
            table.remove(system.sources, i)
            return
        end
        i += 1
    end
end

fun audio_system_set_master_volume(system: any, volume: f64): void
    system.master_volume = math.max(0, math.min(1, volume))
end

fun audio_system_set_mute(system: any, muted: bool): void
    system.muted = muted
end

fun audio_system_update(system: any, delta_time: f64): void
    -- In production, would process audio mixing
    for source in system.sources
        if source.playing and not source.paused then
            -- Update source position, apply spatial audio, etc.
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Sound Generation
-- ═══════════════════════════════════════════════════════════════

fun audio_generate_sine(frequency: f64, duration: f64, sample_rate: i64): any
    samples = {}
    num_samples = math.floor(duration * sample_rate)
    i = 1
    while i <= num_samples
        t = (i - 1) / sample_rate
        samples[i] = math.sin(2 * math.pi * frequency * t)
        i += 1
    end
    {
        data = samples,
        sample_rate = sample_rate,
        duration = duration,
    }
end

fun audio_generate_square(frequency: f64, duration: f64, sample_rate: i64): any
    samples = {}
    num_samples = math.floor(duration * sample_rate)
    i = 1
    while i <= num_samples
        t = (i - 1) / sample_rate
        phase = (frequency * t) % 1
        if phase < 0.5 then
            samples[i] = 1
        else
            samples[i] = -1
        end
        i += 1
    end
    {
        data = samples,
        sample_rate = sample_rate,
        duration = duration,
    }
end

fun audio_generate_noise(duration: f64, sample_rate: i64): any
    samples = {}
    num_samples = math.floor(duration * sample_rate)
    i = 1
    while i <= num_samples
        samples[i] = math.random() * 2 - 1
        i += 1
    end
    {
        data = samples,
        sample_rate = sample_rate,
        duration = duration,
    }
end

