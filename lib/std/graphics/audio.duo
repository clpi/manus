-- std.graphics.audio — Audio playback and spatial audio
-- For sound effects and music in ward's runtime.
-- Supports WAV file loading (PCM format) and procedural waveform generation.

-- ═══════════════════════════════════════════════════════════════
-- Audio Config
-- ═══════════════════════════════════════════════════════════════

config_new(): any
    {
        sample_rate = 44100,
        channels = 2,
        buffer_size = 1024,
        format = "f32",
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Audio Buffer
-- ═══════════════════════════════════════════════════════════════

buffer_new(config: any): any
    {
        config = config,
        data = {},
        duration = 0,
    }
end

buffer_load(buffer: any, path: str): any
    f = std.io.open(path, "rb")
    if f == nil
        return {ok = false, error = "Cannot open file: " .. path}
    end

    -- Read RIFF header
    riff = std.io.read(f, 4)
    if riff != "RIFF"
        std.io.close(f)
        return {ok = false, error = "Not a WAV file (missing RIFF header)"}
    end

    -- File size (skip)
    std.io.read(f, 4)

    -- WAVE marker
    wave = std.io.read(f, 4)
    if wave != "WAVE"
        std.io.close(f)
        return {ok = false, error = "Not a WAV file (missing WAVE marker)"}
    end

    -- Parse chunks
    sample_rate = 44100
    channels = 1
    bits_per_sample = 16
    data = nil

    while true
        chunk_id = std.io.read(f, 4)
        if chunk_id == nil or std.string.len(chunk_id) < 4 break end

        -- Read chunk size (little-endian u32)
        size_bytes = std.io.read(f, 4)
        if size_bytes == nil or std.string.len(size_bytes) < 4 break end
        chunk_size = 0
        i = 1
        while i <= 4
            chunk_size = chunk_size + std.string.byte(size_bytes, i) * (256 ^ (i - 1))
            i += 1
        end

        if chunk_id == "fmt "
            -- Format chunk
            fmt_data = std.io.read(f, chunk_size)
            if fmt_data and std.string.len(fmt_data) >= 16
                audio_format = std.string.byte(fmt_data, 1) + std.string.byte(fmt_data, 2) * 256
                channels = std.string.byte(fmt_data, 3) + std.string.byte(fmt_data, 4) * 256
                sample_rate = std.string.byte(fmt_data, 5) + std.string.byte(fmt_data, 6) * 256 +
                    std.string.byte(fmt_data, 7) * 65536 + std.string.byte(fmt_data, 8) * 16777216
                bits_per_sample = std.string.byte(fmt_data, 15) + std.string.byte(fmt_data, 16) * 256
            end
        elseif chunk_id == "data"
            -- Data chunk — read raw PCM samples
            raw = std.io.read(f, chunk_size)
            if raw
                samples = {}
                bytes_per_sample = math.floor(bits_per_sample / 8)
                num_samples = math.floor(std.string.len(raw) / bytes_per_sample)
                i = 1
                while i <= num_samples
                    -- Read little-endian sample (16-bit signed)
                    if bits_per_sample == 16
                        lo = std.string.byte(raw, i * 2 - 1) or 0
                        hi = std.string.byte(raw, i * 2) or 0
                        val = lo + hi * 256
                        if val >= 32768 val = val - 65536 end
                        samples[i] = val / 32768.0
                    elseif bits_per_sample == 8
                        val = std.string.byte(raw, i) or 128
                        samples[i] = (val - 128) / 128.0
                    else
                        samples[i] = 0
                    end
                    i += 1
                end
                data = samples
            end
        else
            -- Skip unknown chunk
            std.io.read(f, chunk_size)
        end
    end

    std.io.close(f)

    if data == nil
        return {ok = false, error = "No audio data found in WAV file"}
    end

    buffer.data = data
    buffer.sample_rate = sample_rate
    buffer.channels = channels
    buffer.duration = #data / (sample_rate * channels)
    {ok = true, duration = buffer.duration, sample_rate = sample_rate, channels = channels}
end

buffer_get_duration(buffer: any): f64
    buffer.duration
end

-- ═══════════════════════════════════════════════════════════════
-- Audio Source
-- ═══════════════════════════════════════════════════════════════

source_new(buffer: any): any
    {
        buffer = buffer,
        playing = false,
        paused = false,
        loop = false,
        volume = 1.0,
        pitch = 1.0,
        position = {x = 0, y = 0, z = 0},
        velocity = {x = 0, y = 0, z = 0},
        direction = {x = 0, y = 0, z = 1},
        reference_distance = 1,
        max_distance = 100,
        rolloff = 1,
        gain = 1,
        spatial = true,
    }
end

source_play(source: any): void
    source.playing = true
    source.paused = false
end

source_pause(source: any): void
    source.paused = true
end

source_stop(source: any): void
    source.playing = false
    source.paused = false
end

source_set_volume(source: any, volume: f64): void
    source.volume = math.max(0, math.min(1, volume))
end

source_set_pitch(source: any, pitch: f64): void
    source.pitch = math.max(0.5, math.min(2, pitch))
end

source_set_loop(source: any, loop: bool): void
    source.loop = loop
end

source_set_position(source: any, x: f64, y: f64, z: f64): void
    source.position = {x = x, y = y, z = z}
end

source_set_spatial(source: any, spatial: bool): void
    source.spatial = spatial
end

-- ═══════════════════════════════════════════════════════════════
-- Audio Listener
-- ═══════════════════════════════════════════════════════════════

listener_new(): any
    {
        position = {x = 0, y = 0, z = 0},
        velocity = {x = 0, y = 0, z = 0},
        direction = {x = 0, y = 0, z = -1},
        up = {x = 0, y = 1, z = 0},
        gain = 1,
    }
end

listener_set_position(listener: any, x: f64, y: f64, z: f64): void
    listener.position = {x = x, y = y, z = z}
end

listener_set_orientation(listener: any, direction: any, up: any): void
    listener.direction = direction
    listener.up = up
end

listener_set_gain(listener: any, gain: f64): void
    listener.gain = math.max(0, math.min(1, gain))
end

-- ═══════════════════════════════════════════════════════════════
-- Audio System
-- ═══════════════════════════════════════════════════════════════

system_new(config: any): any
    {
        config = config,
        listener = listener_new(),
        sources = {},
        master_volume = 1,
        muted = false,
    }
end

system_create_source(system: any, buffer: any): any
    source = source_new(buffer)
    system.sources[#system.sources + 1] = source
    source
end

system_destroy_source(system: any, source: any): void
    i = 1
    while i <= #system.sources
        if system.sources[i] == source
            table.remove(system.sources, i)
            return
        end
        i += 1
    end
end

system_set_master_volume(system: any, volume: f64): void
    system.master_volume = math.max(0, math.min(1, volume))
end

system_set_mute(system: any, muted: bool): void
    system.muted = muted
end

-- ═══════════════════════════════════════════════════════════════
-- Audio Mixing
-- ═══════════════════════════════════════════════════════════════

audio_mix_sources(sources: any, master_volume: f64, muted: bool): any
    if muted return {} end
    
    mixed = {}
    max_samples = 0
    
    -- Find the longest source
    for source in sources
        if source.playing and source.buffer
            len = #source.buffer.data
            if len > max_samples max_samples = len end
        end
    end
    
    if max_samples == 0 return {} end
    
    -- Initialize output buffer
    i = 1
    while i <= max_samples
        mixed[i] = 0
        i += 1
    end
    
    -- Mix all playing sources
    for source in sources
        if source.playing and source.buffer
            vol = (source.current_volume or source.volume) * master_volume
            pitch = source.pitch or 1.0
            
            -- Mix samples with volume and pitch adjustment
            i = 1
            while i <= max_samples
                -- Get sample index with pitch adjustment
                sample_idx = math.floor((i - 1) * pitch) + 1
                if sample_idx <= #source.buffer.data
                    sample = source.buffer.data[sample_idx]
                    mixed[i] = mixed[i] + sample * vol
                end
                i += 1
            end
        end
    end
    
    -- Clamp output to [-1, 1]
    i = 1
    while i <= max_samples
        if mixed[i] > 1 mixed[i] = 1 end
        if mixed[i] < -1 mixed[i] = -1 end
        i += 1
    end
    
    mixed
end

system_update(system: any, delta_time: f64): void
    -- Process audio sources and apply spatial effects
    for source in system.sources
        if source.playing and not source.paused
            -- Update playback position
            source.position = source.position + delta_time
            
            -- Apply volume falloff based on distance (if spatial)
            if source.spatial and source.listener
                dx = source.x - source.listener.x
                dy = source.y - source.listener.y
                dz = source.z - source.listener.z
                distance = math.sqrt(dx * dx + dy * dy + dz * dz)
                
                -- Simple inverse distance falloff
                if distance > 1
                    source.current_volume = source.volume / distance
                else
                    source.current_volume = source.volume
                end
                
                -- Apply Doppler effect (simplified)
                relative_velocity = (source.vx or 0) * dx + (source.vy or 0) * dy + (source.vz or 0) * dz
                doppler_factor = 1.0 - relative_velocity / 343.0  -- Speed of sound
                source.pitch = source.base_pitch * doppler_factor
            end
            
            -- Check if source has finished playing
            if source.duration > 0 and source.position >= source.duration
                if source.loop
                    source.position = 0
                else
                    source.playing = false
                end
            end
        end
    end
    
    -- Update mixer output
    system.output = audio_mix_sources(system.sources, system.master_volume, system.muted)
end

-- ═══════════════════════════════════════════════════════════════
-- Sound Generation
-- ═══════════════════════════════════════════════════════════════

generate_sine(frequency: f64, duration: f64, sample_rate: i64): any
    samples = {}
    num_samples = math.floor(duration * sample_rate)
    i = 1
    while i <= num_samples
        t = (i - 1) / sample_rate
        samples[i] = math.sin(2 * math.pi * frequency * t)
        i += 1
    end
    {
        data = samples,
        sample_rate = sample_rate,
        duration = duration,
    }
end

generate_square(frequency: f64, duration: f64, sample_rate: i64): any
    samples = {}
    num_samples = math.floor(duration * sample_rate)
    i = 1
    while i <= num_samples
        t = (i - 1) / sample_rate
        phase = (frequency * t) % 1
        if phase < 0.5
            samples[i] = 1
        else
            samples[i] = -1
        end
        i += 1
    end
    {
        data = samples,
        sample_rate = sample_rate,
        duration = duration,
    }
end

generate_noise(duration: f64, sample_rate: i64): any
    samples = {}
    num_samples = math.floor(duration * sample_rate)
    i = 1
    while i <= num_samples
        samples[i] = math.random() * 2 - 1
        i += 1
    end
    {
        data = samples,
        sample_rate = sample_rate,
        duration = duration,
    }
end

