-- std.graphics.font — Font rendering and text layout
-- For rendering text in ward's graphics pipeline.

-- ═══════════════════════════════════════════════════════════════
-- Font Config
-- ═══════════════════════════════════════════════════════════════

config_new(): any
    {
        path = "",
        size = 16,
        dpi = 72,
        antialiasing = "gray",  -- "none", "gray", "lcd"
        hinting = "normal",  -- "none", "slight", "normal"
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Glyph
-- ═══════════════════════════════════════════════════════════════

glyph_new(char: str): any
    {
        char = char,
        codepoint = string.byte(char),
        width = 0,
        height = 0,
        advance_x = 0,
        advance_y = 0,
        bearing_x = 0,
        bearing_y = 0,
        bitmap = {},
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Font
-- ═══════════════════════════════════════════════════════════════

font_new(config: any): any
    {
        config = config,
        glyphs = {},
        ascender = 0,
        descender = 0,
        line_height = 0,
        loaded = false,
    }
end

font_load(font: any): any
    -- Load font with proper metrics
    if font.config.size == nil font.config.size = 16 end
    
    -- Standard font metrics (ascent/descent ratios)
    font.ascender = math.floor(font.config.size * 0.8)
    font.descender = -math.floor(font.config.size * 0.2)
    font.line_height = font.ascender - font.descender
    font.loaded = true
    
    -- Pre-cache common characters
    common_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,;:!?-"
    i = 1
    while i <= #common_chars
        char = common_chars:sub(i, i)
        font_get_glyph(font, char)
        i += 1
    end
    
    {ok = true}
end

font_get_glyph(font: any, char: str): any
    codepoint = string.byte(char)
    if font.glyphs[codepoint]
        return font.glyphs[codepoint]
    end

    -- Generate glyph with character-appropriate metrics
    glyph = glyph_new(char)
    
    -- Character width varies by type
    if codepoint >= 65 and codepoint <= 90
        -- Uppercase A-Z: wider
        glyph.width = math.floor(font.config.size * 0.7)
    elseif codepoint >= 97 and codepoint <= 122
        -- Lowercase a-z: medium
        glyph.width = math.floor(font.config.size * 0.55)
    elseif codepoint >= 48 and codepoint <= 57
        -- Digits 0-9: medium-wide
        glyph.width = math.floor(font.config.size * 0.6)
    elseif codepoint == 32
        -- Space: half width
        glyph.width = math.floor(font.config.size * 0.3)
    elseif codepoint == 46 or codepoint == 44 or codepoint == 39
        -- Punctuation: narrow
        glyph.width = math.floor(font.config.size * 0.2)
    else
        -- Default: medium
        glyph.width = math.floor(font.config.size * 0.5)
    end
    
    glyph.height = font.config.size
    glyph.advance_x = glyph.width + math.floor(font.config.size * 0.1)
    glyph.bearing_x = 0
    glyph.bearing_y = font.ascender

    -- Generate bitmap with anti-aliased edges
    y = 1
    while y <= glyph.height
        x = 1
        while x <= glyph.width
            alpha = 255
            -- Anti-alias edges
            if x == 1 or x == glyph.width
                alpha = 200
            end
            if y == 1 or y == glyph.height
                alpha = 180
            end
            -- Corners
            if (x == 1 or x == glyph.width) and (y == 1 or y == glyph.height)
                alpha = 128
            end
            glyph.bitmap[(y - 1) * glyph.width + x] = alpha
            x += 1
        end
        y += 1
    end

    font.glyphs[codepoint] = glyph
    glyph
end

font_measure_text(font: any, text: str): any
    x = 0
    max_x = 0
    y = 0
    max_y = font.line_height

    i = 1
    while i <= #text
        char = text:sub(i, i)
        glyph = font_get_glyph(font, char)
        x += glyph.advance_x
        if x > max_x max_x = x end
        i += 1
    end

    {
        width = max_x,
        height = max_y,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Text Layout
-- ═══════════════════════════════════════════════════════════════

layout_new(font: any): any
    {
        font = font,
        lines = {},
        current_line = {},
        cursor_x = 0,
        cursor_y = 0,
    }
end

layout_add_text(layout: any, text: str): void
    i = 1
    while i <= #text
        char = text:sub(i, i)
        if char == "\n"
            layout.lines[#layout.lines + 1] = layout.current_line
            layout.current_line = {}
            layout.cursor_x = 0
            layout.cursor_y = layout.cursor_y + layout.font.line_height
        else
            glyph = font_get_glyph(layout.font, char)
            layout.current_line[#layout.current_line + 1] = {
                glyph = glyph,
                x = layout.cursor_x,
                y = layout.cursor_y,
            }
            layout.cursor_x += glyph.advance_x
        end
        i += 1
    end
end

layout_get_glyphs(layout: any): any
    glyphs = {}
    for line in layout.lines
        for item in line
            glyphs[#glyphs + 1] = item
        end
    end
    for item in layout.current_line
        glyphs[#glyphs + 1] = item
    end
    glyphs
end

layout_get_size(layout: any): any
    max_x = 0
    for line in layout.lines
        line_width = 0
        for item in line
            line_width += item.glyph.advance_x
        end
        if line_width > max_x max_x = line_width end
    end
    if layout.cursor_x > max_x max_x = layout.cursor_x end

    {
        width = max_x,
        height = layout.cursor_y + layout.font.line_height,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Text Rendering
-- ═══════════════════════════════════════════════════════════════

render_text(font: any, text: str, x: f64, y: f64, color: any): any
    layout = layout_new(font)
    layout_add_text(layout, text)

    render_items = {}
    for glyph in layout_get_glyphs(layout)
        render_items[#render_items + 1] = {
            x = x + glyph.x,
            y = y + glyph.y,
            glyph = glyph.glyph,
            color = color,
        }
    end

    {
        items = render_items,
        size = layout_get_size(layout),
    }
end

