-- std.graphics.animation — Animation and keyframe system
-- For character animation, procedural motion, and visual effects.

-- ═══════════════════════════════════════════════════════════════
-- Keyframe
-- ═══════════════════════════════════════════════════════════════

keyframe_new(time: f64, value: any): any
    {
        time = time,
        value = value,
        easing = "linear",
    }
end

keyframe_set_easing(kf: any, easing: str): any
    kf.easing = easing
    kf
end

-- ═══════════════════════════════════════════════════════════════
-- Animation Curve
-- ═══════════════════════════════════════════════════════════════

animation_curve_new(name: str): any
    {
        name = name,
        keyframes = {},
        duration = 0,
        loop = false,
        ping_pong = false,
    }
end

animation_curve_add_keyframe(curve: any, time: f64, value: any): void
    kf = keyframe_new(time, value)
    curve.keyframes[#curve.keyframes + 1] = kf

    -- Sort by time
    table.sort(curve.keyframes, fun(a: any, b: any): any a.time < b.time)

    -- Update duration
    if time > curve.duration
        curve.duration = time
    end
end

animation_curve_set_keyframe_easing(curve: any, index: i64, easing: str): void
    if curve.keyframes[index]
        curve.keyframes[index].easing = easing
    end
end

animation_curve_evaluate(curve: any, time: f64): any
    if #curve.keyframes == 0 return nil end
    if #curve.keyframes == 1 return curve.keyframes[1].value end

    -- Handle loop/ping-pong
    if curve.loop
        time = time % curve.duration
    elseif curve.ping_pong
        cycle = math.floor(time / curve.duration)
        time = time % curve.duration
        if cycle % 2 == 1
            time = curve.duration - time
        end
    end

    -- Find surrounding keyframes
    prev = curve.keyframes[1]
    nxt = curve.keyframes[#curve.keyframes]

    for i = 1, #curve.keyframes - 1
        if time >= curve.keyframes[i].time and time <= curve.keyframes[i + 1].time
            prev = curve.keyframes[i]
            nxt = curve.keyframes[i + 1]
            break
        end
    end

    -- Calculate interpolation factor
    if nxt.time == prev.time return prev.value end
    t = (time - prev.time) / (nxt.time - prev.time)

    -- Apply easing
    t = apply_easing(t, nxt.easing)

    -- Interpolate value
    interpolate_values(prev.value, nxt.value, t)
end

animation_curve_get_duration(curve: any): f64
    curve.duration
end

animation_curve_set_loop(curve: any, loop: bool): void
    curve.loop = loop
end

animation_curve_set_ping_pong(curve: any, ping_pong: bool): void
    curve.ping_pong = ping_pong
end

-- ═══════════════════════════════════════════════════════════════
-- Animation Clip
-- ═══════════════════════════════════════════════════════════════

animation_clip_new(name: str): any
    {
        name = name,
        curves = {},
        duration = 0,
        fps = 30,
    }
end

animation_clip_add_curve(clip: any, curve: any): void
    clip.curves[curve.name] = curve
    if curve.duration > clip.duration
        clip.duration = curve.duration
    end
end

animation_clip_evaluate(clip: any, time: f64): any
    result = {}
    for name, curve in clip.curves
        result[name] = animation_curve_evaluate(curve, time)
    end
    result
end

animation_clip_set_fps(clip: any, fps: i64): void
    clip.fps = fps
end

-- ═══════════════════════════════════════════════════════════════
-- Animation Player
-- ═══════════════════════════════════════════════════════════════

animation_player_new(): any
    {
        clips = {},
        current_clip = nil,
        current_time = 0,
        playing = false,
        speed = 1.0,
        callbacks = {},
    }
end

animation_player_add_clip(player: any, clip: any): void
    player.clips[clip.name] = clip
end

animation_player_play(player: any, clip_name: str, start_time: f64): void
    player.current_clip = clip_name
    player.current_time = start_time or 0
    player.playing = true
end

animation_player_stop(player: any): void
    player.playing = false
end

animation_player_pause(player: any): void
    player.playing = false
end

animation_player_resume(player: any): void
    player.playing = true
end

animation_player_set_speed(player: any, speed: f64): void
    player.speed = speed
end

animation_player_update(player: any, delta_time: f64): any
    if not player.playing or player.current_clip == nil return nil end

    clip = player.clips[player.current_clip]
    if clip == nil return nil end

    player.current_time += delta_time * player.speed

    -- Handle end of clip
    if player.current_time > clip.duration
        if clip.curves and nxt(clip.curves)
            -- Check if any curve loops
            for curve in clip.curves
                if curve.loop
                    player.current_time = player.current_time % clip.duration
                    break
                end
            end
        else
            player.current_time = clip.duration
            player.playing = false
        end
    end

    -- Evaluate clip
    result = animation_clip_evaluate(clip, player.current_time)

    -- Trigger callbacks
    for callback in player.callbacks
        callback(result, player.current_time)
    end

    result
end

animation_player_add_callback(player: any, callback: any): void
    player.callbacks[#player.callbacks + 1] = callback
end

animation_player_get_time(player: any): f64
    player.current_time
end

animation_player_is_playing(player: any): bool
    player.playing
end

-- ═══════════════════════════════════════════════════════════════
-- Animation State Machine
-- ═══════════════════════════════════════════════════════════════

animation_state_machine_new(): any
    {
        states = {},
        current_state = nil,
        transitions = {},
    }
end

animation_state_machine_add_state(sm: any, name: str, clip_name: str): void
    sm.states[name] = {
        clip_name = clip_name,
        transitions = {},
    }
end

animation_state_machine_add_transition(sm: any, from: str, to: str, condition: any): void
    if sm.transitions[from] == nil
        sm.transitions[from] = {}
    end
    sm.transitions[from][#sm.transitions[from] + 1] = {
        to = to,
        condition = condition,
    }
end

animation_state_machine_set_state(sm: any, state_name: str): void
    sm.current_state = state_name
end

animation_state_machine_update(sm: any, params: any): any
    if sm.current_state == nil return nil end

    -- Check transitions
    transitions = sm.transitions[sm.current_state]
    if transitions
        for transition in transitions
            if transition.condition(params)
                sm.current_state = transition.to
                return {
                    transition = true,
                    from = sm.current_state,
                    to = transition.to,
                }
            end
        end
    end

    -- Return current state info
    state = sm.states[sm.current_state]
    {
        state = sm.current_state,
        clip_name = state.clip_name,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Procedural Animation
-- ═══════════════════════════════════════════════════════════════

procedural_sine(time: f64, frequency: f64, amplitude: f64, phase: f64): f64
    if frequency == nil frequency = 1 end
    if amplitude == nil amplitude = 1 end
    if phase == nil phase = 0 end
    amplitude * math.sin(2 * math.pi * frequency * time + phase)
end

procedural_noise(time: f64, frequency: f64, amplitude: f64): f64
    -- Value noise using hash-based interpolation
    if frequency == nil frequency = 1 end
    if amplitude == nil amplitude = 1 end

    t = time * frequency
    -- Integer and fractional parts
    i0 = math.floor(t)
    frac = t - i0

    -- Smoothstep interpolation (ease-in-out)
    fade = frac * frac * (3 - 2 * frac)

    -- Hash function for pseudo-random values at integer points
    _hash = fun(n: i64): f64
        h = (n * 2654435761) & 0xFFFFFFFF
        h = ((h >> 16) ~ h) & 0xFFFFFFFF
        (h & 0xFFFF) / 65535.0
    end

    v0 = _hash(i0)
    v1 = _hash(i0 + 1)

    amplitude * (v0 + fade * (v1 - v0))
end

procedural_bounce(time: f64, period: f64, height: f64): f64
    if period == nil period = 1 end
    if height == nil height = 1 end
    t = time % period
    -- Parabola
    height * (1 - (2 * t / period - 1) ^ 2)
end

procedural_wobble(time: f64, frequency: f64, damping: f64): f64
    if frequency == nil frequency = 5 end
    if damping == nil damping = 2 end
    math.exp(-damping * time) * math.cos(2 * math.pi * frequency * time)
end

-- ═══════════════════════════════════════════════════════════════
-- Utility Functions
-- ═══════════════════════════════════════════════════════════════

apply_easing(t: f64, easing: str): f64
    if easing == "linear" return t end
    if easing == "ease_in" return t * t end
    if easing == "ease_out" return t * (2 - t) end
    if easing == "ease_in_out"
        if t < 0.5
            return 2 * t * t
        else
            return -1 + (4 - 2 * t) * t
        end
    end
    if easing == "bounce"
        if t < 0.5
            return 4 * t * t
        else
            t -= 0.5
            return 1 - 8 * t * t + 2 * t
        end
    end
    t
end

interpolate_values(a: any, b: f64, t: f64): any
    if type(a) == "number"
        return a + (b - a) * t
    elseif type(a) == "table"
        result = {}
        for k, v in a
            if b[k]
                result[k] = v + (b[k] - v) * t
            else
                result[k] = v
            end
        end
        return result
    end
    a
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Keyframe
M.keyframe_new = keyframe_new
M.keyframe_set_easing = keyframe_set_easing
-- Curve
M.curve_new = animation_curve_new
M.curve_add_keyframe = animation_curve_add_keyframe
M.curve_set_keyframe_easing = animation_curve_set_keyframe_easing
M.curve_evaluate = animation_curve_evaluate
M.curve_get_duration = animation_curve_get_duration
M.curve_set_loop = animation_curve_set_loop
M.curve_set_ping_pong = animation_curve_set_ping_pong
-- Clip
M.clip_new = animation_clip_new
M.clip_add_curve = animation_clip_add_curve
M.clip_evaluate = animation_clip_evaluate
M.clip_set_fps = animation_clip_set_fps
-- Player
M.player_new = animation_player_new
M.player_add_clip = animation_player_add_clip
M.player_play = animation_player_play
M.player_stop = animation_player_stop
M.player_pause = animation_player_pause
M.player_resume = animation_player_resume
M.player_set_speed = animation_player_set_speed
M.player_update = animation_player_update
M.player_add_callback = animation_player_add_callback
M.player_get_time = animation_player_get_time
M.player_is_playing = animation_player_is_playing
-- State Machine
M.state_machine_new = animation_state_machine_new
M.state_machine_add_state = animation_state_machine_add_state
M.state_machine_add_transition = animation_state_machine_add_transition
M.state_machine_set_state = animation_state_machine_set_state
M.state_machine_update = animation_state_machine_update
-- Procedural
M.procedural_sine = procedural_sine
M.procedural_noise = procedural_noise
M.procedural_bounce = procedural_bounce
M.procedural_wobble = procedural_wobble
-- Utilities
M.apply_easing = apply_easing
M.interpolate_values = interpolate_values
M
