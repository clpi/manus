-- ═══════════════════════════════════════════════════════════════

M = {}
-- Keyframe
M.keyframe_new = keyframe_new
M.keyframe_set_easing = keyframe_set_easing
-- Curve
M.curve_new = animation_curve_new
M.curve_add_keyframe = animation_curve_add_keyframe
M.curve_set_keyframe_easing = animation_curve_set_keyframe_easing
M.curve_evaluate = animation_curve_evaluate
M.curve_get_duration = animation_curve_get_duration
M.curve_set_loop = animation_curve_set_loop
M.curve_set_ping_pong = animation_curve_set_ping_pong
-- Clip
M.clip_new = animation_clip_new
M.clip_add_curve = animation_clip_add_curve
M.clip_evaluate = animation_clip_evaluate
M.clip_set_fps = animation_clip_set_fps
-- Player
M.player_new = animation_player_new
M.player_add_clip = animation_player_add_clip
M.player_play = animation_player_play
M.player_stop = animation_player_stop
M.player_pause = animation_player_pause
M.player_resume = animation_player_resume
M.player_set_speed = animation_player_set_speed
M.player_update = animation_player_update
M.player_add_callback = animation_player_add_callback
M.player_get_time = animation_player_get_time
M.player_is_playing = animation_player_is_playing
-- State Machine
M.state_machine_new = animation_state_machine_new
M.state_machine_add_state = animation_state_machine_add_state
M.state_machine_add_transition = animation_state_machine_add_transition
M.state_machine_set_state = animation_state_machine_set_state
M.state_machine_update = animation_state_machine_update
-- Procedural
M.procedural_sine = procedural_sine
M.procedural_noise = procedural_noise
M.procedural_bounce = procedural_bounce
M.procedural_wobble = procedural_wobble
-- Utilities
M.apply_easing = apply_easing
M.interpolate_values = interpolate_values
M
