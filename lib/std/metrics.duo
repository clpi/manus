-- std.metrics — Observability: counters, gauges, histograms, timers
-- For profiling ward runtime, ML inference, and application monitoring.

-- ═══════════════════════════════════════════════════════════════
-- Counter (monotonically increasing)
-- ═══════════════════════════════════════════════════════════════

fun counter_new(name: str, help: str): any
    {
        type = "counter",
        name = name,
        help = help,
        value = 0,
        labels = {},
    }
end

fun counter_inc(c: any, amount: f64): void
    if amount == nil then amount = 1 end
    c.value += amount
end

fun counter_get(c: any): f64
    c.value
end

fun counter_reset(c: any): void
    c.value = 0
end

-- ═══════════════════════════════════════════════════════════════
-- Gauge (can go up and down)
-- ═══════════════════════════════════════════════════════════════

fun gauge_new(name: str, help: str): any
    {
        type = "gauge",
        name = name,
        help = help,
        value = 0,
    }
end

fun gauge_set(g: any, value: f64): void
    g.value = value
end

fun gauge_inc(g: any, amount: f64): void
    if amount == nil then amount = 1 end
    g.value += amount
end

fun gauge_dec(g: any, amount: f64): void
    if amount == nil then amount = 1 end
    g.value -= amount
end

fun gauge_get(g: any): f64
    g.value
end

-- ═══════════════════════════════════════════════════════════════
-- Histogram (value distribution)
-- ═══════════════════════════════════════════════════════════════

fun histogram_new(name: str, help: str, buckets: any): any
    if buckets == nil then
        buckets = {0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0}
    end
    bucket_counts = {}
    for i = 1, #buckets
        bucket_counts[i] = 0
    end
    {
        type = "histogram",
        name = name,
        help = help,
        buckets = buckets,
        bucket_counts = bucket_counts,
        count = 0,
        sum = 0,
        min = 1e30,
        max = -1e30,
    }
end

fun histogram_observe(h: any, value: f64): void
    h.count += 1
    h.sum += value
    if value < h.min then h.min = value end
    if value > h.max then h.max = value end

    for i = 1, #h.buckets
        if value <= h.buckets[i] then
            h.bucket_counts[i] += 1
        end
    end
end

fun histogram_get(h: any): any
    {
        count = h.count,
        sum = h.sum,
        mean = h.count > 0 and h.sum / h.count or 0,
        min = h.count > 0 and h.min or 0,
        max = h.count > 0 and h.max or 0,
        buckets = h.buckets,
        bucket_counts = h.bucket_counts,
    }
end

fun histogram_quantile(h: any, q: f64): f64
    if h.count == 0 then return 0 end
    target = math.floor(h.count * q)
    cumulative = 0
    for i = 1, #h.buckets
        cumulative += h.bucket_counts[i]
        if cumulative >= target then
            return h.buckets[i]
        end
    end
    h.buckets[#h.buckets]
end

fun histogram_reset(h: any): void
    h.count = 0
    h.sum = 0
    h.min = 1e30
    h.max = -1e30
    for i = 1, #h.buckets
        h.bucket_counts[i] = 0
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Timer (measure elapsed time)
-- ═══════════════════════════════════════════════════════════════

fun timer_new(name: str): any
    {
        type = "timer",
        name = name,
        histogram = histogram_new(name .. "_duration_seconds", "Duration in seconds"),
        total_time = 0,
        call_count = 0,
        start_time = nil,
    }
end

fun timer_start(t: any): void
    t.start_time = os.clock()
end

fun timer_stop(t: any): f64
    if t.start_time == nil then return 0 end
    elapsed = os.clock() - t.start_time
    t.total_time += elapsed
    t.call_count += 1
    histogram_observe(t.histogram, elapsed)
    t.start_time = nil
    elapsed
end

fun timer_elapsed(t: any): f64
    if t.start_time == nil then return 0 end
    os.clock() - t.start_time
end

fun timer_get(t: any): any
    {
        name = t.name,
        total_time = t.total_time,
        call_count = t.call_count,
        mean_time = t.call_count > 0 and t.total_time / t.call_count or 0,
        histogram = histogram_get(t.histogram),
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Registry (collect all metrics)
-- ═══════════════════════════════════════════════════════════════

fun registry_new(): any
    {
        counters = {},
        gauges = {},
        histograms = {},
        timers = {},
    }
end

fun registry_register_counter(reg: any, name: str, help: str): any
    c = counter_new(name, help)
    reg.counters[name] = c
    c
end

fun registry_register_gauge(reg: any, name: str, help: str): any
    g = gauge_new(name, help)
    reg.gauges[name] = g
    g
end

fun registry_register_histogram(reg: any, name: str, help: str, buckets: any): any
    h = histogram_new(name, help, buckets)
    reg.histograms[name] = h
    h
end

fun registry_register_timer(reg: any, name: str): any
    t = timer_new(name)
    reg.timers[name] = t
    t
end

fun registry_summary(reg: any): any
    summary = {}
    for name, c in reg.counters
        summary[name] = {type = "counter", value = c.value}
    end
    for name, g in reg.gauges
        summary[name] = {type = "gauge", value = g.value}
    end
    for name, h in reg.histograms
        summary[name] = {type = "histogram", value = histogram_get(h)}
    end
    for name, t in reg.timers
        summary[name] = {type = "timer", value = timer_get(t)}
    end
    summary
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Counter
M.counter_new = counter_new
M.counter_inc = counter_inc
M.counter_get = counter_get
M.counter_reset = counter_reset
-- Gauge
M.gauge_new = gauge_new
M.gauge_set = gauge_set
M.gauge_inc = gauge_inc
M.gauge_dec = gauge_dec
M.gauge_get = gauge_get
-- Histogram
M.histogram_new = histogram_new
M.histogram_observe = histogram_observe
M.histogram_get = histogram_get
M.histogram_quantile = histogram_quantile
M.histogram_reset = histogram_reset
-- Timer
M.timer_new = timer_new
M.timer_start = timer_start
M.timer_stop = timer_stop
M.timer_elapsed = timer_elapsed
M.timer_get = timer_get
-- Registry
M.registry_new = registry_new
M.registry_register_counter = registry_register_counter
M.registry_register_gauge = registry_register_gauge
M.registry_register_histogram = registry_register_histogram
M.registry_register_timer = registry_register_timer
M.registry_summary = registry_summary
M
