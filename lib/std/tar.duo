-- std.tar — basic TAR archive wrapper

proc = req("std.proc")

create(archive_path: str, source_dir: str): bool
    cmd = "tar -cf " .. archive_path .. " -C " .. source_dir .. " ."
    rc = proc.exec(cmd)
    rc == 0
end

extract(archive_path: str, dest_dir: str): bool
    -- Ensure destination exists
    proc.exec("mkdir -p " .. dest_dir)
    cmd = "tar -xf " .. archive_path .. " -C " .. dest_dir
    rc = proc.exec(cmd)
    rc == 0
end

M = {}
M.create = create
M.extract = extract
M
