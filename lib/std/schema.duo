-- std.schema — Declarative data validation framework
-- Define schemas as data, validate values against them.
-- Critical for: API request/response validation, config validation,
-- data pipeline contracts, ML input shape/type checking.

-- ═══════════════════════════════════════════════════════════════
-- Schema constructors
-- ═══════════════════════════════════════════════════════════════

any_type(): any
    {type = "any"}
end

string(): any
    {type = "string"}
end

integer(): any
    {type = "integer"}
end

number(): any
    {type = "number"}
end

boolean(): any
    {type = "boolean"}
end

array(item_schema: any): any
    {type = "array", items = item_schema}
end

map_(val_schema: any): any
    {type = "map", values = val_schema}
end

optional(inner: any): any
    {type = "optional", inner = inner}
end

one_of(...variants): any
    {type = "one_of", variants = variants}
end

-- ═══════════════════════════════════════════════════════════════
-- Constraint modifiers
-- ═══════════════════════════════════════════════════════════════

min_length(s: any, n: i64): any
    s.min_length = n
    s
end

max_length(s: any, n: i64): any
    s.max_length = n
    s
end

pattern(s: any, pat: str): any
    s.pattern = pat
    s
end

min_val(s: any, v: any): any
    s.min_val = v
    s
end

max_val(s: any, v: any): any
    s.max_val = v
    s
end

enum_(...values): any
    vals = {}
    i = 1
    while i <= rawlen(values)
        vals[rawlen(vals) + 1] = values[i]
        i += 1
    end
    {type = "enum", values = vals}
end

shape(fields: any): any
    {type = "shape", fields = fields}
end

-- ═══════════════════════════════════════════════════════════════
-- Validation engine
-- ═══════════════════════════════════════════════════════════════

validate(value: any, schema: any): any
    errors = {}
    ok = validate_into(value, schema, "", errors)
    if ok return {ok = true, errors = {}} end
    {ok = false, errors = errors}
end

validate_into(value: any, schema: any, path: str, errors: any): bool
    if schema == nil return true end
    t = schema.type
    if t == "any" return true end
    if t == "optional"
        if value == nil return true end
        return validate_into(value, schema.inner, path, errors)
    end
    if value == nil
        errors[rawlen(errors) + 1] = {path = path, message = "required"}
        return false
    end
    if t == "string"
        if type(value) != "string"
            errors[rawlen(errors) + 1] = {path = path, message = "expected string, got " .. type(value)}
            return false
        end
        return check_string_constraints(value, schema, path, errors)
    end
    if t == "integer"
        if type(value) != "number" or value != math.floor(value)
            errors[rawlen(errors) + 1] = {path = path, message = "expected integer"}
            return false
        end
        return check_number_constraints(value, schema, path, errors)
    end
    if t == "number"
        if type(value) != "number"
            errors[rawlen(errors) + 1] = {path = path, message = "expected number"}
            return false
        end
        return check_number_constraints(value, schema, path, errors)
    end
    if t == "boolean"
        if type(value) != "boolean"
            errors[rawlen(errors) + 1] = {path = path, message = "expected boolean"}
            return false
        end
        return true
    end
    if t == "enum"
        i = 1
        while i <= rawlen(schema.values)
            if value == schema.values[i] return true end
            i += 1
        end
        errors[rawlen(errors) + 1] = {path = path, message = "invalid enum value"}
        return false
    end
    if t == "array"
        if type(value) != "table"
            errors[rawlen(errors) + 1] = {path = path, message = "expected array"}
            return false
        end
        ok = true
        i = 1
        while i <= rawlen(value)
            if schema.items != nil
                if not validate_into(value[i], schema.items, path .. "[" .. tostring(i) .. "]", errors)
                    ok = false
                end
            end
            i += 1
        end
        return ok
    end
    if t == "map"
        if type(value) != "table"
            errors[rawlen(errors) + 1] = {path = path, message = "expected map"}
            return false
        end
        if schema.values != nil
            ok = true
            for k, v in value
                if not validate_into(v, schema.values, path .. "." .. tostring(k), errors)
                    ok = false
                end
            end
            return ok
        end
        return true
    end
    if t == "one_of"
        i = 1
        while i <= rawlen(schema.variants)
            sub_errors = {}
            if validate_into(value, schema.variants[i], path, sub_errors) return true end
            i += 1
        end
        errors[rawlen(errors) + 1] = {path = path, message = "no matching variant"}
        return false
    end
    if t == "shape"
        if type(value) != "table"
            errors[rawlen(errors) + 1] = {path = path, message = "expected object"}
            return false
        end
        ok = true
        for fname, fschema in schema.fields
            fpath = path .. "." .. fname
            fval = value[fname]
            if fval == nil and not is_optional(fschema)
                errors[rawlen(errors) + 1] = {path = fpath, message = "required field missing"}
                ok = false
            elseif fval != nil
                if not validate_into(fval, fschema, fpath, errors)
                    ok = false
                end
            end
        end
        return ok
    end
    true
end

is_optional(s: any): bool
    if s == nil return false end
    s.type == "optional"
end

check_string_constraints(v: str, s: any, path: str, errors: any): bool
    ok = true
    if s.min_length != nil and string.len(v) < s.min_length
        errors[rawlen(errors) + 1] = {path = path, message = "min length " .. tostring(s.min_length)}
        ok = false
    end
    if s.max_length != nil and string.len(v) > s.max_length
        errors[rawlen(errors) + 1] = {path = path, message = "max length " .. tostring(s.max_length)}
        ok = false
    end
    if s.pattern != nil
        if string.find(v, s.pattern, 1, true) == nil
            errors[rawlen(errors) + 1] = {path = path, message = "pattern mismatch"}
            ok = false
        end
    end
    ok
end

check_number_constraints(v: any, s: any, path: str, errors: any): bool
    ok = true
    if s.min_val != nil and v < s.min_val
        errors[rawlen(errors) + 1] = {path = path, message = "min value " .. tostring(s.min_val)}
        ok = false
    end
    if s.max_val != nil and v > s.max_val
        errors[rawlen(errors) + 1] = {path = path, message = "max value " .. tostring(s.max_val)}
        ok = false
    end
    ok
end

-- ═══════════════════════════════════════════════════════════════
-- Convenience
-- ═══════════════════════════════════════════════════════════════

check(value: any, schema: any): bool
    validate(value, schema).ok
end

errors_str(result: any): str
    if result.ok return "" end
    parts = {}
    i = 1
    while i <= rawlen(result.errors)
        e = result.errors[i]
        msg = e.path
        if msg != "" msg = msg .. ": " else msg = "" end
        parts[rawlen(parts) + 1] = msg .. e.message
        i += 1
    end
    table.concat(parts, "; ")
end

merge(base: any, extension: any): any
    if base.type != "shape" or extension.type != "shape"
        return extension
    end
    merged = {}
    for k, v in base.fields
        merged[k] = v
    end
    for k, v in extension.fields
        merged[k] = v
    end
    shape(merged)
end
