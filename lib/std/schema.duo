-- std.schema — Declarative data validation framework
-- Define schemas as data, validate values against them.
-- Critical for: API request/response validation, config validation,
-- data pipeline contracts, ML input shape/type checking.

-- ═══════════════════════════════════════════════════════════════
-- Schema constructors
-- ═══════════════════════════════════════════════════════════════

fun any_type(): any
    {type = "any"}
end

fun string(): any
    {type = "string"}
end

fun integer(): any
    {type = "integer"}
end

fun number(): any
    {type = "number"}
end

fun boolean(): any
    {type = "boolean"}
end

fun array(item_schema: any): any
    {type = "array", items = item_schema}
end

fun map_(val_schema: any): any
    {type = "map", values = val_schema}
end

fun optional(inner: any): any
    {type = "optional", inner = inner}
end

fun one_of(...variants): any
    {type = "one_of", variants = variants}
end

-- ═══════════════════════════════════════════════════════════════
-- Constraint modifiers
-- ═══════════════════════════════════════════════════════════════

fun min_length(s: any, n: i64): any
    s.min_length = n
    s
end

fun max_length(s: any, n: i64): any
    s.max_length = n
    s
end

fun pattern(s: any, pat: str): any
    s.pattern = pat
    s
end

fun min_val(s: any, v: any): any
    s.min_val = v
    s
end

fun max_val(s: any, v: any): any
    s.max_val = v
    s
end

fun enum_(...values): any
    vals = {}
    i = 1
    while i <= rawlen(values)
        vals[rawlen(vals) + 1] = values[i]
        i += 1
    end
    {type = "enum", values = vals}
end

fun shape(fields: any): any
    {type = "shape", fields = fields}
end

-- ═══════════════════════════════════════════════════════════════
-- Validation engine
-- ═══════════════════════════════════════════════════════════════

fun validate(value: any, schema: any): any
    errors = {}
    ok = validate_into(value, schema, "", errors)
    if ok then return {ok = true, errors = {}} end
    {ok = false, errors = errors}
end

fun validate_into(value: any, schema: any, path: str, errors: any): bool
    if schema == nil then return true end
    t = schema.type
    if t == "any" then return true end
    if t == "optional" then
        if value == nil then return true end
        return validate_into(value, schema.inner, path, errors)
    end
    if value == nil then
        errors[rawlen(errors) + 1] = {path = path, message = "required"}
        return false
    end
    if t == "string" then
        if type(value) ~= "string" then
            errors[rawlen(errors) + 1] = {path = path, message = "expected string, got " .. type(value)}
            return false
        end
        return check_string_constraints(value, schema, path, errors)
    end
    if t == "integer" then
        if type(value) ~= "number" or value ~= math.floor(value) then
            errors[rawlen(errors) + 1] = {path = path, message = "expected integer"}
            return false
        end
        return check_number_constraints(value, schema, path, errors)
    end
    if t == "number" then
        if type(value) ~= "number" then
            errors[rawlen(errors) + 1] = {path = path, message = "expected number"}
            return false
        end
        return check_number_constraints(value, schema, path, errors)
    end
    if t == "boolean" then
        if type(value) ~= "boolean" then
            errors[rawlen(errors) + 1] = {path = path, message = "expected boolean"}
            return false
        end
        return true
    end
    if t == "enum" then
        i = 1
        while i <= rawlen(schema.values)
            if value == schema.values[i] then return true end
            i += 1
        end
        errors[rawlen(errors) + 1] = {path = path, message = "invalid enum value"}
        return false
    end
    if t == "array" then
        if type(value) ~= "table" then
            errors[rawlen(errors) + 1] = {path = path, message = "expected array"}
            return false
        end
        ok = true
        i = 1
        while i <= rawlen(value)
            if schema.items ~= nil then
                if not validate_into(value[i], schema.items, path .. "[" .. tostring(i) .. "]", errors) then
                    ok = false
                end
            end
            i += 1
        end
        return ok
    end
    if t == "map" then
        if type(value) ~= "table" then
            errors[rawlen(errors) + 1] = {path = path, message = "expected map"}
            return false
        end
        if schema.values ~= nil then
            ok = true
            for k, v in value
                if not validate_into(v, schema.values, path .. "." .. tostring(k), errors) then
                    ok = false
                end
            end
            return ok
        end
        return true
    end
    if t == "one_of" then
        i = 1
        while i <= rawlen(schema.variants)
            sub_errors = {}
            if validate_into(value, schema.variants[i], path, sub_errors) then return true end
            i += 1
        end
        errors[rawlen(errors) + 1] = {path = path, message = "no matching variant"}
        return false
    end
    if t == "shape" then
        if type(value) ~= "table" then
            errors[rawlen(errors) + 1] = {path = path, message = "expected object"}
            return false
        end
        ok = true
        for fname, fschema in schema.fields
            fpath = path .. "." .. fname
            fval = value[fname]
            if fval == nil and not is_optional(fschema) then
                errors[rawlen(errors) + 1] = {path = fpath, message = "required field missing"}
                ok = false
            elseif fval ~= nil then
                if not validate_into(fval, fschema, fpath, errors) then
                    ok = false
                end
            end
        end
        return ok
    end
    true
end

fun is_optional(s: any): bool
    if s == nil then return false end
    s.type == "optional"
end

fun check_string_constraints(v: str, s: any, path: str, errors: any): bool
    ok = true
    if s.min_length ~= nil and string.len(v) < s.min_length then
        errors[rawlen(errors) + 1] = {path = path, message = "min length " .. tostring(s.min_length)}
        ok = false
    end
    if s.max_length ~= nil and string.len(v) > s.max_length then
        errors[rawlen(errors) + 1] = {path = path, message = "max length " .. tostring(s.max_length)}
        ok = false
    end
    if s.pattern ~= nil then
        if string.find(v, s.pattern, 1, true) == nil then
            errors[rawlen(errors) + 1] = {path = path, message = "pattern mismatch"}
            ok = false
        end
    end
    ok
end

fun check_number_constraints(v: any, s: any, path: str, errors: any): bool
    ok = true
    if s.min_val ~= nil and v < s.min_val then
        errors[rawlen(errors) + 1] = {path = path, message = "min value " .. tostring(s.min_val)}
        ok = false
    end
    if s.max_val ~= nil and v > s.max_val then
        errors[rawlen(errors) + 1] = {path = path, message = "max value " .. tostring(s.max_val)}
        ok = false
    end
    ok
end

-- ═══════════════════════════════════════════════════════════════
-- Convenience
-- ═══════════════════════════════════════════════════════════════

fun check(value: any, schema: any): bool
    validate(value, schema).ok
end

fun errors_str(result: any): str
    if result.ok then return "" end
    parts = {}
    i = 1
    while i <= rawlen(result.errors)
        e = result.errors[i]
        msg = e.path
        if msg ~= "" then msg = msg .. ": " else msg = "" end
        parts[rawlen(parts) + 1] = msg .. e.message
        i += 1
    end
    table.concat(parts, "; ")
end

fun merge(base: any, extension: any): any
    if base.type ~= "shape" or extension.type ~= "shape" then
        return extension
    end
    merged = {}
    for k, v in base.fields
        merged[k] = v
    end
    for k, v in extension.fields
        merged[k] = v
    end
    shape(merged)
end
