-- std.crypto — cryptographic hash and encoding utilities

global crypto_sha = req "std.crypto.sha"
global hash_sha512 = req "std.hash.sha512"

fun sha1(s: str): str
    crypto_sha.sha1(s)
end

fun sha256(s: str): str
    crypto_sha.sha256(s)
end

fun sha512(s: str): str
    hash_sha512.sha512(s)
end

fun base64_encode(s: str): str
    b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    padded = s
    while #padded % 3 ~= 0
        padded = padded .. "\0"
    end
    out = {}
    for i = 1, string.len(padded), 3
        b1 = string.byte(padded, i)
        b2 = string.byte(padded, i + 1)
        b3 = string.byte(padded, i + 2)
        triple = (b1 * 65536) + (b2 * 256) + b3
        c1 = string.sub(b64chars, math.floor(triple / 262144) + 1, math.floor(triple / 262144) + 1)
        c2 = string.sub(b64chars, math.floor((triple % 262144) / 4096) + 1, math.floor((triple % 262144) / 4096) + 1)
        c3 = string.sub(b64chars, math.floor((triple % 4096) / 64) + 1, math.floor((triple % 4096) / 64) + 1)
        c4 = string.sub(b64chars, (triple % 64) + 1, (triple % 64) + 1)
        out[rawlen(out) + 1] = c1 .. c2 .. c3 .. c4
    end
    table.concat(out)
end

fun base64_decode(s: str): str
    b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    out = {}
    clean = string.gsub(s, "[^A-Za-z0-9+/=]", "")
    while #clean % 4 ~= 0
        clean = clean .. "="
    end
    for i = 1, string.len(clean), 4
        c1v = 0; c2v = 0; c3v = 0; c4v = 0
        for j = 1, 64
            if string.sub(b64chars, j, j) == string.sub(clean, i, i) then c1v = j - 1 end
            if string.sub(b64chars, j, j) == string.sub(clean, i + 1, i + 1) then c2v = j - 1 end
            if string.sub(b64chars, j, j) == string.sub(clean, i + 2, i + 2) then c3v = j - 1 end
            if string.sub(b64chars, j, j) == string.sub(clean, i + 3, i + 3) then c4v = j - 1 end
        end
        triple = c1v * 262144 + c2v * 4096 + c3v * 64 + c4v
        b1 = math.floor(triple / 65536)
        b2 = math.floor((triple % 65536) / 256)
        b3 = triple % 256
        if c3v ~= -1 and string.sub(clean, i + 2, i + 2) ~= "=" then out[rawlen(out) + 1] = string.char(b1) end
        if c4v ~= -1 and string.sub(clean, i + 3, i + 3) ~= "=" then out[rawlen(out) + 1] = string.char(b2) end
        if string.sub(clean, i + 4, i + 4) ~= "=" then out[rawlen(out) + 1] = string.char(b3) end
    end
    table.concat(out)
end

fun xor_encrypt(s: str, key: str): str
    out = ""
    key_len = string.len(key)
    for i = 1, string.len(s)
        sc = string.byte(s, i)
        kc = string.byte(key, ((i - 1) % key_len) + 1)
        out = out .. string.char(sc ~ kc)
    end
    out
end

fun hex_encode(s: str): str
    out = ""
    for i = 1, string.len(s)
        out = out .. string.format("%02X", string.byte(s, i))
    end
    out
end

M = {}
M.sha1 = sha1
M.sha256 = sha256
M.sha512 = sha512
M.base64_encode = base64_encode
M.base64_decode = base64_decode
M.xor_encrypt = xor_encrypt
M.hex_encode = hex_encode
M
