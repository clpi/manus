-- std.sync_once — Once (mirrors Go's sync.Once)
-- Ensures a function is called exactly once, even across concurrent calls.

-- new_once: create a new Once.
fun new_once(): any
    {done = false, f = nil}
end

-- do_fn: call fn exactly once. Subsequent calls are no-ops.
fun do_fn(o: any, fn: any): any
    if o.done then return nil end
    o.done = true
    fn()
end

-- do_once_with_result: call fn once and cache its result.
fun do_once_with_result(o: any, fn: any): any
    if o.done then return o.result end
    o.done = true
    o.result = fn()
    o.result
end

-- reset: reset the Once so it can fire again.
fun reset(o: any): void
    o.done = false
    o.result = nil
end

M = {}
M.new_once = new_once
M.do = do_fn
M.do_with_result = do_once_with_result
M.reset = reset
M