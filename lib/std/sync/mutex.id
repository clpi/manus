-- std.sync_mutex — Mutex and RWMutex (mirrors Go's sync)
-- In Duo (cooperative single-thread), a Mutex is a simple flag. Since there
-- is no true OS-level preemption, these are advisory locks for coordinating
-- coroutines rather than threads.

-- new_mutex: create a new Mutex.
new_mutex(): any
    {locked = false}
end

-- lock: acquire the mutex. If already locked, yield until available.
lock(m: any): void
    while m.locked
        co = require "std.coroutine"
        co.yield_()
    end
    m.locked = true
end

-- unlock: release the mutex.
unlock(m: any): void
    m.locked = false
end

-- try_lock: attempt to acquire the mutex without blocking. Returns true if acquired.
try_lock(m: any): bool
    if m.locked return false end
    m.locked = true
    true
end

-- new_rwmutex: create a new RWMutex.
new_rwmutex(): any
    {writers = 0, readers = 0, write_locked = false}
end

-- rlock: acquire a read lock.
rlock(m: any): void
    while m.write_locked
        co = require "std.coroutine"
        co.yield_()
    end
    m.readers = m.readers + 1
end

-- runlock: release a read lock.
runlock(m: any): void
    m.readers = m.readers - 1
    if m.readers < 0 m.readers = 0 end
end

-- wlock: acquire a write lock.
wlock(m: any): void
    while m.write_locked or m.readers > 0
        co = require "std.coroutine"
        co.yield_()
    end
    m.write_locked = true
end

-- wunlock: release a write lock.
wunlock(m: any): void
    m.write_locked = false
end
