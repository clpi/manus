stopwatch_new() -> any
  {
    start_time = nil,
    elapsed = 0,
    running = false,
    laps = {}
  }
end
stopwatch_start(sw: any) -> void
  if sw.running
    return
  end
  sw.start_time = os.clock()
  sw.running = true
end
stopwatch_stop(sw: any) -> f64
  if not sw.running
    return sw.elapsed
  end
  sw.elapsed = sw.elapsed + os.clock() - sw.start_time
  sw.running = false
  sw.elapsed
end
stopwatch_reset(sw: any) -> void
  sw.start_time = nil
  sw.elapsed = 0
  sw.running = false
  sw.laps = {}
end
stopwatch_elapsed(sw: any) -> f64
  if not sw.running
    return sw.elapsed
  end
  sw.elapsed + os.clock() - sw.start_time
end
stopwatch_lap(sw: any) -> f64
  if not sw.running
    return 0.0
  end
  lap_time = os.clock() - sw.start_time
  sw.laps[#sw.laps + 1] = lap_time
  sw.start_time = os.clock()
  lap_time
end
stopwatch_laps(sw: any) -> any
  sw.laps
end
stopwatch_avg_lap(sw: any) -> f64
  if #sw.laps == 0
    return 0.0
  end
  total = 0
  for lap in sw.laps
    total = total + lap
  end
  total / #sw.laps
end
scoped_timer_new(name: str) -> any
  sw = stopwatch_new()
  stopwatch_start(sw)
  {
    name = name,
    stopwatch = sw
  }
end
scoped_timer_stop(st: any) -> f64
  elapsed = stopwatch_stop(st.stopwatch)
  elapsed
end
scoped_timer_elapsed(st: any) -> f64
  stopwatch_elapsed(st.stopwatch)
end
profiler_new() -> any
  {
    sections = {}
  }
end
profiler_start(profiler: any, name: str) -> void
  if profiler.sections[name] == nil
    profiler.sections[name] = {
      total = 0,
      count = 0,
      min = 1000000000000000000000000000000.0,
      max = -1000000000000000000000000000000.0,
      start_time = nil
    }
  end
  profiler.sections[name].start_time = os.clock()
end
profiler_stop(profiler: any, name: str) -> void
  section = profiler.sections[name]
  if section == nil or section.start_time == nil
    return
  end
  elapsed = os.clock() - section.start_time
  section.total = section.total + elapsed
  section.count = section.count + 1
  if elapsed < section.min
    section.min = elapsed
  end
  if elapsed > section.max
    section.max = elapsed
  end
  section.start_time = nil
end
profiler_stats(profiler: any, name: str) -> any
  section = profiler.sections[name]
  if section == nil
    return nil
  end
  {
    name = name,
    total = section.total,
    count = section.count,
    avg = section.count > 0 and section.total / section.count or 0,
    min = section.count > 0 and section.min or 0,
    max = section.count > 0 and section.max or 0
  }
end
profiler_report(profiler: any) -> any
  report = {}
  for name, section in profiler.sections
    report[#report + 1] = profiler_stats(profiler, name)
  end
  table.sort(report, (a: any, b: any) -> any
    a.total > b.total
  end)
  report
end
profiler_reset(profiler: any) -> void
  profiler.sections = {}
end
benchmark(func: any, iterations: i64) -> any
  if iterations == nil
    iterations = 1000
  end
  i = 0
  while i < math.min(iterations, 100)
    func()
    i = i + 1
  end
  times = {}
  i = 0
  while i < iterations
    start = os.clock()
    func()
    elapsed = os.clock() - start
    times[#times + 1] = elapsed
    i = i + 1
  end
  table.sort(times)
  total = 0
  for t in times
    total = total + t
  end
  {
    iterations = iterations,
    total = total,
    avg = total / iterations,
    median = times[math.floor(iterations / 2) + 1],
    min = times[1],
    max = times[iterations],
    p95 = times[math.floor(iterations * 0.95) + 1],
    p99 = times[math.floor(iterations * 0.99) + 1],
    ops_per_sec = iterations / total
  }
end
M = {}
M.stopwatch_new = stopwatch_new
M.stopwatch_start = stopwatch_start
M.stopwatch_stop = stopwatch_stop
M.stopwatch_reset = stopwatch_reset
M.stopwatch_elapsed = stopwatch_elapsed
M.stopwatch_lap = stopwatch_lap
M.stopwatch_laps = stopwatch_laps
M.stopwatch_avg_lap = stopwatch_avg_lap
M.scoped_timer_new = scoped_timer_new
M.scoped_timer_stop = scoped_timer_stop
M.scoped_timer_elapsed = scoped_timer_elapsed
M.profiler_new = profiler_new
M.profiler_start = profiler_start
M.profiler_stop = profiler_stop
M.profiler_stats = profiler_stats
M.profiler_report = profiler_report
M.profiler_reset = profiler_reset
M.benchmark = benchmark
M
