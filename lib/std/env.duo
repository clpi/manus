-- std.env — environment variable utilities

fun get(name: str): str
    v = os.getenv(name)
    if v == nil then
        ""
    end
    v
end

fun has(name: str): bool
    os.getenv(name) ~= nil
end

fun get_all(): any
    -- os.getenv() with no args returns the full environment table (Lua 5.1+).
    t = os.getenv()
    if t == nil then t = {} end
    t
end

M = {}
M.get = get
M.has = has
M.get_all = get_all
M
