-- std.env — environment variable utilities

fun std_env_get(name: str): str
    v = os.getenv(name)
    if v == nil then
        ""
    end
    v
end

fun std_env_has(name: str)
    os.getenv(name) ~= nil
end

fun std_env_get_all()
    t = {}
    -- Duo runtime does not expose os.environ; callers may populate manually.
    t
end

M = {}
M.get = std_env_get
M.has = std_env_has
M.get_all = std_env_get_all
M