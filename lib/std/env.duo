-- std.env — environment variable utilities

function std_env_get(name: str): str
    local v = os.getenv(name)
    if v == nil then
        return ""
    end
    return v
end

function std_env_has(name: str)
    return os.getenv(name) ~= nil
end

function std_env_get_all()
    local t = {}
    -- Duo runtime does not expose os.environ; callers may populate manually.
    return t
end

local M = {}
M.get = std_env_get
M.has = std_env_has
M.get_all = std_env_get_all
return M
