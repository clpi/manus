-- std.env — environment variable utilities

get(name: str): str
    v = os.getenv(name)
    if v == nil
        ""
    end
    v
end

has(name: str): bool
    os.getenv(name) != nil
end

get_all(): any
    -- os.getenv() with no args returns the full environment table (Lua 5.1+).
    t = os.getenv()
    if t == nil t = {} end
    t
end

M = {}
M.get = get
M.has = has
M.get_all = get_all
M
