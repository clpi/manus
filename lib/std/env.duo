-- std.env — environment variable utilities

fun get(name: str): str
    v = os.getenv(name)
    if v == nil then
        ""
    end
    v
end

fun has(name: str): bool
    os.getenv(name) ~= nil
end

fun get_all(): any
    t = {}
    -- Duo runtime does not expose os.environ; callers may populate manually.
    t
end

M = {}
M.get = get
M.has = has
M.get_all = get_all
M
