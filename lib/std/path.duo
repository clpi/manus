-- std.path — path manipulation utilities (POSIX-style)

join(a: str, b: str): str
    if a == ""
        b
    end
    if b == ""
        return a
    end
    if string.sub(b, 1, 1) == "/"
        return b
    end
    if string.sub(a, -1, -1) == "/"
        return a .. b
    end
    a .. "/" .. b
end

basename(p: str): str
    if p == ""
        ""
    end
    i = #p
    while i > 1 and string.sub(p, i, i) == "/"
        i -= 1
    end
    last = i
    while i > 1 and string.sub(p, i - 1, i - 1) != "/"
        i -= 1
    end
    string.sub(p, i, last)
end

dirname(p: str): str
    if p == ""
        "."
    end
    i = #p
    while i > 1 and string.sub(p, i, i) == "/"
        i -= 1
    end
    while i > 1 and string.sub(p, i - 1, i - 1) != "/"
        i -= 1
    end
    if i <= 1
        if string.sub(p, 1, 1) == "/"
            return "/"
        end
        return "."
    end
    string.sub(p, 1, i - 1)
end

extname(p: str): str
    base = basename(p)
    i = #base
    while i > 1
        if string.sub(base, i, i) == "."
            string.sub(base, i, #base)
        end
        i -= 1
    end
    ""
end

is_absolute(p: str): bool
    if p == nil or p == "" return false end
    string.sub(p, 1, 1) == "/"
end

normalize(p: str): str
    if p == nil or p == "" return "." end
    while string.find(p, "//")
        p = string.gsub(p, "//", "/")
    end
    if p != "/" and string.sub(p, -1, -1) == "/"
        p = string.sub(p, 1, -2)
    end
    p
end

