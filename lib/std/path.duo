-- std.path — path manipulation utilities (POSIX-style)

fun std_path_join(a: str, b: str): str
    if a == "" then
        b
    end
    if b == "" then
        return a
    end
    if string.sub(b, 1, 1) == "/" then
        return b
    end
    if string.sub(a, -1, -1) == "/" then
        return a .. b
    end
    a .. "/" .. b
end

fun std_path_basename(p: str): str
    if p == "" then
        ""
    end
    i = string.len(p)
    while i > 1 and string.sub(p, i, i) == "/"
        i = i - 1
    end
    last = i
    while i > 1 and string.sub(p, i - 1, i - 1) ~= "/"
        i = i - 1
    end
    string.sub(p, i, last)
end

fun std_path_dirname(p: str): str
    if p == "" then
        "."
    end
    i = string.len(p)
    while i > 1 and string.sub(p, i, i) == "/"
        i = i - 1
    end
    while i > 1 and string.sub(p, i - 1, i - 1) ~= "/"
        i = i - 1
    end
    if i <= 1 then
        if string.sub(p, 1, 1) == "/" then
            return "/"
        end
        return "."
    end
    string.sub(p, 1, i - 1)
end

fun std_path_extname(p: str): str
    base = std_path_basename(p)
    i = string.len(base)
    while i > 1
        if string.sub(base, i, i) == "." then
            string.sub(base, i, string.len(base))
        end
        i = i - 1
    end
    ""
end

M = {}
M.join = std_path_join
M.basename = std_path_basename
M.dirname = std_path_dirname
M.extname = std_path_extname
M