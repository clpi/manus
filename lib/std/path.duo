-- std.path — path manipulation utilities (POSIX-style)

fun join(a: str, b: str): str
    if a == "" then
        b
    end
    if b == "" then
        return a
    end
    if string.sub(b, 1, 1) == "/" then
        return b
    end
    if string.sub(a, -1, -1) == "/" then
        return a .. b
    end
    a .. "/" .. b
end

fun basename(p: str): str
    if p == "" then
        ""
    end
    i = string.len(p)
    while i > 1 and string.sub(p, i, i) == "/"
        i -= 1
    end
    last = i
    while i > 1 and string.sub(p, i - 1, i - 1) ~= "/"
        i -= 1
    end
    string.sub(p, i, last)
end

fun dirname(p: str): str
    if p == "" then
        "."
    end
    i = string.len(p)
    while i > 1 and string.sub(p, i, i) == "/"
        i -= 1
    end
    while i > 1 and string.sub(p, i - 1, i - 1) ~= "/"
        i -= 1
    end
    if i <= 1 then
        if string.sub(p, 1, 1) == "/" then
            return "/"
        end
        return "."
    end
    string.sub(p, 1, i - 1)
end

fun extname(p: str): str
    base = basename(p)
    i = string.len(base)
    while i > 1
        if string.sub(base, i, i) == "." then
            string.sub(base, i, string.len(base))
        end
        i -= 1
    end
    ""
end

fun is_absolute(p: str): bool
    if p == nil or p == "" then return false end
    string.sub(p, 1, 1) == "/"
end

fun normalize(p: str): str
    if p == nil or p == "" then return "." end
    while string.find(p, "//")
        p = string.gsub(p, "//", "/")
    end
    if p ~= "/" and string.sub(p, -1, -1) == "/" then
        p = string.sub(p, 1, -2)
    end
    p
end

M = {}
M.join = join
M.basename = basename
M.dirname = dirname
M.extname = extname
M.is_absolute = is_absolute
M.normalize = normalize
M
