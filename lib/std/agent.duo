-- std.agent — hooks for agentic development on Duo (compiler dev + end-user apps)
-- Primary surface: @comp.* (@meta.* / @compiler.* are aliases). Comptime strings fold to native C.

fun discover(): str
    "comp.map comp.sweep comp.derive comp.product comp.tensor comp.nfold comp.burst comp.power comp.choose comp.permute\n" ..
    "comp.template comp.generate comp.scheme comp.grammar comp.weave comp.each comp.pipeline\n" ..
    "comp.agent.catalog comp.agent.ladder comp.agent.hooks comp.agent.dedupe comp.agent.gaps comp.agent.grammar\n" ..
    "meta.* and compiler.* are compatibility aliases; prefer comp.*"
end

fun scaling_ladder(): str
    "map:O(n)\n" ..
    "derive:O(n*f)\n" ..
    "product:O(n^2)\n" ..
    "tensor:O(n^3)\n" ..
    "nfold:O(n^k)\n" ..
    "power:O(2^n)\n" ..
    "choose:O(n choose k)\n" ..
    "permute:O(n!)\n" ..
    "grammar:O(b^d)\n" ..
    "each:composition glue"
end

fun hook_index(): str
    ".agents/AGENT_CANONICAL.md — single router for all agents\n" ..
    ".agents/AGENT_COORDINATION.md — coordination buffer and Cross-Agent Gap Buffer\n" ..
    "duo_agent_session_start / duo_coordination_update / duo_agent_gaps_update\n" ..
    "std.agent — recipes, build_gates, native_policy, multiplier_for, smoke_targets\n" ..
    "std.script — Duo-first scripting; prefer over bash/python"
end

fun dedupe_policy(): str
    "1. Read .agents/AGENT_COORDINATION.md and claim before editing\n" ..
    "2. Search duo_meta_catalog before adding directives or std modules\n" ..
    "3. Extend std.agent, duo-mcp, and existing @comp.* hooks; do not fork parallel buffers\n" ..
    "4. Serialize builds with scripts/duo_lock.sh\n" ..
    "5. Use duo_coordination_update and duo_agent_gaps_update for coordination"
end

fun gaps_file(): str
    ".agents/AGENT_COORDINATION.md#cross-agent-gap-buffer"
end

fun gaps_index(): str
    "Cross-Agent Gap Buffer: .agents/AGENT_COORDINATION.md#cross-agent-gap-buffer\n" ..
    "Categories: perf native meta script agent backend\n" ..
    "MCP: duo_agent_gaps_read / duo_agent_gaps_update\n" ..
    "Policy: file expressiveness, native-lowering, scripting, backend, and coordination gaps before one-off work"
end

fun coordination_file(): str
    ".agents/AGENT_COORDINATION.md"
end

fun canonical_index_file(): str
    ".agents/AGENT_CANONICAL.md"
end

fun grammar_spec_file(): str
    "docs/GRAMMAR_SPEC.md"
end

fun grammar_index(): str
    "docs/GRAMMAR_SPEC.md — canonical GR-* rules\n" ..
    "GR-001 bare typed function declarations; fun/function deprecated in .duo\n" ..
    "GR-002 if-expressions\n" ..
    "GR-004 quoted table keys without brackets\n" ..
    "MCP: duo_grammar_spec_read / duo_grammar_spec_update"
end

fun multiplier_for(goal: str): str
    g = string.lower(goal)
    if string.find(g, "trait") or string.find(g, "derive") or string.find(g, "impl")
        return "@comp.derive / @comp.derive.all / @comp.derive.bundle — O(types×fields)"
    end
    if string.find(g, "pair") or string.find(g, "cartesian") or string.find(g, "product")
        return "@comp.product / @comp.derive.product — O(types²)"
    end
    if string.find(g, "triple") or string.find(g, "tensor")
        return "@comp.tensor / @comp.derive.tensor — O(types³)"
    end
    if string.find(g, "subset") or string.find(g, "powerset") or string.find(g, "power")
        return "@comp.power / @comp.derive.power — O(2^n)"
    end
    if string.find(g, "combination") or string.find(g, "choose") or string.find(g, "fixed subset")
        return "@comp.choose / @comp.derive.choose — O(n choose k), controlled exponential subset generation"
    end
    if string.find(g, "permute") or string.find(g, "order")
        return "@comp.permute / @comp.derive.permute — O(n!)"
    end
    if string.find(g, "compose") or string.find(g, "chain") or string.find(g, "nest") or string.find(g, "combine") or string.find(g, "glue")
        return "@comp.each(src, fn) / @comp.chain(src, fn) — composition glue: split any combinator output into fragments, re-expand each; chains any two combinators (closes the algebra)"
    end
    if string.find(g, "module") or string.find(g, "file") or string.find(g, "emit")
        return "@comp.burst → @comp.transcend → @comp.infinity → @comp.hyper"
    end
    if string.find(g, "pipeline") or string.find(g, "fuse")
        return "@comp.pipeline({ variants = ... }) — typed kernel family"
    end
    if string.find(g, "rewrite") or string.find(g, "rule")
        return "@comp.rewrite / @comp.rewrite.bundle — pattern → infinite instances"
    end
    if string.find(g, "template") or string.find(g, "parametric")
        return "@comp.template / @comp.generate — O(n) or O(ops×types) native C fragments; chain with @comp.each"
    end
    if string.find(g, "scheme") or string.find(g, "declarative")
        return "@comp.scheme(declarations, template) — pipe-separated type/fn units → O(units) C"
    end
    if string.find(g, "grammar") or string.find(g, "ebnf") or string.find(g, "language")
        return "@comp.grammar(spec, fn) — O(b^d) EBNF expansion"
    end
    if string.find(g, "weave") or string.find(g, "cross-module") or string.find(g, "cross module")
        return "@comp.weave(module, concept, fn) — O(N×M) cross-module concept sweep"
    end
    if string.find(g, "dedupe") or string.find(g, "duplicate") or string.find(g, "coord")
        return "@comp.agent.dedupe() + read .agents/AGENT_COORDINATION.md; claim before edit"
    end
    if string.find(g, "gap") or string.find(g, "script") or string.find(g, "ergonomic")
        return "@comp.agent.gaps() + .agents/AGENT_COORDINATION.md#cross-agent-gap-buffer; record finding before adding one-off tooling"
    end
    "@comp.map / @comp.sweep — O(types); stack @comp.ceiling / @comp.omni for quadratic+"
end

fun build_gates(): str
    "tier0: scripts/duo_lock.sh -- ./zig-out/bin/duo run scripts/agent_smoke.duo\n" ..
    "tier1: scripts/duo_lock.sh -- zig build unit-test --summary all\n" ..
    "tier2: scripts/duo_lock.sh -- zig build test\n" ..
    "tier3: scripts/duo_lock.sh -- zig build bench  (claim benchmarks/perf; never parallel tier3)"
end

fun native_policy(): str
    "NO lua_Value intermediaries on typed/comptime paths\n" ..
    "Hot paths: i64, f64, bool, str, typed records → direct C scalars/structs\n" ..
    "@comp.* / @meta.* fold at compile time; runtime output is native C\n" ..
    "Comptime callbacks: @comp.compile.only or comptime-only detection\n" ..
    "@comp.embed.json / @comp.wasm: module directives → const uint8_t[] globals\n" ..
    "Ultimate target: optimal machine code, not C-as-ceiling (LTO/PGO/@asm/@device)"
end

fun recipes(): str
    "N types one macro: @comp.derive.all(\"Concept\", MyDerive)\n" ..
    "N×M type pairs: @comp.derive.product(\"A\", \"B\", MyDerive)\n" ..
    "Max file emit: @comp.burst(\"A\", MyDerive, \"B\")\n" ..
    "User macro: @comp.define.derive(\"Name\", fun generate(meta) -> str ... end)\n" ..
    "Bundle traits: @comp.derive.bundle(\"Numeric\") on type\n" ..
    "Fixed-size subsets: @comp.choose(\"Concept\", 2, fn) — controlled O(n choose k) expansion\n" ..
    "Pipeline family: @comp.pipeline({ variants = \"name:ctype:init | ...\" })\n" ..
    "Compose combinators: @comp.each(@comp.power(\"C\", fn), fn2) — chains two exponential stages\n" ..
    "Constraint cartesian: @comp.generate({ ops/types/template block }) — O(ops×types)\n" ..
    "Declarative scheme: @comp.scheme(\"type T {...} | fn f(...) -> T\", template)\n" ..
    "Generate→each: @comp.each(@comp.generate(spec, body), fn) — re-expand each cartesian fragment\n" ..
    "Scheme→each: @comp.each(@comp.scheme(decls, tmpl), fn) — declarative units → fragments\n" ..
    "Full stack: examples/meta_generative_stack_showcase.duo — template/generate/scheme → each\n" ..
    "Parallel comptime: @comp.compile.thread\n" ..
    "Coordination: .agents/AGENT_COORDINATION.md; @comp.agent.dedupe(); claim before edit\n" ..
    "Gaps ledger: .agents/AGENT_COORDINATION.md#cross-agent-gap-buffer; @comp.agent.gaps(); MCP duo_agent_gaps_*\n" ..
    "Scripting: req std.script — prefer Duo over bash/python"
end

