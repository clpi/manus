-- std.zip — ZIP archive utilities

proc = req("std.proc")
fs = req("std.fs")

create(archive_path: str, source_dir: str): bool
    cmd = "cd " .. source_dir .. " && zip -r -q " .. archive_path .. " ."
    proc.exec(cmd) == 0
end

create_files(archive_path: str, files: any): bool
    if files == nil or rawlen(files) == 0 return false end
    file_args = table.concat(files, " ")
    cmd = "zip -q " .. archive_path .. " " .. file_args
    proc.exec(cmd) == 0
end

extract(archive_path: str, dest_dir: str): bool
    proc.exec("mkdir -p " .. dest_dir)
    cmd = "unzip -q " .. archive_path .. " -d " .. dest_dir
    proc.exec(cmd) == 0
end

extract_overwrite(archive_path: str, dest_dir: str): bool
    proc.exec("mkdir -p " .. dest_dir)
    cmd = "unzip -o -q " .. archive_path .. " -d " .. dest_dir
    proc.exec(cmd) == 0
end

list(archive_path: str): any
    handle = io.popen("unzip -l " .. archive_path .. " 2>/dev/null")
    if handle == nil return {} end
    output = handle:read("*a")
    handle:close()
    files = {}
    in_listing = false
    for line in output:gmatch("[^\n]+")
        if in_listing
            if line:match("^%-")
                break
            end
            name = line:match("^%s+%d+%s+%S+%s+(.+)$")
            if name and name != ""
                files[rawlen(files) + 1] = name
            end
        end
        if line:match("^%s+Length")
            in_listing = true
        end
    end
    files
end

list_detailed(archive_path: str): any
    handle = io.popen("unzip -l " .. archive_path .. " 2>/dev/null")
    if handle == nil return {} end
    output = handle:read("*a")
    handle:close()
    files = {}
    in_listing = false
    for line in output:gmatch("[^\n]+")
        if in_listing
            if line:match("^%-")
                break
            end
            size, date, time, name = line:match("^%s+(%d+)%s+(%S+)%s+(%S+)%s+(.+)$")
            if name and name != ""
                files[rawlen(files) + 1] = {
                    name = name,
                    size = tonumber(size),
                    date = date,
                    time = time,
                }
            end
        end
        if line:match("^%s+Length")
            in_listing = true
        end
    end
    files
end

info(archive_path: str): any
    if not fs.exists(archive_path) return nil end
    handle = io.popen("unzip -l " .. archive_path .. " 2>/dev/null")
    if handle == nil return nil end
    output = handle:read("*a")
    handle:close()
    total_size, file_count = output:match("(%d+)%s+files?$")
    method, compressed, ratio, flag = output:match("^%s*(%S+)%s+(%d+)%s+(%d+)%%.*$")
    return {
        path = archive_path,
        file_count = tonumber(file_count) or 0,
        total_size = tonumber(total_size) or 0,
    }
end

add_file(archive_path: str, file_path: str): bool
    cmd = "zip -q " .. archive_path .. " " .. file_path
    proc.exec(cmd) == 0
end

remove_file(archive_path: str, file_path: str): bool
    cmd = "zip -d -q " .. archive_path .. " " .. file_path
    proc.exec(cmd) == 0
end

test(archive_path: str): bool
    cmd = "unzip -t " .. archive_path .. " 2>/dev/null"
    proc.exec(cmd) == 0
end

