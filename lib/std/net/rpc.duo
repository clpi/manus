-- std.net.rpc — Remote Procedure Call (RPC) framework
-- For ward's distributed communication and service mesh.

-- ═══════════════════════════════════════════════════════════════
-- RPC Message Types
-- ═══════════════════════════════════════════════════════════════

REQUEST = 1
RESPONSE = 2
ERROR = 3
NOTIFICATION = 4

-- ═══════════════════════════════════════════════════════════════
-- RPC Message
-- ═══════════════════════════════════════════════════════════════

request_new(id: i64, method: str, params: any): any
    {
        jsonrpc = "2.0",
        id = id,
        method = method,
        params = params or {},
    }
end

response_new(id: i64, result: any): any
    {
        jsonrpc = "2.0",
        id = id,
        result = result,
    }
end

error_new(id: i64, code: i64, message: str, data: any): any
    {
        jsonrpc = "2.0",
        id = id,
        error = {
            code = code,
            message = message,
            data = data,
        },
    }
end

notification_new(method: str, params: any): any
    {
        jsonrpc = "2.0",
        method = method,
        params = params or {},
    }
end

-- ═══════════════════════════════════════════════════════════════
-- RPC Server
-- ═══════════════════════════════════════════════════════════════

server_new(): any
    {
        handlers = {},
        middleware = {},
        next_id = 1,
    }
end

server_register(server: any, method: str, handler: any): void
    server.handlers[method] = handler
end

server_add_middleware(server: any, middleware: any): void
    server.middleware[#server.middleware + 1] = middleware
end

server_handle(server: any, request: any): any
    -- Validate JSON-RPC version
    if request.jsonrpc != "2.0"
        return error_new(request.id, -32600, "Invalid Request", "Invalid JSON-RPC version")
    end

    -- Check if method exists
    handler = server.handlers[request.method]
    if handler == nil
        return error_new(request.id, -32601, "Method not found", request.method)
    end

    -- Run middleware
    context = {
        request = request,
        server = server,
    }
    for mw in server.middleware
        result = mw(context)
        if result return result end
    end

    -- Call handler
    ok, result = pcall(handler, request.params, context)
    if not ok
        return error_new(request.id, -32603, "Internal error", to(str)(result))
    end

    response_new(request.id, result)
end

server_next_id(server: any): i64
    id = server.next_id
    server.next_id += 1
    id
end

-- ═══════════════════════════════════════════════════════════════
-- RPC Client
-- ═══════════════════════════════════════════════════════════════

client_new(transport: any): any
    {
        transport = transport,
        next_id = 1,
        pending = {},
    }
end

client_call(client: any, method: str, params: any): any
    id = client.next_id
    client.next_id += 1

    request = request_new(id, method, params)

    -- Send request
    result = client.transport.send(request)
    if result.error return result end

    -- Store pending request
    client.pending[id] = {
        method = method,
        start_time = os.clock(),
    }

    {id = id, request = request}
end

client_notify(client: any, method: str, params: any): any
    notification = notification_new(method, params)
    client.transport.send(notification)
end

client_handle_response(client: any, response: any): any
    if response.id and client.pending[response.id]
        pending = client.pending[response.id]
        client.pending[response.id] = nil
        return {
            id = response.id,
            method = pending.method,
            result = response.result,
            error = response.error,
        }
    end
    {notification = response}
end

client_cancel(client: any, id: i64): void
    client.pending[id] = nil
end

client_pending_count(client: any): i64
    count = 0
    for _ in client.pending
        count += 1
    end
    count
end

-- ═══════════════════════════════════════════════════════════════
-- Transport Layer (pluggable)
-- ═══════════════════════════════════════════════════════════════

transport_http_new(url: str): any
    {
        type = "http",
        url = url,
        timeout = 30,
        headers = {},
    }
end

transport_http_send(transport: any, message: any): any
    json = req "std.encoding.json"
    net = req "std.net"
    payload = json.encode(message)
    result = net.http_post(transport.url, payload, "application/json")
    if result.error
        return {ok = false, error = result.error}
    end
    {ok = true, data = result.body}
end

transport_websocket_new(url: str): any
    {
        type = "websocket",
        url = url,
        connection = nil,
        connected = false,
    }
end

transport_websocket_send(transport: any, message: any): any
    json = req "std.encoding.json"
    net = req "std.net"
    if transport.connection == nil
        result = net.ws_connect(transport.url)
        if result.error
            return {ok = false, error = result.error}
        end
        transport.connection = result.conn
        transport.connected = true
    end
    payload = json.encode(message)
    net.ws_send(transport.connection, payload)
    {ok = true}
end

transport_tcp_new(host: str, port: i64): any
    {
        type = "tcp",
        host = host,
        port = port,
        socket = nil,
        connected = false,
    }
end

transport_tcp_send(transport: any, message: any): any
    json = req "std.encoding.json"
    net = req "std.net"
    if transport.socket == nil
        result = net.connect(transport.host, transport.port)
        if result.error
            return {ok = false, error = result.error}
        end
        transport.socket = result.socket
        transport.connected = true
    end
    payload = json.encode(message)
    net.send(transport.socket, payload)
    {ok = true}
end

-- ═══════════════════════════════════════════════════════════════
-- Error Codes
-- ═══════════════════════════════════════════════════════════════

PARSE_ERROR = -32700
INVALID_REQUEST = -32600
METHOD_NOT_FOUND = -32601
INVALID_PARAMS = -32602
INTERNAL_ERROR = -32603
SERVER_ERROR = -32000

error_code_name(code: i64): str
    codes = {
        [PARSE_ERROR] = "Parse error",
        [INVALID_REQUEST] = "Invalid Request",
        [METHOD_NOT_FOUND] = "Method not found",
        [INVALID_PARAMS] = "Invalid params",
        [INTERNAL_ERROR] = "Internal error",
        [SERVER_ERROR] = "Server error",
    }
    codes[code] or "Unknown error"
end

-- ═══════════════════════════════════════════════════════════════
-- Service Discovery
-- ═══════════════════════════════════════════════════════════════

registry_new(): any
    {
        services = {},
    }
end

registry_register(registry: any, name: str, address: str, metadata: any): void
    registry.services[name] = {
        address = address,
        metadata = metadata or {},
        registered_at = os.clock(),
    }
end

registry_unregister(registry: any, name: str): void
    registry.services[name] = nil
end

registry_discover(registry: any, name: str): any
    registry.services[name]
end

registry_discover_all(registry: any): any
    services = {}
    for name, service in registry.services
        services[#services + 1] = {name = name, address = service.address, metadata = service.metadata}
    end
    services
end

registry_heartbeat(registry: any, name: str): void
    service = registry.services[name]
    if service
        service.last_heartbeat = os.clock()
    end
end

