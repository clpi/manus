-- ═══════════════════════════════════════════════════════════════

M = {}
-- Constants
M.REQUEST = RPC_REQUEST
M.RESPONSE = RPC_RESPONSE
M.ERROR = RPC_ERROR
M.NOTIFICATION = RPC_NOTIFICATION
-- Messages
M.request_new = rpc_request_new
M.response_new = rpc_response_new
M.error_new = rpc_error_new
M.notification_new = rpc_notification_new
-- Server
M.server_new = rpc_server_new
M.server_register = rpc_server_register
M.server_add_middleware = rpc_server_add_middleware
M.server_handle = rpc_server_handle
M.server_next_id = rpc_server_next_id
-- Client
M.client_new = rpc_client_new
M.client_call = rpc_client_call
M.client_notify = rpc_client_notify
M.client_handle_response = rpc_client_handle_response
M.client_cancel = rpc_client_cancel
M.client_pending_count = rpc_client_pending_count
-- Transport
M.transport_http_new = rpc_transport_http_new
M.transport_http_send = rpc_transport_http_send
M.transport_websocket_new = rpc_transport_websocket_new
M.transport_websocket_send = rpc_transport_websocket_send
M.transport_tcp_new = rpc_transport_tcp_new
M.transport_tcp_send = rpc_transport_tcp_send
-- Error Codes
M.PARSE_ERROR = RPC_PARSE_ERROR
M.INVALID_REQUEST = RPC_INVALID_REQUEST
M.METHOD_NOT_FOUND = RPC_METHOD_NOT_FOUND
M.INVALID_PARAMS = RPC_INVALID_PARAMS
M.INTERNAL_ERROR = RPC_INTERNAL_ERROR
M.SERVER_ERROR = RPC_SERVER_ERROR
M.error_code_name = rpc_error_code_name
-- Registry
M.registry_new = rpc_registry_new
M.registry_register = rpc_registry_register
M.registry_unregister = rpc_registry_unregister
M.registry_discover = rpc_registry_discover
M.registry_discover_all = rpc_registry_discover_all
M.registry_heartbeat = rpc_registry_heartbeat
M
