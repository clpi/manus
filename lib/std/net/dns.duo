net = req("std.net")
A = 1
NS = 2
CNAME = 5
SOA = 6
MX = 15
TXT = 16
AAAA = 28
SRV = 33
PTR = 12
ANY = 255
header_new(id: i64, qr: i64, opcode: i64, aa: i64, tc: i64, rd: i64, ra: i64, z: i64, rcode: i64): any
  {
    id = id,
    qr = qr,
    opcode = opcode,
    aa = aa,
    tc = tc,
    rd = rd,
    ra = ra,
    z = z,
    rcode = rcode,
    qdcount = 0,
    ancount = 0,
    nscount = 0,
    arcount = 0
  }
end
header_encode(h: any): any
  bytes = {}
  bytes[1] = h.id >> 8 & 255
  bytes[2] = h.id & 255
  flags = h.qr << 15 | h.opcode << 11 | h.aa << 10 | h.tc << 9 | h.rd << 8 | h.ra << 7 | h.z << 4 | h.rcode
  bytes[3] = flags >> 8 & 255
  bytes[4] = flags & 255
  bytes[5] = h.qdcount >> 8 & 255
  bytes[6] = h.qdcount & 255
  bytes[7] = h.ancount >> 8 & 255
  bytes[8] = h.ancount & 255
  bytes[9] = h.nscount >> 8 & 255
  bytes[10] = h.nscount & 255
  bytes[11] = h.arcount >> 8 & 255
  bytes[12] = h.arcount & 255
  bytes
end
header_decode(data: any): any
  id = data[1] << 8 | data[2]
  flags = data[3] << 8 | data[4]
  {
    id = id,
    qr = flags >> 15 & 1,
    opcode = flags >> 11 & 15,
    aa = flags >> 10 & 1,
    tc = flags >> 9 & 1,
    rd = flags >> 8 & 1,
    ra = flags >> 7 & 1,
    z = flags >> 4 & 7,
    rcode = flags & 15,
    qdcount = data[5] << 8 | data[6],
    ancount = data[7] << 8 | data[8],
    nscount = data[9] << 8 | data[10],
    arcount = data[11] << 8 | data[12]
  }
end
name_encode(name: str): any
  bytes = {}
  pos = 1
  len = string.len(name)
  while pos <= len
    dot_pos = string.find(name, ".", pos, true)
    if dot_pos == nil
      dot_pos = len + 1
    end
    label_len = dot_pos - pos
    bytes[#bytes + 1] = label_len
    i = pos
    while i < dot_pos
      bytes[#bytes + 1] = string.byte(name, i)
      i = i + 1
    end
    pos = dot_pos + 1
  end
  bytes[#bytes + 1] = 0
  bytes
end
name_decode(data: any, pos: i64): any
  parts = {}
  jumped = false
  original_pos = pos
  while true
    if pos > #data
      break
    end
    len = data[pos]
    if len == 0
      pos = pos + 1
      break
    elseif len & 192 == 192
      if not jumped
        original_pos = original_pos + 2
      end
      pointer = (len & 63) << 8 | data[pos + 1]
      pos = pointer + 1
      jumped = true
    else
      pos = pos + 1
      label = ""
      i = 0
      while i < len
        label = label .. string.char(data[pos + i])
        i = i + 1
      end
      parts[#parts + 1] = label
      pos = pos + len
    end
  end
  name = table.concat(parts, ".")
  next_pos = jumped and original_pos or pos
  {
    name = name,
    next = next_pos
  }
end
query_new(name: str, qtype: i64): any
  crypto_rand = req("std.crypto.rand")
  id_bytes = crypto_rand.bytes(2)
  query_id = string.byte(id_bytes, 1) << 8 | string.byte(id_bytes, 2)
  {
    header = header_new(query_id, 0, 0, 0, 0, 1, 0, 0, 0),
    question = {
      name = name,
      qtype = qtype,
      qclass = 1
    }
  }
end
query_encode(q: any): any
  bytes = {}
  q.header.qdcount = 1
  header_bytes = header_encode(q.header)
  for b in header_bytes
    bytes[#bytes + 1] = b
  end
  name_bytes = name_encode(q.question.name)
  for b in name_bytes
    bytes[#bytes + 1] = b
  end
  bytes[#bytes + 1] = q.question.qtype >> 8 & 255
  bytes[#bytes + 1] = q.question.qtype & 255
  bytes[#bytes + 1] = q.question.qclass >> 8 & 255
  bytes[#bytes + 1] = q.question.qclass & 255
  bytes
end
record_decode(data: any, pos: i64): any
  result = name_decode(data, pos)
  name = result.name
  pos = result.next
  rtype = data[pos] << 8 | data[pos + 1]
  pos = pos + 2
  rclass = data[pos] << 8 | data[pos + 1]
  pos = pos + 2
  ttl = data[pos] << 24 | data[pos + 1] << 16 | data[pos + 2] << 8 | data[pos + 3]
  pos = pos + 4
  rdlength = data[pos] << 8 | data[pos + 1]
  pos = pos + 2
  rdata = nil
  if rtype == A and rdlength == 4
    rdata = to(str)(data[pos]) .. "." .. to(str)(data[pos + 1]) .. "." .. to(str)(data[pos + 2]) .. "." .. to(str)(data[pos + 3])
  elseif rtype == AAAA and rdlength == 16
    parts = {}
    i = 0
    while i < 16
      hi = data[pos + i]
      lo = data[pos + i + 1]
      parts[#parts + 1] = string.format("%02x%02x", hi, lo)
      i = i + 2
    end
    rdata = table.concat(parts, ":")
  elseif rtype == CNAME or rtype == NS or rtype == PTR
    cname = name_decode(data, pos)
    rdata = cname.name
  elseif rtype == MX
    preference = data[pos] << 8 | data[pos + 1]
    exchange = name_decode(data, pos + 2)
    rdata = {
      preference = preference,
      exchange = exchange.name
    }
  elseif rtype == TXT
    txt_len = data[pos]
    txt = ""
    i = 1
    while i <= txt_len
      txt = txt .. string.char(data[pos + i])
      i = i + 1
    end
    rdata = txt
  elseif rtype == SRV
    priority = data[pos] << 8 | data[pos + 1]
    weight = data[pos + 2] << 8 | data[pos + 3]
    port = data[pos + 4] << 8 | data[pos + 5]
    target = name_decode(data, pos + 6)
    rdata = {
      priority = priority,
      weight = weight,
      port = port,
      target = target.name
    }
  end
  pos = pos + rdlength
  {
    name = name,
    type = rtype,
    class = rclass,
    ttl = ttl,
    rdlength = rdlength,
    rdata = rdata,
    next = pos
  }
end
response_decode(data: any): any
  header = header_decode(data)
  pos = 13
  i = 0
  while i < header.qdcount
    result = name_decode(data, pos)
    pos = result.next + 4
    i = i + 1
  end
  answers = {}
  i = 0
  while i < header.ancount
    record = record_decode(data, pos)
    answers[#answers + 1] = record
    pos = record.next
    i = i + 1
  end
  authority = {}
  i = 0
  while i < header.nscount
    record = record_decode(data, pos)
    authority[#authority + 1] = record
    pos = record.next
    i = i + 1
  end
  additional = {}
  i = 0
  while i < header.arcount
    record = record_decode(data, pos)
    additional[#additional + 1] = record
    pos = record.next
    i = i + 1
  end
  {
    header = header,
    answers = answers,
    authority = authority,
    additional = additional
  }
end
resolver_new(): any
  {
    servers = {
      "8.8.8.8",
      "8.8.4.4",
      "1.1.1.1",
      "1.0.0.1"
    },
    port = 53,
    timeout = 5,
    cache = {},
    retries = 3
  }
end
resolver_set_servers(resolver: any, servers: any): void
  resolver.servers = servers
end
resolver_set_timeout(resolver: any, timeout: i64): void
  resolver.timeout = timeout
end
resolver_resolve(resolver: any, name: str, qtype: i64): any
  cache_key = name .. ":" .. to(str)(qtype)
  if resolver.cache[cache_key]
    return resolver.cache[cache_key]
  end
  if qtype == A
    ip = net.dns_resolve(name)
    if ip != nil
      result = {
        header = header_new(0, 1, 0, 0, 0, 1, 1, 0, 0),
        answers = {
          {
            name = name,
            type = A,
            class = 1,
            ttl = 300,
            rdlength = 4,
            rdata = ip,
            next = 0
          }
        },
        authority = {},
        additional = {}
      }
      resolver.cache[cache_key] = result
      return result
    end
  end
  for server in resolver.servers
    query = query_new(name, qtype)
    query_bytes = query_encode(query)
    result = {
      header = query.header,
      answers = {},
      authority = {},
      additional = {}
    }
    if result.header.rcode == 0 and #result.answers > 0
      resolver.cache[cache_key] = result
    end
    return result
  end
  {
    error = "All DNS servers failed"
  }
end
resolver_lookup_a(resolver: any, name: str): any
  result = resolver_resolve(resolver, name, A)
  if result.error
    return result
  end
  ips = {}
  for answer in result.answers
    if answer.type == A
      ips[#ips + 1] = answer.rdata
    end
  end
  {
    ips = ips
  }
end
resolver_lookup_aaaa(resolver: any, name: str): any
  result = resolver_resolve(resolver, name, AAAA)
  if result.error
    return result
  end
  ips = {}
  for answer in result.answers
    if answer.type == AAAA
      ips[#ips + 1] = answer.rdata
    end
  end
  {
    ips = ips
  }
end
resolver_lookup_mx(resolver: any, name: str): any
  result = resolver_resolve(resolver, name, MX)
  if result.error
    return result
  end
  mx_records = {}
  for answer in result.answers
    if answer.type == MX
      mx_records[#mx_records + 1] = answer.rdata
    end
  end
  table.sort(mx_records, (a: any, b: any): any
    a.preference < b.preference
  end)
  {
    records = mx_records
  }
end
resolver_lookup_cname(resolver: any, name: str): any
  result = resolver_resolve(resolver, name, CNAME)
  if result.error
    return result
  end
  for answer in result.answers
    if answer.type == CNAME
      return {
        cname = answer.rdata
      }
    end
  end
  {
    cname = nil
  }
end
resolver_flush_cache(resolver: any): void
  resolver.cache = {}
end
type_name(qtype: i64): str
  types = {
    [A] = "A",
    [NS] = "NS",
    [CNAME] = "CNAME",
    [SOA] = "SOA",
    [MX] = "MX",
    [TXT] = "TXT",
    [AAAA] = "AAAA",
    [SRV] = "SRV",
    [PTR] = "PTR",
    [ANY] = "ANY"
  }
  types[qtype] or "UNKNOWN"
end
type_from_name(name: str): i64
  types = {
    A = A,
    NS = NS,
    CNAME = CNAME,
    SOA = SOA,
    MX = MX,
    TXT = TXT,
    AAAA = AAAA,
    SRV = SRV,
    PTR = PTR,
    ANY = ANY
  }
  types[string.upper(name)] or 0
end
