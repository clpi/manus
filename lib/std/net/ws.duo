-- std.net.ws — WebSocket client and server (RFC 6455)
-- Used by ward for real-time communication and the WASM runtime's debug protocol.

-- ═══════════════════════════════════════════════════════════════
-- WebSocket frame encoding/decoding
-- ═══════════════════════════════════════════════════════════════

-- Opcodes
OP_CONTINUATION = 0x00
OP_TEXT = 0x01
OP_BINARY = 0x02
OP_CLOSE = 0x08
OP_PING = 0x09
OP_PONG = 0x0A

-- Frame types
FRAME_TEXT = 1
FRAME_BINARY = 2
FRAME_CLOSE = 8
FRAME_PING = 9
FRAME_PONG = 10

-- ═══════════════════════════════════════════════════════════════
-- Base64 utilities (must be defined before use)
-- ═══════════════════════════════════════════════════════════════

base64_encode(data: any): str
    chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    result = ""
    i = 1
    while i <= #data
        b0 = data[i]
        b1 = 0
        b2 = 0
        if i + 1 <= #data b1 = data[i + 1] end
        if i + 2 <= #data b2 = data[i + 2] end

        triplet = (b0 << 16) | (b1 << 8) | b2
        result = result .. string.char(chars:byte(((triplet >> 18) & 0x3F) + 1))
        result = result .. string.char(chars:byte(((triplet >> 12) & 0x3F) + 1))
        if i + 1 <= #data
            result = result .. string.char(chars:byte(((triplet >> 6) & 0x3F) + 1))
        else
            result = result .. "="
        end
        if i + 2 <= #data
            result = result .. string.char(chars:byte((triplet & 0x3F) + 1))
        else
            result = result .. "="
        end
        i += 3
    end
    result
end

base64_sha1(data: str): str
    -- WebSocket handshake requires base64(SHA-1(data + magic))
    sha1_hex = std.hash.sha1.sha1(data)
    -- Convert hex string to bytes
    sha1_bytes = {}
    i = 1
    while i <= #sha1_hex
        hex_pair = string.sub(sha1_hex, i, i + 1)
        sha1_bytes[#sha1_bytes + 1] = tonumber(hex_pair, 16)
        i += 2
    end
    base64_encode(sha1_bytes)
end

base64_encode_string(s: str): str
    bytes = {}
    i = 1
    while i <= #s
        bytes[#bytes + 1] = s:byte(i)
        i += 1
    end
    base64_encode(bytes)
end

-- ═══════════════════════════════════════════════════════════════
-- Frame encoding
-- ═══════════════════════════════════════════════════════════════

ws_encode_frame(opcode: i64, payload: any, mask: bool): any
    bytes = {}
    -- First byte: FIN bit + opcode
    bytes[1] = 0x80 | opcode

    -- Payload length
    len = #payload
    if len < 126
        bytes[2] = len
        if mask bytes[2] = bytes[2] | 0x80 end
    elseif len < 65536
        bytes[2] = 126
        if mask bytes[2] = bytes[2] | 0x80 end
        bytes[3] = (len >> 8) & 0xFF
        bytes[4] = len & 0xFF
    else
        bytes[2] = 127
        if mask bytes[2] = bytes[2] | 0x80 end
        i = 0
        while i < 8
            bytes[3 + i] = (len >> (56 - i * 8)) & 0xFF
            i += 1
        end
    end

    -- Masking key (if client->server) using CSPRNG
    mask_key = nil
    if mask
        key_data = std.crypto.rand.bytes(4)
        mask_key = {}
        i = 1
        while i <= 4
            mask_key[i] = key_data:byte(i)
            bytes[#bytes + 1] = mask_key[i]
            i += 1
        end
    end

    -- Payload
    i = 1
    while i <= #payload
        if mask
            bytes[#bytes + 1] = payload[i] ~ mask_key[((i - 1) % 4) + 1]
        else
            bytes[#bytes + 1] = payload[i]
        end
        i += 1
    end

    bytes
end

-- ═══════════════════════════════════════════════════════════════
-- Frame decoding
-- ═══════════════════════════════════════════════════════════════

ws_decode_frame(data: any, pos: i64): any
    if pos > #data return nil end

    byte1 = data[pos]
    byte2 = data[pos + 1]

    fin = (byte1 & 0x80) != 0
    opcode = byte1 & 0x0F
    masked = (byte2 & 0x80) != 0
    payload_len = byte2 & 0x7F

    offset = pos + 2

    -- Extended payload length
    if payload_len == 126
        payload_len = (data[offset] << 8) | data[offset + 1]
        offset += 2
    elseif payload_len == 127
        payload_len = 0
        i = 0
        while i < 8
            payload_len = payload_len | (data[offset + i] << (56 - i * 8))
            i += 1
        end
        offset += 8
    end

    -- Masking key
    mask_key = nil
    if masked
        mask_key = {data[offset], data[offset + 1], data[offset + 2], data[offset + 3]}
        offset += 4
    end

    -- Payload
    payload = {}
    i = 0
    while i < payload_len
        b = data[offset + i]
        if masked
            b = b ~ mask_key[i % 4]
        end
        payload[#payload + 1] = b
        i += 1
    end

    {
        fin = fin,
        opcode = opcode,
        masked = masked,
        payload = payload,
        next = offset + payload_len,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- WebSocket handshake (client side)
-- ═══════════════════════════════════════════════════════════════

ws_client_handshake(host: str, port: i64, path: str): str
    -- Generate random key (16 bytes base64 encoded) using CSPRNG
    key_bytes = {}
    key_data = std.crypto.rand.bytes(16)
    i = 1
    while i <= 16
        key_bytes[i] = key_data:byte(i)
        i += 1
    end
    key = base64_encode(key_bytes)

    "GET " .. path .. " HTTP/1.1\r\n"
        .. "Host: " .. host .. ":" .. to(str)(port) .. "\r\n"
        .. "Upgrade: websocket\r\n"
        .. "Connection: Upgrade\r\n"
        .. "Sec-WebSocket-Key: " .. key .. "\r\n"
        .. "Sec-WebSocket-Version: 13\r\n"
        .. "Origin: http://" .. host .. ":" .. to(str)(port) .. "\r\n"
        .. "\r\n"
end

-- ═══════════════════════════════════════════════════════════════
-- WebSocket handshake (server side)
-- ═══════════════════════════════════════════════════════════════

ws_server_handshake(request: str): str
    -- Extract Sec-WebSocket-Key
    key = string["match"](request, "Sec%-WebSocket%-Key: ([%w%+/=]+)")
    if key == nil
        return "HTTP/1.1 400 Bad Request\r\n\r\n"
    end

    -- Compute accept hash
    magic = "258EAFA5-E914-47DA-95CA-5AB9FC1B5B09"
    accept = base64_sha1(key .. magic)

    "HTTP/1.1 101 Switching Protocols\r\n"
        .. "Upgrade: websocket\r\n"
        .. "Connection: Upgrade\r\n"
        .. "Sec-WebSocket-Accept: " .. accept .. "\r\n"
        .. "\r\n"
end

-- ═══════════════════════════════════════════════════════════════
-- WebSocket message helpers
-- ═══════════════════════════════════════════════════════════════

ws_text_frame(text: str): any
    bytes = {}
    i = 1
    while i <= #text
        bytes[#bytes + 1] = text:byte(i)
        i += 1
    end
    ws_encode_frame(OP_TEXT, bytes, false)
end

ws_binary_frame(data: any): any
    ws_encode_frame(OP_BINARY, data, false)
end

ws_close_frame(code: i64, reason: str): any
    payload = {}
    payload[1] = (code >> 8) & 0xFF
    payload[2] = code & 0xFF
    if reason
        i = 1
        while i <= #reason
            payload[#payload + 1] = reason:byte(i)
            i += 1
        end
    end
    ws_encode_frame(OP_CLOSE, payload, false)
end

ws_ping_frame(data: any): any
    if data == nil data = {} end
    ws_encode_frame(OP_PING, data, false)
end

ws_pong_frame(data: any): any
    if data == nil data = {} end
    ws_encode_frame(OP_PONG, data, false)
end

-- ═══════════════════════════════════════════════════════════════
-- WebSocket connection state machine
-- ═══════════════════════════════════════════════════════════════

ws_connection_new(role: str): any
    -- role: "client" or "server"
    {
        role = role,
        state = "connecting",
        buffer = {},
        message = nil,
        close_code = nil,
        close_reason = nil,
    }
end

ws_connection_send(conn: any, opcode: i64, payload: any): any
    mask = conn.role == "client"
    ws_encode_frame(opcode, payload, mask)
end

ws_connection_receive(conn: any, data: any): any
    -- Append to buffer
    for b in data
        conn.buffer[#conn.buffer + 1] = b
    end

    -- Try to decode
    if #conn.buffer < 2 return nil end
    frame = ws_decode_frame(conn.buffer, 1)
    if frame == nil return nil end

    -- Remove consumed bytes
    new_buf = {}
    i = frame.next
    while i <= #conn.buffer
        new_buf[#new_buf + 1] = conn.buffer[i]
        i += 1
    end
    conn.buffer = new_buf

    -- Handle control frames
    if frame.opcode == OP_PING
        conn.state = "connected"
        return {type = "ping", payload = frame.payload}
    elseif frame.opcode == OP_PONG
        return {type = "pong", payload = frame.payload}
    elseif frame.opcode == OP_CLOSE
        conn.state = "closed"
        if #frame.payload >= 2
            conn.close_code = (frame.payload[1] << 8) | frame.payload[2]
        end
        return {type = "close", code = conn.close_code}
    elseif frame.opcode == OP_TEXT
        -- Convert payload to string
        parts = {}
        i = 1
        while i <= #frame.payload
            parts[#parts + 1] = string.char(frame.payload[i])
            i += 1
        end
        return {type = "text", data = table.concat(parts)}
    elseif frame.opcode == OP_BINARY
        return {type = "binary", data = frame.payload}
    end

    nil
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
M.encode_frame = ws_encode_frame
M.decode_frame = ws_decode_frame
M.client_handshake = ws_client_handshake
M.server_handshake = ws_server_handshake
M.text_frame = ws_text_frame
M.binary_frame = ws_binary_frame
M.close_frame = ws_close_frame
M.ping_frame = ws_ping_frame
M.pong_frame = ws_pong_frame
M.connection_new = ws_connection_new
M.connection_send = ws_connection_send
M.connection_receive = ws_connection_receive
-- The opcode literals are written directly here rather than referencing the
-- file-scope constants above.
--
-- Referencing them emitted bare, UNDECLARED identifiers in the generated C
-- ("use of undeclared identifier 'OP_CONTINUATION'") when this module is
-- EMBEDDED. The same constants resolve fine in a standalone program, so the
-- gap is in the embed path: a file-scope constant referenced from inside a
-- nested table of a module's export table is not resolved.
--
-- Reduced to a two-file repro, and note the correction — my first reading was
-- that only the 0x00 entry failed and that the folder treated a zero-valued
-- constant as absent. That is WRONG: a module with `ZERO = 0x00` and
-- `ONE = 0x01` referenced from `M.T = { z = ZERO, o = ONE }` fails on BOTH.
-- The value is irrelevant; the nesting and the embed path are what matter.
M.OP = {
    CONTINUATION = 0x00,
    TEXT = 0x01,
    BINARY = 0x02,
    CLOSE = 0x08,
    PING = 0x09,
    PONG = 0x0A,
}
M
