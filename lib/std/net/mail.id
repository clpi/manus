# std.net_mail — email address and message parsing (mirrors Go's net/mail)

# parse_address: parse a single email address string.
parse_address(s: str): any
    if s == nil or s == "" return nil end
    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    lt = s:find("<", 1, true)
    if lt != nil
        gt = s:find(">", lt + 1, true)
        if gt == nil return nil end
        addr = s:sub(lt + 1, gt - 1)
        name = s:sub(1, lt - 1)
        name = name:gsub("^%s+", "")
        name = name:gsub("%s+$", "")
        if #name >= 2 and name:sub(1, 1) == "\"" and name:sub(#name, #name) == "\""
            name = name:sub(2, #name - 1)
        end
        return {name = name, address = addr}
    end
    at = s:find("@", 1, true)
    if at == nil return nil end
    {name = "", address = s}
end

# parse_address_list: parse a comma-separated list of addresses.
parse_address_list(s: str): any
    if s == nil or s == "" return {} end
    out = {}
    parts = {}
    depth = 0
    start = 1
    i = 1
    while i <= #s
        ch = s:sub(i, i)
        if ch == "<" depth += 1 end
        if ch == ">" depth -= 1 end
        if ch == "," and depth == 0
            parts[parts:len() + 1] = s:sub(start, i - 1)
            start = i + 1
        end
        i += 1
    end
    parts[parts:len() + 1] = s:sub(start)
    i = 1
    while i <= parts:len()
        addr = parse_address(parts[i])
        if addr != nil out[out:len() + 1] = addr end
        i += 1
    end
    out
end

# format_address: format an address table as "Name <addr>" or "addr".
format_address(addr: any): str
    if addr == nil return "" end
    if has(.name)(addr) and addr.name != ""
        return "\"" .. addr.name .. "\" <" .. addr.address .. ">"
    end
    addr.address
end

# split_lines: helper to split a string on newlines.
split_lines(s: str): any
    if s == nil return {} end
    out = {}
    start = 1
    i = 1
    while i <= #s
        if s:byte(i) == 10
            line = s:sub(start, i - 1)
            if #line > 0 and line:byte(#line) == 13
                line = line:sub(1, #line - 1)
            end
            out[out:len() + 1] = line
            start = i + 1
        end
        i += 1
    end
    if start <= #s
        out[out:len() + 1] = s:sub(start)
    end
    out
end

# read_message: parse an RFC 5322 message into {headers = {...}, body = "..."}.
read_message(raw: str): any
    if raw == nil return {headers = {}, body = ""} end
    sep = raw:find("\r\n\r\n", 1, true)
    header_block = ""
    body = ""
    if sep == nil
        sep = raw:find("\n\n", 1, true)
        if sep == nil
            return {headers = {}, body = raw}
        end
        header_block = raw:sub(1, sep - 1)
        body = raw:sub(sep + 2)
    else
        header_block = raw:sub(1, sep - 1)
        body = raw:sub(sep + 4)
    end
    headers = {}
    lines = split_lines(header_block)
    cur_key = nil
    cur_val = ""
    i = 1
    while i <= lines:len()
        line = lines[i]
        if line:sub(1, 1) == " " or line:sub(1, 1) == "\t"
            cur_val = cur_val .. " " .. line:gsub("^%s+", "")
        else
            if cur_key != nil
                headers[cur_key:lower()] = cur_val:gsub("^%s+", "")
            end
            colon = line:find(":", 1, true)
            if colon != nil
                cur_key = line:sub(1, colon - 1)
                cur_val = line:sub(colon + 1)
            else
                cur_key = nil
            end
        end
        i += 1
    end
    if cur_key != nil
        headers[cur_key:lower()] = cur_val:gsub("^%s+", "")
    end
    return {headers = headers, body = body}
end

