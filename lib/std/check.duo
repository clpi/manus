-- std.check — rich assertion library with context and messages
-- Provides expressive assertions that print helpful diagnostics
-- on failure. Ideal for tests, preconditions, and invariants.

-- ===== Core assertions =====

-- assert: basic assertion with optional message.
assert(condition: any, message: any): bool
    if condition return true end
    msg = "assertion failed"
    if message != nil msg = msg .. ": " .. to(str)(message) end
    error(msg)
end

-- assert_eq: assert two values are equal.
assert_eq(actual: any, expected: any, message: any): bool
    if actual == expected return true end
    msg = "expected " .. to(str)(expected) .. ", got " .. to(str)(actual)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_ne: assert two values are not equal.
assert_ne(actual: any, expected: any, message: any): bool
    if actual != expected return true end
    msg = "expected values to differ, both are " .. to(str)(actual)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_true: assert value is truthy.
assert_true(value: any, message: any): bool
    if value != nil and value != false return true end
    msg = "expected truthy value, got " .. to(str)(value)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_false: assert value is falsy.
assert_false(value: any, message: any): bool
    if value == nil or value == false return true end
    msg = "expected falsy value, got " .. to(str)(value)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_nil: assert value is nil.
assert_nil(value: any, message: any): bool
    if value == nil return true end
    msg = "expected nil, got " .. to(str)(value)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_not_nil: assert value is not nil.
assert_not_nil(value: any, message: any): bool
    if value != nil return true end
    msg = "expected non-nil value"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- ===== Numeric assertions =====

-- assert_gt: assert a > b.
assert_gt(actual: any, expected: any, message: any): bool
    if actual > expected return true end
    msg = "expected " .. to(str)(actual) .. " > " .. to(str)(expected)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_gte: assert a >= b.
assert_gte(actual: any, expected: any, message: any): bool
    if actual >= expected return true end
    msg = "expected " .. to(str)(actual) .. " >= " .. to(str)(expected)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_lt: assert a < b.
assert_lt(actual: any, expected: any, message: any): bool
    if actual < expected return true end
    msg = "expected " .. to(str)(actual) .. " < " .. to(str)(expected)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_lte: assert a <= b.
assert_lte(actual: any, expected: any, message: any): bool
    if actual <= expected return true end
    msg = "expected " .. to(str)(actual) .. " <= " .. to(str)(expected)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_in_range: assert value is within [lo, hi].
assert_in_range(value: any, lo: any, hi: any, message: any): bool
    if value >= lo and value <= hi return true end
    msg = "expected " .. to(str)(value) .. " in [" .. to(str)(lo) .. ", " .. to(str)(hi) .. "]"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- ===== String assertions =====

-- assert_match: assert string matches a Lua pattern.
assert_match(str_val: any, pattern: any, message: any): bool
    if str_val == nil str_val = "" end
    found = string.find(str_val, pattern, 1)
    if found != nil return true end
    msg = "expected string to match pattern '" .. pattern .. "', got '" .. to(str)(str_val) .. "'"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_contains: assert string contains substring.
assert_contains(haystack: any, needle: any, message: any): bool
    if haystack == nil haystack = "" end
    if string.find(haystack, needle, 1, true) != nil return true end
    msg = "expected string to contain '" .. to(str)(needle) .. "'"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_starts_with: assert string starts with prefix.
assert_starts_with(str_val: any, prefix: any, message: any): bool
    if str_val == nil str_val = "" end
    if prefix == nil prefix = "" end
    if string.sub(str_val, 1, #prefix) == prefix return true end
    msg = "expected string to start with '" .. prefix .. "'"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_ends_with: assert string ends with suffix.
assert_ends_with(str_val: any, suffix: any, message: any): bool
    if str_val == nil str_val = "" end
    if suffix == nil suffix = "" end
    n = #suffix
    if n == 0 return true end
    if string.sub(str_val, -n) == suffix return true end
    msg = "expected string to end with '" .. suffix .. "'"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- ===== Type assertions =====

-- assert_type: assert value has the expected Lua type.
assert_type(value: any, expected_type: any, message: any): bool
    actual = type(value)
    if actual == expected_type return true end
    msg = "expected type '" .. expected_type .. "', got '" .. actual .. "'"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_is_array: assert value is a table with consecutive integer keys.
assert_is_array(value: any, message: any): bool
    if type(value) != "table"
        msg = "expected array, got " .. type(value)
        if message != nil msg = message .. " — " .. msg end
        error(msg)
    end
    if rawlen(value) == 0 return true end
    i = 2
    while i <= rawlen(value)
        if value[i] == nil
            msg = "expected array but found hole at index " .. to(str)(i)
            if message != nil msg = message .. " — " .. msg end
            error(msg)
        end
        i += 1
    end
    true
end

-- assert_is_table: assert value is a table.
assert_is_table(value: any, message: any): bool
    if type(value) == "table" return true end
    msg = "expected table, got " .. type(value)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- ===== Collection assertions =====

-- assert_len: assert a table/string has the expected length.
assert_len(value: any, expected_len: any, message: any): bool
    actual = 0
    if type(value) == "string"
        actual = #value
    elseif type(value) == "table"
        actual = rawlen(value)
    end
    if actual == expected_len return true end
    msg = "expected length " .. to(str)(expected_len) .. ", got " .. to(str)(actual)
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_empty: assert a table or string is empty.
assert_empty(value: any, message: any): bool
    if value == nil return true end
    if type(value) == "string"
        if #value == 0 return true end
        msg = "expected empty string, got length " .. to(str)(#value)
        if message != nil msg = message .. " — " .. msg end
        error(msg)
    end
    if type(value) == "table"
        if rawlen(value) == 0 and next(value) == nil return true end
        msg = "expected empty table"
        if message != nil msg = message .. " — " .. msg end
        error(msg)
    end
    true
end

-- assert_not_empty: assert a table or string is not empty.
assert_not_empty(value: any, message: any): bool
    if value == nil
        msg = "expected non-empty value, got nil"
        if message != nil msg = message .. " — " .. msg end
        error(msg)
    end
    if type(value) == "string"
        if #value > 0 return true end
        msg = "expected non-empty string"
        if message != nil msg = message .. " — " .. msg end
        error(msg)
    end
    if type(value) == "table"
        if rawlen(value) > 0 or next(value) != nil return true end
        msg = "expected non-empty table"
        if message != nil msg = message .. " — " .. msg end
        error(msg)
    end
    true
end

-- assert_in: assert a value exists in a list.
assert_in(value: any, list: any, message: any): bool
    if list == nil
        error("assert_in called on nil list")
    end
    i = 1
    while i <= rawlen(list)
        if list[i] == value return true end
        i += 1
    end
    msg = "expected " .. to(str)(value) .. " to be in list"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- ===== Error assertions =====

-- assert_errors: assert that fn raises an error.
assert_errors(fn_ref: any, message: any): any
    ok = pcall(fn_ref)
    if not ok return true end
    msg = "expected fn to raise an error, but it returned"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_no_errors: assert that fn does not raise an error.
assert_no_errors(fn_ref: any, message: any): any
    result = {pcall(fn_ref)}
    ok = result[1]
    if ok return true end
    msg = "expected fn to not raise an error: " .. to(str)(result[2])
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- assert_error_match: assert fn raises an error matching a pattern.
assert_error_match(fn_ref: any, pattern: any, message: any): any
    result = {pcall(fn_ref)}
    ok = result[1]
    if not ok
        found = string.find(to(str)(result[2]), pattern, 1)
        if found != nil return true end
        msg = "error did not match pattern '" .. pattern .. "': " .. to(str)(result[2])
        if message != nil msg = message .. " — " .. msg end
        error(msg)
    end
    msg = "expected fn to raise an error matching '" .. pattern .. "'"
    if message != nil msg = message .. " — " .. msg end
    error(msg)
end

-- ===== Soft assertions (collect failures instead of throwing) =====

-- soft_new: create a soft assertion collector.
soft_new(): any
    {failures = {}}
end

-- soft_assert: record a failure instead of throwing.
soft_assert(collector: any, condition: any, message: any): void
    if condition return end
    msg = "assertion failed"
    if message != nil msg = message end
    collector.failures[rawlen(collector.failures) + 1] = msg
end

-- soft_assert_eq: record an equality failure.
soft_assert_eq(collector: any, actual: any, expected: any, message: any): void
    if actual == expected return end
    msg = "expected " .. to(str)(expected) .. ", got " .. to(str)(actual)
    if message != nil msg = message .. " — " .. msg end
    collector.failures[rawlen(collector.failures) + 1] = msg
end

-- soft_check: returns true if no failures, otherwise throws with all messages.
soft_check(collector: any): bool
    if rawlen(collector.failures) == 0 return true end
    msg = to(str)(rawlen(collector.failures)) .. " assertion(s) failed:\n"
    i = 1
    while i <= rawlen(collector.failures)
        msg = msg .. "  - " .. collector.failures[i] .. "\n"
        i += 1
    end
    error(msg)
end

-- soft_count: return the number of recorded failures.
soft_count(collector: any): i64
    if collector == nil return 0 end
    rawlen(collector.failures)
end

