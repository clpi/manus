global __sync_run_queue = {}
spawn(fn: any, ...args) -> any
  args_list = {
    args
  }
  co = coroutine.create(()
    fn(table.unpack(args_list))
  end)
  __sync_run_queue[#__sync_run_queue + 1] = {
    co = co
  }
  return nil
end
yield() -> void
  coroutine.yield()
end
run() -> void
  while #__sync_run_queue > 0
    task = table.remove(__sync_run_queue, 1)
    ok, err = coroutine.resume(task.co)
    if not ok
      io.write("sync: task error: " .. to(str)(err) .. "\n")
    elseif coroutine.status(task.co) == "suspended"
      __sync_run_queue[#__sync_run_queue + 1] = task
    end
  end
end
step() -> bool
  if #__sync_run_queue == 0
    return false
  end
  task = table.remove(__sync_run_queue, 1)
  ok, err = coroutine.resume(task.co)
  if not ok
    io.write("sync: task error: " .. to(str)(err) .. "\n")
  elseif coroutine.status(task.co) == "suspended"
    __sync_run_queue[#__sync_run_queue + 1] = task
  end
  return #__sync_run_queue > 0
end
channel(capacity: i64) -> any
  return {
    _cap = capacity or 0,
    _queue = {},
    _send_waiters = {},
    _recv_waiters = {},
    _closed = false
  }
end
channel_send(ch: any, val: any) -> void
  if ch._closed
    error("send on closed channel")
  end
  if #ch._recv_waiters > 0
    w = table.remove(ch._recv_waiters, 1)
    w._slot[1] = val
    w._slot[2] = true
    __sync_run_queue[#__sync_run_queue + 1] = w
  end
  if ch._cap == 0 or #ch._queue < ch._cap
    ch._queue[#ch._queue + 1] = val
    return
  end
  co = coroutine.running()
  entry = {
    co = co,
    _val = val
  }
  ch._send_waiters[#ch._send_waiters + 1] = entry
  coroutine.yield()
end
channel_recv(ch: any) -> any
  if #ch._queue > 0
    val = table.remove(ch._queue, 1)
    if #ch._send_waiters > 0
      w = table.remove(ch._send_waiters, 1)
      ch._queue[#ch._queue + 1] = w._val
      __sync_run_queue[#__sync_run_queue + 1] = w
    end
    return val
  end
  if ch._closed
    return nil
  end
  co = coroutine.running()
  slot = {
    _val = nil
  }
  entry = {
    co = co,
    _slot = slot
  }
  ch._recv_waiters[#ch._recv_waiters + 1] = entry
  coroutine.yield()
  return slot._val
end
channel_try_recv(ch: any) -> any
  if #ch._queue > 0
    val = table.remove(ch._queue, 1)
    if #ch._send_waiters > 0
      w = table.remove(ch._send_waiters, 1)
      ch._queue[#ch._queue + 1] = w._val
      __sync_run_queue[#__sync_run_queue + 1] = w
    end
    return val
  end
  return nil
end
channel_close(ch: any) -> void
  ch._closed = true
  for _, w in ch._recv_waiters
    w._slot[1] = nil
    w._slot[2] = true
    __sync_run_queue[#__sync_run_queue + 1] = w
  end
  ch._recv_waiters = {}
end
channel_drain(ch: any) -> any
  out = {}
  while #ch._queue > 0
    out[#out + 1] = table.remove(ch._queue, 1)
  end
  return out
end
waitgroup_new() -> any
  {
    count = 0,
    waiters = {}
  }
end
waitgroup_add(wg: any, n: i64) -> void
  if n == nil
    n = 1
  end
  wg.count = wg.count + n
end
waitgroup_done(wg: any) -> void
  wg.count = wg.count - 1
  if wg.count <= 0
    for _, w in wg.waiters
      __sync_run_queue[#__sync_run_queue + 1] = w
    end
    wg.waiters = {}
  end
end
waitgroup_wait(wg: any) -> void
  if wg.count <= 0
    return
  end
  co = coroutine.running()
  wg.waiters[#wg.waiters + 1] = {
    co = co
  }
  coroutine.yield()
end
once(fn: any) -> any
  {
    fn = fn,
    done = false
  }
end
once_do(o: any) -> void
  if o.done
    return
  end
  o.fn()
  o.done = true
end
M = {}
M.spawn = spawn
M.yield = yield
M.run = run
M.step = step
M.channel = channel
M.channel_new = channel
M.channel_send = channel_send
M.channel_recv = channel_recv
M.channel_try_recv = channel_try_recv
M.channel_close = channel_close
M.channel_drain = channel_drain
M.waitgroup_new = waitgroup_new
M.waitgroup_add = waitgroup_add
M.waitgroup_done = waitgroup_done
M.waitgroup_wait = waitgroup_wait
M.once = once
M.once_do = once_do
return M
