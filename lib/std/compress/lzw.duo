-- std.compress.lzw — LZW decompression (mirrors Go's compress/lzw)
-- Used in GIF and PDF. Implements LZW with variable-width codes (3-12 bits).

string = req "std.string"

LSB = "lsb"
MSB = "msb"

new_reader(order: str, lit_width: i64): any
    {order = order, lit_width = lit_width, clear_code = 1 << lit_width,
     eoi_code = (1 << lit_width) + 1, width = lit_width + 1,
     table = {}, next_code = (1 << lit_width) + 2,
     buf = 0, bits = 0, data = "", pos = 1}
end

read_bit(r: any): any
    if r.bits == 0
        if r.pos > string.len(r.data) return nil end
        r.buf = string.byte(r.data, r.pos)
        r.pos = r.pos + 1
        r.bits = 8
    end
    r.bits = r.bits - 1
    (r.buf >> r.bits) & 1
end

read_bits(r: any, n: i64): any
    v = 0
    for i = 0, n - 1
        b = read_bit(r)
        if b == nil return nil end
        if r.order == MSB
            v = (v << 1) | b
        else
            v = v | (b << i)
        end
    end
    v
end

init_table(r: any): void
    r.table = {}
    r.next_code = r.clear_code + 2
    for i = 0, (1 << r.lit_width) - 1
        r.table[i] = string.char(i)
    end
end

decompress(data: str, order: str, lit_width: i64): str
    if data == nil return "" end
    r = new_reader(order, lit_width)
    r.data = data
    out_parts = {}
    init_table(r)
    max_width = 12
    prev = nil
    while true
        code = read_bits(r, r.width)
        if code == nil or code == r.eoi_code break end
        if code == r.clear_code
            init_table(r)
            r.width = r.lit_width + 1
            prev = nil
        else
            entry = nil
            if code < r.next_code
                entry = r.table[code]
            elseif code == r.next_code
                entry = r.table[prev] .. string.sub(r.table[prev], 1, 1)
            else
                break
            end
            if entry != nil
                out_parts[rawlen(out_parts) + 1] = entry
            end
            if prev != nil and entry != nil
                new_entry = r.table[prev] .. string.sub(entry, 1, 1)
                r.table[r.next_code] = new_entry
                r.next_code = r.next_code + 1
                if r.next_code > (1 << r.width) and r.width < max_width
                    r.width = r.width + 1
                end
            end
            prev = code
        end
    end
    table.concat(out_parts)
end

decompress_gif(data: str): str
    decompress(data, LSB, 8)
end

decompress_pdf(data: str): str
    decompress(data, MSB, 8)
end

