-- std.compress.gzip — Gzip decompression (mirrors Go's compress/gzip)

is_gzipped(data: any)
    if data == nil or string.len(data) < 2 return false end
    return string.byte(data, 1) == 31 and string.byte(data, 2) == 139
end

gunzip(data: any)
    if not is_gzipped(data) return data end
    f = io.popen("gzip -d 2>/dev/null", "w")
    if f == nil return data end
    f:write(data)
    f:close()
    f = io.popen("", "r")
    result = f:read("*a")
    f:close()
    return result or data
end

compress(data: any)
    f = io.popen("gzip -c 2>/dev/null", "w")
    if f == nil return data end
    f:write(data)
    f:close()
    f = io.popen("", "r")
    result = f:read("*a")
    f:close()
    return result or data
end

