# std.compress.zlib — Zlib decompression (mirrors Go's compress/zlib)
# Uses the flate module for actual DEFLATE data

decompress(data: any)
    if data == nil or data:len() < 2 return "" end
    cmf = data:byte(1)
    flg = data:byte(2)
    if cmf % 16 != 8 return "" end
    if (cmf * 256 + flg) % 31 != 0 return "" end
    dlen = data:byte(2)
    if dlen % 32 >= 8 return "" end
    deflate_start = 3
    if deflate_start > data:len() return "" end
    deflate_data = data:sub(deflate_start)
    flate_mod = flate
    return flate_mod.decompress(deflate_data)
end

