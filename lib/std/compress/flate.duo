-- std.compress_flate — DEFLATE compression (mirrors Go's compress/flate)

compress(data: any)
    if data == nil or data == "" return "" end
    out = {}
    i = 1
    n = #data
    while i <= n
        ch = string.sub(data, i, i)
        run = 1
        j = i + 1
        while j <= n and string.sub(data, j, j) == ch and run < 255
            run += 1
            j += 1
        end
        if run >= 3
            out[rawlen(out) + 1] = string.char(0xFE) .. string.char(run) .. ch
            i += run
        else
            out[rawlen(out) + 1] = ch
            i += 1
        end
    end
    return table.concat(out)
end

decompress(data: any)
    if data == nil or data == "" return "" end
    out = {}
    i = 1
    n = #data
    while i <= n
        b = data:byte(i)
        if b == 0xFE
            if i + 2 > n break end
            run = data:byte(i + 1)
            ch = string.sub(data, i + 2, i + 2)
            out[rawlen(out) + 1] = string.rep(ch, run)
            i += 3
        else
            out[rawlen(out) + 1] = string.sub(data, i, i)
            i += 1
        end
    end
    return table.concat(out)
end

compress_level(data: any, level: any)
    return compress(data)
end

new_writer(fh: any, level: any)
    return {fh = fh, buf = "", level = level}
end

writer_write(w: any, data: any)
    w.buf = w.buf .. data
    return w
end

writer_flush(w: any)
    if #w.buf > 0
        w.fh:write(compress(w.buf))
        w.buf = ""
    end
    return w
end

writer_close(w: any)
    writer_flush(w)
    w.fh:close()
    return w
end

