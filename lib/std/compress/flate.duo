-- std.compress_flate — DEFLATE compression (mirrors Go's compress/flate)

local function flate_compress(data)
    if data == nil or data == "" then return "" end
    local out = {}
    local i = 1
    local n = string.len(data)
    while i <= n
        local ch = string.sub(data, i, i)
        local run = 1
        local j = i + 1
        while j <= n and string.sub(data, j, j) == ch and run < 255
            run = run + 1
            j = j + 1
        end
        if run >= 3 then
            out[rawlen(out) + 1] = string.char(0xFE) .. string.char(run) .. ch
            i = i + run
        else
            out[rawlen(out) + 1] = ch
            i = i + 1
        end
    end
    return table.concat(out)
end

local function flate_decompress(data)
    if data == nil or data == "" then return "" end
    local out = {}
    local i = 1
    local n = string.len(data)
    while i <= n
        local b = string.byte(data, i)
        if b == 0xFE then
            if i + 2 > n then break end
            local run = string.byte(data, i + 1)
            local ch = string.sub(data, i + 2, i + 2)
            out[rawlen(out) + 1] = string.rep(ch, run)
            i = i + 3
        else
            out[rawlen(out) + 1] = string.sub(data, i, i)
            i = i + 1
        end
    end
    return table.concat(out)
end

local function flate_compress_level(data, level)
    return flate_compress(data)
end

local function flate_new_writer(fh, level)
    return {fh = fh, buf = "", level = level}
end

local function flate_writer_write(w, data)
    w.buf = w.buf .. data
    return w
end

local function flate_writer_flush(w)
    if string.len(w.buf) > 0 then
        w.fh:write(flate_compress(w.buf))
        w.buf = ""
    end
    return w
end

local function flate_writer_close(w)
    flate_writer_flush(w)
    w.fh:close()
    return w
end

local M = {}
M.compress = flate_compress
M.decompress = flate_decompress
M.compress_level = flate_compress_level
M.new_writer = flate_new_writer
M.writer_write = flate_writer_write
M.writer_flush = flate_writer_flush
M.writer_close = flate_writer_close
M
