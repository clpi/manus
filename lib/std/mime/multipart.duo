-- std.mime.multipart — MIME multipart reader/writer (mirrors Go's mime/multipart)

parse_boundary(content_type: any)
    if content_type == nil return nil end
    d1, d2, b = string.find(content_type, "boundary=([^;]+)")
    if b == nil return nil end
    b = string.gsub(b, "^\"", "")
    b = string.gsub(b, "\"$", "")
    return b
end

parse_headers(header_str: any)
    h = {}
    for line in string.gmatch(header_str, "[^\r\n]+")
        d1, d2, k, v = string.find(line, "^([^:]+):%s*(.+)$")
        if k != nil
            h[string.lower(k)] = v
        end
    end
    return h
end

new_reader(data: any, boundary: any)
    return {data = data, boundary = boundary, pos = 1, parts = nil, part_idx = 1}
end

next_part(r: any)
    if r.parts == nil
        r.parts = {}
        sep = "--" .. r.boundary
        end_sep = "--" .. r.boundary .. "--"
        pos = r.pos
        while pos <= #r.data
            d1, e = string.find(r.data, sep, pos, true)
            if e == nil break end
            if r.data:sub(e + 1, e + 1) == "-" break end
            if r.data:sub(e + 1, e + 1) == "\r" e += 2 else e += 1 end
            d2, hdr_end = string.find(r.data, "\r\n\r\n", e, true)
            if hdr_end == nil d2, hdr_end = string.find(r.data, "\n\n", e, true) end
            if hdr_end == nil break end
            hdr = r.data:sub(e, hdr_end - 1)
            body_start = hdr_end + 1
            if r.data:sub(hdr_end - 1, hdr_end) == "\n\n" body_start = hdr_end else body_start = hdr_end + 2 end
            next_sep = string.find(r.data, "\r\n" .. sep, body_start, true)
            if next_sep == nil next_sep = string.find(r.data, "\n" .. sep, body_start, true) end
            if next_sep == nil
                next_sep2 = string.find(r.data, end_sep, body_start, true)
                if next_sep2 == nil break end
                part_body = r.data:sub(body_start, next_sep2 - 1)
                r.parts[rawlen(r.parts) + 1] = {headers = parse_headers(hdr), body = part_body}
                break
            end
            part_body = r.data:sub(body_start, next_sep - 1)
            if part_body:sub(#part_body - 1) == "\r\n"
                part_body = part_body:sub(1, #part_body - 2)
            elseif part_body:sub(#part_body) == "\n"
                part_body = part_body:sub(1, #part_body - 1)
            end
            r.parts[rawlen(r.parts) + 1] = {headers = parse_headers(hdr), body = part_body}
            pos = next_sep + 1
        end
    end
    if r.part_idx > rawlen(r.parts) return nil end
    p = r.parts[r.part_idx]
    r.part_idx = r.part_idx + 1
    return p
end

