-- std.os.linux — Linux-specific APIs
-- For epoll, inotify, eventfd, timerfd, and mmap.
-- Uses @c.emit for direct Linux syscalls.

-- ═══════════════════════════════════════════════════════════════
-- epoll Constants
-- ═══════════════════════════════════════════════════════════════

M.EPOLL_CTL_ADD = 1
M.EPOLL_CTL_MOD = 2
M.EPOLL_CTL_DEL = 3
M.EPOLLIN = 0x001
M.EPOLLPRI = 0x002
M.EPOLLOUT = 0x004
M.EPOLLERR = 0x008
M.EPOLLHUP = 0x010
M.EPOLLRDHUP = 0x2000
M.EPOLLET = 0x80000000

-- ═══════════════════════════════════════════════════════════════
-- Linux syscalls via @c.emit
-- ═══════════════════════════════════════════════════════════════

@c.emit('#include <sys/epoll.h>')
@c.emit('#include <sys/inotify.h>')
@c.emit('#include <sys/eventfd.h>')
@c.emit('#include <sys/timerfd.h>')
@c.emit('#include <sys/mman.h>')
@c.emit('#include <unistd.h>')
@c.emit('#include <fcntl.h>')
@c.emit('#include <stdlib.h>')
@c.emit('#include <string.h>')

-- C shim functions for Linux syscalls

@c.emit('''
static int duo_epoll_create(int maxevents) {
    return epoll_create1(0);
}

static int duo_epoll_ctl(int epfd, int op, int fd, uint32_t events) {
    struct epoll_event ev;
    ev.events = events;
    ev.data.fd = fd;
    return epoll_ctl(epfd, op, fd, &ev);
}

static int duo_epoll_wait(int epfd, int *out_fds, uint32_t *out_events, int maxevents, int timeout_ms) {
    struct epoll_event events[64];
    if (maxevents > 64) maxevents = 64;
    int n = epoll_wait(epfd, events, maxevents, timeout_ms);
    if (n < 0) return n;
    for (int i = 0; i < n; i++) {
        out_fds[i] = events[i].data.fd;
        out_events[i] = events[i].events;
    }
    return n;
}

static int duo_inotify_init(int flags) {
    return inotify_init1(flags);
}

static int duo_inotify_add_watch(int ifd, const char *path, uint32_t mask) {
    return inotify_add_watch(ifd, path, mask);
}

static int duo_inotify_rm_watch(int ifd, int wd) {
    return inotify_rm_watch(ifd, wd);
}

static int duo_eventfd_create(unsigned int initval, int flags) {
    return eventfd(initval, flags);
}

static int duo_timerfd_create(int clockid, int flags) {
    return timerfd_create(clockid, flags);
}

static int duo_timerfd_settime(int fd, int flags, long initial_sec, long initial_nsec, long interval_sec, long interval_nsec) {
    struct itimerspec its;
    its.it_value.tv_sec = initial_sec;
    its.it_value.tv_nsec = initial_nsec;
    its.it_interval.tv_sec = interval_sec;
    its.it_interval.tv_nsec = interval_nsec;
    return timerfd_settime(fd, flags, &its, NULL);
}

static void *duo_mmap_create(size_t length, int prot, int flags, int fd, off_t offset) {
    return mmap(NULL, length, prot, flags, fd, offset);
}

static int duo_munmap(void *addr, size_t length) {
    return munmap(addr, length);
}

static int duo_msync(void *addr, size_t length, int flags) {
    return msync(addr, length, flags);
}

static int duo_read(int fd, void *buf, size_t count) {
    return read(fd, buf, count);
}

static int duo_write(int fd, const void *buf, size_t count) {
    return write(fd, buf, count);
}

static int duo_close(int fd) {
    return close(fd);
}
''')

-- ═══════════════════════════════════════════════════════════════
-- epoll
-- ═══════════════════════════════════════════════════════════════

epoll_new(): any
    epoll_create(64)
end

epoll_create(max_events: i64): any
    fd = @ffi("duo_epoll_create", i64, {i64})(max_events)
    if fd < 0
        error("epoll_create failed: " .. to(str)(fd))
    end
    {
        fd = fd,
        max_events = max_events or 64,
    }
end

epoll_add(epoll: any, fd: i64, events: i64, data: any): any
    result = @ffi("duo_epoll_ctl", i64, {i64, i64, i64, i64})(epoll.fd, M.EPOLL_CTL_ADD, fd, events)
    if result < 0
        return {ok = false, error = "epoll_ctl ADD failed"}
    end
    {ok = true}
end

epoll_mod(epoll: any, fd: i64, events: i64): any
    result = @ffi("duo_epoll_ctl", i64, {i64, i64, i64, i64})(epoll.fd, M.EPOLL_CTL_MOD, fd, events)
    if result < 0
        return {ok = false, error = "epoll_ctl MOD failed"}
    end
    {ok = true}
end

epoll_del(epoll: any, fd: i64): any
    result = @ffi("duo_epoll_ctl", i64, {i64, i64, i64, i64})(epoll.fd, M.EPOLL_CTL_DEL, fd, 0)
    if result < 0
        return {ok = false, error = "epoll_ctl DEL failed"}
    end
    {ok = true}
end

epoll_wait(epoll: any, timeout_ms: i64): any
    if timeout_ms == nil timeout_ms = -1 end
    -- Allocate arrays for results
    fds = @ffi("calloc", any, {i64, i64})(epoll.max_events, 4)
    events_buf = @ffi("calloc", any, {i64, i64})(epoll.max_events, 4)
    count = @ffi("duo_epoll_wait", i64, {i64, any, any, i64, i64})(epoll.fd, fds, events_buf, epoll.max_events, timeout_ms)
    result_events = {}
    if count > 0
        i = 0
        while i < count
            fd = @ffi("malloc_read_i32", i64, {any, i64})(fds, i * 4)
            ev = @ffi("malloc_read_i32", i64, {any, i64})(events_buf, i * 4)
            result_events[#result_events + 1] = {fd = fd, events = ev}
            i += 1
        end
    end
    @ffi("free", void, {any})(fds)
    @ffi("free", void, {any})(events_buf)
    {
        ok = count >= 0,
        events = result_events,
        count = count,
    }
end

epoll_close(epoll: any): void
    @ffi("duo_close", i64, {i64})(epoll.fd)
    epoll.fd = -1
end

-- ═══════════════════════════════════════════════════════════════
-- inotify
-- ═══════════════════════════════════════════════════════════════

M.IN_CREATE = 0x00000100
M.IN_DELETE = 0x00000200
M.IN_MODIFY = 0x00000002
M.IN_MOVED_FROM = 0x00000040
M.IN_MOVED_TO = 0x00000080
M.IN_CLOSE_WRITE = 0x00000008
M.IN_CLOSE_NOWRITE = 0x00000010
M.IN_OPEN = 0x00000020
M.IN_DELETE_SELF = 0x00000400
M.IN_MOVE_SELF = 0x00000800

inotify_new(): any
    fd = @ffi("duo_inotify_init", i64, {i64})(0)
    if fd < 0
        error("inotify_init failed: " .. to(str)(fd))
    end
    {
        fd = fd,
        watches = {},
    }
end

inotify_add_watch(inotify: any, path: str, mask: i64): any
    watch_id = @ffi("duo_inotify_add_watch", i64, {i64, str, i64})(inotify.fd, path, mask)
    if watch_id < 0
        return {ok = false, error = "inotify_add_watch failed"}
    end
    inotify.watches[watch_id] = {path = path, mask = mask}
    {ok = true, watch_id = watch_id}
end

inotify_rm_watch(inotify: any, watch_id: i64): any
    result = @ffi("duo_inotify_rm_watch", i64, {i64, i64})(inotify.fd, watch_id)
    if result < 0
        return {ok = false, error = "inotify_rm_watch failed"}
    end
    inotify.watches[watch_id] = nil
    {ok = true}
end

inotify_read(inotify: any): any
    buf = string.rep(string.char(0), 4096)
    n = @ffi("duo_read", i64, {i64, str, i64})(inotify.fd, buf, 4096)
    if n < 0
        return {ok = false, events = {}, count = 0}
    end
    events = {}
    pos = 1
    while pos + 15 < n
        wd = string.byte(buf, pos) | (string.byte(buf, pos + 1) << 8) |
            (string.byte(buf, pos + 2) << 16) | (string.byte(buf, pos + 3) << 24)
        cookie = string.byte(buf, pos + 4) | (string.byte(buf, pos + 5) << 8) |
            (string.byte(buf, pos + 6) << 16) | (string.byte(buf, pos + 7) << 24)
        mask = string.byte(buf, pos + 8) | (string.byte(buf, pos + 9) << 8) |
            (string.byte(buf, pos + 10) << 16) | (string.byte(buf, pos + 11) << 24)
        name_len = string.byte(buf, pos + 12) | (string.byte(buf, pos + 13) << 8) |
            (string.byte(buf, pos + 14) << 16) | (string.byte(buf, pos + 15) << 24)
        name = ""
        if name_len > 0
            name = buf:sub(pos + 16, pos + 15 + name_len)
            -- Strip null terminator
            null_pos = string.find(name, string.char(0))
            if null_pos name = name:sub(1, null_pos - 1) end
        end
        events[#events + 1] = {
            watch_id = wd,
            cookie = cookie,
            mask = mask,
            name = name,
        }
        pos += 16 + name_len
    end
    {ok = true, events = events, count = #events}
end

inotify_close(inotify: any): void
    @ffi("duo_close", i64, {i64})(inotify.fd)
    inotify.fd = -1
end

-- ═══════════════════════════════════════════════════════════════
-- Memory Mapping
-- ═══════════════════════════════════════════════════════════════

M.MAP_SHARED = 0x01
M.MAP_PRIVATE = 0x02
M.PROT_READ = 0x1
M.PROT_WRITE = 0x2
M.PROT_EXEC = 0x4
M.MS_SYNC = 0x04

mmap_new(path: str, size: i64, flags: i64): any
    if flags == nil flags = M.MAP_SHARED end
    -- Open file for reading/writing
    fd = @ffi("open", i64, {str, i64, i64})(path, 0x0002, 0x0644)  -- O_RDWR | O_CREAT
    if fd < 0
        error("mmap: failed to open " .. path)
    end
    ptr = @ffi("duo_mmap_create", any, {i64, i64, i64, i64, i64})(size, M.PROT_READ | M.PROT_WRITE, flags, fd, 0)
    if ptr == nil
        @ffi("duo_close", i64, {i64})(fd)
        error("mmap: failed to mmap " .. path)
    end
    {
        path = path,
        size = size,
        flags = flags,
        fd = fd,
        ptr = ptr,
    }
end

mmap_read(mmap: any, offset: i64, length: i64): any
    buf = string.rep(string.char(0), length)
    @ffi("memcpy", void, {any, any, i64})(buf, mmap.ptr + offset, length)
    {ok = true, data = buf, size = length}
end

mmap_write(mmap: any, offset: i64, data: any): any
    @ffi("memcpy", void, {any, any, i64})(mmap.ptr + offset, data, #data)
    {ok = true}
end

mmap_sync(mmap: any): any
    result = @ffi("duo_msync", i64, {any, i64, i64})(mmap.ptr, mmap.size, M.MS_SYNC)
    {ok = result == 0}
end

mmap_unmap(mmap: any): void
    if mmap.ptr != nil
        @ffi("duo_munmap", i64, {any, i64})(mmap.ptr, mmap.size)
        mmap.ptr = nil
    end
    if mmap.fd >= 0
        @ffi("duo_close", i64, {i64})(mmap.fd)
        mmap.fd = -1
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Eventfd
-- ═══════════════════════════════════════════════════════════════

M.EFD_SEMAPHORE = 1
M.EFD_NONBLOCK = 2048
M.EFD_CLOEXEC = 2000000

eventfd_new(initval: i64, flags: i64): any
    if initval == nil initval = 0 end
    if flags == nil flags = 0 end
    fd = @ffi("duo_eventfd_create", i64, {i64, i64})(initval, flags)
    if fd < 0
        error("eventfd_create failed")
    end
    {fd = fd}
end

eventfd_write(eventfd: any, value: i64): any
    buf = string.rep(string.char(0), 8)
    -- Write 8-byte little-endian uint64
    v = value
    i = 1
    while i <= 8
        buf = buf:sub(1, i - 1) .. string.char(v & 0xFF) .. buf:sub(i + 1)
        v = v >> 8
        i += 1
    end
    n = @ffi("duo_write", i64, {i64, str, i64})(eventfd.fd, buf, 8)
    {ok = n == 8}
end

eventfd_read(eventfd: any): any
    buf = string.rep(string.char(0), 8)
    n = @ffi("duo_read", i64, {i64, str, i64})(eventfd.fd, buf, 8)
    if n != 8
        return {ok = false, value = 0}
    end
    value = 0
    i = 7
    while i >= 0
        value = (value << 8) | string.byte(buf, 8 - i)
        i -= 1
    end
    {ok = true, value = value}
end

eventfd_close(eventfd: any): void
    @ffi("duo_close", i64, {i64})(eventfd.fd)
    eventfd.fd = -1
end

-- ═══════════════════════════════════════════════════════════════
-- Timerfd
-- ═══════════════════════════════════════════════════════════════

M.TFD_TIMER_ABSTIME = 1
M.TFD_CLOEXEC = 0x800
M.CLOCK_MONOTONIC = 1

timerfd_new(clock_id: i64, flags: i64): any
    if clock_id == nil clock_id = M.CLOCK_MONOTONIC end
    if flags == nil flags = M.TFD_CLOEXEC end
    fd = @ffi("duo_timerfd_create", i64, {i64, i64})(clock_id, flags)
    if fd < 0
        error("timerfd_create failed")
    end
    {fd = fd}
end

timerfd_settime(timerfd: any, initial: any, interval: any): any
    if initial == nil initial = {sec = 0, nsec = 0} end
    if interval == nil interval = {sec = 0, nsec = 0} end
    result = @ffi("duo_timerfd_settime", i64, {i64, i64, i64, i64, i64, i64})(
        timerfd.fd, 0, initial.sec, initial.nsec, interval.sec, interval.nsec
    )
    {ok = result == 0}
end

timerfd_read(timerfd: any): any
    buf = string.rep(string.char(0), 8)
    n = @ffi("duo_read", i64, {i64, str, i64})(timerfd.fd, buf, 8)
    if n != 8
        return {ok = false, expirations = 0}
    end
    expirations = 0
    i = 7
    while i >= 0
        expirations = (expirations << 8) | string.byte(buf, 8 - i)
        i -= 1
    end
    {ok = true, expirations = expirations}
end

timerfd_close(timerfd: any): void
    @ffi("duo_close", i64, {i64})(timerfd.fd)
    timerfd.fd = -1
end

-- ═══════════════════════════════════════════════════════════════
-- Signalfd (stub - needs struct sigset_t)
-- ═══════════════════════════════════════════════════════════════

signalfd_new(signals: any, flags: i64): any
    {
        fd = -1,
        signals = signals or {},
    }
end

signalfd_read(signalfd: any): any
    {
        ok = true,
        signals = {},
    }
end

signalfd_close(signalfd: any): void
    signalfd.fd = -1
end

-- ═══════════════════════════════════════════════════════════════
-- Timer Wheel (pure Lua, no syscalls needed)
-- ═══════════════════════════════════════════════════════════════

timer_wheel_new(slot_count: i64, resolution_ms: i64): any
    slots = {}
    i = 1
    while i <= slot_count
        slots[i] = {}
        i += 1
    end
    {
        slots = slots,
        slot_count = slot_count,
        resolution_ms = resolution_ms,
        current_slot = 1,
    }
end

timer_wheel_add(wheel: any, timeout_ms: i64, callback: any): any
    slots_forward = math.floor(timeout_ms / wheel.resolution_ms)
    target_slot = ((wheel.current_slot - 1 + slots_forward) % wheel.slot_count) + 1

    wheel.slots[target_slot][#wheel.slots[target_slot] + 1] = {
        callback = callback,
        timeout_ms = timeout_ms,
    }

    {
        ok = true,
        slot = target_slot,
    }
end

timer_wheel_advance(wheel: any, elapsed_ms: i64): any
    slots_to_advance = math.floor(elapsed_ms / wheel.resolution_ms)
    fired = {}

    i = 0
    while i < slots_to_advance
        wheel.current_slot = ((wheel.current_slot - 1) % wheel.slot_count) + 1
        for entry in wheel.slots[wheel.current_slot]
            fired[#fired + 1] = entry.callback
        end
        wheel.slots[wheel.current_slot] = {}
        i += 1
    end

    {
        ok = true,
        fired = fired,
        count = #fired,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M.epoll_new = epoll_new
M.epoll_create = epoll_create
M.epoll_add = epoll_add
M.epoll_mod = epoll_mod
M.epoll_del = epoll_del
M.epoll_wait = epoll_wait
M.epoll_close = epoll_close
M.inotify_new = inotify_new
M.inotify_add_watch = inotify_add_watch
M.inotify_rm_watch = inotify_rm_watch
M.inotify_read = inotify_read
M.inotify_close = inotify_close
M.mmap_new = mmap_new
M.mmap_read = mmap_read
M.mmap_write = mmap_write
M.mmap_sync = mmap_sync
M.mmap_unmap = mmap_unmap
M.eventfd_new = eventfd_new
M.eventfd_write = eventfd_write
M.eventfd_read = eventfd_read
M.eventfd_close = eventfd_close
M.timerfd_new = timerfd_new
M.timerfd_settime = timerfd_settime
M.timerfd_read = timerfd_read
M.timerfd_close = timerfd_close
M.signalfd_new = signalfd_new
M.signalfd_read = signalfd_read
M.signalfd_close = signalfd_close
M.timer_wheel_new = timer_wheel_new
M.timer_wheel_add = timer_wheel_add
M.timer_wheel_advance = timer_wheel_advance
M
