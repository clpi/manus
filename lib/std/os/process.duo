-- std.os.process — Process management, spawning, pipes
-- For ward's process isolation and runtime management.

-- ═══════════════════════════════════════════════════════════════
-- Process Configuration
-- ═══════════════════════════════════════════════════════════════

process_config_new(cmd: str): any
    {
        cmd = cmd,
        args = {},
        env = {},
        cwd = nil,
        stdin = "pipe",
        stdout = "pipe",
        stderr = "pipe",
        detached = false,
        uid = nil,
        gid = nil,
    }
end

process_config_arg(config: any, arg: str): any
    config.args[#config.args + 1] = arg
    config
end

process_config_args(config: any, args: any): any
    for arg in args
        config.args[#config.args + 1] = arg
    end
    config
end

process_config_env(config: any, key: str, value: str): any
    config.env[key] = value
    config
end

process_config_cwd(config: any, cwd: str): any
    config.cwd = cwd
    config
end

process_config_stdin(config: any, mode: str): any
    config.stdin = mode  -- "pipe", "inherit", "ignore", or file path
    config
end

process_config_stdout(config: any, mode: str): any
    config.stdout = mode
    config
end

process_config_stderr(config: any, mode: str): any
    config.stderr = mode
    config
end

process_config_detached(config: any, detached: bool): any
    config.detached = detached
    config
end

-- ═══════════════════════════════════════════════════════════════
-- Process Handle
-- ═══════════════════════════════════════════════════════════════

process_new(): any
    {
        pid = nil,
        exit_code = nil,
        stdin = nil,
        stdout = nil,
        stderr = nil,
        running = false,
        killed = false,
    }
end

process_start(proc: any, config: any): any
    -- Build command with arguments
    full_cmd = config.cmd
    for arg in config.args
        full_cmd = full_cmd .. " " .. tostring(arg)
    end

    -- Set environment variables for the child process
    env_prefix = ""
    for k, v in config.env
        env_prefix = env_prefix .. k .. "=" .. tostring(v) .. " "
    end

    -- Capture PID and run in background
    handle = io.popen(env_prefix .. full_cmd .. " 2>&1 & echo $!")
    if handle
        pid_str = io.read(handle, "*l")
        io.close(handle)
        if pid_str
            proc.pid = tonumber(pid_str) or 0
            proc.running = true
            proc.exit_code = nil
            proc.config = config
            return {ok = true, pid = proc.pid}
        end
    end
    {ok = false, error = "Failed to start process"}
end

process_wait(proc: any): any
    if not proc.running
        return {exit_code = proc.exit_code}
    end

    -- Wait for process and capture exit code
    if proc.pid and proc.pid > 0
        os.execute("wait " .. tostring(proc.pid) .. " 2>/dev/null")
        -- Get exit code via $?
        handle = io.popen("echo $?")
        if handle
            code_str = io.read(handle, "*l")
            io.close(handle)
            proc.exit_code = tonumber(code_str) or 0
        else
            proc.exit_code = 0
        end
    else
        proc.exit_code = 0
    end

    proc.running = false
    {exit_code = proc.exit_code}
end

process_kill(proc: any, signal: i64): any
    if not proc.running
        return {error = "Process not running"}
    end

    sig = signal or 15  -- SIGTERM default
    if proc.pid and proc.pid > 0
        os.execute("kill -" .. tostring(sig) .. " " .. tostring(proc.pid) .. " 2>/dev/null")
    end
    proc.killed = true
    proc.running = false
    proc.exit_code = -sig
    {ok = true}
end

process_write_stdin(proc: any, data: str): any
    if proc.stdin == nil
        return {error = "stdin not available"}
    end

    -- Write to the process's stdin pipe
    if type(proc.stdin) == "userdata"
        proc.stdin:write(data)
        proc.stdin:flush()
    end
    {ok = true}
end

process_read_stdout(proc: any): any
    if proc.stdout == nil
        return {error = "stdout not available"}
    end

    if type(proc.stdout) == "userdata"
        data = proc.stdout:read("*a") or ""
        return {data = data, eof = string.len(data) == 0}
    end
    {data = "", eof = true}
end

process_read_stderr(proc: any): any
    if proc.stderr == nil
        return {error = "stderr not available"}
    end

    if type(proc.stderr) == "userdata"
        data = proc.stderr:read("*a") or ""
        return {data = data, eof = string.len(data) == 0}
    end
    {data = "", eof = true}
end

process_is_running(proc: any): bool
    proc.running
end

process_exit_code(proc: any): any
    proc.exit_code
end

-- ═══════════════════════════════════════════════════════════════
-- Command Execution Helpers
-- ═══════════════════════════════════════════════════════════════

process_run(cmd: str, args: any): any
    -- Build full command line
    full_cmd = cmd
    if args
        for arg in args
            full_cmd = full_cmd .. " " .. tostring(arg)
        end
    end

    -- Execute and capture output + exit code in one shot
    f = io.popen(full_cmd .. " 2>&1; echo \"\\n$?\"", "r")
    if f == nil
        return {exit_code = 1, stdout = "", stderr = "Failed to execute: " .. cmd}
    end
    raw = f:read("*a") or ""
    f:close()

    -- Split output from exit code (last line after final newline)
    last_nl = string.find(raw, "\n[^\n]*$")
    if last_nl
        stdout = string.sub(raw, 1, last_nl - 1)
        exit_str = string.sub(raw, last_nl + 1)
        exit_code = tonumber(string.match(exit_str, "%d+")) or 0
    else
        stdout = raw
        exit_code = 0
    end

    {
        exit_code = exit_code,
        stdout = stdout,
        stderr = "",
    }
end

process_run_with_input(cmd: str, args: any, input: str): any
    full_cmd = cmd
    if args
        for arg in args
            full_cmd = full_cmd .. " " .. tostring(arg)
        end
    end

    -- Pipe input to command and capture output + exit code
    escaped_input = string.gsub(input, "'", "'\\''")
    f = io.popen("echo '" .. escaped_input .. "' | " .. full_cmd .. " 2>&1; echo \"\\n$?\"", "r")
    if f == nil
        return {exit_code = 1, stdout = "", stderr = "Failed to execute: " .. cmd}
    end
    raw = f:read("*a") or ""
    f:close()

    last_nl = string.find(raw, "\n[^\n]*$")
    if last_nl
        stdout = string.sub(raw, 1, last_nl - 1)
        exit_str = string.sub(raw, last_nl + 1)
        exit_code = tonumber(string.match(exit_str, "%d+")) or 0
    else
        stdout = raw
        exit_code = 0
    end

    {
        exit_code = exit_code,
        stdout = stdout,
        stderr = "",
    }
end

process_output(cmd: str, args: any): any
    result = process_run(cmd, args)
    result.stdout
end

-- ═══════════════════════════════════════════════════════════════
-- Pipe (inter-process communication)
-- ═══════════════════════════════════════════════════════════════

pipe_new(): any
    {
        read_end = nil,
        write_end = nil,
        buffer = {},
    }
end

pipe_read(pipe: any): any
    if #pipe.buffer == 0
        return {data = "", eof = true}
    end

    data = pipe.buffer[1]
    table.remove(pipe.buffer, 1)
    {data = data, eof = false}
end

pipe_write(pipe: any, data: str): any
    pipe.buffer[#pipe.buffer + 1] = data
    {ok = true}
end

pipe_close(pipe: any): void
    pipe.buffer = {}
end

-- ═══════════════════════════════════════════════════════════════
-- Environment Variables
-- ═══════════════════════════════════════════════════════════════

process_env_get(name: str): any
    os.getenv(name)
end

process_env_set(name: str, value: str): any
    -- Use C setenv for persistent environment changes in the current process
    @c.emit("setenv(" .. name .. ", " .. value .. ", 1)")
    -- Also update Lua's environment table
    os.setenv(name, value)
    {ok = true}
end

process_env_unset(name: str): any
    -- Use C unsetenv for persistent environment changes
    @c.emit("unsetenv(" .. name .. ")")
    os.setenv(name, nil)
    {ok = true}
end

process_env_list(): any
    os.getenv()
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Config
M.config_new = process_config_new
M.config_arg = process_config_arg
M.config_args = process_config_args
M.config_env = process_config_env
M.config_cwd = process_config_cwd
M.config_stdin = process_config_stdin
M.config_stdout = process_config_stdout
M.config_stderr = process_config_stderr
M.config_detached = process_config_detached
-- Process
M.new = process_new
M.start = process_start
M.wait = process_wait
M.kill = process_kill
M.write_stdin = process_write_stdin
M.read_stdout = process_read_stdout
M.read_stderr = process_read_stderr
M.is_running = process_is_running
M.exit_code = process_exit_code
-- Helpers
M.run = process_run
M.run_with_input = process_run_with_input
M.output = process_output
-- Pipe
M.pipe_new = pipe_new
M.pipe_read = pipe_read
M.pipe_write = pipe_write
M.pipe_close = pipe_close
-- Environment
M.env_get = process_env_get
M.env_set = process_env_set
M.env_unset = process_env_unset
M.env_list = process_env_list
M
