-- std.os.process — Process management, spawning, pipes
-- For ward's process isolation and runtime management.

-- ═══════════════════════════════════════════════════════════════
-- Process Configuration
-- ═══════════════════════════════════════════════════════════════

fun process_config_new(cmd: str): any
    {
        cmd = cmd,
        args = {},
        env = {},
        cwd = nil,
        stdin = "pipe",
        stdout = "pipe",
        stderr = "pipe",
        detached = false,
        uid = nil,
        gid = nil,
    }
end

fun process_config_arg(config: any, arg: str): any
    config.args[#config.args + 1] = arg
    config
end

fun process_config_args(config: any, args: any): any
    for arg in args
        config.args[#config.args + 1] = arg
    end
    config
end

fun process_config_env(config: any, key: str, value: str): any
    config.env[key] = value
    config
end

fun process_config_cwd(config: any, cwd: str): any
    config.cwd = cwd
    config
end

fun process_config_stdin(config: any, mode: str): any
    config.stdin = mode  -- "pipe", "inherit", "ignore", or file path
    config
end

fun process_config_stdout(config: any, mode: str): any
    config.stdout = mode
    config
end

fun process_config_stderr(config: any, mode: str): any
    config.stderr = mode
    config
end

fun process_config_detached(config: any, detached: bool): any
    config.detached = detached
    config
end

-- ═══════════════════════════════════════════════════════════════
-- Process Handle
-- ═══════════════════════════════════════════════════════════════

fun process_new(): any
    {
        pid = nil,
        exit_code = nil,
        stdin = nil,
        stdout = nil,
        stderr = nil,
        running = false,
        killed = false,
    }
end

fun process_start(proc: any, config: any): any
    -- In production, this would call fork/exec via __emit
    -- For now, return placeholder
    proc.pid = math.random(10000, 99999)
    proc.running = true
    proc.exit_code = nil
    {ok = true, pid = proc.pid}
end

fun process_wait(proc: any): any
    if not proc.running then
        return {exit_code = proc.exit_code}
    end

    -- In production, this would call waitpid
    proc.running = false
    proc.exit_code = 0
    {exit_code = proc.exit_code}
end

fun process_kill(proc: any, signal: i64): any
    if not proc.running then
        return {error = "Process not running"}
    end

    -- In production, this would call kill
    proc.killed = true
    proc.running = false
    proc.exit_code = -signal
    {ok = true}
end

fun process_write_stdin(proc: any, data: str): any
    if proc.stdin == nil then
        return {error = "stdin not available"}
    end

    -- In production, this would write to pipe
    {ok = true}
end

fun process_read_stdout(proc: any): any
    if proc.stdout == nil then
        return {error = "stdout not available"}
    end

    -- In production, this would read from pipe
    {data = "", eof = true}
end

fun process_read_stderr(proc: any): any
    if proc.stderr == nil then
        return {error = "stderr not available"}
    end

    {data = "", eof = true}
end

fun process_is_running(proc: any): bool
    proc.running
end

fun process_exit_code(proc: any): any
    proc.exit_code
end

-- ═══════════════════════════════════════════════════════════════
-- Command Execution Helpers
-- ═══════════════════════════════════════════════════════════════

fun process_run(cmd: str, args: any): any
    config = process_config_new(cmd)
    config = process_config_args(config, args)

    proc = process_new()
    result = process_start(proc, config)
    if result.error then return result end

    process_wait(proc)
    {
        exit_code = proc.exit_code,
        stdout = "",
        stderr = "",
    }
end

fun process_run_with_input(cmd: str, args: any, input: str): any
    config = process_config_new(cmd)
    config = process_config_args(config, args)
    config = process_config_stdin(config, "pipe")

    proc = process_new()
    result = process_start(proc, config)
    if result.error then return result end

    process_write_stdin(proc, input)
    process_wait(proc)
    {
        exit_code = proc.exit_code,
        stdout = "",
        stderr = "",
    }
end

fun process_output(cmd: str, args: any): any
    result = process_run(cmd, args)
    result.stdout
end

-- ═══════════════════════════════════════════════════════════════
-- Pipe (inter-process communication)
-- ═══════════════════════════════════════════════════════════════

fun pipe_new(): any
    {
        read_end = nil,
        write_end = nil,
        buffer = {},
    }
end

fun pipe_read(pipe: any): any
    if #pipe.buffer == 0 then
        return {data = "", eof = true}
    end

    data = pipe.buffer[1]
    table.remove(pipe.buffer, 1)
    {data = data, eof = false}
end

fun pipe_write(pipe: any, data: str): any
    pipe.buffer[#pipe.buffer + 1] = data
    {ok = true}
end

fun pipe_close(pipe: any): void
    pipe.buffer = {}
end

-- ═══════════════════════════════════════════════════════════════
-- Environment Variables
-- ═══════════════════════════════════════════════════════════════

fun process_env_get(name: str): any
    -- In production, this would call getenv
    nil
end

fun process_env_set(name: str, value: str): any
    -- In production, this would call setenv
    {ok = true}
end

fun process_env_unset(name: str): any
    -- In production, this would call unsetenv
    {ok = true}
end

fun process_env_list(): any
    -- In production, this would return all environment variables
    {}
end

