-- std.image — basic image types (mirrors Go's image package)
-- Provides basic color and image model types for representing 2D pixel data.
-- Images are stored as 2D tables of RGBA pixel values.

-- ----- Color -----

-- new_color: create an RGBA color.
fun new_color(r: i64, g: i64, b: i64, a: i64): any
    if a == nil then a = 255 end
    {r = r % 256, g = g % 256, b = b % 256, a = a % 256}
end

-- new_gray: create a grayscale color.
fun new_gray(y: i64): any
    v = y % 256
    {r = v, g = v, b = v, a = 255}
end

-- new_color_from_hex: parse a hex color string (#RRGGBB or #RRGGBBAA).
fun new_color_from_hex(hex: str): any
    if hex == nil then return new_color(0, 0, 0, 255) end
    hex = string.gsub(hex, "^#", "")
    if string.len(hex) == 6 then
        r = tonumber(string.sub(hex, 1, 2), 16)
        g = tonumber(string.sub(hex, 3, 4), 16)
        b = tonumber(string.sub(hex, 5, 6), 16)
        return new_color(r, g, b, 255)
    end
    if string.len(hex) == 8 then
        r = tonumber(string.sub(hex, 1, 2), 16)
        g = tonumber(string.sub(hex, 3, 4), 16)
        b = tonumber(string.sub(hex, 5, 6), 16)
        a = tonumber(string.sub(hex, 7, 8), 16)
        return new_color(r, g, b, a)
    end
    new_color(0, 0, 0, 255)
end

-- color_to_hex: convert a color to a hex string.
fun color_to_hex(c: any): str
    if c == nil then return "#000000FF" end
    string.format("#%02X%02X%02X%02X", c.r, c.g, c.b, c.a)
end

-- color_to_rgb: return the RGB triple as a string "rgb(r, g, b)".
fun color_to_rgb(c: any): str
    if c == nil then return "rgb(0, 0, 0)" end
    "rgb(" .. tostring(c.r) .. ", " .. tostring(c.g) .. ", " .. tostring(c.b) .. ")"
end

-- color_to_rgba: return the RGBA string.
fun color_to_rgba(c: any): str
    if c == nil then return "rgba(0, 0, 0, 1)" end
    alpha = c.a / 255.0
    "rgba(" .. tostring(c.r) .. ", " .. tostring(c.g) .. ", " .. tostring(c.b) .. ", " .. string.format("%.2f", alpha) .. ")"
end

-- color_invert: return the inverted color.
fun color_invert(c: any): any
    if c == nil then return nil end
    new_color(255 - c.r, 255 - c.g, 255 - c.b, c.a)
end

-- color_blend: blend two colors with factor t (0.0 = c1, 1.0 = c2).
fun color_blend(c1: any, c2: any, t: f64): any
    if c1 == nil then return c2 end
    if c2 == nil then return c1 end
    if t == nil then t = 0.5 end
    if t < 0 then t = 0 end
    if t > 1 then t = 1 end
    r = math.floor(c1.r + (c2.r - c1.r) * t)
    g = math.floor(c1.g + (c2.g - c1.g) * t)
    b = math.floor(c1.b + (c2.b - c1.b) * t)
    a = math.floor(c1.a + (c2.a - c1.a) * t)
    new_color(r, g, b, a)
end

-- color_grayscale: convert a color to grayscale.
fun color_grayscale(c: any): any
    if c == nil then return nil end
    y = math.floor(0.299 * c.r + 0.587 * c.g + 0.114 * c.b)
    new_gray(y)
end

-- ----- Image -----

-- new_rgba: create a new RGBA image of width w and height h.
fun new_rgba(w: i64, h: i64): any
    {width = w, height = h, pixels = {}, stride = w, model = "rgba"}
end

-- set_pixel: set the pixel at (x, y) to color c.
fun set_pixel(img: any, x: i64, y: i64, c: any): void
    if img == nil then return end
    if x < 0 or x >= img.width or y < 0 or y >= img.height then return end
    idx = y * img.stride + x + 1
    img.pixels[idx] = c
end

-- get_pixel: get the pixel at (x, y).
fun get_pixel(img: any, x: i64, y: i64): any
    if img == nil then return nil end
    if x < 0 or x >= img.width or y < 0 or y >= img.height then return nil end
    idx = y * img.stride + x + 1
    img.pixels[idx]
end

-- bounds: return the image bounds as {min = {x=0,y=0}, max = {x=w, y=h}}.
fun bounds(img: any): any
    if img == nil then return {min = {x = 0, y = 0}, max = {x = 0, y = 0}} end
    {min = {x = 0, y = 0}, max = {x = img.width, y = img.height}}
end

-- fill: fill the entire image with a single color.
fun fill(img: any, c: any): void
    if img == nil then return end
    y = 0
    while y < img.height
        x = 0
        while x < img.width
            set_pixel(img, x, y, c)
            x = x + 1
        end
        y = y + 1
    end
end

-- clear: set all pixels to transparent black.
fun clear(img: any): void
    if img == nil then return end
    img.pixels = {}
end

-- to_ascii: render the image as ASCII art (for terminal output).
fun to_ascii(img: any): str
    if img == nil then return "" end
    chars = " .:-=+*#%@"
    out = {}
    y = 0
    while y < img.height
        line = ""
        x = 0
        while x < img.width
            c = get_pixel(img, x, y)
            if c == nil then
                line = line .. " "
            else
                -- luminance
                lum = (0.299 * c.r + 0.587 * c.g + 0.114 * c.b) / 255.0
                idx = math.floor(lum * 9) + 1
                line = line .. string.sub(chars, idx, idx)
            end
            x = x + 1
        end
        out[rawlen(out) + 1] = line
        y = y + 1
    end
    table.concat(out, "\n")
end

-- resize: resize an image to new dimensions (nearest-neighbor).
fun resize(img: any, new_w: i64, new_h: i64): any
    if img == nil then return nil end
    out = new_rgba(new_w, new_h)
    y = 0
    while y < new_h
        x = 0
        while x < new_w
            src_x = math.floor(x * img.width / new_w)
            src_y = math.floor(y * img.height / new_h)
            set_pixel(out, x, y, get_pixel(img, src_x, src_y))
            x = x + 1
        end
        y = y + 1
    end
    out
end

M = {}
M.new_color = new_color
M.new_gray = new_gray
M.new_color_from_hex = new_color_from_hex
M.color_to_hex = color_to_hex
M.color_to_rgb = color_to_rgb
M.color_to_rgba = color_to_rgba
M.color_invert = color_invert
M.color_blend = color_blend
M.color_grayscale = color_grayscale
M.new_rgba = new_rgba
M.set_pixel = set_pixel
M.get_pixel = get_pixel
M.bounds = bounds
M.fill = fill
M.clear = clear
M.to_ascii = to_ascii
M.resize = resize
M