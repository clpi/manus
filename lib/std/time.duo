-- std.time — time utilities

@c.include("sys/time.h")
@c.include("time.h")

now(): int
    os.time()
end

clock(): float
    os.clock()
end

difftime(t2: int, t1: int): float
    os.difftime(t2, t1)
end

sleep(seconds: any): void
    if seconds == nil return end
    sec = math.floor(seconds)
    ns = math.floor((seconds - sec) * 1000000000)
    -- `sec`/`ns` are C locals in the emitted function; reference them directly.
    -- @c.emit takes a compile-time constant string, so runtime `..` interpolation
    -- would be spliced in literally rather than evaluated.
    @c.emit("({ struct timespec ts; ts.tv_sec = (time_t)sec; ts.tv_nsec = (long)ns; nanosleep(&ts, NULL); })")
end

now_ns(): i64
    @c.emit("({ struct timeval tv; gettimeofday(&tv, NULL); (int64_t)(tv.tv_sec * 1000000000LL + tv.tv_usec * 1000LL); })")
end

monotonic(): i64
    now_ns()
end

