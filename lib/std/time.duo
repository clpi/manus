-- std.time — time utilities

@c.include("sys/time.h")
@c.include("time.h")

now(): int
    os.time()
end

clock(): float
    os.clock()
end

difftime(t2: int, t1: int): float
    os.difftime(t2, t1)
end

sleep(seconds: any): void
    if seconds == nil return end
    sec = math.floor(seconds)
    ns = math.floor((seconds - sec) * 1000000000)
    -- `sec`/`ns` are C locals in the emitted function; reference them directly.
    -- @c.emit takes a compile-time constant string, so runtime `..` interpolation
    -- would be spliced in literally rather than evaluated.
    @c.emit("({ struct timespec ts; ts.tv_sec = (time_t)sec; ts.tv_nsec = (long)ns; nanosleep(&ts, NULL); })")
end

-- The `return` is load-bearing. Without it the emitted expression was dropped
-- and this returned 0 for every call -- so `monotonic()` measured a zero delta
-- across a 250 ms sleep, and any Duo benchmark harness built on it would have
-- reported every run as instantaneous. Every other @c.emit-bodied function in
-- the stdlib (see std.script.fs_exists) already writes the explicit return.
now_ns(): i64
    return @c.emit("({ struct timeval tv; gettimeofday(&tv, NULL); (int64_t)(tv.tv_sec * 1000000000LL + tv.tv_usec * 1000LL); })")
end

monotonic(): i64
    now_ns()
end

