-- std.time — time utilities

@c.include("sys/time.h")
@c.include("time.h")

fun now(): i64
    @c.emit("((int64_t)time(NULL))")
end

fun time_clock(): float
    os.clock()
end

fun time_difftime(t2: int, t1: int): float
    os.difftime(t2, t1)
end

fun time_sleep(seconds: any): void
    if seconds == nil then return end
    local sec = math.floor(seconds)
    local ns = math.floor((seconds - sec) * 1000000000)
    __emit("({ struct timespec ts; ts.tv_sec = " .. tostring(sec) .. "; ts.tv_nsec = " .. tostring(ns) .. "; nanosleep(&ts, NULL); })")
end

fun now_ns(): i64
    __emit("({ struct timeval tv; gettimeofday(&tv, NULL); (int64_t)(tv.tv_sec * 1000000000LL + tv.tv_usec * 1000LL); })")
end

fun monotonic(): i64
    now_ns()
end

M = {}
M.now = now
M.clock = time_clock
M.difftime = time_difftime
M.sleep = time_sleep
M.now_ns = now_ns
M.monotonic = monotonic
M
