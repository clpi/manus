-- std.time — time utilities

fun now(): int
    os.time()
end

fun clock(): float
    os.clock()
end

fun difftime(t2: int, t1: int): float
    os.difftime(t2, t1)
end

fun sleep(seconds: any): void
    if seconds == nil then return end
    os.execute("sleep " .. tostring(seconds))
end

M = {}
M.now = now
M.clock = clock
M.difftime = difftime
M.sleep = sleep
M
