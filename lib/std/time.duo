-- std.time — time utilities

fun now(): int
    os.time()
end

fun time_clock(): float
    os.clock()
end

fun time_difftime(t2: int, t1: int): float
    os.difftime(t2, t1)
end

fun time_sleep(seconds: any): void
    if seconds == nil then return end
    os.execute("sleep " .. tostring(seconds))
end

M = {}
M.now = now
M.clock = time_clock
M.difftime = time_difftime
M.sleep = time_sleep
M