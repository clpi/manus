-- std.net — TCP/UDP sockets + HTTP client/server (Requirement 20.5)
-- When the module variable is named "net", the codegen emits direct C calls
-- (duo_net_tcp_connect, duo_net_http_get, etc.) for zero-overhead networking.
-- Otherwise, this Lua fallback uses curl for HTTP and stubs for raw sockets.

-- Parse a URL into {scheme, host, port, path}
fun parse_url(url: str): any
    scheme = "http"
    rest = url
    if string.sub(rest, 1, 7) == "http://" then
        rest = string.sub(rest, 8)
    elseif string.sub(rest, 1, 8) == "https://" then
        scheme = "https"
        rest = string.sub(rest, 9)
    end
    if scheme == "https" then default_port = 443 else default_port = 80 end
    host = rest
    path = "/"
    slash_pos = string.find(rest, "/")
    if slash_pos then
        host = string.sub(rest, 1, slash_pos - 1)
        path = string.sub(rest, slash_pos)
    end
    colon_pos = string.find(host, ":")
    port = default_port
    if colon_pos then
        port = tonumber(string.sub(host, colon_pos + 1)) or default_port
        host = string.sub(host, 1, colon_pos - 1)
    end
    {scheme = scheme, host = host, port = port, path = path}
end

-- HTTP GET via curl (fallback when variable not named "net")
fun http_get(url: str): str
    f = io.popen("curl -sL --max-time 30 -- " .. url, "r")
    if f == nil then return "" end
    body = f:read("*a") or ""
    f:close()
    body
end

-- HTTP POST via curl (fallback)
fun http_post(url: str, body: str, content_type: str): str
    ct = content_type
    if ct == nil then ct = "application/x-www-form-urlencoded" end
    if body == nil then body = "" end
    escaped = string.gsub(body, "'", "'\\''")
    cmd = "curl -sL --max-time 30 -X POST"
        .. " -H 'Content-Type: " .. ct .. "'"
        .. " --data '" .. escaped .. "' -- " .. url
    f = io.popen(cmd, "r")
    if f == nil then return "" end
    resp = f:read("*a") or ""
    f:close()
    resp
end

-- HTTP request returning {body, status} via curl
fun http_request(method: str, url: str, body: str, headers: any): any
    cmd = "curl -si --max-time 30 -X " .. method
    if headers then
        for k, v in pairs(headers)
            cmd = cmd .. " -H '" .. k .. ": " .. v .. "'"
        end
    end
    if body and body ~= "" then
        escaped = string.gsub(body, "'", "'\\''")
        cmd = cmd .. " --data '" .. escaped .. "'"
    end
    cmd = cmd .. " -- " .. url
    f = io.popen(cmd, "r")
    if f == nil then return {body = "", status = 0} end
    raw = f:read("*a") or ""
    f:close()
    status = tonumber(string["match"](raw, "HTTP/%d+%.%d+ (%d+)")) or 0
    sep = string.find(raw, "\r\n\r\n", 1, true)
    resp_b = raw
    if sep then
        resp_b = string.sub(raw, sep + 4)
    end
    {body = resp_b, status = status}
end

-- Raw TCP connect — stub (real impl via codegen interception when var = "net")
fun std_net_connect(host: str, port: i64): any
    nil  -- intercepted: duo_net_tcp_connect(host, port)
end

-- TCP listen — stub
fun std_net_listen(host: str, port: i64, backlog: i64): any
    nil  -- intercepted: duo_net_tcp_listen(host, port, backlog)
end

-- TCP accept — stub
fun std_net_accept(srv_fd: any): any
    nil  -- intercepted: duo_net_tcp_accept(srv_fd)
end

-- TCP send — stub
fun std_net_send(fd: any, data: str): i64
    0 - 1   -- intercepted: duo_net_tcp_send(fd, data)
end

-- TCP recv — stub
fun std_net_recv(fd: any, maxlen: i64): any
    nil     -- intercepted: duo_net_tcp_recv(fd, maxlen)
end

-- TCP close — stub
fun std_net_close(fd: any): void
    -- intercepted: duo_net_tcp_close(fd)
end

-- UDP socket — stub
fun udp_socket(host: str, port: i64): any
    nil  -- intercepted: duo_net_udp_socket_open(host, port)
end

-- UDP sendto — stub
fun udp_sendto(fd: any, data: str, host: str, port: i64): i64
    0 - 1   -- intercepted: duo_net_udp_sendto(fd, data, host, port)
end

-- UDP recvfrom — stub
fun udp_recvfrom(fd: any, maxlen: i64): any
    nil  -- intercepted: duo_net_udp_recvfrom(fd, maxlen)
end

-- Simple blocking HTTP server (requires native socket support via codegen path)
-- handler(method, path, raw_request) -> response_body string
fun http_serve(port: i64, handler: any): void
    srv = std_net_listen("0.0.0.0", port, 128)
    if srv == nil then
        io.write("net.http_serve: listen failed on port " .. tostring(port) .. "\n")
    end
    io.write("net: listening on :" .. tostring(port) .. "\n")
    while true
        cli = std_net_accept(srv)
        if cli == nil then break end
        raw = std_net_recv(cli, 16384)
        if raw ~= nil then
            method = ""
            req_path = ""
            method, req_path = string["match"](raw, "^(%u+) (/[^ ]*)")
            if method == nil then method = "GET" end
            if req_path == nil then req_path = "/" end
            resp_body = handler(method, req_path, raw) or ""
            response = "HTTP/1.0 200 OK\r\n"
                .. "Content-Type: text/plain\r\n"
                .. "Content-Length: " .. tostring(#resp_body) .. "\r\n"
                .. "Connection: close\r\n\r\n"
                .. resp_body
            std_net_send(cli, response)
        end
        std_net_close(cli)
    end
    std_net_close(srv)
end

M = {}
M.parse_url = parse_url
M.http_get = http_get
M.http_post = http_post
M.http_request = http_request
M.connect = std_net_connect
M.listen = std_net_listen
M.accept = std_net_accept
M.send = std_net_send
M.recv = std_net_recv
M.close = std_net_close
M.udp_socket   = udp_socket
M.udp_sendto   = udp_sendto
M.udp_recvfrom = udp_recvfrom
M.http_serve   = http_serve
M
