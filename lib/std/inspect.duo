-- std.inspect — deep inspection, formatting, and debugging of values
-- Provides rich pretty-printing, table diffing, and deep comparison
-- for debugging complex data structures.

-- Internal: sort string array in-place.
std_inspect_sort_strings(arr: any): void
    if arr == nil return end
    n = rawlen(arr)
    i = 1
    while i <= n
        j = i
        while j > 1 and arr[j] < arr[j - 1]
            tmp = arr[j]; arr[j] = arr[j - 1]; arr[j - 1] = tmp
            j -= 1
        end
        i += 1
    end
end

-- Internal: recursive deep hash.
std_inspect_hash(value: any): str
    if value == nil return "nil" end
    t = type(value)
    if t != "table" return t .. ":" .. to(str)(value) end
    parts = {}
    ks = {}
    for k, v in value
        ks[rawlen(ks) + 1] = to(str)(k)
    end
    std_inspect_sort_strings(ks)
    i = 1
    while i <= rawlen(ks)
        k = ks[i]
        v = value[tonumber(k)]
        if v == nil v = value[k] end
        parts[rawlen(parts) + 1] .. k .. "=" .. std_inspect_hash(v)
        i += 1
    end
    "{" .. table.concat(parts, ",") .. "}"
end

-- Internal: recursive to_str with cycle detection.
std_inspect_to_str(value: any, indent: any, seen: any): str
    if indent == nil indent = 0 end
    if seen == nil seen = {} end
    if value == nil return "nil" end
    t = type(value)
    if t == "string"
        return '"' .. value .. '"'
    end
    if t == "number"
        return to(str)(value)
    end
    if t == "boolean"
        if value return "true" end
        return "false"
    end
    if t == "function"
        return "<function>"
    end
    if t != "table"
        return to(str)(value)
    end
    ptr = to(str)(value)
    if seen[ptr] != nil return "<circular>" end
    seen[ptr] = true
    n = rawlen(value)
    if n > 0
        parts = {}
        i = 1
        while i <= n
            parts[rawlen(parts) + 1] = std_inspect_to_str(value[i], indent + 1, seen)
            i += 1
        end
        prefix = string.rep("  ", indent)
        inner_prefix = string.rep("  ", indent + 1)
        if rawlen(parts) <= 4 and indent < 2
            return "[" .. table.concat(parts, ", ") .. "]"
        end
        return "[\n" .. inner_prefix .. table.concat(parts, ",\n" .. inner_prefix) .. "\n" .. prefix .. "]"
    end
    pairs_list = {}
    for k, v in value
        pairs_list[rawlen(pairs_list) + 1] = {k = k, v = v}
    end
    if rawlen(pairs_list) == 0 return "{}" end
    parts = {}
    i = 1
    while i <= rawlen(pairs_list)
        pair = pairs_list[i]
        key_str = to(str)(pair.k)
        if type(pair.k) == "string"
            key_str = pair.k
        end
        val_str = std_inspect_to_str(pair.v, indent + 1, seen)
        parts[rawlen(parts) + 1] = key_str .. " = " .. val_str
        i += 1
    end
    prefix = string.rep("  ", indent)
    inner_prefix = string.rep("  ", indent + 1)
    if rawlen(parts) <= 3 and indent < 2
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return "{\n" .. inner_prefix .. table.concat(parts, ",\n" .. inner_prefix) .. "\n" .. prefix .. "}"
end

-- Internal: recursive diff helper.
std_inspect_diff(a: any, b: any, prefix: any, diffs: any): void
    if a == nil and b == nil return end
    if a == nil or b == nil
        if a == nil
            diffs[rawlen(diffs) + 1] = {path = prefix, kind = "added", new = b}
        else
            diffs[rawlen(diffs) + 1] = {path = prefix, kind = "removed", old = a}
        end
        return
    end
    if type(a) != type(b)
        diffs[rawlen(diffs) + 1] = {path = prefix, kind = "changed", old = a, new = b}
        return
    end
    if type(a) != "table"
        if a != b
            diffs[rawlen(diffs) + 1] = {path = prefix, kind = "changed", old = a, new = b}
        end
        return
    end
    for k, v in a
        path = k
        if prefix != "" path = prefix .. "." .. to(str)(k) end
        if b[k] == nil
            diffs[rawlen(diffs) + 1] = {path = path, kind = "removed", old = v}
        else
            std_inspect_diff(v, b[k], path, diffs)
        end
    end
    for k, v in b
        if a[k] == nil
            path = k
            if prefix != "" path = prefix .. "." .. to(str)(k) end
            diffs[rawlen(diffs) + 1] = {path = path, kind = "added", new = v}
        end
    end
end

-- to_str: deep-convert any value to a human-readable string.
to_str(value: any, indent: any, seen: any): str
    std_inspect_to_str(value, indent, seen)
end

-- deep_equal: recursively compare two values for structural equality.
deep_equal(a: any, b: any): bool
    if a == b return true end
    if a == nil or b == nil return false end
    if type(a) != type(b) return false end
    if type(a) != "table" return false end
    na = rawlen(a)
    nb = rawlen(b)
    if na != nb return false end
    if na > 0
        i = 1
        while i <= na
            if not deep_equal(a[i], b[i]) return false end
            i += 1
        end
        for ka, _va in a
            if type(ka) != "number"
                if not deep_equal(a[ka], b[ka]) return false end
            end
        end
        for kb, _vb in b
            if a[kb] == nil return false end
        end
        return true
    end
    for kc, vc in a
        if not deep_equal(vc, b[kc]) return false end
    end
    for kd, _vd in b
        if a[kd] == nil return false end
    end
    true
end

-- deep_hash: produce a consistent hash of any value.
deep_hash(value: any): str
    std_inspect_hash(value)
end

-- diff: compare two tables and return a list of differences.
diff(a: any, b: any, prefix: any): any
    if prefix == nil prefix = "" end
    diffs = {}
    std_inspect_diff(a, b, prefix, diffs)
    diffs
end

-- diff_summary: return a human-readable summary of differences.
diff_summary(a: any, b: any): str
    diffs = diff(a, b)
    if rawlen(diffs) == 0 return "no differences" end
    parts = {}
    i = 1
    while i <= rawlen(diffs)
        d = diffs[i]
        line = d.kind .. " " .. d.path
        if d.kind == "changed"
            line = line .. ": " .. to(str)(d.old) .. " -> " .. to(str)(d.new)
        elseif d.kind == "added"
            line = line .. ": " .. to(str)(d.new)
        elseif d.kind == "removed"
            line = line .. ": " .. to(str)(d.old)
        end
        parts[rawlen(parts) + 1] = line
        i += 1
    end
    to(str)(rawlen(diffs)) .. " difference(s):\n" .. table.concat(parts, "\n")
end

-- type_name: get a descriptive type name for a value.
type_name(value: any): str
    if value == nil return "nil" end
    t = type(value)
    if t == "table"
        n = rawlen(value)
        if n > 0 return "array[" .. to(str)(n) .. "]" end
        count = 0
        for _ck, _cv in value
            count += 1
        end
        if count > 0 return "table[" .. to(str)(count) .. "]" end
        return "table"
    end
    return t
end

-- size: return the "size" of a value.
size(value: any): i64
    if value == nil return 0 end
    t = type(value)
    if t == "string" return string.len(value) end
    if t == "table"
        n = rawlen(value)
        if n > 0 return n end
        count = 0
        for _ck, _cv in value
            count += 1
        end
        return count
    end
    return 1
end

-- keys_of: return sorted list of keys of a table.
keys_of(t: any): any
    out = {}
    if t == nil or type(t) != "table" return out end
    for kk, _kv in t
        out[rawlen(out) + 1] = to(str)(kk)
    end
    std_inspect_sort_strings(out)
    out
end

-- summary: return a compact summary of a value's structure.
summary(value: any): str
    if value == nil return "nil" end
    t = type(value)
    if t != "table" return t .. ": " .. to(str)(value) end
    n = rawlen(value)
    if n > 0
        return "array(" .. to(str)(n) .. " elements)"
    end
    count = 0
    first_key = nil
    for k, v in value
        count += 1
        if first_key == nil first_key = to(str)(k) end
    end
    if count == 0 return "empty table" end
    if count <= 3
        return "table(" .. to(str)(count) .. " keys: " .. first_key .. " ...)"
    end
    return "table(" .. to(str)(count) .. " keys)"
end

-- caller_info: return info about the calling function.
caller_info(level: any): any
    if level == nil level = 2 end
    info = debug.getinfo(level)
    if info == nil return nil end
    {
        name = info.name,
        source = info.source,
        linedefined = info.linedefined,
        currentline = info.currentline,
        what = info.what
    }
end

-- stack_trace: return a formatted stack trace string.
--   stack_trace(level?, max_depth?, pretty?)
--   pretty = true => ANSI-colored, icon-signed frames (cyan-underlined
--   locations, magenta-italic function names, dim caller meta).
stack_trace(level: any, max_depth: any, pretty: any): str
    if level == nil level = 2 end
    if max_depth == nil max_depth = 20 end
    color_ok = false
    if pretty
        pcall_ok, env_val = pcall(os.getenv, "NO_COLOR")
        if pcall_ok and env_val != nil and env_val != ""
            color_ok = false
        else
            color_ok = true
        end
    end
    C_RESET, C_DIM, C_CYAN, C_MAGENTA, C_YELLOW, C_UNDER, C_ITALIC
    if color_ok
        C_RESET  = "\x1b[0m"
        C_DIM    = "\x1b[2m"
        C_ITALIC = "\x1b[3m"
        C_UNDER  = "\x1b[4m"
        C_CYAN   = "\x1b[36m"
        C_MAGENTA= "\x1b[35m"
        C_YELLOW = "\x1b[33m"
    end
    lines = {}
    i = level
    while i < level + max_depth
        info = debug.getinfo(i, "Snl")
        if info == nil break end
        fname = info.name
        if fname == nil or fname == "" fname = "?" end
        src = info.short_src
        if src == nil src = info.source end
        if src == nil src = "?" end
        if color_ok
            frame = "  " .. C_DIM .. "↳ " .. C_RESET ..
                    C_MAGENTA .. C_ITALIC .. fname .. "()" .. C_RESET
            loc = src
            if info.currentline and info.currentline > 0
                loc = src .. C_DIM .. ":" .. C_RESET .. C_YELLOW .. to(str)(info.currentline) .. C_RESET
            end
            frame = frame .. "  " .. C_DIM .. "⟨" .. C_RESET ..
                    C_UNDER .. loc .. C_RESET .. C_DIM .. "⟩" .. C_RESET
        else
            frame = fname .. "()"
            if info.currentline and info.currentline > 0
                frame = frame .. " [" .. src .. ":" .. to(str)(info.currentline) .. "]"
            else
                frame = frame .. " [" .. src .. "]"
            end
        end
        lines[rawlen(lines) + 1] = frame
        i += 1
    end
    table.concat(lines, "\n")
end

M = {}
M.to_str = to_str
M.deep_equal = deep_equal
M.deep_hash = deep_hash
M.diff = diff
M.diff_summary = diff_summary
M.type_name = type_name
M.size = size
M.keys_of = keys_of
M.summary = summary
M.caller_info = caller_info
M.stack_trace = stack_trace
M
