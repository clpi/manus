-- std.reflect — runtime reflection (mirrors Go's reflect package)
-- Provides type inspection and value manipulation for Duo tables and values.

-- type_of: return a type descriptor string for a value.
-- Returns one of: "nil", "boolean", "number", "string", "table", "function".
fun std_reflect_typeof(v: any): str
    return type(v)
end

fun eq_str(a: str, b: str): bool
    string.find(a, b, 1, true) == 1 and #a == #b
end

-- kind: return a more detailed kind string.
fun kind(v: any): str
    t = type(v)
    if eq_str(t, "number") then
        if v == math.floor(v) then return "int" end
        "float"
    elseif eq_str(t, "table") then
        -- check if it's an array (all integer keys 1..n)
        n = #v
        if n > 0 then
            count = 0
            for _ in v do count += 1 end
            if count == n then return "array" end
        end
        "map"
    else
        t
    end
end

-- size: return the "size" of a value (array length or map key count).
fun size(v: any): i64
    if v == nil then return 0 end
    t = type(v)
    if t == "table" then
        n = rawlen(v)
        if n > 0 then return n end
        count = 0
        for _k, _v in v do count += 1 end
        return count
    end
    if t == "string" then return string.len(v) end
    1
end

-- is_nil: report whether v is nil.
fun is_nil(v: any): bool
    v == nil
end

-- is_valid: report whether v is not nil.
fun is_valid(v: any): bool
    v ~= nil
end

-- can_int: report whether v can be converted to an integer.
fun can_int(v: any): bool
    if type(v) == "number" then return true end
    if type(v) == "string" then
        return tonumber(v) ~= nil
    end
    false
end

-- to_int: convert v to an integer, or nil if impossible.
fun to_int(v: any): any
    if type(v) == "number" then return math.floor(v) end
    if type(v) == "string" then
        n = tonumber(v)
        if n ~= nil then return math.floor(n) end
    end
    nil
end

-- to_float: convert v to a float, or nil.
fun to_float(v: any): any
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) end
    nil
end

-- to_string: convert v to a string.
fun to_string(v: any): str
    if v == nil then return "" end
    tostring(v)
end

-- to_bool: convert v to a boolean.
fun to_bool(v: any): bool
    if v == nil then return false end
    if type(v) == "boolean" then return v end
    if type(v) == "number" then return v ~= 0 end
    if type(v) == "string" then return v ~= "" and v ~= "false" and v ~= "0" end
    true
end

-- fields: return the key-value pairs of a table as an array of {key, value, type}.
fun std_reflect_fields(v: any): any
    if v == nil or type(v) ~= "table" then return {} end
    out = {}
    for k, val in v
        out[rawlen(out) + 1] = {key = k, value = val, type = type(val)}
    end
    out
end

-- field_names: return the keys of a table as an array.
fun field_names(v: any): any
    if v == nil or type(v) ~= "table" then return {} end
    out = {}
    for k, _ in v do out[rawlen(out) + 1] = k end
    out
end

-- field_by_name: look up a key in a table.
fun field_by_name(v: any, name: str): any
    if v == nil or type(v) ~= "table" then return nil end
    v[name]
end

-- set_field: set a key in a table.
fun set_field(v: any, name: str, value: any): void
    if v == nil or type(v) ~= "table" then return end
    v[name] = value
end

-- elem: if v is a table, return v[index]; for nil returns nil.
fun elem(v: any, index: any): any
    if v == nil then return nil end
    v[index]
end

-- len: return the length of an array or string.
fun len(v: any): i64
    if v == nil then return 0 end
    if type(v) == "string" then return string.len(v) end
    if type(v) == "table" then return rawlen(v) end
    0
end

-- deep_equal: structural deep equality for tables and primitives.
fun deep_equal(a: any, b: any): bool
    if a == b then return true end
    if a == nil or b == nil then return false end
    if type(a) ~= type(b) then return false end
    if type(a) ~= "table" then return a == b end
    -- compare table key counts
    ca = 0
    for _k, _v in a do ca += 1 end
    cb = 0
    for _k, _v in b do cb += 1 end
    if ca ~= cb then return false end
    for k, va in a
        vb = b[k]
        if not deep_equal(va, vb) then return false end
    end
    true
end

-- deep_copy: recursively copy a table.
fun deep_copy(v: any): any
    if v == nil then return nil end
    if type(v) ~= "table" then return v end
    out = {}
    for k, val in v
        out[k] = deep_copy(val)
    end
    out
end

-- map_keys: return all keys (both array and hash) as an array.
fun map_keys(v: any): any
    if v == nil or type(v) ~= "table" then return {} end
    out = {}
    for k, _ in v do out[rawlen(out) + 1] = k end
    out
end

-- map_values: return all values as an array.
fun map_values(v: any): any
    if v == nil or type(v) ~= "table" then return {} end
    out = {}
    for _, val in v do out[rawlen(out) + 1] = val end
    out
end

-- call: call a function value with the given argument array.
fun call(fn: any, args: any): any
    if fn == nil or type(fn) ~= "function" then return nil end
    fn(table.unpack(args))
end

M = {}
M.typeof = std_reflect_typeof
M.kind = kind
M.size = size
M.is_nil = is_nil
M.is_valid = is_valid
M.can_int = can_int
M.to_int = to_int
M.to_float = to_float
M.to_string = to_string
M.to_bool = to_bool
M.fields = std_reflect_fields
M.field_names = field_names
M.field_by_name = field_by_name
M.set_field = set_field
M.elem = elem
M.len = len
M.deep_equal = deep_equal
M.deep_copy = deep_copy
M.map_keys = map_keys
M.map_values = map_values
M.call = call
M
