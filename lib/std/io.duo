-- std.io — input/output utilities

fun io_open(filename: str, mode: str): any
    io.open(filename, mode)
end

fun io_popen(prog: str, mode: str): any
    io.popen(prog, mode)
end

fun io_read(file: any, arg: any): any
    file:read(arg)
end

fun io_write(file: any, arg: any): any
    file:write(arg)
end

fun io_close(file: any): void
    file:close()
end

fun io_flush(file: any): void
    file:flush()
end

fun io_lines(filename: str): any
    io.lines(filename)
end

fun io_input(file: any): any
    io.input(file)
end

fun io_output(file: any): any
    io.output(file)
end

fun io_tmpfile(): any
    io.tmpfile()
end

fun io_type(obj: any): any
    io.type(obj)
end

M = {}
M.open = io_open
M.popen = io_popen
M.read = io_read
M.write = io_write
M.close = io_close
M.flush = io_flush
M.lines = io_lines
M.input = io_input
M.output = io_output
M.tmpfile = io_tmpfile
M.type = io_type
M