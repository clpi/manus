-- std.io — input/output utilities
-- Binary I/O: io.read(n) reads exactly n bytes from stdin (LSP Content-Length framing)
-- io.read("*l") reads a line, io.read("*a") reads all remaining input

fun open(filename: str, mode: str): any
    io.open(filename, mode)
end

fun popen(prog: str, mode: str): any
    io.popen(prog, mode)
end

fun read(file: any, arg: any): any
    file:read(arg)
end

fun write(file: any, arg: any): any
    file:write(arg)
end

fun close(file: any): void
    file:close()
end

fun flush(file: any): void
    file:flush()
end

fun lines(filename: str): any
    io.lines(filename)
end

fun input(file: any): any
    io.input(file)
end

fun output(file: any): any
    io.output(file)
end

fun tmpfile(): any
    io.tmpfile()
end

fun type(obj: any): any
    io.type(obj)
end

-- read_bytes: read exactly n bytes from a file or stdin.
-- For LSP JSON-RPC: read header with read("*l"), extract Content-Length,
-- then read_bytes(len) to get the body.
fun read_bytes(file: any, n: int): str
    file:read(n)
end

-- write_bytes: write a string/bytes to a file or stdout.
fun write_bytes(file: any, data: str): void
    file:write(data)
end

-- read_line: convenience to read one line from a file
fun read_line(file: any): str
    file:read("*l")
end

-- read_all: convenience to read all remaining input
fun read_all(file: any): str
    file:read("*a")
end