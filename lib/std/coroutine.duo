-- std.coroutine — coroutine utilities

create(f: any): any
    coroutine.create(f)
end

resume(co: any, arg: any): any
    coroutine.resume(co, arg)
end

yield(arg: any): any
    coroutine.yield(arg)
end

status(co: any): str
    coroutine.status(co)
end

running(): any
    coroutine.running()
end

wrap(f: any): any
    coroutine.wrap(f)
end

isyieldable(): bool
    coroutine.isyieldable()
end

co_close(co: any): any
    coroutine.close(co)
end

M = {}
M.create = create
M.resume = resume
M.yield = yield
M.status = status
M.running = running
M.wrap = wrap
M.isyieldable = isyieldable
M.close = co_close
M