-- std.table — table and array helper utilities

fun std_table_len(t: any): any
    if t == nil then return 0 end
    rawlen(t)
end

fun std_table_keys(t: any): any
    out = {}
    if t == nil then return out end
    for k, _ in pairs(t)
        out[rawlen(out) + 1] = k
    end
    out
end

fun std_table_values(t: any): any
    out = {}
    if t == nil then return out end
    for _, v in pairs(t)
        out[rawlen(out) + 1] = v
    end
    out
end

fun std_table_clone(t: any): any
    out = {}
    if t == nil then return out end
    for k, v in pairs(t)
        out[k] = v
    end
    out
end

fun std_table_merge(a: any, b: any): any
    out = std_table_clone(a)
    if b ~= nil then
        for k, v in pairs(b)
            out[k] = v
        end
    end
    out
end

fun std_table_contains(list: any, value: any): bool
    if list == nil then return false end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        if v == value then return true end
        i += 1
    end
    false
end

fun std_table_index_of(list: any, value: any): any
    if list == nil then return 0 end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        if v == value then return i end
        i += 1
    end
    0
end

fun std_table_reverse(list: any): any
    out = {}
    if list == nil then return out end
    i = rawlen(list)
    while i >= 1
        out[rawlen(out) + 1] = list[i]
        i -= 1
    end
    out
end

fun std_table_map(list: any, fn: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        out[i] = fn(v, i)
        i += 1
    end
    out
end

fun std_table_filter(list: any, fn: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        if fn(v, i) then
            out[rawlen(out) + 1] = v
        end
        i += 1
    end
    out
end

fun std_table_reduce(list: any, fn: any, init: any): any
    acc = init
    if list == nil then return acc end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        acc = fn(acc, v, i)
        i += 1
    end
    acc
end

fun std_table_clear(t: any): void
    if t == nil then return end
    for k, _ in pairs(t)
        t[k] = nil
    end
end

fun std_table_is_empty(t: any): bool
    if t == nil then return true end
    next(t) == nil
end

fun std_table_slice(t: any, start_idx: any, end_idx: any): any
    out = {}
    if t == nil then return out end
    if start_idx == nil then start_idx = 1 end
    if end_idx == nil then end_idx = rawlen(t) end
    if start_idx < 1 then start_idx = 1 end
    if end_idx > rawlen(t) then end_idx = rawlen(t) end
    i = start_idx
    while i <= end_idx
        out[rawlen(out) + 1] = t[i]
        i += 1
    end
    out
end

fun std_table_concat(t: any, sep: any): str
    if t == nil then return "" end
    if sep == nil then sep = "" end
    table.concat(t, sep)
end

fun std_table_sort(list: any, cmp: any): void
    if list == nil then return end
    if cmp == nil then
        table.sort(list)
    else
        table.sort(list, cmp)
    end
end

fun std_table_unpack(list: any, i: any, j: any): any
    if list == nil then return nil end
    if i == nil then i = 1 end
    if j == nil then j = rawlen(list) end
    table.unpack(list, i, j)
end

fun std_table_insert(list: any, pos: any, value: any): void
    if list == nil then return end
    if value == nil then
        table.insert(list, pos)
    else
        table.insert(list, pos, value)
    end
end

fun std_table_remove(list: any, pos: any): any
    if list == nil then return nil end
    if pos == nil then pos = rawlen(list) end
    table.remove(list, pos)
end

fun std_table_count(list: any, fn: any): i64
    c = 0
    if list == nil then return c end
    if fn == nil then return rawlen(list) end
    i = 1
    while i <= rawlen(list)
        if fn(list[i]) then c += 1 end
        i += 1
    end
    c
end

fun std_table_flat(list: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        local item = list[i]
        if type(item) == "table" then
            j = 1
            while j <= rawlen(item)
                out[rawlen(out) + 1] = item[j]
                j += 1
            end
        else
            out[rawlen(out) + 1] = item
        end
        i += 1
    end
    out
end

fun std_table_unique(list: any): any
    out = {}
    if list == nil then return out end
    seen = {}
    i = 1
    while i <= rawlen(list)
        local v = list[i]
        local key = tostring(v)
        if not seen[key] then
            seen[key] = true
            out[rawlen(out) + 1] = v
        end
        i += 1
    end
    out
end

fun std_table_zip(lists: any): any
    out = {}
    if lists == nil or rawlen(lists) == 0 then return out end
    local min_len = rawlen(lists[1])
    i = 2
    while i <= rawlen(lists)
        if rawlen(lists[i]) < min_len then
            min_len = rawlen(lists[i])
        end
        i += 1
    end
    j = 1
    while j <= min_len
        local tuple = {}
        i = 1
        while i <= rawlen(lists)
            tuple[rawlen(tuple) + 1] = lists[i][j]
            i += 1
        end
        out[rawlen(out) + 1] = tuple
        j += 1
    end
    out
end

fun std_table_from_pairs(pairs: any): any
    out = {}
    if pairs == nil then return out end
    i = 1
    while i <= rawlen(pairs)
        local pair = pairs[i]
        if pair and rawlen(pair) >= 2 then
            out[pair[1]] = pair[2]
        end
        i += 1
    end
    out
end

fun std_table_to_pairs(t: any): any
    out = {}
    if t == nil then return out end
    for k, v in pairs(t)
        out[rawlen(out) + 1] = {k, v}
    end
    out
end

fun std_table_pick(t: any, keys: any): any
    out = {}
    if t == nil or keys == nil then return out end
    i = 1
    while i <= rawlen(keys)
        local k = keys[i]
        if t[k] ~= nil then
            out[k] = t[k]
        end
        i += 1
    end
    out
end

fun std_table_omit(t: any, keys: any): any
    out = {}
    if t == nil then return out end
    local omit_set = {}
    if keys ~= nil then
        i = 1
        while i <= rawlen(keys)
            omit_set[keys[i]] = true
            i += 1
        end
    end
    for k, v in pairs(t)
        if not omit_set[k] then
            out[k] = v
        end
    end
    out
end

fun std_table_find(list: any, fn: any): any
    if list == nil then return nil end
    i = 1
    while i <= rawlen(list)
        if fn(list[i]) then return list[i] end
        i += 1
    end
    nil
end

fun std_table_every(list: any, fn: any): bool
    if list == nil then return true end
    i = 1
    while i <= rawlen(list)
        if not fn(list[i]) then return false end
        i += 1
    end
    true
end

fun std_table_some(list: any, fn: any): bool
    if list == nil then return false end
    i = 1
    while i <= rawlen(list)
        if fn(list[i]) then return true end
        i += 1
    end
    false
end

M = {}
M.len = std_table_len
M.keys = std_table_keys
M.values = std_table_values
M.clone = std_table_clone
M.merge = std_table_merge
M.contains = std_table_contains
M.index_of = std_table_index_of
M.reverse = std_table_reverse
M.map = std_table_map
M.filter = std_table_filter
M.reduce = std_table_reduce
M.clear = std_table_clear
M.is_empty = std_table_is_empty
M.slice = std_table_slice
M.concat = std_table_concat
M.sort = std_table_sort
M.unpack = std_table_unpack
M.insert = std_table_insert
M.remove = std_table_remove
M.count = std_table_count
M.flat = std_table_flat
M.unique = std_table_unique
M.zip = std_table_zip
M.from_pairs = std_table_from_pairs
M.to_pairs = std_table_to_pairs
M.pick = std_table_pick
M.omit = std_table_omit
M.find = std_table_find
M.every = std_table_every
M.some = std_table_some
M
