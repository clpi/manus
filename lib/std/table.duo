-- std.table — table and array helper utilities

std_table_len(t: any): any
    if t == nil return 0 end
    rawlen(t)
end

std_table_keys(t: any): any
    out = {}
    if t == nil return out end
    for k, _ in t
        out[rawlen(out) + 1] = k
    end
    out
end

std_table_values(t: any): any
    out = {}
    if t == nil return out end
    for _, v in t
        out[rawlen(out) + 1] = v
    end
    out
end

std_table_clone(t: any): any
    out = {}
    if t == nil return out end
    for k, v in t
        out[k] = v
    end
    out
end

std_table_merge(a: any, b: any): any
    out = std_table_clone(a)
    if b != nil
        for k, v in b
            out[k] = v
        end
    end
    out
end

std_table_contains(list: any, value: any): bool
    if list == nil return false end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        if v == value return true end
        i += 1
    end
    false
end

std_table_index_of(list: any, value: any): any
    if list == nil return 0 end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        if v == value return i end
        i += 1
    end
    0
end

std_table_reverse(list: any): any
    out = {}
    if list == nil return out end
    i = rawlen(list)
    while i >= 1
        out[rawlen(out) + 1] = list[i]
        i -= 1
    end
    out
end

std_table_map(list: any, fn: any): any
    out = {}
    if list == nil return out end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        out[i] = fn(v, i)
        i += 1
    end
    out
end

std_table_filter(list: any, fn: any): any
    out = {}
    if list == nil return out end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        if fn(v, i)
            out[rawlen(out) + 1] = v
        end
        i += 1
    end
    out
end

std_table_reduce(list: any, fn: any, init: any): any
    acc = init
    if list == nil return acc end
    i = 1
    while i <= rawlen(list)
        v = list[i]
        acc = fn(acc, v, i)
        i += 1
    end
    acc
end

std_table_clear(t: any): void
    if t == nil return end
    ks = std_table_keys(t)
    i = 1
    while i <= #ks
        rawset(t, ks[i], nil)
        i += 1
    end
end

std_table_is_empty(t: any): bool
    if t == nil return true end
    for _, v in t
        if v != nil return false end
    end
    true
end

std_table_slice(t: any, start_idx: any, end_idx: any): any
    out = {}
    if t == nil return out end
    if start_idx == nil start_idx = 1 end
    if end_idx == nil end_idx = rawlen(t) end
    if start_idx < 1 start_idx = 1 end
    if end_idx > rawlen(t) end_idx = rawlen(t) end
    i = start_idx
    while i <= end_idx
        out[rawlen(out) + 1] = t[i]
        i += 1
    end
    out
end

std_table_concat(t: any, sep: any): str
    if t == nil return "" end
    if sep == nil sep = "" end
    table.concat(t, sep)
end

std_table_sort(list: any, cmp: any): void
    if list == nil return end
    if cmp == nil
        table.sort(list)
    else
        table.sort(list, cmp)
    end
end

std_table_unpack(list: any, i: any, j: any): any
    if list == nil return nil end
    if i == nil i = 1 end
    if j == nil j = rawlen(list) end
    table.unpack(list, i, j)
end

std_table_insert(list: any, pos: any, value: any): void
    if list == nil return end
    if value == nil
        table.insert(list, pos)
    else
        table.insert(list, pos, value)
    end
end

std_table_remove(list: any, pos: any): any
    if list == nil return nil end
    if pos == nil pos = rawlen(list) end
    table.remove(list, pos)
end

std_table_count(list: any, fn: any): i64
    c = 0
    if list == nil return c end
    if fn == nil return rawlen(list) end
    i = 1
    while i <= rawlen(list)
        if fn(list[i]) c += 1 end
        i += 1
    end
    c
end

std_table_flat(list: any): any
    out = {}
    if list == nil return out end
    i = 1
    while i <= rawlen(list)
        item = list[i]
        if type(item) == "table"
            j = 1
            while j <= rawlen(item)
                out[rawlen(out) + 1] = item[j]
                j += 1
            end
        else
            out[rawlen(out) + 1] = item
        end
        i += 1
    end
    out
end

std_table_unique(list: any): any
    out = {}
    if list == nil return out end
    seen = {}
    i = 1
    while i <= rawlen(list)
        v = list[i]
        key = tostring(v)
        if not seen[key]
            seen[key] = true
            out[rawlen(out) + 1] = v
        end
        i += 1
    end
    out
end

std_table_zip(lists: any): any
    out = {}
    if lists == nil or rawlen(lists) == 0 return out end
    min_len = rawlen(lists[1])
    i = 2
    while i <= rawlen(lists)
        if rawlen(lists[i]) < min_len
            min_len = rawlen(lists[i])
        end
        i += 1
    end
    j = 1
    while j <= min_len
        tuple = {}
        i = 1
        while i <= rawlen(lists)
            tuple[rawlen(tuple) + 1] = lists[i][j]
            i += 1
        end
        out[rawlen(out) + 1] = tuple
        j += 1
    end
    out
end

std_table_from_pairs(pairs: any): any
    out = {}
    if pairs == nil return out end
    i = 1
    while i <= rawlen(pairs)
        pair = pairs[i]
        if pair and rawlen(pair) >= 2
            out[pair[1]] = pair[2]
        end
        i += 1
    end
    out
end

std_table_to_pairs(t: any): any
    out = {}
    if t == nil return out end
    for k, v in t
        out[rawlen(out) + 1] = {k, v}
    end
    out
end

std_table_pick(t: any, keys: any): any
    out = {}
    if t == nil or keys == nil return out end
    i = 1
    while i <= rawlen(keys)
        k = keys[i]
        if t[k] != nil
            out[k] = t[k]
        end
        i += 1
    end
    out
end

std_table_omit(t: any, keys: any): any
    out = {}
    if t == nil return out end
    omit_set = {}
    if keys != nil
        i = 1
        while i <= rawlen(keys)
            omit_set[keys[i]] = true
            i += 1
        end
    end
    for k, v in t
        if not omit_set[k]
            out[k] = v
        end
    end
    out
end

std_table_find(list: any, fn: any): any
    if list == nil return nil end
    i = 1
    while i <= rawlen(list)
        if fn(list[i]) return list[i] end
        i += 1
    end
    nil
end

std_table_every(list: any, fn: any): bool
    if list == nil return true end
    i = 1
    while i <= rawlen(list)
        if not fn(list[i]) return false end
        i += 1
    end
    true
end

std_table_some(list: any, fn: any): bool
    if list == nil return false end
    i = 1
    while i <= rawlen(list)
        if fn(list[i]) return true end
        i += 1
    end
    false
end

M = {}
M.len = std_table_len
M.keys = std_table_keys
M.values = std_table_values
M.clone = std_table_clone
M.merge = std_table_merge
M.contains = std_table_contains
M.index_of = std_table_index_of
M.reverse = std_table_reverse
M.map = std_table_map
M.filter = std_table_filter
M.reduce = std_table_reduce
M.clear = std_table_clear
M.is_empty = std_table_is_empty
M.slice = std_table_slice
M.concat = std_table_concat
M.sort = std_table_sort
M.unpack = std_table_unpack
M.insert = std_table_insert
M.remove = std_table_remove
M.count = std_table_count
M.flat = std_table_flat
M.unique = std_table_unique
M.zip = std_table_zip
M.from_pairs = std_table_from_pairs
M.to_pairs = std_table_to_pairs
M.pick = std_table_pick
M.omit = std_table_omit
M.find = std_table_find
M.every = std_table_every
M.some = std_table_some
M
