-- std.unicode — Unicode character classification (mirrors Go's unicode package)
-- Provides basic rune/byte classification: IsDigit, IsLetter, IsSpace, etc.
-- Since Duo operates on byte strings, these functions take a byte value (0-255)
-- and classify based on ASCII/Latin-1 ranges. Full Unicode would require UTF-8
-- decoding (see std.utf8 for multi-byte support).

-- is_digit: report whether b is an ASCII digit ('0'-'9').
fun is_digit(b: any): bool
    b >= 48 and b <= 57
end

-- is_letter: report whether b is an ASCII letter (a-z, A-Z).
fun is_letter(b: any): bool
    (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
end

-- is_upper: report whether b is an ASCII uppercase letter.
fun is_upper(b: any): bool
    b >= 65 and b <= 90
end

-- is_lower: report whether b is an ASCII lowercase letter.
fun is_lower(b: any): bool
    b >= 97 and b <= 122
end

-- is_space: report whether b is a whitespace byte.
fun is_space(b: any): bool
    b == 32 or b == 9 or b == 10 or b == 13 or b == 11 or b == 12
end

-- is_print: report whether b is a printable ASCII character (0x20-0x7E).
fun is_print(b: any): bool
    b >= 32 and b <= 126
end

-- is_control: report whether b is a control character (0x00-0x1F or 0x7F).
fun is_control(b: any): bool
    b < 32 or b == 127
end

-- is_punct: report whether b is an ASCII punctuation character.
fun is_punct(b: any): bool
    (b >= 33 and b <= 47) or (b >= 58 and b <= 64) or (b >= 91 and b <= 96) or (b >= 123 and b <= 126)
end

-- is_hex_digit: report whether b is a hexadecimal digit (0-9, a-f, A-F).
fun is_hex_digit(b: any): bool
    (b >= 48 and b <= 57) or (b >= 65 and b <= 70) or (b >= 97 and b <= 102)
end

-- is_alnum: report whether b is a letter or digit.
fun is_alnum(b: any): bool
    is_letter(b) or is_digit(b)
end

-- to_upper: convert byte b to uppercase if it is a lowercase letter.
fun to_upper_rune(b: any): i64
    if b >= 97 and b <= 122 then return b - 32 end
    b
end

-- to_lower: convert byte b to lowercase if it is an uppercase letter.
fun to_lower_rune(b: any): i64
    if b >= 65 and b <= 90 then return b + 32 end
    b
end

-- to_title: convert byte b to title case (same as upper for ASCII).
fun to_title_rune(b: any): i64
    to_upper_rune(b)
end

-- ----- Range-based classification on strings -----

-- is_digit_str: report whether s consists entirely of ASCII digits.
fun is_digit_str(s: str): bool
    if s == nil or s == "" then return false end
    i = 1
    while i <= string.len(s)
        if not is_digit(string.byte(s, i)) then return false end
        i = i + 1
    end
    true
end

-- is_letter_str: report whether s consists entirely of ASCII letters.
fun is_letter_str(s: str): bool
    if s == nil or s == "" then return false end
    i = 1
    while i <= string.len(s)
        if not is_letter(string.byte(s, i)) then return false end
        i = i + 1
    end
    true
end

-- is_alnum_str: report whether s consists entirely of ASCII letters and digits.
fun is_alnum_str(s: str): bool
    if s == nil or s == "" then return false end
    i = 1
    while i <= string.len(s)
        if not is_alnum(string.byte(s, i)) then return false end
        i = i + 1
    end
    true
end

-- is_space_str: report whether s consists entirely of whitespace.
fun is_space_str(s: str): bool
    if s == nil or s == "" then return false end
    i = 1
    while i <= string.len(s)
        if not is_space(string.byte(s, i)) then return false end
        i = i + 1
    end
    true
end

-- is_hex_str: report whether s consists entirely of hex digits.
fun is_hex_str(s: str): bool
    if s == nil or s == "" then return false end
    i = 1
    while i <= string.len(s)
        if not is_hex_digit(string.byte(s, i)) then return false end
        i = i + 1
    end
    true
end

-- is_identifier: report whether s is a valid identifier (letter or _ followed by alnum or _).
fun is_identifier(s: str): bool
    if s == nil or s == "" then return false end
    b = string.byte(s, 1)
    if not is_letter(b) and b ~= 95 then return false end
    i = 2
    while i <= string.len(s)
        b = string.byte(s, i)
        if not is_alnum(b) and b ~= 95 then return false end
        i = i + 1
    end
    true
end

M = {}
M.is_digit = is_digit
M.is_letter = is_letter
M.is_upper = is_upper
M.is_lower = is_lower
M.is_space = is_space
M.is_print = is_print
M.is_control = is_control
M.is_punct = is_punct
M.is_hex_digit = is_hex_digit
M.is_alnum = is_alnum
M.to_upper = to_upper_rune
M.to_lower = to_lower_rune
M.to_title = to_title_rune
M.is_digit_str = is_digit_str
M.is_letter_str = is_letter_str
M.is_alnum_str = is_alnum_str
M.is_space_str = is_space_str
M.is_hex_str = is_hex_str
M.is_identifier = is_identifier
M