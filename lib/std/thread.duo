-- std.thread — OS-level threading primitives
-- Provides mutex, rwlock, condition variables, semaphore, barrier,
-- thread spawning/joining, and thread-local storage.
-- In single-threaded mode these use coroutine-based cooperative scheduling.
-- When @concurrent("threaded") is enabled, they map to pthread.

sync = require "std.sync"

-- ─────────────────────────────────────────────────────────────
-- Mutex: blocking mutual exclusion lock
-- ─────────────────────────────────────────────────────────────

-- Create a new mutex.  Initially unlocked.
mutex(): any
    {
        _locked     = false,
        _waiters    = {},  -- suspended coroutines waiting to acquire
        _holder     = nil, -- the coroutine that currently holds the lock
    }
end

-- Acquire the lock, blocking if already held.
lock(m: any): void
    if m._locked and m._holder == coroutine.running()
        return  -- recursive: already owned
    end
    while m._locked
        co = coroutine.running()
        m._waiters[#m._waiters + 1] = co
        coroutine.yield()
    end
    m._locked = true
    m._holder = coroutine.running()
end

-- Try to acquire the lock without blocking.  Returns true on success.
try_lock(m: any): bool
    if m._locked and m._holder == coroutine.running()
        return true
    end
    if m._locked return false end
    m._locked = true
    m._holder = coroutine.running()
    true
end

-- Release the lock, waking one waiter if any.
unlock(m: any): void
    if m._holder != coroutine.running()
        error("thread: unlock called by non-owner")
    end
    m._locked = false
    m._holder = nil
    if #m._waiters > 0
        co = table.remove(m._waiters, 1)
        sync.spawn(() coroutine.resume(co))
    end
end

-- ─────────────────────────────────────────────────────────────
-- RwLock: readers-writer lock
-- ─────────────────────────────────────────────────────────────

-- Create a readers-writer lock.
rwlock(): any
    {
        _readers    = 0,
        _writing    = false,
        _r_waiters  = {},  -- readers waiting
        _w_waiters  = {},  -- writers waiting
        _w_holder   = nil,
    }
end

-- Acquire for reading.  Multiple readers allowed; blocks if writing.
rlock(rw: any): void
    while rw._writing
        co = coroutine.running()
        rw._r_waiters[#rw._r_waiters + 1] = co
        coroutine.yield()
    end
    rw._readers = rw._readers + 1
end

-- Release a read lock.
runlock(rw: any): void
    rw._readers = rw._readers - 1
    if rw._readers == 0 and #rw._w_waiters > 0
        co = table.remove(rw._w_waiters, 1)
        sync.spawn(() coroutine.resume(co))
    end
end

-- Acquire for writing.  Blocks if anyone holds the lock.
wlock(rw: any): void
    if rw._w_holder == coroutine.running() return end
    while rw._writing or rw._readers > 0
        co = coroutine.running()
        rw._w_waiters[#rw._w_waiters + 1] = co
        coroutine.yield()
    end
    rw._writing = true
    rw._w_holder = coroutine.running()
end

-- Release a write lock.
wunlock(rw: any): void
    if rw._w_holder != coroutine.running()
        error("thread: wunlock called by non-owner")
    end
    rw._writing = false
    rw._w_holder = nil
    if #rw._w_waiters > 0
        co = table.remove(rw._w_waiters, 1)
        sync.spawn(() coroutine.resume(co))
    elseif #rw._r_waiters > 0
        for _, co in rw._r_waiters
            sync.spawn(() coroutine.resume(co))
        end
        rw._r_waiters = {}
    end
end

-- ─────────────────────────────────────────────────────────────
-- Condition variable
-- ─────────────────────────────────────────────────────────────

-- Create a condition variable associated with a mutex.
cond(m: any): any
    {
        _mutex  = m,
        _waiters = {},
    }
end

-- Wait on the condition (mutex must be held).  Atomically unlocks the
-- mutex and suspends; re-acquires the lock before returning.
wait(c: any): void
    m = c._mutex
    if m._holder != coroutine.running()
        error("thread: cond.wait without holding mutex")
    end
    co = coroutine.running()
    c._waiters[#c._waiters + 1] = co
    unlock(m)
    coroutine.yield()
    lock(m)
end

-- Wake one waiter on the condition.
signal(c: any): void
    if #c._waiters > 0
        co = table.remove(c._waiters, 1)
        sync.spawn(() coroutine.resume(co))
    end
end

-- Wake all waiters on the condition.
broadcast(c: any): void
    for _, co in c._waiters
        sync.spawn(() coroutine.resume(co))
    end
    c._waiters = {}
end

-- ─────────────────────────────────────────────────────────────
-- Once: run a function exactly once
-- ─────────────────────────────────────────────────────────────

-- Create a Once guard.
once(): any
    {
        _done = false,
        _mu   = mutex(),
    }
end

-- Call fn exactly once; subsequent calls are no-ops.
do_once(o: any, fn: any): void
    lock(o._mu)
    if not o._done
        o._done = true
        unlock(o._mu)
        fn()
    else
        unlock(o._mu)
    end
end

-- ─────────────────────────────────────────────────────────────
-- Semaphore
-- ─────────────────────────────────────────────────────────────

-- Create a counting semaphore with n permits.
semaphore(n: i64): any
    {
        _permits = n,
        _waiters = {},
        _mu      = mutex(),
    }
end

-- Acquire a permit, blocking if none available.
acquire(s: any): void
    lock(s._mu)
    while s._permits <= 0
        co = coroutine.running()
        s._waiters[#s._waiters + 1] = co
        unlock(s._mu)
        coroutine.yield()
        lock(s._mu)
    end
    s._permits = s._permits - 1
    unlock(s._mu)
end

-- Try to acquire a permit without blocking.
try_acquire(s: any): bool
    lock(s._mu)
    if s._permits > 0
        s._permits = s._permits - 1
        unlock(s._mu)
        return true
    end
    unlock(s._mu)
    false
end

-- Release a permit.
release(s: any): void
    lock(s._mu)
    s._permits = s._permits + 1
    if #s._waiters > 0
        co = table.remove(s._waiters, 1)
        sync.spawn(() coroutine.resume(co))
    end
    unlock(s._mu)
end

-- ─────────────────────────────────────────────────────────────
-- Barrier: synchronize N threads at a point
-- ─────────────────────────────────────────────────────────────

-- Create a barrier for n participants.
barrier(n: i64): any
    {
        _count   = n,
        _total   = n,
        _gen     = 0,
        _mu      = mutex(),
        _cv      = nil,  -- will be set below
    }
end

-- Wait at the barrier until all participants arrive.
barrier_wait(b: any): void
    if b._cv == nil
        b._cv = cond(b._mu)
    end
    lock(b._mu)
    gen = b._gen
    b._count = b._count - 1
    if b._count == 0
        -- Last one through: reset and wake everyone
        b._count = b._total
        b._gen = b._gen + 1
        broadcast(b._cv)
        unlock(b._mu)
        return
    end
    -- Wait until generation changes
    while b._gen == gen
        wait(b._cv)
    end
    unlock(b._mu)
end

-- ─────────────────────────────────────────────────────────────
-- Thread spawning and joining
-- ─────────────────────────────────────────────────────────────

-- Spawn a function in a new thread.  Returns a thread handle.
-- In cooperative mode this creates a coroutine and yields to the scheduler.
-- In threaded mode this creates a real OS thread.
spawn(fn: any, ...args): any
    args_list = {args}
    result_ch = sync.channel(1)
    co = coroutine.create(()
        ok, result = pcall(fn, table.unpack(args_list))
        if ok
            sync.channel_send(result_ch, {ok = true, val = result})
        else
            sync.channel_send(result_ch, {ok = false, err = result})
        end
    end)
    sync.spawn(() coroutine.resume(co))
    {
        _co    = co,
        _result = result_ch,
    }
end

-- Wait for a thread to complete, returning its result.  Raises on error.
join(h: any): any
    r = sync.channel_recv(h._result)
    if r == nil return nil end
    if r.ok return r.val end
    error(r.err, 2)
end

-- Detach a thread, allowing it to run independently.  Resources are
-- released automatically when the thread finishes.
detach(h: any): void
    h._detached = true
end

-- ─────────────────────────────────────────────────────────────
-- Thread identity and introspection
-- ─────────────────────────────────────────────────────────────

-- Return a unique identifier for the current thread/coroutine.
id(): i64
    co = coroutine.running()
    if co == nil return 0 end
    -- Hash the coroutine pointer for a stable id
    s = to(str)(co)
    h = 5381
    for i = 1, #s
        h = (h * 33 + string.byte(s, i)) % 4294967296
    end
    h
end

-- Return the number of hardware threads available (for parallelism).
-- In single-threaded mode, returns 1.
cpu_count(): i64
    1
end

-- Sleep the current thread for the given number of milliseconds.
-- In cooperative mode this yields without rescheduling.
sleep(ms: i64): void
    -- In cooperative mode, yield to let other tasks run
    sync.yield()
end

-- Yield execution to the scheduler, allowing other threads to run.
yield(): void
    sync.yield()
end

-- ─────────────────────────────────────────────────────────────
-- Thread-safe wrapper around std.concurrent channels
-- ─────────────────────────────────────────────────────────────

-- Create a thread-safe channel.
channel(capacity: i64): any
    sync.channel(capacity)
end

channel_send(ch: any, val: any): void
    sync.channel_send(ch, val)
end

channel_recv(ch: any): any
    sync.channel_recv(ch)
end

channel_try_recv(ch: any): any
    sync.channel_try_recv(ch)
end

channel_close(ch: any): void
    sync.channel_close(ch)
end

-- ─────────────────────────────────────────────────────────────
-- Parallel execution helpers
-- ─────────────────────────────────────────────────────────────

-- Run the function for each element in parallel (cooperative by default).
-- Returns a table of results in order.
for_each(items: any, fn: any): any
    handles = {}
    for _, item in items
        handles[#handles + 1] = spawn(fn, item)
    end
    results = {}
    for _, h in handles
        results[#results + 1] = join(h)
    end
    results
end

-- Run the function n times in parallel (cooperative by default).
for_range(n: i64, fn: any): any
    handles = {}
    for i = 0, n - 1
        handles[#handles + 1] = spawn(fn, i)
    end
    results = {}
    for _, h in handles
        results[#results + 1] = join(h)
    end
    results
end

-- ─────────────────────────────────────────────────────────────
-- Thread-local storage
-- ─────────────────────────────────────────────────────────────

-- Internal registry keyed by thread/coroutine id
_tls_registry = {}
_tls_stores = {}
_tls_next_key = 0

-- Create a new thread-local key with an optional default value factory.
tls_key(default_fn: any): i64
    _tls_next_key += 1
    _tls_registry[_tls_next_key] = default_fn
    _tls_next_key
end

-- Set the value for a thread-local key in the current thread.
tls_set(key: i64, value: any): void
    tid = to(str)(id())
    if _tls_stores == nil
        _tls_stores = {}
    end
    if _tls_stores[tid] == nil
        _tls_stores[tid] = {}
    end
    store = _tls_stores[tid]
    store[key] = value
end

-- Get the value for a thread-local key in the current thread.
-- If not set and a default_fn was provided, initialises it.
tls_get(key: i64): any
    tid = to(str)(id())
    store = _tls_stores and _tls_stores[tid] or nil
    if store != nil
        val = store[key]
        if val != nil return val end
    end
    default_fn = _tls_registry[key]
    if default_fn != nil
        val = default_fn()
        tls_set(key, val)
        return val
    end
    nil
end

-- Remove the value for a thread-local key.  Returns the old value.
tls_del(key: i64): any
    tid = to(str)(id())
    if _tls_stores == nil return nil end
    store = _tls_stores[tid]
    if store == nil return nil end
    val = store[key]
    store[key] = nil
    val
end

