-- std.flag — command-line flag parsing (mirrors Go's flag package)
-- Provides a simple flag parser supporting --name=value, --name value, and
-- boolean flags. Sub-arguments after -- are treated as positional args.

-- new_flag_set: create a new flag set with the given name.
new_flag_set(name: str): any
    {name = name, flags = {}, args = {}, parsed = false}
end

-- bool_flag: register a boolean flag.
bool_flag(fs: any, name: str, default_val: bool, usage: str): any
    f = {name = name, value = default_val, default = default_val, usage = usage, is_bool = true}
    fs.flags[name] = f
    f
end

-- string_flag: register a string flag.
string_flag(fs: any, name: str, default_val: str, usage: str): any
    f = {name = name, value = default_val, default = default_val, usage = usage, is_bool = false, kind = "string"}
    fs.flags[name] = f
    f
end

-- int_flag: register an integer flag.
int_flag(fs: any, name: str, default_val: i64, usage: str): any
    f = {name = name, value = default_val, default = default_val, usage = usage, is_bool = false, kind = "int"}
    fs.flags[name] = f
    f
end

-- float_flag: register a float flag.
float_flag(fs: any, name: str, default_val: f64, usage: str): any
    f = {name = name, value = default_val, default = default_val, usage = usage, is_bool = false, kind = "float"}
    fs.flags[name] = f
    f
end

-- parse: parse the given argument array (1-based).
parse(fs: any, argv: any): any
    if argv == nil argv = {} end
    i = 1
    n = rawlen(argv)
    fname: any = nil
    fval: any = nil
    while i <= n
        arg = argv[i]
        if arg == "--"
            -- all remaining are positional
            i += 1
            while i <= n
                fs.args[rawlen(fs.args) + 1] = argv[i]
                i += 1
            end
            break
        end
        -- long flag: --name or --name=value
        if string.sub(arg, 1, 2) == "--"
            rest = string.sub(arg, 3)
            eq = string.find(rest, "=", 1, true)
            if eq != nil
                fname = string.sub(rest, 1, eq - 1)
                fval = string.sub(rest, eq + 1)
            else
                fname = rest
                fval = nil
            end
            f = fs.flags[fname]
            if f == nil
                io.write("flag: unknown flag --" .. fname .. "\n")
                return fs, false
            end
            if f.is_bool
                if fval != nil
                    f.value = (fval == "true" or fval == "1")
                else
                    f.value = true
                end
            else
                if fval == nil
                    i += 1
                    if i > n
                        io.write("flag: --" .. fname .. " requires a value\n")
                        return fs, false
                    end
                    fval = argv[i]
                end
                if f.kind == "int"
                    f.value = tonumber(fval)
                elseif f.kind == "float"
                    f.value = tonumber(fval)
                else
                    f.value = fval
                end
            end
        elseif string.sub(arg, 1, 1) == "-" and #arg > 1
            -- short flag: -name or -name=value
            rest = string.sub(arg, 2)
            eq = string.find(rest, "=", 1, true)
            if eq != nil
                fname = string.sub(rest, 1, eq - 1)
                fval = string.sub(rest, eq + 1)
            else
                fname = rest
                fval = nil
            end
            f = fs.flags[fname]
            if f == nil
                io.write("flag: unknown flag -" .. fname .. "\n")
                return fs, false
            end
            if f.is_bool
                if fval != nil
                    f.value = (fval == "true" or fval == "1")
                else
                    f.value = true
                end
            else
                if fval == nil
                    i += 1
                    if i > n
                        io.write("flag: -" .. fname .. " requires a value\n")
                        return fs, false
                    end
                    fval = argv[i]
                end
                if f.kind == "int"
                    f.value = tonumber(fval)
                elseif f.kind == "float"
                    f.value = tonumber(fval)
                else
                    f.value = fval
                end
            end
        else
            -- positional argument
            fs.args[rawlen(fs.args) + 1] = arg
        end
        i += 1
    end
    fs.parsed = true
    return fs, true
end

-- get: return the value of a flag.
get(fs: any, name: str): any
    f = fs.flags[name]
    if f == nil return nil end
    f.value
end

-- lookup: return the flag descriptor.
lookup(fs: any, name: str): any
    fs.flags[name]
end

-- args_: return the positional arguments (named args_ to avoid shadowing).
args(fs: any): any
    fs.args
end

-- print_defaults: print usage information for all flags.
print_defaults(fs: any): void
    for name, f in fs.flags
        prefix = "  -" .. name
        if not f.is_bool
            prefix = prefix .. " value"
        end
        io.write(prefix .. "\n        " .. to(str)(f.usage) .. " (default: " .. to(str)(f.default) .. ")\n")
    end
end

-- ----- Global default flag set -----

global default_fs = new_flag_set("")

-- global bool: register a bool on the default flag set.
bool_global(name: str, default_val: bool, usage: str): any
    bool_flag(default_fs, name, default_val, usage)
end

string(name: str, default_val: str, usage: str): any
    string_flag(default_fs, name, default_val, usage)
end

int(name: str, default_val: i64, usage: str): any
    int_flag(default_fs, name, default_val, usage)
end

parse_argv(argv: any): any
    parse(default_fs, argv)
end

get_flag(name: str): any
    get(default_fs, name)
end

