# std.meta.hierarchy — @meta.* compiler module reference for agents and humans
# Canonical dotted paths; do not add public flat names such as @foo_bar.
# Legacy flat spellings are parser compatibility only, not the documented surface.

# Exponential scaling ladder (one declaration → multiplicative output):
#   @meta.map              O(types)
#   @meta.derive           O(types × fields)
#   @meta.product          O(types²)
#   @meta.derive.product   O(types² × fields)
#   @meta.tensor           O(types³)
#   @meta.derive.tensor    O(types³ × fields)
#   @meta.nfold             O(types^k) — generalizes product/tensor
#   @meta.derive.nfold      O(types^k × fields)
#   @meta.ceiling          derive sweep + cartesian derive product
#   @meta.omni             ceiling + optional sweep comment
#   @meta.burst            module: derive.all + O(types² × fields) emit
#   @meta.transcend        module: burst + O(types³ × fields) emit
#   @meta.infinity         module: transcend + O(types⁴ × fields) emit
#   @meta.hyper             module: transcend + O(types⁵ × fields) emit
#   @meta.tower             O(n^k×f) with dynamic k (k≤16)
#   @meta.power / @meta.powerset   O(2^n) subset enumeration
#   @meta.choose            O(n choose k) fixed-size subset enumeration
#   @meta.permute           O(n!) ordering enumeration
#   @comp.agent.*           agent discoverability hooks (catalog, ladder, hooks, dedupe)

scaling_ladder(): str
    @comp.ladder()
end

agent_catalog(): str
    @comp.agent.catalog()
end

agent_hooks(): str
    @comp.agent.hooks()
end

agent_dedupe(): str
    @comp.agent.dedupe()
end

agent_gaps(): str
    @comp.agent.gaps()
end

catalog_categories(): str
    "combinators, define, emit, introspection, transform, compile, all"
end

M = {
    scaling_ladder = scaling_ladder,
    catalog_categories = catalog_categories,
    agent_catalog = agent_catalog,
    agent_hooks = agent_hooks,
    agent_dedupe = agent_dedupe,
    agent_gaps = agent_gaps,
}
