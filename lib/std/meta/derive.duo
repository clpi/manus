-- std.meta.derive — derivable concept descriptors for the Duo standard library
-- These descriptors are ordinary Lua-shaped meta tables, not `concept`
-- declarations. They are suitable for runtime reflection and
-- meta.satisfies_concept checks today, while compile-time @implements support
-- still uses parser-level concept declarations.

meta = req "std.meta"

Clone = meta.make_concept("Clone", {
    methods = { "clone" },
})

Eq = meta.make_concept("Eq", {
    methods = { "eq" },
})

Ord = meta.make_concept("Ord", {
    methods = { "compare" },
})

Hash = meta.make_concept("Hash", {
    methods = { "hash" },
})

Display = meta.make_concept("Display", {
    methods = { "to_string" },
})

Default = meta.make_concept("Default", {
    methods = { "default" },
})

Iterable = meta.make_concept("Iterable", {
    methods = { "iter", "next" },
})

Index = meta.make_concept("Index", {
    methods = { "at", "len" },
})

Into = meta.make_concept("Into", {
    methods = { "into" },
})

From = meta.make_concept("From", {
    methods = { "from" },
})

Add = meta.make_concept("Add", {
    methods = { "add" },
})

Sub = meta.make_concept("Sub", {
    methods = { "sub" },
})

Mul = meta.make_concept("Mul", {
    methods = { "mul" },
})

Div = meta.make_concept("Div", {
    methods = { "div" },
})

Rem = meta.make_concept("Rem", {
    methods = { "rem" },
})

Pow = meta.make_concept("Pow", {
    methods = { "pow" },
})

Neg = meta.make_concept("Neg", {
    methods = { "neg" },
})

BitAnd = meta.make_concept("BitAnd", {
    methods = { "bit_and" },
})

BitOr = meta.make_concept("BitOr", {
    methods = { "bit_or" },
})

BitXor = meta.make_concept("BitXor", {
    methods = { "bit_xor" },
})

BitNot = meta.make_concept("BitNot", {
    methods = { "bit_not" },
})

Shl = meta.make_concept("Shl", {
    methods = { "shl" },
})

Shr = meta.make_concept("Shr", {
    methods = { "shr" },
})

Concat = meta.make_concept("Concat", {
    methods = { "concat" },
})

Len = meta.make_concept("Len", {
    methods = { "len" },
})

Call = meta.make_concept("Call", {
    methods = { "call" },
})

Contains = meta.make_concept("Contains", {
    methods = { "contains" },
})

Try = meta.make_concept("Try", {
    methods = { "attempt" },
})

Unwrap = meta.make_concept("Unwrap", {
    methods = { "unwrap" },
})

Tag = meta.make_concept("Tag", {
    methods = { "tag" },
})

Close = meta.make_concept("Close", {
    methods = { "close" },
})

Iter = meta.make_concept("Iter", {
    methods = { "iter" },
})

Format = meta.make_concept("Format", {
    methods = { "fmt" },
})

Serialize = meta.make_concept("Serialize", {
    methods = { "serialize" },
})

Deserialize = meta.make_concept("Deserialize", {
    methods = { "deserialize" },
})

DeepClone = meta.make_concept("DeepClone", {
    methods = { "deep_clone" },
})

-- Derive module table
M = {}
M.Clone = Clone
M.Eq = Eq
M.Ord = Ord
M.Hash = Hash
M.Display = Display
M.Default = Default
M.Iterable = Iterable
M.Index = Index
M.Into = Into
M.From = From
M.Add = Add
M.Sub = Sub
M.Mul = Mul
M.Div = Div
M.Rem = Rem
M.Pow = Pow
M.Neg = Neg
M.BitAnd = BitAnd
M.BitOr = BitOr
M.BitXor = BitXor
M.BitNot = BitNot
M.Shl = Shl
M.Shr = Shr
M.Concat = Concat
M.Len = Len
M.Call = Call
M.Contains = Contains
M.Try = Try
M.Unwrap = Unwrap
M.Tag = Tag
M.Close = Close
M.Iter = Iter
M.Format = Format
M.Serialize = Serialize
M.Deserialize = Deserialize
M.DeepClone = DeepClone
M
