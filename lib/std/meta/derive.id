# std.meta.derive — derivable concept descriptors for the Duo standard library
# These descriptors are ordinary Lua-shaped meta tables, not `concept`
# declarations. They are suitable for runtime reflection and
# std.meta.satisfies_concept checks today, while compile-time @implements support
# still uses parser-level concept declarations.

Clone = std.meta.make_concept("Clone", {
    methods = { "clone" },
})

Eq = std.meta.make_concept("Eq", {
    methods = { "eq" },
})

Ord = std.meta.make_concept("Ord", {
    methods = { "compare" },
})

Hash = std.meta.make_concept("Hash", {
    methods = { "hash" },
})

Display = std.meta.make_concept("Display", {
    methods = { "to_string" },
})

Default = std.meta.make_concept("Default", {
    methods = { "default" },
})

Iterable = std.meta.make_concept("Iterable", {
    methods = { "iter", "next" },
})

Index = std.meta.make_concept("Index", {
    methods = { "at", "len" },
})

Into = std.meta.make_concept("Into", {
    methods = { "into" },
})

From = std.meta.make_concept("From", {
    methods = { "from" },
})

Add = std.meta.make_concept("Add", {
    methods = { "add" },
})

Sub = std.meta.make_concept("Sub", {
    methods = { "sub" },
})

Mul = std.meta.make_concept("Mul", {
    methods = { "mul" },
})

Div = std.meta.make_concept("Div", {
    methods = { "div" },
})

Rem = std.meta.make_concept("Rem", {
    methods = { "rem" },
})

Pow = std.meta.make_concept("Pow", {
    methods = { "pow" },
})

Neg = std.meta.make_concept("Neg", {
    methods = { "neg" },
})

BitAnd = std.meta.make_concept("BitAnd", {
    methods = { "bit_and" },
})

BitOr = std.meta.make_concept("BitOr", {
    methods = { "bit_or" },
})

BitXor = std.meta.make_concept("BitXor", {
    methods = { "bit_xor" },
})

BitNot = std.meta.make_concept("BitNot", {
    methods = { "bit_not" },
})

Shl = std.meta.make_concept("Shl", {
    methods = { "shl" },
})

Shr = std.meta.make_concept("Shr", {
    methods = { "shr" },
})

Concat = std.meta.make_concept("Concat", {
    methods = { "concat" },
})

Len = std.meta.make_concept("Len", {
    methods = { "len" },
})

Call = std.meta.make_concept("Call", {
    methods = { "call" },
})

Contains = std.meta.make_concept("Contains", {
    methods = { "contains" },
})

Try = std.meta.make_concept("Try", {
    methods = { "attempt" },
})

Unwrap = std.meta.make_concept("Unwrap", {
    methods = { "unwrap" },
})

Tag = std.meta.make_concept("Tag", {
    methods = { "tag" },
})

Close = std.meta.make_concept("Close", {
    methods = { "close" },
})

Iter = std.meta.make_concept("Iter", {
    methods = { "iter" },
})

Format = std.meta.make_concept("Format", {
    methods = { "fmt" },
})

Serialize = std.meta.make_concept("Serialize", {
    methods = { "serialize" },
})

Deserialize = std.meta.make_concept("Deserialize", {
    methods = { "deserialize" },
})

DeepClone = std.meta.make_concept("DeepClone", {
    methods = { "deep_clone" },
})

