-- std.meta.macros — meta block utilities and compile-time code generation
-- Meta blocks (## { ... }) are evaluated at compile time.
-- This module provides helpers for common meta programming patterns.

-- Evaluate a compile-time expression constant
fun eval_constant(expr: i64): i64
    expr
end

-- Generate a compile-time string from a template
fun template_str(fmt: str): str
    fmt
end

-- Define a meta block that generates code at compile time
-- Usage: ##meta.for_range(0, 10, fun(i) ... end)
fun for_range(start: i64, stop: i64, body_fn: any): void
    for i = start, stop - 1
        body_fn(i)
    end
end

-- Generate a sequence of numbered variable bindings at compile time
-- Usage: ##meta.gen_vars("x", 5)  ->  x0, x1, x2, x3, x4
fun gen_vars(prefix: str, count: i64): any
    vars = {}
    for i = 0, count - 1
        vars[#vars + 1] = prefix .. tostring(i)
    end
    vars
end

-- Compile-time conditional code generation
-- Usage: ##meta.when(condition, then_block)
fun when(cond: bool, block: any): void
    if cond then
        block()
    end
end

-- Compile-time loop unrolling helper
-- Usage: ##meta.unroll(4, fun(i) print(#i) end)
fun unroll(count: i64, body_fn: any): void
    for i = 0, count - 1
        body_fn(i)
    end
end

-- Compile-time type size query
fun sizeof(T: str): i64
    sizes = {}
    sizes["i8"] = 1
    sizes["i16"] = 2
    sizes["i32"] = 4
    sizes["i64"] = 8
    sizes["u8"] = 1
    sizes["u16"] = 2
    sizes["u32"] = 4
    sizes["u64"] = 8
    sizes["f32"] = 4
    sizes["f64"] = 8
    sizes["bool"] = 1
    sizes["str"] = 8
    sizes["ptr"] = 8
    sizes[T] or 0
end

-- Compile-time alignment query
fun alignof(T: str): i64
    aligns = {}
    aligns["i8"] = 1
    aligns["i16"] = 2
    aligns["i32"] = 4
    aligns["i64"] = 8
    aligns["u8"] = 1
    aligns["u16"] = 2
    aligns["u32"] = 4
    aligns["u64"] = 8
    aligns["f32"] = 4
    aligns["f64"] = 8
    aligns["bool"] = 1
    aligns["str"] = 8
    aligns["ptr"] = 8
    aligns[T] or 1
end

-- Compile-time assertion
fun static_assert(cond: bool, msg: str): void
    if not cond then
        error("compile-time assertion failed: " .. msg)
    end
end

-- Generate a struct field accessor at compile time
fun gen_field_accessor(struct_name: str, field_name: str, field_type: str): any
    { name = struct_name, field = field_name, typ = field_type }
end

-- Meta module table
M = {}
M.eval_constant = eval_constant
M.template_str = template_str
M.for_range = for_range
M.gen_vars = gen_vars
M.when = when
M.unroll = unroll
M.sizeof = sizeof
M.alignof = alignof
M.static_assert = static_assert
M.gen_field_accessor = gen_field_accessor
M
