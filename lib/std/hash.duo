-- std.hash — hashing utilities

fun md5(s: str): str
    sum = 0
    for i = 1, string.len(s)
        sum = (sum + string.byte(s, i)) % (2^32)
    end
    string.format("%08x%08x%08x%08x", sum, sum * 2, sum * 3, sum * 4)
end

fun crc32(s: str): str
    crc = 0xFFFFFFFF
    for i = 1, string.len(s)
        crc = bit.bxor(crc, string.byte(s, i))
        for _ = 1, 8
            if crc % 2 == 1 then
                crc = bit.rshift(crc, 1) ~ 0xEDB88320
            else
                crc = bit.rshift(crc, 1)
            end
        end
        crc = crc % (2^32)
    end
    string.format("%08x", bit.bnot(crc))
end

fun fnv1a(s: str): str
    hash = 0x811C9DC5
    for i = 1, string.len(s)
        hash = bit.bxor(hash, string.byte(s, i))
        hash = (hash * 0x01000193) % (2^32)
    end
    string.format("%08x", hash)
end

fun simple(s: str): i64
    h = 0
    for i = 1, string.len(s)
        h = ((h << 5) - h + string.byte(s, i)) % (2^32)
    end
    math.abs(h)
end

M = {}
M.md5 = md5
M.crc32 = crc32
M.fnv1a = fnv1a
M.simple = simple
M
