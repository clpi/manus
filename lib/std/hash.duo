function std_hash_md5(s)
    local sum = 0
    for i = 1, string.len(s) do
        sum = (sum + string.byte(s, i)) % (2^32)
    end
    return string.format("%08x%08x%08x%08x", sum, sum * 2, sum * 3, sum * 4)
end

function std_hash_crc32(s)
    local crc = 0xFFFFFFFF
    for i = 1, string.len(s) do
        crc = bit.bxor(crc, string.byte(s, i))
        for _ = 1, 8 do
            if crc % 2 == 1 then
                crc = bit.rshift(crc, 1) ~ 0xEDB88320
            else
                crc = bit.rshift(crc, 1)
            end
        end
        crc = crc % (2^32)
    end
    return string.format("%08x", bit.bnot(crc))
end

function std_hash_fnv1a(s)
    local hash = 0x811C9DC5
    for i = 1, string.len(s) do
        hash = bit.bxor(hash, string.byte(s, i))
        hash = (hash * 0x01000193) % (2^32)
    end
    return string.format("%08x", hash)
end

function std_hash_simple(s)
    local h = 0
    for i = 1, string.len(s) do
        h = ((h << 5) - h + string.byte(s, i)) % (2^32)
    end
    return math.abs(h)
end

local M = {}
M.md5 = std_hash_md5
M.crc32 = std_hash_crc32
M.fnv1a = std_hash_fnv1a
M.simple = std_hash_simple
return M