vec2 = {
    new = vec2_new,
    add = vec2_add,
    sub = vec2_sub,
    scale = vec2_scale,
    dot = vec2_dot,
    cross = vec2_cross,
    length = vec2_length,
    length_squared = vec2_length_squared,
    normalize = vec2_normalize,
    distance = vec2_distance,
    distance_squared = vec2_distance_squared,
    lerp = vec2_lerp,
    rotate = vec2_rotate,
    perpendicular = vec2_perpendicular,
    angle = vec2_angle,
}

# 2D Shapes
# 3D Vec
vec3 = {
    new = vec3_new,
    add = vec3_add,
    sub = vec3_sub,
    scale = vec3_scale,
    dot = vec3_dot,
    cross = vec3_cross,
    length = vec3_length,
    normalize = vec3_normalize,
    distance = vec3_distance,
    lerp = vec3_lerp,
}

