gradient_descent(f: any, df: any, x0: f64, lr: f64, iterations: i64): any
  x = x0
  history = {
    x
  }
  i = 0
  while i < iterations
    grad = df(x)
    x = x - lr * grad
    history[history:len() + 1] = x
    i = i + 1
  end
  {
    x = x,
    f_x = f(x),
    history = history,
    iterations = iterations
  }
end
adam(f: any, df: any, x0: f64, lr: f64, beta1: f64, beta2: f64, epsilon: f64, iterations: i64): any
  if beta1 == nil
    beta1 = 0.9
  end
  if beta2 == nil
    beta2 = 0.999
  end
  if epsilon == nil
    epsilon = 0.00000001
  end
  x = x0
  m = 0
  v = 0
  history = {
    x
  }
  i = 1
  while i <= iterations
    grad = df(x)
    m = beta1 * m + (1 - beta1) * grad
    v = beta2 * v + (1 - beta2) * grad * grad
    m_hat = m / (1 - beta1 ^ i)
    v_hat = v / (1 - beta2 ^ i)
    x = x - lr * m_hat / (v_hat:sqrt() + epsilon)
    history[history:len() + 1] = x
    i = i + 1
  end
  {
    x = x,
    f_x = f(x),
    history = history,
    iterations = iterations
  }
end
nelder_mead(f: any, x0: any, alpha: f64, gamma: f64, rho: f64, sigma: f64, iterations: i64): any
  if alpha == nil
    alpha = 1.0
  end
  if gamma == nil
    gamma = 2.0
  end
  if rho == nil
    rho = 0.5
  end
  if sigma == nil
    sigma = 0.5
  end
  n = x0:len()
  simplex = {}
  simplex[1] = {
    point = x0,
    value = f(x0)
  }
  i = 1
  while i <= n
    point = {}
    j = 1
    while j <= n
      if j == i
        point[j] = x0[j] + 0.05
      else
        point[j] = x0[j]
      end
      j = j + 1
    end
    simplex[simplex:len() + 1] = {
      point = point,
      value = f(point)
    }
    i = i + 1
  end
  iter = 0
  while iter < iterations
    table.sort(simplex, (a: any, b: any): any
      a.value < b.value
    end)
    best = simplex[1]
    worst = simplex[n + 1]
    centroid = {}
    i = 1
    while i <= n
      centroid[i] = 0
      j = 1
      while j <= n
        centroid[i] = centroid[i] + simplex[j].point[i]
        j = j + 1
      end
      centroid[i] = centroid[i] / n
      i = i + 1
    end
    reflected = {}
    i = 1
    while i <= n
      reflected[i] = centroid[i] + alpha * (centroid[i] - worst.point[i])
      i = i + 1
    end
    reflected_value = f(reflected)
    if reflected_value < simplex[n].value and reflected_value >= best.value
      simplex[n + 1] = {
        point = reflected,
        value = reflected_value
      }
    elseif reflected_value < best.value
      expanded = {}
      i = 1
      while i <= n
        expanded[i] = centroid[i] + gamma * (reflected[i] - centroid[i])
        i = i + 1
      end
      expanded_value = f(expanded)
      if expanded_value < reflected_value
        simplex[n + 1] = {
          point = expanded,
          value = expanded_value
        }
      else
        simplex[n + 1] = {
          point = reflected,
          value = reflected_value
        }
      end
    else
      contracted = {}
      i = 1
      while i <= n
        contracted[i] = centroid[i] + rho * (worst.point[i] - centroid[i])
        i = i + 1
      end
      contracted_value = f(contracted)
      if contracted_value < worst.value
        simplex[n + 1] = {
          point = contracted,
          value = contracted_value
        }
      else
        i = 2
        while i <= n + 1
          j = 1
          while j <= n
            simplex[i].point[j] = best.point[j] + sigma * (simplex[i].point[j] - best.point[j])
            j = j + 1
          end
          simplex[i].value = f(simplex[i].point)
          i = i + 1
        end
      end
    end
    iter = iter + 1
  end
  table.sort(simplex, (a: any, b: any): any
    a.value < b.value
  end)
  {
    x = simplex[1].point,
    f_x = simplex[1].value,
    iterations = iterations
  }
end
grid_search(f: any, ranges: any, steps: i64): any
  grid = {}
  for param_name, range in ranges
    min_val = range[1]
    max_val = range[2]
    step_size = (max_val - min_val) / (steps - 1)
    points = {}
    i = 0
    while i < steps
      points[points:len() + 1] = min_val + i * step_size
      i = i + 1
    end
    grid[param_name] = points
  end
  best = nil
  best_value = 1000000000000000000000000000000.0
  results = {}
  param_names = {}
  for name in ranges
    param_names[param_names:len() + 1] = name
  end
  if param_names:len() == 1
    for v in grid[param_names[1]]
      params = {
        [param_names[1]] = v
      }
      value = f(params)
      results[results:len() + 1] = {
        params = params,
        value = value
      }
      if value < best_value
        best_value = value
        best = params
      end
    end
  elseif param_names:len() == 2
    for v1 in grid[param_names[1]]
      for v2 in grid[param_names[2]]
        params = {
          [param_names[1]] = v1,
          [param_names[2]] = v2
        }
        value = f(params)
        results[results:len() + 1] = {
          params = params,
          value = value
        }
        if value < best_value
          best_value = value
          best = params
        end
      end
    end
  end
  {
    best = best,
    best_value = best_value,
    results = results
  }
end
random_search(f: any, ranges: any, iterations: i64): any
  best = nil
  best_value = 1000000000000000000000000000000.0
  results = {}
  i = 0
  while i < iterations
    params = {}
    for param_name, range in ranges
      min_val = range[1]
      max_val = range[2]
      params[param_name] = min_val + math.random() * (max_val - min_val)
    end
    value = f(params)
    results[results:len() + 1] = {
      params = params,
      value = value
    }
    if value < best_value
      best_value = value
      best = params
    end
    i = i + 1
  end
  {
    best = best,
    best_value = best_value,
    results = results
  }
end
line_search(f: any, x: f64, direction: f64, alpha: f64, beta: f64, max_iter: i64): f64
  if alpha == nil
    alpha = 0.5
  end
  if beta == nil
    beta = 0.8
  end
  if max_iter == nil
    max_iter = 20
  end
  t = 1.0
  f_x = f(x)
  i = 0
  while i < max_iter
    if f(x + t * direction) <= f_x + alpha * t * direction
      return t
    end
    t = beta * t
    i = i + 1
  end
  t
end
