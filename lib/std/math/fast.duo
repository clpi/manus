-- std.math.fast — branchless and intrinsic-backed math primitives
--
-- Typed i64/float helpers that lower to branchless C or single-instruction
-- intrinsics (@popcount, @clz, @ctz, @rotl).

fun fast_min(a: i64, b: i64): i64
    if a < b then a else b end
end

fun fast_max(a: i64, b: i64): i64
    if a > b then a else b end
end

fun fast_minf(a: float, b: float): float
    if a < b then a else b end
end

fun fast_maxf(a: float, b: float): float
    if a > b then a else b end
end

fun fast_abs(x: i64): i64
    if x < 0 then 0 - x else x end
end

fun fast_absf(x: float): float
    if x < 0.0 then 0.0 - x else x end
end

fun fast_clamp(x: i64, lo: i64, hi: i64): i64
    if x < lo then lo elseif x > hi then hi else x end
end

fun fast_clampf(x: float, lo: float, hi: float): float
    if x < lo then lo elseif x > hi then hi else x end
end

fun fast_sign(x: i64): i64
    (x > 0) - (x < 0)
end

fun fast_signf(x: float): i64
    if x > 0.0 then 1 elseif x < 0.0 then -1 else 0 end
end

fun fast_lerp(a: float, b: float, t: float): float
    a + (b - a) * t
end

fun fast_lerpi(a: i64, b: i64, numer: i64, denom: i64): i64
    a + (b - a) * numer // denom
end

fun fast_popcount(x: i64): i64
    @popcount(x)
end

fun fast_clz(x: i64): i64
    if x == 0 then 64 else @clz(x) end
end

fun fast_ctz(x: i64): i64
    if x == 0 then 64 else @ctz(x) end
end

fun fast_bit_length(x: i64): i64
    if x == 0 then 0 else 64 - @clz(x) end
end

fun fast_rotl(x: i64, k: i64): i64
    kk = k & 63
    @rotl(x, kk)
end

fun fast_rotr(x: i64, k: i64): i64
    kk = k & 63
    __rotr(x, kk)
end

fun fast_next_pow2(x: i64): i64
    if x <= 1 then return 1 end
    v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v = v | (v >> 32)
    v + 1
end

fun fast_is_pow2(x: i64): bool
    x > 0 and (x & (x - 1)) == 0
end

fun fast_ceil_div(a: i64, b: i64): i64
    (a + b - 1) // b
end

fun fast_avg(a: i64, b: i64): i64
    (a & b) + (((a | b) - (a & b)) >> 1)
end

fun fast_sat_add(a: i64, b: i64): i64
    r = a + b
    if r < a then 9223372036854775807 else r end
end

fun fast_sat_sub(a: i64, b: i64): i64
    r = a - b
    if r > a then 0 else r end
end

fun fast_euclid_mod(a: i64, b: i64): i64
    r = a % b
    if r >= 0 then return r end
    mag = b
    if b < 0 then mag = 0 - b end
    r + mag
end

fun fast_gcd(a: i64, b: i64): i64
    if a < 0 then a = 0 - a end
    if b < 0 then b = 0 - b end
    while b ~= 0
        temp = b
        b = a % b
        a = temp
    end
    a
end

fun fast_lcm(a: i64, b: i64): i64
    if a == 0 or b == 0 then return 0 end
    (a // fast_gcd(a, b)) * b
end
