-- std.math.cmplx — complex number support (mirrors Go's math/cmplx)
-- Complex numbers as tables {re, im}.

fun new(re: any, im: any): any
    {re = re, im = im}
end

fun add(a: any, b: any): any
    {re = a.re + b.re, im = a.im + b.im}
end

fun sub(a: any, b: any): any
    {re = a.re - b.re, im = a.im - b.im}
end

fun mul(a: any, b: any): any
    {re = a.re * b.re - a.im * b.im, im = a.re * b.im + a.im * b.re}
end

fun div(a: any, b: any): any
    denom = b.re * b.re + b.im * b.im
    return {re = (a.re * b.re + a.im * b.im) / denom, im = (a.im * b.re - a.re * b.im) / denom}
end

fun neg(a: any): any
    {re = -a.re, im = -a.im}
end

fun conj(a: any): any
    {re = a.re, im = -a.im}
end

fun abs(a: any): any
    math.sqrt(a.re * a.re + a.im * a.im)
end

fun phase(a: any): any
    math.atan2(a.im, a.re)
end

fun polar(r: any, theta: any): any
    {re = r * math.cos(theta), im = r * math.sin(theta)}
end

fun rect(r: any, theta: any): any
    polar(r, theta)
end

fun exp(a: any): any
    er = math.exp(a.re)
    return {re = er * math.cos(a.im), im = er * math.sin(a.im)}
end

fun log(a: any): any
    r = abs(a)
    theta = phase(a)
    return {re = math.log(r), im = theta}
end

fun sin(a: any): any
    {re = math.sin(a.re) * math.cosh(a.im), im = math.cos(a.re) * math.sinh(a.im)}
end

fun cos(a: any): any
    {re = math.cos(a.re) * math.cosh(a.im), im = -math.sin(a.re) * math.sinh(a.im)}
end

fun tan(a: any): any
    s = sin(a)
    c = cos(a)
    div(s, c)
end

fun sqrt(a: any): any
    if a.im == 0 and a.re >= 0 then
        return {re = math.sqrt(a.re), im = 0}
    end
    r = abs(a)
    return {re = math.sqrt((r + a.re) / 2), im = math.sign(a.im) * math.sqrt((r - a.re) / 2)}
end

fun pow(a: any, b: any): any
    if b.im == 0 and b.re == math.floor(b.re) then
        n = b.re
        result = {re = 1, im = 0}
        base = {re = a.re, im = a.im}
        if n < 0 then
            base = div({re = 1, im = 0}, base)
            n = -n
        end
        for _ = 1, n
            result = mul(result, base)
        end
        return result
    end
    exp(mul(b, log(a)))
end

fun is_nan(a: any): bool
    a.re ~= a.re or a.im ~= a.im
end

fun is_inf(a: any): bool
    a.re == math.huge or a.re == -math.huge or a.im == math.huge or a.im == -math.huge
end

M = {}
M.new = new
M.add = add
M.sub = sub
M.mul = mul
M.div = div
M.neg = neg
M.conj = conj
M.abs = abs
M.phase = phase
M.polar = polar
M.rect = rect
M.exp = exp
M.log = log
M.sin = sin
M.cos = cos
M.tan = tan
M.sqrt = sqrt
M.pow = pow
M.is_nan = is_nan
M.is_inf = is_inf
M
