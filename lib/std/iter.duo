-- std.iter — functional iterators and higher-order functions

fun map(list: any, fn: any): any
    out = {}
    for i = 1, #list
        out[i] = fn(list[i])
    end
    out
end

fun filter(list: any, fn: any): any
    out = {}
    for i = 1, #list
        if fn(list[i]) then
            table.insert(out, list[i])
        end
    end
    out
end

fun reduce(list: any, init: any, fn: any): any
    acc = init
    for i = 1, #list
        acc = fn(acc, list[i])
    end
    acc
end

fun any_(list: any, fn: any): bool
    for i = 1, #list
        if fn(list[i]) then return true end
    end
    false
end

fun all(list: any, fn: any): bool
    for i = 1, #list
        if not fn(list[i]) then return false end
    end
    true
end

fun find(list: any, fn: any): any
    for i = 1, #list
        if fn(list[i]) then return list[i] end
    end
    nil
end

fun zip(l1: any, l2: any): any
    out = {}
    if l1 == nil or l2 == nil then return out end
    m = math.min(rawlen(l1), rawlen(l2))
    i = 1
    while i <= m
        out[rawlen(out) + 1] = {l1[i], l2[i]}
        i = i + 1
    end
    out
end

fun enumerate(list: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        out[rawlen(out) + 1] = {i, list[i]}
        i = i + 1
    end
    out
end

fun flat_map(list: any, fn: any): any
    out = {}
    if list == nil then return out end
    i = 1
    while i <= rawlen(list)
        mapped = fn(list[i])
        if type(mapped) == "table" then
            j = 1
            while j <= rawlen(mapped)
                out[rawlen(out) + 1] = mapped[j]
                j = j + 1
            end
        else
            out[rawlen(out) + 1] = mapped
        end
        i = i + 1
    end
    out
end

M = {}
M.map = map
M.filter = filter
M.reduce = reduce
M.any = any_
M.all = all
M.find = find
M.zip = zip
M.enumerate = enumerate
M.flat_map = flat_map
M
