-- std.bytes — Native byte slices and cursors for binary parsing.
-- Ward blocker: Duo needs byte buffers for Wasm binary decoding.
-- This is a general-purpose capability, not Ward-specific.

-- Create a byte buffer from a string (zero-copy view of string bytes)
fun from_string(s: str): any
    return { data = s, pos = 1, len = string.len(s) }
end

-- Read one byte at current position, advance cursor
fun read_byte(buf: any): i64
    if buf.pos > buf.len then return -1 end
    b = string.byte(buf.data, buf.pos)
    buf.pos = buf.pos + 1
    return b
end

-- Read a u32 (little-endian) from cursor
fun read_u32_le(buf: any): i64
    if buf.pos + 3 > buf.len then return -1 end
    b0 = string.byte(buf.data, buf.pos)
    b1 = string.byte(buf.data, buf.pos + 1)
    b2 = string.byte(buf.data, buf.pos + 2)
    b3 = string.byte(buf.data, buf.pos + 3)
    buf.pos = buf.pos + 4
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

-- Read a u16 (little-endian) from cursor
fun read_u16_le(buf: any): i64
    if buf.pos + 1 > buf.len then return -1 end
    b0 = string.byte(buf.data, buf.pos)
    b1 = string.byte(buf.data, buf.pos + 1)
    buf.pos = buf.pos + 2
    return b0 + b1 * 256
end

-- Read LEB128-encoded unsigned integer (used extensively in Wasm binary format)
fun read_leb128_u(buf: any): i64
    result = 0
    shift = 0
    while true do
        if buf.pos > buf.len then return -1 end
        b = string.byte(buf.data, buf.pos)
        buf.pos = buf.pos + 1
        result = result + ((b % 128) * (2 ^ shift))
        if b < 128 then return result end
        shift = shift + 7
        if shift >= 35 then return -1 end
    end
    return result
end

-- Read LEB128-encoded signed integer
fun read_leb128_s(buf: any): i64
    result = 0
    shift = 0
    while true do
        if buf.pos > buf.len then return -1 end
        b = string.byte(buf.data, buf.pos)
        buf.pos = buf.pos + 1
        result = result + ((b % 128) * (2 ^ shift))
        shift = shift + 7
        if b < 128 then
            if shift < 64 and (b % 256) >= 64 then
                result = result - (2 ^ shift)
            end
            return result
        end
        if shift >= 70 then return -1 end
    end
    return result
end

-- Read N bytes as a substring
fun read_bytes(buf: any, n: i64): str
    if buf.pos + n - 1 > buf.len then return "" end
    result = string.sub(buf.data, buf.pos, buf.pos + n - 1)
    buf.pos = buf.pos + n
    return result
end

-- Remaining bytes in buffer
fun remaining(buf: any): i64
    return buf.len - buf.pos + 1
end

-- Check if at end
fun is_eof(buf: any): bool
    return buf.pos > buf.len
end

-- Skip N bytes
fun skip(buf: any, n: i64)
    buf.pos = buf.pos + n
end

-- Current position (1-indexed)
fun position(buf: any): i64
    return buf.pos
end
