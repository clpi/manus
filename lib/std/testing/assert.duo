-- std.testing.assert — Rich test assertions
-- Extends basic testing with more expressive assertion functions.

-- ═══════════════════════════════════════════════════════════════
-- Assertion Context
-- ═══════════════════════════════════════════════════════════════

assert_context_new(test_name: str): any
    {
        name = test_name,
        passed = 0,
        failed = 0,
        errors = {},
    }
end

assert_context_report(ctx: any): any
    {
        name = ctx.name,
        passed = ctx.passed,
        failed = ctx.failed,
        total = ctx.passed + ctx.failed,
        success_rate = (ctx.passed + ctx.failed) > 0
            and ctx.passed / (ctx.passed + ctx.failed) or 0,
        errors = ctx.errors,
    }
end

-- ═══════════════════════════════════════════════════════════════
-- Basic Assertions
-- ═══════════════════════════════════════════════════════════════

assert_true(ctx: any, value: bool, msg: str): void
    if value
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_true",
            message = msg or "Expected true",
            expected = true,
            got = value,
        }
    end
end

assert_false(ctx: any, value: bool, msg: str): void
    if not value
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_false",
            message = msg or "Expected false",
            expected = false,
            got = value,
        }
    end
end

assert_equal(ctx: any, got: any, expected: any, msg: str): void
    if got == expected
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_equal",
            message = msg or "Values not equal",
            expected = expected,
            got = got,
        }
    end
end

assert_not_equal(ctx: any, got: any, expected: any, msg: str): void
    if got != expected
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_not_equal",
            message = msg or "Values should not be equal",
            expected = "not " .. expected:to(str),
            got = got,
        }
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Numeric Assertions
-- ═══════════════════════════════════════════════════════════════

assert_near(ctx: any, got: f64, expected: f64, tolerance: f64, msg: str): void
    if tolerance == nil tolerance = 1e-6 end
    if math.abs(got - expected) <= tolerance
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_near",
            message = msg or "Values not within tolerance",
            expected = expected,
            got = got,
            tolerance = tolerance,
        }
    end
end

assert_greater(ctx: any, got: f64, expected: f64, msg: str): void
    if got > expected
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_greater",
            message = msg or "Expected greater than",
            expected = "> " .. expected:to(str),
            got = got,
        }
    end
end

assert_less(ctx: any, got: f64, expected: f64, msg: str): void
    if got < expected
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_less",
            message = msg or "Expected less than",
            expected = "< " .. expected:to(str),
            got = got,
        }
    end
end

assert_in_range(ctx: any, got: f64, min: f64, max: f64, msg: str): void
    if got >= min and got <= max
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_in_range",
            message = msg or "Value not in range",
            expected = "[" .. min:to(str) .. ", " .. max:to(str) .. "]",
            got = got,
        }
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Type Assertions
-- ═══════════════════════════════════════════════════════════════

assert_type(ctx: any, got: any, expected_type: str, msg: str): void
    actual_type = type(got)
    if actual_type == expected_type
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_type",
            message = msg or "Wrong type",
            expected = expected_type,
            got = actual_type,
        }
    end
end

assert_is_nil(ctx: any, got: any, msg: str): void
    if got == nil
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_is_nil",
            message = msg or "Expected nil",
            expected = nil,
            got = got,
        }
    end
end

assert_is_not_nil(ctx: any, got: any, msg: str): void
    if got != nil
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_is_not_nil",
            message = msg or "Expected non-nil value",
            expected = "not nil",
            got = got,
        }
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Collection Assertions
-- ═══════════════════════════════════════════════════════════════

assert_table_equal(ctx: any, got: any, expected: any, msg: str): void
    -- Check length
    if #got != #expected
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_table_equal",
            message = msg or "Table lengths differ",
            expected = #expected,
            got = #got,
        }
        return
    end

    -- Check elements
    i = 1
    while i <= #got
        if got[i] != expected[i]
            ctx.failed += 1
            ctx.errors[#ctx.errors + 1] = {
                type = "assert_table_equal",
                message = msg or "Tables differ at index " .. i:to(str),
                expected = expected[i],
                got = got[i],
                index = i,
            }
            return
        end
        i += 1
    end
    ctx.passed += 1
end

assert_table_contains(ctx: any, table: any, value: any, msg: str): void
    for v in table
        if v == value
            ctx.passed += 1
            return
        end
    end
    ctx.failed += 1
    ctx.errors[#ctx.errors + 1] = {
        type = "assert_table_contains",
        message = msg or "Table does not contain value",
        expected = value,
        got = table,
    }
end

assert_table_empty(ctx: any, table: any, msg: str): void
    if #table == 0
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_table_empty",
            message = msg or "Table is not empty",
            expected = "empty table",
            got = #table .. " elements",
        }
    end
end

-- ═══════════════════════════════════════════════════════════════
-- String Assertions
-- ═══════════════════════════════════════════════════════════════

assert_string_contains(ctx: any, got: str, expected: str, msg: str): void
    if string.find(got, expected, 1, true)
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_string_contains",
            message = msg or "String does not contain expected substring",
            expected = expected,
            got = got,
        }
    end
end

assert_string_starts_with(ctx: any, got: str, expected: str, msg: str): void
    if got:sub(1, #expected) == expected
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_string_starts_with",
            message = msg or "String does not start with expected prefix",
            expected = expected,
            got = got,
        }
    end
end

assert_string_ends_with(ctx: any, got: str, expected: str, msg: str): void
    if got:sub(-#expected) == expected
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_string_ends_with",
            message = msg or "String does not end with expected suffix",
            expected = expected,
            got = got,
        }
    end
end

assert_string_matches(ctx: any, got: str, pattern: str, msg: str): void
    if string.find(got, pattern)
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_string_matches",
            message = msg or "String does not match pattern",
            expected = pattern,
            got = got,
        }
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Error Assertions
-- ═══════════════════════════════════════════════════════════════

assert_errors(ctx: any, func: any, msg: str): void
    ok, err = pcall(func)
    if not ok
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_errors",
            message = msg or "Expected function to error",
            got = "no error",
        }
    end
end

assert_errors_with(ctx: any, func: any, expected_err: str, msg: str): void
    ok, err = pcall(func)
    if not ok and string.find(err, expected_err, 1, true)
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_errors_with",
            message = msg or "Expected function to error with specific message",
            expected = expected_err,
            got = ok and "no error" or err,
        }
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Performance Assertions
-- ═══════════════════════════════════════════════════════════════

assert_faster_than(ctx: any, func: any, max_time: f64, iterations: i64, msg: str): void
    if iterations == nil iterations = 100 end

    start = os.clock()
    i = 0
    while i < iterations
        func()
        i += 1
    end
    elapsed = os.clock() - start

    avg_time = elapsed / iterations
    if avg_time <= max_time
        ctx.passed += 1
    else
        ctx.failed += 1
        ctx.errors[#ctx.errors + 1] = {
            type = "assert_faster_than",
            message = msg or "Function too slow",
            expected = "< " .. max_time:to(str) .. "s",
            got = avg_time:to(str) .. "s",
        }
    end
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Context
M.context_new = assert_context_new
M.context_report = assert_context_report
-- Basic
M.true = assert_true
M.false = assert_false
M.equal = assert_equal
M.not_equal = assert_not_equal
-- Numeric
M.near = assert_near
M.greater = assert_greater
M.less = assert_less
M.in_range = assert_in_range
-- Type
M.type = assert_type
M.is_nil = assert_is_nil
M.is_not_nil = assert_is_not_nil
-- Collection
M.table_equal = assert_table_equal
M.table_contains = assert_table_contains
M.table_empty = assert_table_empty
-- String
M.string_contains = assert_string_contains
M.string_starts_with = assert_string_starts_with
M.string_ends_with = assert_string_ends_with
M.string_matches = assert_string_matches
-- Error
M.errors = assert_errors
M.errors_with = assert_errors_with
-- Performance
M.faster_than = assert_faster_than
M
