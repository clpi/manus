-- std.testing.fstest — filesystem test helpers (mirrors Go's testing/fstest)
-- Provides a MapFS in-memory filesystem for testing file operations.

string = req "std.string"

MapFS = {}
MapFS.__index = MapFS

new_mapfs(): any
    {files = {}}
end

mapfs_add(fs: any, path: str, data: str): void
    fs.files[path] = {data = data, mode = 0644}
end

mapfs_add_dir(fs: any, path: str): void
    fs.files[path] = {data = nil, mode = 0755, is_dir = true}
end

mapfs_open(fs: any, path: str): any
    entry = fs.files[path]
    if entry == nil return nil end
    {data = entry.data, pos = 1, mode = entry.mode, is_dir = entry.is_dir}
end

mapfs_read(f: any, n: i64): any
    if f.data == nil return nil end
    if f.pos > string.len(f.data) return nil end
    chunk = string.sub(f.data, f.pos, f.pos + n - 1)
    f.pos = f.pos + string.len(chunk)
    chunk
end

mapfs_read_all(f: any): str
    if f.data == nil return "" end
    f.pos = string.len(f.data) + 1
    f.data
end

mapfs_seek(f: any, offset: i64, whence: i64): i64
    if f.data == nil return 0 end
    if whence == 0
        f.pos = offset + 1
    elseif whence == 1
        f.pos = f.pos + offset
    elseif whence == 2
        f.pos = string.len(f.data) + offset + 1
    end
    if f.pos < 1 f.pos = 1 end
    f.pos - 1
end

mapfs_glob(fs: any, pattern: str): any
    results = {}
    for path, _ in fs.files
        if string.find(path, pattern)
            results[rawlen(results) + 1] = path
        end
    end
    results
end

M = {}
M.new_mapfs = new_mapfs
M.mapfs_add = mapfs_add
M.mapfs_add_dir = mapfs_add_dir
M.mapfs_open = mapfs_open
M.mapfs_read = mapfs_read
M.mapfs_read_all = mapfs_read_all
M.mapfs_seek = mapfs_seek
M.mapfs_glob = mapfs_glob
M
