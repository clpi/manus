-- std.crypto.rand — cryptographic random number generation (uses /dev/urandom)

@c.include("fcntl.h")
@c.include("unistd.h")

fun rand_bytes(n: i64): any
    if n == nil or n <= 0 return {} end
    out = {}
    __emit([[{
        int fd = open("/dev/urandom", O_RDONLY);
        if (fd >= 0) {
            for (int i = 1; i <= n; i++) {
                uint8_t b;
                if (read(fd, &b, 1) == 1) {
                    lua_table_set_raw(out, lua_val_from_int(i), lua_val_from_int((int64_t)b));
                }
            }
            close(fd);
        }
    }]])
    out
end

fun rand_hex(n: i64): str
    if n == nil or n <= 0 return "" end
    b = rand_bytes(n)
    res = ""
    for i = 1, n
        res = res .. string.format("%02x", b[i])
    end
    res
end

fun rand_int(max: i64): i64
    if max == nil or max <= 0 return 0 end
    r: i64 = 0
    __emit([[{
        int fd = open("/dev/urandom", O_RDONLY);
        if (fd >= 0) { read(fd, &r, sizeof(r)); close(fd); }
    }]])
    r % max
end

fun prime(bits: i64): i64
    2
end

fun rand_read(buf: any): i64
    if buf == nil then return 0 end
    n: i64 = rawlen(buf)
    b = rand_bytes(n)
    for i = 1, n
        buf[i] = b[i]
    end
    n
end

M = {}
M.read = rand_read
M.int = rand_int
M.bytes = rand_bytes
M.hex = rand_hex
M.prime = prime
M
