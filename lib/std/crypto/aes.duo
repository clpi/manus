-- Round constants
RCON = {
    0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36,
}

-- Galois field multiplication
aes_gmul(a: i64, b: i64): i64
    p = 0
    i = 0
    while i < 8
        if b & 1 != 0
            p = p ~ a
        end
        hi = a & 0x80
        a = (a << 1) & 0xFF
        if hi != 0
            a = a ~ 0x1B
        end
        b = b >> 1
        i += 1
    end
    p
end

-- ═══════════════════════════════════════════════════════════════
-- Key Expansion
-- ═══════════════════════════════════════════════════════════════

key_expansion(key: any, key_len: i64): any
    if key_len == 16
        nk = 4; nr = 10
    elseif key_len == 24
        nk = 6; nr = 12
    else
        nk = 8; nr = 14
    end

    w = {}
    i = 0
    while i < nk
        w[i] = {key[i*4+1], key[i*4+2], key[i*4+3], key[i*4+4]}
        i += 1
    end

    i = nk
    while i < 4 * (nr + 1)
        temp = {w[i-1][1], w[i-1][2], w[i-1][3], w[i-1][4]}

        if i % nk == 0
            -- RotWord + SubWord + Rcon
            temp = {
                SBOX[temp[2] + 1] ~ RCON[(i / nk)],
                SBOX[temp[3] + 1],
                SBOX[temp[4] + 1],
                SBOX[temp[1] + 1],
            }
        elseif nk > 6 and i % nk == 4
            -- SubWord only for AES-256
            temp = {
                SBOX[temp[1] + 1],
                SBOX[temp[2] + 1],
                SBOX[temp[3] + 1],
                SBOX[temp[4] + 1],
            }
        end

        w[i] = {}
        j = 0
        while j < 4
            w[i][j+1] = w[i - nk][j+1] ~ temp[j+1]
            j += 1
        end
        i += 1
    end

    {round_keys = w, num_rounds = nr}
end

-- ═══════════════════════════════════════════════════════════════
-- AES Block Operations
-- ═══════════════════════════════════════════════════════════════

aes_sub_bytes(state: any): void
    i = 0
    while i < 16
        state[i] = SBOX[state[i] + 1]
        i += 1
    end
end

aes_inv_sub_bytes(state: any): void
    i = 0
    while i < 16
        state[i] = AES_INV_SBOX[state[i] + 1]
        i += 1
    end
end

aes_inv_shift_rows(state: any): void
    -- Row 1: shift right by 1
    temp = state[13]
    state[13] = state[9]
    state[9] = state[5]
    state[5] = state[1]
    state[1] = temp

    -- Row 2: shift right by 2
    temp = state[2]
    state[2] = state[10]
    state[10] = temp
    temp = state[6]
    state[6] = state[14]
    state[14] = temp

    -- Row 3: shift right by 3
    temp = state[3]
    state[3] = state[7]
    state[7] = state[11]
    state[11] = state[15]
    state[15] = temp
end

aes_inv_mix_columns(state: any): void
    col = 0
    while col < 4
        s0 = state[col * 4]
        s1 = state[col * 4 + 1]
        s2 = state[col * 4 + 2]
        s3 = state[col * 4 + 3]

        state[col * 4] = aes_gmul(s0, 0x0E) ~ aes_gmul(s1, 0x0B) ~ aes_gmul(s2, 0x0D) ~ aes_gmul(s3, 0x09)
        state[col * 4 + 1] = aes_gmul(s0, 0x09) ~ aes_gmul(s1, 0x0E) ~ aes_gmul(s2, 0x0B) ~ aes_gmul(s3, 0x0D)
        state[col * 4 + 2] = aes_gmul(s0, 0x0D) ~ aes_gmul(s1, 0x09) ~ aes_gmul(s2, 0x0E) ~ aes_gmul(s3, 0x0B)
        state[col * 4 + 3] = aes_gmul(s0, 0x0B) ~ aes_gmul(s1, 0x0D) ~ aes_gmul(s2, 0x09) ~ aes_gmul(s3, 0x0E)
        col += 1
    end
end

aes_shift_rows(state: any): void
    -- Row 1: shift left by 1
    temp = state[1]
    state[1] = state[5]
    state[5] = state[9]
    state[9] = state[13]
    state[13] = temp

    -- Row 2: shift left by 2
    temp = state[2]
    state[2] = state[10]
    state[10] = temp
    temp = state[6]
    state[6] = state[14]
    state[14] = temp

    -- Row 3: shift left by 3
    temp = state[15]
    state[15] = state[11]
    state[11] = state[7]
    state[7] = state[3]
    state[3] = temp
end

aes_mix_columns(state: any): void
    col = 0
    while col < 4
        s0 = state[col * 4]
        s1 = state[col * 4 + 1]
        s2 = state[col * 4 + 2]
        s3 = state[col * 4 + 3]

        state[col * 4] = aes_gmul(s0, 2) ~ aes_gmul(s1, 3) ~ s2 ~ s3
        state[col * 4 + 1] = s0 ~ aes_gmul(s1, 2) ~ aes_gmul(s2, 3) ~ s3
        state[col * 4 + 2] = s0 ~ s1 ~ aes_gmul(s2, 2) ~ aes_gmul(s3, 3)
        state[col * 4 + 3] = aes_gmul(s0, 3) ~ s1 ~ s2 ~ aes_gmul(s3, 2)
        col += 1
    end
end

aes_add_round_key(state: any, w: any, round: i64): void
    i = 0
    while i < 16
        state[i] = state[i] ~ w[round * 4 + i / 4][i % 4 + 1]
        i += 1
    end
end

-- ═══════════════════════════════════════════════════════════════
-- AES Encrypt Block (single 16-byte block)
-- ═══════════════════════════════════════════════════════════════

encrypt_block(block: any, expanded_key: any): any
    state = {}
    i = 0
    while i < 16
        state[i] = block[i]
        i += 1
    end

    w = expanded_key.round_keys
    nr = expanded_key.num_rounds

    -- Initial round key addition
    aes_add_round_key(state, w, 0)

    -- Main rounds
    round = 1
    while round < nr
        aes_sub_bytes(state)
        aes_shift_rows(state)
        aes_mix_columns(state)
        aes_add_round_key(state, w, round)
        round += 1
    end

    -- Final round (no MixColumns)
    aes_sub_bytes(state)
    aes_shift_rows(state)
    aes_add_round_key(state, w, nr)

    state
end

-- ═══════════════════════════════════════════════════════════════
-- AES Decrypt Block
-- ═══════════════════════════════════════════════════════════════

decrypt_block(block: any, expanded_key: any): any
    state = {}
    i = 0
    while i < 16
        state[i] = block[i]
        i += 1
    end

    w = expanded_key.round_keys
    nr = expanded_key.num_rounds

    aes_add_round_key(state, w, nr)

    round = nr - 1
    while round >= 1
        aes_inv_shift_rows(state)
        aes_inv_sub_bytes(state)
        aes_add_round_key(state, w, round)
        if round > 1
            aes_inv_mix_columns(state)
        end
        round -= 1
    end

    aes_inv_shift_rows(state)
    aes_inv_sub_bytes(state)
    aes_add_round_key(state, w, 0)

    state
end

-- ═══════════════════════════════════════════════════════════════
-- AES-CBC Mode
-- ═══════════════════════════════════════════════════════════════

cbc_encrypt(plaintext: any, key: any, iv: any): any
    key_len = #key
    expanded = key_expansion(key, key_len)

    -- PKCS7 padding
    pad_len = 16 - (#plaintext % 16)
    padded = {}
    for i = 1, #plaintext
        padded[#padded + 1] = plaintext[i]
    end
    i = 0
    while i < pad_len
        padded[#padded + 1] = pad_len
        i += 1
    end

    ciphertext = {}
    prev = iv

    block_idx = 1
    while block_idx <= #padded
        block = {}
        i = 0
        while i < 16
            block[i] = padded[block_idx + i] ~ prev[i + 1]
            i += 1
        end

        encrypted = encrypt_block(block, expanded)
        for i = 0, 15
            ciphertext[#ciphertext + 1] = encrypted[i]
        end
        -- Convert to 1-based for consistent XOR in next iteration
        prev = {}
        for i = 0, 15
            prev[i + 1] = encrypted[i]
        end
        block_idx += 16
    end

    ciphertext
end

cbc_decrypt(ciphertext: any, key: any, iv: any): any
    key_len = #key
    expanded = key_expansion(key, key_len)

    plaintext = {}
    prev = iv

    block_idx = 1
    while block_idx <= #ciphertext
        block = {}
        i = 0
        while i < 16
            block[i] = ciphertext[block_idx + i]
            i += 1
        end

        decrypted = decrypt_block(block, expanded)
        for i = 0, 15
            plaintext[#plaintext + 1] = decrypted[i] ~ prev[i + 1]
        end
        -- Convert current ciphertext block to 1-based for next iteration
        prev = {}
        for i = 0, 15
            prev[i + 1] = block[i]
        end
        block_idx += 16
    end

    -- Remove PKCS7 padding
    if #plaintext > 0
        pad = plaintext[#plaintext]
        if pad >= 1 and pad <= 16
            i = #plaintext - pad + 1
            while i <= #plaintext
                if plaintext[i] != pad return plaintext end
                i += 1
            end
            -- Valid padding, trim
            new_len = #plaintext - pad
            trimmed = {}
            i = 1
            while i <= new_len
                trimmed[i] = plaintext[i]
                i += 1
            end
            return trimmed
        end
    end
    plaintext
end

-- ═══════════════════════════════════════════════════════════════
-- AES-CTR Mode (stream cipher)
-- ═══════════════════════════════════════════════════════════════

ctr_crypt(data: any, key: any, nonce: any): any
    key_len = #key
    expanded = key_expansion(key, key_len)

    counter = {}
    i = 0
    while i < 16
        counter[i] = nonce[i + 1] or 0
        i += 1
    end

    output = {}
    block_idx = 0
    while block_idx < #data
        keystream = encrypt_block(counter, expanded)

        byte_idx = 0
        while byte_idx < 16 and block_idx + byte_idx < #data
            output[#output + 1] = data[block_idx + byte_idx + 1] ~ keystream[byte_idx]
            byte_idx += 1
        end

        -- Increment counter
        i = 15
        while i >= 0
            counter[i] = (counter[i] + 1) & 0xFF
            if counter[i] != 0 break end
            i -= 1
        end

        block_idx += 16
    end

    output
end

-- ═══════════════════════════════════════════════════════════════
-- Utility functions
-- ═══════════════════════════════════════════════════════════════

string_to_bytes(s: str): any
    bytes = {}
    i = 1
    while i <= #s
        bytes[#bytes + 1] = string.byte(s, i)
        i += 1
    end
    bytes
end

bytes_to_string(bytes: any): str
    parts = {}
    i = 1
    while i <= #bytes
        parts[#parts + 1] = string.char(bytes[i])
        i += 1
    end
    table.concat(parts)
end

