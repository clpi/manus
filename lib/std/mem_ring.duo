-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Ring Buffer
M.ring_new = ring_new
M.ring_push = ring_push
M.ring_pop = ring_pop
M.ring_peek = ring_peek
M.ring_len = ring_len
M.ring_free = ring_free
M.ring_is_empty = ring_is_empty
M.ring_is_full = ring_is_full
M.ring_drain = ring_drain
M.ring_clear = ring_clear
-- Double Buffer
M.double_buffer_new = double_buffer_new
M.double_buffer_swap = double_buffer_swap
M.double_buffer_write = double_buffer_write
M.double_buffer_read = double_buffer_read
-- Memory Pool
M.mem_pool_new = mem_pool_new
M.mem_pool_alloc = mem_pool_alloc
M.mem_pool_free = mem_pool_free
M.mem_pool_stats = mem_pool_stats
-- Slab Allocator
M.slab_allocator_new = slab_allocator_new
M.slab_alloc = slab_alloc
M.slab_free = slab_free
M.slab_stats = slab_stats
-- Virtual Memory Arena
M.vmem_arena_new = vmem_arena_new
M.vmem_arena_alloc = vmem_arena_alloc
M.vmem_arena_reset = vmem_arena_reset
M.vmem_arena_stats = vmem_arena_stats
M
