-- std.ffi_gen — Intelligent FFI Binding Generator
-- At compile time, parses C headers and generates Duo FFI bindings
-- with proper type mapping, error handling, and memory management hints.
--
-- Usage:
--   local ffi = req "std.ffi_gen"
--   local bindings = ffi.from_header("sqlite3.h", { prefix = "sqlite3_" })
--   -- bindings contains generated C code as a string
--   -- Pass to @c.emit(@run(...)) or use directly

-- ═══════════════════════════════════════════════════════════════
-- Helpers
-- ═══════════════════════════════════════════════════════════════

str_join(parts: any, sep: str): str
    result = ""
    for i, part in parts
        if i > 1
            result = result .. sep
        end
        result = result .. part
    end
    result
end

-- ═══════════════════════════════════════════════════════════════
-- Header parsing and binding generation
-- ═══════════════════════════════════════════════════════════════

-- from_header: parse a C header and generate Duo FFI bindings.
-- Use at module scope: the caller preprocesses with @run and passes the source.
-- Example:
--   local preprocessed = @run("echo '#include \"sqlite3.h\"' | cc -E -dM -x c - 2>/dev/null | head -500")
--   local bindings = ffi.from_header_source(preprocessed, { prefix = "sqlite3_" })
from_header(header: str, opts: any): str
    -- NOTE: @run with string concat doesn't work inside function bodies.
    -- Use from_header_source() with a preprocessed string instead.
    "/* from_header: use from_header_source() with @run at module scope */"
end

-- from_source: parse a preprocessed header source string directly.
from_source(source: str, opts: any): str
    if opts == nil opts = {} end
    prefix = opts.prefix or ""
    includes = opts.include or nil
    excludes = opts.excludes or {}
    exclude_set = {}
    for _, e in excludes
        exclude_set[e] = true
    end

    functions = parse_c_declarations(source, prefix, exclude_set, includes)
    parts = {}
    for _, func in functions
        parts[#parts + 1] = emit_ffi_binding(func)
    end
    str_join(parts, "\n")
end

-- ═══════════════════════════════════════════════════════════════
-- C declaration parser
-- ═══════════════════════════════════════════════════════════════

-- parse_c_declarations: extract function signatures from C source.
parse_c_declarations(source: str, prefix: str, excludes: any, includes: any): any
    funcs = {}
    lines = string.split(source, "\n")
    for _, line in lines
        line = string.gsub(line, "^%s+", "")
        line = string.gsub(line, "%s+$", "")
        if string.sub(line, 1, 1) != "#"
           and string.sub(line, 1, 2) != "//"
           and not string.match(line, "^typedef")
           and not string.match(line, "^struct ")
           and not string.match(line, "^enum ")
           and not string.match(line, "^union ")
           and not string.match(line, "^#")
            ret_type, name, params = string.match(line, "^(%S+)%s+(%w+)%s*%((.-)%)%s*;")
            if ret_type and name
                if prefix == "" or string.sub(name, 1, #prefix) == prefix
                    if not excludes[name]
                        include_match = true
                        if includes
                            include_match = false
                            for _, inc in includes
                                if string.sub(name, 1, #inc) == inc
                                    include_match = true
                                    break
                                end
                            end
                        end
                        if include_match
                            funcs[#funcs + 1] = {
                                name = name,
                                ret_type = ret_type,
                                params = parse_c_params(params),
                            }
                        end
                    end
                end
            end
        end
    end
    funcs
end

-- parse_c_params: parse a C parameter list string into a list of {type, name} pairs
parse_c_params(params_str: str): any
    if params_str == "void" or params_str == "" return {} end
    params = {}
    parts = string.split(params_str, ",")
    for _, part in parts
        part = string.gsub(part, "^%s+", "")
        part = string.gsub(part, "%s+$", "")
        tokens = {}
        for token in string.gmatch(part, "%S+") do
            tokens[#tokens + 1] = token
        end
        if #tokens >= 2
            name = tokens[#tokens]
            type_parts = {}
            for j = 1, #tokens - 1
                type_parts[#type_parts + 1] = tokens[j]
            end
            typ = str_join(type_parts, " ")
            params[#params + 1] = {
                c_type = typ,
                name = name,
                is_pointer = string.find(typ, "*") != nil,
                is_const = string.find(typ, "const") != nil,
            }
        elseif #tokens == 1
            params[#params + 1] = {
                c_type = tokens[1],
                name = "arg" .. tostring(#params + 1),
                is_pointer = false,
                is_const = false,
            }
        end
    end
    params
end

-- ═══════════════════════════════════════════════════════════════
-- Type mapping: C types → Duo types
-- ═══════════════════════════════════════════════════════════════

c_type_to_duo(c_type: str, is_pointer: bool): str
    base = string.gsub(c_type, "%*", "")
    base = string.gsub(base, "const ", "")
    base = string.gsub(base, "^%s+", "")
    base = string.gsub(base, "%s+$", "")

    if is_pointer
        if base == "char" return "str" end
        if base == "void" return "any" end
        return "any"
    end

    type_map = {
        ["int"] = "i64", ["unsigned int"] = "i64", ["long"] = "i64",
        ["long long"] = "i64", ["unsigned long"] = "i64", ["unsigned long long"] = "i64",
        ["short"] = "i64", ["unsigned short"] = "i64",
        ["char"] = "i64", ["unsigned char"] = "i64",
        ["int8_t"] = "i64", ["int16_t"] = "i64", ["int32_t"] = "i64", ["int64_t"] = "i64",
        ["uint8_t"] = "i64", ["uint16_t"] = "i64", ["uint32_t"] = "i64", ["uint64_t"] = "i64",
        ["size_t"] = "i64", ["float"] = "f64", ["double"] = "f64",
        ["long double"] = "f64", ["_Bool"] = "bool", ["bool"] = "bool", ["void"] = "void",
    }
    type_map[base] or "any"
end

c_ret_type_to_duo(c_type: str): str
    cleaned = string.gsub(c_type, "^%s+", "")
    cleaned = string.gsub(cleaned, "%s+$", "")
    if cleaned == "void" return "void" end
    if string.find(cleaned, "*") return "any" end
    c_type_to_duo(cleaned, false)
end

-- ═══════════════════════════════════════════════════════════════
-- Binding generation
-- ═══════════════════════════════════════════════════════════════

-- emit_ffi_binding: generate a Duo FFI binding string for a C function.
-- Returns the binding as a string (caller passes to @c.emit or uses directly).
emit_ffi_binding(func: any): str
    duo_params = {}
    for _, p in func.params
        duo_type = c_type_to_duo(p.c_type, p.is_pointer)
        duo_params[#duo_params + 1] = p.name .. ": " .. duo_type
    end
    duo_ret = c_ret_type_to_duo(func.ret_type)
    params_str = #duo_params > 0 and str_join(duo_params, ", ") or ""

    call_args = build_c_call_args(func.params)
    sig = "@ffi(\"" .. func.name .. "\")\nfun " .. string.lower(func.name) .. "(" .. params_str .. "): " .. duo_ret
    body = "    @c.call(\"" .. func.name .. "\"" .. (#func.params > 0 and ", " or "") .. call_args .. ")"
    sig .. "\n" .. body .. "\nend"
end

-- build_c_call_args: generate the argument list for @c.call
build_c_call_args(params: any): str
    args = {}
    for _, p in params
        args[#args + 1] = p.name
    end
    str_join(args, ", ")
end

-- ═══════════════════════════════════════════════════════════════
-- Convenience: generate bindings for common libraries
-- ═══════════════════════════════════════════════════════════════

bind_sqlite(): str
    from_header("sqlite3.h", {
        prefix = "sqlite3_",
        excludes = {"sqlite3_aggregate_context", "sqlite3_set_auxdata"},
    })
end

bind_cjson(): str
    from_header("cJSON.h", {})
end

bind_sdl2(): str
    from_header("SDL2/SDL.h", {
        prefix = "SDL_",
        excludes = {"SDL_main", "SDL_malloc", "SDL_calloc", "SDL_realloc", "SDL_free"},
    })
end

bind_opengl(): str
    from_header("GL/gl.h", {})
end

M = {
    from_header = from_header,
    from_source = from_source,
    parse_c_declarations = parse_c_declarations,
    parse_c_params = parse_c_params,
    c_type_to_duo = c_type_to_duo,
    c_ret_type_to_duo = c_ret_type_to_duo,
    emit_ffi_binding = emit_ffi_binding,
    bind_sqlite = bind_sqlite,
    bind_cjson = bind_cjson,
    bind_sdl2 = bind_sdl2,
    bind_opengl = bind_opengl,
    str_join = str_join,
}
M
