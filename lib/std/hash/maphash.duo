-- std.hash.maphash — Hash for tables/maps (mirrors Go's hash/maphash)
-- A non-cryptographic hash function suitable for use in hash tables.
-- Uses a seed-based FNV-like approach to resist hash-collision attacks.

make_seed(): i64
    bytes = std.crypto.rand.bytes(8)
    seed = 0
    i = 0
    while i < 8
        seed = (seed << 8) | string.byte(bytes, i + 1)
        i += 1
    end
    seed
end

new(): any
    {seed = make_seed(), hash = 0}
end

new_with_seed(seed: i64): any
    {seed = seed, hash = 0}
end

write(h: any, data: str): void
    h.hash = h.seed
    for i = 1, string.len(data)
        h.hash = (h.hash * 31 + string.byte(data, i))
    end
end

write_byte(h: any, b: i64): void
    h.hash = (h.hash * 31 + b)
end

sum(h: any): i64
    h.hash
end

hash_string(seed: i64, s: str): i64
    h = seed
    for i = 1, string.len(s)
        h = (h * 31 + string.byte(s, i))
    end
    h
end

hash_bytes(seed: i64, data: str, off: i64, len: i64): i64
    h = seed
    for i = off, off + len - 1
        h = (h * 31 + string.byte(data, i))
    end
    h
end

