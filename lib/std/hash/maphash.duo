-- std.hash.maphash — Hash for tables/maps (mirrors Go's hash/maphash)
-- A non-cryptographic hash function suitable for use in hash tables.
-- Uses a seed-based FNV-like approach to resist hash-collision attacks.

fun make_seed(): i64
    math.random(0, (2^32) - 1)
end

fun new(): any
    {seed = make_seed(), hash = 0}
end

fun new_with_seed(seed: i64): any
    {seed = seed, hash = 0}
end

fun write(h: any, data: str): void
    h.hash = h.seed
    for i = 1, string.len(data)
        h.hash = (h.hash * 31 + string.byte(data, i)) % (2^64)
    end
end

fun write_byte(h: any, b: i64): void
    h.hash = (h.hash * 31 + b) % (2^64)
end

fun sum(h: any): i64
    h.hash % (2^64)
end

fun hash_string(seed: i64, s: str): i64
    h = seed
    for i = 1, string.len(s)
        h = (h * 31 + string.byte(s, i)) % (2^64)
    end
    h
end

fun hash_bytes(seed: i64, data: str, off: i64, len: i64): i64
    h = seed
    for i = off, off + len - 1
        h = (h * 31 + string.byte(data, i)) % (2^64)
    end
    h
end

M = {}
M.make_seed = make_seed
M.new = new
M.new_with_seed = new_with_seed
M.write = write
M.write_byte = write_byte
M.sum = sum
M.hash_string = hash_string
M.hash_bytes = hash_bytes
M
