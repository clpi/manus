-- std.hash.sha512 — SHA-512 hash (mirrors Go's crypto/sha512)
-- Pure-Duo implementation using 32-bit word pairs to represent 64-bit values.

local string = req "std.string"

fun make_wide(hi: i64, lo: i64): any
    {hi = hi % (2^32), lo = lo % (2^32)}
end

fun wide_add(a: any, b: any): any
    lo = a.lo + b.lo
    hi = a.hi + b.hi
    if lo >= (2^32) then
        lo -= (2^32)
        hi += 1
    end
    hi = hi % (2^32)
    lo = lo % (2^32)
    {hi = hi, lo = lo}
end

fun wide_not(a: any): any
    {hi = (~a.hi) % (2^32), lo = (~a.lo) % (2^32)}
end

fun wide_and(a: any, b: any): any
    {hi = (a.hi & b.hi) % (2^32), lo = (a.lo & b.lo) % (2^32)}
end

fun wide_or(a: any, b: any): any
    {hi = (a.hi | b.hi) % (2^32), lo = (a.lo | b.lo) % (2^32)}
end

fun wide_xor(a: any, b: any): any
    {hi = (a.hi ~ b.hi) % (2^32), lo = (a.lo ~ b.lo) % (2^32)}
end

fun wide_shr(a: any, n: i64): any
    if n >= 32 then
        return {hi = 0, lo = a.hi >> (n - 32)}
    end
    new_hi = a.hi >> n
    new_lo = ((a.hi % (2^n)) * 2^(32 - n) + a.lo >> n) % (2^32)
    return {hi = new_hi, lo = new_lo}
end

fun wide_shl(a: any, n: i64): any
    if n >= 32 then
        return {hi = (a.lo << (n - 32)) % (2^32), lo = 0}
    end
    new_hi = ((a.hi << n) + (a.lo >> (32 - n))) % (2^32)
    new_lo = (a.lo << n) % (2^32)
    return {hi = new_hi, lo = new_lo}
end

fun wide_ror(a: any, n: i64): any
    wide_or(wide_shr(a, n), wide_shl(a, 64 - n))
end

fun wide_to_hex(a: any): str
    string.format("%08x%08x", a.hi, a.lo)
end

fun wide_from_bytes(data: str, off: i64): any
    hi = 0
    for k = 0, 3
        hi = (hi * 256 + string.byte(data, off + k)) % (2^32)
    end
    lo = 0
    for k = 0, 3
        lo = (lo * 256 + string.byte(data, off + 4 + k)) % (2^32)
    end
    {hi = hi, lo = lo}
end

K = {
    make_wide(0x428a2f98, 0xd728ae22), make_wide(0x71374491, 0x23ef65cd),
    make_wide(0xb5c0fbcf, 0xec4d3b2f), make_wide(0xe9b5dba5, 0x8189dbbc),
