-- std.hash.sha512 — SHA-512 hash (mirrors Go's crypto/sha512)
-- Pure-Duo implementation using 32-bit word pairs to represent 64-bit values.

make_wide(hi: i64, lo: i64): any
    {hi = hi % (4294967296), lo = lo % (4294967296)}
end

wide_add(a: any, b: any): any
    lo = a.lo + b.lo
    hi = a.hi + b.hi
    if lo >= (4294967296)
        lo -= (4294967296)
        hi += 1
    end
    {hi = hi % (4294967296), lo = lo % (4294967296)}
end

wide_not(a: any): any
    {hi = (~a.hi) % (4294967296), lo = (~a.lo) % (4294967296)}
end

wide_and(a: any, b: any): any
    {hi = (a.hi & b.hi) % (4294967296), lo = (a.lo & b.lo) % (4294967296)}
end

wide_or(a: any, b: any): any
    {hi = (a.hi | b.hi) % (4294967296), lo = (a.lo | b.lo) % (4294967296)}
end

wide_xor(a: any, b: any): any
    {hi = (a.hi ~ b.hi) % (4294967296), lo = (a.lo ~ b.lo) % (4294967296)}
end

wide_shr(a: any, n: i64): any
    if n >= 32
        return {hi = 0, lo = a.hi >> (n - 32)}
    end
    new_hi = a.hi >> n
    new_lo = ((a.hi % (1 << n)) * (1 << (32 - n)) + a.lo >> n) % (4294967296)
    return {hi = new_hi, lo = new_lo}
end

wide_shl(a: any, n: i64): any
    if n >= 32
        return {hi = (a.lo << (n - 32)) % (4294967296), lo = 0}
    end
    new_hi = ((a.hi << n) + (a.lo >> (32 - n))) % (4294967296)
    new_lo = (a.lo << n) % (4294967296)
    return {hi = new_hi, lo = new_lo}
end

wide_ror(a: any, n: i64): any
    wide_or(wide_shr(a, n), wide_shl(a, 64 - n))
end

wide_to_hex(a: any): str
    string.format("%08x%08x", a.hi, a.lo)
end

wide_from_bytes(data: str, off: i64): any
    hi = 0
    for k = 0, 3
        hi = (hi * 256 + string.byte(data, off + k)) % (4294967296)
    end
    lo = 0
    for k = 0, 3
        lo = (lo * 256 + string.byte(data, off + 4 + k)) % (4294967296)
    end
    {hi = hi, lo = lo}
end

K = {
    {hi = 0x428a2f98, lo = 0xd728ae22}, {hi = 0x71374491, lo = 0x23ef65cd},
    {hi = 0xb5c0fbcf, lo = 0xec4d3b2f}, {hi = 0xe9b5dba5, lo = 0x8189dbbc},
    {hi = 0x3956c25b, lo = 0xf348b538}, {hi = 0x59f111f1, lo = 0xb605d019},
    {hi = 0x923f82a4, lo = 0xaf194f9b}, {hi = 0xab1c5ed5, lo = 0xda6d8118},
    {hi = 0xd807aa98, lo = 0xa3030242}, {hi = 0x12835b01, lo = 0x45706fbe},
