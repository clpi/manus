H_init = {
    make_wide(0x6a09e667, 0xf3bcc908), make_wide(0xbb67ae85, 0x84caa73b),
    make_wide(0x3c6ef372, 0xfe94f82b), make_wide(0xa54ff53a, 0x5f1d36f1),
    make_wide(0x510e527f, 0xade682d1), make_wide(0x9b05688c, 0x2b3e6c1f),
    make_wide(0x1f83d9ab, 0xfb41bd6b), make_wide(0x5be0cd19, 0x137e2179)
}

fun hash_string(s: str): str
    if s == nil then s = "" end
    msg = s .. string.char(0x80)
    while string.len(msg) % 128 ~= 112
        msg = msg .. string.char(0)
    end
    bit_len = string.len(s) * 8
    for i = 1, 16
        msg = msg .. string.char((bit_len >> (16 - i) * 8) % 256)
    end
    H = {}
    for i = 1, 8
        H[i] = {hi = H_init[i].hi, lo = H_init[i].lo}
    end
    for block = 0, string.len(msg) / 128 - 1
        w = {}
        for j = 0, 15
            off = block * 128 + j * 8 + 1
            w[j + 1] = wide_from_bytes(msg, off)
        end
        for j = 16, 79
            s0 = wide_xor(wide_xor(wide_ror(w[j - 14 + 1], 1), wide_ror(w[j - 14 + 1], 8)), wide_shr(w[j - 14 + 1], 7))
            s1 = wide_xor(wide_xor(wide_ror(w[j - 2 + 1], 19), wide_ror(w[j - 2 + 1], 61)), wide_shr(w[j - 2 + 1], 6))
            w[j + 1] = wide_add(wide_add(wide_add(w[j - 16 + 1], s0), w[j - 7 + 1]), s1)
        end
        a = {hi = H[1].hi, lo = H[1].lo}
        b = {hi = H[2].hi, lo = H[2].lo}
        c = {hi = H[3].hi, lo = H[3].lo}
        d = {hi = H[4].hi, lo = H[4].lo}
        e = {hi = H[5].hi, lo = H[5].lo}
        f = {hi = H[6].hi, lo = H[6].lo}
        g = {hi = H[7].hi, lo = H[7].lo}
        hh = {hi = H[8].hi, lo = H[8].lo}
        for j = 0, 79
            S1 = wide_xor(wide_xor(wide_ror(e, 14), wide_ror(e, 18)), wide_ror(e, 41))
            ch = wide_xor(wide_and(e, f), wide_and(wide_not(e), g))
            temp1 = wide_add(wide_add(wide_add(wide_add(hh, S1), ch), K[j + 1]), w[j + 1])
            S0 = wide_xor(wide_xor(wide_ror(a, 28), wide_ror(a, 34)), wide_ror(a, 39))
            maj = wide_xor(wide_xor(wide_and(a, b), wide_and(a, c)), wide_and(b, c))
            temp2 = wide_add(S0, maj)
            hh = g
            g = f
            f = e
            e = wide_add(d, temp1)
            d = c
            c = b
            b = a
            a = wide_add(temp1, temp2)
        end
        H[1] = wide_add(H[1], a)
        H[2] = wide_add(H[2], b)
        H[3] = wide_add(H[3], c)
        H[4] = wide_add(H[4], d)
        H[5] = wide_add(H[5], e)
        H[6] = wide_add(H[6], f)
        H[7] = wide_add(H[7], g)
        H[8] = wide_add(H[8], hh)
    end
    string.format("%s%s%s%s%s%s%s%s", wide_to_hex(H[1]), wide_to_hex(H[2]), wide_to_hex(H[3]), wide_to_hex(H[4]),
                                       wide_to_hex(H[5]), wide_to_hex(H[6]), wide_to_hex(H[7]), wide_to_hex(H[8]))
end

M = {}
M.hash_string = hash_string
M.sha512 = hash_string
M
