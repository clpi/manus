-- std.maps — map (table) helper utilities (mirrors Go 1.21 maps package)

clone(m: any): any
    if m == nil return {} end
    out = {}
    for k, v in m
        out[k] = v
    end
    out
end

copy(dst: any, src: any): i64
    if dst == nil return 0 end
    if src == nil return 0 end
    count = 0
    for k, v in src
        dst[k] = v
        count += 1
    end
    count
end

delete(m: any, k: any): any
    if m == nil return nil end
    v = m[k]
    m[k] = nil
    v
end

equal(m1: any, m2: any): bool
    if m1 == nil and m2 == nil return true end
    if m1 == nil or m2 == nil return false end
    c1 = 0
    for _k, _v in m1 do c1 += 1 end
    c2 = 0
    for _k, _v in m2 do c2 += 1 end
    if c1 != c2 return false end
    for k, v in m1
        if m2[k] != v return false end
    end
    true
end

equal_func(m1: any, m2: any, eq: any): bool
    if m1 == nil and m2 == nil return true end
    if m1 == nil or m2 == nil return false end
    c1 = 0
    for _k, _v in m1 do c1 += 1 end
    c2 = 0
    for _k, _v in m2 do c2 += 1 end
    if c1 != c2 return false end
    for k, v in m1
        v2 = m2[k]
        if v2 == nil return false end
        if not eq(v, v2) return false end
    end
    true
end

keys(m: any): any
    if m == nil return {} end
    out = {}
    for k, _ in m do out[rawlen(out) + 1] = k end
    out
end

values(m: any): any
    if m == nil return {} end
    out = {}
    for _, v in m do out[rawlen(out) + 1] = v end
    out
end

entries(m: any): any
    if m == nil return {} end
    out = {}
    for k, v in m do out[rawlen(out) + 1] = {key = k, value = v} end
    out
end

has(m: any, k: any): bool
    if m == nil return false end
    m[k] != nil
end

get(m: any, k: any, dflt: any): any
    if m == nil return dflt end
    v = m[k]
    if v == nil return dflt end
    v
end

set(m: any, k: any, v: any): any
    if m == nil m = {} end
    m[k] = v
    m
end

size(m: any): i64
    if m == nil return 0 end
    c = 0
    for _k, _v in m do c += 1 end
    c
end

merge(dst: any, src: any): any
    if dst == nil dst = {} end
    if src == nil return dst end
    for k, v in src
        if dst[k] == nil dst[k] = v end
    end
    dst
end

merge_overwrite(dst: any, src: any): any
    if dst == nil dst = {} end
    if src == nil return dst end
    for k, v in src
        dst[k] = v
    end
    dst
end

