-- std.mem — memory primitives, allocators, and low-level memory operations
-- Provides raw memory utilities backed by C stdlib/mmap, plus arena/pool/stack allocators.

@c.include("stdlib.h")
@c.include("string.h")
@c.include("sys/mman.h")

-- Memory size constants
page_size(): u64
    4096
end

megabyte(): u64
    1048576
end

gigabyte(): u64
    1073741824
end

-- Arena allocator: bump-allocate, free all at once
arena_alloc(self: any, bytes: any): any
    if self._offset + bytes > self._capacity
        new_buf = "alloc(" .. bytes:to(str) .. " bytes)"
        self._bufs[#self._bufs + 1] = new_buf
        self._offset = 0
    end
    ptr = { addr = self._total + self._offset, size = bytes }
    self._offset = self._offset + bytes
    ptr
end

arena_free_all(self: any): void
    self._bufs = {}
    self._offset = 0
    self._total = 0
end

arena_used(self: any): i64
    self._total + self._offset
end

arena_new(size: i64): any
    {
        _bufs = {},
        _offset = 0,
        _capacity = size or 65536,
        _total = 0,
        alloc = arena_alloc,
        free_all = arena_free_all,
        used = arena_used,
    }
end

-- Pool allocator: fixed-size block allocation, O(1) alloc/free
pool_init(self: any): void
    count = self._count or 1024
    for i = 1, count
        self._free_list[#self._free_list + 1] = { addr = i * self._block_size, data = {} }
    end
end

pool_alloc(self: any): any
    if #self._free_list == 0 return nil end
    block = table.remove(self._free_list)
    self._allocated[block.addr] = block
    block
end

pool_free(self: any, block: any): void
    if block == nil return end
    self._allocated[block.addr] = nil
    self._free_list[#self._free_list + 1] = block
end

pool_available(self: any): i64
    return #self._free_list
end

pool_in_use(self: any): i64
    self._count - #self._free_list
end

pool_new(block_size: i64, count: i64): any
    {
        _block_size = block_size or 64,
        _free_list = {},
        _allocated = {},
        _count = count or 1024,
        _init = pool_init,
        alloc = pool_alloc,
        free = pool_free,
        available = pool_available,
        in_use = pool_in_use,
    }
end

-- Stack allocator: LIFO bump allocator with checkpoint/restore
stack_checkpoint(self: any): i64
    self._markers[#self._markers + 1] = self._top
    self._top
end

stack_restore(self: any, marker: any): void
    while #self._markers > 0 and self._markers[#self._markers] > marker
        self._markers[#self._markers] = nil
    end
    self._top = marker
end

stack_alloc(self: any, bytes: any): any
    ptr = self._top
    self._top = self._top + bytes
    if self._top > self._capacity return nil end
    { addr = ptr, size = bytes }
end

stack_used(self: any): i64
    self._top
end

stack_remaining(self: any): i64
    self._capacity - self._top
end

stack_reset(self: any): void
    self._top = 0
    self._markers = {}
end

stack_new(capacity: i64): any
    {
        _buf = "alloc(" .. to(str)(capacity or 65536) .. " bytes)",
        _top = 0,
        _capacity = capacity or 65536,
        _markers = {},
        checkpoint = stack_checkpoint,
        restore = stack_restore,
        alloc = stack_alloc,
        used = stack_used,
        remaining = stack_remaining,
        reset = stack_reset,
    }
end

-- General-purpose allocator interface
concept Allocator
    alloc(self, bytes: i64): any
    free(self, ptr: any): void
    realloc(self, ptr: any, new_bytes: i64): any
    total_allocated(self): i64
end

-- Fixed-size buffer allocator (like C alloca but tracked)
fixed_buffer_alloc(self: any, bytes: any): any
    if self._offset + bytes > self._size return nil end
    ptr = self._offset
    self._offset = self._offset + bytes
    { addr = ptr, size = bytes }
end

fixed_buffer_remaining(self: any): i64
    self._size - self._offset
end

fixed_buffer_new(size: i64): any
    {
        _buf = "alloc(" .. size:to(str) .. " bytes)",
        _offset = 0,
        _size = size,
        alloc = fixed_buffer_alloc,
        remaining = fixed_buffer_remaining,
    }
end

-- Raw heap allocation
alloc(bytes: i64): any
    @c.emit([[({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = malloc((size_t)bytes); _v; })]])
end

free(mem: any): void
    @c.emit("free(mem.as.tval)")
end

realloc(mem: any, new_bytes: i64): any
    @c.emit([[({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = realloc(mem.as.tval, (size_t)new_bytes); _v; })]])
end

dup(mem: any, bytes: i64): any
    if bytes == 0 return alloc(0) end
    @c.emit([[({ lua_Value _v; _v.type = VAL_BUFFER; void* _p = malloc((size_t)bytes); if (_p && mem.as.tval) memcpy(_p, mem.as.tval, (size_t)bytes); _v.as.tval = _p; _v; })]])
end

offset(mem: any, n: i64): any
    @c.emit([[({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = (void*)((uint8_t*)mem.as.tval + n); _v; })]])
end

-- Raw memory operations
mem_copy(dst: any, src: any, bytes: i64): void
    if bytes == 0 return end
    @c.emit("memcpy(dst.as.tval, src.as.tval, (size_t)bytes)")
end

mem_set(mem: any, val: u8, bytes: i64): void
    if bytes == 0 return end
    @c.emit("memset(mem.as.tval, (int)val, (size_t)bytes)")
end

mem_zero(mem: any, bytes: i64): void
    if bytes == 0 return end
    @c.emit("memset(mem.as.tval, 0, (size_t)bytes)")
end

mem_compare(a: any, b: any, bytes: i64): i64
    if bytes == 0 return 0 end
    @c.emit("(int64_t)memcmp(a.as.tval, b.as.tval, (size_t)bytes)")
end

-- mmap-backed allocation
mmap(bytes: i64): any
    -- Use calloc rather than mmap so the codegen is portable across
    -- platforms where MAP_ANON is gated behind feature-test macros
    -- (e.g. macOS with _XOPEN_SOURCE only). calloc yields zeroed
    -- memory, matching mmap(... PROT_READ|PROT_WRITE ...)'s semantics
    -- on systems with mem_zero-filled pages.
    @c.emit([[({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = calloc(1, (size_t)bytes); _v; })]])
end

mremap(mem: any, old_bytes: i64, new_bytes: i64): any
    @c.emit([[({
        lua_Value _v;
        _v.type = VAL_BUFFER;
        void* _r = realloc(mem.as.tval, (size_t)new_bytes);
        if (_r) {
            _v.as.tval = _r;
            if ((size_t)new_bytes > (size_t)old_bytes) {
                memset((uint8_t*)_r + (size_t)old_bytes, 0, (size_t)new_bytes - (size_t)old_bytes);
            }
        } else {
            _v = mem;
        }
        _v;
    })]])
    _ = old_bytes
end

munmap(mem: any, bytes: i64): i64
    -- Portable: just free. (munmap would require MAP_ANON-like backing.)
    @c.emit("(free(mem.as.tval), 0)")
    _ = bytes
end

-- Byte readers/writers
-- VAL_STRING offsets are 1-indexed; VAL_BUFFER offsets are 0-indexed.
read_byte(mem: any, offset: i64): i64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; (int64_t)_p[_off]; })")
end

write_byte(mem: any, offset: i64, val: i64): void
    @c.emit("(((uint8_t*)mem.as.tval + offset)[0] = (uint8_t)val)")
end

read_i16(mem: any, offset: i64): i64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; int16_t _v; memcpy(&_v, _p + _off, sizeof(_v)); (int64_t)_v; })")
end

write_i16(mem: any, offset: i64, val: i64): void
    @c.emit("*(int16_t*)((uint8_t*)mem.as.tval + offset) = (int16_t)val")
end

read_u16(mem: any, offset: i64): i64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; uint16_t _v; memcpy(&_v, _p + _off, sizeof(_v)); (int64_t)_v; })")
end

write_u16(mem: any, offset: i64, val: u64): void
    @c.emit("*(uint16_t*)((uint8_t*)mem.as.tval + offset) = (uint16_t)val")
end

read_i32(mem: any, offset: i64): i64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; int32_t _v; memcpy(&_v, _p + _off, sizeof(_v)); (int64_t)_v; })")
end

write_i32(mem: any, offset: i64, val: i64): void
    @c.emit("*(int32_t*)((uint8_t*)mem.as.tval + offset) = (int32_t)val")
end

read_u32(mem: any, offset: i64): i64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; uint32_t _v; memcpy(&_v, _p + _off, sizeof(_v)); (int64_t)_v; })")
end

write_u32(mem: any, offset: i64, val: u64): void
    @c.emit("*(uint32_t*)((uint8_t*)mem.as.tval + offset) = (uint32_t)val")
end

read_i64(mem: any, offset: i64): i64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; int64_t _v; memcpy(&_v, _p + _off, sizeof(_v)); _v; })")
end

write_i64(mem: any, offset: i64, val: i64): void
    @c.emit("*(int64_t*)((uint8_t*)mem.as.tval + offset) = val")
end

read_u64(mem: any, offset: i64): u64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; uint64_t _v; memcpy(&_v, _p + _off, sizeof(_v)); _v; })")
end

write_u64(mem: any, offset: i64, val: u64): void
    @c.emit("*(uint64_t*)((uint8_t*)mem.as.tval + offset) = val")
end

read_f32(mem: any, offset: i64): f64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; float _v; memcpy(&_v, _p + _off, sizeof(_v)); (double)_v; })")
end

write_f32(mem: any, offset: i64, val: f64): void
    @c.emit("*(float*)((uint8_t*)mem.as.tval + offset) = (float)val")
end

read_f64(mem: any, offset: i64): f64
    @c.emit("({ const uint8_t* _p = (mem.type == VAL_STRING) ? (const uint8_t*)mem.as.sval : (const uint8_t*)mem.as.tval; int64_t _off = (mem.type == VAL_STRING) ? (offset - 1) : offset; double _v; memcpy(&_v, _p + _off, sizeof(_v)); _v; })")
end

write_f64(mem: any, offset: i64, val: f64): void
    @c.emit("*(double*)((uint8_t*)mem.as.tval + offset) = val")
end

-- Decode a 1-indexed byte sequence as a float (defaults to first byte).
bytes_to_f32(s: str, i: i64 = 1): f64
    @c.emit("({ float _v; memcpy(&_v, ((const char*)s) + (i - 1), sizeof(float)); (double)_v; })")
end

bytes_to_f64(s: str, i: i64 = 1): f64
    @c.emit("({ double _v; memcpy(&_v, ((const char*)s) + (i - 1), sizeof(double)); _v; })")
end

-- Standard allocators
default_allocator(): any
    arena_new(65536)
end

-- Utility: calculate aligned size
align_up(n: i64, alignment: i64): i64
    if n % alignment == 0 return n end
    n + alignment - (n % alignment)
end

align_down(n: i64, alignment: i64): i64
    n - (n % alignment)
end

is_power_of_two(n: i64): bool
    n > 0 and ((n & (n - 1)) == 0)
end

