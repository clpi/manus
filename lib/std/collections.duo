-- std.collections — basic data structures over Duo tables

list_new(): any
    {}
end

list_push(list: any, value: any): void
    table.insert(list, value)
end

list_pop(list: any): any
    table.remove(list)
end

list_get(list: any, index: i64): any
    list[index]
end

list_len(list: any): i64
    return #list
end

stack_new(): any
    {}
end

stack_push(stack: any, value: any): void
    table.insert(stack, value)
end

stack_pop(stack: any): any
    table.remove(stack)
end

queue_new(): any
    {}
end

queue_enqueue(q: any, value: any): void
    table.insert(q, value)
end

queue_dequeue(q: any): any
    n = #q
    if n == 0
        nil
    end
    table.remove(q, 1)
end

map_new(): any
    {}
end

map_set(m: any, key: any, value: any): void
    m[key] = value
end

map_get(m: any, key: any): any
    m[key]
end

map_has(m: any, key: any): bool
    m[key] != nil
end

set_new(): any
    {}
end

set_add(s: any, value: any): void
    s[value] = true
end

set_has(s: any, value: any): bool
    s[value] != nil
end

is_array(t: any): bool
    if type(t) != "table" return false end
    if t[1] == nil return true end
    i = 2
    while t[i] != nil i += 1 end
    for k, _ in pairs(t)
        if type(k) != "number" return false end
        if k < 1 return false end
    end
    true
end

remove_at(list: any, index: i64): any
    table.remove(list, index)
end

list_insert(list: any, index: i64, value: any): void
    table.insert(list, index, value)
end

list_clear(list: any): void
    if list == nil return end
    i = #list
    while i > 0
        table.remove(list, i)
        i -= 1
    end
end

map_delete(m: any, key: any): void
    if m == nil return end
    m[key] = nil
end

map_keys(m: any): any
    out = {}
    if m == nil return out end
    for k, _ in pairs(m)
        table.insert(out, k)
    end
    out
end

map_values(m: any): any
    out = {}
    if m == nil return out end
    for _, v in pairs(m)
        table.insert(out, v)
    end
    out
end

set_remove(s: any, value: any): void
    if s == nil return end
    s[value] = nil
end

set_clear(s: any): void
    if s == nil return end
    for k, _ in pairs(s)
        s[k] = nil
    end
end

set_union(s1: any, s2: any): any
    out = {}
    if s1 != nil
        for k, _ in pairs(s1) out[k] = true end
    end
    if s2 != nil
        for k, _ in pairs(s2) out[k] = true end
    end
    out
end

set_intersection(s1: any, s2: any): any
    out = {}
    if s1 == nil or s2 == nil return out end
    for k, _ in pairs(s1)
        if s2[k] != nil out[k] = true end
    end
    out
end

set_difference(s1: any, s2: any): any
    out = {}
    if s1 == nil return out end
    for k, _ in pairs(s1)
        if s2 == nil or s2[k] == nil out[k] = true end
    end
    out
end

M = {}
M.list_new = list_new
M.list_push = list_push
M.list_pop = list_pop
M.list_get = list_get
M.list_len = list_len
M.list_insert = list_insert
M.list_clear = list_clear
M.stack_new = stack_new
M.stack_push = stack_push
M.stack_pop = stack_pop
M.queue_new = queue_new
M.queue_enqueue = queue_enqueue
M.queue_dequeue = queue_dequeue
M.map_new = map_new
M.map_set = map_set
M.map_get = map_get
M.map_has = map_has
M.map_delete = map_delete
M.map_keys = map_keys
M.map_values = map_values
M.set_new = set_new
M.set_add = set_add
M.set_has = set_has
M.set_remove = set_remove
M.set_clear = set_clear
M.set_union = set_union
M.set_intersection = set_intersection
M.set_difference = set_difference
M.is_array = is_array
M.remove_at = remove_at
M
