-- std.onnx — ONNX Runtime inference bindings via @ffi
-- Usage: duo compile myapp.duo --link onnxruntime
--       (and compile lib/c/onnx_shim.c, link it into the final binary)
--
-- The ONNX Runtime C API uses a function-pointer-table pattern
-- (OrtGetApiBase -> OrtApi struct with ~200 function pointers).
-- Duo's @ffi cannot dereference C structs, so a C shim (lib/c/onnx_shim.c)
-- provides flat wrapper functions.  This module binds those via @ffi.
--
-- API:
--   load(model_path)    -> session handle (opaque, use `any`)
--   run(session, inputs) -> outputs table  (inputs = {name = float_array})
--   close(session)     -> void
--   info(session)      -> {inputs = [...], outputs = [...]}
--   embedding(session, text) -> float array (convenience for sentence-transformers)
--
-- Build:
--   duo compile myapp.duo --link onnxruntime
--   cc -c lib/c/onnx_shim.c -o onnx_shim.o -I<onnxruntime include>
--   # then link onnx_shim.o into the final binary
-- Or:
--   duo compile myapp.duo --link onnxruntime --link lib/c/onnx_shim.c \
--     --cflags -I<onnxruntime include>

-- ===========================================================================
-- FFI declarations — bodyless, binding to C shim functions in onnx_shim.c
-- The `any` type maps to opaque C pointers (void*, OrtEnv*, OrtSession*, etc.)
-- ===========================================================================

-- duo_onnx_init(const char* model_path) -> void* (session handle)
@ffi("duo_onnx_init")
fun duo_onnx_init(model_path: str): any

-- duo_onnx_run(void* session, const char* input_name,
--              const float* input_data, size_t input_len,
--              const char* output_name,
--              float* output_data, size_t* output_len) -> int
@ffi("duo_onnx_run")
fun duo_onnx_run(session: any, input_name: str, input_data: any, input_len: int,
                 output_name: str, output_data: any, output_len: any): int

-- duo_onnx_close(void* session) -> void
@ffi("duo_onnx_close")
fun duo_onnx_close(session: any): void

-- duo_onnx_input_count(void* session) -> int
@ffi("duo_onnx_input_count")
fun duo_onnx_input_count(session: any): int

-- duo_onnx_output_count(void* session) -> int
@ffi("duo_onnx_output_count")
fun duo_onnx_output_count(session: any): int

-- duo_onnx_input_name(void* session, int idx, char* buf, int buf_len) -> int
@ffi("duo_onnx_input_name")
fun duo_onnx_input_name(session: any, idx: int, buf: str, buf_len: int): int

-- duo_onnx_output_name(void* session, int idx, char* buf, int buf_len) -> int
@ffi("duo_onnx_output_name")
fun duo_onnx_output_name(session: any, idx: int, buf: str, buf_len: int): int

-- duo_onnx_input_shape(void* session, int idx, int64_t* dims, int max_dims) -> int
@ffi("duo_onnx_input_shape")
fun duo_onnx_input_shape(session: any, idx: int, dims: any, max_dims: int): int

-- duo_onnx_output_shape(void* session, int idx, int64_t* dims, int max_dims) -> int
@ffi("duo_onnx_output_shape")
fun duo_onnx_output_shape(session: any, idx: int, dims: any, max_dims: int): int

-- ===========================================================================
-- Constants
-- ===========================================================================

local NAME_BUF_SIZE  = 256
local SHAPE_MAX_DIMS  = 8
local EMBEDDING_MAX_OUTPUT = 4096

-- ===========================================================================
-- Helpers
-- ===========================================================================

-- read_name: query input or output name at idx into a string buffer.
local function read_name(session: any, idx: int, is_input: bool): str
    local buf = string.rep(" ", NAME_BUF_SIZE)
    local rc
    if is_input then
        rc = duo_onnx_input_name(session, idx, buf, NAME_BUF_SIZE)
    else
        rc = duo_onnx_output_name(session, idx, buf, NAME_BUF_SIZE)
    end
    if rc < 0 then
        return ""
    end
    string.sub(buf, 1, rc)
end

-- read_shape: query input or output shape at idx into a duo array.
local function read_shape(session: any, idx: int, is_input: bool): any
    -- We use a table of 8 zero values as our int64_t buffer.
    local dims_buf = {0, 0, 0, 0, 0, 0, 0, 0}
    local rc
    if is_input then
        rc = duo_onnx_input_shape(session, idx, dims_buf, SHAPE_MAX_DIMS)
    else
        rc = duo_onnx_output_shape(session, idx, dims_buf, SHAPE_MAX_DIMS)
    end
    if rc < 0 then
        return {}
    end
    -- rc = number of dimensions
    local shape = {}
    local i = 1
    while i <= rc
        shape[i] = dims_buf[i]
        i = i + 1
    end
    shape
end

-- flatten_array: convert a nested duo table into a flat float array.
-- e.g. {{1.0, 2.0}, {3.0, 4.0}} -> {1.0, 2.0, 3.0, 4.0}
local function flatten_array(data: any): any
    if type(data) == "number" then
        return {data}
    end
    if type(data) ~= "table" then
        return {}
    end
    local out = {}
    local oi = 1

    local function flatten(t: any): void
        local n = rawlen(t)
        if n == 0 then return end
        local i = 1
        while i <= n
            local v = t[i]
            if type(v) == "table" then
                flatten(v)
            else
                out[oi] = v
                oi = oi + 1
            end
            i = i + 1
        end
    end

    flatten(data)

    -- Compute total element count
    local count = rawlen(out)
    {data = out, len = count}
end

-- ===========================================================================
-- Public API
-- ===========================================================================

-- load: load an ONNX model file and create a session.
-- Returns an opaque session handle, or nil on failure.
local function load(model_path: str): any
    local session = duo_onnx_init(model_path)
    if session == nil then
        return nil
    end
    {handle = session, closed = false, model_path = model_path}
end

-- close: release a session handle and free resources.
local function close(session: any): void
    if session == nil then return end
    if type(session) == "table" then
        if session.closed then return end
        session.closed = true
        if session.handle ~= nil then
            duo_onnx_close(session.handle)
        end
    else
        -- Assume raw pointer
        duo_onnx_close(session)
    end
end

-- run: run inference on the model.
-- inputs is a table of {input_name = float_array_or_nested_array}.
-- Returns a table of {output_name = float_array}.
-- For simplicity, runs the first input/output pair.
local function run(session: any, inputs: any): any
    local handle = session
    if type(session) == "table" then handle = session.handle end
    if handle == nil then return nil end

    -- Get input name (index 0)
    local input_name = read_name(handle, 0, true)
    if input_name == "" then return nil end

    -- Get output name (index 0)
    local output_name = read_name(handle, 0, false)
    if output_name == "" then return nil end

    -- Find the input data: either by name from inputs table, or the first value
    local input_data_raw = nil
    if inputs[input_name] ~= nil then
        input_data_raw = inputs[input_name]
    else
        -- Try first value in the table
        local k, v = next(inputs, nil)
        if v ~= nil then
            input_data_raw = v
        end
    end
    if input_data_raw == nil then return nil end

    -- Flatten the input data into a single float array
    local flat = flatten_array(input_data_raw)
    if flat.len == 0 then return nil end

    -- Determine output size from shape info
    local output_shape = read_shape(handle, 0, false)
    local output_size = 1
    local i = 1
    while i <= rawlen(output_shape)
        local d = output_shape[i]
        if d > 0 then
            output_size = output_size * d
        end
        i = i + 1
    end

    -- Allocate output buffer
    local output_data = {}
    local oi = 1
    while oi <= output_size
        output_data[oi] = 0.0
        oi = oi + 1
    end

    -- output_len is passed as a table cell (output parameter)
    local output_len_buf = {output_size}

    local rc = duo_onnx_run(handle, input_name, flat.data, flat.len,
                           output_name, output_data, output_len_buf)
    if rc ~= 0 then
        return nil
    end

    -- Trim output_data to actual length
    local actual_len = output_len_buf[1]
    if actual_len == nil then actual_len = output_size end

    local result_data = {}
    local ri = 1
    while ri <= actual_len
        result_data[ri] = output_data[ri]
        ri = ri + 1
    end

    local result = {}
    result[output_name] = result_data
    result
end

-- info: return model metadata (input/output names and shapes).
-- Returns: {inputs = {{name = str, shape = [int]}}, outputs = {...}}
local function info(session: any): any
    local handle = session
    if type(session) == "table" then handle = session.handle end
    if handle == nil then return nil end

    local result = {inputs = {}, outputs = {}}

    -- Query inputs
    local in_count = duo_onnx_input_count(handle)
    if in_count > 0 then
        local i = 0
        while i < in_count
            local name = read_name(handle, i, true)
            local shape = read_shape(handle, i, true)
            result.inputs[i + 1] = {name = name, shape = shape}
            i = i + 1
        end
    end

    -- Query outputs
    local out_count = duo_onnx_output_count(handle)
    if out_count > 0 then
        local i = 0
        while i < out_count
            local name = read_name(handle, i, false)
            local shape = read_shape(handle, i, false)
            result.outputs[i + 1] = {name = name, shape = shape}
            i = i + 1
        end
    end

    result
end

-- embedding: convenience function for sentence-transformer models.
-- Tokenizes text into character-level token IDs (simple wordpiece fallback),
-- runs inference, and returns the embedding vector as a flat float array.
--
-- NOTE: This uses a very basic tokenizer (character-level) suitable for
-- testing. For production use, you should pre-tokenize and pass the
-- token_ids array directly to run().
local function embedding(session: any, text: str): any
    local handle = session
    if type(session) == "table" then handle = session.handle end
    if handle == nil then return nil end

    -- Simple character-level tokenization: convert each byte to a float.
    -- Real tokenizers (WordPiece, BPE, etc.) should be implemented separately.
    local n = string.len(text)
    if n == 0 then
        return {}
    end

    local token_ids = {}
    local i = 1
    while i <= n
        token_ids[i] = tonumber(string.byte(text, i))
        i = i + 1
    end

    -- Build the input table with the input name
    local input_name = read_name(handle, 0, true)
    if input_name == "" then return nil end

    local inputs = {}
    inputs[input_name] = token_ids

    local result = run(session, inputs)
    if result == nil then return nil end

    -- Get the first output array
    local k, v = next(result, nil)
    if v == nil then return nil end
    v
end

-- ===========================================================================
-- Module export
-- ===========================================================================

M = {}
M.load = load
M.run = run
M.close = close
M.info = info
M.embedding = embedding
M