-- std.json — JSON encoder and decoder for Duo.
--
-- Pure Duo, no external module dependencies. Objects become tables with
-- string keys; arrays become tables with integer keys 1..n; null becomes nil;
-- booleans/numbers/strings map to the obvious Duo values.
--
-- `encode` is total (never errors): tables, arrays, scalars all round-trip.
-- `decode` is a recursive-descent parser tolerant of standard JSON (strings
-- with \uXXXX escapes, nested arrays/objects). Returns nil on malformed input.

-- ── encode ──────────────────────────────────────────────────────────────────

-- Sentinel that encodes as `{}` rather than `[]`. An empty Duo table is
-- indistinguishable from an empty sequence, so `{}` defaults to `[]` (see
-- `is_array`). Where the consumer requires a JSON *object* — JSON Schema
-- `properties`, MCP `capabilities` — pass `json.empty_object` instead.
-- Compared by table identity, so it must never be mutated by callers.
empty_object = {}

-- JSON arrays are tables whose every key is a positive integer. A table with
-- only string keys (an object) is not an array; an empty table is treated as
-- an empty array (matches Duo/Lua table usage where {} grows as a sequence).
is_array(t: any): bool
    if type(t) != "table" return false end
    for k, _ in t
        if type(k) != "number" return false end
        if k < 1 return false end
    end
    true
end

escape(s: any): str
    if s == nil return "" end
    out = {}
    n = #s
    i = 1
    hex = "0123456789abcdef"
    while i <= n
        b = s:byte(i)
        if b == 34
            out[rawlen(out) + 1] = "\\\""
        elseif b == 92
            out[rawlen(out) + 1] = "\\\\"
        elseif b == 10
            out[rawlen(out) + 1] = "\\n"
        elseif b == 13
            out[rawlen(out) + 1] = "\\r"
        elseif b == 9
            out[rawlen(out) + 1] = "\\t"
        elseif b == 8
            out[rawlen(out) + 1] = "\\b"
        elseif b == 12
            out[rawlen(out) + 1] = "\\f"
        elseif b < 32
            hi = math.floor(b / 16) + 1
            lo = (b % 16) + 1
            out[rawlen(out) + 1] = "\\u00" .. string.sub(hex, hi, hi) .. string.sub(hex, lo, lo)
        else
            out[rawlen(out) + 1] = string.sub(s, i, i)
        end
        i += 1
    end
    table.concat(out)
end

encode(val: any): str
    if val == nil return "null" end
    if type(val) == "boolean"
        if val return "true" else return "false" end
    end
    if type(val) == "number"
        if val != val return "null" end
        if val == math.huge return "1e999" end
        if val == -math.huge return "-1e999" end
        return to(str)(val)
    end
    if type(val) == "string"
        return "\"" .. escape(val) .. "\""
    end
    if type(val) == "table"
        if val == empty_object return "{}" end
        if is_array(val)
            parts = {}
            i = 1
            while val[i] != nil
                parts[rawlen(parts) + 1] = encode(val[i])
                i += 1
            end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        parts = {}
        for k, v in val
            if type(k) == "string"
                parts[rawlen(parts) + 1] = encode(k) .. ":" .. encode(v)
            end
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    "null"
end



-- ── decode ──────────────────────────────────────────────────────────────────
-- Recursive-descent over a {s=string, i=index} cursor table. Passes the cursor
-- explicitly to avoid nested-function codegen quirks.

json_skip_ws(cur: any)
    s = cur.s
    n = #s
    while cur.i <= n
        b = s:byte(cur.i)
        if b == 32 or b == 9 or b == 10 or b == 13
            cur.i = cur.i + 1
        else
            break
        end
    end
end

json_hex4(s): i64
    v = 0
    i = 1
    while i <= 4
        b = s:byte(i)
        d = 0
        if b >= 48 and b <= 57
            d = b - 48
        elseif b >= 65 and b <= 70
            d = b - 55
        elseif b >= 97 and b <= 102
            d = b - 87
        end
        v = v * 16 + d
        i += 1
    end
    v
end

json_utf8_char(cp): str
    if cp < 128
        return string.char(cp)
    end
    if cp < 2048
        b1 = math.floor(cp / 64) + 192
        b2 = (cp % 64) + 128
        return string.char(b1) .. string.char(b2)
    end
    b1 = math.floor(cp / 4096) + 224
    b2 = math.floor((cp % 4096) / 64) + 128
    b3 = (cp % 64) + 128
    return string.char(b1) .. string.char(b2) .. string.char(b3)
end

json_string(cur): any
    cur.i = cur.i + 1
    s = cur.s
    n = #s
    out = {}
    while cur.i <= n
        b = s:byte(cur.i)
        if b == 34
            cur.i = cur.i + 1
            return table.concat(out)
        end
        if b == 92
            cur.i = cur.i + 1
            e = s:byte(cur.i)
            if e == 110
                out[rawlen(out) + 1] = "\n"
            elseif e == 116
                out[rawlen(out) + 1] = "\t"
            elseif e == 114
                out[rawlen(out) + 1] = "\r"
            elseif e == 34
                out[rawlen(out) + 1] = "\""
            elseif e == 92
                out[rawlen(out) + 1] = "\\"
            elseif e == 47
                out[rawlen(out) + 1] = "/"
            elseif e == 98
                out[rawlen(out) + 1] = string.char(8)
            elseif e == 102
                out[rawlen(out) + 1] = string.char(12)
            elseif e == 117
                hex = string.sub(s, cur.i + 1, cur.i + 4)
                cp = json_hex4(hex)
                out[rawlen(out) + 1] = json_utf8_char(cp)
                cur.i = cur.i + 4
            else
                out[rawlen(out) + 1] = string.char(e)
            end
            cur.i = cur.i + 1
        else
            -- accumulate a run of plain chars up to the next quote/backslash
            -- (one chunk per run, not one char per byte — avoids the O(n*chars)
            -- concat cliff that made large decodes take >100s). Manual byte scan,
            -- no Lua patterns (immune to F-13813-5).
            start = cur.i
            cur.i = cur.i + 1
            while cur.i <= n
                b2 = s:byte(cur.i)
                if b2 == 34 or b2 == 92 break end
                cur.i = cur.i + 1
            end
            out[rawlen(out) + 1] = string.sub(s, start, cur.i - 1)
        end
    end
    table.concat(out)
end

json_number(cur): any
    s = cur.s
    start = cur.i
    n = #s
    while cur.i <= n
        b = s:byte(cur.i)
        if (b >= 48 and b <= 57) or b == 45 or b == 43 or b == 46 or b == 101 or b == 69
            cur.i = cur.i + 1
        else
            break
        end
    end
    num_str = string.sub(s, start, cur.i - 1)
    tonumber(num_str)
end

json_value(cur): any
    json_skip_ws(cur)
    s = cur.s
    if cur.i > #s return nil end
    b = s:byte(cur.i)
    if b == 123
        cur.i = cur.i + 1
        obj = {}
        json_skip_ws(cur)
        if cur.s:byte(cur.i) == 125
            cur.i = cur.i + 1
            return obj
        end
        while true
            json_skip_ws(cur)
            key = json_string(cur)
            json_skip_ws(cur)
            cur.i = cur.i + 1
            val = json_value(cur)
            obj[key] = val
            json_skip_ws(cur)
            b2 = cur.s:byte(cur.i)
            if b2 == 44
                cur.i = cur.i + 1
            elseif b2 == 125
                cur.i = cur.i + 1
                break
            else
                break
            end
        end
        return obj
    end
    if b == 91
        cur.i = cur.i + 1
        arr = {}
        arrn = 0
        json_skip_ws(cur)
        if cur.s:byte(cur.i) == 93
            cur.i = cur.i + 1
            return arr
        end
        while true
            val = json_value(cur)
            arrn = arrn + 1
            arr[arrn] = val
            json_skip_ws(cur)
            b2 = cur.s:byte(cur.i)
            if b2 == 44
                cur.i = cur.i + 1
            elseif b2 == 93
                cur.i = cur.i + 1
                break
            else
                break
            end
        end
        return arr
    end
    if b == 34
        return json_string(cur)
    end
    if b == 116
        cur.i = cur.i + 4
        return true
    end
    if b == 102
        cur.i = cur.i + 5
        return false
    end
    if b == 110
        cur.i = cur.i + 4
        return nil
    end
    json_number(cur)
end

decode(s: str): any
    if s == nil or s == "" return nil end
    cur = {}
    cur.s = s
    cur.i = 1
    json_skip_ws(cur)
    json_value(cur)
end

