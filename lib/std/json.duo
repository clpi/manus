col = req "std.collections"

fun encode(val: any): str
    if val == nil then return "null" end
    if type(val) == "boolean" then
        if val then return "true" else return "false" end
    end
    if type(val) == "number" then
        if val ~= val then return "null" end
        if val == math.huge then return "1.7976931348623157e+308" end
        if val == -math.huge then return "-1.7976931348623157e+308" end
        return tostring(val)
    end
    if type(val) == "string" then
        s = string.gsub(val, "\\", "\\\\")
        s = string.gsub(s, "\"", "\\\"")
        s = string.gsub(s, "\n", "\\n")
        s = string.gsub(s, "\t", "\\t")
        s = string.gsub(s, "\r", "\\r")
        return string.format("\"%s\"", s)
    end
    if type(val) == "table" then
        if col.is_array(val) then
            parts = {}
            for i = 1, #val
                table.insert(parts, encode(val[i]))
            end
            return "[" .. table.concat(parts, ",") .. "]"
        else
            parts = {}
            for k, v in pairs(val)
                if type(k) == "string" then
                    key_str = encode(k)
                    table.insert(parts, key_str .. ":" .. encode(v))
                end
            end
            return "{" .. table.concat(parts, ",") .. "}"
        end
    end
    "null"
end

fun has_key(val: any, key: str): bool
    if type(val) ~= "table" then return false end
    val[key] ~= nil
end

fun decode(s: str): any
    nil
end

fun pretty(val: any, indent: i64): str
    if indent == nil then indent = 2 end
    if type(indent) ~= "number" then indent = 2 end
    if val == nil then return "null" end
    if type(val) == "boolean" then
        if val then return "true" else return "false" end
    end
    if type(val) == "number" then
        return tostring(val)
    end
    if type(val) == "string" then
        return encode(val)
    end
    if type(val) == "table" then
        if col.is_array(val) then
            if #val == 0 then return "[]" end
            pad = string.rep(" ", indent)
            parts = {}
            for i = 1, #val
                table.insert(parts, pad .. pretty(val[i], indent))
            end
            return "[\n" .. table.concat(parts, ",\n") .. "\n]"
        else
            keys = {}
            for k, _ in pairs(val)
                if type(k) == "string" then
                    table.insert(keys, k)
                end
            end
            if #keys == 0 then return "{}" end
            pad = string.rep(" ", indent)
            parts = {}
            for _, k in ipairs(keys)
                table.insert(parts, pad .. encode(k) .. ": " .. pretty(val[k], indent))
            end
            return "{\n" .. table.concat(parts, ",\n") .. "\n}"
        end
    end
    "null"
end

M = {}
M.encode = encode
M.decode = decode
M.pretty = pretty
M
