-- std.index.suffixarray — suffix array for substring search (mirrors Go's index/suffixarray)
-- Builds a suffix array (sorted list of all suffixes) for efficient substring search.

build(data: str): any
    if data == nil return {data = "", sa = {}} end
    n = std.string.len(data)
    sa = {}
    for i = 1, n
        sa[i] = i
    end
    -- Sort suffixes using insertion sort (simple, adequate for small-medium data)
    for i = 1, n
        j = i
        while j > 1
            a = std.string.sub(data, sa[j - 1])
            b = std.string.sub(data, sa[j])
            if a <= b break end
            sa[j - 1], sa[j] = sa[j], sa[j - 1]
            j -= 1
        end
    end
    {data = data, sa = sa}
end

lookup(sa_obj: any, pattern: str): any
    data = sa_obj.data
    sa = sa_obj.sa
    n = std.string.len(data)
    plen = std.string.len(pattern)
    if plen == 0 or n == 0 return {} end
    results = {}
    -- Binary search for first occurrence
    lo = 1
    hi = n
    while lo <= hi
        mid = math.floor((lo + hi) / 2)
        suffix = std.string.sub(data, sa[mid])
        cmp = 0
        if std.string.len(suffix) < plen
            if suffix < pattern cmp = -1 else cmp = 1 end
        else
            prefix = std.string.sub(suffix, 1, plen)
            if prefix < pattern cmp = -1 elseif prefix > pattern cmp = 1 end
        end
        if cmp < 0
            lo = mid + 1
        else
            hi = mid - 1
        end
    end
    start = lo
    hi = n
    while lo <= hi
        mid = math.floor((lo + hi) / 2)
        suffix = std.string.sub(data, sa[mid])
        cmp = 0
        if std.string.len(suffix) < plen
            if suffix > pattern cmp = 1 else cmp = -1 end
        else
            prefix = std.string.sub(suffix, 1, plen)
            if prefix > pattern cmp = 1 elseif prefix < pattern cmp = -1 end
        end
        if cmp <= 0
            lo = mid + 1
        else
            hi = mid - 1
        end
    end
    end_pos = lo - 1
    for i = start, end_pos
        results[rawlen(results) + 1] = sa[i] - 1
    end
    results
end

find_all(sa_obj: any, pattern: str): any
    lookup(sa_obj, pattern)
end

contains(sa_obj: any, pattern: str): bool
    rawlen(lookup(sa_obj, pattern)) > 0
end

