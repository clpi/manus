-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Stats
M.stats_new = memory_stats_new
M.stats_record_alloc = memory_stats_record_alloc
M.stats_record_free = memory_stats_record_free
M.stats_record_gc = memory_stats_record_gc
M.stats_summary = memory_stats_summary
-- Arena
M.arena_new = memory_arena_new
M.arena_alloc = memory_arena_alloc
M.arena_reset = memory_arena_reset
M.arena_stats = memory_arena_stats
-- GC Config
M.gc_config_new = gc_config_new
M.gc_config_set_mode = gc_config_set_mode
M.gc_config_set_pause_target = gc_config_set_pause_target
M.gc_config_set_heap_limits = gc_config_set_heap_limits
M.gc_config_set_growth = gc_config_set_growth
-- GC State
M.gc_state_new = gc_state_new
M.gc_state_should_collect = gc_state_should_collect
M.gc_state_start_collection = gc_state_start_collection
M.gc_state_end_collection = gc_state_end_collection
M.gc_state_record_alloc = gc_state_record_alloc
M.gc_state_record_free = gc_state_record_free
M.gc_state_stats = gc_state_stats
-- Pressure
M.pressure_new = memory_pressure_new
M.pressure_update = memory_pressure_update
M.pressure_level = memory_pressure_level
M.pressure_should_gc = memory_pressure_should_gc
-- Object Pool
M.pool_new = object_pool_new
M.pool_acquire = object_pool_acquire
M.pool_release = object_pool_release
M.pool_stats = object_pool_stats
M
