-- std.fmt — formatting utilities

int(v: any): str
    if v == nil return "nil" end
    to(str)(v)
end

float(v: any, precision: i64): str
    if v == nil return "nil" end
    if precision == nil
        string.format("%g", v)
    end
    string.format("%." .. to(str)(precision) .. "f", v)
end

to_str(v: any): str
    if v == nil return "nil" end
    v
end

boolean(v: any): str
    if v == nil return "false" end
    -- A guard, not `if v "true" else "false" end`. The endless one-liner clause
    -- must be SELF-DELIMITED (Pass 48 2.4), and `v "true"` reads as PARENLESS
    -- APPLICATION -- it called `v("true")` and returned that. Because `v` is
    -- `any` the bogus call TYPE-CHECKS, so unlike strconv's `b: bool` version
    -- this compiled and shipped: boolean(true) returned "false".
    if v
        return "true"
    end
    "false"
end

hex(v: any): str
    if v == nil return "nil" end
    string.format("0x%X", v)
end

bin(v: any): str
    if v == nil return "nil" end
    digits = {}
    n = v
    if n == 0
        "0b0"
    end
    while n > 0
        table.insert(digits, 1, to(str)(n % 2))
        n = math.floor(n / 2)
    end
    "0b" .. table.concat(digits)
end

trim(s: str, chars: str): str
    if s == nil return "" end
    if chars == nil
        string["match"](s, "^%s*(.-)%s*$")
    end
    string["match"](s, "^[" .. chars .. "]*(.-)[" .. chars .. "]*$")
end

pad(s: str, width: i64, pad_char: str): str
    if s == nil s = "" end
    if pad_char == nil pad_char = " " end
    len = #s
    w = width
    if w == nil or w <= len return s end
    pad_str = string.rep(pad_char, w - len)
    s .. pad_str
end

trunc(s: str, width: i64): str
    if s == nil return "" end
    if width == nil return s end
    len = #s
    if len <= width return s end
    string.sub(s, 1, width)
end

format(fmt: str, args: any): str
    if fmt == nil return "" end
    if args == nil args = {} end
    out = ""
    i = 1
    arg_idx = 1
    while i <= #fmt
        if fmt:sub(i, i) == "{"
            j = fmt:find("}", i, true)
            if j
                spec = fmt:sub(i + 1, j - 1)
                v = args[arg_idx]
                if spec == ""
                    out = out .. to(str)(v)
                elseif string.sub(spec, 1, 2) == ":."
                    prec = tonumber(string.sub(spec, 3))
                    if prec and tonumber(v)
                        out = out .. string.format("%." .. to(str)(prec) .. "f", v)
                    else
                        out = out .. to(str)(v)
                    end
                else
                    out = out .. to(str)(v)
                end
                arg_idx = arg_idx + 1
                i = j + 1
            else
                out = out .. fmt:sub(i, i)
                i = i + 1
            end
        else
            out = out .. fmt:sub(i, i)
            i = i + 1
        end
    end
    out
end

println(fmt_str: str, ...args): void
    s = format(fmt_str, args)
    io.write(s)
    io.write("\n")
end

bytes(size: any): str
    if size == nil return "0 B" end
    if size < 1024
        return to(str)(size) .. " B"
    elseif size < 1024 * 1024
        return string.format("%.1f KB", size / 1024)
    elseif size < 1024 * 1024 * 1024
        return string.format("%.1f MB", size / (1024 * 1024))
    else
        return string.format("%.2f GB", size / (1024 * 1024 * 1024))
    end
end

join(parts: any, sep: str): str
    if parts == nil return "" end
    if sep == nil sep = ", " end
    strs = {}
    i = 1
    while i <= rawlen(parts)
        strs[rawlen(strs) + 1] = to(str)(parts[i])
        i += 1
    end
    table.concat(strs, sep)
end

repr(v: any): str
    if v == nil return "nil" end
    t = type(v)
    if t == "string"
        return "\"" .. string.gsub(v, "\"", "\\\"") .. "\""
    elseif t == "boolean"
        if v return "true" else return "false" end
    elseif t == "number"
        return to(str)(v)
    elseif t == "table"
        parts = {}
        n = rawlen(v)
        if n > 0
            i = 1
            while i <= n
                parts[rawlen(parts) + 1] = repr(v[i])
                i += 1
            end
            return "{" .. table.concat(parts, ", ") .. "}"
        else
            for k, val in v
                parts[rawlen(parts) + 1] = to(str)(k) .. "=" .. repr(val)
            end
            return "{" .. table.concat(parts, ", ") .. "}"
        end
    else
        return to(str)(v)
    end
end

