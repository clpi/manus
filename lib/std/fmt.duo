-- std.fmt — formatting utilities

fun std_fmt_int(v: any): str
    if v == nil then return "nil" end
    tostring(v)
end

fun std_fmt_float(v: any, precision: i64): str
    if v == nil then return "nil" end
    if precision == nil then
        string.format("%g", v)
    end
    string.format("%." .. tostring(precision) .. "f", v)
end

fun to_str(v: any): str
    if v == nil then return "nil" end
    v
end

fun boolean(v: any): str
    if v == nil then return "false" end
    if v then "true" else "false" end
end

fun hex(v: any): str
    if v == nil then return "nil" end
    string.format("0x%X", v)
end

fun bin(v: any): str
    if v == nil then return "nil" end
    digits = {}
    n = v
    if n == 0 then
        "0b0"
    end
    while n > 0
        table.insert(digits, 1, tostring(n % 2))
        n = math.floor(n / 2)
    end
    "0b" .. table.concat(digits)
end

fun trim(s: str, chars: str): str
    if s == nil then return "" end
    if chars == nil then
        string["match"](s, "^%s*(.-)%s*$")
    end
    string["match"](s, "^[" .. chars .. "]*(.-)[" .. chars .. "]*$")
end

fun pad(s: str, width: i64, pad_char: str): str
    if s == nil then s = "" end
    if pad_char == nil then pad_char = " " end
    len = string.len(s)
    w = width
    if w == nil or w <= len then return s end
    pad_str = string.rep(pad_char, w - len)
    s .. pad_str
end

fun std_fmt_trunc(s: str, width: i64): str
    if s == nil then return "" end
    if width == nil then return s end
    len = string.len(s)
    if len <= width then return s end
    string.sub(s, 1, width)
end

fun format(fmt: str, args: any): str
    if fmt == nil then return "" end
    if args == nil then args = {} end
    out = ""
    i = 1
    arg_idx = 1
    while i <= #fmt
        if fmt:sub(i, i) == "{" then
            j = fmt:find("}", i, true)
            if j then
                spec = fmt:sub(i + 1, j - 1)
                v = args[arg_idx]
                if spec == "" then
                    out = out .. tostring(v)
                elseif string.sub(spec, 1, 2) == ":." then
                    prec = tonumber(string.sub(spec, 3))
                    if prec and tonumber(v) then
                        out = out .. string.format("%." .. tostring(prec) .. "f", v)
                    else
                        out = out .. tostring(v)
                    end
                else
                    out = out .. tostring(v)
                end
                arg_idx = arg_idx + 1
                i = j + 1
            else
                out = out .. fmt:sub(i, i)
                i = i + 1
            end
        else
            out = out .. fmt:sub(i, i)
            i = i + 1
        end
    end
    out
end

fun println(fmt_str: str, ...args): void
    s = format(fmt_str, args)
    io.write(s)
    io.write("\n")
end

fun bytes(size: any): str
    if size == nil then return "0 B" end
    if size < 1024 then
        return tostring(size) .. " B"
    elseif size < 1024 * 1024 then
        return string.format("%.1f KB", size / 1024)
    elseif size < 1024 * 1024 * 1024 then
        return string.format("%.1f MB", size / (1024 * 1024))
    else
        return string.format("%.2f GB", size / (1024 * 1024 * 1024))
    end
end

fun join(parts: any, sep: str): str
    if parts == nil then return "" end
    if sep == nil then sep = ", " end
    local strs = {}
    i = 1
    while i <= rawlen(parts)
        strs[rawlen(strs) + 1] = tostring(parts[i])
        i += 1
    end
    table.concat(strs, sep)
end

fun repr(v: any): str
    if v == nil then return "nil" end
    local t = type(v)
    if t == "string" then
        return "\"" .. string.gsub(v, "\"", "\\\"") .. "\""
    elseif t == "boolean" then
        if v then return "true" else return "false" end
    elseif t == "number" then
        return tostring(v)
    elseif t == "table" then
        local parts = {}
        local n = rawlen(v)
        if n > 0 then
            i = 1
            while i <= n
                parts[rawlen(parts) + 1] = repr(v[i])
                i += 1
            end
            return "{" .. table.concat(parts, ", ") .. "}"
        else
            for k, val in pairs(v)
                parts[rawlen(parts) + 1] = tostring(k) .. "=" .. repr(val)
            end
            return "{" .. table.concat(parts, ", ") .. "}"
        end
    else
        return tostring(v)
    end
end

M = {}
M.int = std_fmt_int
M.float = std_fmt_float
M.to_str = to_str
M.boolean = boolean
M.hex = hex
M.bin = bin
M.trim = trim
M.pad = pad
M.trunc = std_fmt_trunc
M.format = format
M.println = println
M.bytes = bytes
M.join = join
M.repr = repr
M
