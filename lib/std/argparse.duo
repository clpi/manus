-- std.argparse — Command-line argument parser

fun parse(args: any): any
    if args == nil then args = arg or {} end
    parsed = { flags = {}, positionals = {} }
    
    i = 1
    while i <= #args
        v = args[i]
        if string.sub(v, 1, 2) == "--" then
            name = string.sub(v, 3)
            eq_pos = string.find(name, "=")
            if eq_pos then
                val = string.sub(name, eq_pos + 1)
                name = string.sub(name, 1, eq_pos - 1)
                parsed.flags[name] = val
            else
                if i + 1 <= #args and string.sub(args[i+1], 1, 1) ~= "-" then
                    parsed.flags[name] = args[i+1]
                    i = i + 1
                else
                    parsed.flags[name] = true
                end
            end
        elseif string.sub(v, 1, 1) == "-" then
            name = string.sub(v, 2)
            if i + 1 <= #args and string.sub(args[i+1], 1, 1) ~= "-" then
                parsed.flags[name] = args[i+1]
                i = i + 1
            else
                parsed.flags[name] = true
            end
        else
            table.insert(parsed.positionals, v)
        end
        i = i + 1
    end
    parsed
end

M = {}
M.parse = parse
M
