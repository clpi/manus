-- std.yaml — YAML parser with nested structure support

local string = req "std.string"
local table_mod = req "std.table"

fun parse_value(data: str, start: i64, indent: i64): any
    local i = start
    local len = string.len(data)
    while i <= len and (string.byte(data, i) == 32 or string.byte(data, i) == 9)
        i = i + 1
    end
    local current_indent = i - start
    if current_indent < indent then
        return nil, i, nil
    end
    local line_start = i
    while i <= len and string.byte(data, i) ~= 10 and string.byte(data, i) ~= 13
        i = i + 1
    end
    local line = string.sub(data, line_start, i - 1)
    if string.byte(data, i) == 10 then i = i + 1 end
    if string.byte(data, i) == 13 then i = i + 1 end
    if string.sub(line, 1, 1) == "#" or string.sub(line, 1, 3) == "---" then
        return parse_value(data, i, indent)
    end
    if string.len(line) == 0 then
        return parse_value(data, i, indent)
    end
    local colon_pos = nil
    for j = 1, string.len(line)
        if string.byte(line, j) == 58 then
            local after = string.sub(line, j + 1)
            if string.sub(after, 1, 1) == " " or string.len(after) == 0 then
                colon_pos = j
                break
            end
        end
    end
    if colon_pos ~= nil then
        local key = string.trim(string.sub(line, 1, colon_pos - 1))
        local val_str = string.trim(string.sub(line, colon_pos + 1))
        if string.len(val_str) == 0 then
            -- Nested mapping: parse children at deeper indent
            local nested = {}
            while true
                local nv, ni, ns = parse_value(data, i, current_indent + 1)
                if nv == nil and ns == nil then
                    break
                end
                local nkey, nval
                if type(nv) == "table" and nv._key ~= nil then
                    nkey = nv._key
                    nval = nv._value
                else
                    nkey = nv
                    nval = ns
                end
                nested[nkey] = nval
                i = ni
            end
            return {_key = key, _value = nested}, i, nested
        else
            local val = val_str
            if string.len(val_str) >= 2 and ((string.sub(val_str, 1, 1) == '"' and string.sub(val_str, string.len(val_str), string.len(val_str)) == '"') or
                                             (string.sub(val_str, 1, 1) == "'" and string.sub(val_str, string.len(val_str), string.len(val_str)) == "'")) then
                val = string.sub(val_str, 2, string.len(val_str) - 1)
            elseif val_str == "true" then
                val = true
            elseif val_str == "false" then
                val = false
            elseif val_str == "null" or val_str == "~" then
                val = nil
            else
                local num = tonumber(val_str)
                if num ~= nil then
                    val = num
                end
            end
            return {_key = key, _value = val}, i, val
        end
    else
        -- List item or scalar
        if string.sub(line, 1, 2) == "- " or string.sub(line, 1, 2) == "-" then
            local item_val = string.trim(string.sub(line, 2))
            if string.len(item_val) == 0 then
                item_val = nil
            end
            if item_val ~= nil and string.len(item_val) >= 2 and string.sub(item_val, 1, 1) == '"' and string.sub(item_val, string.len(item_val), string.len(item_val)) == '"' then
                item_val = string.sub(item_val, 2, string.len(item_val) - 1)
            end
            return item_val, i, nil
        else
            local val = line
            if string.len(val) >= 2 and ((string.sub(val, 1, 1) == '"' and string.sub(val, string.len(val), string.len(val)) == '"') or
                                         (string.sub(val, 1, 1) == "'" and string.sub(val, string.len(val), string.len(val)) == "'")) then
                val = string.sub(val, 2, string.len(val) - 1)
            end
            local num = tonumber(val)
            if num ~= nil then val = num end
            return val, i, nil
        end
    end
end

fun parse(data: str): any
    if data == nil then return nil end
    local res = {}
    local i = 1
    while i <= string.len(data)
        local kv, ni, val = parse_value(data, i, 0)
        if kv == nil then
            if val == nil then break end
            -- List item at root
            res[rawlen(res) + 1] = kv
            i = ni
        else
            if type(kv) == "table" and kv._key ~= nil then
                res[kv._key] = kv._value
            end
            i = ni
        end
    end
    res
end

M = {}
M.parse = parse
M
