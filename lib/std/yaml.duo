-- std.yaml — YAML parser with nested structure support

string = req "std.string"
table_mod = req "std.table"

parse_value(data: str, start: i64, indent: i64): any
    i = start
    len = string.len(data)
    while i <= len and (string.byte(data, i) == 32 or string.byte(data, i) == 9)
        i += 1
    end
    current_indent = i - start
    if current_indent < indent
        return nil, i, nil
    end
    line_start = i
    while i <= len and string.byte(data, i) != 10 and string.byte(data, i) != 13
        i += 1
    end
    line = string.sub(data, line_start, i - 1)
    if string.byte(data, i) == 10 i += 1 end
    if string.byte(data, i) == 13 i += 1 end
    if string.sub(line, 1, 1) == "#" or string.sub(line, 1, 3) == "---"
        return parse_value(data, i, indent)
    end
    if string.len(line) == 0
        return parse_value(data, i, indent)
    end
    colon_pos = nil
    for j = 1, string.len(line)
        if string.byte(line, j) == 58
            after = string.sub(line, j + 1)
            if string.sub(after, 1, 1) == " " or string.len(after) == 0
                colon_pos = j
                break
            end
        end
    end
    if colon_pos != nil
        key = string.trim(string.sub(line, 1, colon_pos - 1))
        val_str = string.trim(string.sub(line, colon_pos + 1))
        if string.len(val_str) == 0
            -- Nested mapping: parse children at deeper indent
            nested = {}
            while true
                nv, ni, ns = parse_value(data, i, current_indent + 1)
                if nv == nil and ns == nil
                    break
                end
                nkey, nval
                if type(nv) == "table" and nv._key != nil
                    nkey = nv._key
                    nval = nv._value
                else
                    nkey = nv
                    nval = ns
                end
                nested[nkey] = nval
                i = ni
            end
            return {_key = key, _value = nested}, i, nested
        else
            val = val_str
            if string.len(val_str) >= 2 and ((string.sub(val_str, 1, 1) == '"' and string.sub(val_str, string.len(val_str), string.len(val_str)) == '"') or
                                             (string.sub(val_str, 1, 1) == "'" and string.sub(val_str, string.len(val_str), string.len(val_str)) == "'"))
                val = string.sub(val_str, 2, string.len(val_str) - 1)
            elseif val_str == "true"
                val = true
            elseif val_str == "false"
                val = false
            elseif val_str == "null" or val_str == "~"
                val = nil
            else
                num = tonumber(val_str)
                if num != nil
                    val = num
                end
            end
            return {_key = key, _value = val}, i, val
        end
    else
        -- List item or scalar
        if string.sub(line, 1, 2) == "- " or string.sub(line, 1, 2) == "-"
            item_val = string.trim(string.sub(line, 2))
            if string.len(item_val) == 0
                item_val = nil
            end
            if item_val != nil and string.len(item_val) >= 2 and string.sub(item_val, 1, 1) == '"' and string.sub(item_val, string.len(item_val), string.len(item_val)) == '"'
                item_val = string.sub(item_val, 2, string.len(item_val) - 1)
            end
            return item_val, i, nil
        else
            val = line
            if string.len(val) >= 2 and ((string.sub(val, 1, 1) == '"' and string.sub(val, string.len(val), string.len(val)) == '"') or
                                         (string.sub(val, 1, 1) == "'" and string.sub(val, string.len(val), string.len(val)) == "'"))
                val = string.sub(val, 2, string.len(val) - 1)
            end
            num = tonumber(val)
            if num != nil val = num end
            return val, i, nil
        end
    end
end

parse(data: str): any
    if data == nil return nil end
    res = {}
    i = 1
    while i <= string.len(data)
        kv, ni, val = parse_value(data, i, 0)
        if kv == nil
            if val == nil break end
            -- List item at root
            res[rawlen(res) + 1] = kv
            i = ni
        else
            if type(kv) == "table" and kv._key != nil
                res[kv._key] = kv._value
            end
            i = ni
        end
    end
    res
end

M = {}
M.parse = parse
M
