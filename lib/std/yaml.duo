-- std.yaml — basic YAML parsing stub

local string = import("std.string")
local table_mod = import("std.table")

fun parse(data: str): any
    -- Very basic stub for YAML parsing
    -- Only handles flat key: value for now
    local lines = string.split(data, "\n")
    local res = {}
    for _, line in ipairs(lines)
        line = string.trim(line)
        if string.len(line) > 0 and string.sub(line, 1, 1) ~= "#" and string.sub(line, 1, 3) ~= "---" then
            local parts = string.split(line, ":")
            if table_mod.len(parts) >= 2 then
                local key = string.trim(parts[1])
                local val = string.trim(parts[2])
                
                -- Handle basic string quoting
                if string.len(val) >= 2 and ((string.sub(val, 1, 1) == '"' and string.sub(val, string.len(val), string.len(val)) == '"') or
                                             (string.sub(val, 1, 1) == "'" and string.sub(val, string.len(val), string.len(val)) == "'")) then
                    val = string.sub(val, 2, string.len(val) - 1)
                end
                
                res[key] = val
            end
        end
    end
    res
end

M = {}
M.parse = parse
M
