fun start(msg: str): void
    io.write(string.format("=== %s ===\n", msg))
end

fun assert_eq(actual: any, expected: any, msg: str): void
    if actual == expected then
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected %s, got %s)\n", msg or "", tostring(expected), tostring(actual)))
    end
end

fun assert_ne(actual: any, not_expected: any, msg: str): void
    if actual ~= not_expected then
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected not %s)\n", msg or "", tostring(not_expected)))
    end
end

fun assert_true(val: any, msg: str): void
    if val == true then
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s\n", msg or ""))
    end
end

fun assert_false(val: any, msg: str): void
    if val == false then
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s\n", msg or ""))
    end
end

fun assert_nil(val: any, msg: str): void
    if val == nil then
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected nil, got %s)\n", msg or "", tostring(val)))
    end
end

fun assert_not_nil(val: any, msg: str): void
    if val ~= nil then
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected not nil)\n", msg or ""))
    end
end

fun done(): void
    io.write("=== tests done ===\n")
end

-- Supported @test.* / @bench / @time attributes (see also std.bench.attrs).
attrs = {
    test = { "test", "test.unit", "test.integration", "test.e2e", "test.skip", "test.only", "test.flaky", "test.should_panic", "test.bench", "test.time" },
    args = { "name", "tag", "message", "timeout", "timeout_ms", "iterations", "warmup" },
    cli = { "duo test <file.duo>", "duo bench <file.duo>", "duo test <file> --filter <pat>" },
}

M = {}
M.start = start
M.assert_eq = assert_eq
M.assert_ne = assert_ne
M.assert_true = assert_true
M.assert_false = assert_false
M.assert_nil = assert_nil
M.assert_not_nil = assert_not_nil
M.done = done
M.attrs = attrs
M
