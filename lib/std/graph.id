# std.graph — Graph data structure and algorithms
# Adjacency-list representation with BFS, DFS, topological sort,
# shortest path, cycle detection, and strongly connected components.
# Critical for: ML computation graphs, build systems, dependency
# resolution, network routing, and workflow orchestration.

# DFS visit colours. File scope: dfs_topo_visit reads them but does not
# declare them, and a sibling function's locals are not in scope there.
WHITE = 0
GRAY = 1
BLACK = 2

# new: create an empty directed graph.
new(): any
    {adj = {}, nodes = {}, in_degree = {}}
end

# add_node: add a node with optional value.
add_node(g: any, id: any, val: any): void
    if g.adj[id] == nil
        g.adj[id] = {}
        g.in_degree[id] = 0
    end
    g.nodes[id] = val
end

# add_edge: add a directed edge from -> to with optional weight.
add_edge(g: any, from: any, to: any, weight: any): void
    if g.adj[from] == nil add_node(g, from, nil) end
    if g.adj[to] == nil add_node(g, to, nil) end
    g.adj[from][g.adj[from]:len() + 1] = {to = to, weight = weight or 1}
    g.in_degree[to] = (g.in_degree[to] or 0) + 1
end

# remove_node: remove a node and all its edges.
remove_node(g: any, id: any): void
    if g.adj[id] == nil return end
    g.adj[id] = nil
    g.nodes[id] = nil
    g.in_degree[id] = nil
    for n, _ in g.adj
        new_edges = {}
        i = 1
        while i <= g.adj[n]:len()
            if g.adj[n][i].to != id
                new_edges[new_edges:len() + 1] = g.adj[n][i]
            end
            i += 1
        end
        g.adj[n] = new_edges
    end
end

# neighbors: return the list of outgoing neighbors.
neighbors(g: any, id: any): any
    if g.adj[id] == nil return {} end
    out = {}
    i = 1
    while i <= g.adj[id]:len()
        out[out:len() + 1] = g.adj[id][i].to
        i += 1
    end
    out
end

# nodes_: return all node IDs.
nodes_(g: any): any
    out = {}
    for k, _ in g.nodes
        out[out:len() + 1] = k
    end
    out
end

# node_count: return the number of nodes.
node_count(g: any): i64
    n = 0
    for _ in g.nodes do n += 1 end
    n
end

# edge_count: return the number of edges.
edge_count(g: any): i64
    n = 0
    for _, edges in g.adj
        n += edges:len()
    end
    n
end

# has_node: check if a node exists.
has_node(g: any, id: any): bool
    g.nodes[id] != nil
end

# has_edge: check if an edge from -> to exists.
has_edge(g: any, from: any, to: any): bool
    if g.adj[from] == nil return false end
    i = 1
    while i <= g.adj[from]:len()
        if g.adj[from][i].to == to return true end
        i += 1
    end
    false
end

# get_weight: return the weight of edge from -> to, or nil.
get_weight(g: any, from: any, to: any): any
    if g.adj[from] == nil return nil end
    i = 1
    while i <= g.adj[from]:len()
        if g.adj[from][i].to == to return g.adj[from][i].weight end
        i += 1
    end
    nil
end

# ═══════════════════════════════════════════════════════════════
# BFS: breadth-first traversal
# ═══════════════════════════════════════════════════════════════

bfs(g: any, start: any, visit: any): void
    visited = {}
    queue = {start}
    visited[start] = true
    while queue:len() > 0
        id = queue:remove(1)
        visit(id, g.nodes[id])
        i = 1
        while i <= g.adj[id] or {}:len()
            nb = g.adj[id][i].to
            if not visited[nb]
                visited[nb] = true
                queue[queue:len() + 1] = nb
            end
            i += 1
        end
    end
end

# bfs_shortest_path: return the shortest path (fewest edges) from start to goal.
bfs_shortest_path(g: any, start: any, goal: any): any
    if start == goal return {start} end
    visited = {}
    prev = {}
    queue = {start}
    visited[start] = true
    while queue:len() > 0
        id = queue:remove(1)
        i = 1
        while i <= g.adj[id] or {}:len()
            nb = g.adj[id][i].to
            if not visited[nb]
                visited[nb] = true
                prev[nb] = id
                if nb == goal
                    path = {}
                    cur = nb
                    while cur != nil
                        path[path:len() + 1] = cur
                        cur = prev[cur]
                    end
                    out = {}
                    j = path:len()
                    while j >= 1
                        out[out:len() + 1] = path[j]
                        j -= 1
                    end
                    return out
                end
                queue[queue:len() + 1] = nb
            end
            i += 1
        end
    end
    nil
end

# ═══════════════════════════════════════════════════════════════
# DFS: depth-first traversal
# ═══════════════════════════════════════════════════════════════

dfs(g: any, start: any, visit: any): void
    visited = {}
    stack = {start}
    while stack:len() > 0
        id = stack:remove()
        if not visited[id]
            visited[id] = true
            visit(id, g.nodes[id])
            i = g.adj[id] or {}:len()
            while i >= 1
                nb = g.adj[id][i].to
                if not visited[nb]
                    stack[stack:len() + 1] = nb
                end
                i -= 1
            end
        end
    end
end

# dfs_topological: DFS-based topological sort (returns nil if cycle exists).
dfs_topological(g: any): any
    color = {}
    order = {}
    for n, _ in g.nodes
        color[n] = WHITE
    end
    for n, _ in g.nodes
        if color[n] == WHITE
            if not dfs_topo_visit(g, n, color, order) return nil end
        end
    end
    out = {}
    i = order:len()
    while i >= 1
        out[out:len() + 1] = order[i]
        i -= 1
    end
    out
end

dfs_topo_visit(g: any, id: any, color: any, order: any): bool
    color[id] = GRAY
    i = 1
    while i <= g.adj[id] or {}:len()
        nb = g.adj[id][i].to
        if color[nb] == GRAY return false end
        if color[nb] == WHITE
            if not dfs_topo_visit(g, nb, color, order) return false end
        end
        i += 1
    end
    color[id] = BLACK
    order[order:len() + 1] = id
    true
end

# ═══════════════════════════════════════════════════════════════
# Kahn's topological sort (BFS-based)
# ═══════════════════════════════════════════════════════════════

topological_sort(g: any): any
    in_deg = {}
    for n, _ in g.nodes
        in_deg[n] = 0
    end
    for n, _ in g.adj
        i = 1
        while i <= g.adj[n]:len()
            in_deg[g.adj[n][i].to] = (in_deg[g.adj[n][i].to] or 0) + 1
            i += 1
        end
    end
    queue = {}
    for n, d in in_deg
        if d == 0 queue[queue:len() + 1] = n end
    end
    order = {}
    while queue:len() > 0
        id = queue:remove(1)
        order[order:len() + 1] = id
        i = 1
        while i <= g.adj[id] or {}:len()
            nb = g.adj[id][i].to
            in_deg[nb] -= 1
            if in_deg[nb] == 0
                queue[queue:len() + 1] = nb
            end
            i += 1
        end
    end
    if order:len() != node_count(g) return nil end
    order
end

# ═══════════════════════════════════════════════════════════════
# Cycle detection
# ═══════════════════════════════════════════════════════════════

has_cycle(g: any): bool
    color = {}
    for n, _ in g.nodes
        color[n] = WHITE
    end
    for n, _ in g.nodes
        if color[n] == WHITE
            if cycle_dfs(g, n, color) return true end
        end
    end
    false
end

cycle_dfs(g: any, id: any, color: any): bool
    color[id] = GRAY
    i = 1
    while i <= g.adj[id] or {}:len()
        nb = g.adj[id][i].to
        if color[nb] == GRAY return true end
        if color[nb] == WHITE
            if cycle_dfs(g, nb, color) return true end
        end
        i += 1
    end
    color[id] = BLACK
    false
end

# ═══════════════════════════════════════════════════════════════
# Dijkstra: shortest weighted path
# ═══════════════════════════════════════════════════════════════

dijkstra(g: any, start: any): any
    dist = {}
    prev = {}
    visited = {}
    for n, _ in g.nodes
        dist[n] = 1e308
    end
    dist[start] = 0
    pq = {{id = start, d = 0}}
    while pq:len() > 0
        min_idx = 1
        i = 2
        while i <= pq:len()
            if pq[i].d < pq[min_idx].d min_idx = i end
            i += 1
        end
        cur = pq:remove(min_idx)
        if not visited[cur.id]
            visited[cur.id] = true
            i = 1
            while i <= g.adj[cur.id] or {}:len()
                edge = g.adj[cur.id][i]
                new_dist = dist[cur.id] + edge.weight
                if new_dist < dist[edge.to]
                    dist[edge.to] = new_dist
                    prev[edge.to] = cur.id
                    pq[pq:len() + 1] = {id = edge.to, d = new_dist}
                end
                i += 1
            end
        end
    end
    {dist = dist, prev = prev}
end

# dijkstra_path: reconstruct path from dijkstra result.
dijkstra_path(result: any, goal: any): any
    if result.dist[goal] >= 1e308 return nil end
    path = {}
    cur = goal
    while cur != nil
        path[path:len() + 1] = cur
        cur = result.prev[cur]
    end
    out = {}
    i = path:len()
    while i >= 1
        out[out:len() + 1] = path[i]
        i -= 1
    end
    out
end

# ═══════════════════════════════════════════════════════════════
# Connected components (undirected)
# ═══════════════════════════════════════════════════════════════

connected_components(g: any): any
    visited = {}
    components = {}
    for n, _ in g.nodes
        visited[n] = false
    end
    for n, _ in g.nodes
        if not visited[n]
            comp = {}
            stack = {n}
            while stack:len() > 0
                id = stack:remove()
                if not visited[id]
                    visited[id] = true
                    comp[comp:len() + 1] = id
                    i = 1
                    while i <= g.adj[id] or {}:len()
                        nb = g.adj[id][i].to
                        if not visited[nb]
                            stack[stack:len() + 1] = nb
                        end
                        i += 1
                    end
                end
            end
            components[components:len() + 1] = comp
        end
    end
    components
end

# indegree: return in-degree of a node.
indegree(g: any, id: any): i64
    g.in_degree[id] or 0
end

# outdegree: return out-degree of a node.
outdegree(g: any, id: any): i64
    g.adj[id] or {}:len()
end

# transpose: return the transpose (reverse all edges).
transpose(g: any): any
    g2 = new()
    for n, v in g.nodes
        add_node(g2, n, v)
    end
    for n, _ in g.adj
        i = 1
        while i <= g.adj[n]:len()
            e = g.adj[n][i]
            add_edge(g2, e.to, n, e.weight)
            i += 1
        end
    end
    g2
end

# subgraph: return the induced subgraph on the given node set.
subgraph(g: any, node_ids: any): any
    g2 = new()
    set = {}
    i = 1
    while i <= node_ids:len()
        set[node_ids[i]] = true
        if g.nodes[node_ids[i]] != nil
            add_node(g2, node_ids[i], g.nodes[node_ids[i]])
        end
        i += 1
    end
    for n, _ in g.nodes
        if set[n]
            i = 1
            while i <= g.adj[n] or {}:len()
                e = g.adj[n][i]
                if set[e.to]
                    add_edge(g2, n, e.to, e.weight)
                end
                i += 1
            end
        end
    end
    g2
end
