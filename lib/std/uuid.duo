-- std.uuid — UUID generation utilities
-- Uses CSPRNG for unpredictable UUIDs

crypto_rand = req "std.crypto.rand"

fun v4(): str
    -- UUIDv4 using cryptographic random bytes
    bytes = crypto_rand.bytes(16)
    
    -- Format as UUID string: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
    -- Version 4 (bits 12-15 of time_hi_and_version = 0100)
    -- Variant 1 (bits 6-7 of clock_seq_hi_and_reserved = 10)
    hex = function(b: i64): str
        string.format("%02x", b)
    end
    
    result = ""
    -- Bytes 0-3 (time_low)
    result = result .. hex(string.byte(bytes, 1))
    result = result .. hex(string.byte(bytes, 2))
    result = result .. hex(string.byte(bytes, 3))
    result = result .. hex(string.byte(bytes, 4))
    result = result .. "-"
    -- Bytes 4-5 (time_mid)
    result = result .. hex(string.byte(bytes, 5))
    result = result .. hex(string.byte(bytes, 6))
    result = result .. "-"
    -- Bytes 6-7 (time_hi_and_version) - set version to 4
    b6 = (string.byte(bytes, 7) & 0x0F) | 0x40
    result = result .. hex(b6)
    result = result .. hex(string.byte(bytes, 8))
    result = result .. "-"
    -- Bytes 8-9 (clock_seq_hi_and_reserved) - set variant to 1
    b8 = (string.byte(bytes, 9) & 0x3F) | 0x80
    result = result .. hex(b8)
    result = result .. hex(string.byte(bytes, 10))
    result = result .. "-"
    -- Bytes 10-15 (clock_seq_low + node)
    i = 11
    while i <= 16
        result = result .. hex(string.byte(bytes, i))
        i += 1
    end
    
    result
end

M = {}
M.v4 = v4
M
