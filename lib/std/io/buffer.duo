-- std.io.buffer — Buffered I/O operations
-- For efficient file and network I/O.
-- Sources: file handles (io.open), stdin, or raw byte-table sources.

local io = req "std.io"

-- ═══════════════════════════════════════════════════════════════
-- Buffered Reader
-- ═══════════════════════════════════════════════════════════════

fun buffered_reader_new(source: any, buffer_size: i64): any
    if buffer_size == nil then buffer_size = 4096 end
    {
        source = source,
        buffer = {},
        buffer_size = buffer_size,
        buffer_pos = 1,
        buffer_len = 0,
        eof = false,
        bytes_read = 0,
    }
end

fun buffered_reader_fill(br: any): any
    if br.eof then return {ok = false, reason = "EOF"} end

    br.buffer = {}
    br.buffer_pos = 1
    br.buffer_len = 0

    -- Read from Lua file handle
    if type(br.source) ~= "table" then
        local chunk = br.source:read(br.buffer_size)
        if chunk == nil or chunk == "" then
            br.eof = true
            return {ok = true, bytes = 0}
        end
        i = 1
        while i <= string.len(chunk)
            br.buffer[i] = string.byte(chunk, i)
            i += 1
        end
        br.buffer_len = string.len(chunk)
        return {ok = true, bytes = string.len(chunk)}
    end

    -- Read from raw byte table (source.pos tracks read cursor)
    local pos = br.source.pos or 1
    local src = br.source.data or br.source
    local avail = #src - pos + 1
    if avail <= 0 then
        br.eof = true
        return {ok = true, bytes = 0}
    end
    local n = math.min(br.buffer_size, avail)
    i = 0
    while i < n
        br.buffer[i + 1] = src[pos + i]
        i += 1
    end
    br.source.pos = pos + n
    br.buffer_len = n
    {ok = true, bytes = n}
end

fun buffered_reader_read_byte(br: any): any
    if br.buffer_pos > br.buffer_len then
        result = buffered_reader_fill(br)
        if not result.ok then return {ok = false, reason = result.reason} end
        if br.buffer_len == 0 then
            br.eof = true
            return {ok = false, reason = "EOF"}
        end
    end

    byte = br.buffer[br.buffer_pos]
    br.buffer_pos = br.buffer_pos + 1
    br.bytes_read = br.bytes_read + 1
    {ok = true, byte = byte}
end

fun buffered_reader_read(br: any, n: i64): any
    result = {}
    count = 0

    while count < n
        if br.buffer_pos > br.buffer_len then
            fill_result = buffered_reader_fill(br)
            if not fill_result.ok then break end
            if br.buffer_len == 0 then
                br.eof = true
                break
            end
        end

        available = br.buffer_len - br.buffer_pos + 1
        to_read = math.min(n - count, available)
        i = 0
        while i < to_read
            result[#result + 1] = br.buffer[br.buffer_pos]
            br.buffer_pos = br.buffer_pos + 1
            count += 1
            i += 1
        end
    end

    br.bytes_read = br.bytes_read + count
    {ok = true, data = result, bytes = count}
end

fun buffered_reader_read_line(br: any): any
    line = ""
    while true
        result = buffered_reader_read_byte(br)
        if not result.ok then
            if string.len(line) > 0 then
                return {ok = true, line = line, eof = true}
            end
            return {ok = false, reason = result.reason}
        end

        byte = result.byte
        if byte == 10 then  -- newline
            return {ok = true, line = line, eof = false}
        elseif byte == 13 then  -- carriage return
            -- Check for \r\n — if next byte is not \n, push it back
            peek = buffered_reader_read_byte(br)
            if peek.ok and peek.byte ~= 10 then
                -- Push back the non-newline byte
                buffered_reader_unread(br, peek.byte)
            end
            return {ok = true, line = line, eof = false}
        else
            line = line .. string.char(byte)
        end
    end
end

fun buffered_reader_peek(br: any): any
    if br.buffer_pos > br.buffer_len then
        result = buffered_reader_fill(br)
        if not result.ok or br.buffer_len == 0 then
            return {ok = false, reason = "EOF"}
        end
    end

    {ok = true, byte = br.buffer[br.buffer_pos]}
end

fun buffered_reader_unread(br: any, byte: i64): void
    if br.buffer_pos > 1 then
        br.buffer_pos = br.buffer_pos - 1
        br.buffer[br.buffer_pos] = byte
        br.bytes_read = br.bytes_read - 1
    end
end

fun buffered_reader_is_eof(br: any): bool
    br.eof
end

fun buffered_reader_bytes_read(br: any): i64
    br.bytes_read
end

-- ═══════════════════════════════════════════════════════════════
-- Buffered Writer
-- ═══════════════════════════════════════════════════════════════

fun buffered_writer_new(destination: any, buffer_size: i64): any
    if buffer_size == nil then buffer_size = 4096 end
    {
        destination = destination,
        buffer = {},
        buffer_size = buffer_size,
        buffer_pos = 1,
        bytes_written = 0,
        errors = {},
    }
end

fun buffered_writer_flush(bw: any): any
    if bw.buffer_pos == 1 then return {ok = true} end

    -- Build chunk from buffered bytes
    chunk = ""
    i = 1
    while i < bw.buffer_pos
        chunk = chunk .. string.char(bw.buffer[i])
        i += 1
    end

    -- Write to Lua file handle
    if type(bw.destination) ~= "table" then
        bw.destination:write(chunk)
    end

    bw.buffer = {}
    bw.buffer_pos = 1
    {ok = true}
end

fun buffered_writer_write_byte(bw: any, byte: i64): any
    if bw.buffer_pos > bw.buffer_size then
        result = buffered_writer_flush(bw)
        if not result.ok then return result end
    end

    bw.buffer[bw.buffer_pos] = byte
    bw.buffer_pos = bw.buffer_pos + 1
    bw.bytes_written = bw.bytes_written + 1
    {ok = true}
end

fun buffered_writer_write(bw: any, data: any): any
    i = 1
    while i <= #data
        result = buffered_writer_write_byte(bw, data[i])
        if not result.ok then return result end
        i += 1
    end
    {ok = true, bytes = #data}
end

fun buffered_writer_write_string(bw: any, s: str): any
    i = 1
    while i <= string.len(s)
        result = buffered_writer_write_byte(bw, string.byte(s, i))
        if not result.ok then return result end
        i += 1
    end
    {ok = true, bytes = string.len(s)}
end

fun buffered_writer_bytes_written(bw: any): i64
    bw.bytes_written
end

-- ═══════════════════════════════════════════════════════════════
-- Ring Buffer I/O (for streaming)
-- ═══════════════════════════════════════════════════════════════

fun ring_io_new(capacity: i64): any
    actual = 1
    while actual < capacity
        actual *= 2
    end
    {
        buf = {},
        capacity = actual,
        mask = actual - 1,
        read_pos = 0,
        write_pos = 0,
        full = false,
    }
end

fun ring_io_write(rio: any, data: any): any
    i = 1
    while i <= #data
        if rio.full then
            return {ok = false, reason = "Buffer full", written = i - 1}
        end
        rio.buf[rio.write_pos & rio.mask] = data[i]
        rio.write_pos = rio.write_pos + 1
        if rio.write_pos - rio.read_pos >= rio.capacity then
            rio.full = true
        end
        i += 1
    end
    {ok = true, written = #data}
end

fun ring_io_read(rio: any, n: i64): any
    result = {}
    count = 0
    while count < n and (rio.read_pos < rio.write_pos or rio.full)
        result[#result + 1] = rio.buf[rio.read_pos & rio.mask]
        rio.read_pos = rio.read_pos + 1
        rio.full = false
        count += 1
    end
    {ok = true, data = result, bytes = count}
end

fun ring_io_available(rio: any): i64
    if rio.full then return rio.capacity end
    rio.write_pos - rio.read_pos
end

fun ring_io_free(rio: any): i64
    if rio.full then return 0 end
    rio.capacity - (rio.write_pos - rio.read_pos)
end

-- ═══════════════════════════════════════════════════════════════
-- Module exports
-- ═══════════════════════════════════════════════════════════════

M = {}
-- Buffered Reader
M.reader_new = buffered_reader_new
M.reader_read_byte = buffered_reader_read_byte
M.reader_read = buffered_reader_read
M.reader_read_line = buffered_reader_read_line
M.reader_peek = buffered_reader_peek
M.reader_unread = buffered_reader_unread
M.reader_is_eof = buffered_reader_is_eof
M.reader_bytes_read = buffered_reader_bytes_read
-- Buffered Writer
M.writer_new = buffered_writer_new
M.writer_flush = buffered_writer_flush
M.writer_write_byte = buffered_writer_write_byte
M.writer_write = buffered_writer_write
M.writer_write_string = buffered_writer_write_string
M.writer_bytes_written = buffered_writer_bytes_written
-- Ring Buffer I/O
M.ring_new = ring_io_new
M.ring_write = ring_io_write
M.ring_read = ring_io_read
M.ring_available = ring_io_available
M.ring_free = ring_io_free
M
