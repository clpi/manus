-- std.html — basic HTML escaping and unescaping

string = req "std.string"

escape(s: str): str
    s = string.gsub(s, "&", "&amp;")
    s = string.gsub(s, "<", "&lt;")
    s = string.gsub(s, ">", "&gt;")
    s = string.gsub(s, '"', "&quot;")
    s = string.gsub(s, "'", "&#39;")
    s
end

unescape(s: str): str
    s = string.gsub(s, "&lt;", "<")
    s = string.gsub(s, "&gt;", ">")
    s = string.gsub(s, "&quot;", '"')
    s = string.gsub(s, "&#39;", "'")
    s = string.gsub(s, "&amp;", "&")
    s
end
