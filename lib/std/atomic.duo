-- std.atomic — atomic operations on table-backed memory

fun store(t: any, key: any, value: any): any
    old = t[key]
    t[key] = value
    old
end

fun compare_swap(t: any, key: any, expected: any, new_value: any): bool, any
    old = t[key]
    if old == expected then
        t[key] = new_value
        true, new_value
    end
    false, old
end

fun fetch_add(t: any, key: any, delta: any): any
    old = t[key]
    if type(old) == "number" then
        t[key] = old + delta
    else
        t[key] = delta
    end
    old
end

fun fetch_sub(t: any, key: any, delta: any): any
    old = t[key]
    if type(old) == "number" then
        t[key] = old - delta
    else
        t[key] = -delta
    end
    old
end

fun inc(t: any, key: any): any
    old = t[key]
    if type(old) == "number" then
        t[key] = old + 1
    else
        t[key] = 1
    end
    old
end

fun dec(t: any, key: any): any
    old = t[key]
    if type(old) == "number" then
        t[key] = old - 1
    else
        t[key] = -1
    end
    old
end

fun mutex_new(): any
    { locked = false }
end

fun lock(m: any): void
    while m.locked
        m.locked = true
    end
end

fun unlock(m: any): void
    m.locked = false
end

fun signal(sp: any): void
    if sp == nil then return end
    sp.notify = true
end

M = {}
M.store = store
M.compare_swap = compare_swap
M.fetch_add = fetch_add
M.fetch_sub = fetch_sub
M.inc = inc
M.dec = dec
M.mutex_new = mutex_new
M.lock = lock
M.unlock = unlock
M.signal = signal
M
