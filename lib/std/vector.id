-- std.vector — Duo-native text embeddings + cosine similarity.
--
-- Provides symbol/query "vector embeddings" with NO Python, NO model download.
-- Backs `duo_embed_symbols` (MCP) so it is a genuine semantic symbol index, not a
-- keyword `find` bag-of-words.
--
-- Method: hashed bag-of-n-grams (feature hashing / "the hashing trick").
--   - word tokens contribute weight WORD_W (exact-lemma signal)
--   - char 3-grams contribute weight NGRAM_W (morphology / typo / prefix signal)
--   - features are hashed (djb2) into a fixed D-dim space, TF-weighted, L2-normed
--   - similarity = cosine (dot / (||q|| * ||s||))
--
-- Sparse vector representation: a single table mapping the STRING key "f"..idx
-- to its TF weight, plus metadata keys "norm" and "dim". String keys are used
-- deliberately so that:
--   (1) the table is heterogeneous -> lowers to a lua_Value table, NOT a native
--       int64[] slice (which cannot be stored as a table value or JSON-encoded);
--   (2) numeric feature indices round-trip EXACTLY through JSON (JSON object
--       keys are strings), so a query embedded at runtime matches an index built
--       and serialized earlier. Numeric keys would collide under JSON.
-- The compute-heavy part (djb2 hashing) stays native i64; only the result table
-- is dynamic, which is the expected dynamic path (NO boxed values mandate).
--
-- NOTE: no nested `fun` closures — they don't lower cleanly in current codegen.

WORD_W  = 3.0
NGRAM_W = 1.0

-- djb2 string hash -> unsigned 32-bit (no xor operator, immune to the pattern
-- engine bugs in F-13813-5; pure arithmetic, lowers to native i64).
hash32(s: str): i64
    h = 5381
    n = #s
    i = 1
    while i <= n
        h = (h * 33 + s:byte(i)) % 4294967296
        i = i + 1
    end
    h
end

-- Split text into lowercase identifier-ish word tokens (alnum runs, len >= 2).
-- Chars scanned directly (no Lua patterns) to dodge the F-13813-5 bugs.
tokens(text: str): any
    out = {}
    if text == nil return out end
    n = #text
    i = 1
    cur = ""
    while i <= n
        c = text:byte(i)
        is_digit = c >= 48 and c <= 57
        is_upper = c >= 65 and c <= 90
        is_lower = c >= 97 and c <= 122
        if is_digit or is_upper or is_lower
            cur = cur .. string.char(c)
        else
            if #cur >= 2
                out[#out + 1] = string.lower(cur)
            end
            cur = ""
        end
        i = i + 1
    end
    if #cur >= 2
        out[#out + 1] = string.lower(cur)
    end
    out
end

-- Char 3-grams of a token, edge-padded with sentinels so prefix/suffix matter.
trigrams(token: str): any
    out = {}
    if token == nil return out end
    s = "^" .. token .. "$"
    n = #s
    if n < 3 return out end
    i = 1
    while i <= n - 2
        out[#out + 1] = s:sub(i, i + 2)
        i = i + 1
    end
    out
end

-- Embed text into a fixed `dim`-dim sparse vector (string-keyed table; see top).
embed(text: str, dim: i64): any
    vec = {}
    for _, word in tokens(text)
        widx = hash32(word) % dim
        wk = "f" .. widx
        vec[wk] = (vec[wk] or 0) + WORD_W
        for _, tg in trigrams(word)
            gidx = hash32(tg) % dim
            gk = "f" .. gidx
            vec[gk] = (vec[gk] or 0) + NGRAM_W
        end
    end
    sumsq = 0.0
    for _k, w in vec
        sumsq = sumsq + w * w
    end
    -- Store the L2 norm as a SCALED INTEGER (norm * 1e6), NOT a float. The C
    -- runtime's tonumber crashes (heap corruption, EXIT 128) on long (>=15 sig-
    -- digit) float reprs, which truncated json.decode of the symbol index at
    -- ~1029 entries. Integers parse safely; cosine() un-scales at query time.
    vec.norm = math.floor(math.sqrt(sumsq) * 1000000 + 0.5)
    vec.dim = dim
    vec
end

-- Cosine similarity between two sparse vectors from embed(). Iterates the
-- (usually smaller) query vector and probes `s` by shared feature key.
cosine(q: any, s: any): float
    if q == nil or s == nil return 0.0 end
    if q.norm == 0 or s.norm == 0 return 0.0 end
    dot = 0.0
    for k, qw in q
        if k != "norm" and k != "dim"
            sw = s[k]
            if sw != nil
                dot = dot + qw * sw
            end
        end
    end
    dot / ((q.norm / 1000000.0) * (s.norm / 1000000.0))
end

-- Rank records (each with a `vec` field) against query vector `q`, returning the
-- top_k records with an added `score` field, best-first.
-- k-pass max selection (O(k*n)): avoids element-swapping, which miscompiles at
-- scale; uses a `taken` marker table and the field-vs-local comparison that is
-- verified to lower correctly.
rank(q: any, records: any, top_k: i64): any
    all = {}
    for _, rec in records
        sc = cosine(q, rec.vec)
        if sc > 0
            all[#all + 1] = { name = rec.name, file = rec.file,
                              kind = rec.kind, doc = rec.doc, score = sc }
        end
    end
    n = #all
    k = top_k
    if k > n k = n end
    if k < 0 k = 0 end
    out = {}
    taken = {}
    round = 1
    while round <= k
        besti = 0
        bestsc = -1.0
        i = 1
        while i <= n
            if taken[i] == nil
                if all[i].score > bestsc
                    bestsc = all[i].score
                    besti = i
                end
            end
            i = i + 1
        end
        if besti == 0 break end
        taken[besti] = true
        out[#out + 1] = all[besti]
        round = round + 1
    end
    out
end

M = {
    hash32   = hash32,
    tokens   = tokens,
    trigrams = trigrams,
    embed    = embed,
    cosine   = cosine,
    rank     = rank,
}
