-- std.base32 — Base32 encoding and decoding (RFC 4648)

-- Note: base32 lookup tables (alphabets and decode tables) are constructed
-- inside the functions that use them. The duo codegen does not yet expose
-- module-level locals/globals to function bodies, so defining them at the
-- top of the module produces "use of undeclared identifier" errors in the
-- emitted C. Keeping them function-local is the minimal fix.

encode_with_alphabet(data: str, tab: str): str
    if data == nil return "" end
    res = {}
    len = std.string.len(data)
    i = 1
    while i <= len
        b1 = std.string.byte(data, i)
        b2 = 0
        if i + 1 <= len b2 = std.string.byte(data, i + 1) end
        b3 = 0
        if i + 2 <= len b3 = std.string.byte(data, i + 2) end
        b4 = 0
        if i + 3 <= len b4 = std.string.byte(data, i + 3) end
        b5 = 0
        if i + 4 <= len b5 = std.string.byte(data, i + 4) end
        c1 = (b1 >> 3) + 1
        c2 = (((b1 & 0x07) << 2) | (b2 >> 6)) + 1
        c3 = ((b2 >> 1) & 0x1F) + 1
        c4 = (((b2 & 0x01) << 4) | (b3 >> 4)) + 1
        c5 = (((b3 & 0x0F) << 1) | (b4 >> 7)) + 1
        c6 = ((b4 >> 2) & 0x1F) + 1
        c7 = (((b4 & 0x03) << 3) | (b5 >> 5)) + 1
        c8 = (b5 & 0x1F) + 1
        -- RFC 4648 s6: a 5-byte group is always EIGHT characters, and how many
        -- of them are data depends on how many bytes are present:
        --   1 byte -> 2 data + 6 '='      4 bytes -> 7 data + 1 '='
        --   2      -> 4 data + 4 '='      5       -> 8 data, no padding
        --   3      -> 5 data + 3 '='
        --
        -- This emitted c1..c3 unconditionally and then branched, so EVERY
        -- partial group came out seven characters instead of eight, with the
        -- wrong data count for the 1- and 4-byte tails: encode("h") gave
        -- "NAA====" where the correct answer is "NA======".
        rem = len - i + 1
        res[rawlen(res) + 1] = std.string.sub(tab, c1, c1)
        res[rawlen(res) + 1] = std.string.sub(tab, c2, c2)
        if rem >= 2
            res[rawlen(res) + 1] = std.string.sub(tab, c3, c3)
            res[rawlen(res) + 1] = std.string.sub(tab, c4, c4)
        end
        if rem >= 3
            res[rawlen(res) + 1] = std.string.sub(tab, c5, c5)
        end
        if rem >= 4
            res[rawlen(res) + 1] = std.string.sub(tab, c6, c6)
            res[rawlen(res) + 1] = std.string.sub(tab, c7, c7)
        end
        if rem >= 5
            res[rawlen(res) + 1] = std.string.sub(tab, c8, c8)
        end
        pad = 0
        if rem == 1 pad = 6 end
        if rem == 2 pad = 4 end
        if rem == 3 pad = 3 end
        if rem == 4 pad = 1 end
        pj = 0
        while pj < pad
            res[rawlen(res) + 1] = "="
            pj += 1
        end
        i += 5
    end
    table.concat(res)
end

encode(data: str): str
    encode_with_alphabet(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567")
end

encode_hex(data: str): str
    encode_with_alphabet(data, "0123456789ABCDEFGHIJKLMNOPQRSTUV")
end

decode_with_alphabet(data: str, tab: any): str
    if data == nil return "" end
    res = {}
    len = std.string.len(data)
    i = 1
    while i <= len
        vals = {}
        pad_count = 0
        for j = 0, 7
            pos = i + j
            if pos > len
                vals[j + 1] = 0
                pad_count += 1
            else
                c = std.string.byte(data, pos)
                if c == 61
                    vals[j + 1] = 0
                    pad_count += 1
                else
                    v = tab[c]
                    if v != nil
                        vals[j + 1] = v
                    else
                        vals[j + 1] = 0
                        pad_count += 1
                    end
                end
            end
        end
        b1 = (vals[1] << 3) | (vals[2] >> 2)
        b2 = ((vals[2] & 0x03) << 6) | (vals[3] << 1) | (vals[4] >> 4)
        b3 = ((vals[4] & 0x0F) << 4) | (vals[5] >> 1)
        b4 = ((vals[5] & 0x01) << 7) | (vals[6] << 2) | (vals[7] >> 3)
        b5 = ((vals[7] & 0x07) << 5) | vals[8]
        res[rawlen(res) + 1] = std.string.char(b1)
        if pad_count < 6
            res[rawlen(res) + 1] = std.string.char(b2)
        end
        if pad_count < 4
            res[rawlen(res) + 1] = std.string.char(b3)
        end
        if pad_count < 3
            res[rawlen(res) + 1] = std.string.char(b4)
        end
        if pad_count < 1
            res[rawlen(res) + 1] = std.string.char(b5)
        end
        i += 8
    end
    table.concat(res)
end

decode(data: str): str
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    dec_table = {}
    for i = 1, 32
        dec_table[std.string.byte(alphabet, i)] = i - 1
    end
    decode_with_alphabet(data, dec_table)
end

decode_hex(data: str): str
    hex_alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUV"
    hex_dec_table = {}
    for i = 1, 32
        hex_dec_table[std.string.byte(hex_alphabet, i)] = i - 1
    end
    decode_with_alphabet(data, hex_dec_table)
end

