-- std.csv — basic CSV parsing and formatting

parse_line(line: any): any
        res = {}
        len = std.string.len(line)
        i = 1
        while i <= len
            c = std.string.sub(line, i, i)
            if c == '"'
                -- quoted field
                field = ""
                i += 1
                while i <= len
                    c2 = std.string.sub(line, i, i)
                    if c2 == '"'
                        if i + 1 <= len and std.string.sub(line, i + 1, i + 1) == '"'
                            field = field .. '"'
                            i += 2
                        else
                            i += 1
                            break
                        end
                    else
                        field = field .. c2
                        i += 1
                    end
                end
                table.insert(res, field)
                if i <= len and std.string.sub(line, i, i) == ','
                    i += 1
                end
            else
                -- unquoted field
                start = i
                while i <= len and std.string.sub(line, i, i) != ','
                    i += 1
                end
                table.insert(res, std.string.sub(line, start, i - 1))
                if i <= len
                    i += 1 -- skip comma
                end
            end
        end
        -- Handle trailing comma
        if len > 0 and std.string.sub(line, len, len) == ','
            table.insert(res, "")
        end
        res
end

parse(data: any): any
    lines = std.string.split(data, "\n")
    res = {}
    for _, line in lines
        if std.string.len(line) > 0 and std.string.sub(line, std.string.len(line), std.string.len(line)) == "\r"
            line = std.string.sub(line, 1, std.string.len(line) - 1)
        end
        if std.string.len(line) > 0
            table.insert(res, parse_line(line))
        end
    end
    res
end

escape_field(field: any): any
    s = to(str)(field)
    if std.string.find(s, ",") or std.string.find(s, '"') or std.string.find(s, "\n")
        s = std.string.gsub(s, '"', '""')
        return '"' .. s .. '"'
    end
    s
end

format_line(row: any): any
    parts = {}
    for _, v in row
        table.insert(parts, escape_field(v))
    end
    std.string.concat(parts, ",")
end

format(rows: any): any
    lines = {}
    for _, row in rows
        table.insert(lines, format_line(row))
    end
    std.string.concat(lines, "\n")
end

