-- std.ini — INI file parser

parse(data: str): any
    lines = std.string.split(data, "\n")
    res = {}
    current_section = res
    
    for _, line in lines
        line = std.string.trim(line)
        if std.string.len(line) > 0 and std.string.sub(line, 1, 1) != ";" and std.string.sub(line, 1, 1) != "#"
            if std.string.sub(line, 1, 1) == "[" and std.string.sub(line, std.string.len(line), std.string.len(line)) == "]"
                sec_name = std.string.sub(line, 2, std.string.len(line) - 1)
                res[sec_name] = {}
                current_section = res[sec_name]
            else
                parts = std.string.split(line, "=")
                if std.table.len(parts) >= 2
                    key = std.string.trim(parts[1])
                    val = std.string.trim(parts[2])
                    current_section[key] = val
                end
            end
        end
    end
    res
end

