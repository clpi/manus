-- std.ini — INI file parser

string = req "std.string"
table_mod = req "std.table"

parse(data: str): any
    lines = string.split(data, "\n")
    res = {}
    current_section = res
    
    for _, line in ipairs(lines)
        line = string.trim(line)
        if string.len(line) > 0 and string.sub(line, 1, 1) != ";" and string.sub(line, 1, 1) != "#"
            if string.sub(line, 1, 1) == "[" and string.sub(line, string.len(line), string.len(line)) == "]"
                sec_name = string.sub(line, 2, string.len(line) - 1)
                res[sec_name] = {}
                current_section = res[sec_name]
            else
                parts = string.split(line, "=")
                if table_mod.len(parts) >= 2
                    key = string.trim(parts[1])
                    val = string.trim(parts[2])
                    current_section[key] = val
                end
            end
        end
    end
    res
end

M = {}
M.parse = parse
M
