-- std.mcp — Model Context Protocol SDK for Duo.
-- Provides a pure Duo implementation of the MCP stdio transport (JSON-RPC 2.0).

global M = {}
M.tools = {}

fun mcp_read_message(): any
    io_mod = req "std.io"
    json_mod = req "std.json"
    content_length = -1
    while true
        line = io_mod.read_line(io_mod.input())
        if line == nil then return nil end
        if line == "\r" or line == "" then
            break
        end
        if string.starts_with(line, "Content-Length: ") then
            len_str = string.sub(line, 17, -1)
            len_str = string.gsub(len_str, "\r", "")
            content_length = tonumber(len_str)
        end
    end
    if content_length < 0 then
        return nil
    end
    body = io_mod.read_bytes(io_mod.input(), content_length)
    if body == nil then return nil end
    json_mod.decode(body)
end

fun mcp_send_message(obj: any): void
    json_mod = req "std.json"
    io_mod = req "std.io"
    body = json_mod.encode(obj)
    len = string.len(body)
    header = "Content-Length: " .. tostring(len) .. "\r\n\r\n"
    io_mod.write_bytes(io_mod.output(), header .. body)
    io_mod.flush(io_mod.output())
end

fun mcp_send_response(id: any, result: any): void
    mcp_send_message({
        jsonrpc = "2.0",
        id = id,
        result = result
    })
end

fun mcp_send_error(id: any, code: int, message: str): void
    mcp_send_message({
        jsonrpc = "2.0",
        id = id,
        error = {
            code = code,
            message = message
        }
    })
end

fun mcp_handle_initialize(msg: any): void
    mcp_send_response(msg.id, {
        protocolVersion = "2024-11-05",
        capabilities = {
            tools = {}
        },
        serverInfo = {
            name = "duo-mcp",
            version = "0.1.0"
        }
    })
end

fun mcp_handle_tools_list(msg: any): void
    tools_list = {}
    for name, tool in M.tools do
        tools_list[#tools_list + 1] = {
            name = name,
            description = tool.description,
            inputSchema = tool.inputSchema
        }
    end
    mcp_send_response(msg.id, {
        tools = tools_list
    })
end

fun mcp_handle_tools_call(msg: any): void
    params = msg.params
    name = params.name
    args = params.arguments
    tool = M.tools[name]
    if tool == nil then
        mcp_send_error(msg.id, -32601, "Tool not found: " .. name)
        return
    end
    
    res = tool.handler(args)
    if type(res) == "string" then
        mcp_send_response(msg.id, {
            content = {
                {
                    type = "text",
                    text = res
                }
            }
        })
    elseif type(res) == "table" and res.isError then
        mcp_send_response(msg.id, {
            isError = true,
            content = {
                {
                    type = "text",
                    text = res.message
                }
            }
        })
    else
        json_mod = req "std.json"
        mcp_send_response(msg.id, {
            content = {
                {
                    type = "text",
                    text = json_mod.encode(res)
                }
            }
        })
    end
end

fun mcp_serve(): void
    while true
        msg = mcp_read_message()
        if msg == nil then
            break
        end
        if msg.method == "initialize" then
            mcp_handle_initialize(msg)
        elseif msg.method == "tools/list" then
            mcp_handle_tools_list(msg)
        elseif msg.method == "tools/call" then
            mcp_handle_tools_call(msg)
        elseif msg.method == "notifications/initialized" then
            -- nothing to do
        elseif msg.method == "ping" then
            mcp_send_response(msg.id, {})
        elseif msg.id ~= nil then
            mcp_send_error(msg.id, -32601, "Method not found: " .. tostring(msg.method))
        end
    end
end

fun mcp_register_tool(name: str, p2: any, p3: any, p4: any): void
    -- Accept two calling conventions:
    --   3-arg: register_tool(name, inputSchema_with_description, handler)
    --   4-arg: register_tool(name, description, inputSchema, handler)
    -- Distinguish by type, not nil: Duo codegen leaves missing trailing args as
    -- non-nil garbage, so `p4 ~= nil` misfires on the 3-arg form and stores garbage
    -- as the handler (tools/call then crashes). `type(p4)=="function"` is unambiguous.
    if type(p4) == "function" then
        M.tools[name] = { name = name, description = p2 or "", inputSchema = p3, handler = p4 }
    else
        M.tools[name] = { name = name, description = p2.description or "", inputSchema = p2, handler = p3 }
    end
end

M.serve = mcp_serve
M.register_tool = mcp_register_tool
M
