start(msg: str): void
    io.write(string.format("=== %s ===\n", msg))
end

assert_eq(actual: any, expected: any, msg: str): void
    if actual == expected
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected %s, got %s)\n", msg or "", expected:to(str), actual:to(str)))
    end
end

assert_ne(actual: any, not_expected: any, msg: str): void
    if actual != not_expected
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected not %s)\n", msg or "", not_expected:to(str)))
    end
end

assert_true(val: any, msg: str): void
    if val == true
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s\n", msg or ""))
    end
end

assert_false(val: any, msg: str): void
    if val == false
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s\n", msg or ""))
    end
end

assert_nil(val: any, msg: str): void
    if val == nil
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected nil, got %s)\n", msg or "", val:to(str)))
    end
end

assert_not_nil(val: any, msg: str): void
    if val != nil
        io.write(string.format("  PASS: %s\n", msg or ""))
    else
        io.write(string.format("  FAIL: %s (expected not nil)\n", msg or ""))
    end
end

done(): void
    io.write("=== tests done ===\n")
end

-- Supported @test.* / @bench / @time attributes (see also std.bench.attrs).
attrs = {
    test = { "test", "test.unit", "test.integration", "test.e2e", "test.skip", "test.only", "test.flaky", "test.should_panic", "test.bench", "test.time" },
    args = { "name", "tag", "message", "timeout", "timeout_ms", "iterations", "warmup" },
    cli = { "duo test <file.id>", "duo bench <file.id>", "duo test <file> --filter <pat>" },
}

