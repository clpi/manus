-- std.slices — slice helper utilities (mirrors Go 1.21 slices package)
-- All functions prefixed with std_slices_ to avoid C name collisions.

std_slices_clip(arr: any, n: i64): any
    if arr == nil return arr end
    len = rawlen(arr)
    if n >= len return arr end
    if n < 0 n = 0 end
    i = n + 1
    while i <= len
        arr[i] = nil
        i += 1
    end
    arr
end

std_slices_clone(arr: any): any
    if arr == nil return {} end
    out = {}
    i = 1
    while i <= rawlen(arr)
        out[i] = arr[i]
        i += 1
    end
    out
end

std_slices_compact(arr: any, eq: any): any
    if arr == nil return {} end
    n = rawlen(arr)
    if n <= 1 return std_slices_clone(arr) end
    out = {}
    out[1] = arr[1]
    j = 1
    i = 2
    while i <= n
        if not eq(arr[i], out[j])
            j += 1
            out[j] = arr[i]
        end
        i += 1
    end
    out
end

std_slices_contains(arr: any, v: any): bool
    if arr == nil return false end
    i = 1
    while i <= rawlen(arr)
        if arr[i] == v return true end
        i += 1
    end
    false
end

std_slices_index(arr: any, v: any): i64
    if arr == nil return 0 - 1 end
    i = 1
    while i <= rawlen(arr)
        if arr[i] == v return i end
        i += 1
    end
    0 - 1
end

std_slices_index_func(arr: any, f: any): i64
    if arr == nil return 0 - 1 end
    i = 1
    while i <= rawlen(arr)
        if f(arr[i]) return i end
        i += 1
    end
    0 - 1
end

std_slices_insert(arr: any, i: i64, v: any): any
    if arr == nil arr = {} end
    n = rawlen(arr)
    if i < 1 i = 1 end
    if i > n + 1 i = n + 1 end
    out = {}
    j = 1
    while j < i
        out[j] = arr[j]
        j += 1
    end
    out[i] = v
    j = i
    while j <= n
        out[j + 1] = arr[j]
        j += 1
    end
    out
end

std_slices_delete(arr: any, i: i64): any
    if arr == nil return {} end
    n = rawlen(arr)
    if i < 1 or i > n return std_slices_clone(arr) end
    out = {}
    j = 1
    while j <= n
        if j != i
            out[rawlen(out) + 1] = arr[j]
        end
        j += 1
    end
    out
end

std_slices_delete_func(arr: any, f: any): any
    if arr == nil return {} end
    out = {}
    i = 1
    while i <= rawlen(arr)
        if not f(arr[i])
            out[rawlen(out) + 1] = arr[i]
        end
        i += 1
    end
    out
end

std_slices_reverse(arr: any): void
    if arr == nil return end
    n = rawlen(arr)
    i = 1
    j = n
    while i < j
        tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp
        i += 1
        j -= 1
    end
end

std_slices_replace(arr: any, i: i64, j: i64, v: any): any
    if arr == nil arr = {} end
    n = rawlen(arr)
    if i < 1 i = 1 end
    if j > n j = n end
    if j < i j = i end
    out = {}
    k = 1
    while k < i
        out[k] = arr[k]
        k += 1
    end
    out[i] = v
    k = j + 1
    while k <= n
        out[rawlen(out) + 1] = arr[k]
        k += 1
    end
    out
end

std_slices_grow(arr: any, n: i64): any
    arr
end

std_slices_binary_search(arr: any, v: any, less: any): any
    if arr == nil return 0, false end
    lo = 0
    hi = rawlen(arr)
    while lo < hi
        mid = lo + (hi - lo) / 2
        if less(v, arr[mid + 1])
            hi = mid
        elseif less(arr[mid + 1], v)
            lo = mid + 1
        else
            return mid + 1, true
        end
    end
    return lo + 1, false
end

std_slices_max(arr: any, less: any): any
    if arr == nil return nil end
    n = rawlen(arr)
    if n == 0 return nil end
    m = arr[1]
    i = 2
    while i <= n
        if less(m, arr[i]) m = arr[i] end
        i += 1
    end
    m
end

std_slices_min(arr: any, less: any): any
    if arr == nil return nil end
    n = rawlen(arr)
    if n == 0 return nil end
    m = arr[1]
    i = 2
    while i <= n
        if less(arr[i], m) m = arr[i] end
        i += 1
    end
    m
end

std_slices_sorted(arr: any, less: any): bool
    if arr == nil return true end
    n = rawlen(arr)
    i = 2
    while i <= n
        if less(arr[i], arr[i - 1]) return false end
        i += 1
    end
    true
end

std_slices_chunk(arr: any, n: i64): any
    if arr == nil return {} end
    if n == nil or n < 1 n = 1 end
    out = {}
    i = 1
    while i <= rawlen(arr)
        c = {}
        j = 0
        while j < n and i + j <= rawlen(arr)
            c[j + 1] = arr[i + j]
            j += 1
        end
        out[rawlen(out) + 1] = c
        i += n
    end
    out
end

M = {}
M.clip = std_slices_clip
M.clone = std_slices_clone
M.compact = std_slices_compact
M.contains = std_slices_contains
M.index = std_slices_index
M.index_func = std_slices_index_func
M.insert = std_slices_insert
M.delete = std_slices_delete
M.delete_func = std_slices_delete_func
M.reverse = std_slices_reverse
M.replace = std_slices_replace
M.grow = std_slices_grow
M.binary_search = std_slices_binary_search
M.max = std_slices_max
M.min = std_slices_min
M.sorted = std_slices_sorted
M.chunk = std_slices_chunk
M