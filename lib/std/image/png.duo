-- std.image.png — PNG image decoder
-- Basic PNG decoder: reads IHDR, IDAT, IEND chunks

local string = req "std.string"
local image = req "std.image"

fun crc32_byte(crc: i64, b: i64): i64
    crc = crc ~ b
    for _ = 1, 8
        if crc % 2 == 1 then
            crc = crc >> 1 ~ 0xEDB88320
        else
            crc = crc >> 1
        end
    end
    crc % (2^32)
end

fun crc32_bytes(data: str): i64
    crc = 0xFFFFFFFF
    for i = 1, string.len(data)
        crc = crc32_byte(crc, string.byte(data, i))
    end
    (2^32 - 1) - crc
end

fun read_u32(s: str, off: i64): i64
    (string.byte(s, off) * 16777216 + string.byte(s, off + 1) * 65536 + string.byte(s, off + 2) * 256 + string.byte(s, off + 3)) % (2^32)
end

fun read_u16(s: str, off: i64): i64
    (string.byte(s, off) * 256 + string.byte(s, off + 1)) % 65536
end

fun decode(data: str): any
    if data == nil then return nil end
    sig = "\137PNG\r\n\26\n"
    for i = 1, 8
        if string.byte(data, i) ~= string.byte(sig, i) then
            return nil
        end
    end
    off = 9
    img = nil
    while off + 4 <= string.len(data)
        chunk_len = read_u32(data, off)
        chunk_type = string.sub(data, off + 4, off + 7)
        chunk_data = string.sub(data, off + 8, off + 7 + chunk_len)
        expected_crc = read_u32(data, off + 8 + chunk_len)
        if chunk_type == "IHDR" then
            width = read_u32(chunk_data, 1)
            height = read_u32(chunk_data, 5)
            bit_depth = string.byte(chunk_data, 9)
            color_type = string.byte(chunk_data, 10)
            if bit_depth == 8 and color_type == 6 then
                img = image.new_rgba(image.rect(0, 0, width, height))
            elseif bit_depth == 8 and color_type == 0 then
                img = image.new_gray(image.rect(0, 0, width, height))
            end
        elseif chunk_type == "IDAT" and img ~= nil then
            -- Append raw compressed data (actual decompression not implemented)
            -- For now, we fill with placeholder pixel data
            w = image.rect_dx(img.rect)
            h = image.rect_dy(img.rect)
            for y = 0, h - 1
                for x = 0, w - 1
                    c = image.color.rgba(65535, 65535, 65535, 65535)
                    image.img_set(img, x, y, c)
                end
            end
        elseif chunk_type == "IEND" then
            break
        end
        off = off + 12 + chunk_len
    end
    img
end

fun encode(img: any): str
    out = "\137PNG\r\n\26\n"
    w = image.rect_dx(img.rect)
    h = image.rect_dy(img.rect)
    ihdr_data = string.char(0, 0, 0, 0, 0, 0, 0, 0, 8, 6, 0, 0, 0)
    ihdr_data = string.char(
        (w / 16777216) % 256, (w / 65536) % 256, (w / 256) % 256, w % 256,
        (h / 16777216) % 256, (h / 65536) % 256, (h / 256) % 256, h % 256,
        8, 6, 0, 0, 0
    )
    out = out .. string.char(0, 0, 0, 13) .. "IHDR" .. ihdr_data
    ihdr_crc = crc32_bytes("IHDR" .. ihdr_data)
    out = out .. string.char(
        (ihdr_crc / 16777216) % 256, (ihdr_crc / 65536) % 256, (ihdr_crc / 256) % 256, ihdr_crc % 256
    )
    -- IDAT chunk (raw uncompressed - violates PNG spec but allows basic decode)
    raw = ""
    for y = 0, h - 1
        raw = raw .. string.char(0) -- filter none
        for x = 0, w - 1
            c = image.img_at(img, x, y)
            r = (c.r / 257) % 256
            g = (c.g / 257) % 256
            b = (c.b / 257) % 256
            a = (c.a / 257) % 256
            raw = raw .. string.char(r, g, b, a)
        end
    end
    zlib_header = string.char(0x78, 0x01)
    -- No actual deflate compression; store raw data
    deflate_block = string.char(0x01)
    len = string.len(raw)
    deflate_block = deflate_block .. string.char(len % 256, (len / 256) % 256, (~len) % 256, ((~len) / 256) % 256)
    deflate_block = deflate_block .. raw
    adler_a = 1
    adler_b = 0
    for i = 1, string.len(raw)
        adler_a = (adler_a + string.byte(raw, i)) % 65521
        adler_b = (adler_b + adler_a) % 65521
    end
    adler32_check = adler_b * 65536 + adler_a
    idat_data = zlib_header .. deflate_block .. string.char(
        (adler32_check / 16777216) % 256, (adler32_check / 65536) % 256, (adler32_check / 256) % 256, adler32_check % 256
    )
    idat_len = string.len(idat_data)
    out = out .. string.char(
        (idat_len / 16777216) % 256, (idat_len / 65536) % 256, (idat_len / 256) % 256, idat_len % 256
    ) .. "IDAT" .. idat_data
    idat_crc = crc32_bytes("IDAT" .. idat_data)
    out = out .. string.char(
        (idat_crc / 16777216) % 256, (idat_crc / 65536) % 256, (idat_crc / 256) % 256, idat_crc % 256
    )
    -- IEND chunk
    iend_crc = crc32_bytes("IEND")
    out = out .. string.char(0, 0, 0, 0) .. "IEND" .. string.char(
        (iend_crc / 16777216) % 256, (iend_crc / 65536) % 256, (iend_crc / 256) % 256, iend_crc % 256
    )
    out
end

M = {}
M.decode = decode
M.encode = encode
M
