# std.image.png — PNG image decoder/encoder
# Decoder: reads IHDR, IDAT, IEND chunks with zlib decompression and filter reconstruction.
# Encoder: writes uncompressed store blocks (valid PNG, larger files).

# ═══════════════════════════════════════════════════════════════
# CRC32 and helpers
# ═══════════════════════════════════════════════════════════════

crc32_byte(crc: i64, b: i64): i64
    crc = crc ~ b
    for _ = 1, 8
        if crc % 2 == 1
            crc = crc >> 1 ~ 0xEDB88320
        else
            crc = crc >> 1
        end
    end
    crc % 4294967296
end

crc32_bytes(data: str): i64
    crc = 0xFFFFFFFF
    for i = 1, data:len()
        crc = crc32_byte(crc, data:byte(i))
    end
    (2^32 - 1) - crc
end

read_u32(s: str, off: i64): i64
    (s:byte(off) * 16777216 + s:byte(off + 1) * 65536 + s:byte(off + 2) * 256 + s:byte(off + 3)) % 4294967296
end

read_u16(s: str, off: i64): i64
    (s:byte(off) * 256 + s:byte(off + 1)) % 65536
end

str_to_bytes(s: str): any
    bytes = {}
    i = 1
    while i <= s:len()
        bytes[bytes:len() + 1] = s:byte(i)
        i += 1
    end
    bytes
end

bytes_to_str(b: any): str
    parts = {}
    i = 1
    while i <= b:len()
        parts[parts:len() + 1] = b[i]:char()
        i += 1
    end
    parts:concat()
end

# ═══════════════════════════════════════════════════════════════
# PNG filter reconstruction
# ═══════════════════════════════════════════════════════════════

paeth_predictor(a: i64, b: i64, c: i64): i64
    p = a + b - c
    pa = p - a
    if pa < 0 pa = -pa end
    pb = p - b
    if pb < 0 pb = -pb end
    pc = p - c
    if pc < 0 pc = -pc end
    if pa <= pb and pa <= pc return a end
    if pb <= pc return b end
    c
end

reconstruct_row(raw_data: any, row: i64, stride: i64, bpp: i64): any
    # Extract the row bytes (skip the filter byte at the start)
    row_start = row * stride + 1
    filter_type = raw_data[row_start]
    row_bytes = {}
    i = 1
    while i <= stride
        row_bytes[i] = raw_data[row_start + i]
        i += 1
    end

    if filter_type == 0
        # None: no reconstruction needed
        return row_bytes
    end

    # For Sub/Up/Average/Paeth, we need the previous reconstructed row
    prev = {}
    if row > 0
        prev_start = (row - 1) * stride + 1
        i = 1
        while i <= stride
            prev[i] = raw_data[prev_start + i]
            i += 1
        end
    else
        i = 1
        while i <= stride
            prev[i] = 0
            i += 1
        end
    end

    recon = {}
    i = 1
    while i <= stride
        raw_byte = row_bytes[i]
        if filter_type == 1
            # Sub: recon(x) = raw(x) + recon(a)
            left = (i > bpp) and recon[i - bpp] or 0
            recon[i] = (raw_byte + left) % 256
        elseif filter_type == 2
            # Up: recon(x) = raw(x) + recon(b)
            recon[i] = (raw_byte + prev[i]) % 256
        elseif filter_type == 3
            # Average: recon(x) = raw(x) + floor((a + b) / 2)
            left = (i > bpp) and recon[i - bpp] or 0
            recon[i] = (raw_byte + (left + prev[i]) / 2:floor()) % 256
        elseif filter_type == 4
            # Paeth: recon(x) = raw(x) + paeth(a, b, c)
            left = (i > bpp) and recon[i - bpp] or 0
            upper_left = (i > bpp) and prev[i - bpp] or 0
            recon[i] = (raw_byte + paeth_predictor(left, prev[i], upper_left)) % 256
        else
            recon[i] = raw_byte
        end
        i += 1
    end

    recon
end

# ═══════════════════════════════════════════════════════════════
# PNG decoder
# ═══════════════════════════════════════════════════════════════

decode(data: str): any
    if data == nil return nil end

    # Verify PNG signature
    sig = "\137PNG\r\n\26\n"
    for i = 1, 8
        if data:byte(i) != sig:byte(i)
            return nil
        end
    end

    off = 9
    img = nil
    width = 0
    height = 0
    bit_depth = 8
    color_type = 6
    idat_data = ""

    # First pass: read IHDR and collect IDAT chunks
    while off + 8 <= data:len()
        chunk_len = read_u32(data, off)
        chunk_type = data:sub(off + 4, off + 7)
        chunk_data = data:sub(off + 8, off + 7 + chunk_len)

        if chunk_type == "IHDR"
            width = read_u32(chunk_data, 1)
            height = read_u32(chunk_data, 5)
            bit_depth = chunk_data:byte(9)
            color_type = chunk_data:byte(10)
            compression = chunk_data:byte(11)
            filter_method = chunk_data:byte(12)
            interlace = chunk_data:byte(13)

            # Create image based on color type
            if color_type == 6
                # RGBA
                img = std.image.new_rgba(std.image.rect(0, 0, width, height))
            elseif color_type == 2
                # RGB (will set alpha to 255)
                img = std.image.new_rgba(std.image.rect(0, 0, width, height))
            elseif color_type == 0
                # Grayscale
                img = std.image.new_gray(std.image.rect(0, 0, width, height))
            elseif color_type == 4
                # Gray + Alpha
                img = std.image.new_rgba(std.image.rect(0, 0, width, height))
            else
                # Unsupported: create RGBA as fallback
                img = std.image.new_rgba(std.image.rect(0, 0, width, height))
            end

        elseif chunk_type == "IDAT"
            # Concatenate all IDAT data
            idat_data = idat_data .. chunk_data

        elseif chunk_type == "IEND"
            break
        end

        # Skip to next chunk (4 len + 4 type + chunk_len data + 4 CRC)
        off += 12 + chunk_len
    end

    # Second pass: decompress and reconstruct
    if img != nil and idat_data:len() > 0
        # Decompress the IDAT data (zlib wrapped)
        compressed = str_to_bytes(idat_data)
        raw_data_str = std.compress.zlib.decompress(idat_data)
        raw_data = str_to_bytes(raw_data_str)

        # Determine bytes per pixel based on color type and bit depth
        bpp = 1
        if color_type == 2 bpp = 3
        elseif color_type == 4 bpp = 2
        elseif color_type == 6 bpp = 4
        end

        # For 8-bit depth, stride = width * bpp
        # (handles sub-byte bit depths as 1 byte per sample for simplicity)
        if bit_depth < 8
            bpp = 1
        end
        stride = width * bpp

        # Reconstruct each row
        row = 0
        while row < height
            recon = reconstruct_row(raw_data, row, stride, bpp)

            # Write pixels to image
            col = 0
            while col < width
                if color_type == 6
                    # RGBA
                    r = recon[col * 4 + 1] * 257
                    g = recon[col * 4 + 2] * 257
                    b = recon[col * 4 + 3] * 257
                    a = recon[col * 4 + 4] * 257
                    std.image.img_set(img, col, row, std.image.color.rgba(r, g, b, a))
                elseif color_type == 2
                    # RGB
                    r = recon[col * 3 + 1] * 257
                    g = recon[col * 3 + 2] * 257
                    b = recon[col * 3 + 3] * 257
                    std.image.img_set(img, col, row, std.image.color.rgba(r, g, b, 65535))
                elseif color_type == 0
                    # Grayscale
                    y = recon[col + 1] * 257
                    std.image.img_set(img, col, row, std.image.color.gray(y))
                elseif color_type == 4
                    # Gray + Alpha
                    y = recon[col * 2 + 1] * 257
                    a = recon[col * 2 + 2] * 257
                    std.image.img_set(img, col, row, std.image.color.rgba(y, y, y, a))
                end
                col += 1
            end
            row += 1
        end
    end

    img
end

# ═══════════════════════════════════════════════════════════════
# PNG encoder
# ═══════════════════════════════════════════════════════════════

encode(img: any): str
    out = "\137PNG\r\n\26\n"
    w = std.image.rect_dx(img.rect)
    h = std.image.rect_dy(img.rect)

    # IHDR chunk (13 bytes)
    ihdr_data = string.char(
        (w / 16777216) % 256, (w / 65536) % 256, (w / 256) % 256, w % 256,
        (h / 16777216) % 256, (h / 65536) % 256, (h / 256) % 256, h % 256,
        8, 6, 0, 0, 0
    )
    out = out .. 0:char(0, 0, 13) .. "IHDR" .. ihdr_data
    ihdr_crc = crc32_bytes("IHDR" .. ihdr_data)
    out = out .. string.char(
        (ihdr_crc / 16777216) % 256, (ihdr_crc / 65536) % 256, (ihdr_crc / 256) % 256, ihdr_crc % 256
    )

    # IDAT chunk: build raw filtered data (filter type 0 = None for each row)
    raw = ""
    for y = 0, h - 1
        raw = raw .. 0:char() # filter: none
        for x = 0, w - 1
            c = std.image.img_at(img, x, y)
            r = (c.r / 257) % 256
            g = (c.g / 257) % 256
            b = (c.b / 257) % 256
            a = (c.a / 257) % 256
            raw = raw .. r:char(g, b, a)
        end
    end

    # Zlib wrapper: store block (uncompressed deflate)
    zlib_header = 0x78:char(0x01)
    deflate_block = 0x01:char() # BFINAL=1, BTYPE=00 (stored)
    len = raw:len()
    # LEN is the 16-bit length, NLEN is its one's complement
    nlen = 0xFFFF ~ len
    deflate_block = deflate_block .. len % 256:char(len / 256:floor() % 256, nlen % 256, nlen / 256:floor() % 256)
    deflate_block = deflate_block .. raw

    # Adler-32 checksum
    adler_a = 1
    adler_b = 0
    for i = 1, raw:len()
        adler_a = (adler_a + raw:byte(i)) % 65521
        adler_b = (adler_b + adler_a) % 65521
    end
    # Adler-32 is stored as (A << 16) | B in big-endian
    adler32_check = adler_a * 65536 + adler_b

    idat_data = zlib_header .. deflate_block .. string.char(
        (adler32_check / 16777216) % 256, (adler32_check / 65536) % 256, (adler32_check / 256) % 256, adler32_check % 256
    )

    idat_len = idat_data:len()
    out = out .. string.char(
        (idat_len / 16777216) % 256, (idat_len / 65536) % 256, (idat_len / 256) % 256, idat_len % 256
    ) .. "IDAT" .. idat_data
    idat_crc = crc32_bytes("IDAT" .. idat_data)
    out = out .. string.char(
        (idat_crc / 16777216) % 256, (idat_crc / 65536) % 256, (idat_crc / 256) % 256, idat_crc % 256
    )

    # IEND chunk
    iend_crc = crc32_bytes("IEND")
    out = out .. 0:char(0, 0, 0) .. "IEND" .. string.char(
        (iend_crc / 16777216) % 256, (iend_crc / 65536) % 256, (iend_crc / 256) % 256, iend_crc % 256
    )
    out
end

