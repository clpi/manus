-- std.encoding_json — JSON encoder/decoder (mirrors Go's encoding/json)
-- All recursive helpers are merged into single self-referencing functions
-- because Duo does not support forward references between functions.
-- Error handling uses p.err field instead of multi-return to avoid codegen issues.

-- marshal: encode a Duo value as a JSON string.
marshal(v: any): str
    if v == nil return "null" end
    t = type(v)
    if t == "nil" return "null" end
    if t == "boolean"
        if v return "true" end
        return "false"
    end
    if t == "number"
        if math.floor(v) == v and math.abs(v) < 1e15
            return tostring(math.floor(v))
        end
        return string.format("%.17g", v)
    end
    if t == "string"
        out = {"\""}
        i = 1
        while i <= string.len(v)
            ch = string.sub(v, i, i)
            b = string.byte(v, i)
            if ch == "\""
                out[rawlen(out) + 1] = "\\\""
            elseif ch == "\\"
                out[rawlen(out) + 1] = "\\\\"
            elseif ch == "\n"
                out[rawlen(out) + 1] = "\\n"
            elseif ch == "\r"
                out[rawlen(out) + 1] = "\\r"
            elseif ch == "\t"
                out[rawlen(out) + 1] = "\\t"
            elseif b < 32
                out[rawlen(out) + 1] = string.format("\\u%04x", b)
            else
                out[rawlen(out) + 1] = ch
            end
            i += 1
        end
        out[rawlen(out) + 1] = "\""
        return table.concat(out)
    end
    if t == "table"
        n = rawlen(v)
        count = 0
        for _ in pairs(v) do count += 1 end
        if n > 0 and count == n
            -- array
            out = {"["}
            i = 1
            while i <= n
                out[rawlen(out) + 1] = marshal(v[i])
                if i < n out[rawlen(out) + 1] = "," end
                i += 1
            end
            out[rawlen(out) + 1] = "]"
            return table.concat(out)
        else
            -- object
            keys = {}
            for mk in pairs(v) do
                if type(mk) == "string"
                    keys[rawlen(keys) + 1] = mk
                end
            end
            if rawlen(keys) == 0 return "{}" end
            table.sort(keys)
            out = {"{"}
            i = 1
            while i <= rawlen(keys)
                k = keys[i]
                -- encode key as string
                key_out = {"\""}
                j = 1
                while j <= string.len(k)
                    ch = string.sub(k, j, j)
                    b = string.byte(k, j)
                    if ch == "\""
                        key_out[rawlen(key_out) + 1] = "\\\""
                    elseif ch == "\\"
                        key_out[rawlen(key_out) + 1] = "\\\\"
                    elseif b < 32
                        key_out[rawlen(key_out) + 1] = string.format("\\u%04x", b)
                    else
                        key_out[rawlen(key_out) + 1] = ch
                    end
                    j += 1
                end
                key_out[rawlen(key_out) + 1] = "\""
                out[rawlen(out) + 1] = table.concat(key_out)
                out[rawlen(out) + 1] = ":"
                out[rawlen(out) + 1] = marshal(v[k])
                if i < rawlen(keys) out[rawlen(out) + 1] = "," end
                i += 1
            end
            out[rawlen(out) + 1] = "}"
            return table.concat(out)
        end
    end
    "null"
end

-- skip_ws: skip whitespace in the parser.
skip_ws(p: any): void
    while p.pos <= string.len(p.s)
        b = string.byte(p.s, p.pos)
        if b == 32 or b == 9 or b == 10 or b == 13
            p.pos = p.pos + 1
        else
            break
        end
    end
end

-- parse_value: parse a JSON value. Self-referencing for nested objects/arrays.
-- Sets p.err to an error string on failure (nil on success).
parse_value(p: any): any
    if p.err != nil return nil end
    skip_ws(p)
    if p.pos > string.len(p.s)
        p.err = "unexpected end of input"
        return nil
    end
    ch = string.sub(p.s, p.pos, p.pos)
    if ch == "{"
        -- parse object
        p.pos = p.pos + 1
        obj = {}
        skip_ws(p)
        if p.pos <= string.len(p.s) and string.sub(p.s, p.pos, p.pos) == "}"
            p.pos = p.pos + 1
            return obj
        end
        while true
            skip_ws(p)
            if p.pos > string.len(p.s)
                p.err = "unterminated object"
                return nil
            end
            if string.sub(p.s, p.pos, p.pos) != "\""
                p.err = "expected string key"
                return nil
            end
            -- parse key (inline string parse)
            p.pos = p.pos + 1
            key_out = {}
            while p.pos <= string.len(p.s)
                kch = string.sub(p.s, p.pos, p.pos)
                if kch == "\""
                    p.pos = p.pos + 1
                    break
                end
                if kch == "\\"
                    p.pos = p.pos + 1
                    if p.pos > string.len(p.s)
                        p.err = "unterminated string escape"
                        return nil
                    end
                    esc = string.sub(p.s, p.pos, p.pos)
                    if esc == "n" key_out[rawlen(key_out) + 1] = "\n"
                    elseif esc == "t" key_out[rawlen(key_out) + 1] = "\t"
                    elseif esc == "r" key_out[rawlen(key_out) + 1] = "\r"
                    elseif esc == "\"" key_out[rawlen(key_out) + 1] = "\""
                    elseif esc == "\\" key_out[rawlen(key_out) + 1] = "\\"
                    else key_out[rawlen(key_out) + 1] = esc
                    end
                else
                    key_out[rawlen(key_out) + 1] = kch
                end
                p.pos = p.pos + 1
            end
            key = table.concat(key_out)
            skip_ws(p)
            if p.pos > string.len(p.s) or string.sub(p.s, p.pos, p.pos) != ":"
                p.err = "expected colon"
                return nil
            end
            p.pos = p.pos + 1
            val = parse_value(p)
            if p.err != nil return nil end
            obj[key] = val
            skip_ws(p)
            if p.pos > string.len(p.s)
                p.err = "unterminated object"
                return nil
            end
            och = string.sub(p.s, p.pos, p.pos)
            if och == "}"
                p.pos = p.pos + 1
                return obj
            end
            if och != ","
                p.err = "expected comma or closing brace"
                return nil
            end
            p.pos = p.pos + 1
        end
        return nil
    end
    if ch == "["
        -- parse array
        p.pos = p.pos + 1
        arr = {}
        skip_ws(p)
        if p.pos <= string.len(p.s) and string.sub(p.s, p.pos, p.pos) == "]"
            p.pos = p.pos + 1
            return arr
        end
        while true
            val = parse_value(p)
            if p.err != nil return nil end
            arr[rawlen(arr) + 1] = val
            skip_ws(p)
            if p.pos > string.len(p.s)
                p.err = "unterminated array"
                return nil
            end
            ach = string.sub(p.s, p.pos, p.pos)
            if ach == "]"
                p.pos = p.pos + 1
                return arr
            end
            if ach != ","
                p.err = "expected comma or closing bracket"
                return nil
            end
            p.pos = p.pos + 1
        end
        return nil
    end
    if ch == "\""
        -- parse string
        p.pos = p.pos + 1
        out = {}
        while p.pos <= string.len(p.s)
            sch = string.sub(p.s, p.pos, p.pos)
            if sch == "\""
                p.pos = p.pos + 1
                return table.concat(out)
            end
            if sch == "\\"
                p.pos = p.pos + 1
                if p.pos > string.len(p.s)
                    p.err = "unterminated string escape"
                    return nil
                end
                esc = string.sub(p.s, p.pos, p.pos)
                if esc == "n" out[rawlen(out) + 1] = "\n"
                elseif esc == "r" out[rawlen(out) + 1] = "\r"
                elseif esc == "t" out[rawlen(out) + 1] = "\t"
                elseif esc == "\"" out[rawlen(out) + 1] = "\""
                elseif esc == "\\" out[rawlen(out) + 1] = "\\"
                elseif esc == "/" out[rawlen(out) + 1] = "/"
                elseif esc == "b" out[rawlen(out) + 1] = string.char(8)
                elseif esc == "f" out[rawlen(out) + 1] = string.char(12)
                elseif esc == "u"
                    hex = string.sub(p.s, p.pos + 1, p.pos + 4)
                    code = tonumber(hex, 16)
                    if code == nil
                        p.err = "invalid unicode escape"
                        return nil
                    end
                    out[rawlen(out) + 1] = string.char(code)
                    p.pos = p.pos + 4
                else
                    out[rawlen(out) + 1] = esc
                end
            else
                out[rawlen(out) + 1] = sch
            end
            p.pos = p.pos + 1
        end
        p.err = "unterminated string"
        return nil
    end
    if ch == "t"
        if string.sub(p.s, p.pos, p.pos + 3) == "true"
            p.pos = p.pos + 4
            return true
        end
        p.err = "invalid boolean"
        return nil
    end
    if ch == "f"
        if string.sub(p.s, p.pos, p.pos + 4) == "false"
            p.pos = p.pos + 5
            return false
        end
        p.err = "invalid boolean"
        return nil
    end
    if ch == "n"
        if string.sub(p.s, p.pos, p.pos + 3) == "null"
            p.pos = p.pos + 4
            return nil
        end
        p.err = "invalid null"
        return nil
    end
    if ch == "-" or (ch >= "0" and ch <= "9")
        start = p.pos
        if string.sub(p.s, p.pos, p.pos) == "-" p.pos = p.pos + 1 end
        while p.pos <= string.len(p.s)
            nch = string.sub(p.s, p.pos, p.pos)
            if (nch >= "0" and nch <= "9") or nch == "." or nch == "e" or nch == "E" or nch == "+" or nch == "-"
                p.pos = p.pos + 1
            else
                break
            end
        end
        num_str = string.sub(p.s, start, p.pos - 1)
        nv = tonumber(num_str)
        if nv == nil
            p.err = "invalid number"
            return nil
        end
        return nv
    end
    p.err = "unexpected character"
    nil
end

-- unmarshal: decode a JSON string into a Duo value.
unmarshal(s: str): any
    if s == nil return nil end
    s = string.gsub(s, "^%s+", "")
    s = string.gsub(s, "%s+$", "")
    if s == "" return nil end
    parser = {s = s, pos = 1, err = nil}
    v = parse_value(parser)
    if parser.err != nil return nil end
    skip_ws(parser)
    if parser.pos <= string.len(s) return nil end
    v
end

-- marshal_indent: encode a Duo value as indented JSON.
marshal_indent(v: any, indent: str): str
    if indent == nil indent = "  " end
    jstr = marshal(v)
    out = {}
    depth = 0
    i = 1
    in_string = false
    while i <= string.len(jstr)
        ch = string.sub(jstr, i, i)
        if in_string
            out[rawlen(out) + 1] = ch
            if ch == "\\" and i < string.len(jstr)
                out[rawlen(out) + 1] = string.sub(jstr, i + 1, i + 1)
                i += 2
            elseif ch == "\""
                in_string = false
                i += 1
            else
                i += 1
            end
        else
            if ch == "\""
                in_string = true
                out[rawlen(out) + 1] = ch
                i += 1
            elseif ch == "{" or ch == "["
                out[rawlen(out) + 1] = ch
                depth += 1
                out[rawlen(out) + 1] = "\n" .. string.rep(indent, depth)
                i += 1
            elseif ch == "}" or ch == "]"
                depth -= 1
                if depth < 0 depth = 0 end
                out[rawlen(out) + 1] = "\n" .. string.rep(indent, depth) .. ch
                i += 1
            elseif ch == ","
                out[rawlen(out) + 1] = ch
                out[rawlen(out) + 1] = "\n" .. string.rep(indent, depth)
                i += 1
            elseif ch == ":"
                out[rawlen(out) + 1] = ": "
                i += 1
            else
                out[rawlen(out) + 1] = ch
                i += 1
            end
        end
    end
    table.concat(out)
end

M = {}
M.marshal = marshal
M.unmarshal = unmarshal
M.marshal_indent = marshal_indent
M