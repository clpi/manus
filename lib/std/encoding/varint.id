# std.encoding.varint — Variable-length integer encodings
# Provides three common varint formats:
#   1. Base-128 varint (protobuf-style, unsigned)
#   2. ZigZag encoding (maps signed to unsigned for better compression)
#   3. LEB128 (DWARF/ELF style, signed and unsigned)
# ═══════════════════════════════════════════════════════════════
# Base-128 Varint (protobuf-style, unsigned)
# Each byte: 7 bits of data + 1 continuation bit (high bit)
# ═══════════════════════════════════════════════════════════════

write(buf: any, value: i64): void
    while value >= 0x80
        buf[#buf + 1] = (value & 0x7F) | 0x80:char()
        value = value >> 7
    end
    buf[#buf + 1] = value:char()
end

read(data: str, pos: any): i64
    result = 0
    shift = 0
    while true
        if pos[1] > #data
            error("varint: unexpected end of data")
        end
        byte = data:byte(pos[1])
        pos[1] += 1
        result = result | ((byte & 0x7F) << shift)
        if byte < 0x80
            break
        end
        shift += 7
        if shift >= 64
            error("varint: overflow")
        end
    end
    result
end

value: i64:len(): i64
    if value < 0x80 return 1 end
    if value < 0x4000 return 2 end
    if value < 0x200000 return 3 end
    if value < 0x10000000 return 4 end
    if value < 0x800000000 return 5 end
    if value < 0x40000000000 return 6 end
    if value < 0x2000000000000 return 7 end
    if value < 0x100000000000000 return 8 end
    if value < 0x8000000000000000 return 9 end
    10
end

# ═══════════════════════════════════════════════════════════════
# ZigZag encoding (protobuf-style, maps signed → unsigned)
# ZigZag(n) = (n << 1) ^ (n >> 63)
#   0 → 0, -1 → 1, 1 → 2, -2 → 3, ...
# ═══════════════════════════════════════════════════════════════

zigzag_encode(value: i64): i64
    (value << 1) ~ (value >> 63)
end

zigzag_decode(value: i64): i64
    (value >> 1) ~ -(value & 1)
end

write_zigzag(buf: any, value: i64): void
    write(buf, zigzag_encode(value))
end

read_zigzag(data: str, pos: any): i64
    zigzag_decode(read(data, pos))
end

# ═══════════════════════════════════════════════════════════════
# LEB128 (Little-Endian Base-128, DWARF/ELF style)
# Each byte: 7 bits of data + 1 continuation bit (high bit)
# Little-endian ordering (lsb first)
# ═══════════════════════════════════════════════════════════════

write_leb128(buf: any, value: i64): void
    repeat
        byte = value & 0x7F
        value = value >> 7
        if value != 0
            byte = byte | 0x80
        end
        buf[#buf + 1] = byte:char()
    until value == 0
end

read_leb128(data: str, pos: any): i64
    result = 0
    shift = 0
    while true
        if pos[1] > #data
            error("leb128: unexpected end of data")
        end
        byte = data:byte(pos[1])
        pos[1] += 1
        result = result | ((byte & 0x7F) << shift)
        if byte < 0x80
            break
        end
        shift += 7
        if shift >= 64
            error("leb128: overflow")
        end
    end
    result
end

write_signed_leb128(buf: any, value: i64): void
    more = true
    while more
        byte = value & 0x7F
        value = value >> 7
        if (value == 0 and (byte & 0x40) == 0) or (value == -1 and (byte & 0x40) != 0)
            more = false
        else
            byte = byte | 0x80
        end
        buf[#buf + 1] = byte:char()
    end
end

read_signed_leb128(data: str, pos: any): i64
    result = 0
    shift = 0
    while true
        if pos[1] > #data
            error("signed leb128: unexpected end of data")
        end
        byte = data:byte(pos[1])
        pos[1] += 1
        result = result | ((byte & 0x7F) << shift)
        shift += 7
        if byte < 0x80
            if shift < 64 and (byte & 0x40) != 0
                result = result | -(1 << shift)
            end
            break
        end
        if shift >= 64
            error("signed leb128: overflow")
        end
    end
    result
end

