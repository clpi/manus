-- std.encoding.pem — PEM encoding (mirrors Go's encoding/pem package)
-- Encode binary data as PEM-formatted ASCII.

line_width = 64

encode(b: any): str
    data = b.bytes
    typ = b.type
    b64 = std.base64.encode(data)
    lines = {}
    lines[rawlen(lines) + 1] = "-----BEGIN " .. typ .. "-----"
    i = 1
    while i <= #b64
        chunk = string.sub(b64, i, i + line_width - 1)
        lines[rawlen(lines) + 1] = chunk
        i += line_width
    end
    lines[rawlen(lines) + 1] = "-----END " .. typ .. "-----"
    table.concat(lines, "\n")
end

decode(data: str): any
    if data == nil return nil end
    begin_marker = nil
    end_marker = nil
    typ = nil
    b64_lines = {}
    for line in string.gmatch(data, "[^\n]+")
        trimmed = string.trim(line)
        if string.sub(trimmed, 1, 11) == "-----BEGIN "
            typ = string.sub(trimmed, 12, #trimmed - 5)
            begin_marker = trimmed
        elseif string.sub(trimmed, 1, 9) == "-----END "
            end_marker = trimmed
        elseif begin_marker != nil and end_marker == nil
            if #trimmed > 0
                b64_lines[rawlen(b64_lines) + 1] = trimmed
            end
        end
    end
    if typ == nil return nil end
    b64_data = table.concat(b64_lines)
    bytes = std.base64.decode(b64_data)
    return {type = typ, headers = {}, bytes = bytes}
end

new(typ: str, data: str): any
    {type = typ, headers = {}, bytes = data}
end

