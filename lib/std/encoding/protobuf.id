# std.encoding.protobuf — Protocol Buffers encoding/decoding
# Minimal implementation for wire format (varint, length-delimited, fixed32/64)

# Wire types
WIRE_VARINT = 0
WIRE_64BIT = 1
WIRE_LENGTH_DELIMITED = 2
# WIRE_START_GROUP (3) and WIRE_END_GROUP (4) are not defined as bare
# constants: nothing in this module uses them, and once MOD-1 removes the
# explicit export table EVERY top-level binding becomes the surface — an
# UNUSED file-scope constant then gets REFERENCED by the emitted surface
# without being DEFINED ("use of undeclared identifier
# 'std_encoding_protobuf__WIRE_START_GROUP'"). Both values remain public
# through the WIRE table below, which is where callers read them.
WIRE_32BIT = 5

# ═══════════════════════════════════════════════════════════════
# Writer
# ═══════════════════════════════════════════════════════════════

writer_new(): any
    {bytes = {}}
end

write_varint(w: any, value: i64): void
    while value >= 0x80
        w.bytes[w:len().bytes + 1] = (value & 0x7F) | 0x80
        value = value >> 7
    end
    w.bytes[w:len().bytes + 1] = value
end

write_tag(w: any, field: i64, wire_type: i64): void
    write_varint(w, (field << 3) | wire_type)
end

write_field_varint(w: any, field: i64, value: i64): void
    write_tag(w, field, WIRE_VARINT)
    write_varint(w, value)
end

write_field_bytes(w: any, field: i64, data: any): void
    write_tag(w, field, WIRE_LENGTH_DELIMITED)
    write_varint(w, data:len())
    for b in data
        w.bytes[w:len().bytes + 1] = b
    end
end

write_field_string(w: any, field: i64, value: str): void
    write_tag(w, field, WIRE_LENGTH_DELIMITED)
    bytes = string_to_bytes(value)
    write_varint(w, bytes:len())
    for b in bytes
        w.bytes[w:len().bytes + 1] = b
    end
end

write_field_fixed32(w: any, field: i64, value: i64): void
    write_tag(w, field, WIRE_32BIT)
    w.bytes[w:len().bytes + 1] = value & 0xFF
    w.bytes[w:len().bytes + 1] = (value >> 8) & 0xFF
    w.bytes[w:len().bytes + 1] = (value >> 16) & 0xFF
    w.bytes[w:len().bytes + 1] = (value >> 24) & 0xFF
end

write_field_fixed64(w: any, field: i64, value: i64): void
    write_tag(w, field, WIRE_64BIT)
    i = 0
    while i < 8
        w.bytes[w:len().bytes + 1] = (value >> (i * 8)) & 0xFF
        i += 1
    end
end

write_field_float(w: any, field: i64, value: f64): void
    # IEEE 754 single-precision float encoding
    write_tag(w, field, WIRE_32BIT)
    # Convert to IEEE 754 float32 bytes
    if value != value
        # NaN
        w.bytes[w:len().bytes + 1] = 0x7F
        w.bytes[w:len().bytes + 1] = 0xC0
        w.bytes[w:len().bytes + 1] = 0x00
        w.bytes[w:len().bytes + 1] = 0x00
        return
    end
    if value == math.huge
        w.bytes[w:len().bytes + 1] = 0x7F
        w.bytes[w:len().bytes + 1] = 0x80
        w.bytes[w:len().bytes + 1] = 0x00
        w.bytes[w:len().bytes + 1] = 0x00
        return
    end
    if value == -math.huge
        w.bytes[w:len().bytes + 1] = 0xFF
        w.bytes[w:len().bytes + 1] = 0x80
        w.bytes[w:len().bytes + 1] = 0x00
        w.bytes[w:len().bytes + 1] = 0x00
        return
    end
    sign = 0
    if value < 0
        sign = 1
        value = -value
    end
    if value == 0
        w.bytes[w:len().bytes + 1] = sign * 128
        w.bytes[w:len().bytes + 1] = 0x00
        w.bytes[w:len().bytes + 1] = 0x00
        w.bytes[w:len().bytes + 1] = 0x00
        return
    end
    # Decompose
    exp = 0
    while value >= 2
        value = value / 2
        exp += 1
    end
    while value < 1
        value = value * 2
        exp -= 1
    end
    mantissa = (value - 1) * (2^23)
    biased_exp = exp + 127
    b0 = sign * 128 + biased_exp / 2:floor() * 4 + mantissa / (2^23):floor()
    b1 = mantissa / (2^15):floor() % 256
    b2 = mantissa / (2^7):floor() % 256
    b3 = (mantissa * 2) % 256
    w.bytes[w:len().bytes + 1] = b0
    w.bytes[w:len().bytes + 1] = b1
    w.bytes[w:len().bytes + 1] = b2
    w.bytes[w:len().bytes + 1] = b3
end

read_field_float(r: any): f64
    # Read IEEE 754 single-precision float
    if r.pos + 3 > r.len return 0.0 end
    b0 = r.data[r.pos]
    b1 = r.data[r.pos + 1]
    b2 = r.data[r.pos + 2]
    b3 = r.data[r.pos + 3]
    r.pos += 4
    sign = 1
    if b0 >= 128
        sign = -1
        b0 = b0 - 128
    end
    exp = b0 / 2:floor() * 16 + b1 / 16:floor()
    mantissa = (b0 % 2) * (2^23) + b1 * (2^15) + b2 * (2^7) + b3
    if exp == 0 return sign * mantissa * (2^-149) end
    if exp == 255
        if mantissa == 0 return sign * math.huge end
        return 0/0
    end
    sign * (1 + mantissa * (2^-23)) * (2^(exp - 127))
end

writer_bytes(w: any): any
    w.bytes
end

# ═══════════════════════════════════════════════════════════════
# Reader
# ═══════════════════════════════════════════════════════════════

reader_new(data: any): any
    {data = data, pos = 1, len = data:len()}
end

reader_varint(r: any): any
    result = 0
    shift = 0
    while true
        if r.pos > r.len return nil end
        byte = r.data[r.pos]
        r.pos = r.pos + 1
        result = result | ((byte & 0x7F) << shift)
        shift += 7
        if (byte & 0x80) == 0 break end
    end
    result
end

reader_tag(r: any): any
    val = reader_varint(r)
    if val == nil return nil end
    {field = val >> 3, wire_type = val & 0x07}
end

reader_skip_field(r: any, wire_type: i64): void
    if wire_type == WIRE_VARINT
        reader_varint(r)
    elseif wire_type == WIRE_64BIT
        r.pos = r.pos + 8
    elseif wire_type == WIRE_LENGTH_DELIMITED
        len = reader_varint(r)
        r.pos = r.pos + len
    elseif wire_type == WIRE_32BIT
        r.pos = r.pos + 4
    end
end

reader_field_bytes(r: any, wire_type: i64): any
    if wire_type != WIRE_LENGTH_DELIMITED return nil end
    len = reader_varint(r)
    out = {}
    i = 0
    while i < len
        out[out:len() + 1] = r.data[r.pos]
        r.pos = r.pos + 1
        i += 1
    end
    out
end

reader_field_string(r: any, wire_type: i64): str
    bytes = reader_field_bytes(r, wire_type)
    if bytes == nil return "" end
    bytes_to_string(bytes)
end

reader_field_fixed32(r: any, wire_type: i64): any
    if wire_type != WIRE_32BIT return nil end
    b0 = r.data[r.pos]
    b1 = r.data[r.pos + 1]
    b2 = r.data[r.pos + 2]
    b3 = r.data[r.pos + 3]
    r.pos = r.pos + 4
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
end

reader_field_fixed64(r: any, wire_type: i64): any
    if wire_type != WIRE_64BIT return nil end
    result = 0
    i = 0
    while i < 8
        result = result | (r.data[r.pos + i] << (i * 8))
        i += 1
    end
    r.pos = r.pos + 8
    result
end

# ═══════════════════════════════════════════════════════════════
# Helper functions
# ═══════════════════════════════════════════════════════════════

string_to_bytes(s: str): any
    out = {}
    i = 1
    while i <= s:len()
        out[out:len() + 1] = s:byte(i)
        i += 1
    end
    out
end

bytes_to_string(bytes: any): str
    parts = {}
    i = 1
    while i <= bytes:len()
        parts[parts:len() + 1] = bytes[i]:char()
        i += 1
    end
    parts:concat()
end

# ═══════════════════════════════════════════════════════════════
# Schema definition helpers
# ═══════════════════════════════════════════════════════════════

message_new(fields: any): any
    {
        type = "protobuf_message",
        fields = fields,  # {name = {field_num, wire_type, type}}
    }
end

field_def(field_num: i64, wire_type: i64, type_name: str): any
    {field_num = field_num, wire_type = wire_type, type = type_name}
end

# Encode a message from a table of field values
message_encode(schema: any, values: any): any
    w = writer_new()
    for name, field_def in schema.fields
        value = values[name]
        if value != nil
            if field_def.type == "varint"
                write_field_varint(w, field_def.field_num, value)
            elseif field_def.type == "string"
                write_field_string(w, field_def.field_num, value)
            elseif field_def.type == "bytes"
                write_field_bytes(w, field_def.field_num, value)
            elseif field_def.type == "fixed32"
                write_field_fixed32(w, field_def.field_num, value)
            elseif field_def.type == "fixed64"
                write_field_fixed64(w, field_def.field_num, value)
            end
        end
    end
    writer_bytes(w)
end

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

# MOD-1: the file IS the module. Identity re-exports deleted; the few
# exports that carried real content are ordinary top-level bindings now.
# Writer
# Reader
# Helpers
# Schema
# Wire type constants
# Literals, not references to the WIRE_* constants above. Referencing a
# file-scope constant from inside a nested table emits a bare, UNDECLARED
# identifier when the module is EMBEDDED ("use of undeclared identifier
# 'WIRE_START_GROUP'"), though it resolves fine standalone. Same compiler gap
# as lib/std/net/ws.id's opcode table; reduced there to a two-file repro.
WIRE = {
    VARINT = 0,
    FIXED64 = 1,
    LENGTH_DELIMITED = 2,
    START_GROUP = 3,
    END_GROUP = 4,
    FIXED32 = 5,
}
