-- std.proof — Pass 27 proof helpers (codegen-safe; no json.decode/inspect on hot path).
sha256(data: str): str
    p = string.gsub(std.script.fs_tmp(), "\n", "")
    std.script.fs_write(p, data)
    h = string.match(std.script.capture("shasum -a 256 '" .. p .. "' 2>/dev/null"), "(%x+)") or ""
    std.script.fs_rm(p)
    h
end

result_rows(output: str): any
    rows = {}
    for line in string.gmatch(output, "[^\n]+")
        rid, val = string.match(line, "^RESULT%s+(%S+)%s+(.*)$")
        if rid != nil
            rows[rawlen(rows) + 1] = rid .. " " .. val
        end
    end
    table.sort(rows)
    rows
end

result_hash(output: str): str
    sha256(table.concat(result_rows(output), "\n"))
end

count_results(output: str): i64
    n = 0
    for line in string.gmatch(output, "[^\n]+")
        if string.match(line, "^RESULT%s+") != nil
            n += 1
        end
    end
    n
end

artifact_path(stem: str, prefer_native: bool): str
    native = "/tmp/duo_" .. stem .. "_native.o.proof.json"
    cpath = "/tmp/duo_" .. stem .. ".c.proof.json"
    if prefer_native and std.script.fs_exists(native)
        return native
    end
    cpath
end

proof_field_int(text: str, key: str): i64
    _, _, val = string.find(text, '"' .. key .. '":(%d+)')
    if val == nil
        return 0
    end
    tonumber(val)
end

proof_field_str(text: str, key: str): str
    _, _, val = string.find(text, '"' .. key .. '":"([^"]+)"')
    if val == nil
        return ""
    end
    val
end

load_emission(path: str): any
    text = std.script.fs_read(path)
    out = {
        boxes = proof_field_int(text, "boxes"),
        unboxes = proof_field_int(text, "unboxes"),
        generic_table_ops = proof_field_int(text, "generic_table_ops"),
        evidence_class = proof_field_str(text, "evidence_class"),
    }
    out
end

artifact_fingerprint(path: str): str
    sha256(std.script.fs_read(path))
end

bench_profiles(): any
    out = {}
    out[1] = { id = "c-dynamic", native = 0, expect_results = 10 }
    out[2] = { id = "c-specialized", native = 0, expect_results = 10 }
    out[3] = { id = "direct", native = 1, expect_results = 0 }
    out
end

M = {
    sha256 = sha256,
    result_hash = result_hash,
    count_results = count_results,
    artifact_path = artifact_path,
    load_emission = load_emission,
    artifact_fingerprint = artifact_fingerprint,
    bench_profiles = bench_profiles,
}
