# std.bufio — buffered I/O utilities (mirrors Go's bufio package)
# Provides buffered readers/writers/scanners on top of std.io file handles.

io_mod = io

# new_reader: wrap a file handle in a buffered reader.
# Fields: fh (file handle), buf (string), pos (1-based cursor), err
new_reader(fh: any, size: i64): any
    if size == nil or size <= 0 size = 4096 end
    {fh = fh, buf = "", pos = 1, size = size, err = nil}
end

# reader_fill: read more data from the underlying handle into the buffer.
reader_fill(r: any): any
    chunk = r.fh:read(r.size)
    if chunk == nil
        r.err = "EOF"
        return r
    end
    r.buf = r.buf:sub(r.pos) .. chunk
    r.pos = 1
    r
end

# reader_read_line: read one line (without trailing newline). Returns (line, ok).
reader_read_line(r: any): any
    while true
        # look for newline in remaining buffer
        remaining = r.buf:sub(r.pos)
        nl = remaining:find("\n", 1, true)
        if nl != nil
            line = remaining:sub(1, nl - 1)
            # strip trailing \r
            if #line > 0 and line:sub(#line, #line) == "\r"
                line = line:sub(1, #line - 1)
            end
            r.pos = r.pos + nl
            return line, true
        end
        # no newline yet, try to fill
        old_len = r.buf:sub(r.pos):len()
        reader_fill(r)
        if has(.err)(r)
            # return whatever is left
            left = r.buf:sub(r.pos)
            if #left > 0
                r.pos = #r.buf + 1
                return left, true
            end
            return "", false
        end
    end
    return "", false
end

# reader_read_bytes: read n bytes. Returns (bytes, ok).
reader_read_bytes(r: any, n: i64): any
    while r.buf:sub(r.pos):len() < n
        reader_fill(r)
        if has(.err)(r)
            left = r.buf:sub(r.pos)
            if #left > 0
                r.pos = #r.buf + 1
                return left, true
            end
            return "", false
        end
    end
    data = r.buf:sub(r.pos, r.pos + n - 1)
    r.pos = r.pos + n
    return data, true
end

# reader_read_string: alias for read_bytes (same semantics in Duo).
reader_read_string(r: any, n: i64): any
    reader_read_bytes(r, n)
end

# reader_read_byte: read a single byte value. Returns (byte, ok).
reader_read_byte(r: any): any
    while r.pos > #r.buf
        reader_fill(r)
        if has(.err)(r) return 0, false end
    end
    b = r.buf:byte(r.pos)
    r.pos = r.pos + 1
    return b, true
end

# reader_unread_byte: move cursor back one byte.
reader_unread_byte(r: any): any
    if r.pos > 1 r.pos = r.pos - 1 end
    r
end

# reader_peek: peek n bytes without consuming them.
reader_peek(r: any, n: i64): any
    while r.buf:sub(r.pos):len() < n
        reader_fill(r)
        if has(.err)(r) break end
    end
    r.buf:sub(r.pos, r.pos + n - 1)
end

# ----- Scanner -----

# new_scanner: create a scanner that splits input on a delimiter (default "\n").
new_scanner(fh: any, delim: str): any
    if delim == nil delim = "\n" end
    {fh = fh, buf = "", pos = 1, delim = delim, done = false, size = 4096}
end

# scanner_scan: advance to the next token. Returns true if a token is available.
scanner_scan(s: any): bool
    if s.done return false end
    while true
        remaining = s.buf:sub(s.pos)
        pos = remaining:find(s.delim, 1, true)
        if pos != nil
            s.token = remaining:sub(1, pos - 1)
            s.pos = s.pos + pos + #s.delim - 1
            return true
        end
        # need more data
        chunk = s.fh:read(s.size)
        if chunk == nil
            s.done = true
            left = s.buf:sub(s.pos)
            if #left > 0
                s.token = left
                s.pos = #s.buf + 1
                return true
            end
            return false
        end
        s.buf = s.buf:sub(s.pos) .. chunk
        s.pos = 1
    end
    false
end

# scanner_text: return the current token.
scanner_text(s: any): str
    s.token
end

# scanner_bytes: alias for scanner_text (strings ARE byte sequences in Duo).
scanner_bytes(s: any): str
    s.token
end

# ----- Writer -----

# new_writer: create a buffered writer wrapping a file handle.
new_writer(fh: any, size: i64): any
    if size == nil or size <= 0 size = 4096 end
    {fh = fh, buf = "", size = size}
end

# writer_flush: write all buffered data to the underlying handle.
writer_flush(w: any): any
    if #w.buf > 0
        w.fh:write(w.buf)
        w.buf = ""
    end
    w
end

# writer_write: buffer a string for later flushing.
writer_write(w: any, s: str): any
    w.buf = w.buf .. s
    if #w.buf >= w.size
        writer_flush(w)
    end
    w
end

# writer_write_byte: buffer a single byte.
writer_write_byte(w: any, b: i64): any
    w.buf = w.buf .. b:char()
    if #w.buf >= w.size
        writer_flush(w)
    end
    w
end

# writer_close: flush and close.
writer_close(w: any): any
    writer_flush(w)
    w.fh:close()
    w
end

