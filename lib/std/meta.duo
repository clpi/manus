fun std_meta_typeof(x)
    if x == nil then return "nil" end
    if type(x) ~= "table" then return type(x) end
    if getmetatable(x) ~= nil then
        mt = getmetatable(x)
        if mt.type ~= nil then return mt.type end
    end
    "table"
end

fun std_meta_is(x, kind)
    std_meta_typeof(x) == kind
end

fun std_meta_is_nil(x)
    x == nil
end

fun std_meta_is_bool(x)
    type(x) == "boolean"
end

fun std_meta_is_number(x)
    type(x) == "number"
end

fun std_meta_is_str(x)
    type(x) == "string"
end

fun std_meta_is_table(x)
    type(x) == "table"
end

fun std_meta_is_func(x)
    type(x) == "function"
end

fun std_meta_len(x)
    #x
end

fun std_meta_keys(t)
    ks = std.collections.list_new()
    for k, _ in pairs(t)
        std.collections.list_push(ks, k)
    end
    ks
end

fun std_meta_values(t)
    vs = std.collections.list_new()
    for _, v in pairs(t)
        std.collections.list_push(vs, v)
    end
    vs
end

fun std_meta_has_key(t, key)
    t[key] ~= nil
end

fun std_meta_clone(t)
    c = {}
    for k, v in pairs(t)
        c[k] = v
    end
    c
end

fun std_meta_merge(dst, src)
    for k, v in pairs(src)
        dst[k] = v
    end
    dst
end

M = {}
M.typeof = std_meta_typeof
M.is = std_meta_is
M.is_nil = std_meta_is_nil
M.is_bool = std_meta_is_bool
M.is_number = std_meta_is_number
M.is_str = std_meta_is_str
M.is_table = std_meta_is_table
M.is_func = std_meta_is_func
M.len = std_meta_len
M.keys = std_meta_keys
M.values = std_meta_values
M.has_key = std_meta_has_key
M.clone = std_meta_clone
M.merge = std_meta_merge
M