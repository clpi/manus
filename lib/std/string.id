-- std.string — string helper utilities

std_string_is_empty(s: any): bool
    s == nil or #s == 0
end

std_string_starts_with(s: any, prefix: any): bool
    if s == nil or prefix == nil return false end
    s:sub(1, #prefix) == prefix
end

std_string_ends_with(s: any, suffix: any): bool
    if s == nil or suffix == nil return false end
    n = #suffix
    if n == 0 return true end
    if n > #s return false end
    s:sub(-n, -1) == suffix
end

std_string_contains(s: any, needle: any): bool
    if s == nil or needle == nil return false end
    string.find(s, needle, 1, true) != nil
end

std_string_is_space(ch: any): bool
    ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
end

std_string_trim(s: any): any
    if s == nil return "" end
    first = 1
    last = #s
    while first <= last and std_string_is_space(s:sub(first, first))
        first += 1
    end
    while last >= first and std_string_is_space(s:sub(last, last))
        last -= 1
    end
    if last < first return "" end
    s:sub(first, last)
end

std_string_ltrim(s: any): any
    if s == nil return "" end
    first = 1
    last = #s
    while first <= last and std_string_is_space(s:sub(first, first))
        first += 1
    end
    s:sub(first)
end

std_string_rtrim(s: any): any
    if s == nil return "" end
    last = #s
    while last >= 1 and std_string_is_space(s:sub(last, last))
        last -= 1
    end
    if last < 1 return "" end
    s:sub(1, last)
end

std_string_split(s: any, sep: any): any
    out = {}
    if s == nil return out end
    if sep == nil or sep == ""
        for i = 1, #s
            out[rawlen(out) + 1] = s:sub(i, i)
        end
        return out
    end
    rest = s
    while true
        pos = string.find(rest, sep)
        if pos == nil
            out[rawlen(out) + 1] = rest
            break
        end
        out[rawlen(out) + 1] = rest:sub(1, pos - 1)
        rest = rest:sub(pos + #sep)
    end
    out
end

std_string_join(parts: any, sep: any): any
    if sep == nil sep = "" end
    table.concat(parts, sep)
end

std_string_replace_all(s: any, needle: any, repl: any): any
    if s == nil return "" end
    if needle == nil or needle == "" return s end
    if repl == nil repl = "" end
    parts = std_string_split(s, needle)
    table.concat(parts, repl)
end

std_string_repeat_str(s: any, n: any): any
    if s == nil return "" end
    if n == nil or n <= 0 return "" end
    string.rep(s, n)
end

std_string_lines(s: any): any
    if s == nil or s == "" return {} end
    std_string_split(s, "\n")
end

std_string_to_upper(s: any): any
    if s == nil return "" end
    string.upper(s)
end

std_string_to_lower(s: any): any
    if s == nil return "" end
    string.lower(s)
end

std_string_capitalize(s: any): any
    if s == nil or s == "" return "" end
    string.upper(s:sub(1, 1)) .. string.lower(s:sub(2))
end

std_string_pad_left(s: any, width: any, pad: any): any
    if s == nil s = "" end
    if pad == nil or pad == "" pad = " " end
    n = width - #s
    if n <= 0 return s end
    string.rep(pad, n) .. s
end

std_string_pad_right(s: any, width: any, pad: any): any
    if s == nil s = "" end
    if pad == nil or pad == "" pad = " " end
    n = width - #s
    if n <= 0 return s end
    s .. string.rep(pad, n)
end

std_string_reverse(s: any): any
    if s == nil return "" end
    string.reverse(s)
end

std_string_count(s: any, pat: any): i64
    if s == nil or pat == nil or pat == "" return 0 end
    c = 0
    start = 1
    while true
        pos = string.find(s, pat, start, true)
        if pos == nil break end
        c += 1
        start = pos + #pat
    end
    c
end

std_string_index_of(s: any, pat: any): any
    if s == nil or pat == nil return nil end
    pos = string.find(s, pat, 1, true)
    if pos == nil return -1 end
    pos
end

std_string_last_index_of(s: any, pat: any): any
    if s == nil or pat == nil return nil end
    last = -1
    start = 1
    while true
        pos = string.find(s, pat, start, true)
        if pos == nil break end
        last = pos
        start = pos + 1
    end
    last
end

std_string_char_at(s: any, index: any): any
    if s == nil or index == nil return "" end
    if index < 1 or index > #s return "" end
    s:sub(index, index)
end

std_string_trim_prefix(s: any, prefix: any): any
    if s == nil or prefix == nil return s or "" end
    if std_string_starts_with(s, prefix)
        return s:sub(#prefix + 1)
    end
    s
end

std_string_trim_suffix(s: any, suffix: any): any
    if s == nil or suffix == nil return s or "" end
    if std_string_ends_with(s, suffix)
        return s:sub(1, #s - #suffix)
    end
    s
end

std_string_is_alpha(s: any): bool
    if s == nil or s == "" return false end
    return string["match"](s, "^[%a]+$") != nil
end

std_string_is_digit(s: any): bool
    if s == nil or s == "" return false end
    return string["match"](s, "^%d+$") != nil
end

std_string_is_alphanumeric(s: any): bool
    if s == nil or s == "" return false end
    return string["match"](s, "^[%w]+$") != nil
end

std_string_split_n(s: any, sep: any, n: any): any
    if s == nil return {} end
    if n == nil or n <= 0 return std_string_split(s, sep) end
    out = {}
    rest = s
    count = 0
    while count < n - 1
        pos = string.find(rest, sep)
        if pos == nil
            out[rawlen(out) + 1] = rest
            return out
        end
        out[rawlen(out) + 1] = rest:sub(1, pos - 1)
        rest = rest:sub(pos + #sep)
        count += 1
    end
    out[rawlen(out) + 1] = rest
    out
end

std_string_to_title_case(s: any): any
    if s == nil return "" end
    result = ""
    capitalize_next = true
    for i = 1, #s
        ch = s:sub(i, i)
        if ch == " " or ch == "-" or ch == "_"
            result = result .. ch
            capitalize_next = true
        elseif capitalize_next
            result = result .. string.upper(ch)
            capitalize_next = false
        else
            result = result .. string.lower(ch)
        end
    end
    result
end

std_string_repeat(s: any, n: any): any
    if s == nil return "" end
    if n == nil or n <= 0 return "" end
    string.rep(s, n)
end

std_string_replace(s: any, old: any, repl: any, n: any): any
    if s == nil return "" end
    if old == nil or old == "" return s end
    if repl == nil repl = "" end
    if n == nil or n <= 0
        return string.gsub(s, string.gsub(old, "([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1"), repl)
    end
    result, _ = string.gsub(s, string.gsub(old, "([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1"), repl, n)
    result
end

M = {}
M.is_empty = std_string_is_empty
M.starts_with = std_string_starts_with
M.ends_with = std_string_ends_with
M.contains = std_string_contains
M.is_space = std_string_is_space
M.trim = std_string_trim
M.ltrim = std_string_ltrim
M.rtrim = std_string_rtrim
M.trim_prefix = std_string_trim_prefix
M.trim_suffix = std_string_trim_suffix
M.split = std_string_split
M.split_n = std_string_split_n
M.join = std_string_join
M.replace_all = std_string_replace_all
M.replace = std_string_replace
M.repeat_str = std_string_repeat_str
M["repeat"] = std_string_repeat
M.lines = std_string_lines
M.to_upper = std_string_to_upper
M.to_lower = std_string_to_lower
M.to_title_case = std_string_to_title_case
M.capitalize = std_string_capitalize
M.pad_left = std_string_pad_left
M.pad_right = std_string_pad_right
M.reverse = std_string_reverse
M.count = std_string_count
M.index_of = std_string_index_of
M.last_index_of = std_string_last_index_of
M.char_at = std_string_char_at
M.is_alpha = std_string_is_alpha
M.is_digit = std_string_is_digit
M.is_alphanumeric = std_string_is_alphanumeric

-- The Lua-builtin surface, which this module never exposed. `std.string.byte`
-- and friends therefore resolved to a MISSING MEMBER and returned nil — no
-- error, no diagnostic, just nil where a byte should be. There are 431 such
-- calls across lib/: byte 130, len 103, sub 102, gsub 36, char 22, find 7,
-- upper/lower 4 each, rep 1. Every one of them was silently reading nil, which
-- is how lib/std/image/gif.id could load cleanly and still decode nothing.
--
-- These are projections, not reimplementations: one edge, and `string.*`
-- remains the thing that actually runs. Exposing them here is what makes the
-- ambient spelling `std.string.byte` mean what every caller already assumed.
-- `char` and `rep` are FORWARDING FUNCTIONS, not value aliases like the rest.
-- Aliasing a host function with VARIADIC or OPTIONAL arity through a module
-- produces wrong results: `std.string.char(104)` returned a value that
-- table.concat could not join past the first element (base32 decode returned
-- "h" for an 8-character group whose five bytes were all computed correctly),
-- and `std.string.rep("x", 2)` returned "xnil" -- the missing optional third
-- argument materialising as the literal text. Same root as the documented
-- variadic-module-export gap.
--
-- Both forwarders are SINGLE-SHAPE on purpose. A 4-parameter `char` with nil
-- guards does NOT work: every parameter is always passed, so the missing ones
-- never compare equal to nil and `string.char(a, b, c, d)` runs regardless --
-- `std.string.char(104)` came back four bytes long, printing as "h" because C
-- stops at the first null. The multi-argument call sites (all in
-- lib/std/image/png.id) use the host `string.char` directly instead.
char(c: any): any
    string.char(c)
end

rep(s: any, n: any): any
    string.rep(s, n)
end

M.byte = string.byte
M.char = char
M.len = string.len
M.sub = string.sub
M.find = string.find
M.gsub = string.gsub
M.gmatch = string.gmatch
M.match = string.match
M.format = string.format
M.rep = rep
M.upper = string.upper
M.lower = string.lower
M.reverse_raw = string.reverse

-- Names the module defines under a std_string_ prefix but never published
-- under the short spelling callers actually write.
M.trim = std_string_trim
M.split = std_string_split
M.join = std_string_join
M.contains = std_string_contains
M.starts_with = std_string_starts_with
M.ends_with = std_string_ends_with

M
