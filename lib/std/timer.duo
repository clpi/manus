-- std.timer — performance measurement, timing, and benchmarking
-- Provides high-resolution timers, lap tracking, and benchmark
-- utilities for measuring code performance.

-- Internal: round a number to nearest integer.
fun std_timer_round(x: any): i64
    math.floor(x + 0.5)
end

-- Internal: round a number to `places` decimal places.
fun std_timer_round_dec(x: any, places: any): any
    factor = 1
    i = 0
    while i < places
        factor = factor * 10
        i = i + 1
    end
    std_timer_round(x * factor) / factor
end

-- ===== Timer type =====

-- new: create a new timer, started immediately.
fun new_timer(): any
    {start = os.clock(), laps = {}, running = true, stopped_at = nil}
end

-- elapsed: return seconds since timer was created or last lap.
fun elapsed(t: any): any
    if t == nil then return 0 end
    if not t.running then return t.stopped_at - t.start end
    os.clock() - t.start
end

-- lap: record a lap time and return the elapsed time since start.
fun lap(t: any): any
    if t == nil then return 0 end
    now = os.clock()
    lap_time = now - t.start
    t.laps[rawlen(t.laps) + 1] = lap_time
    lap_time
end

-- lap_elapsed: return time since the last lap (or start if first lap).
fun lap_elapsed(t: any): any
    if t == nil then return 0 end
    now = os.clock()
    if rawlen(t.laps) == 0 then
        return now - t.start
    end
    now - t.laps[rawlen(t.laps)]
end

-- stop: stop the timer and return total elapsed time.
fun stop(t: any): any
    if t == nil then return 0 end
    t.stopped_at = os.clock()
    t.running = false
    t.stopped_at - t.start
end

-- reset: reset the timer to zero and restart.
fun reset(t: any): void
    if t == nil then return end
    t.start = os.clock()
    t.laps = {}
    t.running = true
    t.stopped_at = nil
end

-- is_running: check if the timer is still running.
fun is_running(t: any): bool
    if t == nil then return false end
    t.running
end

-- get_laps: return the list of recorded lap times.
fun get_laps(t: any): any
    if t == nil then return {} end
    t.laps
end

-- lap_count: return the number of recorded laps.
fun lap_count(t: any): i64
    if t == nil then return 0 end
    rawlen(t.laps)
end

-- ===== Formatting =====

-- format: format seconds into a human-readable string.
fun format(seconds: any): str
    if seconds == nil then return "0s" end
    if seconds < 0.001 then
        ms = seconds * 1000000
        return tostring(std_timer_round(ms)) .. "us"
    end
    if seconds < 1 then
        ms = seconds * 1000
        return tostring(std_timer_round(ms)) .. "ms"
    end
    if seconds < 60 then
        return tostring(std_timer_round_dec(seconds, 3)) .. "s"
    end
    mins = math.floor(seconds / 60)
    secs = seconds - mins * 60
    return tostring(mins) .. "m" .. tostring(std_timer_round_dec(secs, 1)) .. "s"
end

-- summary: return a summary table of all lap times.
fun summary(t: any): any
    if t == nil then return {} end
    laps = t.laps
    n = rawlen(laps)
    if n == 0 then
        return {count = 0, total = 0, min = 0, max = 0, avg = 0}
    end
    total = 0
    min_val = laps[1]
    max_val = laps[1]
    i = 1
    while i <= n
        if laps[i] < min_val then min_val = laps[i] end
        if laps[i] > max_val then max_val = laps[i] end
        total = total + laps[i]
        i = i + 1
    end
    {count = n, total = total, min = min_val, max = max_val, avg = total / n}
end

-- ===== Benchmarking =====

-- measure: run fn and return {result, elapsed_seconds}.
fun measure(fn_ref: any): any
    t = new_timer()
    r = fn_ref()
    d = stop(t)
    out = {}
    out.result = r
    out.elapsed = d
    out
end

-- time_it: run fn `n` times and return {total, avg, min, max}.
fun time_it(n: i64, fn_ref: any): any
    if n == nil or n < 1 then n = 1 end
    times = {}
    i = 0
    while i < n
        t = new_timer()
        fn_ref()
        stop(t)
        times[rawlen(times) + 1] = elapsed(t)
        i = i + 1
    end
    total = 0
    min_val = times[1]
    max_val = times[1]
    j = 1
    while j <= rawlen(times)
        if times[j] < min_val then min_val = times[j] end
        if times[j] > max_val then max_val = times[j] end
        total = total + times[j]
        j = j + 1
    end
    out = {}
    out.iterations = n
    out.total = total
    out.avg = total / n
    out.min = min_val
    out.max = max_val
    out.times = times
    out
end

-- bench: run fn until at least `min_seconds` have elapsed, report stats.
fun bench(fn_ref: any, min_seconds: float): any
    if min_seconds == nil then min_seconds = 0.1 end
    times = {}
    total = 0
    count = 0
    while total < min_seconds
        t = new_timer()
        fn_ref()
        stop(t)
        lap_time = elapsed(t)
        times[rawlen(times) + 1] = lap_time
        total = total + lap_time
        count = count + 1
    end
    min_val = times[1]
    max_val = times[1]
    i = 1
    while i <= rawlen(times)
        if times[i] < min_val then min_val = times[i] end
        if times[i] > max_val then max_val = times[i] end
        i = i + 1
    end
    out = {}
    out.iterations = count
    out.total = total
    out.avg = total / count
    out.min = min_val
    out.max = max_val
    out.ops_per_sec = count / total
    out
end

-- compare: run two functions and report which is faster.
fun compare(name_a: str, fn_a: any, name_b: str, fn_b: any, n: i64): any
    if n == nil then n = 1000 end
    a = time_it(n, fn_a)
    b = time_it(n, fn_b)
    faster = ""
    ratio = 0
    if b.avg > 0 then
        ratio = a.avg / b.avg
    end
    if a.avg < b.avg then
        faster = name_a
    else
        faster = name_b
        if a.avg > 0 then ratio = b.avg / a.avg end
    end
    out = {}
    out[name_a] = a
    out[name_b] = b
    out.faster = faster
    out.ratio = ratio
    out
end

M = {}
M.new = new_timer
M.elapsed = elapsed
M.lap = lap
M.lap_elapsed = lap_elapsed
M.stop = stop
M.reset = reset
M.is_running = is_running
M.get_laps = get_laps
M.lap_count = lap_count
M.format = format
M.summary = summary
M.measure = measure
M.time_it = time_it
M.bench = bench
M.compare = compare
M
