-- std.concurrent — high-level concurrency primitives (Requirement 20.9)
-- Builds on std.sync's scheduler.  Provides go/wait/select/all patterns.

sync = require "std.sync"

-- Spawn a task and return a future channel (capacity 1) for its result.
-- result shape: {ok=bool, val=any, err=any}
fun go(fn: any, ...args): any
    fut = sync.channel(1)
    args_list = {args}
    sync.spawn(fun(): void
        ok, result = pcall(fn, table.unpack(args_list))
        if ok then
            sync.channel_send(fut, {ok = true, val = result})
        else
            sync.channel_send(fut, {ok = false, err = result})
        end
    end)
    fut
end

-- Await a future (blocks/yields until result available).
fun wait(fut: any): any
    r = sync.channel_recv(fut)
    if r == nil then return nil end
    if r.ok then
        r.val
    else
        error(r.err, 2)
    end
end

-- Run N tasks concurrently; return table of results in order.
fun all(tasks: any, ...args): any
    futs = {}
    -- tasks can be a list, or varargs
    if type(tasks) == "function" then
        args_list = {args}
        futs[1] = go(tasks, table.unpack(args_list))
    else
        for _, t in ipairs(tasks)
            if type(t) == "function" then
                futs[#futs + 1] = go(t)
            elseif type(t) == "table" and t[1] then
                futs[#futs + 1] = go(t[1], table.unpack(t, 2))
            end
        end
    end
    sync.run()
    results = {}
    for _, fut in ipairs(futs)
        results[#results + 1] = wait(fut)
    end
    results
end

-- Race: return the first completed future's result.
fun race(futs: any): any
    winner = sync.channel(1)
    for i, fut in ipairs(futs)
        sync.spawn(fun(): void
            val = sync.channel_recv(fut)
            sync.channel_try_recv(winner)  -- drain if already won
            sync.channel_send(winner, {idx = i, val = val})
        end)
    end
    sync.run()
    sync.channel_try_recv(winner)
end

-- Select: poll channels round-robin until one has data.
-- cases = {{ch=channel, fn=handler_fn}, ...}
-- Returns when one case fires; calls its fn with the value.
fun select(cases: any): any
    while true
        for _, c in ipairs(cases)
            val = sync.channel_try_recv(c.ch)
            if val ~= nil then
                if c.fn then c.fn(val) end
                val, c.ch
            end
        end
        sync.yield()
    end
end

-- Semaphore: counting semaphore built on a buffered channel.
fun semaphore(n: i64): any
    s = sync.channel(n)
    for _ = 1, n sync.channel_send(s, true) end
    {
        acquire = fun(): any sync.channel_recv(s) end,
        release = fun(): void sync.channel_send(s, true) end,
        try_acquire = fun(): bool sync.channel_try_recv(s) ~= nil end,
    }
end

-- WaitGroup: wait for N tasks to complete.
fun waitgroup(n: i64): any
    ch = sync.channel(n)
    {
        done = fun(): void sync.channel_send(ch, true) end,
        wait = fun(): void
            for _ = 1, n sync.channel_recv(ch) end
        end,
    }
end

M = {}
M.go         = go
M.wait       = wait
M.all        = all
M.race       = race
M.select     = select
M.semaphore  = semaphore
M.waitgroup  = waitgroup
M.spawn      = sync.spawn
M.run        = sync.run
M.yield      = sync.yield
M.channel    = sync.channel
M.channel_send  = sync.channel_send
M.channel_recv  = sync.channel_recv
M
