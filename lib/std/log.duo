fun std_log_level_new(name)
    { name = name, value = nil }
end

fun std_log_level_set_value(level, value)
    level.value = value
    level
end

fun std_log_debug(msg)
    io.write(string.format("[DEBUG] %s\n", msg))
end

fun std_log_info(msg)
    io.write(string.format("[INFO] %s\n", msg))
end

fun std_log_warn(msg)
    io.write(string.format("[WARN] %s\n", msg))
end

fun std_log_error(msg)
    io.write(string.format("[ERROR] %s\n", msg))
end

fun std_log_print(level, msg)
    if level == nil then
        io.write(string.format("%s\n", msg))
    else
        io.write(string.format("[%s] %s\n", level, msg))
    end
end

M = {}
M.level_new = std_log_level_new
M.level_set_value = std_log_level_set_value
M.debug = std_log_debug
M.info = std_log_info
M.warn = std_log_warn
M.error = std_log_error
M.print = std_log_print
M