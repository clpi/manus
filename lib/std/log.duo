-- std.log — structured logging with level filtering

global log_level = 1
global log_levels = {DEBUG = 0, INFO = 1, WARN = 2, ERROR = 3}

set_level(level: str): void
    if level == nil level = "DEBUG" end
    v = log_levels[level]
    if v != nil
        log_level = v
    end
end

get_level(): str
    for name, v in pairs(log_levels)
        if v == log_level return name end
    end
    "INFO"
end

debug(msg: str): void
    if log_level <= 0
        io.write(string.format("[DEBUG] %s\n", msg))
    end
end

info(msg: str): void
    if log_level <= 1
        io.write(string.format("[INFO] %s\n", msg))
    end
end

warn(msg: str): void
    if log_level <= 2
        io.write(string.format("[WARN] %s\n", msg))
    end
end

error(msg: str): void
    if log_level <= 3
        io.write(string.format("[ERROR] %s\n", msg))
    end
end

print(level: str, msg: str): void
    if level == nil
        io.write(string.format("%s\n", msg))
    else
        io.write(string.format("[%s] %s\n", string.upper(level), msg))
    end
end

with_fields(level: str, fields: any, msg: str): void
    if level == nil level = "INFO" end
    level_val = log_levels[string.upper(level)] or 1
    if level_val < log_level return end
    parts = {string.format("[%s] %s", string.upper(level), msg)}
    if fields != nil
        for k, v in pairs(fields)
            parts[rawlen(parts) + 1] = string.format("%s=%s", k, to(str)(v))
        end
    end
    io.write(table.concat(parts, " ") .. "\n")
end

