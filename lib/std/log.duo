-- std.log — structured logging

fun level_new(name: str): any
    { name = name, value = nil }
end

fun level_set_value(level: any, value: any): any
    level.value = value
    level
end

fun debug(msg: str): void
    io.write(string.format("[DEBUG] %s\n", msg))
end

fun info(msg: str): void
    io.write(string.format("[INFO] %s\n", msg))
end

fun warn(msg: str): void
    io.write(string.format("[WARN] %s\n", msg))
end

fun error(msg: str): void
    io.write(string.format("[ERROR] %s\n", msg))
end

fun print(level: str, msg: str): void
    if level == nil then
        io.write(string.format("%s\n", msg))
    else
        io.write(string.format("[%s] %s\n", level, msg))
    end
end

M = {}
M.level_new = level_new
M.level_set_value = level_set_value
M.debug = debug
M.info = info
M.warn = warn
M.error = error
M.print = print
M
