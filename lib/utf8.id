
char: str = (codepoint: int)
    utf8.char(codepoint)

codes: any = (s: str)
    utf8.codes(s)

codepoint: any = (s: str, i: int, j: int)
    utf8.codepoint(s, i, j)

len: any = (s: str, i: int, j: int)
    utf8.len(s, i, j)

offset: any = (s: str, n: int, i: int)
    utf8.offset(s, n, i)

charpattern = utf8.charpattern
