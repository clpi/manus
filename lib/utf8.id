# utf8 — utf-8 utilities

char: str = (codepoint: int)
    utf8.char(codepoint)

codes: any = (s: str)
    utf8.codes(s)

codepoint: any = (s: str, i: int, j: int)
    utf8.codepoint(s, i, j)

s: str, i: int, j: int:len(): any
    utf8.len(s, i, j)

offset: any = (s: str, n: int, i: int)
    utf8.offset(s, n, i)

# The only export that was not already a top-level binding: an alias onto the
# host's pattern constant.
charpattern = utf8.charpattern
