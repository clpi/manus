
@hot
fence: void = ()
  @comp.c.emit("__asm__ volatile(\"\" ::: \"memory\");")
  

@hot
spinwait: void = ()
  @comp.c.emit("#if defined(__x86_64__) || defined(__i386__)")
  
  @comp.c.emit("__asm__ volatile(\"pause\");")
  
  @comp.c.emit("#elif defined(__aarch64__)")
  
  @comp.c.emit("__asm__ volatile(\"yield\");")
  
  @comp.c.emit("#endif")
  
