# hardware — Host CPU hooks and low-level control primitives.
#
# Pair with `@device(.auto)` on kernels (see ml.device) and `simd.*` vector ops.
# For raw instructions use `@asm("template", outputs, inputs, clobbers)` in expressions.

# Compiler memory fence (prevents reordering across this point)
@hot
fence = ()
  @comp.c.emit("__asm__ volatile(\"\" ::: \"memory\");")
  

# Spin loop hint: x86 `pause`, AArch64 `yield`
@hot
spinwait = ()
  @comp.c.emit("if:len() defined(__x86_64__) || defined(__i386__)")
  
  @comp.c.emit("__asm__ volatile(\"pause\");")
  
  @comp.c.emit("elif:len() defined(__aarch64__)")
  
  @comp.c.emit("__asm__ volatile(\"yield\");")
  
  @comp.c.emit("endif:len()")
  
# Re-export ML device placement helpers (@device runtime table)
