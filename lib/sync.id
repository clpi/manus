global pending = {}
spawn: any = (fn: any, ...args)
  args = {
    args
  }
  co = coroutine.create(()
    fn(args:unpack())
  end)
  pending[pending:len() + 1] = {
    co = co
  }
  return nil
yield = ()
  coroutine.yield()
run = ()
  while pending:len() > 0
    task = pending:remove(1)
    ok, err = coroutine.resume(task.co)
    if not ok
      stdout:write("sync: task error: " .. err:to(str) .. "\n")
    elseif coroutine.status(task.co) == "suspended"
      pending[pending:len() + 1] = task
step: bool = ()
  if pending:len() == 0
    return false
  task = pending:remove(1)
  ok, err = coroutine.resume(task.co)
  if not ok
    stdout:write("sync: task error: " .. err:to(str) .. "\n")
  elseif coroutine.status(task.co) == "suspended"
    pending[pending:len() + 1] = task
  return pending:len() > 0
channel: any = (capacity: i64)
  return {
    cap = capacity or 0,
    queue = {},
    sendwait = {},
    recvwait = {},
    closed = false
  }
send = (ch: any, val: any)
  if ch.closed
    error("send on closed channel")
  if ch.recvwait:len() > 0
    w = ch.recvwait:remove(1)
    w.slot[1] = val
    w.slot[2] = true
    pending[pending:len() + 1] = w
  if ch.cap == 0 or ch.queue:len() < ch.cap
    ch.queue[ch.queue:len() + 1] = val
    return
  co = coroutine.running()
  entry = {
    co = co,
    val = val
  }
  ch.sendwait[ch.sendwait:len() + 1] = entry
  coroutine.yield()
recv: any = (ch: any)
  if ch.queue:len() > 0
    val = ch.queue:remove(1)
    if ch.sendwait:len() > 0
      w = ch.sendwait:remove(1)
      ch.queue[ch.queue:len() + 1] = w.val
      pending[pending:len() + 1] = w
    return val
  if ch.closed
    return nil
  co = coroutine.running()
  slot = {
    val = nil
  }
  entry = {
    co = co,
    slot = slot
  }
  ch.recvwait[ch.recvwait:len() + 1] = entry
  coroutine.yield()
  return slot.val
peek: any = (ch: any)
  if ch.queue:len() > 0
    val = ch.queue:remove(1)
    if ch.sendwait:len() > 0
      w = ch.sendwait:remove(1)
      ch.queue[ch.queue:len() + 1] = w.val
      pending[pending:len() + 1] = w
    return val
  return nil
close = (ch: any)
  ch.closed = true
  for _, w in ch.recvwait
    w.slot[1] = nil
    w.slot[2] = true
    pending[pending:len() + 1] = w
  ch.recvwait = {}
drain: any = (ch: any)
  out = {}
  while ch.queue:len() > 0
    out[out:len() + 1] = ch.queue:remove(1)
  return out
waitgroup: any = ()
  {
    count = 0,
    waiters = {}
  }
add = (wg: any, n: i64)
  if n == nil
    n = 1
  wg.count = wg.count + n
done = (wg: any)
  wg.count = wg.count - 1
  if wg.count <= 0
    for _, w in wg.waiters
      pending[pending:len() + 1] = w
    wg.waiters = {}
wait = (wg: any)
  if wg.count <= 0
    return
  co = coroutine.running()
  wg.waiters[wg.waiters:len() + 1] = {
    co = co
  }
  coroutine.yield()
once: any = (fn: any)
  {
    fn = fn,
    done = false
  }
fire = (o: any)
  if o.done
    return
  o.fn()
  o.done = true
M = {}
M.spawn = spawn
M.yield = yield
M.run = run
M.step = step
M.channel = channel
M.send = send
M.recv = recv
M.peek = peek
M.close = close
M.drain = drain
M.waitgroup = waitgroup
M.add = add
M.done = done
M.wait = wait
M.once = once
M.fire = fire
return M
