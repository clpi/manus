# compress.snappy — Snappy compression (fast, low-ratio)
# Snappy is used in many systems for its speed: LevelDB, RocksDB, Kafka, etc.

# ═══════════════════════════════════════════════════════════════
# Snappy format: varint length + literal runs + copy operations
# ═══════════════════════════════════════════════════════════════

# Snappy block size
SNAPPY_BLOCK_SIZE = 32768

# Compress data using Snappy-like algorithm
compress: any = (data: any)
  if data == nil or data:len() == 0
    return { 0 }

  src_len = data:len()
  out = {}

  # Write uncompressed length as varint
  write_varint(out, src_len)

  # Simple literal-only compression (fallback for correctness)
  # Real Snappy uses hash table for back-references
  i = 1
  while i <= src_len
    # Find longest match
    match_len, match_offset = find_match(data, i, src_len)

    if match_len >= 4
      # Emit copy operation
      # Copy with offset
      length = match_len - 4
      if length < 60
        out(out:len() + 1) = length << 2 | 1
      else(length < 256)
        out(out:len() + 1) = 59 << 2 | 1
        out(out:len() + 1) = length
      else
        out(out:len() + 1) = 60 << 2 | 1
        out(out:len() + 1) = length & 255
        out(out:len() + 1) = length >> 8 & 255
      # Write 2-byte little-endian offset
      out(out:len() + 1) = (match_offset - 1) & 255
      out(out:len() + 1) = (match_offset - 1) >> 8 & 255
      i = i + match_len
    else
      # Emit literal
      literal_start = i
      literal_len = 0
      while i <= src_len and literal_len < SNAPPY_BLOCK_SIZE
        ml, _ = find_match(data, i, src_len)
        if ml >= 4
          break
        literal_len = literal_len + 1
        i = i + 1

      # Write literal header
      if literal_len < 61
        out(out:len() + 1) = (literal_len - 1) << 2 | 0
      else(literal_len < 256)
        out(out:len() + 1) = 60 << 2 | 0
        out(out:len() + 1) = literal_len
      else
        out(out:len() + 1) = 61 << 2 | 0
        out(out:len() + 1) = literal_len & 255
        out(out:len() + 1) = literal_len >> 8 & 255

      # Write literal bytes
      j = literal_start
      while j < literal_start + literal_len
        out(out:len() + 1) = data(j)
        j = j + 1

  out

# Decompress Snappy data
decompress: any = (data: any)
  if data == nil or data:len() == 0
    return {}

  r = { pos = 1, data = data }
  src_len = read_varint(r)
  out = {}

  while r.pos <= data:len() and out:len() < src_len
    byte = data(r.pos)
    r.pos = r.pos + 1

    tag = byte & 3

    if tag == 0
      # Literal
      literal_len = byte >> 2 & 63
      if literal_len < 60
        literal_len = literal_len + 1
      else(literal_len == 60)
        literal_len = data(r.pos) + 1
        r.pos = r.pos + 1
      else(literal_len == 61)
        literal_len = (data(r.pos) + data(r.pos + 1)) << (8 + 1)
        r.pos = r.pos + 2

      i = 0
      while i < literal_len
        out(out:len() + 1) = data(r.pos)
        r.pos = r.pos + 1
        i = i + 1
    else(tag == 1)

      # Copy with 2-byte offset
      length = byte >> 2 & 63
      if length < 60
        length = length + 4
      else(length == 60)
        length = data(r.pos) + 4
        r.pos = r.pos + 1
      else(length == 61)
        length = (data(r.pos) + data(r.pos + 1)) << (8 + 4)
        r.pos = r.pos + 2
      offset = (data(r.pos) + data(r.pos + 1)) << (8 + 1)
      r.pos = r.pos + 2

      # Copy from output buffer
      src_pos = out:len() - offset + 1
      i = 0
      while i < length
        out(out:len() + 1) = out(src_pos + i)
        i = i + 1
    else(tag == 2)

      # Copy with 1-byte offset
      length = byte >> 2 & 63
      if length < 60
        length = length + 4
      else
        length = data(r.pos) + 4
        r.pos = r.pos + 1
      offset = data(r.pos) + 1
      r.pos = r.pos + 1

      src_pos = out:len() - offset + 1
      i = 0
      while i < length
        out(out:len() + 1) = out(src_pos + i)
        i = i + 1
    else(tag == 3)

      # Copy with 4-byte offset
      length = byte >> 2 & 63
      if length < 60
        length = length + 4
      else
        length = data(r.pos) + 4
        r.pos = r.pos + 1
      offset = (data(r.pos) + data(r.pos + 1)) << (8 + data(r.pos + 2)) << (16 + data(r.pos + 3)) << (24 + 1)
      r.pos = r.pos + 4

      src_pos = out:len() - offset + 1
      i = 0
      while i < length
        out(out:len() + 1) = out(src_pos + i)
        i = i + 1

  out

# Find longest match using simple hash chain
find_match: any = (data: any, pos: i64, src_len: i64)
  best_len = 0
  best_offset = 0
  max_len = 64:min(src_len - pos + 1)

  # Simple search (for correctness; real Snappy uses hash table)
  start = 1:max(pos - 32768)
  i = start
  while i < pos
    match_len = 0
    while match_len < max_len and data(i + match_len) == data(pos + match_len)
      match_len = match_len + 1
    if match_len > best_len
      best_len = match_len
      best_offset = pos - i
    i = i + 1

  best_len, best_offset

# Varint encoding/decoding
write_varint = (out: any, value: i64)
  while value >= 128
    out(out:len() + 1) = value & 127 | 128
    value = value >> 7
  out(out:len() + 1) = value

read_varint: i64 = (r: any)
  result = 0
  shift = 0
  while true
    byte = r.data(r.pos)
    r.pos = r.pos + 1
    result = result | (byte & 127) << shift
    shift = shift + 7
    if byte & 128 == 0
      break
  result
# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════
