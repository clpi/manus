
@comp.c.export("duo_str_sub")
sub: str = (s: str, i: i64, j: i64)
  return @comp.c.emit("({ size_t _n = strlen(s); long _i = (long)i, _j = (long)j; if (_i < 0) _i = (long)_n + _i + 1; if (_j < 0) _j = (long)_n + _j + 1; if (_i < 1) _i = 1; if (_j > (long)_n) _j = (long)_n; long _len = _j - _i + 1; if (_len < 0) _len = 0; char* _o = (char*)malloc((size_t)_len + 1); memcpy(_o, s + (_i - 1), (size_t)_len); _o[_len] = 0; (const char*)_o; })")

@comp.c.export("duo_str_len")
len: i64 = (s: str)
  s:len()
