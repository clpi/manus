
len: any = (t: any)
    if t == nil return 0 
    t:len()

keys: any = (t: any)
    out = {}
    if t == nil return out 
    for k, _ in t
        out[out:len() + 1] = k
    out

values: any = (t: any)
    out = {}
    if t == nil return out 
    for _, v in t
        out[out:len() + 1] = v
    out

clone: any = (t: any)
    out = {}
    if t == nil return out 
    for k, v in t
        out[k] = v
    out

merge: any = (a: any, b: any)
    out = clone(a)
    if b != nil
        for k, v in b
            out[k] = v
    out

index_of: any = (list: any, value: any)
    if list == nil return 0 
    i = 1
    while i <= list:len()
        v = list[i]
        if v == value return i 
        i += 1
    0

reverse: any = (list: any)
    out = {}
    if list == nil return out 
    i = list:len()
    while i >= 1
        out[out:len() + 1] = list[i]
        i -= 1
    out

map: any = (list: any, fn: any)
    out = {}
    if list == nil return out 
    i = 1
    while i <= list:len()
        v = list[i]
        out[i] = fn(v, i)
        i += 1
    out

filter: any = (list: any, fn: any)
    out = {}
    if list == nil return out 
    i = 1
    while i <= list:len()
        v = list[i]
        if fn(v, i)
            out[out:len() + 1] = v
        i += 1
    out

reduce: any = (list: any, fn: any, init: any)
    acc = init
    if list == nil return acc 
    i = 1
    while i <= list:len()
        v = list[i]
        acc = fn(acc, v, i)
        i += 1
    acc

clear = (t: any)
    if t == nil return 
    ks = keys(t)
    i = 1
    while i <= ks:len()
        rawset(t, ks[i], nil)
        i += 1

is_empty: bool = (t: any)
    if t == nil return true 
    for _, v in t
        if v != nil return false 
    true

slice: any = (t: any, start_idx: any, end_idx: any)
    out = {}
    if t == nil return out 
    if start_idx == nil start_idx = 1 
    if end_idx == nil end_idx = t:len() 
    if start_idx < 1 start_idx = 1 
    if end_idx > t:len() end_idx = t:len() 
    i = start_idx
    while i <= end_idx
        out[out:len() + 1] = t[i]
        i += 1
    out

concat: str = (t: any, sep: any)
    if t == nil return "" 
    if sep == nil sep = "" 
    t:concat(sep)

sort = (list: any, cmp: any)
    if list == nil return 
    if cmp == nil
        list:sort()
    else
        list:sort(cmp)

unpack: any = (list: any, i: any, j: any)
    if list == nil return nil 
    if i == nil i = 1 
    if j == nil j = list:len() 
    list:unpack(i, j)

insert = (list: any, pos: any, value: any)
    if list == nil return 
    if value == nil
        list:insert(pos)
    else
        list:insert(pos, value)

remove: any = (list: any, pos: any)
    if list == nil return nil 
    if pos == nil pos = list:len() 
    list:remove(pos)

count: i64 = (list: any, fn: any)
    c = 0
    if list == nil return c 
    if fn == nil return list:len() 
    i = 1
    while i <= list:len()
        if fn(list[i]) c += 1 
        i += 1
    c

flat: any = (list: any)
    out = {}
    if list == nil return out 
    i = 1
    while i <= list:len()
        item = list[i]
        if type(item) == "table"
            j = 1
            while j <= item:len()
                out[out:len() + 1] = item[j]
                j += 1
        else
            out[out:len() + 1] = item
        i += 1
    out

unique: any = (list: any)
    out = {}
    if list == nil return out 
    seen = {}
    i = 1
    while i <= list:len()
        v = list[i]
        key = v:to(str)
        if not seen[key]
            seen[key] = true
            out[out:len() + 1] = v
        i += 1
    out

zip: any = (lists: any)
    out = {}
    if lists == nil or lists:len() == 0 return out 
    min_len = lists[1]:len()
    i = 2
    while i <= lists:len()
        if lists[i]:len() < min_len
            min_len = lists[i]:len()
        i += 1
    j = 1
    while j <= min_len
        tuple = {}
        i = 1
        while i <= lists:len()
            tuple[tuple:len() + 1] = lists[i][j]
            i += 1
        out[out:len() + 1] = tuple
        j += 1
    out

from_pairs: any = (pairs: any)
    out = {}
    if pairs == nil return out 
    i = 1
    while i <= pairs:len()
        pair = pairs[i]
        if pair and pair:len() >= 2
            out[pair[1]] = pair[2]
        i += 1
    out

to_pairs: any = (t: any)
    out = {}
    if t == nil return out 
    for k, v in t
        out[out:len() + 1] = {k, v}
    out

pick: any = (t: any, keys: any)
    out = {}
    if t == nil or keys == nil return out 
    i = 1
    while i <= keys:len()
        k = keys[i]
        if t[k] != nil
            out[k] = t[k]
        i += 1
    out

omit: any = (t: any, keys: any)
    out = {}
    if t == nil return out 
    omit_set = {}
    if keys != nil
        i = 1
        while i <= keys:len()
            omit_set[keys[i]] = true
            i += 1
    for k, v in t
        if not omit_set[k]
            out[k] = v
    out

find: any = (list: any, fn: any)
    if list == nil return nil 
    i = 1
    while i <= list:len()
        if fn(list[i]) return list[i] 
        i += 1
    nil

every: bool = (list: any, fn: any)
    if list == nil return true 
    i = 1
    while i <= list:len()
        if not fn(list[i]) return false 
        i += 1
    true

some: bool = (list: any, fn: any)
    if list == nil return false 
    i = 1
    while i <= list:len()
        if fn(list[i]) return true 
        i += 1
    false

