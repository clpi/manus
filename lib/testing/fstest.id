# testing.fstest — filesystem test helpers (mirrors Go's testing/fstest)
# Provides a MapFS in-memory filesystem for testing file operations.

MapFS = {}
MapFS.__index = MapFS

new_mapfs: any = ()
  { files = {} }

mapfs_add = (fs: any, path: str, data: str)
  fs.files[path] =
    data = data
    mode = 644

mapfs_add_dir = (fs: any, path: str)
  fs.files[path] =
    data = nil
    mode = 755
    is_dir = true

mapfs_open: any = (fs: any, path: str)
  entry = fs.files(path)
  if entry == nil
    return nil
  { data = entry.data, pos = 1, mode = entry.mode, is_dir = entry.is_dir }

mapfs_read: any = (f: any, n: i64)
  if f.data == nil
    return nil
  if f.pos > f.data:len()
    return nil
  chunk = f.data:sub(f.pos, f.pos + n - 1)
  f.pos = f.pos + chunk:len()
  chunk

mapfs_read_all: str = (f: any)
  if f.data == nil
    return ""
  f.pos = f.data:len() + 1
  f.data

mapfs_seek: i64 = (f: any, offset: i64, whence: i64)
  if f.data == nil
    return 0
  if whence == 0
    f.pos = offset + 1
  else(whence == 1)
    f.pos = f.pos + offset
  else(whence == 2)
    f.pos = f.data:len() + offset + 1
  if f.pos < 1
    f.pos = 1
  f.pos - 1

mapfs_glob: any = (fs: any, pattern: str)
  results = {}
  for path, _ in fs.files
    if path:find(pattern)
      results[results:len() + 1] = path
  results
