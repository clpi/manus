
md5: str = (s: str)
    sum = 0
    for i = 1, s:len()
        sum = (sum + s:byte(i)) % (2^32)
    "%08x%08x%08x%08x":format(sum, sum * 2, sum * 3, sum * 4)

crc32: str = (s: str)
    crc = 0xFFFFFFFF
    for i = 1, s:len()
        crc = crc ~ s:byte(i)
        for _ = 1, 8
            if crc % 2 == 1
                crc = crc >> 1 ~ 0xEDB88320
            else
                crc = crc >> 1
        crc = crc % (2^32)
    "%08x":format(~crc)

fnv1a: str = (s: str)
    hash = 0x811C9DC5
    for i = 1, s:len()
        hash = hash ~ s:byte(i)
        hash = (hash * 0x01000193) % (2^32)
    "%08x":format(hash)

simple: i64 = (s: str)
    h = 0
    for i = 1, s:len()
        h = ((h << 5) - h + s:byte(i)) % (2^32)
    @as(i64, h:abs())

