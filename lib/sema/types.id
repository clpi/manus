tk_i64: i64 = ()
    1

tk_f64: i64 = ()
    2

tk_bool: i64 = ()
    3

tk_str: i64 = ()
    4

tk_nil: i64 = ()
    5

tk_any: i64 = ()
    6

tkname: str = (k: i64)
    if k == 1
        "i64"
    else if k == 2
        "f64"
    else if k == 3
        "bool"
    else if k == 4
        "str"
    else if k == 5
        "nil"
    else
        "any"

isnum: i64 = (k: i64)
    if k == 1
        1
    else if k == 2
        1
    else
        0

arithres: i64 = (lk: i64, rk: i64)
    if lk == 2 or rk == 2
        2
    else if lk == 1 and rk == 1
        1
    else
        6

bitres: i64 = (lk: i64, rk: i64)
    if lk == 1 and rk == 1
        1
    else
        6
