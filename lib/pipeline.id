

str_join: str = (parts: any, sep: str)
  result = ""
  for i, part in parts
    if i > 1
      result = result .. sep
    result = result .. part
  result


fuse_reduce: str = (data_name: str, elem_type: str, func_name: str, reduce_func: str, init: str)
  "/* [pipeline.fused] reduce */\nstatic " .. elem_type .. " " .. func_name .. "(const " .. elem_type .. "* " .. data_name .. ", size_t len) {\n    " .. elem_type .. " acc = " .. init .. ";\n    for (size_t i = 0; i < len; ++i) {\n        acc = " .. reduce_func .. "(acc, " .. data_name .. "[i]);\n    }\n    return acc;\n}"

fuse_reduce_with_filter: str = (data_name: str, elem_type: str, func_name: str, reduce_func: str, pred_func: str, init: str)
  "/* [pipeline.fused] reduce + filter */\nstatic " .. elem_type .. " " .. func_name .. "(const " .. elem_type .. "* " .. data_name .. ", size_t len) {\n    " .. elem_type .. " acc = " .. init .. ";\n    for (size_t i = 0; i < len; ++i) {\n        " .. elem_type .. " elem = " .. data_name .. "[i];\n        if (!" .. pred_func .. "(elem)) continue;\n        acc = " .. reduce_func .. "(acc, elem);\n    }\n    return acc;\n}"

fuse_map_reduce: str = (data_name: str, elem_type: str, func_name: str, map_func: str, reduce_func: str, init: str)
  "/* [pipeline.fused] map + reduce */\nstatic " .. elem_type .. " " .. func_name .. "(const " .. elem_type .. "* " .. data_name .. ", size_t len) {\n    " .. elem_type .. " acc = " .. init .. ";\n    for (size_t i = 0; i < len; ++i) {\n        acc = " .. reduce_func .. "(acc, " .. map_func .. "(" .. data_name .. "[i]));\n    }\n    return acc;\n}"

fuse_collect: str = (data_name: str, elem_type: str, func_name: str)
  "/* [pipeline.fused] collect */\ntypedef struct { " .. elem_type .. "* data; size_t len; } pipeline_result_t;\nstatic pipeline_result_t " .. func_name .. "(const " .. elem_type .. "* " .. data_name .. ", size_t src_len) {\n    " .. elem_type .. " out_buf[src_len > 0 ? src_len : 1];\n    size_t out_len = 0;\n    for (size_t i = 0; i < src_len; ++i) {\n        out_buf[out_len++] = " .. data_name .. "[i];\n    }\n    pipeline_result_t r = {out_buf, out_len};\n    return r;\n}"

fuse_map_collect: str = (data_name: str, elem_type: str, func_name: str, map_func: str)
  "/* [pipeline.fused] map + collect */\ntypedef struct { " .. elem_type .. "* data; size_t len; } pipeline_result_t;\nstatic pipeline_result_t " .. func_name .. "(const " .. elem_type .. "* " .. data_name .. ", size_t src_len) {\n    " .. elem_type .. " out_buf[src_len > 0 ? src_len : 1];\n    size_t out_len = 0;\n    for (size_t i = 0; i < src_len; ++i) {\n        out_buf[out_len++] = " .. map_func .. "(" .. data_name .. "[i]);\n    }\n    pipeline_result_t r = {out_buf, out_len};\n    return r;\n}"

fuse_filter_collect: str = (data_name: str, elem_type: str, func_name: str, pred_func: str)
  "/* [pipeline.fused] filter + collect */\ntypedef struct { " .. elem_type .. "* data; size_t len; } pipeline_result_t;\nstatic pipeline_result_t " .. func_name .. "(const " .. elem_type .. "* " .. data_name .. ", size_t src_len) {\n    " .. elem_type .. " out_buf[src_len > 0 ? src_len : 1];\n    size_t out_len = 0;\n    for (size_t i = 0; i < src_len; ++i) {\n        " .. elem_type .. " elem = " .. data_name .. "[i];\n        if (!" .. pred_func .. "(elem)) continue;\n        out_buf[out_len++] = elem;\n    }\n    pipeline_result_t r = {out_buf, out_len};\n    return r;\n}"

product_reduce: str = (func_name: str, types: str, takes: str, skips: str, maps: str, filters: str, reducers: str)
  "@pipeline.product.reduce(" .. func_name .. ")"

M =
  fuse_reduce = fuse_reduce
  fuse_reduce_with_filter = fuse_reduce_with_filter
  fuse_map_reduce = fuse_map_reduce
  fuse_collect = fuse_collect
  fuse_map_collect = fuse_map_collect
  fuse_filter_collect = fuse_filter_collect
  product_reduce = product_reduce
  str_join = str_join
M
