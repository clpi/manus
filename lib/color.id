
global M = {}

M.RESET = "[0m"
M.BOLD = "[1m"
M.DIM = "[2m"
M.ITALIC = "[3m"
M.UNDERLINE = "[4m"

M.BLACK = "[30m"
M.RED = "[31m"
M.GREEN = "[32m"
M.YELLOW = "[33m"
M.BLUE = "[34m"
M.MAGENTA = "[35m"
M.CYAN = "[36m"
M.WHITE = "[37m"

M.BG_BLACK = "[40m"
M.BG_RED = "[41m"
M.BG_GREEN = "[42m"
M.BG_YELLOW = "[43m"
M.BG_BLUE = "[44m"
M.BG_MAGENTA = "[45m"
M.BG_CYAN = "[46m"
M.BG_WHITE = "[47m"

red: str = (text: str)
  M.RED .. text .. M.RESET

green: str = (text: str)
  M.GREEN .. text .. M.RESET

yellow: str = (text: str)
  M.YELLOW .. text .. M.RESET

blue: str = (text: str)
  M.BLUE .. text .. M.RESET

bold: str = (text: str)
  M.BOLD .. text .. M.RESET

M.red = red
M.green = green
M.yellow = yellow
M.blue = blue
M.bold = bold

M
