# encoding_json — JSON encoder/decoder (mirrors Go's encoding/json)
# All recursive helpers are merged into single self-referencing functions
# because Duo does not support forward references between functions.
# Error handling uses p.err field instead of multi-return to avoid codegen issues.

# marshal: encode a Duo value as a JSON string.
marshal: str = (v: any)
  if v == nil
    return "null"
  t = type(v)
  if t == "nil"
    return "null"
  if t == "boolean"
    if v
      return "true"
    return "false"
  if t == "number"
    if v:floor() == v and v:abs() < 1000000000000000.0
      return to(str)(v:floor())
    return "%.17g":format(v)
  if t == "string"
    out = { "\"" }
    i = 1
    while i <= v:len()
      ch = v:sub(i, i)
      b = v:byte(i)
      if ch == "\""
        out(out:len() + 1) = "\\\""
      else
        if ch == "\\"
          out(out:len() + 1) = "\\\\"
        else
          if ch == "\n"
            out(out:len() + 1) = "\\n"
          else
            if ch == "\r"
              out(out:len() + 1) = "\\r"
            else
              if ch == "\t"
                out(out:len() + 1) = "\\t"
              else
                if b < 32
                  out(out:len() + 1) = "\\u%04x":format(b)
                else
                  out(out:len() + 1) = ch
      i = i + 1
    out(out:len() + 1) = "\""
    return out:concat()
  if t == "table"
    n = v:len()
    count = 0
    for _ in v
      count = count + 1
    if n > 0 and count == n
      # array
      out = { "[" }
      i = 1
      while i <= n
        out(out:len() + 1) = marshal(v(i))
        if i < n
          out(out:len() + 1) = ","
        i = i + 1
      out(out:len() + 1) = "]"
      return out:concat()
    else
      # object
      keys = {}
      for mk in v
        if type(mk) == "string"
          keys(keys:len() + 1) = mk
      if keys:len() == 0
        return "{}"
      keys:sort()
      out = { "{" }
      i = 1
      while i <= keys:len()
        k = keys(i)
        # encode key as string
        key_out = { "\"" }
        j = 1
        while j <= k:len()
          ch = k:sub(j, j)
          b = k:byte(j)
          if ch == "\""
            key_out(key_out:len() + 1) = "\\\""
          else
            if ch == "\\"
              key_out(key_out:len() + 1) = "\\\\"
            else
              if b < 32
                key_out(key_out:len() + 1) = "\\u%04x":format(b)
              else
                key_out(key_out:len() + 1) = ch
          j = j + 1
        key_out(key_out:len() + 1) = "\""
        out(out:len() + 1) = key_out:concat()
        out(out:len() + 1) = ":"
        out(out:len() + 1) = marshal(v(k))
        if i < keys:len()
          out(out:len() + 1) = ","
        i = i + 1
      out(out:len() + 1) = "}"
      return out:concat()
  "null"

# skip_ws: skip whitespace in the parser.
skip_ws = (p: any)
  while p.pos <= p:len().s
    b = p.s:byte(p.pos)
    if b == 32 or b == 9 or b == 10 or b == 13
      p.pos = p.pos + 1
    else
      break

# parse_value: parse a JSON value. Self-referencing for nested objects/arrays.
# Sets p.err to an error string on failure (nil on success).
parse_value: any = (p: any)
  if has(.err)(p)
    return nil
  skip_ws(p)
  if p.pos > p:len().s
    p.err = "unexpected end of input"
    return nil
  ch = p.s:sub(p.pos, p.pos)
  if ch == "{"
    # parse object
    p.pos = p.pos + 1
    obj = {}
    skip_ws(p)
    if p.pos <= p:len().s and p.s:sub(p.pos, p.pos) == "}"
      p.pos = p.pos + 1
      return obj
    while true
      skip_ws(p)
      if p.pos > p:len().s
        p.err = "unterminated object"
        return nil
      if p.s:sub(p.pos, p.pos) != "\""
        p.err = "expected string key"
        return nil
      # parse key (inline string parse)
      p.pos = p.pos + 1
      key_out = {}
      while p.pos <= p:len().s
        kch = p.s:sub(p.pos, p.pos)
        if kch == "\""
          p.pos = p.pos + 1
          break
        if kch == "\\"
          p.pos = p.pos + 1
          if p.pos > p:len().s
            p.err = "unterminated string escape"
            return nil
          esc = p.s:sub(p.pos, p.pos)
          if esc == "n"
            key_out(key_out:len() + 1) = "\n"
          else
            if esc == "t"
              key_out(key_out:len() + 1) = "\t"
            else
              if esc == "r"
                key_out(key_out:len() + 1) = "\r"
              else
                if esc == "\""
                  key_out(key_out:len() + 1) = "\""
                else
                  if esc == "\\"
                    key_out(key_out:len() + 1) = "\\"
                  else
                    key_out(key_out:len() + 1) = esc
        else
          key_out(key_out:len() + 1) = kch
        p.pos = p.pos + 1
      key = key_out:concat()
      skip_ws(p)
      if p.pos > p:len().s or p.s:sub(p.pos, p.pos) != ":"
        p.err = "expected colon"
        return nil
      p.pos = p.pos + 1
      val = parse_value(p)
      if has(.err)(p)
        return nil
      obj(key) = val
      skip_ws(p)
      if p.pos > p:len().s
        p.err = "unterminated object"
        return nil
      och = p.s:sub(p.pos, p.pos)
      if och == "}"
        p.pos = p.pos + 1
        return obj
      if och != ","
        p.err = "expected comma or closing brace"
        return nil
      p.pos = p.pos + 1
    return nil
  if ch == "["
    # parse array
    p.pos = p.pos + 1
    arr = {}
    skip_ws(p)
    if p.pos <= p:len().s and p.s:sub(p.pos, p.pos) == "]"
      p.pos = p.pos + 1
      return arr
    while true
      val = parse_value(p)
      if has(.err)(p)
        return nil
      arr(arr:len() + 1) = val
      skip_ws(p)
      if p.pos > p:len().s
        p.err = "unterminated array"
        return nil
      ach = p.s:sub(p.pos, p.pos)
      if ach == "]"
        p.pos = p.pos + 1
        return arr
      if ach != ","
        p.err = "expected comma or closing bracket"
        return nil
      p.pos = p.pos + 1
    return nil
  if ch == "\""
    # parse string
    p.pos = p.pos + 1
    out = {}
    while p.pos <= p:len().s
      sch = p.s:sub(p.pos, p.pos)
      if sch == "\""
        p.pos = p.pos + 1
        return out:concat()
      if sch == "\\"
        p.pos = p.pos + 1
        if p.pos > p:len().s
          p.err = "unterminated string escape"
          return nil
        esc = p.s:sub(p.pos, p.pos)
        if esc == "n"
          out(out:len() + 1) = "\n"
        else
          if esc == "r"
            out(out:len() + 1) = "\r"
          else
            if esc == "t"
              out(out:len() + 1) = "\t"
            else
              if esc == "\""
                out(out:len() + 1) = "\""
              else
                if esc == "\\"
                  out(out:len() + 1) = "\\"
                else
                  if esc == "/"
                    out(out:len() + 1) = "/"
                  else
                    if esc == "b"
                      out(out:len() + 1) = 8:char()
                    else
                      if esc == "f"
                        out(out:len() + 1) = 12:char()
                      else
                        if esc == "u"
                          hex = p.s:sub(p.pos + 1, p.pos + 4)
                          code = tonumber(hex, 16)
                          if code == nil
                            p.err = "invalid unicode escape"
                            return nil
                          out(out:len() + 1) = code:char()
                          p.pos = p.pos + 4
                        else
                          out(out:len() + 1) = esc
      else
        out(out:len() + 1) = sch
      p.pos = p.pos + 1
    p.err = "unterminated string"
    return nil
  if ch == "t"
    if p.s:sub(p.pos, p.pos + 3) == "true"
      p.pos = p.pos + 4
      return true
    p.err = "invalid boolean"
    return nil
  if ch == "f"
    if p.s:sub(p.pos, p.pos + 4) == "false"
      p.pos = p.pos + 5
      return false
    p.err = "invalid boolean"
    return nil
  if ch == "n"
    if p.s:sub(p.pos, p.pos + 3) == "null"
      p.pos = p.pos + 4
      return nil
    p.err = "invalid null"
    return nil
  if ch == "-" or ch >= "0" and ch <= "9"
    start = p.pos
    if p.s:sub(p.pos, p.pos) == "-"
      p.pos = p.pos + 1
    while p.pos <= p:len().s
      nch = p.s:sub(p.pos, p.pos)
      if nch >= "0" and nch <= "9" or nch == "." or nch == "e" or nch == "E" or nch == "+" or nch == "-"
        p.pos = p.pos + 1
      else
        break
    num_str = p.s:sub(start, p.pos - 1)
    nv = num_str:to(i64)
    if nv == nil
      p.err = "invalid number"
      return nil
    return nv
  p.err = "unexpected character"
  nil

# unmarshal: decode a JSON string into a Duo value.
unmarshal: any = (s: str)
  if s == nil
    return nil
  s = s:gsub("^%s+", "")
  s = s:gsub("%s+$", "")
  if s == ""
    return nil
  parser =
    s = s
    pos = 1
    err = nil
  v = parse_value(parser)
  if has(.err)(parser)
    return nil
  skip_ws(parser)
  if parser.pos <= s:len()
    return nil
  v

# marshal_indent: encode a Duo value as indented JSON.
marshal_indent: str = (v: any, indent: str)
  if indent == nil
    indent = "  "
  jstr = marshal(v)
  out = {}
  depth = 0
  i = 1
  in_string = false
  while i <= jstr:len()
    ch = jstr:sub(i, i)
    if in_string
      out(out:len() + 1) = ch
      if ch == "\\" and i < jstr:len()
        out(out:len() + 1) = jstr:sub(i + 1, i + 1)
        i = i + 2
      else
        if ch == "\""
          in_string = false
          i = i + 1
        else
          i = i + 1
    else
      if ch == "\""
        in_string = true
        out(out:len() + 1) = ch
        i = i + 1
      else
        if ch == "{" or ch == "["
          out(out:len() + 1) = ch
          depth = depth + 1
          out(out:len() + 1) = "\n" .. indent:rep(depth)
          i = i + 1
        else
          if ch == "}" or ch == "]"
            depth = depth - 1
            if depth < 0
              depth = 0
            out(out:len() + 1) = "\n" .. indent:rep(depth) .. ch
            i = i + 1
          else
            if ch == ","
              out(out:len() + 1) = ch
              out(out:len() + 1) = "\n" .. indent:rep(depth)
              i = i + 1
            else
              if ch == ":"
                out(out:len() + 1) = ": "
                i = i + 1
              else
                out(out:len() + 1) = ch
                i = i + 1
  out:concat()
