
WIRE_VARINT = 0
WIRE_64BIT = 1
WIRE_LENGTH_DELIMITED = 2
WIRE_32BIT = 5


writer_new: any = ()
  { bytes = {} }

write_varint = (w: any, value: i64)
  while value >= 128
    w.bytes(w.bytes:len() + 1) = value & 127 | 128
    value = value >> 7
  w.bytes(w.bytes:len() + 1) = value

write_tag = (w: any, field: i64, wire_type: i64)
  write_varint(w, field << 3 | wire_type)

write_field_varint = (w: any, field: i64, value: i64)
  write_tag(w, field, WIRE_VARINT)
  write_varint(w, value)

write_field_bytes = (w: any, field: i64, data: any)
  write_tag(w, field, WIRE_LENGTH_DELIMITED)
  write_varint(w, data:len())
  for b in data
    w.bytes(w.bytes:len() + 1) = b

write_field_string = (w: any, field: i64, value: str)
  write_tag(w, field, WIRE_LENGTH_DELIMITED)
  bytes = string_to_bytes(value)
  write_varint(w, bytes:len())
  for b in bytes
    w.bytes(w.bytes:len() + 1) = b

write_field_fixed32 = (w: any, field: i64, value: i64)
  write_tag(w, field, WIRE_32BIT)
  w.bytes(w.bytes:len() + 1) = value & 255
  w.bytes(w.bytes:len() + 1) = value >> 8 & 255
  w.bytes(w.bytes:len() + 1) = value >> 16 & 255
  w.bytes(w.bytes:len() + 1) = value >> 24 & 255

write_field_fixed64 = (w: any, field: i64, value: i64)
  write_tag(w, field, WIRE_64BIT)
  i = 0
  while i < 8
    w.bytes(w.bytes:len() + 1) = value >> (i * 8) & 255
    i = i + 1

write_field_float = (w: any, field: i64, value: f64)
  write_tag(w, field, WIRE_32BIT)
  if value != value
    w.bytes(w.bytes:len() + 1) = 127
    w.bytes(w.bytes:len() + 1) = 192
    w.bytes(w.bytes:len() + 1) = 0
    w.bytes(w.bytes:len() + 1) = 0
    return
  if value == math.huge
    w.bytes(w.bytes:len() + 1) = 127
    w.bytes(w.bytes:len() + 1) = 128
    w.bytes(w.bytes:len() + 1) = 0
    w.bytes(w.bytes:len() + 1) = 0
    return
  if value == -math.huge
    w.bytes(w.bytes:len() + 1) = 255
    w.bytes(w.bytes:len() + 1) = 128
    w.bytes(w.bytes:len() + 1) = 0
    w.bytes(w.bytes:len() + 1) = 0
    return
  sign = 0
  if value < 0
    sign = 1
    value = -value
  if value == 0
    w.bytes(w.bytes:len() + 1) = sign * 128
    w.bytes(w.bytes:len() + 1) = 0
    w.bytes(w.bytes:len() + 1) = 0
    w.bytes(w.bytes:len() + 1) = 0
    return
  exp = 0
  while value >= 2
    value = value / 2
    exp = exp + 1
  while value < 1
    value = value * 2
    exp = exp - 1
  mantissa = (value - 1) * 2 ^ 23
  biased_exp = exp + 127
  b0 = sign * 128 + biased_exp / 2:floor() * 4 + mantissa / 2 ^ 23:floor()
  b1 = mantissa / 2 ^ 15:floor() % 256
  b2 = mantissa / 2 ^ 7:floor() % 256
  b3 = mantissa * 2 % 256
  w.bytes(w.bytes:len() + 1) = b0
  w.bytes(w.bytes:len() + 1) = b1
  w.bytes(w.bytes:len() + 1) = b2
  w.bytes(w.bytes:len() + 1) = b3

read_field_float: f64 = (r: any)
  if r.pos + 3 > r.len
    return 0.0
  b0 = r.data(r.pos)
  b1 = r.data(r.pos + 1)
  b2 = r.data(r.pos + 2)
  b3 = r.data(r.pos + 3)
  r.pos = r.pos + 4
  sign = 1
  if b0 >= 128
    sign = -1
    b0 = b0 - 128
  exp = b0 / 2:floor() * 16 + b1 / 16:floor()
  mantissa = b0 % 2 * 2 ^ 23 + b1 * 2 ^ 15 + b2 * 2 ^ 7 + b3
  if exp == 0
    return sign * mantissa * 2 ^ -149
  if exp == 255
    if mantissa == 0
      return sign * math.huge
    return 0.0 / 0.0
  sign * (1 + mantissa * 2 ^ -23) * 2 ^ (exp - 127)

writer_bytes: any = (w: any)
  w.bytes


reader_new: any = (data: any)
  { data = data, pos = 1, len = data:len() }

reader_varint: any = (r: any)
  result = 0
  shift = 0
  while true
    if r.pos > r.len
      return nil
    byte = r.data(r.pos)
    r.pos = r.pos + 1
    result = result | (byte & 127) << shift
    shift = shift + 7
    if byte & 128 == 0
      break
  result

reader_tag: any = (r: any)
  val = reader_varint(r)
  if val == nil
    return nil
  { field = val >> 3, wire_type = val & 7 }

reader_skip_field = (r: any, wire_type: i64)
  if wire_type == WIRE_VARINT
    reader_varint(r)
  else(wire_type == WIRE_64BIT)
    r.pos = r.pos + 8
  else(wire_type == WIRE_LENGTH_DELIMITED)
    len = reader_varint(r)
    r.pos = r.pos + len
  else(wire_type == WIRE_32BIT)
    r.pos = r.pos + 4

reader_field_bytes: any = (r: any, wire_type: i64)
  if wire_type != WIRE_LENGTH_DELIMITED
    return nil
  len = reader_varint(r)
  out = {}
  i = 0
  n = 0
  while i < len
    n = n + 1
    out(n) = r.data(r.pos)
    r.pos = r.pos + 1
    i = i + 1
  out

reader_field_string: str = (r: any, wire_type: i64)
  bytes = reader_field_bytes(r, wire_type)
  if bytes == nil
    return ""
  tostring(bytes)

reader_field_fixed32: any = (r: any, wire_type: i64)
  if wire_type != WIRE_32BIT
    return nil
  b0 = r.data(r.pos)
  b1 = r.data(r.pos + 1)
  b2 = r.data(r.pos + 2)
  b3 = r.data(r.pos + 3)
  r.pos = r.pos + 4
  b0 | b1 << 8 | b2 << 16 | b3 << 24

reader_field_fixed64: any = (r: any, wire_type: i64)
  if wire_type != WIRE_64BIT
    return nil
  result = 0
  i = 0
  while i < 8
    result = result | r.data(r.pos + i) << (i * 8)
    i = i + 1
  r.pos = r.pos + 8
  result


string_to_bytes: any = (s: str)
  out = {}
  i = 1
  n = 0
  while i <= s:len()
    n = n + 1
    out(n) = s:byte(i)
    i = i + 1
  out

tostring: str = (bytes: any)
  parts = {}
  i = 1
  n = 0
  while i <= bytes:len()
    n = n + 1
    parts(n) = bytes(i):char()
    i = i + 1
  parts:concat()


message_new: any = (fields: any)
  {
    type = "protobuf_message",
    fields = fields
  }

field_def: any = (field_num: i64, wire_type: i64, type_name: str)
  { field_num = field_num, wire_type = wire_type, type = type_name }

message_encode: any = (schema: any, values: any)
  w = writer_new()
  for name, field_def in schema.fields
    value = values(name)
    if value != nil
      if field_def.type == "varint"
        write_field_varint(w, field_def.field_num, value)
      else(field_def.type == "string")
        write_field_string(w, field_def.field_num, value)
      else(field_def.type == "bytes")
        write_field_bytes(w, field_def.field_num, value)
      else(field_def.type == "fixed32")
        write_field_fixed32(w, field_def.field_num, value)
      else(field_def.type == "fixed64")
        write_field_fixed64(w, field_def.field_num, value)
  writer_bytes(w)


WIRE =
  VARINT = 0
  FIXED64 = 1
  LENGTH_DELIMITED = 2
  START_GROUP = 3
  END_GROUP = 4
  FIXED32 = 5
