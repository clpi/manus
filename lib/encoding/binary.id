

encode_u16_le: str = (v: i64)
  b0 = v % 256
  b1 = v / 256 % 256
  return b0:char(b1)

encode_u16_be: str = (v: i64)
  b0 = v % 256
  b1 = v / 256 % 256
  return b1:char(b0)

encode_u32_le: str = (v: i64)
  b0 = v % 256
  b1 = v / 256 % 256
  b2 = v / 65536 % 256
  b3 = v / 16777216 % 256
  return b0:char(b1, b2, b3)

encode_u32_be: str = (v: i64)
  b0 = v % 256
  b1 = v / 256 % 256
  b2 = v / 65536 % 256
  b3 = v / 16777216 % 256
  return b3:char(b2, b1, b0)

encode_u64_le: str = (v: i64)
  parts = {}
  i = 0
  while i < 8
    parts[parts:len() + 1] = v % 256:char()
    v = v / 256
    i = i + 1
  parts:concat()

encode_u64_be: str = (v: i64)
  parts = {}
  i = 0
  while i < 8
    parts[8 - i] = v % 256:char()
    v = v / 256
    i = i + 1
  parts:concat()


decode_u16_le: i64 = (s: str)
  s:byte(1) + s:byte(2) * 256

decode_u16_be: i64 = (s: str)
  s:byte(2) + s:byte(1) * 256

decode_u32_le: i64 = (s: str)
  b0 = s:byte(1)
  b1 = s:byte(2)
  b2 = s:byte(3)
  b3 = s:byte(4)
  b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

decode_u32_be: i64 = (s: str)
  b0 = s:byte(1)
  b1 = s:byte(2)
  b2 = s:byte(3)
  b3 = s:byte(4)
  b3 + b2 * 256 + b1 * 65536 + b0 * 16777216

decode_u64_le: i64 = (s: str)
  v = 0
  i = 8
  while i >= 1
    v = v * 256 + s:byte(i)
    i = i - 1
  v

decode_u64_be: i64 = (s: str)
  v = 0
  i = 1
  while i <= 8
    v = v * 256 + s:byte(i)
    i = i + 1
  v


encode_f32: str = (v: f64)
  "%.7g":format(v)

decode_f32: f64 = (s: str)
  s:to(i64)

encode_f64: str = (v: f64)
  "%.17g":format(v)

decode_f64: f64 = (s: str)
  s:to(i64)


encode_varint: str = (v: i64)
  out = {}
  while v >= 128
    out[out:len() + 1] = v % 128 + 128:char()
    v = v / 128
  out[out:len() + 1] = v:char()
  out:concat()

decode_varint: any = (s: str, offset: i64)
  if offset == nil
    offset = 1
  v = 0
  shift = 0
  i = offset
  while i <= s:len()
    b = s:byte(i)
    v = (v + b % 128) << shift
    i = i + 1
    if b < 128
      return v, i, true
    shift = shift + 7
  return 0, offset, false


put_u16_le: str = (s: str, offset: i64, v: i64)
  prefix = ""
  mid = encode_u16_le(v)
  suffix = ""
  if offset > 1
    prefix = s:sub(1, offset - 1)
  if offset + 1 < s:len()
    suffix = s:sub(offset + 2)
  prefix .. mid .. suffix

put_u32_le: str = (s: str, offset: i64, v: i64)
  prefix = ""
  mid = encode_u32_le(v)
  suffix = ""
  if offset > 1
    prefix = s:sub(1, offset - 1)
  if offset + 3 < s:len()
    suffix = s:sub(offset + 4)
  prefix .. mid .. suffix
