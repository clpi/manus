# encoding.varint — Variable-length integer encodings
# Provides three common varint formats:
#   1. Base-128 varint (protobuf-style, unsigned)
#   2. ZigZag encoding (maps signed to unsigned for better compression)
#   3. LEB128 (DWARF/ELF style, signed and unsigned)
# ═══════════════════════════════════════════════════════════════
# Base-128 Varint (protobuf-style, unsigned)
# Each byte: 7 bits of data + 1 continuation bit (high bit)
# ═══════════════════════════════════════════════════════════════

write = (buf: any, value: i64)
  while value >= 128
    buf[buf:len() + 1] = value & 127 | 128:char()
    value = value >> 7
  buf[buf:len() + 1] = value:char()

read: i64 = (data: str, pos: any)
  result = 0
  shift = 0
  while true
    if pos(1) > data:len()
      error("varint: unexpected end of data")
    byte = data:byte(pos(1))
    pos[1] = pos(1) + 1
    result = result | (byte & 127) << shift
    if byte < 128
      break
    shift = shift + 7
    if shift >= 64
      error("varint: overflow")
  result

size: i64 = (value: i64)
  if value < 128
    return 1
  if value < 16384
    return 2
  if value < 2097152
    return 3
  if value < 268435456
    return 4
  if value < 34359738368
    return 5
  if value < 4398046511104
    return 6
  if value < 562949953421312
    return 7
  if value < 72057594037927936
    return 8
  if value < -9223372036854775808
    return 9
  10

# ═══════════════════════════════════════════════════════════════
# ZigZag encoding (protobuf-style, maps signed → unsigned)
# ZigZag(n) = (n << 1) ^ (n >> 63)
#   0 → 0, -1 → 1, 1 → 2, -2 → 3, ...
# ═══════════════════════════════════════════════════════════════

zigzag_encode: i64 = (value: i64)
  value << 1 ~ value >> 63

zigzag_decode: i64 = (value: i64)
  value >> 1 ~ -(value & 1)

write_zigzag = (buf: any, value: i64)
  write(buf, zigzag_encode(value))

read_zigzag: i64 = (data: str, pos: any)
  zigzag_decode(read(data, pos))

# ═══════════════════════════════════════════════════════════════
# LEB128 (Little-Endian Base-128, DWARF/ELF style)
# Each byte: 7 bits of data + 1 continuation bit (high bit)
# Little-endian ordering (lsb first)
# ═══════════════════════════════════════════════════════════════

write_leb128 = (buf: any, value: i64)
  repeat
    byte = value & 127
    value = value >> 7
    if value != 0
      byte = byte | 128
    buf[buf:len() + 1] = byte:char()
  until value == 0

read_leb128: i64 = (data: str, pos: any)
  result = 0
  shift = 0
  while true
    if pos(1) > data:len()
      error("leb128: unexpected end of data")
    byte = data:byte(pos(1))
    pos[1] = pos(1) + 1
    result = result | (byte & 127) << shift
    if byte < 128
      break
    shift = shift + 7
    if shift >= 64
      error("leb128: overflow")
  result

write_signed_leb128 = (buf: any, value: i64)
  more = true
  while more
    byte = value & 127
    value = value >> 7
    if value == 0 and byte & 64 == 0 or value == -1 and byte & 64 != 0
      more = false
    else
      byte = byte | 128
    buf[buf:len() + 1] = byte:char()

read_signed_leb128: i64 = (data: str, pos: any)
  result = 0
  shift = 0
  while true
    if pos(1) > data:len()
      error("signed leb128: unexpected end of data")
    byte = data:byte(pos(1))
    pos[1] = pos(1) + 1
    result = result | (byte & 127) << shift
    shift = shift + 7
    if byte < 128
      if shift < 64 and byte & 64 != 0
        result = result | -(1 << shift)
      break
    if shift >= 64
      error("signed leb128: overflow")
  result
# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════
