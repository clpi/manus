# std.fs — simple file-system helpers

exists(path: any): bool
    if path == nil return false end
    f = io.open(path, "r")
    if f == nil return false end
    f:close()
    true
end

read(path: any): any
    f = io.open(path, "r")
    if f == nil return "" end
    # Read the WHOLE file in one C-level call (f:read("*a")). The previous
    # line-by-line `data = data .. line .. "\n"` loop was (a) O(n^2) and (b)
    # triggered a runtime large-string-concat corruption (extra bytes +
    # scrambled content past ~10KB), which broke json.decode of the symbol
    # index (apparent "1029 truncation") and any large-file read.
    data = f:read("*a")
    f:close()
    if data == nil return "" end
    data
end

write(path: any, data: any): bool
    f = io.open(path, "w")
    if f == nil return false end
    if data == nil data = "" end
    f:write(data)
    f:close()
    true
end

append(path: any, data: any): bool
    f = io.open(path, "a")
    if f == nil return false end
    if data == nil data = "" end
    f:write(data)
    f:close()
    true
end

lines(path: any): any
    out = {}
    f = io.open(path, "r")
    if f == nil return out end
    line = f:read()
    while line != nil
        out[out:len() + 1] = line
        line = f:read()
    end
    f:close()
    out
end

# gap[075]: these tested a BOOL against nil. os.remove answers `false` on
# failure, never nil, so `false != nil` is true and no input could ever answer
# false — remove reported success for a path it had not removed. Answer with
# the value itself. Proof asserts both directions: scripts/proof/remove.id
remove(path: any): bool
    os.remove(path)
end

rename(src: any, dst: any): bool
    os.rename(src, dst)
end

make(path: str): bool
    # IMPLEMENTATION-BLOCKED: directory create needs world/effect/witness
    # (path:make). Not os.execute, not a C emit directive.
    false
end

# VOCABULARY-BLOCKED: filesystem mutation/query below requires admitted
# process world with subject-first relations (path:make(), src:copy(dst)).
# Do not use os.execute, io.popen, Lua .., or shell-string construction.
# Unblock: GAP-154 (host boundary), process world admission.

tree(path: str): bool
    # IMPLEMENTATION-BLOCKED: recursive make needs admitted process world
    false

copy(src: str, dest: str): bool
    # IMPLEMENTATION-BLOCKED: copy needs admitted process world
    false

list(path: str): any
    # IMPLEMENTATION-BLOCKED: directory iteration requires admitted world
    {}

dir(path: str): bool
    # IMPLEMENTATION-BLOCKED: directory query requires admitted world
    false

file(path: str): bool
    # IMPLEMENTATION-BLOCKED: file query requires admitted world
    false

drop(path: str): bool
    # IMPLEMENTATION-BLOCKED: directory remove needs world/effect/witness
    false
end

chmod(path: str, mode: str): bool
    # IMPLEMENTATION-BLOCKED: permission change requires admitted world
