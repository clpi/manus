
exists: bool = (path: any)
  if path == nil
    return false
  f = io.open(path, "r")
  if f == nil
    return false
  f:close()
  true

read: any = (path: any)
  f = io.open(path, "r")
  if f == nil
    return ""
  data = f:read("*a")
  f:close()
  if data == nil
    return ""
  data

write: bool = (path: any, data: any)
  f = io.open(path, "w")
  if f == nil
    return false
  if data == nil
    data = ""
  f:write(data)
  f:close()
  true

append: bool = (path: any, data: any)
  f = io.open(path, "a")
  if f == nil
    return false
  if data == nil
    data = ""
  f:write(data)
  f:close()
  true

lines: any = (path: any)
  out = {}
  f = io.open(path, "r")
  if f == nil
    return out
  line = f:read()
  while line != nil
    out[out:len() + 1] = line
    line = f:read()
  f:close()
  out

remove: bool = (path: any)
  os.remove(path)

rename: bool = (src: any, dst: any)
  os.rename(src, dst)

make: bool = (path: str)
  false


tree: bool = (path: str)
  false

copy: bool = (src: str, dest: str)
  false

list: any = (path: str)
  {}

dir: bool = (path: str)
  false

file: bool = (path: str)
  false

drop: bool = (path: str)
  false

chmod: bool = (path: str, mode: str)
  false

size: i64 = (path: str)
  0 - 1
