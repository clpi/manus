# std.meta — reflection, type introspection, and meta utilities
# Derivable concept descriptors live in std.meta.derive, and macro helpers live
# in std.meta.macros. Import those submodules directly when needed so the core
# reflection module stays lightweight.

# ─────────────────────────────────────────────────────────────
# Reflection: runtime type introspection
# ─────────────────────────────────────────────────────────────

# Get the type kind of a value as a string
std_meta_typeof(x): str
    if x == nil return "nil" end
    if type(x) != "table" return type(x) end
    if getmetatable(x) != nil
        mt = getmetatable(x)
        if has(.type)(mt) return mt.type end
    end
    "table"
end

# Check if a value is of a specific type kind
is(x, kind: str): bool
    std_meta_typeof(x) == kind
end

is_nil(x): bool
    x == nil
end

is_bool(x): bool
    return type(x) == "boolean"
end

is_number(x): bool
    return type(x) == "number"
end

is_str(x): bool
    return type(x) == "string"
end

is_table(x): bool
    return type(x) == "table"
end

is_func(x): bool
    return type(x) == "function"
end

is_integer(x): bool
    if type(x) != "number" return false end
    x == x:floor()
end

is_float(x): bool
    if type(x) != "number" return false end
    x != x:floor()
end

# ─────────────────────────────────────────────────────────────
# Reflection: field and method introspection
# ─────────────────────────────────────────────────────────────

# Get all keys of a table (both array and hash parts)
fields(t: any)
    ks = {}
    for k, _ in t
        ks[ks:len() + 1] = k
    end
    ks
end

# Get field names (string keys only)
field_names(t: any)
    ks = {}
    for k, _ in t
        if type(k) == "string"
            ks[ks:len() + 1] = k
        end
    end
    ks
end

# Get method names (function-valued fields)
method_names(t: any)
    ms = {}
    for k, v in t
        if type(k) == "string" and type(v) == "function"
            ms[ms:len() + 1] = k
        end
    end
    ms
end

# Check if a table has a field
has_field(t: any, name: str): bool
    if type(t) != "table" return false end
    t[name] != nil
end

# Check if a table has a method (function-valued field)
has_method(t: any, name: str): bool
    if type(t) != "table" return false end
    return type(t[name]) == "function"
end

# Get the metatable type name
type_name(t: any): str
    if t == nil return "nil" end
    mt = getmetatable(t)
    if mt != nil and mt.type != nil return mt.type end
    return type(t)
end

# ─────────────────────────────────────────────────────────────
# Reflection: callable and concept introspection
# ─────────────────────────────────────────────────────────────

# Check if a value satisfies a concept (has required fields/methods)
# concept_def is a concept table with required_methods and required_fields
concept_member_name(member: any): any
    if type(member) == "string" return member end
    if type(member) == "table" return member.name end
    nil
end

satisfies_concept(val: any, concept_def: any): bool
    if val == nil or concept_def == nil return false end
    if has(.required_fields)(concept_def)
        for _, f in concept_def.required_fields
            name = concept_member_name(f)
            if name == nil or val[name] == nil return false end
        end
    end
    if has(.required_methods)(concept_def)
        for _, m in concept_def.required_methods
            name = concept_member_name(m)
            if name == nil or type(val[name]) != "function" return false end
        end
    end
    true
end

concept_member(member: any, kind: str): any
    if type(member) == "string"
        return { name = member, kind = kind }
    end
    if member.kind == nil member.kind = kind end
    if kind == "method" and member.param_count == nil and member.params != nil
        member.param_count = member:len().params
    end
    member
end

concept_member_list(items: any, kind: str): any
    out = {}
    if items == nil return out end
    for _, item in items
        out[out:len() + 1] = concept_member(item, kind)
    end
    out
end

make_concept(name: str, spec: any): any
    if spec == nil spec = {} end
    concept_fields = spec.required_fields
    if concept_fields == nil concept_fields = spec.fields end
    concept_methods = spec.required_methods
    if concept_methods == nil concept_methods = spec.methods end
    desc = {
        kind = "concept",
        name = name,
        required_fields = concept_member_list(concept_fields, "field"),
        required_methods = concept_member_list(concept_methods, "method"),
    }
    setmetatable(desc, {
        kind = "concept_metatable",
        type = "concept",
    })
    return desc
end

# ─────────────────────────────────────────────────────────────
# General table utilities
# ─────────────────────────────────────────────────────────────

t: any:len(): i64
    return t:len()
end

keys(t: any)
    ks = {}
    for k, _ in t
        ks[ks:len() + 1] = k
    end
    ks
end

values(t: any)
    vs = {}
    for _, v in t
        vs[vs:len() + 1] = v
    end
    vs
end

has_key(t: any, key: any): bool
    if type(t) != "table" return false end
    t[key] != nil
end

clone(t: any)
    if type(t) != "table" return t end
    c = {}
    for k, v in t
        c[k] = v
    end
    c
end

merge(dst: any, src: any): any
    for k, v in src
        dst[k] = v
    end
    dst
end

deep_clone(t: any)
    if type(t) != "table" return t end
    c = {}
    for k, v in t
        if type(v) == "table"
            c[k] = deep_clone(v)
        else
            c[k] = v
        end
    end
    c
end

# Compare two tables for shallow equality
shallow_eq(a: any, b: any): bool
    if a == b return true end
    if type(a) != "table" or type(b) != "table" return false end
    for k, v in a
        if b[k] != v return false end
    end
    for k, _ in b
        if a[k] == nil return false end
    end
    true
end

# Collect garbage (if available) — triggers cycle collector in ARC mode
collect(): void
    collectgarbage("collect")
end

# Get memory usage stats
memory_stats(): any
    return {
        total = collectgarbage("count"),
        step = collectgarbage("step"),
    }
end

# ─────────────────────────────────────────────────────────────
# Derive helpers: check/bind concept satisfaction
# ─────────────────────────────────────────────────────────────

# Verify that a table-type binding satisfies a concept
# returns true if satisfied, errors with details if not
derive_clone(val: any): any
    if type(val) != "table" return val end
    clone(val)
end

derive_eq(a: any, b: any): bool
    if a == nil and b == nil return true end
    if a == nil or b == nil return false end
    if type(a) == "table" and type(b) == "table"
        return shallow_eq(a, b)
    end
    a == b
end

derive_display(val: any): str
    if val == nil return "nil" end
    if type(val) == "boolean"
        if val return "true" else return "false" end
    end
    if type(val) == "number" return val:to(str) end
    if type(val) == "string" return val end
    if type(val) == "table"
        parts = {}
        for k, v in val
            if type(k) == "string"
                parts[parts:len() + 1] = k .. ": " .. derive_display(v)
            end
        end
        return "{" .. parts:concat(", ") .. "}"
    end
    val:to(str)
end

derive_deep_clone(val: any): any
    if type(val) != "table" return val end
    c = {}
    for k, v in val
        if type(v) == "table"
            c[k] = derive_deep_clone(v)
        else
            c[k] = v
        end
    end
    c
end

derive_default(): any
    {}
end

derive_hash(val: any): u64
    if val == nil return 0 end
    if type(val) == "number"
        i = val:floor()
        return i % 4294967296
    end
    if type(val) == "string"
        h = 5381
        for i = 1, val:len()
            h = (h * 33 + val:byte(i)) % 4294967296
        end
        return h
    end
    if type(val) == "table"
        h = 0
        for _, v in val
            h = (h + derive_hash(v)) % 4294967296
        end
        return h
    end
    val:to(str):len()
end

derive_ord(a: any, b: any): i64
    if a == b return 0 end
    if a == nil return -1 end
    if b == nil return 1 end
    if type(a) == "number" and type(b) == "number"
        if a < b return -1 else return 1 end
    end
    sa = a:to(str)
    sb = b:to(str)
    if sa < sb return -1 else return 1 end
end

derive_format(val: any, spec: str): str
    if spec == "d" or spec == "i"
        return to(str)(val:floor())
    end
    if spec == "f"
        return "%f":format(val)
    end
    if spec == "x"
        return "%x":format(val:floor())
    end
    if spec == "s"
        return val:to(str)
    end
    if spec == "t"
        return derive_display(val)
    end
    val:to(str)
end

derive_val: any:len(): i64
    if val == nil return 0 end
    if type(val) == "string" return val:len() end
    if type(val) == "table" return val:len() end
    0
end

derive_contains(val: any, elem: any): bool
    if type(val) == "table"
        for _, v in val
            if v == elem return true end
        end
    end
    false
end

derive_iter(val: any): any
    if type(val) != "table"
        empty = () nil
        return empty
    end
    val
end

# ─────────────────────────────────────────────────────────────
# Functional programming: higher-order collection transforms
# ─────────────────────────────────────────────────────────────

# map: transform each element of an array
map(t: any, f: any): any
    out = {}
    i = 1
    while i <= t:len()
        out[i] = f(t[i], i)
        i += 1
    end
    out
end

# mapk: transform each key-value pair
mapk(t: any, f: any): any
    out = {}
    for k, v in t
        out[k] = f(v, k)
    end
    out
end

# filter: keep elements where predicate returns true
filter(t: any, pred: any): any
    out = {}
    n = 0
    i = 1
    while i <= t:len()
        if pred(t[i], i)
            n += 1
            out[n] = t[i]
        end
        i += 1
    end
    out
end

# filterk: keep entries where predicate(value, key) returns true
filterk(t: any, pred: any): any
    out = {}
    for k, v in t
        if pred(v, k)
            out[k] = v
        end
    end
    out
end

# reduce: fold array left-to-right with accumulator
reduce(t: any, f: any, init: any): any
    acc = init
    i = 1
    while i <= t:len()
        acc = f(acc, t[i], i)
        i += 1
    end
    acc
end

# reducek: fold table with (accumulator, value, key)
reducek(t: any, f: any, init: any): any
    acc = init
    for k, v in t
        acc = f(acc, v, k)
    end
    acc
end

# each: call side-effecting function on each element
each(t: any, f: any): void
    i = 1
    while i <= t:len()
        f(t[i], i)
        i += 1
    end
end

# eachk: call side-effecting function on each key-value pair
eachk(t: any, f: any): void
    for k, v in t
        f(v, k)
    end
end

# find: return first element matching predicate, or nil
find(t: any, pred: any): any
    i = 1
    while i <= t:len()
        if pred(t[i], i) return t[i] end
        i += 1
    end
    nil
end

# findk: return first key whose value matches predicate
findk(t: any, pred: any): any
    for k, v in t
        if pred(v, k) return k end
    end
    nil
end

# find_index: return 1-based index of first matching element, or 0
find_index(t: any, pred: any): i64
    i = 1
    while i <= t:len()
        if pred(t[i], i) return i end
        i += 1
    end
    0
end

# includes: check if any element equals value
includes(t: any, value: any): bool
    i = 1
    while i <= t:len()
        if t[i] == value return true end
        i += 1
    end
    false
end

# count: count elements matching predicate
count(t: any, pred: any): i64
    n = 0
    i = 1
    while i <= t:len()
        if pred(t[i], i) n += 1 end
        i += 1
    end
    n
end

# all: true if every element matches predicate
all(t: any, pred: any): bool
    i = 1
    while i <= t:len()
        if not pred(t[i], i) return false end
        i += 1
    end
    true
end

# any: true if at least one element matches predicate
any(t: any, pred: any): bool
    i = 1
    while i <= t:len()
        if pred(t[i], i) return true end
        i += 1
    end
    false
end

# ─────────────────────────────────────────────────────────────
# Functional: collection builders
# ─────────────────────────────────────────────────────────────

# flatten: one-level flatten of array of arrays
flatten(t: any): any
    out = {}
    n = 0
    i = 1
    while i <= t:len()
        sub = t[i]
        if type(sub) == "table"
            j = 1
            while j <= sub:len()
                n += 1
                out[n] = sub[j]
                j += 1
            end
        else
            n += 1
            out[n] = sub
        end
        i += 1
    end
    out
end

# flat_map: map then flatten one level
flat_map(t: any, f: any): any
    flatten(map(t, f))
end

# zip: combine N arrays into array of tuples
zip(...): any
    args = {...}
    if args:len() == 0 return {} end
    min_len = args:len()[1]
    i = 2
    while i <= args:len()
        if args:len()[i] < min_len min_len = args:len()[i] end
        i += 1
    end
    out = {}
    j = 1
    while j <= min_len
        tuple = {}
        k = 1
        while k <= args:len()
            tuple[k] = args[k][j]
            k += 1
        end
        out[j] = tuple
        j += 1
    end
    out
end

# enumerate: array to array of {index, value} pairs
enumerate(t: any): any
    out = {}
    i = 1
    while i <= t:len()
        out[i] = { index = i, value = t[i] }
        i += 1
    end
    out
end

# take: first n elements
take(t: any, n: i64): any
    out = {}
    limit = n
    if limit > t:len() limit = t:len() end
    i = 1
    while i <= limit
        out[i] = t[i]
        i += 1
    end
    out
end

# drop: skip first n elements
drop(t: any, n: i64): any
    out = {}
    start = n + 1
    if start > t:len() return out end
    i = start
    j = 1
    while i <= t:len()
        out[j] = t[i]
        i += 1
        j += 1
    end
    out
end

# reverse: return new reversed array
reverse(t: any): any
    out = {}
    n = t:len()
    i = 1
    while i <= n
        out[i] = t[n - i + 1]
        i += 1
    end
    out
end

# unique: remove duplicate elements (preserves first occurrence)
unique(t: any): any
    seen = {}
    out = {}
    n = 0
    i = 1
    while i <= t:len()
        v = t[i]
        key = v:to(str)
        if not seen[key]
            seen[key] = true
            n += 1
            out[n] = v
        end
        i += 1
    end
    out
end

# partition: split array into {matching, rest} based on predicate
partition(t: any, pred: any): any
    yes = {}
    no = {}
    ny = 0
    nn = 0
    i = 1
    while i <= t:len()
        if pred(t[i], i)
            ny += 1
            yes[ny] = t[i]
        else
            nn += 1
            no[nn] = t[i]
        end
        i += 1
    end
    { yes, no }
end

# ─────────────────────────────────────────────────────────────
# Functional: sorting
# ─────────────────────────────────────────────────────────────

# sort: return new sorted array (ascending)
sort(t: any): any
    out = {}
    i = 1
    while i <= t:len()
        out[i] = t[i]
        i += 1
    end
    i = 2
    while i <= out:len()
        key = out[i]
        j = i - 1
        while j >= 1 and out[j] > key
            out[j + 1] = out[j]
            j -= 1
        end
        out[j + 1] = key
        i += 1
    end
    out
end

# sort_by: sort by key function
sort_by(t: any, key_fn: any): any
    indexed = {}
    i = 1
    while i <= t:len()
        indexed[i] = { val = t[i], key = key_fn(t[i]) }
        i += 1
    end
    i = 2
    while i <= indexed:len()
        entry = indexed[i]
        j = i - 1
        while j >= 1 and indexed[j].key > entry.key
            indexed[j + 1] = indexed[j]
            j -= 1
        end
        indexed[j + 1] = entry
        i += 1
    end
    out = {}
    i = 1
    while i <= indexed:len()
        out[i] = indexed[i].val
        i += 1
    end
    out
end

# sort_desc: descending order
sort_desc(t: any): any
    return reverse(sort(t))
end

# ─────────────────────────────────────────────────────────────
# Functional: grouping and aggregation
# ─────────────────────────────────────────────────────────────

# group_by: group array elements by key function
group_by(t: any, key_fn: any): any
    groups = {}
    i = 1
    while i <= t:len()
        k = to(str)(key_fn(t[i]))
        if groups[k] == nil groups[k] = {} end
        groups[k][groups[k]:len() + 1] = t[i]
        i += 1
    end
    groups
end

# count_by: count elements grouped by key function
count_by(t: any, key_fn: any): any
    counts = {}
    i = 1
    while i <= t:len()
        k = to(str)(key_fn(t[i]))
        if counts[k] == nil counts[k] = 0 end
        counts[k] += 1
        i += 1
    end
    counts
end

# sum_by: sum numeric values extracted by key function
sum_by(t: any, key_fn: any): any
    total = 0
    i = 1
    while i <= t:len()
        total += key_fn(t[i])
        i += 1
    end
    total
end

# min_by / max_by: find element with min/max key
min_by(t: any, key_fn: any): any
    if t:len() == 0 return nil end
    best = t[1]
    best_key = key_fn(t[1])
    i = 2
    while i <= t:len()
        k = key_fn(t[i])
        if k < best_key
            best = t[i]
            best_key = k
        end
        i += 1
    end
    best
end

max_by(t: any, key_fn: any): any
    if t:len() == 0 return nil end
    best = t[1]
    best_key = key_fn(t[1])
    i = 2
    while i <= t:len()
        k = key_fn(t[i])
        if k > best_key
            best = t[i]
            best_key = k
        end
        i += 1
    end
    best
end

# ─────────────────────────────────────────────────────────────
# Functional: composition and chaining
# ─────────────────────────────────────────────────────────────

# pipe: left-to-right function composition
pipe(...): any
    funcs = {...}
    return function(x)
        result = x
        i = 1
        while i <= funcs:len()
            result = funcs[i](result)
            i += 1
        end
        return result
    end
end

# compose: right-to-left function composition
compose(...): any
    funcs = {...}
    return function(x)
        result = x
        i = funcs:len()
        while i >= 1
            result = funcs[i](result)
            i -= 1
        end
        return result
    end
end

# partial: partially apply a function with leading args.
#
# The obvious shape — an inner `apply = (...)` closing over `f` and the bound
# args — does not lower: the C backend has no closure capture, so it emitted
# `use of undeclared identifier 'f'` / `'partial_args'` and the whole module
# failed to compile. The state therefore lives in a table and the callable is
# a `__call` metamethod, which receives that table as its first argument and so
# captures nothing.
#
# `partial_invoke` is `_`-prefixed and unexported: it is this module's
# private surface, reachable only through the value `partial`
# hands back.
partial_invoke(self: any, ...): any
    joined = {}
    n = 0
    i = 1
    while i <= self:len().args
        n += 1
        joined[n] = self.args[i]
        i += 1
    end
    extra = {...}
    i = 1
    while i <= extra:len()
        n += 1
        joined[n] = extra[i]
        i += 1
    end
    return self.fn(joined:unpack(1, n))
end

partial(f: any, ...): any
    bound = { fn = f, args = {...} }
    setmetatable(bound, { __call = partial_invoke })
    return bound
end

# tap: side-effecting pass-through
tap(value: any, f: any): any
    f(value)
    value
end

# ─────────────────────────────────────────────────────────────
# Functional: numeric aggregation
# ─────────────────────────────────────────────────────────────

sum(t: any): any
    total = 0
    i = 1
    while i <= t:len()
        total += t[i]
        i += 1
    end
    total
end

product(t: any): any
    total = 1
    i = 1
    while i <= t:len()
        total *= t[i]
        i += 1
    end
    total
end

min(t: any): any
    if t:len() == 0 return nil end
    best = t[1]
    i = 2
    while i <= t:len()
        if t[i] < best best = t[i] end
        i += 1
    end
    best
end

max(t: any): any
    if t:len() == 0 return nil end
    best = t[1]
    i = 2
    while i <= t:len()
        if t[i] > best best = t[i] end
        i += 1
    end
    best
end

# ─────────────────────────────────────────────────────────────
# Functional: key-value transforms
# ─────────────────────────────────────────────────────────────

# map_values: transform only values, keep keys
map_values(t: any, f: any): any
    out = {}
    for k, v in t
        out[k] = f(v, k)
    end
    out
end

# map_keys: transform only keys, keep values
map_keys(t: any, f: any): any
    out = {}
    for k, v in t
        out[f(v, k)] = v
    end
    out
end

# key_by: array to table keyed by extract function
key_by(t: any, key_fn: any): any
    out = {}
    i = 1
    while i <= t:len()
        k = to(str)(key_fn(t[i]))
        out[k] = t[i]
        i += 1
    end
    out
end

# invert: swap keys and values
invert(t: any): any
    out = {}
    for k, v in t
        out[v:to(str)] = k
    end
    out
end

# ─────────────────────────────────────────────────────────────
# Functional: predicate builders
# ─────────────────────────────────────────────────────────────

# eq: build equality predicate
eq(val: any): any
    return (x: any): any x == val
end

# gt / lt / gte / lte: comparison predicates
gt(val: any): any
    return (x: any): any x > val
end

lt(val: any): any
    return (x: any): any x < val
end

gte(val: any): any
    return (x: any): any x >= val
end

lte(val: any): any
    return (x: any): any x <= val
end

# notf: negate a predicate
notf(pred: any): any
    return (x: any): any not pred(x)
end

# andf / orf: combine predicates
andf(...): any
    preds = {...}
    return function(x)
        i = 1
        while i <= preds:len()
            if not preds[i](x) return false end
            i += 1
        end
        return true
    end
end

orf(...): any
    preds = {...}
    return function(x)
        i = 1
        while i <= preds:len()
            if preds[i](x) return true end
            i += 1
        end
        return false
    end
end

# ─────────────────────────────────────────────────────────────
# Functional: utility
# ─────────────────────────────────────────────────────────────

# identity: return value unchanged
identity(x: any): any
    x
end

# always / never: constant predicates
always(): bool
    true
end

never(): bool
    false
end

# noop: do nothing
noop(): void
end

# ─────────────────────────────────────────────────────────────
# Functional: numeric helpers
# ─────────────────────────────────────────────────────────────

clamp(value: any, lo: any, hi: any): any
    if value < lo return lo end
    if value > hi return hi end
    value
end

lerp(a: any, b: any, t: any): any
    a + (b - a) * t
end

abs(x: any): any
    if x < 0 return -x end
    x
end

