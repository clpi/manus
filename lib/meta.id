# meta — reflection, type introspection, and meta utilities
# Derivable concept descriptors live in meta.derive, and macro helpers live
# in meta.macros. Import those submodules directly when needed so the core
# reflection module stays lightweight.

# ─────────────────────────────────────────────────────────────
# Reflection: runtime type introspection
# ─────────────────────────────────────────────────────────────

# Get the type kind of a value as a string
std_meta_typeof: str = (x)
    if x == nil return "nil" 
    if type(x) != "table" return type(x) 
    if getmetatable(x) != nil
        mt = getmetatable(x)
        if has(.type)(mt) return mt.type 
    "table"

# Check if a value is of a specific type kind
is: bool = (x, kind: str)
    std_meta_typeof(x) == kind

is_nil: bool = (x)
    x == nil

is_bool(x): bool
    return type(x) == "boolean"

is_number(x): bool
    return type(x) == "number"

is_str(x): bool
    return type(x) == "string"

is_table(x): bool
    return type(x) == "table"

is_func(x): bool
    return type(x) == "function"

is_integer: bool = (x)
    if type(x) != "number" return false 
    x == x:floor()

is_float: bool = (x)
    if type(x) != "number" return false 
    x != x:floor()

# ─────────────────────────────────────────────────────────────
# Reflection: field and method introspection
# ─────────────────────────────────────────────────────────────

# Get all keys of a table (both array and hash parts)
fields(t: any)
    ks = {}
    for k, _ in t
        ks[ks:len() + 1] = k
    ks

# Get field names (string keys only)
field_names(t: any)
    ks = {}
    for k, _ in t
        if type(k) == "string"
            ks[ks:len() + 1] = k
    ks

# Get method names (function-valued fields)
method_names(t: any)
    ms = {}
    for k, v in t
        if type(k) == "string" and type(v) == "function"
            ms[ms:len() + 1] = k
    ms

# Check if a table has a field
has_field: bool = (t: any, name: str)
    if type(t) != "table" return false 
    t[name] != nil

# Check if a table has a method (function-valued field)
has_method: bool = (t: any, name: str)
    if type(t) != "table" return false 
    return type(t[name]) == "function"

# Get the metatable type name
type_name: str = (t: any)
    if t == nil return "nil" 
    mt = getmetatable(t)
    if mt != nil and mt.type != nil return mt.type 
    return type(t)

# ─────────────────────────────────────────────────────────────
# Reflection: callable and concept introspection
# ─────────────────────────────────────────────────────────────

# Check if a value satisfies a concept (has required fields/methods)
# concept_def is a concept table with required_methods and required_fields
concept_member_name: any = (member: any)
    if type(member) == "string" return member 
    if type(member) == "table" return member.name 
    nil

satisfies_concept: bool = (val: any, concept_def: any)
    if val == nil or concept_def == nil return false 
    if has(.required_fields)(concept_def)
        for _, f in concept_def.required_fields
            name = concept_member_name(f)
            if name == nil or val[name] == nil return false 
    if has(.required_methods)(concept_def)
        for _, m in concept_def.required_methods
            name = concept_member_name(m)
            if name == nil or type(val[name]) != "function" return false 
    true

concept_member: any = (member: any, kind: str)
    if type(member) == "string"
        return { name = member, kind = kind }
    if member.kind == nil member.kind = kind 
    if kind == "method" and member.param_count == nil and member.params != nil
        member.param_count = member.params:len()
    member

concept_member_list: any = (items: any, kind: str)
    out = {}
    if items == nil return out 
    for _, item in items
        out[out:len() + 1] = concept_member(item, kind)
    out

make_concept: any = (name: str, spec: any)
    if spec == nil spec = {} 
    concept_fields = spec.required_fields
    if concept_fields == nil concept_fields = spec.fields 
    concept_methods = spec.required_methods
    if concept_methods == nil concept_methods = spec.methods 
    desc = {
        kind = "concept",
        name = name,
        required_fields = concept_member_list(concept_fields, "field"),
        required_methods = concept_member_list(concept_methods, "method"),
    }
    setmetatable(desc, {
        kind = "concept_metatable",
        type = "concept",
    })
    return desc

# ─────────────────────────────────────────────────────────────
# General table utilities
# ─────────────────────────────────────────────────────────────

len: i64 = (t: any)
    return t:len()

keys(t: any)
    ks = {}
    for k, _ in t
        ks[ks:len() + 1] = k
    ks

values(t: any)
    vs = {}
    for _, v in t
        vs[vs:len() + 1] = v
    vs

has_key: bool = (t: any, key: any)
    if type(t) != "table" return false 
    t[key] != nil

clone(t: any)
    if type(t) != "table" return t 
    c = {}
    for k, v in t
        c[k] = v
    c

merge: any = (dst: any, src: any)
    for k, v in src
        dst[k] = v
    dst

deep_clone(t: any)
    if type(t) != "table" return t 
    c = {}
    for k, v in t
        if type(v) == "table"
            c[k] = deep_clone(v)
        else
            c[k] = v
    c

# Compare two tables for shallow equality
shallow_eq: bool = (a: any, b: any)
    if a == b return true 
    if type(a) != "table" or type(b) != "table" return false 
    for k, v in a
        if b[k] != v return false 
    for k, _ in b
        if a[k] == nil return false 
    true

# Collect garbage (if available) — triggers cycle collector in ARC mode
collect = ()
    collectgarbage("collect")

# Get memory usage stats
memory_stats: any = ()
    return {
        total = collectgarbage("count"),
        step = collectgarbage("step"),
    }

# ─────────────────────────────────────────────────────────────
# Derive helpers: check/bind concept satisfaction
# ─────────────────────────────────────────────────────────────

# Verify that a table-type binding satisfies a concept
# returns true if satisfied, errors with details if not
derive_clone: any = (val: any)
    if type(val) != "table" return val 
    clone(val)

derive_eq: bool = (a: any, b: any)
    if a == nil and b == nil return true 
    if a == nil or b == nil return false 
    if type(a) == "table" and type(b) == "table"
        return shallow_eq(a, b)
    a == b

derive_display: str = (val: any)
    if val == nil return "nil" 
    if type(val) == "boolean"
        if val return "true" else return "false" 
    if type(val) == "number" return val:to(str) 
    if type(val) == "string" return val 
    if type(val) == "table"
        parts = {}
        for k, v in val
            if type(k) == "string"
                parts[parts:len() + 1] = k .. ": " .. derive_display(v)
        return "{" .. parts:concat(", ") .. "}"
    val:to(str)

derive_deep_clone: any = (val: any)
    if type(val) != "table" return val 
    c = {}
    for k, v in val
        if type(v) == "table"
            c[k] = derive_deep_clone(v)
        else
            c[k] = v
    c

derive_default: any = ()
    {}

derive_hash: u64 = (val: any)
    if val == nil return 0 
    if type(val) == "number"
        i = val:floor()
        return i % 4294967296
    if type(val) == "string"
        h = 5381
        for i = 1, val:len()
            h = (h * 33 + val:byte(i)) % 4294967296
        return h
    if type(val) == "table"
        h = 0
        for _, v in val
            h = (h + derive_hash(v)) % 4294967296
        return h
    val:to(str):len()

derive_ord: i64 = (a: any, b: any)
    if a == b return 0 
    if a == nil return -1 
    if b == nil return 1 
    if type(a) == "number" and type(b) == "number"
        if a < b return -1 else return 1 
    sa = a:to(str)
    sb = b:to(str)
    if sa < sb return -1 else return 1 

derive_format: str = (val: any, spec: str)
    if spec == "d" or spec == "i"
        return to(str)(val:floor())
    if spec == "f"
        return "%f":format(val)
    if spec == "x"
        return "%x":format(val:floor())
    if spec == "s"
        return val:to(str)
    if spec == "t"
        return derive_display(val)
    val:to(str)

derive_len: i64 = (val: any)
    if val == nil return 0 
    if type(val) == "string" return val:len() 
    if type(val) == "table" return val:len() 
    0

derive_contains: bool = (val: any, elem: any)
    if type(val) == "table"
        for _, v in val
            if v == elem return true 
    false

derive_iter: any = (val: any)
    if type(val) != "table"
        empty = () nil
        return empty
    val

# ─────────────────────────────────────────────────────────────
# Functional programming: higher-order collection transforms
# ─────────────────────────────────────────────────────────────

# map: transform each element of an array
map: any = (t: any, f: any)
    out = {}
    i = 1
    while i <= t:len()
        out[i] = f(t[i], i)
        i += 1
    out

# mapk: transform each key-value pair
mapk: any = (t: any, f: any)
    out = {}
    for k, v in t
        out[k] = f(v, k)
    out

# filter: keep elements where predicate returns true
filter: any = (t: any, pred: any)
    out = {}
    n = 0
    i = 1
    while i <= t:len()
        if pred(t[i], i)
            n += 1
            out[n] = t[i]
        i += 1
    out

# filterk: keep entries where predicate(value, key) returns true
filterk: any = (t: any, pred: any)
    out = {}
    for k, v in t
        if pred(v, k)
            out[k] = v
    out

# reduce: fold array left-to-right with accumulator
reduce: any = (t: any, f: any, init: any)
    acc = init
    i = 1
    while i <= t:len()
        acc = f(acc, t[i], i)
        i += 1
    acc

# reducek: fold table with (accumulator, value, key)
reducek: any = (t: any, f: any, init: any)
    acc = init
    for k, v in t
        acc = f(acc, v, k)
    acc

# each: call side-effecting function on each element
each = (t: any, f: any)
    i = 1
    while i <= t:len()
        f(t[i], i)
        i += 1

# eachk: call side-effecting function on each key-value pair
eachk = (t: any, f: any)
    for k, v in t
        f(v, k)

# find: return first element matching predicate, or nil
find: any = (t: any, pred: any)
    i = 1
    while i <= t:len()
        if pred(t[i], i) return t[i] 
        i += 1
    nil

# findk: return first key whose value matches predicate
findk: any = (t: any, pred: any)
    for k, v in t
        if pred(v, k) return k 
    nil

# find_index: return 1-based index of first matching element, or 0
find_index: i64 = (t: any, pred: any)
    i = 1
    while i <= t:len()
        if pred(t[i], i) return i 
        i += 1
    0

# includes: check if any element equals value
includes: bool = (t: any, value: any)
    i = 1
    while i <= t:len()
        if t[i] == value return true 
        i += 1
    false

# count: count elements matching predicate
count: i64 = (t: any, pred: any)
    n = 0
    i = 1
    while i <= t:len()
        if pred(t[i], i) n += 1 
        i += 1
    n

# all: true if every element matches predicate
all: bool = (t: any, pred: any)
    i = 1
    while i <= t:len()
        if not pred(t[i], i) return false 
        i += 1
    true

# ─────────────────────────────────────────────────────────────
# Functional: collection builders
# ─────────────────────────────────────────────────────────────

# flatten: one-level flatten of array of arrays
flatten: any = (t: any)
    out = {}
    n = 0
    i = 1
    while i <= t:len()
        sub = t[i]
        if type(sub) == "table"
            j = 1
            while j <= sub:len()
                n += 1
                out[n] = sub[j]
                j += 1
        else
            n += 1
            out[n] = sub
        i += 1
    out

# flat_map: map then flatten one level
flat_map: any = (t: any, f: any)
    flatten(map(t, f))

# zip: combine N arrays into array of tuples
zip: any = (...)
    args = {...}
    if args:len() == 0 return {} 
    min_len = args[1]:len()
    i = 2
    while i <= args:len()
        if args[i]:len() < min_len min_len = args[i]:len() 
        i += 1
    out = {}
    j = 1
    while j <= min_len
        tuple = {}
        k = 1
        while k <= args:len()
            tuple[k] = args[k][j]
            k += 1
        out[j] = tuple
        j += 1
    out

# enumerate: array to array of {index, value} pairs
enumerate: any = (t: any)
    out = {}
    i = 1
    while i <= t:len()
        out[i] = { index = i, value = t[i] }
        i += 1
    out

# take: first n elements
take: any = (t: any, n: i64)
    out = {}
    limit = n
    if limit > t:len() limit = t:len() 
    i = 1
    while i <= limit
        out[i] = t[i]
        i += 1
    out

# drop: skip first n elements
drop: any = (t: any, n: i64)
    out = {}
    start = n + 1
    if start > t:len() return out 
    i = start
    j = 1
    while i <= t:len()
        out[j] = t[i]
        i += 1
        j += 1
    out

# reverse: return new reversed array
reverse: any = (t: any)
    out = {}
    n = t:len()
    i = 1
    while i <= n
        out[i] = t[n - i + 1]
        i += 1
    out

# unique: remove duplicate elements (preserves first occurrence)
unique: any = (t: any)
    seen = {}
    out = {}
    n = 0
    i = 1
    while i <= t:len()
        v = t[i]
        key = v:to(str)
        if not seen[key]
            seen[key] = true
            n += 1
            out[n] = v
        i += 1
    out

# partition: split array into {matching, rest} based on predicate
partition: any = (t: any, pred: any)
    yes = {}
    no = {}
    ny = 0
    nn = 0
    i = 1
    while i <= t:len()
        if pred(t[i], i)
            ny += 1
            yes[ny] = t[i]
        else
            nn += 1
            no[nn] = t[i]
        i += 1
    { yes, no }

# ─────────────────────────────────────────────────────────────
# Functional: sorting
# ─────────────────────────────────────────────────────────────

# sort: return new sorted array (ascending)
sort: any = (t: any)
    out = {}
    i = 1
    while i <= t:len()
        out[i] = t[i]
        i += 1
    i = 2
    while i <= out:len()
        key = out[i]
        j = i - 1
        while j >= 1 and out[j] > key
            out[j + 1] = out[j]
            j -= 1
        out[j + 1] = key
        i += 1
    out

# sort_by: sort by key function
sort_by: any = (t: any, key_fn: any)
    indexed = {}
    i = 1
    while i <= t:len()
        indexed[i] = { val = t[i], key = key_fn(t[i]) }
        i += 1
    i = 2
    while i <= indexed:len()
        entry = indexed[i]
        j = i - 1
        while j >= 1 and indexed[j].key > entry.key
            indexed[j + 1] = indexed[j]
            j -= 1
        indexed[j + 1] = entry
        i += 1
    out = {}
    i = 1
    while i <= indexed:len()
        out[i] = indexed[i].val
        i += 1
    out

# sort_desc: descending order
sort_desc: any = (t: any)
    return reverse(sort(t))

# ─────────────────────────────────────────────────────────────
# Functional: grouping and aggregation
# ─────────────────────────────────────────────────────────────

# group_by: group array elements by key function
group_by: any = (t: any, key_fn: any)
    groups = {}
    i = 1
    while i <= t:len()
        k = to(str)(key_fn(t[i]))
        if groups[k] == nil groups[k] = {} 
        groups[k][groups[k]:len() + 1] = t[i]
        i += 1
    groups

# count_by: count elements grouped by key function
count_by: any = (t: any, key_fn: any)
    counts = {}
    i = 1
    while i <= t:len()
        k = to(str)(key_fn(t[i]))
        if counts[k] == nil counts[k] = 0 
        counts[k] += 1
        i += 1
    counts

# sum_by: sum numeric values extracted by key function
sum_by: any = (t: any, key_fn: any)
    total = 0
    i = 1
    while i <= t:len()
        total += key_fn(t[i])
        i += 1
    total

# min_by / max_by: find element with min/max key
min_by: any = (t: any, key_fn: any)
    if t:len() == 0 return nil 
    best = t[1]
    best_key = key_fn(t[1])
    i = 2
    while i <= t:len()
        k = key_fn(t[i])
        if k < best_key
            best = t[i]
            best_key = k
        i += 1
    best

max_by: any = (t: any, key_fn: any)
    if t:len() == 0 return nil 
    best = t[1]
    best_key = key_fn(t[1])
    i = 2
    while i <= t:len()
        k = key_fn(t[i])
        if k > best_key
            best = t[i]
            best_key = k
        i += 1
    best

# ─────────────────────────────────────────────────────────────
# Functional: composition and chaining
# ─────────────────────────────────────────────────────────────

# pipe: left-to-right function composition
pipe: any = (...)
    funcs = {...}
    return function(x)
                    result = x
                    i = 1
                    while i <= funcs:len()
                        result = funcs[i](result)
                        i += 1
                    return result

# compose: right-to-left function composition
compose: any = (...)
    funcs = {...}
    return function(x)
                    result = x
                    i = funcs:len()
                    while i >= 1
                        result = funcs[i](result)
                        i -= 1
                    return result

# partial: partially apply a function with leading args.
#
# The obvious shape — an inner `apply = (...)` closing over `f` and the bound
# args — does not lower: the C backend has no closure capture, so it emitted
# `use of undeclared identifier 'f'` / `'partial_args'` and the whole module
# failed to compile. The state therefore lives in a table and the callable is
# a `__call` metamethod, which receives that table as its first argument and so
# captures nothing.
#
# `partial_invoke` is `_`-prefixed and unexported: it is this module's
# private surface, reachable only through the value `partial`
# hands back.
partial_invoke: any = (self: any, ...)
    joined = {}
    n = 0
    i = 1
    while i <= self.args:len()
        n += 1
        joined[n] = self.args[i]
        i += 1
    extra = {...}
    i = 1
    while i <= extra:len()
        n += 1
        joined[n] = extra[i]
        i += 1
    return self.fn(joined:unpack(1, n))

partial: any = (f: any, ...)
    bound = { fn = f, args = {...} }
    setmetatable(bound, { __call = partial_invoke })
    return bound

# tap: side-effecting pass-through
tap: any = (value: any, f: any)
    f(value)
    value

# ─────────────────────────────────────────────────────────────
# Functional: numeric aggregation
# ─────────────────────────────────────────────────────────────

sum: any = (t: any)
    total = 0
    i = 1
    while i <= t:len()
        total += t[i]
        i += 1
    total

product: any = (t: any)
    total = 1
    i = 1
    while i <= t:len()
        total *= t[i]
        i += 1
    total

min: any = (t: any)
    if t:len() == 0 return nil 
    best = t[1]
    i = 2
    while i <= t:len()
        if t[i] < best best = t[i] 
        i += 1
    best

max: any = (t: any)
    if t:len() == 0 return nil 
    best = t[1]
    i = 2
    while i <= t:len()
        if t[i] > best best = t[i] 
        i += 1
    best

# ─────────────────────────────────────────────────────────────
# Functional: key-value transforms
# ─────────────────────────────────────────────────────────────

# map_values: transform only values, keep keys
map_values: any = (t: any, f: any)
    out = {}
    for k, v in t
        out[k] = f(v, k)
    out

# map_keys: transform only keys, keep values
map_keys: any = (t: any, f: any)
    out = {}
    for k, v in t
        out[f(v, k)] = v
    out

# key_by: array to table keyed by extract function
key_by: any = (t: any, key_fn: any)
    out = {}
    i = 1
    while i <= t:len()
        k = to(str)(key_fn(t[i]))
        out[k] = t[i]
        i += 1
    out

# invert: swap keys and values
invert: any = (t: any)
    out = {}
    for k, v in t
        out[v:to(str)] = k
    out

# ─────────────────────────────────────────────────────────────
# Functional: predicate builders
# ─────────────────────────────────────────────────────────────

# eq: build equality predicate
eq: any = (val: any)
    return (x: any): any x == val

# gt / lt / gte / lte: comparison predicates
gt: any = (val: any)
    return (x: any): any x > val

lt: any = (val: any)
    return (x: any): any x < val

gte: any = (val: any)
    return (x: any): any x >= val

lte: any = (val: any)
    return (x: any): any x <= val

# notf: negate a predicate
notf: any = (pred: any)
    return (x: any): any not pred(x)

# andf / orf: combine predicates
andf: any = (...)
    preds = {...}
    return function(x)
                    i = 1
                    while i <= preds:len()
                        if not preds[i](x) return false 
                        i += 1
                    return true

orf: any = (...)
    preds = {...}
    return function(x)
                    i = 1
                    while i <= preds:len()
                        if preds[i](x) return true 
                        i += 1
                    return false

# ─────────────────────────────────────────────────────────────
# Functional: utility
# ─────────────────────────────────────────────────────────────

# identity: return value unchanged
identity: any = (x: any)
    x

# always / never: constant predicates
always: bool = ()
    true

never: bool = ()
    false

# noop: do nothing
noop = ()

# ─────────────────────────────────────────────────────────────
# Functional: numeric helpers
# ─────────────────────────────────────────────────────────────

clamp: any = (value: any, lo: any, hi: any)
    if value < lo return lo 
    if value > hi return hi 
    value

lerp: any = (a: any, b: any, t: any)
    a + (b - a) * t

abs: any = (x: any)
    if x < 0 return -x 
    x

# Module table — everything exported
M = {}
# Reflection
M.typeof = std_meta_typeof
M.is = is
M.is_nil = is_nil
M.is_bool = is_bool
M.is_number = is_number
M.is_str = is_str
M.is_table = is_table
M.is_func = is_func
M.is_integer = is_integer
M.is_float = is_float
# Field introspection
M.fields = fields
M.field_names = field_names
M.method_names = method_names
M.has_field = has_field
M.has_method = has_method
M.type_name = type_name
M.satisfies_concept = satisfies_concept
M.make_concept = make_concept
M["concept"] = make_concept
# Table utilities
M.len = len
M.keys = keys
M.values = values
M.has_key = has_key
M.clone = clone
M.merge = merge
M.deep_clone = deep_clone
M.shallow_eq = shallow_eq
# Memory
M.collect = collect
