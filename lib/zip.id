# zip — ZIP archive utilities

proc = proc
fs = fs

create: bool = (archive_path: str, source_dir: str)
  cmd = "cd " .. source_dir .. " && zip -r -q " .. archive_path .. " ."
  proc.exec(cmd) == 0

create_files: bool = (archive_path: str, files: any)
  if files == nil or files:len() == 0
    return false
  file_args = files:concat(" ")
  cmd = "zip -q " .. archive_path .. " " .. file_args
  proc.exec(cmd) == 0

extract: bool = (archive_path: str, dest_dir: str)
  proc.exec("mkdir -p " .. dest_dir)
  cmd = "unzip -q " .. archive_path .. " -d " .. dest_dir
  proc.exec(cmd) == 0

extract_overwrite: bool = (archive_path: str, dest_dir: str)
  proc.exec("mkdir -p " .. dest_dir)
  cmd = "unzip -o -q " .. archive_path .. " -d " .. dest_dir
  proc.exec(cmd) == 0

list: any = (archive_path: str)
  handle = io.popen("unzip -l " .. archive_path .. " 2>/dev/null")
  if handle == nil
    return {}
  output = handle:read("*a")
  handle:close()
  files = {}
  in_listing = false
  for line in output:gmatch("[^\n]+")
    if in_listing
      if line:match("^%-")
        break
      name = line:match("^%s+%d+%s+%S+%s+(.+)$")
      if name and name != ""
        files(files:len() + 1) = name
    if line:match("^%s+Length")
      in_listing = true
  files

list_detailed: any = (archive_path: str)
  handle = io.popen("unzip -l " .. archive_path .. " 2>/dev/null")
  if handle == nil
    return {}
  output = handle:read("*a")
  handle:close()
  files = {}
  in_listing = false
  for line in output:gmatch("[^\n]+")
    if in_listing
      if line:match("^%-")
        break
      size, date, time, name = line:match("^%s+(%d+)%s+(%S+)%s+(%S+)%s+(.+)$")
      if name and name != ""
        files(files:len() + 1) =
          name = name
          size = size:to(i64)
          date = date
          time = time
    if line:match("^%s+Length")
      in_listing = true
  files

info: any = (archive_path: str)
  if not fs.exists(archive_path)
    return nil
  handle = io.popen("unzip -l " .. archive_path .. " 2>/dev/null")
  if handle == nil
    return nil
  output = handle:read("*a")
  handle:close()
  total_size, file_count = output:match("(%d+)%s+files?$")
  method, compressed, ratio, flag = output:match("^%s*(%S+)%s+(%d+)%s+(%d+)%%.*$")
  return {
    path = archive_path,
    file_count = file_count:to(i64) or 0,
    total_size = total_size:to(i64) or 0
  }

add_file: bool = (archive_path: str, file_path: str)
  cmd = "zip -q " .. archive_path .. " " .. file_path
  proc.exec(cmd) == 0

remove_file: bool = (archive_path: str, file_path: str)
  cmd = "zip -d -q " .. archive_path .. " " .. file_path
  proc.exec(cmd) == 0

test: bool = (archive_path: str)
  cmd = "unzip -t " .. archive_path .. " 2>/dev/null"
  proc.exec(cmd) == 0
