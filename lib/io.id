
read: any = (file: any, arg: any)
  file:read(arg)

write: any = (file: any, arg: any)
  file:write(arg)

close = (file: any)
  file:close()

flush = (file: any)
  file:flush()

bytes: str = (file: any, n: int)
  file:read(n)

put = (file: any, data: str)
  file:write(data)

line: any = (file: any)
  file:read("*l")

all: any = (file: any)
  file:read("*a")
