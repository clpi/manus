# io home — subject-first handle relations only.
# No @c.emit. No lua. Namespace io.method() is forbidden — use io:read / handle:read.

read(file: any, arg: any): any
    file:read(arg)

write(file: any, arg: any): any
    file:write(arg)

close(file: any): void
    file:close()

flush(file: any): void
    file:flush()

bytes(file: any, n: int): str
    file:read(n)

put(file: any, data: str): void
    file:write(data)

line(file: any): any
    file:read("*l")

all(file: any): any
    file:read("*a")
