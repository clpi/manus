

ring_new: any = (capacity: i64)
    actual = 1
    while actual < capacity
        actual *= 2
    {
        buf = {},
        capacity = actual,
        mask = actual - 1,
        read_pos = 0,
        write_pos = 0,
    }

ring_push: bool = (rb: any, value: any)
    wp = rb.write_pos
    rp = rb.read_pos
    if wp - rp >= rb.capacity return false 
    rb.buf[(wp & rb.mask) + 1] = value
    rb.write_pos = wp + 1
    true

ring_pop: any = (rb: any)
    rp = rb.read_pos
    if rp >= rb.write_pos return nil 
    val = rb.buf[(rp & rb.mask) + 1]
    rb.buf[(rp & rb.mask) + 1] = nil
    rb.read_pos = rp + 1
    val

ring_peek: any = (rb: any)
    rp = rb.read_pos
    if rp >= rb.write_pos return nil 
    rb.buf[(rp & rb.mask) + 1]

ring_len: i64 = (rb: any)
    rb.write_pos - rb.read_pos

ring_free: i64 = (rb: any)
    rb.capacity - (rb.write_pos - rb.read_pos)

ring_is_empty: bool = (rb: any)
    rb.write_pos == rb.read_pos

ring_is_full: bool = (rb: any)
    rb.write_pos - rb.read_pos >= rb.capacity

ring_drain: any = (rb: any, max: i64)
    out = {}
    count = 0
    while count < max
        val = ring_pop(rb)
        if val == nil break 
        out[out:len() + 1] = val
        count += 1
    out

ring_clear = (rb: any)
    rb.buf = {}
    rb.read_pos = 0
    rb.write_pos = 0


double_buffer_new: any = ()
    {
        front = {},
        back = {},
        read_idx = 1,
    }

double_buffer_swap = (db: any)
    if db.read_idx == 1
        db.read_idx = 2
    else
        db.read_idx = 1

double_buffer_write = (db: any, data: any)
    if db.read_idx == 1
        db.back = data
    else
        db.front = data

double_buffer_read: any = (db: any)
    if db.read_idx == 1
        return db.front
    db.back


mem_pool_new: any = (block_size: i64, block_count: i64)
    blocks = {}
    i = 0
    while i < block_count
        blocks[i + 1] = {data = {}, in_use = false, id = i}
        i += 1
    {
        block_size = block_size,
        block_count = block_count,
        blocks = blocks,
        free_count = block_count,
        alloc_count = 0,
    }

mem_pool_alloc: any = (pool: any)
    i = 1
    while i <= pool.block_count
        if not pool.blocks[i].in_use
            pool.blocks[i].in_use = true
            pool.free_count -= 1
            pool.alloc_count += 1
            return pool.blocks[i]
        i += 1
    nil

mem_pool_free = (pool: any, block: any)
    if block == nil return 
    block.in_use = false
    block.data = {}
    pool.free_count += 1
    pool.alloc_count -= 1

mem_pool_stats: any = (pool: any)
    {
        total = pool.block_count,
        free = pool.free_count,
        allocated = pool.alloc_count,
        utilization = pool.alloc_count / pool.block_count,
    }


slab_allocator_new: any = ()
    {
        slabs = {},
        total_allocated = 0,
    }

slab_alloc: any = (sa: any, size_class: i64, count: i64)
    if sa.slabs[size_class] == nil
        sa.slabs[size_class] = mem_pool_new(size_class, count)
    mem_pool_alloc(sa.slabs[size_class])

slab_free = (sa: any, size_class: i64, block: any)
    if sa.slabs[size_class] == nil return 
    mem_pool_free(sa.slabs[size_class], block)

slab_stats: any = (sa: any)
    stats = {}
    for size_class, pool in sa.slabs
        stats[size_class] = mem_pool_stats(pool)
    stats


vmem_arena_new: any = (initial_pages: i64, max_pages: i64)
    page_size = 4096
    {
        page_size = page_size,
        max_pages = max_pages,
        committed_pages = initial_pages,
        used_bytes = 0,
        pages = {},
        total_bytes = initial_pages * page_size,
    }

vmem_arena_alloc: any = (arena: any, size: i64)
    aligned = size / 8:ceil() * 8

    if arena.used_bytes + aligned > arena.total_bytes
        needed = (arena.used_bytes + aligned - arena.total_bytes) / arena.page_size:ceil()
        arena.committed_pages = arena.committed_pages + needed
        if arena.committed_pages > arena.max_pages
            return nil
        arena.total_bytes = arena.committed_pages * arena.page_size

    offset = arena.used_bytes
    arena.used_bytes += aligned
    {offset = offset, size = aligned}

vmem_arena_reset = (arena: any)
    arena.used_bytes = 0

vmem_arena_stats: any = (arena: any)
    {
        used_bytes = arena.used_bytes,
        total_bytes = arena.total_bytes,
        committed_pages = arena.committed_pages,
        max_pages = arena.max_pages,
        utilization = arena.used_bytes / arena.total_bytes,
    }


