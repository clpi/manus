# mem — Enhanced memory primitives: ring buffer, mmap wrapper, virtual memory arena
# Extends the existing mem.id with advanced memory management for runtime and networking.

# ═══════════════════════════════════════════════════════════════
# Ring Buffer (lock-free SPSC for producer-consumer patterns)
# ═══════════════════════════════════════════════════════════════

ring_new(capacity: i64): any
    # Round up to power of two for efficient modulo
    actual = 1
    while actual < capacity
        actual *= 2
    {
        buf = {},
        capacity = actual,
        mask = actual - 1,
        read_pos = 0,
        write_pos = 0,
    }

ring_push(rb: any, value: any): bool
    wp = rb.write_pos
    rp = rb.read_pos
    # Check if full
    if wp - rp >= rb.capacity return false 
    rb.buf[(wp & rb.mask) + 1] = value
    rb.write_pos = wp + 1
    true

ring_pop(rb: any): any
    rp = rb.read_pos
    if rp >= rb.write_pos return nil 
    val = rb.buf[(rp & rb.mask) + 1]
    rb.buf[(rp & rb.mask) + 1] = nil  # help GC
    rb.read_pos = rp + 1
    val

ring_peek(rb: any): any
    rp = rb.read_pos
    if rp >= rb.write_pos return nil 
    rb.buf[(rp & rb.mask) + 1]

ring_rb: any:len(): i64
    rb.write_pos - rb.read_pos

ring_free(rb: any): i64
    rb.capacity - (rb.write_pos - rb.read_pos)

ring_is_empty(rb: any): bool
    rb.write_pos == rb.read_pos

ring_is_full(rb: any): bool
    rb.write_pos - rb.read_pos >= rb.capacity

ring_drain(rb: any, max: i64): any
    out = {}
    count = 0
    while count < max
        val = ring_pop(rb)
        if val == nil break 
        out[out:len() + 1] = val
        count += 1
    out

ring_clear(rb: any): void
    rb.buf = {}
    rb.read_pos = 0
    rb.write_pos = 0

# ═══════════════════════════════════════════════════════════════
# Double Buffer (swap between read/write buffers)
# ═══════════════════════════════════════════════════════════════

double_buffer_new(): any
    {
        front = {},
        back = {},
        read_idx = 1,  # 1 = front, 2 = back
    }

double_buffer_swap(db: any): void
    if db.read_idx == 1
        db.read_idx = 2
    else
        db.read_idx = 1

double_buffer_write(db: any, data: any): void
    if db.read_idx == 1
        db.back = data
    else
        db.front = data

double_buffer_read(db: any): any
    if db.read_idx == 1
        return db.front
    db.back

# ═══════════════════════════════════════════════════════════════
# Memory Pool (pre-allocated fixed-size blocks)
# ═══════════════════════════════════════════════════════════════

mem_pool_new(block_size: i64, block_count: i64): any
    blocks = {}
    i = 0
    while i < block_count
        blocks[i + 1] = {data = {}, in_use = false, id = i}
        i += 1
    {
        block_size = block_size,
        block_count = block_count,
        blocks = blocks,
        free_count = block_count,
        alloc_count = 0,
    }

mem_pool_alloc(pool: any): any
    i = 1
    while i <= pool.block_count
        if not pool.blocks[i].in_use
            pool.blocks[i].in_use = true
            pool.free_count -= 1
            pool.alloc_count += 1
            return pool.blocks[i]
        i += 1
    nil  # out of blocks

mem_pool_free(pool: any, block: any): void
    if block == nil return 
    block.in_use = false
    block.data = {}
    pool.free_count += 1
    pool.alloc_count -= 1

mem_pool_stats(pool: any): any
    {
        total = pool.block_count,
        free = pool.free_count,
        allocated = pool.alloc_count,
        utilization = pool.alloc_count / pool.block_count,
    }

# ═══════════════════════════════════════════════════════════════
# Slab Allocator (size-segregated pools for different object sizes)
# ═══════════════════════════════════════════════════════════════

slab_allocator_new(): any
    {
        slabs = {},
        total_allocated = 0,
    }

slab_alloc(sa: any, size_class: i64, count: i64): any
    if sa.slabs[size_class] == nil
        sa.slabs[size_class] = mem_pool_new(size_class, count)
    mem_pool_alloc(sa.slabs[size_class])

slab_free(sa: any, size_class: i64, block: any): void
    if sa.slabs[size_class] == nil return 
    mem_pool_free(sa.slabs[size_class], block)

slab_stats(sa: any): any
    stats = {}
    for size_class, pool in sa.slabs
        stats[size_class] = mem_pool_stats(pool)
    stats

# ═══════════════════════════════════════════════════════════════
# Virtual Memory Arena (bump allocator with commit/decommit)
# ═══════════════════════════════════════════════════════════════

vmem_arena_new(initial_pages: i64, max_pages: i64): any
    page_size = 4096
    {
        page_size = page_size,
        max_pages = max_pages,
        committed_pages = initial_pages,
        used_bytes = 0,
        pages = {},
        total_bytes = initial_pages * page_size,
    }

vmem_arena_alloc(arena: any, size: i64): any
    # Align to 8 bytes
    aligned = size / 8:ceil() * 8

    # Check if we need more pages
    if arena.used_bytes + aligned > arena.total_bytes
        needed = (arena.used_bytes + aligned - arena.total_bytes) / arena.page_size:ceil()
        arena.committed_pages = arena.committed_pages + needed
        if arena.committed_pages > arena.max_pages
            return nil
        arena.total_bytes = arena.committed_pages * arena.page_size

    offset = arena.used_bytes
    arena.used_bytes += aligned
    {offset = offset, size = aligned}

vmem_arena_reset(arena: any): void
    arena.used_bytes = 0

vmem_arena_stats(arena: any): any
    {
        used_bytes = arena.used_bytes,
        total_bytes = arena.total_bytes,
        committed_pages = arena.committed_pages,
        max_pages = arena.max_pages,
        utilization = arena.used_bytes / arena.total_bytes,
    }

