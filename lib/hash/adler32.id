
new: any = ()
  { s1 = 1, s2 = 0 }

update = (state: any, data: str)
  if data == nil
    return
  for i = 1, data:len()
    state.s1 = (state.s1 + data:byte(i)) % 65521
    state.s2 = (state.s2 + state.s1) % 65521

final: i64 = (state: any)
  (state.s2 * 65536 + state.s1) % 4294967296

checksum: i64 = (data: str)
  s = new()
  update(s, data)
  final(s)
