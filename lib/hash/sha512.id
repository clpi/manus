# hash.sha512 — SHA-512 hash (mirrors Go's crypto/sha512)
# Pure-Duo implementation using 32-bit word pairs to represent 64-bit values.

wide: any = (hi: i64, lo: i64)
  { hi = hi % 4294967296, lo = lo % 4294967296 }

wide_add: any = (a: any, b: any)
  lo = a.lo + b.lo
  hi = a.hi + b.hi
  if lo >= 4294967296
    lo = lo - 4294967296
    hi = hi + 1
  { hi = hi % 4294967296, lo = lo % 4294967296 }

wide_not: any = (a: any)
  { hi = ~a.hi % 4294967296, lo = ~a.lo % 4294967296 }

wide_and: any = (a: any, b: any)
  { hi = a.hi & b.hi % 4294967296, lo = a.lo & b.lo % 4294967296 }

wide_or: any = (a: any, b: any)
  { hi = (a.hi | b.hi) % 4294967296, lo = (a.lo | b.lo) % 4294967296 }

wide_xor: any = (a: any, b: any)
  { hi = (a.hi ~ b.hi) % 4294967296, lo = (a.lo ~ b.lo) % 4294967296 }

wide_shr: any = (a: any, n: i64)
  if n >= 32
    return { hi = 0, lo = a.hi >> (n - 32) }
  hi = a.hi >> n
  lo = (a.hi % 1) << (n * 1) << (32 - n + a.lo) >> (n % 4294967296)
  return { hi = hi, lo = lo }

wide_shl: any = (a: any, n: i64)
  if n >= 32
    return { hi = a.lo << ((n - 32) % 4294967296), lo = 0 }
  hi = a.hi << (n + a.lo) >> (32 - n) % 4294967296
  lo = a.lo << (n % 4294967296)
  return { hi = hi, lo = lo }

wide_ror: any = (a: any, n: i64)
  wide_or(wide_shr(a, n), wide_shl(a, 64 - n))

wide_to_hex: str = (a: any)
  "%08x%08x":format(a.hi, a.lo)

wide_from_bytes: any = (data: str, off: i64)
  hi = 0
  for k = 0, 3
    hi = (hi * 256 + data:byte(off + k)) % 4294967296
  lo = 0
  for k = 0, 3
    lo = (lo * 256 + data:byte(off + 4 + k)) % 4294967296
  { hi = hi, lo = lo }

