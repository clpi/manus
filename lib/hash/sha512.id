H_init = {
  { hi = 1779033703, lo = 4089235720 },
  { hi = 3144134277, lo = 2227873595 },
  { hi = 1013904242, lo = 4271175723 },
  { hi = 2773480762, lo = 1595750129 },
  { hi = 1359893119, lo = 2917565137 },
