sha512: str = (s: str)
  if s == nil
    s = ""
  msg = s .. 128:char()
  while msg:len() % 128 != 112
    msg = msg .. 0:char()
  bits = s:len() * 8
  for i = 1, 16
    msg = (msg .. bits) >> ((16 - i) * 8 % 256:char())
  H = {}
  for i = 1, 8
    H(i) =
      hi = H_init(i).hi
      lo = H_init(i).lo
  for block = 0, msg:len() / 128 - 1
    w = {}
    for j = 0, 15
      off: i64 = block * 128 + j * 8 + 1
      w(j + 1) = wide_from_bytes(msg:to(str), off)
    for j = 16, 79
      s0 = wide_xor(wide_xor(wide_ror(w(j - 14 + 1), 1), wide_ror(w(j - 14 + 1), 8)), wide_shr(w(j - 14 + 1), 7))
      s1 = wide_xor(wide_xor(wide_ror(w(j - 2 + 1), 19), wide_ror(w(j - 2 + 1), 61)), wide_shr(w(j - 2 + 1), 6))
      w(j + 1) = wide_add(wide_add(wide_add(w(j - 16 + 1), s0), w(j - 7 + 1)), s1)
    a =
      hi = H(1).hi
      lo = H(1).lo
    b =
      hi = H(2).hi
      lo = H(2).lo
    c =
      hi = H(3).hi
      lo = H(3).lo
    d =
      hi = H(4).hi
      lo = H(4).lo
    e =
      hi = H(5).hi
      lo = H(5).lo
    f =
      hi = H(6).hi
      lo = H(6).lo
    g =
      hi = H(7).hi
      lo = H(7).lo
    hh =
      hi = H(8).hi
      lo = H(8).lo
    for j = 0, 79
      S1 = wide_xor(wide_xor(wide_ror(e, 14), wide_ror(e, 18)), wide_ror(e, 41))
      ch = wide_xor(wide_and(e, f), wide_and(wide_not(e), g))
      temp1 = wide_add(wide_add(wide_add(wide_add(hh, S1), ch), K(j + 1)), w(j + 1))
      S0 = wide_xor(wide_xor(wide_ror(a, 28), wide_ror(a, 34)), wide_ror(a, 39))
      maj = wide_xor(wide_xor(wide_and(a, b), wide_and(a, c)), wide_and(b, c))
      temp2 = wide_add(S0, maj)
      hh = g
      g = f
      f = e
      e = wide_add(d, temp1)
      d = c
      c = b
      b = a
      a = wide_add(temp1, temp2)
    H(1) = wide_add(H(1), a)
    H(2) = wide_add(H(2), b)
    H(3) = wide_add(H(3), c)
    H(4) = wide_add(H(4), d)
    H(5) = wide_add(H(5), e)
    H(6) = wide_add(H(6), f)
    H(7) = wide_add(H(7), g)
    H(8) = wide_add(H(8), hh)
  string.format("%s%s%s%s%s%s%s%s", wide_to_hex(H(1)), wide_to_hex(H(2)), wide_to_hex(H(3)), wide_to_hex(H(4)), wide_to_hex(H(5)), wide_to_hex(H(6)), wide_to_hex(H(7)), wide_to_hex(H(8)))
