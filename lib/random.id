# random — Random number generation and utilities

# seed: seed the random number generator.
seed = (s: int)
  math.randomseed(s)

# float: return a random float in [0, 1).
float: float = ()
  math.random()

# int: return a random integer in [min, max] (inclusive).
# If only one argument, returns random int in [1, max].
int: int = (min: int, max: int)
  if max == nil
    min:random()
  else
    min:random(max)

# rand_bool: return a random boolean (50/50).
rand_bool: bool = ()
  math.random() < 0.5

# bool_weighted: return a random boolean with the given probability of true.
bool_weighted: bool = (p: float)
  math.random() < p

# choice: return a random element from a list.
choice: any = (list: any)
  if list == nil or list:len() == 0
    return nil
  list(1:random(list:len()))

# sample: return n unique random elements from a list (without replacement).
sample: any = (list: any, n: i64)
  out = {}
  if list == nil or n <= 0
    return out
  len = list:len()
  if n > len
    n = len
  indices = {}
  i = 1
  while i <= len
    indices[i] = i
    i = i + 1
  picked = 0
  while picked < n
    swap_idx = picked + 1:random(len)
    tmp = indices[picked + 1]
    indices[picked + 1] = indices[swap_idx]
    indices[swap_idx] = tmp
    out(out:len() + 1) = list(indices[picked + 1])
    picked = picked + 1
  out

# pick_n: alias for sample (more idiomatic name).
pick_n: any = (list: any, n: i64)
  sample(list, n)

# weighted_choice: choose from items with corresponding weights.
# items: list of values, weights: parallel list of numeric weights.
weighted_choice: any = (items: any, weights: any)
  if items == nil or weights == nil
    return nil
  len = items:len()
  if len == 0
    return nil
  if weights:len() != len
    return nil
  total = 0
  i = 1
  while i <= len
    total = total + weights[i]
    i = i + 1
  r = math.random() * total
  cumulative = 0
  i = 1
  while i <= len
    cumulative = cumulative + weights[i]
    if r <= cumulative
      return items[i]
    i = i + 1
  items[len]

# range: return a list of integers from start to stop (exclusive), with optional step.
range: any = (start: i64, stop: i64, step: i64)
  out = {}
  if step == nil
    step = 1
  if step == 0
    return out
  if step > 0
    i = start
    while i < stop
      out(out:len() + 1) = i
      i = i + step
  else
    i = start
    while i > stop
      out(out:len() + 1) = i
      i = i + step
  out

# gauss: return a random number from a normal distribution (Box-Muller).
gauss: float = (mean: float, stddev: float)
  if mean == nil
    mean = 0
  if stddev == nil
    stddev = 1
  u1 = math.random()
  u2 = math.random()
  while u1 == 0
    u1 = math.random()
  z = -2 * u1:log():sqrt() * 2 * math.pi * u2:cos()
  mean + stddev * z

# shuffle: shuffle a list in-place (Fisher-Yates).
shuffle = (list: any)
  if list == nil
    return
  n = list:len()
  while n > 1
    k = 1:random(n)
    tmp = list[n]
    list[n] = list[k]
    list[k] = tmp
    n = n - 1

# coin: flip a coin, return "heads" or "tails".
coin: str = ()
  if math.random() < 0.5
    return "heads"
  "tails"

# uuid_v4ish: generate a random UUID-like string (not cryptographically secure).
uuid_v4ish: str = ()
  hex_chars = "0123456789abcdef"
  parts = {}
  i = 1
  while i <= 36
    if i == 9 or i == 14 or i == 19 or i == 24
      parts[i] = "-"
    else(i == 15)
      parts[i] = "4"
    else(i == 20)
      idx = 1:random(4)
      if idx == 1
        parts[i] = "8"
      else(idx == 2)
        parts[i] = "9"
      else(idx == 3)
        parts[i] = "a"
      else
        parts[i] = "b"
    else
      # Use single random call to get one hex character
      idx = 1:random(16)
      parts[i] = hex_chars:sub(idx, idx)
    i = i + 1
  result = ""
  i = 1
  while i <= 36
    result = result .. parts[i]
    i = i + 1
  result
