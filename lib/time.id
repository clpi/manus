
@cinclude("sys/time.h")

@cinclude("time.h")


now: int = ()
  os.time()

clock: float = ()
  os.clock()

difftime: float = (t2: int, t1: int)
  os.difftime(t2, t1)

sleep = (seconds: any)
  if seconds == nil
    return
  sec = seconds:floor()
  ns = (seconds - sec) * 1000000000:floor()
  @comp.c.emit("({ struct timespec ts; ts.tv_sec = (time_t)sec; ts.tv_nsec = (long)ns; nanosleep(&ts, NULL); })")
  

now_ns: i64 = ()
  return @comp.c.emit("({ struct timeval tv; gettimeofday(&tv, NULL); (int64_t)(tv.tv_sec * 1000000000LL + tv.tv_usec * 1000LL); })")

monotonic: i64 = ()
  now_ns()
