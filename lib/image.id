# image — Image root module (mirrors Go's image)

pt: any = (x: any, y: any)
  { x = x, y = y, kind = "point" }

rect: any = (x0: any, y0: any, x1: any, y1: any)
  { min = pt(x0, y0), max = pt(x1, y1), kind = "rect" }

rect_dx: i64 = (r: any)
  r.max.x - r.min.x

rect_dy: i64 = (r: any)
  r.max.y - r.min.y

rect_empty: bool = (r: any)
  r.min.x >= r.max.x or r.min.y >= r.max.y

rect_inset: any = (r: any, n: i64)
  rect(r.min.x + n, r.min.y + n, r.max.x - n, r.max.y - n)

rect_union: any = (r1: any, r2: any)
  rect(r1.min.x:min(r2.min.x), r1.min.y:min(r2.min.y), r1.max.x:max(r2.max.x), r1.max.y:max(r2.max.y))

rect_intersect: any = (r1: any, r2: any)
  rect(r1.min.x:max(r2.min.x), r1.min.y:max(r2.min.y), r1.max.x:min(r2.max.x), r1.max.y:min(r2.max.y))

rect_overlaps: bool = (r1: any, r2: any)
  if rect_empty(rect_intersect(r1, r2))
    return false
  true

new_rgba: any = (r: any)
  { rect = r, pix = {}, stride = rect_dx(r) * 4, kind = "rgba_img" }

new_gray: any = (r: any)
  { rect = r, pix = {}, stride = rect_dx(r), kind = "gray_img" }

img_set = (img: any, x: i64, y: i64, c: any)
  r = img.rect
  if x < r.min.x or x >= r.max.x or y < r.min.y or y >= r.max.y
    return
  off = (y - r.min.y) * img.stride + (x - r.min.x) * 4
  img.pix[off + 1] = c.r / 257
  img.pix[off + 2] = c.g / 257
  img.pix[off + 3] = c.b / 257
  img.pix[off + 4] = c.a / 257

img_at: any = (img: any, x: i64, y: i64)
  r = img.rect
  if x < r.min.x or x >= r.max.x or y < r.min.y or y >= r.max.y
    return color.rgba(0, 0, 0, 0)
  off = (y - r.min.y) * img.stride + (x - r.min.x) * 4
  color.rgba(img.pix(off + 1) * 257, img.pix(off + 2) * 257, img.pix(off + 3) * 257, img.pix(off + 4) * 257)
