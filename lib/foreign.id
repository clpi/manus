# foreign — Cross-Language AST Bridge
# Transpile snippets from Python, Rust, Zig, and other languages into C
# at compile time via @run, then inject the result with @c.emit.
#
# Usage:
#   @foreign("zig", "fn add(a: i64, b: i64) i64 { return a + b; }")
#   @foreign("python", "def add(a, b): return a + b")
#
#   local foreign = foreign
#   local c_code = foreign.zig_to_c("fn add(a: i64, b: i64) i64 { return a + b; }")
#   # c_code = "int64_t add(int64_t a, int64_t b) { return a + b; }"

# ═══════════════════════════════════════════════════════════════
# Zig → C transpilation
# ═══════════════════════════════════════════════════════════════

# zig_to_c: translate common Zig patterns to C.
# Returns the C equivalent as a string.
zig_to_c: str = (code: str)
  result = code
  result = result:gsub(": u64", ": uint64_t")
  result = result:gsub(": u32", ": uint32_t")
  result = result:gsub(": u16", ": uint16_t")
  result = result:gsub(": u8", ": uint8_t")
  result = result:gsub(": i64", ": int64_t")
  result = result:gsub(": i32", ": int32_t")
  result = result:gsub(": i16", ": int16_t")
  result = result:gsub(": i8", ": int8_t")
  result = result:gsub(": f64", ": double")
  result = result:gsub(": f32", ": float")
  result = result:gsub(": bool", ": int")
  result = result:gsub(": void", ": void")
  result = result:gsub("*const [%d+]u8", "const char*")
  result = result:gsub("*[%d+]u8", "char*")
  result = result:gsub("*const u8", "const char*")
  result

# ═══════════════════════════════════════════════════════════════
# Rust → C transpilation
# ═══════════════════════════════════════════════════════════════

# rust_to_c: translate common Rust patterns to C.
# Returns the C equivalent as a string.
rust_to_c: str = (code: str)
  result = code
  result = result:gsub("pub fn (%w+)%((.-)%)%s*->%s*(%S+)", "%3 %1(%2)")
  result = result:gsub("fn (%w+)%((.-)%)%s*->%s*(%S+)", "%3 %1(%2)")
  result = result:gsub(": u64", ": uint64_t")
  result = result:gsub(": u32", ": uint32_t")
  result = result:gsub(": u16", ": uint16_t")
  result = result:gsub(": u8", ": uint8_t")
  result = result:gsub(": i64", ": int64_t")
  result = result:gsub(": i32", ": int32_t")
  result = result:gsub(": i16", ": int16_t")
  result = result:gsub(": i8", ": int8_t")
  result = result:gsub(": f64", ": double")
  result = result:gsub(": f32", ": float")
  result = result:gsub(": bool", ": int")
  result = result:gsub(": usize", ": size_t")
  result = result:gsub(": isize", ": ssize_t")
  result = result:gsub("&str", "const char*")
  result = result:gsub("&[%d+]u8", "const uint8_t*")
  result = result:gsub("*mut u8", "uint8_t*")
  result

# ═══════════════════════════════════════════════════════════════
# Python → C helper
# ═══════════════════════════════════════════════════════════════

# python_func: generate a C function declaration from Python-style metadata.
# Returns the C function as a string (caller can pass to @c.emit).
python_func: str = (name: str, params: any, body: str, ret_type: str)
  parts = {}
  parts(parts:len() + 1) = "/* [foreign.python] " .. name .. " */"
  parts(parts:len() + 1) = ret_type .. " " .. name .. "("
  if params:len() > 0
    for i, p in params
      if i > 1
        parts(parts:len() + 1) = ","
      if type(p) == "table"
        parts(parts:len() + 1) = "    " .. p(2) .. " " .. p(1)
      else
        parts(parts:len() + 1) = "    double " .. p
  else
    parts(parts:len() + 1) = "    void"
  parts(parts:len() + 1) = ") {"
  parts(parts:len() + 1) = body
  parts(parts:len() + 1) = "}"
  str_join(parts, "\n")

# ═══════════════════════════════════════════════════════════════
# String joining helper
# ═══════════════════════════════════════════════════════════════

str_join: str = (parts: any, sep: str)
  result = ""
  for i, part in parts
    if i > 1
      result = result .. sep
    result = result .. part
  result

M =
  zig_to_c = zig_to_c
  rust_to_c = rust_to_c
  python_func = python_func
  str_join = str_join
M
