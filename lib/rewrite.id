# rewrite — User-Definable Compile-Time Rewrite Rules
# Define algebraic simplification and loop transformation rules
# that the compiler applies at compile time.
#
# **Ergonomic entry point:** use `@meta.rewrite.bundle("algebraic")` or
# `@meta.rewrite.bundle("fast")` at module scope — one line registers the
# full rule set in the compiler (see examples/parity/map.id).
# The functions below are for inspection, documentation, and future
# user-defined rule registration via `@meta.rewrite(...)`.

# ═══════════════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════════════

str_join(parts: any, sep: str): str
    result = ""
    for i, part in parts
        if i > 1
            result = result .. sep
        end
        result = result .. part
    end
    result
end

# ═══════════════════════════════════════════════════════════════
# Rule registry
# ═══════════════════════════════════════════════════════════════

global rules = {}
global rule_count = 0

# define: register a rewrite rule.
define(name: str, pattern: str, replacement: str, priority: i64)
    if priority == nil priority = 0 end
    rule_count += 1
    rules[rule_count] = {
        name = name,
        pattern = pattern,
        replacement = replacement,
        priority = priority,
        enabled = true,
    }
end

# disable: temporarily disable a rule by name
disable(name: str)
    for i = 1, rule_count
        if rules[i].name == name
            rules[i].enabled = false
        end
    end
end

# enable: re-enable a rule by name
enable(name: str)
    for i = 1, rule_count
        if rules[i].name == name
            rules[i].enabled = true
        end
    end
end

# ═══════════════════════════════════════════════════════════════
# Built-in algebraic simplification rules
# ═══════════════════════════════════════════════════════════════

register_algebraic(): void
    define("add_zero_l", "(0 + $1)", "$1", 10)
    define("add_zero_r", "($1 + 0)", "$1", 10)
    define("mul_one_l", "(1 * $1)", "$1", 10)
    define("mul_one_r", "($1 * 1)", "$1", 10)
    define("mul_zero_l", "(0 * $1)", "0", 10)
    define("mul_zero_r", "($1 * 0)", "0", 10)
    define("mul_two", "($1 * 2)", "$1 << 1", 5)
    define("mul_four", "($1 * 4)", "$1 << 2", 5)
    define("div_two", "($1 / 2)", "$1 >> 1", 5)
    define("double_neg", "-(-($1))", "$1", 10)
    define("and_true_l", "(true and $1)", "$1", 10)
    define("and_true_r", "($1 and true)", "$1", 10)
    define("or_false_l", "(false or $1)", "$1", 10)
    define("or_false_r", "($1 or false)", "$1", 10)
    define("and_false", "($1 and false)", "false", 10)
    define("or_true", "($1 or true)", "true", 10)
    define("eq_self", "($1 == $1)", "true", 8)
    define("sub_self", "($1 - $1)", "0", 8)
    define("div_self", "($1 / $1)", "1", 8)
end

# ═══════════════════════════════════════════════════════════════
# Loop transformation rules
# ═══════════════════════════════════════════════════════════════

register_loop_opts(): void
    define("strength_mul_pow2", "($1 * (1 << $2))", "($1 << $2)", 5)
    define("strength_div_pow2", "($1 / (1 << $2))", "($1 >> $2)", 5)
    define("loop_peel", "for ($1) = $2, $3 do $4 end", "peeled", 3)
    define("loop_fuse", "for ($1) = $2, $3 do $4 end for ($1) = $2, $3 do $5 end", "fused", 3)
end

# ═══════════════════════════════════════════════════════════════
# Constant folding rules
# ═══════════════════════════════════════════════════════════════

register_const_fold(): void
    define("fold_add", "($1 + $2)", "evaluated", 15)
    define("fold_sub", "($1 - $2)", "evaluated", 15)
    define("fold_mul", "($1 * $2)", "evaluated", 15)
    define("fold_div", "($1 / $2)", "evaluated", 15)
    define("fold_mod", "($1 % $2)", "evaluated", 15)
    define("fold_pow", "($1 ^ $2)", "evaluated", 15)
    define("fold_band", "($1 & $2)", "evaluated", 15)
    define("fold_bor", "($1 | $2)", "evaluated", 15)
    define("fold_bxor", "($1 ~ $2)", "evaluated", 15)
    define("fold_shl", "($1 << $2)", "evaluated", 15)
    define("fold_shr", "($1 >> $2)", "evaluated", 15)
end

# ═══════════════════════════════════════════════════════════════
# Rule application engine
# ═══════════════════════════════════════════════════════════════

# apply_all: apply all enabled rules and return a summary string.
apply_all(): str
    applied = 0
    # `lines`, not `summary`: a local shadowing this module's own top-level
    # `summary()` binding lowers to an assignment to the function name, and the
    # C backend then emits "use of undeclared identifier".
    lines = {}
    for i = 1, rule_count
        if rules[i].enabled
            r = rules[i]
            lines[lines:len() + 1] = "  [" .. r.priority:to(str) .. "] " .. r.name .. ": " .. r.pattern .. " -> " .. r.replacement
            applied += 1
        end
    end
    "/* [rewrite] " .. applied:to(str) .. " rules registered */\n" .. str_join(lines, "\n")
end

# describe_bundle: compile-time bundle metadata (folds to native C string).
describe_bundle(name: str): str
    @comp.rewrite.describe(name)
end

# active_rule_count: compiler-registered rewrite rules after @comp.rewrite.bundle.
active_rule_count(): i64
    @comp.rewrite.rulecount()
end

# summary: return a summary of all registered rules as a string
summary(): str
    parts = {}
    for i = 1, rule_count
        r = rules[i]
        status = r.enabled and "on" or "off"
        parts[parts:len() + 1] = "  [" .. status .. "] " .. r.name .. ": " .. r.pattern .. " -> " .. r.replacement
    end
    "Rewrite rules (" .. rule_count:to(str) .. "):\n" .. str_join(parts, "\n")
end

# clear: remove all rules
clear(): void
    rules = {}
    rule_count = 0
end

M = {
    define = define,
    disable = disable,
    enable = enable,
    register_algebraic = register_algebraic,
    register_loop_opts = register_loop_opts,
    register_const_fold = register_const_fold,
    apply_all = apply_all,
    describe_bundle = describe_bundle,
    active_rule_count = active_rule_count,
    summary = summary,
    clear = clear,
    str_join = str_join,
}
M
