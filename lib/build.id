# build — build system helpers and environment info

global _project = { name = "duo-app", version = "0.1.0", default = "app" }
global _targets = {}

info: any = ()
  {
    compiler = "duo",
    version = "0.1.0",
    host = os.env("HOSTNAME") or "unknown",
    timestamp = os.date("%Y-%m-%dT%H:%M:%S")
  }

platform: str = ()
  os.env("OSTYPE") or "unknown"

arch: str = ()
  a = os.env("HOSTTYPE") or os.env("MACHTYPE") or "unknown"
  a

target: str = ()
  "%s-%s":format(arch(), platform())

is_debug: bool = ()
  os.env("DEBUG") == "1"

env: str = ()
  os.env("BUILD_ENV") or "development"

project: any = (cfg: any)
  if cfg == nil
    _project
  else
    if has(.name)(cfg)
      _project.name = cfg.name
    if has(.version)(cfg)
      _project.version = cfg.version
    if has(.default)(cfg)
      _project.default = cfg.default
    _project

exe: any = (cfg: any)
  if cfg.name == nil
    cfg.name = "app"
  if cfg.src == nil
    cfg.src = "src/main.id"
  if cfg.out == nil
    cfg.out = "zig-out/bin/" .. cfg.name
  if cfg.opt == nil
    cfg.opt = "-O3"
  if cfg.target == nil
    cfg.target = "native"
  cfg.kind = "exe"
  _targets(_targets:len() + 1) = cfg
  cfg

lib: any = (cfg: any)
  t = exe(cfg)
  t.kind = "lib"
  t.lib = true
  t

targets: any = ()
  _targets

default_target: str = ()
  _project.default

find: any = (name: str)
  for _, t in _targets
    if t.name == name
      t
  nil

command: str = (t: any)
  cmd = "duo compile " .. t.src
  if has(.out)(t)
    cmd = cmd .. " -o " .. t.out
  if has(.opt)(t)
    cmd = cmd .. " " .. t.opt
  if has(.target)(t) and t.target != "native"
    cmd = cmd .. " --target " .. t.target
  if has(.cc)(t)
    cmd = cmd .. " --cc " .. t.cc
  if t.pgo
    cmd = cmd .. " --pgo"
  if t.shared_memory
    cmd = cmd .. " --shared-memory"
  if t.load_chunk
    cmd = cmd .. " --load-chunk"
  if t.lib
    cmd = cmd .. " --lib"
  cmd

clean: i64 = ()
  os.execute("rm -rf zig-out/bin")

log_target = (t: any)
  print(term.banner("build target"))
  print(term.kv("name", t.name))
  print(term.kv("source", t.src))
  if has(.out)(t)
    print(term.kv("output", t.out))
  print(term.kv("command", command(t)))

log_project = ()
  print(term.banner("duo project"))
  print(term.kv("name", _project.name))
  print(term.kv("version", _project.version))
  print(term.kv("default", _project.default))
