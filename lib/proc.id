exec: { status: i64 } = (cmd: str)
  rc = os.execute(cmd)
  if rc == nil
    { status = -1 }
  { status = rc }

capture: { output: str, status: i64 } = (cmd: str)
  f = io.popen(cmd .. " 2>&1; echo \"\\n$?\"", "r")
  if f == nil
    { output = "", status = -1 }
  raw = f:read("*a") or ""
  f:close()
  last_nl = raw:find("\n[^\n]*$")
  if last_nl
    output = raw:sub(1, last_nl - 1)
    code_str = raw:sub(last_nl + 1)
    code = code_str:match("%d+") or "0"
    { output = output, status = code:to(i64) or 0 }
  { output = raw, status = 0 }
