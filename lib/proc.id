exec(cmd: str): i64
    rc = os.execute(cmd)
    if rc == nil
        return -1
    rc

capture(cmd: str): str
    f = io.popen(cmd, "r")
    if f == nil
        ""
    out = ""
    line = f:read()
    while line != nil
        out = out .. line .. "\n"
        line = f:read()
    f:close()
    out

