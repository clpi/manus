
clamp: any = (x: any, lo: any, hi: any)
    if x < lo return lo
    if x > hi return hi
    x

min: any = (a: any, b: any)
    if a < b return a
    b

max: any = (a: any, b: any)
    if a > b return a
    b

sign: i64 = (x: any)
    if x > 0 return 1
    if x < 0 return -1
    0

round: i64 = (x: any)
    if x >= 0
        return @as(i64, x + 0.5:floor())
    return @as(i64, 0 - (0 - x) + 0.5:floor())

lerp: any = (a: any, b: any, t: any)
    a + (b - a) * t

remap: any = (...args)
    x = args[1]
    ilo = args[2]
    ihi = args[3]
    olo = args[4]
    ohi = args[5]
    if ihi == ilo return olo
    olo + (x - ilo) * (ohi - olo) / (ihi - ilo)

sum: any = (xs: any)
    total = 0
    for _, v in xs
        total += v
    total

mean: any = (xs: any)
    if xs == nil or xs:len() == 0 return 0
    sum(xs) / xs:len()

even: bool = (n: i64)
    n % 2 == 0

odd: bool = (n: i64)
    n % 2 != 0

distsq: any = (x1: any, y1: any, x2: any, y2: any)
    dx = x2 - x1
    dy = y2 - y1
    dx * dx + dy * dy

distance: any = (x1: any, y1: any, x2: any, y2: any)
    distsq(x1, y1, x2, y2):sqrt()

gcd: i64 = (a: i64, b: i64)
    if a < 0 a = 0 - a
    if b < 0 b = 0 - b
    while b != 0
        temp = b
        b = a % b
        a = temp
    a

lcm: i64 = (a: i64, b: i64)
    if a == 0 or b == 0 return 0
    n = a * b
    if n < 0 n = 0 - n
    n / gcd(a, b)

median: any = (xs: any)
    if xs == nil or xs:len() == 0 return 0
    sorted = {}
    for _, v in xs
        sorted[sorted:len() + 1] = v
    sorted:sort()
    n = sorted:len()
    if n % 2 == 1
        return sorted[n / 2:floor() + 1]
    (sorted[n / 2] + sorted[n / 2 + 1]) / 2

variance: any = (xs: any)
    if xs == nil or xs:len() <= 1 return 0
    m = mean(xs)
    ssq = 0
    for _, v in xs
        diff = v - m
        ssq += diff * diff
    ssq / xs:len()

stddev: any = (xs: any)
    variance(xs):sqrt()

smoothstep: any = (edge0: any, edge1: any, x: any)
    t = clamp((x - edge0) / (edge1 - edge0), 0, 1)
    t * t * (3 - 2 * t)

approx: bool = (a: any, b: any, eps: any)
    if eps == nil eps = 1e-9
    diff = a - b
    if diff < 0 diff = 0 - diff
    diff <= eps

least: any = (list: any)
    if list == nil or list:len() == 0 return nil
    result = list[1]
    i = 2
    while i <= list:len()
        if list[i] < result result = list[i]
        i += 1
    result

greatest: any = (list: any)
    if list == nil or list:len() == 0 return nil
    result = list[1]
    i = 2
    while i <= list:len()
        if list[i] > result result = list[i]
        i += 1
    result

M = {}
M.clamp = clamp
M.min = min
M.max = max
M.sign = sign
M.round = round
M.lerp = lerp
M.remap = remap
M.sum = sum
M.mean = mean
M.median = median
M.variance = variance
M.std_dev = stddev
M.smoothstep = smoothstep
M.approx_eq = approx
M.min_of = least
M.max_of = greatest
M.is_even = even
M.is_odd = odd
M.distance = distance
M.distance_squared = distsq
M.gcd = gcd
M.lcm = lcm

M.pi = math.pi
M.huge = math.huge
M.maxinteger = math.maxinteger
M.mininteger = math.mininteger
M.abs = math.abs
M.acos = math.acos
M.asin = math.asin
M.atan = math.atan
M.ceil = math.ceil
M.cos = math.cos
M.deg = math.deg
M.exp = math.exp
M.floor = math.floor
M.fmod = math.fmod
M.log = math.log
M.modf = math.modf
M.rad = math.rad
M.random = math.random
M.randomseed = math.randomseed
M.sin = math.sin
M.sqrt = math.sqrt
M.tan = math.tan
M.type = math.type
M
