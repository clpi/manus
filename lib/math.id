# math — numeric helper utilities

clamp(x: any, lo: any, hi: any): any
    if x < lo return lo end
    if x > hi return hi end
    x
end

min(a: any, b: any): any
    if a < b return a end
    b
end

max(a: any, b: any): any
    if a > b return a end
    b
end

sign(x: any): i64
    if x > 0 return 1 end
    if x < 0 return -1 end
    0
end

round(x: any): i64
    if x >= 0
        return @as(i64, x + 0.5:floor())
    end
    return @as(i64, 0 - (0 - x) + 0.5:floor())
end

lerp(a: any, b: any, t: any): any
    a + (b - a) * t
end

remap(...args): any
    x = args[1]
    ilo = args[2]
    ihi = args[3]
    olo = args[4]
    ohi = args[5]
    if ihi == ilo return olo end
    olo + (x - ilo) * (ohi - olo) / (ihi - ilo)
end

sum(xs: any): any
    total = 0
    for _, v in xs
        total += v
    end
    total
end

mean(xs: any): any
    if xs == nil or xs:len() == 0 return 0 end
    sum(xs) / xs:len()
end

even(n: i64): bool
    n % 2 == 0
end

odd(n: i64): bool
    n % 2 != 0
end

distsq(x1: any, y1: any, x2: any, y2: any): any
    dx = x2 - x1
    dy = y2 - y1
    dx * dx + dy * dy
end

distance(x1: any, y1: any, x2: any, y2: any): any
    distsq(x1, y1, x2, y2):sqrt()
end

gcd(a: i64, b: i64): i64
    if a < 0 a = 0 - a end
    if b < 0 b = 0 - b end
    while b != 0
        temp = b
        b = a % b
        a = temp
    end
    a
end

lcm(a: i64, b: i64): i64
    if a == 0 or b == 0 return 0 end
    n = a * b
    if n < 0 n = 0 - n end
    n / gcd(a, b)
end

median(xs: any): any
    if xs == nil or xs:len() == 0 return 0 end
    sorted = {}
    for _, v in xs
        sorted[sorted:len() + 1] = v
    end
    sorted:sort()
    n = sorted:len()
    if n % 2 == 1
        return sorted[n / 2:floor() + 1]
    end
    (sorted[n / 2] + sorted[n / 2 + 1]) / 2
end

variance(xs: any): any
    if xs == nil or xs:len() <= 1 return 0 end
    m = mean(xs)
    ssq = 0
    for _, v in xs
        diff = v - m
        ssq += diff * diff
    end
    ssq / xs:len()
end

stddev(xs: any): any
    variance(xs):sqrt()
end

smoothstep(edge0: any, edge1: any, x: any): any
    t = clamp((x - edge0) / (edge1 - edge0), 0, 1)
    t * t * (3 - 2 * t)
end

approx(a: any, b: any, eps: any): bool
    if eps == nil eps = 1e-9 end
    diff = a - b
    if diff < 0 diff = 0 - diff end
    diff <= eps
end

least(list: any): any
    if list == nil or list:len() == 0 return nil end
    result = list[1]
    i = 2
    while i <= list:len()
        if list[i] < result result = list[i] end
        i += 1
    end
    result
end

greatest(list: any): any
    if list == nil or list:len() == 0 return nil end
    result = list[1]
    i = 2
    while i <= list:len()
        if list[i] > result result = list[i] end
        i += 1
    end
    result
end

M = {}
M.clamp = clamp
M.min = min
M.max = max
M.sign = sign
M.round = round
M.lerp = lerp
M.remap = remap
M.sum = sum
M.mean = mean
M.median = median
M.variance = variance
M.std_dev = stddev
M.smoothstep = smoothstep
M.approx_eq = approx
M.min_of = least
M.max_of = greatest
M.is_even = even
M.is_odd = odd
M.distance = distance
M.distance_squared = distsq
M.gcd = gcd
M.lcm = lcm

# Expose core Lua math utilities
M.pi = math.pi
M.huge = math.huge
M.maxinteger = math.maxinteger
M.mininteger = math.mininteger
M.abs = math.abs
M.acos = math.acos
M.asin = math.asin
M.atan = math.atan
M.ceil = math.ceil
M.cos = math.cos
M.deg = math.deg
M.exp = math.exp
M.floor = math.floor
M.fmod = math.fmod
M.log = math.log
M.modf = math.modf
M.rad = math.rad
M.random = math.random
M.randomseed = math.randomseed
M.sin = math.sin
M.sqrt = math.sqrt
M.tan = math.tan
M.type = math.type
M
