
compare: i64 = (a: any, b: any)
  if a < b
    return -1
  if a > b
    return 1
  0

less: bool = (a: any, b: any)
  a < b

ordered: i64 = (a: any, b: any)
  compare(a, b)

min: any = (a: any, b: any)
  if a < b
    return a
  b

max: any = (a: any, b: any)
  if a > b
    return a
  b

clamp: any = (val: any, lo: any, hi: any)
  if val < lo
    return lo
  if val > hi
    return hi
  val
