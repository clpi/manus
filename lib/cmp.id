# cmp — Ordered comparison utilities (mirrors Go 1.21 cmp package)
# Provides comparison functions for ordered types.

compare: i64 = (a: any, b: any)
  if a < b
    return -1
  if a > b
    return 1
  0

less: bool = (a: any, b: any)
  a < b

ordered: i64 = (a: any, b: any)
  compare(a, b)

# Guards, not `if a < b a else b end`. The endless one-liner clause must be
# SELF-DELIMITED: in `a < b a` the trailing `b a` reads as
# PARENLESS APPLICATION, so the clause was `a < b(a)` # calling the operand.
# min(3, 7) returned `true` and max(3, 7) returned 3.
#
# Same defect as strconv.format_bool and fmt.boolean. The shape to avoid is a
# one-line `if` whose clause ENDS in a bare name and whose body BEGINS with
# one; `clamp` below is safe because each body starts with `return`.
min: any = (a: any, b: any)
  if a < b
    return a
  b

max: any = (a: any, b: any)
  if a > b
    return a
  b

clamp: any = (val: any, lo: any, hi: any)
  if val < lo
    return lo
  if val > hi
    return hi
  val
