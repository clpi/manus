

ok: any = (value: any)
  { kind = "ok", value = value, err = nil }

err: any = (message: any)
  if type(message) == "table" and message.message != nil
    return { kind = "err", value = nil, err = message }
  { kind = "err", value = nil, err = { message = message:to(str), cause = nil, kind = "error" } }

is_ok: bool = (r: any)
  if r == nil
    return false
  r.kind == "ok"

is_err: bool = (r: any)
  if r == nil
    return true
  r.kind == "err"

value: any = (r: any, fallback: any)
  if r != nil and r.kind == "ok"
    return r.value
  fallback

std_result_error: any = (r: any)
  if r == nil
    return nil
  r.err

unwrap: any = (r: any)
  if r != nil and r.kind == "ok"
    return r.value
  msg = "unwrap called on error"
  if r != nil and r.err != nil and r.err.message != nil
    msg = msg .. ": " .. r.err.message
  error(msg)

unwrap_or_else: any = (r: any, fn: any)
  if r != nil and r.kind == "ok"
    return r.value
  fn(r.err)

map: any = (r: any, fn: any)
  if r != nil and r.kind == "ok"
    return ok(fn(r.value))
  r

map_err: any = (r: any, fn: any)
  if r != nil and r.kind == "err"
    return err(fn(r.err))
  r

flat_map: any = (r: any, fn: any)
  if r != nil and r.kind == "ok"
    return fn(r.value)
  r

and_then: any = (r: any, fn: any)
  flat_map(r, fn)

or_else: any = (r: any, fn: any)
  if r != nil and r.kind == "err"
    return fn(r.err)
  r

result_to_str: str = (r: any)
  if r == nil
    return "Result(nil)"
  if r.kind == "ok"
    return "Ok(" .. r.value:to(str) .. ")"
  msg = ""
  if has(.err)(r) and r.err.message != nil
    msg = r.err.message
  return "Err(" .. msg .. ")"


some: any = (value: any)
  { kind = "some", value = value }

none: any = ()
  { kind = "none", value = nil }

is_some: bool = (o: any)
  if o == nil
    return false
  o.kind == "some"

is_none: bool = (o: any)
  if o == nil
    return true
  o.kind != "some"

option_value: any = (o: any, fallback: any)
  if o != nil and o.kind == "some"
    return o.value
  fallback

option_unwrap: any = (o: any)
  if o != nil and o.kind == "some"
    return o.value
  error("option_unwrap called on none")

option_unwrap_or_else: any = (o: any, fn: any)
  if o != nil and o.kind == "some"
    return o.value
  fn()

option_map: any = (o: any, fn: any)
  if o != nil and o.kind == "some"
    return some(fn(o.value))
  none()

option_flat_map: any = (o: any, fn: any)
  if o != nil and o.kind == "some"
    return fn(o.value)
  none()

option_filter: any = (o: any, fn: any)
  if o != nil and o.kind == "some" and fn(o.value)
    return o
  none()

option_to_str: str = (o: any)
  if o == nil or o.kind != "some"
    return "None"
  return "Some(" .. o.value:to(str) .. ")"


collect: any = (results: any)
  vals = {}
  errs = {}
  if results == nil
    return { ok = vals, err = nil }
  i = 1
  while i <= results:len()
    r = results[i]
    if r != nil and r.kind == "ok"
      vals[vals:len() + 1] = r.value
    else
      errs[errs:len() + 1] = std_result_error(r)
    i = i + 1
  first_err = nil
  if errs:len() > 0
    first_err = errs[1]
  { ok = vals, err = first_err, errors = errs }

all_ok: bool = (results: any)
  if results == nil
    return true
  i = 1
  while i <= results:len()
    if !is_ok(results[i])
      return false
    i = i + 1
  true

values: any = (results: any)
  out = {}
  if results == nil
    return out
  i = 1
  while i <= results:len()
    r = results[i]
    if r != nil and r.kind == "ok"
      out[out:len() + 1] = r.value
    i = i + 1
  out

std_result_errors: any = (results: any)
  out = {}
  if results == nil
    return out
  i = 1
  while i <= results:len()
    r = results[i]
    if r != nil and r.kind == "err"
      out[out:len() + 1] = r.err
    i = i + 1
  out

M = {}
M.ok = ok
M.err = err
M.is_ok = is_ok
M.is_err = is_err
M.value = value
M.error = std_result_error
M.unwrap = unwrap
M.unwrap_or_else = unwrap_or_else
M.map = map
M.map_err = map_err
M.flat_map = flat_map
M.and_then = and_then
M.or_else = or_else
M.some = some
M.none = none
M.is_some = is_some
M.is_none = is_none
M.option_value = option_value
M.option_unwrap = option_unwrap
M.option_unwrap_or_else = option_unwrap_or_else
M.option_map = option_map
M.option_flat_map = option_flat_map
M.option_filter = option_filter
M.option_to_str = option_to_str
M.collect = collect
M.all_ok = all_ok
M.values = values
M.errors = std_result_errors
M
