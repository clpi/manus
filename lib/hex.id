# hex — Hexadecimal encoding and decoding utilities


encode(s: str): str
    crypto.hex_encode(s)
end

decode(s: str): str
    if s == nil return "" end
    out = {}
    for i = 1, s:len(), 2
        byte_str = s:sub(i, i + 1)
        out:insert(tonumber(byte_str, 16):char())
    end
    out:concat()
end

