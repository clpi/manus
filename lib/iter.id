
map: any = (list: any, fn_ref: any)
  fn.map_filter(list, fn_ref)

filter: any = (list: any, fn_ref: any)
  out = {}
  if list == nil
    return out
  i = 1
  while i <= list:len()
    if fn_ref(list[i])
      out[out:len() + 1] = list[i]
    i = i + 1
  out

reduce: any = (list: any, init: any, fn_ref: any)
  fn.foldl(list, init, fn_ref)

all: bool = (list: any, fn_ref: any)
  if list == nil
    return true
  i = 1
  while i <= list:len()
    if !fn_ref(list[i])
      return false
    i = i + 1
  true

find: any = (list: any, fn_ref: any)
  if list == nil
    return nil
  i = 1
  while i <= list:len()
    if fn_ref(list[i])
      return list[i]
    i = i + 1
  nil

find_index: any = (list: any, fn_ref: any)
  if list == nil
    return nil
  i = 1
  while i <= list:len()
    if fn_ref(list[i])
      return i
    i = i + 1
  nil

count: i64 = (list: any, fn_ref: any)
  if list == nil
    return 0
  n = 0
  i = 1
  while i <= list:len()
    if fn_ref(list[i])
      n = n + 1
    i = i + 1
  n

zip: any = (l1: any, l2: any)
  out = {}
  if l1 == nil or l2 == nil
    return out
  n = l1:len()
  if l2:len() < n
    n = l2:len()
  i = 1
  while i <= n
    pair = {}
    pair[1] = l1[i]
    pair[2] = l2[i]
    out[out:len() + 1] = pair
    i = i + 1
  out

zip_with: any = (l1: any, l2: any, fn_ref: any)
  out = {}
  if l1 == nil or l2 == nil
    return out
  n = l1:len()
  if l2:len() < n
    n = l2:len()
  i = 1
  while i <= n
    out[out:len() + 1] = fn_ref(l1[i], l2[i])
    i = i + 1
  out

enumerate: any = (list: any)
  out = {}
  if list == nil
    return out
  i = 1
  while i <= list:len()
    pair = {}
    pair[1] = i
    pair[2] = list[i]
    out[out:len() + 1] = pair
    i = i + 1
  out

flat_map: any = (list: any, fn_ref: any)
  fn.flatten(fn.map_filter(list, fn_ref))

sliding_window: any = (list: any, n: i64)
  out = {}
  if list == nil or n <= 0
    return out
  len = list:len()
  i = 1
  while i + n - 1 <= len
    window = {}
    j = 0
    while j < n
      window[window:len() + 1] = list[i + j]
      j = j + 1
    out[out:len() + 1] = window
    i = i + 1
  out

take: any = (list: any, n: i64)
  out = {}
  if list == nil or n <= 0
    return out
  len = list:len()
  if n > len
    n = len
  i = 1
  while i <= n
    out[out:len() + 1] = list[i]
    i = i + 1
  out

drop: any = (list: any, n: i64)
  out = {}
  if list == nil or n <= 0
    return list
  len = list:len()
  i = n + 1
  while i <= len
    out[out:len() + 1] = list[i]
    i = i + 1
  out

unique: any = (list: any)
  fn.unique_by(list, fn.identity)

group_by: any = (list: any, fn_ref: any)
  fn.group_by(list, fn_ref)

min_by: any = (list: any, fn_ref: any)
  fn.min_by(list, fn_ref)

max_by: any = (list: any, fn_ref: any)
  fn.max_by(list, fn_ref)

sort_by = (list: any, fn_ref: any)
  fn.sort_by(list, fn_ref)

partition: any = (list: any, fn_ref: any)
  fn.partition(list, fn_ref)
