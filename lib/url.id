encode(s: str): str
  if s == nil
    return ""
  end
  s:gsub("([^%w%.%-~_])", (c: str): str
    "%%%02X":format(c:byte())
  end)
end
decode(s: str): str
  if s == nil
    return ""
  end
  s = s:gsub("+", " ")
  s:gsub("%%(%x%x)", (h: str): str
    tonumber(h, 16):char()
  end)
end
parse(url: str): any
  scheme = "http"
  rest = url
  if rest:sub(1, 7) == "http://"
    rest = rest:sub(8)
  elseif rest:sub(1, 8) == "https://"
    scheme = "https"
    rest = rest:sub(9)
  end
  default = 80
  if scheme == "https"
    default = 443
  end
  host = rest
  path = "/"
  slash = rest:find("/")
  if slash
    host = rest:sub(1, slash - 1)
    path = rest:sub(slash)
  end
  colon = host:find(":")
  port = default
  if colon
    port = host:sub(colon + 1:to(i64)) or default
    host = host:sub(1, colon - 1)
  end
  query = ""
  mark = path:find("?")
  if mark
    query = path:sub(mark + 1)
    path = path:sub(1, mark - 1)
  end
  {
    scheme = scheme,
    host = host,
    port = port,
    path = path,
    query = query
  }
end
