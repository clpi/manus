encode(s: str): str
  if s == nil
    return ""
  end
  string.gsub(s, "([^%w%.%-~_])", (c: str): str
    "%%%02X":format(c:byte())
  end)
end
decode(s: str): str
  if s == nil
    return ""
  end
  s = s:gsub("+", " ")
  string.gsub(s, "%%(%x%x)", (h: str): str
    tonumber(h, 16):char()
  end)
end
parse(url: str): any
  scheme = "http"
  rest = url
  if rest:sub(1, 7) == "http://"
    rest = rest:sub(8)
  elseif rest:sub(1, 8) == "https://"
    scheme = "https"
    rest = rest:sub(9)
  end
  default_port = 80
  if scheme == "https"
    default_port = 443
  end
  host = rest
  path = "/"
  slash_pos = rest:find("/")
  if slash_pos
    host = rest:sub(1, slash_pos - 1)
    path = rest:sub(slash_pos)
  end
  colon_pos = host:find(":")
  port = default_port
  if colon_pos
    port = tonumber(host:sub(colon_pos + 1)) or default_port
    host = host:sub(1, colon_pos - 1)
  end
  query = ""
  q_pos = path:find("?")
  if q_pos
    query = path:sub(q_pos + 1)
    path = path:sub(1, q_pos - 1)
  end
  {
    scheme = scheme,
    host = host,
    port = port,
    path = path,
    query = query
  }
end
