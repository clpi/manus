
global M = {}
M.tools = {}

mcp_read_message: any = ()
    while true
        line = io:read_line(io:input())
        if line == nil return nil 
        line = line:gsub("[\r\n]", "")
        if line != "" break 
    json:decode(line)

mcp_send_message = (obj: any)
    body = json:encode(obj)
    io:write_bytes(io:output(), body .. "\n")
    io:flush(io:output())

mcp_send_response = (id: any, result: any)
    mcp_send_message({
        jsonrpc = "2.0",
        id = id,
        result = result
    })

mcp_send_error = (id: any, code: int, message: str)
    mcp_send_message({
        jsonrpc = "2.0",
        id = id,
        error = {
            code = code,
            message = message
        }
    })

mcp_handle_initialize = (msg: any)
    mcp_send_response(msg.id, {
        protocolVersion = "2024-11-05",
        capabilities = {
            tools = json:empty_object
        },
        serverInfo = {
            name = "duo-mcp",
            version = "0.1.0"
        }
    })

mcp_handle_tools_list = (msg: any)
    tools_list = {}
    for name, tool in M.tools
        schema = tool.inputSchema
        if schema != nil and schema.properties != nil and next(schema.properties) == nil
            schema.properties = json:empty_object
        tools_list[tools_list:len() + 1] = {
            name = name,
            description = tool.description,
            inputSchema = schema
        }
    mcp_send_response(msg.id, {
        tools = tools_list
    })

mcp_handle_tools_call = (msg: any)
    params = msg.params
    name = params.name
    args = params.arguments
    tool = M.tools[name]
    if tool == nil
        mcp_send_error(msg.id, -32601, "Tool not found: " .. name)
        return
    
    res = tool.handler(args)
    if type(res) == "string"
        mcp_send_response(msg.id, {
            content = {
                {
                    type = "text",
                    text = res
                }
            }
        })
    else(type(res) == "table" and res.isError)
        mcp_send_response(msg.id, {
            isError = true,
            content = {
                {
                    type = "text",
                    text = res.message
                }
            }
        })
    else
        mcp_send_response(msg.id, {
            content = {
                {
                    type = "text",
                    text = json:encode(res)
                }
            }
        })

mcp_serve = ()
    while true
        msg = mcp_read_message()
        if msg == nil
            break
        if msg.method == "initialize"
            mcp_handle_initialize(msg)
        else(msg.method == "tools/list")
            mcp_handle_tools_list(msg)
        else(msg.method == "tools/call")
            mcp_handle_tools_call(msg)
        else(msg.method == "notifications/initialized")
        else(msg.method == "ping")
            mcp_send_response(msg.id, {})
        else(has(.id)(msg))
            mcp_send_error(msg.id, -32601, "Method not found: " .. msg.method:to(str))

mcp_register_tool = (name: str, p2: any, p3: any, p4: any)
    if type(p4) == "function"
        M.tools[name] = { name = name, description = p2 or "", inputSchema = p3, handler = p4 }
    else
        M.tools[name] = { name = name, description = p2.description or "", inputSchema = p2, handler = p3 }

M.serve = mcp_serve
M.register_tool = mcp_register_tool
M
