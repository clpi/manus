

lower: str = (s: str)
  result = ""
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c >= 65 and c <= 90
      result = result .. c + 32:char()
    else
      result = result .. c:char()
    i = i + 1
  result

upper: str = (s: str)
  result = ""
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c >= 97 and c <= 122
      result = result .. c - 32:char()
    else
      result = result .. c:char()
    i = i + 1
  result

title: str = (s: str)
  capitalize_next = true
  result = ""
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c == 32 or c == 9 or c == 10
      capitalize_next = true
      result = result .. c:char()
    else
      if capitalize_next and c >= 97 and c <= 122
        result = result .. c - 32:char()
        capitalize_next = false
      else
        result = result .. c:char()
        capitalize_next = false
    i = i + 1
  result

capitalize: str = (s: str)
  if s:len() == 0
    return s
  first = s:byte(1)
  if first >= 97 and first <= 122
    return first - 32:char() .. s:sub(2)
  s


trim: str = (s: str)
  start = 1
  while start <= s:len()
    c = s:byte(start)
    if c != 32 and c != 9 and c != 10 and c != 13
      break
    start = start + 1

  finish = s:len()
  while finish >= start
    c = s:byte(finish)
    if c != 32 and c != 9 and c != 10 and c != 13
      break
    finish = finish - 1

  s:sub(start, finish)

trim_left: str = (s: str)
  start = 1
  while start <= s:len()
    c = s:byte(start)
    if c != 32 and c != 9 and c != 10 and c != 13
      break
    start = start + 1
  s:sub(start)

trim_right: str = (s: str)
  finish = s:len()
  while finish >= 1
    c = s:byte(finish)
    if c != 32 and c != 9 and c != 10 and c != 13
      break
    finish = finish - 1
  s:sub(1, finish)

compress_whitespace: str = (s: str)
  result = ""
  in_whitespace = false
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c == 32 or c == 9 or c == 10 or c == 13
      if not in_whitespace
        result = result .. " "
        in_whitespace = true
    else
      result = result .. c:char()
      in_whitespace = false
    i = i + 1
  result

normalize_whitespace: str = (s: str)
  compress_whitespace(trim(s))


remove_accents: str = (s: str)
  accents = {
    ["á"] = "a",
    ["à"] = "a",
    ["ä"] = "a",
    ["â"] = "a",
    ["ã"] = "a",
    ["é"] = "e",
    ["è"] = "e",
    ["ë"] = "e",
    ["ê"] = "e",
    ["í"] = "i",
    ["ì"] = "i",
    ["ï"] = "i",
    ["î"] = "i",
    ["ó"] = "o",
    ["ò"] = "o",
    ["ö"] = "o",
    ["ô"] = "o",
    ["õ"] = "o",
    ["ú"] = "u",
    ["ù"] = "u",
    ["ü"] = "u",
    ["û"] = "u",
    ["ñ"] = "n",
    ["ç"] = "c",
    ["Á"] = "A",
    ["À"] = "A",
    ["Ä"] = "A",
    ["Â"] = "A",
    ["Ã"] = "A",
    ["É"] = "E",
    ["È"] = "E",
    ["Ë"] = "E",
    ["Ê"] = "E",
    ["Í"] = "I",
    ["Ì"] = "I",
    ["Ï"] = "I",
    ["Î"] = "I",
    ["Ó"] = "O",
    ["Ò"] = "O",
    ["Ö"] = "O",
    ["Ô"] = "O",
    ["Õ"] = "O",
    ["Ú"] = "U",
    ["Ù"] = "U",
    ["Ü"] = "U",
    ["Û"] = "U",
    ["Ñ"] = "N",
    ["Ç"] = "C"
  }

  result = ""
  i = 1
  while i <= s:len()
    found = false
    for pattern, replacement in accents
      plen = pattern:len()
      if s:sub(i, i + plen - 1) == pattern
        result = result .. replacement
        i = i + plen
        found = true
        break
    if not found
      result = result .. s:byte(i):char()
      i = i + 1
  result

remove_punctuation: str = (s: str)
  result = ""
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c >= 48 and c <= 57 or c >= 65 and c <= 90 or c >= 97 and c <= 122 or c == 32
      result = result .. c:char()
    i = i + 1
  result

collapse_whitespace: str = (s: str)
  normalize_whitespace(s)

normalize_unicode: str = (s: str)
  remove_accents(s)


word_count: i64 = (s: str)
  if s:len() == 0
    return 0
  count = 1
  in_word = true
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c == 32 or c == 9 or c == 10 or c == 13
      if in_word
        count = count + 1
        in_word = false
    else
      in_word = true
    i = i + 1
  if not in_word
    count = count - 1
  count

char_count: i64 = (s: str)
  s:len()

sentence_count: i64 = (s: str)
  count = 0
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c == 46 or c == 33 or c == 63
      count = count + 1
    i = i + 1
  count

avg_word_length: f64 = (s: str)
  words = split_words(s)
  if words:len() == 0
    return 0.0
  total = 0
  for word in words
    total = total + word:len()
  total / words:len()


split_lines: any = (s: str)
  lines = {}
  current = ""
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c == 10
      lines[lines:len() + 1] = current
      current = ""
    else
      if c == 13
      else
        current = current .. c:char()
    i = i + 1
  if current:len() > 0
    lines[lines:len() + 1] = current
  lines

split_words: any = (s: str)
  words = {}
  current = ""
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c == 32 or c == 9 or c == 10 or c == 13
      if current:len() > 0
        words[words:len() + 1] = current
        current = ""
    else
      current = current .. c:char()
    i = i + 1
  if current:len() > 0
    words[words:len() + 1] = current
  words

split_sentences: any = (s: str)
  sentences = {}
  current = ""
  i = 1
  while i <= s:len()
    c = s:byte(i)
    current = current .. c:char()
    if c == 46 or c == 33 or c == 63
      sentences[sentences:len() + 1] = trim(current)
      current = ""
    i = i + 1
  if trim(current):len() > 0
    sentences[sentences:len() + 1] = trim(current)
  sentences

split_tokens: any = (s: str, max_length: i64)
  words = split_words(s)
  tokens = {}
  current = ""
  for word in words
    if current:len() + word:len() + 1 > max_length
      if current:len() > 0
        tokens[tokens:len() + 1] = current
        current = word
      else
        tokens[tokens:len() + 1] = word
    else
      if current:len() > 0
        current = current .. " " .. word
      else
        current = word
  if current:len() > 0
    tokens[tokens:len() + 1] = current
  tokens


replace: str = (s: str, old: str, new: str)
  result = ""
  i = 1
  old_len = old:len()
  while i <= s:len()
    if s:sub(i, i + old_len - 1) == old
      result = result .. new
      i = i + old_len
    else
      result = result .. s:byte(i):char()
      i = i + 1
  result

replace_all: str = (s: str, old: str, new: str)
  replace(s, old, new)

count_occurrences: i64 = (s: str, pattern: str)
  count = 0
  i = 1
  pat_len = pattern:len()
  while i <= s:len()
    if s:sub(i, i + pat_len - 1) == pattern
      count = count + 1
      i = i + pat_len
    else
      i = i + 1
  count


ascii: bool = (s: str)
  i = 1
  while i <= s:len()
    if s:byte(i) > 127
      return false
    i = i + 1
  true

utf8: bool = (s: str)
  s:ascii()
