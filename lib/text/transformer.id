# text.transformer — Text transformation utilities
# For NLP preprocessing and text normalization in ward's ML pipeline.

# ═══════════════════════════════════════════════════════════════
# Text Normalization
# ═══════════════════════════════════════════════════════════════

lower(s: str): str
    result = ""
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c >= 65 and c <= 90  # A-Z
            result = result .. c + 32:char()
        else
            result = result .. c:char()
        i += 1
    result

upper(s: str): str
    result = ""
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c >= 97 and c <= 122  # a-z
            result = result .. c - 32:char()
        else
            result = result .. c:char()
        i += 1
    result

title(s: str): str
    capitalize_next = true
    result = ""
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c == 32 or c == 9 or c == 10  # whitespace
            capitalize_next = true
            result = result .. c:char()
        else if capitalize_next and c >= 97 and c <= 122
            result = result .. c - 32:char()
            capitalize_next = false
        else
            result = result .. c:char()
            capitalize_next = false
        i += 1
    result

capitalize(s: str): str
    if s:len() == 0 return s
    first = s:byte(1)
    if first >= 97 and first <= 122
        return first - 32:char() .. s:sub(2)
    s

# ═══════════════════════════════════════════════════════════════
# Whitespace Handling
# ═══════════════════════════════════════════════════════════════

trim(s: str): str
    # Trim leading whitespace
    start = 1
    while start <= s:len()
        c = s:byte(start)
        if c != 32 and c != 9 and c != 10 and c != 13 break
        start += 1

    # Trim trailing whitespace
    finish = s:len()
    while finish >= start
        c = s:byte(finish)
        if c != 32 and c != 9 and c != 10 and c != 13 break
        finish -= 1

    s:sub(start, finish)

trim_left(s: str): str
    start = 1
    while start <= s:len()
        c = s:byte(start)
        if c != 32 and c != 9 and c != 10 and c != 13 break
        start += 1
    s:sub(start)

trim_right(s: str): str
    finish = s:len()
    while finish >= 1
        c = s:byte(finish)
        if c != 32 and c != 9 and c != 10 and c != 13 break
        finish -= 1
    s:sub(1, finish)

compress_whitespace(s: str): str
    result = ""
    in_whitespace = false
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c == 32 or c == 9 or c == 10 or c == 13
            if not in_whitespace
                result = result .. " "
                in_whitespace = true
        else
            result = result .. c:char()
            in_whitespace = false
        i += 1
    result

normalize_whitespace(s: str): str
    compress_whitespace(trim(s))

# ═══════════════════════════════════════════════════════════════
# Text Cleaning (for NLP)
# ═══════════════════════════════════════════════════════════════

remove_accents(s: str): str
    # Simple accent removal (ASCII approximation)
    accents = {
        ["á"] = "a", ["à"] = "a", ["ä"] = "a", ["â"] = "a", ["ã"] = "a",
        ["é"] = "e", ["è"] = "e", ["ë"] = "e", ["ê"] = "e",
        ["í"] = "i", ["ì"] = "i", ["ï"] = "i", ["î"] = "i",
        ["ó"] = "o", ["ò"] = "o", ["ö"] = "o", ["ô"] = "o", ["õ"] = "o",
        ["ú"] = "u", ["ù"] = "u", ["ü"] = "u", ["û"] = "u",
        ["ñ"] = "n", ["ç"] = "c",
        ["Á"] = "A", ["À"] = "A", ["Ä"] = "A", ["Â"] = "A", ["Ã"] = "A",
        ["É"] = "E", ["È"] = "E", ["Ë"] = "E", ["Ê"] = "E",
        ["Í"] = "I", ["Ì"] = "I", ["Ï"] = "I", ["Î"] = "I",
        ["Ó"] = "O", ["Ò"] = "O", ["Ö"] = "O", ["Ô"] = "O", ["Õ"] = "O",
        ["Ú"] = "U", ["Ù"] = "U", ["Ü"] = "U", ["Û"] = "U",
        ["Ñ"] = "N", ["Ç"] = "C",
    }

    result = ""
    i = 1
    while i <= s:len()
        # Try to match multi-byte characters
        found = false
        for pattern, replacement in accents
            plen = pattern:len()
            if s:sub(i, i + plen - 1) == pattern
                result = result .. replacement
                i += plen
                found = true
                break
        if not found
            result = result .. s:byte(i):char()
            i += 1
    result

remove_punctuation(s: str): str
    result = ""
    i = 1
    while i <= s:len()
        c = s:byte(i)
        # Keep alphanumeric and spaces
        if (c >= 48 and c <= 57) or  # 0-9
           (c >= 65 and c <= 90) or  # A-Z
           (c >= 97 and c <= 122) or # a-z
           c == 32              # space
            result = result .. c:char()
        i += 1
    result

collapse_whitespace(s: str): str
    normalize_whitespace(s)

normalize_unicode(s: str): str
    # Simple Unicode normalization (NFKD approximation)
    # Remove combining characters, normalize forms
    remove_accents(s)

# ═══════════════════════════════════════════════════════════════
# Text Analysis
# ═══════════════════════════════════════════════════════════════

word_count(s: str): i64
    if s:len() == 0 return 0
    count = 1
    in_word = true
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c == 32 or c == 9 or c == 10 or c == 13
            if in_word
                count += 1
                in_word = false
        else
            in_word = true
        i += 1
    if not in_word count -= 1
    count

char_count(s: str): i64
    s:len()

sentence_count(s: str): i64
    count = 0
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c == 46 or c == 33 or c == 63  # . ! ?
            count += 1
        i += 1
    count

avg_word_length(s: str): f64
    words = split_words(s)
    if words:len() == 0 return 0.0
    total = 0
    for word in words
        total += word:len()
    total / words:len()

# ═══════════════════════════════════════════════════════════════
# Text Splitting
# ═══════════════════════════════════════════════════════════════

split_lines(s: str): any
    lines = {}
    current = ""
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c == 10  # newline
            lines[lines:len() + 1] = current
            current = ""
        else if c == 13  # carriage return
            # Skip, handle \r\n
        else
            current = current .. c:char()
        i += 1
    if current:len() > 0
        lines[lines:len() + 1] = current
    lines

split_words(s: str): any
    words = {}
    current = ""
    i = 1
    while i <= s:len()
        c = s:byte(i)
        if c == 32 or c == 9 or c == 10 or c == 13
            if current:len() > 0
                words[words:len() + 1] = current
                current = ""
        else
            current = current .. c:char()
        i += 1
    if current:len() > 0
        words[words:len() + 1] = current
    words

split_sentences(s: str): any
    sentences = {}
    current = ""
    i = 1
    while i <= s:len()
        c = s:byte(i)
        current = current .. c:char()
        if c == 46 or c == 33 or c == 63  # . ! ?
            sentences[sentences:len() + 1] = trim(current)
            current = ""
        i += 1
    if trim(current):len() > 0
        sentences[sentences:len() + 1] = trim(current)
    sentences

split_tokens(s: str, max_length: i64): any
    words = split_words(s)
    tokens = {}
    current = ""
    for word in words
        if current:len() + word:len() + 1 > max_length
            if current:len() > 0
                tokens[tokens:len() + 1] = current
                current = word
            else
                tokens[tokens:len() + 1] = word
        else
            if current:len() > 0
                current = current .. " " .. word
            else
                current = word
    if current:len() > 0
        tokens[tokens:len() + 1] = current
    tokens

# ═══════════════════════════════════════════════════════════════
# Text Search & Replace
# ═══════════════════════════════════════════════════════════════

replace(s: str, old: str, new: str): str
    result = ""
    i = 1
    old_len = old:len()
    while i <= s:len()
        if s:sub(i, i + old_len - 1) == old
            result = result .. new
            i += old_len
        else
            result = result .. s:byte(i):char()
            i += 1
    result

replace_all(s: str, old: str, new: str): str
    replace(s, old, new)

count_occurrences(s: str, pattern: str): i64
    count = 0
    i = 1
    pat_len = pattern:len()
    while i <= s:len()
        if s:sub(i, i + pat_len - 1) == pattern
            count += 1
            i += pat_len
        else
            i += 1
    count

# ═══════════════════════════════════════════════════════════════
# Text Encoding Detection (simplified)
# ═══════════════════════════════════════════════════════════════

is_ascii(s: str): bool
    i = 1
    while i <= s:len()
        if s:byte(i) > 127 return false
        i += 1
    true

is_utf8(s: str): bool
    # Simplified check
    is_ascii(s)

