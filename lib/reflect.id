
typeof: str = (v: any)
    return type(v)

eq_str: bool = (a: str, b: str)
    a:find(b, 1, true) == 1 and a:len() == b:len()

kind: str = (v: any)
    t = type(v)
    if eq_str(t, "number")
        if v == v:floor() return "int" 
        "float"
    else if eq_str(t, "table")
        n = v:len()
        if n > 0
            count = 0
            for _ in v do count += 1 
            if count == n return "array" 
        "map"
    else
        t

size: i64 = (v: any)
    if v == nil return 0 
    t = type(v)
    if t == "table"
        n = v:len()
        if n > 0 return n 
        count = 0
        for _k, _v in v do count += 1 
        return count
    if t == "string" return v:len() 
    1

is_nil: bool = (v: any)
    v == nil

is_valid: bool = (v: any)
    v != nil

can_int: bool = (v: any)
    if type(v) == "number" return true 
    if type(v) == "string"
        return v:to(i64) != nil
    false

to_int: any = (v: any)
    if type(v) == "number" return v:floor() 
    if type(v) == "string"
        n = v:to(i64)
        if n != nil return n:floor() 
    nil

to_float: any = (v: any)
    if type(v) == "number" return v 
    if type(v) == "string" return v:to(i64) 
    nil

tostring: str = (v: any)
    if v == nil return "" 
    v:to(str)

to_bool: bool = (v: any)
    if v == nil return false 
    if type(v) == "boolean" return v 
    if type(v) == "number" return v != 0 
    if type(v) == "string" return v != "" and v != "false" and v != "0" 
    true

fields: any = (v: any)
    if v == nil or type(v) != "table" return {} 
    out = {}
    for k, val in v
        out[out:len() + 1] = {key = k, value = val, type = type(val)}
    out

field_names: any = (v: any)
    if v == nil or type(v) != "table" return {} 
    out = {}
    for k, _ in v do out[out:len() + 1] = k 
    out

field_by_name: any = (v: any, name: str)
    if v == nil or type(v) != "table" return nil 
    v[name]

set_field = (v: any, name: str, value: any)
    if v == nil or type(v) != "table" return 
    v[name] = value

elem: any = (v: any, index: any)
    if v == nil return nil 
    v[index]

len: i64 = (v: any)
    if v == nil return 0 
    if type(v) == "string" return v:len() 
    if type(v) == "table" return v:len() 
    0

deep_equal: bool = (a: any, b: any)
    if a == b return true 
    if a == nil or b == nil return false 
    if type(a) != type(b) return false 
    if type(a) != "table" return a == b 
    ca = 0
    for _k, _v in a do ca += 1 
    cb = 0
    for _k, _v in b do cb += 1 
    if ca != cb return false 
    for k, va in a
        vb = b[k]
        if not deep_equal(va, vb) return false 
    true

deep_copy: any = (v: any)
    if v == nil return nil 
    if type(v) != "table" return v 
    out = {}
    for k, val in v
        out[k] = deep_copy(val)
    out

map_keys: any = (v: any)
    if v == nil or type(v) != "table" return {} 
    out = {}
    for k, _ in v do out[out:len() + 1] = k 
    out

map_values: any = (v: any)
    if v == nil or type(v) != "table" return {} 
    out = {}
    for _, val in v do out[out:len() + 1] = val 
    out

call: any = (fn: any, args: any)
    if fn == nil or type(fn) != "function" return nil 
    fn(args:unpack())

