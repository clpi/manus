
std_retry_sleep = (seconds: any)
    if seconds == nil or seconds <= 0 return
    start = os.clock()
    while os.clock() - start < seconds
end


constant_backoff: any = (interval: float)
    iv = interval
    return (attempt: any) iv

linear_backoff: any = (base: float, max_val: float)
    if base == nil base = 1
    if max_val == nil max_val = 30
    base_c = base
    max_c = max_val
    return (attempt: any): any
        wait = base_c * attempt
        if wait > max_c wait = max_c
        wait

exponential_backoff: any = (base: float, max_val: float, jitter: bool)
    if base == nil base = 0.5
    if max_val == nil max_val = 30
    if jitter == nil jitter = false
    base_c = base
    max_c = max_val
    jitter_c = jitter
    return (attempt: any): any
        wait = base_c
        idx = 0
        while idx < attempt
            wait *= 2
            idx += 1
        if wait > max_c wait = max_c
        if jitter_c
            variation = wait * 0.25
            wait -= variation + (math.random() * variation * 2)
        wait


do_retry: any = (max_attempts: i64, backoff_fn: any, fn_ref: any)
    if max_attempts == nil or max_attempts < 1 max_attempts = 3
    if backoff_fn == nil backoff_fn = constant_backoff(1)
    attempt = 1
    last_error = nil
    while attempt <= max_attempts
        ok, result = pcall(fn_ref)
        if ok and result != nil
            return {ok = result, attempts = attempt}
        if not ok
            last_error = result:to(str)
        if attempt < max_attempts
            wait = backoff_fn(attempt)
            std_retry_sleep(wait)
        attempt += 1
    {ok = nil, error = last_error, attempts = max_attempts}

do_retry_bool: any = (max_attempts: i64, backoff_fn: any, fn_ref: any)
    if max_attempts == nil or max_attempts < 1 max_attempts = 3
    if backoff_fn == nil backoff_fn = constant_backoff(1)
    attempt = 1
    last_error = nil
    while attempt <= max_attempts
        ok, result = pcall(fn_ref)
        if ok and result == true
            return {ok = true, attempts = attempt}
        if not ok
            last_error = result:to(str)
        if attempt < max_attempts
            wait = backoff_fn(attempt)
            std_retry_sleep(wait)
        attempt += 1
    {ok = false, error = last_error, attempts = max_attempts}

retry: any = (fn_ref: any)
    do_retry(3, constant_backoff(1), fn_ref)

retry_with_backoff: any = (fn_ref: any, max_attempts: i64)
    if max_attempts == nil max_attempts = 5
    do_retry(max_attempts, exponential_backoff(0.5, 30, true), fn_ref)

retry_if: any = (max_attempts: i64, backoff_fn: any, condition: any, fn_ref: any)
    if max_attempts == nil or max_attempts < 1 max_attempts = 3
    if backoff_fn == nil backoff_fn = constant_backoff(1)
    attempt = 1
    last_error = nil
    while attempt <= max_attempts
        ok, result = pcall(fn_ref)
        if ok and result != nil
            return {ok = result, attempts = attempt}
        if not ok
            last_error = result:to(str)
            if not condition(last_error)
                return {ok = nil, error = last_error, attempts = attempt}
        if attempt < max_attempts
            wait = backoff_fn(attempt)
            std_retry_sleep(wait)
        attempt += 1
    {ok = nil, error = last_error, attempts = max_attempts}


circuit_new: any = (failure_threshold: i64, reset_timeout: i64)
    if failure_threshold == nil failure_threshold = 5
    if reset_timeout == nil reset_timeout = 30
    {
        state = "closed",
        failures = 0,
        threshold = failure_threshold,
        timeout = reset_timeout,
        last_failure = 0,
        success_count = 0,
        total_calls = 0,
        total_failures = 0
    }

circuit_call: any = (cb: any, fn_ref: any)
    if cb == nil return {ok = nil, error = "nil circuit breaker"}
    cb.total_calls = cb.total_calls + 1
    if cb.state == "open"
        if os.clock() - cb.last_failure >= cb.timeout
            cb.state = "half_open"
        else
            return {ok = nil, circuit_open = true}
    ok, result = pcall(fn_ref)
    if ok
        if cb.state == "half_open"
            cb.success_count = cb.success_count + 1
            if cb.success_count >= 2
                cb.state = "closed"
                cb.failures = 0
                cb.success_count = 0
        else
            cb.failures = 0
            cb.success_count = 0
        return {ok = result}
    cb.failures = cb.failures + 1
    cb.total_failures = cb.total_failures + 1
    cb.last_failure = os.clock()
    cb.success_count = 0
    if cb.failures >= cb.threshold
        cb.state = "open"
    {ok = nil, error = result:to(str)}

circuit_state: str = (cb: any)
    if cb == nil return "unknown"
    cb.state

circuit_reset = (cb: any)
    if cb == nil return
    cb.state = "closed"
    cb.failures = 0
    cb.last_failure = 0
    cb.success_count = 0

circuit_stats: any = (cb: any)
    if cb == nil return {}
    {
        state = cb.state,
        failures = cb.failures,
        threshold = cb.threshold,
        total_calls = cb.total_calls,
        total_failures = cb.total_failures
    }

