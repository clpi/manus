# coroutine — coroutine utilities

create(f: any): any
    coroutine.create(f)

resume(co: any, arg: any): any
    coroutine.resume(co, arg)

yield(arg: any): any
    coroutine.yield(arg)

status(co: any): str
    coroutine.status(co)

running(): any
    coroutine.running()

wrap(f: any): any
    coroutine.wrap(f)

isyieldable(): bool
    coroutine.isyieldable()

close(co: any): any
    coroutine.close(co)

