# coroutine — coroutine utilities

create: any = (f: any)
  coroutine.create(f)

resume: any = (co: any, arg: any)
  coroutine.resume(co, arg)

yield: any = (arg: any)
  coroutine.yield(arg)

status: str = (co: any)
  coroutine.status(co)

running: any = ()
  coroutine.running()

wrap: any = (f: any)
  coroutine.wrap(f)

isyieldable: bool = ()
  coroutine.isyieldable()

close: any = (co: any)
  coroutine.close(co)
