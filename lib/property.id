
std_property_parse: any = (path: str)
  if path == nil
    return {}
  parts = {}
  current = ""
  i = 1
  while i <= path:len()
    ch = path:sub(i, i)
    if ch == "."
      if current != ""
        parts[parts:len() + 1] = current
      current = ""
    else
      current = current .. ch
    i = i + 1
  if current != ""
    parts[parts:len() + 1] = current
  parts

std_property_to_num: any = (s: str)
  if s == nil
    return nil
  num = s:to(i64)
  num

std_property_navigate: any = (obj: any, path: str)
  if obj == nil or path == nil
    return nil
  parts = std_property_parse(path)
  if parts:len() == 0
    return nil
  current = obj
  i = 1
  while i < parts:len()
    key = parts[i]
    idx = std_property_to_num(key)
    if idx != nil
      current = current(idx)
    else
      current = current(key)
    if current == nil
      return nil
    i = i + 1
  last = parts(parts:len())
  last_idx = std_property_to_num(last)
  if last_idx != nil
    return { parent = current, key = last_idx, is_num = true }
  return { parent = current, key = last, is_num = false }

std_property_ensure_path: any = (obj: any, parts: any)
  current = obj
  i = 1
  while i <= parts:len()
    key = parts[i]
    idx = std_property_to_num(key)
    if idx != nil
      if current(idx) == nil
        current[idx] = {}
      current = current(idx)
    else
      if current(key) == nil
        current[key] = {}
      current = current(key)
    i = i + 1
  current

parse_path: any = (path: str)
  std_property_parse(path)

get: any = (obj: any, path: str)
  if obj == nil or path == nil
    return nil
  parts = std_property_parse(path)
  current = obj
  i = 1
  while i <= parts:len()
    if type(current) != "table"
      return nil
    key = parts[i]
    idx = std_property_to_num(key)
    if idx != nil
      current = current(idx)
    else
      current = current(key)
    if current == nil
      return nil
    i = i + 1
  current

set = (obj: any, path: str, value: any)
  if obj == nil or path == nil
    return
  parts = std_property_parse(path)
  if parts:len() == 0
    return
  current = obj
  i = 1
  while i < parts:len()
    key = parts[i]
    idx = std_property_to_num(key)
    if idx != nil
      if current(idx) == nil
        current[idx] = {}
      current = current(idx)
    else
      if current(key) == nil
        current[key] = {}
      current = current(key)
    i = i + 1
  last = parts(parts:len())
  last_idx = std_property_to_num(last)
  if last_idx != nil
    current[last_idx] = value
  else
    current[last] = value

has: bool = (obj: any, path: str)
  if obj == nil or path == nil
    return false
  parts = std_property_parse(path)
  current = obj
  i = 1
  while i <= parts:len()
    if type(current) != "table"
      return false
    key = parts[i]
    idx = std_property_to_num(key)
    if idx != nil
      current = current(idx)
    else
      current = current(key)
    if current == nil
      return false
    i = i + 1
  true

delete: any = (obj: any, path: str)
  nav = std_property_navigate(obj, path)
  if nav == nil
    return nil
  removed = nil
  if nav.is_num
    removed = nav.parent(nav.key)
    nav.parent[nav.key] = nil
  else
    removed = nav.parent(nav.key)
    nav.parent[nav.key] = nil
  removed

get_or: any = (obj: any, path: str, fallback: any)
  result = get(obj, path)
  if result == nil
    return fallback
  result

set_multiple = (obj: any, values: any)
  if obj == nil or values == nil
    return
  for path, value in values
    set(obj, path, value)

std_property_flatten_rec = (obj: any, prefix: any, out: any)
  if obj == nil
    return
  for k, v in obj
    path = k:to(str)
    if prefix != ""
      path = prefix .. "." .. path
    if type(v) == "table"
      has_leaf = false
      for _, inner in v
        if type(inner) != "table"
          has_leaf = true
          break
      if has_leaf
        out[path] = v
      else
        std_property_flatten_rec(v, path, out)
    else
      out[path] = v

flatten: any = (obj: any, prefix: any)
  out = {}
  if prefix == nil
    prefix = ""
  std_property_flatten_rec(obj, prefix, out)
  out

keys: any = (obj: any)
  flat = flatten(obj, "")
  out = {}
  for pk, _pv in flat
    out[out:len() + 1] = pk
  out

values: any = (obj: any)
  flat = flatten(obj, "")
  out = {}
  for _, v in flat
    out[out:len() + 1] = v
  out

update: bool = (obj: any, path: str, value: any)
  if not has(obj, path)
    return false
  set(obj, path, value)
  true

merge_deep: any = (a: any, b: any)
  out = {}
  if a != nil
    for k, v in a
      out[k] = v
  if b != nil
    for k, v in b
      if type(v) == "table" and type(out[k]) == "table"
        out[k] = merge_deep(out[k], v)
      else
        out[k] = v
  out
