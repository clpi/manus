# term — terminal styling helpers for Duo programs and build scripts

global M = {}

M.RESET = color.RESET
M.BOLD = color.BOLD
M.DIM = color.DIM

is_tty: bool = ()
  ok, val = pcall(os.getenv, "DUO_COLOR")
  if ok and val != nil and val != "" and val != "0"
    return true
  ok2, val2 = pcall(os.getenv, "NO_COLOR")
  if ok2 and val2 != nil and val2 != ""
    return false
  true

styled: str = (prefix, text, suffix)
  if is_tty()
    prefix .. text .. suffix
  else
    text

bold: str = (text: str)
  styled(color.BOLD, text, color.RESET)

dim: str = (text: str)
  styled(color.DIM, text, color.RESET)

green: str = (text: str)
  color.green(text)

red: str = (text: str)
  color.red(text)

yellow: str = (text: str)
  color.yellow(text)

cyan: str = (text: str)
  color.blue(text)

banner: str = (title: str)
  if is_tty()
    color.CYAN .. "╭─ " .. title .. color.RESET
  else
    "== " .. title .. " =="

kv: str = (key: str, value: str)
  if is_tty()
    color.DIM .. key .. color.RESET .. " " .. color.CYAN .. value .. color.RESET
  else
    key .. " " .. value

divider: str = ()
  if is_tty()
    color.DIM .. "────────────────────────────────────────" .. color.RESET
  else
    "----------------------------------------"

ok_msg: str = (text: str)
  if is_tty()
    color.GREEN .. "✓ " .. text .. color.RESET
  else
    "ok: " .. text

err_msg: str = (text: str)
  if is_tty()
    color.RED .. "● error: " .. text .. color.RESET
  else
    "error: " .. text

M.is_tty = is_tty
M.styled = styled
M.bold = bold
M.dim = dim
M.green = green
M.red = red
M.yellow = yellow
M.cyan = cyan
M.banner = banner
M.kv = kv
M.divider = divider
M.ok_msg = ok_msg
M.err_msg = err_msg

M
