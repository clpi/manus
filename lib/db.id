

config_new: any = (driver: str)
  {
    driver = driver,
    host = "localhost",
    port = 5432,
    database = "",
    username = "",
    password = "",
    max_connections = 10,
    min_connections = 2,
    connection_timeout = 30,
    idle_timeout = 300,
    schema = "public",
    ssl_mode = "prefer",
    options = {}
  }

config_set_host: any = (config: any, host: str)
  config.host = host
  config

config_set_port: any = (config: any, port: i64)
  config.port = port
  config

config_set_database: any = (config: any, database: str)
  config.database = database
  config

config_set_auth: any = (config: any, username: str, password: str)
  config.username = username
  config.password = password
  config

config_set_pool: any = (config: any, min: i64, max: i64)
  config.min_connections = min
  config.max_connections = max
  config


pool_new: any = (config: any)
  pool = {
    config = config,
    connections = {},
    available = {},
    in_use = 0,
    total = 0
  }
  i = 0
  while i < config.min_connections
    conn = connection_new(config)
    if conn
      pool.connections[pool.connections:len() + 1] = conn
      pool.available[pool.available:len() + 1] = conn
      pool.total = pool.total + 1
    i = i + 1
  pool

pool_acquire: any = (pool: any)
  if pool.available:len() > 0
    conn = pool.available[pool.available:len()]
    pool.available[pool.available:len()] = nil
    pool.in_use = pool.in_use + 1
    return conn

  if pool.total < pool.config.max_connections
    conn = connection_new(pool.config)
    if conn
      pool.total = pool.total + 1
      pool.in_use = pool.in_use + 1
      return conn

  nil

pool_release: void = (pool: any, conn: any)
  if conn == nil
    return
  pool.in_use = pool.in_use - 1
  pool.available[pool.available:len() + 1] = conn

pool_close: void = (pool: any)
  for conn in pool.connections
    connection_close(conn)
  pool.connections = {}
  pool.available = {}
  pool.total = 0
  pool.in_use = 0

pool_stats: any = (pool: any)
  {
    total = pool.total,
    available = pool.available:len(),
    in_use = pool.in_use,
    max = pool.config.max_connections,
    utilization = pool.total > 0 and pool.in_use / pool.total or 0
  }


connection_new: any = (config: any)
  if config.driver == "sqlite"
    db_path = config.database
    if db_path == nil or db_path == ""
      db_path = ":memory:"
    handle = sqlite.open(db_path)
    if handle == nil
      return { error = "Failed to open SQLite database: " .. db_path }
    {
      config = config,
      connected = true,
      handle = handle,
      driver = "sqlite",
      transaction_active = false
    }
  else
    { error = "Unsupported driver: " .. config.driver }

connection_close: void = (conn: any)
  if conn == nil
    return
  if has(.handle)(conn) and conn.connected
    sqlite.close(conn.handle)
    conn.handle = nil
  conn.connected = false

connection_ping: bool = (conn: any)
  conn.connected and conn.handle != nil

connection_execute: any = (conn: any, sql: str, params: any)
  if not conn.connected
    return { error = "Connection closed" }
  if conn.driver == "sqlite"
    err = sqlite.execute(conn.handle, sql)
    if err != ""
      return { ok = false, error = err, rows_affected = 0, rows = {}, columns = {} }
    affected = sqlite.changes(conn.handle)
    return { ok = true, rows_affected = affected, rows = {}, columns = {} }
  { error = "Unsupported driver" }

connection_query: any = (conn: any, sql: str, params: any)
  if not conn.connected
    return { error = "Connection closed" }
  if conn.driver == "sqlite"
    rows = sqlite.query(conn.handle, sql)
    if rows == nil
      return { ok = false, error = "Query failed", rows = {}, columns = {} }
    columns = {}
    if rows:len() > 0
      for k, _ in rows[1]
        columns[columns:len() + 1] = k
    return { ok = true, rows_affected = 0, rows = rows, columns = columns }
  { error = "Unsupported driver" }

connection_query_one: any = (conn: any, sql: str, params: any)
  result = connection_query(conn, sql, params)
  if result.error or not result.ok
    return result
  if result.rows:len() > 0
    return result.rows[1]
  nil

connection_begin: any = (conn: any)
  if conn.transaction_active
    return { error = "Transaction already active" }
  if conn.driver == "sqlite"
    err = sqlite.execute(conn.handle, "BEGIN TRANSACTION")
    if err != ""
      return { ok = false, error = err }
  conn.transaction_active = true
  { ok = true }

connection_commit: any = (conn: any)
  if not conn.transaction_active
    return { error = "No active transaction" }
  if conn.driver == "sqlite"
    err = sqlite.execute(conn.handle, "COMMIT")
    if err != ""
      return { ok = false, error = err }
  conn.transaction_active = false
  { ok = true }

connection_rollback: any = (conn: any)
  if not conn.transaction_active
    return { error = "No active transaction" }
  if conn.driver == "sqlite"
    err = sqlite.execute(conn.handle, "ROLLBACK")
    if err != ""
      return { ok = false, error = err }
  conn.transaction_active = false
  { ok = true }


query: any = ()
  {
    type = "select",
    table = "",
    columns = {},
    where = {},
    joins = {},
    group_by = {},
    having = {},
    order_by = {},
    limit = nil,
    offset = nil,
    params = {}
  }

select: any = (q: any, ...columns)
  q.type = "select"
  args = { ... }
  for i = 1, args:len()
    q.columns[q.columns:len() + 1] = args[i]
  q

from: any = (q: any, table: str)
  q.table = table
  q

where: any = (q: any, condition: str, ...args)
  q.where[q.where:len() + 1] = condition
  vals = { ... }
  for i = 1, vals:len()
    q.params[q.params:len() + 1] = vals[i]
  q

join: any = (q: any, table: str, condition: str)
  q.joins[q.joins:len() + 1] = { table = table, condition = condition, type = "INNER" }
  q

left_join: any = (q: any, table: str, condition: str)
  q.joins[q.joins:len() + 1] = { table = table, condition = condition, type = "LEFT" }
  q

group_by: any = (q: any, ...columns)
  args = { ... }
  for i = 1, args:len()
    q.group_by[q.group_by:len() + 1] = args[i]
  q

having: any = (q: any, condition: str)
  q.having[q.having:len() + 1] = condition
  q

order_by: any = (q: any, column: str, direction: str)
  if direction == nil
    direction = "ASC"
  q.order_by[q.order_by:len() + 1] = { column = column, direction = direction }
  q

limit: any = (q: any, n: i64)
  q.limit = n
  q

offset: any = (q: any, n: i64)
  q.offset = n
  q

insert: any = (q: any, table: str, data: any)
  q.type = "insert"
  q.table = table
  q.data = data
  q

update: any = (q: any, table: str, data: any)
  q.type = "update"
  q.table = table
  q.data = data
  q

delete: any = (q: any, table: str)
  q.type = "delete"
  q.table = table
  q

build: any = (q: any)
  parts = {}
  params = {}

if q.type == "select"
  if q.columns:len() == 0
    parts[parts:len() + 1] = "SELECT *"
  else
    parts[parts:len() + 1] = "SELECT " .. q.columns:concat(", ")

  if q.table != ""
    parts[parts:len() + 1] = "FROM " .. q.table

  for join in q.joins
    parts[parts:len() + 1] = join.type .. " JOIN " .. join.table .. " ON " .. join.condition

  if q.where:len() > 0
    parts[parts:len() + 1] = "WHERE " .. q.where:concat(" AND ")
    for p in q.params
      params[params:len() + 1] = p

  if q.group_by:len() > 0
    parts[parts:len() + 1] = "GROUP BY " .. q.group_by:concat(", ")

  if q.having:len() > 0
    parts[parts:len() + 1] = "HAVING " .. q.having:concat(" AND ")

  if q.order_by:len() > 0
    order_parts = {}
    for o in q.order_by
      order_parts[order_parts:len() + 1] = o.column .. " " .. o.direction
    parts[parts:len() + 1] = "ORDER BY " .. order_parts:concat(", ")

  if has(.limit)(q)
    parts[parts:len() + 1] = "LIMIT " .. q.limit:to(str)

  if has(.offset)(q)
    parts[parts:len() + 1] = "OFFSET " .. q.offset:to(str)
else(q.type == "insert")

  parts[parts:len() + 1] = "INSERT INTO " .. q.table

  columns = {}
  values = {}
  placeholders = {}
  for col, val in q.data
    columns[columns:len() + 1] = col
    values[values:len() + 1] = val
    placeholders[placeholders:len() + 1] = "$" .. to(str)(params:len() + 1)
    params[params:len() + 1] = val
  parts[parts:len() + 1] = "(" .. columns:concat(", ") .. ")"
  parts[parts:len() + 1] = "VALUES (" .. placeholders:concat(", ") .. ")"
else(q.type == "update")

  parts[parts:len() + 1] = "UPDATE " .. q.table

  set_parts = {}
  for col, val in q.data
    set_parts[set_parts:len() + 1] = col .. " = $" .. to(str)(params:len() + 1)
    params[params:len() + 1] = val
  parts[parts:len() + 1] = "SET " .. set_parts:concat(", ")

  if q.where:len() > 0
    parts[parts:len() + 1] = "WHERE " .. q.where:concat(" AND ")
    for p in q.params
      params[params:len() + 1] = p
else(q.type == "delete")

  parts[parts:len() + 1] = "DELETE FROM " .. q.table

  if q.where:len() > 0
    parts[parts:len() + 1] = "WHERE " .. q.where:concat(" AND ")
    for p in q.params
      params[params:len() + 1] = p

{
  sql = parts:concat(" "),
  params = params
}
