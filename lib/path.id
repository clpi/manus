# path — path manipulation utilities (POSIX-style)

join: str = (a: str, b: str)
  if a == ""
    b
  if b == ""
    return a
  if b:sub(1, 1) == "/"
    return b
  if a:sub(-1, -1) == "/"
    return a .. b
  a .. "/" .. b

basename: str = (p: str)
  if p == ""
    ""
  i = p:len()
  while i > 1 and p:sub(i, i) == "/"
    i = i - 1
  last = i
  while i > 1 and p:sub(i - 1, i - 1) != "/"
    i = i - 1
  p:sub(i, last)

dirname: str = (p: str)
  if p == ""
    "."
  i = p:len()
  while i > 1 and p:sub(i, i) == "/"
    i = i - 1
  while i > 1 and p:sub(i - 1, i - 1) != "/"
    i = i - 1
  if i <= 1
    if p:sub(1, 1) == "/"
      return "/"
    return "."
  p:sub(1, i - 1)

extname: str = (p: str)
  base = basename(p)
  i = base:len()
  while i > 1
    if base:sub(i, i) == "."
      base:sub(i, base:len())
    i = i - 1
  ""

absolute: bool = (p: str)
  if p == nil or p == ""
    return false
  p:sub(1, 1) == "/"

normalize: str = (p: str)
  if p == nil or p == ""
    return "."
  while p:find("//")
    p = p:gsub("//", "/")
  if p != "/" and p:sub(-1, -1) == "/"
    p = p:sub(1, -2)
  p
