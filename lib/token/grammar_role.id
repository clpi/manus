role_begin_expr(kind: i64): bool
    kind >= 0 and kind < ROLE_COUNT and BEGIN_EXPR[kind + 1] != 0
end

role_prefix(kind: i64): bool
    kind >= 0 and kind < ROLE_COUNT and PREFIX[kind + 1] != 0
end

role_postfix(kind: i64): bool
    kind >= 0 and kind < ROLE_COUNT and POSTFIX[kind + 1] != 0
end

role_parameter(kind: i64): bool
    kind >= 0 and kind < ROLE_COUNT and PARAMETER[kind + 1] != 0
end

role_compat_only(kind: i64): bool
    kind >= 0 and kind < ROLE_COUNT and COMPAT_ONLY[kind + 1] != 0
end

role_precedence(kind: i64): i64
    if kind < 0 or kind >= ROLE_COUNT
        0
    else
        PRECEDENCE[kind + 1]
    end
end

role_assoc(kind: i64): i64
    if kind < 0 or kind >= ROLE_COUNT
        0
    else
        ASSOC[kind + 1]
    end
end
