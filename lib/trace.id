# trace — beautiful, semantically-formatted trace & debug output
#
# Design:
#   * Every event is signed with a beautiful Unicode glyph and colored
#     by severity. Bold/italic/dim/underline/strikethrough/reverse
#     carry semantic meaning (see LEGEND below).
#   * Spans can be opened/closed and timed.
#   * Field values are colored by Lua TYPE so a glance reveals shape.
#   * Source locations are underline; function names are magenta-italic;
#     timestamps are dim; slow durations are bold-yellow.
#   * Honors NO_COLOR / DUO_COLOR env vars.
#
# LEGEND of formatting semantics:
#   bold       = essential payload (msg, error text, slow span durs)
#   italic     = identity (function names, type names, nil)
#   dim        = ancillary (timestamps, caller meta, trace level)
#   underline  = location references (file:line, field keys)
#   strikethrough = deleted/removed (in diffs, deprecated values)
#   reverse    = breakpoint / attention-grab (fatal banner, divider)
#   color      = severity / type class
#
# NOTE: this module is intentionally self-contained — it does not
# `req` other stdlib modules at top level. The current codegen drops
# top-level `local x = stdlib` bindings when a stdlib module is
# inlined under `duo run`; inlining ANSI codes + tty detection here
# keeps trace compilable today. When that codegen gap is fixed,
# trace.id can switch back to `local color = color` etc.

global M = {}

# ─── ANSI codes (inline copy of color) ─────────────────────────
M.RESET      = "\x1b[0m"
M.BOLD       = "\x1b[1m"
M.DIM        = "\x1b[2m"
M.ITALIC     = "\x1b[3m"
M.UNDERLINE  = "\x1b[4m"
M.BLINK      = "\x1b[5m"
M.REVERSE    = "\x1b[7m"
M.STRIKE     = "\x1b[9m"

M.BLACK      = "\x1b[30m"
M.RED        = "\x1b[31m"
M.GREEN      = "\x1b[32m"
M.YELLOW     = "\x1b[33m"
M.BLUE       = "\x1b[34m"
M.MAGENTA    = "\x1b[35m"
M.CYAN       = "\x1b[36m"
M.WHITE      = "\x1b[37m"

M.BRIGHT_BLACK   = "\x1b[90m"
M.BRIGHT_RED     = "\x1b[91m"
M.BRIGHT_GREEN   = "\x1b[92m"
M.BRIGHT_YELLOW  = "\x1b[93m"
M.BRIGHT_BLUE    = "\x1b[94m"
M.BRIGHT_MAGENTA = "\x1b[95m"
M.BRIGHT_CYAN    = "\x1b[96m"
M.BRIGHT_WHITE   = "\x1b[97m"

M.BG_BLACK   = "\x1b[40m"
M.BG_RED     = "\x1b[41m"
M.BG_GREEN   = "\x1b[42m"
M.BG_YELLOW  = "\x1b[43m"
M.BG_BLUE    = "\x1b[44m"
M.BG_MAGENTA = "\x1b[45m"
M.BG_CYAN    = "\x1b[46m"
M.BG_WHITE   = "\x1b[47m"

# ─── Glyphs ────────────────────────────────────────────────────────
M.G_TRACE      = "∘"
M.G_DEBUG      = "⊙"
M.G_INFO       = "✦"
M.G_WARN       = "▲"
M.G_ERROR      = "✕"
M.G_FATAL      = "☠"

M.G_SPAN_BEGIN = "┌─"
M.G_SPAN_END   = "└─"
M.G_ARROW      = "⤳"
M.G_DUR        = "⊹"
M.G_KV_SEP     = "="
M.G_PIPE       = "│"
M.G_BULLET     = "•"
M.G_DOT        = "·"
M.G_CROSS      = "┼"
M.G_ELLIPSIS   = "⋯"
M.G_DASH       = "─"
M.G_EQUIV      = "≡"
M.G_PROPEL     = "▸"
M.G_RETURN     = "◂"
M.G_CHECK      = "✓"
M.G_CROSS_MARK = "✗"
M.G_WARN_MARK  = "⚠"
M.G_INFO_MARK  = "ℹ"
M.G_POINTER    = "→"
M.G_SEED       = "⊕"
M.G_SNAPSHOT   = "◎"
M.G_LOCK       = "🔒"
M.G_UNLOCK     = "🔓"
M.G_STAR       = "★"
M.G_DIAMOND    = "◆"
M.G_SQUARE     = "■"
M.G_CIRCLE     = "●"
M.G_TRIANGLE   = "▲"
M.G_HEXAGON    = "⬡"

# ─── Box-drawing palette ──────────────────────────────────────────
M.BOX_TL = "╭"   # top-left rounded
M.BOX_TR = "╮"   # top-right rounded
M.BOX_BL = "╰"   # bottom-left rounded
M.BOX_BR = "╯"   # bottom-right rounded
M.BOX_ML = "├"   # mid-left
M.BOX_MR = "┤"   # mid-right
M.BOX_H  = "─"   # horizontal
M.BOX_V  = "│"   # vertical
M.BOX_C  = "┼"   # cross
M.BOX_TL_SQUARE = "┌"
M.BOX_TR_SQUARE = "┐"
M.BOX_BL_SQUARE = "└"
M.BOX_BR_SQUARE = "┘"

# ─── Levels ────────────────────────────────────────────────────────
M.LV_TRACE = 0
M.LV_DEBUG = 1
M.LV_INFO  = 2
M.LV_WARN  = 3
M.LV_ERROR = 4
M.LV_FATAL = 5

M.level_value = {
    trace = M.LV_TRACE, debug = M.LV_DEBUG, info = M.LV_INFO,
    warn = M.LV_WARN, error = M.LV_ERROR, fatal = M.LV_FATAL,
}
M.level_name = {
    [0] = "trace", [1] = "debug", [2] = "info",
    [3] = "warn", [4] = "error", [5] = "fatal",
}

global trace_level = M.LV_INFO
global trace_show_caller = true
global trace_show_ts = true
global trace_spans = {}
global trace_color = true

# ─── tty detection ────────────────────────────────────────────────
tty: bool = ()
    ok, val = pcall(os.getenv, "DUO_COLOR")
    if ok and val != nil and val != "" and val != "0"
        return true
    ok2, val2 = pcall(os.getenv, "NO_COLOR")
    if ok2 and val2 != nil and val2 != ""
        return false
    return true

# ─── Low-level style wrappers ────────────────────────────────────

s: str = (prefix: str, text: str, suffix: str)
    if prefix == nil prefix = "" 
    if suffix == nil suffix = M.RESET 
    if not tty()
        return text:to(str)
    return prefix .. text:to(str) .. suffix

bold: str = (text: str)
    return M.BOLD .. text:to(str) .. M.RESET

dim: str = (text: str)
    return M.DIM .. text:to(str) .. M.RESET

italic: str = (text: str)
    return M.ITALIC .. text:to(str) .. M.RESET

underline: str = (text: str)
    return M.UNDERLINE .. text:to(str) .. M.RESET

strikethrough: str = (text: str)
    return M.STRIKE .. text:to(str) .. M.RESET

reverse: str = (text: str)
    return M.REVERSE .. text:to(str) .. M.RESET

blink: str = (text: str)
    return M.BLINK .. text:to(str) .. M.RESET

red: str = (text: str)
    return M.RED .. text:to(str) .. M.RESET

green: str = (text: str)
    return M.GREEN .. text:to(str) .. M.RESET

yellow: str = (text: str)
    return M.YELLOW .. text:to(str) .. M.RESET

blue: str = (text: str)
    return M.BLUE .. text:to(str) .. M.RESET

magenta: str = (text: str)
    return M.MAGENTA .. text:to(str) .. M.RESET

cyan: str = (text: str)
    return M.CYAN .. text:to(str) .. M.RESET

bright_red: str = (text: str)
    return M.BRIGHT_RED .. text:to(str) .. M.RESET

bright_green: str = (text: str)
    return M.BRIGHT_GREEN .. text:to(str) .. M.RESET

bright_yellow: str = (text: str)
    return M.BRIGHT_YELLOW .. text:to(str) .. M.RESET

bright_blue: str = (text: str)
    return M.BRIGHT_BLUE .. text:to(str) .. M.RESET

bright_magenta: str = (text: str)
    return M.BRIGHT_MAGENTA .. text:to(str) .. M.RESET

bright_cyan: str = (text: str)
    return M.BRIGHT_CYAN .. text:to(str) .. M.RESET

bright_white: str = (text: str)
    return M.BRIGHT_WHITE .. text:to(str) .. M.RESET

gray: str = (text: str)
    return M.BRIGHT_BLACK .. text:to(str) .. M.RESET

# ─── Compound semantic styles ─────────────────────────────────────
# These combine attributes for specific semantic roles.
# Each one paints a single concept — use them to build readable output.

sem_success: str = (text: str)
    return M.BOLD .. M.GREEN .. text:to(str) .. M.RESET

sem_failure: str = (text: str)
    return M.BOLD .. M.RED .. text:to(str) .. M.RESET

sem_caution: str = (text: str)
    return M.BOLD .. M.YELLOW .. text:to(str) .. M.RESET

sem_identity: str = (text: str)
    return M.ITALIC .. M.MAGENTA .. text:to(str) .. M.RESET

sem_location: str = (text: str)
    return M.UNDERLINE .. text:to(str) .. M.RESET

sem_meta: str = (text: str)
    return M.DIM .. text:to(str) .. M.RESET

sem_payload: str = (text: str)
    return M.BOLD .. text:to(str) .. M.RESET

sem_deleted: str = (text: str)
    return M.STRIKE .. M.RED .. text:to(str) .. M.RESET

sem_added: str = (text: str)
    return M.BOLD .. M.GREEN .. text:to(str) .. M.RESET

sem_changed_old: str = (text: str)
    return M.DIM .. M.RED .. text:to(str) .. M.RESET

sem_changed_new: str = (text: str)
    return M.BOLD .. M.GREEN .. text:to(str) .. M.RESET

sem_type: str = (text: str)
    return M.ITALIC .. M.CYAN .. text:to(str) .. M.RESET

sem_constant: str = (text: str)
    return M.BOLD .. M.BRIGHT_CYAN .. text:to(str) .. M.RESET

sem_hex: str = (text: str)
    return M.BRIGHT_BLACK .. M.UNDERLINE .. text:to(str) .. M.RESET

sem_text: str:len(): str
    return M.BRIGHT_YELLOW .. text:to(str) .. M.RESET

sem_percent: str = (text: str)
    return M.BRIGHT_MAGENTA .. text:to(str) .. M.RESET

sem_time_fast: str = (text: str)
    return M.DIM .. M.GREEN .. text:to(str) .. M.RESET

sem_time_normal: str = (text: str)
    return M.YELLOW .. text:to(str) .. M.RESET

sem_time_slow: str = (text: str)
    return M.BOLD .. M.RED .. text:to(str) .. M.RESET

sem_attention: str = (text: str)
    return M.REVERSE .. M.BOLD .. text:to(str) .. M.RESET

sem_deprecated: str = (text: str)
    return M.STRIKE .. M.DIM .. text:to(str) .. M.RESET

sem_key: str = (text: str)
    return M.UNDERLINE .. M.CYAN .. text:to(str) .. M.RESET

sem_nil: str = (text: str)
    return M.DIM .. M.ITALIC .. text:to(str) .. M.RESET

sem_string_val: str = (text: str)
    return M.GREEN .. text:to(str) .. M.RESET

sem_number_val: str = (text: str)
    return M.YELLOW .. text:to(str) .. M.RESET

sem_bool_val: str = (text: str)
    return M.MAGENTA .. text:to(str) .. M.RESET

sem_table_val: str = (text: str)
    return M.CYAN .. text:to(str) .. M.RESET

sem_function_val: str = (text: str)
    return M.ITALIC .. M.CYAN .. text:to(str) .. M.RESET

sem_breakpoint: str = (text: str)
    return M.REVERSE .. M.RED .. M.BOLD .. text:to(str) .. M.RESET

sem_banner_line: str = (text: str)
    return M.BOLD .. M.CYAN .. text:to(str) .. M.RESET

sem_frame: str = (text: str)
    return M.BRIGHT_BLACK .. text:to(str) .. M.RESET

sem_numbering: str = (text: str)
    return M.DIM .. M.BRIGHT_BLACK .. text:to(str) .. M.RESET

sem_diff_hunk: str = (text: str)
    return M.BOLD .. M.BRIGHT_WHITE .. text:to(str) .. M.RESET

sem_context_line: str = (text: str)
    return M.DIM .. text:to(str) .. M.RESET

# ─── Value formatting ─────────────────────────────────────────────
tbl_summary: str = (t: any)
    if t == nil return "nil" 
    n = t:len()
    if n > 0
        return "array(" .. n:to(str) .. ")"
    count = 0
    first = ""
    for k, _v in t
        count += 1
        if count == 1 first = k:to(str) 
    if count == 0 return "{}" 
    if count <= 3
        return "{" .. first .. ", ...}"
    return "{" .. count:to(str) .. " keys}"

pretty_val: str = (value: any)
    if value == nil
        return sem_nil("nil")
    t = type(value)
    if t:find("string") == 1
        return sem_string_val('"' .. to(str)(value) .. '"')
    else if t:find("number") == 1
        return sem_number_val(value:to(str))
    else if t:find("boolean") == 1
        return sem_bool_val(value:to(str))
    else if t:find("function") == 1
        return sem_function_val("⟪fn⟫")
    else if t:find("table") == 1
        n = value:len()
        if n > 0
            return sem_table_val("⟦array " .. n:to(str) .. "⟧")
        return sem_table_val(italic("{" .. tbl_summary(value) .. "}"))
    return value:to(str)

pretty_kv: str = (k: str, v: any)
    return sem_key(k:to(str)) .. dim(" " .. M.G_KV_SEP .. " ") .. pretty_val(v)

# ─── Contextual formatters ───────────────────────────────────────

_to_hex: str = (n: int)
    digits = "0123456789abcdef"
    if n == 0 return "0" 
    result = ""
    while n > 0
        d = n % 16:floor() + 1
        result = digits:sub(d, d) .. result
        n = n / 16:floor()
    return result

fmt_hex: str = (value: any)
    n = value:to(i64)
    if n == nil return value:to(str) 
    neg = false
    if n < 0
        neg = true
        n = -n
    hex = _to_hex(n:floor())
    if neg hex = "-" .. hex 
    return sem_hex("0x" .. hex)

fmt_bytes: any:len(): str
    n = bytes:to(i64)
    if n == nil return bytes:to(str) 
    if n < 1024
        return sem_n:to(str) .. "B":len()
    else if n < 1048576
        whole = n / 1024:floor()
        frac = (n - whole * 1024) * 10 / 1024:floor()
        return sem_whole:to(str) .. "." .. frac:to(str) .. "KB":len()
    else if n < 1073741824
        whole = n / 1048576:floor()
        frac = (n - whole * 1048576) * 10 / 1048576:floor()
        return sem_whole:to(str) .. "." .. frac:to(str) .. "MB":len()
    else
        whole = n / 1073741824:floor()
        frac = (n - whole * 1073741824) * 10 / 1073741824:floor()
        return sem_whole:to(str) .. "." .. frac:to(str) .. "GB":len()

fmt_pct: str = (value: any)
    n = value:to(i64)
    if n == nil return value:to(str) 
    whole = n:floor()
    frac = (n - whole) * 100 + 0.5:floor()
    if frac >= 100 frac = 99 
    frac_str = frac:to(str)
    if frac < 10 frac_str = "0" .. frac:to(str) 
    return sem_percent(whole:to(str) .. "." .. frac_str .. "%")

fmt_count: str = (n: any)
    num = n:to(i64)
    if num == nil return n:to(str) 
    return sem_number_val(num:to(str))

fmt_bool: str = (b: any)
    if b return sem_added("true") 
    return sem_deleted("false")

fmt_nil: str = ()
    return sem_nil("nil")

fmt_ref: str = (id: any)
    return sem_hex(id:to(str))

fmt_path: str = (path: str)
    return sem_location(path:to(str))

# ─── Caller info ───────────────────────────────────────────────────
caller: str = (level: int)
    info = debug.getinfo(level, "Snl")
    if info == nil return "" 
    name_part = info.name
    if name_part == nil or name_part == ""
        name_part = "?"
    src = info.short_src
    if src == nil src = info.source 
    if src == nil src = "?" 
    loc = src
    if info.currentline and info.currentline > 0
        loc = src .. dim(":") .. yellow(info.currentline:to(str))
    return sem_identity(name_part) .. dim(" " .. M.G_ARROW .. " ") .. sem_location(loc)

# ─── Timestamp ─────────────────────────────────────────────────────
ts: str = ()
    secs = os.time()
    ms = (os.clock() * 1000) % 1000:floor()
    frac = "." .. ms:to(str)
    if ms < 10 frac = ".00" .. ms:to(str)
    else if ms < 100 frac = ".0" .. ms:to(str)
    return sem_meta(os.date("%H:%M:%S", secs) .. frac)

# ─── Level tag ─────────────────────────────────────────────────────
level_tag: str = (level: int)
    glyph = M.G_TRACE
    tag = "trace"
    if level == M.LV_DEBUG
        glyph = M.G_DEBUG
        tag = "debug"
    else if level == M.LV_INFO
        glyph = M.G_INFO
        tag = " info"
    else if level == M.LV_WARN
        glyph = M.G_WARN
        tag = " warn"
    else if level == M.LV_ERROR
        glyph = M.G_ERROR
        tag = "error"
    else if level == M.LV_FATAL
        glyph = M.G_FATAL
        tag = "fatal"
    body = glyph .. " " .. tag
    if level == M.LV_TRACE return dim(body) 
    if level == M.LV_DEBUG return blue(body) 
    if level == M.LV_INFO return sem_success(body) 
    if level == M.LV_WARN return sem_caution(body) 
    if level == M.LV_ERROR return sem_failure(body) 
    if level == M.LV_FATAL
        return sem_breakpoint(body)
    return body

# ─── Span indent ───────────────────────────────────────────────────
span_indent: str = ()
    n = trace_spans:len()
    if n <= 0 return "" 
    rep = M.G_PIPE .. " ":rep(n)
    if rep == nil or rep == "" return "" 
    return dim(rep)

# ─── Duration formatting with speed coloring ──────────────────────
_fmt_dur: str = (ms: float)
    whole = ms:floor()
    frac = (ms - whole) * 100:floor()
    frac_str = frac:to(str)
    if frac < 10 frac_str = "0" .. frac:to(str) 
    raw = whole:to(str) .. "." .. frac_str .. "ms"
    if ms < 1
        return sem_time_fast(raw)
    else if ms < 16
        return sem_time_normal(raw)
    else
        return sem_time_slow(raw)

# ─── Emit ──────────────────────────────────────────────────────────
emit = (level: int, msg: str, fields: any, skip: int)
    if level < trace_level return 
    parts = {}
    parts[parts:len() + 1] = level_tag(level)
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    if trace_show_caller
        c = caller(skip + 1)
        if c != ""
            parts[parts:len() + 1] = dim("(") .. c .. dim(")")
    parts[parts:len() + 1] = span_indent()
    if msg != nil and msg != ""
        parts[parts:len() + 1] = sem_payload(msg)
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[parts:len() + 1] = pretty_kv(k, v)
    print(parts:concat(" "))

# ─── Public API ─────────────────────────────────────────────────
set_level = (level: any)
    if type(level) == "string"
        v = M.level_value[level:lower()]
        if v != nil
            trace_level = v
        return
    if type(level) == "number"
        if level >= M.LV_TRACE and level <= M.LV_FATAL
            trace_level = level

get_level: str = ()
    return M.level_name[trace_level] or "info"

show_caller = (on: bool)
    trace_show_caller = on and true or false

show_timestamp = (on: bool)
    trace_show_ts = on and true or false

set_color = (on: bool)
    trace_color = on and true or false

trace = (msg: str, fields: any)
    emit(M.LV_TRACE, msg, fields, 2)

_debug = (msg: str, fields: any)
    emit(M.LV_DEBUG, msg, fields, 2)

info = (msg: str, fields: any)
    emit(M.LV_INFO, msg, fields, 2)

warn = (msg: str, fields: any)
    emit(M.LV_WARN, msg, fields, 2)

error = (msg: str, fields: any)
    emit(M.LV_ERROR, msg, fields, 2)

fatal = (msg: str, fields: any)
    emit(M.LV_FATAL, msg, fields, 2)

# ─── Spans ────────────────────────────────────────────────────────
span: any = (name: str, fields: any)
    h = {
        name = name or "span",
        start = os.clock(),
        depth = trace_spans:len() + 1,
    }
    trace_spans[trace_spans:len() + 1] = h
    ind = dim(M.G_PIPE .. " ":rep(h.depth - 1))
    parts = {}
    parts[parts:len() + 1] = magenta(M.G_SPAN_BEGIN)
    parts[parts:len() + 1] = sem_identity(name or "span")
    parts[parts:len() + 1] = dim(M.G_ARROW)
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    if trace_show_caller
        c = caller(2)
        if c != ""
            parts[parts:len() + 1] .. dim("(") .. c .. dim(")")
    parts[parts:len() + 1] = ind
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[parts:len() + 1] = pretty_kv(k, v)
    print(parts:concat(" "))
    return h

span_end = (h: any, fields: any)
    if h == nil return 
    n = trace_spans:len()
    while n > 0
        if trace_spans[n] == h
            trace_spans:remove(n)
            break
        n -= 1
    dur_s = os.clock() - h.start
    dur_ms = dur_s * 1000
    dur_str = _fmt_dur(dur_ms)
    ind = dim(M.G_PIPE .. " ":rep((h.depth - 1)))
    parts = {}
    parts[parts:len() + 1] = magenta(M.G_SPAN_END)
    parts[parts:len() + 1] = italic(h.name)
    parts[parts:len() + 1] = dim(M.G_DUR)
    parts[parts:len() + 1] = dur_str
    parts[parts:len() + 1] = ind
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[parts:len() + 1] = pretty_kv(k, v)
    print(parts:concat(" "))

# ─── Assertion / check helpers ────────────────────────────────────

assert_ok = (condition: bool, msg: str)
    if condition
        print(sem_success(M.G_CHECK .. " " .. to(str)(msg or "ok")))
    else
        print(sem_failure(M.G_CROSS_MARK .. " " .. to(str)(msg or "assertion failed")))

assert_eq = (actual: any, expected: any, msg: str)
    if actual == expected
        print(sem_success(M.G_CHECK .. " " .. to(str)(msg or "eq")))
    else
        parts = {}
        parts[parts:len() + 1] = sem_failure(M.G_CROSS_MARK .. " " .. to(str)(msg or "eq"))
        parts[parts:len() + 1] = dim("expected")
        parts[parts:len() + 1] = sem_changed_new(pretty_val(expected))
        parts[parts:len() + 1] = dim("got")
        parts[parts:len() + 1] = sem_changed_old(pretty_val(actual))
        print(parts:concat(" "))

# ─── Structured diff ──────────────────────────────────────────────

diff_line: str = (kind: str, key: str, old_val: any, new_val: any)
    prefix = ""
    line = ""
    if kind == "added"
        prefix = dim(green(M.G_PROPEL .. " "))
        line = sem_added("+" .. key) .. " " .. pretty_val(new_val)
    else if kind == "removed"
        prefix = dim(red(M.G_RETURN .. " "))
        line = sem_deleted("-" .. key) .. " " .. pretty_val(old_val)
    else if kind == "changed"
        prefix = dim(yellow(M.G_CROSS .. " "))
        line = sem_changed_old("-" .. key .. " " .. pretty_val(old_val)) ..
               "\n" .. dim("  ") ..
               sem_changed_new("+" .. key .. " " .. pretty_val(new_val))
    else
        prefix = dim(M.G_DOT .. " ")
        line = sem_context_line(key .. " " .. pretty_val(old_val))
    return prefix .. line

print_diff = (label: str, diffs: any)
    if label == nil label = "diff" 
    n = diffs:len()
    if n == 0
        print(sem_success(M.G_CHECK .. " " .. bold(label) .. " " .. dim("— no differences")))
        return
    print(sem_diff_hunk(M.BOX_TL .. M.G_DIAMOND .. " " .. bold(label) ..
          " " .. dim(M.G_DASH) .. dim(M.G_DASH:rep(38))))
    i = 1
    while i <= n
        d = diffs[i]
        print(M.BOX_V .. " " .. diff_line(d.kind, d.path, d.old, d.new))
        i += 1
    print(dim(M.BOX_BL .. M.G_DASH:rep(50)))
    print(dim("  " .. n:to(str) .. " difference(s)"))

# ─── Checkpoint / milestone markers ───────────────────────────────

checkpoint = (label: str)
    ind = span_indent()
    parts = {}
    parts[parts:len() + 1] = ind
    parts[parts:len() + 1] = sem_constant(M.G_SNAPSHOT)
    parts[parts:len() + 1] = sem_payload(to(str)(label or "checkpoint"))
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    if trace_show_caller
        c = caller(2)
        if c != ""
            parts[parts:len() + 1] = dim("(") .. c .. dim(")")
    print(parts:concat(" "))

milestone = (label: str, value: any)
    ind = span_indent()
    parts = {}
    parts[parts:len() + 1] = ind
    parts[parts:len() + 1] = sem_constant(M.G_STAR)
    parts[parts:len() + 1] = sem_identity(to(str)(label or "milestone"))
    if value != nil
        parts[parts:len() + 1] = dim(M.G_ARROW)
        parts[parts:len() + 1] = pretty_val(value)
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    print(parts:concat(" "))

# ─── Variable watch ───────────────────────────────────────────────

watch = (name: str, value: any)
    ind = span_indent()
    parts = {}
    parts[parts:len() + 1] = ind
    parts[parts:len() + 1] = dim(M.G_SEED)
    parts[parts:len() + 1] = sem_key(name:to(str))
    parts[parts:len() + 1] = dim("→")
    parts[parts:len() + 1] = pretty_val(value)
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    print(parts:concat(" "))

# ─── Event timeline entry ────────────────────────────────────────

event = (name: str, fields: any)
    ind = span_indent()
    parts = {}
    parts[parts:len() + 1] = ind
    parts[parts:len() + 1] = sem_type(M.G_PROPEL .. " " .. name:to(str))
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[parts:len() + 1] = pretty_kv(k, v)
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    print(parts:concat(" "))

# ─── Section / divider helpers ────────────────────────────────────

banner = (title: str, subtitle: str)
    if title == nil title = "trace" 
    if tty()
        w = 50
        title_len = title:len()
        pad = w - title_len - 4
        if pad < 2 pad = 2 
        print(sem_banner_line(M.BOX_TL .. M.BOX_H:rep(2) .. " " .. title .. " " ..
              M.BOX_H:rep(pad) .. M.BOX_TR))
        if subtitle != nil and subtitle != ""
            print(dim(M.BOX_V .. "  " .. subtitle .. " ":rep(w - 2 - subtitle:len()) .. M.BOX_V))
        print(dim(M.BOX_BL .. M.BOX_H:rep(w) .. M.BOX_BR))
    else
        print("=== " .. title .. " ===")
        if subtitle != nil and subtitle != ""
            print("    " .. subtitle)

divider = ()
    print(span_indent() .. dim(M.BOX_H:rep(60)))

double_divider = ()
    print(span_indent() .. dim("═":rep(60)))

section = (title: str)
    ind = span_indent()
    w = 50
    title_len = title:len()
    pad = w - title_len - 3
    if pad < 2 pad = 2 
    print(ind .. dim(" ") .. sem_banner_line(M.G_DIAMOND .. " " .. title) ..
          dim(" " .. M.BOX_H:rep(pad)))

# ─── Legend ───────────────────────────────────────────────────────

legend = ()
    print(bold(italic("trace legend:")))
    print("")
    print("  " .. level_tag(M.LV_TRACE) .. "  " .. dim("fine-grained, usually off"))
    print("  " .. level_tag(M.LV_DEBUG) .. "  " .. dim("development detail"))
    print("  " .. level_tag(M.LV_INFO)  .. "  " .. dim("general progress"))
    print("  " .. level_tag(M.LV_WARN)  .. "  " .. dim("something suspicious"))
    print("  " .. level_tag(M.LV_ERROR) .. "  " .. dim("failure, recoverable"))
    print("  " .. level_tag(M.LV_FATAL) .. "  " .. dim("unrecoverable"))
    print("")
    print("  " .. M.G_SPAN_BEGIN .. "/" .. M.G_SPAN_END ..
          " " .. dim("span begin/end    ") .. M.G_DUR .. " measured duration")
    print("  " .. M.G_SNAPSHOT .. " checkpoint    " ..
          M.G_STAR .. " milestone    " .. M.G_SEED .. " watch    " ..
          M.G_PROPEL .. " event")
    print("")
    print("  " .. bold("bold") .. " = essential payload    " ..
          italic("italic") .. " = identity / type    " ..
          dim("dim") .. " = ancillary meta")
    print("  " .. underline("underline") .. " = location / field key    " ..
          strikethrough("strikethrough") .. " = deleted / deprecated    " ..
          reverse("reverse") .. " = attention")
    print("")
    print("  " .. sem_success("success") .. "    " ..
          sem_failure("failure") .. "    " ..
          sem_caution("caution") .. "    " ..
          sem_hex("0xDEAD") .. " hex    " ..
          sem_"1.2MB":len() .. " size    " ..
          sem_percent("87.5%") .. " percent")
    print("")
    print("  " .. sem_time_fast("<1ms") .. " fast    " ..
          sem_time_normal("~8ms") .. " normal    " ..
          sem_time_slow(">16ms") .. " slow    " ..
          "color = severity + Lua type class")
    print("")
    print("  value types: " ..
          sem_string_val('"string"') .. "  " ..
          sem_number_val("42") .. "  " ..
          sem_bool_val("true") .. "  " ..
          sem_nil("nil") .. "  " ..
          sem_table_val("{…}") .. "  " ..
          sem_function_val("⟪fn⟫"))

# ─── Recursive pretty printer for dump() ───────────────────────────
_seen: bool = (seen: any, value: any)
    if seen == nil return false 
    i = 1
    n = seen:len()
    while i <= n
        if seen[i] == value return true 
        i += 1
    return false

_seen_add = (seen: any, value: any)
    seen[seen:len() + 1] = value

pretty_repr: str = (value: any, depth: int, seen: any)
    if depth == nil depth = 0 
    if seen == nil seen = {} 
    if value == nil return "nil" 
    t = type(value)
    if t:find("string") == 1
        return '"' .. to(str)(value) .. '"'
    else if t:find("number") == 1
        return value:to(str)
    else if t:find("boolean") == 1
        return value:to(str)
    else if t:find("function") == 1
        return "<function>"
    else if t:find("table") != 1
        return value:to(str)
    if _seen(seen, value) return "<circular>" 
    _seen_add(seen, value)
    n = value:len()
    parts = {}
    if n > 0
        i = 1
        while i <= n
            parts[parts:len() + 1] = "  ":rep(depth + 1) ..
                pretty_repr(value[i], depth + 1, seen)
            i += 1
        if parts:len() <= 3
            return "[" .. parts:concat(", ") .. "]"
        return "[\n" .. parts:concat(",\n") .. "\n" ..
            "  ":rep(depth) .. "]"
    for k, v in value
        parts[parts:len() + 1] = "  ":rep(depth + 1) ..
            k:to(str) .. " = " .. pretty_repr(v, depth + 1, seen)
    if parts:len() == 0 return "{}" 
    return "{\n" .. parts:concat("\n") .. "\n" ..
        "  ":rep(depth) .. "}"

dump = (label: str, value: any)
    if label == nil label = "dump" 
    ind = span_indent()
    header = ind .. cyan(M.G_BULLET) .. " " .. bold(label) ..
        dim(" ⟜ ") .. pretty_val(value)
    print(header)
    if value != nil and type(value) == "table"
        rendered = pretty_repr(value, 1, nil)
        i = 1
        n = rendered:len()
        line_start = 1
        line_num = 1
        while i <= n
            ch = rendered:sub(i, i)
            if ch == "\n"
                seg = rendered:sub(line_start, i - 1)
                if seg != ""
                    print(dim(M.BOX_V .. " ") .. sem_numbering(line_num:to(str) .. " ") .. cyan(seg))
                    line_num += 1
                line_start = i + 1
            i += 1
        if line_start <= n
            print(dim(M.BOX_V .. " ") .. sem_numbering(line_num:to(str) .. " ") ..
                  cyan(rendered:sub(line_start)))

# ─── Compact value table ──────────────────────────────────────────

table_print = (label: str, t: any)
    if t == nil or type(t) != "table"
        dump(label, t)
        return
    ind = span_indent()
    n = t:len()
    if n > 0
        print(ind .. bold(label) .. dim(" [" .. n:to(str) .. " items]"))
        i = 1
        while i <= n
            print(ind .. dim(M.G_PIPE .. " ") .. sem_numbering(i:to(str) .. " ") .. pretty_val(t[i]))
            i += 1
    else
        print(ind .. bold(label) .. dim(" {"))
        for k, v in t
            print(ind .. dim(M.G_PIPE .. " ") .. sem_key(k:to(str)) ..
                  dim(" = ") .. pretty_val(v))
        print(ind .. dim("}"))

