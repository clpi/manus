M.span = span
M.span_end = span_end
M.banner = banner
M.divider = divider
M.double_divider = double_divider
M.section = section
M.legend = legend
M.dump = dump
M.table_print = table_print
M.assert_ok = assert_ok
M.assert_eq = assert_eq
M.print_diff = print_diff
M.diff_line = diff_line
M.checkpoint = checkpoint
M.milestone = milestone
M.watch = watch
M.event = event
M.fmt_hex = fmt_hex
M.fmt_size = fmt_size
M.fmt_pct = fmt_pct
M.fmt_count = fmt_count
M.fmt_bool = fmt_bool
M.fmt_nil = fmt_nil
M.fmt_ref = fmt_ref
M.fmt_path = fmt_path
M.pretty_val = pretty_val
M.pretty_kv = pretty_kv
M.LV_TRACE = M.LV_TRACE
M.LV_DEBUG = M.LV_DEBUG
M.LV_INFO  = M.LV_INFO
M.LV_WARN  = M.LV_WARN
M.LV_ERROR = M.LV_ERROR
M.LV_FATAL = M.LV_FATAL

M
