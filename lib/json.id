

empty_object = {}

is_array: bool = (t: any)
    if type(t) != "table" return false
    for k, _ in t
        if type(k) != "number" return false
        if k < 1 return false
    true

escape: str = (s: any)
    if s == nil return ""
    out = {}
    n = s:len()
    i = 1
    hex = "0123456789abcdef"
    while i <= n
        b = s:byte(i)
        if b == 34
            on = on + 1
            out[on] = "\\\""
        else(b == 92)
            on = on + 1
            out[on] = "\\\\"
        else(b == 10)
            on = on + 1
            out[on] = "\\n"
        else(b == 13)
            on = on + 1
            out[on] = "\\r"
        else(b == 9)
            on = on + 1
            out[on] = "\\t"
        else(b == 8)
            on = on + 1
            out[on] = "\\b"
        else(b == 12)
            on = on + 1
            out[on] = "\\f"
        else(b < 32)
            hi = b / 16:floor() + 1
            lo = (b % 16) + 1
            on = on + 1
            out[on] = "\\u00" .. hex:sub(hi, hi) .. hex:sub(lo, lo)
        else
            on = on + 1
            out[on] = s:sub(i, i)
        i += 1
    out:concat()

encode: str = (val: any)
    if val == nil return "null"
    if type(val) == "boolean"
        if val return "true" else return "false"
    if type(val) == "number"
        if val != val return "null"
        if val == math.huge return "1e999"
        if val == -math.huge return "-1e999"
        return val:to(str)
    if type(val) == "string"
        return "\"" .. escape(val) .. "\""
    if type(val) == "table"
        if val == empty_object return "\{\}"
        if is_array(val)
            parts = {}
            pn = 0
            i = 1
            while val[i] != nil
                pn = pn + 1
                parts[pn] = encode(val[i])
                i += 1
            return "[" .. parts:concat(",") .. "]"
        parts = {}
        pn = 0
        for k, v in val
            if type(k) == "string"
                pn = pn + 1
                parts[pn] = encode(k) .. ":" .. encode(v)
        return "\{" .. parts:concat(",") .. "\}"
    "null"




skip(cur: any)
    s = cur.s
    n = s:len()
    while cur.i <= n
        b = s:byte(cur.i)
        if b == 32 or b == 9 or b == 10 or b == 13
            cur.i = cur.i + 1
        else
            break

json_hex4: i64 = (s)
    v = 0
    i = 1
    while i <= 4
        b = s:byte(i)
        d = 0
        if b >= 48 and b <= 57
            d = b - 48
        else(b >= 65 and b <= 70)
            d = b - 55
        else(b >= 97 and b <= 102)
            d = b - 87
        v = v * 16 + d
        i += 1
    v

json_utf8_char(cp): str
    if cp < 128
        return cp:char()
    if cp < 2048
        b1 = cp / 64:floor() + 192
        b2 = (cp % 64) + 128
        return b1:char() .. b2:char()
    b1 = cp / 4096:floor() + 224
    b2 = (cp % 4096) / 64:floor() + 128
    b3 = (cp % 64) + 128
    return b1:char() .. b2:char() .. b3:char()

json_string: any = (cur)
    cur.i = cur.i + 1
    s = cur.s
    n = s:len()
    out = {}
    on = 0
    while cur.i <= n
        b = s:byte(cur.i)
        if b == 34
            cur.i = cur.i + 1
            return out:concat()
        if b == 92
            cur.i = cur.i + 1
            e = s:byte(cur.i)
            if e == 110
                on = on + 1
                out[on] = "\n"
            else(e == 116)
                on = on + 1
                out[on] = "\t"
            else(e == 114)
                on = on + 1
                out[on] = "\r"
            else(e == 34)
                on = on + 1
                out[on] = "\""
            else(e == 92)
                on = on + 1
                out[on] = "\\"
            else(e == 47)
                on = on + 1
                out[on] = "/"
            else(e == 98)
                on = on + 1
                out[on] = 8:char()
            else(e == 102)
                on = on + 1
                out[on] = 12:char()
            else(e == 117)
                hex = s:sub(cur.i + 1, cur.i + 4)
                cp = json_hex4(hex)
                on = on + 1
                out[on] = json_utf8_char(cp)
                cur.i = cur.i + 4
            else
                on = on + 1
                out[on] = e:char()
            cur.i = cur.i + 1
        else
            start = cur.i
            cur.i = cur.i + 1
            while cur.i <= n
                b2 = s:byte(cur.i)
                if b2 == 34 or b2 == 92 break
                cur.i = cur.i + 1
            on = on + 1
            out[on] = s:sub(start, cur.i - 1)
    out:concat()

json_number: any = (cur)
    s = cur.s
    start = cur.i
    n = s:len()
    while cur.i <= n
        b = s:byte(cur.i)
        if (b >= 48 and b <= 57) or b == 45 or b == 43 or b == 46 or b == 101 or b == 69
            cur.i = cur.i + 1
        else
            break
    num_str = s:sub(start, cur.i - 1)
    num_str:to(i64)

json_value: any = (cur)
    skip(cur)
    s = cur.s
    if cur.i > s:len() return nil
    b = s:byte(cur.i)
    if b == 123
        cur.i = cur.i + 1
        obj = {}
        skip(cur)
        if cur.s:byte(cur.i) == 125
            cur.i = cur.i + 1
            return obj
        while true
            skip(cur)
            key = json_string(cur)
            skip(cur)
            cur.i = cur.i + 1
            val = json_value(cur)
            obj[key] = val
            skip(cur)
            b2 = cur.s:byte(cur.i)
            if b2 == 44
                cur.i = cur.i + 1
            else(b2 == 125)
                cur.i = cur.i + 1
                break
            else
                break
        return obj
    if b == 91
        cur.i = cur.i + 1
        arr = {}
        arrn = 0
        skip(cur)
        if cur.s:byte(cur.i) == 93
            cur.i = cur.i + 1
            return arr
        while true
            val = json_value(cur)
            arrn += 1
            arr[arrn] = val
            skip(cur)
            b2 = cur.s:byte(cur.i)
            if b2 == 44
                cur.i = cur.i + 1
            else(b2 == 93)
                cur.i = cur.i + 1
                break
            else
                break
        return arr
    if b == 34
        return json_string(cur)
    if b == 116
        cur.i = cur.i + 4
        return true
    if b == 102
        cur.i = cur.i + 5
        return false
    if b == 110
        cur.i = cur.i + 4
        return nil
    json_number(cur)

decode: any = (s: str)
    if s == nil or s == "" return nil
    cur = {}
    cur.s = s
    cur.i = 1
    skip(cur)
    json_value(cur)

