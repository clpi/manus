
global log_level = 1
global log_levels = { DEBUG = 0, INFO = 1, WARN = 2, ERROR = 3 }

set_level = (level: str)
  if level == nil
    level = "DEBUG"
  v = log_levels[level]
  if v != nil
    log_level = v

get_level: str = ()
  for name, v in log_levels
    if v == log_level
      return name
  "INFO"

debug = (msg: str)
  if log_level <= 0
    stdout:write("[DEBUG] %s\n":format(msg))

info = (msg: str)
  if log_level <= 1
    stdout:write("[INFO] %s\n":format(msg))

warn = (msg: str)
  if log_level <= 2
    stdout:write("[WARN] %s\n":format(msg))

error = (msg: str)
  if log_level <= 3
    stdout:write("[ERROR] %s\n":format(msg))

print = (level: str, msg: str)
  if level == nil
    stdout:write("%s\n":format(msg))
  else
    stdout:write("[%s] %s\n":format(level:upper(), msg))

with_fields = (level: str, fields: any, msg: str)
  if level == nil
    level = "INFO"
  level_val = log_levels(level:upper()) or 1
  if level_val < log_level
    return
  parts = { "[%s] %s":format(level:upper(), msg) }
  if fields != nil
    for k, v in fields
      parts[parts:len() + 1] = "%s=%s":format(k, v:to(str))
  stdout:write(parts:concat(" ") .. "\n")
