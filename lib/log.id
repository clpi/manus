# log — structured logging with level filtering

global log_level = 1
global log_levels = { DEBUG = 0, INFO = 1, WARN = 2, ERROR = 3 }

set_level: void = (level: str)
  if level == nil
    level = "DEBUG"
  v = log_levels[level]
  if v != nil
    log_level = v

get_level: str = ()
  for name, v in log_levels
    if v == log_level
      return name
  "INFO"

debug: void = (msg: str)
  if log_level <= 0
    io:write("[DEBUG] %s\n":format(msg))

info: void = (msg: str)
  if log_level <= 1
    io:write("[INFO] %s\n":format(msg))

warn: void = (msg: str)
  if log_level <= 2
    io:write("[WARN] %s\n":format(msg))

error: void = (msg: str)
  if log_level <= 3
    io:write("[ERROR] %s\n":format(msg))

print: void = (level: str, msg: str)
  if level == nil
    io:write("%s\n":format(msg))
  else
    io:write("[%s] %s\n":format(level:upper(), msg))

with_fields: void = (level: str, fields: any, msg: str)
  if level == nil
    level = "INFO"
  level_val = log_levels[level:upper()] or 1
  if level_val < log_level
    return
  parts = { "[%s] %s":format(level:upper(), msg) }
  if fields != nil
    for k, v in fields
      parts[parts:len() + 1] = "%s=%s":format(k, v:to(str))
  io:write(parts:concat(" ") .. "\n")
