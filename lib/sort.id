# std.sort — sorting utilities (mirrors Go's sort package)
# Provides generic sort, stable sort, binary search, and convenience wrappers
# for ascending/descending order on homogeneous array-like tables.

# Insertion sort for small ranges (stable).
insertion(arr: any, lo: any, hi: any, less: any): void
    i = lo + 1
    while i <= hi
        key = arr[i]
        j = i
        while j > lo and less(key, arr[j - 1])
            arr[j] = arr[j - 1]
            j -= 1
        end
        arr[j] = key
        i += 1
    end
end

# Median-of-three pivot selection.
median3(arr: any, lo: any, hi: any, less: any): any
    mid = lo + (hi - lo) / 2
    if less(arr[mid], arr[lo])
        tmp = arr[lo]
        arr[lo] = arr[mid]
        arr[mid] = tmp
    end
    if less(arr[hi], arr[lo])
        tmp = arr[lo]
        arr[lo] = arr[hi]
        arr[hi] = tmp
    end
    if less(arr[hi], arr[mid])
        tmp = arr[mid]
        arr[mid] = arr[hi]
        arr[hi] = tmp
    end
    arr[mid]
end

# Partition for quicksort (Lomuto scheme).
partition(arr: any, lo: any, hi: any, less: any): any
    pivot = median3(arr, lo, hi, less)
    # move pivot to hi-1
    tmp = arr[hi - 1]
    arr[hi - 1] = arr[lo + (hi - lo) / 2]
    arr[lo + (hi - lo) / 2] = tmp
    pivot = arr[hi - 1]
    i = lo
    j = hi - 1
    while true
        i += 1
        while less(arr[i], pivot) do i += 1 end
        j -= 1
        while less(pivot, arr[j]) do j -= 1 end
        if i >= j break end
        tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
    end
    # place pivot
    tmp = arr[i]
    arr[i] = arr[hi - 1]
    arr[hi - 1] = tmp
    i
end

# Introsort-style quicksort with insertion-sort cutoff.
quicksort(arr: any, lo: any, hi: any, less: any): void
    while hi - lo > 24
        p = partition(arr, lo, hi, less)
        if p - lo < hi - p
            quicksort(arr, lo, p - 1, less)
            lo = p + 1
        else
            quicksort(arr, p + 1, hi, less)
            hi = p - 1
        end
    end
    if hi - lo > 1
        insertion(arr, lo, hi, less)
    end
end

# sort: sort the array portion of `arr` in-place using `less` comparator.
# less(a, b) should return true when a should come before b.
sort(arr: any, less: any): void
    if arr == nil return end
    n = arr:len()
    if n < 2 return end
    quicksort(arr, 1, n, less)
end

# stable: sort stably (insertion sort, O(n^2) but correct for all inputs).
stable(arr: any, less: any): void
    if arr == nil return end
    n = arr:len()
    if n < 2 return end
    insertion(arr, 1, n, less)
end

# Ascending integer sort.
asc(a: any, b: any): bool
    return a < b
end

# Descending integer sort.
desc(a: any, b: any): bool
    return a > b
end

ints(arr: any): void
    if arr == nil return end
    n = arr:len()
    if n < 2 return end
    quicksort(arr, 1, n, asc)
end

intdesc(arr: any): void
    if arr == nil return end
    n = arr:len()
    if n < 2 return end
    quicksort(arr, 1, n, desc)
end

sless(a: any, b: any): bool
    return a:to(str) < b:to(str)
end

strings(arr: any): void
    if arr == nil return end
    n = arr:len()
    if n < 2 return end
    quicksort(arr, 1, n, sless)
end

# sorted: returns true if arr is sorted according to less.
sorted(arr: any, less: any): bool
    if arr == nil return true end
    n = arr:len()
    i = 2
    while i <= n
        if less(arr[i], arr[i - 1]) return false end
        i += 1
    end
    true
end

# search: binary search for the smallest index i in [lo, hi) where f(i) is true.
search(n: any, f: any): any
    lo = 0
    hi = n
    while lo < hi
        mid = lo + (hi - lo) / 2
        if f(mid + 1)
            hi = mid
        else
            lo = mid + 1
        end
    end
    lo
end

# bsearch: binary search for value v in a sorted arr.
# Returns 1-based index or -1. Uses iterative search (no closures).
bsearch(arr: any, v: any, less: any): any
    if arr == nil return 0 - 1 end
    n = arr:len()
    lo = 0
    hi = n
    while lo < hi
        mid = lo + (hi - lo) / 2
        if less(v, arr[mid + 1])
            hi = mid
        elseif less(arr[mid + 1], v)
            lo = mid + 1
        else
            return mid + 1
        end
    end
    0 - 1
end

# reverse: reverse the array portion of arr in-place.
reverse(arr: any): void
    if arr == nil return end
    n = arr:len()
    i = 1
    j = n
    while i < j
        tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
        i += 1
        j -= 1
    end
end

# swap: swap two indices.
swap(arr: any, i: any, j: any): void
    tmp = arr[i]
    arr[i] = arr[j]
    arr[j] = tmp
end

# slice: sort a sub-range [from, to] of arr.
slice(arr: any, from: any, to: any, less: any): void
    if arr == nil return end
    if from < 1 from = 1 end
    if to > arr:len() to = arr:len() end
    if to - from < 1 return end
    quicksort(arr, from, to, less)
end
