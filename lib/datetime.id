# std.datetime — date and time parsing, formatting, and arithmetic
# Uses Lua's os.date/os.time as the underlying engine.
# A datetime is a table: {year, month, day, hour, min, sec, wday, yday, isdst}

# ---- Constants ----

global DT_MONTH_NAMES = {}
DT_MONTH_NAMES[1] = "January"
DT_MONTH_NAMES[2] = "February"
DT_MONTH_NAMES[3] = "March"
DT_MONTH_NAMES[4] = "April"
DT_MONTH_NAMES[5] = "May"
DT_MONTH_NAMES[6] = "June"
DT_MONTH_NAMES[7] = "July"
DT_MONTH_NAMES[8] = "August"
DT_MONTH_NAMES[9] = "September"
DT_MONTH_NAMES[10] = "October"
DT_MONTH_NAMES[11] = "November"
DT_MONTH_NAMES[12] = "December"

global DT_MONTH_ABBR = {}
DT_MONTH_ABBR[1] = "Jan"
DT_MONTH_ABBR[2] = "Feb"
DT_MONTH_ABBR[3] = "Mar"
DT_MONTH_ABBR[4] = "Apr"
DT_MONTH_ABBR[5] = "May"
DT_MONTH_ABBR[6] = "Jun"
DT_MONTH_ABBR[7] = "Jul"
DT_MONTH_ABBR[8] = "Aug"
DT_MONTH_ABBR[9] = "Sep"
DT_MONTH_ABBR[10] = "Oct"
DT_MONTH_ABBR[11] = "Nov"
DT_MONTH_ABBR[12] = "Dec"

global DT_DAY_NAMES = {}
DT_DAY_NAMES[1] = "Sunday"
DT_DAY_NAMES[2] = "Monday"
DT_DAY_NAMES[3] = "Tuesday"
DT_DAY_NAMES[4] = "Wednesday"
DT_DAY_NAMES[5] = "Thursday"
DT_DAY_NAMES[6] = "Friday"
DT_DAY_NAMES[7] = "Saturday"

global DT_DAY_ABBR = {}
DT_DAY_ABBR[1] = "Sun"
DT_DAY_ABBR[2] = "Mon"
DT_DAY_ABBR[3] = "Tue"
DT_DAY_ABBR[4] = "Wed"
DT_DAY_ABBR[5] = "Thu"
DT_DAY_ABBR[6] = "Fri"
DT_DAY_ABBR[7] = "Sat"

global DT_DAYS_PER_MONTH = {}
DT_DAYS_PER_MONTH[1] = 31
DT_DAYS_PER_MONTH[2] = 28
DT_DAYS_PER_MONTH[3] = 31
DT_DAYS_PER_MONTH[4] = 30
DT_DAYS_PER_MONTH[5] = 31
DT_DAYS_PER_MONTH[6] = 30
DT_DAYS_PER_MONTH[7] = 31
DT_DAYS_PER_MONTH[8] = 31
DT_DAYS_PER_MONTH[9] = 30
DT_DAYS_PER_MONTH[10] = 31
DT_DAYS_PER_MONTH[11] = 30
DT_DAYS_PER_MONTH[12] = 31

global SECS_PER_MINUTE = 60
global SECS_PER_HOUR = 3600
global SECS_PER_DAY = 86400
global SECS_PER_WEEK = 604800

# ---- Constructors ----
new(year: any, month: any, day: any, hour: any, min: any, sec: any): any
    d = {}
    d.year = year
    d.month = month
    d.day = day
    if hour != nil d.hour = hour else d.hour = 0 end
    if min != nil d.min = min else d.min = 0 end
    if sec != nil d.sec = sec else d.sec = 0 end
    d.wday = 0
    d.yday = 0
    d.isdst = false
    d
end

now(): any
    os.date("*t")
end

utc(): any
    os.date("!*t")
end

from_timestamp(ts: int): any
    os.date("*t", ts)
end

to_timestamp(d: any): int
    os.time(d)
end

# ---- Queries ----

is_leap_year(year: i64): bool
    if year % 400 == 0 return true end
    if year % 100 == 0 return false end
    if year % 4 == 0 return true end
    false
end

days_in_month(year: i64, month: i64): i64
    if month == 2 and is_leap_year(year) return 29 end
    DT_DAYS_PER_MONTH[month]
end

days_in_year(year: i64): i64
    if is_leap_year(year) return 366 end
    365
end

weekday_name(d: any): str
    DT_DAY_NAMES[d.wday]
end

weekday_abbr(d: any): str
    DT_DAY_ABBR[d.wday]
end

month_name(d: any): str
    DT_MONTH_NAMES[d.month]
end

month_abbr(d: any): str
    DT_MONTH_ABBR[d.month]
end

is_weekend(d: any): bool
    d.wday == 1 or d.wday == 7
end

# ---- Arithmetic ----

add(d: any, secs: int): any
    ts = os.time(d)
    os.date("*t", ts + secs)
end

add_days(d: any, n: i64): any
    add(d, n * SECS_PER_DAY)
end

add_hours(d: any, n: i64): any
    add(d, n * SECS_PER_HOUR)
end

add_minutes(d: any, n: i64): any
    add(d, n * SECS_PER_MINUTE)
end

add_months(d: any, n: i64): any
    total_month = d.month + n
    new_year = d.year + total_month / 12:floor()
    new_month = total_month % 12
    if new_month <= 0
        new_month += 12
        new_year -= 1
    end
    max_day = days_in_month(new_year, new_month)
    new_day = d.day
    if new_day > max_day new_day = max_day end
    r = {}
    r.year = new_year
    r.month = new_month
    r.day = new_day
    r.hour = d.hour
    r.min = d.min
    r.sec = d.sec
    r.wday = 0
    r.yday = 0
    r.isdst = false
    r
end

add_years(d: any, n: i64): any
    add_months(d, n * 12)
end

diff(a: any, b: any): int
    os.time(a) - os.time(b)
end

diff_days(a: any, b: any): i64
    diff(a, b) // SECS_PER_DAY
end

diff_hours(a: any, b: any): i64
    diff(a, b) // SECS_PER_HOUR
end

# ---- Formatting ----
dt_pad2(n: i64): str
    if n < 10 return "0" .. n:to(str) end
    n:to(str)
end

format(d: any, layout: str): str
    r = layout
    year4 = d.year:to(str)
    year2 = year4:sub(year4:len() - 1)
    r = r:gsub("YYYY", year4)
    r = r:gsub("YY", year2)
    r = r:gsub("MM", dt_pad2(d.month))
    r = r:gsub("DD", dt_pad2(d.day))
    r = r:gsub("HH", dt_pad2(d.hour))
    r = r:gsub("mm", dt_pad2(d.min))
    r = r:gsub("ss", dt_pad2(d.sec))
    r = r:gsub("WWW", DT_DAY_ABBR[d.wday])
    r = r:gsub("WWWW", DT_DAY_NAMES[d.wday])
    h12 = d.hour % 12
    if h12 == 0 h12 = 12 end
    r = r:gsub("hh", dt_pad2(h12))
    if d.hour < 12
        r = r:gsub("AMPM", "AM")
        r = r:gsub("ampm", "am")
    else
        r = r:gsub("AMPM", "PM")
        r = r:gsub("ampm", "pm")
    end
    r
end

iso8601(d: any): str
    format(d, "YYYY-MM-DDTHH:mm:ss")
end

date_only(d: any): str
    format(d, "YYYY-MM-DD")
end

time_only(d: any): str
    format(d, "HH:mm:ss")
end

rfc2822(d: any): str
    p = DT_DAY_ABBR[d.wday] .. ", "
    p = p .. d.day:to(str) .. " "
    p = p .. DT_MONTH_ABBR[d.month] .. " "
    p = p .. d.year:to(str) .. " "
    p = p .. dt_pad2(d.hour) .. ":"
    p = p .. dt_pad2(d.min) .. ":"
    p = p .. dt_pad2(d.sec) .. " +0000"
    p
end

human_relative(d: any): str
    secs = diff(now(), d)
    future = false
    if secs < 0
        secs = 0 - secs
        future = true
    end
    if secs < 60 return "just now" end
    if secs < 3600
        mins = secs / 60:floor()
        if future return "in " .. mins:to(str) .. " minutes" end
        return mins:to(str) .. " minutes ago"
    end
    if secs < 86400
        hrs = secs / 3600:floor()
        if future return "in " .. hrs:to(str) .. " hours" end
        return hrs:to(str) .. " hours ago"
    end
    day_count = secs / 86400:floor()
    if day_count == 1
        if future return "tomorrow" end
        return "yesterday"
    end
    if day_count < 30
        if future return "in " .. day_count:to(str) .. " days" end
        return day_count:to(str) .. " days ago"
    end
    months = day_count / 30:floor()
    if months < 12
        if future return "in " .. months:to(str) .. " months" end
        return months:to(str) .. " months ago"
    end
    years = months / 12:floor()
    if future return "in " .. years:to(str) .. " years" end
    years:to(str) .. " years ago"
end

# ---- Parsing ----
# Parse helpers return two values via Duo multi-return.
# The codegen handles multi-return for direct call sites.
# We pre-declare variables so the codegen emits proper C declarations.

dt_parse_digit2(s: str, pos: any): any
    val = s:sub(pos, pos):to(i64) * 10 + s:sub(pos + 1, pos + 1):to(i64)
    return val, pos + 2
end

dt_parse_digit4(s: str, pos: any): any
    val = s:sub(pos, pos):to(i64) * 1000
    val += s:sub(pos + 1, pos + 1):to(i64) * 100
    val += s:sub(pos + 2, pos + 2):to(i64) * 10
    val += s:sub(pos + 3, pos + 3):to(i64)
    return val, pos + 4
end

parse_iso8601(s: str): any
    if s:len() < 10 return nil end
    year = 0
    pos = 1
    year, pos = dt_parse_digit4(s, 1)
    if s:sub(pos, pos) != "-" return nil end
    month = 0
    month, pos = dt_parse_digit2(s, pos + 1)
    if s:sub(pos, pos) != "-" return nil end
    day = 0
    day, pos = dt_parse_digit2(s, pos + 1)
    hour = 0
    minute = 0
    second = 0
    if s:len() >= pos + 2
        sep = s:sub(pos, pos)
        if sep == "T" or sep == " "
            hour, pos = dt_parse_digit2(s, pos + 1)
            if s:sub(pos, pos) == ":"
                minute, pos = dt_parse_digit2(s, pos + 1)
            end
            if s:sub(pos, pos) == ":"
                second, pos = dt_parse_digit2(s, pos + 1)
            end
        end
    end
    new(year, month, day, hour, minute, second)
end

parse_date(s: str): any
    parse_iso8601(s .. "T00:00:00")
end

parse_time(s: str): any
    hour = 0
    pos = 1
    hour, pos = dt_parse_digit2(s, 1)
    minute = 0
    second = 0
    if s:sub(pos, pos) == ":"
        minute, pos = dt_parse_digit2(s, pos + 1)
    end
    if s:sub(pos, pos) == ":"
        second, pos = dt_parse_digit2(s, pos + 1)
    end
    new(0, 1, 1, hour, minute, second)
end

# ---- Comparison ----

before(a: any, b: any): bool
    os.time(a) < os.time(b)
end

after(a: any, b: any): bool
    os.time(a) > os.time(b)
end

equal(a: any, b: any): bool
    os.time(a) == os.time(b)
end

min(a: any, b: any): any
    if before(a, b) return a end
    b
end

max(a: any, b: any): any
    if after(a, b) return a end
    b
end

# ---- Range & Truncation ----
start_of_day(d: any): any
    new(d.year, d.month, d.day, 0, 0, 0)
end

end_of_day(d: any): any
    new(d.year, d.month, d.day, 23, 59, 59)
end

start_of_month(d: any): any
    new(d.year, d.month, 1, 0, 0, 0)
end

end_of_month(d: any): any
    last_day = days_in_month(d.year, d.month)
    new(d.year, d.month, last_day, 23, 59, 59)
end

start_of_year(d: any): any
    new(d.year, 1, 1, 0, 0, 0)
end

end_of_year(d: any): any
    new(d.year, 12, 31, 23, 59, 59)
end

truncate(d: any, precision: str): any
    if precision == "hour"
        return new(d.year, d.month, d.day, d.hour, 0, 0)
    end
    if precision == "minute"
        return new(d.year, d.month, d.day, d.hour, d.min, 0)
    end
    d
end

