# thread — OS-level threading primitives
# Provides mutex, rwlock, condition variables, semaphore, barrier,
# thread spawning/joining, and thread-local storage.
# In single-threaded mode these use coroutine-based cooperative scheduling.
# When @concurrent("threaded") is enabled, they map to pthread.


# ─────────────────────────────────────────────────────────────
# Mutex: blocking mutual exclusion lock
# ─────────────────────────────────────────────────────────────

# Create a new mutex.  Initially unlocked.
mutex: any = ()
    {
        locked     = false,
        waiting    = {},  # suspended coroutines waiting to acquire
        holder     = nil, # the coroutine that currently holds the lock
    }

# Acquire the lock, blocking if already held.
lock = (m: any)
    if m.locked and m.holder == coroutine.running()
        return  # recursive: already owned
    while m.locked
        co = coroutine.running()
        m.waiting[m:len().waiting + 1] = co
        coroutine.yield()
    m.locked = true
    m.holder = coroutine.running()

# Try to acquire the lock without blocking.  Returns true on success.
probe: bool = (m: any)
    if m.locked and m.holder == coroutine.running()
        return true
    if m.locked return false 
    m.locked = true
    m.holder = coroutine.running()
    true

# Release the lock, waking one waiter if any.
unlock = (m: any)
    if m.holder != coroutine.running()
        error("thread: unlock called by non-owner")
    m.locked = false
    m.holder = nil
    if m:len().waiting > 0
        co = m.waiting:remove(1)
        sync.spawn(() coroutine.resume(co))

# ─────────────────────────────────────────────────────────────
# RwLock: readers-writer lock
# ─────────────────────────────────────────────────────────────

# Create a readers-writer lock.
rwlock: any = ()
    {
        readers    = 0,
        writing    = false,
        rwait      = {},  # readers waiting
        wwait      = {},  # writers waiting
        wholder    = nil,
    }

# Acquire for reading.  Multiple readers allowed; blocks if writing.
rlock = (rw: any)
    while rw.writing
        co = coroutine.running()
        rw.rwait[rw:len().rwait + 1] = co
        coroutine.yield()
    rw.readers = rw.readers + 1

# Release a read lock.
runlock = (rw: any)
    rw.readers = rw.readers - 1
    if rw.readers == 0 and rw:len().wwait > 0
        co = rw.wwait:remove(1)
        sync.spawn(() coroutine.resume(co))

# Acquire for writing.  Blocks if anyone holds the lock.
wlock = (rw: any)
    if rw.wholder == coroutine.running() return 
    while rw.writing or rw.readers > 0
        co = coroutine.running()
        rw.wwait[rw:len().wwait + 1] = co
        coroutine.yield()
    rw.writing = true
    rw.wholder = coroutine.running()

# Release a write lock.
wunlock = (rw: any)
    if rw.wholder != coroutine.running()
        error("thread: wunlock called by non-owner")
    rw.writing = false
    rw.wholder = nil
    if rw:len().wwait > 0
        co = rw.wwait:remove(1)
        sync.spawn(() coroutine.resume(co))
    elseif rw:len().rwait > 0
        for _, co in rw.rwait
            sync.spawn(() coroutine.resume(co))
        rw.rwait = {}

# ─────────────────────────────────────────────────────────────
# Condition variable
# ─────────────────────────────────────────────────────────────

# Create a condition variable associated with a mutex.
cond(m: any): any
    {
        guard  = m,
        waiting = {},
    }

# Wait on the condition (mutex must be held).  Atomically unlocks the
# mutex and suspends; re-acquires the lock before returning.
wait = (c: any)
    m = c.guard
    if m.holder != coroutine.running()
        error("thread: cond.wait without holding mutex")
    co = coroutine.running()
    c.waiting[c:len().waiting + 1] = co
    unlock(m)
    coroutine.yield()
    lock(m)

# Wake one waiter on the condition.
signal = (c: any)
    if c:len().waiting > 0
        co = c.waiting:remove(1)
        sync.spawn(() coroutine.resume(co))

# Wake all waiters on the condition.
broadcast = (c: any)
    for _, co in c.waiting
        sync.spawn(() coroutine.resume(co))
    c.waiting = {}

# ─────────────────────────────────────────────────────────────
# Once: run a function exactly once
# ─────────────────────────────────────────────────────────────

# Create a Once guard.
once: any = ()
    {
        done = false,
        guard   = mutex(),
    }

# Call fn exactly once; subsequent calls are no-ops.
run = (o: any, fn: any)
    lock(o.guard)
    if not o.done
        o.done = true
        unlock(o.guard)
        fn()
    else
        unlock(o.guard)

# ─────────────────────────────────────────────────────────────
# Semaphore
# ─────────────────────────────────────────────────────────────

# Create a counting semaphore with n permits.
semaphore: any = (n: i64)
    {
        permits = n,
        waiting = {},
        guard      = mutex(),
    }

# Acquire a permit, blocking if none available.
acquire = (s: any)
    lock(s.guard)
    while s.permits <= 0
        co = coroutine.running()
        s.waiting[s:len().waiting + 1] = co
        unlock(s.guard)
        coroutine.yield()
        lock(s.guard)
    s.permits = s.permits - 1
    unlock(s.guard)

# Try to acquire a permit without blocking.
probe: bool = (s: any)
    lock(s.guard)
    if s.permits > 0
        s.permits = s.permits - 1
        unlock(s.guard)
        return true
    unlock(s.guard)
    false

# Release a permit.
release = (s: any)
    lock(s.guard)
    s.permits = s.permits + 1
    if s:len().waiting > 0
        co = s.waiting:remove(1)
        sync.spawn(() coroutine.resume(co))
    unlock(s.guard)

# ─────────────────────────────────────────────────────────────
# Barrier: synchronize N threads at a point
# ─────────────────────────────────────────────────────────────

# Create a barrier for n participants.
barrier: any = (n: i64)
    {
        count   = n,
        total   = n,
        gen     = 0,
        guard      = mutex(),
        cond      = nil,  # will be set below
    }

# Wait at the barrier until all participants arrive.
wait = (b: any)
    if b.cond == nil
        b.cond = cond(b.guard)
    lock(b.guard)
    gen = b.gen
    b.count = b.count - 1
    if b.count == 0
        # Last one through: reset and wake everyone
        b.count = b.total
        b.gen = b.gen + 1
        broadcast(b.cond)
        unlock(b.guard)
        return
    # Wait until generation changes
    while b.gen == gen
        wait(b.cond)
    unlock(b.guard)

# ─────────────────────────────────────────────────────────────
# Thread spawning and joining
# ─────────────────────────────────────────────────────────────

# Spawn a function in a new thread.  Returns a thread handle.
# In cooperative mode this creates a coroutine and yields to the scheduler.
# In threaded mode this creates a real OS thread.
spawn: any = (fn: any, ...args)
    args = {args}
    chan = sync.channel(1)
    co = coroutine.create(()
        ok, result = pcall(fn, args:unpack())
        if ok
            chan:send({ok = true, val = result})
        else
            chan:send({ok = false, err = result})
    end)
    sync.spawn(() coroutine.resume(co))
    {
        co    = co,
        result = chan,
    }

# Wait for a thread to complete, returning its result.  Raises on error.
join: any = (h: any)
    r = h.result:recv()
    if r == nil return nil 
    if r.ok return r.val 
    error(r.err, 2)

# Detach a thread, allowing it to run independently.  Resources are
# released automatically when the thread finishes.
detach = (h: any)
    h.detached = true

# ─────────────────────────────────────────────────────────────
# Thread identity and introspection
# ─────────────────────────────────────────────────────────────

# Return a unique identifier for the current thread/coroutine.
id: i64 = ()
    co = coroutine.running()
    if co == nil return 0 
    # Hash the coroutine pointer for a stable id
    s = co:to(str)
    h = 5381
    for i = 1, s:len()
        h = (h * 33 + s:byte(i)) % 4294967296
    h

# Return the number of hardware threads available (for parallelism).
# In single-threaded mode, returns 1.
count: i64 = ()
    1

# Sleep the current thread for the given number of milliseconds.
# In cooperative mode this yields without rescheduling.
sleep = (ms: i64)
    # In cooperative mode, yield to let other tasks run
    sync.yield()

# Yield execution to the scheduler, allowing other threads to run.
yield = ()
    sync.yield()

# ─────────────────────────────────────────────────────────────
# Thread-safe wrapper around concurrent channels
# ─────────────────────────────────────────────────────────────

# Create a thread-safe channel.
channel: any = (capacity: i64)
    sync.channel(capacity)

send = (ch: any, val: any)
    ch:send(val)

recv: any = (ch: any)
    ch:recv()

peek: any = (ch: any)
    ch:peek()

close = (ch: any)
    ch:close()

# ─────────────────────────────────────────────────────────────
# Parallel execution helpers
# ─────────────────────────────────────────────────────────────

# Run the function for each element in parallel (cooperative by default).
# Returns a table of results in order.
each: any = (items: any, fn: any)
    handles = {}
    for _, item in items
        handles[handles:len() + 1] = spawn(fn, item)
    results = {}
    for _, h in handles
        results[results:len() + 1] = join(h)
    results

# Run the function n times in parallel (cooperative by default).
range: any = (n: i64, fn: any)
    handles = {}
    for i = 0, n - 1
        handles[handles:len() + 1] = spawn(fn, i)
    results = {}
    for _, h in handles
        results[results:len() + 1] = join(h)
    results

# ─────────────────────────────────────────────────────────────
# Thread-local storage
# ─────────────────────────────────────────────────────────────

# Internal registry keyed by thread/coroutine id
registry = {}
stores = {}
seed = 0

# Create a new thread-local key with an optional default value factory.
key: i64 = (default: any)
    seed += 1
    registry[seed] = default
    seed

# Set the value for a thread-local key in the current thread.
set = (key: i64, value: any)
    tid = to(str)(id())
    if stores == nil
        stores = {}
    if stores[tid] == nil
        stores[tid] = {}
    store = stores[tid]
    store[key] = value

# Get the value for a thread-local key in the current thread.
# If not set and a default was provided, initialises it.
get: any = (key: i64)
    tid = to(str)(id())
    store = stores and stores[tid] or nil
    if store != nil
        val = store[key]
        if val != nil return val 
    default = registry[key]
    if default != nil
        val = default()
        set(key, val)
        return val
    nil

# Remove the value for a thread-local key.  Returns the old value.
del: any = (key: i64)
    tid = to(str)(id())
    if stores == nil return nil 
    store = stores[tid]
    if store == nil return nil 
    val = store[key]
    store[key] = nil
    val

