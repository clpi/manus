


mutex: any = ()
    {
        locked     = false,
        waiting    = {},
        holder     = nil,
    }

lock = (m: any)
    if m.locked and m.holder == coroutine.running()
        return
    while m.locked
        co = coroutine.running()
        m.waiting[m.waiting:len() + 1] = co
        coroutine.yield()
    m.locked = true
    m.holder = coroutine.running()

probe: bool = (m: any)
    if m.locked and m.holder == coroutine.running()
        return true
    if m.locked return false 
    m.locked = true
    m.holder = coroutine.running()
    true

unlock = (m: any)
    if m.holder != coroutine.running()
        error("thread: unlock called by non-owner")
    m.locked = false
    m.holder = nil
    if m.waiting:len() > 0
        co = m.waiting:remove(1)
        sync.spawn(() coroutine.resume(co))


rwlock: any = ()
    {
        readers    = 0,
        writing    = false,
        rwait      = {},
        wwait      = {},
        wholder    = nil,
    }

rlock = (rw: any)
    while rw.writing
        co = coroutine.running()
        rw.rwait[rw.rwait:len() + 1] = co
        coroutine.yield()
    rw.readers = rw.readers + 1

runlock = (rw: any)
    rw.readers = rw.readers - 1
    if rw.readers == 0 and rw.wwait:len() > 0
        co = rw.wwait:remove(1)
        sync.spawn(() coroutine.resume(co))

wlock = (rw: any)
    if rw.wholder == coroutine.running() return 
    while rw.writing or rw.readers > 0
        co = coroutine.running()
        rw.wwait[rw.wwait:len() + 1] = co
        coroutine.yield()
    rw.writing = true
    rw.wholder = coroutine.running()

wunlock = (rw: any)
    if rw.wholder != coroutine.running()
        error("thread: wunlock called by non-owner")
    rw.writing = false
    rw.wholder = nil
    if rw.wwait:len() > 0
        co = rw.wwait:remove(1)
        sync.spawn(() coroutine.resume(co))
    else(rw.rwait:len() > 0)
        for _, co in rw.rwait
            sync.spawn(() coroutine.resume(co))
        rw.rwait = {}


cond(m: any): any
    {
        guard  = m,
        waiting = {},
    }

wait = (c: any)
    m = c.guard
    if m.holder != coroutine.running()
        error("thread: cond.wait without holding mutex")
    co = coroutine.running()
    c.waiting[c.waiting:len() + 1] = co
    unlock(m)
    coroutine.yield()
    lock(m)

signal = (c: any)
    if c.waiting:len() > 0
        co = c.waiting:remove(1)
        sync.spawn(() coroutine.resume(co))

broadcast = (c: any)
    for _, co in c.waiting
        sync.spawn(() coroutine.resume(co))
    c.waiting = {}


once: any = ()
    {
        done = false,
        guard   = mutex(),
    }

run = (o: any, fn: any)
    lock(o.guard)
    if not o.done
        o.done = true
        unlock(o.guard)
        fn()
    else
        unlock(o.guard)


semaphore: any = (n: i64)
    {
        permits = n,
        waiting = {},
        guard      = mutex(),
    }

acquire = (s: any)
    lock(s.guard)
    while s.permits <= 0
        co = coroutine.running()
        s.waiting[s.waiting:len() + 1] = co
        unlock(s.guard)
        coroutine.yield()
        lock(s.guard)
    s.permits = s.permits - 1
    unlock(s.guard)

probe: bool = (s: any)
    lock(s.guard)
    if s.permits > 0
        s.permits = s.permits - 1
        unlock(s.guard)
        return true
    unlock(s.guard)
    false

release = (s: any)
    lock(s.guard)
    s.permits = s.permits + 1
    if s.waiting:len() > 0
        co = s.waiting:remove(1)
        sync.spawn(() coroutine.resume(co))
    unlock(s.guard)


barrier: any = (n: i64)
    {
        count   = n,
        total   = n,
        gen     = 0,
        guard      = mutex(),
        cond      = nil,
    }

wait = (b: any)
    if b.cond == nil
        b.cond = cond(b.guard)
    lock(b.guard)
    gen = b.gen
    b.count = b.count - 1
    if b.count == 0
        b.count = b.total
        b.gen = b.gen + 1
        broadcast(b.cond)
        unlock(b.guard)
        return
    while b.gen == gen
        wait(b.cond)
    unlock(b.guard)


spawn: any = (fn: any, ...args)
    args = {args}
    chan = sync.channel(1)
    co = coroutine.create(()
        ok, result = pcall(fn, args:unpack())
        if ok
            chan:send({ok = true, val = result})
        else
            chan:send({ok = false, err = result})
    )
    sync.spawn(() coroutine.resume(co))
    {
        co    = co,
        result = chan,
    }

join: any = (h: any)
    r = h.result:recv()
    if r == nil return nil 
    if r.ok return r.val 
    error(r.err, 2)

detach = (h: any)
    h.detached = true


id: i64 = ()
    co = coroutine.running()
    if co == nil return 0 
    s = co:to(str)
    h = 5381
    for i = 1, s:len()
        h = (h * 33 + s:byte(i)) % 4294967296
    h

count: i64 = ()
    1

sleep = (ms: i64)
    sync.yield()

yield = ()
    sync.yield()


channel: any = (capacity: i64)
    sync.channel(capacity)

send = (ch: any, val: any)
    ch:send(val)

recv: any = (ch: any)
    ch:recv()

peek: any = (ch: any)
    ch:peek()

close = (ch: any)
    ch:close()


each: any = (items: any, fn: any)
    handles = {}
    for _, item in items
        handles[handles:len() + 1] = spawn(fn, item)
    results = {}
    for _, h in handles
        results[results:len() + 1] = join(h)
    results

range: any = (n: i64, fn: any)
    handles = {}
    for i = 0, n - 1
        handles[handles:len() + 1] = spawn(fn, i)
    results = {}
    for _, h in handles
        results[results:len() + 1] = join(h)
    results


registry = {}
stores = {}
seed = 0

key: i64 = (default: any)
    seed += 1
    registry[seed] = default
    seed

set = (key: i64, value: any)
    tid = to(str)(id())
    if stores == nil
        stores = {}
    if stores[tid] == nil
        stores[tid] = {}
    store = stores[tid]
    store[key] = value

get: any = (key: i64)
    tid = to(str)(id())
    store = stores and stores[tid] or nil
    if store != nil
        val = store[key]
        if val != nil return val 
    default = registry[key]
    if default != nil
        val = default()
        set(key, val)
        return val
    nil

del: any = (key: i64)
    tid = to(str)(id())
    if stores == nil return nil 
    store = stores[tid]
    if store == nil return nil 
    val = store[key]
    store[key] = nil
    val


