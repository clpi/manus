
escape: str = (s: str)
  s:gsub("[;&|`$(){}]", "")

mail: any = (addr: str, from: str, to: any, msg: str)
  if addr == nil or from == nil or to == nil or msg == nil
    return false, "missing arguments"
  from = escape(from)
  recipients = ""
  i = 1
  while i <= to:len()
    recipients = recipients .. " " .. escape(to[str](to[i]))
    i = i + 1
  cmd = "sendmail -f " .. from .. recipients
  f = io.popen(cmd .. " 2>&1", "w")
  if f == nil
    return false, "failed to start sendmail"
  f:write(msg)
  f:close()
  return true, nil

plain: any = (username: str, password: str)
  return { mechanism = "PLAIN", username = username, password = password }

send: any = (addr: str, auth: any, from: str, to: any, msg: str)
  if addr == nil or from == nil or to == nil or msg == nil
    return false, "missing arguments"
  host = addr
  port = 25
  colon = addr:find(":", 1, true)
  if colon != nil
    host = addr:sub(1, colon - 1)
    port = addr:sub(colon + 1):to[i64]
  host = escape(host)
  url = "smtp://" .. host .. ":" .. port:to[str]
  cmd = "curl -s --url " .. url
  if auth != nil and auth.username != nil
    user = escape(auth.username)
    pass = escape(auth.password)
    cmd = cmd .. " --user " .. user .. ":" .. pass
  from = escape(from)
  cmd = cmd .. " --mail-from " .. from
  i = 1
  while i <= to:len()
    cmd = cmd .. " --mail-rcpt " .. escape(to[str](to[i]))
    i = i + 1
  cmd = cmd .. " -T -"
  f = io.popen(cmd .. " 2>&1", "w")
  if f == nil
    return false, "failed to start curl"
  f:write(msg)
  result = f:close()
  return true, nil

message: str = (headers: any, body: str)
  if headers == nil
    headers = {}
  if body == nil
    body = ""
  out = {}
  for k, v in headers
    out(out:len() + 1) = k .. ": " .. v:to[str] .. "\r\n"
  out(out:len() + 1) = "\r\n"
  out(out:len() + 1) = body
  out:concat()
