# net.ws — WebSocket client and server (RFC 6455)
# Used by ward for real-time communication and the WASM runtime's debug protocol.

# ═══════════════════════════════════════════════════════════════
# WebSocket frame encoding/decoding
# ═══════════════════════════════════════════════════════════════

# Opcodes
OP_CONTINUATION = 0
OP_TEXT = 1
OP_BINARY = 2
OP_CLOSE = 8
OP_PING = 9
OP_PONG = 10

# Frame types
FRAME_TEXT = 1
FRAME_BINARY = 2
FRAME_CLOSE = 8
FRAME_PING = 9
FRAME_PONG = 10

# ═══════════════════════════════════════════════════════════════
# Base64 utilities (must be defined before use)
# ═══════════════════════════════════════════════════════════════

base64_encode: str = (data: any)
  chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  result = ""
  i = 1
  while i <= data:len()
    b0 = data(i)
    b1 = 0
    b2 = 0
    if i + 1 <= data:len()
      b1 = data(i + 1)
    if i + 2 <= data:len()
      b2 = data(i + 2)

triplet = b0 << 16 | b1 << 8 | b2
result = result .. chars:byte(triplet >> 18 & (63 + 1)):char()
result = result .. chars:byte(triplet >> 12 & (63 + 1)):char()
if i + 1 <= data:len()
  result = result .. chars:byte(triplet >> 6 & (63 + 1)):char()
else
  result = result .. "="
if i + 2 <= data:len()
  result = result .. chars:byte(triplet & (63 + 1)):char()
else
  result = result .. "="
i = i + 3
result

base64_sha1: str = (data: str)
  # WebSocket handshake requires base64(SHA-1(data + magic))
  sha1_hex = std.hash.sha1.sha1(data)
  # Convert hex string to bytes
  sha1_bytes = {}
  i = 1
  while i <= sha1_hex:len()
    hex_pair = sha1_hex:sub(i, i + 1)
    sha1_bytes(sha1_bytes:len() + 1) = tonumber(hex_pair, 16)
    i = i + 2
  base64_encode(sha1_bytes)

base64_encode_string: str = (s: str)
  bytes = {}
  i = 1
  while i <= s:len()
    bytes(bytes:len() + 1) = s:byte(i)
    i = i + 1
  base64_encode(bytes)

# ═══════════════════════════════════════════════════════════════
# Frame encoding
# ═══════════════════════════════════════════════════════════════

ws_encode_frame: any = (opcode: i64, payload: any, mask: bool)
  bytes = {}
  # First byte: FIN bit + opcode
  bytes(1) = 128 | opcode

  # Payload length
  len = payload:len()
  if len < 126
    bytes(2) = len
    if mask
      bytes(2) = bytes(2) | 128
  else(len < 65536)
    bytes(2) = 126
    if mask
      bytes(2) = bytes(2) | 128
    bytes(3) = len >> 8 & 255
    bytes(4) = len & 255
  else
    bytes(2) = 127
    if mask
      bytes(2) = bytes(2) | 128
    i = 0
    while i < 8
      bytes(3 + i) = len >> (56 - i * 8) & 255
      i = i + 1

  # Masking key (if client->server) using CSPRNG
  mask_key = nil
  if mask
    key_data = std.crypto.rand.bytes(4)
    mask_key = {}
    i = 1
    while i <= 4
      mask_key(i) = key_data:byte(i)
      bytes(bytes:len() + 1) = mask_key(i)
      i = i + 1

  # Payload
  i = 1
  while i <= payload:len()
    if mask
      bytes(bytes:len() + 1) = payload(i) ~ mask_key((i - 1) % 4 + 1)
    else
      bytes(bytes:len() + 1) = payload(i)
    i = i + 1

bytes

# ═══════════════════════════════════════════════════════════════
# Frame decoding
# ═══════════════════════════════════════════════════════════════

ws_decode_frame: any = (data: any, pos: i64)
  if pos > data:len()
    return nil

byte1 = data(pos)
byte2 = data(pos + 1)

fin = byte1 & 128 != 0
opcode = byte1 & 15
masked = byte2 & 128 != 0
payload_len = byte2 & 127

offset = pos + 2

# Extended payload length
if payload_len == 126
  payload_len = data(offset) << 8 | data(offset + 1)
  offset = offset + 2
else(payload_len == 127)
  payload_len = 0
  i = 0
  while i < 8
    payload_len = payload_len | data(offset + i) << (56 - i * 8)
    i = i + 1
  offset = offset + 8

# Masking key
mask_key = nil
if masked
  mask_key = { data(offset), data(offset + 1), data(offset + 2), data(offset + 3) }
  offset = offset + 4

# Payload
payload = {}
i = 0
while i < payload_len
  b = data(offset + i)
  if masked
    b = b ~ mask_key(i % 4)
  payload(payload:len() + 1) = b
  i = i + 1

{
  fin = fin,
  opcode = opcode,
  masked = masked,
  payload = payload,
  next = offset + payload_len
}

# ═══════════════════════════════════════════════════════════════
# WebSocket handshake (client side)
# ═══════════════════════════════════════════════════════════════

ws_client_handshake: str = (host: str, port: i64, path: str)
  # Generate random key (16 bytes base64 encoded) using CSPRNG
  key_bytes = {}
  key_data = std.crypto.rand.bytes(16)
  i = 1
  while i <= 16
    key_bytes(i) = key_data:byte(i)
    i = i + 1
  key = base64_encode(key_bytes)

"GET " .. path .. " HTTP/1.1\r\n" .. "Host: " .. host .. ":" .. port:to(str) .. "\r\n" .. "Upgrade: websocket\r\n" .. "Connection: Upgrade\r\n" .. "Sec-WebSocket-Key: " .. key .. "\r\n" .. "Sec-WebSocket-Version: 13\r\n" .. "Origin: http://" .. host .. ":" .. port:to(str) .. "\r\n" .. "\r\n"

# ═══════════════════════════════════════════════════════════════
# WebSocket handshake (server side)
# ═══════════════════════════════════════════════════════════════

ws_server_handshake: str = (request: str)
  # Extract Sec-WebSocket-Key
  key = string("match")(request, "Sec%-WebSocket%-Key: ([%w%+/=]+)")
  if key == nil
    return "HTTP/1.1 400 Bad Request\r\n\r\n"

  # Compute accept hash
  magic = "258EAFA5-E914-47DA-95CA-5AB9FC1B5B09"
  accept = base64_sha1(key .. magic)

"HTTP/1.1 101 Switching Protocols\r\n" .. "Upgrade: websocket\r\n" .. "Connection: Upgrade\r\n" .. "Sec-WebSocket-Accept: " .. accept .. "\r\n" .. "\r\n"

# ═══════════════════════════════════════════════════════════════
# WebSocket message helpers
# ═══════════════════════════════════════════════════════════════

ws_text_frame: any = (text: str)
  bytes = {}
  i = 1
  while i <= text:len()
    bytes(bytes:len() + 1) = text:byte(i)
    i = i + 1
  ws_encode_frame(OP_TEXT, bytes, false)

ws_binary_frame: any = (data: any)
  ws_encode_frame(OP_BINARY, data, false)

ws_close_frame: any = (code: i64, reason: str)
  payload = {}
  payload(1) = code >> 8 & 255
  payload(2) = code & 255
  if reason
    i = 1
    while i <= reason:len()
      payload(payload:len() + 1) = reason:byte(i)
      i = i + 1
  ws_encode_frame(OP_CLOSE, payload, false)

ws_ping_frame: any = (data: any)
  if data == nil
    data = {}
  ws_encode_frame(OP_PING, data, false)

ws_pong_frame: any = (data: any)
  if data == nil
    data = {}
  ws_encode_frame(OP_PONG, data, false)

# ═══════════════════════════════════════════════════════════════
# WebSocket connection state machine
# ═══════════════════════════════════════════════════════════════

ws_connection_new: any = (role: str)
  # role: "client" or "server"
  {
    role = role,
    state = "connecting",
    buffer = {},
    message = nil,
    close_code = nil,
    close_reason = nil
  }

ws_connection_send: any = (conn: any, opcode: i64, payload: any)
  mask = conn.role == "client"
  ws_encode_frame(opcode, payload, mask)

ws_connection_receive: any = (conn: any, data: any)
  # Append to buffer
  for b in data
    conn.buffer(conn.buffer:len() + 1) = b

  # Try to decode
  if conn.buffer:len() < 2
    return nil
  frame = ws_decode_frame(conn.buffer, 1)
  if frame == nil
    return nil

  # Remove consumed bytes
  new_buf = {}
  i = frame.next
  while i <= conn.buffer:len()
    new_buf(new_buf:len() + 1) = conn.buffer(i)
    i = i + 1
  conn.buffer = new_buf

  # Handle control frames
  if frame.opcode == OP_PING
    conn.state = "connected"
    return { type = "ping", payload = frame.payload }
  else(frame.opcode == OP_PONG)
    return { type = "pong", payload = frame.payload }
  else(frame.opcode == OP_CLOSE)
    conn.state = "closed"
    if frame.payload:len() >= 2
      conn.close_code = frame.payload(1) << 8 | frame.payload(2)
    return { type = "close", code = conn.close_code }
  else(frame.opcode == OP_TEXT)
    # Convert payload to string
    parts = {}
    i = 1
    while i <= frame.payload:len()
      parts(parts:len() + 1) = frame.payload(i):char()
      i = i + 1
    return { type = "text", data = parts:concat() }
  else(frame.opcode == OP_BINARY)
    return { type = "binary", data = frame.payload }

nil

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

M = {}
M.encode_frame = ws_encode_frame
M.decode_frame = ws_decode_frame
M.client_handshake = ws_client_handshake
M.server_handshake = ws_server_handshake
M.text_frame = ws_text_frame
M.binary_frame = ws_binary_frame
M.close_frame = ws_close_frame
M.ping_frame = ws_ping_frame
M.pong_frame = ws_pong_frame
M.connection_new = ws_connection_new
M.connection_send = ws_connection_send
M.connection_receive = ws_connection_receive
# The opcode literals are written directly here rather than referencing the
# file-scope constants above.
#
# Referencing them emitted bare, UNDECLARED identifiers in the generated C
# ("use of undeclared identifier 'OP_CONTINUATION'") when this module is
# EMBEDDED. The same constants resolve fine in a standalone program, so the
# gap is in the embed path: a file-scope constant referenced from inside a
# nested table of a module's export table is not resolved.
#
# Reduced to a two-file repro, and note the correction — my first reading was
# that only the 0x00 entry failed and that the folder treated a zero-valued
# constant as absent. That is WRONG: a module with `ZERO = 0x00` and
# `ONE = 0x01` referenced from `M.T = { z = ZERO, o = ONE }` fails on BOTH.
# The value is irrelevant; the nesting and the embed path are what matter.
M.OP =
  CONTINUATION = 0
  TEXT = 1
  BINARY = 2
  CLOSE = 8
  PING = 9
  PONG = 10
M
