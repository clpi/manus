
M = {}


M.QUIC_VERSION = 1
M.MAX_UDP_PAYLOAD = 1200
M.MAX_STREAMS = 256
M.DEFAULT_IDLE_TIMEOUT = 30000

M.PACKET_TYPE_INITIAL = 0
M.PACKET_TYPE_0RTT = 1
M.PACKET_TYPE_HANDSHAKE = 2
M.PACKET_TYPE_RETRY = 3
M.PACKET_TYPE_1RTT = 4

M.FRAME_CRYPTO = 6
M.FRAME_STREAM = 8
M.FRAME_ACK = 10
M.FRAME_MAX_DATA = 16
M.FRAME_MAX_STREAMS = 18
M.FRAME_CONNECTION_CLOSE = 28


quic_connection_new: any = (config: any)
  {
    connection_id = config.connection_id or generate_connection_id(),
    remote_address = config.remote_address or "0.0.0.0:0",
    state = "idle",
    streams = {},
    next_stream_id = 0,
    packet_number = 0,
    max_data = 1048576,
    max_streams = M.MAX_STREAMS,
    idle_timeout = M.DEFAULT_IDLE_TIMEOUT,
    created_at = os.time() * 1000,
    last_activity = os.time() * 1000
  }

quic_connection_connect: any = (conn: any, address: str)
  conn.remote_address = address
  conn.state = "connecting"
  conn.last_activity = os.time() * 1000

  {
    ok = true,
    connection_id = conn.connection_id
  }

quic_connection_accept: any = (conn: any)
  conn.state = "connected"
  conn.last_activity = os.time() * 1000
  {
    ok = true,
    connection_id = conn.connection_id
  }

quic_connection_close = (conn: any, error_code: i64, reason: str)
  conn.state = "closed"
  conn.close_error = error_code
  conn.close_reason = reason

quic_connection_is_open: bool = (conn: any)
  conn.state != "closed"


quic_stream_new: any = (conn: any, stream_id: i64)
  {
    stream_id = stream_id or conn.next_stream_id,
    conn = conn,
    state = "open",
    send_buffer = {},
    recv_buffer = {},
    send_offset = 0,
    recv_offset = 0,
    max_stream_data = 65536,
    data_available = false
  }

quic_stream_write: any = (stream: any, data: any)
  if stream.state != "open"
    return { ok = false, error = "stream closed" }

  for byte in data
    stream.send_buffer[stream.send_buffer:len() + 1] = byte
  stream.send_offset = stream.send_offset + data:len()

  {
    ok = true,
    bytes_sent = data:len()
  }

quic_stream_read: any = (stream: any, max_bytes: i64)
  if stream.recv_buffer:len() == 0
    return { ok = false, error = "no data" }

  bytes = {}
  count = max_bytes:min(stream.recv_buffer:len())
  i = 1
  while i <= count
    bytes[i] = stream.recv_buffer(i)
    i = i + 1

  i = 1
  while i <= stream.recv_buffer:len() - count
    stream.recv_buffer[i] = stream.recv_buffer(i + count)
    i = i + 1

  new_size = stream.recv_buffer:len() - count
  while stream.recv_buffer:len() > new_size
    stream.recv_buffer[stream.recv_buffer:len()] = nil

  stream.recv_offset = stream.recv_offset + count

  {
    ok = true,
    data = bytes,
    size = count
  }

quic_stream_close = (stream: any)
  stream.state = "closed"

quic_stream_is_open: bool = (stream: any)
  stream.state == "open"


quic_packet_header_encode: any = (packet_type: i64, connection_id: i64, packet_number: i64)
  bytes = {}

  bytes[1] = bit.band(bit.rshift(M.QUIC_VERSION, 24), 255)
  bytes[2] = bit.band(bit.rshift(M.QUIC_VERSION, 16), 255)
  bytes[3] = bit.band(bit.rshift(M.QUIC_VERSION, 8), 255)
  bytes[4] = bit.band(M.QUIC_VERSION, 255)

  bytes[5] = 8
  i = 1
  while i <= 8
    bytes[5 + i] = bit.band(bit.rshift(connection_id, (8 - i) * 8), 255)
    i = i + 1

  offset = 14
  bytes[offset] = bit.band(bit.rshift(packet_number, 24), 255)
  bytes[offset + 1] = bit.band(bit.rshift(packet_number, 16), 255)
  bytes[offset + 2] = bit.band(bit.rshift(packet_number, 8), 255)
  bytes[offset + 3] = bit.band(packet_number, 255)

  bytes

quic_frame_stream_encode: any = (stream_id: i64, offset: i64, data: any)
  bytes = {}

  bytes[1] = M.FRAME_STREAM

  bytes[2] = bit.band(stream_id, 255)

  bytes[3] = bit.band(offset, 255)

  bytes[4] = data:len()

  i = 1
  while i <= data:len()
    bytes[4 + i] = data[i]
    i = i + 1

  bytes

quic_frame_ack_encode: any = (largest_acknowledged: i64, ack_delay: i64)
  bytes = {}

  bytes[1] = M.FRAME_ACK

  bytes[2] = bit.band(largest_acknowledged, 255)

  bytes[3] = bit.band(ack_delay, 255)

  bytes[4] = 0

  bytes


quic_config_new: any = ()
  {
    max_data = 1048576,
    max_streams = M.MAX_STREAMS,
    idle_timeout = M.DEFAULT_IDLE_TIMEOUT,
    max_udp_payload = M.MAX_UDP_PAYLOAD,
    initial_max_data = 1048576,
    initial_max_streams_bidi = 100,
    initial_max_streams_uni = 100
  }

quic_config_set_max_data = (config: any, max_data: i64)
  config.max_data = max_data

quic_config_set_max_streams = (config: any, max_streams: i64)
  config.max_streams = max_streams

quic_config_set_idle_timeout = (config: any, timeout: i64)
  config.idle_timeout = timeout


generate_connection_id: any = ()
  crypto_rand = rand
  bytes = {}
  data = crypto_rand.bytes(8)
  i = 1
  while i <= 8
    bytes[i] = data:byte(i)
    i = i + 1
  bytes

quic_varint_encode: any = (value: i64)
  if value < 64
    return { bit.band(value, 255) }
  else
    if value < 16384
      return {
        bit.bor(64, bit.rshift(value, 8)),
        bit.band(value, 255)
      }
    else
      if value < 1073741824
        return {
          bit.bor(128, bit.rshift(value, 24)),
          bit.band(bit.rshift(value, 16), 255),
          bit.band(bit.rshift(value, 8), 255),
          bit.band(value, 255)
        }
      else
        return {
          bit.bor(192, bit.rshift(value, 56)),
          bit.band(bit.rshift(value, 48), 255),
          bit.band(bit.rshift(value, 40), 255),
          bit.band(bit.rshift(value, 32), 255),
          bit.band(bit.rshift(value, 24), 255),
          bit.band(bit.rshift(value, 16), 255),
          bit.band(bit.rshift(value, 8), 255),
          bit.band(value, 255)
        }


M.connection_new = quic_connection_new
M.connection_connect = quic_connection_connect
M.connection_accept = quic_connection_accept
M.connection_close = quic_connection_close
M.connection_is_open = quic_connection_is_open
M.stream_new = quic_stream_new
M.stream_write = quic_stream_write
M.stream_read = quic_stream_read
M.stream_close = quic_stream_close
M.stream_is_open = quic_stream_is_open
M.packet_header_encode = quic_packet_header_encode
M.frame_stream_encode = quic_frame_stream_encode
M.frame_ack_encode = quic_frame_ack_encode
M.config_new = quic_config_new
M.config_set_max_data = quic_config_set_max_data
M.config_set_max_streams = quic_config_set_max_streams
M.config_set_idle_timeout = quic_config_set_idle_timeout
M.varint_encode = quic_varint_encode
M
