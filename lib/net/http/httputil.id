
dump: str = (x: any)
    if x == nil return ""
    if has(.method)(x)
        out = {x.method or "GET", " ", x.path or "/", " HTTP/1.1\r\n"}
    else
        out = {"HTTP/1.1 ", to(str)(x.status or 200), " OK\r\n"}
    if x.headers
        for k, v in x.headers
            out[out:len() + 1] = k .. ": " .. v .. "\r\n"
    out[out:len() + 1] = "\r\n"
    if x.body out[out:len() + 1] = x.body
    out:concat()

proxy: any = (target: str)
    {target = target}
