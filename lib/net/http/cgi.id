# net.http.cgi — CGI handler (mirrors Go's net/http/cgi)

serve = (handler: any)
  method = env("REQUEST_METHOD") or "GET"
  path = env("PATH_INFO") or "/"
  query = env("QUERY_STRING") or ""
  body = ""
  if method == "POST" or method == "PUT"
    body = stdin:read()
  resp = handler(method, path, query, body)
  stdout:write("Status: 200 OK\r\nContent-Type: text/plain\r\n\r\n")
  stdout:write(resp)

request: any = ()
  { method = env("REQUEST_METHOD") or "GET", path = env("PATH_INFO") or "/", query = env("QUERY_STRING") or "" }
