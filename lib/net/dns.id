net = net
A = 1
NS = 2
CNAME = 5
SOA = 6
MX = 15
TXT = 16
AAAA = 28
SRV = 33
PTR = 12
ANY = 255
header_new: any = (id: i64, qr: i64, opcode: i64, aa: i64, tc: i64, rd: i64, ra: i64, z: i64, rcode: i64)
  {
    id = id,
    qr = qr,
    opcode = opcode,
    aa = aa,
    tc = tc,
    rd = rd,
    ra = ra,
    z = z,
    rcode = rcode,
    qdcount = 0,
    ancount = 0,
    nscount = 0,
    arcount = 0
  }
header_encode: any = (h: any)
  bytes = {}
  bytes(1) = h.id >> 8 & 255
  bytes(2) = h.id & 255
  flags = h.qr << 15 | h.opcode << 11 | h.aa << 10 | h.tc << 9 | h.rd << 8 | h.ra << 7 | h.z << 4 | h.rcode
  bytes(3) = flags >> 8 & 255
  bytes(4) = flags & 255
  bytes(5) = h.qdcount >> 8 & 255
  bytes(6) = h.qdcount & 255
  bytes(7) = h.ancount >> 8 & 255
  bytes(8) = h.ancount & 255
  bytes(9) = h.nscount >> 8 & 255
  bytes(10) = h.nscount & 255
  bytes(11) = h.arcount >> 8 & 255
  bytes(12) = h.arcount & 255
  bytes
header_decode: any = (data: any)
  id = data(1) << 8 | data(2)
  flags = data(3) << 8 | data(4)
  {
    id = id,
    qr = flags >> 15 & 1,
    opcode = flags >> 11 & 15,
    aa = flags >> 10 & 1,
    tc = flags >> 9 & 1,
    rd = flags >> 8 & 1,
    ra = flags >> 7 & 1,
    z = flags >> 4 & 7,
    rcode = flags & 15,
    qdcount = data(5) << 8 | data(6),
    ancount = data(7) << 8 | data(8),
    nscount = data(9) << 8 | data(10),
    arcount = data(11) << 8 | data(12)
  }
name_encode: any = (name: str)
  bytes = {}
  pos = 1
  len = name:len()
  while pos <= len
    dot_pos = name:find(".", pos, true)
    if dot_pos == nil
      dot_pos = len + 1
    label_len = dot_pos - pos
    bytes(bytes:len() + 1) = label_len
    i = pos
    while i < dot_pos
      bytes(bytes:len() + 1) = name:byte(i)
      i = i + 1
    pos = dot_pos + 1
  bytes(bytes:len() + 1) = 0
  bytes
name_decode: any = (data: any, pos: i64)
  parts = {}
  jumped = false
  original_pos = pos
  while true
    if pos > data:len()
      break
    len = data(pos)
    if len == 0
      pos = pos + 1
      break
    else(len & 192 == 192)
      if not jumped
        original_pos = original_pos + 2
      pointer = (len & 63) << 8 | data(pos + 1)
      pos = pointer + 1
      jumped = true
    else
      pos = pos + 1
      label = ""
      i = 0
      while i < len
        label = label .. data(pos + i):char()
        i = i + 1
      parts(parts:len() + 1) = label
      pos = pos + len
  name = parts:concat(".")
  next_pos = jumped and original_pos or pos
  {
    name = name,
    next = next_pos
  }
query_new: any = (name: str, qtype: i64)
  crypto_rand = rand
  id_bytes = crypto_rand.bytes(2)
  query_id = id_bytes:byte(1) << 8 | id_bytes:byte(2)
  {
    header = header_new(query_id, 0, 0, 0, 0, 1, 0, 0, 0),
    question = {
      name = name,
      qtype = qtype,
      qclass = 1
    }
  }
query_encode: any = (q: any)
  bytes = {}
  q.header.qdcount = 1
  header_bytes = header_encode(q.header)
  for b in header_bytes
    bytes(bytes:len() + 1) = b
  name_bytes = name_encode(q.question.name)
  for b in name_bytes
    bytes(bytes:len() + 1) = b
  bytes(bytes:len() + 1) = q.question.qtype >> 8 & 255
  bytes(bytes:len() + 1) = q.question.qtype & 255
  bytes(bytes:len() + 1) = q.question.qclass >> 8 & 255
  bytes(bytes:len() + 1) = q.question.qclass & 255
  bytes
record_decode: any = (data: any, pos: i64)
  result = name_decode(data, pos)
  name = result.name
  pos = result.next
  rtype = data(pos) << 8 | data(pos + 1)
  pos = pos + 2
  rclass = data(pos) << 8 | data(pos + 1)
  pos = pos + 2
  ttl = data(pos) << 24 | data(pos + 1) << 16 | data(pos + 2) << 8 | data(pos + 3)
  pos = pos + 4
  rdlength = data(pos) << 8 | data(pos + 1)
  pos = pos + 2
  rdata = nil
  if rtype == A and rdlength == 4
    rdata = to(str)(data(pos)) .. "." .. to(str)(data(pos + 1)) .. "." .. to(str)(data(pos + 2)) .. "." .. to(str)(data(pos + 3))
  else(rtype == AAAA and rdlength == 16)
    parts = {}
    i = 0
    while i < 16
      hi = data(pos + i)
      lo = data(pos + i + 1)
      parts(parts:len() + 1) = "%02x%02x":format(hi, lo)
      i = i + 2
    rdata = parts:concat(":")
  else(rtype == CNAME or rtype == NS or rtype == PTR)
    cname = name_decode(data, pos)
    rdata = cname.name
  else(rtype == MX)
    preference = data(pos) << 8 | data(pos + 1)
    exchange = name_decode(data, pos + 2)
    rdata = {
      preference = preference,
      exchange = exchange.name
    }
  else(rtype == TXT)
    txt_len = data(pos)
    txt = ""
    i = 1
    while i <= txt_len
      txt = txt .. data(pos + i):char()
      i = i + 1
    rdata = txt
  else(rtype == SRV)
    priority = data(pos) << 8 | data(pos + 1)
    weight = data(pos + 2) << 8 | data(pos + 3)
    port = data(pos + 4) << 8 | data(pos + 5)
    target = name_decode(data, pos + 6)
    rdata = {
      priority = priority,
      weight = weight,
      port = port,
      target = target.name
    }
  pos = pos + rdlength
  {
    name = name,
    type = rtype,
    class = rclass,
    ttl = ttl,
    rdlength = rdlength,
    rdata = rdata,
    next = pos
  }
response_decode: any = (data: any)
  header = header_decode(data)
  pos = 13
  i = 0
  while i < header.qdcount
    result = name_decode(data, pos)
    pos = result.next + 4
    i = i + 1
  answers = {}
  i = 0
  while i < header.ancount
    record = record_decode(data, pos)
    answers(answers:len() + 1) = record
    pos = record.next
    i = i + 1
  authority = {}
  i = 0
  while i < header.nscount
    record = record_decode(data, pos)
    authority(authority:len() + 1) = record
    pos = record.next
    i = i + 1
  additional = {}
  i = 0
  while i < header.arcount
    record = record_decode(data, pos)
    additional(additional:len() + 1) = record
    pos = record.next
    i = i + 1
  {
    header = header,
    answers = answers,
    authority = authority,
    additional = additional
  }
resolver_new: any = ()
  {
    servers = {
      "8.8.8.8",
      "8.8.4.4",
      "1.1.1.1",
      "1.0.0.1"
    },
    port = 53,
    timeout = 5,
    cache = {},
    retries = 3
  }
resolver_set_servers = (resolver: any, servers: any)
  resolver.servers = servers
resolver_set_timeout = (resolver: any, timeout: i64)
  resolver.timeout = timeout
resolver_resolve: any = (resolver: any, name: str, qtype: i64)
  cache_key = name .. ":" .. qtype:to(str)
  if resolver.cache(cache_key)
    return resolver.cache(cache_key)
  if qtype == A
    ip = net.dns_resolve(name)
    if ip != nil
      result = {
        header = header_new(0, 1, 0, 0, 0, 1, 1, 0, 0),
        answers = {
          {
            name = name,
            type = A,
            class = 1,
            ttl = 300,
            rdlength = 4,
            rdata = ip,
            next = 0
          }
        },
        authority = {},
        additional = {}
      }
      resolver.cache(cache_key) = result
      return result
  for server in resolver.servers
    query = query_new(name, qtype)
    query_bytes = query_encode(query)
    result = {
      header = query.header,
      answers = {},
      authority = {},
      additional = {}
    }
    if result.header.rcode == 0 and result.answers:len() > 0
      resolver.cache(cache_key) = result
    return result
  {
    error = "All DNS servers failed"
  }
resolver_lookup_a: any = (resolver: any, name: str)
  result = resolver_resolve(resolver, name, A)
  if result.error
    return result
  ips = {}
  for answer in result.answers
    if answer.type == A
      ips(ips:len() + 1) = answer.rdata
  {
    ips = ips
  }
resolver_lookup_aaaa: any = (resolver: any, name: str)
  result = resolver_resolve(resolver, name, AAAA)
  if result.error
    return result
  ips = {}
  for answer in result.answers
    if answer.type == AAAA
      ips(ips:len() + 1) = answer.rdata
  {
    ips = ips
  }
resolver_lookup_mx: any = (resolver: any, name: str)
  result = resolver_resolve(resolver, name, MX)
  if result.error
    return result
  mx_records = {}
  for answer in result.answers
    if answer.type == MX
      mx_records(mx_records:len() + 1) = answer.rdata
  mx_records:sort((a: any, b: any) -> any
    a.preference < b.preference
  )
  {
    records = mx_records
  }
resolver_lookup_cname: any = (resolver: any, name: str)
  result = resolver_resolve(resolver, name, CNAME)
  if result.error
    return result
  for answer in result.answers
    if answer.type == CNAME
      return {
        cname = answer.rdata
      }
  {
    cname = nil
  }
resolver_flush_cache = (resolver: any)
  resolver.cache = {}
type_name: str = (qtype: i64)
  types = {
    [A] = "A",
    [NS] = "NS",
    [CNAME] = "CNAME",
    [SOA] = "SOA",
    [MX] = "MX",
    [TXT] = "TXT",
    [AAAA] = "AAAA",
    [SRV] = "SRV",
    [PTR] = "PTR",
    [ANY] = "ANY"
  }
  types(qtype) or "UNKNOWN"
type_from_name: i64 = (name: str)
  types = {
    A = A,
    NS = NS,
    CNAME = CNAME,
    SOA = SOA,
    MX = MX,
    TXT = TXT,
    AAAA = AAAA,
    SRV = SRV,
    PTR = PTR,
    ANY = ANY
  }
  types(name:upper()) or 0
