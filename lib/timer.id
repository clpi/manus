
std_timer_round: i64 = (x: any)
  to(i64)(x + 0.5:floor())

std_timer_round_dec: any = (x: any, places: any)
  factor = 1
  i = 0
  while i < places
    factor = factor * 10
    i = i + 1
  std_timer_round(x * factor) / factor


new: any = ()
  { start = os.clock(), laps = {}, running = true, stopped_at = nil }

elapsed: any = (t: any)
  if t == nil
    return 0
  if not t.running
    return t.stopped_at - t.start
  os.clock() - t.start

lap: any = (t: any)
  if t == nil
    return 0
  now = os.clock()
  lap_time = now - t.start
  t.laps[t.laps:len() + 1] = lap_time
  lap_time

lap_elapsed: any = (t: any)
  if t == nil
    return 0
  now = os.clock()
  if t.laps:len() == 0
    return now - t.start
  now - t.laps(t.laps:len())

stop: any = (t: any)
  if t == nil
    return 0
  t.stopped_at = os.clock()
  t.running = false
  t.stopped_at - t.start

reset = (t: any)
  if t == nil
    return
  t.start = os.clock()
  t.laps = {}
  t.running = true
  t.stopped_at = nil

is_running: bool = (t: any)
  if t == nil
    return false
  t.running

get_laps: any = (t: any)
  if t == nil
    return {}
  t.laps

lap_count: i64 = (t: any)
  if t == nil
    return 0
  t.laps:len()


format: str = (seconds: any)
  if seconds == nil
    return "0s"
  if seconds < 0.001
    ms = seconds * 1000000
    return to(str)(std_timer_round(ms)) .. "us"
  if seconds < 1
    ms = seconds * 1000
    return to(str)(std_timer_round(ms)) .. "ms"
  if seconds < 60
    return to(str)(std_timer_round_dec(seconds, 3)) .. "s"
  mins = seconds / 60:floor()
  secs = seconds - mins * 60
  return mins:to(str) .. "m" .. to(str)(std_timer_round_dec(secs, 1)) .. "s"

summary: any = (t: any)
  if t == nil
    return {}
  laps = t.laps
  n = laps:len()
  if n == 0
    return { count = 0, total = 0, min = 0, max = 0, avg = 0 }
  total = 0
  min_val = laps[1]
  max_val = laps[1]
  i = 1
  while i <= n
    if laps[i] < min_val
      min_val = laps[i]
    if laps[i] > max_val
      max_val = laps[i]
    total = total + laps[i]
    i = i + 1
  { count = n, total = total, min = min_val, max = max_val, avg = total / n }


measure: any = (fn_ref: any)
  t = new()
  r = fn_ref()
  d = stop(t)
  out = {}
  out.result = r
  out.elapsed = d
  out

time_it: any = (n: i64, fn_ref: any)
  if n == nil or n < 1
    n = 1
  times = {}
  i = 0
  while i < n
    t = new()
    fn_ref()
    stop(t)
    times[times:len() + 1] = elapsed(t)
    i = i + 1
  total = 0
  min_val = times[1]
  max_val = times[1]
  j = 1
  while j <= times:len()
    if times[j] < min_val
      min_val = times[j]
    if times[j] > max_val
      max_val = times[j]
    total = total + times[j]
    j = j + 1
  out = {}
  out.iterations = n
  out.total = total
  out.avg = total / n
  out.min = min_val
  out.max = max_val
  out.times = times
  out

bench: any = (fn_ref: any, min_seconds: float)
  if min_seconds == nil
    min_seconds = 0.1
  times = {}
  total = 0
  count = 0
  while total < min_seconds
    t = new()
    fn_ref()
    stop(t)
    lap_time = elapsed(t)
    times[times:len() + 1] = lap_time
    total = total + lap_time
    count = count + 1
  min_val = times[1]
  max_val = times[1]
  i = 1
  while i <= times:len()
    if times[i] < min_val
      min_val = times[i]
    if times[i] > max_val
      max_val = times[i]
    i = i + 1
  out = {}
  out.iterations = count
  out.total = total
  out.avg = total / count
  out.min = min_val
  out.max = max_val
  out.ops_per_sec = count / total
  out

compare: any = (name_a: str, fn_a: any, name_b: str, fn_b: any, n: i64)
  if n == nil
    n = 1000
  a = time_it(n, fn_a)
  b = time_it(n, fn_b)
  faster = ""
  ratio = 0
  if b.avg > 0
    ratio = a.avg / b.avg
  if a.avg < b.avg
    faster = name_a
  else
    faster = name_b
    if a.avg > 0
      ratio = b.avg / a.avg
  out = {}
  out[name_a] = a
  out[name_b] = b
  out.faster = faster
  out.ratio = ratio
  out
