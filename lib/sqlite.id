# std.sqlite — SQLite database interface via native C API (@ffi bindings)
# Replaces the previous sqlite3 CLI shell wrapper with direct C library calls.
# Link with: duo compile myapp.id #link sqlite3
# The @ffi declarations bind directly to the libsqlite3 C API.

# ===========================================================================
# SQLite result codes and column type constants
# ===========================================================================
SQLITE_OK = 0
SQLITE_ROW = 100
SQLITE_DONE = 101
SQLITE_INTEGER = 1
SQLITE_FLOAT = 2
SQLITE_TEXT = 3
SQLITE_BLOB = 4
SQLITE_NULL = 5

# ===========================================================================
# FFI declarations — direct bindings to libsqlite3 C functions
# The `any` type maps to lua_Value in C, which can hold opaque pointers.
# ===========================================================================

# sqlite3_open(const char* filename, sqlite3** ppDb): int
@ffi("sqlite3_open")
sqlite3_open(path: str, db: any): int

# sqlite3_close(sqlite3* db): int
@ffi("sqlite3_close")
sqlite3_close(db: any): int

# sqlite3_prepare_v2(sqlite3* db, const char* sql, int nByte, sqlite3_stmt** ppStmt, const char** pzTail): int
# nByte = -1 means read until NUL terminator; pzTail and ppStmt are output pointers.
@ffi("sqlite3_prepare_v2")
sqlite3_prepare_v2(db: any, sql: str, nByte: int, stmt: any, pzTail: any): int

# sqlite3_step(sqlite3_stmt* stmt): int
@ffi("sqlite3_step")
sqlite3_step(stmt: any): int

# sqlite3_finalize(sqlite3_stmt* stmt): int
@ffi("sqlite3_finalize")
sqlite3_finalize(stmt: any): int

# sqlite3_bind_int(sqlite3_stmt* stmt, int idx, int val): int
@ffi("sqlite3_bind_int")
sqlite3_bind_int(stmt: any, idx: int, val: int): int

# sqlite3_bind_int64(sqlite3_stmt* stmt, int idx, sqlite3_int64 val): int
@ffi("sqlite3_bind_int64")
sqlite3_bind_int64(stmt: any, idx: int, val: int): int

# sqlite3_bind_double(sqlite3_stmt* stmt, int idx, double val): int
@ffi("sqlite3_bind_double")
sqlite3_bind_double(stmt: any, idx: int, val: f64): int

# sqlite3_bind_text(sqlite3_stmt* stmt, int idx, const char* val, int nByte, void(*)(void*)): int
# nByte = -1 means NUL-terminated string; the destructor param is SQLITE_TRANSIENT = -1.
@ffi("sqlite3_bind_text")
sqlite3_bind_text(stmt: any, idx: int, val: str, nByte: int, destructor: int): int

# sqlite3_bind_null(sqlite3_stmt* stmt, int idx): int
@ffi("sqlite3_bind_null")
sqlite3_bind_null(stmt: any, idx: int): int

# sqlite3_column_int(sqlite3_stmt* stmt, int idx): int
@ffi("sqlite3_column_int")
sqlite3_column_int(stmt: any, idx: int): int

# sqlite3_column_int64(sqlite3_stmt* stmt, int idx): sqlite3_int64
@ffi("sqlite3_column_int64")
sqlite3_column_int64(stmt: any, idx: int): int

# sqlite3_column_double(sqlite3_stmt* stmt, int idx): double
@ffi("sqlite3_column_double")
sqlite3_column_double(stmt: any, idx: int): f64

# sqlite3_column_text(sqlite3_stmt* stmt, int idx): const unsigned char*
@ffi("sqlite3_column_text")
sqlite3_column_text(stmt: any, idx: int): str

# sqlite3_column_type(sqlite3_stmt* stmt, int idx): int
@ffi("sqlite3_column_type")
sqlite3_column_type(stmt: any, idx: int): int

# sqlite3_column_count(sqlite3_stmt* stmt): int
@ffi("sqlite3_column_count")
sqlite3_column_count(stmt: any): int

# sqlite3_column_name(sqlite3_stmt* stmt, int idx): const char*
@ffi("sqlite3_column_name")
sqlite3_column_name(stmt: any, idx: int): str

# sqlite3_exec(sqlite3* db, const char* sql, callback, arg, errmsg): int
# callback and arg are NULL (0), errmsg is NULL (0) for simple execution.
@ffi("sqlite3_exec")
sqlite3_exec(db: any, sql: str, callback: int, arg: int, errmsg: int): int

# sqlite3_errmsg(sqlite3* db): const char*
@ffi("sqlite3_errmsg")
sqlite3_errmsg(db: any): str

# sqlite3_changes(sqlite3* db): int
@ffi("sqlite3_changes")
sqlite3_changes(db: any): int

# sqlite3_last_insert_rowid(sqlite3* db): sqlite3_int64
@ffi("sqlite3_last_insert_rowid")
sqlite3_last_insert_rowid(db: any): int

# sqlite3_load_extension(sqlite3* db, const char* file, const char* proc, char** errmsg): int
@ffi("sqlite3_load_extension")
sqlite3_load_extension(db: any, path: str, proc: int, errmsg: int): int

# ===========================================================================
# Constants exported for user code
# ===========================================================================
constant(name: str): int
    if name == "SQLITE_OK" return SQLITE_OK end
    if name == "SQLITE_ROW" return SQLITE_ROW end
    if name == "SQLITE_DONE" return SQLITE_DONE end
    if name == "SQLITE_INTEGER" return SQLITE_INTEGER end
    if name == "SQLITE_FLOAT" return SQLITE_FLOAT end
    if name == "SQLITE_TEXT" return SQLITE_TEXT end
    if name == "SQLITE_BLOB" return SQLITE_BLOB end
    if name == "SQLITE_NULL" return SQLITE_NULL end
    return -1
end

# ===========================================================================
# API: open(path): connection handle
# Opens a SQLite database file. Use ":memory:" for an in-memory database.
# Returns a table wrapping the opaque db pointer and the original path.
# ===========================================================================
open(path: str): any
    db_ptr = nil
    rc = sqlite3_open(path, db_ptr)
    if rc != SQLITE_OK
        # On failure, db_ptr may still hold a handle that needs closing.
        if db_ptr != nil
            sqlite3_close(db_ptr)
        end
        return nil
    end
    {handle = db_ptr, path = path, closed = false}
end

# ===========================================================================
# API: close(db): void
# Closes the database connection and frees resources.
# ===========================================================================
close(db: any): void
    if db == nil return end
    if type(db) == "table"
        if db.closed return end
        db.closed = true
        if has(.handle)(db)
            sqlite3_close(db.handle)
        end
    else
        # Assume raw pointer
        sqlite3_close(db)
    end
end

# ===========================================================================
# API: execute(db, sql): error message or empty string
# Runs a DDL/DML statement via sqlite3_exec. Returns empty string on success,
# or the error message on failure.
# ===========================================================================
execute(db: any, sql: str): str
    handle = db
    if type(db) == "table" handle = db.handle end
    if handle == nil return "no database handle" end
    rc = sqlite3_exec(handle, sql, 0, 0, 0)
    if rc != SQLITE_OK
        return sqlite3_errmsg(handle)
    end
    ""
end

# ===========================================================================
# API: prepare(db, sql): statement handle (opaque pointer)
# Compiles a SQL statement. Returns the opaque sqlite3_stmt* or nil on error.
# ===========================================================================
prepare(db: any, sql: any): any
    handle = db
    if type(db) == "table" handle = db.handle end
    if handle == nil return nil end
    stmt = nil
    tail = nil
    rc = sqlite3_prepare_v2(handle, sql, -1, stmt, tail)
    if rc != SQLITE_OK
        return nil
    end
    stmt
end

# ===========================================================================
# API: bind_* functions — bind values to prepared statement parameters
# Parameter indices are 1-based in SQLite.
# ===========================================================================
bind_int(stmt: any, idx: int, val: int): void
    sqlite3_bind_int(stmt, idx, val)
end

bind_int64(stmt: any, idx: int, val: int): void
    sqlite3_bind_int64(stmt, idx, val)
end

bind_double(stmt: any, idx: int, val: f64): void
    sqlite3_bind_double(stmt, idx, val)
end

bind_text(stmt: any, idx: int, val: str): void
    # nByte=-1: NUL-terminated string. destructor=-1: SQLITE_TRANSIENT (SQLite copies the data).
    sqlite3_bind_text(stmt, idx, val, -1, -1)
end

bind_null(stmt: any, idx: int): void
    sqlite3_bind_null(stmt, idx)
end

# ===========================================================================
# API: step(stmt): int
# Advances the prepared statement. Returns SQLITE_ROW (100) if a row is
# available, SQLITE_DONE (101) if execution completed.
# ===========================================================================
step(stmt: any): int
    sqlite3_step(stmt)
end

# ===========================================================================
# API: column_* functions — read column values from the current row
# ===========================================================================
column_int(stmt: any, idx: int): int
    sqlite3_column_int(stmt, idx)
end

column_int64(stmt: any, idx: int): int
    sqlite3_column_int64(stmt, idx)
end

column_double(stmt: any, idx: int): f64
    sqlite3_column_double(stmt, idx)
end

column_text(stmt: any, idx: int): str
    sqlite3_column_text(stmt, idx)
end

column_type(stmt: any, idx: int): int
    sqlite3_column_type(stmt, idx)
end

column_count(stmt: any): int
    sqlite3_column_count(stmt)
end

column_name(stmt: any, idx: int): str
    sqlite3_column_name(stmt, idx)
end

# ===========================================================================
# API: finalize(stmt): void
# Destroys a prepared statement, freeing its resources.
# ===========================================================================
finalize(stmt: any): void
    if stmt != nil
        sqlite3_finalize(stmt)
    end
end

# ===========================================================================
# API: errmsg(db): str
# Returns the most recent error message from the database connection.
# ===========================================================================
errmsg(db: any): str
    handle = db
    if type(db) == "table" handle = db.handle end
    if handle == nil return "no database handle" end
    sqlite3_errmsg(handle)
end

# ===========================================================================
# API: changes(db): int
# Returns the number of rows modified by the most recent INSERT/UPDATE/DELETE.
# ===========================================================================
changes(db: any): int
    handle = db
    if type(db) == "table" handle = db.handle end
    if handle == nil return 0 end
    sqlite3_changes(handle)
end

# ===========================================================================
# API: last_insert_rowid(db): int (i64)
# Returns the rowid of the most recent successful INSERT.
# ===========================================================================
last_insert_rowid(db: any): int
    handle = db
    if type(db) == "table" handle = db.handle end
    if handle == nil return 0 end
    sqlite3_last_insert_rowid(handle)
end

# ===========================================================================
# API: load_extension(db, path): int
# Loads a SQLite extension. Returns SQLITE_OK (0) on success.
# ===========================================================================
load_extension(db: any, path: str): int
    handle = db
    if type(db) == "table" handle = db.handle end
    if handle == nil return -1 end
    sqlite3_load_extension(handle, path, 0, 0)
end

# ===========================================================================
# API: query(db, sql): table of rows
# Convenience function: prepares, steps through all rows, and returns results
# as a table of rows. Each row is a table of {column_name = value} pairs.
# Column values are typed: INTEGER -> int, FLOAT -> f64, TEXT -> str, NULL -> nil.
# Returns nil on prepare failure.
# ===========================================================================
query(db: any, sql: str): any
    stmt = prepare(db, sql)
    if stmt == nil return nil end

    ncols = sqlite3_column_count(stmt)
    rows = {}
    row_idx = 1

    rc = sqlite3_step(stmt)
    while rc == SQLITE_ROW
        row = {}
        col_idx = 0
        while col_idx < ncols
            name = sqlite3_column_name(stmt, col_idx)
            col_type = sqlite3_column_type(stmt, col_idx)
            val = nil
            if col_type == SQLITE_INTEGER
                val = sqlite3_column_int64(stmt, col_idx)
            elseif col_type == SQLITE_FLOAT
                val = sqlite3_column_double(stmt, col_idx)
            elseif col_type == SQLITE_TEXT
                val = sqlite3_column_text(stmt, col_idx)
            elseif col_type == SQLITE_BLOB
                # BLOBs are returned as text (best effort in duo)
                val = sqlite3_column_text(stmt, col_idx)
            else
                # SQLITE_NULL or unknown
                val = nil
            end
            row[name] = val
            col_idx += 1
        end
        rows[row_idx] = row
        row_idx += 1
        rc = sqlite3_step(stmt)
    end

    sqlite3_finalize(stmt)
    rows
end

# ===========================================================================
# Module export table
# ===========================================================================
