

crc32_byte: i64 = (crc: i64, b: i64)
  crc = crc ~ b
  for _ = 1, 8
    if crc % 2 == 1
      crc = crc >> 1 ~ 3988292384
    else
      crc = crc >> 1
  crc % 4294967296

crc32_bytes: i64 = (data: str)
  crc = 4294967295
  for i = 1, data:len()
    crc = crc32_byte(crc, data:byte(i))
  2 ^ 32 - 1 - crc

read_u32: i64 = (s: str, off: i64)
  (s:byte(off) * 16777216 + s:byte(off + 1) * 65536 + s:byte(off + 2) * 256 + s:byte(off + 3)) % 4294967296

read_u16: i64 = (s: str, off: i64)
  (s:byte(off) * 256 + s:byte(off + 1)) % 65536

str_to_bytes: any = (s: str)
  bytes = {}
  i = 1
  n = 0
  while i <= s:len()
    n = n + 1
    bytes[n] = s:byte(i)
    i = i + 1
  bytes

tostring: str = (b: any)
  parts = {}
  i = 1
  n = 0
  while i <= b:len()
    n = n + 1
    parts[n] = b[i]:char()
    i = i + 1
  parts:concat()


paeth_predictor: i64 = (a: i64, b: i64, c: i64)
  p = a + b - c
  pa = p - a
  if pa < 0
    pa = -pa
  pb = p - b
  if pb < 0
    pb = -pb
  pc = p - c
  if pc < 0
    pc = -pc
  if pa <= pb and pa <= pc
    return a
  if pb <= pc
    return b
  c

reconstruct_row: any = (raw_data: any, row: i64, stride: i64, bpp: i64)
  row_start = row * stride + 1
  filter_type = raw_data[row_start]
  row_bytes = {}
  i = 1
  while i <= stride
    row_bytes[i] = raw_data[row_start + i]
    i = i + 1

if filter_type == 0
  return row_bytes

prev = {}
if row > 0
  prev_start = (row - 1) * stride + 1
  i = 1
  while i <= stride
    prev[i] = raw_data[prev_start + i]
    i = i + 1
else
  i = 1
  while i <= stride
    prev[i] = 0
    i = i + 1

recon = {}
i = 1
while i <= stride
  raw_byte = row_bytes[i]
  if filter_type == 1
    left = i > bpp and recon[i - bpp] or 0
    recon[i] = (raw_byte + left) % 256
  else(filter_type == 2)
    recon[i] = (raw_byte + prev[i]) % 256
  else(filter_type == 3)
    left = i > bpp and recon[i - bpp] or 0
    recon[i] = (raw_byte + (left + prev[i]) / 2:floor()) % 256
  else(filter_type == 4)
    left = i > bpp and recon[i - bpp] or 0
    upper_left = i > bpp and prev[i - bpp] or 0
    recon[i] = (raw_byte + paeth_predictor(left, prev[i], upper_left)) % 256
  else
    recon[i] = raw_byte
  i = i + 1

recon


decode: any = (data: str)
  if data == nil
    return nil

  sig = "137PNG\r\n26\n"
  for i = 1, 8
    if data:byte(i) != sig:byte(i)
      return nil

off = 9
img = nil
width = 0
height = 0
bit_depth = 8
color_type = 6
idat_data = ""

while off + 8 <= data:len()
  chunk_len = read_u32(data, off)
  chunk_type = data:sub(off + 4, off + 7)
  chunk_data = data:sub(off + 8, off + 7 + chunk_len)

if chunk_type == "IHDR"
  width = read_u32(chunk_data, 1)
  height = read_u32(chunk_data, 5)
  bit_depth = chunk_data:byte(9)
  color_type = chunk_data:byte(10)
  compression = chunk_data:byte(11)
  filter_method = chunk_data:byte(12)
  interlace = chunk_data:byte(13)

  if color_type == 6
    img = image.new_rgba(image.rect(0, 0, width, height))
  else(color_type == 2)
    img = image.new_rgba(image.rect(0, 0, width, height))
  else(color_type == 0)
    img = image.new_gray(image.rect(0, 0, width, height))
  else(color_type == 4)
    img = image.new_rgba(image.rect(0, 0, width, height))
  else
    img = image.new_rgba(image.rect(0, 0, width, height))
else(chunk_type == "IDAT")

  idat_data = idat_data .. chunk_data
else(chunk_type == "IEND")

  break

  off = off + 12 + chunk_len

  if img != nil and idat_data:len() > 0
    compressed = str_to_bytes(idat_data)
    raw_data_str = compress.zlib.decompress(idat_data)
    raw_data = str_to_bytes(raw_data_str)

    bpp = 1
    if color_type == 2
      bpp = 3
    else(color_type == 4)
      bpp = 2
    else(color_type == 6)
      bpp = 4

    if bit_depth < 8
      bpp = 1
    stride = width * bpp

    row = 0
    while row < height
      recon = reconstruct_row(raw_data, row, stride, bpp)

      col = 0
      while col < width
        if color_type == 6
          r = recon[col * 4 + 1] * 257
          g = recon[col * 4 + 2] * 257
          b = recon[col * 4 + 3] * 257
          a = recon[col * 4 + 4] * 257
          image.img_set(img, col, row, image.color.rgba(r, g, b, a))
        else(color_type == 2)
          r = recon[col * 3 + 1] * 257
          g = recon[col * 3 + 2] * 257
          b = recon[col * 3 + 3] * 257
          image.img_set(img, col, row, image.color.rgba(r, g, b, 65535))
        else(color_type == 0)
          y = recon[col + 1] * 257
          image.img_set(img, col, row, image.color.gray(y))
        else(color_type == 4)
          y = recon[col * 2 + 1] * 257
          a = recon[col * 2 + 2] * 257
          image.img_set(img, col, row, image.color.rgba(y, y, y, a))
        col = col + 1
      row = row + 1

  img


  encode: str = (img: any)
    out = "137PNG\r\n26\n"
    w = image.rect_dx(img.rect)
    h = image.rect_dy(img.rect)

    ihdr_data = string.char(w / 16777216 % 256, w / 65536 % 256, w / 256 % 256, w % 256, h / 16777216 % 256, h / 65536 % 256, h / 256 % 256, h % 256, 8, 6, 0, 0, 0)
    out = out .. 0:char(0, 0, 13) .. "IHDR" .. ihdr_data
    ihdr_crc = crc32_bytes("IHDR" .. ihdr_data)
    out = out .. string.char(ihdr_crc / 16777216 % 256, ihdr_crc / 65536 % 256, ihdr_crc / 256 % 256, ihdr_crc % 256)

    raw = ""
    for y = 0, h - 1
      raw = raw .. 0:char()
      for x = 0, w - 1
        c = image.img_at(img, x, y)
        r = c.r / 257 % 256
        g = c.g / 257 % 256
        b = c.b / 257 % 256
        a = c.a / 257 % 256
        raw = raw .. r:char(g, b, a)

    zlib_header = 120:char(1)
    deflate_block = 1:char()
    len = raw:len()
    nlen = 65535 ~ len
    deflate_block = deflate_block .. len % 256:char(len / 256:floor() % 256, nlen % 256, nlen / 256:floor() % 256)
    deflate_block = deflate_block .. raw

    adler_a = 1
    adler_b = 0
    for i = 1, raw:len()
      adler_a = (adler_a + raw:byte(i)) % 65521
      adler_b = (adler_b + adler_a) % 65521
    adler32_check = adler_a * 65536 + adler_b

  idat_data = zlib_header .. deflate_block .. string.char(adler32_check / 16777216 % 256, adler32_check / 65536 % 256, adler32_check / 256 % 256, adler32_check % 256)

  idat_len = idat_data:len()
  out = out .. string.char(idat_len / 16777216 % 256, idat_len / 65536 % 256, idat_len / 256 % 256, idat_len % 256) .. "IDAT" .. idat_data
  idat_crc = crc32_bytes("IDAT" .. idat_data)
  out = out .. string.char(idat_crc / 16777216 % 256, idat_crc / 65536 % 256, idat_crc / 256 % 256, idat_crc % 256)

  iend_crc = crc32_bytes("IEND")
  out = out .. 0:char(0, 0, 0) .. "IEND" .. string.char(iend_crc / 16777216 % 256, iend_crc / 65536 % 256, iend_crc / 256 % 256, iend_crc % 256)
  out
