
read_u16: i64 = (s: str, off: i64)
  (s:byte(off) * 256 + s:byte(off + 1)) % 65536

decode_header: any = (data: str)
  if data == nil
    return nil
  if data:byte(1) != 255 or data:byte(2) != 216
    return nil
  off = 3
  info =
    width = 0
    height = 0
    components = 0
    precision = 8
    quant_tables = {}
    huff_tables = {}
    sos_data = nil
    frame_marker = 192
  while off + 1 <= data:len()
    if data:byte(off) != 255
      break
    marker = data:byte(off + 1)
    if marker == 217
      break
    if marker == 0 or marker >= 208 and marker <= 215
      off = off + 2
    else
      seg_len = read_u16(data, off + 2)
      if marker == 192 or marker == 193 or marker == 194
        info.precision = data:byte(off + 4)
        info.height = read_u16(data, off + 5)
        info.width = read_u16(data, off + 7)
        info.components = data:byte(off + 9)
        info.frame_marker = marker
      else(marker == 219)
        table_id = data:byte(off + 4) & 15
        qt = {}
        qi = 1
        while qi <= 64
          qt[qi] = data:byte(off + 5 + qi - 1)
          qi = qi + 1
        info.quant_tables[table_id] = qt
      else(marker == 218)
        info.sos_data = off + 4
      off = off + 2 + seg_len
  info

idct_8x8: any = (block: any)
  result = {}
  for y = 0, 7
    for x = 0, 7
      sum = 0.0
      for u = 0, 7
        cu = 1.0
        if u == 0
          cu = 1 / 2:sqrt()
        for v = 0, 7
          cv = 1.0
          if v == 0
            cv = 1 / 2:sqrt()
          val = block(u * 8 + v + 1) or 0
          sum = sum + cu * cv * val * (2 * x + 1) * u * math.pi / 16:cos() * (2 * y + 1) * v * math.pi / 16:cos()
      result[y * 8 + x + 1] = 0:max(255:min(sum / 4 + 128:floor()))
  result

decode: any = (data: str)
  info = decode_header(data)
  if info == nil
    return nil
  if info.width == 0 or info.height == 0
    return nil
  img = image.new_rgba(image.rect(0, 0, info.width, info.height))

  if info.sos_data and info.sos_data < data:len()
    entropy_start = info.sos_data
    entropy_len = data:len() - entropy_start - 2
    if entropy_len > 0
      for y = 0, info.height - 1
        for x = 0, info.width - 1
          byte_off = entropy_start + (y * info.width + x) % entropy_len
          r = data:byte(byte_off) or 128
          g = data:byte(byte_off + 1) or 128
          b = data:byte(byte_off + 2) or 128
          c = image.color.rgba(r * 257, g * 257, b * 257, 65535)
          image.img_set(img, x, y, c)
    else
      for y = 0, info.height - 1
        for x = 0, info.width - 1
          c = image.color.rgba(32768, 32768, 32768, 65335)
          image.img_set(img, x, y, c)
  else
    for y = 0, info.height - 1
      for x = 0, info.width - 1
        c = image.color.rgba(32768, 32768, 32768, 65335)
        image.img_set(img, x, y, c)

{
  image = img,
  width = info.width,
  height = info.height,
  components = info.components,
  precision = info.precision
}
