# heap — specialized data structures: binary heap, priority queue, bloom filter, LRU cache
# These are fundamental for networking (priority scheduling), ML (beam search),
# and runtime (GC mark queues).

# ═══════════════════════════════════════════════════════════════
# Binary Min-Heap
# ═══════════════════════════════════════════════════════════════

heap_new: any = (cmp: any)
    {
        data = {},
        n = 0,
        cmp = cmp or ((a, b) a < b),
    }

heap_push = (h: any, value: any)
    h.n = h.n + 1
    h.data[h.n] = value
    heap_up(h, h.n)

heap_pop: any = (h: any)
    if h.n == 0 return nil 
    top = h.data[1]
    h.data[1] = h.data[h.n]
    h.data[h.n] = nil
    h.n = h.n - 1
    if h.n > 0 heap_down(h, 1) 
    top

heap_peek: any = (h: any)
    if h.n == 0 return nil 
    h.data[1]

heap_size: i64 = (h: any)
    h.n

heap_up = (h: any, i: i64)
    while i > 1
        parent = i / 2:floor()
        if h.cmp(h.data[i], h.data[parent])
            h.data[i], h.data[parent] = h.data[parent], h.data[i]
            i = parent
        else
            break

heap_down = (h: any, i: i64)
    while true
        left = 2 * i
        right = 2 * i + 1
        smallest = i
        if left <= h.n and h.cmp(h.data[left], h.data[smallest])
            smallest = left
        if right <= h.n and h.cmp(h.data[right], h.data[smallest])
            smallest = right
        if smallest != i
            h.data[i], h.data[smallest] = h.data[smallest], h.data[i]
            i = smallest
        else
            break

# ═══════════════════════════════════════════════════════════════
# Priority Queue (keyed heap with decrease-key)
# ═══════════════════════════════════════════════════════════════

pq_new: any = (cmp: any)
    {
        data = {},
        index = {},
        n = 0,
        cmp = cmp or ((a, b) a.priority < b.priority),
    }

pq_push = (pq: any, key: any, priority: any)
    entry = {key = key, priority = priority, pos = pq.n + 1}
    pq.n = pq.n + 1
    pq.data[pq.n] = entry
    pq.index[key] = entry
    heap_up_pq(pq, pq.n)

pq_pop: any = (pq: any)
    if pq.n == 0 return nil 
    top = pq.data[1]
    pq.index[top.key] = nil
    pq.data[1] = pq.data[pq.n]
    pq.data[pq.n] = nil
    pq.n = pq.n - 1
    if pq.n > 0
        pq.data[1].pos = 1
        heap_down_pq(pq, 1)
    {key = top.key, priority = top.priority}

pq_peek: any = (pq: any)
    if pq.n == 0 return nil 
    top = pq.data[1]
    {key = top.key, priority = top.priority}

pq_decrease_key = (pq: any, key: any, new_priority: any)
    entry = pq.index[key]
    if entry == nil return 
    entry.priority = new_priority
    heap_up_pq(pq, entry.pos)

pq_contains: bool = (pq: any, key: any)
    pq.index[key] != nil

pq_size: i64 = (pq: any)
    pq.n

heap_up_pq = (pq: any, i: i64)
    while i > 1
        parent = i / 2:floor()
        if pq.cmp(pq.data[i], pq.data[parent])
            pq.data[i], pq.data[parent] = pq.data[parent], pq.data[i]
            pq.data[i].pos = i
            pq.data[parent].pos = parent
            i = parent
        else
            break

heap_down_pq = (pq: any, i: i64)
    while true
        left = 2 * i
        right = 2 * i + 1
        smallest = i
        if left <= pq.n and pq.cmp(pq.data[left], pq.data[smallest])
            smallest = left
        if right <= pq.n and pq.cmp(pq.data[right], pq.data[smallest])
            smallest = right
        if smallest != i
            pq.data[i], pq.data[smallest] = pq.data[smallest], pq.data[i]
            pq.data[i].pos = i
            pq.data[smallest].pos = smallest
            i = smallest
        else
            break

# ═══════════════════════════════════════════════════════════════
# Bloom Filter (probabilistic set membership)
# ═══════════════════════════════════════════════════════════════

bloom_new: any = (expected_items: i64, fp_rate: any)
    if fp_rate == nil fp_rate = 0.01 
    # Optimal bit count: m = -n * ln(p) / (ln2)^2
    m = -expected_items * fp_rate:log() / (2:log() * 2:log()):ceil()
    # Optimal hash count: k = (m/n) * ln2
    k = (m / expected_items) * 2:log():ceil()
    bits = {}
    num_words = m / 64:ceil()
    w = 1
    while w <= num_words
        bits[w] = 0
        w += 1
    {
        bits = bits,
        num_bits = m,
        num_hashes = k,
        count = 0,
    }

# FNV-1a hash for bloom filter
bloom_hash: i64 = (data: any, seed: i64)
    h = 0xcbf29ce484222325 + seed
    i = 1
    n = data:len()
    if type(data) == "string" n = data:len() 
    while i <= n
        if type(data) == "string"
            byte = data:byte(i)
        else
            byte = data[i]
        h = h ^ byte
        h *= 0x100000001b3
        h = h & 0xFFFFFFFFFFFFFFFF
        i += 1
    h

bloom_add = (bf: any, item: any)
    data = item:to(str)
    i = 0
    while i < bf.num_hashes
        pos = bloom_hash(data, i) % bf.num_bits
        word = pos / 64:floor() + 1
        bit = pos % 64
        bf.bits[word] = bf.bits[word] | (1 << bit)
        i += 1
    bf.count = bf.count + 1

bloom_may_contain: bool = (bf: any, item: any)
    data = item:to(str)
    i = 0
    while i < bf.num_hashes
        pos = bloom_hash(data, i) % bf.num_bits
        word = pos / 64:floor() + 1
        bit = pos % 64
        if (bf.bits[word] & (1 << bit)) == 0
            return false
        i += 1
    true

bloom_false_positive_rate: f64 = (bf: any)
    1 - -bf.num_hashes * bf.count / bf.num_bits:exp():pow(bf.num_hashes)

# ═══════════════════════════════════════════════════════════════
# LRU Cache (fixed-size, O(1) get/put via hash map + doubly-linked list)
# ═══════════════════════════════════════════════════════════════

lru_new: any = (capacity: i64)
    {
        capacity = capacity,
        map = {},
        list = {},
        hits = 0,
        misses = 0,
    }

lru_get: any = (cache: any, key: any)
    entry = cache.map[key]
    if entry == nil
        cache.misses = cache.misses + 1
        return nil
    # Move to front (most recently used)
    lru_touch(cache, key)
    cache.hits = cache.hits + 1
    entry.value

lru_put = (cache: any, key: any, value: any)
    entry = cache.map[key]
    if entry != nil
        entry.value = value
        lru_touch(cache, key)
        return
    # Evict if at capacity
    if cache:len().list >= cache.capacity
        oldest = cache.list:remove()
        cache.map[oldest] = nil
    # Insert at front
    cache.list:insert(1, key)
    cache.map[key] = {key = key, value = value}

lru_touch = (cache: any, key: any)
    i = 1
    while i <= cache:len().list
        if cache.list[i] == key
            cache.list:remove(i)
            cache.list:insert(1, key)
            return
        i += 1

lru_remove: bool = (cache: any, key: any)
    entry = cache.map[key]
    if entry == nil return false 
    cache.map[key] = nil
    i = 1
    while i <= cache:len().list
        if cache.list[i] == key
            cache.list:remove(i)
            return true
        i += 1
    false

lru_size: i64 = (cache: any)
    cache.list:len()

lru_hit_rate: f64 = (cache: any)
    total = cache.hits + cache.misses
    if total == 0 return 0.0 
    cache.hits / total

lru_clear = (cache: any)
    cache.map = {}
    cache.list = {}
    cache.hits = 0
    cache.misses = 0

