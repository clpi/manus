# graphics.font — Font rendering and text layout
# For rendering text in ward's graphics pipeline.

# ═══════════════════════════════════════════════════════════════
# Font Config
# ═══════════════════════════════════════════════════════════════

config_new: any = ()
    {
        path = "",
        size = 16,
        dpi = 72,
        antialiasing = "gray",  # "none", "gray", "lcd"
        hinting = "normal",  # "none", "slight", "normal"
    }

# ═══════════════════════════════════════════════════════════════
# Glyph
# ═══════════════════════════════════════════════════════════════

glyph_new: any = (char: str)
    {
        char = char,
        codepoint = char:byte(),
        width = 0,
        height = 0,
        advance_x = 0,
        advance_y = 0,
        bearing_x = 0,
        bearing_y = 0,
        bitmap = {},
    }

# ═══════════════════════════════════════════════════════════════
# Font
# ═══════════════════════════════════════════════════════════════

font_new: any = (config: any)
    {
        config = config,
        glyphs = {},
        ascender = 0,
        descender = 0,
        line_height = 0,
        loaded = false,
    }

font_load: any = (font: any)
    # Load font with proper metrics
    if font.config.size == nil font.config.size = 16 
    
    # Standard font metrics (ascent/descent ratios)
    font.ascender = font.config.size * 0.8:floor()
    font.descender = -font.config.size * 0.2:floor()
    font.line_height = font.ascender - font.descender
    font.loaded = true
    
    # Pre-cache common characters
    common_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,;:!?-"
    i = 1
    while i <= common_chars:len()
        char = common_chars:sub(i, i)
        font_get_glyph(font, char)
        i += 1
    
    {ok = true}

font_get_glyph: any = (font: any, char: str)
    codepoint = char:byte()
    if font.glyphs[codepoint]
        return font.glyphs[codepoint]

    # Generate glyph with character-appropriate metrics
    glyph = glyph_new(char)
    
    # Character width varies by type
    if codepoint >= 65 and codepoint <= 90
        # Uppercase A-Z: wider
        glyph.width = font.config.size * 0.7:floor()
    elseif codepoint >= 97 and codepoint <= 122
        # Lowercase a-z: medium
        glyph.width = font.config.size * 0.55:floor()
    elseif codepoint >= 48 and codepoint <= 57
        # Digits 0-9: medium-wide
        glyph.width = font.config.size * 0.6:floor()
    elseif codepoint == 32
        # Space: half width
        glyph.width = font.config.size * 0.3:floor()
    elseif codepoint == 46 or codepoint == 44 or codepoint == 39
        # Punctuation: narrow
        glyph.width = font.config.size * 0.2:floor()
    else
        # Default: medium
        glyph.width = font.config.size * 0.5:floor()
    
    glyph.height = font.config.size
    glyph.advance_x = glyph.width + font.config.size * 0.1:floor()
    glyph.bearing_x = 0
    glyph.bearing_y = font.ascender

    # Generate bitmap with anti-aliased edges
    y = 1
    while y <= glyph.height
        x = 1
        while x <= glyph.width
            alpha = 255
            # Anti-alias edges
            if x == 1 or x == glyph.width
                alpha = 200
            if y == 1 or y == glyph.height
                alpha = 180
            # Corners
            if (x == 1 or x == glyph.width) and (y == 1 or y == glyph.height)
                alpha = 128
            glyph.bitmap[(y - 1) * glyph.width + x] = alpha
            x += 1
        y += 1

    font.glyphs[codepoint] = glyph
    glyph

font_measure_text: any = (font: any, text: str)
    x = 0
    max_x = 0
    y = 0
    max_y = font.line_height

    i = 1
    while i <= text:len()
        char = text:sub(i, i)
        glyph = font_get_glyph(font, char)
        x += glyph.advance_x
        if x > max_x max_x = x 
        i += 1

    {
        width = max_x,
        height = max_y,
    }

# ═══════════════════════════════════════════════════════════════
# Text Layout
# ═══════════════════════════════════════════════════════════════

layout_new: any = (font: any)
    {
        font = font,
        lines = {},
        current_line = {},
        cursor_x = 0,
        cursor_y = 0,
    }

layout_add_text = (layout: any, text: str)
    i = 1
    while i <= text:len()
        char = text:sub(i, i)
        if char == "\n"
            layout.lines[layout:len().lines + 1] = layout.current_line
            layout.current_line = {}
            layout.cursor_x = 0
            layout.cursor_y = layout.cursor_y + layout.font.line_height
        else
            glyph = font_get_glyph(layout.font, char)
            layout.current_line[layout:len().current_line + 1] = {
                glyph = glyph,
                x = layout.cursor_x,
                y = layout.cursor_y,
            }
            layout.cursor_x += glyph.advance_x
        i += 1

layout_get_glyphs: any = (layout: any)
    glyphs = {}
    for line in layout.lines
        for item in line
            glyphs[glyphs:len() + 1] = item
    for item in layout.current_line
        glyphs[glyphs:len() + 1] = item
    glyphs

layout_get_size: any = (layout: any)
    max_x = 0
    for line in layout.lines
        line_width = 0
        for item in line
            line_width += item.glyph.advance_x
        if line_width > max_x max_x = line_width 
    if layout.cursor_x > max_x max_x = layout.cursor_x 

    {
        width = max_x,
        height = layout.cursor_y + layout.font.line_height,
    }

# ═══════════════════════════════════════════════════════════════
# Text Rendering
# ═══════════════════════════════════════════════════════════════

render_text: any = (font: any, text: str, x: f64, y: f64, color: any)
    layout = layout_new(font)
    layout_add_text(layout, text)

    render_items = {}
    for glyph in layout_get_glyphs(layout)
        render_items[render_items:len() + 1] = {
            x += glyph.x,
            y += glyph.y,
            glyph = glyph.glyph,
            color = color,
        }

    {
        items = render_items,
        size = layout_get_size(layout),
    }

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

