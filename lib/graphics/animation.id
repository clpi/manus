# graphics.animation — Animation and keyframe system
# For character animation, procedural motion, and visual effects.

# ═══════════════════════════════════════════════════════════════
# Keyframe
# ═══════════════════════════════════════════════════════════════

keyframe_new: any = (time: f64, value: any)
    {
        time = time,
        value = value,
        easing = "linear",
    }

keyframe_set_easing: any = (kf: any, easing: str)
    kf.easing = easing
    kf

# ═══════════════════════════════════════════════════════════════
# Animation Curve
# ═══════════════════════════════════════════════════════════════

curve_new: any = (name: str)
    {
        name = name,
        keyframes = {},
        duration = 0,
        loop = false,
        ping_pong = false,
    }

curve_add_keyframe = (curve: any, time: f64, value: any)
    kf = keyframe_new(time, value)
    curve.keyframes[curve.keyframes:len() + 1] = kf

    # Sort by time
    curve.keyframes:sort((a: any, b: any) a.time < b.time)

    # Update duration
    if time > curve.duration
        curve.duration = time

curve_set_keyframe_easing = (curve: any, index: i64, easing: str)
    if curve.keyframes[index]
        curve.keyframes[index].easing = easing

curve_evaluate: any = (curve: any, time: f64)
    if curve.keyframes:len() == 0 return nil
    if curve.keyframes:len() == 1 return curve.keyframes[1].value

    # Handle loop/ping-pong
    if curve.loop
        time = time % curve.duration
    elseif curve.ping_pong
        cycle = time / curve.duration:floor()
        time = time % curve.duration
        if cycle % 2 == 1
            time = curve.duration - time

    # Find surrounding keyframes
    prev = curve.keyframes[1]
    nxt = curve.keyframes[curve.keyframes:len()]

    for i = 1, curve.keyframes:len() - 1
        if time >= curve.keyframes[i].time and time <= curve.keyframes[i + 1].time
            prev = curve.keyframes[i]
            nxt = curve.keyframes[i + 1]
            break

    # Calculate interpolation factor
    if nxt.time == prev.time return prev.value
    t = (time - prev.time) / (nxt.time - prev.time)

    # Apply easing
    t = apply_easing(t, nxt.easing)

    # Interpolate value
    interpolate_values(prev.value, nxt.value, t)

curve_get_duration: f64 = (curve: any)
    curve.duration

curve_set_loop = (curve: any, loop: bool)
    curve.loop = loop

curve_set_ping_pong = (curve: any, ping_pong: bool)
    curve.ping_pong = ping_pong

# ═══════════════════════════════════════════════════════════════
# Animation Clip
# ═══════════════════════════════════════════════════════════════

clip_new: any = (name: str)
    {
        name = name,
        curves = {},
        duration = 0,
        fps = 30,
    }

clip_add_curve = (clip: any, curve: any)
    clip.curves[curve.name] = curve
    if curve.duration > clip.duration
        clip.duration = curve.duration

clip_evaluate: any = (clip: any, time: f64)
    result = {}
    for name, curve in clip.curves
        result[name] = curve_evaluate(curve, time)
    result

clip_set_fps = (clip: any, fps: i64)
    clip.fps = fps

# ═══════════════════════════════════════════════════════════════
# Animation Player
# ═══════════════════════════════════════════════════════════════

player_new: any = ()
    {
        clips = {},
        current_clip = nil,
        current_time = 0,
        playing = false,
        speed = 1.0,
        callbacks = {},
    }

player_add_clip = (player: any, clip: any)
    player.clips[clip.name] = clip

player_play = (player: any, clip_name: str, start_time: f64)
    player.current_clip = clip_name
    player.current_time = start_time or 0
    player.playing = true

player_stop = (player: any)
    player.playing = false

player_pause = (player: any)
    player.playing = false

player_resume = (player: any)
    player.playing = true

player_set_speed = (player: any, speed: f64)
    player.speed = speed

player_update: any = (player: any, delta_time: f64)
    if not player.playing or player.current_clip == nil return nil

    clip = player.clips[player.current_clip]
    if clip == nil return nil

    player.current_time += delta_time * player.speed

    # Handle end of clip
    if player.current_time > clip.duration
        if clip.curves and next(clip.curves)
            # Check if any curve loops
            for curve in clip.curves
                if curve.loop
                    player.current_time = player.current_time % clip.duration
                    break
        else
            player.current_time = clip.duration
            player.playing = false

    # Evaluate clip
    result = clip_evaluate(clip, player.current_time)

    # Trigger callbacks
    for callback in player.callbacks
        callback(result, player.current_time)

    result

player_add_callback = (player: any, callback: any)
    player.callbacks[player.callbacks:len() + 1] = callback

player_get_time: f64 = (player: any)
    player.current_time

player_is_playing: bool = (player: any)
    player.playing

# ═══════════════════════════════════════════════════════════════
# Animation State Machine
# ═══════════════════════════════════════════════════════════════

state_machine_new: any = ()
    {
        states = {},
        current_state = nil,
        transitions = {},
    }

state_machine_add_state = (sm: any, name: str, clip_name: str)
    sm.states[name] = {
        clip_name = clip_name,
        transitions = {},
    }

state_machine_add_transition = (sm: any, from: str, to: str, condition: any)
    if sm.transitions[from] == nil
        sm.transitions[from] = {}
    sm.transitions[from][sm.transitions[from]:len() + 1] = {
        to = to,
        condition = condition,
    }

state_machine_set_state = (sm: any, state_name: str)
    sm.current_state = state_name

state_machine_update: any = (sm: any, params: any)
    if sm.current_state == nil return nil

    # Check transitions
    transitions = sm.transitions[sm.current_state]
    if transitions
        for transition in transitions
            if transition.condition(params)
                sm.current_state = transition.to
                return {
                    transition = true,
                    from = sm.current_state,
                    to = transition.to,
                }

    # Return current state info
    state = sm.states[sm.current_state]
    {
        state = sm.current_state,
        clip_name = state.clip_name,
    }

# ═══════════════════════════════════════════════════════════════
# Procedural Animation
# ═══════════════════════════════════════════════════════════════

procedural_sine: f64 = (time: f64, frequency: f64, amplitude: f64, phase: f64)
    if frequency == nil frequency = 1
    if amplitude == nil amplitude = 1
    if phase == nil phase = 0
    amplitude * 2 * math.pi * frequency * time + phase:sin()

procedural_noise: f64 = (time: f64, frequency: f64, amplitude: f64)
    # Value noise using hash-based interpolation
    if frequency == nil frequency = 1
    if amplitude == nil amplitude = 1

    t = time * frequency
    # Integer and fractional parts
    i0 = t:floor()
    frac = t - i0

    # Smoothstep interpolation (ease-in-out)
    fade = frac * frac * (3 - 2 * frac)

    # Hash function for pseudo-random values at integer points
    _hash: f64 = (n: i64)
        h = (n * 2654435761) & 0xFFFFFFFF
        h = ((h >> 16) ~ h) & 0xFFFFFFFF
        (h & 0xFFFF) / 65535.0

    v0 = _hash(i0)
    v1 = _hash(i0 + 1)

    amplitude * (v0 + fade * (v1 - v0))

procedural_bounce: f64 = (time: f64, period: f64, height: f64)
    if period == nil period = 1
    if height == nil height = 1
    t = time % period
    # Parabola
    height * (1 - (2 * t / period - 1) ^ 2)

procedural_wobble: f64 = (time: f64, frequency: f64, damping: f64)
    if frequency == nil frequency = 5
    if damping == nil damping = 2 end
    -damping * time:exp() * 2 * math.pi * frequency * time:cos()

# ═══════════════════════════════════════════════════════════════
# Utility Functions
# ═══════════════════════════════════════════════════════════════

apply_easing: f64 = (t: f64, easing: str)
    if easing == "linear" return t
    if easing == "ease_in" return t * t
    if easing == "ease_out" return t * (2 - t)
    if easing == "ease_in_out"
        if t < 0.5
            return 2 * t * t
        else
            return -1 + (4 - 2 * t) * t
    if easing == "bounce"
        if t < 0.5
            return 4 * t * t
        else
            t -= 0.5
            return 1 - 8 * t * t + 2 * t
    t

interpolate_values: any = (a: any, b: f64, t: f64)
    if type(a) == "number"
        return a + (b - a) * t
    elseif type(a) == "table"
        result = {}
        for k, v in a
            if b[k]
                result[k] = v + (b[k] - v) * t
            else
                result[k] = v
        return result
    a

