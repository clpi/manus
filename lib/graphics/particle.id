# graphics.particle — Particle systems
# For visual effects, explosions, rain, fire, and other phenomena.

# ═══════════════════════════════════════════════════════════════
# Particle
# ═══════════════════════════════════════════════════════════════

particle_new(): any
    {
        position = {x = 0, y = 0, z = 0},
        velocity = {x = 0, y = 0, z = 0},
        acceleration = {x = 0, y = 0, z = 0},
        color = {r = 1, g = 1, b = 1, a = 1},
        size = 1,
        rotation = 0,
        angular_velocity = 0,
        lifetime = 1,
        age = 0,
        alive = true,
    }
end

# ═══════════════════════════════════════════════════════════════
# Emitter Configuration
# ═══════════════════════════════════════════════════════════════

emitter_config_new(): any
    {
        position = {x = 0, y = 0, z = 0},
        spread = {x = 1, y = 1, z = 1},
        direction = {x = 0, y = 1, z = 0},
        speed = {min = 5, max = 10},
        lifetime = {min = 0.5, max = 2},
        size = {min = 0.1, max = 0.5},
        rotation = {min = 0, max = 360},
        angular_velocity = {min = -90, max = 90},
        colors = {
            {r = 1, g = 0.8, b = 0, a = 1},
            {r = 1, g = 0.3, b = 0, a = 0},
        },
        rate = 10,
        burst = 0,
        gravity = {x = 0, y = -9.8, z = 0},
        drag = 0.1,
        start_offset = 0,
    }
end

emitter_config_set_position(config: any, x: f64, y: f64, z: f64): void
    config.position = {x = x, y = y, z = z}
end

emitter_config_set_spread(config: any, x: f64, y: f64, z: f64): void
    config.spread = {x = x, y = y, z = z}
end

emitter_config_set_speed(config: any, min: f64, max: f64): void
    config.speed = {min = min, max = max}
end

emitter_config_set_lifetime(config: any, min: f64, max: f64): void
    config.lifetime = {min = min, max = max}
end

emitter_config_set_colors(config: any, colors: any): void
    config.colors = colors
end

emitter_config_set_rate(config: any, rate: f64): void
    config.rate = rate
end

emitter_config_set_burst(config: any, count: i64): void
    config.burst = count
end

emitter_config_set_gravity(config: any, x: f64, y: f64, z: f64): void
    config.gravity = {x = x, y = y, z = z}
end

# ═══════════════════════════════════════════════════════════════
# Particle Emitter
# ═══════════════════════════════════════════════════════════════

emitter_new(config: any): any
    {
        config = config,
        particles = {},
        time_since_emission = 0,
        active = true,
    }
end

emitter_emit(emitter: any): any
    config = emitter.config
    particle = particle_new()

    # Randomize position within spread
    particle.position = {
        x = config.position.x + (math.random() - 0.5) * config.spread.x,
        y = config.position.y + (math.random() - 0.5) * config.spread.y,
        z = config.position.z + (math.random() - 0.5) * config.spread.z,
    }

    # Randomize velocity
    speed = config.speed.min + math.random() * (config.speed.max - config.speed.min)
    angle = math.random() * 2 * math.pi
    elevation = (math.random() - 0.5) * math.pi * config.spread.y

    particle.velocity = {
        x = config.direction.x + angle:cos() * elevation:cos() * speed,
        y = config.direction.y + elevation:sin() * speed,
        z = config.direction.z + angle:sin() * elevation:cos() * speed,
    }

    # Randomize properties
    particle.lifetime = config.lifetime.min + math.random() * (config.lifetime.max - config.lifetime.min)
    particle.size = config.size.min + math.random() * (config.size.max - config.size.min)
    particle.rotation = config.rotation.min + math.random() * (config.rotation.max - config.rotation.min)
    particle.angular_velocity = config.angular_velocity.min + math.random() * (config.angular_velocity.max - config.angular_velocity.min)

    # Interpolate color
    if config:len().colors >= 2
        t = math.random()
        c1 = config.colors[1]
        c2 = config.colors[config:len().colors]
        particle.color = {
            r = c1.r + (c2.r - c1.r) * t,
            g = c1.g + (c2.g - c1.g) * t,
            b = c1.b + (c2.b - c1.b) * t,
            a = c1.a + (c2.a - c1.a) * t,
        }
    end

    particle.acceleration = config.gravity
    emitter.particles[emitter:len().particles + 1] = particle
    particle
end

emitter_update(emitter: any, delta_time: f64): void
    if not emitter.active return end

    config = emitter.config

    # Emit new particles
    emitter.time_since_emission = emitter.time_since_emission + delta_time
    if emitter.time_since_emission >= 1 / config.rate
        emitter_emit(emitter)
        emitter.time_since_emission = 0
    end

    # Burst
    if config.burst > 0
        i = 0
        while i < config.burst
            emitter_emit(emitter)
            i += 1
        end
        config.burst = 0
    end

    # Update particles
    i = 1
    while i <= emitter:len().particles
        p = emitter.particles[i]
        p.age = p.age + delta_time

        if p.age >= p.lifetime
            p.alive = false
            emitter.particles:remove(i)
        else
            # Update velocity with acceleration
            p.velocity.x = p.velocity.x + p.acceleration.x * delta_time
            p.velocity.y = p.velocity.y + p.acceleration.y * delta_time
            p.velocity.z = p.velocity.z + p.acceleration.z * delta_time

            # Apply drag
            drag = 1 - config.drag * delta_time
            p.velocity.x = p.velocity.x * drag
            p.velocity.y = p.velocity.y * drag
            p.velocity.z = p.velocity.z * drag

            # Update position
            p.position.x = p.position.x + p.velocity.x * delta_time
            p.position.y = p.position.y + p.velocity.y * delta_time
            p.position.z = p.position.z + p.velocity.z * delta_time

            # Update rotation
            p.rotation = p.rotation + p.angular_velocity * delta_time

            i += 1
        end
    end
end

emitter_get_particles(emitter: any): any
    emitter.particles
end

emitter_clear(emitter: any): void
    emitter.particles = {}
end

emitter_set_active(emitter: any, active: bool): void
    emitter.active = active
end

emitter_particle_count(emitter: any): i64
    emitter.particles:len()
end

# ═══════════════════════════════════════════════════════════════
# Particle System
# ═══════════════════════════════════════════════════════════════

system_new(): any
    {
        emitters = {},
        max_particles = 10000,
    }
end

system_add_emitter(system: any, emitter: any): void
    system.emitters[system:len().emitters + 1] = emitter
end

system_update(system: any, delta_time: f64): void
    total_particles = 0
    for emitter in system.emitters
        emitter_update(emitter, delta_time)
        total_particles += emitter_particle_count(emitter)
    end
end

system_get_all_particles(system: any): any
    particles = {}
    for emitter in system.emitters
        for p in emitter_get_particles(emitter)
            particles[particles:len() + 1] = p
        end
    end
    particles
end

system_clear(system: any): void
    for emitter in system.emitters
        emitter_clear(emitter)
    end
end

system_total_count(system: any): i64
    count = 0
    for emitter in system.emitters
        count += emitter_particle_count(emitter)
    end
    count
end

