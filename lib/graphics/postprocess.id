    }
  }
# "reinhard", "aces", "linear"

# ═══════════════════════════════════════════════════════════════
# Bloom
# ═══════════════════════════════════════════════════════════════

bloom_extract_bright: any = (image: any, threshold: f64)
  width = image.width
  height = image.height
  channels = image.channels
  
result = {}
  i = 1
  while i <= image:len().data
    if channels >= 3
      r = image.data[i]
      g = image.data[i + 1]
      b = image.data[i + 2]
      luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b
      if luminance / 255 > threshold
        result[i] = r
        result[i + 1] = g
        result[i + 2] = b
      else
        result[i] = 0
        result[i + 1] = 0
        result[i + 2] = 0
    i = i + channels
  
{
    width = width,
    height = height,
    channels = channels,
    data = result
  }

bloom_blur: any = (image: any, radius: i64)
  # Separable Gaussian blur (two-pass: horizontal then vertical)
  width = image.width
  height = image.height
  channels = image.channels
  
# Build 1D Gaussian kernel
  sigma = radius / 3.0
  if sigma < 0.5
    sigma = 0.5
  kernel = {}
  kernel_sum = 0.0
  i = -radius
  while i <= radius
    val = -(i * i) / 2 * sigma * sigma:exp()
    kernel[i + radius + 1] = val
    kernel_sum = kernel_sum + val
    i = i + 1
  # Normalize kernel
  i = 1
  while i <= kernel:len()
    kernel[i] = kernel[i] / kernel_sum
    i = i + 1
  
# Horizontal pass
  temp = {}
  y = 0
  while y < height
    x = 0
    while x < width
      r_sum = 0.0
      g_sum = 0.0
      b_sum = 0.0
      k_idx = 1
      dx = -radius
      while dx <= radius
        nx = x + dx
        if nx < 0
          nx = 0
        if nx >= width
          nx = width - 1
        idx = (y * width + nx) * channels + 1
        w = kernel[k_idx]
        if channels >= 3
          r_sum = r_sum + image.data[idx] * w
          g_sum = g_sum + image.data[idx + 1] * w
          b_sum = b_sum + image.data[idx + 2] * w
        k_idx = k_idx + 1
        dx = dx + 1
      idx = (y * width + x) * channels + 1
      temp[idx] = r_sum
      temp[idx + 1] = g_sum
      temp[idx + 2] = b_sum
      x = x + 1
    y = y + 1
  
# Vertical pass
  result = {}
  y = 0
  while y < height
    x = 0
    while x < width
      r_sum = 0.0
      g_sum = 0.0
      b_sum = 0.0
      k_idx = 1
      dy = -radius
      while dy <= radius
        ny = y + dy
        if ny < 0
          ny = 0
        if ny >= height
          ny = height - 1
        idx = (ny * width + x) * channels + 1
        w = kernel[k_idx]
        if channels >= 3
          r_sum = r_sum + temp[idx] * w
          g_sum = g_sum + temp[idx + 1] * w
          b_sum = b_sum + temp[idx + 2] * w
        k_idx = k_idx + 1
        dy = dy + 1
      idx = (y * width + x) * channels + 1
      result[idx] = r_sum
      result[idx + 1] = g_sum
      result[idx + 2] = b_sum
      x = x + 1
    y = y + 1
  
{
    width = width,
    height = height,
    channels = channels,
    data = result
  }

bloom_apply: any = (original: any, config: any)
  bright = bloom_extract_bright(original, config.threshold)
  blurred = bloom_blur(bright, config.radius)
  
# Add blurred bloom to original
  result = {}
  i = 1
  while i <= original:len().data
    result[i] = 255:min(original.data[i] + blurred.data[i] * config.intensity)
    if original.channels >= 3
      result[i + 1] = 255:min(original.data[i + 1] + blurred.data[i + 1] * config.intensity)
      result[i + 2] = 255:min(original.data[i + 2] + blurred.data[i + 2] * config.intensity)
    i = i + original.channels
  
{
    width = original.width,
    height = original.height,
    channels = original.channels,
    data = result
  }

# ═══════════════════════════════════════════════════════════════
# Tone Mapping
# ═══════════════════════════════════════════════════════════════

tonemap_reinhard: any = (color: any)
  {
    r = color.r / (1 + color.r),
    g = color.g / (1 + color.g),
    b = color.b / (1 + color.b)
  }

tonemap_aces: any = (color: any)
  a = 2.51
  b = 0.03
  c = 2.43
  d = 0.59
  e = 0.14
  
clamp = (x)
    0:max(1:min(x))
  
{
    r = clamp(color.r * (a * color.r + b) / (color.r * (c * color.r + d) + e)),
    g = clamp(color.g * (a * color.g + b) / (color.g * (c * color.g + d) + e)),
    b = clamp(color.b * (a * color.b + b) / (color.b * (c * color.b + d) + e))
  }

tonemap_linear: any = (color: any, exposure: f64)
  {
    r = 1 - -color.r * exposure:exp(),
    g = 1 - -color.g * exposure:exp(),
    b = 1 - -color.b * exposure:exp()
  }

# ═══════════════════════════════════════════════════════════════
# FXAA (Fast Approximate Anti-Aliasing)
# ═══════════════════════════════════════════════════════════════

fxaa_luminance: f64 = (r: f64, g: f64, b: f64)
  0.2126 * r + 0.7152 * g + 0.0722 * b

fxaa_process: any = (image: any, config: any)
  width = image.width
  height = image.height
  channels = image.channels
  result = {}
  
y = 1
  while y < height - 1
    x = 1
    while x < width - 1
      idx = (y * width + x) * channels + 1
      
# Get 3x3 neighborhood luminance
      n = {}
      dy = -1
      while dy <= 1
        dx = -1
        while dx <= 1
          nidx = ((y + dy) * width + x + dx) * channels + 1
          if channels >= 3
            n[(dy + 1) * 3 + dx + 1 + 1] = fxaa_luminance(image.data[nidx], image.data[nidx + 1], image.data[nidx + 2])
          dx = dx + 1
        dy = dy + 1
      
# Simple edge detection
      edge_h = n[1] - n[7]:abs() + 2 * n[2] - n[8]:abs() + n[3] - n[9]:abs()
      edge_v = n[1] - n[3]:abs() + 2 * n[4] - n[6]:abs() + n[7] - n[9]:abs()
      
# Blend based on edge
      if edge_h > config.edge_threshold or edge_v > config.edge_threshold
        # Apply simple blur
        i = 0
        while i < channels
          result[result:len() + 1] = (image.data[idx + i] * 4 + image.data[idx - channels + i] + image.data[idx + channels + i] + image.data[idx - 1 + i] + image.data[idx + 1 + i]) / 8
          i = i + 1
      else
        i = 0
        while i < channels
          result[result:len() + 1] = image.data[idx + i]
          i = i + 1
      
x = x + 1
    y = y + 1
  
{
    width = width,
    height = height,
    channels = channels,
    data = result
  }

# ═══════════════════════════════════════════════════════════════
# Vignette
# ═══════════════════════════════════════════════════════════════

vignette_apply: any = (image: any, intensity: f64, smoothness: f64)
  width = image.width
  height = image.height
  channels = image.channels
  cx = width / 2
  cy = height / 2
  max_dist = cx * cx + cy * cy:sqrt()
  
result = {}
  y = 0
  while y < height
    x = 0
    while x < width
      dx = (x - cx) / cx
      dy = (y - cy) / cy
      dist = dx * dx + dy * dy:sqrt()
      vignette = 1 - smoothstep(1 - intensity, 1, dist) * smoothness
      
idx = (y * width + x) * channels + 1
      i = 0
      while i < channels
        result[result:len() + 1] = image.data[idx + i] * vignette
        i = i + 1
      x = x + 1
    y = y + 1
  
{
    width = width,
    height = height,
    channels = channels,
    data = result
  }

# ═══════════════════════════════════════════════════════════════
# Film Grain
# ═══════════════════════════════════════════════════════════════

film_grain_apply: any = (image: any, intensity: f64)
  width = image.width
  height = image.height
  channels = image.channels
  
result = {}
  y = 0
  while y < height
    x = 0
    while x < width
      grain = (math.random() - 0.5) * intensity * 255
      
idx = (y * width + x) * channels + 1
      i = 0
      while i < channels
        result[result:len() + 1] = 0:max(255:min(image.data[idx + i] + grain))
        i = i + 1
      x = x + 1
    y = y + 1
  
{
    width = width,
    height = height,
    channels = channels,
    data = result
  }

# ═══════════════════════════════════════════════════════════════
# Utility Functions
# ═══════════════════════════════════════════════════════════════

smoothstep: f64 = (edge0: f64, edge1: f64, x: f64)
  t = 0:max(1:min((x - edge0) / (edge1 - edge0)))
  t * t * (3 - 2 * t)
