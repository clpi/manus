# graphics.postprocess — Post-processing effects
# For screen-space effects in ward's rendering pipeline.

# ═══════════════════════════════════════════════════════════════
# Post-process Config
# ═══════════════════════════════════════════════════════════════

config_new: any = ()
  {
    enabled = true,
    bloom = {
      enabled = false,
      threshold = 0.8,
      intensity = 0.5,
      radius = 4
    },
    tone_map = {
      enabled = false,
      mode = "aces",
      exposure = 1.0,
      gamma = 2.2
    },
    fxaa = {
      enabled = false,
      subpixel_quality = 0.75,
      edge_threshold = 0.166,
      edge_threshold_min = 0.0833
    },
    dof = {
      enabled = false,
      focal_distance = 10,
      focal_range = 5,
      blur_radius = 2
    },
    motion_blur = {
      enabled = false,
      intensity = 0.5,
      samples = 8
    },
    vignette = {
      enabled = false,
      intensity = 0.5,
      smoothness = 0.5
    },
    chromatic_aberration = {
      enabled = false,
      intensity = 0.01
    },
    film_grain = {
      enabled = false,
