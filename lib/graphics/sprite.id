new: any = (texture: any, x: f64, y: f64)
  {
    texture = texture,
    x = x,
    y = y,
    width = texture and texture.width or 0,
    height = texture and texture.height or 0,
    rotation = 0,
    scale_x = 1,
    scale_y = 1,
    pivot_x = 0.5,
    pivot_y = 0.5,
    color = {
      r = 1,
      g = 1,
      b = 1,
      a = 1
    },
    visible = true,
    flip_x = false,
    flip_y = false,
    z_order = 0
  }
set_position = (sprite: any, x: f64, y: f64)
  sprite.x = x
  sprite.y = y
set_scale = (sprite: any, sx: f64, sy: f64)
  sprite.scale_x = sx
  sprite.scale_y = sy or sx
set_rotation = (sprite: any, degrees: f64)
  sprite.rotation = degrees
set_color = (sprite: any, r: f64, g: f64, b: f64, a: f64)
  sprite.color =
    r = r
    g = g
    b = b
    a = a or 1
set_flip = (sprite: any, flip_x: bool, flip_y: bool)
  sprite.flip_x = flip_x
  sprite.flip_y = flip_y
sheet_new: any = (texture: any, frame_width: i64, frame_height: i64)
  cols = texture.width / frame_width:floor()
  rows = texture.height / frame_height:floor()
  frames = {}
  y = 0
  while y < rows
    x = 0
    while x < cols
      frames(frames:len() + 1) =
        x = x * frame_width
        y = y * frame_height
        width = frame_width
        height = frame_height
      x = x + 1
    y = y + 1
  {
    texture = texture,
    frame_width = frame_width,
    frame_height = frame_height,
    frames = frames
  }
sheet_get_frame: any = (sheet: any, index: i64)
  sheet.frames(index)
sheet_get_frame_count: i64 = (sheet: any)
  s:len()
  heet.frames
anim_new: any = (sheet: any, frame_indices: any, fps: f64)
  {
    sheet = sheet,
    frames = frame_indices,
    fps = fps or 12,
    current_frame = 1,
    elapsed = 0,
    playing = false,
    loop = true
  }
anim_play = (anim: any)
  anim.playing = true
  anim.current_frame = 1
  anim.elapsed = 0
anim_stop = (anim: any)
  anim.playing = false
anim_pause = (anim: any)
  anim.playing = false
anim_update = (anim: any, delta_time: f64)
  if not anim.playing
    return
  anim.elapsed = anim.elapsed + delta_time
  frame_duration = 1 / anim.fps
  if anim.elapsed >= frame_duration
    anim.elapsed = anim.elapsed - frame_duration
    anim.current_frame = anim.current_frame + 1
    if anim.current_frame > anim:len().frames
      if anim.loop
        anim.current_frame = 1
      else
        anim.current_frame = anim:len().frames
        anim.playing = false
anim_get_frame: any = (anim: any)
  frame_index = anim.frames(anim.current_frame)
  anim.sheet.frames(frame_index)
renderer_new: any = ()
  {
    sprites = {},
    sorted = false
  }
renderer_add = (renderer: any, sprite: any)
  renderer.sprites(renderer:len().sprites + 1) = sprite
  renderer.sorted = false
renderer_remove = (renderer: any, sprite: any)
  i = 1
  while i <= renderer:len().sprites
    if renderer.sprites(i) == sprite
      renderer.sprites:remove(i)
      return
    i = i + 1
renderer_sort = (renderer: any)
  renderer.sprites:sort(fun(a: any, b: any) -> any
    a.z_order < b.z_order
  end)
  renderer.sorted = true
renderer_render: any = (renderer: any)
  if not renderer.sorted
    renderer_sort(renderer)
  render_calls = {}
  for sprite in renderer.sprites
    if sprite.visible
      render_calls(render_calls:len() + 1) =
        texture = sprite.texture
        x = sprite.x
        y = sprite.y
        width = sprite.width * sprite.scale_x
        height = sprite.height * sprite.scale_y
        rotation = sprite.rotation
        color = sprite.color
        flip_x = sprite.flip_x
        flip_y = sprite.flip_y
        pivot_x = sprite.pivot_x
        pivot_y = sprite.pivot_y
  {
    calls = render_calls,
    count = render_calls:len()
  }
