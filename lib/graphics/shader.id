# graphics.shader — Shader compilation and management
# Data-structure API for WebGPU/Vulkan/Metal shaders.
# compile/link/use are no-ops in pure Duo — actual GPU compilation
# happens in the rendering backend (wgpu, Metal, Vulkan driver).

# ═══════════════════════════════════════════════════════════════
# Shader Types
# ═══════════════════════════════════════════════════════════════

M.SHADER_VERTEX = "vertex"
M.SHADER_FRAGMENT = "fragment"
M.SHADER_COMPUTE = "compute"

# ═══════════════════════════════════════════════════════════════
# Shader
# ═══════════════════════════════════════════════════════════════

shader_new: any = (shader_type: str, source: str)
  {
    type = shader_type,
    source = source,
    compiled = false,
    handle = nil
  }

shader_compile: any = (shader: any)
  # In production, would compile via WebGPU/Vulkan/Metal
  shader.compiled = true
  { ok = true }

shader_get_error: str = (shader: any)
  ""

# ═══════════════════════════════════════════════════════════════
# Shader Program
# ═══════════════════════════════════════════════════════════════

shader_program_new: any = ()
  {
    vertex_shader = nil,
    fragment_shader = nil,
    compute_shader = nil,
    linked = false,
    uniforms = {},
    handle = nil
  }

shader_program_attach = (program: any, shader: any)
  if shader.type == M.SHADER_VERTEX
    program.vertex_shader = shader
  else(shader.type == M.SHADER_FRAGMENT)
    program.fragment_shader = shader
  else(shader.type == M.SHADER_COMPUTE)
    program.compute_shader = shader

shader_program_link: any = (program: any)
  # In production, would link shader program
  program.linked = true
  { ok = true }

shader_program_use = (program: any)
  # In production, would bind program
  void

shader_program_get_uniform: any = (program: any, name: str)
  program.uniforms(name)

shader_program_set_uniform = (program: any, name: str, value: any)
  program.uniforms[name] = value

# ═══════════════════════════════════════════════════════════════
# Built-in Shaders
# ═══════════════════════════════════════════════════════════════

shader_basic_vertex: str = ()
  "        @vertex\n        fn vs_main(@location(0) position: vec3f) -> @builtin(position) vec4f {\n            return vec4f(position, 1.0);\n        }\n    "

shader_basic_fragment: str = ()
  "        @fragment\n        fn fs_main() -> @location(0) vec4f {\n            return vec4f(1.0, 1.0, 1.0, 1.0);\n        }\n    "

shader_pbr_vertex: str = ()
  "        struct Uniforms {\n            model: mat4x4f,\n            view: mat4x4f,\n            projection: mat4x4f,\n            normal_matrix: mat3x3f,\n        }\n        @group(0) @binding(0) var<uniform> uniforms: Uniforms;\n\n        struct VertexInput {\n            @location(0) position: vec3f,\n            @location(1) normal: vec3f,\n            @location(2) uv: vec2f,\n        }\n\n        struct VertexOutput {\n            @builtin(position) position: vec4f,\n            @location(0) world_position: vec3f,\n            @location(1) world_normal: vec3f,\n            @location(2) uv: vec2f,\n        }\n\n        @vertex\n        fn vs_main(input: VertexInput): VertexOutput {\n            var output: VertexOutput;\n            output.world_position = (uniforms.model * vec4f(input.position, 1.0)).xyz;\n            output.world_normal = uniforms.normal_matrix * input.normal;\n            output.uv = input.uv;\n            output.position = uniforms.projection * uniforms.view * vec4f(output.world_position, 1.0);\n            return output;\n        }\n    "

shader_pbr_fragment: str = ()
  "        struct Material {\n            albedo: vec4f,\n            metallic: f32,\n            roughness: f32,\n            ao: f32,\n            emissive: vec3f,\n        }\n        @group(1) @binding(0) var<uniform> material: Material;\n        @group(1) @binding(1) var albedo_texture: texture_2d<f32>;\n        @group(1) @binding(2) var albedo_sampler: sampler;\n\n        struct Light {\n            position: vec3f,\n            color: vec3f,\n            intensity: f32,\n        }\n        @group(2) @binding(0) var<uniform> light: Light;\n\n        @fragment\n        fn fs_main(\n            @location(0) world_position: vec3f,\n            @location(1) world_normal: vec3f,\n            @location(2) uv: vec2f,\n        ) -> @location(0) vec4f {\n            let albedo = textureSample(albedo_texture, albedo_sampler, uv).rgb * material.albedo.rgb;\n            let n = normalize(world_normal);\n            let v = normalize(-world_position);\n            let l = normalize(light.position - world_position);\n            let h = normalize(v + l);\n\n            let n_dot_l = max(dot(n, l), 0.0);\n\n            return vec4f(albedo * light.color * light.intensity * n_dot_l, material.albedo.a);\n        }\n    "

# ═══════════════════════════════════════════════════════════════
# Shader Presets
# ═══════════════════════════════════════════════════════════════

shader_preset_basic: any = ()
  program = shader_program_new()
  shader_program_attach(program, shader_new(M.SHADER_VERTEX, shader_basic_vertex()))
  shader_program_attach(program, shader_new(M.SHADER_FRAGMENT, shader_basic_fragment()))
  shader_program_link(program)
  program

shader_preset_pbr: any = ()
  program = shader_program_new()
  shader_program_attach(program, shader_new(M.SHADER_VERTEX, shader_pbr_vertex()))
  shader_program_attach(program, shader_new(M.SHADER_FRAGMENT, shader_pbr_fragment()))
  shader_program_link(program)
  program

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════

M.new = shader_new
M.compile = shader_compile
M.get_error = shader_get_error
M.program_new = shader_program_new
M.program_attach = shader_program_attach
M.program_link = shader_program_link
M.program_use = shader_program_use
M.program_get_uniform = shader_program_get_uniform
M.program_set_uniform = shader_program_set_uniform
M.basic_vertex = shader_basic_vertex
M.basic_fragment = shader_basic_fragment
M.pbr_vertex = shader_pbr_vertex
M.pbr_fragment = shader_pbr_fragment
M.preset_basic = shader_preset_basic
M.preset_pbr = shader_preset_pbr
M
