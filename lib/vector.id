
WORD_W = 3.0
NGRAM_W = 1.0

hash32: i64 = (s: str)
  h = 5381
  n = s:len()
  i = 1
  while i <= n
    h = (h * 33 + s:byte(i)) % 4294967296
    i = i + 1
  h

tokens: any = (text: str)
  out = {}
  if text == nil
    return out
  n = text:len()
  i = 1
  cur = ""
  while i <= n
    c = text:byte(i)
    digit = c >= 48 and c <= 57
    upper = c >= 65 and c <= 90
    lower = c >= 97 and c <= 122
    if digit or upper or lower
      cur = cur .. c:char()
    else
      if cur:len() >= 2
        out[out:len() + 1] = cur:lower()
      cur = ""
    i = i + 1
  if cur:len() >= 2
    out[out:len() + 1] = cur:lower()
  out

trigrams: any = (token: str)
  out = {}
  if token == nil
    return out
  s = "^" .. token .. "$"
  n = s:len()
  if n < 3
    return out
  i = 1
  while i <= n - 2
    out[out:len() + 1] = s:sub(i, i + 2)
    i = i + 1
  out

embed: any = (text: str, dim: i64)
  vec = {}
  for _, word in tokens(text)
    widx = hash32(word) % dim
    wk = "f" .. widx
    vec[wk] = (vec[wk] or 0) + WORD_W
    for _, tg in trigrams(word)
      gidx = hash32(tg) % dim
      gk = "f" .. gidx
      vec[gk] = (vec[gk] or 0) + NGRAM_W
  sumsq = 0.0
  for k, w in vec
    sumsq = sumsq + w * w
  vec.norm = sumsq:sqrt() * 1000000 + 0.5:floor()
  vec.dim = dim
  vec

cosine: float = (q: any, s: any)
  if q == nil or s == nil
    return 0.0
  if q.norm == 0 or s.norm == 0
    return 0.0
  dot = 0.0
  for k, qw in q
    if k != "norm" and k != "dim"
      sw = s[k]
      if sw != nil
        dot = dot + qw * sw
  dot / q.norm / 1000000.0 * s.norm / 1000000.0

rank: any = (q: any, records: any, topk: i64)
  all = {}
  for _, rec in records
    sc = cosine(q, rec.vec)
    if sc > 0
      all[all:len() + 1] =
        name = rec.name
        file = rec.file
        kind = rec.kind
        doc = rec.doc
        score = sc
  n = all:len()
  k = topk
  if k > n
    k = n
  if k < 0
    k = 0
  out = {}
  taken = {}
  round = 1
  while round <= k
    besti = 0
    bestsc = -1.0
    i = 1
    while i <= n
      if taken[i] == nil
        if all[i].score > bestsc
          bestsc = all[i].score
          besti = i
      i = i + 1
    if besti == 0
      break
    taken[besti] = true
    out[out:len() + 1] = all[besti]
    round = round + 1
  out

M =
  hash32 = hash32
  tokens = tokens
  trigrams = trigrams
  embed = embed
  cosine = cosine
  rank = rank
