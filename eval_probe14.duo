line = "fun add_i32(a: i32, b: i32): i32 a + b end"
mname, mblob = string.match(line, "^%s*fun%s+([%w_]+)(%b())")
print("mname=[" .. tostring(mname) .. "] mblob=[" .. tostring(mblob) .. "]")
inner = string.sub(mblob, 2, #mblob - 1)
print("inner=[" .. inner .. "]")
pset = {}
for p in string.gmatch(inner, "%s*([^,]+)") do
    pt = string.match(p, "^%s*[%w_]+%s*:%s*([%w_]+)%s*$")
    print("p=[" .. tostring(p) .. "] pt=[" .. tostring(pt) .. "]")
    if pt ~= nil then pset[pt] = 1 end
end
print("pset has entries")
ptypes_csv = ""
first = 1
for pt2, _ in pset do
    print("pt2=[" .. tostring(pt2) .. "]")
    if first == 1 then ptypes_csv = pt2; first = 0 else ptypes_csv = ptypes_csv .. "," .. pt2 end
end
print("ptypes_csv=[" .. ptypes_csv .. "]")
