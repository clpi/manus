-- ward/src/wasm/stack.duo — Operand + control stack
-- Pre-allocated fixed arrays. All ops inline to single pointer derefs.

fun stack_new(capacity: i64)
    ptr = __emit("calloc(capacity, sizeof(int64_t))")
    return { ptr = ptr, sp = 0, cap = capacity }
end

--- @inline
fun stack_push(s, val: i64)
    __emit("((int64_t*)s.as.tval)[s_sp] = val")
    s.sp = s.sp + 1
end

--- @inline
fun stack_pop(s): i64
    s.sp = s.sp - 1
    return __emit("((int64_t*)s.as.tval)[s_sp]")
end

--- @inline
fun stack_peek(s): i64
    return __emit("((int64_t*)s.as.tval)[s_sp - 1]")
end

--- @inline
fun stack_peek_at(s, offset: i64): i64
    return __emit("((int64_t*)s.as.tval)[s_sp - 1 - offset]")
end

-- Control stack: stores (pc, arity, stack_height) triples
fun ctrl_new(capacity: i64)
    ptr = __emit("calloc(capacity * 3, sizeof(int64_t))")
    return { ptr = ptr, depth = 0, cap = capacity }
end

--- @inline
fun ctrl_push(cs, pc: i64, arity: i64, stack_h: i64)
    base: i64 = cs.depth * 3
    __emit("((int64_t*)cs.as.tval)[base] = pc")
    __emit("((int64_t*)cs.as.tval)[base+1] = arity")
    __emit("((int64_t*)cs.as.tval)[base+2] = stack_h")
    cs.depth = cs.depth + 1
end

--- @inline
fun ctrl_pop(cs)
    cs.depth = cs.depth - 1
    base: i64 = cs.depth * 3
    pc: i64 = __emit("((int64_t*)cs.as.tval)[base]")
    arity: i64 = __emit("((int64_t*)cs.as.tval)[base+1]")
    stack_h: i64 = __emit("((int64_t*)cs.as.tval)[base+2]")
    return pc, arity, stack_h
end

--- @inline
fun ctrl_peek(cs)
    base: i64 = (cs.depth - 1) * 3
    return __emit("((int64_t*)cs.as.tval)[base]"),
           __emit("((int64_t*)cs.as.tval)[base+1]"),
           __emit("((int64_t*)cs.as.tval)[base+2]")
end

M = {}
M.stack_new = stack_new
M.stack_push = stack_push
M.stack_pop = stack_pop
M.stack_peek = stack_peek
M.stack_peek_at = stack_peek_at
M.ctrl_new = ctrl_new
M.ctrl_push = ctrl_push
M.ctrl_pop = ctrl_pop
M.ctrl_peek = ctrl_peek
M
