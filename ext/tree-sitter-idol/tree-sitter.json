{
  "grammars": [
    {
      "name": "idol",
      "camelcase": "Idol",
      "scope": "source.id",
      "path": ".",
      "file-types": [
        "id"
      ],
      "injection-regex": "^idol$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Idol grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-idol"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
