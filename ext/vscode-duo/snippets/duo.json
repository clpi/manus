{
  "Function (typed)": {
    "prefix": "fun",
    "body": [
      "fun ${1:name}(${2:args}): ${3:void}",
      "\t$0",
      "end"
    ],
    "description": "Typed function definition"
  },
  "Function (untyped)": {
    "prefix": "fn",
    "body": [
      "local function ${1:name}(${2:args})",
      "\t$0",
      "end"
    ],
    "description": "Untyped function definition"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "\t$0",
      "end"
    ],
    "description": "If statement"
  },
  "If-else statement": {
    "prefix": "ifel",
    "body": [
      "if ${1:condition} then",
      "\t$2",
      "else",
      "\t$0",
      "end"
    ],
    "description": "If-else statement"
  },
  "For-in loop": {
    "prefix": "for",
    "body": [
      "for ${1:key}, ${2:value} in ${3:iterable} do",
      "\t$0",
      "end"
    ],
    "description": "For-in loop"
  },
  "For-i numeric loop": {
    "prefix": "fori",
    "body": [
      "for ${1:i} = ${2:1}, ${3:n} do",
      "\t$0",
      "end"
    ],
    "description": "Numeric for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} do",
      "\t$0",
      "end"
    ],
    "description": "While loop"
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "match ${1:value}",
      "\t${2:pattern} =>",
      "\t\t$0",
      "end"
    ],
    "description": "Match expression"
  },
  "Enum definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}",
      "\t${2:VariantA}",
      "\t${3:VariantB}$0",
      "end"
    ],
    "description": "Enum definition"
  },
  "Concept definition": {
    "prefix": "concept",
    "body": [
      "concept ${1:Name}",
      "\t$0",
      "end"
    ],
    "description": "Concept definition"
  },
  "Alias definition": {
    "prefix": "alias",
    "body": [
      "alias ${1:Name} = ${2:Type}",
      "$0"
    ],
    "description": "Type alias"
  },
  "Try block": {
    "prefix": "try",
    "body": [
      "try",
      "\t$1",
      "catch ${2:e}",
      "\t$0",
      "end"
    ],
    "description": "Try-catch block"
  },
  "Catch clause": {
    "prefix": "catch",
    "body": [
      "catch ${1:e}",
      "\t$0"
    ],
    "description": "Catch clause"
  },
  "Defer block": {
    "prefix": "defer",
    "body": [
      "defer",
      "\t$0",
      "end"
    ],
    "description": "Defer block"
  },
  "Local binding": {
    "prefix": "local",
    "body": [
      "local ${1:name}: ${2:Type} = ${3:value}",
      "$0"
    ],
    "description": "Local typed binding"
  },
  "Const binding": {
    "prefix": "const",
    "body": [
      "const ${1:name}: ${2:Type} = ${3:value}",
      "$0"
    ],
    "description": "Constant binding"
  },
  "Test block": {
    "prefix": "test",
    "body": [
      "fun test_${1:name}()",
      "\t$0",
      "end"
    ],
    "description": "Test function"
  }
}
