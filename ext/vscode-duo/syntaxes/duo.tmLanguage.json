{
  "scopeName": "source.id",
  "name": "Duo",
  "patterns": [
    { "include": "#comment" },
    { "include": "#attribute" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#type-keyword" },
    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.id",
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.id" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.id" }
          }
        },
        {
          "name": "comment.line.double-dash.id",
          "match": "--(?!\\[\\=*\\[).*$",
          "captures": {
            "0": { "name": "punctuation.definition.comment.id" }
          }
        }
      ]
    },
    "attribute": {
      "match": "@(\\w+)(\\([^)]*\\))?",
      "captures": {
        "0": { "name": "meta.attribute.id" },
        "1": { "name": "punctuation.special.attribute.id" },
        "2": { "name": "entity.other.attribute-name.id" },
        "3": { "name": "meta.attribute.arguments.id" }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.id",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.id" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.id" } },
          "patterns": [
            {
              "name": "constant.character.escape.id",
              "match": "\\\\[abfnrtv\\\\\"'\\n]"
            },
            {
              "name": "constant.character.escape.id",
              "match": "\\\\x[0-9a-fA-F]{2}"
            },
            {
              "name": "constant.character.escape.id",
              "match": "\\\\[0-9]{1,3}"
            },
            {
              "name": "constant.character.escape.id",
              "match": "\\\\u\\{[0-9a-fA-F]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.id",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.id" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.id" } },
          "patterns": [
            {
              "name": "constant.character.escape.id",
              "match": "\\\\[abfnrtv\\\\\"'\\n]"
            },
            {
              "name": "constant.character.escape.id",
              "match": "\\\\x[0-9a-fA-F]{2}"
            },
            {
              "name": "constant.character.escape.id",
              "match": "\\\\[0-9]{1,3}"
            },
            {
              "name": "constant.character.escape.id",
              "match": "\\\\u\\{[0-9a-fA-F]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.other.long.id",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.id" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.id" } }
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.id",
          "match": "0[xX][0-9a-fA-F]+\\.[0-9a-fA-F]*([pP][+-]?[0-9]+)?"
        },
        {
          "name": "constant.numeric.float.id",
          "match": "0[xX][0-9a-fA-F]+[pP][+-]?[0-9]+"
        },
        {
          "name": "constant.numeric.float.id",
          "match": "[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?"
        },
        {
          "name": "constant.numeric.float.id",
          "match": "\\.[0-9]+([eE][+-]?[0-9]+)?"
        },
        {
          "name": "constant.numeric.float.id",
          "match": "[0-9]+[eE][+-]?[0-9]+"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.id",
          "match": "0[xX][0-9a-fA-F]+"
        },
        {
          "name": "constant.numeric.integer.id",
          "match": "[0-9]+"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.id",
          "match": "\\b(if|then|else|elseif|end|do|while|repeat|until|for|in|return|break|goto)\\b"
        },
        {
          "name": "keyword.declaration.id",
          "match": "\\b(local|global|const|function|fun)\\b"
        },
        {
          "name": "keyword.operator.id",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.true.id",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.id",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.nil.id",
          "match": "\\bnil\\b"
        },
        {
          "name": "keyword.control.id",
          "match": "\\b(match|case|try|catch|defer|async|await|enum|concept|alias|extends|private)\\b"
        }
      ]
    },
    "type-keyword": {
      "name": "support.type.primitive.id",
      "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|void|str)\\b"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.id",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.comparison.id",
          "match": "==|~=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.id",
          "match": "\\+|-|\\*|/|%|\\^|#"
        },
        {
          "name": "keyword.operator.bitwise.id",
          "match": "&|\\||~|<<|>>"
        },
        {
          "name": "keyword.operator.concat.id",
          "match": "\\.\\.|\\.\\.\\."
        },
        {
          "name": "keyword.operator.assignment.id",
          "match": "="
        },
        {
          "name": "keyword.operator.type.id",
          "match": "::|\\?|!"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.id",
          "match": "[()\\[\\]{}]"
        },
        {
          "name": "punctuation.delimiter.id",
          "match": "[,.;:]"
        }
      ]
    },
    "identifier": {
      "patterns": [
        {
          "name": "variable.language.id",
          "match": "\\b_\\b"
        },
        {
          "name": "variable.other.id",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
