{
  "name": "idol",
  "displayName": "Idol",
  "description": "Idol language support — syntax highlighting, snippets, and language server integration",
  "version": "0.1.0",
  "publisher": "idol-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:idol"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "idol",
        "extensions": [
          ".id"
        ],
        "aliases": [
          "Idol",
          "idol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "idol",
        "scopeName": "source.id",
        "path": "./syntaxes/idol.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "idol",
        "path": "./snippets/idol.json"
      }
    ],
    "configuration": {
      "title": "Idol Language Server",
      "properties": {
        "idol-lsp.path": {
          "type": "string",
          "default": "idol-lsp",
          "description": "Path to the Idol language server binary."
        },
        "idol-lsp.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace level for LSP communication."
        },
        "idol-lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Idol language server."
        }
      }
    }
  },
  "dependencies": {}
}
