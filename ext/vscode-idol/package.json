{
  "name": "idol",
  "displayName": "Idol",
  "description": "Idol file association and language server integration",
  "version": "0.1.0",
  "publisher": "idol-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:idol"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "idol",
        "extensions": [
          ".id"
        ],
        "aliases": [
          "Idol",
          "idol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Idol Language Server",
      "properties": {
        "idol-lsp.path": {
          "type": "string",
          "default": "idol-lsp",
          "description": "Path to the Idol language server binary."
        },
        "idol-lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Idol language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
