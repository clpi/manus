# Native lowering differential — the direct ARM64 backend must agree with the C
# backend on every corpus program.
#
# Idol replacement for scripts/native_differential.sh (monoglot census).
#
# Why this exists: the direct backend's own unit tests assert that instructions
# are *present* ("at least 3 cmp, at least 3 b."). A backend can satisfy every
# one of those while computing the wrong answer, which is exactly what happened
# # `if n < 0` compiled as `if n == 0`, loop bodies returned after one
# iteration, and loop counters were folded to constants. Only a behavioural
# differential against a known-good backend catches that class.
#
# Exit 0 iff every program in examples/native_differential/ produces the same
# exit status under #backend=direct and , with no hangs.
#
# THE STATUS READ IS LOAD-BEARING. std.script.run cannot report an exit code:
# std.os.execute collapses every nonzero status to 1. A differential built on
# `run` would compare 1 against 1 and call every divergence agreement # it
# would pass while the backend returned 3 where C returned 7. std.script.status
# reads the real code back through a subshell, so it is used throughout.

work = "/tmp/idol-native-diff"

agree = 0
diverge = 0
fails = ""

fail = (msg: str)
  fails = fails .. "  " .. msg .. "\n"
  diverge = diverge + 1

envval: str = (name: str, fallback: str)
  v = std.script.getenv_or(name)
  if v == ""
    return fallback
  v

# A miscompiled loop does not fail, it spins. Every run is bounded, and 124 is
# the timeout marker the caller checks for.
bounded = ""

rc: i64 = (bin: str)
  std.script.status(bounded .. bin)

# gap[067] part 2. Exit status alone is structurally blind to a DROPPED EFFECT:
# `for i = 1, 3 / print(i)` exited 0 on both backends and printed `1 2 3` under
# and NOTHING under #backend=direct, and this gate called that
# agreement for as long as it compared statuses. The same hole hid a file-scope
# global whose read folded to its initializer (c=6, direct=3, both exit 0).
#
# Newlines are folded to spaces so a one-line failure message can carry the
# whole transcript; a divergence in line BREAKS alone is not a divergence this
# gate is built to catch, and squeezing them keeps the report readable.
outtext: str = (bin: str)
  std.script.chomp(std.script.capture(bounded .. bin .. " 2>/dev/null | tr '\\n' ' '"))

# The stdout half of one row's verdict. Split out so the comparison reads as
# one fact at the call site instead of four nested lines inside the status
# ladder.
judgeout = (name: str, ctext: str, dtext: str)
  if ctext == dtext
    agree = agree + 1
  if ctext != dtext
    fail(name .. ": stdout differs — c=[" .. ctext .. "] direct=[" .. dtext .. "]")

# `ls` rather than a glob: an empty directory must yield nothing, not a literal
# unexpanded pattern treated as a filename.
listfiles: any = (dir: str)
  out = script.capture("ls " .. dir .. "/*.id 2>/dev/null")
  files = {}
  for i, line in out:split("\n")
    t = script.chomp(line)
    if t != ""
      files(files:len() + 1) = t
  files

stem: str = (path: str)
  script.chomp(script.capture("basename " .. path .. " .id"))

compileok: bool = (idol: str, src: str, backend: str, out: str)
  script.run(idol .. " compile " .. src .. " --backend=" .. backend .. " --emit exe -o " .. out .. " >/dev/null 2>&1") == 0

# gap[108]. One `unsupported/` row's verdict. The folder used to be LISTED and
# nothing more — the name printed, the program never compiled — which made its
# contract ("an honest capability gap, NOT a miscompilation") an assertion
# instead of a measurement. The assertion was load-bearing:
# `g066_written_file_scope_global` lives there precisely because the direct
# backend once answered 3 where C answered 6, and the only thing between that
# wrong answer and a user is one precheck guard in `codegen.zig`. Delete the
# guard and the old gate still printed "unsupported" and still passed.
#
# The check IS the contract, in three arms:
#   direct refuses             the expected state, reported, does not block
#   direct compiles + agrees   the capability landed, promote it, does not block
#   direct compiles + diverges a MISCOMPILATION, and it BLOCKS
# The third arm is the one with teeth, and it is the arm the folder always
# claimed was impossible.
#
# `knowndivergent/` runs through the SAME helper, because the two folders were
# always one question asked twice — compile both ways, compare status AND
# stdout, say which of the three arms you landed in. They differed only in the
# word printed and in whether a divergence blocked, and both of those are now
# parameters. Folding them also deletes the duplicate ladder rather than adding
# a second one.
frontier = (idol: str, kind: str, blocks: bool, src: str)
  name = stem(src)
  base = "{work}/{kind}_{name}"
  dbin = "{base}.direct"
  cbin = "{base}.c"
  if not compileok(idol, src, "direct", dbin)
    print("native_differential: {kind} (direct cannot compile) — {name}")
  else
    if not compileok(idol, src, "c", cbin)
      print("native_differential: {kind} compiles under direct, C cannot build it — move to native_only/ — {name}")
    else
      d = rc(dbin)
      c = rc(cbin)
      dtext = outtext(dbin)
      ctext = outtext(cbin)
      note = "c={c}/[{ctext}] direct={d}/[{dtext}]"
      if d == c and dtext == ctext
        print("native_differential: {kind} now COMPILES and AGREES — {name} (promote it into the corpus)")
      if d != c or dtext != ctext
        if blocks
          fail("{name}: {kind} program compiled under direct and MISCOMPILED — {note}")
        if not blocks
          print("native_differential: known divergence — {name} ({note})")

main: i64 = ()
  idol = envval("IDOL", envval("DUO", "./zig-out/bin/idol"))
  corpus = envval("NATIVE_DIFF_CORPUS", "examples/native_differential")
  bound = envval("NATIVE_DIFF_TIMEOUT", "10")

  if not std.script.fs_exists(idol)
    zig = envval("ZIG", "zig")
    if std.script.run(zig .. " build") != 0
      print("native_differential: FAIL — zig build")
      return 1

  for i, cand in { "timeout", "gtimeout" }
    if bounded == "" and std.script.chomp(std.script.capture("command -v " .. cand .. " 2>/dev/null")) != ""
      bounded = cand .. " " .. bound .. " "

  std.script.run("rm -rf " .. work .. " && mkdir -p " .. work)

  for i, src in listfiles(corpus)
    name = stem(src)
    dbin = work .. "/" .. name .. ".direct"
    cbin = work .. "/" .. name .. ".c"

    if not compileok(idol, src, "direct", dbin)
      fail(name .. ": direct backend failed to compile")
    else
      if not compileok(idol, src, "c", cbin)
        fail(name .. ": c backend failed to compile")
      else
        drc = rc(dbin)
        crc = rc(cbin)
        if drc == 124
          fail(name .. ": direct backend HUNG (>" .. bound .. "s) — c=" .. crc:to(str))
        else
          if drc != crc
            fail(name .. ": c=" .. crc:to(str) .. " direct=" .. drc:to(str))
          else
            # gap[067]. STDOUT is the second half of the comparison
            # and the half that catches dropped effects. Status
            # agreement is necessary, never sufficient.
            judgeout(name, outtext(cbin), outtext(dbin))

  # `native_only/` gates capabilities where the C backend is not a valid
  # oracle (it cannot compile them at all), so the expected exit status is
  # declared in the file itself as `-- expect: N`. These block like the main
  # corpus: they pin self-hosting capabilities with no differential twin.
  for i, src in listfiles(corpus .. "/native_only")
    name = stem(src)
    expected = std.script.chomp(std.script.capture("sed -n 's/^-- expect: *\\([0-9][0-9]*\\).*/\\1/p' " .. src .. " | head -1"))
    if expected == ""
      fail(name .. ": native_only file has no '-- expect: N' header")
    else
      bin = work .. "/no_" .. name
      if not compileok(idol, src, "direct", bin)
        fail(name .. ": direct backend failed to compile (native_only)")
      else
        actual = rc(bin)
        if actual:to(str) != expected
          fail(name .. ": expected " .. expected .. ", got " .. actual:to(str) .. " (native_only)")
        else
          agree = agree + 1

  # Frontier reporting. `unsupported/` holds programs the direct backend
  # refuses to compile (a capability gap — honest, not a miscompilation).
  # `knowndivergent/` holds programs it compiles and gets WRONG; those are
  # open bugs, listed every run so they stay visible instead of decaying into
  # folklore. Neither blocks on the CAPABILITY being absent: the gate exists
  # to stop regressions in what already works.
  unsupported_count = 0
  for i, src in listfiles(corpus .. "/unsupported")
    unsupported_count = unsupported_count + 1
    frontier(idol, "unsupported", true, src)

  for i, src in listfiles(corpus .. "/knowndivergent")
    frontier(idol, "knowndivergent", false, src)

  print("native_differential: " .. agree:to(str) .. " agree, " .. diverge:to(str) .. " diverge, " .. unsupported_count:to(str) .. " unsupported (corpus: " .. corpus .. ")")

  if diverge != 0
    print("native_differential: FAIL")
    stdout:write(fails)
    return 1
  # An empty corpus passing every check is the failure mode this catches:
  # a mistyped corpus path would otherwise report a clean run.
  if agree == 0
    print("native_differential: FAIL (empty corpus)")
    return 1
  print("native_differential: PASS")
  0
