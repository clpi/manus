#!/usr/bin/env idol
# idol_lock.id — serialize heavy Idol/Zig builds across concurrent agent sessions.
# Native mkdir mutex. Existing locks are never reclaimed here.

chomp: str = (text: str)
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32
            break
        n -= 1
    text:sub(1, n)

cap: str = (cmd: str)
    gatecap(cmd):chomp()

status: i64 = (cmd: str)
    cap("( {cmd} ) >/dev/null 2>&1; echo $?"):to(i64)

release: i64 = (lockdir: str, wrapper: str)
    lock = "'{lockdir}'"
    path = "'{lockdir}/owner'"
    held = "'{wrapper}'"
    status("current=$(cat {path} 2>/dev/null) || exit 1; [ \"$current\" = {held} ] || exit 1; rm -f {path} && rmdir {lock}")

main: i64 = ()
    lockdir = os.env["IDOL_BUILD_LOCK"] or "/tmp/idol-lock"

    i = 1

    if os.args(i) == nil
        print("idol_lock: no command (usage: idol_lock.id [--timeout N] -- cmd...)")
        return 64

    if os.args(i) == "status"
        lock = "'{lockdir}'"
        if status("test -d {lock}") == 0
            path = "'{lockdir}/owner'"
            owner = cap("cat {path} 2>/dev/null")
            if owner:len() > 0
                print("LOCKED by {owner}")
            else
                print("LOCKED (owner unavailable)")
        else
            print("FREE")
        return 0

    timeout = 1800
    if os.args(i) == "--timeout"
        if os.args(i + 1) == nil
            print("idol_lock: --timeout needs a value")
            return 64
        val = os.args(i + 1)
        if val == "0"
            timeout = 0
        else
            timeout = val:to(i64)
            if !timeout
                timeout = 1800
        i += 2

    if os.args(i) == "--"
        i += 1

    if os.args(i) == nil
        print("idol_lock: no command given")
        return 64

    cmd = ""
    first = true
    while os.args(i) != nil
        arg = os.args(i)
        if first
            cmd = arg
            first = false
        else
            cmd = "{cmd} {arg}"
        i += 1

    wrapper = cap("printf '%s' \"$PPID\"")
    held = "'{wrapper}'"
    if status("case {held} in ''|*[!0-9]*) exit 1;; esac; kill -0 {held}") != 0
        print("idol_lock: unable to identify live wrapper")
        return 75

    lock = "'{lockdir}'"
    path = "'{lockdir}/owner'"
    ok = status("mkdir {lock} 2>/dev/null && printf '%s\\n' {held} > {path}")
    if ok != 0
        waited = 0
        while waited < timeout
            ok = status("mkdir {lock} 2>/dev/null && printf '%s\\n' {held} > {path}")
            if ok == 0
                break
            status("sleep 1")
            waited += 1
        if ok != 0
            print("idol_lock: timed out after {timeout}s waiting for lock")
            return 75

    os.env["IDOL_LOCK_HELD"] = "1"
    os.env["IDOL_BUILD_LOCK"] = lockdir
    rc = status(cmd)
    release(lockdir, wrapper)
    if rc != 0
        return rc
    0
