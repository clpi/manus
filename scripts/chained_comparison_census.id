

global census_ands: i64 = 0
global census_files: i64 = 0

is_ident_byte: bool = (c: i64)
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 46

ident_start: i64 = (s: str, i: i64)
    j: i64 = i
    while j >= 1 and is_ident_byte(s:byte(j))
        j -= 1
    if j == i
        return 0
    j + 1

ident_end: i64 = (s: str, i: i64)
    n: i64 = s:len()
    j: i64 = i
    while j <= n and is_ident_byte(s:byte(j))
        j += 1
    if j == i
        return 0
    j - 1

skip_spaces_left: i64 = (s: str, i: i64)
    j: i64 = i
    while j >= 1 and (s:byte(j) == 32 or s:byte(j) == 9)
        j -= 1
    j

skip_spaces_right: i64 = (s: str, i: i64)
    n: i64 = s:len()
    j: i64 = i
    while j <= n and (s:byte(j) == 32 or s:byte(j) == 9)
        j += 1
    j

ord_op_len: i64 = (s: str, i: i64)
    n: i64 = s:len()
    c: i64 = s:byte(i)
    if i + 1 <= n
        c2: i64 = s:byte(i + 1)
        if (c == 60 or c == 62) and c2 == 61
            return 2
    if c == 60 or c == 62
        return 1
    0

line_of: i64 = (s: str, upto: i64)
    ln: i64 = 1
    i: i64 = 1
    while i < upto
        if s:byte(i) == 10
            ln += 1
        i += 1
    ln

scan: i64 = (src: str, path: str)
    n: i64 = src:len()
    found: i64 = 0
    i: i64 = 1
    while i + 4 <= n
        if src:byte(i) == 32 and src:byte(i + 1) == 97 and src:byte(i + 2) == 110 and src:byte(i + 3) == 100 and src:byte(i + 4) == 32
            census_ands += 1
            le: i64 = skip_spaces_left(src, i - 1)
            bs: i64 = ident_start(src, le)
            if bs > 0
                opl: i64 = skip_spaces_left(src, bs - 1)
                oplen: i64 = 0
                if opl >= 2
                    oplen = ord_op_len(src, opl - 1)
                if oplen == 0 and opl >= 1
                    oplen = ord_op_len(src, opl)
                if oplen > 0
                    rs: i64 = skip_spaces_right(src, i + 5)
                    re: i64 = ident_end(src, rs)
                    if re > 0
                        ao: i64 = skip_spaces_right(src, re + 1)
                        if ord_op_len(src, ao) > 0
                            if src:sub(bs, le) == src:sub(rs, re)
                                found += 1
                                print(path .. ":" .. to(str)(line_of(src, bs)) .. "  " .. src:sub(bs, le))
        i += 1
    found

main: i64 = ()
    paths = os.env["CENSUS_PATHS"]
    if !paths
        print("set CENSUS_PATHS to a space-separated list of .id files")
        return 0
    total: i64 = 0
    n: i64 = paths:len()
    start: i64 = 1
    i: i64 = 1
    while i <= n + 1
        at_end = i > n
        sep = false
        if !at_end
            sep = paths:byte(i) == 32
        if at_end or sep
            if i > start
                path = paths:sub(start, i - 1)
                src = path:read()
                if src != nil and src != ""
                    census_files += 1
                    total += scan(src, path)
            start = i + 1
        i += 1
    label = os.env["CENSUS_LABEL"]
    if !label
        label = "corpus"
    print(label .. ": files=" .. census_files:to(str) .. "  and=" .. census_ands:to(str) .. "  CHAINED=" .. total:to(str))
    0
