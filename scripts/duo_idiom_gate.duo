-- Idiomatic .duo enforcement for canonical tooling scripts (expand list as migrations land).
s = req "std.script"
os = req "std.os"

ROOT = string.gsub(s.capture("git rev-parse --show-toplevel 2>/dev/null"), "\n", "")

rules = {
    { re = "^%s*local%s", label = "implicit-local", hint = "omit local in .duo" },
    { re = "^%s*function%s", label = "function-kw", hint = "use bare decl or fun" },
    { re = "require%(", label = "require-call", hint = "use req(\"mod\")" },
    { re = "%f[%w]then%f[%W]", label = "then-kw", hint = "omit then in .duo" },
    { re = "%sdo%s*$", label = "do-kw", hint = "omit do before end blocks" },
}

canonical = {
    "scripts/run_benchmark_proof.duo",
    "scripts/verify_build.duo",
    "scripts/duo_idiom_gate.duo",
    "scripts/agent_smoke.duo",
}

shell_dupes = { "run_benchmark_proof", "verify_build" }

scan_file(path: str): i64
    text = s.fs_read(path)
    hits = 0
    for line in string.gmatch(text, "[^\n]+")
        for i = 1, rawlen(rules)
            rule = rules[i]
            if string.match(line, rule.re) != nil
                s.echo("idiom FAIL " .. path .. ": " .. rule.label .. " — " .. rule.hint)
                hits += 1
            end
        end
    end
    hits
end

fail = 0
for i = 1, rawlen(canonical)
    path = ROOT .. "/" .. canonical[i]
    if s.fs_exists(path)
        fail += scan_file(path)
    end
end

for i = 1, rawlen(shell_dupes)
    stem = shell_dupes[i]
    sh = ROOT .. "/scripts/" .. stem .. ".sh"
    duo = ROOT .. "/scripts/" .. stem .. ".duo"
    if s.fs_exists(sh) and s.fs_exists(duo)
        sh_text = s.fs_read(sh)
        if string.find(sh_text, stem .. ".duo") == nil or string.find(sh_text, " run ") == nil
            s.echo("idiom FAIL " .. sh .. ": must delegate to scripts/" .. stem .. ".duo")
            fail += 1
        end
    end
end

if fail != 0
    s.echo("duo_idiom_gate: FAIL (" .. tostring(fail) .. " issue(s))")
    os.exit(1)
end
s.echo("duo_idiom_gate: PASS")
