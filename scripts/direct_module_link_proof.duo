-- Proof: the direct ARM64 backend compiles and links a `req`'d Duo module by
-- itself, with no manual steps.
--
-- Duo replacement for scripts/direct_module_link_proof.sh (monoglot census).
--
-- `E.emit_u32(...)` lowers to a real ARM64 `bl` with a relocation against the
-- module's export symbol. Nothing in the program's own object defines that
-- symbol, so the compiler must locate lib/std/emit.duo, emit its C, build it
-- into an object, and put it on the link line. This checks that the resulting
-- program runs and writes the machine code it was asked to write.
--
-- Every exit-status read goes through std.script.status, never `run`:
-- std.os.execute collapses every nonzero status to 1, and three of the four
-- sections below assert an EXACT code (8, 5, 11). Under `run` all three would
-- read 1 and the proof would pass on any failing program.

_WORK = "/tmp/duo_direct_module_link"
_PROBE = "/tmp/duo_emit_probe.bin"
_DUO = "./zig-out/bin/duo"

_bad(msg: str): i64
    print("direct_module_link_proof: " .. msg)
    1
end

_compile_direct(src: str, out: str): bool
    std.script.run(_DUO .. " compile " .. src .. " --backend=direct --emit exe -o " .. out) == 0
end

_grep_q(pattern: str, path: str): bool
    n = std.script.chomp(std.script.capture("grep -c \"" .. pattern .. "\" " .. path .. " 2>/dev/null"))
    n != "" and n != "0"
end

main = (): i64
    std.script.run("rm -rf " .. _WORK .. " " .. _PROBE .. " && mkdir -p " .. _WORK)

    -- 1. One command. No hand-compiled module, no hand-written link line.
    if not _compile_direct("examples/duo_emit_machine_code.duo", _WORK .. "/prog")
        return _bad("compile failed")
    end

    -- main() returns the file size: two 4-byte ARM64 instructions.
    rc = std.script.status(_WORK .. "/prog")
    if rc != 8
        return _bad("expected exit 8 (bytes written), got " .. rc:to(str))
    end

    -- mov x0, #42 (0xd2800540) ; ret (0xd65f03c0), little-endian.
    got = std.script.chomp(std.script.capture("xxd -p " .. _PROBE))
    if got != "400580d2c0035fd6"
        return _bad("wrong machine code: " .. got)
    end

    -- The module the compiler built must carry the export symbols and contain
    -- no boxed runtime: a module that pulls in `lua_*` cannot stand alone.
    modc = "/tmp/duo_reqmod_emit.c"
    if not std.script.fs_exists(modc)
        return _bad("compiler emitted no module C")
    end
    if _grep_q("lua_", modc)
        return _bad("module C references the boxed runtime")
    end
    -- `T _sym` — a DEFINED text symbol. Matching the bare name would also
    -- accept `U _duo_emit_u32`, an undefined reference, which is exactly the
    -- state this proof exists to rule out.
    for _i, sym in {"duo_emit_begin", "duo_emit_u32", "duo_emit_size"}
        n = std.script.chomp(std.script.capture(
            "nm -g /tmp/duo_reqmod_emit.o 2>/dev/null | grep -c \"T _" .. sym .. "\""))
        if n == "" or n == "0"
            return _bad("module object is missing _" .. sym)
        end
    end

    -- The program's own object must be machine code the direct backend
    -- produced, with the module call left undefined for the linker.
    if not std.script.fs_exists("/tmp/duo_duo_emit_machine_code_native.o")
        return _bad("direct backend emitted no object")
    end

    print("direct_module_link_proof: PASS — compiler linked a req'd Duo module unaided")
    print("direct_module_link_proof: emitted " .. got .. " (mov x0,#42 ; ret)")

    -- 2. SH-03/SH-11: `string.sub` allocates, and the ARM64 backend emits only
    -- read-only __TEXT — the matrix listed that as needing a writable __DATA
    -- arena or L4 borrowed strings. Exporting the primitive from a stdlib
    -- module bypasses both: the allocation happens in the module's C and the
    -- direct backend only has to emit a relocation.
    sub_src = _WORK .. "/sub.duo"
    std.script.fs_write(sub_src, "main(): i64\n"
        .. "    S = req \"std.str\"\n"
        .. "    return S.len(S.sub(\"hello world\", 7, 11))\n"
        .. "end\n")
    if not _compile_direct(sub_src, _WORK .. "/sub")
        return _bad("native string.sub failed to compile")
    end
    subrc = std.script.status(_WORK .. "/sub")
    if subrc != 5
        return _bad("native string.sub returned " .. subrc:to(str) .. ", expected 5")
    end
    print("direct_module_link_proof: native string.sub works on the direct backend")

    -- 3. SH-04: the Duo recursive-descent parser, compiled to native ARM64 and
    -- called from a natively lowered program. Mutual recursion (parse_expr <->
    -- parse_factor) and an ABI-register record result both have to survive
    -- lowering, so this is the strongest single check that a compiler front end
    -- can run natively.
    parse_src = _WORK .. "/parse.duo"
    std.script.fs_write(parse_src, "main(): i64\n"
        .. "    P = req \"std.compiler.parser\"\n"
        .. "    return P.eval(\"2 + 3 * (4 - 1)\")\n"
        .. "end\n")
    if not _compile_direct(parse_src, _WORK .. "/parse")
        return _bad("Duo parser failed to compile")
    end
    prc = std.script.status(_WORK .. "/parse")
    if prc != 11
        return _bad("Duo parser returned " .. prc:to(str) .. ", expected 11")
    end
    print("direct_module_link_proof: Duo parser runs natively (2 + 3 * (4 - 1) = 11)")

    -- 4. Sovereign `print` (kill-C): `print` used to be the most common
    -- construct forcing the C-emit bootstrap fallback (DNB007). It now lowers
    -- to Mach-O _printf/_puts externs with the Apple arm64 stack-vararg
    -- convention, so a program whose only dynamic surface is output stays pure
    -- machine code.
    print_src = _WORK .. "/print.duo"
    std.script.fs_write(print_src, "fun main(): i64\n"
        .. "    print(42)\n    print(\"hi\")\n    print(1.5)\n    print()\n    0\nend\n")
    if not _compile_direct(print_src, _WORK .. "/print")
        return _bad("native print failed to compile")
    end
    std.script.run(_WORK .. "/print > " .. _WORK .. "/print.out")

    -- The trailing blank line from `print()` is part of the expectation, so the
    -- comparison is byte-exact rather than a grep.
    std.script.fs_write(_WORK .. "/expected.txt", "42\nhi\n1.500000\n\n")
    if std.script.run("cmp -s " .. _WORK .. "/print.out " .. _WORK .. "/expected.txt") != 0
        print("direct_module_link_proof: native print output mismatch")
        print("--- expected ---")
        io.write(std.script.capture("cat " .. _WORK .. "/expected.txt"))
        print("--- got ---")
        io.write(std.script.capture("cat " .. _WORK .. "/print.out"))
        print("--- end ---")
        return 1
    end

    -- The binary must contain no boxed runtime: `print` is not routed through
    -- lua_* machinery on the direct backend.
    n = std.script.chomp(std.script.capture(
        "strings " .. _WORK .. "/print 2>/dev/null | grep -c lua_Value"))
    if n != "" and n != "0"
        return _bad("native print binary pulls in the boxed runtime")
    end

    print("direct_module_link_proof: sovereign native print works (i64/str/f64/blank)")
    0
end
