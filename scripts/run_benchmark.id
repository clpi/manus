#!/usr/bin/env duo
s = script

# Prevent stale artifact reuse on crash
s.run("rm -f benchmark_evidence.json")

# Keep compile progress off stdout
global DUO_BUILD_REPORT = tostring(s.getenv_or("DUO_BUILD_REPORT"))
if DUO_BUILD_REPORT:len() == 0
    s.env_set("DUO_BUILD_REPORT", "plain")
end

# gap[027]: the parameter must NOT be named `s` — a parameter does not shadow
# a global of the same name, so `s` here resolved to the module global above and
# this file would not compile at all.
#
# gap[014] keeps the body manual: `text:trim()` resolves and returns nil.
trim(text: str): str
    if text:sub(-1) == "\n" return text:sub(1, #text - 1) end
    text
end

global ROOT = trim(s.capture("git rev-parse --show-toplevel"))

# Everything this script says about the fold classifier goes out through the
# SAME channel as the results table. `print` from a compiled Duo script is
# buffered and the shelled-out `printf` the table uses is not, so a caveat
# written with `print` lands in a different part of the transcript from the
# numbers it qualifies # which is exactly how a win count gets quoted without
# the caveat attached to it.
say(line: str): i64
    s.must("printf \"%s\\n\" \"" .. line .. "\"")
    0
end

global DUO = tostring(s.getenv_or("DUO"))
if DUO:len() == 0
    DUO = ROOT .. "/zig-out/bin/idol"
end
DUO = "env DUO_BUILD_REPORT=plain " .. DUO

global CC = tostring(s.getenv_or("CC"))
if CC:len() == 0
    CC = "clang"
end

global CFLAGS = "-O3 -ffast-math -march=native -flto -fomit-frame-pointer -funroll-loops -ffp-contract=fast -fno-trapping-math -fno-math-errno -ffunction-sections -fdata-sections -Wl,-dead_strip -std=c99 -lm"

global SDKROOT = tostring(s.getenv_or("SDKROOT"))
if SDKROOT:len() == 0
    SDKROOT = trim(s.capture("xcrun --sdk macosx --show-sdk-path 2>/dev/null || true"))
end
if SDKROOT:len() != 0
    CFLAGS = CFLAGS .. " -isysroot " .. SDKROOT
end

s.must("cd " .. ROOT .. " && if [ ! -x zig-out/bin/idol ]; then ${ZIG:-zig} build; fi")

# Pass 11 WP-01: explicit benchmark manifest (backend must not force boxing).
# The first port dropped this entirely. It is not decoration: the row states
# which backend and representation produced the numbers below, so a run that
# silently fell back to a boxed representation is distinguishable from one that
# did not. DUO_BENCH_MANIFEST is also read downstream # and only reaches a
# child now that std.script.env_set is a real setenv rather than a shelled-out
# `export` that never left its subshell.
BENCH_BACKEND = s.getenv_or("BENCH_BACKEND")
if BENCH_BACKEND:len() == 0
    BENCH_BACKEND = "c-specialized"
end
duo_version = trim(s.capture(DUO .. " --version 2>/dev/null || echo unknown"))
if duo_version:len() == 0
    duo_version = "unknown"
end
BENCH_MANIFEST = "backend=" .. BENCH_BACKEND .. " representation=specialized runtime=dynamic intermediate=generated-c external_compiler=" .. CC .. " duo=" .. duo_version
print("BENCH_MANIFEST " .. BENCH_MANIFEST)
s.env_set("DUO_BENCH_MANIFEST", BENCH_MANIFEST)

BENCH_PARALLEL_COMPILE = s.getenv_or("BENCH_PARALLEL_COMPILE")

_duo_lua_compile = "/usr/bin/time -l " .. DUO .. " compile --pgo -O3 examples/benchmark.lua -o /tmp/duo_bench.out 2> /tmp/duolua_compile_time.txt"
_c_instr_compile = CC .. " " .. CFLAGS .. " -fprofile-instr-generate -o /tmp/c_bench_instr.out examples/benchmark_c.c"
_c_opt_compile = "/usr/bin/time -l " .. CC .. " " .. CFLAGS .. " -fprofile-instr-use=/tmp/c_bench.profdata -o /tmp/c_bench.out examples/benchmark_c.c 2> /tmp/c_compile_time.txt"
_c_profile_steps = "env LLVM_PROFILE_FILE=/tmp/c_bench.profraw /tmp/c_bench_instr.out > /dev/null 2>&1 || true; xcrun llvm-profdata merge -output=/tmp/c_bench.profdata /tmp/c_bench.profraw"

if BENCH_PARALLEL_COMPILE == "1"
    # ONE shell. The previous spelling backgrounded with `s.run("... &")` and
    # then called `s.run("wait")` # two SEPARATE shells, so `wait` had no jobs
    # to wait for and returned instantly. The compiles were orphaned and the
    # script raced on to time /tmp/duo_bench.out while it was still being
    # written, or was a stale binary from a previous run. Off by default, so it
    # never fired in CI; a trap for whoever set the variable.
    s.must("cd " .. ROOT .. " && { " .. _duo_lua_compile .. " ; } & DUO_PID=$!; " .. _c_instr_compile .. " && { " .. _c_profile_steps .. " ; } && { " .. _c_opt_compile .. " ; } & CC_PID=$!; wait $DUO_PID && wait $CC_PID")
else
    s.must("cd " .. ROOT .. " && " .. _duo_lua_compile)
    s.must("cd " .. ROOT .. " && " .. _c_instr_compile)
    s.run(_c_profile_steps)
    s.must("cd " .. ROOT .. " && " .. _c_opt_compile)
end

# Compile the .id mirror
s.must("cd " .. ROOT .. " && /usr/bin/time -l " .. DUO .. " compile --pgo -O3 examples/benchmark.id -o /tmp/duo_bench_duo.out 2> /tmp/duoduo_compile_time.txt")

# RESULT rows and TIMED rows are no longer the same count, and the split is
# the whole of gap[096]'s closure.
#
# BENCHES is the CORRECTNESS count: every kernel still runs in all three
# programs and every answer is still compared against reference C. 40, and it
# must stay 40 # the three rows removed below are precisely the ones whose
# RESULT row is the only thing keeping the compiler's most aggressive kernel
# substitutions honest, so deleting them would delete the oracle.
#
# TIMED is the SPEED count. Three rows publish no Time line in ANY of the
# three programs, because a duration for them cannot be compared:
#
#   Fibonacci(40)  codegen substitutes an O(n) iteration for O(phi^n) recursion
#   Table array    codegen substitutes n(n+1)/2 for the O(n) fill-and-sum
#   Bitcount       codegen substitutes an O(log n) identity for the O(n log n)
#
# These are not constant folds and gap[096]'s two proposed repairs were both
# measured INEFFECTIVE before the rows were removed:
#
#   raise the bound  # the run this was decided on reported `res 0`: NO row
#                       folded for want of resolution. Every fold was `both`,
#                       and an O(1) kernel has no bound that reaches the floor.
#   opaque input     # sourcing the bound from getenv (which neither compiler
#                       can see through) leaves the emitted kernel BYTE-
#                       IDENTICAL. Verified by diffing the generated C for all
#                       three functions, literal bound against getenv bound.
#
# The substitutions are keyed on the function BODY, so no change to the INPUT
# reaches them. The row was comparing two algorithms, not two codegens, and
# gap[096] step 5 says a row that still folds after the repair is removed with
# a reason rather than left folding. That is what this is.
global BENCHES: i64 = 40
global TIMED: i64 = 37

# Two measured defects forced this shape; do not "simplify" it back.
#
# 1. NESTED gmatch IS BROKEN. Iterating words with a gmatch inside a gmatch
#    over lines yields 4 of 12 words on a 3-line fixture # the inner
#    iterator corrupts the outer one. The old body did exactly that, so it
#    returned 2 times for a 40-benchmark run. # gap[035]
# 2. tonumber DOES NOT RETURN nil ON NON-NUMBERS. tonumber("Fibonacci(40)")
#    and tonumber("Time") both return 0, so the "first word that parses as a
#    number" scan accepted the FIRST word of every line and recorded 0. Every
#    timing was therefore 0 or missing, every row printed N/A, and every
#    winner defaulted to C # a suite reporting total defeat for a reason
#    that had nothing to do with speed. # gap[031]
#
# One match per line, anchored to the "Time" label, extracts the number
# directly: no inner iterator, and no reliance on tonumber signalling failure
# (it is only ever handed text already known to be numeric).
#
# Duo separates the fields with TABS and C with spaces, so the pattern spans
# %s+ rather than a literal space.
extract_times(out: str): table
    times = {}
    for line in out:gmatch("([^\n]+)")
        num = line:match("Time%s+([0-9%.eE%+%-]+)")
        if num != nil
            times:insert(tonumber(num))
        end
    end
    times
end

extract_results(out: str): table
    res = {}
    for line in out:gmatch("([^\n]+)")
        id, val = line:match("^RESULT%s+([^%s]+)%s+([^%s]+)")
        if id != nil
            res:insert({ id = id, val = val })
        end
    end
    res
end

compare_results(name: str, duo_res: table, c_res: table): bool
    if #duo_res != BENCHES or #c_res != BENCHES
        print("RESULT count mismatch for " .. name .. ": Duo=" .. tostring(#duo_res) .. " C=" .. tostring(#c_res) .. " (expected " .. tostring(BENCHES) .. ")")
        return false
    end
    fail = false
    for i = 1, BENCHES
        if duo_res[i].id != c_res[i].id
            print("RESULT mismatch: id order differs (" .. duo_res[i].id .. " vs " .. c_res[i].id .. ")")
            fail = true
        else
            a = duo_res[i].val
            b = c_res[i].val
            if a != b
                da = tonumber(a)
                db = tonumber(b)
                # INTEGER RESULTS MUST MATCH EXACTLY. The shell original had
                # this branch and the first port of it did not, which silently
                # weakened the gate: without it two integers fall through to
                # the float ladder below, where `base > 1e6 => tol = 1` accepts
                # an off-by-one. A checksum of 1899277430 vs 1899277431 # a
                # real divergence between Duo and C # was reported as
                # AGREEMENT. Compared as strings, which is exact; tonumber
                # would round any value past 2^53 and re-introduce the hole.
                is_int = a:match("^%-?%d+$") != nil and b:match("^%-?%d+$") != nil
                if is_int
                    print("RESULT mismatch for " .. duo_res[i].id .. ": Duo=" .. a .. " C=" .. b)
                    fail = true
                elseif da == nil or db == nil
                    print("RESULT mismatch for " .. duo_res[i].id .. ": Duo=" .. a .. " C=" .. b)
                    fail = true
                else
                    abs_a = da:abs()
                    abs_b = db:abs()
                    if abs_a < 1e-6 and abs_b < 1e-6
                        # SIGN-AWARE. This compared abs_a - abs_b, i.e. the
                        # MAGNITUDES, so a sign flip in a small value differed
                        # by exactly zero and passed. Not hypothetical: nbody
                        # reports Duo=+9.3782588805879641e-08 against
                        # C=-9.3782588805879641e-08 # bit-identical magnitude,
                        # opposite sign # and the suite called that agreement
                        # on every run. The shell original had the same defect
                        # (`abs_a - abs_b > 1e-12 && abs_b - abs_a > 1e-12`),
                        # so the port inherited a blind spot rather than
                        # introducing one.
                        if da - db:abs() > 1e-12
                            print("RESULT mismatch for " .. duo_res[i].id .. ": Duo=" .. a .. " C=" .. b)
                            fail = true
                        end
                    else
                        diff = da - db:abs()
                        base = abs_a:max(abs_b)
                        tol = 1e-9
                        if base != 0
                            tol = base * 1e-6
                        end
                        if tol < 1e-9 tol = 1e-9 end
                        if base > 1e6 and tol < 1 tol = 1 end
                        if diff > tol
                            print("RESULT mismatch for " .. duo_res[i].id .. ": Duo=" .. a .. " C=" .. b)
                            fail = true
                        end
                    end
                end
            end
        end
    end
    !fail
end

_collect_min_times_impl(cmd: str, min_times: table): table
    runs = 10
    for i = 1, runs
        out = s.capture("cd " .. ROOT .. " && " .. cmd .. " 2>/dev/null")
        times = extract_times(out)
        # DO NOT round-trip through tonumber here. `tonumber(nil)` returns 0,
        # not nil # gap[031] # so `m = tonumber(min_times[j])` on an unset
        # slot gave 0, `m == nil` was false, and `t < 0` is false for every
        # positive duration. The minimum was therefore NEVER SEEDED: min_times
        # stayed empty, every row printed N/A, every winner defaulted to C, and
        # the suite reported Duo losing all 40 benchmarks on timing it had not
        # collected. extract_times already returns numbers, so compare the raw
        # values and let an unset slot actually read as nil.
        for j = 1, #times
            t = times[j]
            m = min_times[j]
            if m == nil or t < m
                min_times[j] = t
            end
        end
    end
    min_times
end

collect_min_times(cmd: str): table
    _collect_min_times_impl(cmd, {})
end

capture_results(label: str, cmd: str): table
    status = 0
    res = {}
    for attempt = 1, 2
        out = s.capture("cd " .. ROOT .. " && " .. cmd .. " 2>/dev/null")
        res = extract_results(out)
        if #res == BENCHES
            return res
        end
        if attempt == 1
            s.echo("warning: " .. label .. " produced " .. tostring(#res) .. "/" .. tostring(BENCHES) .. " RESULT rows, retrying...")
        end
    end
    s.echo("error: " .. label .. " produced " .. tostring(#res) .. "/" .. tostring(BENCHES) .. " RESULT rows after retry")
    os.exit(1)
    res
end

# ── The folded-row classifier ───────────────────────────────────────────────
#
# A benchmark row is supposed to answer "is the code Duo GENERATED fast?".
# It answers that only if the kernel actually RAN. Two observable signatures
# say it did not:
#
#   R1  the Duo duration is at or under `cutoff`, this harness's reporting
#       floor, so there is no significant digit in it to compare with;
#   R2  the Duo duration beats reference C by more than `ratio`.
#       Both sides reach clang -O3 through PGO from the same source algorithm,
#       so a CODEGEN difference cannot open a gap of that size. An ASYMPTOTIC
#       difference can, and that is exactly what a closed-form substitution
#       is: the compiler evaluated the benchmark instead of running it.
#
# Such a row measures whether a human wrote a closed form. It is not a win and
# it is reported as `folded`, never as `Duo`.
#
# NOTHING HERE KEYS ON A ROW. No benchmark name, no expected value, no loop
# bound reaches this code; the only inputs are the row's own two durations.
# The same rule would fire for arbitrary user code of the same shape, which is
# the test CLAUDE.md §3 sets for any recogniser in this repository.
#
# `tick` is a property of the INSTRUMENT, not a constant fitted to the results:
# reference C prints every duration with printf("%f") # six decimal places #
# so the smallest non-zero duration this harness can report at all is 1e-06 s.
# `cutoff` is ten of those quanta; under ten ticks a duration carries no
# significant digit. The summary prints the smallest positive duration actually
# observed, so a reader can check that assumed resolution against the run
# instead of taking it on the comment.
#
# Named `cutoff` rather than `floor` on purpose: `floor` is an unmangled libc
# symbol and a file-scope binding of that name is a link hazard here.
global tick: f64 = 0.000001
global cutoff: f64 = 0.00001
global ratio: f64 = 100.0

# gap[019]: a value read out of a table is `any`, and `any` arithmetic
# truncates the field to int64 first, which would turn every sub-second
# duration into 0 and fold the entire table. Both durations are taken as f64
# PARAMETERS so everything below is native f64. Verified by value, not by
# shape: 0.0002 handed through an f64 parameter and multiplied by 100.0 comes
# back 0.02, and the ratio arm answers accordingly.
#
# No early return: both clauses are evaluated every call, so neither can be
# silently unreachable behind the other.
folded(dt: f64, ct: f64): bool
    out = false
    if dt <= cutoff
        out = true
    end
    if ct > cutoff and ct >= dt * ratio
        out = true
    end
    out
end

# WHICH rule fired, and it is not cosmetic. `folded` returns one bool for two
# causes that need OPPOSITE repairs:
#
#   res   R1, at or under the reporting floor. The workload is too cheap to
#         measure and the repair is a larger bound.
#   form  R2, beating C by more than `ratio`. Both sides reach clang -O3 from
#         the same algorithm, so a gap that size is ASYMPTOTIC — the compiler
#         evaluated the benchmark instead of running it. A larger bound folds
#         just the same; the repair is an input the compiler cannot know.
#   both  R1 and R2 together, which is what a closed form usually looks like:
#         it returns instantly AND beats C enormously.
#
# gap[096] recorded a repair plan that was WRONG for three rows because one
# word covered both causes and the summary line — "smallest POSITIVE duration"
# — had quietly excluded the rows sitting at 0. Reporting the reason is what
# makes the two piles countable.
#
# The DECISION is unchanged: this reads the same two clauses and adds no third.
# A reason function that could disagree with `folded` would be a second
# classifier, and then the table would have two answers.
foldreason(dt: f64, ct: f64): str
    r1 = false
    r2 = false
    if dt <= cutoff
        r1 = true
    end
    if ct > cutoff and ct >= dt * ratio
        r2 = true
    end
    out = ""
    if r1 and r2
        out = "both"
    end
    if r1 and !r2
        out = "res"
    end
    if r2 and !r1
        out = "form"
    end
    out
end

# One place formats a duration, so one line in this file names a Lua library.
sec(v: f64): str
    "%g":format(v)
end

yesno(b: bool): str
    out = "no"
    if b
        out = "yes"
    end
    out
end

probe(label: str, dt: f64, ct: f64, want: bool): i64
    got = folded(dt, ct)
    mark = "  ok  "
    bad: i64 = 0
    if got != want
        mark = "BROKEN"
        bad = 1
    end
    say(mark .. "  " .. label .. "  duo=" .. sec(dt) .. "  c=" .. sec(ct)
        .. "  folded=" .. yesno(got) .. "  want=" .. yesno(want))
    bad
end

# POSITIVE CONTROL, run before any benchmark data exists. A classifier that
# never fires is indistinguishable from one that is broken # this repository
# has already shipped a capability table reporting 46/0 and a gate reporting
# 0/N from evidence neither of them could have read. So the rule is fired on
# synthetic points first, and each point pins one edge:
#
#   rows 1-3 walk the cutoff clause up to the cutoff;   row 4 clears the cutoff
#   and is caught by the RATIO ALONE, which is what proves the two clauses
#   independent;
#   row 5 holds C fixed and moves Duo across the ratio, so 4 and 5 bracket
#   `ratio` from both sides;   rows 6-7 hold the ratio at 10 and 5, far below
#   the fold ratio, and move Duo across the CUTOFF, so they bracket `cutoff`
#   with the ratio clause disabled # without that pair the cutoff could be
#   moved two orders of magnitude and the ratio clause would silently cover
#   for it, which is a perturbation this table was checked against;
#   rows 8-9 are genuine wins (2x and 50x) and must NOT fire; row 11 is a
#   loss and must not fire either.
control(): i64
    bad: i64 = 0
    say("=== fold classifier control (synthetic; no benchmark data in scope) ===")
    bad = bad + probe("zero against real work        ", 0.0,      0.01,   true)
    bad = bad + probe("one tick against real work    ", 0.000001, 0.01,   true)
    bad = bad + probe("exactly at the cutoff         ", 0.00001,  0.01,   true)
    bad = bad + probe("above cutoff, ratio 500       ", 0.00002,  0.01,   true)
    bad = bad + probe("above cutoff, ratio 50        ", 0.0002,   0.01,   false)
    bad = bad + probe("at the cutoff, ratio only 10  ", 0.00001,  0.0001, true)
    bad = bad + probe("just over cutoff, ratio only 5", 0.00002,  0.0001, false)
    bad = bad + probe("genuine win, 2x               ", 0.005,    0.01,   false)
    bad = bad + probe("genuine win, 50x              ", 0.0001,   0.005,  false)
    bad = bad + probe("both sides under the cutoff   ", 0.0,      0.0,    true)
    bad = bad + probe("slower than C                 ", 0.02,     0.01,   false)
    bad
end

if control() != 0
    say("")
    say("Benchmark failed: the fold classifier disagrees with its own control table.")
    os.exit(1)
end
say("fold classifier control: 11/11 agree (cutoff=" .. sec(cutoff)
    .. "s = 10 x " .. sec(tick) .. "s reporting resolution; ratio=" .. sec(ratio) .. "x)")
say("")

print("=== Correctness (RESULT lines) ===")
duobenchres = capture_results("Duo benchmark.lua", "/tmp/duo_bench.out")
duobenchduores = capture_results("Duo benchmark.id", "/tmp/duo_bench_duo.out")
cbenchres = capture_results("reference C benchmark", "/tmp/c_bench.out")

# `global` is load-bearing. As a BARE top-level binding this stayed false
# through both reassignments below: the suite printed real mismatches and then
# "All 40 benchmark results match reference C" on the same run. RESULT_FAIL_FLAG
# further down was already declared global and always worked, which is the
# contrast that named the cause.
global RESULT_FAIL: bool = false
if !compare_results("Duo .lua", duobenchres, cbenchres)
    RESULT_FAIL = true
end
if !compare_results("Duo .id", duobenchduores, cbenchres)
    RESULT_FAIL = true
end

if RESULT_FAIL
    print("")
    print("Benchmark failed: Duo .lua and .id results must match reference C.")
    os.exit(1)
end
print("All " .. tostring(BENCHES) .. " benchmark results match reference C for .lua and .id.")

s.must("cat << 'EOF' > /tmp/timer.c\n#include <sys/time.h>\n#include <lua.h>\n#include <lauxlib.h>\nstatic int l_now(lua_State *L) {\n    struct timeval tv;\n    gettimeofday(&tv, NULL);\n    lua_pushnumber(L, (double)tv.tv_sec + (double)tv.tv_usec / 1000000.0);\n    return 1;\n}\nint luaopen_timer(lua_State *L) {\n    lua_pushcfunction(L, l_now);\n    return 1;\n}\nEOF")
s.run("clang -shared -undefined dynamic_lookup -o /tmp/timer.so /tmp/timer.c 2>/dev/null || true")

s.must("cd " .. ROOT .. " && sed -E 's/:[ ]*[a-zA-Z0-9_]+//g' examples/benchmark.lua > /tmp/lua_bench.lua")
s.must("sed -i '' '1i\\\nlocal ok, t = pcall(require, \"timer\"); if ok and type(t) == \"function\" then os.clock = t end\\\n' /tmp/lua_bench.lua")

print("")
print("=== Duo (Lua AOT) ===")
global DUO_TIMES = collect_min_times("/tmp/duo_bench.out")

print("=== Duo (.id AOT) ===")
global DUOFILETIMES = collect_min_times("/tmp/duo_bench_duo.out")

print("=== Reference C ===")
global C_TIMES = collect_min_times("/tmp/c_bench.out")

print("=== LuaJIT ===")
global LUAJIT_TIMES = collect_min_times("LUA_CPATH=\"/tmp/?.so;;\" luajit /tmp/lua_bench.lua")

print("=== Lua 5.5 ===")
global LUA55_TIMES = collect_min_times("LUA_CPATH=\"/tmp/?.so;;\" lua /tmp/lua_bench.lua")

RUN_NELUA_BENCH = s.getenv_or("RUN_NELUA_BENCH")
NELUA_TIMES = {}
if RUN_NELUA_BENCH == "1" and s.run("command -v nelua >/dev/null 2>&1") == 0
    print("=== Nelua ===")
    NELUA_TIMES = collect_min_times("nelua /tmp/lua_bench.lua 2>/dev/null || true")
else
    print("=== Nelua (skipped; set RUN_NELUA_BENCH=1 to enable) ===")
end

# TIMED rows, in Time-line order. Fibonacci(40), Table array and Bitcount are
# absent BY REMOVAL, not by oversight: see the TIMED note at the top of this
# file. Their kernels still run and their RESULT rows are still compared, so
# this list is 37 while BENCHES stays 40. The count check below is what turns
# a silently dropped Time line back into a failure instead of three N/A rows
# that would read as losses.
global NAMES = {
    "Prime sieve", "Mandelbrot", "Grid matrix", "N-body", "String bytes",
    "Trig sum", "String chain", "String hash", "Math floor/max", "Table max",
    "Pow/sqrt", "Binary search", "Filter count", "Dot product", "Clamp sum", "Bucket hash",
    "EMA smooth", "Token count", "Config parse", "Table lookup", "Table churn", "Matrix multiply",
    "Prefix sum", "GCD reduce", "Collatz sum", "XOR fold", "Ring buffer", "Cond swap",
    "Ackermann", "Levenshtein", "Sieve", "Fenwick tree", "Interpolation", "Run-length",
    "CORDIC sin", "Sparse dot", "Game of Life"
}

# POSITIVE CONTROL on the row count. Without it, a build that emits fewer Time
# lines than TIMED prints N/A for the tail, N/A takes the `c_wins` default, and
# a PARSE failure is published as a clean sweep of losses. This repository has
# already shipped exactly that once # gap[031], every row N/A and every winner
# C # so the count is asserted rather than assumed.
checktimes(label: str, t: table): i64
    n = #t
    if n != TIMED
        say("error: " .. label .. " produced " .. tostring(n) .. "/" .. TIMED:to(str)
            .. " Time lines; the timing table cannot be trusted.")
        os.exit(1)
    end
    0
end

checktimes("Duo benchmark.lua", DUO_TIMES)
checktimes("Duo benchmark.id", DUOFILETIMES)
checktimes("reference C benchmark", C_TIMES)

global RESULT_FAIL_FLAG: i64 = 0

# The three-way split. `measured` is the only one of these that is a win.
global measured: i64 = 0
global folds: i64 = 0
global losses: i64 = 0
# Instrument checks, printed with the summary rather than assumed:
# the smallest positive Duo duration anywhere in the table (which is what the
# assumed reporting resolution has to be consistent with), and a negative
# control on real data # the C column classified against ITSELF, a ratio of
# exactly 1, must never be called folded on any row where C did real work.
global least: f64 = 1000000.0
global impossible: i64 = 0
# Rows where AT LEAST ONE of the two Duo builds is folded. The verdict column
# uses the slower build, so it only says `folded` when both are; this counter
# is the wider number, and the gap between them is rows where one build ran
# the kernel and the other evaluated it.
global partial: i64 = 0
# gap[096]: the two fold causes, counted separately. `folded` stays one
# decision; these only record WHY, so a reader can size the two repairs — a
# larger bound fixes `res` and does nothing for `form`.
#
# `fold*` counts the verdict rows, where the SLOWER Duo variant decides.
# `fold*all` counts every folded Duo build observation across the .lua and
# .id columns. That second count is the worklist: a row where only one
# variant folded still tells us one benchmark input is not measuring runtime.
global foldres: i64 = 0
global foldform: i64 = 0
global foldboth: i64 = 0
global foldsites: i64 = 0
global foldresall: i64 = 0
global foldformall: i64 = 0
global foldbothall: i64 = 0

FAIL = false
print("")
print("══════════════════════════════════════════════════════════════════════════════")
print("                       Duo Performance Benchmark Suite")
print("══════════════════════════════════════════════════════════════════════════════")
print("")
s.must("printf \"%-16s %12s %12s %12s %12s %12s %12s %8s\\n\" \"Benchmark\" \"DuoLua(s)\" \"DuoDuo(s)\" \"C(s)\" \"LuaJIT(s)\" \"Lua5.5(s)\" \"Nelua(s)\" \"Winner\"")
s.must("printf \"%-16s %12s %12s %12s %12s %12s %12s %8s\\n\" \"----------------\" \"------------\" \"------------\" \"------------\" \"------------\" \"------------\" \"------------\" \"--------\"")

for i = 1, TIMED
    name = NAMES[i]
    if name == nil name = "bench-" .. tostring(i) end
    
    d = DUO_TIMES[i]
    duofile = DUOFILETIMES[i]
    c = C_TIMES[i]
    lj = LUAJIT_TIMES[i]
    l5 = LUA55_TIMES[i]
    n = NELUA_TIMES[i]
    
    eps = 1e-7
    if c != nil
        if c > 0 eps = c * 0.05 end
        if c < 0.01 and eps < 5e-5 eps = 5e-5 end
    end
    
    c_wins = 1
    if d != nil and duofile != nil and c != nil
        if (d <= c + eps) and (duofile <= c + eps)
            c_wins = 0
        end
    end
    
    if d != nil and duofile != nil and c != nil
        luadur: f64 = d
        filedur: f64 = duofile
        cdur: f64 = c
        if folded(luadur, cdur) or folded(filedur, cdur)
            partial = partial + 1
            why = foldreason(luadur, cdur)
            if why != ""
                foldsites = foldsites + 1
            end
            if why == "res"
                foldresall = foldresall + 1
            end
            if why == "form"
                foldformall = foldformall + 1
            end
            if why == "both"
                foldbothall = foldbothall + 1
            end

            why = foldreason(filedur, cdur)
            if why != ""
                foldsites = foldsites + 1
            end
            if why == "res"
                foldresall = foldresall + 1
            end
            if why == "form"
                foldformall = foldformall + 1
            end
            if why == "both"
                foldbothall = foldbothall + 1
            end
        end
    end

    # Verdict. `folded` only ever reclassifies a row that would otherwise have
    # been called a Duo win, so the loss column is unaffected by the rule.
    winner = "Duo"
    if c_wins == 1
        winner = "C"
        losses = losses + 1
        RESULT_FAIL_FLAG = 1
    else
        # The SLOWER of the two Duo builds decides. A row is folded only when
        # BOTH the .lua and the .id build failed to run it; if either one did
        # real work the row stays a measured win. That is the conservative
        # direction # this under-reports folding rather than over-reporting
        # it, so the number below is a floor on the problem, not a ceiling.
        slower: f64 = d
        if duofile > slower
            slower = duofile
        end
        ct: f64 = c
        if slower > 0.0 and slower < least
            least = slower
        end
        if ct > cutoff and folded(ct, ct)
            impossible = impossible + 1
        end
        if folded(slower, ct)
            # EVALUATED, NOT RUN. Not a win: the pass/fail criterion is
            # "Duo must beat or tie C on every test", and a row whose kernel
            # did not execute has not beaten anything.
            winner = "folded"
            folds = folds + 1
            why = foldreason(slower, ct)
            if why == "res"
                foldres = foldres + 1
            end
            if why == "form"
                foldform = foldform + 1
            end
            if why == "both"
                foldboth = foldboth + 1
            end
            RESULT_FAIL_FLAG = 1
        else
            measured = measured + 1
        end
    end
    d_fmt = "N/A"
    if d != nil d_fmt = "%g":format(d) end
    
    duofilefmt = "N/A"
    if duofile != nil duofilefmt = "%g":format(duofile) end
    
    c_fmt = "N/A"
    if c != nil c_fmt = "%g":format(c) end
    
    lj_fmt = "N/A"
    if lj != nil lj_fmt = "%g":format(lj) end
    
    l5_fmt = "N/A"
    if l5 != nil l5_fmt = "%g":format(l5) end
    
    n_fmt = "N/A"
    if n != nil n_fmt = "%g":format(n) end
    
    s.must("printf \"%-16s %12s %12s %12s %12s %12s %12s %8s\\n\" \"" .. name .. "\" \"" .. d_fmt .. "\" \"" .. duofilefmt .. "\" \"" .. c_fmt .. "\" \"" .. lj_fmt .. "\" \"" .. l5_fmt .. "\" \"" .. n_fmt .. "\" \"" .. winner .. "\"")
end

say("")
say("-- Speed verdict, three ways --------------------------------------------------")
say("  measured wins  " .. measured:to(str) .. "   Duo ran the kernel and was faster")
say("  folded         " .. folds:to(str) .. "   EVALUATED, NOT RUN - closed form, not codegen; NOT a win")
# gap[096]: WHY each row folded, because the two causes need opposite repairs
# and one word hid that. `res` wants a larger bound; `form` wants an input the
# compiler cannot know, and a larger bound does nothing for it.
say("    verdict cause res " .. foldres:to(str) .. " (under the reporting floor - raise the bound)")
say("                  form " .. foldform:to(str) .. " (beats C asymptotically - closed form, bound will not help)")
say("                  both " .. foldboth:to(str) .. " (returns instantly AND beats C - the usual closed-form signature)")
say("    all folded Duo builds " .. foldsites:to(str) .. " across .lua/.id columns")
say("                  res " .. foldresall:to(str) .. " (under the reporting floor - raise the bound)")
say("                  form " .. foldformall:to(str) .. " (beats C asymptotically - closed form, bound will not help)")
say("                  both " .. foldbothall:to(str) .. " (returns instantly AND beats C - the usual closed-form signature)")
say("  losses         " .. losses:to(str) .. "   reference C was faster")
say("")
say("  fold rule: Duo time <= " .. sec(cutoff)
    .. "s (10 x the " .. sec(tick)
    .. "s reporting resolution), OR C >= " .. sec(ratio)
    .. "x the Duo time while C is above that floor.")
say("  No row name, expected value or loop bound is an input to it.")
say("  smallest positive Duo duration in this table: " .. sec(least) .. "s")
say("  rows with AT LEAST ONE Duo build folded: " .. partial:to(str)
    .. " of " .. TIMED:to(str) .. " - the verdict column folds a row only when")
say("  BOTH builds are folded, so the folded count above is a FLOOR, not a ceiling.")
if impossible != 0
    say("  CONTROL FAILED: the rule fired on the C column against itself on "
        .. impossible:to(str) .. " row(s); a ratio of 1 can never be a fold.")
    os.exit(1)
end
say("  negative control on real data: the rule fires on 0 rows when the C column")
say("  is classified against itself.")
say("")
# gap[096]: the removed rows are declared HERE, in the same block as the
# verdict, so a reader counting 37 against a suite documented as 40 finds the
# reason attached to the number rather than in a commit message. Their kernels
# still run and their RESULT rows are still compared against reference C, so
# correctness stays 40 of 40 while the speed table is 37.
removed = BENCHES - TIMED
say("  REMOVED from the speed table (gap[096]), " .. tostring(removed)
    .. " of " .. BENCHES:to(str) .. " rows -- their RESULT is still compared:")
say("    Fibonacci(40)  codegen emits an O(n) iteration for O(phi^n) recursion")
say("    Table array    codegen emits n(n+1)/2 for the O(n) fill-and-sum")
say("    Bitcount       codegen emits an O(log n) identity for O(n log n)")
say("  Each compared two ALGORITHMS, not two codegens. Measured, not assumed:")
say("  a larger bound cannot reach an O(1) kernel, and an opaque getenv bound")
say("  leaves the emitted kernel byte-identical -- the substitution is keyed on")
say("  the function BODY, so no change to the INPUT reaches it.")

if RESULT_FAIL_FLAG == 1
    say("")
    say("FAIL: Duo .lua and .id must beat or tie reference C on every test, and the")
    say("      beating must be MEASURED. Folded rows count against this verdict.")
end

extract_compile_metrics(file: str): table
    out = s.capture("cat " .. file .. " 2>/dev/null || echo ''")
    latency = out:match("([0-9%.]+)%s+real")
    mem = out:match("([0-9]+)%s+maximum resident set size")
    { latency = tonumber(latency) or -1.0, mem = tonumber(mem) or -1 }
end

duolua_metrics = extract_compile_metrics("/tmp/duolua_compile_time.txt")
duoduo_metrics = extract_compile_metrics("/tmp/duoduo_compile_time.txt")
c_metrics = extract_compile_metrics("/tmp/c_compile_time.txt")

duolua_size = tonumber(trim(s.capture("stat -f %z /tmp/duo_bench.out 2>/dev/null || echo 0"))) or -1
duoduo_size = tonumber(trim(s.capture("stat -f %z /tmp/duo_bench_duo.out 2>/dev/null || echo 0"))) or -1
c_size = tonumber(trim(s.capture("stat -f %z /tmp/c_bench.out 2>/dev/null || echo 0"))) or -1

# Workstream A/B evidence binding
duo_hash = trim(s.capture("shasum -a 256 " .. DUO .. " 2>/dev/null | awk '{print $1}'"))
c_out_hash = trim(s.capture("shasum -a 256 /tmp/c_bench.out 2>/dev/null | awk '{print $1}'"))
workload_hash = trim(s.capture("shasum -a 256 examples/benchmark.id 2>/dev/null | awk '{print $1}'"))

evidence = "{\n"
evidence = evidence .. "  \"revision\": \"" .. trim(s.capture("git rev-parse HEAD")) .. "\",\n"
evidence = evidence .. "  \"compiler_artifact\": \"" .. DUO .. "\",\n"
evidence = evidence .. "  \"compiler_hash\": \"" .. duo_hash .. "\",\n"
evidence = evidence .. "  \"target\": \"" .. trim(s.capture("uname -m -s")) .. "\",\n"
evidence = evidence .. "  \"benchmark_identity\": \"run_benchmark.id\",\n"
evidence = evidence .. "  \"input_identity\": \"" .. BENCH_MANIFEST .. "\",\n"
evidence = evidence .. "  \"workload_hash\": \"" .. workload_hash .. "\",\n"
evidence = evidence .. "  \"realization_mode\": \"" .. BENCH_BACKEND .. "\",\n"
evidence = evidence .. "  \"comparator\": \"C\",\n"
evidence = evidence .. "  \"comparator_hash\": \"" .. c_out_hash .. "\",\n"
evidence = evidence .. "  \"warm_cold\": \"warm\",\n"
evidence = evidence .. "  \"outcome\": "
if RESULT_FAIL_FLAG == 0
    evidence = evidence .. "true,\n"
else
    evidence = evidence .. "false,\n"
end
evidence = evidence .. "  \"compilation\": {\n"
evidence = evidence .. "    \"duo_lua\": {\"latency_s\": " .. tostring(duolua_metrics.latency) .. ", \"peak_mem_bytes\": " .. tostring(duolua_metrics.mem) .. ", \"artifact_size_bytes\": " .. tostring(duolua_size) .. "},\n"
evidence = evidence .. "    \"duo_duo\": {\"latency_s\": " .. tostring(duoduo_metrics.latency) .. ", \"peak_mem_bytes\": " .. tostring(duoduo_metrics.mem) .. ", \"artifact_size_bytes\": " .. tostring(duoduo_size) .. "},\n"
evidence = evidence .. "    \"c_opt\": {\"latency_s\": " .. tostring(c_metrics.latency) .. ", \"peak_mem_bytes\": " .. tostring(c_metrics.mem) .. ", \"artifact_size_bytes\": " .. tostring(c_size) .. "}\n"
evidence = evidence .. "  },\n"
evidence = evidence .. "  \"measurements\": [\n"

for i = 1, TIMED
    name = NAMES[i]
    d = DUO_TIMES[i]
    if d == nil d = -1.0 end
    duofile = DUOFILETIMES[i]
    if duofile == nil duofile = -1.0 end
    c = C_TIMES[i]
    if c == nil c = -1.0 end
    
    evidence = evidence .. "    {\n"
    evidence = evidence .. "      \"name\": \"" .. name .. "\",\n"
    evidence = evidence .. "      \"duo_lua_s\": " .. tostring(d) .. ",\n"
    evidence = evidence .. "      \"duo_duo_s\": " .. tostring(duofile) .. ",\n"
    evidence = evidence .. "      \"c_s\": " .. tostring(c) .. "\n"
    evidence = evidence .. "    }"
    if i < TIMED
        evidence = evidence .. ",\n"
    else
        evidence = evidence .. "\n"
    end
end
evidence = evidence .. "  ]\n}\n"

fs.write_file("benchmark_evidence.json", evidence)

if RESULT_FAIL_FLAG == 1
    os.exit(1)
end

print("══════════════════════════════════════════════════════════════════════════════")
print("✓ All benchmarks: results match and Duo .lua/.id >= C on measured time")
print("══════════════════════════════════════════════════════════════════════════════")

