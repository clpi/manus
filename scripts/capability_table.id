# The generated capability table — Pass 100 §22's replacement for a prose
# status ledger.
#
# §22 exists because this repository has repeatedly described capabilities it
# had not demonstrated. The repository note on it says the replacement is a
# GENERATED table over the rungs
#
#     described -> parsed -> checked -> C path -> direct-native
#              -> differentially proven -> canonical
#
# and that is what this builds. Every cell is MEASURED by running the compiler
# against a fixture, never asserted by a list someone maintains. A capability
# that stops working loses its rung on the next run; a capability nobody wrote
# a fixture for does not appear at all, which is the honest answer for it.
#
# THE RUNGS, and exactly what each one runs:
#
#   described  the fixture opens with a `--` line saying what it is for. A
#              file with no statement of intent is a program, not evidence.
#   parsed     `duo fmt` exits 0 on a COPY of the fixture — the front end
#              accepted the source. On a copy because fmt rewrites in place
#              and drops comments; see gap[048] and `_measure` below.
#   checked    `duo check <f>` exits 0 — sema accepted it too.
#   cpath      `#emit exe` links AND the binary runs without
#              hanging. Compiling is not running; the bench suite shipped
#              frozen answers for a year because nothing ran the result.
#   native     `--backend=direct #emit exe` links.
#   proven     direct and C agree on exit status. For `native_only/`, where
#              the C backend cannot compile the program at all and is
#              therefore not an oracle, the fixture declares its own answer as
#              `-- expect: N` and that is what must match.
#   canonical  the fixture lives in a BLOCKING directory, so losing any rung
#              above fails `zig build native-differential`. A capability that
#              is proven but not canonical is proven until someone breaks it
#              quietly.
#
# WHY EXIT STATUS AND NOT OUTPUT: `std.os.execute` collapses every nonzero
# status to 1, so a differential built on `std.script.run` compares 1 against 1
# and calls every divergence agreement. `std.script.status` reads the real code
# back through a subshell. Same reason scripts/native_differential.id does it.
#
# This is a REPORT, not a second gate: `native-differential` already blocks on
# the canonical rows and duplicating that here would mean two things to fix
# when one breaks. It fails only when it cannot have measured anything — an
# empty corpus, or a run where no row reached `canonical`, both of which are
# how a table like this silently reports a confident zero.

_WORK = "/tmp/duo-capability-table"

_rows = ""
_n = 0
_described = 0
_parsed = 0
_checked = 0
_cpath = 0
_native = 0
_proven = 0
_canonical = 0

_env_or(name: str, fallback: str): str
    v = std.script.getenv_or(name)
    if v == "" return fallback end
    v
end

# A miscompiled loop does not fail, it spins. 124 is the timeout marker.
_timeout_prefix = ""

_status(cmd: str): i64
    std.script.status(_timeout_prefix .. cmd)
end

_quiet(cmd: str): i64
    std.script.status(cmd .. " >/dev/null 2>&1")
end

_list(dir: str): any
    out = std.script.capture("ls " .. dir .. "/*.id 2>/dev/null")
    files = {}
    for _i, line in out:split("\n")
        t = std.script.chomp(line)
        if t != ""
            files[files:len() + 1] = t
        end
    end
    files
end

_stem(path: str): str
    std.script.chomp(std.script.capture("basename " .. path .. " .id"))
end

# The fixture's own statement of intent: does it carry a `--` comment line at
# all?
#
# `awk`, not `grep -c`, on purpose though not on evidence: `grep -c` EXITS 1
# when the count is zero, and a helper that answers "" for a failed command
# would invert this test silently. `std.script.capture` turned out to return
# the "0" anyway, so the grep form was not the bug — but the rung is one shell
# helper away from reading backwards, and awk always exits 0 and always prints
# a numeral. Do not swap it back to save a character.
_has_intent(src: str): bool
    std.script.chomp(std.script.capture(
        "awk '/^--/ {c++} END{print c+0}' " .. src)) != "0"
end

# `-- expect: N`, the declared answer for a program the C backend cannot be an
# oracle for.
_expect(src: str): str
    std.script.chomp(std.script.capture(
        "sed -n 's/^-- expect: *\\([0-9][0-9]*\\).*/\\1/p' " .. src .. " | head -1"))
end

_mark(reached: bool): str
    if reached return "  x" end
    "  ." end

# One fixture, one row. `blocking` says whether this directory's failures fail
# native-differential. `declared` marks `native_only/`, where the C backend is
# not an oracle and the fixture must state its own answer as `-- expect: N`.
#
# A `native_only/` fixture with no `-- expect:` header is NOT proven even when
# the C backend happens to compile it. Being in that directory is a claim that
# C cannot judge the program; if C can, the fixture is in the wrong directory,
# and reading a passing differential off it would be reading an oracle the
# fixture just said does not apply. scripts/native_differential.id fails such
# a file outright for the same reason, and this table must not disagree with
# the gate about what counts.
_measure(duo: str, src: str, group: str, blocking: bool, declared: bool): void
    name = _stem(src)
    bin_d = _WORK .. "/" .. name .. ".direct"
    bin_c = _WORK .. "/" .. name .. ".c"

    described = _has_intent(src)
    # `duo fmt` REWRITES ITS ARGUMENT IN PLACE, and it deletes comments
    # (gap[048]). The first version of this ran it on the fixture and
    # reformatted all 68 corpus files in one run: 13 broke, agreement fell
    # 59 -> 46, the `-- expect: N` headers `native_only/` depends on were
    # stripped, and this table then reported those numbers confidently from
    # evidence it had destroyed itself.
    #
    # A MEASUREMENT MUST NOT BE ABLE TO WRITE TO WHAT IT MEASURES. It runs on
    # a copy, and the copy is what gets rewritten.
    copy = _WORK .. "/" .. name .. ".fmt.id"
    std.script.run("cp " .. src .. " " .. copy)
    parsed = _quiet(duo .. " fmt " .. copy) == 0
    checked = _quiet(duo .. " check " .. src) == 0

    c_built = _quiet(duo .. " compile " .. src .. " --emit exe -o " .. bin_c) == 0
    c_rc = -1
    if c_built c_rc = _status(bin_c) end
    # Compiled is not run. A binary that hangs has no answer to compare.
    cpath = c_built and c_rc != 124

    native = _quiet(duo .. " compile " .. src .. " --backend=direct --emit exe -o " .. bin_d) == 0
    d_rc = -1
    if native d_rc = _status(bin_d) end

    want = _expect(src)
    proven = false
    if native and d_rc != 124
        if declared
            proven = want != "" and d_rc:to(str) == want
        else
            proven = cpath and d_rc == c_rc
        end
    end

    canonical = proven and blocking

    _n = _n + 1
    if described _described = _described + 1 end
    if parsed _parsed = _parsed + 1 end
    if checked _checked = _checked + 1 end
    if cpath _cpath = _cpath + 1 end
    if native _native = _native + 1 end
    if proven _proven = _proven + 1 end
    if canonical _canonical = _canonical + 1 end

    _rows = _rows .. _mark(described) .. _mark(parsed) .. _mark(checked)
        .. _mark(cpath) .. _mark(native) .. _mark(proven) .. _mark(canonical)
        .. "   " .. group .. "/" .. name .. "\n"
end

main: i64 = ()
    duo = _env_or("DUO", "./zig-out/bin/idol")
    corpus = _env_or("NATIVE_DIFF_CORPUS", "examples/native_differential")
    run_timeout = _env_or("NATIVE_DIFF_TIMEOUT", "10")

    if !std.script.fs_exists(duo)
        print("capability_table: FAIL — no compiler at " .. duo)
        return 1
    end

    for _i, cand in {"timeout", "gtimeout"}
        if _timeout_prefix == "" and std.script.chomp(std.script.capture(
            "command -v " .. cand .. " 2>/dev/null")) != ""
            _timeout_prefix = cand .. " " .. run_timeout .. " "
        end
    end

    std.script.run("rm -rf " .. _WORK .. " && mkdir -p " .. _WORK)

    for _i, src in _list(corpus)
        _measure(duo, src, "corpus", true, false)
    end
    for _i, src in _list(corpus .. "/native_only")
        _measure(duo, src, "native_only", true, true)
    end
    for _i, src in _list(corpus .. "/unsupported")
        _measure(duo, src, "unsupported", false, false)
    end
    for _i, src in _list(corpus .. "/known_divergent")
        _measure(duo, src, "known_divergent", false, false)
    end

    print("")
    print("  Pass 100 §22 — GENERATED capability table (" .. corpus .. ")")
    print("")
    print("  des par chk  cpa nat prv can   capability")
    print("  --- --- ---  --- --- --- ---   ----------")
    io.write(_rows)
    print("")
    print("  described  " .. _described:to(str) .. "/" .. _n:to(str))
    print("  parsed     " .. _parsed:to(str) .. "/" .. _n:to(str))
    print("  checked    " .. _checked:to(str) .. "/" .. _n:to(str))
    print("  c path     " .. _cpath:to(str) .. "/" .. _n:to(str))
    print("  native     " .. _native:to(str) .. "/" .. _n:to(str))
    print("  proven     " .. _proven:to(str) .. "/" .. _n:to(str))
    print("  canonical  " .. _canonical:to(str) .. "/" .. _n:to(str))
    print("")

    # Positive controls. A table like this fails by reporting nothing, not by
    # reporting something wrong, so both zeros are checked explicitly.
    if _n == 0
        print("capability_table: FAIL (empty corpus — nothing was measured)")
        return 1
    end
    if _canonical == 0
        print("capability_table: FAIL (no row reached canonical — the ladder is not wired)")
        return 1
    end
    print("capability_table: PASS")
    0
end
