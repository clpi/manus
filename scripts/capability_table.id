
work = "/tmp/idol-capability-table"

timeprep = ""
output = ""
total = 0
desc = 0
pars = 0
chk = 0
cp = 0
natcnt = 0
prv = 0
can = 0

envval: str = (name: str, fallback: str)
  v = script.getenv_or(name)
  if v == ""
    return fallback
  v

status: i64 = (cmd: str)
  script.status(timeprep .. cmd)

quiet: i64 = (cmd: str)
  script.status(cmd .. " >/dev/null 2>&1")

_exitmatch: bool = (want: str, actual: i64, out: str, err: str)
  actual:to(str) == want and script.status("test ! -s " .. out) == 0 and script.status("test ! -s " .. err) == 0

_exitcontrols: bool = ()
  out = work .. "/exit-control.stdout"
  err = work .. "/exit-control.stderr"
  script.fs_write(out, "")
  script.fs_write(err, "")
  if not _exitmatch("7", 7, out, err)
    return false
  script.fs_write(out, "noise")
  if _exitmatch("7", 7, out, err)
    return false
  script.fs_write(out, "")
  script.fs_write(err, "noise")
  if _exitmatch("7", 7, out, err)
    return false
  true

files: any = (dir: str)
  out = script.capture("ls " .. dir .. "/*.id 2>/dev/null")
  acc = {}
  for i, line in out:split("\n")
    t = script.chomp(line)
    if t != ""
      acc(acc:len() + 1) = t
  acc

name: str = (path: str)
  script.chomp(script.capture("basename " .. path .. " .id"))

hasint: bool = (src: str)
  script.chomp(script.capture("awk '/^--/ \{c++\} END\{print c+0\}' " .. src)) != "0"

declared: str = (src: str)
  script.chomp(script.capture("sed -n 's/^# expect-exit: *\\([0-9][0-9]*\\).*/\\1/p' " .. src .. " | head -1"))

rung: str = (reached: bool)
  if reached
    return "  x"
  "  ."

measure = (idol: str, src: str, group: str, blocking: bool, declaredans: bool)
  nm = name(src)
  bindir_d = work .. "/" .. nm .. ".direct"
  bindir_c = work .. "/" .. nm .. ".c"

  isdesc = hasint(src)
  copy = work .. "/" .. nm .. ".fmt.id"
  script.run("cp " .. src .. " " .. copy)
  ispars = quiet(idol .. " fmt " .. copy) == 0
  ischk = quiet(idol .. " check " .. src) == 0

  cbuilt = quiet(idol .. " compile " .. src .. " --emit exe -o " .. bindir_c) == 0
  cout = bindir_c .. ".stdout"
  cerr = bindir_c .. ".stderr"
  crc = -1
  if cbuilt
    crc = status(bindir_c .. " >" .. cout .. " 2>" .. cerr)
  iscp = cbuilt and crc != 124

  isnat = quiet(idol .. " compile " .. src .. " --backend=direct --emit exe -o " .. bindir_d) == 0
  dout = bindir_d .. ".stdout"
  derr = bindir_d .. ".stderr"
  drc = -1
  if isnat
    drc = status(bindir_d .. " >" .. dout .. " 2>" .. derr)

  want = declared(src)
  isprv = false
  if isnat and drc != 124
    if declaredans
      isprv = want != "" and _exitmatch(want, drc, dout, derr)
    else
      isprv = iscp and drc == crc

  iscan = isprv and blocking

  total = total + 1
  if isdesc
    desc = desc + 1
  if ispars
    pars = pars + 1
  if ischk
    chk = chk + 1
  if iscp
    cp = cp + 1
  if isnat
    natcnt = natcnt + 1
  if isprv
    prv = prv + 1
  if iscan
    can = can + 1

  output = output .. rung(isdesc) .. rung(ispars) .. rung(ischk) .. rung(iscp) .. rung(isnat) .. rung(isprv) .. rung(iscan) .. "   " .. group .. "/" .. nm .. "\n"

main: i64 = ()
  idol = envval("IDOL", envval("DUO", "./zig-out/bin/idol"))
  corpus = envval("NATIVE_DIFF_CORPUS", "examples/native_differential")
  run_timeout = envval("NATIVE_DIFF_TIMEOUT", "10")

  if not script.fs_exists(idol)
    print("capability_table: FAIL — no compiler at " .. idol)
    return 1

  for i, cand in { "timeout", "gtimeout" }
    if timeprep == "" and script.chomp(script.capture("command -v " .. cand .. " 2>/dev/null")) != ""
      timeprep = cand .. " " .. run_timeout .. " "

  script.run("rm -rf " .. work .. " && mkdir -p " .. work)
  if not _exitcontrols()
    print("capability_table: FAIL — exit-oracle controls accepted matching status with stdout/stderr")
    return 1

  for i, src in files(corpus)
    measure(idol, src, "corpus", true, false)
  for i, src in files(corpus .. "/native_only")
    measure(idol, src, "native_only", true, true)
  for i, src in files(corpus .. "/unsupported")
    measure(idol, src, "unsupported", false, false)
  for i, src in files(corpus .. "/known_divergent")
    measure(idol, src, "known_divergent", false, false)

  print("")
  print("  GENERATED capability table (" .. corpus .. ")")
  print("")
  print("  des par chk  cpa nat prv can   capability")
  print("  --- --- ---  --- --- --- ---   ----------")
  stdout:write(output)
  print("")
  print("  described  " .. desc:to(str) .. "/" .. total:to(str))
  print("  parsed     " .. pars:to(str) .. "/" .. total:to(str))
  print("  checked    " .. chk:to(str) .. "/" .. total:to(str))
  print("  c path     " .. cp:to(str) .. "/" .. total:to(str))
  print("  native     " .. natcnt:to(str) .. "/" .. total:to(str))
  print("  proven     " .. prv:to(str) .. "/" .. total:to(str))
  print("  canonical  " .. can:to(str) .. "/" .. total:to(str))
  print("")

  if total == 0
    print("capability_table: FAIL (empty corpus — nothing was measured)")
    return 1
  if can == 0
    print("capability_table: FAIL (no row reached canonical — the ladder is not wired)")
    return 1
  print("capability_table: PASS")
  0
