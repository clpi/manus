capture: str = (shellline: str)
  gatecap(shellline)

chomp: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

status: i64 = (shellline: str)
  chomp(capture("{shellline} >/dev/null 2>&1; printf \"%d\" $?")):to(i64)

run: i64 = (shellline: str)
  capture(shellline)
  0

here: str = ()
  chomp(capture("pwd"))

compiler: str = (root: str)
  "{root}/zig-out/bin/idol"

shout: i64 = (msg: str)
  print("luahost: {msg}")
  0

tally: i64 = (cmd: str)
  chomp(capture(cmd)):to(i64)

present: bool = (path: str)
  status("test -e {path}") == 0

main: i64 = ()
  root = here()
  bin = compiler(root)
  bad = 0

  if status("false") == 0
    shout("FAIL — control: status() called `false` a success")
    bad = bad + 1

  if !present(bin)
    shout("FAIL — no compiler at {bin}; run `zig build` first")
    bad = bad + 1

  total = tally("cd {root} && ls examples/luahost/*.id 2>/dev/null | wc -l")
  if total < 12
    shout("FAIL — corpus holds {total} case(s), fewer than the 12 ported")
    bad = bad + 1

  work = chomp(capture("mktemp -d"))
  deny = "{work}/deny.id"
  run("printf 'x = [[unterminated\\n' > {deny}")
  if status("{bin} check {deny} >/dev/null 2>&1") == 0
    shout("FAIL — control: an unterminated long string was ACCEPTED")
    bad = bad + 1
  run("rm -rf {work}")

  fails = tally("cd {root} && n=0; for f in examples/luahost/*.id; do {bin} check $f >/dev/null 2>&1 || n=$((n+1)); done; echo $n")
  if fails != 0
    shout("FAIL — {fails} of {total} corpus case(s) rejected")
    shout("the rejected cases, with their diagnostics:")
    print(capture("cd {root} && for f in examples/luahost/*.id; do {bin} check $f >/dev/null 2>&1 || {bin} check $f 2>&1 | grep error: | head -2; done"))
    bad = bad + 1

  if bad == 0
    shout("PASS — {total} hosted-language cases accepted, 4 controls held")
  return bad

os.exit(main())
