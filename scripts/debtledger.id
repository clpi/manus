# Aggregate non-duon source ledger for the self-hosting target.
#
# This is intentionally standalone evidence. It does not change any ratchet or
# build step; it prints the current queues that must reach zero.

script = std.script

lines: any = (text: str)
    out = {}
    start = 1
    i = 1
    n = text:len()
    while i <= n
        if text:byte(i) == 10
            if i > start
                out[out:len() + 1] = text:sub(start, i - 1)
            start = i + 1
        i += 1
    if start <= n
        out[out:len() + 1] = text:sub(start, n)
    out

list: any = (root: str, cmd: str)
    lines(script.capture("cd '{root}' && {cmd}"))

num: i64 = (root: str, cmd: str)
    out = script.chomp(script.capture("cd '{root}' && {cmd}"))
    if out == ""
        return 0
    to(i64)(out)

starts: bool = (path: str, prefix: str)
    path:len() >= prefix:len() and path:sub(1, prefix:len()) == prefix

has: bool = (text: str, part: str)
    text:find(part, 1, true) != nil

zigbucket: str = (path: str)
    if path == "build.zig"
        return "zigbuild"
    if has(path, "test") or has(path, "fixture")
        return "zigtest"
    if has(path, "wasm")
        return "zigwasm"
    if has(path, "native") or has(path, "dnir") or has(path, "abi")
        return "zignative"
    if has(path, "semantic") or has(path, "graph") or has(path, "relation") or has(path, "realization")
        return "zigsemantic"
    if has(path, "lexer") or has(path, "parser") or has(path, "token") or has(path, "sema")
        return "zigfront"
    if has(path, "codegen") or has(path, "backend") or has(path, "lower") or has(path, "jit")
        return "zigback"
    "zigsupport"

zigcontrol: i64 = ()
    bad = 0
    if zigbucket("build.zig") != "zigbuild"
        print("debtledger: fail control zigbuild")
        bad += 1
    if zigbucket("src/parser.zig") != "zigfront"
        print("debtledger: fail control zigfront")
        bad += 1
    if zigbucket("src/native_backend.zig") != "zignative"
        print("debtledger: fail control zignative")
        bad += 1
    if zigbucket("src/wasm_semantic.zig") != "zigwasm"
        print("debtledger: fail control zigwasm")
        bad += 1
    if bad == 0
        print("debtledger: control ok")
    bad

bootc: bool = (path: str)
    starts(path, "src/") or starts(path, "lib/c/")

generated: bool = (root: str, path: str)
    if path == "ext/vscode-duo/extension.js"
        script.status("cd '{root}' && ./zig-out/bin/idol run scripts/vscodeproj.id") == 0
    elseif path == "ext/tree-sitter-duo/grammar.js"
        script.status("cd '{root}' && env TSEMIT_CHECK=1 ./zig-out/bin/idol run scripts/treesitter_emit.id") == 0
    else
        false
    end

partial: bool = (root: str, path: str)
    false

pickjs: any = (root: str, files: any, mode: str)
    out = {}
    for i = 1, files:len()
        path = files[i]
        isgen = generated(root, path)
        ispart = partial(root, path)
        if mode == "generated" and isgen
            out[out:len() + 1] = path
        elseif mode == "partial" and ispart
            out[out:len() + 1] = path
        elseif mode == "authored" and !isgen and !ispart
            out[out:len() + 1] = path
    out

pickc: any = (files: any, mode: str)
    out = {}
    for i = 1, files:len()
        path = files[i]
        isboot = bootc(path)
        if mode == "boot" and isboot
            out[out:len() + 1] = path
        elseif mode == "oracle" and !isboot
            out[out:len() + 1] = path
    out

show: i64 = (name: str, files: any)
    count = files:len()
    print("{name} {count}")
    for i = 1, count
        print("  {files[i]}")
    count

showzig: i64 = (name: str, files: any)
    count = 0
    for i = 1, files:len()
        if zigbucket(files[i]) == name
            count += 1
    print("{name} {count}")
    for i = 1, files:len()
        if zigbucket(files[i]) == name
            print("  {files[i]}")
    count

shownum: i64 = (name: str, value: i64)
    print("{name} {value}")
    value

main: i64 = ()
    root = script.chomp(script.capture("git rev-parse --show-toplevel 2>/dev/null"))
    if root == ""
        print("debtledger: fail no git root")
        std.os.exit(3)

    zig = list(root, "git ls-files '*.zig' | sort")
    c = list(root, "git ls-files '*.[ch]' | sort")
    cboot = pickc(c, "boot")
    coracle = pickc(c, "oracle")
    js = list(root, "git ls-files '*.js' | sort")
    jsgen = pickjs(root, js, "generated")
    jspart = pickjs(root, js, "partial")
    jsauth = pickjs(root, js, "authored")
    scratch = list(root, "find . -maxdepth 1 -type f \\( -name '*.py' -o -name '*.sh' \\) -print | sort")
    embedded = num(root, "git ls-files '*.id' | grep -v '^scripts/foreign_census.id$' | tr '\\n' '\\0' | xargs -0 grep -h -E '@(comp\\.)?c\\.(emit|include)' 2>/dev/null | grep -v -E '^[[:space:]]*--' | grep -o -E '@(comp\\.)?c\\.(emit|include)' | wc -l")

    total = 0
    bad = zigcontrol()
    total += show("zig", zig)
    showzig("zigbuild", zig)
    showzig("zigfront", zig)
    showzig("zigback", zig)
    showzig("zignative", zig)
    showzig("zigwasm", zig)
    showzig("zigsemantic", zig)
    showzig("zigtest", zig)
    showzig("zigsupport", zig)
    total += show("cboot", cboot)
    show("coracle", coracle)
    total += show("jsgenerated", jsgen)
    total += show("jspartial", jspart)
    total += show("jsauthored", jsauth)
    total += show("scratch", scratch)
    total += shownum("embeddedc", embedded)

    if total == 0
        print("debtledger: pass total 0")
        std.os.exit(bad)
    print("debtledger: fail total {total}")
    std.os.exit(1)
    0
