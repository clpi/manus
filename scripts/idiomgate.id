# idiomgate — staged-diff MIGRATION PREFLIGHT only. NOT semantic authority.
#
# Classification: temporary migration approximation.
# Reason: blocks known-debt spellings on ADDED lines until graph canonicality
# executes on the same staged diff.
# Production authority approximated: GAP-124 graph obligations via scripts/canon.id
# and future production parse → resolve → graph → verdict path.
# Forbidden detector kingdoms (removed, do not reintroduce): codens, luahash,
# opcast, readface, materialize, suffix. Callable result demand belongs to
# scripts/semanticgate.id staged census + examples/spec100/result.id + canon.id.
#
# String matching here is evidence for migration pressure only. It must never
# decide namespace, length, cast, world, or relation identity verdicts.
# Source snippets enter the real compiler for semantic tests; they are not judged
# by a second parser in this gate.
#
# Why the diff and !the tree: 756 .id files still carry bare `end` and 227
# carry Lua module idioms. A whole-tree gate would block every commit until a
# 756-file migration landed, so it would be switched off within a day.
#
# Scans ONLY THE LINES THE DIFF ADDS and every path those additions touch.
# Whole-file scanning looks stricter and is worse: it makes every debt-carrying
# file untouchable and punishes the person REPAIRING one, so it gets switched
# off. Added lines only freezes the debt and makes every new line canonical.
#
# Path and home names obey the same LAW-ONE as bindings. Concat/mashed file and
# directory stems are forbidden — semantic units belong in nested homes through
# hierarchy (`semantic/graph.id`), never mashed compounds (`semantic_graph.id`).
#
# Gate transport: Idol only — stdin via stdin:read(). No os.args, no --backend=c.
#   git diff -U0 ... | idol run scripts/idiomgate.id
#   idol run scripts/idiomgate.id < /path/to.diff
#
# Gate scan law (agents: AGENTS.md § Gate scan boundaries):
#   scan(diff)(body) — diff is a SYMBOL in the curry slot, not "diff" string.
#   dot(world) = (code: str) — world symbol in dot(world); call dot(io)(code).
#   hit(io) = (code: str) — world prefix symbol; call hit(io)(code).
#   len(path) = (min: i64) — path string boundary; call len(path)(min).
#   audit(path) = (pattern: str) — required pattern; call audit(path)(pattern).
#   hit(path) = (pattern: str) — forbidden pattern; call hit(path)(pattern).
#   Never scandiff / scanline / diffhead / bareend / flat len(path, min).

transport: str = ()
    text = stdin:read()
    if text:len() == 0
        return ""
    text

# Runs a POSITIVE CONTROL before any verdict.

# Pattern rows live in rules() — no module-level keyed table (direct-native).

word: bool = (c: str)
    alpha(c) or upper(c) or digit(c) or c == "_"

# Worlds (io, os) are authority — never namespace.method(). One word per binding;
# world and owner are arguments across the relation, not mashed into the name.
# Exception: bootstrap foreign ingress in scripts/ingress/* only (GAP-155).
peek(prefix: str, code: str)
    n = code:len()
    m = prefix:len()
    i = 1
    while i + m - 1 <= n
        if code:sub(i, i + m - 1) == prefix
            before = ""
            if i > 1
                before = code:sub(i - 1, i - 1)
            if before != "." and (before == "" or !word(before))
                j = i + m
                start = j
                while j <= n and word(code:sub(j, j))
                    j += 1
                if j > start
                    k = j
                    while k <= n and (code:sub(k, k) == " " or code:sub(k, k) == "\t")
                        k += 1
                    if k <= n and code:sub(k, k) == "("
                        return true
        i += 1
    false

hit(io) = (code: str)
    peek("io.", code)

hit(os) = (code: str)
    peek("os.", code)

edge: bool = (prefix: str, code: str)
    n = code:len()
    m = prefix:len()
    i = 1
    while i + m - 1 <= n
        if code:sub(i, i + m - 1) == prefix
            j = i + m
            start = j
            while j <= n and word(code:sub(j, j))
                j += 1
            if j > start
                k = j
                while k <= n and (code:sub(k, k) == " " or code:sub(k, k) == "\t")
                    k += 1
                if k <= n and code:sub(k, k) == "("
                    return true
        i += 1
    false

dot(io) = (code: str)
    hit(io)(code)

dot(os) = (code: str)
    hit(os)(code)

dot(std) = (world: str, code: str)
    edge("std.{world}.", code)

ingress: bool = (path: str)
    path:len() >= 17 and path:sub(1, 17) == "scripts/ingress/"

# Needle membership is subject-first only: hay:has(needle). Never has(hay, needle).

# Subject-first law: scanned source must use subject:rel(...), never rel(subject) or world:rel(...).
subject(has) = (code: str)
    n = code:len()
    i = 1
    while i + 3 <= n
        if code:sub(i, i + 3) == "has("
            before = ""
            if i > 1
                before = code:sub(i - 1, i - 1)
            if before != ":" and (before == "" or !word(before))
                true
        i += 1
    false

subject(tail) = (code: str)
    n = code:len()
    i = 1
    while i + 4 <= n
        if code:sub(i, i + 4) == "tail("
            before = ""
            if i > 1
                before = code:sub(i - 1, i - 1)
            if before != ":" and (before == "" or !word(before))
                true
        i += 1
    false

subject(read) = (code: str)
    code:has("io:read(") or code:has("io.read(")

rule: i64 = (path: str, no: i64, code: str, pat: str, law: str, fix: str)
    if code:has(pat)
        print("{path}:{no}  {pat}  [{law}]  {fix}")
        1
    else
        0

rules: i64 = (path: str, no: i64, code: str)
    hits = 0
    hits += rule(path, no, code, "_", "LAW-ONE", "one lowercase word: a LEVEL read(number), a HOME date.pad, or delete the axis")
    hits += rule(path, no, code, "end", "Pass 100 §7", "`end` is DELETED — outdent")
    hits += rule(path, no, code, ";", "Pass 119 §1", "the semicolon does not exist — press enter")
    hits += rule(path, no, code, "local", "§1 deny", "bindings are already scoped")
    hits += rule(path, no, code, "require", "§1 deny", "no import — reachability is scope/home projection")
    hits += rule(path, no, code, "then", "§1 deny", "outdent")
    hits += rule(path, no, code, "tostring", "§1 deny", "x:to(str)")
    hits += rule(path, no, code, "tonumber", "§1 deny", "x:to(i64) — and it ROUTES on failure")
    hits += rule(path, no, code, "pcall", "§1 deny", "t | error — failure routes (B-15)")
    hits += rule(path, no, code, "setmetatable", "§1 deny", "descriptors and protocols")
    hits += rule(path, no, code, "pairs", "§1 deny", "iterate the value: xs:each()")
    hits += rule(path, no, code, "if not ", "LEXICAL", "prefix ! — if !expr; never if not expr")
    hits += rule(path, no, code, " and not ", "LEXICAL", "prefix ! — and !expr; never and not expr")
    hits += rule(path, no, code, " or not ", "LEXICAL", "prefix ! — or !expr; never or not expr")
    hits += rule(path, no, code, "(not ", "LEXICAL", "prefix ! — (!expr); never (not expr)")
    hits += rule(path, no, code, ".new(", "LADDER", "desc{…} · x:to(desc) · p:from(mode)(…) · file.open")
    hits += rule(path, no, code, ".create(", "LADDER", "desc{…}")
    hits += rule(path, no, code, "make", "LADDER", "desc{…} — make* is banned")
    hits += rule(path, no, code, "self", "SELF-ZERO", ".x · leading :call() · `.` is the subject · ... spreads it")
    hits += rule(path, no, code, " .. ", "FMT-ONE", "`{{}}` interpolation — never `..` concatenation")
    hits += rule(path, no, code, "os.args(", "host-TEMP", "os.args[n] table under os world — never os.args()")
    hits += rule(path, no, code, "os.getenv(", "host-TEMP", "os.env[key] / os.env(key) — environment is not a thing")
    hits += rule(path, no, code, "environment[", "host-TEMP", "environment is not a thing — use os.env[key]")
    hits += rule(path, no, code, "environment:", "host-TEMP", "environment is not a thing — use os.env[key]")
    hits += rule(path, no, code, "io.popen(", "host-TEMP", "command(line) then c:open(mode) across process boundary — docs/spec/host.md")
    hits += rule(path, no, code, "popen(", "host-TEMP", "command(line) then c:open(mode) — never popen")
    hits += rule(path, no, code, "io:popen(", "host-TEMP", "command(line) then c:open(mode) across process boundary")
    hits += rule(path, no, code, ":popen(", "host-TEMP", "c:open(mode) on command subject — never :popen")
    hits += rule(path, no, code, "os.execute(", "host-TEMP", "structured command + process world — docs/spec/host.md")
    hits += rule(path, no, code, "io.read(", "law.readable", "stdin:read() or path:read() — readable protocol on the subject; never io.read")
    hits += rule(path, no, code, "io.open(", "law.world.dot", "path:open(mode) — subject-first; never io.open dot")
