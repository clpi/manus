    hits += rule(path, no, code, "os.exit(", "law.world.dot", "demand/transition — never os.exit(); docs/spec/world.md")
    hits += rule(path, no, code, "use(", "projection", "no admission syntax — scope/home projection only")
    hits += rule(path, no, code, "using(", "projection", "no admission syntax — scope/home projection only")
    hits += rule(path, no, code, "inject(", "projection", "no admission syntax — scope/home projection only")
