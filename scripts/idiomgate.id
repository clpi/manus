    hits += rule(path, no, code, "pathbody", "LAW-ONE", "path file under scratch — never path+body mash")
    hits += rule(path, no, code, "treebody", "LAW-ONE", "reuse path under scratch — never tree+body mash")
    hits += rule(path, no, code, "hostdiff", "LAW-ONE", "host file under scratch — decompose owner and role")
    hits += rule(path, no, code, "pathgate", "LAW-ONE", "path file under scratch — decompose owner and role")
    hits += rule(path, no, code, "treegate", "LAW-ONE", "path file under scratch — decompose owner and role")
    hits += rule(path, no, code, "scan(\\\"diff\\\")", "LAW-ONE", "scan(body) — one word; diff is the transport boundary, not a string tag")
    hits += rule(path, no, code, "scan(\\\"path\\\")", "LAW-ONE", "scan(body) — one word; path list is the transport boundary, not a string tag")
    hits += rule(path, no, code, "qualworlddot", "LAW-ONE", "dot(std)(world, code) — relation family; never qual+world+dot mash")
    hits += rule(path, no, code, "ingressonly", "LAW-ONE", "ingress(path) — one word; never ingress+only mash")
    hits += rule(path, no, code, "only(ingress)", "LAW-ONE", "ingress(path) — ingress is the relation, not only(ingress)")
    hits += rule(path, no, code, "worlddot", "LAW-ONE", "dot(io)(code) / dot(os)(code) — relation family; never world+dot mash")
    hits += rule(path, no, code, "captureline", "LAW-ONE", "chomp(capture(cmd)) — never capture+line mash")
    hits += rule(path, no, code, "[[", "lexical", "use \\\" text \\\" — double quotes admit multiline content")
    hits


# lowercase letter, for the LAW-ONE [a-z]_[a-z] check
alpha: bool = (c: str)
    c >= "a" and c <= "z"

upper: bool = (c: str)
    c >= "A" and c <= "Z"

digit: bool = (c: str)
    c >= "0" and c <= "9"

# true when code introduces a Lua dash comment outside strings
dash: bool = (code: str)
    n = code:len()
    quote = ""
    i = 1
    while i <= n
        c = code:sub(i, i)
        if quote == ""
            if c == "#"
                return false
            if c == "\"" or c == "'"
                quote = c
            else
                if c == "-" and i < n and code:sub(i + 1, i + 1) == "-"
                    if i + 2 <= n and code:sub(i + 2, i + 2) == "-"
                        i = i + 1
                    else
                        before = ""
                        if i > 1
                            before = code:sub(i - 1, i - 1)
                        if before == "" or before == " " or before == "\t"
                            return true
        else
            if c == quote
                quote = ""
        i = i + 1
    false

# Strip comments and string bodies so a rule cannot fire on prose or on this
# file's own rule table. Quotes are replaced by spaces, not removed, so column
# numbers stay true.
strip: str = (line: str)
    out = ""
    n = line:len()
    quote = ""
    i = 1
    while i <= n
        c = line:sub(i, i)
        if quote == ""
            if c == "#"
                return out
            if c == "\"" or c == "'"
                quote = c
                out = "{out} "
            else
                out = "{out}{c}"
        else
            if c == quote
                quote = ""
            out = "{out} "
        i = i + 1
    out

# LAW-ONE has no spelling exemptions. Qualification belongs to levels and
# homes; an underscore in idsem source is migration debt regardless of where it
# occurs in an identifier.
under: bool = (code: str)
    n = code:len()
    i = 1
    while i <= n
        if code:sub(i, i) == "_"
            return true
        i = i + 1
    false

# Uppercase is not a descriptor convention in idsem. Cases, descriptors,
# bindings, homes, relations, and generated identities share the same law.
capital: bool = (code: str)
    n = code:len()
    i = 1
    while i <= n
        c = code:sub(i, i)
        before = ""
        if i > 1
            before = code:sub(i - 1, i - 1)
        if digit(c) and (i == 1 or (!alpha(before) and !upper(before) and before != "_"))
            i = i + 1
            while i <= n and (alpha(code:sub(i, i)) or upper(code:sub(i, i)) or digit(code:sub(i, i)) or code:sub(i, i) == "_" or code:sub(i, i) == ".")
                i = i + 1
        else
            if upper(c)
                return true
            i = i + 1
    false

token: bool = (code: str, sought: str)
    n = code:len()
    m = sought:len()
    i = 1
    while i + m - 1 <= n
        if code:sub(i, i + m - 1) == sought
            before = ""
            after = ""
            if i > 1
                before = code:sub(i - 1, i - 1)
            if i + m <= n
                after = code:sub(i + m, i + m)
            if (before == "" or !word(before)) and (after == "" or !word(after))
                return true
        i = i + 1
    false

# Concatenation with `..` is forbidden everywhere — use `{}` interpolation.
bridge: bool = (code: str)
    n = code:len()
    quote = ""
    i = 1
    while i <= n
        c = code:sub(i, i)
        if quote == ""
            if c == "#"
                return false
            if c == "\"" or c == "'"
                quote = c
            else
                if i + 1 <= n and code:sub(i, i + 1) == ".."
                    if i + 2 <= n and code:sub(i + 2, i + 2) == "."
                        i += 1
                    else
                        return true
        else
            if c == quote
                quote = ""
        i += 1
    false

# true when code uses place = place op value instead of canonical place op= value
expand: bool = (code: str)
    n = code:len()
    i = 1
    while i <= n
        if code:sub(i, i) == "="
            if i > 1
                prev = code:sub(i - 1, i - 1)
                if prev == "+" or prev == "-" or prev == "*" or prev == "/" or prev == "<" or prev == ">" or prev == "!"
                    i += 1
                    continue
            if i < n and code:sub(i + 1, i + 1) == "="
                i += 2
                continue
            j = i - 1
            while j >= 1 and (code:sub(j, j) == " " or code:sub(j, j) == "\t")
                j -= 1
            endpos = j
            while j >= 1 and word(code:sub(j, j))
                j -= 1
            k = i + 1
            while k <= n and (code:sub(k, k) == " " or code:sub(k, k) == "\t")
                k += 1
            start = k
            while k <= n and word(code:sub(k, k))
                k += 1
            if k > start and endpos >= j + 1
                left = code:sub(j + 1, endpos)
                right = code:sub(start, k - 1)
                if left == right
                    while k <= n and (code:sub(k, k) == " " or code:sub(k, k) == "\t")
                        k += 1
                    if k <= n
                        op = code:sub(k, k)
                        if op == "+" or op == "-" or op == "*" or op == "/"
                            return true
        i += 1
    false

# a bare `end` occupying its own line
bare: bool = (code: str)
    t = ""
    n = code:len()
    i = 1
    while i <= n
        c = code:sub(i, i)
        if c != " " and c != "\t"
            t = "{t}{c}"
        i = i + 1
    t == "end"

words = " graph lexer parser compiler token scope world demand relation semantic native backend read line old thing layout home origin law stage role value witness place realize machine emit target bind host profile rewrite fmt check trace proof schema cursor thread sync time random hash crypto net path bytes str text json io mem heap bit flag table vector meta script build config foreign wasm os process signal id idol gap agent bench engine opcode decode run tool orient doctor manifest ledger census gate smoke audit highlight capability idiom module surface correctness embed hygiene repro init spec corpus constitution authority bootstrap tooling performance contributing alignment integration readme examples scripts tools lib src gaps tests benchmarks docs agents cursor rules hooks lower codegen sema ast term transaction snapshot reach layout compound name proof fixture benchmark generated migration cache legacy compat foreign history numeric version taxonomy suffix array back end write file dir view quick fstest iotest cmplx ascii adler subtle strbuilder tabwriter scanner template jpeg png gif flate gzip zlib lzw crc fnv sha hmac rand split join concat format emit lower codegen parse symbol scope compress encode decode image color database sql encoding testing grammar classify role classify wasm wasi jit simd memory stack value engine probe derived verify perf hash ledger claim debt embed zig shc ftcftw perf js c census dig full vscode emit project materialization priority chained comparison capability scan "

known: bool = (word: str)
    m = word:len()
    if m < 2
        return false
    needle = " {word} "
    hay = words
    n = hay:len()
    k = needle:len()
    i = 1
    while i + k - 1 <= n
        if hay:sub(i, i + k - 1) == needle
            return true
        i = i + 1
    false

sep: bool = (name: str)
    n = name:len()
    i = 1
    while i <= n
        c = name:sub(i, i)
        if c == "_" or c == "-" or upper(c)
            return true
        i = i + 1
    false

# numeric suffix taxonomy on a path word. Subject-first: name:tail().
tail: bool = (name: str)
    n = name:len()
    if n < 2
        return false
    if !digit(name:sub(n, n))
        return false
    i = n - 1
    while i >= 1 and digit(name:sub(i, i))
        i = i - 1
    i == 0 or alpha(name:sub(i, i)) or name:sub(i, i) == "_"

compound: bool = (name: str)
    if known(name)
        return false
    n = name:len()
    if n >= 5 and name:sub(n - 4, n) == "proof"
        left = name:sub(1, n - 5)
        if left:len() >= 2 and known(left)
            return true
    if n < 4
        return false
    i = 2
    while i <= n - 1
        left = name:sub(1, i - 1)
        right = name:sub(i, n)
        if left:len() >= 2 and right:len() >= 2 and known(left) and known(right)
            return true
        i = i + 1
    false

foreign: bool = (path: str)
    path:len() >= 4 and path:sub(1, 4) == "ext/"

owned: bool = (path: str)
    !foreign(path)

stem: str = (path: str)
    slash = 0
    i = path:len()
    while i >= 1
        if path:sub(i, i) == "/"
            slash = i
            break
        i = i - 1
    base = path
    if slash > 0
        base = path:sub(slash + 1, path:len())
    stop = 0
    i = base:len()
    while i >= 1
        if base:sub(i, i) == "."
            stop = i
            break
        i = i - 1
    if stop <= 1
        base
    else
        base:sub(1, stop - 1)

judge: i64 = (where: str, name: str)
    hits = 0
    if name:len() == 0
        return 0
    if sep(name)
        print("{where}  [law.path.name]  snake_case or separator `{name}` — one lowercase word; use home hierarchy")
        hits += 1
    if name:tail()
        print("{where}  [law.path.name]  numeric taxonomy `{name}` — version is provenance, not a path word")
        hits += 1
    if compound(name)
        print("{where}  [PATH-SEMANTICS-BLOCKED]  mashed compound `{name}` — decompose into homes/worlds through hierarchy")
        hits += 1
    hits

route: i64 = (path: str)
    if !owned(path)
        return 0
    hits = judge(path, stem(path))
    part = ""
    n = path:len()
    i = 1
    while i <= n
        c = path:sub(i, i)
        if c == "/"
            if part:len() > 0 and part:sub(1, 1) != "."
                hits += judge("{path}:", part)
            part = ""
        else
            part = "{part}{c}"
        i += 1
    if part:len() > 0 and part:sub(1, 1) != "." and part != stem(path)
        hits += judge("{path}:", part)
    hits

router(semantic) = (home: str)
    home:read()

check(semantic) = (slot: str)
    path = "lib/semantic/graph.id"
    if slot == "vocab"
        path = "lib/semantic/vocabulary.id"
    if slot == "ingest"
        path = "lib/semantic/ingest.id"
    if slot == "census"
        path = "lib/semantic/census.id"
    path:read()

seed: bool = ()
    body = check(semantic)("vocab")
    if body:len() < 32
        false
    if body:match("relationid")
        false
    if body:match("read = 10")
        false
    if !body:has("standard = ingest.resident")
        false
    body = check(semantic)("ingest")
    if body:len() < 32
        false
    if !body:has("resident = {")
        false
    if !body:has("|io/read|")
        false
    body = check(semantic)("census")
    if body:len() < 16
        false
    if !body:has("forbidden = ")
        false
    if !body:has("|std|")
        false
    if body:has("worlds = \"|std|")
        false
    body = check(semantic)("graph")
    if body:len() < 16
        false
    true

audit: i64 = (path: str, no: i64, line: str)
    code = strip(line)
    hits = 0
    if bare(code)
        print("{path}:{no}  end  [Pass 100 §7]  `end` is DELETED — outdent")
        hits += 1
    if under(code)
        print("{path}:{no}  underscore  [LAW-ONE]  one lowercase word: a LEVEL, a HOME, or delete the axis")
        hits += 1
    if capital(code)
        print("{path}:{no}  uppercase  [LAW-ONE]  no uppercase in an identifier, ever: point, error, max")
        hits += 1
    if code:has(";")
        print("{path}:{no}  semicolon  [Pass 119 §1]  the semicolon does not exist — press enter")
        hits += 1
    if dash(line)
        print("{path}:{no}  dash comment  [LEXICAL]  `#` starts a comment — `--` is Lua debt")
        hits += 1
    if bridge(line)
        print("{path}:{no}  concat  [FMT-ONE]  `{{}}` interpolation — never `..` concatenation")
        hits += 1
    if expand(code)
        print("({path}, {no}, migratable, law.update.face, place += value — use += -= *= /=; never place = place op value)")
        hits += 1
    if code:has("function")
        print("{path}:{no}  function  [§1]  callable binding: name: i64 = (a: i64)")
        hits += 1
    if code:has("require")
        print("{path}:{no}  require  [§0h]  std is the prelude graph — no import")
        hits += 1
    if code:has("tostring")
        print("{path}:{no}  tostring  [§1]  x:to(str)")
        hits += 1
    if code:has("pcall")
        print("{path}:{no}  pcall  [B-15]  t | error — failure routes")
        hits += 1
    if code:has("setmetatable")
        print("{path}:{no}  setmetatable  [§1]  descriptors and protocols")
        hits += 1
    if token(code, "nil")
        print("({path}, {no}, invalid, law.lua.hosted, nil is a Lua value; use the admitted semantic case)")
        hits += 1
    if code:has(".new(")
        print("{path}:{no}  .new(  [LADDER]  desc{{…}} · x:to(desc) · p:from(mode)(…)")
        hits += 1
    if subject(has)(code)
        print("{path}:{no}  has(  [law.world.dot]  hay:has(needle) — subject-first; never has(hay, needle)")
        hits += 1
    if subject(tail)(code)
        print("{path}:{no}  tail(  [law.world.dot]  name:tail() — subject-first; never tail(name)")
        hits += 1
    if subject(read)(code)
        print("{path}:{no}  io:read(  [law.readable]  stdin:read() or path:read() — readable protocol on the subject")
        hits += 1
    hits += rules(path, no, code)
    if !ingress(path)
        if dot(io)(code)
            print("({path}, {no}, violation, law.world.dot, io is a world — stdin:read() / path:read() / subject:relation(); never io.method())")
            hits += 1
        if dot(os)(code)
            print("({path}, {no}, violation, law.world.dot, os is a world — use os.args[n] / os.env[k]; never os.method())")
            hits += 1
        if dot(std)(io, code)
            print("({path}, {no}, violation, law.world.dot, std.io is forbidden — stdin:read() / path:read() / subject:relation(); docs/spec/world.md")
            hits += 1
        if dot(std)(os, code)
            print("({path}, {no}, violation, law.world.dot, std.os is forbidden — use root projection or bridge relations; docs/spec/world.md")
            hits += 1
    pi = 1
    pn = code:len()
    while pi <= pn
        c = code:sub(pi, pi)
        if word(c)
            start = pi
            while pi <= pn and word(code:sub(pi, pi))
                pi = pi + 1
            piece = code:sub(start, pi - 1)
            if piece:len() >= 2
                hits += judge("{path}:{no}", piece)
        else
            pi = pi + 1
    hits

# the decimal number starting at i
num = (s: str, i: i64): i64
    v = 0
    n = s:len()
    j = i
    while j <= n and s:sub(j, j) >= "0" and s:sub(j, j) <= "9"
        v = v * 10 + (s:sub(j, j):byte() - 48)
        j = j + 1
    v

head: bool = (line: str)
    line:len() >= 6 and line:sub(1, 6) == "+++ b/"

# Scan ONLY THE LINES THIS DIFF ADDS.
#
# Scanning whole files looks stricter and is worse: 756 files carry inherited
# debt, so a whole-file gate makes every legacy file untouchable and gets
# itself switched off within a day. It also punishes the person REPAIRING a
# file, which is backwards. Added lines only means the debt is frozen, every
# new line is canonical, and repair is rewarded.
#
# One word `scan`; diff is the only admitted boundary here — never scandiff mash.
scan: i64 = (body: str)
    hits = 0
    path = ""
    no = 0
    line = ""
    n = body:len()
    i = 1
    while i <= n + 1
        c = "\n"
        if i <= n
            c = body:sub(i, i)
        if c == "\n"
            if head(line)
                path = line:sub(7, line:len())
                no = 0
                hits += route(path)
            else
                if line:len() > 2 and line:sub(1, 2) == "@@"
                    p = 1
                    m = line:len()
                    while p <= m and line:sub(p, p) != "+"
                        p = p + 1
                    no = num(line, p + 1)
                else
                    if line:len() > 0 and line:sub(1, 1) == "+" and path != ""
                        hits += audit(path, no, line:sub(2, line:len()))
                        no = no + 1
            line = ""
        else
            line = "{line}{c}"
        i = i + 1
    hits

# POSITIVE CONTROL. Every detector must fire on a line built to trip it, and
# must stay silent on a canonical line. A gate that cannot convict its own
# exhibit reports 0 because it is broken, not because the tree is clean.
control: bool = ()
    ok = true
    if !bare("    end")
        print("control FAIL: bare did not fire")
        ok = false
    if bare("    scan(n)")
        print("control FAIL: bare fired on canonical")
        ok = false
    if !under("is_digit(c)") or !under("_subject")
        print("control FAIL: under did not fire")
        ok = false
    if under("digit(c)")
        print("control FAIL: under fired on canonical")
        ok = false
    if !capital("p: Point") or !capital("p: P") or !capital("foo2Bar")
        print("control FAIL: capital did not fire")
        ok = false
    if capital("p: point") or capital("mask = 0xFF") or capital("value = 1E9")
        print("control FAIL: capital fired on canonical")
        ok = false
    if strip("code # string.sub here"):len() > 6
        print("control FAIL: strip did not remove a comment")
        ok = false
    if !dash("x = 1  -- old")
        print("control FAIL: dash did not reject Lua comment")
        ok = false
    if dash("x = 1  # canonical") or dash("--- @inline")
        print("control FAIL: dash rejected canonical # comment or --- decorator")
        ok = false
    if !token("value = nil", "nil") or token("value = vanilla", "nil")
        print("control FAIL: nil token boundary is broken")
        ok = false
    if !head("+++ b/example.id") or head("+value = \"+++ b/\"")
        print("control FAIL: diff header boundary is broken")
        ok = false
    if !bridge("x = left .. right")
        print("control FAIL: bridge did not reject .. concatenation")
        ok = false
    if bridge("# x .. y")
        print("control FAIL: bridge rejected comment context")
        ok = false
    if !expand("hits = hits + 1")
        print("control FAIL: expand did not reject place = place op value")
        ok = false
    if expand("hits += 1") or expand("left = right + 1")
        print("control FAIL: expand rejected compound or distinct places")
        ok = false
    if !subject(tail)("if tail(name)")
        print("control FAIL: subject(tail) did not reject non-subject-first tail(")
        ok = false
    if subject(tail)("if name:tail()") or subject(tail)("exprtail()")
        print("control FAIL: subject(tail) rejected subject-first or identifier suffix")
        ok = false
    if !subject(has)("if has(code, pat)")
        print("control FAIL: subject(has) did not reject non-subject-first has(")
        ok = false
    if subject(has)("if code:has(pat)")
        print("control FAIL: subject(has) rejected subject-first has(")
        ok = false
    if !subject(read)("line = io:read()")
        print("control FAIL: subject(read) did not reject io:read")
        ok = false
    if subject(read)("line = stdin:read()") or subject(read)("path:read()")
        print("control FAIL: subject(read) rejected canonical stdin:read / path:read")
        ok = false
    if route("lib/std/index/suffixarray.id") == 0
        print("control FAIL: route did not reject suffixarray compound path")
        ok = false
    if route("lib/std/index/suffix/array.id") != 0
        print("control FAIL: route rejected decomposed suffix/array path")
        ok = false
    if route("lib/semantic_graph.id") == 0
        print("control FAIL: route did not reject mashed path stem")
        ok = false
    if route("lib/semantic/graph.id") != 0
        print("control FAIL: route rejected decomposed hierarchy path")
        ok = false
    if !compound("readline")
        print("control FAIL: compound did not reject readline")
        ok = false
    if !compound("strproof")
        print("control FAIL: compound did not reject strproof")
        ok = false
    if !compound("writetemp")
        print("control FAIL: compound did not reject writetemp")
        ok = false
    if !"writetemp(path, body)":has("writetemp")
        print("control FAIL: writetemp mash rule did not fire")
        ok = false
    if compound("write")
        print("control FAIL: compound rejected canonical write")
        ok = false
    if compound("audit")
        print("control FAIL: compound rejected canonical audit")
        ok = false
    if judge("x", "semantic_graph") == 0
        print("control FAIL: judge did not reject semantic_graph")
        ok = false
    if judge("x", "semantic") != 0
        print("control FAIL: judge rejected canonical semantic")
        ok = false
    if !"args = os.args()":has("os.args(")
        print("control FAIL: os.args host firewall did not fire")
        ok = false
    if !"mode = os.getenv(\"X\")":has("os.getenv(")
        print("control FAIL: os.getenv host firewall did not fire")
        ok = false
    if !"use(m)":has("use(") or !"using(m)":has("using(")
        print("control FAIL: admission syntax firewall did not fire")
        ok = false
    if "command = os.args[1]":has("os.args(")
        print("control FAIL: os.args() fired on os.args table index")
        ok = false
    if !"mode = environment[":has("environment[")
        print("control FAIL: environment entity firewall did not fire")
        ok = false
    if !"x = std.proc.capture(\"echo\")":has("std.")
        print("control FAIL: std namespace firewall did not fire")
        ok = false
    if !"node = ir.node()":has("ir.")
        print("control FAIL: ir namespace firewall did not fire")
        ok = false
    if !dot(io)("text = io.read(\"*a\")")
        print("control FAIL: dot(io) did not reject io.read")
        ok = false
    if !dot(os)("code = os.exit(1)")
        print("control FAIL: dot(os) did not reject os.exit")
        ok = false
    if dot(io)("line = io:read()")
        print("control FAIL: dot(io) fired on io:read — use stdin:read() or path:read()")
        ok = false
    if dot(io)("x = std.io.open(p)")
        print("control FAIL: dot(io) fired on std.io qualification")
        ok = false
    if !dot(std)(io, "f = std.io.open(p)")
        print("control FAIL: dot(std)(io) did not reject std.io.open")
        ok = false
    if !"x = @c.emit(\"fn()\")":has("@c.")
        print("control FAIL: @c foreign-zero firewall did not fire")
        ok = false
    if !"y = lua_io_read()":has("lua_")
        print("control FAIL: lua foreign-zero firewall did not fire")
        ok = false
    if !"x = bit.f64_to_bits(v)":has("bit.")
        print("control FAIL: bit module firewall did not fire")
        ok = false
    if !"to(f64)(bit) = unpack@view":has("unpack@view")
        print("control FAIL: unpack@view firewall did not fire")
        ok = false
    if !"y = bitcast(x)":has("bitcast")
        print("control FAIL: bitcast naming firewall did not fire")
        ok = false
    if "pattern: bit = one:to(bit)":has("bit.")
        print("control FAIL: bit. fired on canonical to(bit)")
        ok = false
    if !"viewedges = \"|bit|\"":has("viewedges")
        print("control FAIL: viewedges mash firewall did not fire")
        ok = false
    if "view(edges) = ()":has("viewedges")
        print("control FAIL: viewedges fired on canonical view(edges)")
        ok = false
    if !"viewrouter = stdin:read":has("viewrouter")
        print("control FAIL: viewrouter mash firewall did not fire")
        ok = false
    if "router(view)(view[census])":has("viewrouter")
        print("control FAIL: viewrouter fired on canonical router(view)")
        ok = false
    if !"viewproof = router":has("viewproof")
        print("control FAIL: viewproof mash firewall did not fire")
        ok = false
    if "view = router(proof)(proof[view])":has("viewproof")
        print("control FAIL: viewproof fired on canonical slot-named view")
        ok = false
    if !"zig-out/bin/duo":has("bin/duo")
        print("control FAIL: bin/duo path firewall did not fire")
        ok = false
    if "zig-out/bin/idol":has("bin/duo")
        print("control FAIL: bin/duo fired on canonical idol binary path")
        ok = false
    if !"ingestbody = path:read":has("ingestbody")
        print("control FAIL: ingestbody mash firewall did not fire")
        ok = false
    if "router(semantic)(semantic[ingest])":has("ingestbody")
        print("control FAIL: ingestbody fired on canonical router(semantic)")
        ok = false
    if !"std.script.fs_exists(":has("fs_exists")
        print("control FAIL: fs_exists snake firewall did not fire")
        ok = false
    if "fs:exists(":has("fs_exists")
        print("control FAIL: fs_exists fired on canonical path:exists")
        ok = false
    if rules("control", 1, "text = router(x)") == 0
        print("control FAIL: router bridge binding firewall did not fire")
        ok = false
    if rules("control", 1, "len: bool = (path: str, min: i64)") == 0
        print("control FAIL: flat len binding bridge rule did not fire")
        ok = false
    if rules("control", 1, "len(path) = (min: i64)") != 0
        print("control FAIL: flat len rule fired on canonical len(path) boundary curry")
        ok = false
    if rules("control", 1, "audit: bool = (path: str, pattern: str)") == 0
        print("control FAIL: flat audit binding bridge rule did not fire")
        ok = false
    if rules("control", 1, "audit(path) = (pattern: str)") != 0
        print("control FAIL: flat audit rule fired on canonical audit(path) boundary curry")
        ok = false
    if rules("control", 1, "hit: bool = (path: str, pattern: str)") == 0
        print("control FAIL: flat hit binding bridge rule did not fire")
        ok = false
    if rules("control", 1, "from(path) = (pattern: str)") == 0
        print("control FAIL: from(path) mash bridge rule did not fire")
        ok = false
    if rules("control", 1, "hit(path) = (pattern: str)") != 0
        print("control FAIL: flat hit rule fired on canonical hit(path) boundary curry")
        ok = false
    if rules("control", 1, "if len(path, min)") == 0
        print("control FAIL: len(path, min) call bridge rule did not fire")
        ok = false
    if rules("control", 1, "if !len(path)(min)") != 0
        print("control FAIL: len(path, min) rule fired on canonical len(path)(min)")
        ok = false
    if rules("control", 1, "if not bare") == 0
        print("control FAIL: if not keyword bridge rule did not fire")
        ok = false
    if rules("control", 1, "if !bare") != 0
        print("control FAIL: if not rule fired on canonical prefix !")
        ok = false
    if rules("control", 1, "text = path:read()") == 0
        print("control FAIL: transitive read binding firewall did not fire")
        ok = false
    if rules("control", 1, "path:read():match(pattern)") != 0
        print("control FAIL: read binding rule fired on canonical path:read():match chain")
        ok = false
    if !"relationid":has("relationid")
        print("control FAIL: relationid mash firewall did not fire")
        ok = false
    if "standard = ingest.resident":has("relationid")
        print("control FAIL: relationid fired on canonical resident facts")
        ok = false
    if !"io:read(\"lib/semantic":has("io:read(")
        print("control FAIL: io:read firewall did not fire")
        ok = false
    if "path:read()":has("io:read(")
        print("control FAIL: io:read rule fired on canonical path:read()")
        ok = false
    if !"std.script.fswrite(":has("fswrite")
        print("control FAIL: fswrite mash firewall did not fire")
        ok = false
    if "io.open(":has("fswrite")
        print("control FAIL: fswrite fired on canonical io.open write")
        ok = false
    ok

main: i64 = ()
    if !seed()
        print("idiomgate: vocabulary load failed")
        return 3
    if !control()
        print("")
        print("idiomgate: POSITIVE CONTROL FAILED — the gate is broken, not the tree.")
        print("No verdict is reported. Fix the gate before trusting any run.")
        return 3
    files = transport()
    if files:len() == 0
        print("idiomgate: empty input — pipe unified diff on stdin")
        print("Usage: git diff -U0 ... | idol run scripts/idiomgate.id")
        return 3
    total = scan(files)
    print("")
    print("idiomgate: {total} finding(s) on ADDED lines and paths  [control: pass]")
