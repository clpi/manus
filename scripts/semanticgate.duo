-- Semantic normalization architecture gate, C0 §65.
--
-- A grammar face may survive for readable density. It may not survive as the
-- thing sema, optimization or lowering reasons about. This census separates
-- five classifications instead of treating every syntax-shaped word alike:
-- parser-only, provenance-only, physical-realization-only, documented
-- irreducible meaning, and migration debt. The first three are bounded; the
-- fourth is deliberately zero; every debt row ratchets down.
--
-- The rows count LINES, not matches. The gate scans the proposed staged index,
-- not the shared dirty worktree, so another session cannot move this run's
-- evidence. These are migration censuses, never semantic verdicts. GAP-124 owns
-- the graph queries that make world, subject, vocabulary, sentinel and control
-- findings authoritative.
--
-- GAP-119 owns this gate's 34 process-capture namespace calls. Execution has
-- no admitted subject/world/result vocabulary yet, and GAP-117 prevents hiding
-- the repetition behind a canonically result-typed helper. The blocked row
-- makes that bootstrap debt visible and monotone instead of aliasing it away.

q = "'"

all = "'src/*.zig'"
front = "src/ast.zig src/parser.zig src/macro_expand.zig"
after = "'src/*.zig' ':(exclude)src/ast.zig' ':(exclude)src/parser.zig' ':(exclude)src/macro_expand.zig' ':(exclude)src/pretty.zig'"
proven = "src/ast.zig src/parser.zig src/pretty.zig"
duofiles = "'*.duo' ':(exclude)scripts/semanticgate.duo' ':(exclude)scripts/idiomgate.duo'"

astpat = "ast\\.(Expr|Stmt|BinOp|UnOp|IfExpr|ElseIf|ListComprehension)"
dispatchpat = "\\.(if_stmt|while_loop|repeat_loop|num_for|gen_for|brk|cont|ret|binop|unop|call|method_call|index|field|if_expr|contains_expr)[[:space:],]*=>"
parserpat = "pub const (BinOp|UnOp|IfExpr|ListComprehension|Stmt)[[:space:]=]"
provenpat = "InvocationForm|\\.form[[:space:]]*(==|!=)"
facepat = "if \\(c\\.form != \\.braced\\)"
graphpat = "^[[:space:]]+(call|directive|pipeline),$"
physicalpat = "^[[:space:]]+(br|br_if|br_if_not|ret|ret_record),$"
irpat = "^[[:space:]]+(const_(i64|f64|str|req)|load_(local|field|index|global)|store_(local|field|index)|call_(direct|extern)|mov_arg|fp_mov_arg|br_if|br_if_not|ret_record|hw_(fence|spin|unary)|str_len|binop|cmp),$"
taxpat = "pub const (Op|BinOpTag|FieldKind)[[:space:]=]"
apipat = "pub const (CallSite|CallTransform|ReturnPack|ReturnConsumption|CalleeKind|CallShape|CallReturnSpecialization)[[:space:]=]"
newpat = "pub const (IfStmt|WhileStmt|ForStmt|BinaryExpr|UnaryExpr|CallExpr|IndexExpr|MemberExpr|ReturnStmt|BreakStmt|ContinueStmt)[[:space:]=]"
namespacepat = "std\\.(os|fs|mem)\\.[a-z][a-z0-9]*\\("
stdpat = "(^|[^a-z0-9.])std\\.[a-z]"
suffixpat = "^[[:space:]]*[a-z][a-z0-9]*[[:space:]]*=[[:space:]]*\\([^)]*\\)[[:space:]]*:[[:space:]]*[a-z][a-z0-9]*(\\([^)]*\\))?[[:space:]]*$"
envemptypat = "(getenv|envor|env_or|std\\.script\\.getenv).*\"\"|\"\".*(getenv|envor|env_or|std\\.script\\.getenv)"
nilpat = "^[[:space:]]*if .*(!=|==) nil"
existpat = "^[[:space:]]*if .*exists\\("
processpat = "std[.]proc[.]capture\\("
boxpat = "lua_Value|lua_invoke|lua_require"

states = {
    canonical = "canonical",
    migratable = "migratable",
    vocabularyblocked = "vocabularyblocked",
    invalid = "invalid"
}

blocked = {
    world = { id = "worldgate", state = states.vocabularyblocked, owner = "gap.124" },
    subject = { id = "subjectgate", state = states.vocabularyblocked, owner = "gap.124" },
    vocab = { id = "vocabgate", state = states.vocabularyblocked, owner = "gap.124" },
    sentinel = { id = "sentinelgate", state = states.vocabularyblocked, owner = "gap.124" },
    control = { id = "controlreduce", state = states.vocabularyblocked, owner = "gap.124" }
}

debt = {
    syntax = {
        id = "syntax.authority",
        state = states.invalid,
        law = "law.semantics.only",
        owner = "normalization",
        cap = 0,
        positive = "pub const WhileStmt = struct {",
        negative = "pub const Demand = struct {"
    },
    namespace = {
        id = "namespace.activity",
        state = states.vocabularyblocked,
        law = "law.audit.conventional",
        owner = "vocabulary",
        cap = 179,
        positive = "std.fs.exists(path)",
        negative = "path:exists()",
        rewrite = "none until subject relation world and demand are admitted"
    },
    standard = {
        id = "distribution.authority",
        state = states.vocabularyblocked,
        law = "law.std.zero",
        owner = "vocabulary",
        cap = 2844,
        positive = "std.json.encode(value)",
        negative = "value:encode(json)",
        rewrite = "only an admitted subject relation home or world"
    },
    result = {
        id = "callable.result.suffix",
        state = states.migratable,
        law = "law.canonical.format",
        owner = "canonicalizer",
        cap = 296,
        positive = "budget = (fallback: i64): i64",
        negative = "budget: i64 = (fallback: i64)",
        rewrite = "proved binding result migration"
    },
    empty = {
        id = "absence.empty",
        state = states.vocabularyblocked,
        law = "law.audit.conventional",
        owner = "presence",
        cap = 20,
        positive = "std.os.getenv(name) == \"\"",
        negative = "present(empty)",
        rewrite = "none until lookup preserves absent and present empty"
    },
    absence = {
        id = "absence.nil",
        state = states.vocabularyblocked,
        law = "law.audit.conventional",
        owner = "presence",
        cap = 1540,
        positive = "if value == nil",
        negative = "value:case(.absent)",
        rewrite = "none without the value descriptor law"
    },
    existence = {
        id = "transition.existence",
        state = states.vocabularyblocked,
        law = "law.audit.conventional",
        owner = "world",
        cap = 86,
        positive = "if path:exists()",
        negative = "path:ensure(file)",
        rewrite = "none until the atomic transition relation is admitted"
    },
    file = {
        id = "file.word",
        state = states.invalid,
        law = "law.file.one",
        owner = "corpus",
        cap = 468,
        positive = "bad_name.duo",
        negative = "concept.duo"
    },
    process = {
        id = "process.namespace",
        state = states.vocabularyblocked,
        law = "law.boundary.semantic",
        owner = "gap.119",
        cap = 34,
        positive = "std.proc.capture(command)",
        negative = "command:run(process)",
        rewrite = "none until execution has subject world and structured result vocabulary"
    },
    vocab = {
        id = "operation.qualifier",
        state = states.migratable,
        law = "law.vocab.same",
        owner = "realization",
        cap = 24,
        positive = "    const_i64,",
        negative = "    const,",
        rewrite = "factor relation identity from descriptor place linkage abi and target facts"
    },
    taxonomy = {
        id = "operation.taxonomy",
        state = states.migratable,
        law = "law.op.intern",
        owner = "realization",
        cap = 3,
        positive = "pub const BinOpTag = enum {",
        negative = "pub const RelationId = struct {",
        rewrite = "replace semantic operation enums with reversible relation interning"
    },
    boxed = {
        id = "runtime.boxed",
        state = states.migratable,
        law = "law.shc.native",
        owner = "shc",
        cap = 1271,
        positive = "lua_Value value",
        negative = "int64_t value",
        rewrite = "retain typed semantic values through direct realization"
    }
}

main = ()
    code = 0
    cmd = "if git cat-file -e :src/ast.zig && git cat-file -e :src/parser.zig && git cat-file -e :src/pretty.zig && git cat-file -e :src/duo_native_ir.zig && git cat-file -e :src/semantic_graph.zig && git cat-file -e :scripts/semanticgate.duo && git grep --cached -q -E {q}{parserpat}{q} -- {front} && git grep --cached -q -E {q}{astpat}{q} -- {after} && git grep --cached -q {q}boxpat = {q} -- scripts/semanticgate.duo; then git grep --cached -q {q}boxpat = {q} -- {duofiles}; status=$?; if test $status = 1; then printf {q}%s\\n{q} {q}pub const IfExpr = struct {{{q} | grep -q -E {q}{parserpat}{q} && printf {q}%s\\n{q} {q}pub const relation = struct {{{q} | grep -q -v -E {q}{parserpat}{q} && printf {q}%s\\n{q} {q}{debt.boxed.positive}{q} | grep -q -E {q}{boxpat}{q} && printf {q}%s\\n{q} {q}{debt.boxed.negative}{q} | grep -q -v -E {q}{boxpat}{q} && printf 1; else printf 0; fi; else printf 0; fi"
    if std.proc.capture(cmd):to(i64) != 1
        print("(semanticgate, control, source, staged pathspec parser classifier or exclusion failed)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}.if_stmt => |branch|{q} | grep -c -E {q}{dispatchpat}{q}"
    if std.proc.capture(cmd):to(i64) != 1
        print("(semanticgate, control, dispatch, missed if face)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}.demand => |edge|{q} | grep -c -E {q}{dispatchpat}{q}"
    if std.proc.capture(cmd):to(i64) != 0
        print("(semanticgate, control, dispatch, convicted demand)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}    directive,{q} | grep -c -E {q}{graphpat}{q}"
    if std.proc.capture(cmd):to(i64) != 1
        print("(semanticgate, control, graph, missed directive kind)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}    relation,{q} | grep -c -E {q}{graphpat}{q}"
    if std.proc.capture(cmd):to(i64) != 0
        print("(semanticgate, control, graph, convicted relation)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{debt.vocab.positive}{q} | grep -c -E {q}{irpat}{q}"
    if std.proc.capture(cmd):to(i64) != 1
        print("(semanticgate, control, ir, missed duplicate call identity)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{debt.vocab.negative}{q} | grep -c -E {q}{irpat}{q}"
    if std.proc.capture(cmd):to(i64) != 0
        print("(semanticgate, control, ir, convicted physical branch)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{debt.syntax.positive}{q} | grep -c -E {q}{newpat}{q}"
    if std.proc.capture(cmd):to(i64) != 1
        print("(semanticgate, control, unclassified, missed new syntax kind)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{debt.syntax.negative}{q} | grep -c -E {q}{newpat}{q}"
    if std.proc.capture(cmd):to(i64) != 0
        print("(semanticgate, control, unclassified, convicted semantic kind)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{debt.namespace.positive}{q} | grep -c -E {q}{namespacepat}{q}"
    if std.proc.capture(cmd):to(i64) != 1
        print("(semanticgate, control, namespace, missed std fs operation)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{debt.namespace.negative}{q} | grep -c -E {q}{namespacepat}{q}"
    if std.proc.capture(cmd):to(i64) != 0
        print("(semanticgate, control, namespace, convicted subject relation)")
        code = 3
    cmd = "test \"$(./zig-out/bin/duo run examples/spec100/result.duo 2>/dev/null)\" = 42 && test \"$(./zig-out/bin/duo run scripts/canon.duo 2>/dev/null)\" = {q}canon: pass{q} && printf {q}%s\\n{q} {q}{debt.result.positive}{q} | grep -q -E {q}{suffixpat}{q} && printf {q}%s\\n{q} {q}{debt.standard.positive}{q} | grep -q -E {q}{stdpat}{q} && printf {q}%s\\n{q} {q}{debt.standard.negative}{q} | grep -q -v -E {q}{stdpat}{q} && printf {q}%s\\n{q} {q}{debt.empty.positive}{q} | grep -q -E {q}{envemptypat}{q} && printf {q}%s\\n{q} {q}{debt.empty.negative}{q} | grep -q -v -E {q}{envemptypat}{q} && printf {q}%s\\n{q} {q}{debt.absence.positive}{q} | grep -q -E {q}{nilpat}{q} && printf {q}%s\\n{q} {q}{debt.absence.negative}{q} | grep -q -v -E {q}{nilpat}{q} && printf {q}%s\\n{q} {q}{debt.existence.positive}{q} | grep -q -E {q}{existpat}{q} && printf {q}%s\\n{q} {q}{debt.existence.negative}{q} | grep -q -v -E {q}{existpat}{q} && printf {q}%s\\n{q} {q}{debt.file.positive}{q} | grep -q {q}_{q} && printf {q}%s\\n{q} {q}{debt.file.negative}{q} | grep -q -v {q}_{q} && printf {q}%s\\n{q} {q}{debt.process.positive}{q} | grep -q -E {q}{processpat}{q} && printf {q}%s\\n{q} {q}{debt.process.negative}{q} | grep -q -v -E {q}{processpat}{q} && printf {q}%s\\n{q} {q}{debt.taxonomy.positive}{q} | grep -q -E {q}{taxpat}{q} && printf {q}%s\\n{q} {q}{debt.taxonomy.negative}{q} | grep -q -v -E {q}{taxpat}{q} && ! ./zig-out/bin/duo dump-c examples/spec100/read.duo 2>/dev/null | grep -q -E {q}{boxpat}{q} && ./zig-out/bin/duo dump-c examples/spec100/read.duo 2>/dev/null | grep -q {q}std_compiler_reader__read{q} && printf 1"
    if std.proc.capture(cmd):to(i64) != 1
        print("(semanticgate, control, source, broken semantic debt classifier)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{debt.result.negative}{q} | grep -c -E {q}{suffixpat}{q}"
    if std.proc.capture(cmd):to(i64) != 0
        print("(semanticgate, control, result, convicted result demand)")
        code = 3

    if code != 0
        print("(semanticgate, error, controls, broken, repository counts withheld)")
    if code == 0
        cmd = "git grep --cached -h -E {q}{parserpat}{q} -- {front} 2>/dev/null | wc -l"
        parser = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{provenpat}{q} -- {proven} 2>/dev/null | wc -l"
        provenance = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{astpat}{q} -- src/pretty.zig 2>/dev/null | wc -l"
        render = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{dispatchpat}{q} -- src/pretty.zig 2>/dev/null | wc -l"
        render += std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{physicalpat}{q} -- src/duo_native_ir.zig 2>/dev/null | wc -l"
        physical = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{newpat}{q} -- {all} 2>/dev/null | wc -l"
        unclassified = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{astpat}{q} -- {after} 2>/dev/null | wc -l"
        consumer = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{dispatchpat}{q} -- {after} 2>/dev/null | wc -l"
        dispatch = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{facepat}{q} -- {after} 2>/dev/null | wc -l"
        face = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{graphpat}{q} -- src/semantic_graph.zig 2>/dev/null | wc -l"
        graph = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{irpat}{q} -- src/duo_native_ir.zig 2>/dev/null | wc -l"
        ir = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{taxpat}{q} -- src/duo_native_ir.zig 2>/dev/null | wc -l"
        taxonomy = std.proc.capture(cmd):to(i64)
        cmd = "a=$(git grep --cached -h -E {q}{apipat}{q} -- {after} 2>/dev/null | wc -l); b=$(git grep --cached -h {q}lua_Value{q} -- {all} 2>/dev/null | wc -l); printf {q}%s{q} $((a * 10000 + b))"
        api = std.proc.capture(cmd):to(i64)
        combined = api
        boxed = combined % 10000
        api = (combined - boxed) / 10000
        cmd = "git grep --cached -h -E {q}{namespacepat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*(--|source[[:space:]]*=|\"){q} | wc -l"
        namespace = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{stdpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*(--|source[[:space:]]*=|\"){q} | wc -l"
        standard = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{suffixpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l"
        suffix = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{envemptypat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l"
        envempty = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{nilpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l"
        nilabsence = std.proc.capture(cmd):to(i64)
        cmd = "git grep --cached -h -E {q}{existpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l"
        existence = std.proc.capture(cmd):to(i64)
        cmd = "git show :scripts/semanticgate.duo | grep -E {q}std[.]proc[.]capture\\({q} | grep -v -E {q}^[[:space:]]*positive[[:space:]]*={q} | wc -l"
        bootstrap = std.proc.capture(cmd):to(i64)
        cmd = "git ls-files '*.duo' | grep -c {q}_{q}"
        fileword = std.proc.capture(cmd):to(i64)

        over = 0
        print("(semanticgate, count, parser-only, faces, {parser}, cap=5)")
        if parser > 5 over += 1
        print("(semanticgate, count, provenance, faces, {provenance}, cap=10)")
        if provenance > 10 over += 1
        print("(semanticgate, count, provenance, render, {render}, cap=26)")
        if render > 26 over += 1
        print("(semanticgate, count, physical, control, {physical}, cap=5)")
        if physical > 5 over += 1
        print("(semanticgate, count, irreducible, documented, 0, cap=0)")
        print("(semanticgate, count, unclassified, syntax, {unclassified}, cap=0)")
        if unclassified > 0 over += 1
        print("(semanticgate, count, migration, consumers, {consumer}, cap=815)")
        if consumer > 815 over += 1
        print("(semanticgate, count, migration, dispatch, {dispatch}, cap=723)")
        if dispatch > 723 over += 1
        print("(semanticgate, count, migration, faceauth, {face}, cap=2)")
        if face > 2 over += 1
        print("(semanticgate, count, migration, graphkind, {graph}, cap=1)")
        if graph > 1 over += 1
        print("(semanticgate, census, {debt.vocab.state}, {debt.vocab.id}, {ir}, cap={debt.vocab.cap}, law={debt.vocab.law}, owner={debt.vocab.owner})")
        if ir > debt.vocab.cap over += 1
        print("(semanticgate, census, {debt.taxonomy.state}, {debt.taxonomy.id}, {taxonomy}, cap={debt.taxonomy.cap}, law={debt.taxonomy.law}, owner={debt.taxonomy.owner})")
        if taxonomy > debt.taxonomy.cap over += 1
        print("(semanticgate, census, {debt.boxed.state}, {debt.boxed.id}, {boxed}, cap={debt.boxed.cap}, law={debt.boxed.law}, owner={debt.boxed.owner})")
        if boxed > debt.boxed.cap over += 1
        print("(semanticgate, count, migration, api, {api}, cap=8)")
        if api > 8 over += 1
        print("(semanticgate, census, {debt.namespace.state}, {debt.namespace.id}, {namespace}, cap={debt.namespace.cap}, law={debt.namespace.law}, owner={debt.namespace.owner})")
        if namespace > debt.namespace.cap over += 1
        print("(semanticgate, census, {debt.standard.state}, {debt.standard.id}, {standard}, cap={debt.standard.cap}, law={debt.standard.law}, owner={debt.standard.owner})")
        if standard > debt.standard.cap over += 1
        print("(semanticgate, census, {debt.result.state}, {debt.result.id}, {suffix}, cap={debt.result.cap}, law={debt.result.law}, owner={debt.result.owner})")
        if suffix > debt.result.cap over += 1
        print("(semanticgate, census, {debt.empty.state}, {debt.empty.id}, {envempty}, cap={debt.empty.cap}, law={debt.empty.law}, owner={debt.empty.owner})")
        if envempty > debt.empty.cap over += 1
        print("(semanticgate, census, {debt.absence.state}, {debt.absence.id}, {nilabsence}, cap={debt.absence.cap}, law={debt.absence.law}, owner={debt.absence.owner})")
        if nilabsence > debt.absence.cap over += 1
        print("(semanticgate, census, {debt.existence.state}, {debt.existence.id}, {existence}, cap={debt.existence.cap}, law={debt.existence.law}, owner={debt.existence.owner})")
        if existence > debt.existence.cap over += 1
        print("(semanticgate, census, {debt.file.state}, {debt.file.id}, {fileword}, cap={debt.file.cap}, law={debt.file.law}, owner={debt.file.owner})")
        if fileword > debt.file.cap over += 1
        print("(semanticgate, census, {debt.process.state}, {debt.process.id}, {bootstrap}, cap={debt.process.cap}, law={debt.process.law}, owner={debt.process.owner})")
        if bootstrap > debt.process.cap over += 1
        print("(semanticgate, blocked, {blocked.world.state}, {blocked.world.id}, owner={blocked.world.owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked.subject.state}, {blocked.subject.id}, owner={blocked.subject.owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked.vocab.state}, {blocked.vocab.id}, owner={blocked.vocab.owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked.sentinel.state}, {blocked.sentinel.id}, owner={blocked.sentinel.owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked.control.state}, {blocked.control.id}, owner={blocked.control.owner}, evidence=graph-required)")

        if over > 0
            print("(semanticgate, fail, ratchet, raised, lower implementation or justify law change)")
            code = 1
        else
            print("(semanticgate, pass, law.surface.zero, staged census classified, debt may only descend, semantic verdicts remain gap.124)")
    if code != 0
        error("(semanticgate, blocked, canonicality, unresolved, see structured findings above)")
    code
