-- std.fs.mkdir / mkdir(all) / copy — verified BY VALUE, both directions.
--
-- gap[100] rung 0. The duplicate os/fs surface could not be collapsed safely
-- because picking a survivor ships that survivor's bugs to every caller of
-- both, and NONE of mkdir / mkdir(all) / copy had a fixture. gap[075] had
-- already shown what that costs: fs.remove answered true for a path it had not
-- removed, because a wrapper reported success it never verified.
--
-- So every assertion here checks the FILESYSTEM, never the wrapper's word:
-- the directory must EXIST afterward, the copy's bytes must MATCH, and a call
-- that cannot succeed must answer the failure side.
--
-- This fixture also convicts the defect that blocked rung 2 for an hour:
-- `@c.emit` in TAIL-EXPRESSION position returns the wrong value silently.
--
--     return @c.emit("mkdir(path, 0777) == 0")   -> true,  directory created
--            @c.emit("mkdir(path, 0777) == 0")   -> FALSE, directory created
--
-- Same C, same syscall, same observable effect, opposite answer. Nothing
-- diagnoses. A caller branching on the result takes the wrong arm while the
-- filesystem says the operation worked.
--
-- exit 0 all good; 1..6 names the broken direction.

base = "/tmp/duofsproof"

main = (): i64
    -- Clean DEEPEST FIRST and include the base itself. The first draft removed
    -- only the leaves, so a second run found the base already present, mkdir
    -- correctly answered false, and the fixture reported a failure that was its
    -- own litter. A fixture that passes only on a clean machine manufactures
    -- false reds today and false greens the moment someone "fixes" it by
    -- loosening the assertion.
    std.fs.remove("{base}/two")
    std.fs.remove("{base}/one")
    std.fs.remove("{base}/a/b/c")
    std.fs.remove("{base}/a/b")
    std.fs.remove("{base}/a")
    std.fs.remove("{base}")

    made = std.fs.mkdir("{base}")
    if not std.fs.exists("{base}")
        print("fs proof: mkdir answered {made} and the directory is absent")
        std.os.exit(1)
    if made == false
        print("fs proof: mkdir created the directory and answered {made}")
        std.os.exit(2)

    deep = std.fs.mkdir("{base}/nosuchparent/x")
    if deep
        print("fs proof: mkdir answered {deep} for a path whose parent is absent")
        std.os.exit(3)

    -- Now assertable. This block used to be a comment explaining why it could
    -- not exist: the op was spelled `mkdir_all`, a LAW-ONE identifier cannot
    -- carry that underscore, so canonical duon could not call it and no
    -- canonical fixture could cover it. Renamed to one legal word, so the
    -- coverage hole closes with it.
    all = std.fs.mkdirall("{base}/a/b/c")
    if not std.fs.exists("{base}/a/b/c")
        print("fs proof: mkdirall answered {all} and the leaf is absent")
        std.os.exit(4)

    src = "{base}/one"
    f = io.open(src, "w")
    f:write("duon")
    f:close()
    dst = "{base}/two"
    cp = std.fs.copy(src, dst)
    if not std.fs.exists(dst)
        print("fs proof: copy answered {cp} and the target is absent")
        std.os.exit(5)
    g = io.open(dst, "r")
    body = g:read("a")
    g:close()
    if body != "duon"
        print("fs proof: copy produced {body}, not the source bytes")
        std.os.exit(6)

    print("fs proof: mkdir, mkdirall and copy all verified by value")
    0
