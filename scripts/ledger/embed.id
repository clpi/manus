# Embedded @c audit and enforce for the self-hosting target.
#
# scripts/census/foreign advertises the aggregate count and keeps the unclassified
# floor. This script audits each remaining payload site by file and enforces
# the Pass 103 termination condition: embedded C only shrinks; self-hosting
# requires zero sites.

chomp: str = (text: str)
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32
            break
        n -= 1
    text:sub(1, n)

capture: str = (cmd: str)
    gatecap(cmd)

cap: str = (cmd: str)
    chomp(gatecap(cmd))

lines: any = (text: str)
    out = {}
    start = 1
    i = 1
    n = text:len()
    while i <= n
        if text:byte(i) == 10
            if i > start
                out[out:len() + 1] = text:sub(start, i - 1)
            start = i + 1
        i += 1
    if start <= n
        out[out:len() + 1] = text:sub(start, n)
    out

has: bool = (text: str, part: str)
    pos = text:find(part, 1, true)
    pos and pos > 0

trimleft: str = (text: str)
    i = 1
    n = text:len()
    while i <= n and (text:byte(i) == 32 or text:byte(i) == 9)
        i += 1
    text:sub(i, n)

site: bool = (line: str)
    t = trimleft(line)
    if t:len() >= 2 and t:sub(1, 2) == "--"
        return false
    has(line, "@c.emit") or has(line, "@c.include") or has(line, "@comp.c.emit") or has(line, "@comp.c.include")

occur: i64 = (text: str, needle: str)
    total = 0
    start = 1
    while true
        at = text:find(needle, start, true)
        if !at
            return total
        total += 1
        start = at + needle:len()
    total

sitecount: i64 = (line: str)
    t = trimleft(line)
    if t:len() >= 2 and t:sub(1, 2) == "--"
        return 0
    occur(line, "@c.emit") + occur(line, "@c.include") + occur(line, "@comp.c.emit") + occur(line, "@comp.c.include")

multistart: bool = (line: str)
    site(line) and has(line, "[[") and !has(line, "]]")

countfile: any = (root: str, path: str)
    text = cap("cd '{root}' && cat '{path}'")
    rows = lines(text)
    sites = 0
    payload = 0
    inblock = false
    for i = 1, rows:len()
        line = rows[i]
        if inblock
            payload += 1
            if has(line, "]]")
                inblock = false
        else
            got = sitecount(line)
            if got > 0
                sites += got
                payload += 1
                if multistart(line)
                    inblock = true
    { sites = sites, payload = payload }

root = cap("git rev-parse --show-toplevel 2>/dev/null")
if root == ""
    print("ledger/embed: fail no git root")
    return 3

files = lines(cap("cd '{root}' && git ls-files '*.id' | grep -v '^scripts/census/foreign.id$' | sort"))
total = 0
payload = 0
print("ledger/embed -- audit (sites by file)")
for i = 1, files:len()
    path = files[i]
    row = countfile(root, path)
    if row.sites > 0
        print("  {row.sites} sites {row.payload} payload-lines {path}")
        total += row.sites
        payload += row.payload

print("ledger/embed: enforce zero embedded @c sites for self-hosting")
if total == 0
    print("ledger/embed: pass sites 0 payload-lines 0")
    return 0
print("ledger/embed: fail sites {total} payload-lines {payload}")
1
