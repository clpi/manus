# Embedded @c audit. Counts are i64 facts from capture, not shell `test` status.

chomp: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

cap: str = (cmd: str)
  chomp(gatecap(cmd))

digits: i64 = (text: str)
  s = chomp(text)
  if not s:len()
    return 0
  v = 0
  i = 1
  while i <= s:len()
    c = s:byte(i)
    if c >= 48 and c <= 57
      v = v * 10 + c - 48
      i = i + 1
    else
      break
  v

envor: str = (name: str, fallback: str)
  v = os.env(name)
  if not v or v:len() == 0
    fallback
  else
    v

sites = digits(cap("git ls-files '*.id' | grep -v scripts/census/foreign.id | tr '\\n' '\\0' | xargs -0 grep -l -E '@(comp\\.)?c\\.(emit|include)' 2>/dev/null | wc -l | tr -d ' '"))
payload = digits(cap("git ls-files '*.id' | grep -v scripts/census/foreign.id | tr '\\n' '\\0' | xargs -0 grep -h -E '@(comp\\.)?c\\.(emit|include)' 2>/dev/null | grep -v -E '^[[:space:]]*#' | wc -l | tr -d ' '"))
floor = digits(envor("EMBED_FLOOR", "11"))
print("ledger/embed -- audit (sites by file)")
if sites
  print(cap("git ls-files '*.id' | grep -v scripts/census/foreign.id | tr '\\n' '\\0' | xargs -0 grep -l -E '@(comp\\.)?c\\.(emit|include)' 2>/dev/null | sed 's/^/  /'"))
print("ledger/embed: enforce zero embedded @c sites for self-hosting")
code = 0
if not sites
  print("ledger/embed: pass sites 0 payload-lines 0")
if sites > floor
  print("ledger/embed: fail sites {sites} payload-lines {payload} over ratchet {floor}")
  code = 1
if sites and not (sites > floor)
  print("ledger/embed: pass sites {sites} payload-lines {payload} (ratchet {floor}; target zero)")
code
