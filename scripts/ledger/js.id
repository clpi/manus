# Tracked JavaScript debt ledger for the self-hosting target.
#
# scripts/census/language keeps the count bounded. This prints the exact tracked files
# so the remaining non-idol debt is visible without re-reading prose.

capture: str = (shellline: str)
  gatecap(shellline)

chomp: str = (text: str)
  if text:len() == 0
    return ""
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

cap: str = (shellline: str)
  chomp(gatecap(shellline))

status: i64 = (cmd: str)
  cap("( {cmd} ) >/dev/null 2>&1; echo $?"):to(i64)

lines: any = (text: str)
  out = {}
  start = 1
  i = 1
  n = text:len()
  while i <= n
    if text:byte(i) == 10
      if i > start
        out:push(text:sub(start, i - 1))
      start = i + 1
    i = i + 1
  if start <= n
    out:push(text:sub(start, n))
  out

vscode: bool = (root: str, path: str)
  path == "ext/vscode-idol/extension.js" and status("cd '{root}' && ./zig-out/bin/idol run scripts/vscodeproj.id") == 0

tree: bool = (root: str, path: str)
  path == "ext/tree-sitter-idol/grammar.js" and status("cd '{root}' && env TSEMIT_CHECK=1 ./zig-out/bin/idol run scripts/treesitter_emit.id") == 0

main: i64 = ()
  root = cap("git rev-parse --show-toplevel 2>/dev/null")
  if root == ""
    print("ledger/js: fail no git root")
    return 3

  # GAP-220 / GAP-201: the enumeration below reads zero with a stale pathspec
  # or in a tree with no `.git`, and zero is the verdict this file most wants
  # to print. `gate/subject.sh` owns the ruling; ask it where a status is not
  # destroyed by a pipe.
  if cap("cd '{root}' && sh gate/subject.sh '*.id' >/dev/null 2>&1; echo $?") != "0"
    print("ledger/js: FAIL subject enumeration is not trustworthy here — GAP-201/GAP-220")
    return 3

  files = lines(capture("cd '{root}' && git ls-files '*.js' | sort"))
  generated = {}
  partial = {}
  authored = {}
  for i = 1, files:len()
    path = files(i)
    if vscode(root, path)
      generated:push(path)
    if not vscode(root, path) and tree(root, path)
      generated:push(path)
    if not vscode(root, path) and not tree(root, path)
      authored:push(path)

  filecount = files:len()
  gencount = generated:len()
  partcount = partial:len()
  authcount = authored:len()

  if filecount == 0
    print("ledger/js: pass tracked js 0")
    return 0

  label = "fail"
  if partcount == 0 and authcount == 0
    label = "pass"
  print("ledger/js: {label} tracked js {filecount}")
  print("generated {gencount}")
  for i = 1, gencount
    print("  {generated[i]}")
  print("partial {partcount}")
  for i = 1, partcount
    print("  {partial[i]}")
  print("authored {authcount}")
  for i = 1, authcount
    print("  {authored[i]}")
  if partcount == 0 and authcount == 0
    return 0
  1
