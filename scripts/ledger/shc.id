# Self-hosting completion ledger.
#
# This does !make production claims. It reports the current blockers to a
# 100% Idol self-hosting state from live repository facts, and keeps expensive
# proof execution behind SHCLEDGER_DEEP=1 so the default census stays cheap.

chomp: str = (text: str)
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32
            break
        n -= 1
    text:sub(1, n)

cap: str = (cmd: str)
    chomp(gatecap(cmd))

status: i64 = (cmd: str)
    cap("( {cmd} ) >/dev/null 2>&1; echo $?"):to(i64)

lines: any = (text: str)
    out = {}
    start = 1
    i = 1
    n = text:len()
    while i <= n
        if text:byte(i) == 10
            if i > start
                out[out:len() + 1] = text:sub(start, i - 1)
            start = i + 1
        i += 1
    if start <= n
        out[out:len() + 1] = text:sub(start, n)
    out

count: i64 = (root: str, cmd: str)
    out = cap("cd '{root}' && {cmd}")
    if out:len() == 0
        return 0
    n = out:len()
    while n > 0 and out:byte(n) == 32
        n -= 1
    if n == 0
        return 0
    out:sub(1, n):to(i64)

need: i64 = (text: str, part: str, label: str)
    if text:find(part, 1, true)
        print("  ok   {label}")
        return 0
    print("  FAIL {label}")
    1

neednum: i64 = (got: i64, want: i64, label: str)
    if got == want
        print("  ok   {label} {got}")
        return 0
    print("  FAIL {label} got {got} want {want}")
    1

runcheck: i64 = (root: str, name: str, cmd: str)
    rc = status("cd '{root}' && {cmd} > /tmp/ledger-shc-{name}.out 2>&1")
    if rc == 0
        print("  ok   {name}")
        return 0
    print("  FAIL {name} status {rc}")
    1

bucket: str = (path: str)
    if path == "build.zig"
        return "zigbuild"
    if path:find("test", 1, true) or path:find("fixture", 1, true)
        return "zigtest"
    if path:find("wasm", 1, true)
        return "zigwasm"
    if path:find("native", 1, true) or path:find("dnir", 1, true) or path:find("abi", 1, true)
        return "zignative"
    if path:find("semantic", 1, true) or path:find("graph", 1, true) or path:find("relation", 1, true) or path:find("realization", 1, true)
        return "zigsemantic"
    if path:find("lexer", 1, true) or path:find("parser", 1, true) or path:find("token", 1, true) or path:find("sema", 1, true)
        return "zigfront"
    if path:find("codegen", 1, true) or path:find("backend", 1, true) or path:find("lower", 1, true) or path:find("jit", 1, true)
        return "zigback"
    "zigsupport"

bucketcount: i64 = (files: any, name: str)
    total = 0
    for i = 1, files:len()
        if bucket(files[i]) == name
            total += 1
    total

envor: str = (name: str, fallback: str)
    v = os.env(name)
    if !v or v:len() == 0
        fallback
    else
        v

root = cap("git rev-parse --show-toplevel 2>/dev/null")
if root == ""
    print("ledger/shc: FAIL no git root")
    return 3

duobin = "{root}/zig-out/bin/idol"
zigfiles = lines(cap("cd '{root}' && git ls-files '*.zig' | sort"))
zig = zigfiles:len()
cboot = count(root, "git ls-files '*.[ch]' | grep -E '^(src/|lib/c/)' | wc -l")
rootforeign = count(root, "find . -maxdepth 1 -type f \\( -name '*.py' -o -name '*.sh' \\) -print | wc -l")
js = count(root, "git ls-files '*.js' | wc -l")
embedded = count(root, "git ls-files '*.id' | grep -v 'scripts/census/foreign.id' | tr '\\n' '\\0' | xargs -0 grep -h -E '@(comp\\.)?c\\.(emit|include)' 2>/dev/null | grep -v -E '^[[:space:]]*--' | grep -o -E '@(comp\\.)?c\\.(emit|include)' | wc -l")
jsgen = 0
if status("cd '{root}' && {duobin} run scripts/vscodeproj.id > /dev/null 2>&1") == 0
    jsgen += 1
if status("cd '{root}' && env TSEMIT_CHECK=1 {duobin} run scripts/treesitter_emit.id > /dev/null 2>&1") == 0
    jsgen += 1
jsauth = js - jsgen
zb = bucketcount(zigfiles, "zigbuild")
zf = bucketcount(zigfiles, "zigfront")
zk = bucketcount(zigfiles, "zigback")
zn = bucketcount(zigfiles, "zignative")
zw = bucketcount(zigfiles, "zigwasm")
zs = bucketcount(zigfiles, "zigsemantic")
zt = bucketcount(zigfiles, "zigtest")
zu = bucketcount(zigfiles, "zigsupport")

print("ledger/shc -- current blockers to 100% Idol self-hosting")
print("  zig bootstrap files     {zig}")
print("  c bootstrap files       {cboot}")
print("  js authored files       {jsauth}")
print("  root sh/py scratch      {rootforeign}")
print("  generated js projections {jsgen}")
print("  advertise embedded {embedded}")
print("  audit     scripts/ledger/embed.id")
print("  enforce   zero sites (ledger/embed gate)")

print("zig queue")
print("  zigbuild    {zb}")
print("  zigfront    {zf}")
print("  zigback     {zk}")
print("  zignative   {zn}")
print("  zigwasm     {zw}")
print("  zigsemantic {zs}")
print("  zigtest     {zt}")
print("  zigsupport  {zu}")

bad = 0
manifest = cap("cd '{root}' && cat scripts/selfhost_manifest.id")
rows = count(root, "grep -c '_row(\"SH-' scripts/selfhost_manifest.id")
impl = count(root, "grep -c 'duo_impl_rows.*14' scripts/selfhost_manifest.id")
oracle = count(root, "grep -c 'oracle_backed_rows.*13' scripts/selfhost_manifest.id")
canonical = count(root, "grep -c 'duo_canonical_rows.*1' scripts/selfhost_manifest.id")
print("manifest contract")
bad += neednum(rows, 14, "manifest rows")
bad += neednum(impl, 1, "duo implementation summary")
bad += neednum(oracle, 1, "oracle-backed summary")
bad += neednum(canonical, 1, "production-canonical summary")
bad += need(manifest, "production dispatch: host still calls src/*.zig", "production dispatch blocker named")
bad += need(manifest, "FIXTURES ONLY", "fixture-only backend row !hidden")

print("cheap gates")
bad += runcheck(root, "language", "{duobin} run --backend=c scripts/census/language.id")
bad += runcheck(root, "foreign", "{duobin} run --backend=c scripts/census/foreign.id")
bad += runcheck(root, "embed", "{duobin} run --backend=c scripts/ledger/embed.id")
bad += runcheck(root, "gates/build", "{duobin} run gates/build.id")

deep = envor("SHCLEDGER_DEEP", "0")
if deep == "1"
    print("deep gates")
    bad += runcheck(root, "selfhost_proofs", "{duobin} run scripts/selfhost_proofs.id")
    bad += runcheck(root, "debt", "{duobin} run scripts/ledger/debt.id")
else
    print("deep gates skipped (set SHCLEDGER_DEEP=1)")

debt = zig + cboot + js + rootforeign + embedded
if bad == 0 and debt == 0
    print("ledger/shc: PASS complete")
    return 0
print("ledger/shc: FAIL blockers {debt} checks {bad}")
return 1
