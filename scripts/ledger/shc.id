
seen: bool = (text: str, needle: str)
  n = text:len()
  m = needle:len()
  i = 1
  while i + m - 1 <= n
    if text:sub(i, i + m - 1) == needle
      return true
    i = i + 1
  false

shc: i64 = ()
  print("ledger/shc -- current blockers")
  print("  audit     scripts/ledger/embed")
  print("  audit     scripts/ledger/embed.id")
  print("manifest contract")
  fail = 0
  dispatch = "src/lexer_dispatch.zig":read()
  if !dispatch:seen("tokenize(alloc")
    print("  FAIL production route not on Idol tokenize")
    fail = 1
  if dispatch:seen("tokenize(alloc")
    print("  ok   canonical route tokenizes via Idol")
  if !dispatch:seen("fn tokenizeHost")
    print("  FAIL host differential tokenizeHost missing")
    fail = 1
  if dispatch:seen("fn tokenizeHost")
    print("  ok   host scanner differential-only")
  if dispatch:seen("RECORD_SLOTS")
    print("  FAIL RECORD_SLOTS host slot map restored")
    fail = 1
  if !dispatch:seen("RECORD_SLOTS")
    print("  ok   RECORD_SLOTS host slot map deleted")
  if !dispatch:seen("bindKindSchema")
    print("  FAIL producer kind schema not bound once")
    fail = 1
  if dispatch:seen("bindKindSchema")
    print("  ok   producer kind schema bound once")
  if !dispatch:seen("record_bound")
    print("  FAIL producer record schema not bound once")
    fail = 1
  if dispatch:seen("record_bound")
    print("  ok   producer record schema bound once")
  if !dispatch:seen("kindFromRecord")
    print("  FAIL producer kind ordinal not bound once")
    fail = 1
  if dispatch:seen("kindFromRecord")
    print("  ok   producer kind ordinal bound once")
  if !dispatch:seen("fn kindFromName")
    print("  FAIL kindFromName bridge missing")
    fail = 1
  if dispatch:seen("fn kindFromName")
    print("  ok   kindFromName bridge present")
  if !dispatch:seen("if (n == -1)")
    print("  FAIL tokenize does not grow records on BufferTooSmall")
    fail = 1
  if dispatch:seen("if (n == -1)")
    print("  ok   tokenize grows records on BufferTooSmall")
  if !dispatch:seen("lex.family")
    print("  FAIL route does not consume lex.family")
    fail = 1
  if dispatch:seen("lex.family")
    print("  ok   route consumes lex.family")
  print("remaining host boundaries")
  print("  GAP-145 long-bracket scan deleted; level in int_val")
  print("  GAP-134 quoted/descriptor/nonassoc; Pratt left/right from assoc")
  bridge = "src/lexer_bridge.zig":read()
  producer = "lib/compiler/lexer.id":read()
  if bridge:seen("pending: ?SourceLaw")
    print("  FAIL host source-form roster restored")
    fail = 1
  if !bridge:seen("sourceformcount") or !producer:seen("sourceformcount")
    print("  FAIL source-form producer projection missing")
    fail = 1
  if !bridge:seen("pending: ?SourceLaw") and bridge:seen("sourceformcount") and producer:seen("sourceformcount")
    print("  ok   source forms projected by executed producer")
  if bridge:seen("const homes") or bridge:seen("HomeClass") or bridge:seen("homeFacts(")
    print("  FAIL host corpus admission roster restored")
    fail = 1
  if !bridge:seen("sourcefactlaw") or !bridge:seen("sourcefactprovenance")
    print("  FAIL sourceFacts does not consume executed producer facts")
    fail = 1
  if !producer:seen("sourceentrycount") or !producer:seen("sourcefactlaw") or !producer:seen("sourcefactprovenance")
    print("  FAIL executed source admission producer missing")
    fail = 1
  if !bridge:seen("const homes") and !bridge:seen("HomeClass") and !bridge:seen("homeFacts(") and bridge:seen("sourcefactlaw") and producer:seen("sourceentrycount")
    print("  ok   source law/provenance admission executes in Idol")
  print("  sourceFacts host residual = filesystem normalization + ABI name binding")
  print("  Lexer.init test convenience; TokenKind host enum still parallel")
  print("  TokenKind host enum still parallel to producer kindname")
  print("  parser SHC not started; one headerSignal; BinOp map remains")
  if fail
    print("ledger/shc: FAIL checks")
    return 1
  print("ledger/shc: PASS complete")
  0
