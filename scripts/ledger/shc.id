# Self-hosting completion ledger. Entry shc: i64 = ().
# ledger/shc -- current blockers
# File facts only. Window compare, never :has.
# Native whole-string `==` is false above 15 bytes; keep needles short.

seen: bool = (text: str, needle: str)
  n = text:len()
  m = needle:len()
  i = 1
  while i + m - 1 <= n
    if text:sub(i, i + m - 1) == needle
      return true
    i = i + 1
  false

