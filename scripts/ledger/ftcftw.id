
look: bool = (path: str, pattern: str)
  body = path:read()
  body:has(pattern)

need: i64 = (path: str, tag: str, pattern: str)
  if look(path, pattern)
    print("  ok {tag}")
    return 0
  print("  miss {tag}: {pattern}")
  1

row: i64 = (path: str, proof: str, a: str, b: str, c: str, d: str)
  print("index {path}")
  print("  {proof}")
  fail = 0
  if need(path, "contract", a)
    fail = 1
  if need(path, "oracle", b)
    fail = 1
  if need(path, "negative", c)
    fail = 1
  if need(path, "verdict", d)
    fail = 1
  fail

control: i64 = (path: str)
  if not look(path, "ledger/ftcftw: pass all evidence contracts present")
    print("ledger/ftcftw: fail control present pattern")
    1
  print("ledger/ftcftw: control ok")
  0

ftcftw: i64 = ()
  fail = 0
  if control("scripts/ledger/ftcftw.id")
    fail = 1
  if row("scripts/census/native.id", "direct-native coverage over the reachable Idol examples corpus", "native census (--backend=direct", "NATIVE_FLOOR", "0 programs compiled natively", "census/native: PASS")
    fail = 1
  if row("scripts/native_differential.id", "direct and c backends agree on stdout and exit for blocking fixtures", "native_differential: PASS", "c backend failed to compile", "native_differential: FAIL", "stdout")
    fail = 1
  if row("scripts/run_benchmark.id", "Idiom-hosted kernels match reference C before any speed comparison", "reference C benchmark", "RESULT_FAIL_FLAG = 1", "Benchmark failed:", "Duo .lua/.id >= C")
    fail = 1
  if row("scripts/runtime_bench.id", "Idiom Wasm runtime measured against wasmtime with answer-checked exec axis", "wasmtime is the oracle", "answer mismatch", "losses += 1", "runtime bench: PASS")
    fail = 1
  if row("scripts/ledger/shc.id", "live bootstrap blockers to 100% Idol self-hosting authority", "ledger/shc -- current blockers", "audit     scripts/ledger/embed", "ledger/shc: FAIL", "manifest contract")
    fail = 1
  if row("scripts/ledger/perf.id", "parent performance evidence index must remain wired", "ledger/perf: pass all evidence contracts present", "ledger/perf: fail", "ledger/perf: fail control", "ledger/perf: control ok")
    fail = 1
  if fail
    1

  print("complete proof")
  metrics = "docs/METRICS.md"
  if look(metrics, "FTCFTW complete experimental proof") and look(metrics, "near 0%")
    print("  ok   complete FTCFTW proof not claimed")
  if not (look(metrics, "FTCFTW complete experimental proof") and look(metrics, "near 0%"))
    print("  FAIL complete FTCFTW proof claimed or METRICS unbound")
    1

  print("")
  print("claim.refused faster than c across the board without exception")
  print("claim.made    law.project.ftcftw + law.perf.dominance on supported corpus")
  print("ordering      direct native > c-equivalent > wasm oracle (separate evidence per family)")
  print("complete FTCFTW proof: NOT PROVEN")
  print("index         contract presence is not performance evidence")
  print("ledger/ftcftw: pass all evidence contracts present")
  0
