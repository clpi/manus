
seen: bool = (text: str, needle: str)
  n = text:len()
  m = needle:len()
  i = 1
  while i + m - 1 <= n
    if text:sub(i, i + m - 1) == needle
      return true
    i = i + 1
  false

debtrow: i64 = (label: str, needle: str, text: str)
  if seen(text, needle)
    print("  open {label} still reconstructed ({needle})")
    return 1
  0

graphok: i64 = (label: str, needle: str, text: str)
  if seen(text, needle)
    print("  ok   {label} via graph accessor")
  if !seen(text, needle)
    print("  FAIL {label} graph accessor missing ({needle})")
    return 1
  0

application: i64 = ()
  print("ledger/application -- APPLICATION-CONSUMER-ZERO")
  fail = 0
  role = "lib/compiler/application.id":read()
  lower = "src/graph/lower.zig":read()
  backend = "src/native.zig":read()
  graph = "src/graph.zig":read()
  identity = "src/semantic_identity.zig":read()
  query = "src/graph_query.zig":read()
  if !role:len()
    print("  FAIL lib/compiler/application.id missing")
    fail = 1
  if role:len() and seen(role, "application: {")
    print("  FAIL coordinate application schema in application.id")
    fail = 1
  if role:len() and !seen(role, "law.application.consumer")
    print("  FAIL application.id missing consumer law pointer")
    fail = 1
  if role:len() and !seen(role, "application: {")
    print("  ok   application.id is role documentation only")
  print("graph accessors (required in graph + consumers)")
  fail += graphok("relation", "pub fn applicationRelation", graph)
  fail += graphok("caller", "pub fn applicationCaller", graph)
  fail += graphok("results", "pub fn applicationResults", graph)
  fail += graphok("descriptor", "pub fn applicationDescriptor", graph)
  fail += graphok("demand", "pub fn applicationDemand", graph)
  fail += graphok("subject", "pub fn applicationSubject", graph)
  if !seen(lower, "applicationRelation")
    print("  FAIL dnir_lower missing applicationRelation")
    fail = 1
  if seen(lower, "applicationRelation")
    print("  ok   dnir_lower consumes graph relation")
  if seen(backend, "applicationRelation") and seen(backend, "applicationCaller")
    print("  ok   native_backend consumes graph relation and caller")
  if seen(lower, "applicationSubject") and seen(backend, "applicationSubject")
    print("  ok   subject consumed via graph.applicationSubject")
  print("FACT-CARDINALITY-ONE")
  card = seen(graph, "pub const Card = union") or seen(identity, "pub const Card = union")
  if card
    print("  ok   Card unknown/none/one on ApplicationFact")
  if !card
    fail = 1
    print("  FAIL Card union missing from graph and identity")
  if seen(graph, "effect: ?id = null")
    fail = 1
    print("  FAIL nullable Card fields on ApplicationFact")
  print("reconstruction debt (target zero before closure)")
  debt = 0
  debt += debtrow("subject row", "subject: ?id,\n    arguments", graph)
  debt += debtrow("subject lower", "fact.subject", lower)
  debt += debtrow("subject backend", "fact.subject", backend)
  debt += debtrow("subject query", "return fact.subject", query)
  debt += debtrow("native_ir subject", "fact.subject", "src/native/ir.zig":read())
  debt += debtrow("sema fact in lowering", "applicationFact(", lower)
  debt += debtrow("sema fact in backend", "applicationFact(", backend)
  if !seen(lower, "applicationArguments")
    print("  open operand pack not consumed from graph in dnir_lower")
  if seen(lower, "applicationArguments")
    print("  ok   dnir_lower consumes graph operand pack")
  if !seen(lower, "applicationArguments")
    debt += 1
  print("checked-path DNIR identity (GAP-137)")
  ir = "src/native/ir.zig":read()
  fail += graphok("checked module derived from graph", "fn moduleIsChecked", ir)
  fail += graphok("identity-free call refused when checked", "if (checked) return false;", ir)
  fail += graphok("checked target continuity", "applicationTarget(application) != i.target", ir)
  fail += graphok("checked provenance continuity", "applicationProvenance(application) == null", ir)
  print("syntax backdoors below resolution")
  debt += debtrow("descriptor from shape AST", "ast.AliasDef = @ptrCast", lower)
  print("bootstrap faces still selected by callee text (GAP-155)")
  debt += debtrow("subject tail", "fn lowerSubjectTail", lower)
  print("one refusal names one cause")
  debt += debtrow("cause splice in DNB formatter", "diag.lowering.note() orelse diag.note()", backend)
  fail += graphok("one selected cause", "fn selectedCause", backend)
  if fail
    print("ledger/application: FAIL provenance")
    return 1
  if debt
    print("ledger/application: accessors PASS, closure OPEN ({debt} reconstruction row(s))")
    print("APPLICATION-CONSUMER-ZERO is NOT satisfied; accessors exist, consumers still reconstruct")
    return 0
  print("ledger/application: accessors PASS, every measured row CLOSED")
  0
