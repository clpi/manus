# Tracked Zig bootstrap ledger for the self-hosting target.
#
# scripts/census/language proves the count is bounded. This file prints the exact
# tracked bootstrap files, including build.zig, so the remaining queue is
# inspectable from idol.

capture: str = (shellline: str)
  gatecap(shellline)

chomp: str = (text: str)
  if text:len() == 0
    return ""
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

cap: str = (shellline: str)
  chomp(gatecap(shellline))

status: i64 = (cmd: str)
  cap("( {cmd} ) >/dev/null 2>&1; echo $?"):to(i64)

lines: any = (text: str)
  out = {}
  start = 1
  i = 1
  n = text:len()
  while i <= n
    if text:byte(i) == 10
      if i > start
        out:push(text:sub(start, i - 1))
      start = i + 1
    i = i + 1
  if start <= n
    out:push(text:sub(start, n))
  out

starts: bool = (text: str, prefix: str)
  text:len() >= prefix:len() and text:sub(1, prefix:len()) == prefix

has: bool = (text: str, part: str)
  pos = text:find(part, 1, true)
  pos and pos > 0

bucket: str = (path: str)
  if path == "build.zig"
    return "build"
  if has(path, "test") or has(path, "fixture")
    return "test"
  if has(path, "wasm")
    return "wasm"
  if has(path, "native") or has(path, "dnir") or has(path, "abi")
    return "native"
  if has(path, "semantic") or has(path, "graph") or has(path, "relation") or has(path, "realization")
    return "semantic"
  if has(path, "lexer") or has(path, "parser") or has(path, "token") or has(path, "sema")
    return "front"
  if has(path, "codegen") or has(path, "backend") or has(path, "lower") or has(path, "jit")
    return "back"
  "support"

control: i64 = ()
  bad = 0
  if bucket("build.zig") != "build"
    print("ledger/zig: fail control build")
    bad = bad + 1
  if bucket("src/parser.zig") != "front"
    print("ledger/zig: fail control front")
    bad = bad + 1
  if bucket("src/native_backend.zig") != "native"
    print("ledger/zig: fail control native")
    bad = bad + 1
  if bucket("src/wasm_semantic.zig") != "wasm"
    print("ledger/zig: fail control wasm")
    bad = bad + 1
  if bad == 0
    print("ledger/zig: control ok")
  bad

show: i64 = (name: str, files: any)
  count = 0
  for i = 1, files:len()
    if bucket(files(i)) == name
      count = count + 1
  print("{name} {count}")
  for i = 1, files:len()
    if bucket(files(i)) == name
      print("  {files[i]}")
  count

# GAP-220 / GAP-201. ZERO IS THIS LEDGER'S GOAL, so an empty enumeration
# cannot simply be scored a failure — and that is exactly what made the vacuous
# case so dangerous here. A tree with no `.git` answers zero for every pathspec,
# and this file then prints its BEST POSSIBLE verdict having examined nothing.
# So the enumerator is live-wired instead: `gate/subject.sh` is asked for a
# pathspec this repository cannot lack, and a zero there is the enumerator
# being broken, never the debt being retired.
subject: i64 = (root: str)
  status("cd '{root}' && sh gate/subject.sh '*.id'")

main: i64 = ()
  root = cap("git rev-parse --show-toplevel 2>/dev/null")
  if root == ""
    print("ledger/zig: fail no git root")
    return 3

  if subject(root) != 0
    print("ledger/zig: FAIL subject enumeration is not trustworthy here — GAP-220")
    return 3

  cmd = "cd '{root}' && git ls-files 'build.zig' 'src/*.zig' | sort"
  files = lines(capture(cmd))
  count = files:len()
  bad = control()
  if count == 0
    print("ledger/zig: pass tracked zig 0")
    return bad

  print("ledger/zig: fail tracked zig {count}")
  show("build", files)
  show("front", files)
  show("back", files)
  show("native", files)
  show("wasm", files)
  show("semantic", files)
  show("test", files)
  show("support", files)
  1
