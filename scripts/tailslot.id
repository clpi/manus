
rows = ""
failed = 0

here: str = ()
  script.chomp(script.capture("pwd"))

quiet: i64 = (cmd: str)
  script.status("{cmd} >/dev/null 2>&1")

grab: str = (cmd: str)
  script.chomp(script.capture(cmd))

note = (tag: str, ok: bool, detail: str)
  mark = "FAIL"
  if ok
    mark = "ok  "
  if not ok
    failed = failed + 1
  rows = "{rows}  {mark} {tag}  {detail}\n"

run: str = (bin: str, work: str, name: str, backend: str)
  src = "examples/tailslot/{name}.id"
  exe = "{work}/{name}.{backend}"
  out = "{work}/{name}.{backend}.out"
  quiet("rm -f {exe} {out}")
  built = quiet("{bin} compile {src} --backend={backend} -o {exe}")
  if built != 0
    return "BUILD-FAILED"
  code = script.status("{exe} >{out} 2>/dev/null")
  body = grab("tr '\\n' '|' <{out}")
  "rc={code} {body}"

main: i64 = ()
  root = here()
  bin = "{root}/zig-out/bin/idol"
  work = "/tmp/duo-tailslot"
  quiet("rm -rf {work}")
  quiet("mkdir -p {work}")

  fixtures = grab("ls examples/tailslot/*.id | wc -l | tr -d ' '")
  have = to(i64)(fixtures)
  note("P0 control", have == 4, "fixtures on disk: {have} of 4")
  if have != 4
    print(rows)
    print("tailslot: FAIL — the fixture set is not what the rows below assume")
    return 3

  branchd = run(bin, work, "branch", "direct")
  branchc = run(bin, work, "branch", "c")
  loopd = run(bin, work, "loop", "direct")
  loopc = run(bin, work, "loop", "c")
  armsd = run(bin, work, "arms", "direct")
  armsc = run(bin, work, "arms", "c")
  answd = run(bin, work, "answer", "direct")
  answc = run(bin, work, "answer", "c")

  note("T1 gap[104] branch", branchd == "rc=0 first|last|", "if-body tail print · direct: {branchd}")

  note("T2 gap[104] loop", loopd == "rc=0 b|b|b|3|", "while-body tail print · direct: {loopd}")

  note("T3 gap[104] arms", armsd == "rc=0 then|done|else|done|4|", "if/else arms out of tail slot · direct: {armsd}")

  spaced = grab("sed -n '1p' {work}/answer.direct.out | wc -c | tr -d ' '")
  note("N1 gap[033]", spaced == "2", "void tail call as the answer prints its space, no `ret` leak: width={spaced}")
  note("N2 branch answers", answd == "rc=7  |30|", "taken branch still returns · direct: {answd}")
  note("N3 tail assignment", grab("sed -n '2p' {work}/answer.direct.out") == "30", "tail `t += 10` still accumulates: reads 30")

  agree = branchd == branchc and loopd == loopc and armsd == armsc and answd == answc
  note("X1 oracle", agree, "direct vs on all four fixtures")

  print(rows)
  if failed > 0
    print("tailslot: FAIL — {failed} row(s); gap[104] is not closed")
    return 1
  print("tailslot: ok — the tail slot of a non-answering block runs, on both backends")
  0
