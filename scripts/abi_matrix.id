# ABI shape matrix — differential the direct backend over GENERATED call
# shapes rather than over the programs someone happened to write.
#
# WHY THIS EXISTS. The native differential sat at 81 agree / 2 differ, green,
# while the backend passed f64 arguments to a float kernel in GP registers
# (gap[056]) — `p(x: f64, y: f64): i64` with `if x > y` answered 1 where C
# answered 9. The gate was not broken. It was UNCOVERED: no corpus program had
# the shape "f64 params + comparison + non-f64 return", so 81/2 was a statement
# about what the corpus contains, not about whether the backend is correct.
#
# A corpus grows by accident. This grid grows on purpose: every combination of
# parameter signature x return type x whether the body branches on a
# comparison. Shapes nobody would think to write down are exactly the ones a
# hand-written corpus omits, and the AAPCS64 argument classifier is precisely
# the kind of code that is right for the shapes you tested and wrong for the
# rest.
#
# MIXED SIGNATURES ARE THE POINT. AAPCS64 counts FP and GP argument registers
# SEPARATELY: `f(a: i64, b: f64, c: i64)` is x0, d0, x1 — not x0, d1, x2. An
# all-float or all-integer signature is right under a shared-counter
# implementation and a mixed one is not, so a grid without mixtures would have
# reported this backend clean.
#
# A generated C twin compiled by clang is the oracle. Every row is judged by
# one complete execution from each arm: event, exit status, stdout, and stderr.
# A typed direct DNB refusal is a bail. Compiler transport, limiter, or C
# toolchain failure is infrastructure, never an unexamined row presented as a
# clean refusal. The compiler and oracle identities are printed on every run.
#
# MISCOMPILE_CEILING ratchets DOWNWARD. It shipped at 4 # the gap[056]
# family # and reached 0 the same day, so the gate is now a floor at zero:
# ANY wrong answer fails it, and a future fix that lowers it further should do
# so in the same commit — the mirror of how NATIVE_FLOOR ratchets up.

# One shell pass builds the grid, compiles each shape both ways, and observes
# each artifact exactly once under the shared native limiter. The final framed
# verdict is the only shell fact the Idol root projects into its process exit.
#
# Each row carries Idol and C parameter/call/condition faces. For every row
# three bodies are generated:
#   1. no comparison, constant i64 return   — isolates plain argument passing
#   2. comparison, i64 return               — argument passing + fcmp
#   3. comparison, str return               — the return-classification path
# The shell program is one ordinary string literal. Literal braces are escaped
# because Idol interpolation must not consume the shell's own parameter syntax.
matrix: i64 = ()
    gatecap("set -u\nexec 3>&1\nexec 1>&2\nidol=$\{IDOL:-./zig-out/bin/idol\}\nnative=$\{IDOL_NATIVE:-../idol-native\}\nlimiter=$\{ABI_MATRIX_LIMITER:-$native/gate/run_limited.pl\}\nlimit=$\{ABI_MATRIX_TIMEOUT:-30\}\nceiling=$\{MISCOMPILE_CEILING:-0\}\ndamage=$\{ABI_MATRIX_DAMAGE:-none\}\n\ncase $limit in ''|*[!0-9]*|0) printf '%s\\n' 'abi_matrix: infrastructure — timeout must be a positive decimal'; printf '%s\\n' 'abi_matrix_verdict=3'; printf '%s\\n' '3' >&3; exit 0;; esac\ncase $ceiling in ''|*[!0-9]*) printf '%s\\n' 'abi_matrix: infrastructure — ceiling must be a nonnegative decimal'; printf '%s\\n' 'abi_matrix_verdict=3'; printf '%s\\n' '3' >&3; exit 0;; esac\ncase $damage in none|wrong|zero) :;; *) printf '%s\\n' 'abi_matrix: infrastructure — unknown damage control'; printf '%s\\n' 'abi_matrix_verdict=3'; printf '%s\\n' '3' >&3; exit 0;; esac\n\nif [ ! -x \"$idol\" ] || [ ! -f \"$limiter\" ]; then\n  printf '%s\\n' 'abi_matrix: infrastructure — compiler or shared limiter absent'\n  printf '%s\\n' 'abi_matrix_verdict=3'\n  printf '%s\\n' '3' >&3\n  exit 0\nfi\nclang=$\{CC:-\}\nif [ -z \"$clang\" ]; then clang=$(xcrun --find clang 2>/dev/null || true); fi\nxcrun=$(command -v xcrun 2>/dev/null || true)\nif [ ! -x \"$clang\" ] || [ ! -x \"$xcrun\" ]; then\n  printf '%s\\n' 'abi_matrix: infrastructure — clang absent'\n  printf '%s\\n' 'abi_matrix_verdict=3'\n  printf '%s\\n' '3' >&3\n  exit 0\nfi\n\nd=$(mktemp -d \"$\{TMPDIR:-/tmp\}/idol-abi.XXXXXX\") || \{\n  printf '%s\\n' 'abi_matrix: infrastructure — private work creation failed'\n  printf '%s\\n' 'abi_matrix_verdict=3'\n  printf '%s\\n' '3' >&3\n  exit 0\n\}\ntrap 'rm -rf \"$d\"' EXIT HUP INT TERM\n\nhash256() \{ shasum -a 256 \"$1\" | awk '\{print $1\}'; \}\nidolhash=$(hash256 \"$idol\") || idolhash=unavailable\nclanghash=$(hash256 \"$clang\") || clanghash=unavailable\nxcrunhash=$(hash256 \"$xcrun\") || xcrunhash=unavailable\nlimiterhash=$(hash256 \"$limiter\") || limiterhash=unavailable\n\nobserve() \{\n  tag=$1\n  shift\n  event=$d/$tag.event\n  out=$d/$tag.stdout\n  err=$d/$tag.stderr\n  record=$d/$tag.record\n  rm -f \"$event\" \"$out\" \"$err\" \"$record\"\n  perl \"$limiter\" \"$limit\" \"$event\" \"$@\" </dev/null >\"$out\" 2>\"$err\"\n  rc=$?\n  kind=missing\n  if [ -s \"$event\" ]; then kind=$(sed -n '1p' \"$event\"); fi\n  printf '%s\\t%s\\n' \"$kind\" \"$rc\" >\"$record\"\n\}\n\nrows=$d/rows\nif [ \"$damage\" = zero ]; then\n  : >\"$rows\"\nelse\n  cat >\"$rows\" <<'ROWS'\na: i64|f(7)|a > 1|int64_t a|7|a > 1\na: f64|f(3.5)|a > 1.0|double a|3.5|a > 1.0\na: i64, b: f64|f(7, 3.5)|a > 1|int64_t a, double b|7, 3.5|a > 1\na: f64, b: i64|f(3.5, 7)|a > 1.0|double a, int64_t b|3.5, 7|a > 1.0\na: f64, b: f64|f(3.5, 1.5)|a > 1.0|double a, double b|3.5, 1.5|a > 1.0\na: i64, b: f64, c: i64, d: f64|f(1, 2.5, 3, 4.5)|a > 1|int64_t a, double b, int64_t c, double d|1, 2.5, 3, 4.5|a > 1\na: f64, b: i64, c: f64|f(2.5, 9, 1.5)|a > 1.0|double a, int64_t b, double c|2.5, 9, 1.5|a > 1.0\nROWS\nfi\n\nseen=0\nagree=0\nwrong=0\nbail=0\ninfra=0\n: >\"$d/wrong\"\n: >\"$d/infra\"\n\nwhile IFS='|' read -r iparams icall icond cparams ccall ccond; do\n  [ -n \"$iparams\" ] || continue\n\n  seen=$((seen + 1))\n  src=$d/t$seen.id\n  csrc=$d/t$seen.c\n  dbin=$d/t$seen.direct\n  cbin=$d/t$seen.clang\n  cvalue=300\n  if [ \"$damage\" = wrong ] && [ \"$seen\" -eq 1 ]; then cvalue=299; fi\n  printf 'f: i64 = (%s)\\n    300\\n\\nobserve: i64 = ()\\n    if %s == 300\\n        return 42\\n    43\\n\\nobserve()\\n' \"$iparams\" \"$icall\" >\"$src\"\n  printf '#include <stdint.h>\\nint64_t f(%s) \{ return %s; \}\\nint main(void) \{ return f(%s) == 300 ? 42 : 43; \}\\n' \"$cparams\" \"$cvalue\" \"$ccall\" >\"$csrc\"\n\n  observe dc$seen \"$idol\" compile --no-cache --backend=direct \"$src\" -o \"$dbin\"\n  IFS=$(printf '\\t') read -r dck dcrc <\"$d/dc$seen.record\"\n  observe cc$seen \"$xcrun\" --sdk macosx \"$clang\" -std=c11 -O2 \"$csrc\" -o \"$cbin\"\n  IFS=$(printf '\\t') read -r cck ccrc <\"$d/cc$seen.record\"\n  if [ \"$cck\" != ok ] || [ \"$ccrc\" -ne 0 ] || [ ! -x \"$cbin\" ]; then\n    infra=$((infra + 1))\n    printf 't%s compile direct=%s/%s clang=%s/%s\\n' \"$seen\" \"$dck\" \"$dcrc\" \"$cck\" \"$ccrc\" >>\"$d/infra\"\n  elif [ \"$dck\" = ok ] && [ \"$dcrc\" -ne 0 ] && grep -q 'DNB' \"$d/dc$seen.stderr\"; then\n    bail=$((bail + 1))\n  elif [ \"$dck\" != ok ] || [ \"$dcrc\" -ne 0 ] || [ ! -x \"$dbin\" ]; then\n    infra=$((infra + 1))\n    printf 't%s compile direct=%s/%s clang=%s/%s\\n' \"$seen\" \"$dck\" \"$dcrc\" \"$cck\" \"$ccrc\" >>\"$d/infra\"\n  else\n    observe dr$seen \"$dbin\"\n    IFS=$(printf '\\t') read -r drk drrc <\"$d/dr$seen.record\"\n    observe cr$seen \"$cbin\"\n    IFS=$(printf '\\t') read -r crk crrc <\"$d/cr$seen.record\"\n    case $drk in ok|timeout|signal:*) :;; *) infra=$((infra + 1)); printf 't%s runtime direct=%s/%s\\n' \"$seen\" \"$drk\" \"$drrc\" >>\"$d/infra\"; continue;; esac\n    case $crk in ok|timeout|signal:*) :;; *) infra=$((infra + 1)); printf 't%s runtime clang=%s/%s\\n' \"$seen\" \"$crk\" \"$crrc\" >>\"$d/infra\"; continue;; esac\n    if [ \"$drk\" = ok ] && [ \"$crk\" = ok ] && [ \"$drrc\" -eq \"$crrc\" ] && [ ! -s \"$d/dr$seen.stdout\" ] && [ ! -s \"$d/dr$seen.stderr\" ] && [ ! -s \"$d/cr$seen.stdout\" ] && [ ! -s \"$d/cr$seen.stderr\" ]; then\n      agree=$((agree + 1))\n    else\n      wrong=$((wrong + 1))\n      printf 't%s direct=%s/%s/%s/%s clang=%s/%s/%s/%s\\n' \"$seen\" \"$drk\" \"$drrc\" \"$(wc -c <\"$d/dr$seen.stdout\" | tr -d ' ')\" \"$(wc -c <\"$d/dr$seen.stderr\" | tr -d ' ')\" \"$crk\" \"$crrc\" \"$(wc -c <\"$d/cr$seen.stdout\" | tr -d ' ')\" \"$(wc -c <\"$d/cr$seen.stderr\" | tr -d ' ')\" >>\"$d/wrong\"\n    fi\n  fi\n\n  seen=$((seen + 1))\n  src=$d/t$seen.id\n  csrc=$d/t$seen.c\n  dbin=$d/t$seen.direct\n  cbin=$d/t$seen.clang\n  printf 'f: i64 = (%s)\\n    if %s\\n        return 9\\n    1\\n\\nobserve: i64 = ()\\n    %s\\n\\nobserve()\\n' \"$iparams\" \"$icond\" \"$icall\" >\"$src\"\n  printf '#include <stdint.h>\\nint64_t f(%s) \{ if (%s) return 9; return 1; \}\\nint main(void) \{ return (int)f(%s); \}\\n' \"$cparams\" \"$ccond\" \"$ccall\" >\"$csrc\"\n\n  observe dc$seen \"$idol\" compile --no-cache --backend=direct \"$src\" -o \"$dbin\"\n  IFS=$(printf '\\t') read -r dck dcrc <\"$d/dc$seen.record\"\n  observe cc$seen \"$xcrun\" --sdk macosx \"$clang\" -std=c11 -O2 \"$csrc\" -o \"$cbin\"\n  IFS=$(printf '\\t') read -r cck ccrc <\"$d/cc$seen.record\"\n  if [ \"$cck\" != ok ] || [ \"$ccrc\" -ne 0 ] || [ ! -x \"$cbin\" ]; then\n    infra=$((infra + 1))\n    printf 't%s compile direct=%s/%s clang=%s/%s\\n' \"$seen\" \"$dck\" \"$dcrc\" \"$cck\" \"$ccrc\" >>\"$d/infra\"\n  elif [ \"$dck\" = ok ] && [ \"$dcrc\" -ne 0 ] && grep -q 'DNB' \"$d/dc$seen.stderr\"; then\n    bail=$((bail + 1))\n  elif [ \"$dck\" != ok ] || [ \"$dcrc\" -ne 0 ] || [ ! -x \"$dbin\" ]; then\n    infra=$((infra + 1))\n    printf 't%s compile direct=%s/%s clang=%s/%s\\n' \"$seen\" \"$dck\" \"$dcrc\" \"$cck\" \"$ccrc\" >>\"$d/infra\"\n  else\n    observe dr$seen \"$dbin\"\n    IFS=$(printf '\\t') read -r drk drrc <\"$d/dr$seen.record\"\n    observe cr$seen \"$cbin\"\n    IFS=$(printf '\\t') read -r crk crrc <\"$d/cr$seen.record\"\n    case $drk in ok|timeout|signal:*) :;; *) infra=$((infra + 1)); printf 't%s runtime direct=%s/%s\\n' \"$seen\" \"$drk\" \"$drrc\" >>\"$d/infra\"; continue;; esac\n    case $crk in ok|timeout|signal:*) :;; *) infra=$((infra + 1)); printf 't%s runtime clang=%s/%s\\n' \"$seen\" \"$crk\" \"$crrc\" >>\"$d/infra\"; continue;; esac\n    if [ \"$drk\" = ok ] && [ \"$crk\" = ok ] && [ \"$drrc\" -eq \"$crrc\" ] && [ ! -s \"$d/dr$seen.stdout\" ] && [ ! -s \"$d/dr$seen.stderr\" ] && [ ! -s \"$d/cr$seen.stdout\" ] && [ ! -s \"$d/cr$seen.stderr\" ]; then\n      agree=$((agree + 1))\n    else\n      wrong=$((wrong + 1))\n      printf 't%s direct=%s/%s/%s/%s clang=%s/%s/%s/%s\\n' \"$seen\" \"$drk\" \"$drrc\" \"$(wc -c <\"$d/dr$seen.stdout\" | tr -d ' ')\" \"$(wc -c <\"$d/dr$seen.stderr\" | tr -d ' ')\" \"$crk\" \"$crrc\" \"$(wc -c <\"$d/cr$seen.stdout\" | tr -d ' ')\" \"$(wc -c <\"$d/cr$seen.stderr\" | tr -d ' ')\" >>\"$d/wrong\"\n    fi\n  fi\n\n  seen=$((seen + 1))\n  src=$d/t$seen.id\n  csrc=$d/t$seen.c\n  dbin=$d/t$seen.direct\n  cbin=$d/t$seen.clang\n  printf 'f: str = (%s)\\n    if %s\\n        return \"yes\"\\n    \"no\"\\n\\nobserve: i64 = ()\\n    %s:len()\\n\\nobserve()\\n' \"$iparams\" \"$icond\" \"$icall\" >\"$src\"\n  printf '#include <stdint.h>\\n#include <string.h>\\nconst char *f(%s) \{ if (%s) return \"yes\"; return \"no\"; \}\\nint main(void) \{ return (int)strlen(f(%s)); \}\\n' \"$cparams\" \"$ccond\" \"$ccall\" >\"$csrc\"\n\n  observe dc$seen \"$idol\" compile --no-cache --backend=direct \"$src\" -o \"$dbin\"\n  IFS=$(printf '\\t') read -r dck dcrc <\"$d/dc$seen.record\"\n  observe cc$seen \"$xcrun\" --sdk macosx \"$clang\" -std=c11 -O2 \"$csrc\" -o \"$cbin\"\n  IFS=$(printf '\\t') read -r cck ccrc <\"$d/cc$seen.record\"\n  if [ \"$cck\" != ok ] || [ \"$ccrc\" -ne 0 ] || [ ! -x \"$cbin\" ]; then\n    infra=$((infra + 1))\n    printf 't%s compile direct=%s/%s clang=%s/%s\\n' \"$seen\" \"$dck\" \"$dcrc\" \"$cck\" \"$ccrc\" >>\"$d/infra\"\n  elif [ \"$dck\" = ok ] && [ \"$dcrc\" -ne 0 ] && grep -q 'DNB' \"$d/dc$seen.stderr\"; then\n    bail=$((bail + 1))\n  elif [ \"$dck\" != ok ] || [ \"$dcrc\" -ne 0 ] || [ ! -x \"$dbin\" ]; then\n    infra=$((infra + 1))\n    printf 't%s compile direct=%s/%s clang=%s/%s\\n' \"$seen\" \"$dck\" \"$dcrc\" \"$cck\" \"$ccrc\" >>\"$d/infra\"\n  else\n    observe dr$seen \"$dbin\"\n    IFS=$(printf '\\t') read -r drk drrc <\"$d/dr$seen.record\"\n    observe cr$seen \"$cbin\"\n    IFS=$(printf '\\t') read -r crk crrc <\"$d/cr$seen.record\"\n    case $drk in ok|timeout|signal:*) :;; *) infra=$((infra + 1)); printf 't%s runtime direct=%s/%s\\n' \"$seen\" \"$drk\" \"$drrc\" >>\"$d/infra\"; continue;; esac\n    case $crk in ok|timeout|signal:*) :;; *) infra=$((infra + 1)); printf 't%s runtime clang=%s/%s\\n' \"$seen\" \"$crk\" \"$crrc\" >>\"$d/infra\"; continue;; esac\n    if [ \"$drk\" = ok ] && [ \"$crk\" = ok ] && [ \"$drrc\" -eq \"$crrc\" ] && [ ! -s \"$d/dr$seen.stdout\" ] && [ ! -s \"$d/dr$seen.stderr\" ] && [ ! -s \"$d/cr$seen.stdout\" ] && [ ! -s \"$d/cr$seen.stderr\" ]; then\n      agree=$((agree + 1))\n    else\n      wrong=$((wrong + 1))\n      printf 't%s direct=%s/%s/%s/%s clang=%s/%s/%s/%s\\n' \"$seen\" \"$drk\" \"$drrc\" \"$(wc -c <\"$d/dr$seen.stdout\" | tr -d ' ')\" \"$(wc -c <\"$d/dr$seen.stderr\" | tr -d ' ')\" \"$crk\" \"$crrc\" \"$(wc -c <\"$d/cr$seen.stdout\" | tr -d ' ')\" \"$(wc -c <\"$d/cr$seen.stderr\" | tr -d ' ')\" >>\"$d/wrong\"\n    fi\n  fi\ndone <\"$rows\"\n\nif [ \"$(hash256 \"$idol\" || true)\" != \"$idolhash\" ] || [ \"$(hash256 \"$clang\" || true)\" != \"$clanghash\" ] || [ \"$(hash256 \"$xcrun\" || true)\" != \"$xcrunhash\" ] || [ \"$(hash256 \"$limiter\" || true)\" != \"$limiterhash\" ]; then\n  infra=$((infra + 1))\n  printf '%s\\n' 'input moved during measurement' >>\"$d/infra\"\nfi\n\nprintf 'ABI shape matrix (generated Idol versus generated C/clang)\\n'\nprintf '  subject-count %s\\n' \"$seen\"\nprintf '  agree         %s\\n' \"$agree\"\nprintf '  MISCOMPILE    %s\\n' \"$wrong\"\nprintf '  bail          %s\\n' \"$bail\"\nprintf '  infrastructure %s\\n' \"$infra\"\nprintf '  idol-sha256   %s\\n' \"$idolhash\"\nprintf '  clang         %s\\n' \"$clang\"\nprintf '  clang-sha256  %s\\n' \"$clanghash\"\nprintf '  xcrun-sha256  %s\\n' \"$xcrunhash\"\nprintf '  limiter-sha256 %s\\n' \"$limiterhash\"\nif [ -s \"$d/wrong\" ]; then cat \"$d/wrong\"; fi\nif [ -s \"$d/infra\" ]; then cat \"$d/infra\"; fi\n\nverdict=0\nif [ \"$seen\" -ne 21 ]; then verdict=3\nelif [ \"$infra\" -ne 0 ]; then verdict=3\nelif [ $((agree + wrong)) -eq 0 ]; then verdict=3\nelif [ \"$wrong\" -gt \"$ceiling\" ]; then verdict=1\nelif [ \"$wrong\" -lt \"$ceiling\" ]; then verdict=3\nfi\nprintf 'abi_matrix_verdict=%s\\n' \"$verdict\"\nprintf '%s\\n' \"$verdict\" >&3\nexit 0\n"):to(i64)


matrix()
