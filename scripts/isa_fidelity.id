

capture: str = (shellline: str)
    gatecap(shellline)

chomp: str = (text: str)
    if text == nil or text:len() == 0
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

cap: str = (shellline: str)
    chomp(gatecap(shellline))

status: i64 = (cmd: str)
    cap("( {cmd} ) >/dev/null 2>&1; echo $?"):to(i64)

each: i64 = ()
    16

work: str = ()
    "/tmp/duo_isa"

sh: str = (cmd: str)
    root = os.env["DUO_ROOT"] or "."
    capture("cd {root} && {cmd}")

hexof: str = (v: i64)
    digits = "0123456789abcdef"
    out: str = ""
    j: i64 = 0
    while j < 8
        nib = (v >> ((7 - j) * 4)) & 15
        out = "{out}{digits:sub(nib + 1, nib + 1)}"
        j += 1
    out

regs: any = ()
    { 0, 1, 3, 5, 9, 12, 17, 20, 24, 28, 30, 2, 7, 15, 21, 29 }

pick: i64 = (f: str, w: i64, t: i64)
    v: i64 = 0
    if f == "d"
        v = regs()[(t % 16) + 1]
    else(f == "n")
        v = regs()[((t + 5) % 16) + 1]
    else(f == "m")
        v = regs()[((t + 9) % 16) + 1]
    else(f == "a")
        v = regs()[((t + 13) % 16) + 1]
    else(f == "h")
        v = t % 4
    else(f == "c")
        v = t % 16
    else
        top = (1 << w) - 1
        v = (t * 2731) % (top + 1)
        if t == 0
            v = 0
        if t == 1
            v = top
    v

expand: str = (row: str, asmout: str, want: any, whose: any)
    out = asmout
    lay = arm64:layout(row)
    nm = arm64:name(row)
    t: i64 = 0
    while t < each()
        ops = {}
        if lay:len() > 0
            for i, fact in lay:split(" ")
                ops[arm64:holds(fact)] =
                    pick(arm64:holds(fact), arm64:width(fact), t)
        line = arm64:text(row, ops)
        want[want:len() + 1] = arm64:encode(row, ops)
        whose[whose:len() + 1] = "{nm}  {line}"
        out = "{out}\t{line}\n"
        t += 1
    out

oracle: any = (asmtext: str, tag: str)
    wd = work()
    src = "{wd}/{tag}.s"
    obj = "{wd}/{tag}.o"
    handle = src:open("w")
    handle:write(".text\n.globl _isaprobe\n_isaprobe:\n{asmtext}")
    handle:close()
    trip = "arm64-apple-macos"
    if chomp(sh("uname -s")) != "Darwin"
        trip = "aarch64-linux-gnu"
    out = {}
    if status("clang -c -target {trip} -o {obj} {src} >/dev/null 2>&1") == 0
        raw = sh("objdump -d {obj} | cut -f1 | sed -n -e 's/^ *[0-9a-f]*: *//p' | tr -d ' '")
        out = raw:split("\n")
    out

sweep: i64 = (rowset: any, tag: str, show: bool)
    want = {}
    whose = {}
    asmtext = ""
    for i, row in rowset
        asmtext = expand(row, asmtext, want, whose)

    got = oracle(asmtext, tag)
    lines = {}
    for i, raw in got
        h = chomp(raw)
        if h:len() == 8
            lines[lines:len() + 1] = h

    outcome: i64 = -1
    if lines:len() != want:len()
        if show
            a = lines:len():to(str)
            b = want:len():to(str)
            print("isa_fidelity: FAIL — the oracle returned {a} words for {b} instructions;")
            print("  clang or objdump did not run, and an unjudged sweep is not a clean one")
    else
        bad: i64 = 0
        shown: i64 = 0
        for i, h in lines
            mine = want[i]
            theirs = arm64:hex(h)
            if mine != theirs
                bad += 1
                if show and shown < 12
                    ours = hexof(mine)
                    which = whose[i]
                    print("  MISMATCH  {which}")
                    print("            descriptor {ours}   oracle {h}")
                    shown += 1
        outcome = bad
    outcome

only: any = (row: str)
    { row }

main: i64 = ()
    wd = work()
    status("rm -rf {wd} && mkdir -p {wd}")

    rowset = arm64:rows()
    nrows = rowset:len()
    code: i64 = 0

    if nrows == 0
        print("isa_fidelity: FAIL — the descriptor table is empty; nothing was judged")
        code = 3
    else
        n = nrows:to(str)
        tup = each():to(str)
        total = (nrows * each()):to(str)
        print("ISA fidelity — descriptors vs clang, byte for byte (G-D3)")
        print("  descriptors   {n} instruction forms")
        print("  tuples        {tup} operand combinations each — {total} instructions")
        print("")

        bad = sweep(rowset, "main", true)

        ctlbase = "add|8d000000|m@20:16 n@9:5 d@4:0|add x%d, x%n, x%m"
        ctlshift = "add|8b000000|m@20:16 n@9:5 d@4:1|add x%d, x%n, x%m"
        ctlswap = "add|8b000000|m@9:5 n@20:16 d@4:0|add x%d, x%n, x%m"

        cbase = sweep(only(ctlbase), "ctlbase", false)
        cshift = sweep(only(ctlshift), "ctlshift", false)
        cswap = sweep(only(ctlswap), "ctlswap", false)

        cb = cbase:to(str)
        cs = cshift:to(str)
        cw = cswap:to(str)
        agreed = (nrows * each() - bad):to(str)
        b = bad:to(str)

        if bad < 0
            code = 3
        else(cbase != each())
            print("isa_fidelity: FAIL — the corrupted-base control was caught {cb} times of {tup};")
            print("  a wrong base word must fail every tuple, so the comparison is not comparing")
            code = 3
        else(cshift < 1)
            print("isa_fidelity: FAIL — the shifted-field control was never caught;")
            print("  the encoder is not reading the layout's bit positions")
            code = 3
        else(cswap < 1)
            print("isa_fidelity: FAIL — the swapped-field control was never caught;")
            print("  operand identity is not reaching the encoding")
            code = 3
        else(bad > 0)
            print("  controls      corrupted base {cb}/{tup} · shifted field {cs} · swapped fields {cw}")
            print("")
            print("  agree         {agreed}")
            print("  DISAGREE      {b}   a descriptor and the assembler encode differently")
            print("")
            print("isa_fidelity: FAIL — the ISA table and the oracle do not agree.")
            code = 1
        else
            print("  controls      corrupted base {cb}/{tup} · shifted field {cs} · swapped fields {cw}")
            print("  agree         {agreed}   every descriptor encodes what clang encodes")
            print("")
            print("isa_fidelity: PASS")
            code = 0
    code
