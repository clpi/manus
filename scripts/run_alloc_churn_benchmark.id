
_OUT_DIR = "/tmp/duo_alloc_churn_bench"
_EX = "examples"

_fmt2: str = (x: f64)
  n = to(i64)(x * 100.0 + 0.5)
  whole = n / 100
  frac = n % 100
  if frac < 10
    return whole:to(str) .. ".0" .. frac:to(str)
  whole:to(str) .. "." .. frac:to(str)

_sdk_flag: str = ()
  sdk = script.chomp(script.capture("xcrun --show-sdk-path 2>/dev/null"))
  if sdk == ""
    return ""
  "-isysroot " .. sdk

main: i64 = ()
  print("=== Duo Alloc Churn Benchmark ===")
  print("")

  duo = "./zig-out/bin/idol"
  if not script.fs_exists(duo)
    print("ERROR: Duo compiler not found at " .. duo)
    print("  Run 'zig build' first")
    return 1

  script.run("mkdir -p " .. _OUT_DIR)
  sysroot = _sdk_flag()

  print("[1/3] Compiling C reference...")
  cbin = _OUT_DIR .. "/bench_alloc_c"
  if script.run("clang -O3 -flto -march=native " .. sysroot .. " " .. _EX .. "/bench_alloc_churn_c.c -o " .. cbin) != 0
    print("ERROR: C reference failed to compile")
    return 1
  print("      -> " .. cbin)

  print("[2/3] Compiling bench_alloc_churn.id...")
  dbin = _OUT_DIR .. "/bench_alloc_churn_duo"
  if script.run(duo .. " compile " .. _EX .. "/bench_alloc_churn.id -o " .. dbin .. " -O3") != 0
    print("ERROR: Duo benchmark failed to compile")
    return 1
  print("      -> " .. dbin)

  print("")
  print("[3/3] Running benchmark...")
  print("-----------------------------------------------")

  print("Running Duo...")
  duo_out = script.chomp(script.capture(dbin .. " | tail -n 1"))
  print("Duo Time: " .. duo_out .. " s")

  print("Running C...")
  c_out = script.chomp(script.capture(cbin .. " | tail -n 1"))
  print("C Time:   " .. c_out .. " s")

  ct = to(f64)(c_out)
  dt = to(f64)(duo_out)
  if ct == nil or dt == nil or ct == 0.0
    print("Ratio (Duo/C): unavailable — could not read both times")
    print("-----------------------------------------------")
    return 1

  print("Ratio (Duo/C): " .. _fmt2(dt / ct) .. "x")
  print("-----------------------------------------------")
  print("")
  print("Done.")
  0
