# INFER-ONE conversion debt census (law.repair.infer · law.projection.census).
#
# Counts explicit conversion spellings in tracked .id files. Reports by path
# role prefix so agents classify before rewrite — never bulk-delete.
#
# Bootstrap shell ingress via gatecap (GAP-155) — not process.* namespace.
# Uses grep for patterns containing '(' — gatecap strips rg regex escapes.
#
# Run from repository root:
#   idol run scripts/infer_census.id
#
# Exit 0 always — this reports; graph gates own enforcement (law.gate.infer).

chomp: str = (text: str)
    if text:len() == 0
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

cap: str = (cmd: str)
    chomp(gatecap(cmd))

main: i64 = ()
    root = cap("git rev-parse --show-toplevel 2>/dev/null")
    if root == ""
        print("infer_census: fail no root — run from repository root")
        return 3

    subj = cap("git ls-files '*.id' | xargs grep -h -c ':to(' 2>/dev/null | awk '{s+=$1} END{print s+0}'")
    nest = cap("git ls-files '*.id' | xargs grep -h -E -c 'to\\((str|i64|bytes)\\)\\(' 2>/dev/null | awk '{s+=$1} END{print s+0}'")
    files = cap("git ls-files '*.id' | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")

    print("infer_census: explicit conversion spellings in tracked .id")
    print("  root {root}")
    print("  files with hits {files}")
    print("  subject-first :to( {subj}")
    print("  nested to(T)( {nest}")
    print("")
    print("  by role prefix:")
    print(cap("git ls-files '*.id' | xargs grep -l ':to(' 2>/dev/null | awk -F/ '{ if ($1==\"examples\" && ($2==\"conversion\" || $2==\"projection\" || $2==\"infer\" || $2==\"demand\" || $2==\"nominal\" || $2==\"layout\" || $2==\"pack\" || $2==\"anchor\" || $2==\"case\" || $2==\"read\")) print \"canonical-teaching\"; else if ($1==\"lib\" && $2==\"std\") print \"std-migration\"; else if ($1==\"scripts\") print \"script\"; else if ($1==\"gates\") print \"gate\"; else if ($1==\"tools\" && $2==\"mcp\") print \"mcp-agent\"; else if ($1==\"tools\") print \"tool\"; else if ($1==\"lib\") print \"lib\"; else if ($1==\"examples\") print \"example\"; else print \"other\" }' | sort | uniq -c | sort -rn"))
    print("")
    print("  top files (:to( count):")
    print(cap("git ls-files '*.id' | xargs grep -c ':to(' 2>/dev/null | awk -F: '$2>0' | sort -t: -k2 -nr | head -25"))
    print("")
    print("  repair classes A–L (law.repair.infer) — classify each site before rewrite")
    print("  census only; graph proof required for removal (GAP-124 · GAP-165)")
    0
