# INFER-ONE conversion debt census (law.repair.infer · law.projection.census).
#
# Counts explicit conversion spellings in tracked .id files. Reports by path
# role prefix so agents classify before rewrite — never bulk-delete.
#
# Bootstrap shell ingress via gatecap (GAP-155) — not process.* namespace.
# Uses grep for patterns containing '(' — gatecap strips rg regex escapes.
#
# Run from repository root:
#   idol run scripts/infer_census.id
#
# Exit 0 always — this reports; graph gates own enforcement (law.gate.infer).

chomp: str = (text: str)
  if text:len() == 0
    return ""
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

cap: str = (cmd: str)
  chomp(gatecap(cmd))

main: i64 = ()
  root = cap("git rev-parse --show-toplevel 2>/dev/null")
  if root == ""
    print("infer_census: fail no root — run from repository root")
    return 3

  # GAP-220 / GAP-201. EVERY enumeration below is `git ls-files` at the HEAD OF
  # A PIPELINE, so its exit status is destroyed before anything can read it:
  # with a stale pathspec, or in a tree with no `.git`, every row reads 0 and
  # this census prints a perfect, meaningless report. `gate/subject.sh` owns
  # the ruling — a gate that examines zero subjects must FAIL — and this asks
  # it in the one position where a status survives a pipe.
  if cap("sh gate/subject.sh '*.id' >/dev/null 2>&1; echo $?") != "0"
    print("infer_census: FAIL zero subjects — the census did not run (GAP-201)")
    return 3

  subj = cap("git ls-files '*.id' | xargs grep -h -c ':to(' 2>/dev/null | awk '{s+=$1} END{print s+0}'")
  nest = cap("git ls-files '*.id' | xargs grep -h -E -c 'to\\((str|i64|bytes)\\)\\(' 2>/dev/null | awk '{s+=$1} END{print s+0}'")
  files = cap("git ls-files '*.id' | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")

  print("infer_census: explicit conversion spellings in tracked .id")
  print("  root {root}")
  print("  files with hits {files}")
  print("  subject-first :to( {subj}")
  print("  nested to(T)( {nest}")
  print("")
  print("  by role prefix (files with :to():")
  teach = cap("git ls-files 'examples/conversion/*.id' 'examples/projection/*.id' 'examples/infer/*.id' 'examples/demand/*.id' 'examples/nominal/*.id' 'examples/layout/*.id' 'examples/pack/*.id' 'examples/anchor/*.id' 'examples/case/*.id' 'examples/read/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  stdmig = cap("git ls-files 'lib/std/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  script = cap("git ls-files 'scripts/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  gate = cap("git ls-files 'gates/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  mcp = cap("git ls-files 'tools/mcp/*.id' 'tools/mcp/*/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  example = cap("git ls-files 'examples/*.id' 'examples/*/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  tool = cap("git ls-files 'tools/*.id' 'tools/*/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  lib = cap("git ls-files 'lib/*.id' 'lib/*/*.id' 2>/dev/null | xargs grep -l ':to(' 2>/dev/null | wc -l | tr -d ' '")
  print("    canonical-teaching {teach}")
  print("    std-migration      {stdmig}")
  print("    script             {script}")
  print("    gate               {gate}")
  print("    mcp-agent          {mcp}")
  print("    example-other      {example}")
  print("    tool               {tool}")
  print("    lib                {lib}")
  print("")
  print("  top files (:to( count):")
  print(cap("git ls-files '*.id' | xargs grep -c ':to(' 2>/dev/null | awk -F: '$2>0' | sort -t: -k2 -nr | head -25"))
  print("")
  print("  repair classes A–L (law.repair.infer) — classify each site before rewrite")
  print("  census only; graph proof required for removal (GAP-124 · GAP-165)")
  0
