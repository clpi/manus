#!/usr/bin/env bash
# zig-safe — auto-lock wrapper for bare `zig` invocations (G-057 / F-lock-bypass-stall).
#
# Parallel agents calling bare `zig build|test|run` bypass duo_lock.sh and corrupt
# .zig-cache or exhaust fork/RAM limits. Always prefer this shim (or
# scripts/duo_lock.sh -- zig …) for heavy Zig work.
#
# Usage:
#   scripts/zig-safe build
#   scripts/zig-safe test src/codegen.zig --test-filter foo
#   scripts/zig-safe build unit-test --summary all
#
# Environment:
#   DUO_SAFE_NO_LOCK — set to 1 to pass through without locking (debug only)

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GATE="$ROOT/scripts/duo_gate.sh"
LOCK="$ROOT/scripts/duo_lock.sh"

# Resolve zig: prefer PATH, fall back to common install locations.
resolve_zig() {
    if command -v zig >/dev/null 2>&1; then
        command -v zig
        return 0
    fi
    for candidate in "$HOME/.local/bin/zig" "/opt/homebrew/bin/zig" "/usr/local/bin/zig"; do
        if [[ -x "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

REAL_ZIG="$(resolve_zig)" || {
    echo "zig-safe: zig not found on PATH" >&2
    exit 127
}

needs_lock() {
    local sub="${1:-}"
    case "$sub" in
        build|test|run|fetch) return 0 ;;
        *) return 1 ;;
    esac
}

if [[ "${DUO_SAFE_NO_LOCK:-0}" == "1" ]] || [[ "${DUO_LOCK_HELD:-0}" == "1" ]]; then
    exec "$REAL_ZIG" "$@"
fi

if [[ $# -eq 0 ]] || ! needs_lock "${1:-}"; then
    exec "$REAL_ZIG" "$@"
fi

exec "$GATE" -- "$LOCK" -- "$REAL_ZIG" "$@"
