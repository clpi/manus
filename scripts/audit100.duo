-- audit100 — CLAUDE.md §1 DENY LIST, made executable.
--
-- Epoch 2 (Pass 100) put a deny table in CLAUDE.md and §2 says "ship with EVERY
-- diff or the diff is rejected unread". Nothing enforced it, so it was read as
-- advice. This gate greps for it.
--
-- TWO DESIGN DECISIONS, both of which are the difference between a gate that
-- gets run and a gate that gets muted:
--
--   1. IT RATCHETS. Every row carries the count measured when the row landed.
--      Over budget fails; at or under budget passes and prints the slack. A
--      gate that is red on the day it ships teaches people to pass --skip.
--      Lower a budget whenever you lower a count; that is the whole protocol.
--
--   2. IT SCANS THE CANONICAL PARTITION ONLY. docs/spec/corpus.md classifies
--      every tracked .duo file. examples/compile_fail/ must contain denied
--      text — that is its assertion. Counting it makes zero unreachable and
--      the number meaningless. See docs/spec/corpus.md for the mechanism and
--      the argument against per-file markers.
--
-- HONESTY (CLAUDE.md §3). Seven §1 rows are SEMANTIC and are NOT mechanized
-- here: `_` discard binders, module aliases, Alias.fn(subject, …), single-use
-- next-line temps, elseif kind-ladders, sentinels, and mixed-kind groups. They
-- are listed in the output as UNMECHANIZED rather than omitted, because a
-- 17-row report that silently covers 17 of 24 rows is how an audit starts
-- lying. The mechanized rows are also line-grained and comment-stripped, so
-- they over-report inside string literals and under-report inside trailing
-- comments; they are pressure, not proof.
--
-- SELF-EXCLUSION. This file is skipped by its own scan, and says so. Its deny
-- patterns are DATA. A corpus walker whose data is the text it greps for
-- reports itself — GAP-16 already cost this repo a day when
-- scripts/spec_conformance.duo had its own test programs interpolated as if
-- they were harness source.
--
-- STRING BODIES ARE STRIPPED, PER ROW. Same argument, one level down. The rows
-- are about the SHAPE OF DUO CODE, and a `"const T*"` inside an @comp.c.emit
-- payload is not Duo code — it is data the compiler hands to a C compiler.
-- Counting it applies pressure toward something no edit can reach: measured
-- 2026-08-08 over 441 canonical files, `foreignkw` read 330 with string
-- bodies in and 164 with them out, so HALF that row was unrepairable by
-- definition.
--
-- The strip is per-row and not global because one row's noise is another
-- row's subject: `concatlit` asks whether `..` sits beside a string literal,
-- and a global strip deletes the literal it is looking for. So each row
-- carries a flag in `keeps`; today exactly one row sets it, and that row is
-- the control — its count must NOT move when this strip is introduced, and
-- it did not: 2155 before, 2155 after.
--
-- Exit 0 pass · 1 a row exceeded budget or a file is unclassified · 3 the gate
-- could not run (no rules, no files, no canonical set — a confident 0 is
-- usually a broken gate, so every zero here is positive-controlled).
--
-- AUDIT100_SHOW=<row>   print up to 20 offending lines for one row, with paths.
-- AUDIT100_LIST=<path>  where to write the canonical file list.
--
-- NOT SAFE TO RUN CONCURRENTLY AT THE DEFAULT PATH, and that is why the
-- override above exists. The canonical list used to be written to a fixed
-- /tmp path with no override. A run in a detached worktree printed that
-- worktree as its `root` and then counted THE MAIN TREE'S FILES, because a
-- concurrent run in the main tree had rewritten the list underneath it — one
-- tree's banner over another tree's numbers, with no indication. A fixed path
-- in /tmp is a shared mutable surface. If you are measuring anything you
-- intend to write down, point AUDIT100_LIST somewhere private and confirm the
-- counts are stable across repeat runs.

_SELF = "scripts/audit100.duo"
-- The constitution is excluded for the SAME reason audit100 excludes itself:
-- its text is DATA. `law.arch.relation` must be able to name `addnode` and
-- `add_node` as the spellings it forbids, and `law.fact.one` must show the
-- two-write anti-pattern it rules out. A deny-grep over the law convicts the
-- law for citing the law. Exclusion is NOT a budget: the file is canonical, it
-- passes `duo check`, and every rule it states is enforced on every other file.
_LAW = "docs/spec/constitution.duo"
_LIST = std.script.getenv("AUDIT100_LIST", "/tmp/duo_audit100_canonical.list")

-- The string-body strip, as a shell fragment. Two passes, in this order:
-- drop escaped quotes (`\"`) so they cannot close a body early, then drop
-- every `"…"` body. Built from named pieces rather than one escaped literal
-- because the literal spelling is `s/\\"//g` and writing that through two
-- levels of quoting is how a gate ends up silently matching nothing.
_Q = "'"
_DQ = "\""
_BSBS = "\\\\"
_STRIP = " | sed -e " .. _Q .. "s/" .. _BSBS .. _DQ .. "//g" .. _Q
    .. " -e " .. _Q .. "s/" .. _DQ .. "[^" .. _DQ .. "]*" .. _DQ .. "//g" .. _Q

_lines(s: str): any
    out = {}
    n: i64 = #s
    start: i64 = 1
    i: i64 = 1
    while i <= n
        if string.byte(s, i) == 10
            if i > start
                table.insert(out, string.sub(s, start, i - 1))
            end
            start = i + 1
        end
        i += 1
    end
    if start <= n
        table.insert(out, string.sub(s, start, n))
    end
    out
end

_starts(s: str, prefix: str): bool
    p: i64 = #prefix
    if #s < p
        return false
    end
    string.sub(s, 1, p) == prefix
end

-- Whitespace-separated field n (1-based) of a line, "" when absent.
_field(line: str, want: i64): str
    n: i64 = #line
    i: i64 = 1
    seen: i64 = 0
    while i <= n
        b: i64 = string.byte(line, i)
        if b != 32 and b != 9
            seen += 1
            start: i64 = i
            while i <= n and string.byte(line, i) != 32 and string.byte(line, i) != 9
                i += 1
            end
            if seen == want
                return string.sub(line, start, i - 1)
            end
        else
            i += 1
        end
    end
    ""
end

_is_class(c: str): bool
    c == "canonical" or c == "compatibility" or c == "foreign"
        or c == "negative" or c == "historical" or c == "generated"
end

-- Count lines matching `pat` across the canonical list, comments always
-- stripped. `keep` is 1 for the rows whose subject IS a string literal; every
-- other row also has string BODIES stripped, so it measures Duo code rather
-- than payloads the compiler hands to a C compiler.
_hits(pat: str, keep: i64): i64
    q: str = "'"
    strip: str = _STRIP
    if keep != 0
        strip = ""
    end
    cmd: str = ("tr '\\n' '\\0' < " .. _LIST
        .. " | xargs -0 cat 2>/dev/null"
        .. " | grep -v -E " .. q .. "^[[:space:]]*--" .. q
        .. strip
        .. " | grep -c -E " .. q .. pat .. q)
    to(i64)(std.script.chomp(std.script.capture(cmd)))
end

-- Count lines matching `pat` in an ARBITRARY text source, through the two
-- filters every row uses. `src` is a shell fragment that writes the text to
-- stdout, so the same row regex can be pointed at the working copy of a file
-- (`cat p`) or at its HEAD blob (`git show HEAD:p`). That pair is the whole
-- delta report: `after - before` is what YOUR tree costs on that row.
--
-- It is a separate function from `_hits` rather than a parameter on it because
-- `_hits` hard-codes the canonical list, and the delta report must be able to
-- read a file that is not on that list yet — an UNTRACKED `.duo` is invisible
-- to `git ls-files`, so its points are worth exactly zero until someone runs
-- `git add`, at which moment they are worth all of them at once. That is how
-- `examples/boring/` landed +6 on `trailret` with nobody holding it.
_tally(pat: str, keep: i64, src: str): i64
    q: str = "'"
    strip: str = _STRIP
    if keep != 0
        strip = ""
    end
    cmd: str = (src
        .. " | grep -v -E " .. q .. "^[[:space:]]*--" .. q
        .. strip
        .. " | grep -c -E " .. q .. pat .. q)
    to(i64)(std.script.chomp(std.script.capture(cmd)))
end

-- Does `f` fall in the canonical partition, by the same first-match-wins walk
-- the census does? The delta report needs this for files the census never
-- saw.
_canon(rcls: any, rpre: any, f: str): bool
    j: i64 = 1
    while j <= #rpre
        if _starts(f, rpre[j])
            return rcls[j] == "canonical"
        end
        j += 1
    end
    false
end

-- Count matches of `pat` against ONE literal line, through the same grep the
-- rows use. This is the control surface: it asks whether a pattern still
-- recognises the text it was written for, without depending on the corpus
-- containing that text. A row whose residue legitimately reaches zero stays
-- controlled; a row whose regex rots is caught on the run that rots it.
_probe(pat: str, line: str): i64
    q: str = "'"
    cmd: str = ("printf " .. q .. "%s\n" .. q .. " " .. q .. line .. q
        .. " | grep -c -E " .. q .. pat .. q)
    to(i64)(std.script.chomp(std.script.capture(cmd)))
end

_show(pat: str, keep: i64): void
    q: str = "'"
    -- SHOW must agree with the count or it sends people to lines the ratchet
    -- never saw. Both filters therefore run here too, applied AFTER the match
    -- so the `path:line:` prefix survives — sed cannot damage it, there are no
    -- quotes in a path — and then the pattern is re-checked against the
    -- stripped text so anything that only matched inside a string body drops.
    strip: str = _STRIP
    if keep != 0
        strip = ""
    end
    cmd: str = ("tr '\\n' '\\0' < " .. _LIST
        .. " | xargs -0 grep -n -E " .. q .. pat .. q .. " 2>/dev/null"
        .. " | grep -v -E " .. q .. ":[0-9][0-9]*:[[:space:]]*--" .. q
        .. strip
        .. " | grep -E " .. q .. pat .. q
        .. " | head -20")
    io.write(std.script.capture(cmd))
end

_pad(s: str, width: i64): str
    out: str = s
    while #out < width
        out = out .. " "
    end
    out
end

main(): i64
    root: str = std.script.chomp(std.script.capture("git rev-parse --show-toplevel 2>/dev/null"))
    if root == ""
        print("audit100: FAIL — not inside a git work tree; the corpus cannot be listed")
        return 3
    end
    print("audit100 — CLAUDE.md §1 deny table, over the canonical partition")
    print("  root      " .. root)

    manifest: str = root .. "/docs/spec/corpus.md"
    if not std.script.fs_exists(manifest)
        print("audit100: FAIL — missing " .. manifest)
        return 3
    end

    -- Rules: parallel arrays, first match wins, order as written.
    rcls = {}
    rpre = {}
    for _i, line in _lines(std.script.fs_read(manifest))
        c: str = _field(line, 1)
        p: str = _field(line, 2)
        if _is_class(c) and p != "" and _field(line, 3) == ""
            table.insert(rcls, c)
            table.insert(rpre, p)
        end
    end
    if #rcls == 0
        print("audit100: FAIL — docs/spec/corpus.md yielded 0 rules; the parse is broken")
        return 3
    end
    print("  rules     " .. to(str)(#rcls) .. " from docs/spec/corpus.md")

    files = _lines(std.script.capture("cd " .. root .. " && git ls-files '*.duo'"))
    if #files == 0
        print("audit100: FAIL — git ls-files found 0 .duo files; the census did not run")
        return 3
    end

    n_canon = 0
    n_compat = 0
    n_foreign = 0
    n_neg = 0
    n_hist = 0
    n_gen = 0
    n_none = 0
    written = 0
    unclassified: str = ""
    canon: str = ""

    for _i, f in files
        cls: str = ""
        j: i64 = 1
        while j <= #rpre and cls == ""
            if _starts(f, rpre[j])
                cls = rcls[j]
            end
            j += 1
        end
        if cls == "canonical"
            n_canon += 1
            if f != _SELF and f != _LAW
                written += 1
                canon = canon .. root .. "/" .. f .. "\n"
            end
        elseif cls == "compatibility"
            n_compat += 1
        elseif cls == "foreign"
            n_foreign += 1
        elseif cls == "negative"
            n_neg += 1
        elseif cls == "historical"
            n_hist += 1
        elseif cls == "generated"
            n_gen += 1
        else
            n_none += 1
            if n_none <= 10
                unclassified = unclassified .. "    " .. f .. "\n"
            end
        end
    end

    print("")
    print("corpus census (" .. to(str)(#files) .. " tracked .duo files)")
    print("  canonical      " .. to(str)(n_canon) .. "   deny table applies")
    print("  compatibility  " .. to(str)(n_compat) .. "   Lua-superset input")
    print("  foreign        " .. to(str)(n_foreign) .. "   embeds another language, or vendored")
    print("  negative       " .. to(str)(n_neg) .. "   denied text IS the assertion")
    print("  historical     " .. to(str)(n_hist) .. "   past-epoch evidence, unmaintained")
    print("  generated      " .. to(str)(n_gen) .. "   fix the generator, not the file")

    if n_none != 0
        print("")
        print("audit100: FAIL — " .. to(str)(n_none)
            .. " tracked .duo files match no rule in docs/spec/corpus.md:")
        io.write(unclassified)
        print("  Classify them; there is deliberately no silent default.")
        return 1
    end

    if n_canon == 0
        print("audit100: FAIL — canonical partition is empty; the rules cannot be right")
        return 3
    end

    std.script.fs_write(_LIST, canon)
    listed: i64 = to(i64)(std.script.chomp(std.script.capture("wc -l < " .. _LIST)))
    if listed != written
        print("audit100: FAIL — wrote " .. to(str)(written)
            .. " canonical paths but the list holds " .. to(str)(listed))
        return 3
    end

    -- Positive control: a pattern that MUST hit. If this reads 0, the pipeline
    -- is broken and every other 0 in this report is a lie.
    control: i64 = _hits("[a-zA-Z]", 1)
    if control == 0
        print("audit100: FAIL — control pattern matched 0 lines across "
            .. to(str)(listed) .. " canonical files; the grep pipeline is broken")
        return 3
    end

    -- The SAME control, through the STRIPPED path — and it is a separate check
    -- because the two paths are separate pipelines and only one of them was
    -- ever controlled. Sixteen of the seventeen rows below are measured with
    -- string bodies stripped; the control above is measured with them intact
    -- (keep=1), so it never touches the sed at all.
    --
    -- What that missed, reproduced by perturbation 2026-08-08: replace the
    -- strip with a sed that ERRORS (`sed -e 's/unterminated'`) and every
    -- stripped row reads 0, every row is therefore under budget, and the gate
    -- exits 0 saying "18 rows at or under budget". The no-op control below
    -- cannot catch it — a broken sed emits nothing, so `razed` is 0, and
    -- `kept > razed` is satisfied HARDER by the worse failure than by the
    -- lesser one. A confident zero is usually a broken gate (CLAUDE.md §3),
    -- and this gate had sixteen of them one shell error away.
    stripped: i64 = _hits("[a-zA-Z]", 0)
    if stripped == 0
        print("audit100: FAIL — control pattern matched 0 lines through the"
            .. " STRIPPED path while reading " .. to(str)(control)
            .. " unstripped; the strip pipeline is broken and every row that"
            .. " uses it would read a confident 0")
        return 3
    end

    -- Positive control for the string-body strip itself. A sed that silently
    -- matched nothing would leave every row's count unchanged and look like a
    -- clean result. `..` beside a quote is the one thing the strip must be
    -- able to delete, so kept and stripped MUST disagree here. If they agree,
    -- the strip is a no-op and every stripped count below is unearned.
    concat: str = "[" .. "\"" .. "][[:space:]]*\\.\\.|\\.\\.[[:space:]]*[" .. "\"" .. "]"
    kept: i64 = _hits(concat, 1)
    razed: i64 = _hits(concat, 0)
    if kept <= razed
        print("audit100: FAIL — string-body strip is a no-op: `..` beside a"
            .. " quote reads " .. to(str)(kept) .. " kept and " .. to(str)(razed)
            .. " stripped. Every stripped row below would be unearned.")
        return 3
    end

    q: str = "'"
    brace: str = "\\{"
    brace_close: str = "\\}"
    dq: str = "\""

    -- The deny rows, as parallel arrays; `budget` is hoisted to the top of
    -- main and must stay in this order.
    id = {
        "snake", "upper", "upperdecl", "underprefix", "companion", "accessor", "axis",
        "directive", "ctor", "stdlib", "import", "foreignkw", "arrow",
        "luafn", "mwrapper", "concatlit", "oneline", "trailret",
        "graveyard", "convert",
    }
    note = {
        "underscore inside an identifier",
        "uppercase identifier in bind/call/field position",
        "uppercase name in DECLARATION position (Point: @" .. "{" .. "…" .. "}" .. ")",
        "_ prefix on a name",
        "companion *_kind / *_type",
        "get_ / set_ / compute_",
        "axis name instead of a level",
        "prefix-@ directive",
        ".new( .create( make_ .init(",
        "string. / table. / std.string.",
        "require / req / local",
        "foreign declaration keyword",
        "-> => ?. ?: |>",
        "Lua library call",
        "M = " .. "{" .. "}" .. " module wrapper",
        ".. beside a string literal",
        "end on a one-line block",
        "trailing return <expr>",
        "compiler REFUSES these in .duo",
        "to(x)(y) — conversion written operation-first",
    }
    pat = {
        "[a-z]_[a-z]",
        "(^|[^A-Za-z0-9_])[A-Z][A-Za-z0-9_]*[[:space:]]*[=(.]",
        "^[[:space:]]*[A-Z][A-Za-z0-9_]*[[:space:]]*:",
        "(^|[^A-Za-z0-9_.])_[A-Za-z]",
        "_(kind|type)([^A-Za-z0-9_]|$)",
        "(get|set|compute)_[A-Za-z]",
        "(sort_by|take_while|drop_while|group_by|max_by|min_by|is_[a-z])",
        "@(comp|c)\\.",
        "\\.(new|create)\\(|make_[a-z]|\\.init\\(",
        "(^|[^A-Za-z0-9_.])(string|table)\\.|std\\.string",
        "(^|[^A-Za-z0-9_.])(require|req|local)([^A-Za-z0-9_]|$)",
        "(^|[^A-Za-z0-9_.])(function|fn|def|let|const|var|class|impl|trait|interface|enum|match|switch|try|catch)([^A-Za-z0-9_]|$)",
        "(->|=>|\\?\\.|\\?:|\\|>)",
        "(^|[^A-Za-z0-9_.])(pairs|ipairs|pcall|tostring|tonumber|setmetatable|getmetatable|gmatch|gsub)\\(|_G([^A-Za-z0-9_]|$)",
        "^[A-Za-z][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*" .. brace .. brace_close,
        "[" .. dq .. "][[:space:]]*\\.\\.|\\.\\.[[:space:]]*[" .. dq .. "]",
        "(^|[[:space:]])(if|for|while|elseif)[[:space:]].*[[:space:]]end[[:space:]]*$",
        "(^|[[:space:]])return[[:space:]]+[^[:space:]]",
        "(^|[^A-Za-z0-9_.])(try|catch|defer|goto|extends|private|await|async|macro|let)([^A-Za-z0-9_]|$)",
        "(^|[^A-Za-z0-9_.:])to\\([A-Za-z0-9]+\\)\\(",
    }
    -- REBASELINED 2026-08-08 (third time), same method as the last two: every
    -- point counted PER FILE at the commit where the gate was last exactly at
    -- budget (a34b10b) and again at HEAD. Seven rows went red; the canonical
    -- set grew 445 -> 447. All 440 points land in exactly THREE files, and all
    -- three are under `tools/wasm/`:
    --
    --   row          delta   opcodes.duo  ward.duo  derived.duo
    --   snake         +158        11        146          1
    --   upper         +167         3        164          0
    --   underprefix    +48        47          0          1
    --   axis            +2         0          2          0
    --   stdlib         +15        11          0          4
    --   concatlit      +32        30          1          1
    --   trailret       +18        15          1          2
    --
    -- Nothing here is repairable as text, which is why it is budgeted and not
    -- fixed:
    --
    --   `tools/wasm/src/ward.duo` carries 314 of the 440 points, and 310 of those
    --   (164 upper + 146 snake) are ONE generated block — the `OP_unreachable = 0`
    --   … `OP_i64_extend32_s = 196` constants that `tools/wasm/tools/opcodes.duo`
    --   projects into it (6497d44, which is what took ward from 241 hand-typed
    --   opcode predicates to 3). Editing those names by hand is undone by the
    --   next projection run. The repair is in the projector's `_const()`
    --   renderer, which is a naming decision across 184 sites inside another
    --   session's live work, not a mechanical rename. Same shape as GAP-041,
    --   where 46 flat `encode_add_reg` names are owed a level rather than 46
    --   other flat names.
    --
    --   `tools/wasm/tools/opcodes.duo` is the projector itself (new in 6497d44).
    --   Its 47 underprefix points are `_agree` `_selfcheck` `_const` `_num`
    --   `_isreserved` and friends — private helpers, and `_` is EXPORT CONTROL
    --   in this compiler (codegen.zig drops `_`-prefixed names from module
    --   exports), so stripping the prefix is a surface change, not a rename.
    --
    --   `tools/wasm/bench/derived.duo` drifted by 9 points total.
    --
    -- This session DID repair one thing in that file rather than budget it, but
    -- it was a different gate: its `getenv("DUO_ROOT", <an absolute path under
    -- one author's home directory>)` default was failing public_safety_scan
    -- (Pass 10 A19), and the replacement adds no deny
    -- line (two comments, one `if`, one assignment — verified: the counts below
    -- are byte-identical before and after that commit).
    --
    -- +2 MORE, landed while this was being written, and named rather than
    -- absorbed: `fd10b39` (RL-04, a face call in a statement-level argument was
    -- read as a declaration) added one `snake` point and one `underprefix`
    -- point, both in `lib/std/compiler/parser.duo` (snake 315 -> 316,
    -- underprefix 116 -> 117). Nothing else in that commit or its two siblings
    -- moved any row. A one-line regression is the only kind anyone ever
    -- introduces, so an unattributed +1 is indistinguishable from one — which
    -- is exactly why the ratchet caught these two and why they are written down
    -- instead of rounded into the table above.
    --
    -- LOWERING was checked and there is nothing to lower. Every row not listed
    -- above reads EXACTLY its budget — companion 259, accessor 322, directive
    -- 152, ctor 58, import 442, foreignkw 167, arrow 128, luafn 228, mwrapper
    -- 36, oneline 2224, nonduo 536. Zero slack anywhere, so the ratchet's other
    -- direction had no work to do this time. It is still half the protocol.
    --
    -- No number below was raised without a file behind it. That is the whole
    -- difference between a rebaseline and a laundering, and the check that
    -- enforces it is per-file attribution, not the census delta — a growing
    -- file count is not evidence about any particular row.
    --
    -- THE RATCHET. One budget per row, same order as `id`. Each number was
    -- measured on the canonical partition when the row landed. Lower a budget
    -- whenever you lower a count; raising one needs a sentence in the commit
    -- message saying why the ROW, not the code, was wrong.
    --
    -- Measured 2026-08-08 over 446 scanned canonical files, in a DETACHED
    -- WORKTREE at the pushed HEAD rather than in a working tree — three other
    -- sessions had uncommitted edits while this was measured, and a budget
    -- taken over those is phantom slack that nobody can reproduce from a clean
    -- clone. WITH string bodies stripped. EXACT counts, no headroom. A previous revision
    -- carried +2 per row to absorb concurrent sessions; the +2 was dropped
    -- because it disarms the ratchet by exactly the amount that matters. The
    -- test that showed it: lowering `snake` by one below its count must fail
    -- the gate, and it does (exit 1). Under +2 slack the same one-line
    -- regression passes, and a one-line regression is the only kind anyone
    -- ever introduces.
    --
    -- The gate reads the WORKING TREE on purpose — it should see your diff
    -- before you commit it. The cost is that these numbers are a measurement
    -- of a moving object: three rows drifted (snake +40, underprefix +2,
    -- trailret +1) between two runs minutes apart while another session was
    -- editing canonical files. So RE-MEASURE IMMEDIATELY BEFORE COMMITTING,
    -- and read a red row on a dirty tree as somebody's in-flight work rather
    -- than a fault. Whoever adds a deny line moves the budget in the same
    -- commit, and says why.
    --
    -- These are lower than the pre-strip baseline because the strip removed
    -- noise no edit could ever have cleared: on this same 441-file list,
    -- foreignkw 330 -> 164, directive 267 -> 151, arrow 177 -> 119. Those
    -- rows were asking for repairs that did not exist. concatlit is unchanged
    -- at 2155 by design — see `keeps` below.
    --
    -- Held as a string, not a table of integers, because a dense numeric table
