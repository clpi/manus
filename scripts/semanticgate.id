    cmd = "git grep -n 'dot: bool = (code: str, world: str)' scripts/idiomgate.id gates/host.id 2>/dev/null | wc -l | awk '{print $1}'"
    if ascount(cmd) < 2
        print("(semanticgate, control, gate, dot(code, world) enforcement removed from gates)")
        code = 3
    cmd = "git grep -n '@c\\.' scripts/ingress gates scripts/idiomgate.id 2>/dev/null | wc -l | awk '{print $1}'"
    if ascount(cmd) != 0
        print("(semanticgate, control, gate, @c foreign emit reintroduced in ingress/gates)")
        code = 3
    cmd = "git grep -n lua_ scripts/ingress gates scripts/idiomgate.id lib/process.id 2>/dev/null | wc -l | awk '{print $1}'"
    if ascount(cmd) != 0
        print("(semanticgate, control, gate, lua intermediary reintroduced in ingress/gates)")
        code = 3
    cmd = "git grep -n '@c\\.' scripts/semanticgate.id scripts/ingress gates lib/process.id 2>/dev/null | wc -l | awk '{print $1}'"
    if ascount(cmd) != 0
        print("(semanticgate, control, gate, @c foreign emit reintroduced)")
        code = 3
    cmd = "git grep -n popen scripts/semanticgate.id lib/process.id gates scripts/idiomgate.id 2>/dev/null | grep -v fix | grep -v Forbidden | wc -l | awk '{print $1}'"
    if ascount(cmd) != 0
        print("(semanticgate, control, gate, popen spelling reintroduced — use command:open)")
        code = 3
    # Every census pathset is compared with an independently expanded source
    # set. An empty or narrowed pathset with zero matches must withhold counts.
    cmd = "allfiles=$(git ls-files -- {all}); frontfiles=$(git ls-files -- {front}); afterfiles=$(git ls-files -- {after}); provenfiles=$(git ls-files -- {proven}); duos=$(git ls-files -- {duofiles}); expectedall=$(git ls-files -- {q}src/*.zig{q}); expectedfront=$(git ls-files -- src/ast.zig src/parser.zig src/macro_expand.zig); expectedafter=$(git ls-files -- {q}src/*.zig{q} {q}:(exclude)src/ast.zig{q} {q}:(exclude)src/parser.zig{q} {q}:(exclude)src/macro_expand.zig{q} {q}:(exclude)src/pretty.zig{q}); expectedproven=$(git ls-files -- src/ast.zig src/parser.zig src/pretty.zig); expectedduos=$(git ls-files -- {q}*.id{q} {q}:(exclude)scripts/semanticgate.id{q} {q}:(exclude)scripts/idiomgate.id{q}); if test -n \"$allfiles\" && test -n \"$duos\" && test \"$allfiles\" = \"$expectedall\" && test \"$frontfiles\" = \"$expectedfront\" && test \"$afterfiles\" = \"$expectedafter\" && test \"$provenfiles\" = \"$expectedproven\" && test \"$duos\" = \"$expectedduos\" && test -z \"$(git ls-files -- {q}src/no-such-*.zig{q})\" && printf {q}%s\\n{q} \"$allfiles\" | grep -qx src/ast.zig && printf {q}%s\\n{q} \"$allfiles\" | grep -qx src/duo_native_ir.zig && printf {q}%s\\n{q} \"$duos\" | grep -qx lib/compiler/application.id && git cat-file -e :src/ast.zig && git cat-file -e :src/parser.zig && git cat-file -e :src/pretty.zig && git cat-file -e :src/duo_native_ir.zig && git cat-file -e :src/semantic_graph.zig && git cat-file -e :scripts/semanticgate.id && git grep --cached -q -E {q}{parserpat}{q} -- {front} && git grep --cached -q -E {q}{astpat}{q} -- {after} && git grep --cached -q {q}boxpat = {q} -- scripts/semanticgate.id; then git grep --cached -q {q}boxpat = {q} -- {duofiles}; status=$?; if test $status = 1; then printf {q}%s\\n{q} {q}pub const IfExpr = struct {{{q} | grep -q -E {q}{parserpat}{q} && printf {q}%s\\n{q} {q}pub const relation = struct {{{q} | grep -q -v -E {q}{parserpat}{q} && printf {q}%s\\n{q} {q}{debt.boxed.positive}{q} | grep -q -E {q}{boxpat}{q} && printf {q}%s\\n{q} {q}{debt.boxed.negative}{q} | grep -q -v -E {q}{boxpat}{q} && printf 1; else printf 0; fi; else printf 0; fi"
    if ascount(cmd) != 1
        print("(semanticgate, control, source, staged pathspec parser classifier or exclusion failed)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}.if_stmt => |branch|{q} | grep -c -E {q}{dispatchpat}{q}"
    if ascount(cmd) != 1
        print("(semanticgate, control, dispatch, missed if face)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}.demand => |edge|{q} | grep -c -E {q}{dispatchpat}{q}"
    if ascount(cmd) != 0
        print("(semanticgate, control, dispatch, convicted demand)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}    directive,{q} | grep -c -E {q}{graphpat}{q}"
    if ascount(cmd) != 1
        print("(semanticgate, control, graph, missed directive kind)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}    relation,{q} | grep -c -E {q}{graphpat}{q}"
    if ascount(cmd) != 0
