-- run_alloc_churn_benchmark.duo — compare Duo dynamic table churn to native C arrays.
--
-- Duo replacement for scripts/run_alloc_churn_benchmark.sh (monoglot census).
--
-- examples/bench_alloc_churn_c.c stays C on purpose: it is the REFERENCE the
-- benchmark measures against. Converting the baseline to Duo would delete the
-- comparison, which is the whole point of the script.

_OUT_DIR = "/tmp/duo_alloc_churn_bench"
_EX = "examples"

-- Two decimals, built from integer hundredths. `to(str)` on an f64 does not
-- compile today -- it lowers to an undeclared `tostring` -- and printing the
-- float raw gives 1.2344999999999999. Integer math sidesteps both.
_fmt2(x: f64): str
    n = to(i64)(x * 100.0 + 0.5)
    whole = n / 100
    frac = n % 100
    if frac < 10
        return whole:to(str) .. ".0" .. frac:to(str)
    end
    whole:to(str) .. "." .. frac:to(str)
end

_sdk_flag(): str
    sdk = std.script.chomp(std.script.capture("xcrun --show-sdk-path 2>/dev/null"))
    if sdk == "" return "" end
    "-isysroot " .. sdk
end

main = (): i64
    print("=== Duo Alloc Churn Benchmark ===")
    print("")

    duo = "./zig-out/bin/duo"
    if not std.script.fs_exists(duo)
        print("ERROR: Duo compiler not found at " .. duo)
        print("  Run 'zig build' first")
        return 1
    end

    std.script.run("mkdir -p " .. _OUT_DIR)
    sysroot = _sdk_flag()

    print("[1/3] Compiling C reference...")
    cbin = _OUT_DIR .. "/bench_alloc_c"
    if std.script.run("clang -O3 -flto -march=native " .. sysroot .. " "
        .. _EX .. "/bench_alloc_churn_c.c -o " .. cbin) != 0
        print("ERROR: C reference failed to compile")
        return 1
    end
    print("      -> " .. cbin)

    print("[2/3] Compiling bench_alloc_churn.duo...")
    dbin = _OUT_DIR .. "/bench_alloc_churn_duo"
    if std.script.run(duo .. " compile " .. _EX .. "/bench_alloc_churn.duo -o " .. dbin .. " -O3") != 0
        print("ERROR: Duo benchmark failed to compile")
        return 1
    end
    print("      -> " .. dbin)

    print("")
    print("[3/3] Running benchmark...")
    print("-----------------------------------------------")

    print("Running Duo...")
    duo_out = std.script.chomp(std.script.capture(dbin .. " | tail -n 1"))
    print("Duo Time: " .. duo_out .. " s")

    print("Running C...")
    c_out = std.script.chomp(std.script.capture(cbin .. " | tail -n 1"))
    print("C Time:   " .. c_out .. " s")

    -- A zero or unparseable C time would make the ratio meaningless (or a
    -- divide by zero); the shell version handed both straight to awk and
    -- printed "inf" or "nan" as if it were a measurement.
    ct = to(f64)(c_out)
    dt = to(f64)(duo_out)
    if ct == nil or dt == nil or ct == 0.0
        print("Ratio (Duo/C): unavailable — could not read both times")
        print("-----------------------------------------------")
        return 1
    end

    print("Ratio (Duo/C): " .. _fmt2(dt / ct) .. "x")
    print("-----------------------------------------------")
    print("")
    print("Done.")
    0
end
