# duo_idiom_gate — compatibility entry for the build step.
#
# The law lives in scripts/idiomgate.id and scans added lines from a unified
# diff on stdin. Keep this file small so pre-commit and zig build use the same scanner.

script = std.script

main: i64 = ()
    root = script.chomp(script.capture("git rev-parse --show-toplevel 2>/dev/null"))
    if root == ""
        print("duo_idiom_gate: fail no git root")
        return 3

    bytes = script.chomp(script.capture("cd '{root}' && git diff -U0 --diff-filter=ACM -- '*.id' | wc -c"))
    if bytes == "" or bytes == "0"
        print("duo_idiom_gate: PASS no added duo diff")
        return 0

    rc = script.run("cd '{root}' && git diff -U0 --diff-filter=ACM -- '*.id' | ./zig-out/bin/idol run scripts/idiomgate.id")
    if rc != 0
        return rc
    print("duo_idiom_gate: PASS")
    0
