-- duo_idiom_gate — compatibility entry for the build step.
--
-- The law lives in scripts/idiomgate.id and scans added lines from a unified
-- diff. Keep this file small so pre-commit and zig build use the same scanner.

script = std.script

main(): i64
    root = script.chomp(script.capture("git rev-parse --show-toplevel 2>/dev/null"))
    if root == ""
        print("duo_idiom_gate: fail no git root")
        std.os.exit(3)

    tmp = script.chomp(script.capture("mktemp -t duoidiomgate"))
    if tmp == ""
        print("duo_idiom_gate: fail no temp file")
        std.os.exit(3)

    script.run("cd '{root}' && git diff -U0 --diff-filter=ACM -- '*.id' > '{tmp}'")
    bytes = script.chomp(script.capture("wc -c < '{tmp}'"))
    if bytes == "" or bytes == "0"
        script.run("rm -f '{tmp}'")
        print("duo_idiom_gate: PASS no added duo diff")
        std.os.exit(0)

    rc = script.run("cd '{root}' && DUOGATEDIFF='{tmp}' ./zig-out/bin/duo run scripts/idiomgate.id")
    script.run("rm -f '{tmp}'")
    if rc != 0
        std.os.exit(rc)
    print("duo_idiom_gate: PASS")
    0
