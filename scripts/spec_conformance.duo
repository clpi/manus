-- Pass 64 Part VIII — G1/G2: does the compiler implement the spec it is given?
--
-- Why this exists. Passes 57, 59, 60, 61 and 64 each pin canonical forms, and
-- in three of them the canonical form was NOT implemented — `"{x}"` printed the
-- literal text `{x}`, `t:push(v)` compiled clean and dropped the element,
-- `f = (x: t): r ... end` did not parse at all. An agent following the spec
-- literally wrote WORSE code than the vestige the spec told it to delete, and
-- nothing failed to warn it, because these are wrong-output bugs and not
-- errors.
--
-- So conformance is measured, not assumed. Every row below is a Pass 64 surface
-- form reduced to the smallest program that exercises it. A row is IMPLEMENTED
-- only if the program compiles AND prints the expected value: "compiles" is not
-- evidence, since the whole failure class here compiles.
--
-- This is a RATCHET, not a pass/fail of the spec. The spec is the target and is
-- allowed to run ahead of the compiler. What is not allowed is the number going
-- DOWN — a form that once worked and stopped is a regression, and a form that
-- starts working should be recorded so the interim advice in CLAUDE.md can be
-- narrowed (see GAP-11, which spent time telling agents to avoid a form that
-- had been fixed).

-- Pinned floor: the MEASURED count, never an estimate. I first wrote 13 here
-- from memory of what I had probed by hand and the gate immediately reported a
-- regression that had not happened -- the real number is 10. A floor guessed
-- upward makes the gate cry wolf; guessed downward it goes quiet. Run the gate,
-- read the number, pin the number.
--
-- Raise this when rows go green; never lower it to make the gate quiet.
-- Verified 2026-08-07: 15/29 -- three of the gain are FF-1 rows that were
-- never broken, only mis-probed. See the FF-1 note in main().
baseline(): i64
    15
end

-- An open brace, built rather than written. Interpolation has NO ESCAPE: there
-- is no way to spell a literal `{name}` in a Duo string, so a file like this
-- one -- whose data is Duo source containing interpolation holes -- would have
-- its own corpus rewritten by the compiler. That is not hypothetical: the first
-- run of this gate failed with "use of undeclared identifier 'x'" because the
-- STR-1 row's test PROGRAM was interpolated as if it were this program's
-- source. Filed as GAP-16.
--
-- The same class of mistake once rewrote `~=` inside a lexer's own corpus data.
-- A brace sequence inside a string a program is meant to EMIT is not an
-- interpolation hole, and nothing in the language currently lets you say so.
lb(): str
    "{"
end

fails = 0
implemented = 0
checked = 0
report = ""

-- One row: id, the smallest program exercising the form, and what it must
-- print. Threaded through a return value rather than a module-level flag,
-- because a function assigning to a file-scope variable is not reliably visible
-- to other functions.
probe(id: str, src: str, want: str): bool
    path = "/tmp/duo_specconf.duo"
    std.script.fs_write(path, src)
    got = std.script.capture(std.script.duo_bin() .. " run " .. path .. " 2>/dev/null")
    trimmed = std.script.chomp(got)
    if trimmed == want
        return true
    end
    return false
end

record(id: str, src: str, want: str): void
    checked = checked + 1
    if probe(id, src, want)
        implemented = implemented + 1
        report = report .. "  ok      " .. id .. "\n"
    else
        report = report .. "  MISSING " .. id .. "\n"
    end
end

main(): i64
    -- PART II 2.2 — functions, control
    -- FF-1 was recorded MISSING for most of this session on a bad probe. It
    -- tested `f = (x: i64): i64 x * 2 end` -- the ONE-LINE form carrying an
    -- `end`, which Prime 2 forbids anyway ("no end on one line"). The forms the
    -- spec actually endorses both work, and I wrote bare declarations for a
    -- long time on the strength of that wrong row.
    record("FF-1 value fn multiline", "f = (x: i64): i64\n    x * 2\nend\nmain = (): void\n    print(f(21))\nend\n", "42")
    record("FF-1 value fn one-line", "f = (x: i64) x * 2\nmain = (): void\n    print(f(21))\nend\n", "42")
    record("FF-1 value fn no params", "run = (): i32\n    42\nend\nmain = (): void\n    print(run())\nend\n", "42")
    -- The variant that does NOT parse, pinned so the distinction is not lost
    -- again: a one-line value-form body may not carry `end`.
    record("FF-1 one-line+end absent", "f = (x: i64): i64 x * 2 end\nmain(): void\n    print(f(21))\nend\n", "ABSENT")
    record("FF-5 binding cond", "g(): i64\n    7\nend\nmain(): void\n    if v = g()\n        print(v)\n    end\nend\n", "7")
    record("FF-6 demand return", "f(): i64\n    41 + 1\nend\nmain(): void\n    print(f())\nend\n", "42")
    record("FF-11 range", "main(): void\n    t = 0\n    for i in range(0, 3)\n        t = t + i\n    end\n    print(t)\nend\n", "3")

    -- PART II 2.3 — data
    record("FF-13 t{...} shape", "point: { x: i64, y: i64 }\nmain(): void\n    p = point{ x = 1, y = 2 }\n    print(p.x)\nend\n", "1")
    record("FF-17 T | nil", "f(x: i64): i64 | nil\n    x\nend\nmain(): void\n    print(f(5))\nend\n", "5")

    -- PART II 2.5 / STR — strings
    record("STR-1 name hole", "main(): void\n    x = 3\n    print(\"" .. lb() .. "x}\")\nend\n", "3")
    record("STR-1 field hole", "main(): void\n    p = { x = 4 }\n    print(\"" .. lb() .. "p.x}\")\nend\n", "4")
    record("STR-1 expr hole", "main(): void\n    i = 1\n    print(\"" .. lb() .. "i + 1}\")\nend\n", "2")

    -- PART II 2.1 / Pass 38 — access and relations
    record("G6 value.@name", "e(a: any, b: any): bool\n    true\nend\nmain(): void\n    p = {}\n    setmetatable(p, { __eq = e })\n    print(p.@eq != nil)\nend\n", "true")
    record("FF-14 strata curry", "main(): void\n    print(to(str)(42))\nend\n", "42")
    record("FF-12 subject-first", "main(): void\n    print((42):to(str))\nend\n", "42")
    record("primitive as value", "main(): void\n    t = str\n    print(t)\nend\n", "str")

    -- PART IV LV — vestige replacements. These are the rows that fail SILENTLY,
    -- which is why each asserts a VALUE and not merely that it compiled.
    record("LV-4 t:push", "main(): void\n    a = {}\n    a:push(5)\n    print(#a)\nend\n", "1")
    record("LV-5 t:pop", "main(): void\n    a = {1, 2}\n    print(a:pop())\nend\n", "2")
    record("LV-6 t:join", "main(): void\n    c = {\"x\", \"y\"}\n    print(c:join(\", \"))\nend\n", "x, y")
    record("LV-8 for v in t", "main(): void\n    t = {10, 20}\n    s = 0\n    for v in t\n        s = s + v\n    end\n    print(s)\nend\n", "30")
    record("LV-13 #s", "main(): void\n    print(#\"hello\")\nend\n", "5")

    -- Pass 48 §2.1/§2.6 + Pass 67 §2 (S14): apply / retrieve / anchor are ruled
    -- TOTAL and DISJOINT. Only APPLY exists. The collision S14 resolves —
    -- `to(str)(Point)` reading as retrieval vs application — cannot occur
    -- today, because the bracket retrieval form it is disambiguated against
    -- does not parse to anything.
    --
    -- Note Pass 48 §2.6's own example lines (`edge = to[str][Point]`,
    -- `render = Point@to(str)`) are among the rows that do not compile.
    record("S14 apply to(T)(v)", "main(): void\n    print(to(str)(42))\nend\n", "42")
    record("S14 retrieve to[T]", "main(): void\n    print(to[str] != nil)\nend\n", "true")
    record("S14 retrieve to[T][X]", "main(): void\n    print(to[str][i64] != nil)\nend\n", "true")

    -- THE CANONICAL ANCHOR is POSTFIX `X@rel` (Pass 48 §2.1). This is the form
    -- that should exist, and does not.
    record("P48 anchor X@to(T)", "main(): void\n    print(i64@to(str) != nil)\nend\n", "true")

    -- `value.@name` is IN PASS 48'S GRAVEYARD (Part VI), alongside `point:@to`
    -- and `Point.@to`. It is implemented anyway — I added it in 7af9a66 working
    -- from the Pass 38 catalog, which Pass 48 supersedes. This row therefore
    -- asserts the form is ABSENT, and it FAILS on purpose until the parser
    -- change is reverted or the graveyard ruling is revisited. A conformance
    -- suite that only tests what should exist cannot catch a form that should
    -- not.
    record("GRAVEYARD .@name absent", "e(a: any, b: any): bool\n    true\nend\nmain(): void\n    p = {}\n    setmetatable(p, { __eq = e })\n    print(p.@eq == nil)\nend\n", "ABSENT")

    -- Pass 67 §4 — face rows that DO work, pinned so they cannot regress.
    record("face brace call f{}", "srv(o: any): i64\n    o.port\nend\nmain(): void\n    print(srv{ port = 8080 })\nend\n", "8080")

    -- PIPE-1 — the pinned pipeline surface
    record("PIPE map", "main(): void\n    vs = {1, 2}\n    print(#vs:map(.x))\nend\n", "2")
    record("PIPE filter", "main(): void\n    vs = {1, 2}\n    print(#vs:filter(.x))\nend\n", "2")

    io.write(report)
    print("spec_conformance: " .. to(str)(implemented) .. "/" .. to(str)(checked)
        .. " implemented (floor " .. to(str)(baseline()) .. ")")

    if implemented < baseline()
        print("spec_conformance: FAIL — a form that used to work has regressed")
        return 1
    end
    if implemented > baseline()
        print("spec_conformance: forms gained since the floor was set — RAISE baseline() to "
            .. to(str)(implemented) .. " and narrow the interim advice in CLAUDE.md")
    end
    print("spec_conformance: PASS")
    0
end
