
_TMP = "/tmp/duo_wasm_exec_test"

_pass = 0
_fail = 0
_skip = 0

_ok = (m: str)
  print("  PASS: " .. m)
  _pass = _pass + 1

_bad = (m: str)
  print("  FAIL: " .. m)
  _fail = _fail + 1

_skipped = (m: str, why: str)
  print("  SKIP: " .. m .. " (" .. why .. ")")
  _skip = _skip + 1

_have: bool = (t: str)
  script.chomp(script.capture("command -v " .. t .. " 2>/dev/null")) != ""

_env_or: str = (n: str, d: str)
  v = script.getenv_or(n)
  if v == ""
    return d
  v

_stem: str = (p: str)
  script.chomp(script.capture("basename " .. p .. " | sed 's/\\.[^.]*$//'"))

_compile: str = (duo: str, src: str)
  w = _TMP .. "/" .. _stem(src) .. ".wasm"
  if script.run(duo .. " compile " .. src .. " --target wasm32-wasi -o " .. w .. " 2>" .. _TMP .. "/err") != 0
    return ""
  if not script.fs_exists(w)
    return ""
  w

_contains: bool = (hay: str, needle: str)
  hay:find(needle, 1, true) != nil

_assert_output = (duo: str, wasmtime: str, label: str, src: str, expected: str)
  if not _have(wasmtime)
    _skipped(label, "wasmtime not found")
    return
  w = _compile(duo, src)
  if w == ""
    head = std.script.chomp(std.script.capture("head -3 " .. _TMP .. "/err 2>/dev/null"))
    _bad(label .. " — compile failed: " .. head)
    return
  actual = std.script.chomp(std.script.capture(wasmtime .. " run " .. w .. " 2>/dev/null"))
  if actual == expected
    _ok(label)
  else
    _bad(label .. " — output mismatch")
    print("      expected: " .. expected:gsub("\n", "\\n"))
    print("      got:      " .. actual:gsub("\n", "\\n"))

_assert_structure = (duo: str, wasmtime: str, objdump: str, label: str, src: str)
  if not _have(wasmtime)
    _skipped(label .. " (structure: compile)", "wasmtime not found")
    return
  w = _compile(duo, src)
  if w == ""
    _bad(label .. " (structure) — compile failed")
    return

  if _have("wasm-validate")
    if std.script.run("wasm-validate " .. w .. " 2>/dev/null") == 0
      _ok(label .. " — wasm-validate: well-formed module")
    else
      _bad(label .. " — wasm-validate: malformed module")

  if not _have(objdump)
    _skipped(label .. " (structure checks)", "wasm-objdump not found")
    return

  d = std.script.capture(objdump .. " -x " .. w .. " 2>/dev/null")
  if _contains(d, "memory")
    _ok(label .. " — exports memory")
  else
    _bad(label .. " — missing memory export")
  if _contains(d, "_start")
    _ok(label .. " — exports _start")
  else
    _bad(label .. " — missing _start export")
  if _contains(d, "wasi_snapshot_preview1")
    _ok(label .. " — imports wasi_snapshot_preview1")
  else
    _bad(label .. " — missing wasi_snapshot_preview1 imports")
  if _contains(d, "__wasi_unstable")
    _bad(label .. " — unexpected __wasi_unstable import")
  else
    _ok(label .. " — no deprecated __wasi_unstable ABI")

main: i64 = ()
  duo = _env_or("DUO", "./zig-out/bin/idol")
  wasmtime = _env_or("WASMTIME", "wasmtime")
  objdump = _env_or("WASM_OBJDUMP", "wasm-objdump")

  std.script.run("rm -rf " .. _TMP .. " && mkdir -p " .. _TMP)

  print("=== WASI Execution Tests ===")

  cases = {
    {
      "examples/wasm/hello.lua",
      "hello.lua: print two lines",
      "hello wasm\nfrom duo!",
      true
    },
    {
      "examples/wasm/arithmetic.lua",
      "arithmetic.lua: basic ops",
      "3\n12\n3\n5\n256\n2",
      false
    },
    {
      "examples/wasm/strings.lua",
      "strings.lua: string ops",
      "hello\n5\nhello world\nHELLO\nhel\nababab",
      false
    },
    {
      "examples/wasm/tables.lua",
      "tables.lua: ipairs + numeric for",
      "10\n20\n30\n15",
      true
    },
    {
      "examples/wasm/fib.lua",
      "fib.lua: fib(10)=55 then fib(0..5)",
      "55\n0\n1\n1\n2\n3\n5",
      true
    },
    {
      "examples/wasm/typed_fib.id",
      "typed_fib.id: fib(10)=55 fib(15)=610",
      "55\n610",
      true
    },
    {
      "examples/wasm/math_funcs.lua",
      "math_funcs.lua: math stdlib",
      "42\n5\n2\n3\n4\n4\ninteger\nfloat",
      false
    },
    {
      "examples/hello.lua",
      "examples/hello.lua: greet output",
      "Hello from duo!\nHello, world!",
      true
    }
  }

  for _i, c in cases
    print("")
    print("--- " .. c(2) .. " ---")
    if not std.script.fs_exists(c(1))
      _bad(c(2) .. " — missing source " .. c(1))
    else
      _assert_output(duo, wasmtime, c(2), c(1), c(3))
      if c(4)
        _assert_structure(duo, wasmtime, objdump, _stem(c(1)), c(1))

  print("")
  print("--- wasm-validate sweep over examples/wasm/ ---")
  if not (_have("wasm-validate") and _have(wasmtime))
    _skipped("wasm-validate sweep", "wasm-validate or wasmtime not available")
  else
    listing = std.script.capture("ls examples/wasm/*.lua examples/wasm/*.id 2>/dev/null")
    for _i, line in listing:split("\n")
      src = std.script.chomp(line)
      if src != ""
        base = std.script.chomp(std.script.capture("basename " .. src))
        w = _compile(duo, src)
        if w == ""
          _bad("compile: " .. base)
        else
          if std.script.run("wasm-validate " .. w .. " 2>/dev/null") == 0
            _ok("wasm-validate: " .. base)
          else
            _bad("wasm-validate: " .. base .. " — invalid module")

  print("")
  print("=== Results: " .. _pass:to(str) .. " passed, " .. _fail:to(str) .. " failed, " .. _skip:to(str) .. " skipped ===")
  if _fail > 0
    os.exit(1)
  0
