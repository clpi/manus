
targets: any = ()
  {
    { name = "native", backend = "direct" },
    { name = "c", backend = "c" }
  }

corpus_glob: str = ()
  "examples/native_differential/*.id"

run_timeout: str = ()
  "10"

fingerprint: i64 = (s: str)
  h = 2166136261
  n = s:len()
  for i = 1, n
    h = (h * 31 + s:byte(i)) % 1000000007
  h

probe: i64 = (src: str, backend: str, bin: str, out_file: str)
  build = std.script.id_bin() .. " compile " .. src .. " --backend=" .. backend .. " --emit exe -o " .. bin
  if std.script.status(build) != 0
    return -1
  rc = std.script.status("timeout " .. run_timeout() .. " " .. bin .. " > " .. out_file .. " 2>/dev/null")
  rc * 4294967296 + fingerprint(std.script.fs_read(out_file))

describe: str = (cell: i64)
  if cell == -1
    return "COMPILE-FAIL"
  status = cell / 4294967296
  fp = cell % 4294967296
  if status == 124
    return "HUNG"
  "exit=" .. status:to(str) .. " fp=" .. fp:to(str)

main: i64 = ()
  work = std.script.fs_tmpdir()
  files = std.script.fs_glob(corpus_glob())
  cols = targets()

  entries = 0
  diverged = 0

  for fi, src in files
    stem = std.script.path_stem(src)
    entries = entries + 1

    ref = 0
    ref_name = ""
    bad = ""

    for ti, t in cols
      bin = work .. "/" .. stem .. "." .. t.name
      out_file = bin .. ".out"
      cell = probe(src, t.backend, bin, out_file)

      if cell == -1
        bad = bad .. "    " .. t.name .. ": COMPILE-FAIL\n"
      else
        if ref_name == ""
          ref = cell
          ref_name = t.name
        else
          if cell != ref
            bad = bad .. "    " .. t.name .. ": " .. describe(cell) .. "  vs  " .. ref_name .. ": " .. describe(ref) .. "\n"

    if bad != ""
      diverged = diverged + 1
      print("semantic_harness: DIVERGE " .. stem)
      stdout:write(bad)

  ncols = 0
  for ti, t in cols
    ncols = ncols + 1

  print("semantic_harness: " .. entries:to(str) .. " entries x " .. ncols:to(str) .. " targets, " .. diverged:to(str) .. " diverged")

  if entries == 0
    print("semantic_harness: FAIL (empty corpus)")
    return 1
  if diverged != 0
    print("semantic_harness: FAIL")
    return 1
  print("semantic_harness: PASS")
  0
