# treesitter emit — the grammar projection, as far as it honestly goes today.
#
# The host requires tree-sitter to be "a generated grammar
# projection (output, never authored)". gaps/GAP-049 records why it was not:
# three pieces were missing — a declarative production source, an emitter, and
# a differential. The first landed as docs/spec/grammar.md. THIS FILE
# is the second. `zig build tree-sitter-coverage` is the third.
#
# WHAT THIS EMITS, and what it does not. The output file
# ext/tree-sitter-duo/grammar.js is split by two markers into GENERATED parts
# and an AUTHORED residue. Everything outside the markers is emitted from the
# registries below; everything between them is carried through byte for byte
# and COUNTED. The count is the number gaps/GAP-049 is measured by, and
# printing it is the only honest way to say "partially generated".
#
# The residue is not a formatting convenience. docs/spec/grammar.md §3 states
# the structural productions as EBNF, but for the PASS-100 surface, and the
# tracked corpus is still overwhelmingly pre-Pass-100 — `match`, `enum`,
# `concept`, `local`, `fun`. Projecting §3 over the residue would drop editor
# recognition from 755 of 775 files to almost none. That is a language
# decision (GAP-049's "second reason"), not a build-system one, so this
# emitter refuses to make it and says why instead.
#
# WHAT IS GENUINELY DERIVED rather than transliterated:
#
#   long string levels 0..2   one rule per level from ONE template, with the
#                             body alternation that excludes the closer
#                             COMPUTED from the level. It used to be three
#                             hand-written lines whose alternations had to be
#                             got right by eye.
#   quoted string tokens      one template, two quote characters.
#   binary and unary operators  one table of spelling, level and
#                             associativity — which is what a precedence
#                             table IS — checked against grammar.md §2.
#
# THE CHECK FOUND A REAL DEFECT THE DAY IT WAS WRITTEN, which is the argument
# for the whole approach. The authored table numbered `or` 11 and `^` 4, and
# in tree-sitter a HIGHER number binds TIGHTER, so the entire binary
# precedence table was inverted end to end. Verified by value before it was
# believed: `x = 2 + 3 * 4` parsed as `(2 + 3) * 4` and `a or b and c` as
# `(a or b) and c`. The recognition gate could not see it — no ERROR node is
# produced by a wrong tree — and no reader was going to diff twenty-five
# `prec.left` lines against Lua by eye. A table that is DATA gets compared;
# a table that is code gets read past.
#
# WHAT IS CHECKED AGAINST THE SPEC BUT NOT PROJECTED FROM IT: the operator
# table is compared, adjacent pair by adjacent pair, against §2, and every
# divergence is PRINTED. The emitted bytes deliberately do NOT depend on
# grammar.md: docs/spec is edited by other sessions, and a byte-identity gate
# that an unrelated documentation commit can redden is a gate people learn to
# skip. The report is the link; making it load-bearing needs §3 first.
#
# THE OFFSIDE LAYER IS NOT EMITTED AND CANNOT BE. grammar.md §1 defines
# NEWLINE / INDENT / DEDENT. tree-sitter has no offside layer; it needs an
# EXTERNAL SCANNER, which is a C file, and `ls ext/tree-sitter-duo/src` has
# none. That is why examples/layout/offside.id parses as one ERROR node from
# [0,0] to end of file. Emitting an `externals` block without the scanner
# would make the generated parser fail to LINK, which is worse than the hole.
#
# WHY THE REGISTRIES ARE SPACE-SEPARATED STRINGS and !tables: a table does
# not survive a function boundary in this compilation path. Measured — a
# table pushed to inside a callee reads `#t == 0` in the caller, and so does
# one returned from a callee. scripts/audit100.id carries its budgets the
# same way for the same reason. Positive-controlled below: the row-length
# check refuses to run if the parallel rows are not all the same length.
#
# Env:
#   TSEMIT_OUT     where to write (default the tracked grammar.js)
#   TSEMIT_CHECK   set to 1 to compare instead of writing — the gate mode
#   TSEMIT_RESIDUE bootstrap only: take the residue from this file when the
#                  output has no markers yet
#
# Exit 0 emitted or identical · 1 the check found a difference · 3 the emitter
# could not run (no output, no residue, no spec — a confident success is
# usually a broken gate, so every path here is positive-controlled).

grammarpath = "ext/tree-sitter-duo/grammar.js"
specpath = "docs/spec/grammar.md"
markbegin = "@@residue:begin"
markend = "@@residue:end"

slurp: str = (path: str)
    f = io.open(path, "r")
    body: str = ""
    if f
        body = f:read("a")
        f:close()
    body

spill: bool = (path: str, body: str)
    f = io.open(path, "w")
    done: bool = false
    if f
        f:write(body)
        f:close()
        done = true
    done

# `n` copies of `s`. The long-string delimiters need exactly this: the number
# of `=` signs IS the level.
tile: str = (s: str, n: i64)
    acc: str = ""
    i: i64 = 0
    while i < n
        acc = "{acc}{s}"
        i += 1
    acc

lines: i64 = (s: str)
    parts = s:split("\n")
    n: i64 = parts:len()
    if n > 0
        last: str = parts[n]
        if last == ""
            n -= 1
    n

# ── The head registry ────────────────────────────────────────────────────────

# The banner. `count` is the residue line count — the one number in this file
# that is measured rather than declared.
banner: str = (count: i64)
    n: str = count:to(str)
    b: str = "/**\n"
    b = "{b} * @file tree-sitter grammar for Duo — GENERATED.\n"
    b = "{b} *\n"
    b = "{b} * GENERATED by scripts/treesitter_emit.id — do not edit the generated\n"
    b = "{b} * regions by hand. Regenerate with:\n"
    b = "{b} *\n"
    b = "{b} *     idol run scripts/treesitter_emit.id\n"
    b = "{b} *\n"
    b = "{b} * `zig build treesitter-projection` regenerates and FAILS unless the result is\n"
    b = "{b} * byte-identical to the tracked file, so a hand edit to a generated region\n"
    b = "{b} * cannot survive review. A generated file nobody regenerates is an authored\n"
    b = "{b} * file with extra steps.\n"
    b = "{b} *\n"
    b = "{b} * ── THE BOUNDARY, stated rather than banner-washed ──────────────────────────\n"
    b = "{b} *\n"
    b = "{b} * Everything in this file is emitted from registries in the generator.\n"
    b = "{b} * The carried authored residue is currently\n"
    b = "{b} *\n"
    b = "{b} *     {n} lines\n"
    b = "{b} *\n"
    b = "{b} * and that number is what gaps/GAP-049 is measured by.\n"
    b = "{b} *\n"
    b = "{b} * GENERATED, and from what:\n"
    b = "{b} *   name / extras / supertypes    the head registry\n"
    b = "{b} *   conflicts                     the conflict registry\n"
    b = "{b} *   module / statement shell      the rule head registry\n"
    b = "{b} *   attributes                    the attribute rule registry\n"
    b = "{b} *   declarations / assignments    the declaration rule registry\n"
    b = "{b} *   control flow                  the control rule registry\n"
    b = "{b} *   function forms                the function rule registry\n"
    b = "{b} *   tail statements               the tail statement registry\n"
    b = "{b} *   match and pattern forms       the pattern registry\n"
    b = "{b} *   definitions                   the definition registry\n"
    b = "{b} *   types                         the type registry\n"
    b = "{b} *   expression head               the expression registry\n"
    b = "{b} *   expression tail               the expression registry\n"
    b = "{b} *   literal tokens                the token registry\n"
    b = "{b} *   long_string levels 0..2       ONE template per level; the body\n"
    b = "{b} *                                 alternation that excludes the closing\n"
    b = "{b} *                                 delimiter is computed from the level\n"
    b = "{b} *   double / single quoted string ONE template, two quote characters\n"
    b = "{b} *   binary_expression             one table of spelling, level and\n"
    b = "{b} *   unary_expression              associativity, compared pair by pair\n"
    b = "{b} *                                 against docs/spec/grammar.md §2 with every\n"
    b = "{b} *                                 divergence PRINTED. That comparison is how\n"
    b = "{b} *                                 the inverted precedence table was found.\n"
    b = "{b} *   comment / helpers             the tail registry\n"
    b = "{b} *\n"
    b = "{b} * NOT GENERATED FROM DOC EBNF, and why:\n"
    b = "{b} *   structural productions         docs/spec/grammar.md §3 states them as EBNF\n"
    b = "{b} *                                  for the PASS-100 surface. The tracked corpus\n"
    b = "{b} *                                  is still mostly pre-Pass-100, so the registry\n"
    b = "{b} *                                  intentionally preserves editor recognition.\n"
    b = "{b} *   NEWLINE / INDENT / DEDENT      tree-sitter has no offside layer. It needs\n"
    b = "{b} *                                 an external scanner, which is a C file, and\n"
    b = "{b} *                                 this tree has none — see\n"
    b = "{b} *                                 ext/tree-sitter-duo/src. That hole is why\n"
    b = "{b} *                                 examples/layout/offside.id is a single\n"
    b = "{b} *                                 ERROR node from [0,0] to end of file.\n"
    b = "{b} *\n"
    b = "{b} * Classified as generated by scripts/jsledger.id only when\n"
    b = "{b} * TSEMIT_CHECK=1 regeneration is byte-identical to the tracked file.\n"
    b = "{b} */\n"
    b

head: str = (count: i64)
    b: str = banner(count)
    b = "{b}\n"
    b = "{b}module.exports = grammar({\n"
    b = "{b}  name: 'duo',\n"
    b = "{b}\n"
    b = "{b}  extras: $ => [\n"
    b = "{b}    /\\s/,\n"
    b = "{b}    $.comment,\n"
    b = "{b}  ],\n"
    b = "{b}\n"
    b = "{b}  supertypes: $ => [\n"
    b = "{b}    $.statement,\n"
    b = "{b}    $.expression,\n"
    b = "{b}    $.type,\n"
    b = "{b}    $.pattern,\n"
    b = "{b}  ],\n"
    b = "{b}\n"
    b

conflictrows: str = ()
    "struct_definition expression\n" ..
    "typed_binding call_expression\n" ..
    "assignment call_expression\n" ..
    "compound_assignment call_expression\n" ..
    "local_declaration call_expression\n" ..
    "const_declaration call_expression\n" ..
    "global_declaration call_expression\n" ..
    "return_statement call_expression\n" ..
    "repeat_loop call_expression\n" ..
    "expression_statement call_expression\n" ..
    "expression call_expression\n" ..
    "match_arm expression_statement call_expression\n" ..
    "table_entry call_expression\n" ..
    "table_entry index_expression\n" ..
    "table_entry expression\n" ..
    "spread_entry call_expression\n" ..
    "spread_entry index_expression\n" ..
    "call_expression parenthesized_expression\n" ..
    "attribute anchor_expression\n" ..
    "descriptor_constructor anchor_expression\n" ..
    "_attribute_list expression\n" ..
    "function_name expression\n" ..
    "function_name function_expression\n" ..
    "function_name jai_type_definition type_alias_definition typed_binding expression\n" ..
    "function_name catch_clause expression\n" ..
    "function_name applied_type named_type\n" ..
    "jai_type_definition type\n" ..
    "applied_type named_type\n" ..
    "named_type generic_type\n" ..
    "type_attribute\n" ..
    "attributed_type pointer_type\n" ..
    "attributed_type optional_type\n" ..
    "attributed_type array_type\n" ..
    "attributed_type function_type\n" ..
    "pack_type pointer_type\n" ..
    "pack_type optional_type\n" ..
    "pack_type array_type\n" ..
    "pack_type function_type\n" ..
    "bare_function_declaration foreign_declaration\n" ..
    "bare_function_declaration builtinname\n" ..
    "type_alias_definition builtinname\n" ..
    "directive_function _annotated_signature\n" ..
    "vararg_parameter vararg\n" ..
    "parameter _plain_parameter\n" ..
    "parameter _plain_parameter expression\n" ..
    "expression_statement lambda_expression\n" ..
    "expression_statement if_expression\n" ..
    "expression_statement lambda_expression call_expression\n" ..
    "function_value_expression call_expression\n" ..
    "function_value_expression lambda_expression call_expression\n" ..
    "assignment lambda_expression\n" ..
    "assignment expression_statement lambda_expression\n" ..
    "assignment expression_statement call_expression\n" ..
    "binding_condition call_expression\n" ..
    "compound_assignment lambda_expression\n" ..
    "lambda_expression call_expression\n" ..
    "lambda_expression method_call_expression\n" ..
    "lambda_expression index_expression\n" ..
    "lambda_expression try_expression\n" ..
    "lambda_expression unwrap_expression\n" ..
    "_annotated_signature lambda_expression\n" ..
    "_annotated_signature lambda_expression call_expression\n" ..
    "parameter _typed_parameter\n" ..
    "parameter _typed_parameter expression\n" ..
    "do_block while_loop\n" ..
    "do_block numeric_for\n" ..
    "do_block generic_for\n" ..
    "statement try_statement\n" ..
    "catch_clause\n" ..
    "catch_clause expression\n" ..
    "binding_name\n" ..
    "literal_pattern expression\n" ..
    "literal_pattern nil\n" ..
    "literal_pattern boolean\n" ..
    "binding_pattern expression\n" ..
    "binding_pattern variant_pattern\n" ..
    "variant_pattern expression\n" ..
    "table_pattern table_constructor\n" ..
    "rest_pattern vararg\n" ..
    "match_statement match_expression\n" ..
    "expression_statement match_arm\n" ..
    "match_arm index_expression\n" ..
    "match_arm\n" ..
    "do_block match_arm\n" ..
    "repeat_loop index_expression\n" ..
    "expression_statement index_expression\n" ..
    "assignment index_expression\n" ..
    "assignment expression_statement index_expression\n" ..
    "compound_assignment index_expression\n" ..
    "local_declaration index_expression\n" ..
    "const_declaration index_expression\n" ..
    "global_declaration index_expression\n" ..
    "return_statement index_expression\n" ..
    "typed_binding index_expression\n" ..
    "guard index_expression\n" ..
    "if_statement guard\n" ..
    "if_statement guard if_expression\n" ..
    "if_statement guard call_expression if_expression\n" ..
    "binary_expression contains_expression\n" ..
    "call_expression await_expression\n" ..
    "index_expression await_expression\n" ..
    "method_call_expression await_expression\n" ..
    "try_expression await_expression\n" ..
    "unwrap_expression await_expression"

conflicts: str = ()
    b: str = "  conflicts: $ => [\n"
    rows = conflictrows():split("\n")
    i: i64 = 1
    while i <= rows:len()
        row: str = rows[i]
        b = "{b}    ["
        n: i64 = width(row)
        j: i64 = 1
        while j <= n
            if j > 1
                b = "{b}, "
            sym: str = field(row, j)
            b = "{b}$.{sym}"
            j += 1
        b = "{b}],\n"
        i += 1
    b = "{b}  ],\n"
    b = "{b}\n"
    b

ruleshead: str = ()
    b: str = "  // ── Rules ──────────────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}  rules: {\n"
    b = "{b}    // ── Top-level ───────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    module: $ => seq(\n"
    b = "{b}      optional($.shebang),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // `#!/usr/bin/env duo`. src/lexer.zig recognises `#!` only at index 0 and\n"
    b = "{b}    // so does this: `#` is the length operator everywhere else.\n"
    b = "{b}    shebang: $ => token(seq('#!', /[^\\n]*/)),\n"
    b = "{b}\n"
    b = "{b}    // ── Statements ──────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    statement: $ => choice(\n"
    b = "{b}      $.local_declaration,\n"
    b = "{b}      $.const_declaration,\n"
    b = "{b}      $.global_declaration,\n"
    b = "{b}      $.assignment,\n"
    b = "{b}      $.compound_assignment,\n"
    b = "{b}      $.typed_binding,\n"
    b = "{b}      $.type_alias_definition,\n"
    b = "{b}      $.jai_type_definition,\n"
    b = "{b}      $.struct_definition,\n"
    b = "{b}      $.do_block,\n"
    b = "{b}      $.if_statement,\n"
    b = "{b}      $.while_loop,\n"
    b = "{b}      $.repeat_loop,\n"
    b = "{b}      $.numeric_for,\n"
    b = "{b}      $.generic_for,\n"
    b = "{b}      $.function_declaration,\n"
    b = "{b}      $.bare_function_declaration,\n"
    b = "{b}      $.foreign_declaration,\n"
    b = "{b}      $.return_statement,\n"
    b = "{b}      $.break_statement,\n"
    b = "{b}      $.goto_statement,\n"
    b = "{b}      $.label_statement,\n"
    b = "{b}      $.expression_statement,\n"
    b = "{b}      $.match_statement,\n"
    b = "{b}      $.try_statement,\n"
    b = "{b}      $.defer_statement,\n"
    b = "{b}      $.enum_definition,\n"
    b = "{b}      $.concept_definition,\n"
    b = "{b}      $.alias_definition,\n"
    b = "{b}      $.empty_statement,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // Duo has no statement terminator, but `;` is a token (`semi`) and 16\n"
    b = "{b}    // tracked files use it to put two statements on one line.\n"
    b = "{b}    empty_statement: $ => ';',\n"
    b = "{b}\n"
    b

attributes: str = ()
    b: str = "    // ── Attributes ──────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    // `@export`, `@ffi(\"puts\")`, legacy c emit, `@comp.define.derive(…)`,\n"
    b = "{b}    // `@(expr)`.\n"
    b = "{b}    //\n"
    b = "{b}    // Two things were wrong here. The path was capped at TWO segments, so\n"
    b = "{b}    // `@comp.define.derive` and `@comp.embed.json` had no rule; and the\n"
    b = "{b}    // argument list was the raw regex `/[^)]*/`, which stops at the first `)`\n"
    b = "{b}    // it sees — so `@comp.assert(@comp.satisfies(point, \"hasxy\"), \"…\")` ended\n"
    b = "{b}    // mid-argument and every nested call was an error. Arguments are ordinary\n"
    b = "{b}    // expressions, which is what they are in the compiler too.\n"
    b = "{b}    attribute: $ => prec.right(choice(\n"
    b = "{b}      seq('@', $.attribute_path, optional(seq(\n"
    b = "{b}        '(',\n"
    b = "{b}        // A directive argument may be a whole function: 22 tracked files write\n"
    b = "{b}        // `@comp.define.derive(\"name\", generate(meta) -> str … end)`, where the\n"
    b = "{b}        // second argument is a NAMED declaration, not an expression.\n"
    b = "{b}        commaSep(choice($.expression, $.bare_function_declaration, $.directive_function)),\n"
    b = "{b}        ')',\n"
    b = "{b}      ))),\n"
    b = "{b}      // @(expr) — compile-time evaluation\n"
    b = "{b}      seq('@', '(', $.expression, ')'),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    // `@comp.define.derive(\"printable\", generate(type_info) … end)` — a\n"
    b = "{b}    // declaration with NO annotation anywhere, which GR-001 forbids in\n"
    b = "{b}    // statement position because it would make a declaration candidate out of\n"
    b = "{b}    // every ordinary call. Inside a directive's argument list that objection\n"
    b = "{b}    // does not apply: a call reading exists but cannot complete, because the\n"
    b = "{b}    // statements that follow are not arguments. So the rule is REACHABLE ONLY\n"
    b = "{b}    // HERE — it is not in `statement` and !in `expression` — and the\n"
    b = "{b}    // exclusion that protects 791 call sites is untouched.\n"
    b = "{b}    directive_function: $ => seq(\n"
    b = "{b}      field('name', $.function_name),\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep(choice($.parameter, $.vararg_parameter)),\n"
    b = "{b}      ')',\n"
    b = "{b}      optional(seq($._result_arrow, field('result', $.type))),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // Right-associative so the path is GREEDY: `@comp.type.name(x)` is one\n"
    b = "{b}    // three-segment directive, not `@comp` with a field access hanging off it.\n"
    b = "{b}    attribute_path: $ => prec.right(seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      repeat(seq('.', $.identifier)),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    // An attribute BINDS to the declaration it precedes wherever one follows;\n"
    b = "{b}    // where none does (legacy c emit on its own line) the same syntax is a\n"
    b = "{b}    // statement. Both readings exist in the corpus, so the list carries a\n"
    b = "{b}    // dynamic precedence and attachment wins when it is available at all.\n"
    b = "{b}    _attribute_list: $ => prec.dynamic(1, repeat1($.attribute)),\n"
    b = "{b}\n"
    b

declarations: str = ()
    b: str = "    // ── Local declaration ───────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    local_declaration: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      'local',\n"
    b = "{b}      commaSep1($.binding_name),\n"
    b = "{b}      optional(seq(\n"
    b = "{b}        ':',\n"
    b = "{b}        $.type,\n"
    b = "{b}      )),\n"
    b = "{b}      optional(seq(\n"
    b = "{b}        '=',\n"
    b = "{b}        commaSep1($.expression),\n"
    b = "{b}      )),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    binding_name: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', field('type', $.type))),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Const declaration ───────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    const_declaration: $ => seq(\n"
    b = "{b}      'const',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', $.type)),\n"
    b = "{b}      '=',\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Global declaration ──────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    global_declaration: $ => seq(\n"
    b = "{b}      'global',\n"
    b = "{b}      choice(\n"
    b = "{b}        '*',\n"
    b = "{b}        commaSep1($.binding_name),\n"
    b = "{b}      ),\n"
    b = "{b}      optional(seq(\n"
    b = "{b}        '=',\n"
    b = "{b}        commaSep1($.expression),\n"
    b = "{b}      )),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Assignment ──────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    assignment: $ => seq(\n"
    b = "{b}      commaSep1($.expression),\n"
    b = "{b}      '=',\n"
    b = "{b}      commaSep1($.expression),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Compound assignment ─────────────────────────────────────────────────\n"
    b = "{b}    //\n"
    b = "{b}    // `+= -= *= /= %= ^=` are six distinct token kinds in src/lexer.zig\n"
    b = "{b}    // (`plus_assign` … `caret_assign`) and this grammar had none of them, so\n"
    b = "{b}    // `sub -= 1` parsed as `sub -` followed by `= 1`.\n"
    b = "{b}    compound_assignment: $ => seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      choice('+=', '-=', '*=', '/=', '%=', '^='),\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b

controls: str = ()
    b: str = "    // ── Do block ────────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    do_block: $ => seq(\n"
    b = "{b}      'do',\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── If statement ────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    if_statement: $ => seq(\n"
    b = "{b}      'if',\n"
    b = "{b}      choice($.binding_condition, $.expression),\n"
    b = "{b}      optional('then'),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      repeat($.elseif_clause),\n"
    b = "{b}      optional($.else_clause),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    elseif_clause: $ => seq(\n"
    b = "{b}      'elseif',\n"
    b = "{b}      choice($.binding_condition, $.expression),\n"
    b = "{b}      optional('then'),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Condition ───────────────────────────────────────────────────────────\n"
    b = "{b}    //\n"
    b = "{b}    // binding conditions stay projected because formatter and editor tooling\n"
    b = "{b}    // must recognise forms such as `found[i]` inside the value expression\n"
    b = "{b}    // instead of side-stepping bracketed indexing at the syntax boundary.\n"
    b = "{b}    binding_condition: $ => seq(\n"
    b = "{b}      commaSep1($.identifier),\n"
    b = "{b}      '=',\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    else_clause: $ => seq(\n"
    b = "{b}      'else',\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── While loop ──────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    while_loop: $ => seq(\n"
    b = "{b}      'while',\n"
    b = "{b}      choice($.binding_condition, $.expression),\n"
    b = "{b}      optional('do'),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Repeat loop ─────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    repeat_loop: $ => seq(\n"
    b = "{b}      'repeat',\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'until',\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Numeric for ─────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    numeric_for: $ => seq(\n"
    b = "{b}      'for',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', $.type)),\n"
    b = "{b}      '=',\n"
    b = "{b}      $.expression,\n"
    b = "{b}      ',',\n"
    b = "{b}      $.expression,\n"
    b = "{b}      optional(seq(',', $.expression)),\n"
    b = "{b}      optional('do'),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Generic for ─────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    generic_for: $ => seq(\n"
    b = "{b}      'for',\n"
    b = "{b}      commaSep1($.identifier),\n"
    b = "{b}      'in',\n"
    b = "{b}      commaSep1($.expression),\n"
    b = "{b}      optional('do'),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b

forms: str = ()
    b: str = "    // ── Function declaration ────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    function_declaration: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      optional('local'),\n"
    b = "{b}      choice('function', 'fun'),\n"
    b = "{b}      field('name', $.function_name),\n"
    b = "{b}      optional($.type_parameters),\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep($.parameter),\n"
    b = "{b}      optional(seq(',', '...')),\n"
    b = "{b}      ')',\n"
    b = "{b}      optional(seq($._result_arrow, $.type)),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    type_parameters: $ => seq(\n"
    b = "{b}      '<',\n"
    b = "{b}      commaSep1($.type_parameter),\n"
    b = "{b}      '>',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    type_parameter: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', $.type, repeat(seq('+', $.type)))),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    function_name: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      repeat(seq('.', $.identifier)),\n"
    b = "{b}      optional(seq(':', $.identifier)),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    parameter: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', field('type', $.type))),\n"
    b = "{b}      optional(seq('=', $.expression)),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Bare function declaration ──────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    bare_function_declaration: $ => prec.dynamic(3, seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      field('name', choice($.function_name, alias('type', $.identifier))),\n"
    b = "{b}      $._annotated_signature,\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    // ── Foreign or bodyless declaration ────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    foreign_declaration: $ => seq(\n"
    b = "{b}      $._attribute_list,\n"
    b = "{b}      field('name', $.function_name),\n"
    b = "{b}      $._annotated_signature,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    _annotated_signature: $ => choice(\n"
    b = "{b}      seq(\n"
    b = "{b}        '(',\n"
    b = "{b}        optional(seq(\n"
    b = "{b}          optional($._plain_parameter_prefix),\n"
    b = "{b}          choice(alias($._plain_parameter, $.parameter), $.vararg_parameter),\n"
    b = "{b}        )),\n"
    b = "{b}        ')',\n"
    b = "{b}        $._result_arrow,\n"
    b = "{b}        field('result', $.type),\n"
    b = "{b}      ),\n"
    b = "{b}      seq(\n"
    b = "{b}        '(',\n"
    b = "{b}        optional($._plain_parameter_prefix),\n"
    b = "{b}        alias($._typed_parameter, $.parameter),\n"
    b = "{b}        repeat(seq(',', choice($.parameter, $.vararg_parameter))),\n"
    b = "{b}        ')',\n"
    b = "{b}        optional(seq($._result_arrow, field('result', $.type))),\n"
    b = "{b}      ),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    _result_arrow: $ => choice(':', '->'),\n"
    b = "{b}\n"
    b = "{b}    _plain_parameter_prefix: $ => repeat1(\n"
    b = "{b}      seq(alias($._plain_parameter, $.parameter), ','),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    _plain_parameter: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    _typed_parameter: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      ':',\n"
    b = "{b}      field('type', $.type),\n"
    b = "{b}      optional(seq('=', $.expression)),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    vararg_parameter: $ => seq(\n"
    b = "{b}      '...',\n"
    b = "{b}      optional($.identifier),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b

tails: str = ()
    b: str = "    // ── Return ──────────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    return_statement: $ => prec.right(seq(\n"
    b = "{b}      'return',\n"
    b = "{b}      optional(commaSep1($.expression)),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    // ── Break ───────────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    break_statement: $ => 'break',\n"
    b = "{b}\n"
    b = "{b}    // ── Goto ────────────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    goto_statement: $ => seq(\n"
    b = "{b}      'goto',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    label_statement: $ => seq(\n"
    b = "{b}      '::',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '::',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Expression statement ────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    expression_statement: $ => commaSep1($.expression),\n"
    b = "{b}\n"
    b

patterns: str = ()
    b: str = "    // ── Match statement ─────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    match_statement: $ => seq(\n"
    b = "{b}      'match',\n"
    b = "{b}      $.expression,\n"
    b = "{b}      repeat($.match_arm),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    match_arm: $ => choice(\n"
    b = "{b}      seq(\n"
    b = "{b}        'case',\n"
    b = "{b}        $.pattern,\n"
    b = "{b}        optional($.guard),\n"
    b = "{b}        optional(choice('then', 'do')),\n"
    b = "{b}        repeat($.statement),\n"
    b = "{b}        optional('end'),\n"
    b = "{b}      ),\n"
    b = "{b}      seq('else', repeat($.statement), optional('end')),\n"
    b = "{b}      seq(\n"
    b = "{b}        $.pattern,\n"
    b = "{b}        optional($.guard),\n"
    b = "{b}        '=>',\n"
    b = "{b}        choice(\n"
    b = "{b}          $.expression,\n"
    b = "{b}          seq(repeat($.statement), 'end'),\n"
    b = "{b}        ),\n"
    b = "{b}      ),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    guard: $ => seq(\n"
    b = "{b}      'if',\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Pattern ─────────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    pattern: $ => choice(\n"
    b = "{b}      $.literal_pattern,\n"
    b = "{b}      $.binding_pattern,\n"
    b = "{b}      $.variant_pattern,\n"
    b = "{b}      $.table_pattern,\n"
    b = "{b}      $.array_pattern,\n"
    b = "{b}      $.rest_pattern,\n"
    b = "{b}      '_',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    literal_pattern: $ => choice(\n"
    b = "{b}      $.number,\n"
    b = "{b}      $.string,\n"
    b = "{b}      'true',\n"
    b = "{b}      'false',\n"
    b = "{b}      'nil',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    binding_pattern: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', $.type)),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    variant_pattern: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep($.pattern),\n"
    b = "{b}      ')',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    table_pattern: $ => seq(\n"
    b = "{b}      '{',\n"
    b = "{b}      commaSep($.table_pattern_entry),\n"
    b = "{b}      '}',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    table_pattern_entry: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '=',\n"
    b = "{b}      $.pattern,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    array_pattern: $ => seq(\n"
    b = "{b}      '[',\n"
    b = "{b}      commaSep($.pattern),\n"
    b = "{b}      ']',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    rest_pattern: $ => seq(\n"
    b = "{b}      '...',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b

defs: str = ()
    b: str = "    // ── Try statement ───────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    try_statement: $ => seq(\n"
    b = "{b}      'try',\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      repeat($.catch_clause),\n"
    b = "{b}      optional($.defer_statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    catch_clause: $ => seq(\n"
    b = "{b}      'catch',\n"
    b = "{b}      optional($.identifier),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Defer statement ─────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    defer_statement: $ => seq(\n"
    b = "{b}      'defer',\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Enum definition ─────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    enum_definition: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      'enum',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional($.type_parameters),\n"
    b = "{b}      repeat($.enum_variant),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    enum_variant: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(\n"
    b = "{b}        '(',\n"
    b = "{b}        commaSep1($.enum_field),\n"
    b = "{b}        ')',\n"
    b = "{b}      )),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    enum_field: $ => seq(\n"
    b = "{b}      optional(seq($.identifier, ':')),\n"
    b = "{b}      $.type,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Concept definition ──────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    concept_definition: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      'concept',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional($.type_parameters),\n"
    b = "{b}      repeat(choice(\n"
    b = "{b}        $.concept_method,\n"
    b = "{b}        $.concept_field,\n"
    b = "{b}      )),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    concept_method: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep($.parameter),\n"
    b = "{b}      ')',\n"
    b = "{b}      $._result_arrow,\n"
    b = "{b}      $.type,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    concept_field: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      ':',\n"
    b = "{b}      $.type,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Alias definition ────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    alias_definition: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      'alias',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      choice(\n"
    b = "{b}        seq('=', $.type),\n"
    b = "{b}        seq(\n"
    b = "{b}          optional(seq('extends', $.identifier)),\n"
    b = "{b}          repeat($.alias_member),\n"
    b = "{b}          'end',\n"
    b = "{b}        ),\n"
    b = "{b}      ),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Jai-like type definition ────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    jai_type_definition: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      ':',\n"
    b = "{b}      $.record_type,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    type_alias_definition: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      choice(\n"
    b = "{b}        seq($.identifier, ':', $.type),\n"
    b = "{b}        seq('type', $.identifier, '=', $.type),\n"
    b = "{b}      ),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Typed binding (name: Type = expr) ───────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    typed_binding: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      ':',\n"
    b = "{b}      $.type,\n"
    b = "{b}      '=',\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Struct definition (Name = struct ... end) ────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    struct_definition: $ => seq(\n"
    b = "{b}      optional($._attribute_list),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '=',\n"
    b = "{b}      'struct',\n"
    b = "{b}      repeat($.struct_field),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    struct_field: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', $.type)),\n"
    b = "{b}      optional(seq('=', $.expression)),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    alias_member: $ => choice(\n"
    b = "{b}      $.alias_field,\n"
    b = "{b}      $.function_declaration,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    alias_field: $ => seq(\n"
    b = "{b}      optional('private'),\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      ':',\n"
    b = "{b}      $.type,\n"
    b = "{b}      optional(seq('=', $.expression)),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b

types: str = ()
    b: str = "    // ── Types ───────────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    type: $ => choice(\n"
    b = "{b}      $.named_type,\n"
    b = "{b}      $.array_type,\n"
    b = "{b}      $.pointer_type,\n"
    b = "{b}      $.optional_type,\n"
    b = "{b}      $.generic_type,\n"
    b = "{b}      $.function_type,\n"
    b = "{b}      $.record_type,\n"
    b = "{b}      $.tuple_type,\n"
    b = "{b}      $.pack_type,\n"
    b = "{b}      $.applied_type,\n"
    b = "{b}      $.attributed_type,\n"
    b = "{b}      $.attribute,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    tuple_type: $ => seq(\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep1($.type),\n"
    b = "{b}      ')',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    pack_type: $ => prec.left(seq(\n"
    b = "{b}      $.type,\n"
    b = "{b}      '|',\n"
    b = "{b}      $.type,\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    applied_type: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep1($.type),\n"
    b = "{b}      ')',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    attributed_type: $ => prec.left(seq(\n"
    b = "{b}      $.type,\n"
    b = "{b}      repeat1(seq('&', $.type_attribute)),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    type_attribute: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq('(', commaSep($.expression), ')')),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    named_type: $ => $.identifier,\n"
    b = "{b}\n"
    b = "{b}    array_type: $ => choice(\n"
    b = "{b}      seq('[', optional($.number), ']', $.type),\n"
    b = "{b}      seq('[', $.type, ']'),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    pointer_type: $ => seq(\n"
    b = "{b}      '*',\n"
    b = "{b}      $.type,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    optional_type: $ => seq(\n"
    b = "{b}      '?',\n"
    b = "{b}      $.type,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    generic_type: $ => choice(\n"
    b = "{b}      seq($.identifier, '<', commaSep1($.type), '>'),\n"
    b = "{b}      seq($.identifier, '[', commaSep1(choice($.type, $.number)), ']'),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    function_type: $ => seq(\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep($.type),\n"
    b = "{b}      ')',\n"
    b = "{b}      '->',\n"
    b = "{b}      $.type,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    record_type: $ => seq(\n"
    b = "{b}      optional('@'),\n"
    b = "{b}      '{',\n"
    b = "{b}      sepBy(choice($.record_slot, $.record_field, $.spread_entry)),\n"
    b = "{b}      '}',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    record_slot: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '=',\n"
    b = "{b}      $.lambda_expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    record_field: $ => seq(\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      optional(seq(':', $.type)),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b

exprs: str = ()
    b: str = "    // ── Expressions ─────────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    expression: $ => choice(\n"
    b = "{b}      $.nil,\n"
    b = "{b}      $.boolean,\n"
    b = "{b}      $.number,\n"
    b = "{b}      $.string,\n"
    b = "{b}      $.vararg,\n"
    b = "{b}      $.anchor_expression,\n"
    b = "{b}      $.builtinname,\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      $.binary_expression,\n"
    b = "{b}      $.unary_expression,\n"
    b = "{b}      $.function_expression,\n"
    b = "{b}      $.function_value_expression,\n"
    b = "{b}      $.lambda_expression,\n"
    b = "{b}      $.table_constructor,\n"
    b = "{b}      $.descriptor_constructor,\n"
    b = "{b}      $.attribute,\n"
    b = "{b}      $.field_projection,\n"
    b = "{b}      $.index_expression,\n"
    b = "{b}      $.field_expression,\n"
    b = "{b}      $.semantic_field_expression,\n"
    b = "{b}      $.call_expression,\n"
    b = "{b}      $.method_call_expression,\n"
    b = "{b}      $.try_expression,\n"
    b = "{b}      $.unwrap_expression,\n"
    b = "{b}      $.match_expression,\n"
    b = "{b}      $.if_expression,\n"
    b = "{b}      $.await_expression,\n"
    b = "{b}      $.contains_expression,\n"
    b = "{b}      $.parenthesized_expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    anchor_expression: $ => '@',\n"
    b = "{b}\n"
    b = "{b}    // ── Function expression ─────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    function_expression: $ => seq(\n"
    b = "{b}      choice('function', 'fun'),\n"
    b = "{b}      optional($.identifier),\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep($.parameter),\n"
    b = "{b}      optional(seq(',', '...')),\n"
    b = "{b}      ')',\n"
    b = "{b}      optional(seq($._result_arrow, $.type)),\n"
    b = "{b}      repeat($.statement),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Function value ──────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    function_value_expression: $ => choice(\n"
    b = "{b}      seq($._annotated_signature, repeat($.statement), 'end'),\n"
    b = "{b}      prec.dynamic(-1, seq('(', ')', repeat($.statement), 'end')),\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Expression-body function value ──────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    lambda_expression: $ => prec.dynamic(-1, seq(\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep(choice($.parameter, $.vararg_parameter)),\n"
    b = "{b}      ')',\n"
    b = "{b}      optional(seq($._result_arrow, field('result', $.type))),\n"
    b = "{b}      field('body', $.expression),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b

exprtail: str = ()
    b: str = "    // ── Table constructor ───────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    table_constructor: $ => seq(\n"
    b = "{b}      '{',\n"
    b = "{b}      sepBy(choice($.table_entry, $.spread_entry)),\n"
    b = "{b}      '}',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    table_entry: $ => choice(\n"
    b = "{b}      seq(choice($.identifier, $.builtinname, $.string), '=', $.expression),\n"
    b = "{b}      seq($.identifier, ':', field('type', $.type), '=', $.expression),\n"
    b = "{b}      seq('[', $.expression, ']', '=', $.expression),\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Field projection / method reference ─────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    field_projection: $ => prec(-1, seq('.', $.identifier)),\n"
    b = "{b}\n"
    b = "{b}    // ── Descriptor constructor ──────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    descriptor_constructor: $ => seq(\n"
    b = "{b}      '@',\n"
    b = "{b}      '{',\n"
    b = "{b}      sepBy(choice($.table_entry, $.spread_entry)),\n"
    b = "{b}      '}',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    spread_entry: $ => seq('..', $.expression),\n"
    b = "{b}\n"
    b = "{b}    // ── Postfix expressions ─────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    index_expression: $ => seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      '[',\n"
    b = "{b}      $.expression,\n"
    b = "{b}      ']',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    field_expression: $ => prec(1, seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      '.',\n"
    b = "{b}      choice($.identifier, alias('type', $.identifier)),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    semantic_field_expression: $ => prec(1, seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      '.',\n"
    b = "{b}      '@',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    call_expression: $ => prec.dynamic(1, seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      choice(\n"
    b = "{b}        seq('(', commaSep($.expression), ')'),\n"
    b = "{b}        $.string,\n"
    b = "{b}        $.table_constructor,\n"
    b = "{b}      ),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    method_call_expression: $ => seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      ':',\n"
    b = "{b}      $.identifier,\n"
    b = "{b}      '(',\n"
    b = "{b}      commaSep($.expression),\n"
    b = "{b}      ')',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Try/unwrap expressions ──────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    try_expression: $ => seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      '?',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    unwrap_expression: $ => seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      '!',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Match expression ────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    match_expression: $ => seq(\n"
    b = "{b}      'match',\n"
    b = "{b}      $.expression,\n"
    b = "{b}      repeat($.match_arm),\n"
    b = "{b}      'end',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    if_expression: $ => prec.right(seq(\n"
    b = "{b}      'if',\n"
    b = "{b}      field('condition', $.expression),\n"
    b = "{b}      field('consequence', $.expression),\n"
    b = "{b}      'else',\n"
    b = "{b}      field('alternative', $.expression),\n"
    b = "{b}      optional('end'),\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    // ── Await expression ────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    await_expression: $ => seq(\n"
    b = "{b}      'await',\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Contains expression ─────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    contains_expression: $ => seq(\n"
    b = "{b}      $.expression,\n"
    b = "{b}      'in',\n"
    b = "{b}      $.expression,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    // ── Parenthesized ───────────────────────────────────────────────────────\n"
    b = "{b}\n"
    b = "{b}    parenthesized_expression: $ => seq(\n"
    b = "{b}      '(',\n"
    b = "{b}      $.expression,\n"
    b = "{b}      ')',\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b

residuemark: str = ()
    # ONE LINE. The begin marker has to be a single line, because `carve`
    # starts capturing at the line AFTER it: a two-line marker puts its second
    # line inside the residue, where the next regeneration emits it again
    # above the copy it just carried. Caught by running the emitter twice.
    "    // {markbegin} — AUTHORED to {markend}, carried verbatim; see the banner.\n"

# ── The token registry ───────────────────────────────────────────────────────

# A long string at level `lv`. The delimiters are `[` + lv `=` + `[`, and the
# body is "any character that is not `]`, or a `]` run shorter than my own
# closer". A single token DFA cannot remember how many `=` it opened with, so
# the exclusion has to be spelled out per level — exactly the kind of thing a
# generator should do and a person should not.
longlevel: str = (lv: i64)
    eqs: str = tile("=", lv)
    body: str = "/[^\\]]/"
    k: i64 = 0
    while k < lv
        run: str = tile("=", k)
        body = "{body}, /\\]{run}[^=]/"
        k += 1
    body = "{body}, /\\]{eqs}[^\\]]/"
    "      seq('[{eqs}[', repeat(choice({body})), ']{eqs}]'),\n"

# One template, two quote characters. The escape class is the quote itself
# plus the backslash, which is the only thing that differs between them.
quoted: str = (rulename: str, quote: str, wrap: str)
    b: str = "    {rulename}: $ => token(seq(\n"
    b = "{b}      {wrap}{quote}{wrap},\n"
    b = "{b}      repeat(choice(\n"
    b = "{b}        /[^{quote}\\\\]+/,\n"
    b = "{b}        /\\\\./,\n"
    b = "{b}      )),\n"
    b = "{b}      {wrap}{quote}{wrap},\n"
    b = "{b}    )),\n"
    b

tokens: str = ()
    dq: str = "\""
    sq: str = "'"
    dot: str = "."
    ell: str = "{dot}{dot}{dot}"
    b: str = "    nil: $ => 'nil',\n"
    b = "{b}\n"
    b = "{b}    boolean: $ => choice('true', 'false'),\n"
    b = "{b}\n"
    b = "{b}    number: $ => choice(\n"
    b = "{b}      $.integer,\n"
    b = "{b}      $.float,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    integer: $ => token(choice(\n"
    b = "{b}      /[0-9]+/,\n"
    b = "{b}      /0x[0-9a-fA-F]+/,\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    float: $ => token(choice(\n"
    b = "{b}      /[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?/,\n"
    b = "{b}      /[0-9]+[eE][+-]?[0-9]+/,\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    string: $ => choice(\n"
    b = "{b}      $.double_quoted_string,\n"
    b = "{b}      $.single_quoted_string,\n"
    b = "{b}      $.long_string,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    one: str = quoted("double_quoted_string", dq, sq)
    b = "{b}{one}"
    b = "{b}\n"
    two: str = quoted("single_quoted_string", sq, dq)
    b = "{b}{two}"
    b = "{b}\n"
    b = "{b}    // The body was `/[^]]*/` — \"no `]` at all\" — so a long string containing\n"
    b = "{b}    // an index expression (`a[i]`) or a C statement ended at the first `]` and\n"
    b = "{b}    // took the rest of the file with it. A `]` is body text unless the NEXT\n"
    b = "{b}    // character is also `]`, which is the closing delimiter. Stated as an\n"
    b = "{b}    // alternation rather than a lookahead because tree-sitter's token DFA has\n"
    b = "{b}    // none; it stays non-greedy across two long strings in one file precisely\n"
    b = "{b}    // because `]]` can never be consumed as body.\n"
    b = "{b}    //\n"
    b = "{b}    // ONE ALTERNATIVE PER LEVEL, and the GENERATOR writes them now. A single\n"
    b = "{b}    // token DFA cannot remember how many `=` it opened with, so each body is\n"
    b = "{b}    // \"any character, or a `]` run shorter than MY closer\" — a function of the\n"
    b = "{b}    // level, and previously three lines that had to be checked by eye.\n"
    b = "{b}    // Levels 0 and 1 are what the corpus uses (108 `[[` and 1 `[=[`); level 2\n"
    b = "{b}    // is here so the next one does not reopen this.\n"
    b = "{b}    long_string: $ => token(choice(\n"
    lv: i64 = 0
    while lv <= 2
        row: str = longlevel(lv)
        b = "{b}{row}"
        lv += 1
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    vararg: $ => '{ell}',\n"
    b = "{b}\n"
    b = "{b}    builtinname: $ => alias('type', $.identifier),\n"
    b = "{b}\n"
    b = "{b}    identifier: $ => /[a-zA-Z_][a-zA-Z0-9_]*/,\n"
    b

# ── The operator table ───────────────────────────────────────────────────────
#
# This IS the precedence table, and it is the reason this generator exists.
#
#   spell   the operator, as the lexer spells it
#   level   the tree-sitter binding power — HIGHER BINDS TIGHTER
#   spec    the level docs/spec/grammar.md §2 gives it, counting the other way
#           (§2 is tightest-first), or 0 where §2 does not list it at all
#   assoc   left, or right for the one right-associative operator
#
# The rows are parallel and the lengths are checked before anything is
# emitted. `cat` stands for the concatenation operator, spelled out at use, so
# that this file never places that spelling beside a quote — CLAUDE.md §1's
# `concatlit` row is a text rule and applies to the generator too.

spell: str = ()
    "or and < > <= >= ~= != == in | & ~ << >> |> cat + - * / // % ^"

# Tree-sitter binding power. Tighter binds higher. §2 order, translated:
# ^ 13 · unary 12 · * / // % 11 · + - 10 · << >> 9 · & 8 · ~ | 7 · cat 6 ·
# comparisons and `in` 5 · and 4 · or 3 · |> 2.
level: str = ()
    "3 4 5 5 5 5 5 5 5 5 7 8 7 9 9 2 6 10 10 11 11 11 11 13"

spec: str = ()
    "12 11 10 10 10 10 10 10 10 0 8 7 8 6 6 0 9 5 5 4 4 0 4 3"

assoc: str = ()
    "left left left left left left left left left left left left left left left left left left left left left left left right"

field: str = (row: str, n: i64)
    parts = row:split(" ")
    got: str = ""
    if n >= 1 and n <= parts:len()
        got = parts[n]
    got

width: i64 = (row: str)
    parts = row:split(" ")
    #parts

# A note printed immediately above the row it explains.
opnote: str = (idx: i64)
    b: str = ""
    if idx == 8
        b = "{b}      // `!=` is the SAME token as `~=` in src/lexer.zig (both lex to `.neq`),\n"
        b = "{b}      // and it is the spelling 271 tracked files actually use. Without it\n"
        b = "{b}      // `a != nil` lexed as an unwrap_expression `a!` followed by `= nil`.\n"
    if idx == 12
        b = "{b}      // `&` (amp) and binary `~` (xor) are in the lexer's token table and were\n"
        b = "{b}      // not in this one; `|` alone was.\n"
    b

rule: str = (bar: str)
    dot: str = "."
    out: str = bar
    if bar == "cat"
        out = "{dot}{dot}"
    out

operators: str = ()
    sp: str = spell()
    lv: str = level()
    ac: str = assoc()
    n: i64 = width(sp)
    dash: str = "\u{2500}"
    bar: str = tile(dash, 46)
    b: str = "    // {dash}{dash} Binary operators {bar}\n"
    b = "{b}\n"
    b = "{b}    binary_expression: $ => choice(\n"
    i: i64 = 1
    while i <= n
        note: str = opnote(i)
        b = "{b}{note}"
        raw: str = field(sp, i)
        op: str = rule(raw)
        pw: str = field(lv, i)
        side: str = field(ac, i)
        b = "{b}      prec.{side}({pw}, seq($.expression, '{op}', $.expression)),\n"
        i += 1
    b = "{b}    ),\n"
    b = "{b}\n"
    ubar: str = tile(dash, 47)
    b = "{b}    // {dash}{dash} Unary operators {ubar}\n"
    b = "{b}\n"
    b = "{b}    // Unary binds tighter than every binary operator except `^`, which is what\n"
    b = "{b}    // `-a^b` meaning `-(a^b)` requires. Its level is one below `^` and one\n"
    b = "{b}    // above `*`, and it moves with them because it is in the same table.\n"
    b = "{b}    unary_expression: $ => choice(\n"
    pre: str = "not # ## comptime - ~"
    m: i64 = width(pre)
    i = 1
    while i <= m
        op: str = field(pre, i)
        b = "{b}      prec(12, seq('{op}', $.expression)),\n"
        i += 1
    b = "{b}    ),\n"
    b

# ── The tail registry ────────────────────────────────────────────────────────

tail: str = ()
    dash: str = "\u{2500}"
    cbar: str = tile(dash, 51)
    hbar: str = tile(dash, 76)
    b: str = "    // {dash}{dash} Comments {cbar}\n"
    b = "{b}\n"
    b = "{b}    comment: $ => token(choice(\n"
    b = "{b}      seq('--', /[^\\n]*/),\n"
    b = "{b}      seq('--', '[', repeat('='), '[',\n"
    b = "{b}          repeat(choice(/[^\\]]/, seq(']', /[^\\]]/))),\n"
    b = "{b}          ']', repeat('='), ']'),\n"
    b = "{b}    )),\n"
    b = "{b}  },\n"
    b = "{b}});\n"
    b = "{b}\n"
    b = "{b}// {dash}{dash} Helpers {hbar}\n"
    b = "{b}\n"
    b = "{b}function commaSep(rule) {\n"
    b = "{b}  return optional(commaSep1(rule));\n"
    b = "{b}}\n"
    b = "{b}\n"
    b = "{b}function commaSep1(rule) {\n"
    b = "{b}  return seq(rule, repeat(seq(',', rule)));\n"
    b = "{b}}\n"
    b = "{b}\n"
    b = "{b}// The NEWLINE is the canonical separator inside a braced group\n"
    b = "{b}// and the comma is the optional one. `extras` already consumes the newline, so\n"
    b = "{b}// \"optional comma between elements, optional trailing comma\" is the whole rule.\n"
    b = "{b}function sepBy(rule) {\n"
    b = "{b}  return optional(seq(rule, repeat(seq(optional(','), rule)), optional(',')));\n"
    b = "{b}}\n"
    b

# ── The spec cross-check ─────────────────────────────────────────────────────
#
# Reads docs/spec/grammar.md §2 and reports, per adjacent pair of operators,
# whether the tree-sitter table and the normative table agree on WHICH BINDS
# TIGHTER. Compared by order, not by value, because the two tables count in
# opposite directions. Nothing here changes a byte of the output.

specrows: i64 = (body: str)
    rows = body:split("\n")
    seen: i64 = 0
    i: i64 = 1
    while i <= rows:len()
        row: str = rows[i]
        two: str = row:sub(1, 2)
        one: str = row:sub(1, 1)
        digit: bool = one == "1" or one == "2" or one == "3" or one == "4" or one == "5"
        digit = digit or one == "6" or one == "7" or one == "8" or one == "9"
        if digit and (two:sub(2, 2) == " " or two:sub(2, 2) == "0" or two:sub(2, 2) == "1" or two:sub(2, 2) == "2" or two:sub(2, 2) == "3" or two:sub(2, 2) == "4")
            seen += 1
        i += 1
    seen

report: i64 = ()
    sp: str = spell()
    lv: str = level()
    sc: str = spec()
    ac: str = assoc()
    bad: i64 = 0

    n: i64 = width(sp)
    if width(lv) != n or width(sc) != n or width(ac) != n
        print("treesitter emit: FAIL — the operator rows are not the same length.")
        print("  Parallel rows that drift silently assign the wrong precedence to the")
        print("  wrong operator, which is the exact defect this table was written to")
        print("  catch. Refusing to emit.")
        bad = 3

    if bad == 0
        body: str = slurp(specpath)
        rows: i64 = specrows(body)
        if rows == 0
            print("treesitter emit: FAIL — docs/spec/grammar.md yielded 0 precedence rows.")
            print("  The §2 reader is broken, and a broken reader reports agreement.")
            bad = 3
        if bad == 0
            nrows: str = rows:to(str)
            nops: str = n:to(str)
            print("  operators in the table: {nops}")
            print("  §2 precedence rows read from docs/spec/grammar.md: {nrows}")
            flips: i64 = 0
            unlisted: i64 = 0
            i: i64 = 1
            while i < n
                sa: i64 = to(i64)(field(sc, i))
                sb: i64 = to(i64)(field(sc, i + 1))
                if sa == 0 or sb == 0
                    unlisted += 1
                else
                    la: i64 = to(i64)(field(lv, i))
                    lb: i64 = to(i64)(field(lv, i + 1))
                    if la != lb
                        tighter: bool = la > lb
                        spectighter: bool = sa < sb
                        if tighter != spectighter
                            opa: str = field(sp, i)
                            opb: str = field(sp, i + 1)
                            print("  DIVERGENCE  `{opa}` vs `{opb}` — tree-sitter and §2 disagree on which binds tighter")
                            flips += 1
                i += 1
            nflips: str = flips:to(str)
            nunlisted: str = unlisted:to(str)
            print("  adjacent pairs where §2 and this table disagree: {nflips}")
            print("  adjacent pairs §2 does not list at all: {nunlisted}")
    bad

# ── Splice ───────────────────────────────────────────────────────────────────

# Everything between the two markers, verbatim, the marker lines themselves
# excluded. Empty when the markers are absent, which is the bootstrap path.
carve: str = (body: str)
    rows = body:split("\n")
    out: str = ""
    inside: bool = false
    i: i64 = 1
    while i <= rows:len()
        row: str = rows[i]
        at1: i64 = row:find(markbegin)
        at2: i64 = row:find(markend)
        if inside and at2 > 0
            inside = false
        else
            if inside
                out = "{out}{row}\n"
            if at1 > 0
                inside = true
        i += 1
    out

rulesonly: str = (body: str)
    rows = body:split("\n")
    out: str = ""
    seen: bool = false
    i: i64 = 1
    while i <= rows:len()
        row: str = rows[i]
        if !seen and row:find("    // ── No authored residue") > 0
            seen = true
        if seen
            out = "{out}{row}\n"
        i += 1
    if out != ""
        n: i64 = out:len()
        while n > 0 and out:sub(n, n) == "\n"
            n -= 1
        out:sub(1, n) .. "\n"
    else
        ""

envor: str = (name: str, fallback: str)
    v = os.getenv(name)
    s: str = v:to(str)
    return if s == "" fallback else s 

main: i64 = ()
    out: str = envor("TSEMIT_OUT", grammarpath)
    check: str = envor("TSEMIT_CHECK", "")
    seed: str = envor("TSEMIT_RESIDUE", "")

    print("treesitter emit — the grammar projection")
    print("  output   {out}")

    existing: str = slurp(grammarpath)
    residue: str = carve(existing)
    source: str = grammarpath
    if residue == "" and seed != ""
        residue = slurp(seed)
        source = seed
    residue = rulesonly(residue)

    count: i64 = lines(residue)
    nres: str = count:to(str)
    print("  residue  {nres} authored lines, carried from {source}")

    bad: i64 = report()
    if bad != 0
        os.exit(bad)

    body: str = head(count)
    cf: str = conflicts()
    body = "{body}{cf}"
    rh: str = ruleshead()
    body = "{body}{rh}"
    ar: str = attributes()
    body = "{body}{ar}"
    ds: str = declarations()
    body = "{body}{ds}"
    ct: str = controls()
    body = "{body}{ct}"
    ff: str = forms()
    body = "{body}{ff}"
    ts: str = tails()
    body = "{body}{ts}"
    pa: str = patterns()
    body = "{body}{pa}"
    df: str = defs()
    body = "{body}{df}"
    ty: str = types()
    body = "{body}{ty}"
    ex: str = exprs()
    body = "{body}{ex}"
    et: str = exprtail()
    body = "{body}{et}"
    tk: str = tokens()
    body = "{body}{tk}"
    body = "{body}\n"
    op: str = operators()
    body = "{body}{op}"
    body = "{body}\n"
    tl: str = tail()
    body = "{body}{tl}"

    total: i64 = lines(body)
    gen: i64 = total - count
    ntotal: str = total:to(str)
    ngen: str = gen:to(str)
    print("  emitted  {ngen} generated lines of {ntotal} total")

    # Positive control on the emitter itself. A build that lost the operator
    # table or the residue would still look like a plausible file; these are
    # the two absences that must never be reported as success.
    hasop: i64 = body:find("binary_expression")
    hasmod: i64 = body:find("module.exports")
    hasres: i64 = body:find("conflicts")
    if hasop == 0 or hasmod == 0 or hasres == 0
        print("treesitter emit: FAIL — the emitted text is missing binary_expression, the")
        print("  module export, or the residue's conflict list. The emitter is broken,")
        print("  not the grammar.")
        os.exit(3)

    if check == "1"
        onfile: str = slurp(out)
        if onfile == body
            print("treesitter emit: PASS — regeneration is byte-identical to {out}")
        else
            na: str = to(str)(onfile:len())
            nb: str = to(str)(body:len())
            print("treesitter emit: FAIL — {out} is not what this emitter produces.")
            print("  tracked {na} bytes, regenerated {nb} bytes.")
            print("  Either a generated region was hand-edited, or the emitter changed and")
            print("  the file was not regenerated. Run:")
            print("      idol run scripts/treesitter_emit.id")
            os.exit(1)
    else
        done: bool = spill(out, body)
        if done
            print("treesitter emit: wrote {out}")
        else
            print("treesitter emit: FAIL — could not write {out}")
            os.exit(3)
    0
