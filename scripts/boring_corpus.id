
work = "/tmp/duo-boring-corpus"
boring = "examples/boring"
page = "examples/table"

boringfloor = 10
pagefloor = 19

boringrows = ""
boringtotal = 0
boringpass = 0

pagerows = ""
pagetotal = 0
pagepass = 0

controlok = 0

chomp: str = (text: str)
  if text:len() == 0
    return ""
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

capture: str = (shellline: str)
  gatecap(shellline)

cap: str = (shellline: str)
  chomp(gatecap(shellline))

status: i64 = (cmd: str)
  cap("( {cmd} ) >/dev/null 2>&1\necho $?"):to(i64)

quiet: i64 = (cmd: str)
  status("{cmd}")

count: i64 = (path: str)
  cap("wc -l < {path}"):to(i64)

stem: str = (path: str)
  cap("basename {path} .id")

diagnostic: str = (duo: str, path: str)
  line = cap("{duo} compile {path} --emit exe -o {work}/probe.out 2>&1 | grep -m1 'error:' | head -1")
  if line == ""
    line = "no diagnostic captured"
  line

runone: i64 = (duo: str, path: str, which: str)
  ok = 0
  name = stem(path)
  want = cap("sed -n 's/^# expect: *//p' {path} | head -1")
  bin = "{work}/{which}-{name}.out"
  if want == ""
    row = "  FAIL  {name}  carries no '# expect:' line\n"
    record(which, row)
  if want != ""
    if status("{duo} compile {path} --emit exe -o {bin}") != 0
      note = diagnostic(duo, path)
      row = "  FAIL  {name}  {note}\n"
      record(which, row)
    if status("{duo} compile {path} --emit exe -o {bin}") == 0
      code = status("{bin} >{work}/{name}.stdout 2>{work}/{name}.stderr")
      got = cap("cat {work}/{name}.stdout")
      err = cap("cat {work}/{name}.stderr")
      if code != 0
        row = "  FAIL  {name}  exited {code} (signal or error), stdout '{got}'\n"
        record(which, row)
      if code == 0 and err != ""
        row = "  FAIL  {name}  unexpected stderr '{err}', stdout '{got}'\n"
        record(which, row)
      if code == 0 and err == "" and got == want
        ok = 1
        row = "  pass  {name}  {got}\n"
        record(which, row)
      if code == 0 and err == "" and got != want
        row = "  FAIL  {name}  want '{want}' got '{got}'\n"
        record(which, row)
  ok

record = (which: str, row: str)
  if which == "boring"
    boringrows = "{boringrows}{row}"
  if which == "page"
    pagerows = "{pagerows}{row}"

sweep = (duo: str, dir: str, which: str)
  list = "{work}/{which}.list"
  status("find {dir} -name '*.id' | sort > {list}")
  j = 1
  n = count(list)
  while j <= n
    path = cap("sed -n '{j}p' {list}")
    ok = runone(duo, path, which)
    if which == "boring"
      boringtotal = boringtotal + 1
      boringpass = boringpass + ok
    if which == "page"
      pagetotal = pagetotal + 1
      pagepass = pagepass + ok
    j = j + 1

controls: i64 = (duo: str)
  ok = 0
  probe = "{work}/control.id"
  status("sed 's/return n$/return n + 1/' {boring}/fib.id > {probe}")
  got = runone(duo, probe, "control")
  if got == 0
    ok = 1
  ok

verdict: i64 = ()
  code = 0
  if boringtotal == 0
    print("boring corpus: FAIL — no programs found in {boring}")
    code = 1
  if code == 0 and pagetotal == 0
    print("boring corpus: FAIL — no table fixtures found in {page}")
    code = 1
  if code == 0 and controlok == 0
    print("boring corpus: FAIL — the control stopped discriminating:")
    print("  a fib.id with its base case corrupted still PASSED, so the")
    print("  value comparison is broken and no row above means anything.")
    code = 1
  if code == 0 and boringpass < boringfloor
    print("boring corpus: FAIL — everyday programs regressed below the floor")
    code = 1
  if code == 0 and pagepass < pagefloor
    print("boring corpus: FAIL — a numerics or text row changed behaviour.")
    print("  These fixtures assert what the compiler MEASURABLY DOES, so a")
    print("  red row means the reading moved. Re-measure and update")
    print("  docs/numerics_and_text.md in the same commit.")
    code = 1
  if code == 0
    print("boring corpus: PASS")
  code

report = ()
  print("")
  print("  THE BORING CORPUS ({boring})")
  print("")
  print(boringrows)
  print("")
  print("  NUMERICS AND TEXT, as measured ({page})")
  print("")
  print(pagerows)
  print("")
  print("  boring  {boringpass}/{boringtotal}   floor {boringfloor}")
  print("  table   {pagepass}/{pagetotal}   floor {pagefloor}")
  print("")

measure: i64 = (duo: str)
  status("rm -rf {work} && mkdir -p {work}")
  controlok = controls(duo)
  sweep(duo, boring, "boring")
  sweep(duo, page, "page")
  report()
  verdict()

main: i64 = ()
  duo = os.env("DUO") or "./zig-out/bin/idol"
  measure(duo)
