-- treesitter emit — the grammar projection, as far as it honestly goes today.
--
-- Pass 101 §"The host" requires tree-sitter to be "a generated grammar
-- projection (output, never authored)". gaps/GAP-049 records why it was not:
-- three pieces were missing — a declarative production source, an emitter, and
-- a differential. Pass 108 landed the first as docs/spec/grammar.md. THIS FILE
-- is the second. `zig build tree-sitter-coverage` is the third.
--
-- WHAT THIS EMITS, and what it does not. The output file
-- ext/tree-sitter-duo/grammar.js is split by two markers into GENERATED parts
-- and an AUTHORED residue. Everything outside the markers is emitted from the
-- registries below; everything between them is carried through byte for byte
-- and COUNTED. The count is the number gaps/GAP-049 is measured by, and
-- printing it is the only honest way to say "partially generated".
--
-- The residue is not a formatting convenience. docs/spec/grammar.md §3 states
-- the structural productions as EBNF, but for the PASS-100 surface, and the
-- tracked corpus is still overwhelmingly pre-Pass-100 — `match`, `enum`,
-- `concept`, `local`, `fun`. Projecting §3 over the residue would drop editor
-- recognition from 755 of 775 files to almost none. That is a language
-- decision (GAP-049's "second reason"), not a build-system one, so this
-- emitter refuses to make it and says why instead.
--
-- WHAT IS GENUINELY DERIVED rather than transliterated:
--
--   long string levels 0..2   one rule per level from ONE template, with the
--                             body alternation that excludes the closer
--                             COMPUTED from the level. It used to be three
--                             hand-written lines whose alternations had to be
--                             got right by eye.
--   quoted string tokens      one template, two quote characters.
--   binary and unary operators  one table of spelling, level and
--                             associativity — which is what a precedence
--                             table IS — checked against grammar.md §2.
--
-- THE CHECK FOUND A REAL DEFECT THE DAY IT WAS WRITTEN, which is the argument
-- for the whole approach. The authored table numbered `or` 11 and `^` 4, and
-- in tree-sitter a HIGHER number binds TIGHTER, so the entire binary
-- precedence table was inverted end to end. Verified by value before it was
-- believed: `x = 2 + 3 * 4` parsed as `(2 + 3) * 4` and `a or b and c` as
-- `(a or b) and c`. The recognition gate could not see it — no ERROR node is
-- produced by a wrong tree — and no reader was going to diff twenty-five
-- `prec.left` lines against Lua by eye. A table that is DATA gets compared;
-- a table that is code gets read past.
--
-- WHAT IS CHECKED AGAINST THE SPEC BUT NOT PROJECTED FROM IT: the operator
-- table is compared, adjacent pair by adjacent pair, against §2, and every
-- divergence is PRINTED. The emitted bytes deliberately do NOT depend on
-- grammar.md: docs/spec is edited by other sessions, and a byte-identity gate
-- that an unrelated documentation commit can redden is a gate people learn to
-- skip. The report is the link; making it load-bearing needs §3 first.
--
-- THE OFFSIDE LAYER IS NOT EMITTED AND CANNOT BE. grammar.md §1 defines
-- NEWLINE / INDENT / DEDENT. tree-sitter has no offside layer; it needs an
-- EXTERNAL SCANNER, which is a C file, and `ls ext/tree-sitter-duo/src` has
-- none. That is why examples/spec100/offside.duo parses as one ERROR node from
-- [0,0] to end of file. Emitting an `externals` block without the scanner
-- would make the generated parser fail to LINK, which is worse than the hole.
--
-- WHY THE REGISTRIES ARE SPACE-SEPARATED STRINGS and not tables: a table does
-- not survive a function boundary in this compilation path. Measured — a
-- table pushed to inside a callee reads `#t == 0` in the caller, and so does
-- one returned from a callee. scripts/audit100.duo carries its budgets the
-- same way for the same reason. Positive-controlled below: the row-length
-- check refuses to run if the parallel rows are not all the same length.
--
-- Env:
--   TSEMIT_OUT     where to write (default the tracked grammar.js)
--   TSEMIT_CHECK   set to 1 to compare instead of writing — the gate mode
--   TSEMIT_RESIDUE bootstrap only: take the residue from this file when the
--                  output has no markers yet
--
-- Exit 0 emitted or identical · 1 the check found a difference · 3 the emitter
-- could not run (no output, no residue, no spec — a confident success is
-- usually a broken gate, so every path here is positive-controlled).

grammarpath = "ext/tree-sitter-duo/grammar.js"
specpath = "docs/spec/grammar.md"
markbegin = "@@residue:begin"
markend = "@@residue:end"

slurp(path: str): str
    f = io.open(path, "r")
    body: str = ""
    if f
        body = f:read("a")
        f:close()
    end
    body
end

spill(path: str, body: str): bool
    f = io.open(path, "w")
    done: bool = false
    if f
        f:write(body)
        f:close()
        done = true
    end
    done
end

-- `n` copies of `s`. The long-string delimiters need exactly this: the number
-- of `=` signs IS the level.
tile(s: str, n: i64): str
    acc: str = ""
    i: i64 = 0
    while i < n
        acc = "{acc}{s}"
        i = i + 1
    end
    acc
end

lines(s: str): i64
    parts = s:split("\n")
    n: i64 = #parts
    if n > 0
        last: str = parts[n]
        if last == ""
            n = n - 1
        end
    end
    n
end

-- ── The head registry ────────────────────────────────────────────────────────

-- The banner. `count` is the residue line count — the one number in this file
-- that is measured rather than declared.
banner(count: i64): str
    n: str = to(str)(count)
    b: str = "/**\n"
    b = "{b} * @file tree-sitter grammar for Duo — PARTIALLY GENERATED.\n"
    b = "{b} *\n"
    b = "{b} * GENERATED by scripts/treesitter_emit.duo — do not edit the generated\n"
    b = "{b} * regions by hand. Regenerate with:\n"
    b = "{b} *\n"
    b = "{b} *     duo run scripts/treesitter_emit.duo\n"
    b = "{b} *\n"
    b = "{b} * `zig build treesitter-projection` regenerates and FAILS unless the result is\n"
    b = "{b} * byte-identical to the tracked file, so a hand edit to a generated region\n"
    b = "{b} * cannot survive review. A generated file nobody regenerates is an authored\n"
    b = "{b} * file with extra steps.\n"
    b = "{b} *\n"
    b = "{b} * ── THE BOUNDARY, stated rather than banner-washed ──────────────────────────\n"
    b = "{b} *\n"
    b = "{b} * Everything OUTSIDE the @@residue markers below is emitted from registries in\n"
    b = "{b} * the generator. Everything BETWEEN them is AUTHORED — currently\n"
    b = "{b} *\n"
    b = "{b} *     {n} lines\n"
    b = "{b} *\n"
    b = "{b} * and that number is what gaps/GAP-049 is measured by. It must go down.\n"
    b = "{b} *\n"
    b = "{b} * GENERATED, and from what:\n"
    b = "{b} *   name / extras / supertypes    the head registry\n"
    b = "{b} *   literal tokens                the token registry\n"
    b = "{b} *   long_string levels 0..2       ONE template per level; the body\n"
    b = "{b} *                                 alternation that excludes the closing\n"
    b = "{b} *                                 delimiter is computed from the level\n"
    b = "{b} *   double / single quoted string ONE template, two quote characters\n"
    b = "{b} *   binary_expression             one table of spelling, level and\n"
    b = "{b} *   unary_expression              associativity, compared pair by pair\n"
    b = "{b} *                                 against docs/spec/grammar.md §2 with every\n"
    b = "{b} *                                 divergence PRINTED. That comparison is how\n"
    b = "{b} *                                 the inverted precedence table was found.\n"
    b = "{b} *   comment / helpers             the tail registry\n"
    b = "{b} *\n"
    b = "{b} * AUTHORED, and why:\n"
    b = "{b} *   the structural productions    docs/spec/grammar.md §3 states them as EBNF\n"
    b = "{b} *                                 — for the PASS-100 surface. The tracked\n"
    b = "{b} *                                 corpus is still mostly pre-Pass-100, so\n"
    b = "{b} *                                 projecting §3 here would drop editor\n"
    b = "{b} *                                 recognition from 755/775 to near zero. That\n"
    b = "{b} *                                 is a language decision, not a build-system\n"
    b = "{b} *                                 one — see gaps/GAP-049.\n"
    b = "{b} *   the conflicts list            94 LR conflicts, each proven necessary by\n"
    b = "{b} *                                 dropping it and re-running the generator.\n"
    b = "{b} *                                 Knowledge about an LR automaton is not in\n"
    b = "{b} *                                 any grammar document and cannot be.\n"
    b = "{b} *   NEWLINE / INDENT / DEDENT     tree-sitter has no offside layer. It needs\n"
    b = "{b} *                                 an external scanner, which is a C file, and\n"
    b = "{b} *                                 this tree has none — see\n"
    b = "{b} *                                 ext/tree-sitter-duo/src. That hole is why\n"
    b = "{b} *                                 examples/spec100/offside.duo is a single\n"
    b = "{b} *                                 ERROR node from [0,0] to end of file.\n"
    b = "{b} *\n"
    b = "{b} * Still counted as one of three tracked `.js` files by\n"
    b = "{b} * scripts/language_census.duo, which classifies by EXTENSION and therefore\n"
    b = "{b} * cannot see the difference this file makes. Said here so nobody reads the\n"
    b = "{b} * unchanged census row as evidence that nothing happened.\n"
    b = "{b} */\n"
    b
end

head(count: i64): str
    b: str = banner(count)
    b = "{b}\n"
    b = "{b}module.exports = grammar({\n"
    b = "{b}  name: 'duo',\n"
    b = "{b}\n"
    b = "{b}  extras: $ => [\n"
    b = "{b}    /\\s/,\n"
    b = "{b}    $.comment,\n"
    b = "{b}  ],\n"
    b = "{b}\n"
    b = "{b}  supertypes: $ => [\n"
    b = "{b}    $.statement,\n"
    b = "{b}    $.expression,\n"
    b = "{b}    $.type,\n"
    b = "{b}    $.pattern,\n"
    b = "{b}  ],\n"
    b = "{b}\n"
    -- ONE LINE. The begin marker has to be a single line, because `carve`
    -- starts capturing at the line AFTER it: a two-line marker puts its second
    -- line inside the residue, where the next regeneration emits it again
    -- above the copy it just carried. Caught by running the emitter twice.
    b = "{b}  // {markbegin} — AUTHORED to {markend}, carried verbatim; see the banner.\n"
    b
end

-- ── The token registry ───────────────────────────────────────────────────────

-- A long string at level `lv`. The delimiters are `[` + lv `=` + `[`, and the
-- body is "any character that is not `]`, or a `]` run shorter than my own
-- closer". A single token DFA cannot remember how many `=` it opened with, so
-- the exclusion has to be spelled out per level — exactly the kind of thing a
-- generator should do and a person should not.
longlevel(lv: i64): str
    eqs: str = tile("=", lv)
    body: str = "/[^\\]]/"
    k: i64 = 0
    while k < lv
        run: str = tile("=", k)
        body = "{body}, /\\]{run}[^=]/"
        k = k + 1
    end
    body = "{body}, /\\]{eqs}[^\\]]/"
    "      seq('[{eqs}[', repeat(choice({body})), ']{eqs}]'),\n"
end

-- One template, two quote characters. The escape class is the quote itself
-- plus the backslash, which is the only thing that differs between them.
quoted(rulename: str, quote: str, wrap: str): str
    b: str = "    {rulename}: $ => token(seq(\n"
    b = "{b}      {wrap}{quote}{wrap},\n"
    b = "{b}      repeat(choice(\n"
    b = "{b}        /[^{quote}\\\\]+/,\n"
    b = "{b}        /\\\\./,\n"
    b = "{b}      )),\n"
    b = "{b}      {wrap}{quote}{wrap},\n"
    b = "{b}    )),\n"
    b
end

tokens(): str
    dq: str = "\""
    sq: str = "'"
    dot: str = "."
    ell: str = "{dot}{dot}{dot}"
    b: str = "    nil: $ => 'nil',\n"
    b = "{b}\n"
    b = "{b}    boolean: $ => choice('true', 'false'),\n"
    b = "{b}\n"
    b = "{b}    number: $ => choice(\n"
    b = "{b}      $.integer,\n"
    b = "{b}      $.float,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    b = "{b}    integer: $ => token(choice(\n"
    b = "{b}      /[0-9]+/,\n"
    b = "{b}      /0x[0-9a-fA-F]+/,\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    float: $ => token(choice(\n"
    b = "{b}      /[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?/,\n"
    b = "{b}      /[0-9]+[eE][+-]?[0-9]+/,\n"
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    string: $ => choice(\n"
    b = "{b}      $.double_quoted_string,\n"
    b = "{b}      $.single_quoted_string,\n"
    b = "{b}      $.long_string,\n"
    b = "{b}    ),\n"
    b = "{b}\n"
    one: str = quoted("double_quoted_string", dq, sq)
    b = "{b}{one}"
    b = "{b}\n"
    two: str = quoted("single_quoted_string", sq, dq)
    b = "{b}{two}"
    b = "{b}\n"
    b = "{b}    // The body was `/[^]]*/` — \"no `]` at all\" — so a long string containing\n"
    b = "{b}    // an index expression (`a[i]`) or a C statement ended at the first `]` and\n"
    b = "{b}    // took the rest of the file with it. A `]` is body text unless the NEXT\n"
    b = "{b}    // character is also `]`, which is the closing delimiter. Stated as an\n"
    b = "{b}    // alternation rather than a lookahead because tree-sitter's token DFA has\n"
    b = "{b}    // none; it stays non-greedy across two long strings in one file precisely\n"
    b = "{b}    // because `]]` can never be consumed as body.\n"
    b = "{b}    //\n"
    b = "{b}    // ONE ALTERNATIVE PER LEVEL, and the GENERATOR writes them now. A single\n"
    b = "{b}    // token DFA cannot remember how many `=` it opened with, so each body is\n"
    b = "{b}    // \"any character, or a `]` run shorter than MY closer\" — a function of the\n"
    b = "{b}    // level, and previously three lines that had to be checked by eye.\n"
    b = "{b}    // Levels 0 and 1 are what the corpus uses (108 `[[` and 1 `[=[`); level 2\n"
    b = "{b}    // is here so the next one does not reopen this.\n"
    b = "{b}    long_string: $ => token(choice(\n"
    lv: i64 = 0
    while lv <= 2
        row: str = longlevel(lv)
        b = "{b}{row}"
        lv = lv + 1
    end
    b = "{b}    )),\n"
    b = "{b}\n"
    b = "{b}    vararg: $ => '{ell}',\n"
    b = "{b}\n"
    b = "{b}    identifier: $ => /[a-zA-Z_][a-zA-Z0-9_]*/,\n"
    b
end

-- ── The operator table ───────────────────────────────────────────────────────
--
-- This IS the precedence table, and it is the reason this generator exists.
--
--   spell   the operator, as the lexer spells it
--   level   the tree-sitter binding power — HIGHER BINDS TIGHTER
--   spec    the level docs/spec/grammar.md §2 gives it, counting the other way
--           (§2 is tightest-first), or 0 where §2 does not list it at all
--   assoc   left, or right for the one right-associative operator
--
-- The rows are parallel and the lengths are checked before anything is
-- emitted. `cat` stands for the concatenation operator, spelled out at use, so
-- that this file never places that spelling beside a quote — CLAUDE.md §1's
-- `concatlit` row is a text rule and applies to the generator too.

spell(): str
    "or and < > <= >= ~= != == in | & ~ << >> |> cat + - * / // % ^"
end

-- Tree-sitter binding power. Tighter binds higher. §2 order, translated:
-- ^ 13 · unary 12 · * / // % 11 · + - 10 · << >> 9 · & 8 · ~ | 7 · cat 6 ·
-- comparisons and `in` 5 · and 4 · or 3 · |> 2.
level(): str
    "3 4 5 5 5 5 5 5 5 5 7 8 7 9 9 2 6 10 10 11 11 11 11 13"
end

spec(): str
    "12 11 10 10 10 10 10 10 10 0 8 7 8 6 6 0 9 5 5 4 4 0 4 3"
end

assoc(): str
    "left left left left left left left left left left left left left left left left left left left left left left left right"
end

field(row: str, n: i64): str
    parts = row:split(" ")
    got: str = ""
    if n >= 1 and n <= #parts
        got = parts[n]
    end
    got
end

width(row: str): i64
    parts = row:split(" ")
    #parts
end

-- A note printed immediately above the row it explains.
opnote(idx: i64): str
    b: str = ""
    if idx == 8
        b = "{b}      // `!=` is the SAME token as `~=` in src/lexer.zig (both lex to `.neq`),\n"
        b = "{b}      // and it is the spelling 271 tracked files actually use. Without it\n"
        b = "{b}      // `a != nil` lexed as an unwrap_expression `a!` followed by `= nil`.\n"
    end
    if idx == 12
        b = "{b}      // `&` (amp) and binary `~` (xor) are in the lexer's token table and were\n"
        b = "{b}      // not in this one; `|` alone was.\n"
    end
    b
end

rule(bar: str): str
    dot: str = "."
    out: str = bar
    if bar == "cat"
        out = "{dot}{dot}"
    end
    out
end

operators(): str
    sp: str = spell()
    lv: str = level()
    ac: str = assoc()
    n: i64 = width(sp)
    dash: str = "\u{2500}"
    bar: str = tile(dash, 46)
    b: str = "    // {dash}{dash} Binary operators {bar}\n"
    b = "{b}\n"
    b = "{b}    binary_expression: $ => choice(\n"
    i: i64 = 1
    while i <= n
        note: str = opnote(i)
        b = "{b}{note}"
        raw: str = field(sp, i)
        op: str = rule(raw)
        pw: str = field(lv, i)
        side: str = field(ac, i)
        b = "{b}      prec.{side}({pw}, seq($.expression, '{op}', $.expression)),\n"
        i = i + 1
    end
    b = "{b}    ),\n"
    b = "{b}\n"
    ubar: str = tile(dash, 47)
    b = "{b}    // {dash}{dash} Unary operators {ubar}\n"
    b = "{b}\n"
    b = "{b}    // Unary binds tighter than every binary operator except `^`, which is what\n"
    b = "{b}    // `-a^b` meaning `-(a^b)` requires. Its level is one below `^` and one\n"
    b = "{b}    // above `*`, and it moves with them because it is in the same table.\n"
    b = "{b}    unary_expression: $ => choice(\n"
    pre: str = "not # ## comptime - ~"
    m: i64 = width(pre)
    i = 1
    while i <= m
        op: str = field(pre, i)
        b = "{b}      prec(12, seq('{op}', $.expression)),\n"
        i = i + 1
    end
    b = "{b}    ),\n"
    b
end

-- ── The tail registry ────────────────────────────────────────────────────────

tail(): str
    dash: str = "\u{2500}"
    cbar: str = tile(dash, 51)
    hbar: str = tile(dash, 76)
    b: str = "    // {dash}{dash} Comments {cbar}\n"
    b = "{b}\n"
    b = "{b}    comment: $ => token(choice(\n"
    b = "{b}      seq('--', /[^\\n]*/),\n"
    b = "{b}      seq('--', '[', repeat('='), '[',\n"
    b = "{b}          repeat(choice(/[^\\]]/, seq(']', /[^\\]]/))),\n"
    b = "{b}          ']', repeat('='), ']'),\n"
    b = "{b}    )),\n"
    b = "{b}  },\n"
    b = "{b}});\n"
    b = "{b}\n"
    b = "{b}// {dash}{dash} Helpers {hbar}\n"
    b = "{b}\n"
    b = "{b}function commaSep(rule) {\n"
    b = "{b}  return optional(commaSep1(rule));\n"
    b = "{b}}\n"
    b = "{b}\n"
    b = "{b}function commaSep1(rule) {\n"
    b = "{b}  return seq(rule, repeat(seq(',', rule)));\n"
    b = "{b}}\n"
    b = "{b}\n"
    b = "{b}// Pass 100 §7 X8: the NEWLINE is the canonical separator inside a braced group\n"
    b = "{b}// and the comma is the optional one. `extras` already consumes the newline, so\n"
    b = "{b}// \"optional comma between elements, optional trailing comma\" is the whole rule.\n"
    b = "{b}function sepBy(rule) {\n"
    b = "{b}  return optional(seq(rule, repeat(seq(optional(','), rule)), optional(',')));\n"
    b = "{b}}\n"
    b
end

-- ── The spec cross-check ─────────────────────────────────────────────────────
--
-- Reads docs/spec/grammar.md §2 and reports, per adjacent pair of operators,
-- whether the tree-sitter table and the normative table agree on WHICH BINDS
-- TIGHTER. Compared by order, not by value, because the two tables count in
-- opposite directions. Nothing here changes a byte of the output.

specrows(body: str): i64
    rows = body:split("\n")
    seen: i64 = 0
    i: i64 = 1
    while i <= #rows
        row: str = rows[i]
        two: str = row:sub(1, 2)
        one: str = row:sub(1, 1)
        digit: bool = one == "1" or one == "2" or one == "3" or one == "4" or one == "5"
        digit = digit or one == "6" or one == "7" or one == "8" or one == "9"
        if digit and (two:sub(2, 2) == " " or two:sub(2, 2) == "0" or two:sub(2, 2) == "1" or two:sub(2, 2) == "2" or two:sub(2, 2) == "3" or two:sub(2, 2) == "4")
            seen = seen + 1
        end
        i = i + 1
    end
    seen
end

report(): i64
    sp: str = spell()
    lv: str = level()
    sc: str = spec()
    ac: str = assoc()
    bad: i64 = 0

    n: i64 = width(sp)
    if width(lv) != n or width(sc) != n or width(ac) != n
        print("treesitter emit: FAIL — the operator rows are not the same length.")
        print("  Parallel rows that drift silently assign the wrong precedence to the")
        print("  wrong operator, which is the exact defect this table was written to")
        print("  catch. Refusing to emit.")
        bad = 3
    end

    if bad == 0
        body: str = slurp(specpath)
        rows: i64 = specrows(body)
        if rows == 0
            print("treesitter emit: FAIL — docs/spec/grammar.md yielded 0 precedence rows.")
            print("  The §2 reader is broken, and a broken reader reports agreement.")
            bad = 3
        end
        if bad == 0
            nrows: str = to(str)(rows)
            nops: str = to(str)(n)
            print("  operators in the table: {nops}")
            print("  §2 precedence rows read from docs/spec/grammar.md: {nrows}")
            flips: i64 = 0
            unlisted: i64 = 0
            i: i64 = 1
            while i < n
                sa: i64 = to(i64)(field(sc, i))
                sb: i64 = to(i64)(field(sc, i + 1))
                if sa == 0 or sb == 0
                    unlisted = unlisted + 1
                else
                    la: i64 = to(i64)(field(lv, i))
                    lb: i64 = to(i64)(field(lv, i + 1))
                    if la != lb
                        tighter: bool = la > lb
                        spectighter: bool = sa < sb
                        if tighter != spectighter
                            opa: str = field(sp, i)
                            opb: str = field(sp, i + 1)
                            print("  DIVERGENCE  `{opa}` vs `{opb}` — tree-sitter and §2 disagree on which binds tighter")
                            flips = flips + 1
                        end
                    end
                end
                i = i + 1
            end
            nflips: str = to(str)(flips)
            nunlisted: str = to(str)(unlisted)
            print("  adjacent pairs where §2 and this table disagree: {nflips}")
            print("  adjacent pairs §2 does not list at all: {nunlisted}")
        end
    end
    bad
end

-- ── Splice ───────────────────────────────────────────────────────────────────

-- Everything between the two markers, verbatim, the marker lines themselves
-- excluded. Empty when the markers are absent, which is the bootstrap path.
carve(body: str): str
    rows = body:split("\n")
    out: str = ""
    inside: bool = false
    i: i64 = 1
    while i <= #rows
        row: str = rows[i]
        at1: i64 = row:find(markbegin)
        at2: i64 = row:find(markend)
        if inside and at2 > 0
            inside = false
        else
            if inside
                out = "{out}{row}\n"
            end
            if at1 > 0
                inside = true
            end
        end
        i = i + 1
    end
    out
end

main(): i64
    out: str = std.script.getenv("TSEMIT_OUT", grammarpath)
    check: str = std.script.getenv("TSEMIT_CHECK", "")
    seed: str = std.script.getenv("TSEMIT_RESIDUE", "")

    print("treesitter emit — the grammar projection")
    print("  output   {out}")

    existing: str = slurp(grammarpath)
    residue: str = carve(existing)
    source: str = grammarpath
    if residue == "" and seed != ""
        residue = slurp(seed)
        source = seed
    end

    if residue == ""
        print("treesitter emit: FAIL — no residue found.")
        print("  {grammarpath} carries no {markbegin} / {markend} pair and TSEMIT_RESIDUE")
        print("  is unset. Emitting the generated regions alone would produce a grammar")
        print("  with no productions — which tree-sitter accepts and which recognises")
        print("  nothing at all. Refusing.")
        std.os.exit(3)
    end

    count: i64 = lines(residue)
    nres: str = to(str)(count)
    print("  residue  {nres} authored lines, carried from {source}")

    bad: i64 = report()
    if bad != 0
        std.os.exit(bad)
    end

    body: str = head(count)
    body = "{body}{residue}"
    body = "{body}  // {markend}\n"
    body = "{body}\n"
    tk: str = tokens()
    body = "{body}{tk}"
    body = "{body}\n"
    op: str = operators()
    body = "{body}{op}"
    body = "{body}\n"
    tl: str = tail()
    body = "{body}{tl}"

    total: i64 = lines(body)
    gen: i64 = total - count
    ntotal: str = to(str)(total)
    ngen: str = to(str)(gen)
    print("  emitted  {ngen} generated lines of {ntotal} total")

    -- Positive control on the emitter itself. A build that lost the operator
    -- table or the residue would still look like a plausible file; these are
    -- the two absences that must never be reported as success.
    hasop: i64 = body:find("binary_expression")
    hasmod: i64 = body:find("module.exports")
    hasres: i64 = body:find("conflicts")
    if hasop == 0 or hasmod == 0 or hasres == 0
        print("treesitter emit: FAIL — the emitted text is missing binary_expression, the")
        print("  module export, or the residue's conflict list. The emitter is broken,")
        print("  not the grammar.")
        std.os.exit(3)
    end

    if check == "1"
        onfile: str = slurp(out)
        if onfile == body
            print("treesitter emit: PASS — regeneration is byte-identical to {out}")
        else
            na: str = to(str)(#onfile)
            nb: str = to(str)(#body)
            print("treesitter emit: FAIL — {out} is not what this emitter produces.")
            print("  tracked {na} bytes, regenerated {nb} bytes.")
            print("  Either a generated region was hand-edited, or the emitter changed and")
            print("  the file was not regenerated. Run:")
            print("      duo run scripts/treesitter_emit.duo")
            std.os.exit(1)
        end
    else
        done: bool = spill(out, body)
        if done
            print("treesitter emit: wrote {out}")
        else
            print("treesitter emit: FAIL — could not write {out}")
            std.os.exit(3)
        end
    end
    0
end
