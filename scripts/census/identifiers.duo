-- Pass 91 / Epoch 2 — the identifier recognizer.
--
-- The epoch ships two greppable scans that must reach zero:
--
--     grep [a-z]_[a-z] outside numerals = 0
--     grep [A-Z] in identifiers         = 0
--
-- A raw count is not actionable -- 14504 sites is a number you cannot start on.
-- This triages them into the buckets the canon's own repair table names, and
-- flags the one bucket that is a TRAP, so the sweep can be run in order of
-- safety rather than alphabetically.
--
-- This is the recognizer Pass 86 §4 asked codex to gain, generalized by Pass 91
-- to every interior `_` rather than just constructor modes. It REPORTS; it does
-- not rewrite. Automatic renaming is not safe here: 25 of Pass 88's predicate
-- bases collide with existing bindings, one of Pass 90's collides same-file,
-- and gap[31] means a LEVEL repair landing on a libc verb produces a silent
-- miscompile rather than an error. Those three facts are why this ships as a
-- triage tool and the sweep stays a human-reviewed edit.
--
-- Shelling out through std.script.capture is the established corpus-walk
-- pattern here (scripts/parser_corpus_coverage.duo enumerates with `find`).
-- MONOGLOT is about the FILES being Duo, which they are.

root(): str
    std.script.getenv("DUO_ROOT", ".")
end

-- One counted grep over lib/std. `pat` is an extended-regex; the pipeline
-- de-duplicates so every number below is DISTINCT identifiers, not occurrences.
-- Pass 94 repaired these two bodies, as far as the compiler allows.
--
--   chomp     DISSOLVED. It existed only because shell capture appends a
--             newline. Measured (contract.duo P94-5): `to(i64)("42\n")` is 42
--             -- the numeric edge already tolerates surrounding noise, so the
--             call and its temporary both go.
--   capture   NOT repairable yet. The ruling is `sh(cmd).out`, where consuming
--             .out IS the capture. `sh` does not resolve (P94-1..P94-4 all
--             MISSING), so the activity namespace survives here under protest.
--             -- gap[34]
--   the path  Destructured once at the top per the import canon, so the bodies
--             speak in bare names rather than reading like a filesystem.
--   :to(T)    NOT erasable. CDR would delete it under the `: i64` contract, but
--             contract-directed realization does not run (P94-8 MISSING), and
--             the receiver face `out:to(i64)` miscompiles (gap[32]) -- so the
--             section face stays, explicitly.
{ capture } = std.script

distinct(pat: str): i64
    r = root()                                          -- gap[29] (TMP-1 forced)
    cmd = "grep -rhoE '{pat}' --include='*.duo' {r}/lib/std/ | sort -u | wc -l"
    out = capture(cmd)                                  -- gap[32] (TMP-1 forced)
    to(i64)(out)
end

occurrences(pat: str): i64
    r = root()                                          -- gap[29] (TMP-1 forced)
    cmd = "grep -rhoE '{pat}' --include='*.duo' {r}/lib/std/ | wc -l"
    out = capture(cmd)                                  -- gap[32] (TMP-1 forced)
    to(i64)(out)
end

-- Every interior-underscore identifier. This is the scan's denominator.
compound(): str
    "\\b[a-z][a-z0-9]*(_[a-z][a-z0-9]*)+\\b"
end

main(): i64
    total = distinct(compound())
    sites = occurrences(compound())

    -- Positive control. A scan that reports zero because its pattern is wrong
    -- looks exactly like a corpus that conforms, and this file's whole job is
    -- to report a large number honestly.
    if total == 0
        print("identifiers: SCAN BROKEN — zero compounds found in lib/std.")
        print("  The corpus is known to contain thousands; check DUO_ROOT and")
        print("  that grep -E is available. A confident zero is the failure")
        print("  mode this control exists to catch.")
        return 2
    end

    -- The TRAP bucket. gap[31]: Duo functions are emitted as unmangled static C
    -- symbols, so a LEVEL repair whose bare verb is a libc symbol either fails
    -- to build or -- where arities match -- silently binds the C function.
    -- These must be repaired to a non-colliding verb, never mechanically.
    hazard = distinct("\\b(read|write|open|close|time|index|link|free|exit|stat|send|recv|kill|wait)_[a-z][a-z0-9]*\\b")

    -- Pass 88's predicate purge: is_x -> x. 25 of these collide with an
    -- existing binding; 4 collide same-file against their own constructor.
    predicate = distinct("\\bis_[a-z][a-z0-9]*\\b")

    -- Pass 88's axis compounds: sort_by -> sort, take_while -> take. Blocked on
    -- the sequence surface, which does not exist.
    axis = distinct("\\b[a-z][a-z0-9]*_(by|while|until)\\b")

    -- Pass 86's constructor modes: from_x / of_x -> :from(mode).
    mode = distinct("\\b([a-z][a-z0-9]*_)?from_[a-z][a-z0-9]*\\b")

    -- The case scan, Epoch 2's other absolute.
    upper = distinct("\\b[A-Z][A-Za-z0-9_]*\\b")
    uppersites = occurrences("\\b[A-Z][A-Za-z0-9_]*\\b")

    -- THE BLOCKED MAJORITY, and the correction this file exists to carry.
    --
    -- An earlier revision reported the remainder as "actionable, all three
    -- destinations compile". That measured the destination forms IN ISOLATION
    -- -- `scan(number)(1)`, `utf8.valid`, `limit` each compile -- and not
    -- against real sites. Against real sites the dominant class is blocked.
    --
    -- A top-level compound-named function taking a typed first parameter is a
    -- SUBJECT-FIRST function: `cursor_peek(c: ByteCursor)`. Its canonical Epoch
    -- 2 destination is a descriptor method (`cursor: { peek = () … }`), because
    -- §0.6 says methods travel with values and §0.6's own recognizer denies
    -- `alias.fn(subject, …)`. Descriptor member bindings do not parse
    -- (GAP-025), so that destination does not exist. Renaming such a function
    -- to a bare word trades a NAMING violation for an ALIAS-CALL violation --
    -- it moves the diff from one deny row to another.
    subject = occurrences("^[a-z][a-z0-9]*(_[a-z][a-z0-9]*)+\\([a-z]+: [A-Za-z]")

    rest = total - hazard - predicate - axis - mode

    print("identifier census — lib/std, Epoch 2 scans")
    print("")
    print("  interior `_`   {total} distinct / {sites} sites   (scan demands 0)")
    print("  uppercase      {upper} distinct / {uppersites} sites   (scan demands 0)")
    print("")
    print("  triage of the interior-`_` set:")
    print("    libc-verb TRAP   {hazard}   gap[31] — repair by hand, never sweep")
    print("    is_ predicates   {predicate}   Pass 88 — 25 collide, 4 same-file")
    print("    axis compounds   {axis}   Pass 88 — blocked on the sequence surface")
    print("    from_ modes      {mode}   Pass 86 — blocked, `from` does not resolve")
    print("    remainder        {rest}   LEVEL / HOME / CONTEXT destinations")
    print("")
    print("  cutting the other way — by SITE SHAPE, not by name shape:")
    print("    subject-first fns  {subject}   canonical destination is a descriptor")
    print("                          method — GAP-025, does not parse")
    print("")
    print("  That second number is the one that governs. A destination form")
    print("  compiling in isolation is not the same as a SITE being repairable:")
    print("  renaming a subject-first function to a bare word trades a naming")
    print("  violation for an ALIAS-CALL violation. The sweep is unblocked only")
    print("  for names that are not subject-first functions.")
    0
end
