
chomp: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32
      break
    n = n - 1
  text:sub(1, n)

cap: str = (cmd: str)
  chomp(gatecap(cmd))

lines: any = (text: str)
  out = {}
  start = 1
  i = 1
  n = text:len()
  while i <= n
    if text:byte(i) == 10
      if i > start
        out(out:len() + 1) = text:sub(start, i - 1)
      start = i + 1
    i = i + 1
  if start <= n
    out(out:len() + 1) = text:sub(start, n)
  out

status: i64 = (cmd: str)
  cap("( {cmd} ) >/dev/null 2>&1; echo $?"):to(i64)

count: i64 = (cmd: str)
  cap(cmd):to(i64)

sh: i64 = (cmd: str)
  status(cmd)

envor: str = (name: str, fallback: str)
  v = os.env(name)
  if not v or v:len() == 0
    fallback
  else
    v

prefix = envor("FOREIGN_PREFIX", "")
rest = envor("FOREIGN_REST", "")
into = envor("FOREIGN_INTO", "")
if prefix == "" or rest == "" or into == ""
  print("0")
  return 1

trail = prefix:sub(prefix:len(), prefix:len())
cmd = ""
if trail == "/"
  cmd = "grep '^{prefix}' {rest} 2>/dev/null | tee -a {into} >/dev/null; grep -v '^{prefix}' {rest} > {rest}.keep 2>/dev/null; mv {rest}.keep {rest}"
else
  cmd = "grep -xF '{prefix}' {rest} 2>/dev/null | tee -a {into} >/dev/null; grep -vxF '{prefix}' {rest} > {rest}.keep 2>/dev/null; mv {rest}.keep {rest}"
sh(cmd)

hits: i64 = 0
if trail == "/"
  hits = count("grep '^{prefix}' {into} 2>/dev/null | wc -l")
else
  hits = count("grep -cxF '{prefix}' {into} 2>/dev/null")
print(hits:to(str))
0
