

chomp: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32
      break
    n = n - 1
  text:sub(1, n)

cap: str = (cmd: str)
  chomp(gatecap(cmd))

tonum: i64 = (out: str)
  n = out:len()
  while n > 0 and (out:byte(n) == 10 or out:byte(n) == 32)
    n = n - 1
  out:sub(1, n):to(i64)

sweep: str = (root: str)
  gatecap("cd '{root}' && duo=./zig-out/bin/idol; ok=0; bail=0; un=0; noent=0; for f in $(find examples -name '*.id' | grep -v compile_fail); do out=$($duo compile --backend=direct $f -o /tmp/_census.bin 2>&1); case $out in *'ok compile'*) ok=$((ok+1)); continue;; esac; case $out in *DNB*) : ;; *) noent=$((noent+1)); continue;; esac; if grep -qE '^global [A-Za-z_]* = std.compiler\\.|=.*req.*std.compiler' $f; then un=$((un+1)); else bail=$((bail+1)); fi; done; echo $ok $bail $un $noent")

census: i64 = ()
  root = cap("git rev-parse --show-toplevel 2>/dev/null")
  counts = sweep(root)
  if not counts:len()
    print("census/native: FAIL — sweep produced no output; census did !run")
    return 3

  ok = tonum(counts:match("^%d+"))
  rest = counts:gsub("^%d+%s+", "")
  bail = tonum(rest:match("^%d+"))
  rest2 = rest:gsub("^%d+%s+", "")
  unreachable = tonum(rest2:match("^%d+"))

  if ok == 0
    print("census/native: FAIL — 0 programs compiled natively; the sweep is broken")
    return 3

  reachable = ok + bail
  print("native census (--backend=direct over examples/, compile_fail excluded)")
  print("  native        {ok}   lowered to ARM64")
  print("  bail          {bail}   reachable, !yet lowered — the worklist")
  print("  unreachable   {unreachable}   C-emitter fixtures; native is !a goal for these")
  print("  reachable     {reachable}   the denominator that can reach 100%")

  floor = 88
  if ok < floor
    print("census/native: FAIL — native {ok} fell below the ratchet {floor}")
    return 1
  print("census/native: PASS (native {ok} >= {floor}, {reachable - ok} reachable programs remain)")
  0
