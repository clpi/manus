# Embedded @c audit and enforce for the self-hosting target.
#
# scripts/census/foreign.id advertises the aggregate count and keeps the unclassified
# floor. This script audits each remaining payload site by file and enforces
# the termination condition: embedded C only shrinks; self-hosting
# requires zero sites.

chomp: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32
      break
    n = n - 1
  text:sub(1, n)

capture: str = (cmd: str)
  f = io.popen(cmd, "r")
  if f == nil
    return ""
  out = ""
  line = f:read("*a")
  if line != nil
    out = line
  f:close()
  chomp(out)

cap: str = (cmd: str)
  chomp(capture(cmd))

lines: any = (text: str)
  out = {}
  start = 1
  i = 1
  n = text:len()
  while i <= n
    if text:byte(i) == 10
      if i > start
        out(out:len() + 1) = text:sub(start, i - 1)
      start = i + 1
    i = i + 1
  if start <= n
    out(out:len() + 1) = text:sub(start, n)
  out

has: bool = (text: str, part: str)
  pos = text:find(part, 1, true)
  pos != nil and pos > 0

trimleft: str = (text: str)
  i = 1
  n = text:len()
  while i <= n and (text:byte(i) == 32 or text:byte(i) == 9)
    i = i + 1
  text:sub(i, n)

site: bool = (line: str)
  t = trimleft(line)
  if t:len() >= 2 and t:sub(1, 2) == "--"
    return false
  has(line, "@c.emit") or has(line, "@c.include") or has(line, "@comp.c.emit") or has(line, "@comp.c.include")

occur: i64 = (text: str, needle: str)
  total = 0
  start = 1
  while true
    at = text:find(needle, start, true)
    if at == nil
      return total
    total = total + 1
    start = at + needle:len()

sitecount: i64 = (line: str)
  t = trimleft(line)
  if t:len() >= 2 and t:sub(1, 2) == "--"
    return 0
  occur(line, "@c.emit") + occur(line, "@c.include") + occur(line, "@comp.c.emit") + occur(line, "@comp.c.include")

multistart: bool = (line: str)
  site(line) and has(line, "[[") and not has(line, "]]")

countfile: any = (root: str, path: str)
  text = cap("cd '" .. root .. "' && cat '" .. path .. "'")
  rows = lines(text)
  sites = 0
  payload = 0
  inblock = false
  for i = 1, rows:len()
    line = rows(i)
    if inblock
      payload = payload + 1
      if has(line, "]]")
        inblock = false
    else
      got = sitecount(line)
      if got > 0
        sites = sites + got
        payload = payload + 1
        if multistart(line)
          inblock = true
  { sites = sites, payload = payload }

main: i64 = ()
  root = cap("git rev-parse --show-toplevel 2>/dev/null")
  if root == ""
    print("embedledger: fail no git root")
    return 3

  # GAP-220 / GAP-201: the enumeration below reads zero with a stale pathspec
  # or in a tree with no `.git`, and zero is the verdict this file most wants
  # to print. `gate/subject.sh` owns the ruling; ask it where a status is not
  # destroyed by a pipe.
  if cap("cd '{root}' && sh gate/subject.sh '*.id' >/dev/null 2>&1; echo $?") != "0"
    print("embedledger: FAIL subject enumeration is not trustworthy here — GAP-201/GAP-220")
    return 3

  files = lines(cap("cd '" .. root .. "' && git ls-files '*.id' | grep -v '^scripts/census/foreign.id$' | sort"))
  total = 0
  payload = 0
  print("embedledger -- audit (sites by file)")
  for i = 1, files:len()
    path = files(i)
    row = countfile(root, path)
    if row.sites > 0
      print("  {row.sites} sites {row.payload} payload-lines {path}")
      total = total + row.sites
      payload = payload + row.payload

  print("embedledger: enforce zero embedded @c sites for self-hosting")
  if total == 0
    print("embedledger: pass sites 0 payload-lines 0")
    return 0
  print("embedledger: fail sites {total} payload-lines {payload}")
  1
