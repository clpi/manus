# Run idiomgate over a working-tree diff. Idol only — stdin pipe, no --backend=c.
#
# Usage:
#   git diff -U0 -- '*.id' > /tmp/d.diff
#   idol run scripts/idiomgate.id < /tmp/d.diff

transport: str = ()
    text = stdin:read()
    if text == nil
        return ""
    text

main: i64 = ()
    body = transport()
    if body:len() == 0
        print("gates: empty input — pipe a unified diff on stdin")
        print("  git diff -U0 -- '*.id' > /tmp/d.diff")
        print("  idol run scripts/idiomgate.id < /tmp/d.diff")
        return 3
    print("gates: {body:len()} bytes on stdin — run scripts/idiomgate.id for verdict")
    0
