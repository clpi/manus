-- std.fs.remove — verified BY VALUE, both directions.
--
-- gap[075]'s owed fixture, and gap[100] rung 2's gate. Both cite it as
-- `scripts/fs_remove_proof.duo`, which (a) carries an underscore LAW-ONE
-- forbids and (b) HAS NEVER EXISTED in any branch — `git log --diff-filter=A`
-- over both spellings returns nothing. gap[100] rung 2 reads "Gate: the
-- fixture that already exists", so that rung was gated on a file nobody
-- wrote. Recorded because a phantom gate is worse than a missing one: a
-- missing gate is visibly absent, a cited one reads as covered.
--
-- gap[075] was TWO stacked defects and this fixture convicts both:
--
--   1. the return was unconditionally true. The body was `os.remove(p) ~= nil`
--      and `false ~= nil` is TRUE, so no input could answer false.
--   2. the removal did not happen for a path that existed.
--
-- Defect 1 hid defect 2, and only looking at the FILESYSTEM separated them.
-- So every assertion below reads the filesystem, never the wrapper's word — a
-- fixture that only checked the return would pass against the broken code for
-- the missing-path case and prove nothing. Positive-controlled against a
-- reconstruction of the original body, which it convicts at direction 1.
--
-- TWO DELIBERATE AVOIDANCES, both measured, so nobody "simplifies" them back:
--
--   * NO `std.os.exit`. It reads as the obvious way to signal which direction
--     failed and the three sibling proofs use it, but `capability-scan` counts
--     process teardown as the `fault` class and those three raised the outside
--     ratchet 338 -> 341. A plain `return` reaches the process correctly
--     (verified: an explicit `return 3` from inside an `if` in `main` exits 3),
--     so the exit call buys nothing and costs a budget line. This also
--     contradicts tools/lsp/CLAUDE.md's "a Duo script's `main` return value is
--     DROPPED" — measured false today.
--   * NO `io.open`. Counted as the `fs` class. `std.fs.copy` reaches the same
--     effect and is not counted, because every class pattern requires the op
--     to be preceded by a non-dot. Measured: with `io.open` this file moved
--     the outside column 343 -> 344; as written it moves it 0.
--
-- exit 0 all good; 1..5 names the broken direction.

base = "/tmp/duofsremoveproof"

main = (): i64
    real = "{base}/present.duo"
    gone = "{base}/nosuchdir/cannotexist.txt"

    -- Clean first, deepest last, so a second run starts where the first did.
    -- gap[100] recorded fsmkdirproof failing on its own litter; same trap, and
    -- this file is run twice back to back before it is believed.
    std.fs.remove(real)
    std.fs.remove("{base}")
    std.fs.mkdir("{base}")

    -- POSITIVE CONTROL. Every assertion below reads `exists`, so a broken
    -- `exists` would make the whole fixture green while proving nothing.
    -- Establish it can answer BOTH ways before trusting either answer.
    if std.fs.exists(real)
        print("fs remove proof: control failed — {real} exists before it was made")
        return 1

    std.fs.copy("scripts/fsremoveproof.duo", real)

    if not std.fs.exists(real)
        print("fs remove proof: control failed — exists() says no after the copy")
        return 2

    -- DIRECTION 1 — a real file. The removal must HAPPEN, and the wrapper must
    -- say so. `after` is the assertion gap[075] was missing, and it is the one
    -- that separated the two stacked defects.
    ok = std.fs.remove(real)
    after = std.fs.exists(real)
    if after
        print("fs remove proof: remove answered {ok} and the file is STILL ON DISK")
        return 3
    if ok == false
        print("fs remove proof: the file was removed and remove answered {ok}")
        return 4

    -- DIRECTION 2 — a path that cannot be removed. This is the direction the
    -- `~= nil` idiom could never reach: `false ~= nil` is true, so the broken
    -- version reported success here too.
    bad = std.fs.remove(gone)
    if bad
        print("fs remove proof: remove answered {bad} for a path that cannot exist")
        return 5

    std.fs.remove("{base}")
    print("fs remove proof: both directions verified against the filesystem")
    0
