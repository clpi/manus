
work = "/tmp/duo-cfloor"
runs = 5
bound = 100000000

rows = ""
failed = 0

here: str = ()
    std.script.chomp(std.script.capture("pwd"))

quiet: i64 = (cmd: str)
    std.script.status("{cmd} >/dev/null 2>&1")

shell: i64 = (cmd: str)
    std.script.status(cmd)

grab: str = (cmd: str)
    std.script.chomp(std.script.capture(cmd))

note: void = (tag: str, ok: bool, detail: str)
    mark = "FAIL"
    if ok
        mark = "ok  "
    if !ok
        failed += 1
    rows = "{rows}  {mark} {tag}  {detail}\n"

count: i64 = (cmd: str)
    out = grab("{cmd} 2>/dev/null | tr -d ' \\n'")
    n = -1
    if out:len() > 0
        n = to(i64)(out)
    n

explained: bool = (bin: str, src: str, out: str)
    shell("{bin} explain {src} >{out} 2>/dev/null") == 0

slice: bool = (doc: str, name: str, out: str)
    shell("sed 's/\"id\":\"realize.lowering:/\\n@@@/g' {doc} | grep '^@@@{name}\"' >{out} 2>/dev/null") == 0

pick: bool = (blk: str, cand: str, out: str)
    shell("sed 's/\"id\":\"lower\\./\\n###/g' {blk} | grep '^###{cand}\"' >{out} 2>/dev/null") == 0

field: i64 = (path: str, key: str)
    count("grep -o '\"{key}\":[0-9][0-9]*' {path} | head -1 | cut -d: -f2")

holds: bool = (path: str, want: str)
    quiet("grep -q -F '{want}' {path}") == 0

timed: i64 = (cmd: str, n: i64, pos: i64)
    log = "{work}/timed.txt"
    quiet("rm -f {log}")
    i = 0
    while i < n
        shell("/usr/bin/time -p {cmd} >/dev/null 2>>{log}")
        i += 1
    centi = count("grep real {log} | tr -s ' ' | cut -d' ' -f2 | sort -n | head -{pos} | tail -1 | tr -d '.'")
    ms = -1
    if centi >= 0
        ms = centi * 10
    ms

resolved: i64 = (amin: i64, amax: i64, bmin: i64, bmax: i64)
    floor = amax - amin
    if bmax - bmin > floor
        floor = bmax - bmin
    gap = bmin - amin
    verdict = 0
    if gap > floor
        verdict = 1
    if 0 - gap > floor
        verdict = -1
    verdict

main: i64 = ()
    root = here()
    bin = "{root}/zig-out/bin/idol"
    strong = "{root}/examples/cfloor/fact.id"
    weakf = "{root}/examples/cfloor/weak.id"
    quiet("rm -rf {work}")
    quiet("mkdir -p {work}")

    sdoc = "{work}/strong.json"
    wdoc = "{work}/weak.json"
    if !explained(bin, strong, sdoc)
        print("cfloor: FAIL — `duo explain` produced no document for the typed fixture")
        return 3
    if !explained(bin, weakf, wdoc)
        print("cfloor: FAIL — `duo explain` produced no document for the `any` fixture")
        return 3

    lowered = field(sdoc, "lowerings")
    note("P0 control", lowered >= 2, "lowering variables in the plan: {lowered} (mix, main)")
    if lowered < 2
        print(rows)
        print("cfloor: FAIL — the plan holds no lowering variables; nothing below was measured")
        return 3

    baselines = count("grep -o 'C-equivalent lowering (baseline)' {sdoc} | wc -l")
    note("C1 law.c.floor", baselines == lowered,
        "callables carrying a C-equivalent baseline: {baselines} of {lowered}")

    smix = "{work}/strong-mix.json"
    if !slice(sdoc, "mix", smix)
        print("cfloor: FAIL — no `realize.lowering:mix` variable in the typed plan")
        return 3
    stotal = field(smix, "total")
    sviable = field(smix, "viable")
    note("C2 law.c.floor", stotal == 2 and sviable == 2 and holds(smix, "\"baseline\":true"),
        "typed callable keeps both: total={stotal} viable={sviable}")

    snative = "{work}/strong-native.json"
    _ = pick(smix, "native", snative)
    skipped = holds(snative, "\"unseats\":false")
    chosen = holds(smix, "\"choice\":\"lower.cequiv\"")
    kept = holds(smix, "\"retained\":true")
    missing = field(snative, "missing")
    compared = field(snative, "compared")
    note("F1 law.perf.floor", chosen and kept and skipped and missing == 12 and compared == 0,
        "floor retained; why(skip): relation=insufficient compared={compared} missing={missing} of 12 · unseats=false")

    wmix = "{work}/weak-mix.json"
    if !slice(wdoc, "mix", wmix)
        print("cfloor: FAIL — no `realize.lowering:mix` variable in the `any` plan")
        return 3
    wtotal = field(wmix, "total")
    wviable = field(wmix, "viable")
    note("D1 law.perf.dominance", wtotal == stotal and wtotal == 2,
        "candidate set across the fact: {wtotal} -> {stotal} (must not fall)")
    note("D2 control", wviable == 1 and sviable == 2,
        "the fact was not inert: viable {wviable} -> {sviable}")

    wdirect = quiet("{bin} compile {weakf} --backend=direct -o {work}/w.bin")
    sdirect = quiet("{bin} compile {strong} --backend=direct -o {work}/s.bin")
    note("D3 plan vs world", wdirect != 0 and sdirect == 0,
        "--backend=direct refuses the `any` version ({wdirect}) and accepts the typed one ({sdirect})")

    _ = quiet("{bin} compile {strong} -o {work}/sc.bin")
    adirect = grab("{work}/s.bin")
    acequiv = grab("{work}/sc.bin")
    aoracle = grab("awk 'BEGIN{ a=1; for(i=0;i<{bound};i++){ a=(a*31+i)%1000003 } print a }'")
    agreed = adirect == acequiv and adirect == aoracle and adirect:len() > 0
    note("M0 same answer", agreed,
        "direct={adirect} c-equivalent={acequiv} awk-oracle={aoracle}")
    if !agreed
        print(rows)
        print("cfloor: FAIL — the two lowerings and the oracle disagree; no speed number is comparable")
        return 1

    cdirect = timed("{bin} compile {strong} --backend=direct -o {work}/s.bin", 3, 1)
    ccequiv = timed("{bin} compile {strong} -o {work}/sc.bin", 3, 1)
    note("M1 compile", cdirect > 0 and ccequiv > 0,
        "direct={cdirect}ms  c-equivalent={ccequiv}ms  (published, not gated: observed in BOTH orders across runs)")

    zdirect = count("wc -c < {work}/s.bin")
    zcequiv = count("wc -c < {work}/sc.bin")
    note("M2 size", zdirect > 0 and zcequiv > 0,
        "direct={zdirect}B  c-equivalent={zcequiv}B")

    dmin = timed("{work}/s.bin", runs, 1)
    dmax = timed("{work}/s.bin", runs, runs)
    emin = timed("{work}/sc.bin", runs, 1)
    emax = timed("{work}/sc.bin", runs, runs)
    verdict = resolved(dmin, dmax, emin, emax)
    label = "UNRESOLVED — the gap is inside the run-to-run spread; no win credited"
    if verdict == 1
        label = "the direct lowering is resolvably faster"
    if verdict == -1
        label = "the C-EQUIVALENT lowering is resolvably faster; the floor is earning its keep"
    note("M3 latency", dmin > 0 and emin > 0,
        "direct={dmin}..{dmax}ms  c-equivalent={emin}..{emax}ms")
    rows = "{rows}       verdict  {label}\n"

    fires = resolved(100, 110, 500, 520) == 1
    declines = resolved(430, 620, 530, 730) == 0
    note("M4 control", fires and declines,
        "separated pair resolves={fires}  overlapping pair declines={declines}")

    print("law.c.floor — constitution §47, plan and measurement")
    print(rows)
    print("  comparison: idol's DIRECT lowering vs idol's own C-EQUIVALENT lowering.")
    print("  awk is the answer oracle only. No idol-vs-C claim is made here.")
    print("  cost facts the compiler attaches to either candidate today: 0 of 12.")
    if failed > 0
        print("cfloor: FAIL ({failed} rows)")
        return 1
    print("cfloor: PASS")
    0
