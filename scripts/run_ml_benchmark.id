
_RUNS = 5
_SLACK = 1.05
_BENCHES = 5
_NAMES = { "matmul_256", "conv2d", "softmax_1k", "attention", "mlp_forward" }
_WORK = "/tmp/duo_ml_bench"

_env_or: str = (n: str, d: str)
  v = script.getenv_or(n)
  if v == ""
    return d
  v

_pad: str = (s: str, w: i64)
  o = s
  while o:len() < w
    o = o .. " "
  o

_lpad: str = (s: str, w: i64)
  o = s
  while o:len() < w
    o = " " .. o
  o

_fx: str = (x: f64, places: i64)
  scale = 1
  i = 0
  while i < places
    scale = scale * 10
    i = i + 1
  n = to(i64)(x * to(f64)(scale) + 0.5)
  whole = n / scale
  frac = n % scale
  fs = frac:to(str)
  while fs:len() < places
    fs = "0" .. fs
  whole:to(str) .. "." .. fs

_numeric: bool = (s: str)
  if s == ""
    return false
  d = false
  i = 1
  while i <= s:len()
    c = s:sub(i, i)
    if c >= "0" and c <= "9"
      d = true
    else
      if c != "." and c != "-" and c != "+" and c != "e" and c != "E"
        return false
    i = i + 1
  d

_fields: any = (line: str)
  out = {}
  for _i, w in line:gsub("\t", " "):split(" ")
    if w != ""
      out(out:len() + 1) = w
  out

_lines: any = (t: str)
  out = {}
  for _i, l in t:split("\n")
    c = script.chomp(l)
    if c != ""
      out(out:len() + 1) = c
  out

_results: any = (text: str)
  r = {}
  n = 0
  for _i, l in _lines(text)
    f = _fields(l)
    if f:len() >= 3 and f(1) == "RESULT"
      r(f(2)) = f(3)
      n = n + 1
  r("__count") = n:to(str)
  r

_times: any = (text: str)
  t = {}
  cur = ""
  for _i, l in _lines(text)
    f = _fields(l)
    if f:len() >= 2 and f(1) == "Running"
      cur = f(2):gsub("%.%.%.", "")
    if f:len() >= 2 and f(1) == "Time:" and cur != "" and _numeric(f(2))
      t(cur) = to(f64)(f(2))
  t

main: i64 = ()
  duo = "./zig-out/bin/idol"
  cc = _env_or("CC", "clang")
  runs = to(i64)(_env_or("RUNS", _RUNS:to(str)))
  if runs == nil or runs < 1
    runs = _RUNS

  print("========================================")
  print("     ML BENCHMARK: Duo vs C             ")
  print("========================================")

  if not script.fs_exists(duo)
    print("Building Duo compiler...")
    if script.run(_env_or("ZIG", "zig") .. " build") != 0
      return 1

  script.run("rm -rf " .. _WORK .. " && mkdir -p " .. _WORK)
  duo_bin = _WORK .. "/duo_ml_bench"
  c_bin = _WORK .. "/c_ml_bench"

  print("Compiling bench_ml.id...")
  if script.run(duo .. " compile examples/bench_ml.id -o " .. duo_bin) != 0
    print("ml_benchmark: FAIL — bench_ml.id did not compile")
    return 1

  print("Compiling bench_ml_c.c...")
  sdk = script.chomp(script.capture("xcrun --sdk macosx --show-sdk-path 2>/dev/null"))
  if script.run("SDKROOT=" .. sdk .. " " .. cc .. " -O3 -ffast-math -march=native -flto -lm -o " .. c_bin .. " examples/bench_ml_c.c") != 0
    print("ml_benchmark: FAIL — bench_ml_c.c did not compile")
    return 1

  print("")
  print("--- Correctness Check ---")

  dres = _results(script.capture(duo_bin .. " 2>/dev/null"))
  cres = _results(script.capture(c_bin .. " 2>/dev/null"))

  for _i, pair in { { "Duo", dres }, { "C", cres } }
    if pair(2)("__count") != _BENCHES:to(str)
      print(pair(1) .. " correctness run emitted " .. pair(2)("__count") .. " RESULT row(s), expected " .. _BENCHES:to(str))
      return 1

  bad = 0
  for _i, name in _NAMES
    d = dres(name)
    c = cres(name)
    if d == nil or c == nil
      print("MISMATCH: " .. name .. " missing from one side")
      bad = bad + 1
    else
      dv = to(f64)(d)
      cv = to(f64)(c)
      diff = dv - cv
      if diff < 0.0
        diff = -diff
      denom = cv
      if denom < 0.0
        denom = -denom
      if denom < 0.0000000001
        denom = 1.0
      if diff / denom < 0.0001
        print("  OK: " .. name .. " = " .. d)
      else
        print("MISMATCH: " .. name .. ": Duo=" .. d .. " vs C=" .. c)
        bad = bad + 1
  if bad != 0
    print("")
    print("ML BENCHMARK: FAIL — " .. bad:to(str) .. " result(s) differ from C")
    return 1

  print("")
  print("All " .. _BENCHES:to(str) .. " results match.")
  print("")
  print("--- Timing (" .. runs:to(str) .. " runs each) ---")
  print("")

  dmin = {}
  cmin = {}
  print("Running Duo (" .. runs:to(str) .. " times)...")
  r = 0
  while r < runs
    for k, v in _times(script.capture(duo_bin .. " 2>/dev/null"))
      if dmin(k) == nil or v < dmin(k)
        dmin(k) = v
    r = r + 1
  print("Running C (" .. runs:to(str) .. " times)...")
  r = 0
  while r < runs
    for k, v in _times(script.capture(c_bin .. " 2>/dev/null"))
      if cmin(k) == nil or v < cmin(k)
        cmin(k) = v
    r = r + 1

  print("")
  print("--- Results (min of " .. runs:to(str) .. " runs) ---")
  print("")
  print(_pad("Benchmark", 16) .. " " .. _lpad("Duo(s)", 12) .. " " .. _lpad("C(s)", 12) .. " " .. _lpad("Ratio", 10))
  print(_pad("----------------", 16) .. " " .. _lpad("------------", 12) .. " " .. _lpad("------------", 12) .. " " .. _lpad("----------", 10))

  timing_fail = 0
  for _i, name in _NAMES
    d = dmin(name)
    c = cmin(name)
    if d == nil or c == nil
      print(_pad(name, 16) .. " " .. _lpad("no Time reported", 36))
      timing_fail = timing_fail + 1
    else
      ratio = "N/A"
      if c > 0.0
        ratio = _fx(d / c, 3) .. "x"
      print(_pad(name, 16) .. " " .. _lpad(_fx(d, 6), 12) .. " " .. _lpad(_fx(c, 6), 12) .. " " .. _lpad(ratio, 10))
      if d > c * _SLACK
        print("  *** WARN: Duo (" .. _fx(d, 6) .. ") slower than C (" .. _fx(c, 6) .. ") — optimization target")
        timing_fail = timing_fail + 1

  print("")
  if timing_fail > 0
    print("ML BENCHMARK: " .. timing_fail:to(str) .. " workload(s) slower than C (optimization targets).")
    print("  (Core 40-benchmark gate: zig build bench)")
    return 0
  print("ALL ML BENCHMARKS PASSED: Duo beats or ties C on all ML workloads.")
  0
