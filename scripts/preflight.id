# scripts/preflight.id — commit admission in Idol only.
# Git hook: exec idol run scripts/preflight.id [source-zero BASE]
# No bash gate wrappers. No gatepath embedding. No --backend=c.

command: any = (line: str)
    { line = line }

capture: str = (line: str)
    c = command(line)
    stream = c:open("r")
    if stream == nil
        return ""
    text = stream:read("*a")
    if text == nil
        return ""
    stream:close()
    chomp(text)

status: i64 = (cmd: str)
    to(i64)(capture("( {cmd} ) >/dev/null 2>&1; echo $?"))

chomp: str = (text: str)
    if text == nil
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

quote: str = (text: str)
    if text == nil
        return "''"
    "'{text:gsub(\"'\", \"'\\\\''\")}'"

root: str = ()
    chomp(capture("git rev-parse --show-toplevel"))

idol: str = ()
    repo = root()
    if repo:len() == 0
        return ""
    bin = "{repo}/zig-out/bin/idol"
    if status("test -x {quote(bin)}") == 0
        return bin
    bin = "{repo}/zig-out/bin/duo"
    if status("test -x {quote(bin)}") == 0
        return bin
    ""

put: bool = (path: str, body: str)
    content = body
    if content == nil
        content = ""
    f = io:open(path, "w")
    if f == nil
        return false
    f:write(content)
    f:close()
    true

run: i64 = (gate: str, inpath: str)
    exe = idol()
    repo = root()
    target = "{repo}/{gate}"
    cmd = "{quote(exe)} run {quote(target)}"
    if inpath != nil and inpath:len() > 0
        cmd = "{cmd} < {quote(inpath)}"
    status(cmd)

emit: void = (prefix: str, text: str)
    n = text:len()
    i = 1
    while i <= n
        j = i
        while j <= n and text:byte(j) != 10
            j += 1
        line = text:sub(i, j - 1)
        if line:len() > 0
            print("{prefix}{line}")
        i = j + 1

zero: i64 = (phase: str, base: str)
    if phase == "staged"
        text = capture("git diff --cached --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo'")
        if chomp(text):len() > 0
            print("SOURCE-ZERO: new .duo paths are forbidden; canonical source is .id:")
            emit("  ", chomp(text))
            return 1
        return 0
    if phase == "range"
        if status("git rev-parse --verify " .. quote(base) .. "^commit >/dev/null") != 0
            print("SOURCE-ZERO: base revision unavailable — admission blocked.")
            return 1
        text = capture("git diff {quote(base)} HEAD --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo'")
        if chomp(text):len() > 0
            print("SOURCE-ZERO: this revision range adds forbidden .duo paths:")
            emit("  ", chomp(text))
            return 1
        return 0
    if phase == "worktree"
        text = capture("git diff --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo'")
        if chomp(text):len() > 0
            print("SOURCE-ZERO: worktree .duo additions are admission failures:")
            emit("  ", chomp(text))
            return 1
        text = capture("git ls-files --others -- ':(icase,glob)**/*.duo'")
        if chomp(text):len() > 0
            print("SOURCE-ZERO: untracked .duo paths are admission failures:")
            emit("  ", chomp(text))
            return 1
        return 0
    1

main: i64 = ()
    mode = os.args[1]
    base = os.args[2]

    if idol():len() == 0
        print("canonical preflight: idol not built — commit blocked.")
        return 1

    if zero("staged", "") != 0
        return 1

    if mode == "source-zero"
        if base == nil or base:len() == 0
            print("SOURCE-ZERO: invalid admission invocation — blocked.")
            return 1
        if zero("range", base) != 0
            return 1
        if zero("worktree", "") != 0
            return 1
        return 0

    scratch = "/tmp/idol/preflight"
    idiom = "{scratch}/idiom.diff"
    host = "{scratch}/host.diff"
    list = "{scratch}/paths.txt"
    names = "{scratch}/names.diff"
    track = "{scratch}/tree.txt"
    path = "{scratch}/path.txt"

    capture("git diff --cached -U0 --diff-filter=ACM -- '*.id' '*.duo' > {quote(idiom)}")
    if status("test -s {quote(idiom)}") == 0
        rc = run("scripts/idiomgate.id", idiom)
        if rc != 0
            print("")
            print("COMMIT BLOCKED — every finding above is on a line THIS DIFF ADDS.")
            print("Inherited debt in the same file is not gated; only what you write is.")
            return 1

    capture("git diff --cached -U0 --diff-filter=ACM -- '*.id' '*.zig' '*.md' '*.mdc' 'AGENTS.md' 'CLAUDE.md' 'README.md' 'build.zig' '.cursor/rules/*.mdc' '.githooks/*' 'gates/*' 'scripts/*' > {quote(host)}")
    if status("test -s {quote(host)}") == 0
        rc = run("gates/host.id", host)
        if rc != 0
            print("")
            print("COMMIT BLOCKED — gates/host found new host API debt on staged additions.")
            print("Host APIs belong at ingress/egress only — docs/spec/host.md · GAP-155.")
            return 1

    rc = run("scripts/semanticgate.id", "")
    if rc != 0
        print("")
        print("COMMIT BLOCKED — semantic canonicality is part of correctness.")
        print("Repair or explicitly classify the semantic debt; do not suppress it.")
        return 1

    capture("git diff --cached --name-only --diff-filter=AR > {quote(list)}")
    capture("git diff --cached -U0 --diff-filter=ACM -- '*.id' '*.zig' '*.md' '*.mdc' 'AGENTS.md' 'CLAUDE.md' 'README.md' 'build.zig' '.cursor/rules/*.mdc' '.githooks/*' 'gates/*' > {quote(names)}")
    if status("test -s {quote(list)}") == 0 or status("test -s {quote(names)}") == 0
        paths = ""
        if status("test -s {quote(list)}") == 0
            paths = list:read()
        added = ""
        if status("test -s {quote(names)}") == 0
            added = names:read()
        body = "IDOLGATE staged\n{paths}\nIDOLGATE namediff\n{added}\nIDOLGATE end\n"
        put(path, body)
        rc = run("gates/path.id", path)
        if rc != 0
            print("")
            print("COMMIT BLOCKED — gates/path found invalid names on staged paths or added lines.")
            print("LAW-ONE applies to paths, identifiers, and prose tokens alike; do not mash compounds.")
            return 1

    capture("git ls-files > {quote(track)}")
    listing = track:read()
    if listing == nil
        listing = ""
    body = "IDOLGATE tree\n{listing}\nIDOLGATE end\n"
    put(path, body)
    rc = run("gates/path.id", path)
    if rc != 0
        print("")
        print("COMMIT BLOCKED — tracked tree still carries mashed compound or separator path debt.")
        print("Decompose owners into nested homes (scripts/proof/str.id), never strproof.id.")
        return 1

    0
