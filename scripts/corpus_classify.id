# corpus_classify — re-derive the .id corpus classification, and report what
# the classification is NOT confident about.
#
# The rules live in ONE place: `docs/spec/corpus.md`. This file does not
# restate them, it reads them. Adding a class rule here instead of there would
# give the repo two edges for one fact, which is the failure mode the manifest
# exists to avoid.
#
# WHY THIS IS SEPARATE FROM audit100. audit100 ENFORCES the deny table over the
# canonical partition; it needs the partition and stops there. This gate
# ADJUDICATES the partition itself: it regenerates the per-file manifest
# (`docs/corpus_manifest.md`) and, more usefully, names the files whose class
# came from a policy default rather than from evidence. A classification nobody
# re-derives rots into a list of paths that used to be true.
#
# THREE THINGS IT MEASURES
#
#   1. COUNTS PER CLASS, plus the count per RULE. A rule that matches zero
#      files is dead — either the files moved or the rule was aspirational.
#      Dead rules are printed, because a manifest whose rules no longer bind is
#      how a partition drifts without anyone noticing.
#
#   2. TIER. How much of the path a rule actually pins:
#        exact    the rule names the file             — an adjudication
#        family   the rule pins two or more segments  — a purpose
#        default  the rule pins one segment           — a POLICY, not evidence
#      `examples/ -> historical` is a default over 250+ files. That is a
#      defensible policy and it is also the single largest unexamined claim in
#      the manifest, so it is reported as such rather than counted as known.
#
#   3. CONTRADICTIONS — where the class and the evidence disagree. These are
#      the finding; the counts are just the frame.
#        C1  historical, but a gate references it. "Unmaintained" is false for
#            a file `build.zig` runs. Either the class or the gate is wrong.
#        C2  canonical, no inbound reference, and outside lib/. The stdlib is
#            reached by `req`, so absence of a build.zig mention proves nothing
#            there — but a `tools/` or `scripts/` file nothing runs is scratch
#            sitting inside the partition the deny table is enforced against.
#        C3  canonical, but the file carries a generator marker. `generated`
#            exists precisely so the fix lands in the generator.
#        C4  canonical, but the file embeds C, Lua or another language. Named,
#            not failed: `lib/std` embedding C is sanctioned, while
#            `examples/c_emit_*` is classified `foreign` for doing the same
#            thing. The inconsistency is real and belongs in the open.
#
# SELF-EXCLUSION. This file is kept out of its own reference haystack. Its text
# contains corpus paths as DATA; a walker that greps for the names it prints
# reports itself. GAP-16 cost this repo a day on exactly that shape.
#
# POSITIVE CONTROL. Every zero here is checked before it is believed: no rules,
# no files, no canonical set, or an empty reference haystack all exit 3. A
# confident 0 from a gate run in the wrong directory is this repo's most
# expensive recurring bug.
#
# Exit 0 pass · 1 a tracked file matches no rule · 3 the gate could not run.
#
# CORPUS_CLASSIFY_EMIT=1   print one `class tier ref path` row per file, which
#                          is what regenerates docs/corpus_manifest.md.

# Canonical spelling, 2026-08-08. The helpers used to carry `_` prefixes and the
# reports used to be `..` ladders; both are §1 deny rows that `audit100`
# ratchets, and this file held 58 of one and 52 of the other. The behaviour is
# unchanged and was checked that way: the full report and the
# CORPUS_CLASSIFY_EMIT manifest were captured before and after and are
# byte-identical.

here = "scripts/corpus_classify.id"
listing = "/tmp/duo_corpus_classify.list"
haystack = "/tmp/duo_corpus_classify.hay"
needles = "/tmp/duo_corpus_classify.pat"

cut(s: str): any
    out = {}
    n: i64 = s:len()
    start: i64 = 1
    i: i64 = 1
    while i <= n
        if s:byte(i) == 10
            if i > start
                out[out:len() + 1] = s:sub(start, i - 1)
            end
            start = i + 1
        end
        i += 1
    end
    if start <= n
        out[out:len() + 1] = s:sub(start, n)
    end
    out
end

starts(s: str, prefix: str): bool
    #s >= #prefix and s:sub(1, #prefix) == prefix
end

ends(s: str, suffix: str): bool
    #s >= #suffix and s:sub(#s - #suffix + 1, #s) == suffix
end

# Whitespace-separated field n (1-based) of a line, "" when absent. `seen` only
# ever increases, so the first field that matches `want` is the only one that
# can, and the answer is carried to the tail rather than returned early.
field(line: str, want: i64): str
    out: str = ""
    n: i64 = line:len()
    i: i64 = 1
    seen: i64 = 0
    while i <= n
        b: i64 = line:byte(i)
        if b != 32 and b != 9
            seen += 1
            start: i64 = i
            while i <= n and line:byte(i) != 32 and line:byte(i) != 9
                i += 1
            end
            if seen == want
                out = line:sub(start, i - 1)
            end
        else
            i += 1
        end
    end
    out
end

known(c: str): bool
    c == "canonical" or c == "compatibility" or c == "foreign"
        or c == "negative" or c == "historical" or c == "generated"
end

base(p: str): str
    out: str = p
    i: i64 = p:len()
    while i > 0
        if p:byte(i) == 47
            out = p:sub(i + 1, p:len())
            i = 0
        else
            i -= 1
        end
    end
    out
end

parent(p: str): str
    out: str = ""
    i: i64 = p:len()
    while i > 0
        if p:byte(i) == 47
            out = p:sub(1, i - 1)
            i = 0
        else
            i -= 1
        end
    end
    out
end

depth(prefix: str): i64
    n: i64 = prefix:len()
    i: i64 = 1
    c: i64 = 0
    while i <= n
        if prefix:byte(i) == 47
            c += 1
        end
        i += 1
    end
    c
end

# How much of the path the rule pins. See the header: `default` means the
# class came from a policy over a whole top-level tree, not from evidence
# about the file.
tier(prefix: str): str
    out: str = "family"
    if ends(prefix, ".id")
        out = "exact"
    elseif depth(prefix) <= 1 and ends(prefix, "/")
        out = "default"
    end
    out
end

pad(s: str, width: i64): str
    out: str = s
    while out:len() < width
        out = "{out} "
    end
    out
end

# One shell round trip; the caller decides whether an empty answer is fatal.
shell(cmd: str): str
    std.script.capture(cmd)
end

main(): i64
    root: str = std.script.chomp(shell("git rev-parse --show-toplevel 2>/dev/null"))
    if root == ""
        print("corpus_classify: FAIL — not inside a git work tree; the corpus cannot be listed")
        return 3
    end
    print("corpus_classify — docs/spec/corpus.md, re-derived over the tracked corpus")
    print("  root      {root}")

    spec: str = "{root}/docs/spec/corpus.md"
    if !std.script.fs_exists(spec)
        print("corpus_classify: FAIL — missing {spec}")
        return 3
    end

    # Rules as parallel arrays: first match wins, order as written.
    rcls = {}
    rpre = {}
    rpin = {}
    rhit = {}
    for i, line in cut(std.script.fs_read(spec))
        c: str = field(line, 1)
        p: str = field(line, 2)
        if known(c) and p != "" and field(line, 3) == ""
            rcls[rcls:len() + 1] = c
            rpre[rpre:len() + 1] = p
            rpin[rpin:len() + 1] = tier(p)
            rhit[rhit:len() + 1] = 0
        end
    end
    if rcls:len() == 0
        print("corpus_classify: FAIL — docs/spec/corpus.md yielded 0 rules; the parse is broken")
        return 3
    end
    nrules: str = to(str)(rcls:len())
    print("  rules     {nrules} from docs/spec/corpus.md")

    files = cut(shell("cd {root} && git ls-files '*.id'"))
    if files:len() == 0
        print("corpus_classify: FAIL — git ls-files found 0 .id files; the census did not run")
        return 3
    end

    # The reference haystack: what a gate could plausibly run. build.zig and
    # CI are the entry points; scripts/*.id are the gates themselves. This
    # file is excluded from it (see SELF-EXCLUSION in the header).
    #
    # The group is a SUBSHELL, not a `{ …; }` brace group: a brace in a string
    # literal is an interpolation hole, and `{ cat build.zig` would
    # be read as one. `( … )` groups identically for a redirect.
    shell("cd {root} && ( cat build.zig 2>/dev/null; git ls-files 'scripts/*.id' | grep -v corpus_classify | tr '\\n' '\\0' | xargs -0 cat 2>/dev/null; find .github -type f 2>/dev/null | tr '\\n' '\\0' | xargs -0 cat 2>/dev/null; ) > {haystack}")
    haybytes: i64 = to(i64)(std.script.chomp(shell("wc -c < {haystack} 2>/dev/null")))
    if haybytes == 0
        print("corpus_classify: FAIL — reference haystack is empty; every UNREF would be a lie")
        return 3
    end

    # One grep for every name, rather than one grep per file. Paths and bare
    # basenames both count as a reference.
    # Paths, bare basenames, AND parent directories. The directory matters:
    # `scripts/native_differential.id` walks a whole folder, so every fixture
    # in it is run by name-less enumeration. Counting only filenames would
    # report 60-odd live gate fixtures as dead scratch.
    pats: str = ""
    for i, f in files
        b: str = base(f)
        pats = "{pats}{f}\n{b}\n"
        # Only NESTED directories, and every one of them up the chain. A bare
        # top-level name like `examples` or `lib` occurs in unrelated prose and
        # would mark the whole tree live, so it is excluded.
        d: str = parent(f)
        while depth(d) >= 1
            pats = "{pats}{d}\n"
            d = parent(d)
        end
    end
    std.script.fs_write(needles, pats)
    refs = {}
    for i, h in cut(shell("grep -o -F -f {needles} {haystack} 2>/dev/null | sort -u"))
        refs[h] = 1
    end

    # A subtree carrying its own `build.id` is an APPLICATION. It is reached
    # by its own build entry point, not by duo's gates, so "no inbound
    # reference from build.zig" says nothing about it. Derived, not listed:
    # adding another in-tree app must not require editing this gate.
    approot = {}
    napp = 0
    for i, f in files
        if base(f) == "build.id"
            d: str = parent(f)
            if d != ""
                approot[d] = 1
                napp += 1
            end
        end
    end
    napps: str = napp:to(str)
    print("  apps      {napps} in-tree application roots (own build.id)")

    ncanon = 0
    ncompat = 0
    nforeign = 0
    nneg = 0
    nhist = 0
    ngen = 0
    nnone = 0
    texact = 0
    tfamily = 0
    tdefault = 0
    unclassified: str = ""
    canon: str = ""
    c1: str = ""
    nc1 = 0
    c2: str = ""
    nc2 = 0
    emit: bool = script.getenv("CORPUS_CLASSIFY_EMIT", "") != ""
    rows: str = ""

    for i, f in files
        cls: str = ""
        pin: str = ""
        j: i64 = 1
        while j <= rpre:len() and cls == ""
            if starts(f, rpre[j])
                cls = rcls[j]
                pin = rpin[j]
                rhit[j] = rhit[j] + 1
            end
            j += 1
        end

        referenced: bool = refs[f] == 1 or refs[base(f)] == 1
        fdir: str = parent(f)
        while depth(fdir) >= 1
            if refs[fdir] == 1
                referenced = true
            end
            fdir = parent(fdir)
        end
        mark: str = "UNREF"
        if referenced
            mark = "REF"
        end

        if cls == "canonical"
            ncanon += 1
            if f != here
                canon = "{canon}{root}/{f}\n"
            end
            # C2: scratch inside the enforced partition. Two exemptions, both
            # earned: lib/ is reached by `req` so build.zig never names it,
            # and an application subtree is reached by its own build.id.
            inapp: bool = false
            adir: str = parent(f)
            while adir != ""
                if approot[adir] == 1
                    inapp = true
                end
                adir = parent(adir)
            end
            if !referenced and !starts(f, "lib/") and !inapp
                nc2 += 1
                if nc2 <= 12
                    c2 = "{c2}    {f}\n"
                end
            end
        elseif cls == "compatibility"
            ncompat += 1
        elseif cls == "foreign"
            nforeign += 1
        elseif cls == "negative"
            nneg += 1
        elseif cls == "historical"
            nhist += 1
            # C1: "unmaintained past-epoch evidence" that a gate still runs.
            if referenced
                nc1 += 1
                if nc1 <= 12
                    c1 = "{c1}    {f}\n"
                end
            end
        elseif cls == "generated"
            ngen += 1
        else
            nnone += 1
            if nnone <= 12
                unclassified = "{unclassified}    {f}\n"
            end
        end

        if pin == "exact"
            texact += 1
        elseif pin == "family"
            tfamily += 1
        elseif pin == "default"
            tdefault += 1
        end

        if emit
            cell: str = pad(cls, 15)
            pincell: str = pad(pin, 9)
            refcell: str = pad(mark, 7)
            rows = "{rows}{cell}{pincell}{refcell}{f}\n"
        end
    end

    nfiles: str = to(str)(files:len())
    scanon: str = ncanon:to(str)
    scompat: str = ncompat:to(str)
    sforeign: str = nforeign:to(str)
    sneg: str = nneg:to(str)
    shist: str = nhist:to(str)
    sgen: str = ngen:to(str)
    print("")
    print("corpus census ({nfiles} tracked .id files)")
    print("  canonical      {scanon}   deny table applies")
    print("  compatibility  {scompat}   Lua-superset input")
    print("  foreign        {sforeign}   embeds another language, or vendored")
    print("  negative       {sneg}   denied text IS the assertion")
    print("  historical     {shist}   past-epoch evidence, unmaintained")
    print("  generated      {sgen}   fix the generator, not the file")

    if nnone != 0
        snone: str = nnone:to(str)
        print("")
        print("corpus_classify: FAIL — {snone} tracked .id files match no rule in docs/spec/corpus.md:")
        io:write(unclassified)
        print("  Classify them; there is deliberately no silent default.")
        return 1
    end

    if ncanon == 0
        print("corpus_classify: FAIL — canonical partition is empty; the rules cannot be right")
        return 3
    end

    sexact: str = texact:to(str)
    sfamily: str = tfamily:to(str)
    sdefault: str = tdefault:to(str)
    print("")
    print("how much of each path the rule pins")
    print("  exact          {sexact}   the rule names the file")
    print("  family         {sfamily}   the rule pins a purpose (2+ segments)")
    print("  default        {sdefault}   the rule pins one top-level tree — POLICY, not evidence")

    print("")
    print("rules, in order (first match wins)")
    print("  class          tier     files   prefix")
    dead = 0
    k: i64 = 1
    while k <= rpre:len()
        flag: str = "  "
        if rhit[k] == 0
            flag = "!!"
            dead += 1
        end
        cell: str = pad(rcls[k], 14)
        pincell: str = pad(rpin[k], 9)
        hits: str = pad(to(str)(rhit[k]), 8)
        pre: str = rpre[k]
        print("  {flag} {cell}{pincell}{hits}{pre}")
        k += 1
    end
    if dead != 0
        sdead: str = dead:to(str)
        print("  !! {sdead} rule(s) match nothing. A rule that binds no file is not a rule.")
    end

    # C3 and C4 read the canonical partition's CONTENT, so they need the list.
    std.script.fs_write(listing, canon)
    listed: i64 = to(i64)(std.script.chomp(shell("wc -l < {listing}")))
    if listed == 0
        print("corpus_classify: FAIL — canonical list is empty on disk; the content checks cannot run")
        return 3
    end
    q: str = "'"
    marker: str = "tr '\\n' '\\0' < {listing} | xargs -0 grep -l -i -E {q}generated by|do not edit|auto-generated{q} 2>/dev/null"
    nc3: i64 = to(i64)(std.script.chomp(shell("{marker} | grep -c . || true")))
    c3: str = shell("{marker} | sed {q}s|{root}/||{q} | head -12")
    embeds: str = "tr '\\n' '\\0' < {listing} | xargs -0 grep -l -E {q}@c\\.emit|@comp\\.c\\.emit|@lua\\(|@foreign\\(|@ffi\\({q} 2>/dev/null"
    nc4: i64 = to(i64)(std.script.chomp(shell("{embeds} | grep -c . || true")))

    sc1: str = nc1:to(str)
    sc2: str = nc2:to(str)
    sc3: str = nc3:to(str)
    sc4: str = nc4:to(str)
    print("")
    print("contradictions — where the class and the evidence disagree")
    print("  C1  historical yet gate-referenced       {sc1}")
    if nc1 != 0
        io.write(c1)
        print("      (first 12; \"unmaintained\" is false for a file build.zig runs)")
    end
    print("  C2  canonical, unreferenced, outside lib {sc2}")
    if nc2 != 0
        io:write(c2)
        print("      (first 12; scratch inside the partition the deny table enforces)")
    end
    print("  C3  canonical yet carries a generator marker  {sc3}")
    if nc3 != 0
        io:write(c3)
    end
    print("  C4  canonical yet embeds another language     {sc4}")
    print("      (named, not failed: lib/std embedding C is sanctioned, while")
    print("       examples/c_emit_* is `foreign` for the same act — one of these is wrong)")

    if emit
        io:write("\n-- MANIFEST ROWS (class tier ref path) --\n")
        io:write(rows)
    end

    print("")
    print("corpus_classify: PASS — {nfiles} files, 0 unclassified, {sdefault} resolved by a top-level policy default")
    0
end
