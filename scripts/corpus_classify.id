

here = "scripts/corpus_classify.id"
listing = "/tmp/duo_corpus_classify.list"
haystack = "/tmp/duo_corpus_classify.hay"
needles = "/tmp/duo_corpus_classify.pat"

cut: any = (s: str)
  out = {}
  n: i64 = s:len()
  start: i64 = 1
  i: i64 = 1
  while i <= n
    if s:byte(i) == 10
      if i > start
        out(out:len() + 1) = s:sub(start, i - 1)
      start = i + 1
    i = i + 1
  if start <= n
    out(out:len() + 1) = s:sub(start, n)
  out

starts: bool = (s: str, prefix: str)
  void

ends: bool = (s: str, suffix: str)
  void

field: str = (line: str, want: i64)
  out: str = ""
  n: i64 = line:len()
  i: i64 = 1
  seen: i64 = 0
  while i <= n
    b: i64 = line:byte(i)
    if b != 32 and b != 9
      seen = seen + 1
      start: i64 = i
      while i <= n and line:byte(i) != 32 and line:byte(i) != 9
        i = i + 1
      if seen == want
        out = line:sub(start, i - 1)
    else
      i = i + 1
  out

known: bool = (c: str)
  c == "canonical" or c == "compatibility" or c == "foreign" or c == "negative" or c == "historical" or c == "generated"

base: str = (p: str)
  out: str = p
  i: i64 = p:len()
  while i > 0
    if p:byte(i) == 47
      out = p:sub(i + 1, p:len())
      i = 0
    else
      i = i - 1
  out

parent: str = (p: str)
  out: str = ""
  i: i64 = p:len()
  while i > 0
    if p:byte(i) == 47
      out = p:sub(1, i - 1)
      i = 0
    else
      i = i - 1
  out

depth: i64 = (prefix: str)
  n: i64 = prefix:len()
  i: i64 = 1
  c: i64 = 0
  while i <= n
    if prefix:byte(i) == 47
      c = c + 1
    i = i + 1
  c

tier: str = (prefix: str)
  out: str = "family"
  if ends(prefix, ".id")
    out = "exact"
  else(depth(prefix) <= 1 and ends(prefix, "/"))
    out = "default"
  out

pad: str = (s: str, width: i64)
  out: str = s
  while out:len() < width
    out = "{out} "
  out

shell: str = (cmd: str)
  std.script.capture(cmd)

main: i64 = ()
  root: str = std.script.chomp(shell("git rev-parse --show-toplevel 2>/dev/null"))
  if root == ""
    print("corpus_classify: FAIL — not inside a git work tree; the corpus cannot be listed")
    return 3
  print("corpus_classify — docs/spec/corpus.md, re-derived over the tracked corpus")
  print("  root      {root}")

  spec: str = "{root}/docs/spec/corpus.md"
  if not std.script.fs_exists(spec)
    print("corpus_classify: FAIL — missing {spec}")
    return 3

  rcls = {}
  rpre = {}
  rpin = {}
  rhit = {}
  for i, line in cut(std.script.fs_read(spec))
    c: str = field(line, 1)
    p: str = field(line, 2)
    if known(c) and p != "" and field(line, 3) == ""
      rcls(rcls:len() + 1) = c
      rpre(rpre:len() + 1) = p
      rpin(rpin:len() + 1) = tier(p)
      rhit(rhit:len() + 1) = 0
  if rcls:len() == 0
    print("corpus_classify: FAIL — docs/spec/corpus.md yielded 0 rules; the parse is broken")
    return 3
  nrules: str = to(str)(rcls:len())
  print("  rules     {nrules} from docs/spec/corpus.md")

  files = cut(shell("cd {root} && git ls-files '*.id'"))
  if files:len() == 0
    print("corpus_classify: FAIL — git ls-files found 0 .id files; the census did not run")
    return 3

  if shell("cd {root} && sh gate/subject.sh 'scripts/*.id' >/dev/null 2>&1 && printf y || printf n") != "y"
    print("corpus_classify: FAIL — the gate-source arm of the haystack is not trustworthy here (GAP-220)")
    return 3
  shell("cd {root} && ( cat build.zig 2>/dev/null; git ls-files 'scripts/*.id' | grep -v corpus_classify | tr '\\n' '\\0' | xargs -0 cat 2>/dev/null; find .github -type f 2>/dev/null | tr '\\n' '\\0' | xargs -0 cat 2>/dev/null; ) > {haystack}")
  haybytes: i64 = to(i64)(std.script.chomp(shell("wc -c < {haystack} 2>/dev/null")))
  if haybytes == 0
    print("corpus_classify: FAIL — reference haystack is empty; every UNREF would be a lie")
    return 3

  pats: str = ""
  for i, f in files
    b: str = base(f)
    pats = "{pats}{f}\n{b}\n"
    d: str = parent(f)
    while depth(d) >= 1
      pats = "{pats}{d}\n"
      d = parent(d)
  std.script.fs_write(needles, pats)
  refs = {}
  for i, h in cut(shell("grep -o -F -f {needles} {haystack} 2>/dev/null | sort -u"))
    refs(h) = 1

  approot = {}
  napp = 0
  for i, f in files
    if base(f) == "build.id"
      d: str = parent(f)
      if d != ""
        approot(d) = 1
        napp = napp + 1
  napps: str = napp:to(str)
  print("  apps      {napps} in-tree application roots (own build.id)")

  ncanon = 0
  ncompat = 0
  nforeign = 0
  nneg = 0
  nhist = 0
  ngen = 0
  nnone = 0
  texact = 0
  tfamily = 0
  tdefault = 0
  unclassified: str = ""
  canon: str = ""
  c1: str = ""
  nc1 = 0
  c2: str = ""
  nc2 = 0
  emit: bool = script.getenv("CORPUS_CLASSIFY_EMIT", "") != ""
  rows: str = ""

  for i, f in files
    cls: str = ""
    pin: str = ""
    j: i64 = 1
    while j <= rpre:len() and cls == ""
      if starts(f, rpre(j))
        cls = rcls(j)
        pin = rpin(j)
        rhit(j) = rhit(j) + 1
      j = j + 1

    referenced: bool = refs(f) == 1 or refs(base(f)) == 1
    fdir: str = parent(f)
    while depth(fdir) >= 1
      if refs(fdir) == 1
        referenced = true
      fdir = parent(fdir)
    mark: str = "UNREF"
    if referenced
      mark = "REF"

    if cls == "canonical"
      ncanon = ncanon + 1
      if f != here
        canon = "{canon}{root}/{f}\n"
      inapp: bool = false
      adir: str = parent(f)
      while adir != ""
        if approot(adir) == 1
          inapp = true
        adir = parent(adir)
      if not referenced and not starts(f, "lib/") and not inapp
        nc2 = nc2 + 1
        if nc2 <= 12
          c2 = "{c2}    {f}\n"
    else(cls == "compatibility")
      ncompat = ncompat + 1
    else(cls == "foreign")
      nforeign = nforeign + 1
    else(cls == "negative")
      nneg = nneg + 1
    else(cls == "historical")
      nhist = nhist + 1
      if referenced
        nc1 = nc1 + 1
        if nc1 <= 12
          c1 = "{c1}    {f}\n"
    else(cls == "generated")
      ngen = ngen + 1
    else
      nnone = nnone + 1
      if nnone <= 12
        unclassified = "{unclassified}    {f}\n"

    if pin == "exact"
      texact = texact + 1
    else(pin == "family")
      tfamily = tfamily + 1
    else(pin == "default")
      tdefault = tdefault + 1

    if emit
      cell: str = pad(cls, 15)
      pincell: str = pad(pin, 9)
      refcell: str = pad(mark, 7)
      rows = "{rows}{cell}{pincell}{refcell}{f}\n"

  nfiles: str = to(str)(files:len())
  scanon: str = ncanon:to(str)
  scompat: str = ncompat:to(str)
  sforeign: str = nforeign:to(str)
  sneg: str = nneg:to(str)
  shist: str = nhist:to(str)
  sgen: str = ngen:to(str)
  print("")
  print("corpus census ({nfiles} tracked .id files)")
  print("  canonical      {scanon}   deny table applies")
  print("  compatibility  {scompat}   Lua-superset input")
  print("  foreign        {sforeign}   embeds another language, or vendored")
  print("  negative       {sneg}   denied text IS the assertion")
  print("  historical     {shist}   past-epoch evidence, unmaintained")
  print("  generated      {sgen}   fix the generator, not the file")

  if nnone != 0
    snone: str = nnone:to(str)
    print("")
    print("corpus_classify: FAIL — {snone} tracked .id files match no rule in docs/spec/corpus.md:")
    stdout:write(unclassified)
    print("  Classify them; there is deliberately no silent default.")
    return 1

  if ncanon == 0
    print("corpus_classify: FAIL — canonical partition is empty; the rules cannot be right")
    return 3

  sexact: str = texact:to(str)
  sfamily: str = tfamily:to(str)
  sdefault: str = tdefault:to(str)
  print("")
  print("how much of each path the rule pins")
  print("  exact          {sexact}   the rule names the file")
  print("  family         {sfamily}   the rule pins a purpose (2+ segments)")
  print("  default        {sdefault}   the rule pins one top-level tree — POLICY, not evidence")

  print("")
  print("rules, in order (first match wins)")
  print("  class          tier     files   prefix")
  dead = 0
  k: i64 = 1
  while k <= rpre:len()
    flag: str = "  "
    if rhit(k) == 0
      flag = "!!"
      dead = dead + 1
    cell: str = pad(rcls(k), 14)
    pincell: str = pad(rpin(k), 9)
    hits: str = pad(to(str)(rhit(k)), 8)
    pre: str = rpre(k)
    print("  {flag} {cell}{pincell}{hits}{pre}")
    k = k + 1
  if dead != 0
    sdead: str = dead:to(str)
    print("  !! {sdead} rule(s) match nothing. A rule that binds no file is not a rule.")

  std.script.fs_write(listing, canon)
  listed: i64 = to(i64)(std.script.chomp(shell("wc -l < {listing}")))
  if listed == 0
    print("corpus_classify: FAIL — canonical list is empty on disk; the content checks cannot run")
    return 3
  q: str = "'"
  marker: str = "tr '\\n' '\\0' < {listing} | xargs -0 grep -l -i -E {q}generated by|do not edit|auto-generated{q} 2>/dev/null"
  nc3: i64 = to(i64)(std.script.chomp(shell("{marker} | grep -c . || true")))
  c3: str = shell("{marker} | sed {q}s|{root}/||{q} | head -12")
  embeds: str = "tr '\\n' '\\0' < {listing} | xargs -0 grep -l -E {q}@c\\.emit|@comp\\.c\\.emit|@lua\\(|@foreign\\(|@ffi\\({q} 2>/dev/null"
  nc4: i64 = to(i64)(std.script.chomp(shell("{embeds} | grep -c . || true")))

  sc1: str = nc1:to(str)
  sc2: str = nc2:to(str)
  sc3: str = nc3:to(str)
  sc4: str = nc4:to(str)
  print("")
  print("contradictions — where the class and the evidence disagree")
  print("  C1  historical yet gate-referenced       {sc1}")
  if nc1 != 0
    stdout:write(c1)
    print("      (first 12; \"unmaintained\" is false for a file build.zig runs)")
  print("  C2  canonical, unreferenced, outside lib {sc2}")
  if nc2 != 0
    stdout:write(c2)
    print("      (first 12; scratch inside the partition the deny table enforces)")
  print("  C3  canonical yet carries a generator marker  {sc3}")
  if nc3 != 0
    stdout:write(c3)
  print("  C4  canonical yet embeds another language     {sc4}")
  print("      (named, not failed: lib/std embedding C is sanctioned, while")
  print("       examples/c_emit_* is `foreign` for the same act — one of these is wrong)")

  if emit
    stdout:write("\n-- MANIFEST ROWS (class tier ref path) --\n")
    stdout:write(rows)

  print("")
  print("corpus_classify: PASS — {nfiles} files, 0 unclassified, {sdefault} resolved by a top-level policy default")
  0
