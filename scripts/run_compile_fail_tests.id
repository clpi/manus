duo: str = ()
    bin = gatecap("sh -c 'if [ -n \"$DUO\" ]; then printf %s \"$DUO\"; else printf %s ./zig-out/bin/idol; fi'")
    return "env DUO_BUILD_REPORT=plain {bin}"

global any_failed: i64 = 0

pass = (msg: str)
    print("OK:   {msg}")

fail(msg: str, out: str)
    print("FAIL: {msg}")
    if out:len() > 0
        print(out)
    any_failed = 1

temp_file: str = ()
    gatecap("sh -c 'printf /tmp/duo_test_$$'")

run_fail(file: str, pattern: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} check {file} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        fail("{file} should not compile", out)
    else if out:find(pattern, 1, true) != nil
        pass("{file}  (expected error found)")
    else
        fail("{file}  expected pattern: {pattern}", out)

refuses(file: str, pattern: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} compile {file} -o /dev/null > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)

    if rc == 0
        fail("{file} should not compile", out)
    else if out:find(pattern, 1, true) != nil
        pass("{file}  (expected error found)")
    else
        fail("{file}  expected pattern: {pattern}", out)

run_ok(file: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} check {file} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        pass("{file}  (check passes)")
    else
        fail("{file}  should compile but got:", out)

run_output(file: str, expected: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} run {file} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        if out == expected
            pass("{file}  (run output matches)")
        else
            msg = "{file}  output mismatch\n--- want ---\n{expected}\n--- got ---\n{out}"
            fail(msg, "")
    else
        fail("{file}  should compile+run but got:", out)

run_shell_ok(label: str, script: str)
    tmp = temp_file()
    cmd = "bash {script} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        pass(label)
    else
        fail("{label} failed:", out)

run_duo_ok(label: str, script: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} run {script} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        pass(label)
    else
        fail("{label} failed:", out)

run_fail("examples/compile_fail/global_star_read.lua",    "use of undeclared global")
run_fail("examples/compile_fail/implicit_global_read.lua", "use of undeclared global")
run_fail("examples/compile_fail/global_star_assign.lua",  "attempt to assign to undeclared global")
run_fail("examples/compile_fail/for_assign_num.lua",      "cannot assign to for loop control variable")
run_fail("examples/compile_fail/for_assign_gen.lua",      "cannot assign to for loop control variable")
run_fail("examples/compile_fail/const_local_assign.lua",  "attempt to assign to const variable")
run_fail("examples/compile_fail/const_no_init.lua",       "must have an initializer")
run_fail("examples/compile_fail/close_no_init.lua",       "must have an initializer")
run_fail("examples/compile_fail/vararg_rest_assign.lua",  "read-only vararg table")
run_fail("examples/compile_fail/global_const_assign.lua", "attempt to assign to const variable")
refuses("examples/compile_fail/relation_lossy_compose.id", "no silent conversion inch -> milli")
run_fail("examples/compile_fail/nominal_bare.id", "descriptor mismatch: 'd' is declared 'feet'")
run_fail("examples/compile_fail/nominal_erase.id", "descriptor mismatch: 'y' is declared 'f64'")
run_fail("examples/compile_fail/expect_apply_label.id", "has no field 'z'")
run_fail("examples/compile_fail/callable_demand_label.id", "has no field 'z'")
run_fail("examples/compile_fail/barecase_shadow.id", "expected descriptor field name or spread")
run_fail("examples/compile_fail/barecase_mixed.id", "expected descriptor field name or spread")
run_fail("examples/compile_fail/tensor_matmul_k_mismatch.id", "tensor matmul inner dimension mismatch")
run_fail("examples/compile_fail/tensor_matmul_symbolic_k_mismatch.id", "tensor matmul inner dimension mismatch")
run_fail("examples/compile_fail/tensor_broadcast_incompatible.id", "tensor broadcast incompatible shapes")
run_fail("examples/compile_fail/tensor_return_mismatch.id", "return type mismatch")
run_fail("examples/compile_fail/generic_concept_fail.id", "does not satisfy concept 'Hashable'")
run_fail("examples/compile_fail/satisfies_fail.id", "Empty lacks hash")
run_fail("examples/compile_fail/multi_concept_fail.id", "does not satisfy concept 'Counter'")
run_fail("examples/compile_fail/offside_misindent.id", "indentation matches no block")
run_fail("examples/compile_fail/offside_end_column.id", "closes a block opened at column")
run_fail("examples/compile_fail/anchor_metafield.id", "is not an anchor stance")
run_fail("examples/compile_fail/anchor_infix_at.id", "has no meaning in .id")
run_ok("examples/compile_fail/anchor_infix_at.lua")

run_ok("tests/test.lua")
run_ok("examples/hello.lua")
run_ok("examples/fib.lua")
run_ok("examples/boring/fib.id")
run_ok("examples/table/iterate.id")
run_output("examples/layout/refine.id", "6\n")

print("")
if any_failed == 0
    print("All compile-fail tests passed")
else
    print("Some tests FAILED")
    os.exit(1)
