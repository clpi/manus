#!/usr/bin/env duo
duo: str = ()
    bin = gatecap("sh -c 'if [ -n \"$DUO\" ]; then printf %s \"$DUO\"; else printf %s ./zig-out/bin/idol; fi'")
    return "env DUO_BUILD_REPORT=plain {bin}"

global any_failed: i64 = 0

pass = (msg: str)
    print("OK:   {msg}")

fail(msg: str, out: str)
    print("FAIL: {msg}")
    if out:len() > 0
        print(out)
    any_failed = 1

temp_file: str = ()
    gatecap("sh -c 'printf /tmp/duo_test_$$'")

run_fail(file: str, pattern: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} check {file} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        fail("{file} should not compile", out)
    else if out:find(pattern, 1, true) != nil
        pass("{file}  (expected error found)")
    else
        fail("{file}  expected pattern: {pattern}", out)

# gap[082]: a refusal that only CODEGEN can make. `run_fail` runs `duo check`,
# which stops before lowering, so a judgment made while emitting is invisible
# to it — and reporting such a fixture as passing `check` is exactly the
# false-green this repo has paid for before. This runner compiles.
#
# That `duo check` cannot see a lossy-composition refusal is a real limitation
# and is recorded on the gap: the class lattice belongs in sema, where it would
# be one diagnostic in one place instead of a lowering-time veto. Until it
# moves, the gate has to run the stage that holds the rule.
refuses(file: str, pattern: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} compile {file} -o /dev/null > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)

    if rc == 0
        fail("{file} should not compile", out)
    else if out:find(pattern, 1, true) != nil
        pass("{file}  (expected error found)")
    else
        fail("{file}  expected pattern: {pattern}", out)

run_ok(file: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} check {file} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        pass("{file}  (check passes)")
    else
        fail("{file}  should compile but got:", out)

run_output(file: str, expected: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} run {file} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        if out == expected
            pass("{file}  (run output matches)")
        else
            msg = "{file}  output mismatch\n--- want ---\n{expected}\n--- got ---\n{out}"
            fail(msg, "")
    else
        fail("{file}  should compile+run but got:", out)

run_shell_ok(label: str, script: str)
    tmp = temp_file()
    cmd = "bash {script} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        pass(label)
    else
        fail("{label} failed:", out)

run_duo_ok(label: str, script: str)
    tmp = temp_file()
    tool = duo()
    cmd = "{tool} run {script} > {tmp} 2>&1"
    rc = os.execute(cmd)
    out = tmp:read()
    os.remove(tmp)
    
    if rc == 0
        pass(label)
    else
        fail("{label} failed:", out)

run_fail("examples/compile_fail/global_star_read.lua",    "use of undeclared global")
run_fail("examples/compile_fail/implicit_global_read.lua", "use of undeclared global")
run_fail("examples/compile_fail/global_star_assign.lua",  "attempt to assign to undeclared global")
run_fail("examples/compile_fail/for_assign_num.lua",      "cannot assign to for loop control variable")
run_fail("examples/compile_fail/for_assign_gen.lua",      "cannot assign to for loop control variable")
run_fail("examples/compile_fail/const_local_assign.lua",  "attempt to assign to const variable")
run_fail("examples/compile_fail/const_no_init.lua",       "must have an initializer")
run_fail("examples/compile_fail/close_no_init.lua",       "must have an initializer")
run_fail("examples/compile_fail/vararg_rest_assign.lua",  "read-only vararg table")
run_fail("examples/compile_fail/global_const_assign.lua", "attempt to assign to const variable")
refuses("examples/compile_fail/relation_lossy_compose.id", "no silent conversion inch -> milli")
# constitution §46 `law.nominal`, both directions. These two are `run_fail`
# and !`refuses` on purpose: the nominal rule lives in SEMA, so `duo check`
# is authoritative about it. That is the direction gap[082] records the class
# lattice as still owing — legality above realization — and it is worth noting
# that the row above needs a compile because its rule did not make it there.
run_fail("examples/compile_fail/nominal_bare.id", "descriptor mismatch: 'd' is declared 'feet'")
run_fail("examples/compile_fail/nominal_erase.id", "descriptor mismatch: 'y' is declared 'f64'")
# gap[110], the DEMANDED rung of the application ladder. `p: point = { … }`
# and `q = point{ … }` are two projections of one relation, so a label the
# descriptor has no field for refuses at both — this row is the demanded
# mirror of the applied-rung pin scripts/applyone.id ROW 6 carries. Pinned on
# the shared substring so the two rungs cannot drift apart silently.
run_fail("examples/compile_fail/expect_apply_label.id", "has no field 'z'")
run_fail("examples/compile_fail/callable_demand_label.id", "has no field 'z'")
# constitution §41, the two refusals that ship WITH bare-case resolution.
# gap[087] fix step 2 says the shadow diagnostic "lands with it, not after",
# and the mixed-space row is what distinguishes a demand-driven resolver from
# an index that got lucky on the positive fixture.
run_fail("examples/compile_fail/barecase_shadow.id", "expected descriptor field name or spread")
run_fail("examples/compile_fail/barecase_mixed.id", "expected descriptor field name or spread")
run_fail("examples/compile_fail/tensor_matmul_k_mismatch.id", "tensor matmul inner dimension mismatch")
run_fail("examples/compile_fail/tensor_matmul_symbolic_k_mismatch.id", "tensor matmul inner dimension mismatch")
run_fail("examples/compile_fail/tensor_broadcast_incompatible.id", "tensor broadcast incompatible shapes")
run_fail("examples/compile_fail/tensor_return_mismatch.id", "return type mismatch")
run_fail("examples/compile_fail/generic_concept_fail.id", "does not satisfy concept 'Hashable'")
run_fail("examples/compile_fail/satisfies_fail.id", "Empty lacks hash")
run_fail("examples/compile_fail/multi_concept_fail.id", "does not satisfy concept 'Counter'")
# Offside layout DIAGNOSES rather than re-nests. Both rows fail
# for indentation alone; both files are otherwise well-formed programs, which
# is the point: the only thing wrong with them is a rendering that matches no
# shallow shape, and that has to be an error rather than a second parse.
run_fail("examples/compile_fail/offside_misindent.id", "indentation matches no block")
run_fail("examples/compile_fail/offside_end_column.id", "closes a block opened at column")
# The anchor has THREE stances and `.@name` is not one of them.
# This row is a rejection and !a corpus value fixture on purpose: the form
# shipped a wrong VALUE (`p.@x` = nil beside `p.x` = 3, both checking clean),
# and a wrong value that type-checks is exactly the thing a value fixture
# cannot pin. See docs/anchor_stance_conflict.md row 3.
run_fail("examples/compile_fail/anchor_metafield.id", "is not an anchor stance")
# GAP-059 — the half of the `@` token adjacency did not reconcile. 3f6ec4e
# gave the GLUED spelling to the anchor (`p@x` retrieves; anchormove.id pins
# it at 353), but `infix_prec` still maps the token to `.matmul`, so the
# SPACED spelling kept the false green: `p @ x` warned, checked clean, exited
# 0, and then handed the C backend an identifier the user never wrote. This
# row asserts the refusal; the row under it asserts the .lua twin still
# compiles, which is what proves the operator was gated on the dialect rather
# than removed. The pattern is the refusal line, and the hint beside it names
# the repair — close the space — which is the only reason this can be an error
# instead of a warning.
run_fail("examples/compile_fail/anchor_infix_at.id", "has no meaning in .id")
run_ok("examples/compile_fail/anchor_infix_at.lua")

# Positive smoke rows kept to prove the compile-fail runner still reaches
# ordinary accepted inputs while the missing retired try/goto fixtures remain
# outside the tracked tree.
run_ok("tests/test.lua")
run_ok("examples/hello.lua")
run_ok("examples/fib.lua")
run_ok("examples/boring/fib.id")
run_ok("examples/table/iterate.id")
run_output("examples/layout/refine.id", "6\n")

print("")
if any_failed == 0
    print("All compile-fail tests passed")
else
    print("Some tests FAILED")
    os.exit(1)
