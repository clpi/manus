# Live agent claim ledger.
#
# The durable coordination file points agents at `.agents/session/claims`.
# This script turns those markdown claims into a concise duon-readable view.

process = req "lib.process"

lines: any = (text: str)
    out = {}
    start = 1
    i = 1
    n = text:len()
    while i <= n
        if text:byte(i) == 10
            if i > start
                out:push(text:sub(start, i - 1))
            start = i + 1
        i += 1
    if start <= n
        out:push(text:sub(start, n))
    out

field: str = (line: str)
    mark = ": "
    p = line:find(mark)
    if p == nil
        ""
    else
        line:sub(p + mark:len())

space: bool = (c: i64)
    c == 32 or c == 9 or c == 10 or c == 13

trim: str = (text: str)
    a = 1
    b = text:len()
    while a <= b and space(text:byte(a))
        a += 1
    while b >= a and space(text:byte(b))
        b -= 1
    if b < a
        ""
    else
        text:sub(a, b)

cutnote: str = (text: str)
    p = text:find(" — ", 1, true)
    if p != nil
        return text:sub(1, p - 1)
    p = text:find(" (", 1, true)
    if p != nil
        return text:sub(1, p - 1)
    text

rootpath: bool = (path: str)
    path == "build.zig" or
        starts(path, "scripts/") or
        starts(path, "src/") or
        starts(path, "lib/") or
        starts(path, "tools/") or
        starts(path, "docs/") or
        starts(path, "examples/") or
        starts(path, "ext/") or
        starts(path, "gaps/") or
        starts(path, "benchmarks/")

seen: bool = (out: any, item: str)
    for i = 1, out:len()
        if out[i] == item
            return true
    false

push: void = (out: any, item: str)
    clean = trim(cutnote(item))
    if clean != "" and rootpath(clean) and !seen(out, clean)
        out:push(clean)

splitlocks: any = (text: str)
    out = {}
    i = 1
    n = text:len()
    found = 0
    while i <= n
        if text:sub(i, i) == "`"
            j = i + 1
            while j <= n and text:sub(j, j) != "`"
                j += 1
            if j <= n
                push(out, text:sub(i + 1, j - 1))
                found += 1
                i = j
        i += 1
    if found > 0
        return out

    start = 1
    i = 1
    while i <= n
        if text:sub(i, i) == ","
            push(out, text:sub(start, i - 1))
            start = i + 1
        i += 1
    if start <= n
        push(out, text:sub(start, n))
    out

collect: any = (path: str)
    text = process.capture("cat '{path}'")
    agent = ""
    area = ""
    files = ""
    taking = false
    for i, line in lines(text)
        if line:sub(1, 9) == "- Agent: "
            agent = field(line)
        if line:sub(1, 9) != "- Agent: " and line:sub(1, 8) == "- Area: "
            area = field(line)
        if line:sub(1, 9) != "- Agent: " and line:sub(1, 8) != "- Area: " and line:sub(1, 16) == "- Files locked: "
            files = field(line)
            taking = true
        if taking and line:sub(1, 2) == "  "
            files = "{files} {trim(line)}"
        if line:sub(1, 2) == "- "
            taking = false
    locktext = files
    if area != ""
        locktext = "{locktext}, {area}"
    { path = path, agent = agent, area = area, files = files, locks = splitlocks(locktext) }

show: void = (claim: any)
    print("{claim.path}")
    print("  agent {claim.agent}")
    print("  area {claim.area}")
    print("  files {claim.files}")
    for i = 1, claim.locks:len()
        print("    lock {claim.locks[i]}")

sameagent: bool = (a: str, b: str)
    a == b

starts: bool = (text: str, prefix: str)
    text:len() >= prefix:len() and text:sub(1, prefix:len()) == prefix

starprefix: str = (lock: str)
    p = lock:find("*", 1, true)
    if p == nil
        ""
    else
        lock:sub(1, p - 1)

directory: str = (lock: str)
    n = lock:len()
    if n >= 3 and lock:sub(n - 2, n) == "/**"
        return lock:sub(1, n - 2)
    if n >= 2 and lock:sub(n - 1, n) == "/*"
        return lock:sub(1, n - 1)
    if n >= 1 and lock:sub(n, n) == "/"
        return lock
    ""

covers: bool = (lock: str, path: str)
    if lock == path
        return true
    dir = directory(lock)
    if dir != "" and starts(path, dir)
        return true
    prefix = starprefix(lock)
    if prefix != "" and starts(path, prefix)
        return true
    false

touches: bool = (left: str, right: str)
    covers(left, right) or covers(right, left)

control: i64 = ()
    bad = 0
    if !touches("a/b.id", "a/b.id")
        print("claimledger: fail control exact")
        bad += 1
    if !touches("tools/wasm/**", "tools/wasm/src/engine.id")
        print("claimledger: fail control wildcard")
        bad += 1
    if touches("tools/wasm/**", "lib/std/fs.id")
        print("claimledger: fail control disjoint")
        bad += 1
    if bad == 0
        print("claimledger: control ok")
    bad

codex: bool = (agent: str)
    starts(agent, "codex")

statuspath: str = (line: str)
    path = ""
    if line:len() >= 4
        path = trim(line:sub(4))
    arrow = path:find(" -> ", 1, true)
    if arrow != nil
        path = trim(path:sub(arrow + 4))
    path

dirtyfiles: any = (root: str)
    out = {}
    text = process.capture("cd '{root}' && git status --porcelain --untracked-files=all")
    for i, line in lines(text)
        path = statuspath(line)
        if path != "" and !starts(path, ".agents/session/")
            out:push(path)
    out

dirty: i64 = (claims: any, root: str)
    files = dirtyfiles(root)
    unclaimed = 0
    other = 0
    strict = (os.env["CLAIMLEDGER_STRICT"] or "") == "1"
    for i = 1, files:len()
        path = files[i]
        hits = 0
        foreign = 0
        for j = 1, claims:len()
            claim = claims[j]
            for k = 1, claim.locks:len()
                if covers(claim.locks[k], path)
                    hits += 1
                    if !codex(claim.agent)
                        foreign += 1
        if hits == 0
            unclaimed += 1
            print("claimledger: dirty unclaimed {path}")
        if hits != 0 and foreign > 0
            other += 1
            print("claimledger: dirty foreign {path}")
        if hits != 0 and foreign == 0
            print("claimledger: dirty claimed {path}")
    if other > 0 and strict
        print("claimledger: fail dirty paths claimed by another agent {other}")
        return 1
    print("claimledger: dirty ok claimed-by-other {other} unclaimed {unclaimed}")
    0

overlaps: i64 = (claims: any)
    soft = 0
    hard = 0
    for i = 1, claims:len()
        a = claims[i]
        for j = i + 1, claims:len()
            b = claims[j]
            for x = 1, a.locks:len()
                left = a.locks[x]
                for y = 1, b.locks:len()
                    right = b.locks[y]
                    if touches(left, right)
                        if sameagent(a.agent, b.agent)
                            soft += 1
                            print("claimledger: shared {left} <-> {right}")
                            print("  {a.path}")
                            print("  {b.path}")
                        else
                            hard += 1
                            print("claimledger: conflict {left} <-> {right}")
                            print("  {a.agent}: {a.path}")
                            print("  {b.agent}: {b.path}")
    if hard > 0
        print("claimledger: fail cross-agent overlaps {hard}")
        return 1
    print("claimledger: overlaps ok shared {soft} conflict 0")
    0

main: i64 = ()
    root = process.chomp(process.capture("git rev-parse --show-toplevel 2>/dev/null"))
    if root == ""
        print("claimledger: fail no git root")
        process.exit(3)

    found = lines(process.capture("cd '{root}' && find .agents/session/claims -maxdepth 1 -type f -name '*.md' -print | sort"))
    count = found:len()
    if count == 0
        print("claimledger: fail live claims 0")
        process.exit(1)

    print("claimledger: live claims {count}")
    claims = {}
    for i = 1, count
        path = "{root}/{found[i]}"
        claim = collect(path)
        claims:push(claim)
        show(claim)
    rc = control()
    rc += overlaps(claims)
    rc += dirty(claims, root)
    process.exit(rc)
    0
