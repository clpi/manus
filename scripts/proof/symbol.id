# SH-10 — the symbol owner, proven BY VALUE and against the bootstrap.
#
# `lib/std/compiler/symbol.id` is the duon-native owner of C symbol emission.
# This is its differential: the duon rule must answer what the bootstrap
# answers, for every name that matters, and it must answer for names the
# bootstrap has never seen.
#
# WHY A DIFFERENTIAL AND NOT A UNIT TEST. `law.differential`: old is oracle,
# new is candidate, the differential judges. A unit test on the duon rule alone
# would prove the rule is self-consistent, which is not the question. The
# question is whether it agrees with the compiler that ships.
#
# WHY THE ROWS ARE THE ROWS. Four of them are duon's OWN VOCABULARY — `case`
# (§0.3), `union` (§0.5), `register` (§0b), `default` (Pass 119's `?.` repair
# spells `get(.y, default)`). Three are the libc names that BIND SILENTLY
# rather than failing: `read`, `write`, `open`. `abs` is the one measured
# returning libc's answer — `abs(21)` printed 21. `main` is the exception.
#
# Exit 0 pass · 1 a row disagreed · 3 the harness could not run.

sym = symbol

# Every row: the duon name, and the C symbol the rule must produce.
names = {
    "case", "union", "register", "default",
    "read", "write", "open", "abs",
    "ordinary", "twice", "sort",
}

fail = 0

check = (name: str, want: str)
    got: str = sym.symbol(name)
    if got == want
        print("  ok   {name} -> {got}")
    else
        print("  FAIL {name} -> {got}, wanted {want}")
        fail = fail + 1

main: i64 = ()
    print("")
    print("  the duon-native symbol owner (SH-10), by value")
    print("")

    # CONTROLS FIRST. A row printed before the rule is shown to discriminate is
    # a number nobody should act on — and this file's whole claim is that the
    # rule is not the identity function.
    if sym.root("read") == "read"
        print("CONTROL FAILED: root() is the identity — it mangles nothing")
        std.os.exit(3)
    if sym.module("wire", "read") == sym.root("read")
        print("CONTROL FAILED: module and root symbols collide")
        std.os.exit(3)
    if sym.mangles("main")
        print("CONTROL FAILED: main must NOT take the ordinary prefix")
        std.os.exit(3)
    if sym.mangles("read") == false
        print("CONTROL FAILED: an ordinary name must mangle")
        std.os.exit(3)

    i: i64 = 1
    n: i64 = names:len()
    while i <= n
        nm: str = names[i]
        check(nm, "duo_fn_{nm}")
        i = i + 1

    # The exception, asserted separately because it is the one row that would
    # silently pass if `symbol` returned the prefix for everything.
    check2: str = sym.symbol("main")
    if check2 == "duo_entry_main"
        print("  ok   main -> {check2}   (the exception)")
    else
        print("  FAIL main -> {check2}, wanted duo_entry_main")
        fail = fail + 1

    # A module name must NOT be prefixed twice: `<mod>__<name>` is already
    # closed, and prefixing it again is the mistake this row exists to catch.
    mo: str = sym.module("wire", "read")
    if mo == "wire__read"
        print("  ok   wire.read -> {mo}   (already closed, not reprefixed)")
    else
        print("  FAIL wire.read -> {mo}, wanted wire__read")
        fail = fail + 1

    print("")
    if fail > 0
        print("symbol proof: FAIL — {fail} row(s) disagreed")
        std.os.exit(1)
    print("symbol proof: PASS — 13 rows, every duon name owns its C symbol")
    0
