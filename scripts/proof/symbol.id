
sym = symbol

names = {
  "case",
  "union",
  "register",
  "default",
  "read",
  "write",
  "open",
  "abs",
  "ordinary",
  "twice",
  "sort"
}

fail = 0

check = (name: str, want: str)
  got: str = sym.symbol("compiler.lexer", name)
  if got == want
    print("  ok   {name} -> {got}")
  else
    print("  FAIL {name} -> {got}, wanted {want}")
    fail = fail + 1

main: i64 = ()
  print("")
  print("  the idol-native symbol owner (SH-10), by value")
  print("")

  if sym.module("compiler.lexer", "read") == "read"
    print("CONTROL FAILED: the rule is the identity — it mangles nothing")
    os.exit(3)
  if sym.module("wire", "read") == sym.module("other", "read")
    print("CONTROL FAILED: two homes produce one symbol — the home is not in it")
    os.exit(3)
  if sym.mangles("main")
    print("CONTROL FAILED: main must NOT take the ordinary prefix")
    os.exit(3)
  if not sym.mangles("read")
    print("CONTROL FAILED: an ordinary name must mangle")
    os.exit(3)

  i: i64 = 1
  n: i64 = names:len()
  while i <= n
    nm: str = names(i)
    check(nm, "idol_compiler_lexer__{nm}")
    i = i + 1

  check2: str = sym.symbol("compiler.lexer", "main")
  if check2 == "main"
    print("  ok   main -> {check2}   (the exception)")
  else
    print("  FAIL main -> {check2}, wanted main")
    fail = fail + 1

  mo: str = sym.module("wire", "read")
  if mo == "idol_wire__read"
    print("  ok   wire.read -> {mo}")
  else
    print("  FAIL wire.read -> {mo}, wanted idol_wire__read")
    fail = fail + 1

  dot: str = sym.module("compiler.lexer", "read")
  if dot == "idol_compiler_lexer__read"
    print("  ok   dotted home -> {dot}   (alphabet applied)")
  else
    print("  FAIL dotted home -> {dot}, wanted idol_compiler_lexer__read")
    fail = fail + 1

  hyp: str = sym.module("odd-name", "f")
  if hyp == "idol_odd_name__f"
    print("  ok   hyphen -> {hyp}   (the assembler can take this)")
  else
    print("  FAIL hyphen -> {hyp}, wanted idol_odd_name__f")
    fail = fail + 1

  print("")
  if fail > 0
    print("symbol proof: FAIL — {fail} row(s) disagreed")
    os.exit(1)
  print("symbol proof: PASS — 13 rows, every idol name owns its C symbol")
  0
