# path:mkdir / mkdirall / copy — verified BY VALUE (GAP-157: no std).
#
# gap[100] rung 0. Every assertion checks the FILESYSTEM, never the wrapper's
# word. Also convicts tail-position @c.emit returning the wrong value silently.
#
# exit 0 all good; 1..6 names the broken direction.

base = "/tmp/duofsproof"

main: i64 = ()
    code: i64 = 0
    two = "{base}/two"
    one = "{base}/one"
    leaf = "{base}/a/b/c"
    midb = "{base}/a/b"
    mida = "{base}/a"
    deep = "{base}/nosuchparent/x"

    two:remove()
    one:remove()
    leaf:remove()
    midb:remove()
    mida:remove()
    base:remove()

    made = base:mkdir()
    if !base:exists()
        print("fs proof: mkdir answered {made} and the directory is absent")
        code = 1
    if code == 0 and made == false
        print("fs proof: mkdir created the directory and answered {made}")
        code = 2

    deepmade = deep:mkdir()
    if code == 0 and deepmade
        print("fs proof: mkdir answered {deepmade} for a path whose parent is absent")
        code = 3

    all = leaf:mkdirall()
    if code == 0 and !leaf:exists()
        print("fs proof: mkdirall answered {all} and the leaf is absent")
        code = 4

    src = one
    f = src:open("w")
    f:write("duon")
    f:close()
    dst = two
    cp = src:copy(dst)
    if code == 0 and !dst:exists()
        print("fs proof: copy answered {cp} and the target is absent")
        code = 5
    g = dst:open("r")
    body = g:read("a")
    g:close()
    if code == 0 and body != "duon"
        print("fs proof: copy produced {body}, not the source bytes")
        code = 6

    if code == 0
        print("fs proof: mkdir, mkdirall and copy all verified by value")

    code
