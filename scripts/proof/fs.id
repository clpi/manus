  path:read():len() >= min

audit__path = (pattern: str)
  path:read():has(pattern)

hit__path = (pattern: str)
  path:read():has(pattern)

main: i64 = ()
  if not remove:len(16)
    return 1
  if not mkdir:len(16)
    return 2
  if not remove:audit(":remove(")
    return 3
  if not remove:audit(":exists(")
    return 4
  if remove:hit("std.")
    return 5
  if remove:hit("fs.")
    return 6
  if not mkdir:audit(":mkdir(")
    return 7
  if not mkdir:audit(":copy(")
