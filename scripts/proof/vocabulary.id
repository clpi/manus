# @bootstrap.waive(graph-facts) — this file reaches boundary-curried relation
# edges: `audit__path` / `hit__path` / `len__path` declared here are invoked as
# `path:audit(p)`, and `dnir_lower.tryLowerSubjectRelationEdgeCall` fuses that
# pair only when graph facts are waived. The graph publishes no application id
# for the fused edge, so without this request the file is refused with
# `DNB011 unresolved-application-facts`. Measured — it is the ONLY thing this
# file still needs the waiver for. Delete this line when the graph owns the
# edge (GAP-155); `gate/waive.sh` in the surface repo pins the roster.
# SH-10 proof router - resident + suite; no ingest.resident catalog.

resident = "scripts/proof/resident.id"
suite = "scripts/proof/semantic.id"

len__path = (min: i64)
  path:read():len() >= min

audit__path = (pattern: str)
  path:read():has(pattern)

hit__path = (pattern: str)
  path:read():has(pattern)

main: i64 = ()
  if not resident:len(32)
    return 1
  if not resident:audit("path:read(")
    return 2
  if not suite:len(16)
    return 3
  if not suite:audit("path:read(")
    return 4
  if resident:hit("ingest.resident")
    return 5
  if not resident:audit("CATALOG-ZERO")
    return 6
  print("semantic proof router: pass")
  0
