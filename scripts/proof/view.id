# View-class edges live on the bit proof — not a relation catalog pipe.

bit = "scripts/proof/bit.id"

len(path) = (min: i64)
    path:read()
        :len() >= min

audit(path) = (pattern: str)
    path:read()
        :has(pattern)

hit(path) = (pattern: str)
    path:read()
        :has(pattern)

main: i64 = ()
    if !bit:len(32)
        return 1
    if bit:hit("viewedges")
        return 3
    if bit:hit("callable = true")
        return 4
    if !bit:audit("@view")
        return 5
    if !bit:audit(":to(bit)")
        return 6
    if !bit:audit("to(bit)(f64)")
        return 7
    if !bit:audit("to(i64)(bit)")
        return 8
    print("proof/view: pass")
    0
