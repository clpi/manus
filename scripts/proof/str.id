# Proof for std.str length/substr staying native without an embedded C length shim.

work = "/tmp/idolproofstr"
idol = "./zig-out/bin/idol"

fail: i64 = (msg: str)
    print("proof/str: " .. msg)
    1
end

main: i64 = ()
    if "hello":len() != 5
        return fail("len literal")
    end
    if "":len() != 0
        return fail("len empty")
    end
    if "hello world":sub(7, 11):len() != 5
        return fail("len sub")
    end

    std.script.run("rm -rf " .. work .. " && mkdir -p " .. work)
    src = work .. "/main.id"
    f = src:open("w")
    f:write("main: i64 = ()\n"
        .. "    a: i64 = \"hello\":len()\n"
        .. "    b: i64 = \"hello world\":sub(7, 11):len()\n"
        .. "    a + b\n"
        .. "end\n")
    f:close()

    if std.script.run(idol .. " compile " .. src .. " --backend=direct --emit exe -o " .. work .. "/main") != 0
        return fail("direct compile")
    end
    rc = std.script.status(work .. "/main")
    if rc != 10
        return fail("direct exit " .. rc:to(str))
    end

    modc = "/tmp/duo_reqmod_str.c"
    if !modc:exists()
        return fail("missing emitted std.str C module")
    end
    n = std.script.chomp(std.script.capture(
        "awk '/len\\(s: str\\)/,/^end$/' lib/str.id | grep -c '@.*c\\.emit'"))
    if n != "" and n != "0"
        return fail("std.str.len still uses embedded C")
    end

    print("proof/str: pass")
    0
end
