# SH-10 — the record owner, proven BY VALUE (GAP-157: no std).

rec = record

check = (what: str, got: str, want: str, fail: i64): i64
    if got == want
        print("  ok   {what}")
        fail
    else
        print("  FAIL {what}")
        print("       got  {got}")
        print("       want {want}")
        fail + 1

main: i64 = ()
    code: i64 = 0
    fail: i64 = 0

    print("")
    print("  the duon-native record owner (SH-10), by value")
    print("")

    if rec.typename("point") == "point"
        print("CONTROL FAILED: typename() is the identity — it names nothing")
        code = 3
    if code == 0 and rec.emits("")
        print("CONTROL FAILED: an unnamed descriptor must not emit")
        code = 3
    if code == 0 and rec.field("x", "1") == "1"
        print("CONTROL FAILED: field() dropped its designator")
        code = 3

    if code == 0
        fail = check("typename", rec.typename("point"), "duo_point", fail)
        fail = check("field designator", rec.field("x", "3.0"), ".x = 3.0", fail)

        named: str = rec.applynamed("point", ".x = 3.0, .y = 4.0")
        fail = check("apply, named pack", named, "((duo_point){.x = 3.0, .y = 4.0})", fail)

        pos: str = rec.applypositional("point", "3.0, 4.0")
        fail = check("apply, positional pack", pos, "((duo_point){3.0, 4.0})", fail)

        if named:find("lua_val", 1, true) > 0
            print("  FAIL apply emitted a boxed value — law.pack violated")
            fail += 1
        else
            print("  ok   apply allocates nothing (law.pack)")

    print("")
    if code != 0
        code
    else if fail > 0
        print("record proof: FAIL — {fail} row(s) disagreed")
        1
    else
        print("record proof: PASS — 5 rows, the descriptor edge of apply emits C")
        0
