
work = "/tmp/duo-capability-matrix"
probepath = "/tmp/duo-capability-matrix/probe.sh"
recordpath = "/tmp/duo-capability-matrix/records.tsv"
listpath = "/tmp/duo-capability-matrix/files.list"

countsd = 0
countsp = 0
countsc = 0
countspc = 0
countsn = 0
countspr = 0
countsca = 0
countsnentry = 0
countsund = 0
countstotal = 0

topcanon = 0
topproven = 0
topnative = 0
topnoentry = 0
topbail = 0
topchecked = 0
countsptop = 0
countstopt = 0
topnone = 0

inversions = ""
ninversions = 0
shown = 0

chomp: str = (text: str)
    if text:len() == 0
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

capture: str = (shellline: str)
    gatecap(shellline)

cap: str = (shellline: str)
    chomp(gatecap(shellline))

status: i64 = (cmd: str)
    cap("( {cmd} ) >/dev/null 2>&1\necho $?"):to(i64)

envor: str = (name: str, fallback: str)
    os.env[name] or fallback

probetext: str = (duo: str, tprefix: str)
    "f=\"$1\"\nd={duo}\nt={work}/w$$\nexport DUO_SEMANTIC_CACHE=0\n"
    .. "des=0\ngrep -q \"^--\" \"$f\" && des=1\n"
    .. "oc=$($d check \"$f\" 2>&1); cr=$?\npar=1\n"
    .. "case \"$oc\" in *\"parse failed\"*) par=0;; esac\n"
    .. "chk=0\nif [ $cr -eq 0 ]; then chk=1; fi\n"
    .. "xc=$($d compile \"$f\" -o $t.c 2>&1); crc=$?\n"
    .. "xd=$($d compile --backend=direct \"$f\" -o $t.d 2>&1); drc=$?\ncpa=0\n"
    .. "if [ $crc -eq 0 ]; then cpa=1; fi\nnat=0\nif [ $drc -eq 0 ]; then nat=1; fi\n"
    .. "ent=0\ncase \"$xd\" in *\"no linker entry\"*) ent=1;; esac\n"
    .. "prv=0\nif [ $cpa -eq 1 ] && [ $nat -eq 1 ]; then\n"
    .. "  {tprefix}$t.c > $t.co 2>/dev/null; a=$?\n"
    .. "  {tprefix}$t.d > $t.do 2>/dev/null; b=$?\n"
    .. "  if [ $a -ne 124 ] && [ $b -ne 124 ] && [ $a -eq $b ] && cmp -s $t.co $t.do; then prv=1; fi\nfi\n"
    .. "printf \"%s%s%s%s%s%s%s\\t%s\\n\" $des $par $chk $cpa $nat $prv $ent \"$f\"\n"
    .. "rm -f $t.c $t.d $t.co $t.do\n"

flagat: bool = (rec: str, at: i64)
    rec:sub(at, at) == "1"

pathof: str = (rec: str)
    i: i64 = 1
    n: i64 = rec:len()
    while i <= n and rec:byte(i) != 9
        i += 1
    rec:sub(i + 1, n)

blocking: bool = (path: str)
    incorpus = path:find("/native_differential/", 1, true)
    frontier = path:find("/unsupported/", 1, true)
        or path:find("/known_divergent/", 1, true)
    incorpus and not frontier

note: void = (path: str, why: str)
    ninversions += 1
    if shown < 40
        shown += 1
        inversions = "{inversions}    {why}   {path}\n"

tally: void = (rec: str)
    path = pathof(rec)
    des = flagat(rec, 1)
    par = flagat(rec, 2)
    chk = flagat(rec, 3)
    cpa = flagat(rec, 4)
    nat = flagat(rec, 5)
    prv = flagat(rec, 6)
    ent = flagat(rec, 7)
    can = prv and blocking(path)

    ntotal += 1
    if des
        ndescribed += 1
    if par
        nparsed += 1
    if chk
        nchecked += 1
    if cpa
        ncpath += 1
    if nat
        nnative += 1
    if prv
        nproven += 1
    if can
        ncanonical += 1
    if ent
        nnoentry += 1

    if can
        topcanon += 1
    elif prv
        topproven += 1
    elif nat
        topnative += 1
    elif cpa
        if ent
            topnoentry += 1
        else
            topbail += 1
    elif chk
        topchecked += 1
    elif par
        topparsed += 1
    elif des
        topdescribed += 1
    else
        topnone += 1

    if nat and not cpa
        note(path, "native, no C path  ")
    if cpa and not chk
        note(path, "C path, check fails")
    if nat and not chk
        note(path, "native, check fails")
    if chk and not des
        nundescribed += 1

rung: void = (label: str, n: i64, total: i64)
    v = n:to(str)
    t = total:to(str)
    print("    {label} {v} / {t}")

bucket: void = (label: str, n: i64, tail: str)
    v = n:to(str)
    print("    {label} {v}   {tail}")

main: i64 = ()
    duo = envor("DUO", "./zig-out/bin/idol")
    root = envor("CAPMATRIX_ROOT", "examples")
    jobs = envor("CAPMATRIX_JOBS", "8")
    limit = envor("CAPMATRIX_TIMEOUT", "10")

    if not duo:exists()
        print("capability_matrix: FAIL — no compiler at {duo}; run `zig build`")
        return 3

    stale = cap("find src -name \"*.zig\" -newer {duo} 2>/dev/null | head -3")
    if stale != ""
        print("capability_matrix: FAIL — {duo} is older than src/; run `zig build`")
        print("  newer than the binary: {stale}")
        return 3

    tprefix = ""
    for i, cand in {"timeout", "gtimeout"}
        if tprefix == "" and cap("command -v {cand} 2>/dev/null") != ""
            tprefix = "{cand} {limit} "

    status("rm -rf {work} && mkdir -p {work}")

    script.run(
        "find {root} -name \"*.id\" -not -path \"*/compile_fail/*\" | sort > {listpath}")
    wanted: i64 = to(i64)(script.chomp(script.capture("wc -l < {listpath}")))
    if wanted == 0
        print("capability_matrix: FAIL — no .id programs under {root}; the sweep is broken")
        return 3

    std.script.fs_write(probepath, probetext(duo, tprefix))
    std.script.run(
        "xargs -P {jobs} -n 1 sh {probepath} < {listpath} > {recordpath} 2>/dev/null")

    for i, line in std.script.fs_read(recordpath):split("\n")
        rec = std.script.chomp(line)
        if rec:len() > 8
            tally(rec)

    got = ntotal:to(str)
    want = wanted:to(str)
    if ntotal == 0
        print("capability_matrix: FAIL — 0 records for {want} programs; the sweep is broken")
        return 3
    if ntotal != wanted
        print("capability_matrix: FAIL — {got} records for {want} programs; the sweep lost files")
        return 3

    print("")
    print("  capability matrix over {root}/ (compile_fail excluded)")
    print("")
    print("  RUNG POPULATION — programs reaching each rung, measured independently")
    rung("described    ", ndescribed, ntotal)
    rung("parsed       ", nparsed, ntotal)
    rung("checked      ", nchecked, ntotal)
    rung("c path       ", ncpath, ntotal)
    rung("native       ", nnative, ntotal)
    rung("proven       ", nproven, ntotal)
    rung("canonical    ", ncanonical, ntotal)
    print("")
    print("  HIGHEST RUNG — every program in exactly one bucket")
    bucket("canonical             ", topcanon,
        "proven AND blocking; a regression fails native-differential")
    bucket("differentially proven ", topproven,
        "both backends run and agree; nothing blocks on it")
    bucket("direct-native         ", topnative,
        "builds native; the backends disagree, or one did not run")
    bucket("c path (no entry)     ", topnoentry,
        "nothing to link; the native rungs do not apply")
    bucket("c path (native bail)  ", topbail,
        "the direct-backend worklist")
    bucket("semantically checked  ", topchecked,
        "sema accepts it; neither backend produced an object")
    bucket("parsed                ", topparsed,
        "the front end accepts it; sema does not")
    bucket("described             ", topdescribed,
        "states its intent; the parser rejects it")
    bucket("none                  ", topnone,
        "no intent line, and does not parse")
    print("")
    bucket("no entry point        ", nnoentry,
        "direct backend has nothing to link — NOT a failure")
    bucket("undescribed           ", nundescribed,
        "checked, but carry no `--` statement of intent")
    print("")
    inv = ninversions:to(str)
    print("  LADDER INVERSIONS — {inv} reached a rung while failing one below it")
    if inversions != ""
        stdout:write(inversions)
    print("")

    if nparsed == 0
        print("capability_matrix: FAIL — 0 programs parsed; the parse probe is broken")
        return 3
    if ncpath == 0
        print("capability_matrix: FAIL — 0 programs took the C path; the probe is broken")
        return 3
    if nnative == 0
        print("capability_matrix: FAIL — 0 reached direct-native; the probe is broken")
        return 3
    if nproven == 0
        print("capability_matrix: FAIL — 0 differentially proven; the probe is broken")
        return 3
    if ncanonical == 0
        print("capability_matrix: FAIL — 0 canonical; the ladder is not wired")
        return 3

    provenfloor: i64 = to(i64)(envor("CAPMATRIX_PROVEN_FLOOR", "79"))
    checkedfloor: i64 = to(i64)(envor("CAPMATRIX_CHECKED_FLOOR", "285"))
    pf = provenfloor:to(str)
    cf = checkedfloor:to(str)
    pn = nproven:to(str)
    cn = nchecked:to(str)
    if nproven < provenfloor
        print("capability_matrix: FAIL — proven {pn} fell below the ratchet {pf}")
        return 1
    if nchecked < checkedfloor
        print("capability_matrix: FAIL — checked {cn} fell below the ratchet {cf}")
        return 1

    print("capability_matrix: PASS (proven {pn} >= {pf}, checked {cn} >= {cf})")
    0
