# The capability matrix — Pass 100 §22's "Running: nothing", replaced by a
# measurement.
#
# §22 used to answer the question "what works?" with a Boolean: implemented or
# not, and for the running story, `nothing`. That was conservative rather than
# honest. A compiler does not implement a program, it carries it some distance
# up a ladder, and the distance is the information:
#
#     described -> parsed -> semantically checked -> C path
#               -> direct-native -> differentially proven -> canonical
#
# This walks every program under examples/ and reports the population at each
# rung. Nothing here is asserted from a list a human maintains; every cell is
# the exit status of a command run against the file on this machine.
#
# WHAT EACH RUNG RUNS, and why that command and !a nearby one:
#
#   described   the file carries a `--` line. A program with no statement of
#               intent is a program, not evidence.
#   parsed      `duo check <f>` did not print `parse failed`. The front end
#               accepted the source, whatever sema then said about it.
#   checked     `duo check <f>` exits 0.
#   c path      `duo compile <f> -o T` exits 0.
#   native      `duo compile #backend=direct <f> -o T` exits 0. ONLY
#               `--backend=direct`: plain `duo compile` FALLS BACK to the C
#               backend and still prints `ok compile`, so a sweep over it
#               scores ~100% and means nothing. Same trap
#               scripts/native_census.id documents.
#   proven      both binaries BUILD, both RUN, and they agree on stdout and on
#               exit code. Compiling is not running — the bench suite reported
#               "Duo beats C" for a year off programs nothing ever executed.
#   canonical   the program lives in a BLOCKING native-differential directory
#               (the corpus root or native_only/), so losing a rung above
#               fails `zig build native-differential`. unsupported/ and
#               known_divergent/ are frontier reporting and do not block, so
#               they are proven-at-most. Proven but not canonical means proven
#               until someone breaks it quietly.
#
# `proven` HERE IS THE STRICT DEFINITION: a real differential, both backends,
# same stdout, same exit code. It is deliberately stricter than
# `zig build native-differential`, which additionally accepts a native_only/
# fixture matching its own declared `-- expect: N` — the C backend cannot
# compile those programs at all and so is not an oracle for them. Three
# fixtures sit in that gap (codegen_native, parser_token_stream,
# table_shared_param); they appear below as `native, no C path`, and they are
# proven by the gate even though they are not proven by this stricter test.
# 63 blocking fixtures, 60 proven here, 3 in the gap — that is the whole
# difference, and it reconciles exactly.
#
# THE LADDER IS NOT A TOTAL ORDER, and saying it is would hide the most
# interesting rows in the report. Eight programs compile to native ARM64 while
# the C backend REFUSES them. So each rung is measured as an independent
# predicate; the highest-rung census is derived from those, and every program
# that reached a rung while failing one below it is named under LADDER
# INVERSIONS. A matrix that silently sorted those into "c path" would be
# describing a ladder the compiler does not actually have.
#
# NO ENTRY POINT IS NOT A FAILURE. Most files under examples/ are fragments
# with nothing to link; the direct backend says `no linker entry` and the C
# backend happily synthesises a main from the top-level statements, which is
# why the two disagree on 118 files that have no bug in them. They are counted
# in their own bucket. Counting them as native failures is what put an earlier
# reading of native coverage at 1/60.
#
# RECONCILES WITH scripts/native_census.id, and this was CHECKED rather than
# assumed, on 2026-08-08 against the same binary. `native` here is its
# `native`: 89 = 89. `c path (native bail)` 47 plus the 5 programs that bail
# while also failing the C path is 52, which is its `bail` 40 + `unreachable`
# 12. Two sweeps written months apart, over the same corpus, by different
# routes, landing on the same partition is the only reason to believe either.
# If they ever part company, one of them has broken, and finding out which is
# worth more than either number alone.
#
# SISTER REPORT. scripts/capability_table.id runs the same rungs one fixture
# at a time over examples/native_differential, to answer "which CAPABILITIES
# are proven". This answers "how far does the POPULATION get". Neither
# duplicates `zig build native-differential`, which is the gate; both are
# reports, and a report that re-fails what a gate already fails just means two
# things to fix when one breaks.
#
# POSITIVE CONTROLS. This kind of report fails by measuring nothing, not by
# measuring something wrong, so every zero is checked: no files found, no
# records written, fewer records than files, or a zero population on a rung
# this repo demonstrably reaches, are all EXIT 3 — the sweep is broken — and
# never a green table.
#
# Exit 0 pass · 1 a rung fell below its ratchet · 3 the matrix could not run.
#
# Env: DUO, CAPMATRIX_ROOT, CAPMATRIX_JOBS, CAPMATRIX_TIMEOUT,
#      CAPMATRIX_PROVEN_FLOOR, CAPMATRIX_CHECKED_FLOOR.

work = "/tmp/duo-capability-matrix"
probepath = "/tmp/duo-capability-matrix/probe.sh"
recordpath = "/tmp/duo-capability-matrix/records.tsv"
listpath = "/tmp/duo-capability-matrix/files.list"

ndescribed = 0
nparsed = 0
nchecked = 0
ncpath = 0
nnative = 0
nproven = 0
ncanonical = 0
nnoentry = 0
nundescribed = 0
ntotal = 0

topcanon = 0
topproven = 0
topnative = 0
topnoentry = 0
topbail = 0
topchecked = 0
topparsed = 0
topdescribed = 0
topnone = 0

inversions = ""
ninversions = 0
shown = 0

chomp: str = (text: str)
    if text:len() == 0
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

capture: str = (shellline: str)
    gatecap(shellline)

cap: str = (shellline: str)
    chomp(gatecap(shellline))

status: i64 = (cmd: str)
    cap("( {cmd} ) >/dev/null 2>&1\necho $?"):to(i64)

envor: str = (name: str, fallback: str)
    os.env[name] or fallback

# The per-file probe, written out as shell because measuring 348 programs
# means ~1400 compiler and process invocations and Duo has no process pool.
# Duo still does all the REASONING: the probe emits seven raw booleans per
# file and nothing else, and every rung, bucket and inversion below is derived
# here from those booleans.
#
# Every status is read WITHOUT A PIPE. `cmd | tail; echo $?` reads tail, not
# cmd, and that exact shape has produced false greens in this repo. Command
# substitution keeps the status of the command being measured.
#
# Grouped one phase per literal rather than one shell line per literal: the
# phases are what a reader needs to check, and 30 concatenations of one line
# each hide them.
#
# `DUO_SEMANTIC_CACHE=0` IS LOAD-BEARING, and it is the most expensive thing
# this file learned. `duo check` writes `.id/cache/semantic/state.json` — ONE
# file, relative to the working directory — so eight parallel probes share one
# semantic cache and corrupt each other's reads. Two -P 8 sweeps minutes apart
# disagreed on SIX programs, and !only at the backends:
# `p09_closure.id` read `0000000` in one sweep and `0110000` in the next, so
# `duo check` itself was flipping and `parsed` and `checked` were flaky too.
# With the cache off, two sweeps are byte-identical, and the numbers go UP —
# checked 282 -> 285, c path 240 -> 246 — because the contention was producing
# FALSE FAILURES, the direction that quietly understates a capability report.
#
# THE FIX IS NOT AN ISOLATED WORKING DIRECTORY, which was tried first and is
# worse. It makes the sweep deterministic too, but `req "std.compiler.token"`
# resolves relative to the CWD, so three native_only fixtures lose their
# module and `native` reads 86 where native_census reads 89. A measurement
# that has to disagree with the neighbouring gate to be reproducible has
# picked the wrong isolation. Cache off, repo root, both properties hold.
#
# If you ever make this sweep faster, re-run it twice and DIFF THE RECORDS
# before believing either run. This class of fault does not announce itself;
# it just reports a slightly worse compiler than you have.
probetext: str = (duo: str, tprefix: str)
    "f=\"$1\"\nd={duo}\nt={work}/w$$\nexport DUO_SEMANTIC_CACHE=0\n"
    .. "des=0\ngrep -q \"^--\" \"$f\" && des=1\n"
    .. "oc=$($d check \"$f\" 2>&1); cr=$?\npar=1\n"
    .. "case \"$oc\" in *\"parse failed\"*) par=0;; esac\n"
    .. "chk=0\nif [ $cr -eq 0 ]; then chk=1; fi\n"
    .. "xc=$($d compile \"$f\" -o $t.c 2>&1); crc=$?\n"
    .. "xd=$($d compile --backend=direct \"$f\" -o $t.d 2>&1); drc=$?\ncpa=0\n"
    .. "if [ $crc -eq 0 ]; then cpa=1; fi\nnat=0\nif [ $drc -eq 0 ]; then nat=1; fi\n"
    .. "ent=0\ncase \"$xd\" in *\"no linker entry\"*) ent=1;; esac\n"
    # A miscompiled loop does not fail, it spins; 124 is the timeout marker,
    # and a run that timed out has no answer, which is not agreement.
    .. "prv=0\nif [ $cpa -eq 1 ] && [ $nat -eq 1 ]; then\n"
    .. "  {tprefix}$t.c > $t.co 2>/dev/null; a=$?\n"
    .. "  {tprefix}$t.d > $t.do 2>/dev/null; b=$?\n"
    .. "  if [ $a -ne 124 ] && [ $b -ne 124 ] && [ $a -eq $b ] && cmp -s $t.co $t.do; then prv=1; fi\nfi\n"
    .. "printf \"%s%s%s%s%s%s%s\\t%s\\n\" $des $par $chk $cpa $nat $prv $ent \"$f\"\n"
    .. "rm -f $t.c $t.d $t.co $t.do\n"

flagat: bool = (rec: str, at: i64)
    rec:sub(at, at) == "1"

pathof: str = (rec: str)
    i: i64 = 1
    n: i64 = rec:len()
    while i <= n and rec:byte(i) != 9
        i += 1
    rec:sub(i + 1, n)

# A program is canonical when a regression in it fails a BLOCKING gate.
# native_differential blocks on the corpus root and on native_only/; it prints
# unsupported/ and known_divergent/ as frontier reporting and passes anyway.
blocking: bool = (path: str)
    incorpus = path:find("/native_differential/", 1, true)
    frontier = path:find("/unsupported/", 1, true)
        or path:find("/known_divergent/", 1, true)
    incorpus and !frontier

note: void = (path: str, why: str)
    ninversions += 1
    if shown < 40
        shown += 1
        inversions = "{inversions}    {why}   {path}\n"

tally: void = (rec: str)
    path = pathof(rec)
    des = flagat(rec, 1)
    par = flagat(rec, 2)
    chk = flagat(rec, 3)
    cpa = flagat(rec, 4)
    nat = flagat(rec, 5)
    prv = flagat(rec, 6)
    ent = flagat(rec, 7)
    can = prv and blocking(path)

    ntotal += 1
    if des
        ndescribed += 1
    if par
        nparsed += 1
    if chk
        nchecked += 1
    if cpa
        ncpath += 1
    if nat
        nnative += 1
    if prv
        nproven += 1
    if can
        ncanonical += 1
    if ent
        nnoentry += 1

    # Highest rung reached. Each program lands in exactly one bucket, and the
    # C-path bucket is split because "compiles to C, nothing to link" and
    # "compiles to C, the direct backend bailed" are opposite facts about the
    # compiler that a single number would average into noise.
    if can
        topcanon += 1
    elif prv
        topproven += 1
    elif nat
        topnative += 1
    elif cpa
        if ent
            topnoentry += 1
        else
            topbail += 1
    elif chk
        topchecked += 1
    elif par
        topparsed += 1
    elif des
        topdescribed += 1
    else
        topnone += 1

    # Inversions: a rung reached over a rung missed. These are the rows worth
    # reading, and folding them into the ladder would erase them.
    #
    # `described` is deliberately NOT an inversion. A checked program with no
    # comment is a documentation gap, not a fact about the compiler, and there
    # are enough of them to bury the eight rows that ARE facts about the
    # compiler. It gets a count of its own instead — an inversion list nobody
    # reads to the bottom is an inversion list that has stopped working.
    if nat and !cpa
        note(path, "native, no C path  ")
    if cpa and !chk
        note(path, "C path, check fails")
    if nat and !chk
        note(path, "native, check fails")
    if chk and !des
        nundescribed += 1

rung: void = (label: str, n: i64, total: i64)
    v = n:to(str)
    t = total:to(str)
    print("    {label} {v} / {t}")

bucket: void = (label: str, n: i64, tail: str)
    v = n:to(str)
    print("    {label} {v}   {tail}")

main: i64 = ()
    duo = envor("DUO", "./zig-out/bin/idol")
    root = envor("CAPMATRIX_ROOT", "examples")
    jobs = envor("CAPMATRIX_JOBS", "8")
    limit = envor("CAPMATRIX_TIMEOUT", "10")

    if !std.script.fs_exists(duo)
        print("capability_matrix: FAIL — no compiler at {duo}; run `zig build`")
        return 3
    end

    # Stale binaries lie. A matrix measured with yesterday's compiler is a
    # confident report about a build nobody has. This does not run `zig build`
    # itself — a nested build inside `zig build capability-matrix` contends for
    # the same cache lock — it refuses to measure a binary older than the
    # sources that produced it. The build step depends on the install step, so
    # from `zig build capability-matrix` this is always already satisfied; it
    # fires for a bare `idol run`, which is exactly when it is needed. It caught
    # a stale binary twice while this file was being written, because another
    # session was editing src/ at the same time.
    stale = std.script.chomp(std.script.capture(
        "find src -name \"*.zig\" -newer {duo} 2>/dev/null | head -3"))
    if stale != ""
        print("capability_matrix: FAIL — {duo} is older than src/; run `zig build`")
        print("  newer than the binary: {stale}")
        return 3
    end

    tprefix = ""
    for i, cand in {"timeout", "gtimeout"}
        if tprefix == "" and std.script.chomp(std.script.capture(
            "command -v {cand} 2>/dev/null")) != ""
            tprefix = "{cand} {limit} "
        end
    end

    std.script.run("rm -rf {work} && mkdir -p {work}")

    # compile_fail/ is excluded because DENIED TEXT IS ITS ASSERTION. Those
    # programs exist to be rejected; scoring them here would shrink every rung
    # population and make every number mean less — the same argument
    # docs/spec/corpus.md makes for the canonical partition.
    std.script.run(
        "find {root} -name \"*.id\" -not -path \"*/compile_fail/*\" | sort > {listpath}")
    # `wc -l <`, not `awk END`, for a reason that is about Duo and !shell:
    # `{` opens a string interpolation hole, so an awk program cannot be
    # written in a Duo string literal at all. `find | sort` always ends its
    # output with a newline, so the line count is the file count.
    wanted: i64 = to(i64)(std.script.chomp(std.script.capture("wc -l < {listpath}")))
    if wanted == 0
        print("capability_matrix: FAIL — no .id programs under {root}; the sweep is broken")
        return 3
    end

    # The workers inherit this process's working directory — the repo root,
    # which `find {root}` above already depends on — so a relative compiler
    # path is the same path the rest of this file uses. An earlier revision
    # absolutised it, which was only needed by the isolated-directory design
    # the comment on probetext explains was wrong.
    std.script.fs_write(probepath, probetext(duo, tprefix))
    std.script.run(
        "xargs -P {jobs} -n 1 sh {probepath} < {listpath} > {recordpath} 2>/dev/null")

    for i, line in std.script.fs_read(recordpath):split("\n")
        rec = std.script.chomp(line)
        if rec:len() > 8
            tally(rec)
        end
    end

    got = ntotal:to(str)
    want = wanted:to(str)
    if ntotal == 0
        print("capability_matrix: FAIL — 0 records for {want} programs; the sweep is broken")
        return 3
    end
    # A worker that dies mid-sweep drops its line and every population below it
    # shrinks silently. The denominator is known independently, so check it.
    if ntotal != wanted
        print("capability_matrix: FAIL — {got} records for {want} programs; the sweep lost files")
        return 3
    end

    print("")
    print("  Pass 100 §22 — capability matrix over {root}/ (compile_fail excluded)")
    print("")
    print("  RUNG POPULATION — programs reaching each rung, measured independently")
    rung("described    ", ndescribed, ntotal)
    rung("parsed       ", nparsed, ntotal)
    rung("checked      ", nchecked, ntotal)
    rung("c path       ", ncpath, ntotal)
    rung("native       ", nnative, ntotal)
    rung("proven       ", nproven, ntotal)
    rung("canonical    ", ncanonical, ntotal)
    print("")
    print("  HIGHEST RUNG — every program in exactly one bucket")
    bucket("canonical             ", topcanon,
        "proven AND blocking; a regression fails native-differential")
    bucket("differentially proven ", topproven,
        "both backends run and agree; nothing blocks on it")
    bucket("direct-native         ", topnative,
        "builds native; the backends disagree, or one did not run")
    bucket("c path (no entry)     ", topnoentry,
        "nothing to link; the native rungs do not apply")
    bucket("c path (native bail)  ", topbail,
        "the direct-backend worklist")
    bucket("semantically checked  ", topchecked,
        "sema accepts it; neither backend produced an object")
    bucket("parsed                ", topparsed,
        "the front end accepts it; sema does not")
    bucket("described             ", topdescribed,
        "states its intent; the parser rejects it")
    bucket("none                  ", topnone,
        "no intent line, and does not parse")
    print("")
    bucket("no entry point        ", nnoentry,
        "direct backend has nothing to link — NOT a failure")
    bucket("undescribed           ", nundescribed,
        "checked, but carry no `--` statement of intent")
    print("")
    inv = ninversions:to(str)
    print("  LADDER INVERSIONS — {inv} reached a rung while failing one below it")
    if inversions != ""
        io.write(inversions)
    end
    print("")

    # Positive controls, one per rung this repo is known to reach. A rung that
    # reports 0 is a broken probe far more often than a broken compiler, and a
    # matrix that prints a green zero has stopped being evidence.
    if nparsed == 0
        print("capability_matrix: FAIL — 0 programs parsed; the parse probe is broken")
        return 3
    end
    if ncpath == 0
        print("capability_matrix: FAIL — 0 programs took the C path; the probe is broken")
        return 3
    end
    if nnative == 0
        print("capability_matrix: FAIL — 0 reached direct-native; the probe is broken")
        return 3
    end
    if nproven == 0
        print("capability_matrix: FAIL — 0 differentially proven; the probe is broken")
        return 3
    end
    if ncanonical == 0
        print("capability_matrix: FAIL — 0 canonical; the ladder is not wired")
        return 3
    end

    # Ratchets on the two rungs nothing else guards. `native` is
    # native_census's ratchet and is deliberately not re-ratcheted here;
    # `canonical` is native-differential's. Lower a floor whenever you lower a
    # count on purpose; that is the whole protocol.
    #
    # Both floors are the counts measured on 2026-08-08. `proven` moved 75 ->
    # 79 between two runs an hour apart, on a codegen change landing in another
    # session, so it is a live number and !a constant: raise it when you
    # raise it.
    provenfloor: i64 = to(i64)(envor("CAPMATRIX_PROVEN_FLOOR", "79"))
    checkedfloor: i64 = to(i64)(envor("CAPMATRIX_CHECKED_FLOOR", "285"))
    pf = provenfloor:to(str)
    cf = checkedfloor:to(str)
    pn = nproven:to(str)
    cn = nchecked:to(str)
    if nproven < provenfloor
        print("capability_matrix: FAIL — proven {pn} fell below the ratchet {pf}")
        return 1
    end
    if nchecked < checkedfloor
        print("capability_matrix: FAIL — checked {cn} fell below the ratchet {cf}")
        return 1
    end

    print("capability_matrix: PASS (proven {pn} >= {pf}, checked {cn} >= {cf})")
    0
end
