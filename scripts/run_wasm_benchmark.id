# WASM runtime benchmark with a ratcheted wall-clock baseline.
#
# ledger/perf contract: wasm benchmark
# oracle: wasm: FAIL
# negative: wasm: PASS
# verdict: wasmtime runtime oracle axis
#
# Duo replacement for scripts/run_wasm_benchmark.sh (monoglot census).
#
# Compiles examples/benchmark_wasm.lua to wasm32-wasi, runs it under every
# runtime on PATH, checks correctness, times each, and gates against
# benchmarks/wasm_baseline.txt: a runtime more than 10% slower than its
# recorded time fails the build.
#
# Usage: idol run scripts/run_wasm_benchmark.id # [--reset-baseline] [--runs N]

_BENCHES = 40
_REGRESS_PCT = 10.0
_WORK = "/tmp/duo_wasm_bench"
_SRC = "examples/benchmark_wasm.lua"

_env_or: str = (n: str, d: str)
    v = script.getenv_or(n)
    if v == "" return d
    v

_pad: str = (s: str, w: i64)
    o = s
    while o:len() < w
        o = o .. " "
    o

_lpad: str = (s: str, w: i64)
    o = s
    while o:len() < w
        o = " " .. o
    o

# `to(str)` on an f64 does not compile, so fixed-point comes from integers.
# Negative values matter here: a delta percentage can be either sign, and
# flooring a negative toward zero would report an improvement as a regression.
_fx: str = (x: f64, places: i64)
    neg = false
    v = x
    if v < 0.0
        neg = true
        v = -v
    scale = 1
    i = 0
    while i < places
        scale = scale * 10
        i += 1
    n = to(i64)(v * to(f64)(scale) + 0.5)
    w = n / scale
    f = n % scale
    fs = f:to(str)
    while fs:len() < places
        fs = "0" .. fs
    s = w:to(str) .. "." .. fs
    if neg return "-" .. s
    s

_have: bool = (t: str)
    script.chomp(script.capture("command -v " .. t .. " 2>/dev/null")) != ""

_fields: any = (l: str)
    o = {}
    for _i, w in l:gsub("\t", " "):split(" ")
        if w != "" o[o:len() + 1] = w
    o

# "RESULT <id> <value>" lines, joined, so two runtimes can be compared as one
# string rather than field by field.
_result_block: str = (text: str)
    out = ""
    n = 0
    for _i, l in text:split("\n")
        f = _fields(script.chomp(l))
        if f:len() >= 3 and f[1] == "RESULT"
            out = out .. f[2] .. " " .. f[3] .. "\n"
            n += 1
    out .. "__n " .. n:to(str)

_result_count: i64 = (block: str)
    for _i, l in block:split("\n")
        f = _fields(l)
        if f:len() == 2 and f[1] == "__n"
            return to(i64)(f[2])
    0

# Wall clock via time.monotonic. The shell version needed a two-stage
# fallback # `/usr/bin/time -f %e`, and if that produced something
# unparseable, bash's own TIMEFORMAT='%R' -- because GNU and BSD `time` differ.
# An in-process clock has neither problem and no fork per sample.
_wall_seconds: f64 = (cmd: str)
    t0 = std.time.monotonic()
    std.script.run(cmd .. " >/dev/null 2>&1")
    to(f64)(std.time.monotonic() - t0) / 1000000000.0

_min_wall: f64 = (cmd: str, runs: i64)
    best = 0.0
    i = 0
    while i < runs
        t = _wall_seconds(cmd)
        if best == 0.0 or t < best best = t
        i += 1
    best

_baseline_for: f64 = (path: str, rt: str)
    if !std.script.fs_exists(path) return 0.0
    for _i, l in std.script.capture("cat " .. path):split("\n")
        c = std.script.chomp(l)
        if c != "" and c:sub(1, 1) != "#"
            f = _fields(c)
            if f:len() >= 2 and f[1] == rt
                return to(f64)(f[2])
    0.0

_save_baseline = (path: str, names: any, times: any, runs: i64)
    std.script.run("mkdir -p $(dirname " .. path .. ")")
    commit = std.script.chomp(std.script.capture("git rev-parse --short HEAD 2>/dev/null"))
    if commit == "" commit = "unknown"
    body = "# Duo WASM Runtime Benchmark Baseline\n"
        .. "# Generated: " .. std.script.chomp(std.script.capture("date -u '+%Y-%m-%d %H:%M:%S UTC'")) .. "\n"
        .. "# Commit: " .. commit .. "\n"
        .. "# Runs per runtime: " .. runs:to(str) .. "\n#\n"
        .. "# runtime  total_wall_seconds\n"
    for i, n in names
        body = body .. _pad(n, 12) .. "  " .. _fx(times[i], 3) .. "\n"
    std.script.fs_write(path, body)
    print("  INFO Baseline saved -> " .. path)

main: i64 = ()
    args = std.os.args()
    reset = false
    runs = to(i64)(_env_or("WASM_BENCH_RUNS", "3"))
    if runs == nil or runs < 1 runs = 3

    i = 1
    while i <= args:len()
        a = args[i]
        if a == "--reset-baseline"
            reset = true
        else
            if a == "--runs"
                if i + 1 > args:len()
                    print("ERROR: --runs requires a value")
                    os.exit(1)
                runs = to(i64)(args[i + 1])
                i += 1
            else
                if a != "--"
                    print("ERROR: unknown argument: " .. a)
                    os.exit(1)
        i += 1
    if runs == nil or runs < 1
        print("ERROR: runs must be a positive integer")
        os.exit(1)

    std.script.run("rm -rf " .. _WORK .. " && mkdir -p " .. _WORK)
    wasm = _WORK .. "/duo_wasm_bench.wasm"
    baseline = _env_or("WASM_BENCH_BASELINE", "benchmarks/wasm_baseline.txt")
    filter = std.script.getenv_or("WASM_BENCH_RUNTIMES")

    candidates = {
        { "wasmtime", "wasmtime", "wasmtime run " },
        { "wazero", "wazero", "wazero run " },
        { "iwasm", "iwasm", "iwasm " },
        { "wasmer", "wasmer", "wasmer " },
        { "spin", "spin", "spin up --file " },
    }
    names = {}
    cmds = {}
    for _i, c in candidates
        wanted = filter == "" or filter:find(c[1], 1, true) != nil
        if wanted and _have(c[2])
            names[names:len() + 1] = c[1]
            cmds[names:len()] = c[3] .. wasm
            print("  INFO Found runtime: " .. c[1])
    if names:len() == 0
        print("ERROR: No WASM runtimes found. Install at least one of:")
        print("  wasmtime  https://wasmtime.dev")
        print("  wazero    go install github.com/tetratelabs/wazero/cmd/wazero@latest")
        print("  iwasm     https://github.com/bytecodealliance/wasm-micro-runtime/releases")
        os.exit(1)

    print("")
    print("=== Compiling benchmark to WASM ===")
    duo = "./zig-out/bin/idol"
    std.script.run(duo .. " compile " .. _SRC .. " --target wasm32-wasi -o " .. wasm)
    # Existence is checked separately from the exit status: the compiler can
    # report success and write nothing, or the wrong format (GAP-19).
    if !std.script.fs_exists(wasm)
        print("ERROR: WASM compilation failed — " .. wasm .. " not produced.")
        os.exit(1)
    print("  INFO Produced: " .. wasm .. " ("
        .. std.script.chomp(std.script.capture("du -sh " .. wasm .. " | cut -f1")) .. ")")

    print("")
    print("=== Correctness (RESULT lines, first runtime: " .. names[1] .. ") ===")
    first = _result_block(std.script.capture(cmds[1] .. " 2>/dev/null"))
    n = _result_count(first)
    if n != _BENCHES
        print("ERROR: Expected " .. _BENCHES:to(str) .. " RESULT lines, got " .. n:to(str) .. ".")
        os.exit(1)
    print("  PASS All " .. _BENCHES:to(str) .. " RESULT lines present")

    # Two runtimes disagreeing on a RESULT is a wasm codegen bug, not a
    # performance note, so it fails before any timing is reported.
    if names:len() >= 2
        second = _result_block(std.script.capture(cmds[2] .. " 2>/dev/null"))
        if first == second
            print("  PASS Results match between " .. names[1] .. " and " .. names[2])
        else
            print("  FAIL Result mismatch between " .. names[1] .. " and " .. names[2])
            os.exit(1)

    print("")
    print("=== Timing (min of " .. runs:to(str) .. " runs, wall-clock seconds) ===")
    times = {}
    for i2, nm in names
        print("  INFO Timing " .. nm .. "...")
        times[i2] = _min_wall(cmds[i2], runs)
        print("  " .. _pad(nm, 12) .. "  " .. _fx(times[i2], 3) .. "s")

    print("")
    if reset or !std.script.fs_exists(baseline)
        if reset
            print("=== Resetting baseline ===")
        else
            print("=== No baseline found — writing initial baseline ===")
        _save_baseline(baseline, names, times, runs)
        print("")
        for i2, nm in names
            print(_pad(nm, 12) .. "  " .. _lpad(_fx(times[i2], 3), 10) .. "  "
                .. _lpad("(new)", 11) .. "  " .. _lpad("baseline", 8))
        return 0

    print(_pad("Runtime", 12) .. "  " .. _lpad("Current(s)", 10) .. "  "
        .. _lpad("Baseline(s)", 11) .. "  " .. _lpad("Delta", 8))
    print(_pad("------------", 12) .. "  " .. _lpad("----------", 10) .. "  "
        .. _lpad("-----------", 11) .. "  " .. _lpad("--------", 8))

    gate_fail = false
    for i2, nm in names
        cur = times[i2]
        base = _baseline_for(baseline, nm)
        if base <= 0.0
            print(_pad(nm, 12) .. "  " .. _lpad(_fx(cur, 3), 10) .. "  "
                .. _lpad("(none)", 11) .. "  " .. _lpad("new", 8))
        else
            delta = (cur - base) / base * 100.0
            status = "OK"
            if delta > _REGRESS_PCT
                status = "REGRESSED"
                gate_fail = true
            else
                if cur < base * 0.98 status = "IMPROVED"
            print(_pad(nm, 12) .. "  " .. _lpad(_fx(cur, 3), 10) .. "  "
                .. _lpad(_fx(base, 3), 11) .. "  " .. _lpad(_fx(delta, 1) .. "%", 8)
                .. "  " .. status)

    # The baseline only moves on a PASSING run. Saving after a regression
    # would ratchet the slowdown in and the gate would never fire again.
    if !gate_fail
        print("")
        _save_baseline(baseline, names, times, runs)

    if names:len() >= 2
        print("")
        print("=== Relative speed (" .. names[1] .. "=1.0x reference, lower is faster) ===")
        ref = times[1]
        for i2, nm in names
            if ref < 0.000000001
                print("  " .. _pad(nm, 12) .. "  N/A")
            else
                print("  " .. _pad(nm, 12) .. "  " .. _fx(times[i2] / ref, 2) .. "x")

    print("")
    if gate_fail
        print("WASM benchmark FAILED: one or more runtimes regressed by >"
            .. to(str)(to(i64)(_REGRESS_PCT)) .. "%.")
        print("Run with --reset-baseline to accept the new times as the new baseline.")
        os.exit(1)
    print("WASM benchmark PASSED: all runtimes at or better than baseline.")
    0
