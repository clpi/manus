# Tracked JavaScript debt ledger for the self-hosting target.
#
# language_census keeps the count bounded. This prints the exact tracked files
# so the remaining non-duon debt is visible without re-reading prose.

process = lib.process

lines: any = (text: str)
    out = {}
    start = 1
    i = 1
    n = text:len()
    while i <= n
        if text:byte(i) == 10
            if i > start
                out:push(text:sub(start, i - 1))
            start = i + 1
        i += 1
    if start <= n
        out:push(text:sub(start, n))
    out

vscode: bool = (root: str, path: str)
    path == "ext/vscode-duo/extension.js" and process.run("cd '{root}' && ./zig-out/bin/idol run scripts/vscodeproj.id") == 0

tree: bool = (root: str, path: str)
    path == "ext/tree-sitter-duo/grammar.js" and process.run("cd '{root}' && env TSEMIT_CHECK=1 ./zig-out/bin/idol run scripts/treesitter_emit.id") == 0

main: i64 = ()
    root = process.chomp(process.capture("git rev-parse --show-toplevel 2>/dev/null"))
    if root == ""
        print("jsledger: fail no git root")
        process.exit(3)

    files = lines(process.capture("cd '{root}' && git ls-files '*.js' | sort"))
    generated = {}
    partial = {}
    authored = {}
    for i = 1, files:len()
        path = files[i]
        if vscode(root, path)
            generated:push(path)
        if !vscode(root, path) and tree(root, path)
            generated:push(path)
        if !vscode(root, path) and !tree(root, path)
            authored:push(path)

    filecount = files:len()
    gencount = generated:len()
    partcount = partial:len()
    authcount = authored:len()

    if filecount == 0
        print("jsledger: pass tracked js 0")
        process.exit(0)

    status = "fail"
    if partcount == 0 and authcount == 0
        status = "pass"
    print("jsledger: {status} tracked js {filecount}")
    print("generated {gencount}")
    for i = 1, gencount
        print("  {generated[i]}")
    print("partial {partcount}")
    for i = 1, partcount
        print("  {partial[i]}")
    print("authored {authcount}")
    for i = 1, authcount
        print("  {authored[i]}")
    if partcount == 0 and authcount == 0
        process.exit(0)
    process.exit(1)
    0
