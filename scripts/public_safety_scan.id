# Public safety pre-scan (tracked + staged files).
# Exit 0 = no hits; exit 1 = review required.
#
# One gatecap round-trip via embedded scan payload (native gatecap cannot chain).

chomp: str = (text: str)
  if not text:len()
    return ""
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32 and c != 9
      break
    n = n - 1
  text:sub(1, n)

cap: str = (shellline: str)
  chomp(gatecap(shellline))

scan: i64 = ()
  rc = cap("echo  | base64 -d | sh"):to(i64)
  if rc != 0
    print("public_safety_scan: FAIL")
    return 1
  print("public_safety_scan: PASS")
  0
