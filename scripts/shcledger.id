# Self-hosting completion ledger.
#
# This does not make production claims. It reports the current blockers to a
# 100% Idol self-hosting state from live repository facts, and keeps expensive
# proof execution behind SHCLEDGER_DEEP=1 so the default census stays cheap.

chomp: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c != 10 and c != 13 and c != 32
      break
    n = n - 1
  text:sub(1, n)

capture: str = (cmd: str)
  f = io.popen(cmd, "r")
  if f == nil
    return ""
  out = ""
  line = f:read("*a")
  if line != nil
    out = line
  f:close()
  chomp(out)

cap: str = (cmd: str)
  chomp(capture(cmd))

shellstatus: i64 = (cmd: str)
  to(i64)(cap("( " .. cmd .. " ) >/dev/null 2>&1; echo $?"))

lines: any = (text: str)
  out = {}
  start = 1
  i = 1
  n = text:len()
  while i <= n
    if text:byte(i) == 10
      if i > start
        out(out:len() + 1) = text:sub(start, i - 1)
      start = i + 1
    i = i + 1
  if start <= n
    out(out:len() + 1) = text:sub(start, n)
  out

count: i64 = (root: str, cmd: str)
  out = cap("cd '" .. root .. "' && " .. cmd)
  if out == ""
    return 0
  n = out:len()
  while n > 0 and out:byte(n) == 32
    n = n - 1
  if n == 0
    return 0
  to(i64)(out:sub(1, n))

has: bool = (text: str, part: str)
  pos = text:find(part, 1, true)
  pos != nil and pos > 0

need: i64 = (text: str, part: str, label: str)
  if has(text, part)
    print("  ok   {label}")
    return 0
  print("  FAIL {label}")
  1

neednum: i64 = (got: i64, want: i64, label: str)
  if got == want
    print("  ok   {label} {got}")
    return 0
  print("  FAIL {label} got {got} want {want}")
  1

runcheck: i64 = (root: str, name: str, cmd: str)
  rc = shellstatus("cd '" .. root .. "' && " .. cmd .. " > /tmp/duo-shcledger-" .. name .. ".out 2>&1")
  if rc == 0
    print("  ok   {name}")
    return 0
  print("  FAIL {name} status {rc} (/tmp/duo-shcledger-{name}.out)")
  1

bucket: str = (path: str)
  if path == "build.zig"
    return "zigbuild"
  if has(path, "test") or has(path, "fixture")
    return "zigtest"
  if has(path, "wasm")
    return "zigwasm"
  if has(path, "native") or has(path, "dnir") or has(path, "abi")
    return "zignative"
  if has(path, "semantic") or has(path, "graph") or has(path, "relation") or has(path, "realization")
    return "zigsemantic"
  if has(path, "lexer") or has(path, "parser") or has(path, "token") or has(path, "sema")
    return "zigfront"
  if has(path, "codegen") or has(path, "backend") or has(path, "lower") or has(path, "jit")
    return "zigback"
  "zigsupport"

bucketcount: i64 = (files: any, name: str)
  total = 0
  for i = 1, files:len()
    if bucket(files(i)) == name
      total = total + 1
  total

envor: str = (name: str, fallback: str)
  v = os.env(name)
  if v == nil or v == ""
    fallback
  else
    v

main: i64 = ()
  root = cap("git rev-parse --show-toplevel 2>/dev/null")
  if root == ""
    print("shcledger: FAIL no git root")
    return 3

  duobin = root .. "/zig-out/bin/idol"
  zigfiles = lines(capture("cd '" .. root .. "' && git ls-files '*.zig' | sort"))
  zig = zigfiles:len()
  cboot = count(root, "git ls-files '*.[ch]' | grep -E '^(src/|lib/c/)' | wc -l")
  rootforeign = count(root, "find . -maxdepth 1 -type f \\( -name '*.py' -o -name '*.sh' \\) -print | wc -l")
  js = count(root, "git ls-files '*.js' | wc -l")
  embedded = count(root, "git ls-files '*.id' | grep -v 'scripts/foreign_census.id' | tr '\\n' '\\0' | xargs -0 grep -h -E '@(comp\\.)?c\\.(emit|include)' 2>/dev/null | grep -v -E '^[[:space:]]*--' | grep -o -E '@(comp\\.)?c\\.(emit|include)' | wc -l")
  jsgen = 0
  if shellstatus("cd '" .. root .. "' && " .. duobin .. " run scripts/vscodeproj.id > /dev/null 2>&1") == 0
    jsgen = jsgen + 1
  if shellstatus("cd '" .. root .. "' && env TSEMIT_CHECK=1 " .. duobin .. " run scripts/treesitter_emit.id > /dev/null 2>&1") == 0
    jsgen = jsgen + 1
  jsauth = js - jsgen
  zb = bucketcount(zigfiles, "zigbuild")
  zf = bucketcount(zigfiles, "zigfront")
  zk = bucketcount(zigfiles, "zigback")
  zn = bucketcount(zigfiles, "zignative")
  zw = bucketcount(zigfiles, "zigwasm")
  zs = bucketcount(zigfiles, "zigsemantic")
  zt = bucketcount(zigfiles, "zigtest")
  zu = bucketcount(zigfiles, "zigsupport")

  print("shcledger -- current blockers to 100% Idol self-hosting")
  print("  zig bootstrap files     {zig}")
  print("  c bootstrap files       {cboot}")
  print("  js authored files       {jsauth}")
  print("  root sh/py scratch      {rootforeign}")
  print("  generated js projections {jsgen}")
  print("  advertise embedded {embedded}")
  print("  audit     scripts/embedledger.id")
  print("  enforce   zero sites (embedledger gate)")

  print("zig queue")
  print("  zigbuild    {zb}")
  print("  zigfront    {zf}")
  print("  zigback     {zk}")
  print("  zignative   {zn}")
  print("  zigwasm     {zw}")
  print("  zigsemantic {zs}")
  print("  zigtest     {zt}")
  print("  zigsupport  {zu}")

  bad = 0
  manifest = capture("cd '" .. root .. "' && cat scripts/selfhost_manifest.id")
  rows = count(root, "grep -c '_row(\"SH-' scripts/selfhost_manifest.id")
  impl = count(root, "grep -c 'duo_impl_rows.*14' scripts/selfhost_manifest.id")
  oracle = count(root, "grep -c 'oracle_backed_rows.*13' scripts/selfhost_manifest.id")
  canonical = count(root, "grep -c 'duo_canonical_rows.*1' scripts/selfhost_manifest.id")
  print("manifest contract")
  bad = bad + neednum(rows, 14, "manifest rows")
  bad = bad + neednum(impl, 1, "duo implementation summary")
  bad = bad + neednum(oracle, 1, "oracle-backed summary")
  bad = bad + neednum(canonical, 1, "production-canonical summary")
  bad = bad + need(manifest, "production dispatch: host still calls src/*.zig", "production dispatch blocker named")
  bad = bad + need(manifest, "FIXTURES ONLY", "fixture-only backend row not hidden")

  print("cheap gates")
  bad = bad + runcheck(root, "language_census", duobin .. " run --backend=c scripts/language_census.id")
  bad = bad + runcheck(root, "foreign_census", duobin .. " run --backend=c scripts/foreign_census.id")
  bad = bad + runcheck(root, "embedledger", duobin .. " run --backend=c scripts/embedledger.id")
  bad = bad + runcheck(root, "gates/build", duobin .. " run gates/build.id")

  deep = envor("SHCLEDGER_DEEP", "0")
  if deep == "1"
    print("deep gates")
    bad = bad + runcheck(root, "selfhost_proofs", duobin .. " run scripts/selfhost_proofs.id")
    bad = bad + runcheck(root, "debtledger", duobin .. " run scripts/debtledger.id")
  else
    print("deep gates skipped (set SHCLEDGER_DEEP=1)")

  debt = zig + cboot + js + rootforeign + embedded
  if bad == 0 and debt == 0
    print("shcledger: PASS complete")
    return 0
  print("shcledger: FAIL blockers {debt} checks {bad}")
  return 1
