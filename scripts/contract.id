
here: str = ()
  std.script.chomp(std.script.capture("pwd"))

compiler: str = (root: str)
  "{root}/zig-out/bin/idol"

shout = (msg: str)
  print("contract: {msg}")

present: bool = (path: str)
  std.script.status("test -e {path}") == 0

code: i64 = (bin: str, verb: str, fixture: str)
  std.script.status("{bin} {verb} {fixture} >/dev/null 2>&1")

codecompile: i64 = (bin: str, flags: str, fixture: str)
  std.script.status("{bin} compile {flags} {fixture} -o /dev/null >/dev/null 2>&1")

mentions: bool = (bin: str, verb: str, fixture: str, want: str)
  script.status("{bin} {verb} {fixture} 2>&1 | grep -q -F '{want}'") == 0

mentionsq: bool = (bin: str, verb: str, fixture: str, want: str)
  script.status("{bin} {verb} {fixture} 2>&1 | grep -q -F \"{want}\"") == 0

compilesays: bool = (bin: str, flags: str, fixture: str, want: str)
  script.status("{bin} compile {flags} {fixture} -o /dev/null 2>&1 | grep -q -F '{want}'") == 0

main: i64 = ()
  root = here()
  bin = compiler(root)
  bad = 0

  if script.status("false") == 0
    shout("FAIL — control: status() called `false` a success")
    bad = bad + 1

  if script.status("true") != 0
    shout("FAIL — control: status() called `true` a failure")
    bad = bad + 1

  if not present(bin)
    shout("FAIL — no compiler at {bin}; run `zig build` first")
    bad = bad + 1

  naok = "{root}/examples/contracts/noalloc_ok.id"
  nabad = "{root}/examples/contracts/noalloc_fail.id"
  pureok = "{root}/examples/contracts/pure_ok.id"
  purebad = "{root}/examples/compile_fail/pure_module_state.id"
  lexbad = "{root}/examples/compile_fail/lex_slash_comment.id"

  if not present(naok)
    shout("FAIL — missing fixture {naok}")
    bad = bad + 1
  if not present(nabad)
    shout("FAIL — missing fixture {nabad}")
    bad = bad + 1
  if not present(pureok)
    shout("FAIL — missing fixture {pureok}")
    bad = bad + 1
  if not present(purebad)
    shout("FAIL — missing fixture {purebad}")
    bad = bad + 1
  if not present(lexbad)
    shout("FAIL — missing fixture {lexbad}")
    bad = bad + 1

  if mentions(bin, "check", naok, "duo-contract-this-string-does-not-exist")
    shout("FAIL — control: mentions() matched a string that is not in the output")
    bad = bad + 1

  if code(bin, "check", naok) != 0
    shout("FAIL — `check` rejected the module that honours @noalloc")
    bad = bad + 1
  if codecompile(bin, "", naok) != 0
    shout("FAIL — `compile` rejected the module that honours @noalloc")
    bad = bad + 1
  if mentions(bin, "check", naok, "@noalloc violated")
    shout("FAIL — the honouring module was diagnosed anyway")
    bad = bad + 1

  if code(bin, "check", nabad) == 0
    shout("FAIL — `check` accepted a module that violates @noalloc")
    bad = bad + 1
  if codecompile(bin, "", nabad) == 0
    shout("FAIL — `compile` accepted a module that violates @noalloc")
    bad = bad + 1
  if not compilesays(bin, "", nabad, "@noalloc violated")
    shout("FAIL — `compile` refused without naming the contract")
    bad = bad + 1
  if not compilesays(bin, "--backend=direct", nabad, "@noalloc violated")
    shout("FAIL — `compile --backend=direct` did not diagnose the @noalloc violation")
    bad = bad + 1
  if not compilesays(bin, "", nabad, "@noalloc violated")
    shout("FAIL — `compile ` did not diagnose the @noalloc violation")
    bad = bad + 1
  if code(bin, "explain", nabad) == 0
    shout("FAIL — `explain` exited 0 on a @noalloc violation")
    bad = bad + 1
  if code(bin, "run", nabad) == 0
    shout("FAIL — `run` accepted a module that violates @noalloc")
    bad = bad + 1

  if not mentionsq(bin, "check", nabad, "@noalloc violated in function 'leak'")
    shout("FAIL — the @noalloc diagnostic did not name the function")
    bad = bad + 1
  if not mentions(bin, "check", nabad, "heap allocation at mem.alloc")
    shout("FAIL — the @noalloc diagnostic did not name the allocation site")
    bad = bad + 1
  if not mentions(bin, "check", nabad, "[allocate_output_separately]")
    shout("FAIL — the @noalloc diagnostic carried no repair edge")
    bad = bad + 1

  if not mentions(bin, "explain", nabad, "\"transformation\":\"contract.noalloc\"")
    shout("FAIL — `explain` stopped rendering the contract outcome")
    bad = bad + 1

  if code(bin, "check", pureok) != 0
    shout("FAIL — `check` rejected the module that honours @pure")
    bad = bad + 1
  if code(bin, "check", purebad) == 0
    shout("FAIL — `check` accepted a @pure function reading mutable module state")
    bad = bad + 1
  if codecompile(bin, "", purebad) == 0
    shout("FAIL — `compile` accepted a @pure function reading mutable module state")
    bad = bad + 1
  if not mentionsq(bin, "check", purebad, "reads module state 'seed'")
    shout("FAIL — the @pure diagnostic did not name the module state it reads")
    bad = bad + 1
  if mentions(bin, "check", pureok, "@pure violated")
    shout("FAIL — the honouring @pure module was diagnosed anyway")
    bad = bad + 1

  if code(bin, "check", lexbad) == 0
    shout("FAIL — `check` accepted a file the lexer refuses")
    bad = bad + 1
  if code(bin, "explain", lexbad) == 0
    shout("FAIL — `explain` accepted a file the lexer refuses")
    bad = bad + 1
  if not mentions(bin, "explain", lexbad, "lex_slash_comment.id:1:")
    shout("FAIL — the lexer diagnostic named no file and no span")
    bad = bad + 1
  if not mentions(bin, "explain", lexbad, "a idol comment starts with")
    shout("FAIL — the lexer diagnostic carried no repair")
    bad = bad + 1
  if mentions(bin, "explain", lexbad, "UnexpectedChar")
    shout("FAIL — `explain` printed the raw lexer error name (H-8 output totality)")
    bad = bad + 1

  if bad == 0
    shout("PASS — @noalloc across 6 verb paths, @pure both halves, the lexer diagnostic, 5 controls held")
  bad

os.exit(main())
