# Compile time + binary size, Idol against C. A TRACKING benchmark: it reports,
# it does not fail when Idol is slower or larger.
#
# ledger/perf contract: compile size benchmark
# oracle: compile_size: FAIL
# negative: compile_size: PASS
# verdict: artifact size and compile-time evidence
#
# Idol replacement for scripts/run_compile_size_benchmark.sh (monoglot census,
# G11). The shell version was the last tracked .sh in the repo and it carried
# TWO foreign languages, not one: 439 lines of bash plus two inline python3
# heredocs (39 lines) — one the wall-clock timer, one the ML float comparison.
# Both are arithmetic, which is exactly what the census says belongs in Idol.
#
# WHAT IS STILL SHELLED OUT, and why none of it is reasoning:
#   uname / xcrun / mktemp / cp / rm     environment facts and file moves
#   stat -f%z, wc -l                     one number, read back and compared here
#   grep '^RESULT ' | sort               selecting and ordering lines; the
#                                        COMPARISON of those lines is Idol
#   the compilers themselves             the thing being measured
# No branch, no ratio and no tolerance is computed by foreign machinery.
#
# THE ONE MEASUREMENT DIFFERENCE, stated rather than buried. The shell version
# timed with python's perf_counter around a child runner, which forks and
# execs the compiler directly. Idol's process primitive goes through system(3),
# which inserts a /bin/sh between this process and the compiler and costs
# about 3.6 ms every call. So the harness MEASURES that floor — the min over
# eight runs of an empty command, which spawns the shell and nothing else —
# subtracts it, and PRINTS the value it subtracted, so the correction is
# visible rather than assumed. Against the shell version's last run every
# deterministic column is identical and compile_s agrees closely; the
# correction is what makes the second half of that true.
#
# SOURCES ARE STREAMED TO DISK, NOT BUILT IN MEMORY. The 10k workload is a
# 205 KB source. Accumulating it with string interpolation is quadratic AND
# hits a live native-backend defect: a 1500-iteration append loop sitting
# beside a few i64 scalars compiles clean under #backend=direct and then
# SEGFAULTS before its first print (exit 139), while runs the same
# program correctly. Writing each block straight to an open file handle is
# linear and steps around it.
#
# Env: RUNS, CHAIN_FUNCS_1K (or CHAIN_FUNCS), CHAIN_FUNCS_10K, CC, STRIP,
# SDKROOT, ZIG, DUO_ROOT. Exit 0 report produced, 1 a workload disagreed with
# C, a capture came back short, or a compile failed.

sh(cmd: str): str
    std.script.chomp(std.script.capture(cmd))

pad(s: str, w: i64): str
    o = s
    while o:len() < w
        o = "{o} "
    o

lpad(s: str, w: i64): str
    o = s
    while o:len() < w
        o = " {o}"
    o

digits(n: i64, w: i64): str
    o = n:to(str)
    while o:len() < w
        o = "0{o}"
    o

# Seconds with six places, from integer nanoseconds. `to(str)` on an f64 does
# not compile, and a float round trip would put the last digit at the mercy of
# the printer; this arithmetic is exact in i64.
secs(ns: i64): str
    v: i64 = ns
    if v < 0
        v = 0
    micro: i64 = (v + 500) // 1000
    whole: i64 = micro // 1000000
    frac: str = digits(micro % 1000000, 6)
    "{whole}.{frac}"

# a / b to three places, half-up, entirely in i64. Reproduces awk's "%.3f" on
# every value this benchmark has produced; checked against the shell run.
ratio(a: i64, b: i64): str
    out = "n/a"
    if b > 0
        scaled: i64 = (a * 1000 + b // 2) // b
        whole: i64 = scaled // 1000
        frac: str = digits(scaled % 1000, 3)
        out = "{whole}.{frac}"
    out

sizeat(path: str): i64
    to(i64)(sh("stat -f%z '{path}' 2>/dev/null || stat -c%s '{path}'"))

linesat(path: str): i64
    to(i64)(sh("wc -l < '{path}' | tr -d ' '"))

field(line: str, want: i64): str
    n: i64 = line:len()
    i: i64 = 1
    seen: i64 = 0
    out = ""
    while i <= n
        b: i64 = line:byte(i)
        if b != 32 and b != 9
            seen += 1
            start: i64 = i
            while i <= n and line:byte(i) != 32 and line:byte(i) != 9
                i += 1
            if seen == want and out == ""
                out = line:sub(start, i - 1)
        else
            i += 1
    out

lines(text: str): any
    out = {}
    n: i64 = text:len()
    start: i64 = 1
    i: i64 = 1
    while i <= n
        if text:byte(i) == 10
            if i > start
                out[out:len() + 1] = text:sub(start, i - 1)
            start = i + 1
        i += 1
    if start <= n
        out[out:len() + 1] = text:sub(start, n)
    out

absf(x: f64): f64
    o: f64 = x
    if o < 0.0
        o = 0.0 - o
    o

homedir = script.getenv("DUO_ROOT", ".")
root = sh("cd '{homedir}' && pwd")
duobin = "{root}/zig-out/bin/idol"
zigbin = script.getenv("ZIG", "zig")
cc = script.getenv("CC", "clang")
stripbin = script.getenv("STRIP", "strip")
runs = to(i64)(script.getenv("RUNS", "5"))
chainmid = to(i64)(script.getenv("CHAIN_FUNCS", "180"))
chainsmall = to(i64)(script.getenv("CHAIN_FUNCS_1K", chainmid:to(str)))
chainbig = to(i64)(script.getenv("CHAIN_FUNCS_10K", "1500"))
uname = sh("uname -s")

trimflag(): str
    o = "-Wl,--gc-sections"
    if uname == "Darwin"
        o = "-Wl,-dead_strip"
    o

stripflag(): str
    o = "--strip-all"
    if uname == "Darwin"
        o = "-x"
    o

trim = trimflag()
stripmode = stripflag()
cflags = "-O3 -ffast-math -march=native -flto -fomit-frame-pointer {trim}"
work = sh("mktemp -d 2>/dev/null")

# The min of `runs` wall times, less the shell-spawn floor. A failed compile is
# fatal: a benchmark that quietly times a command which did not run is the
# frozen-literal failure mode in another costume.
mintime(label: str, cmd: str, floor: i64): i64
    log = "{work}/compile.log"
    quiet = "{cmd} > '{log}' 2>&1"
    best: i64 = 0
    i: i64 = 0
    while i < runs
        a: i64 = time.monotonic()
        rc: i64 = script.run(quiet)
        b: i64 = time.monotonic()
        if rc != 0
            print("compile-size-bench: FAIL — {label} exited {rc}")
            print("  command: {cmd}")
            print(sh("sed -n '1,40p' '{log}'"))
            os.exit(1)
        d: i64 = b - a
        if best == 0 or d < best
            best = d
        i += 1
    out: i64 = best - floor
    if out < 0
        out = 0
    out

spawnfloor(): i64
    best: i64 = 0
    i: i64 = 0
    while i < 8
        a: i64 = time.monotonic()
        rc: i64 = script.run("true")
        b: i64 = time.monotonic()
        d: i64 = b - a
        if rc == 0 and (best == 0 or d < best)
            best = d
        i += 1
    best

strippedinput: str, out: str:len(): i64
    script.must("cp '{input}' '{out}'")
    script.run("'{stripbin}' {stripmode} '{out}' 2>/dev/null")
    sizeat(out)

duotyped(path: str): void
    f = io.open(path, "w")
    f:write("fun fib_iter(n: i64): i64\n")
    f:write("    a: i64 = 0\n")
    f:write("    b: i64 = 1\n")
    f:write("    i: i64 = 0\n")
    f:write("    while i < n\n")
    f:write("        t: i64 = a + b\n")
    f:write("        a = b\n")
    f:write("        b = t\n")
    f:write("        i += 1\n")
    f:write("    end\n")
    f:write("    a\n")
    f:write("end\n")
    f:write("\n")
    f:write("fun checksum(n: i64): i64\n")
    f:write("    acc: i64 = 0\n")
    f:write("    i: i64 = 1\n")
    f:write("    while i <= n\n")
    f:write("        acc += (fib_iter(i % 40) * i) % 1000003\n")
    f:write("        i += 1\n")
    f:write("    end\n")
    f:write("    acc\n")
    f:write("end\n")
    f:write("\n")
    f:write("print(checksum(200000))\n")
    f:close()

ctyped(path: str): void
    f = io.open(path, "w")
    f:write("include:len() <stdint.h>\n")
    f:write("include:len() <stdio.h>\n")
    f:write("\n")
    f:write("static inline int64_t fib_iter(int64_t n) {\n")
    f:write("    int64_t a = 0;\n")
    f:write("    int64_t b = 1;\n")
    f:write("    for (int64_t i = 0; i < n; ++i) {\n")
    f:write("        int64_t t = a + b;\n")
    f:write("        a = b;\n")
    f:write("        b = t;\n")
    f:write("    }\n")
    f:write("    return a;\n")
    f:write("}\n")
    f:write("\n")
    f:write("static inline int64_t checksum(int64_t n) {\n")
    f:write("    int64_t acc = 0;\n")
    f:write("    for (int64_t i = 1; i <= n; ++i) {\n")
    f:write("        acc += (fib_iter(i % 40) * i) % 1000003;\n")
    f:write("    }\n")
    f:write("    return acc;\n")
    f:write("}\n")
    f:write("\n")
    f:write("int main(void) {\n")
    f:write("    printf(\"%lld\\n\", (long long)checksum(200000));\n")
    f:write("    return 0;\n")
    f:write("}\n")
    f:close()

duochain(path: str, funcs: i64): void
    f = io.open(path, "w")
    f:write("-- Generated typed function-chain workload.\n")
    f:write("\n")
    i: i64 = 0
    while i < funcs
        add: i64 = i * 17 + 31
        salt: i64 = i + 3
        f:write("fun step_{i}(x: i64): i64\n")
        f:write("    y: i64 = x + {add}\n")
        f:write("    y = (y * 1103515245 + 12345 + {salt}) % 2147483647\n")
        f:write("    y\n")
        f:write("end\n")
        f:write("\n")
        i += 1
    f:write("fun checksum(n: i64): i64\n")
    f:write("    acc: i64 = 0\n")
    f:write("    i: i64 = 1\n")
    f:write("    while i <= n\n")
    f:write("        x: i64 = i + acc % 97\n")
    i = 0
    while i < funcs
        f:write("        x = step_{i}(x)\n")
        i += 1
    f:write("        acc = (acc + x) % 1000000007\n")
    f:write("        i += 1\n")
    f:write("    end\n")
    f:write("    acc\n")
    f:write("end\n")
    f:write("\n")
    f:write("print(checksum(2000))\n")
    f:close()

cchain(path: str, funcs: i64): void
    f = io.open(path, "w")
    f:write("include:len() <stdint.h>\n")
    f:write("include:len() <stdio.h>\n")
    f:write("\n")
    i: i64 = 0
    while i < funcs
        add: i64 = i * 17 + 31
        salt: i64 = i + 3
        f:write("static inline int64_t step_{i}(int64_t x) {\n")
        f:write("    int64_t y = x + {add};\n")
        f:write("    y = (y * 1103515245 + 12345 + {salt}) % 2147483647;\n")
        f:write("    return y;\n")
        f:write("}\n")
        f:write("\n")
        i += 1
    f:write("static inline int64_t checksum(int64_t n) {\n")
    f:write("    int64_t acc = 0;\n")
    f:write("    for (int64_t i = 1; i <= n; ++i) {\n")
    f:write("        int64_t x = i + acc % 97;\n")
    i = 0
    while i < funcs
        f:write("        x = step_{i}(x);\n")
        i += 1
    f:write("        acc = (acc + x) % 1000000007;\n")
    f:write("    }\n")
    f:write("    return acc;\n")
    f:write("}\n")
    f:write("\n")
    f:write("int main(void) {\n")
    f:write("    printf(\"%lld\\n\", (long long)checksum(2000));\n")
    f:write("    return 0;\n")
    f:write("}\n")
    f:close()

head(): void
    a: str = pad("Workload", 22)
    b: str = pad("Metric", 16)
    c: str = lpad("Idol", 12)
    d: str = lpad("C", 12)
    e: str = lpad("Ratio", 10)
    print("{a} {b} {c} {d} {e}")
    a = pad("----------------------", 22)
    b = pad("----------------", 16)
    c = lpad("------------", 12)
    d = lpad("------------", 12)
    e = lpad("----------", 10)
    print("{a} {b} {c} {d} {e}")

row(name: str, metric: str, dv: str, cv: str, rv: str): void
    a: str = pad(name, 22)
    b: str = pad(metric, 16)
    c: str = lpad(dv, 12)
    d: str = lpad(cv, 12)
    e: str = lpad(rv, 10)
    print("{a} {b} {c} {d} {e}x")

lone(name: str, metric: str, dv: str): void
    a: str = pad(name, 22)
    b: str = pad(metric, 16)
    c: str = lpad(dv, 12)
    d: str = lpad("-", 12)
    e: str = lpad("-", 10)
    print("{a} {b} {c} {d} {e}")

resultrow(name: str, value: str): void
    a: str = pad(name, 15)
    print("RESULT {a} {value}")

pairrows(name: str, idolsrc: str, csrc: str, idolout: str, cout: str,
    idolns: i64, cns: i64): void
    idollines: i64 = linesat(idolsrc)
    clines: i64 = linesat(csrc)
    idolbytes: i64 = sizeat(idolsrc)
    cbytes: i64 = sizeat(csrc)
    idolsize: i64 = sizeat(idolout)
    csize: i64 = sizeat(cout)
    row(name, "source_lines", idollines:to(str), clines:to(str),
        ratio(idollines, clines))
    row(name, "source_bytes", idolbytes:to(str), cbytes:to(str),
        ratio(idolbytes, cbytes))
    row(name, "compile_s", secs(idolns), secs(cns), ratio(idolns, cns))
    row(name, "binary_bytes", idolsize:to(str), csize:to(str),
        ratio(idolsize, csize))

workload(name: str, idolsrc: str, csrc: str, idolout: str, cout: str,
    floor: i64): void
    idolns: i64 = mintime("idol compile {name}",
        "'{duobin}' compile '{idolsrc}' -o '{idolout}'", floor)
    cns: i64 = mintime("cc {name}",
        "'{cc}' {cflags} '{csrc}' -o '{cout}'", floor)
    duoanswer: str = sh("'{idolout}'")
    canswer: str = sh("'{cout}'")
    if duoanswer != canswer
        print("RESULT mismatch for {name}: Idol={duoanswer} C={canswer}")
        os.exit(1)
    pairrows(name, idolsrc, csrc, idolout, cout, idolns, cns)
    resultrow(name, duoanswer)

# Sorted RESULT rows, with the count checked against what the program is
# supposed to emit. A capture that silently produced 0 rows would otherwise
# compare two empty lists and call them equal.
capturerows(label: str, want: i64, bin: str, out: str): void
    rc: i64 = script.run("'{bin}' > '{out}.raw' 2>'{out}.err'")
    script.run("grep '^RESULT ' '{out}.raw' | sort > '{out}'")
    got: i64 = to(i64)(sh("grep -c '^RESULT ' '{out}' | tr -d ' '"))
    if rc != 0 or got != want
        print("RESULT capture failed for {label}: got {got}/{want} row(s), status {rc}")
        print(sh("sed -n '1,40p' '{out}.err'"))
        print(sh("sed -n '1,40p' '{out}.raw'"))
        os.exit(1)

mlagree(duopath: str, cpath: str): void
    dl = lines(sh("cat '{duopath}'"))
    cl = lines(sh("cat '{cpath}'"))
    nd: i64 = dl:len()
    nc: i64 = cl:len()
    if nd != nc
        print("RESULT count mismatch: Idol={nd} C={nc}")
        os.exit(1)
    i: i64 = 1
    while i <= nd
        a = dl[i]
        b = cl[i]
        ida: str = field(a, 2)
        idb: str = field(b, 2)
        if ida == "" or ida != idb
            print("RESULT id mismatch: Idol={a} C={b}")
            os.exit(1)
        d: f64 = to(f64)(field(a, 3))
        r: f64 = to(f64)(field(b, 3))
        denom: f64 = absf(r)
        if denom < 1.0
            denom = 1.0
        if absf(d - r) / denom >= 0.0001
            print("RESULT mismatch for {ida}: Idol={d} C={r}")
            os.exit(1)
        i += 1

mlbinary(floor: i64): void
    name = "ml_binary"
    idolsrc = "{root}/examples/bench_ml.id"
    csrc = "{root}/examples/bench_ml_c.c"
    idolout = "{work}/ml_bench_idol"
    cout = "{work}/ml_bench_c"
    idolrows = "{work}/ml_idol.results"
    crows = "{work}/ml_c.results"
    idolns: i64 = mintime("idol compile {name}",
        "'{duobin}' compile '{idolsrc}' -o '{idolout}'", floor)
    cns: i64 = mintime("cc {name}",
        "'{cc}' {cflags} '{csrc}' -o '{cout}' -lm", floor)
    capturerows("ml_binary Idol", 5, idolout, idolrows)
    capturerows("ml_binary C", 5, cout, crows)
    mlagree(idolrows, crows)
    pairrows(name, idolsrc, csrc, idolout, cout, idolns, cns)
    idolstrip: i64 = strippedidolout, "{work}/ml_bench_idol_stripped":len()
    cstrip: i64 = strippedcout, "{work}/ml_bench_c_stripped":len()
    row(name, "stripped_bytes", idolstrip:to(str), cstrip:to(str),
        ratio(idolstrip, cstrip))
    resultrow(name, "5_rows_match")

idolapp(name: str, idolsrc: str, sentinel: str, floor: i64): void
    idolout = "{work}/{name}_idol"
    idolstripped = "{work}/{name}_idol_stripped"
    idolns: i64 = mintime("idol compile {name}",
        "'{duobin}' compile '{idolsrc}' -o '{idolout}'", floor)
    seen: i64 = to(i64)(sh("'{idolout}' 2>/dev/null | grep -c -F '{sentinel}' | tr -d ' '"))
    if seen < 1
        print("RESULT mismatch for {name}: missing sentinel '{sentinel}'")
        os.exit(1)
    idollines: i64 = linesat(idolsrc)
    idolbytes: i64 = sizeat(idolsrc)
    idolsize: i64 = sizeat(idolout)
    idolstrip: i64 = strippedidolout, idolstripped:len()
    lone(name, "source_lines", idollines:to(str))
    lone(name, "source_bytes", idolbytes:to(str))
    lone(name, "compile_s", secs(idolns))
    lone(name, "binary_bytes", idolsize:to(str))
    lone(name, "stripped_bytes", idolstrip:to(str))
    resultrow(name, "sentinel_match")

main(): i64
    if sh("test -x '{duobin}' && echo yes") != "yes"
        script.must("cd '{root}' && '{zigbin}' build")
    if sh("test -x '{duobin}' && echo yes") != "yes"
        print("compile-size-bench: FAIL — no idol binary at {duobin}")
        os.exit(1)
    if work == ""
        print("compile-size-bench: FAIL — mktemp -d produced nothing")
        os.exit(1)

    sdk = script.getenv("SDKROOT", "")
    if sdk == ""
        sdk = sh("xcrun --sdk macosx --show-sdk-path 2>/dev/null")
    if sdk != ""
        os.setenv("SDKROOT", sdk, true)

    floor: i64 = spawnfloor()
    floortext: str = secs(floor)

    print("=== Compile Time + Binary Size Benchmark ===")
    print("Runs: {runs} (minimum wall time)")
    print("Generated chain functions: 1k={chainsmall} 10k={chainbig}")
    print("Harness: idol at {duobin}; spawn floor {floortext} s subtracted")
    print("")
    head()

    duotypedsrc = "{work}/typed_checksum.id"
    ctypedsrc = "{work}/typed_checksum.c"
    duotyped(duotypedsrc)
    ctyped(ctypedsrc)
    workload("typed_checksum", duotypedsrc, ctypedsrc,
        "{work}/typed_checksum_idol", "{work}/typed_checksum_c", floor)

    duosmall = "{work}/function_chain_1k.id"
    csmall = "{work}/function_chain_1k.c"
    duochain(duosmall, chainsmall)
    cchain(csmall, chainsmall)
    workload("function_chain_1k", duosmall, csmall,
        "{work}/function_chain_1k_idol", "{work}/function_chain_1k_c", floor)

    duobig = "{work}/function_chain_10k.id"
    cbig = "{work}/function_chain_10k.c"
    duochain(duobig, chainbig)
    cchain(cbig, chainbig)
    workload("function_chain_10k", duobig, cbig,
        "{work}/function_chain_10k_idol", "{work}/function_chain_10k_c", floor)

    mlbinary(floor)
    idolapp("metaprogramming_app", "{root}/examples/benchmark.id",
        "RESULT matmul", floor)

    script.must("rm -rf '{work}'")

    print("")
    print("Note: this is a tracking benchmark. It reports typed-program runtime")
    print("prelude cost, generated 1k/10k-line project scaling, ML binary size,")
    print("and a fixed metaprogramming app binary-size sample;")
    print("it does not fail when Idol is slower or larger than C.")
    0
