# vscodeemit — project the vscode extension host from idol.

script = std.script
targetpath = "ext/vscode-duo/extension.js"

body: str = ()
    b = ""
    b = "{b}'use strict';\n"
    b = "{b}\n"
    b = "{b}const { LanguageClient, TransportKind } = require('vscode-languageclient');\n"
    b = "{b}const vscode = require('vscode');\n"
    b = "{b}\n"
    b = "{b}let client = null;\n"
    b = "{b}\n"
    b = "{b}/**\n"
    b = "{b} * @param "
    b = b .. "{"
    b = "{b}vscode.ExtensionContext"
    b = b .. "}"
    b = "{b} context\n"
    b = "{b} */\n"
    b = "{b}async function activate(context) {\n"
    b = "{b}  const config = vscode.workspace.getConfiguration('duo-lsp');\n"
    b = "{b}  if (!config.get('enable')) {\n"
    b = "{b}    return;\n"
    b = "{b}  }\n"
    b = "{b}\n"
    b = "{b}  const path = config.get('path') || 'duo-lsp';\n"
    b = "{b}  const trace = config.get('trace') || 'off';\n"
    b = "{b}\n"
    b = "{b}  // Search PATH + common install locations\n"
    b = "{b}  const resolved = await resolveBinary(path);\n"
    b = "{b}  if (!resolved) {\n"
    b = "{b}    vscode.window.showWarningMessage(\n"
    b = "{b}      `Duo LSP binary not found at \"$"
    b = b .. "{"
    b = "{b}path"
    b = b .. "}"
    b = "{b}\". ` +\n"
    b = "{b}      'Install duo-lsp or set duo-lsp.path in settings.'\n"
    b = "{b}    );\n"
    b = "{b}    return;\n"
    b = "{b}  }\n"
    b = "{b}\n"
    b = "{b}  const traceLevels = { off: undefined, messages: 'messages', verbose: 'verbose' };\n"
    b = "{b}\n"
    b = "{b}  const serverOptions = {\n"
    b = "{b}    run: { command: resolved, transport: TransportKind.stdio },\n"
    b = "{b}    debug: { command: resolved, transport: TransportKind.stdio, args: ['--debug'] },\n"
    b = "{b}  };\n"
    b = "{b}\n"
    b = "{b}  const clientOptions = {\n"
    b = "{b}    documentSelector: [{ scheme: 'file', language: 'duo' }],\n"
    b = "{b}    traceOutputChannel: traceLevels[trace]\n"
    b = "{b}      ? vscode.window.createOutputChannel('Duo LSP Trace')\n"
    b = "{b}      : undefined,\n"
    b = "{b}  };\n"
    b = "{b}\n"
    b = "{b}  client = new LanguageClient('duo-lsp', 'Duo Language Server', serverOptions, clientOptions);\n"
    b = "{b}  await client.start();\n"
    b = "{b}}\n"
    b = "{b}\n"
    b = "{b}/**\n"
    b = "{b} * @param "
    b = b .. "{"
    b = "{b}string"
    b = b .. "}"
    b = "{b} bin\n"
    b = "{b} * @returns {Promise<string|null>}\n"
    b = "{b} */\n"
    b = "{b}async function resolveBinary(bin) {\n"
    b = "{b}  // If it's an absolute or relative path, check directly\n"
    b = "{b}  if (bin.includes('/') || bin.includes('\\\\')) {\n"
    b = "{b}    try {\n"
    b = "{b}      await vscode.workspace.fs.stat(vscode.Uri.file(bin));\n"
    b = "{b}      return bin;\n"
    b = "{b}    } catch {\n"
    b = "{b}      return null;\n"
    b = "{b}    }\n"
    b = "{b}  }\n"
    b = "{b}  // Otherwise check PATH via which/where\n"
    b = "{b}  const "
    b = b .. "{"
    b = "{b} execFile "
    b = b .. "}"
    b = "{b} = require('child_process');\n"
    b = "{b}  const cmd = process.platform === 'win32' ? 'where' : 'which';\n"
    b = "{b}  return new Promise((resolve) => {\n"
    b = "{b}    execFile(cmd, [bin], (err, stdout) => {\n"
    b = "{b}      if (err) return resolve(null);\n"
    b = "{b}      const first = stdout.trim().split(/[\\r\\n]/)[0];\n"
    b = "{b}      resolve(first || null);\n"
    b = "{b}    });\n"
    b = "{b}  });\n"
    b = "{b}}\n"
    b = "{b}\n"
    b = "{b}async function deactivate() {\n"
    b = "{b}  if (client) {\n"
    b = "{b}    await client.stop();\n"
    b = "{b}    client = null;\n"
    b = "{b}  }\n"
    b = "{b}}\n"
    b = "{b}\n"
    b = "{b}module.exports = { activate, deactivate };\n"
    b

spill: bool = (path: str, text: str)
    f = io.open(path, "w")
    if !f
        return false
    f:write(text)
    f:close()
    true

main: i64 = ()
    out = script.getenv("VSCODEOUT", targetpath)
    if !spill(out, body())
        print("vscodeemit: fail write {out}")
        std.os.exit(3)
    print("vscodeemit: wrote {out}")
    0
