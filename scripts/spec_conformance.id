
baseline: i64 = ()
  15

lb: str = ()
  "{"

fails = 0
implemented = 0
checked = 0
report = ""

probe: bool = (id: str, src: str, want: str)
  path = "/tmp/idol_specconf.id"
  std.script.fs_write(path, src)
  got = std.script.capture(std.script.id_bin() .. " run " .. path .. " 2>/dev/null")
  trimmed = std.script.chomp(got)
  if trimmed == want
    return true
  return false

record = (id: str, src: str, want: str)
  checked = checked + 1
  if probe(id, src, want)
    implemented = implemented + 1
    report = report .. "  ok      " .. id .. "\n"
  else
    report = report .. "  MISSING " .. id .. "\n"

main: i64 = ()
  record("FF-1 value fn multiline", "f = (x: i64): i64\n    x * 2\nend\nmain = (): void\n    print(f(21))\nend\n", "42")
  record("FF-1 value fn one-line", "f = (x: i64) x * 2\nmain = (): void\n    print(f(21))\nend\n", "42")
  record("FF-1 value fn no params", "run = (): i32\n    42\nend\nmain = (): void\n    print(run())\nend\n", "42")
  record("FF-1 one-line+end absent", "f = (x: i64): i64 x * 2 end\nmain(): void\n    print(f(21))\nend\n", "ABSENT")
  record("FF-5 binding cond", "g(): i64\n    7\nend\nmain(): void\n    if v = g()\n        print(v)\n    end\nend\n", "7")
  record("FF-6 demand return", "f(): i64\n    41 + 1\nend\nmain(): void\n    print(f())\nend\n", "42")
  record("FF-11 range", "main(): void\n    t = 0\n    for i in range(0, 3)\n        t = t + i\n    end\n    print(t)\nend\n", "3")

  record("FF-13 t{...} shape", "point: { x: i64, y: i64 }\nmain(): void\n    p = point{ x = 1, y = 2 }\n    print(p.x)\nend\n", "1")
  record("FF-17 T | nil", "f(x: i64): i64 | nil\n    x\nend\nmain(): void\n    print(f(5))\nend\n", "5")

  record("STR-1 name hole", "main(): void\n    x = 3\n    print(\"" .. lb() .. "x}\")\nend\n", "3")
  record("STR-1 field hole", "main(): void\n    p = { x = 4 }\n    print(\"" .. lb() .. "p.x}\")\nend\n", "4")
  record("STR-1 expr hole", "main(): void\n    i = 1\n    print(\"" .. lb() .. "i + 1}\")\nend\n", "2")

  record("FF-14 subject-first convert", "main(): void\n    print(42:to(str))\nend\n", "42")
  record("FF-12 subject-first", "main(): void\n    print((42):to(str))\nend\n", "42")
  record("primitive as value", "main(): void\n    t = str\n    print(t)\nend\n", "str")

  record("LV-4 t:push", "main(): void\n    a = {}\n    a:push(5)\n    print(a:len())\nend\n", "1")
  record("LV-5 t:pop", "main(): void\n    a = {1, 2}\n    print(a:pop())\nend\n", "2")
  record("LV-6 t:join", "main(): void\n    c = {\"x\", \"y\"}\n    print(c:join(\", \"))\nend\n", "x, y")
  record("LV-8 for v in t", "main(): void\n    t = {10, 20}\n    s = 0\n    for v in t\n        s = s + v\n    end\n    print(s)\nend\n", "30")
  record("LV-13 s:len()", "main(): void\n    print(#\"hello\")\nend\n", "5")

  record("S14 apply subject-first to(T)", "main(): void\n    print(42:to(str))\nend\n", "42")
  record("S14 retrieve to[T]", "main(): void\n    print(to[str] != nil)\nend\n", "true")
  record("S14 retrieve to[T][X]", "main(): void\n    print(to[str][i64] != nil)\nend\n", "true")

  record("P48 anchor X@to(T)", "main(): void\n    print(i64@to(str) != nil)\nend\n", "true")

  record("GRAVEYARD .@name absent", "e(a: any, b: any): bool\n    true\nend\nmain(): void\n    p = {}\n    setmetatable(p, { __eq = e })\n    print(p.@eq == nil)\nend\n", "ABSENT")

  record("face brace call f{}", "srv(o: any): i64\n    o.port\nend\nmain(): void\n    print(srv{ port = 8080 })\nend\n", "8080")

  record("PIPE map", "main(): void\n    vs = {1, 2}\n    print(vs:map(.x):len())\nend\n", "2")
  record("PIPE filter", "main(): void\n    vs = {1, 2}\n    print(vs:filter(.x):len())\nend\n", "2")

  stdout:write(report)
  print("spec_conformance: " .. implemented:to(str) .. "/" .. checked:to(str) .. " implemented (floor " .. to(str)(baseline()) .. ")")

  if implemented < baseline()
    print("spec_conformance: FAIL — a form that used to work has regressed")
    return 1
  if implemented > baseline()
    print("spec_conformance: forms gained since the floor was set — RAISE baseline() to " .. implemented:to(str) .. " and narrow the interim advice in CLAUDE.md")
  print("spec_conformance: PASS")
  0
