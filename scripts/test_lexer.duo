print("0")
req "std"
print("1")

source = std.compiler.source
print("2")
token = std.compiler.token
print("3")
lexer = std.compiler.lexer
print("4")

run_test()
    print("Starting test")
    src = "fun add(a: i64, b: i64): i64 return a + b end"
    print("calling lexer.new")
    l = lexer.new(src, "test.duo")
    print("lexer created")
    
    t1 = lexer.next(l)
    print("t1", t1.kind, t1.text)
    if t1.kind != token.KIND_FUN error("expected fun") end
    
    t2 = lexer.next(l)
    print("t2", t2.kind, t2.text)
    if t2.kind != token.KIND_NAME error("expected name") end
    if t2.text != "add" error("expected add") end
    
    t3 = lexer.next(l)
    print("t3", t3.kind, t3.text)
    if t3.kind != token.KIND_LPAREN error("expected (") end
    
    t4 = lexer.next(l)
    print("t4", t4.kind, t4.text)
    if t4.kind != token.KIND_NAME error("expected name") end
    if t4.text != "a" error("expected a") end
    
    t5 = lexer.next(l)
    print("t5", t5.kind, t5.text)
    if t5.kind != token.KIND_COLON error("expected :") end
    
    t6 = lexer.next(l)
    print("t6", t6.kind, t6.text)
    if t6.kind != token.KIND_I64 error("expected i64") end
    
    print("Lexer smoke test passed!")
end

run_test()
