#!/usr/bin/env duo

content = fs.read_file("benchmark_evidence.json")
if content == nil
    print("No benchmark evidence found. Run scripts/run_benchmark.id first.")
    os.exit(1)

evidence = json.decode(content)

print("=== Optimization Opportunity Projection ===")
print("Compiler Artifact: " .. evidence.compiler_artifact .. " (" .. evidence.compiler_hash .. ")")
print("Realization Mode: " .. evidence.realization_mode)
print("Comparator Hash: " .. evidence.comparator_hash)
print("Workload Hash: " .. evidence.workload_hash)
print("Revision: " .. evidence.revision)
print("")

print("BLOCKED: Poolside/graph lineage has not supplied the required semantic attribution interface.")
print("Cannot map measurements to semantic application/value -> selected realization -> machine range.")
print("A name/symbol-based parallel semantic map is strictly forbidden.")
print("Requesting narrow interface from Poolside: Export exact lineage mapping before fine-grained prioritization can proceed.")
os.exit(1)
