
work = std.script.getenv("CAPROWS_WORK", "/tmp/duo-capability-rows")

rows = {
  {
    "implicit tail return",
    "-",
    {
      "examples/native_differential/canon2_tail_record_return.id",
      "examples/native_differential/canon6_call_in_record_literal.id",
      "examples/native_differential/canon7_call_local_then_record.id",
      "examples/layout/offside.id"
    },
    {}
  },
  {
    "record return",
    "\"kind\":\"table_shape\"",
    {
      "examples/native_differential/canon1_lambda_record_return.id",
      "examples/native_differential/canon2_tail_record_return.id",
      "examples/native_differential/rec4_return.id",
      "examples/native_differential/rec8_token_return.id"
    },
    {}
  },
  {
    "recursive calls",
    "-",
    {
      "examples/native_differential/p10_recurse.id",
      "examples/native_differential/s2_mutual.id"
    },
    {}
  },
  {
    "offside blocks",
    "-",
    { "examples/layout/offside.id" },
    {
      "examples/compile_fail/offside_misindent.id",
      "examples/compile_fail/offside_end_column.id"
    }
  },
  {
    "p100 failure routing",
    "-",
    {
      "examples/pack/merge.id",
      "examples/pack/consume.id"
    },
    {}
  },
  { "anchor semantics", "-", {}, {} },
  {
    "tokenizer",
    "\"kind\":\"table_shape\"",
    {
      "examples/native_differential/tokenizer.id",
      "examples/native_differential/tokenizer_selfscan.id",
      "examples/native_differential/native_only/lexer_native.id"
    },
    {}
  },
  {
    "parser kernel",
    "\"kind\":\"table_shape\"",
    {
      "examples/native_differential/native_only/parser_native.id",
      "examples/native_differential/native_only/parser_blocks.id",
      "examples/native_differential/native_only/parser_token_stream.id"
    },
    {}
  },
  {
    "inline case-set",
    "\"kind\":\"enum_shape\"",
    { "examples/case/set.id" },
    {}
  },
  { "relation edge (level)", "-", { "examples/conversion/edge.id" }, {} },
  { "relation slot", "-", { "examples/conversion/slot.id" }, {} },
  { "level application", "-", { "examples/conversion/level.id" }, {} },
  { "binding-condition loop", "-", { "examples/pack/consume.id" }, {} },
  { "correlated guard chain", "-", { "examples/layout/guard.id" }, {} },
  { "glued compound assign", "-", { "examples/layout/glued.id" }, {} },
  {
    "x8 field layout",
    "\"kind\":\"table_shape\"",
    { "examples/pack/x8.id" },
    {}
  },
  {
    "string interpolation",
    "-",
    {
      "examples/layout/offside.id",
      "examples/conversion/edge.id"
    },
    {}
  },
  {
    "native table storage",
    "-",
    {
      "examples/native_differential/native_only/table_const_index.id",
      "examples/native_differential/native_only/table_dynamic_index.id",
      "examples/native_differential/native_only/table_mutable_store.id"
    },
    {}
  }
}

nofixture = ""
denyrows = ""
denyfail = 0
denytotal = 0

weave: str = (lines: any)
  out = ""
  for i, line in lines
    out = out .. line
    out = out .. "\n"
  out

remember = (files: any, seen: any, path: str)
  if seen(path) == nil
    seen(path) = 1
    files(files:len() + 1) = path

slot: str = (path: str)
  out = ""
  i: i64 = 1
  n: i64 = path:len()
  while i <= n
    b = path:byte(i)
    if b == 47 or b == 46
      out = out .. "_"
    else
      out = out .. path:sub(i, i)
    i = i + 1
  out

probetext: str = (duo: str, tprefix: str)
  lines = {
    "exitmatch() \{",
    " [ \"$1\" = \"$2\" ] && [ ! -s \"$3\" ] && [ ! -s \"$4\" ]",
    "\\}",
    "if [ \"$1\" = --oracle-control ]; then",
    " : > \"$2\"; : > \"$3\"",
    " exitmatch 7 7 \"$2\" \"$3\" || exit 91",
    " printf noise > \"$2\"",
    " if exitmatch 7 7 \"$2\" \"$3\"; then exit 92; fi",
    " : > \"$2\"; printf noise > \"$3\"",
    " if exitmatch 7 7 \"$2\" \"$3\"; then exit 93; fi",
    " exit 0",
    "fi",
    "f=\"$1\"",
    "s=\"$2\"",
    "d={duo}",
    "t={work}/w/$s",
    "des=0",
    "head -1 \"$f\" | grep -q '^--' && des=1",
    "cp \"$f\" $t.fmt.id",
    "par=0",
    "if $d fmt $t.fmt.id >/dev/null 2>&1; then par=1; fi",
    "chk=0",
    "if $d check \"$f\" >/dev/null 2>&1; then chk=1; fi",
    "gra=0",
    "if $d graph \"$f\" > {work}/g/$s.json 2>/dev/null; then",
    "  if [ -s {work}/g/$s.json ]; then gra=1; fi",
    "fi",
    "wantout=$(sed -n 's/^# expect: *//p' \"$f\" | head -1)",
    "wantexit=$(sed -n 's/^# expect-exit: *//p' \"$f\" | head -1)",
    "want=",
    "decl=0",
    "mode=none",
    "if [ -n \"$wantout\" ] && [ -z \"$wantexit\" ]; then decl=1; mode=out; want=$wantout; fi",
    "if [ -n \"$wantexit\" ] && [ -z \"$wantout\" ]; then decl=1; mode=exit; want=$wantexit; fi",
    "cst=0",
    "crc=-1",
    "if $d compile \"$f\" --emit exe -o $t.cb >/dev/null 2>&1; then",
    " if [ -x $t.cb ]; then",
    "  {tprefix}$t.cb > $t.co 2>$t.ce; crc=$?",
    "  if [ $crc -ne 124 ]; then cst=1",
    "   if [ $decl -eq 1 ]; then",
    "    if [ \"$mode\" = exit ]; then got=\"$crc\"; fi",
    "    if [ \"$mode\" = out ]; then got=$(tr '\\n' ' ' < $t.co | sed 's/ *$//'); fi",
    "    if [ \"$mode\" = exit ] && exitmatch \"$got\" \"$want\" $t.co $t.ce; then cst=2; fi",
    "    if [ \"$mode\" = out ] && [ $crc -eq 0 ] && [ ! -s $t.ce ] && [ \"$got\" = \"$want\" ]; then cst=2; fi",
    "   fi",
    "  fi",
    " fi",
    "fi",
    "nat=0",
    "nrc=-1",
    "if $d compile \"$f\" --backend=direct --emit exe -o $t.db >/dev/null 2>&1; then",
    " if [ -x $t.db ]; then",
    "  {tprefix}$t.db > $t.do 2>$t.de; nrc=$?",
    "  if [ $nrc -ne 124 ]; then nat=1; fi",
    " fi",
    "fi",
    "wit=0",
    "if [ $nat -eq 1 ]; then",
    " if [ \"$mode\" = exit ]; then",
    "  if [ $decl -eq 1 ] && exitmatch \"$nrc\" \"$want\" $t.do $t.de; then wit=1; fi",
    " else",
    "  if [ \"$mode\" = out ] && [ $cst -eq 2 ] && [ $nrc -eq 0 ] && [ ! -s $t.de ] && cmp -s $t.co $t.do; then wit=1; fi",
    "  if [ \"$mode\" = none ] && [ $cst -ge 1 ] && [ $crc -eq $nrc ] && cmp -s $t.co $t.do; then wit=1; fi",
    " fi",
    "fi",
    "printf \"%s%s%s%s%s%s%s\\t%s\\n\" $des $par $chk $gra $cst $nat $wit \"$f\"",
    "rm -f $t.cb $t.db $t.co $t.ce $t.do $t.de $t.fmt.id"
  }
  weave(lines)

hosttext: str = ()
  lines = {
    "global P = std.compiler.parser",
    "",
    "main(): i64",
    "    listing = std.script.fs_read(std.script.getenv(\"CAPROWS_LIST\", \"\"))",
    "    n: i64 = listing:len()",
    "    start: i64 = 1",
    "    i: i64 = 1",
    "    while i <= n + 1",
    "        cut = i > n",
    "        if !cut",
    "            cut = listing:byte(i) == 10",
    "        end",
    "        if cut",
    "            if i > start",
    "                path = listing:sub(start, i - 1)",
    "                f = io.open(path, \"r\")",
    "                if f",
    "                    src = f:read(\"a\")",
    "                    f:close()",
    "                    st = P.parse_status(src)",
    "                    print(to(str)(st) .. \"\\t\" .. path)",
    "                end",
    "            end",
    "            start = i + 1",
    "        end",
    "        i += 1",
    "    end",
    "    0",
    "end"
  }
  weave(lines)

digit: i64 = (rec: str, at: i64)
  to(i64)(rec:sub(at, at))

tab: i64 = (rec: str)
  i: i64 = 1
  n: i64 = rec:len()
  while i <= n and rec:byte(i) != 9
    i = i + 1
  i

cellof: str = (reach: i64, total: i64, gap: bool)
  if gap
    return "   ?   "
  if total == 0
    return "   —   "
  if reach == total
    return "   ✓   "
  if reach == 0
    return "   —   "
  "partial"

pad: str = (s: str, w: i64)
  out = s
  i: i64 = s:len()
  while i < w
    out = out .. " "
    i = i + 1
  out

main: i64 = ()
  files = {}
  seen = {}
  probe = {}
  host = {}
  duo = std.script.getenv("DUO", "./zig-out/bin/idol")
  jobs = std.script.getenv("CAPROWS_JOBS", "8")
  limit = std.script.getenv("CAPROWS_TIMEOUT", "20")

  if not std.script.fs_exists(duo)
    print("capability_rows: FAIL — no compiler at {duo}; run `zig build`")
    return 3
  stale = script.chomp(script.capture("find src -name \"*.zig\" -newer {duo} 2>/dev/null | head -3"))
  if stale != ""
    print("capability_rows: FAIL — {duo} is older than src/; run `zig build`")
    print("  newer than the binary: {stale}")
    return 3

  tprefix = ""
  for i, cand in { "timeout", "gtimeout" }
    if tprefix == "" and script.chomp(script.capture("command -v {cand} 2>/dev/null")) != ""
      tprefix = "{cand} {limit} "

  script.run("rm -rf {work} && mkdir -p {work}/w {work}/g {work}/c")

  for ri, r in rows
    for fi, f in r(3)
      if not script.fs_exists(f)
        print("capability_rows: FAIL — row '{r[1]}' names a missing fixture {f}")
        return 3
      remember(files, seen, f)
    for fi, f in r(4)
      if not script.fs_exists(f)
        print("capability_rows: FAIL — row '{r[1]}' names a missing deny fixture {f}")
        return 3
      remember(files, seen, f)
  if files:len() == 0
    print("capability_rows: FAIL — no fixtures at all; the report is not wired")
    return 3

  good = "examples/layout/offside.id"
  if not script.fs_exists(good)
    print("capability_rows: FAIL — the control source {good} is gone")
    return 3
  ctlsyntax = "{work}/c/ctlsyntax.id"
  ctltype = "{work}/c/ctltype.id"
  ctlvalue = "{work}/c/ctlvalue.id"
  script.run("cp {good} {ctlsyntax} && printf 'if if if\\n' >> {ctlsyntax}")
  script.run("cp {good} {ctltype} && printf 'bad: i64 = \"notanumber\"\\n' >> {ctltype}")
  script.run("sed 's/^# expect: .*/# expect: 99 99 99/' {good} > {ctlvalue}")
  remember(files, seen, ctlsyntax)
  remember(files, seen, ctltype)
  remember(files, seen, ctlvalue)

  listpath = "{work}/files.list"
  listing = ""
  for i, f in files
    listing = listing .. f .. "\n"
  script.fs_write(listpath, listing)

  script.fs_write("{work}/probe.sh", probetext(duo, tprefix))
  oracleout = "{work}/c/exit-control.stdout"
  oracleerr = "{work}/c/exit-control.stderr"
  if script.status("sh {work}/probe.sh --oracle-control {oracleout} {oracleerr}") != 0
    print("capability_rows: FAIL — exit-oracle controls accepted matching status with stdout/stderr")
    return 3
  joined = ""
  for i, f in files
    joined = joined .. f .. "\n" .. slot(f) .. "\n"
  script.fs_write("{work}/pairs.list", joined)
  script.run("xargs -P {jobs} -n 2 sh {work}/probe.sh < {work}/pairs.list > {work}/records.tsv 2>/dev/null")

  nrec = 0
  for i, line in script.fs_read("{work}/records.tsv"):split("\n")
    rec = script.chomp(line)
    if rec:len() > 8
      t = tab(rec)
      probe(rec:sub(t + 1, rec:len())) = rec:sub(1, t - 1)
      nrec = nrec + 1
  if nrec != files:len()
    got = nrec:to(str)
    want = to(str)(files:len())
    print("capability_rows: FAIL — {got} records for {want} fixtures; the sweep lost files")
    return 3

  hostsrc = "{work}/hostprobe.id"
  hostbin = "{work}/hostprobe.bin"
  script.fs_write(hostsrc, hosttext())
  if script.status("{duo} compile {hostsrc} --emit exe -o {hostbin} >/dev/null 2>&1") != 0
    print("capability_rows: FAIL — the self-hosted front end probe did not build;")
    print("  H cannot be measured, and an unmeasured column must not print as `—`")
    return 3
  script.env_set("CAPROWS_LIST", listpath)
  script.run("CAPROWS_LIST={listpath} {hostbin} > {work}/host.tsv 2>/dev/null")
  nhost = 0
  for i, line in script.fs_read("{work}/host.tsv"):split("\n")
    rec = script.chomp(line)
    if rec:len() > 2
      t = tab(rec)
      host(rec:sub(t + 1, rec:len())) = rec:sub(1, t - 1)
      nhost = nhost + 1
  if nhost != files:len()
    got = nhost:to(str)
    want = to(str)(files:len())
    print("capability_rows: FAIL — hosted probe answered {got} of {want}; H is not measured")
    return 3

  cs = probe(ctlsyntax)
  ct = probe(ctltype)
  cv = probe(ctlvalue)
  gb = probe(good)
  if digit(cs, 2) != 0
    print("capability_rows: FAIL — the syntax control still PARSES; the P probe is broken")
    return 3
  if digit(ct, 2) != 1 or digit(ct, 3) != 0
    print("capability_rows: FAIL — the type control did not fail sema alone; the S probe is broken")
    print("  wanted parse 1 check 0, got record {ct}")
    return 3
  if digit(gb, 5) != 2
    print("capability_rows: FAIL — {good} does not match its own `# expect:`;")
    print("  the value control cannot mean anything until it does. record {gb}")
    return 3
  if digit(cv, 5) != 1
    print("capability_rows: FAIL — the value control still MATCHES a falsified")
    print("  `# expect:`; the C column is not checking values. record {cv}")
    return 3
  hostyes = 0
  hostno = 0
  for i, f in files
    if host(f) == "0"
      hostyes = hostyes + 1
    else
      hostno = hostno + 1
  if hostyes == 0 or hostno == 0
    hy = hostyes:to(str)
    hn = hostno:to(str)
    print("capability_rows: FAIL — the hosted probe answered the same for every")
    print("  fixture ({hy} accepted, {hn} rejected); H is not discriminating")
    return 3

  print("")
  print("  capability matrix, PER CAPABILITY, generated from fixtures")
  print("")
  head = "  " .. pad("capability", 24)
  rule = "  " .. pad("----------", 24)
  for i, cn in { "D", "P", "S", "G", "C", "N", "W", "H" }
    head = head .. " " .. pad("   " .. cn, 7)
    rule = rule .. " " .. "-------"
  print(head)
  print(rule)

  for ri, r in rows
    nm = r(1)
    gk = r(2)
    fs = r(3)
    nf = fs:len()
    gapg = gk == "-" and nf > 0
    d = 0
    p = 0
    s = 0
    g = 0
    c = 0
    n = 0
    w = 0
    h = 0
    for fi, f in fs
      rec = probe(f)
      if digit(rec, 1) == 1
        d = d + 1
      if digit(rec, 2) == 1
        p = p + 1
      if digit(rec, 3) == 1
        s = s + 1
      if digit(rec, 4) == 1 and std.script.status("grep -qF '{gk}' {work}/g/" .. slot(f) .. ".json 2>/dev/null") == 0
        g = g + 1
      if digit(rec, 5) == 2
        c = c + 1
      if digit(rec, 6) == 1
        n = n + 1
      if digit(rec, 7) == 1
        w = w + 1
      if host(f) == "0"
        h = h + 1
    cran = 0
    for fi, f in fs
      if digit(probe(f), 5) >= 1
        cran = cran + 1
    ccell = cellof(c, nf, false)
    if nf > 0 and c < nf and cran > c
      ccell = "partial"
    print("  " .. pad(nm, 24) .. " " .. cellof(d, nf, false) .. " " .. cellof(p, nf, false) .. " " .. cellof(s, nf, false) .. " " .. cellof(g, nf, gapg) .. " " .. ccell .. " " .. cellof(n, nf, false) .. " " .. cellof(w, nf, false) .. " " .. cellof(h, nf, false))
    if nf == 0
      nofixture = nofixture .. "    {nm}\n"

    for fi, f in r(4)
      denytotal = denytotal + 1
      rec = probe(f)
      at = "rejected at sema "
      if digit(rec, 2) == 0
        at = "rejected at parse"
      if digit(rec, 3) == 0
        denyrows = denyrows .. "    {at}  {nm}  {f}\n"
      else
        denyrows = denyrows .. "    ACCEPTED         {nm}  {f}  <- the diagnostic is gone\n"
        denyfail = denyfail + 1

  print("")
  print("  D described (first line states intent) · P parsed (`duo fmt` on a copy)")
  print("  S `duo check` · G `duo graph` names the capability · C C backend ran AND")
  print("  matched its declared value · N `--backend=direct` ran · W both backends")
  print("  agree (or an exit oracle matched `# expect-exit:`) · H hosted compiler parser")
  print("  accepts it — the Duo-written front end, not the Zig one")
  print("")

  if nofixture != ""
    print("  NO FIXTURE — asserted somewhere, demonstrated nowhere")
    stdout:write(nofixture)
    print("")

  if denytotal > 0
    print("  DENY FIXTURES — the diagnostic IS the capability; these must be rejected")
    stdout:write(denyrows)
    print("")

  edges = 0
  for i, f in files
    if script.status("grep -qF '\"edges\"' {work}/g/" .. slot(f) .. ".json 2>/dev/null") == 0
      edges = edges + 1
  ec = edges:to(str)
  fc = to(str)(files:len())
  print("  G NOTES — `duo graph` emits an `edges` array for {ec} of {fc} fixtures.")
  print("  A `?` cell means the graph schema has no slot for that capability at all")
  print("  (`-` in the row's key), so no run of this report could turn it into a ✓.")
  print("  Graph keys, per row:")
  for ri, r in rows
    if r(3):len() > 0
      print("    " .. pad(r(1), 24) .. "  " .. r(2))
  print("")

  hy = hostyes:to(str)
  hn = hostno:to(str)
  print("  CONTROLS — all four fired, so a failure in this matrix would show")
  print("    syntax  {ctlsyntax}  lost P")
  print("    type    {ctltype}  kept P, lost S")
  print("    value   {ctlvalue}  fell from matched to merely-ran")
  print("    hosted  the self-hosted parser accepted {hy} and rejected {hn}; not constant")
  print("")

  if denyfail > 0
    df = denyfail:to(str)
    print("capability_rows: FAIL — {df} deny fixture(s) were ACCEPTED")
    return 1
  nr = to(str)(rows:len())
  nfx = to(str)(files:len())
  print("capability_rows: PASS ({nr} capabilities over {nfx} fixtures)")
  0
