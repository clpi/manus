
q = "'"

head: str = (root: str)
  "cd {root} && git ls-files 'src/*.zig' | tr '\\n' '\\0' | xargs -0 grep -h -E "

upperpat = "^pub const [A-Z][A-Za-z0-9]* = (enum|struct|union|packed struct)"

companionpat = "^pub const [A-Za-z0-9]*(Kind|Type) = enum"

relationpat = "pub fn (add|register|emit)[A-Z][A-Za-z0-9]*\\("

count: i64 = (root: str, pat: str)
  pre: str = head(root)
  cmd: str = "{pre}{q}{pat}{q} 2>/dev/null | wc -l"
  std.proc.capture(cmd):to(i64)

sees: i64 = (pat: str, line: str)
  cmd: str = "printf {q}%s\\n{q} {q}{line}{q} | grep -c -E {q}{pat}{q}"
  std.proc.capture(cmd):to(i64)

livepat = "fb\\.use_[a-z0-9_]+ = [a-z!(][a-z]*"
verifypat = "verify_[a-z0-9_]+"

live: str = (feed: str)
  "{feed} | grep -hoE {q}{livepat}{q} | grep -v {q} = false{q} | sed {q}s/fb\\.use_//;s/ = .*//{q} | sort -u"

verified: str = (feed: str)
  "{feed} | grep -hoE {q}{verifypat}{q} | sed {q}s/verify_//{q} | sort -u"

zig: str = (root: str)
  "cd {root} && git ls-files 'src/*.zig' | tr '\\n' '\\0' | xargs -0 cat"

lines: i64 = (cmd: str)
  to(i64)(proc.capture("{cmd} | wc -l"))

minus: i64 = (a: str, b: str)
  to(i64)(proc.capture("( {a} ; {b} ; {b} ) | sort | uniq -u | wc -l"))

pad: str = (s: str, width: i64)
  out = s
  while out:len() < width
    out = out .. " "
  out

row: i64 = (name: str, n: i64, budget: i64)
  mark = "  "
  if n > budget
    mark = "!!"
  label: str = pad(name, 11)
  shown: str = pad(n:to(str), 7)
  print("  {mark} {label} {shown} {budget}")
  if n > budget
    return 1
  0

main: i64 = ()
  root = os.env("DUO_ROOT")
  if root == nil or root == ""
    root = "."

  bad = 0
  if sees(upperpat, "pub const NodeKind = enum {") != 1
    print("CONTROL FAILED: upper does not see `pub const NodeKind = enum`")
    bad = bad + 1
  if sees(upperpat, "pub const node = enum {") != 0
    print("CONTROL FAILED: upper convicts an already-canonical name")
    bad = bad + 1
  if sees(companionpat, "pub const EdgeKind = enum {") != 1
    print("CONTROL FAILED: companion does not see `EdgeKind`")
    bad = bad + 1
  if sees(companionpat, "pub const Lexer = struct {") != 0
    print("CONTROL FAILED: companion convicts a non-companion type")
    bad = bad + 1
  if sees(relationpat, "pub fn addChild(self: *SemanticGraph") != 1
    print("CONTROL FAILED: relation does not see `addChild`")
    bad = bad + 1
  if sees(relationpat, "pub fn get(self: *const SemanticGraph") != 0
    print("CONTROL FAILED: relation convicts an ordinary accessor")
    bad = bad + 1

  if lines(live(zig(root))) < 1
    print("CONTROL FAILED: the live extractor reads no flag from src/*.zig")
    bad = bad + 1
  if lines(verified(zig(root))) < 1
    print("CONTROL FAILED: the verify extractor reads no companion from src/*.zig")
    bad = bad + 1
  if lines(live("printf {q}    fb.use_alpha = detect(fb);\\n{q}")) != 1
    print("CONTROL FAILED: live does not see a conditionally-assigned flag")
    bad = bad + 1
  if lines(live("printf {q}    fb.use_beta = false;\\n{q}")) != 0
    print("CONTROL FAILED: live counts a flag retired to false")
    bad = bad + 1
  if minus("printf {q}alpha\\n{q}", "printf {q}beta\\n{q}") != 1
    print("CONTROL FAILED: minus loses a left-only name")
    bad = bad + 1
  if minus("printf {q}alpha\\n{q}", "printf {q}alpha\\n{q}") != 0
    print("CONTROL FAILED: minus keeps a name present on both sides")
    bad = bad + 1

  if bad > 0
    print("")
    print("bootstrap scan: CONTROLS BROKEN — every number below would be")
    print("  meaningless, so none is printed. Fix the patterns first.")
    os.exit(3)

  upper = count(root, upperpat)
  companion = count(root, companionpat)
  relation = count(root, relationpat)
  assume = minus(live(zig(root)), verified(zig(root)))

  print("")
  print("  the deny table over src/*.zig — the corpus audit100 cannot see")
  print("  row          count   budget")
  over = 0
  over = over + row("upper", upper, 444)
  over = over + row("companion", companion, 41)
  over = over + row("relation", relation, 45)
  over = over + row("assume", assume, 17)
  print("")
  print("  §0.1 LAW-ONE denies uppercase; §0.3 denies companion *Kind/*Type")
  print("  by name; law.arch.relation denies a semantic distinction encoded")
  print("  in a host function name. See gaps/GAP-080.md for the repair order")
  print("  and for why NOT to bulk-rename.")
  print("")
  print("  assume is §3 MEASUREMENT HONESTY made a number: a live use flag")
  print("  with no verify companion. The seventeen at budget were each read")
  print("  and none is an unguarded value claim — the row exists so the")
  print("  eighteenth cannot arrive unread. See gaps/GAP-085.md.")
  print("")

  if over > 0
    print("bootstrap scan: FAIL — {over} row(s) rose. The ratchet runs DOWN.")
    os.exit(1)

  total: i64 = upper + companion + relation
  print("bootstrap scan: PASS — {total} sites, none rising")
  0
