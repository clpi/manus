-- Pass 11 WP-15 — native-barrier proofs for M1 classifier + honest Ward decode gap.
--
-- Duo replacement for scripts/pass11_ward_no_boxing_smoke.sh (monoglot census).

_zig(): str
    z = std.script.getenv_or("ZIG")
    if z == "" return "zig" end
    z
end

main = (): i64
    zig = _zig()

    print("pass11_ward_no_boxing_smoke: build duo (dump-c dependency)")
    if std.script.run(zig .. " build") != 0
        print("pass11_ward_no_boxing_smoke: FAIL — zig build")
        return 1
    end

    -- Both filters are passed, as the shell version did. `zig test` treats
    -- repeated --test-filter as a UNION, so this runs WP-15 tests named either
    -- way; dropping one would silently shrink the suite.
    print("pass11_ward_no_boxing_smoke: barrier profile tests")
    cmd = zig .. " test src/pass11_ward_barrier_tests.zig"
        .. " --test-filter \"Pass 11 WP-15\" --test-filter \"WP-15\""
    if std.script.run(cmd) != 0
        print("pass11_ward_no_boxing_smoke: FAIL — barrier profile tests")
        return 1
    end

    print("pass11_ward_no_boxing_smoke: PASS")
    0
end
