-- Agent tier-0 gate — Duo-native scripting (replaces bash logic; bash wrapper optional).
-- Safe for parallel agent sessions; does NOT run bench/ml-bench/gpu-bench.
# run: duo run --backend=c scripts/agent_smoke.id
# or:  duo run --backend=c scripts/duo_lock.id -- ./zig-out/bin/duo run --backend=c scripts/agent_smoke.id

agent = req "std.agent"
script = req "std.script"
os = req "std.os"

if not script.ok("./zig-out/bin/duo run --backend=c scripts/public_safety_scan.id")
    print("agent-smoke: public_safety_scan FAIL")
    os.exit(1)
end

-- Pass 57 C2 — exports are scope. No module may reach through another module's
-- `_`-prefixed surface. The gate carries its own positive control, so a clean
-- report is evidence rather than an absence of output.
if not script.ok("./zig-out/bin/duo run --backend=c scripts/module_surface_gate.id")
    print("agent-smoke: module_surface_gate FAIL")
    os.exit(1)
end

-- The hosted-language corpus, ported out of src/lua_superset_corpus.zig when
-- that file was deleted. It runs HERE rather than as its own build.zig step
-- because tier-0 is where a front-end regression should be caught, and because
-- the corpus is twelve `duo check` invocations, not a suite.
if not script.ok("./zig-out/bin/duo run --backend=c scripts/luahost.id")
    print("agent-smoke: luahost FAIL")
    os.exit(1)
end

-- The `duo explain` contract + enrichment assertions, ported out of
-- src/pass7_contract_tests.zig and src/pass7_explain_tests.zig when those
-- were deleted. They read the shipping JSON, so they
-- also convict a `duo explain` that has stopped printing a section.
if not script.ok("./zig-out/bin/duo run --backend=c scripts/explain.id")
    print("agent-smoke: explain FAIL")
    os.exit(1)
end

-- Declared contracts, asserted at the verbs a USER STANDS AT. GAP-090 measured
-- `@noalloc` accepted by `check`, `compile` AND `explain` because the only check
-- lived in the C emitter and the default backend is `direct` — the contract was
-- decorative while a Zig test called it covered. This gate reads exit codes, not
-- output, on six verb paths, and it also owns the lexer-rejection diagnostic
-- (H-8: a bare `error: UnexpectedChar` names no edge). GAP-091.
if not script.ok("./zig-out/bin/duo run --backend=c scripts/contract.id")
    print("agent-smoke: contract FAIL")
    os.exit(1)
end

-- The Pass 8 realization plan, the codegen outcome it produces, shape
-- fingerprint drift, cache invalidation and entity removal. Ported out of
-- src/pass8_realization_tests.zig + src/pass8_codegen_realization_tests.zig.
if not script.ok("./zig-out/bin/duo run --backend=c scripts/realize.id")
    print("agent-smoke: realize FAIL")
    os.exit(1)
end

-- The Pass 5 SIM snapshots — stable entity ids, ABI facts, and byte-for-byte
-- rendering invariance across two runs. Ported out of
-- src/pass5_golden_tests.zig.
if not script.ok("./zig-out/bin/duo run --backend=c scripts/sim.id")
    print("agent-smoke: sim FAIL")
    os.exit(1)
end

-- The transform engine: tier-1 registry contracts, the strict dispatch gate,
-- three-site combinator parity and the call algebra. Ported out of
-- src/meta_transform_tests.zig + src/call_transform_tests.zig +
-- src/pass6_dispatch_tests.zig.
if not script.ok("./zig-out/bin/duo run --backend=c scripts/transform.id")
    print("agent-smoke: transform FAIL")
    os.exit(1)
end

bin = script.id_bin()
script.id_run_all(agent.smoke_targets(), bin)
print("agent-smoke: PASS")
