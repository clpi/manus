tool: str = ()
    d = os.env["DUO"] or ""
    if d:len() == 0
        d = "./zig-out/bin/idol"
    d

report: void = (ok: bool, what: str)
    if ok
        print("OK:   {what}")
    if not ok
        print("FAIL: {what}")

oldway: bool = (s: str)
    s:find("3", 1, true) != nil and s:find("7\n7", 1, true) != nil and s:find("9", 1, true) != nil

newway: bool = (s: str, want: str)
    s == want
normline: void = (path: str, dest: str)
    os.execute("sed -E 's/at native[.]zig:[0-9]+/at native.zig:LINE/g' {path} > {dest}")


main: void = ()
    duo = tool()
    exp = "scripts/applyone_expected"
    allok = true

    rc = os.execute("DUO_BUILD_REPORT=plain {duo} run examples/pack/apply.id > /tmp/ao_pos.txt 2>&1")
    rcmp = os.execute("cmp -s /tmp/ao_pos.txt {exp}/pos.txt")
    rowok = rc != 0 and rcmp == 0
    report(rowok, "brace faces refused exactly as law.brace demands, two sites in order")
    allok = allok and rowok

    rc = os.execute("DUO_BUILD_REPORT=plain {duo} check examples/compile_fail/apply_one_neither.id > /tmp/ao_neg.txt 2>&1")
    rcmp = os.execute("cmp -s /tmp/ao_neg.txt {exp}/neg.txt")
    rowok = rc != 0 and rcmp == 0
    report(rowok, "neither-case refuses, naming the subject and both homes consulted")
    allok = allok and rowok

    rc = os.execute("DUO_BUILD_REPORT=plain {duo} run examples/projection/descriptor.id > /tmp/ao_desc.txt 2>&1")
    normline("/tmp/ao_desc.txt", "/tmp/ao_desc_got.n")
    normline("{exp}/desc.txt", "/tmp/ao_desc_want.n")
    rcmp = os.execute("cmp -s /tmp/ao_desc_got.n /tmp/ao_desc_want.n")
    rowok = rc != 0 and rcmp == 0
    report(rowok, "descriptor application owed refusal, exact")
    allok = allok and rowok

    rc = os.execute("DUO_BUILD_REPORT=plain {duo} check examples/compile_fail/apply_one_label.id > /tmp/ao_lab.txt 2>&1")
    rcmp = os.execute("cmp -s /tmp/ao_lab.txt {exp}/lab.txt")
    rowok = rc != 0 and rcmp == 0
    report(rowok, "resolved descriptor refuses the unknown label, naming it")
    allok = allok and rowok

    rcs = os.execute("mkdir -p /tmp/ao_shape && printf '%b' 'point: descriptor = (x: f64, y: f64)\nq = point\{ x = 3.0, y = 4.0 }\nmain: void = ()\n    print(q.x == 3.0)\n    print(q.y == 4.0)\n' > /tmp/ao_shape/a.id && printf '%b' 'point: descriptor = (x: f64, y: f64)\nq: point = \{x = 3.0, y = 4.0}\nmain: void = ()\n    print(q.x == 3.0)\n    print(q.y == 4.0)\n' > /tmp/ao_shape/b.id && DUO_BUILD_REPORT=plain {duo} run /tmp/ao_shape/a.id > /tmp/ao_shape/a.txt 2>&1; DUO_BUILD_REPORT=plain {duo} run /tmp/ao_shape/b.id > /tmp/ao_shape/b.txt 2>&1")
    rca = os.execute("cmp -s /tmp/ao_shape/a.txt {exp}/shape_a.txt")
    rcb = os.execute("cmp -s /tmp/ao_shape/b.txt {exp}/shape_b.txt")
    rowok = rcs != 0 and rca == 0
    report(rowok, "law.pack.shape applied form refused exactly")
    allok = allok and rowok
    rowok = rcb == 0
    report(rowok, "law.pack.shape typed binding refused exactly")
    allok = allok and rowok

    trunc = "3\n7\n7\n9\n"
    reord = "5\n4\n3\n1\n9\n7\n7\n4\n3\n"
    dupl = "3\n4\n7\n7\n9\n1\n3\n4\n5\n3\n"
    full = "3\n4\n7\n7\n9\n1\n3\n4\n5\n"
    rowok = oldway(trunc) and not newway(trunc, full)
    report(rowok, "counterexample truncated output: old substring check passes, exact check rejects")
    allok = allok and rowok
    rowok = oldway(reord) and not newway(reord, full)
    report(rowok, "counterexample reordered output: old substring check passes, exact check rejects")
    allok = allok and rowok
    rowok = oldway(dupl) and not newway(dupl, full)
    report(rowok, "counterexample duplicated output: old substring check passes, exact check rejects")
    allok = allok and rowok
    rowok = newway(full, full)
    report(rowok, "counterexample true full output: exact check accepts")
    allok = allok and rowok
    rcx = os.execute("cmp -s /tmp/ao_neg.txt {exp}/pos.txt")
    rowok = rcx != 0
    report(rowok, "counterexample cross-run record: output of run two rejected against expectation of run one")
    allok = allok and rowok
    rcx = os.execute("cmp -s /tmp/ao_pos.txt {exp}/neg.txt")
    rowok = rcx != 0
    report(rowok, "counterexample cross-run record: output of run one rejected against expectation of run two")
    allok = allok and rowok

    os.execute("rm -rf /tmp/ao_pos.txt /tmp/ao_neg.txt /tmp/ao_desc.txt /tmp/ao_lab.txt /tmp/ao_shape /tmp/ao_desc_got.n /tmp/ao_desc_want.n")
    if allok
        print("apply-one: all outcome records exact")
    if not allok
        print("apply-one: mismatched outcome records")
    code = 0
    if not allok
        code = 1
    os.exit(code)
