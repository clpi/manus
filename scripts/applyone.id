
chomp: str = (text: str)
    if text == nil or text:len() == 0
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

cap: str = (shellline: str)
    chomp(gatecap(shellline))

global duo: str = os.env["DUO"] or ""
if duo:len() == 0
    duo = "./zig-out/bin/idol"

global failures: i64 = 0

report: void = (ok: bool, what: str, detail: str)
    if ok
        print("OK:   {what}")
    if !ok
        print("FAIL: {what}")
        if detail:len() > 0
            print("      {detail}")
        failures += 1

capture: str = (cmd: str)
    cap("{cmd} 2>&1")

status: i64 = (cmd: str)
    cap("( {cmd} ) > /dev/null 2>&1; echo $?"):to(i64)

has: bool = (hay: str, needle: str)
    n = hay:len()
    m = needle:len()
    if m == 0
        return false
    i = 1
    while i + m - 1 <= n
        if hay:sub(i, i + m - 1) == needle
            return true
        i += 1
    false

counted: i64 = (path: str, needle: str)
    capture("grep -c {needle} {path} | tr -d '\\n'"):to(i64)

allocs: i64 = (cpath: str)
    counted(cpath, "lua_table_new_with_capacity")

put: void = (path: str, body: str)
    status("printf '%s' '{body}' > '{path}'")

main: void = ()
    pos = "examples/pack/apply.id"
    out = capture("{duo} run {pos}")
    hasvalues = out:find("3", 1, true) != nil
    if out:find("7", 1, true) == nil
        hasvalues = false
    if out:find("9", 1, true) == nil
        hasvalues = false
    report(hasvalues, "positive twin answers by value (3 4 7 7 9 1)", out)

    faces = out:find("7\n7", 1, true) != nil
    report(faces, "brace face and paren face project onto one relation", out)

    neg = "examples/compile_fail/apply_one_neither.id"
    negrc = status("{duo} check {neg}")
    negout = capture("{duo} check {neg}")
    refused = negrc != 0
    if negout:find("nosuch", 1, true) == nil
        refused = false
    report(refused, "neither-case refuses, and names the subject", negout)

    homes = has(negout, "descriptor") and has(negout, "callable")
    report(homes, "neither-case names BOTH homes consulted, not just the call path", negout)

    dpos = "examples/projection/descriptor.id"
    dout = capture("{duo} run {dpos}")
    drc = status("{duo} run {dpos}")
    dvalues = drc == 0 and has(dout, "3\n4\n21\n21\n0.75")
    report(dvalues, "descriptor subject constructs, by value (3 4 21 21 0.75)", dout)

    lab = "examples/compile_fail/apply_one_label.id"
    labrc = status("{duo} check {lab}")
    labout = capture("{duo} check {lab}")
    labref = labrc != 0 and has(labout, "has no field") and has(labout, "'z'")
    report(labref, "a resolved descriptor refuses a label it has no field for", labout)

    stem = "applyoneshape{os.time():to(str)}"
    fa = "/tmp/{stem}a.id"
    fb = "/tmp/{stem}b.id"
    fc = "/tmp/{stem}c.id"
    ca = "/tmp/duo_{stem}a.c"
    cb = "/tmp/duo_{stem}b.c"
    cc = "/tmp/duo_{stem}c.c"
    put(fa, "point: { x: f64, y: f64 }\nmain(): void\n    q = point{ x = 3.0, y = 4.0 }\n    print(q.x)\n")
    put(fb, "point: { x: f64, y: f64 }\nmain(): void\n    q: point = { x = 3.0, y = 4.0 }\n    print(q.x)\n")
    put(fc, "main(): void\n    q = { x = 3.0, y = 4.0 }\n    print(q.x)\n")
    status("{duo} run {fa}")
    status("{duo} run {fb}")
    status("{duo} run {fc}")
    na = allocs(ca)
    nb = allocs(cb)
    nc = allocs(cc)
    lit = counted(ca, "'(duo_rec_'") > 0
    status("rm -f '{fa}' '{fb}' '{fc}'")
    shape = lit and na == nb and nc > nb
    report(shape, "law.pack.shape: the applied pack lands as FIELDS, not a table",
        "applied={na} typed-binding={nb} anonymous-pack={nc} compound-literal={lit}")

    if failures == 0
        print("apply-one: 7/7")
    if failures != 0
        print("apply-one: {failures:to(str)} row(s) drifted")
        return 1
