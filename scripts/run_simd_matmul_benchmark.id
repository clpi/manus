# run_simd_matmul_benchmark.id — compare Duo builtin simd.matmul_f32 to native C.
#
# Duo replacement for scripts/run_simd_matmul_benchmark.sh (monoglot census).
#
# examples/bench_simd_matmul_c.c stays C: it is the REFERENCE this benchmark
# measures against, and converting the baseline deletes the comparison.

_OUT_DIR = "/tmp/duo_simd_matmul_bench"
_EX = "examples"

# See run_alloc_churn_benchmark.id: `to(str)` on an f64 does not compile, and
# printing the float raw gives full binary precision. Integer hundredths.
_fmt2: str = (x: f64)
  n = to(i64)(x * 100.0 + 0.5)
  whole = n / 100
  frac = n % 100
  if frac < 10
    return whole:to(str) .. ".0" .. frac:to(str)
  whole:to(str) .. "." .. frac:to(str)

_sdk_flag: str = ()
  sdk = script.chomp(script.capture("xcrun --show-sdk-path 2>/dev/null"))
  if sdk == ""
    return ""
  "-isysroot " .. sdk

# Output shape is: RESULT simd_matmul / <time> / Checksum: <csum>, so the time
# is the line AFTER the marker # not the last line, which is the checksum.
_time_after_marker: str = (bin: str)
  script.chomp(script.capture(bin .. " | grep -A 1 \"RESULT simd_matmul\" | tail -n 1"))

main: i64 = ()
  print("=== Duo SIMD Matmul Benchmark (512x512) ===")
  print("")

  duo = "./zig-out/bin/idol"
  if not script.fs_exists(duo)
    print("ERROR: Duo compiler not found at " .. duo)
    print("  Run 'zig build' first")
    return 1

  script.run("mkdir -p " .. _OUT_DIR)
  sysroot = _sdk_flag()

  print("[1/3] Compiling C reference...")
  cbin = _OUT_DIR .. "/bench_simd_matmul_c"
  if script.run("clang -O3 -flto -ffast-math -march=native " .. sysroot .. " " .. _EX .. "/bench_simd_matmul_c.c -o " .. cbin) != 0
    print("ERROR: C reference failed to compile")
    return 1
  print("      -> " .. cbin)

  print("[2/3] Compiling bench_simd_matmul.id...")
  dbin = _OUT_DIR .. "/bench_simd_matmul_duo"
  if script.run(duo .. " compile " .. _EX .. "/bench_simd_matmul.id -o " .. dbin .. " -O3") != 0
    print("ERROR: Duo benchmark failed to compile")
    return 1
  print("      -> " .. dbin)

  print("")
  print("[3/3] Running benchmark (10 iterations)...")
  print("-----------------------------------------------")

  print("Running Duo...")
  duo_out = _time_after_marker(dbin)
  print("Duo Time: " .. duo_out .. " s")

  print("Running C...")
  c_out = _time_after_marker(cbin)
  print("C Time:   " .. c_out .. " s")

  ct = to(f64)(c_out)
  dt = to(f64)(duo_out)
  if ct == nil or dt == nil or ct == 0.0
    print("Ratio (Duo/C): unavailable — could not read both times")
    print("-----------------------------------------------")
    return 1

  print("Ratio (Duo/C): " .. _fmt2(dt / ct) .. "x")
  print("-----------------------------------------------")
  print("")
  print("Done.")
  0
