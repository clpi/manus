-- tree-sitter recognition gate — `zig build tree-sitter-coverage`.
--
-- Pass 100 §19 names tree-sitter as one of the toolchain hosts. gaps/GAP-049
-- records that the grammar did not build at all until 2026-08-08, and that the
-- setup script had been printing `-- tree-sitter generate failed` in the same
-- shape it uses for genuinely optional steps, which is how a dead grammar
-- stayed unremarked for a long time. This gate exists so that cannot recur:
-- it runs the generator, measures the corpus, and RATCHETS.
--
-- What it ratchets is the number of UNRECOGNISED files, not the number of
-- recognised ones. A count-of-recognised floor reddens when somebody deletes a
-- `.duo` file, which is not a regression; a ceiling on failures reddens only
-- when the grammar loses ground or when a new file lands that it cannot read,
-- and both of those are worth stopping for.
--
-- Three ways this gate could report a confident wrong number, all handled:
--
--   1. `SDKROOT` unset. The tree-sitter CLI compiles `parser.c` itself, and
--      without `SDKROOT` that compile fails on `stdlib.h`, so EVERY file is
--      reported unparseable — a 0/N that looks like a catastrophic regression
--      and is really a missing environment variable. Resolved explicitly
--      below, and the gate refuses to measure if it cannot be resolved.
--   2. `tree-sitter` not installed. Reported as a hard failure rather than a
--      skip: a coverage gate that silently skips is worse than no gate.
--   3. The counter itself being broken. Every run POSITIVE-CONTROLS the
--      detector against two files it writes itself — one valid, one with a
--      deliberate syntax error — and refuses to trust its own number unless
--      the valid one is recognised AND the broken one is not.

-- The most failures allowed. Measured 2026-08-08 at 15 of 759 tracked files.
-- Lower it whenever the real number drops; never raise it without saying which
-- file regressed and why.
ceiling = 15

grammardir = "ext/tree-sitter-duo"

-- The tree-sitter CLI builds parser.c with the host compiler, so it needs the
-- macOS SDK on its include path. `xcrun` is the authority; an already-exported
-- SDKROOT wins so a CI image can pin one.
_sdkroot(): str
    fromenv = std.script.chomp(std.os.getenv("SDKROOT"))
    if fromenv != ""
        return fromenv
    end
    std.script.chomp(std.script.capture("xcrun --show-sdk-path 2>/dev/null"))
end

-- Every shell command the gate runs goes through here, so the SDK path is
-- never accidentally dropped from one of them.
--
-- `export SDKROOT=…; cmd`, NOT the `SDKROOT=… cmd` prefix form. Every command
-- here begins `cd ext/tree-sitter-duo && tree-sitter …`, and a variable
-- prefixed onto that binds to the `cd` alone — tree-sitter runs on the far
-- side of the `&&` without it. The prefix form silently produced an empty
-- result for every command, which `to(i64)("")` turned into a confident 0.
_sh(sdk: str, cmd: str): str
    std.script.capture("export SDKROOT='" .. sdk .. "'; " .. cmd)
end

_shstatus(sdk: str, cmd: str): i64
    std.script.status("export SDKROOT='" .. sdk .. "'; " .. cmd)
end

-- Count files whose tree carries an ERROR / MISSING / UNEXPECTED node.
-- `tree-sitter parse --quiet --paths` prints one line per FAILING file and
-- nothing at all for a clean one, so the failure count is the line count.
_failures(sdk: str, listfile: str): i64
    out: str = _sh(sdk, "cd " .. grammardir .. " && tree-sitter parse --quiet --paths '" .. listfile .. "' 2>/dev/null | sort -u | grep -c . ")
    return to(i64)(std.script.chomp(out))
end

-- Prove the detector can distinguish a good file from a bad one BEFORE
-- believing anything it says about the corpus. A gate that reports 0/N is
-- usually broken, not green.
_control(sdk: str, dir: str): bool
    good = dir .. "/control_good.duo"
    bad = dir .. "/control_bad.duo"
    std.script.capture("printf 'add(a: i64, b: i64): i64\\n    a + b\\nend\\n' > '" .. good .. "'")
    -- An unclosed parenthesis and a dangling operator: not a Duo program under
    -- any reading, so the parser must produce an error node for it.
    std.script.capture("printf 'add(a: i64, b: i64: i64\\n    a + +\\nend\\n' > '" .. bad .. "'")

    -- `fs_tmpdir` is already absolute, so these paths must NOT be prefixed
    -- with $PWD: an unreadable path makes tree-sitter print nothing to stdout,
    -- which the counter would read as "recognised" for both controls.
    std.script.capture("printf '%s\\n' '" .. good .. "' > '" .. dir .. "/good.txt'")
    std.script.capture("printf '%s\\n' '" .. bad .. "' > '" .. dir .. "/bad.txt'")

    goodfails = _failures(sdk, dir .. "/good.txt")
    badfails = _failures(sdk, dir .. "/bad.txt")

    if goodfails != 0
        io.write("tree_sitter_coverage: CONTROL FAILED — a valid file was reported unrecognised\n")
        io.write("  this means the measurement is broken, not that the grammar regressed\n")
        return false
    end
    if badfails != 1
        io.write("tree_sitter_coverage: CONTROL FAILED — a file with a deliberate syntax error was reported RECOGNISED\n")
        io.write("  the detector cannot fail, so its count proves nothing\n")
        return false
    end
    print("tree_sitter_coverage: control ok — valid file recognised, broken file rejected")
    true
end

main = (): i64
    sdk = _sdkroot()
    if sdk == ""
        io.write("tree_sitter_coverage: FAIL — cannot resolve SDKROOT (xcrun --show-sdk-path returned nothing)\n")
        io.write("  without it the tree-sitter CLI cannot compile parser.c and reports EVERY file unparseable\n")
        return 1
    end
    print("tree_sitter_coverage: SDKROOT=" .. sdk)

    if not std.script.ok("command -v tree-sitter >/dev/null 2>&1")
        io.write("tree_sitter_coverage: FAIL — tree-sitter CLI not found on PATH\n")
        io.write("  the grammar cannot be built or measured; install it rather than skipping this gate\n")
        return 1
    end

    -- The generator, checked. This is the step scripts/setup-nvim.duo used to
    -- swallow with `>/dev/null 2>&1`.
    genstatus = _shstatus(sdk, "cd " .. grammardir .. " && tree-sitter generate")
    if genstatus != 0
        io.write("tree_sitter_coverage: FAIL — tree-sitter generate exited " .. genstatus:to(str) .. "\n")
        io.write(_sh(sdk, "cd " .. grammardir .. " && tree-sitter generate 2>&1 | head -40"))
        return 1
    end
    print("tree_sitter_coverage: tree-sitter generate ok")

    -- The generator warns rather than fails on a conflict entry that is no
    -- longer needed. Left alone those accumulate until nobody knows which of
    -- them are load-bearing, so the gate treats one as a failure.
    genout = _sh(sdk, "cd " .. grammardir .. " && tree-sitter generate 2>&1")
    if std.script.chomp(genout) != ""
        io.write("tree_sitter_coverage: FAIL — tree-sitter generate emitted warnings\n")
        io.write(genout)
        io.write("  drop the entries it names; every conflict must be provably necessary\n")
        return 1
    end

    tmp = std.script.fs_tmpdir()
    if not _control(sdk, tmp)
        return 1
    end

    -- git ls-files is the authority on what is tracked; the `-f` test drops
    -- entries that are staged-deleted so a mid-rebase tree cannot fake a
    -- failure out of a missing file.
    --
    -- `fixtures/highlight/` is EXCLUDED, and the reason matters because the
    -- exclusion looks like the exact move this gate exists to stop. This census
    -- asks "can an editor recognise the DUON corpus". Those files are the golden
    -- role corpus for `zig build highlight-corpus`,
    -- and several of them deliberately carry dnir, arm64 assembly, ebnf and C —
    -- one colour language over five surfaces is the point of them. Counting
    -- non-duon text as unrecognised duon does not measure the grammar, it
    -- dilutes the metric with files nobody claimed it should parse. The duon
    -- fixtures among them DO fail here, and that is a real signal — the same
    -- GAP-049 offside hole `examples/spec100/offside.duo` already reports, so
    -- dropping them costs no information this gate was carrying.
    listfile = tmp .. "/corpus.txt"
    std.script.capture("git ls-files '*.duo' | grep -v '^fixtures/highlight/' | while read f; do [ -f \"$f\" ] && printf '%s/%s\\n' \"$PWD\" \"$f\"; done > '" .. listfile .. "'")
    total = to(i64)(std.script.chomp(std.script.capture("grep -c . '" .. listfile .. "'")))
    if total < 1
        io.write("tree_sitter_coverage: FAIL — no tracked .duo files found; the corpus list is empty\n")
        return 1
    end

    fails = _failures(sdk, listfile)
    recognised = total - fails
    pct = (recognised * 1000) / total
    print("tree_sitter_coverage: recognised " .. recognised:to(str) .. " / " .. total:to(str)
        .. " (" .. to(str)(pct / 10) .. "." .. to(str)(pct % 10) .. "%), unrecognised " .. fails:to(str)
        .. ", ceiling " .. ceiling:to(str))

    if fails > ceiling
        io.write("tree_sitter_coverage: FAIL — " .. fails:to(str) .. " unrecognised, ceiling is " .. ceiling:to(str) .. "\n")
        io.write("  the files that failed:\n")
        io.write(_sh(sdk, "cd " .. grammardir .. " && tree-sitter parse --quiet --paths '" .. listfile .. "' 2>/dev/null | sort -u | head -40"))
        return 1
    end

    if fails < ceiling
        print("tree_sitter_coverage: ratchet may be lowered to " .. fails:to(str))
    end

    print("tree_sitter_coverage: PASS")
    0
end
