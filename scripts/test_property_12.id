
_TMP = "/tmp/duo-prop12"

seed = 305419896

rand: i64 = ()
  seed = (seed * 1103515245 + 12345) & 2147483647
  seed

main: i64 = ()
  print("[Property 12] Testing bitwise correctness...")

  std.script.run("rm -rf " .. _TMP .. " && mkdir -p " .. _TMP)
  duo_src = _TMP .. "/prop12.id"
  c_src = _TMP .. "/prop12.c"
  c_bin = _TMP .. "/prop12_c"
  duo_out = _TMP .. "/duo.out"
  c_out = _TMP .. "/c.out"

  d = "-- Generated by scripts/test_property_12.id.\n"
  c = "#include <stdint.h>\n#include <stdio.h>\n\nint main(void) {\n"

  i = 0
  while i < 64
    ra = rand()
    rb = rand()
    a = ra - 1073741824
    b = rb - 1073741824
    shift = rb & 31
    positive = ra & 1048575

    si = i:to(str)
    sa = a:to(str)
    sb = b:to(str)
    ss = shift:to(str)
    sp = positive:to(str)

    d = d .. "local a" .. si .. ": i64 = " .. sa .. "\n" .. "local b" .. si .. ": i64 = " .. sb .. "\n" .. "local s" .. si .. ": i64 = " .. ss .. "\n" .. "local p" .. si .. ": i64 = " .. sp .. "\n" .. "print(a" .. si .. " & b" .. si .. ")\n" .. "print(a" .. si .. " | b" .. si .. ")\n" .. "print(a" .. si .. " ~ b" .. si .. ")\n" .. "print(~a" .. si .. ")\n" .. "print(p" .. si .. " << s" .. si .. ")\n" .. "print(p" .. si .. " >> s" .. si .. ")\n"

    c = c .. "    int64_t a" .. si .. " = " .. sa .. "LL;\n" .. "    int64_t b" .. si .. " = " .. sb .. "LL;\n" .. "    int64_t s" .. si .. " = " .. ss .. "LL;\n" .. "    int64_t p" .. si .. " = " .. sp .. "LL;\n" .. "    printf(\"%lld\\n\", (long long)(a" .. si .. " & b" .. si .. "));\n" .. "    printf(\"%lld\\n\", (long long)(a" .. si .. " | b" .. si .. "));\n" .. "    printf(\"%lld\\n\", (long long)(a" .. si .. " ^ b" .. si .. "));\n" .. "    printf(\"%lld\\n\", (long long)(~a" .. si .. "));\n" .. "    printf(\"%lld\\n\", (long long)(p" .. si .. " << s" .. si .. "));\n" .. "    printf(\"%lld\\n\", (long long)(p" .. si .. " >> s" .. si .. "));\n"

    i = i + 1

  c = c .. "    return 0;\n}\n"

  script.fs_write(duo_src, d)
  script.fs_write(c_src, c)

  duo = "./zig-out/bin/idol"
  if script.run(duo .. " run " .. duo_src .. " > " .. duo_out) != 0
    print("[Property 12] FAIL — Duo program did not run")
    return 1

  cc = "clang"
  if script.chomp(script.capture("uname")) == "Darwin"
    cc = "xcrun clang"
  if script.run(cc .. " -Wall -Wextra -pedantic -std=c11 " .. c_src .. " -o " .. c_bin) != 0
    print("[Property 12] FAIL — C reference did not compile")
    return 1
  if script.run(c_bin .. " > " .. c_out) != 0
    print("[Property 12] FAIL — C reference did not run")
    return 1

  if std.script.run("diff -u " .. c_out .. " " .. duo_out) != 0
    print("[Property 12] FAIL — Duo and C disagree on bitwise results")
    return 1

  print("[Property 12] SUCCESS")
  0
