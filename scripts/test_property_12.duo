-- Property 12: bitwise correctness, Duo vs C, differentially.
--
-- Duo replacement for scripts/test_property_12.sh (monoglot census).
--
-- Generates 64 pseudo-random cases, emits the SAME cases as a Duo program and
-- a C program, runs both, and diffs the output. C is the oracle here, so
-- examples of it stay C by construction -- the generated .c is the reference,
-- not a source file.

_TMP = "/tmp/duo-prop12"

-- The exact LCG the shell version used, seed included, so this generates the
-- SAME 64 cases: any divergence in the report is a real bitwise divergence and
-- not a different corpus. glibc's constants, masked to 31 bits.
_seed = 305419896

_next_rand(): i64
    _seed = (_seed * 1103515245 + 12345) & 0x7fffffff
    _seed
end

main = (): i64
    print("[Property 12] Testing bitwise correctness...")

    std.script.run("rm -rf " .. _TMP .. " && mkdir -p " .. _TMP)
    duo_src = _TMP .. "/prop12.duo"
    c_src = _TMP .. "/prop12.c"
    c_bin = _TMP .. "/prop12_c"
    duo_out = _TMP .. "/duo.out"
    c_out = _TMP .. "/c.out"

    d = "-- Generated by scripts/test_property_12.duo.\n"
    c = "#include <stdint.h>\n#include <stdio.h>\n\nint main(void) {\n"

    i = 0
    while i < 64
        ra = _next_rand()
        rb = _next_rand()
        a = ra - 1073741824
        b = rb - 1073741824
        shift = rb & 31
        positive = ra & 1048575

        si = i:to(str)
        sa = a:to(str)
        sb = b:to(str)
        ss = shift:to(str)
        sp = positive:to(str)

        -- The generated Duo still uses `local`, exactly as the shell version
        -- emitted it. The canon lists `local` as dead, so this corpus is due a
        -- refresh -- but changing what the differential FEEDS the compiler is a
        -- different change from porting the harness, and would quietly alter
        -- what the test proves.
        d = d .. "local a" .. si .. ": i64 = " .. sa .. "\n"
            .. "local b" .. si .. ": i64 = " .. sb .. "\n"
            .. "local s" .. si .. ": i64 = " .. ss .. "\n"
            .. "local p" .. si .. ": i64 = " .. sp .. "\n"
            .. "print(a" .. si .. " & b" .. si .. ")\n"
            .. "print(a" .. si .. " | b" .. si .. ")\n"
            .. "print(a" .. si .. " ~ b" .. si .. ")\n"
            .. "print(~a" .. si .. ")\n"
            .. "print(p" .. si .. " << s" .. si .. ")\n"
            .. "print(p" .. si .. " >> s" .. si .. ")\n"

        -- Duo's binary `~` is XOR and unary `~` is NOT, which is why the C
        -- side pairs them with `^` and `~` respectively. Getting that mapping
        -- backwards would make the test pass on a compiler that had them
        -- swapped.
        c = c .. "    int64_t a" .. si .. " = " .. sa .. "LL;\n"
            .. "    int64_t b" .. si .. " = " .. sb .. "LL;\n"
            .. "    int64_t s" .. si .. " = " .. ss .. "LL;\n"
            .. "    int64_t p" .. si .. " = " .. sp .. "LL;\n"
            .. "    printf(\"%lld\\n\", (long long)(a" .. si .. " & b" .. si .. "));\n"
            .. "    printf(\"%lld\\n\", (long long)(a" .. si .. " | b" .. si .. "));\n"
            .. "    printf(\"%lld\\n\", (long long)(a" .. si .. " ^ b" .. si .. "));\n"
            .. "    printf(\"%lld\\n\", (long long)(~a" .. si .. "));\n"
            .. "    printf(\"%lld\\n\", (long long)(p" .. si .. " << s" .. si .. "));\n"
            .. "    printf(\"%lld\\n\", (long long)(p" .. si .. " >> s" .. si .. "));\n"

        i = i + 1
    end

    c = c .. "    return 0;\n}\n"

    std.script.fs_write(duo_src, d)
    std.script.fs_write(c_src, c)

    duo = "./zig-out/bin/duo"
    if std.script.run(duo .. " run " .. duo_src .. " > " .. duo_out) != 0
        print("[Property 12] FAIL — Duo program did not run")
        return 1
    end

    cc = "clang"
    if std.script.chomp(std.script.capture("uname")) == "Darwin"
        cc = "xcrun clang"
    end
    if std.script.run(cc .. " -Wall -Wextra -pedantic -std=c11 " .. c_src .. " -o " .. c_bin) != 0
        print("[Property 12] FAIL — C reference did not compile")
        return 1
    end
    if std.script.run(c_bin .. " > " .. c_out) != 0
        print("[Property 12] FAIL — C reference did not run")
        return 1
    end

    -- diff's STATUS is the assertion; its output is the report. The shell
    -- version ran `diff -u` under `set -e`, so a divergence aborted before the
    -- SUCCESS line -- correct, but it never said the word FAIL.
    if std.script.run("diff -u " .. c_out .. " " .. duo_out) != 0
        print("[Property 12] FAIL — Duo and C disagree on bitwise results")
        return 1
    end

    print("[Property 12] SUCCESS")
    0
end
