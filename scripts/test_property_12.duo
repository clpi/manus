#!/usr/bin/env duo
global s = req "std.script"

s.echo("[Property 12] Testing bitwise correctness...")

global ROOT: str = tostring(s.path_dirname(s.path_dirname(s.capture("pwd"))))
if tostring(s.getenv_or("PWD")) ~= ""
    ROOT = tostring(s.getenv_or("PWD"))
end

global TMP_DIR: str = string.gsub(tostring(s.fs_tmpdir()), "\n", "")

global CLANG: str = "clang"
if tostring(s.capture("uname -s")) == "Darwin\n"
    CLANG = "xcrun clang"
end

global DUO_SRC: str = tostring(s.path_join(TMP_DIR, "prop12.duo"))
global C_SRC: str = tostring(s.path_join(TMP_DIR, "prop12.c"))
global C_BIN: str = tostring(s.path_join(TMP_DIR, "prop12_c"))
global DUO_OUT: str = tostring(s.path_join(TMP_DIR, "duo.out"))
global C_OUT: str = tostring(s.path_join(TMP_DIR, "c.out"))

duo_code: str = "-- Generated by scripts/test_property_12.duo.\n"

c_code: str = [[
#include <stdint.h>
#include <stdio.h>

int main(void) {
]]

global seed: i64 = 305419896

function next_rand() -> i64
    seed = (seed * 1103515245 + 12345) & 0x7fffffff
    return seed
end

for i = 0, 63 do
    local ra: i64 = next_rand()
    local rb: i64 = next_rand()
    local a: i64 = ra - 1073741824
    local b: i64 = rb - 1073741824
    local shift: i64 = rb & 31
    local positive: i64 = ra & 1048575

    local is: str = tostring(i)
    local as: str = tostring(a)
    local bs: str = tostring(b)
    local ss: str = tostring(shift)
    local ps: str = tostring(positive)

    duo_code = duo_code .. "local a" .. is .. ": i64 = " .. as .. "\n"
    duo_code = duo_code .. "local b" .. is .. ": i64 = " .. bs .. "\n"
    duo_code = duo_code .. "local s" .. is .. ": i64 = " .. ss .. "\n"
    duo_code = duo_code .. "local p" .. is .. ": i64 = " .. ps .. "\n"
    duo_code = duo_code .. "print(a" .. is .. " & b" .. is .. ")\n"
    duo_code = duo_code .. "print(a" .. is .. " | b" .. is .. ")\n"
    duo_code = duo_code .. "print(a" .. is .. " ~ b" .. is .. ")\n"
    duo_code = duo_code .. "print(~a" .. is .. ")\n"
    duo_code = duo_code .. "print(p" .. is .. " << s" .. is .. ")\n"
    duo_code = duo_code .. "print(p" .. is .. " >> s" .. is .. ")\n"

    c_code = c_code .. "    int64_t a" .. is .. " = " .. as .. "LL;\n"
    c_code = c_code .. "    int64_t b" .. is .. " = " .. bs .. "LL;\n"
    c_code = c_code .. "    int64_t s" .. is .. " = " .. ss .. "LL;\n"
    c_code = c_code .. "    int64_t p" .. is .. " = " .. ps .. "LL;\n"
    c_code = c_code .. "    printf(\"%lld\\n\", (long long)(a" .. is .. " & b" .. is .. "));\n"
    c_code = c_code .. "    printf(\"%lld\\n\", (long long)(a" .. is .. " | b" .. is .. "));\n"
    c_code = c_code .. "    printf(\"%lld\\n\", (long long)(a" .. is .. " ^ b" .. is .. "));\n"
    c_code = c_code .. "    printf(\"%lld\\n\", (long long)(~a" .. is .. "));\n"
    c_code = c_code .. "    printf(\"%lld\\n\", (long long)(p" .. is .. " << s" .. is .. "));\n"
    c_code = c_code .. "    printf(\"%lld\\n\", (long long)(p" .. is .. " >> s" .. is .. "));\n"
end

c_code = c_code .. "    return 0;\n}\n"

s.fs_write(DUO_SRC, duo_code)
s.fs_write(C_SRC, c_code)

s.must(ROOT .. "/zig-out/bin/duo run " .. DUO_SRC .. " > " .. DUO_OUT)

s.must(CLANG .. " -Wall -Wextra -pedantic -std=c11 " .. C_SRC .. " -o " .. C_BIN)
s.must(C_BIN .. " > " .. C_OUT)

if not s.ok("diff -u " .. C_OUT .. " " .. DUO_OUT)
    s.echo("Mismatch between C output and Duo output!")
    os.exit(1)
end

s.echo("[Property 12] SUCCESS")
s.run("rm -rf " .. TMP_DIR)
