# Duo Neovim integration setup.
#
# Duo replacement for scripts/setup-nvim.sh (monoglot census).
# Run: idol run scripts/setup-nvim.id
#
# 1. Builds the duo compiler if missing
# 2. Builds duo-lsp
# 3. Writes the Neovim autoload config
# 4. Generates the tree-sitter grammar
# 5. Installs highlight queries
#
# The config this WRITES is Lua, and stays Lua: Neovim's runtime loads Lua and
# vimscript, so that file is a host requirement # the same class as
# examples/metal_compute.m and the plugin's .vim files. A .id file in
# after/plugin/ would simply never be read.
#
# It is embedded as a [[raw string]], which takes no interpolation. That is
# load-bearing: the Lua below is dense with braces (`{ extension = { duo =
# "duo" } }`), and in an ordinary string every one of them would be read as a
# hole and rewritten # GAP-16, the bug that once rewrote a conformance
# corpus's own test data.

_NVIM_LUA = [[-- Duo language support (auto-loaded by Neovim)
# Source: ~/x/duo/ext/duo.nvim

# Add duo.nvim to runtime path
local duo_nvim_path = vim.fn.expand("~/x/duo/ext/duo.nvim")
if vim.fn.isdirectory(duo_nvim_path) == 1
  vim.opt.runtimepath:append(duo_nvim_path)

# Filetype detection
vim.filetype.add({
  extension = { duo = "duo" },
})

# File settings
vim.api.nvim_create_autocmd("FileType", {
  pattern = "duo",
  callback = function()
    vim.bo.commentstring = "-- %s"
    vim.bo.tabstop = 2
    vim.bo.shiftwidth = 2
    vim.bo.expandtab = true
    vim.bo.smartindent = true
  end,
})

# LSP setup
local duo_lsp_bin = vim.fn.expand("~/x/duo-lsp/duo-lsp")
if vim.fn.filereadable(duo_lsp_bin) == 1
  vim.api.nvim_create_autocmd("FileType", {
    pattern = "duo",
    callback = function(args)
      vim.lsp.start({
        name = "duo-lsp",
        cmd = { duo_lsp_bin },
        root_dir = vim.fs.dirname(vim.fs.find({"build.id", ".git"}, {
          upward = true,
          path = vim.fs.dirname(args.file),
        })[1] or args.file),
      })
    end,
  })

# Key mappings for Duo
vim.api.nvim_create_autocmd("FileType", {
  pattern = "duo",
  callback = function()
    local opts = { buffer = true, silent = true }
    # Run current file
    vim.keymap.set("n", "<leader>dr", ":!idol run %<CR>", opts)
    # Check current file
    vim.keymap.set("n", "<leader>dc", ":!duo check %<CR>", opts)
    # Dump generated C
    vim.keymap.set("n", "<leader>dd", ":!duo dump-c %<CR>", opts)
    # Format
    vim.keymap.set("n", "<leader>df", ":!duo fmt %<CR>", opts)
  end,
})
]]

_home(): str
    std.script.getenv_or("HOME")

_nvim_config(): str
    x = std.script.getenv_or("XDG_CONFIG_HOME")
    if x == "" return _home() .. "/.config/nvim"
    x .. "/nvim"

# Copy one file, reporting only when it lands. The shell version chained
# `cp ... && echo` so a missing source was silent; this says which one.
_install(src: str, dir: str, label: str): void
    if std.script.run("cp " .. src .. " " .. dir .. "/ 2>/dev/null") == 0
        print("  ok " .. label .. " installed")
    else
        print("  -- " .. label .. " not found (" .. src .. ")")

main: i64 = ()
    duo_root = std.script.chomp(std.script.capture("pwd"))
    duo_bin = duo_root .. "/zig-out/bin/idol"
    lsp_root = _home() .. "/x/duo-lsp"
    nvim_config = _nvim_config()

    print("=== Duo Neovim Setup ===")

    print("-> Building duo compiler...")
    if std.script.fs_exists(duo_bin)
        print("  ok duo binary exists")
    else
        print("  Building...")
        if std.script.run("zig build") != 0
            print("  -- build failed (may need zig 0.17)")

    print("-> Building duo-lsp...")
    if !std.script.fs_exists(lsp_root)
        print("  -- ~/x/duo-lsp not found")
    else
        if std.script.fs_exists(lsp_root .. "/duo-lsp")
            print("  ok duo-lsp binary exists")
        else
            if !std.script.fs_exists(duo_bin)
                print("  -- no duo compiler to build it with")
            else
                # duo-lsp now has its own Duo build script; prefer it, so the
                # compile flags stay in ONE place rather than being restated
                # here and drifting.
                cmd = "cd " .. lsp_root .. " && " .. duo_bin .. " run build.id >/dev/null 2>&1"
                if std.script.run(cmd) == 0
                    print("  ok built duo-lsp")
                else
                    print("  -- duo-lsp build failed")

    print("-> Setting up duo.nvim plugin...")
    after_dir = nvim_config .. "/after/plugin"
    std.script.run("mkdir -p " .. after_dir)
    std.script.fs_write(after_dir .. "/duo.lua", _NVIM_LUA)
    print("  ok created " .. after_dir .. "/duo.lua")

    # A generator that RUNS and FAILS is not an optional step, and this block
    # used to report it as one: `>/dev/null 2>&1` threw away the diagnostic and
    # `-- tree-sitter generate failed` read exactly like the `-- not found`
    # line above it. The grammar had not built in some time and nothing said
    # so. A missing CLI is still optional (another machine may not have it);
    # a failing generate is now fatal, and prints what the generator said.
    print("-> Setting up tree-sitter-duo...")
    broken = 0
    if std.script.chomp(std.script.capture("command -v tree-sitter 2>/dev/null")) == ""
        print("  -- tree-sitter-cli not found (npm i -g tree-sitter-cli)")
    else
        ts = duo_root .. "/ext/tree-sitter-duo"
        # No redirect. The generator names the exact rule and lookahead it
        # could not resolve, and that text IS the repair instruction; sending
        # it to /dev/null is what made this invisible.
        code = std.script.run("cd {ts} && tree-sitter generate")
        if code == 0
            print("  ok grammar generated")
        else
            broken = 1
            print("  FAIL tree-sitter generate exited {code} in {ts}")
            print("  the editors have NO working parser until this exits 0.")
            print("  see gaps/GAP-049.")

    print("-> Installing highlight queries...")
    queries = nvim_config .. "/queries/duo"
    std.script.run("mkdir -p " .. queries)
    q = duo_root .. "/ext/tree-sitter-duo/queries"
    _install(q .. "/highlights.scm", queries, "highlights")
    _install(q .. "/locals.scm", queries, "locals")
    _install(q .. "/injections.scm", queries, "injections")

    print("")
    if broken == 1
        print("=== Setup FAILED — tree-sitter generate did not exit 0 ===")
        print("")
        print("Neovim will highlight nothing in .id files until it does.")
    else
        print("=== Setup Complete ===")
        print("")
        print("Add to your shell profile:")
        print("  export PATH=\"$HOME/x/duo/zig-out/bin:$HOME/x/duo-lsp:$PATH\"")
        print("")
        print("Neovim keybindings (in .id files):")
        print("  <leader>dr  — Run current file")
        print("  <leader>dc  — Check/lint current file")
        print("  <leader>dd  — Dump generated C")
        print("  <leader>df  — Format file")
        print("")
        print("LSP features: diagnostics, hover, go-to-definition, completions")
    broken
