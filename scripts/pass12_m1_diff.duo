-- Pass 12 M1 — differential + fuzz harness for the Duo-native keyword classifier.
-- Run: scripts/duo_lock.sh -- ./zig-out/bin/duo run scripts/pass12_m1_diff.duo
--
-- Verifies, at runtime against the compiled Duo module:
--   1. Exhaustive: every descriptor entry classifies to its own kind id under
--      ALL 3 candidate realizations (branch_chain, length_bucket, sorted_lookup).
--   2. Negative: non-keyword identifiers (incl. case / prefix / suffix mutants)
--      classify to 0 under all 3 candidates (no false positives).
--   3. Fuzz: deterministic LCG over random lowercase words — all candidates
--      agree with the descriptor reference (no divergence, no false positives).
--   4. Metadata projections: category_of / spelling_of / is_keyword agree.
--
-- Differential vs the Zig host table (src/lexer.zig via token_semantic.zig) is
-- closed transitively: emitted kind ids are lexer.TokenKind ordinals (verified by
-- src/token_classify_gen.zig tests) and the host classifiers are self-differential
-- (src/token_semantic.zig tests).

C = req "std.token.classify"
os = req "std.os"

total = 0
fail = 0

check(name: str, cond: bool)
    total = total + 1
    if not cond
        fail = fail + 1
        print("  FAIL: " .. name)
    end
end

CANDIDATES = { "branch_chain", "length_bucket", "sorted_lookup" }

classify_with(cid: str, w: str): i64
    if cid == "branch_chain" return C.classify_branch_chain(w) end
    if cid == "length_bucket" return C.classify_length_bucket(w) end
    if cid == "sorted_lookup" return C.classify_sorted_lookup(w) end
    0
end

-- 1. Exhaustive descriptor verification.
for i = 1, C.KEYWORD_COUNT
    t = C.SORTED_TEXT[i]
    id = C.SORTED_ID[i]
    cat = C.SORTED_CATEGORY[i]
    check("exhaustive: " .. t .. " id=" .. id .. " cat=" .. cat,
        C.classify(t) == id and
        C.classify_branch_chain(t) == id and
        C.classify_length_bucket(t) == id and
        C.classify_sorted_lookup(t) == id and
        C.is_keyword(t) and
        C.category_of(id) == cat and
        C.spelling_of(id) == t)
end

-- 2. Negative samples (no false positives).
NEGATIVES = {
    "foo", "bar", "identifier", "notkw", "Function", "asyncio", "matchx",
    "", "a", "zz", "yy", "x", "And", "AND", "If", "IF", "True", "tRUE",
    "andd", "xand", "end1", "1and", "endo", "endd", "dot", "doo", "dox",
    "i64x", "xi64", "stir", "forr", "whilee", "ifx", "returnt",
}
for _, neg in ipairs(NEGATIVES)
    for _, cid in ipairs(CANDIDATES)
        check("negative[" .. cid .. "]: '" .. neg .. "'",
            classify_with(cid, neg) == 0)
    end
    check("negative[prod]: '" .. neg .. "'", C.classify(neg) == 0)
    check("negative[is_keyword]: '" .. neg .. "'", not C.is_keyword(neg))
end

-- 3. Deterministic fuzz (LCG over lowercase words, 0..12 chars).
seed = 0xC12A1F00D
next_rand(): i64
    seed = (seed * 1103515245 + 12345) % 2147483648
    seed
end

random_word(): str
    len = next_rand() % 13
    w = ""
    for i = 1, len
        c = string.char(97 + next_rand() % 26)
        w = w .. c
    end
    w
end

descriptor_ref(w: str): i64
    for i = 1, C.KEYWORD_COUNT
        if C.SORTED_TEXT[i] == w return C.SORTED_ID[i] end
    end
    0
end

for n = 1, 2048
    w = random_word()
    ref = descriptor_ref(w)
    for _, cid in ipairs(CANDIDATES)
        got = classify_with(cid, w)
        check("fuzz[" .. cid .. "]: '" .. w .. "' ref=" .. ref .. " got=" .. got,
            got == ref)
    end
    check("fuzz[prod]: '" .. w .. "'", C.classify(w) == ref)
end

-- 4. Near-miss mutations of every real keyword (prefix/suffix/case).
MUTATIONS = { "x", "z" }
for i = 1, C.KEYWORD_COUNT
    t = C.SORTED_TEXT[i]
    for _, m in ipairs(MUTATIONS)
        w1 = m .. t
        w2 = t .. m
        for _, cid in ipairs(CANDIDATES)
            check("mutant[" .. cid .. "]: '" .. w1 .. "'", classify_with(cid, w1) == 0)
            check("mutant[" .. cid .. "]: '" .. w2 .. "'", classify_with(cid, w2) == 0)
        end
    end
end

print(string.format("pass12_m1_diff: %d checks, %d failures", total, fail))
if fail > 0
    os.exit(1)
end
print("pass12_m1_diff: PASS")
