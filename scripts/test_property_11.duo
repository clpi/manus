#!/usr/bin/env duo
global s = req "std.script"

s.echo("[Property 11] Testing C codegen...")

s.echo("1")
global ROOT: str = tostring(s.path_dirname(s.path_dirname(s.capture("pwd"))))
s.echo("2")
if tostring(s.getenv_or("PWD")) != ""
    ROOT = tostring(s.getenv_or("PWD"))
end

s.echo("3")
global TMP_DIR: str = string.gsub(s.fs_tmpdir(), "\n", "")
s.echo("4: " .. TMP_DIR)

global CLANG: str = "clang"
s.echo("5")
uname = s.capture("uname -s")
s.echo("6")
if uname == "Darwin\n"
    CLANG = "xcrun clang"
end
s.echo("7")

check_module(name: str, code: str): void
    s.echo("  checking " .. name .. "...")
    duo_file = s.path_join(TMP_DIR, name .. ".duo")
    c_file = s.path_join(TMP_DIR, name .. ".c")
    clang_log = s.path_join(TMP_DIR, name .. ".clang.log")
    
    s.fs_write(duo_file, code)
    s.must(ROOT .. "/zig-out/bin/duo dump-c " .. duo_file .. " > " .. c_file)
    
    cmd = CLANG .. " -Wall -Wextra -pedantic -std=c11 -Wno-unused-variable -Wno-strict-prototypes -fsyntax-only " .. c_file .. " > " .. clang_log .. " 2>&1"
    if not s.ok(cmd)
        s.echo(s.fs_read(clang_log))
        os.exit(1)
    end
    s.echo("  ok " .. name)
end

check_module("arithmetic", [[
add(a: i64, b: i64) -> i64
  return a + b
end

mix(a: i64, b: i64) -> i64
  x: i64 = add(a, b)
  y: i64 = (x * 3) - (b // 2)
  return y % 97
end

result: i64 = mix(40, 2)
]])

check_module("floats_and_branches", [[
scale(x: f64, n: i64) -> f64
  if n > 10
    return x * 2.5
  elseif n == 10
    return x + 1.25
  end
  return x / 2.0
end

a: f64 = scale(3.0, 12)
b: bool = a > 1.0
]])

check_module("loops", [[
sum_to(n: i64) -> i64
  acc: i64 = 0
  i: i64 = 1
  while i <= n do
    acc = acc + i
    i = i + 1
  end
  return acc
end

total: i64 = sum_to(16)
]])

check_module("strings", [[
middle(s: str): str
  return string.sub(s, 2, 4)
end

label(n: i64): str
  s: str = tostring(n)
  return middle("abcdef") .. s
end

out: str = label(42)
]])

check_module("records_and_globals", [[
@packed
@align(16)
global gp: { x: i8, y: i64 } = { x = 1, y = 2 }

sum_point(): i64
  @packed
  @align(8)
  p: { x: i8, y: i64 } = { x = 3, y = 4 }
  return gp.y + p.y
end

n: i64 = sum_point()
]])

check_module("record_alias_params", [[
type Point = { x: i64, y: i64 }

get_y(p: { x: i64, y: i64 }) -> i64
  return p.y
end

sum_point(p: Point) -> i64
  return p.x + p.y
end

p: Point = { x = 5, y = 7 }
a: i64 = get_y({ x = 3, y = 4 })
b: i64 = sum_point(p)
]])

check_module("bitwise", [[
bits(a: i64, b: i64, s: i64) -> i64
  x: i64 = (a & b) | (a ~ b)
  y: i64 = (a & 65535) << s
  z: i64 = y >> s
  return x + z + (~b)
end

n: i64 = bits(123456, 7890, 3)
]])

check_module("native_indexing", [[
pointer_read(xs: *i32, i: i64) -> i32
  return xs[i]
end
]])

if not s.ok("grep -Fq 'return xs[i];' " .. TMP_DIR .. "/native_indexing.c")
    s.echo("native pointer indexing did not remain a direct typed C index")
    os.exit(1)
end

check_module("typed_function_values", [[
increment(x: i32) -> i32
  return x + 1
end

apply(f: (i32) -> i32, x: i32) -> i32
  return f(x)
end

result: i32 = apply(increment, 41)
]])

if not s.ok("grep -Fq 'int32_t (*f)(int32_t)' " .. TMP_DIR .. "/typed_function_values.c") or not s.ok("grep -Fq 'return f(x);' " .. TMP_DIR .. "/typed_function_values.c")
    s.echo("typed function parameter/call did not remain direct native C")
    os.exit(1)
end

s.echo("[Property 11] SUCCESS")
s.run("rm -rf " .. TMP_DIR)
