-- Does the stdlib compute the RIGHT ANSWER?
--
-- The other two gates measure different things and neither measures this:
--   scripts/stdlib_embed_gate.id   — does the module LOAD?
--   scripts/spec_conformance.id    — does the spec's FORM exist?
--
-- Every serious bug found on 2026-08-07 produced a plausible wrong answer with
-- NO error, and would have passed both:
--
--   std.fmt.boolean(true)          -> "false"   (a boolean formatter, wrong)
--   std.string.byte("AB", 1)       -> nil       (431 call sites read nil)
--   std.inspect hash of anything   -> "{}"
--   to(i64)("42")                  -> 4338831547  (a pointer, cast as int)
--   descending `for` loops         -> zero iterations, silently
--
-- So this asserts VALUES, against vectors that are known independently — not
-- against whatever the implementation currently returns. That distinction is
-- the whole point: a hash module driven wrong once returned its own SEED,
-- 2166136261, which looks exactly like a plausible hash.
--
-- A RATCHET on the failure count. Fix a row, lower the floor.

-- Measured floor: rows currently failing. Lower when fixed; never raise to
-- quiet the gate. Verified 2026-08-07.
baseline(): i64
    0
end

fnv_hello(): i64
    s = std.hash.fnv.new32a()
    std.hash.fnv.update(s, "hello")
    std.hash.fnv.final(s)
end

fails = 0
checked = 0
report = ""

check(label: str, got: str, want: str): void
    checked = checked + 1
    if got == want
        return
    end
    fails = fails + 1
    report = report .. "  WRONG " .. label .. ": got " .. got .. ", want " .. want .. "\n"
end

main(): i64
    -- std.fmt — the boolean formatter that returned "false" for true.
    check("fmt.boolean(true)", to(str)(std.fmt.boolean(true)), "true")
    check("fmt.boolean(false)", to(str)(std.fmt.boolean(false)), "false")

    -- std.strconv — same defect, caught by typing instead of shipping.
    check("strconv.format_bool(true)", std.strconv.format_bool(true), "true")
    check("strconv.format_bool(false)", std.strconv.format_bool(false), "false")

    -- std.string — the Lua-builtin surface that resolved to missing members
    -- and returned nil at 431 call sites across lib/.
    check("string.byte", to(str)(std.string.byte("AB", 1)), "65")
    check("string.len", to(str)(std.string.len("hello")), "5")
    check("string.sub", std.string.sub("hello", 2, 3), "el")
    check("string.char", std.string.char(65), "A")

    -- std.base64 — RFC 4648 vectors, written from the RFC, not read back from
    -- the implementation. Encode dropped '=' padding entirely and decode lost
    -- one byte from every 2-byte tail, so the module's own round trip was
    -- lossy: encode("hi") -> "aGk" -> decode -> "h".
    check("base64.encode('h')", std.base64.encode("h"), "aA==")
    check("base64.encode('hi')", std.base64.encode("hi"), "aGk=")
    check("base64.encode('hel')", std.base64.encode("hel"), "aGVs")
    check("base64.encode('hello')", std.base64.encode("hello"), "aGVsbG8=")
    check("base64.decode('aGk=')", std.base64.decode("aGk="), "hi")
    check("base64.decode('aA==')", std.base64.decode("aA=="), "h")
    check("base64.roundtrip", std.base64.decode(std.base64.encode("hello world")), "hello world")

    -- std.base32 — RFC 4648 s6 vectors, both directions now. Encode emitted
    -- seven characters per partial group instead of eight; decode was broken by
    -- std.string.char returning a FOUR-byte string (see string.id), so every
    -- byte after the first vanished at table.concat.
    check("base32.encode('h')", std.base32.encode("h"), "NA======")
    check("base32.encode('hi')", std.base32.encode("hi"), "NBUQ====")
    check("base32.encode('hello')", std.base32.encode("hello"), "NBSWY3DP")
    check("base32.decode('NA======')", std.base32.decode("NA======"), "h")
    check("base32.decode('NBUQ====')", std.base32.decode("NBUQ===="), "hi")
    check("base32.decode('NBSWY3DP')", std.base32.decode("NBSWY3DP"), "hello")
    check("base32.roundtrip", std.base32.decode(std.base32.encode("hi")), "hi")
    -- The defect underneath base32 decode, pinned directly.
    check("string.char len", to(str)(string.len(std.string.char(104))), "1")
    check("string.char concat", std.string.char(104) .. std.string.char(101), "he")
    check("string.rep", std.string.rep("x", 2), "xx")

    -- std.bit and std.hash.fnv — both CORRECT. Added as coverage, and as a
    -- correction: an earlier sweep of mine reported `std.bit.band/bor` and
    -- `std.hash.fnv.hash32` returning nil and I recorded them as defects in two
    -- commit messages. Those names never existed. std.bit exposes
    -- popcount/clz/ctz/bit_length/rotl/rotr/reverse; std.hash.fnv is a
    -- STREAMING api (new32a/update/final). The probe was wrong, not the code.
    --
    -- The FNV vector is the real one: FNV-1a 32 of "hello" is 1335831723.
    -- NOT 2166136261 — that is the offset basis, i.e. what this module returns
    -- when driven wrong, and it looks exactly like a plausible hash.
    check("bit.popcount(255)", to(str)(std.bit.popcount(255)), "8")
    check("bit.clz(1)", to(str)(std.bit.clz(1)), "63")
    check("bit.bit_length(8)", to(str)(std.bit.bit_length(8)), "4")
    check("bit.rotl(1,1)", to(str)(std.bit.rotl(1, 1)), "2")
    check("fnv1a32('hello')", to(str)(fnv_hello()), "1335831723")

    -- Modules swept and found CORRECT. Recorded as coverage so a future
    -- change cannot break them silently — which is the point of a ratchet, and
    -- cheaper than rediscovering them. `std.math.pow` is deliberately absent:
    -- Lua 5.3 removed it in favour of `^`, so its nil is correct, not a defect.
    check("crypto.hex_encode", std.crypto.hex_encode("hi"), "6869")
    check("crypto.hex_decode", std.crypto.hex_decode("6869"), "hi")
    check("json.encode", to(str)(std.json.encode({a = 1})), "{\"a\":1}")
    check("script.path_basename", std.script.path_basename("a/b/c.id"), "c.id")
    check("script.path_stem", std.script.path_stem("a/b/c.id"), "c")
    check("script.path_ext", std.script.path_ext("a/b/c.id"), ".id")
    check("script.path_dirname", std.script.path_dirname("a/b/c.id"), "a/b")
    check("string.trim", std.string.trim("  hi  "), "hi")
    check("string.reverse", std.string.reverse("abc"), "cba")
    check("string.count", to(str)(std.string.count("banana", "a")), "3")
    check("string.pad_left", std.string.pad_left("7", 3, "0"), "007")
    check("string.repeat_str", std.string.repeat_str("ab", 3), "ababab")
    check("table.index_of", to(str)(std.table.index_of({5, 6, 7}, 6)), "2")
    check("table.reverse", to(str)(std.table.reverse({1, 2, 3})[1]), "3")
    check("table.concat", std.table.concat({"a", "b"}, "-"), "a-b")
    check("math.floor", to(str)(std.math.floor(2.7)), "2")
    check("math.min", to(str)(std.math.min(3, 7)), "3")

    -- std.cmp — min returned `true` and max returned the SMALLER value. Third
    -- and fourth instances of the parenless-application trap, after
    -- strconv.format_bool and fmt.boolean: in `if a < b a else b end` the
    -- trailing `b a` reads as `b(a)`, so the clause called its own operand.
    check("cmp.min(3,7)", to(str)(std.cmp.min(3, 7)), "3")
    check("cmp.max(3,7)", to(str)(std.cmp.max(3, 7)), "7")
    check("cmp.min(9,2)", to(str)(std.cmp.min(9, 2)), "2")
    check("cmp.max(9,2)", to(str)(std.cmp.max(9, 2)), "9")
    check("cmp.clamp(5,1,3)", to(str)(std.cmp.clamp(5, 1, 3)), "3")

    -- std.csv / std.uuid — swept, correct, pinned as coverage.
    check("csv.parse_line[1]", to(str)(std.csv.parse_line("a,b")[1]), "a")
    check("csv.parse_line[2]", to(str)(std.csv.parse_line("a,b")[2]), "b")
    check("uuid.v4 length", to(str)(string.len(std.uuid.v4())), "36")

    -- std.inspect — hashed every input to "{}" because a line was a concat
    -- expression with no assignment.
    check("inspect.hash", std.inspect.std_inspect_hash({1, 2}), "{1=number:1,2=number:2}")
    check("inspect.to_str", std.inspect.std_inspect_to_str({7}, 0, {}), "[7]")

    -- std.xml — round-trip, not just one direction.
    check("xml.escape", std.xml.escape("a<b"), "a&lt;b")
    check("xml.unescape", std.xml.unescape("a&lt;b"), "a<b")

    -- std.wasm — constants that vanished when referenced from a nested export
    -- table. Values are from the WASM binary format spec, not from the module.
    check("wasm.SECTION.CODE", std.wasm.SECTION.CODE:to(str), "10")
    check("wasm.TYPE.I32", std.wasm.TYPE.I32:to(str), "127")
    check("wasm.TYPE.FUNC", std.wasm.TYPE.FUNC:to(str), "96")

    -- std.encoding.protobuf / std.net.ws — same nested-table defect.
    check("protobuf.WIRE.VARINT", std.encoding.protobuf.WIRE.VARINT:to(str), "0")
    check("protobuf.WIRE.FIXED32", std.encoding.protobuf.WIRE.FIXED32:to(str), "5")
    check("ws.OP.PONG", std.net.ws.OP.PONG:to(str), "10")

    -- std.math.geometry — vec2_dot of (3,4).(1,0) is 3. Arithmetic, not lookup.
    check("geometry.vec2_dot", to(str)(std.math.geometry.vec2_dot(
        std.math.geometry.vec2_new(3.0, 4.0),
        std.math.geometry.vec2_new(1.0, 0.0))), "3")

    -- std.encoding.ascii85 — ceiling of n/4 in 4-byte groups: 2*5 + 4.
    check("ascii85.max_encoded_len", to(str)(std.encoding.ascii85.max_encoded_len(8)), "14")

    -- std.timer — round-half-up.
    check("timer.round", to(str)(std.timer.std_timer_round(2.6)), "3")

    -- std.mime — the keys carry the dot.
    check("mime.type_by_extension", std.mime.type_by_extension(".txt"), "text/plain")

    -- std.utf8 — projections onto the host surface.
    check("utf8.char", std.utf8.char(65), "A")
    check("utf8.len", to(str)(std.utf8.len("abc", 1, 3)), "3")

    -- std.sync.once — fires once, then no-ops.
    check("once.new.done", to(str)(std.sync.once.new_once().done), "false")

    -- std.script — the exact exit status `run` cannot give, and the chomp that
    -- fs_tmpdir needed.
    check("script.status(true)", to(str)(std.script.status("true")), "0")
    check("script.status(exit 7)", to(str)(std.script.status("exit 7")), "7")
    check("script.chomp", std.script.chomp("x\n"), "x")
    check("script.getenv fallback", std.script.getenv("DEFINITELY_UNSET_XYZ", "fb"), "fb")

    io.write(report)
    print("stdlib_correctness: " .. fails:to(str) .. " wrong of " .. checked:to(str)
        .. " (floor " .. to(str)(baseline()) .. ")")

    if checked == 0
        print("stdlib_correctness: FAIL (empty corpus)")
        return 1
    end
    if fails > baseline()
        print("stdlib_correctness: FAIL — a stdlib function returns the wrong value")
        return 1
    end
    if fails < baseline()
        print("stdlib_correctness: rows fixed since the floor was set — LOWER baseline() to "
            .. fails:to(str))
    end
    print("stdlib_correctness: PASS")
    0
end
