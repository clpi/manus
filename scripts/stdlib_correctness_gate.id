
baseline: i64 = ()
    0

fnv_hello: i64 = ()
    s = std.hash.fnv.new32a()
    std.hash.fnv.update(s, "hello")
    std.hash.fnv.final(s)

fails = 0
checked = 0
report = ""

check = (label: str, got: str, want: str)
    checked += 1
    if got == want
        return
    fails += 1
    report = report .. "  WRONG " .. label .. ": got " .. got .. ", want " .. want .. "\n"

main: i64 = ()
    check("fmt.boolean(true)", std.fmt.boolean(true):to(str), "true")
    check("fmt.boolean(false)", std.fmt.boolean(false):to(str), "false")

    check("strconv.format_bool(true)", std.strconv.format_bool(true), "true")
    check("strconv.format_bool(false)", std.strconv.format_bool(false), "false")

    check("string.byte", "AB":byte(1):to(str), "65")
    check("string.len", "hello":len():to(str), "5")
    check("string.sub", "hello":sub(2, 3), "el")
    check("string.char", 65:char(), "A")

    check("base64.encode('h')", base64.encode("h"), "aA==")
    check("base64.encode('hi')", base64.encode("hi"), "aGk=")
    check("base64.encode('hel')", base64.encode("hel"), "aGVs")
    check("base64.encode('hello')", base64.encode("hello"), "aGVsbG8=")
    check("base64.decode('aGk=')", base64.decode("aGk="), "hi")
    check("base64.decode('aA==')", base64.decode("aA=="), "h")
    check("base64.roundtrip", base64.decode(base64.encode("hello world")), "hello world")

    check("base32.encode('h')", base32.encode("h"), "NA======")
    check("base32.encode('hi')", base32.encode("hi"), "NBUQ====")
    check("base32.encode('hello')", base32.encode("hello"), "NBSWY3DP")
    check("base32.decode('NA======')", base32.decode("NA======"), "h")
    check("base32.decode('NBUQ====')", base32.decode("NBUQ===="), "hi")
    check("base32.decode('NBSWY3DP')", base32.decode("NBSWY3DP"), "hello")
    check("base32.roundtrip", base32.decode(base32.encode("hi")), "hi")
    check("string.char len", 104:char():len():to(str), "1")
    check("string.char concat", 104:char() .. 101:char(), "he")
    check("string.rep", "x":rep(2), "xx")

    check("bit.popcount(255)", bit.popcount(255):to(str), "8")
    check("bit.clz(1)", bit.clz(1):to(str), "63")
    check("bit.bit_length(8)", bit.bit_length(8):to(str), "4")
    check("bit.rotl(1,1)", bit.rotl(1, 1):to(str), "2")
    check("fnv1a32('hello')", fnv_hello():to(str), "1335831723")

    check("crypto.hex_encode", crypto.hex_encode("hi"), "6869")
    check("crypto.hex_decode", crypto.hex_decode("6869"), "hi")
    check("json.encode", json.encode({a = 1}):to(str), "\{\"a\":1\}")
    check("script.path_basename", script.path_basename("a/b/c.id"), "c.id")
    check("script.path_stem", script.path_stem("a/b/c.id"), "c")
    check("script.path_ext", script.path_ext("a/b/c.id"), ".id")
    check("script.path_dirname", script.path_dirname("a/b/c.id"), "a/b")
    check("string.trim", "  hi  ":trim(), "hi")
    check("string.reverse", "abc":reverse(), "cba")
    check("string.count", string.count("banana", "a"):to(str), "3")
    check("string.pad_left", string.pad_left("7", 3, "0"), "007")
    check("string.repeat_str", string.repeat_str("ab", 3), "ababab")
    check("table.index_of", table.index_of({5, 6, 7}, 6):to(str), "2")
    check("table.reverse", table.reverse({1, 2, 3})[1]:to(str), "3")
    check("table.concat", table.concat({"a", "b"}, "-"), "a-b")
    check("math.floor", 2.7:floor():to(str), "2")
    check("math.min", 3:min(7):to(str), "3")

    check("cmp.min(3,7)", cmp.min(3, 7):to(str), "3")
    check("cmp.max(3,7)", cmp.max(3, 7):to(str), "7")
    check("cmp.min(9,2)", cmp.min(9, 2):to(str), "2")
    check("cmp.max(9,2)", cmp.max(9, 2):to(str), "9")
    check("cmp.clamp(5,1,3)", cmp.clamp(5, 1, 3):to(str), "3")

    check("csv.parse_line[1]", csv.parse_line("a,b")[1]:to(str), "a")
    check("csv.parse_line[2]", csv.parse_line("a,b")[2]:to(str), "b")
    check("uuid.v4 length", uuid.v4():len():to(str), "36")

    check("inspect.hash", inspect.std_inspect_hash({1, 2}), "\{1=number:1,2=number:2\}")
    check("inspect.tostring", inspect.tostring({7}, 0, {}), "[7]")

    check("xml.escape", xml.escape("a<b"), "a&lt;b")
    check("xml.unescape", xml.unescape("a&lt;b"), "a<b")

    check("wasm.SECTION.CODE", wasm.SECTION.CODE:to(str), "10")
    check("wasm.TYPE.I32", wasm.TYPE.I32:to(str), "127")
    check("wasm.TYPE.FUNC", wasm.TYPE.FUNC:to(str), "96")

    check("protobuf.WIRE.VARINT", encoding.protobuf.WIRE.VARINT:to(str), "0")
    check("protobuf.WIRE.FIXED32", encoding.protobuf.WIRE.FIXED32:to(str), "5")
    check("ws.OP.PONG", net.ws.OP.PONG:to(str), "10")

    check("geometry.vec2_dot", math.geometry.vec2_dot(
        math.geometry.vec2_new(3.0, 4.0),
        math.geometry.vec2_new(1.0, 0.0)):to(str), "3")

    check("ascii85.max_encoded_len", encoding.ascii85.max_encoded_len(8):to(str), "14")

    check("timer.round", timer.std_timer_round(2.6):to(str), "3")

    check("mime.type_by_extension", mime.type_by_extension(".txt"), "text/plain")

    check("utf8.char", utf8.char(65), "A")
    check("utf8.len", utf8.len("abc", 1, 3):to(str), "3")

    check("once.new.done", sync.once.new_once().done:to(str), "false")

    check("script.status(true)", script.status("true"):to(str), "0")
    check("script.status(exit 7)", script.status("exit 7"):to(str), "7")
    check("script.chomp", script.chomp("x\n"), "x")
    check("script.getenv fallback", script.getenv("DEFINITELY_UNSET_XYZ", "fb"), "fb")

    stdout:write(report)
    print("stdlib_correctness: " .. fails:to(str) .. " wrong of " .. checked:to(str)
        .. " (floor " .. baseline():to(str) .. ")")

    if checked == 0
        print("stdlib_correctness: FAIL (empty corpus)")
        return 1
    if fails > baseline()
        print("stdlib_correctness: FAIL — a stdlib function returns the wrong value")
        return 1
    if fails < baseline()
        print("stdlib_correctness: rows fixed since the floor was set — LOWER baseline() to "
            .. fails:to(str))
    print("stdlib_correctness: PASS")
    0
