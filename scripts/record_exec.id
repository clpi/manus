# SH-10 — the record owner proven BY EXECUTION, not by inspection.
#
# `scripts/proof/record.id` checks the emitted TEXT. That catches a missing designator
# or an unclosed paren, and it cannot catch the thing that actually matters:
# whether `((duo_point){.x = 3.0, .y = 4.0})` puts 3 in the field named x.
#
# `(duo_point){ .x = 3, .y = 4 }` and `(duo_point){ 3, 4 }` are both
# plausible-looking text and both compile. Only running them says which one is
# right, and whether the two agree. That is the standard `emit_c.id` set for
# itself — "the emitted C is COMPILED AND RUN, and its answer must equal what
# the folder computes" — and a backend proven by reading is a backend proven by
# the person least able to see its bugs.
#
# WHAT THIS PROVES END TO END. The descriptor edge of `apply` (law.apply.one)
# emits C that a C compiler accepts and that answers correctly. That is rung
# (a) of the constructor ladder working, in idol, for the first time — the form
# gap[088] measured as not lowering.
#
# Exit 0 pass · 1 an answer was wrong · 3 the harness could not run.

rec = record

q = "'"

# Build a complete C program around one emitted application and run it. The
# program prints the field the caller asks about, so a literal that fills the
# WRONG field is caught rather than merely one that fails to compile.
chomp: str = (s: str)
  n: i64 = s:len()
  while n > 0 and (s:byte(n) == 10 or s:byte(n) == 13 or s:byte(n) == 32)
    n = n - 1
  s:sub(1, n)

runs: str = (decl: str, apply: str, read: str)
  src = "#include <stdio.h>\ntypedef struct { double x; double y; } duo_point;\nint main(void){ duo_point p = {apply}; printf(\"%g\\n\", p.{read}); return 0; }\n"
  src = "#include <stdio.h>\ntypedef struct { double x; double y; } duo_point;\nint main(void){ duo_point p = " .. apply .. "; printf(\"%g\\n\", p." .. read .. "); return 0; }\n"
  path: str = "/tmp/duorecexec.c"
  bin: str = "/tmp/duorecexec.bin"
  fs.write_file(path, src)
  # `cc` alone finds no `stdio.h` in this environment: there is no default
  # sysroot, and the failure is a COMPILE error rather than a wrong answer,
  # so it reads as "the emitted C is broken" when the emitted C is fine.
  # Measured, and the sysroot is what the compiler itself passes.
  sdk: str = chomp(proc.capture("xcrun --show-sdk-path 2>/dev/null"))
  cmd: str = "clang -isysroot {sdk} -O0 -o {bin} {path} 2>/dev/null && {bin}"
  proc.capture(cmd)

# `s:trim()` RETURNS NIL SILENTLY — measured 2026-08-09. It is not a method
# idol has, and a missing method resolves to nil rather than diagnosing, which
# is the `string.byte` failure class over again. `chomp` above is written
# out rather than reached for; `script` is not an option.

fail = 0

check = (what: str, got: str, want: str)
  g: str = chomp(got)
  if g == want
    print("  ok   {what} -> {g}")
  else
    print("  FAIL {what} -> {g}, wanted {want}")
    fail = fail + 1

main: i64 = ()
  print("")
  print("  the descriptor edge of apply, COMPILED AND RUN")
  print("")

  # CONTROL FIRST. If the harness cannot make a wrong answer appear, every
  # row below is decoration. A literal that fills only `.y` must NOT report 3
  # when asked for `.x`.
  bad: str = runs("", "((duo_point){.y = 3.0})", "x")
  # NIL FIRST. The original control checked `== ""` and a nil return sailed
  # past it, so four rows reported `nil` while the control said the harness
  # was fine. A control that cannot see the actual failure mode is decoration.
  if bad == nil
    print("CONTROL FAILED: the harness returned nil — it cannot run C")
    os.exit(3)
  if chomp(bad) == ""
    print("CONTROL FAILED: the harness produced no output")
    os.exit(3)
  if chomp(bad) == "3"
    print("CONTROL FAILED: a literal filling .y reported 3 for .x")
    os.exit(3)

  # The named pack — rung (a) with designators.
  named: str = rec.applynamed("point", ".x = 3.0, .y = 4.0")
  check("apply named, read x", runs("", named, "x"), "3")
  check("apply named, read y", runs("", named, "y"), "4")

  # The positional pack — spec §15.1's `point{ 3, 4 }`. This is the row that
  # proves declaration ORDER is the correspondence positional construction
  # rests on: if C filled these in any other order, x would not be 3.
  pos: str = rec.applypositional("point", "3.0, 4.0")
  check("apply positional, read x", runs("", pos, "x"), "3")
  check("apply positional, read y", runs("", pos, "y"), "4")

  # THE AGREEMENT ROW, and it is the point of having two faces: the named and
  # positional packs describe the SAME value, so they must answer the same.
  # A backend where they disagree has two constructors, which law.apply.one
  # denies.
  # The agreement row must not pass on two nils. It did, on the first run of
  # this file: both faces returned nil, nil == nil, and the row printed ok
  # beside four failures. Agreement between two absent answers is not
  # agreement.
  an: str = chomp(runs("", named, "x"))
  ap: str = chomp(runs("", pos, "x"))
  if an == "3" and ap == "3"
    print("  ok   named and positional agree at 3 (law.apply.one)")
  else
    print("  FAIL named and positional disagree — two constructors, not one")
    fail = fail + 1

  print("")
  if fail > 0
    print("record exec: FAIL — {fail} row(s) answered wrong")
    std.os.exit(1)
  print("record exec: PASS — rung (a) emits C that compiles and answers")
  0
