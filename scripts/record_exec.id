
rec = record

q = "'"

chomp: str = (s: str)
  n: i64 = s:len()
  while n > 0 and (s:byte(n) == 10 or s:byte(n) == 13 or s:byte(n) == 32)
    n = n - 1
  s:sub(1, n)

runs: str = (decl: str, apply: str, read: str)
  src = "#include <stdio.h>\ntypedef struct { double x; double y; } duo_point;\nint main(void){ duo_point p = {apply}; printf(\"%g\\n\", p.{read}); return 0; }\n"
  src = "#include <stdio.h>\ntypedef struct { double x; double y; } duo_point;\nint main(void){ duo_point p = " .. apply .. "; printf(\"%g\\n\", p." .. read .. "); return 0; }\n"
  path: str = "/tmp/duorecexec.c"
  bin: str = "/tmp/duorecexec.bin"
  fs.write_file(path, src)
  sdk: str = chomp(proc.capture("xcrun --show-sdk-path 2>/dev/null"))
  cmd: str = "clang -isysroot {sdk} -O0 -o {bin} {path} 2>/dev/null && {bin}"
  proc.capture(cmd)


fail = 0

check = (what: str, got: str, want: str)
  g: str = chomp(got)
  if g == want
    print("  ok   {what} -> {g}")
  else
    print("  FAIL {what} -> {g}, wanted {want}")
    fail = fail + 1

main: i64 = ()
  print("")
  print("  the descriptor edge of apply, COMPILED AND RUN")
  print("")

  bad: str = runs("", "((duo_point){.y = 3.0})", "x")
  if bad == nil
    print("CONTROL FAILED: the harness returned nil — it cannot run C")
    os.exit(3)
  if chomp(bad) == ""
    print("CONTROL FAILED: the harness produced no output")
    os.exit(3)
  if chomp(bad) == "3"
    print("CONTROL FAILED: a literal filling .y reported 3 for .x")
    os.exit(3)

  named: str = rec.applynamed("point", ".x = 3.0, .y = 4.0")
  check("apply named, read x", runs("", named, "x"), "3")
  check("apply named, read y", runs("", named, "y"), "4")

  pos: str = rec.applypositional("point", "3.0, 4.0")
  check("apply positional, read x", runs("", pos, "x"), "3")
  check("apply positional, read y", runs("", pos, "y"), "4")

  an: str = chomp(runs("", named, "x"))
  ap: str = chomp(runs("", pos, "x"))
  if an == "3" and ap == "3"
    print("  ok   named and positional agree at 3 (law.apply.one)")
  else
    print("  FAIL named and positional disagree — two constructors, not one")
    fail = fail + 1

  print("")
  if fail > 0
    print("record exec: FAIL — {fail} row(s) answered wrong")
    os.exit(1)
  print("record exec: PASS — rung (a) emits C that compiles and answers")
  0
