# assert_no_ansi_reports.id — verify ANSI escape handling in test reporter output.
# Replaces scripts/assert_no_ansi_reports.sh
# Run: idol run scripts/assert_no_ansi_reports.id

duo: str = ()
  bin = gatecap("sh -c 'if [ -n \"$DUO\" ]; then printf %s \"$DUO\"; else printf %s ./zig-out/bin/idol; fi'")
  "env DUO_BUILD_REPORT=plain {bin}"

temp_file: str = ()
  gatecap("sh -c 'printf /tmp/duo_ansi_test_$$'")

fail = (msg: str)
  print(msg)
  os.exit(1)

# assert_escape_free: fail if ESC bytes appear in the captured output file
assert_escape_free_file = (label: str, tmpfile: str)
  found = os.execute("LC_ALL=C grep -q $'\\033' '{tmpfile}' 2>/dev/null")
  if found == 0
    fail("ANSI escape sequence leaked in {label}")
  print("ok no-ansi {label}")

# assert_has_escape: fail if ESC bytes do NOT appear in the captured output file
assert_has_escape_file = (label: str, tmpfile: str)
  found = os.execute("LC_ALL=C grep -q $'\\033' '{tmpfile}' 2>/dev/null")
  if found != 0
    fail("ANSI styling missing in {label}")
  print("ok ansi {label}")

check_flag_report = (style: str)
  tmp = temp_file()
  tool = duo()
  cmd = "{tool} test examples/directives_test.id --no-color --test-report {style} >{tmp} 2>&1"
  os.execute(cmd)
  assert_escape_free_file("--no-color {style}", tmp)
  os.remove(tmp)

check_env_report = (style: str)
  tmp = temp_file()
  tool = duo()
  cmd = "NO_COLOR=1 {tool} test examples/directives_test.id --test-report {style} >{tmp} 2>&1"
  os.execute(cmd)
  assert_escape_free_file("NO_COLOR=1 {style}", tmp)
  os.remove(tmp)

check_forced_color_report = (style: str)
  tmp = temp_file()
  tool = duo()
  cmd = "DUO_COLOR=1 {tool} test examples/directives_test.id --test-report {style} >{tmp} 2>&1"
  os.execute(cmd)
  assert_has_escape_file("DUO_COLOR=1 {style}", tmp)
  os.remove(tmp)

check_json_report = ()
  tmp = temp_file()
  tool = duo()
  cmd = "DUO_COLOR=1 {tool} test examples/directives_test.id --test-report json >{tmp} 2>&1"
  os.execute(cmd)
  assert_escape_free_file("DUO_COLOR=1 json", tmp)
  print("ok json DUO_COLOR=1 json")
  os.remove(tmp)

check_flag_report("pretty")
check_env_report("pretty")
check_forced_color_report("pretty")
check_flag_report("compact")
check_env_report("compact")
check_forced_color_report("compact")
check_flag_report("verbose")
check_env_report("verbose")
check_forced_color_report("verbose")
check_json_report()
