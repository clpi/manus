-- P0 proof matrix — Duo-native; self-contained (std.script only; avoids std.proof module init bugs).
s = req "std.script"
os = req "std.os"

sha256(data: str): str
    tmp = string.gsub(s.fs_tmp(), "\n", "")
    s.fs_write(tmp, data)
    cap = s.capture("shasum -a 256 '" .. tmp .. "' 2>/dev/null")
    s.fs_rm(tmp)
    matched = string.match(cap, "(%x+)")
    if matched == nil
        return ""
    end
    matched
end

result_hash(output: str): str
    rows = {}
    for line in string.gmatch(output, "[^\n]+")
        rid, val = string.match(line, "^RESULT%s+(%S+)%s+(.*)$")
        if rid != nil
            rows[rawlen(rows) + 1] = rid .. " " .. val
        end
    end
    table.sort(rows)
    sha256(table.concat(rows, "\n"))
end

count_results(output: str): i64
    n = 0
    for line in string.gmatch(output, "[^\n]+")
        if string.match(line, "^RESULT%s+") != nil
            n += 1
        end
    end
    n
end

proof_field_int(text: str, key: str): i64
    _, _, val = string.find(text, '"' .. key .. '":(%d+)')
    if val == nil
        return 0
    end
    tonumber(val)
end

proof_field_str(text: str, key: str): str
    _, _, val = string.find(text, '"' .. key .. '":"([^"]+)"')
    if val == nil
        return ""
    end
    val
end

load_emission(path: str): any
    text = s.fs_read(path)
    out = {
        boxes = proof_field_int(text, "boxes"),
        unboxes = proof_field_int(text, "unboxes"),
        generic_table_ops = proof_field_int(text, "generic_table_ops"),
        evidence_class = proof_field_str(text, "evidence_class"),
    }
    out
end

artifact_path(stem: str, prefer_native: bool): str
    native = "/tmp/duo_" .. stem .. "_native.o.proof.json"
    cpath = "/tmp/duo_" .. stem .. ".c.proof.json"
    if prefer_native and s.fs_exists(native)
        return native
    end
    cpath
end

run_capture(bin: str): str
    r = s.exec("'" .. bin .. "'")
    if r.code != 0
        s.echo("run failed: " .. bin)
        os.exit(1)
    end
    r.output
end

compile_one(duo: str, work: str, profile: str, main_src: str, native_src: str): str
    src = main_src
    if profile == "direct"
        src = native_src
    end
    out = work .. "/bench_" .. profile .. ".out"
    s.env_set("BENCH_BACKEND", profile)
    s.env_set("DUO_BENCH_MANIFEST", "backend=" .. profile .. " representation=profile-selected runtime=dynamic")
    cmd = duo .. " compile --bench-backend " .. profile .. " -O3 '" .. src .. "' -o '" .. out .. "' >/dev/null"
    if not s.ok(cmd)
        s.echo("compile failed: " .. profile)
        os.exit(1)
    end
    out
end

proof_copy(work: str, profile: str, main_stem: str, native_stem: str): str
    stem = main_stem
    if profile == "direct"
        stem = native_stem
    end
    src = artifact_path(stem, profile == "direct")
    if not s.fs_exists(src)
        s.echo("missing proof artifact: " .. src)
        os.exit(1)
    end
    dst = work .. "/bench_" .. profile .. ".proof.json"
    s.fs_cp(src, dst)
    dst
end

s.env_set("DUO_EMIT_PROOF", "1")
ROOT = string.gsub(s.capture("git rev-parse --show-toplevel 2>/dev/null"), "\n", "")
DUO = s.getenv("DUO", ROOT .. "/zig-out/bin/duo")
CC = s.getenv("CC", "clang")
MAIN_SRC = s.getenv("BENCH_PROOF_SOURCE", "examples/pass27_proof_matrix.id")
NATIVE_SRC = s.getenv("BENCH_PROOF_DIRECT_SOURCE", "examples/pass27_proof_matrix_direct.id")
C_SRC = s.getenv("BENCH_PROOF_C_SOURCE", "examples/pass27_proof_matrix_c.c")
WORK = s.getenv("BENCH_PROOF_DIR", "")
CLEAN = 0
if WORK == ""
    WORK = string.gsub(s.fs_tmpdir(), "\n", "")
    CLEAN = 1
end
MAIN_STEM = s.path_stem(MAIN_SRC)
NATIVE_STEM = s.path_stem(NATIVE_SRC)

if not s.fs_exists(DUO)
    s.must("cd '" .. ROOT .. "' && zig build")
end
s.must("cd '" .. ROOT .. "'")

SDK = s.getenv("SDKROOT", string.gsub(s.capture("xcrun --sdk macosx --show-sdk-path 2>/dev/null || true"), "\n", ""))
CFLAGS = "-O3 -ffast-math -march=native -flto -lm"
if SDK != ""
    CFLAGS = CFLAGS .. " -isysroot " .. SDK
end

s.echo("=== Pass 27 benchmark proof matrix (Duo-native) ===")
s.echo("source: " .. MAIN_SRC)
s.echo("direct: " .. NATIVE_SRC)
s.echo("work:   " .. WORK)

cref = WORK .. "/c_ref.out"
s.must(CC .. " " .. CFLAGS .. " -o '" .. cref .. "' '" .. C_SRC .. "'")
C_HASH = result_hash(run_capture(cref))
s.echo("correctness_hash(c_ref)=" .. C_HASH)

canonical = ""
canon_profile = ""
fail = 0
profiles = {
    { id = "c-dynamic", native = 0, expect = 10 },
    { id = "c-specialized", native = 0, expect = 10 },
    { id = "direct", native = 1, expect = 0 },
}

for i = 1, rawlen(profiles)
    prof = profiles[i]
    pid = prof.id
    s.echo("--- Profile: " .. pid .. " ---")
    bin = compile_one(DUO, WORK, pid, MAIN_SRC, NATIVE_SRC)
    proof = proof_copy(WORK, pid, MAIN_STEM, NATIVE_STEM)
    em = load_emission(proof)
    hash = ""

    if prof.native != 0
        if not s.ok("'" .. bin .. "' >/dev/null 2>&1")
            s.echo("FAIL: direct native exit non-zero")
            fail = 1
        else
            s.echo("OK direct native binary exit 0")
        end
        hash = sha256(s.fs_read(proof))
        if em.evidence_class != "direct-native-subset"
            s.echo("FAIL: direct profile must emit direct-native-subset")
            fail = 1
        end
        if em.boxes != 0
            s.echo("FAIL: direct profile must have zero boxes")
            fail = 1
        end
    else
        out = run_capture(bin)
        rc = count_results(out)
        hash = result_hash(out)
        if rc != prof.expect
            s.echo("FAIL: " .. pid .. " emitted " .. tostring(rc) .. " RESULT lines")
            fail = 1
        end
        if canonical == ""
            canonical = hash
            canon_profile = pid
        else
            if hash != canonical
                s.echo("FAIL: semantics mismatch vs " .. canon_profile)
                fail = 1
            else
                s.echo("OK cross-profile semantics match " .. canon_profile)
            end
        end
    end
    s.echo("emission boxes=" .. tostring(em.boxes) .. " class=" .. em.evidence_class)
    s.echo("correctness_hash=" .. hash)
end

summary = WORK .. "/proof_matrix_summary.json"
s.fs_write(summary, "{\"schema\":\"pass27-proof-matrix-v0\",\"canonical_hash\":\"" .. canonical .. "\"}")

if fail != 0
    if CLEAN != 0
        s.fs_rm(WORK)
    end
    os.exit(1)
end

s.echo("PASS: canonical " .. canonical .. "; summary " .. summary)
if CLEAN != 0
    s.fs_rm(WORK)
end
