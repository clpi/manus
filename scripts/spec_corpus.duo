-- Pass 100 §20 — the golden corpus, run.
--
-- §19 lists `blocks-passing/blocks-total` as a tracked metric and §22 calls it
-- "the project's first honest number". Nothing computed it. This does.
--
-- WHY THIS IS THE LEADING MEASURE. `audit100` counts deny lines over the
-- canonical corpus — around 30k — and that number is real but LAGGING: it
-- measures how much old code still spells things the old way. The leading
-- measure is whether the NEW spelling exists at all, and §20 is where the spec
-- says it does. §3 tells agents to pattern-match only from those five blocks,
-- so every block that does not compile is an instruction to write source the
-- compiler rejects.
--
-- TWO NUMBERS, answering different questions:
--
--   blocks     §20's five golden files, checked. This is the metric §19
--              names. It moves rarely and in big steps, because a block needs
--              EVERY construct in it. Split verbatim/joined in the report —
--              see the note above `work` for what a block is checked against
--              and why that is not the same as making it pass.
--   forms      one fixture per §20 construct, each printing a value the
--              fixture itself declares. This is the number that moves while a
--              block is still red, and it is where a regression surfaces
--              first.
--
-- THE BLOCKS ARE EXTRACTED FROM THE SPEC ON EVERY RUN, never kept as tracked
-- copies. A tracked copy is a second source of truth that drifts, and the
-- drift is invisible precisely because both files look canonical. Extraction
-- also makes the §22 lesson structural: this reads the spec and writes only
-- into its own work directory, so it cannot rewrite what it measures the way
-- the first capability table rewrote 68 fixtures with `duo fmt`.
--
-- VERIFY BY VALUE. A form fixture is not passing because it compiled — it
-- passes when its stdout equals the `-- expect:` line it carries. The guard
-- chain fixture is why: `while b = pull() and small(b)` COMPILES whether `b`
-- binds `pull()` or the whole conjunction, and only the printed total tells
-- the two apart.
--
-- RATCHET, not pass/fail of the spec. The spec is allowed to run ahead of the
-- compiler; what is not allowed is a number going down. Raise a floor when a
-- row goes green; never lower one to quiet the gate.

-- A BLOCK IS A FILE IN A PROJECT, not a standalone program. §20 heads every
-- block with a PATH — `shc/lex.duo`, `shc/parse.duo` — and those two are one
-- module: `parse.duo` cites `lexer` and `token` because `lex.duo` declares
-- them. So a block is checked against the blocks that share its path prefix,
-- and then against `stubs/corpus.duo` for the three names no §20 block
-- declares at all (§19: "stubs are `todo(gap[nn])` or bodiless declarations").
--
-- The two facts stay SEPARATE in the report, because one number for both
-- cannot tell you which one moved:
--
--   verbatim   the block checks clean exactly as §20 writes it
--   joined     it checks clean once its module and the descent stubs are
--              present — i.e. every CONSTRUCT in it is admitted and what was
--              missing was declarations, which is a corpus property
--
-- The prelude is the one part of this gate that can turn a row green with no
-- compiler change, so it is answerable to `stubs/control.duo`: a fragment
-- citing a name the prelude does not carry must still FAIL, and if it stops
-- failing this gate reports FAIL and no verdict.
work = "/tmp/duo-spec-corpus"
spec = "docs/spec/pass100.md"
fixtures = "examples/spec100"
stubs = "examples/spec100/stubs/corpus.duo"
control = "examples/spec100/stubs/control.duo"

-- MEASURED floors, never estimated. `scripts/spec_conformance.duo` records
-- what happens otherwise: a floor written from memory reported a regression
-- that had not happened. Run the gate, read the number, pin the number.
--
-- 11 -> 12: `anchormove`, §2's postfix anchor `X@rel`. Raised because the row
-- went green, which is the only reason a floor may move.
-- 12 -> 16: `ternary`, `walk`, `loopbody`, `anchorbare` — the four constructs
-- `shc/lex.duo` was waiting on.
-- blocks 2 -> 5: `shc/lex.duo` and `shc/parse.duo` join their module and the
-- §19 descent stubs; `tool/wordcount.duo` gets its shebang onto line 1.
-- 17 -> 18: `convert`, Pass 121 §9's conversion edge at the receiver. It went
-- green because `str -> i64` started building at all — gaps/GAP-081.md found
-- it failing in BOTH faces on a typed `str`, which is why the tree is written
-- 1647:1 in the noncanonical orientation and why the census was never only
-- about taste. The fixture asserts 2^53 + 1 for the reason all of these carry
-- a value: a conversion detouring through a double answers 9007199254740992
-- and reads as correct.
blockfloor = 5
formfloor = 18

fence = "^```"

blockrows = ""
blocktotal = 0
blockpass = 0
blockbare = 0
blockjoin = 0

formrows = ""
formtotal = 0
formpass = 0

-- 1 while the descent stubs still let a citation of an undeclared name fail.
controlok = 0

-- Printed with the verdict so the prelude cannot grow quietly: a stub file
-- that doubles in size between two runs is visible in the report itself.
stublines = 0

quiet(cmd: str): i64
    std.script.status("{cmd} >/dev/null 2>&1")
end

-- The i-th line of a file, as a number. Lists travel between the shell and
-- here as FILES rather than through a string split, so no row of this gate
-- depends on a splitter's behaviour at the end of its input.
nth(path: str, i: i64): i64
    v = 0
    line = std.script.chomp(std.script.capture("sed -n '{i}p' {path}"))
    if line != ""
        v = to(i64)(line)
    end
    v
end

count(path: str): i64
    to(i64)(std.script.chomp(std.script.capture("wc -l < {path}")))
end

-- The absolute line number of the first line matching a pattern, or 0.
-- `grep -c` exits 1 on a zero count and a helper that swallowed that would
-- read backwards, so this pipes through `head`/`cut`, both of which always
-- exit 0 and always print.
--
-- Written as assign-then-fall-through rather than as an if/else TAIL, for the
-- reason spelled out over `diagnostic`.
at(pattern: str): i64
    n = 0
    hit = std.script.chomp(std.script.capture(
        "grep -n '{pattern}' {spec} | head -1 | cut -d: -f1"))
    if hit != ""
        n = to(i64)(hit)
    end
    n
end

-- A block's name is its `-- path/name.duo` header; that is the name §20 gives
-- it and the only name it has. It is line 1 for every block except the one
-- that must give line 1 to a shebang — a shebang is only a shebang on line 1,
-- which is a property of every POSIX kernel and not of Duo — so the first TWO
-- lines are searched and nothing deeper, or an inner comment in a headerless
-- block would name it.
label(path: str): str
    std.script.chomp(std.script.capture("sed -n '1,2p' {path} | grep -m1 '^-- ' | head -1"))
end

-- The MODULE a block belongs to: the first path element of its header. Two
-- blocks with the same one are two files of one project and are checked
-- together, in the order §20 writes them.
home(path: str): str
    std.script.chomp(std.script.capture(
        "sed -n '1,2p' {path} | grep -m1 '^-- ' | head -1 | cut -c4- | cut -d/ -f1"))
end

stem(path: str): str
    std.script.chomp(std.script.capture("basename {path} .duo"))
end

-- The exact diagnostic, not a summary. An audit that says "fails" teaches
-- nothing; the construct named in the message is the ordered work list.
--
-- NOT an if/else tail. A `str` function whose final expression is an if/else
-- over a local captured from a subprocess reads the comparison WRONG: this
-- body, with the fallback in the then-arm, returned the fallback while the
-- local demonstrably held the diagnostic. It is not this session's bug — it
-- reproduces on the compiler built from HEAD with every change here stashed.
-- Filed as a gap; worked around here because a measurement that silently
-- reports "nothing" is the exact failure this whole gate exists to prevent.
diagnostic(duo: str, path: str): str
    line = std.script.chomp(std.script.capture(
        "{duo} check {path} 2>&1 | grep -m1 'error:' | head -1"))
    if line == ""
        line = "no diagnostic captured"
    end
    line
end

-- VERBATIM FIRST, JOINED SECOND, and the diagnostic always comes from the
-- VERBATIM block: a line number that names the composed file would send a
-- reader to a line §20 never wrote.
block(duo: str, index: i64, first: i64, last: i64): void
    path = "{work}/block{index}.duo"
    std.script.run("sed -n '{first},{last}p' {spec} > {path}")
    blocktotal = blocktotal + 1
    name = label(path)
    if name == ""
        name = "block {index}"
    end
    mod = home(path)
    if mod == ""
        mod = "solo{index}"
    end
    -- The module accumulator holds the blocks of this project already seen.
    -- Empty for the first block of every module, so a one-file module is
    -- checked against the stubs and nothing else.
    kit = "{work}/kit-{mod}.duo"
    join = "{work}/join{index}.duo"
    std.script.run("touch {kit} && cat {stubs} {kit} {path} > {join}")
    if quiet("{duo} check {path}") == 0
        blockpass = blockpass + 1
        blockbare = blockbare + 1
        blockrows = "{blockrows}  pass  {name}\n"
    else
        if quiet("{duo} check {join}") == 0
            blockpass = blockpass + 1
            blockjoin = blockjoin + 1
            blockrows = "{blockrows}  pass  {name}\n        with module '{mod}' and the §19 descent stubs\n"
        else
            note = diagnostic(duo, path)
            blockrows = "{blockrows}  FAIL  {name}\n        {note}\n"
        end
    end
    std.script.run("cat {path} >> {kit}")
end

-- One construct fixture: compile it, RUN it, compare stdout against the value
-- the fixture declares. The three ways to be wrong stay separate on purpose —
-- a fixture with no declared value proves nothing and must not read as a pass.
form(duo: str, path: str): void
    formtotal = formtotal + 1
    name = stem(path)
    want = std.script.chomp(std.script.capture(
        "sed -n 's/^-- expect: *//p' {path} | head -1"))
    bin = "{work}/{name}.out"
    if want == ""
        formrows = "{formrows}  FAIL  {name}  carries no '-- expect:' line\n"
    else
        if quiet("{duo} compile {path} --emit exe -o {bin}") != 0
            note = diagnostic(duo, path)
            formrows = "{formrows}  FAIL  {name}  {note}\n"
        else
            got = std.script.chomp(std.script.capture(bin))
            if got == want
                formpass = formpass + 1
                formrows = "{formrows}  pass  {name}  {got}\n"
            else
                formrows = "{formrows}  FAIL  {name}  want '{want}' got '{got}'\n"
            end
        end
    end
end

-- The prelude's own control, run the way a block is run: prepend it to a
-- fragment citing a name it does NOT carry and require the check to fail. A
-- prelude that makes everything pass measures nothing, and a gate that cannot
-- fail is the exact §22 defect this file was written against.
controls(duo: str): i64
    ok = 1
    probe = "{work}/control.duo"
    std.script.run("cat {stubs} {control} > {probe}")
    if quiet("{duo} check {probe}") == 0
        ok = 0
    end
    ok
end

-- POSITIVE CONTROLS FIRST, verdict second. Every gate in this repository that
-- reported a confident zero did it by measuring nothing and saying so in the
-- language of a pass, so the empties and the discriminating control are all
-- checked before either floor is.
verdict(): i64
    code = 0
    if blocktotal == 0
        print("spec corpus: FAIL — no §20 blocks extracted; the extractor is broken")
        code = 1
    end
    if code == 0 and formtotal == 0
        print("spec corpus: FAIL — no construct fixtures found in {fixtures}")
        code = 1
    end
    if code == 0 and controlok == 0
        print("spec corpus: FAIL — the descent stubs stopped discriminating:")
        print("  {control} CHECKED CLEAN with {stubs} prepended, so a block")
        print("  that passes 'joined' proves nothing. Read the prelude before")
        print("  believing any row above.")
        code = 1
    end
    if code == 0 and blockpass < blockfloor
        print("spec corpus: FAIL — golden blocks regressed below the floor")
        code = 1
    end
    if code == 0 and formpass < formfloor
        print("spec corpus: FAIL — construct fixtures regressed below the floor")
        code = 1
    end
    if code == 0
        print("spec corpus: PASS")
    end
    code
end

report(): void
    print("")
    print("  Pass 100 §20 — GOLDEN CORPUS (extracted from {spec})")
    print("")
    io.write(blockrows)
    print("")
    print("  Pass 100 §20 — CONSTRUCT FIXTURES ({fixtures})")
    print("")
    io.write(formrows)
    print("")
    print("  blocks  {blockpass}/{blocktotal}   floor {blockfloor}")
    print("          {blockbare} verbatim, {blockjoin} with module + §19 descent stubs ({stublines} stub lines)")
    print("  forms   {formpass}/{formtotal}   floor {formfloor}")
    print("")
end

-- Extraction, then the fixtures, then the report. Split out of `main` so the
-- setup failures stay one flat ladder rather than a nest.
measure(duo: str): i64
    std.script.run("rm -rf {work} && mkdir -p {work}")
    code = 0

    first = at("^## 20")
    stop = at("^## 21")
    if first == 0 or stop == 0 or stop <= first
        print("spec corpus: FAIL — §20 not located in {spec}")
        code = 1
    end

    if code == 0
        controlok = controls(duo)
        stublines = count(stubs)
    end

    if code == 0
        -- Fence line numbers are read RELATIVE to the §20 slice and shifted
        -- back, which is why no filtering pass is needed and no fence from
        -- §19 or §21 can leak in.
        marks = "{work}/fences"
        std.script.run(
            "sed -n '{first},{stop}p' {spec} | grep -n '{fence}' | cut -d: -f1 > {marks}")
        n = 0
        k = 1
        while k + 1 <= count(marks)
            open = nth(marks, k) + first
            shut = nth(marks, k + 1) + first - 2
            n = n + 1
            block(duo, n, open, shut)
            k = k + 2
        end

        list = "{work}/fixtures"
        std.script.run("ls {fixtures}/*.duo > {list} 2>/dev/null")
        j = 1
        while j <= count(list)
            path = std.script.chomp(std.script.capture("sed -n '{j}p' {list}"))
            form(duo, path)
            j = j + 1
        end

        report()
        code = verdict()
    end
    code
end

main = (): i64
    duo = std.script.getenv("DUO", "./zig-out/bin/duo")
    code = 0
    if quiet("test -x {duo}") != 0
        print("spec corpus: FAIL — no compiler at {duo}")
        code = 1
    end
    if code == 0 and quiet("test -f {spec}") != 0
        print("spec corpus: FAIL — no spec at {spec}")
        code = 1
    end
    if code == 0
        code = measure(duo)
    end
    code
end
