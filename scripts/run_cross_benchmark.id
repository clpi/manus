
_BENCHES = 21
_RUNS = 3
_OUT = "/tmp/duo_cross_bench"

_names = {
  "Prime sieve",
  "Mandelbrot",
  "Grid matrix",
  "N-body",
  "String bytes",
  "Trig sum",
  "String chain",
  "String hash",
  "Math floor/max",
  "Table max",
  "Pow/sqrt",
  "Binary search",
  "Filter count",
  "Dot product",
  "Clamp sum",
  "Bucket hash",
  "EMA smooth",
  "Token count",
  "Config parse",
  "Table lookup",
  "Table churn"
}

_fail = 0

_env_or: str = (n: str, d: str)
  v = script.getenv_or(n)
  if v == ""
    return d
  v

_pad: str = (s: str, w: i64)
  out = s
  while out:len() < w
    out = out .. " "
  out

_lpad: str = (s: str, w: i64)
  out = s
  while out:len() < w
    out = " " .. out
  out

_f6: str = (x: f64)
  n = to(i64)(x * 1000000.0 + 0.5)
  whole = n / 1000000
  frac = n % 1000000
  fs = frac:to(str)
  while fs:len() < 6
    fs = "0" .. fs
  whole:to(str) .. "." .. fs

_numeric: bool = (s: str)
  if s == ""
    return false
  seen_digit = false
  i = 1
  while i <= s:len()
    c = s:sub(i, i)
    if c >= "0" and c <= "9"
      seen_digit = true
    else
      if c != "." and c != "-" and c != "+" and c != "e" and c != "E"
        return false
    i = i + 1
  seen_digit

_lines: any = (text: str)
  out = {}
  for _i, l in text:split("\n")
    t = std.script.chomp(l)
    if t != ""
      out(out:len() + 1) = t
  out

_results: any = (text: str)
  r = {}
  for _i, l in _lines(text)
    if l:sub(1, 7) == "RESULT "
      parts = l:split(" ")
      if parts:len() >= 3
        r(parts(2)) = parts(3)
  r

_times: any = (text: str)
  ts = {}
  for _i, l in _lines(text)
    if l:find("Time", 1, true) != nil
      for _j, w in l:gsub("\t", " "):split(" ")
        if ts:len() < _BENCHES and _numeric(w)
          ts(ts:len() + 1) = to(f64)(w)
          break
  ts

_min_times: any = (cmd: str)
  best = {}
  r = 0
  while r < _RUNS
    ts = _times(std.script.capture(cmd .. " 2>/dev/null"))
    i = 1
    while i <= ts:len()
      if best(i) == nil or ts(i) < best(i)
        best(i) = ts(i)
      i = i + 1
    r = r + 1
  best

_is_int: bool = (s: str)
  v = to(f64)(s)
  if v == nil
    return false
  to(f64)(to(i64)(v)) == v

_compare_strict = (ref: any, got: any)
  bad = 0
  for k, a in ref
    b = got(k)
    if b != nil
      if _is_int(a) and _is_int(b)
        if a != b
          print("    MISMATCH " .. k .. ":" .. a .. " vs" .. b)
          bad = bad + 1
      else
        d = to(f64)(a) - to(f64)(b)
        if d < 0.0
          d = -d
        if d > 0.0001
          print("    FLOAT DIFF " .. k .. ":" .. a .. " vs" .. b)
          bad = bad + 1
  if bad == 0
    print("    PASS")
  else
    _fail = 1

_compare_loose = (label: str, ref: any, got: any)
  print("  C vs " .. label .. ":")
  bad = 0
  for k, a in ref
    b = got(k)
    if b != nil and _is_int(a) and _is_int(b) and a != b
      print("    MISMATCH " .. k .. ":" .. a .. " vs" .. b)
      bad = bad + 1
  if bad == 0
    print("    PASS")

main: i64 = ()
  duo = "./zig-out/bin/idol"
  cc = _env_or("CC", "clang")
  lua = _env_or("LUA", "lua")
  luajit = _env_or("LUAJIT", "luajit")

  if not std.script.fs_exists(duo)
    print("Building Duo compiler...")
    if std.script.run("zig build") != 0
      print("cross_benchmark: FAIL — zig build")
      return 1

  std.script.run("rm -rf " .. _OUT .. " && mkdir -p " .. _OUT)

  print("Compiling Duo binary...")
  if std.script.run(duo .. " compile examples/benchmark.lua -o " .. _OUT .. "/duo.out 2>/dev/null") != 0
    print("cross_benchmark: FAIL — Duo binary did not compile")
    return 1

  print("Compiling reference C binary...")
  sdk = std.script.chomp(std.script.capture("xcrun --sdk macosx --show-sdk-path 2>/dev/null"))
  cflags = "-O3 -ffast-math -march=native -flto -fomit-frame-pointer -funroll-loops" .. " -ffp-contract=fast -fno-trapping-math -fno-math-errno -ffunction-sections" .. " -fdata-sections -Wl,-dead_strip -std=c99 -lm"
  ccmd = "SDKROOT=" .. sdk .. " " .. cc .. " " .. cflags .. " -o " .. _OUT .. "/c.out examples/benchmark_c.c"
  if std.script.run(ccmd) != 0
    print("cross_benchmark: FAIL — reference C did not compile")
    return 1

  fixed = _OUT .. "/benchmark_pure.lua"
  std.script.run("sed 's/math\\.pow(\\(.*\\), \\(.*\\))/\\1 ^ \\2/g' examples/benchmark_pure.lua > " .. fixed)

  print("==============================================")
  print("     Cross-Language Performance Benchmark     ")
  print("==============================================")
  print("")
  print("=== Correctness (RESULT lines vs reference C) ===")

  ref = _results(std.script.capture(_OUT .. "/c.out 2>/dev/null"))
  dres = _results(std.script.capture(_OUT .. "/duo.out 2>/dev/null"))

  print("  C vs Duo:")
  _compare_strict(ref, dres)

  _compare_loose("Lua", ref, _results(std.script.capture(lua .. " " .. fixed .. " 2>/dev/null")))
  _compare_loose("LuaJIT", ref, _results(std.script.capture(luajit .. " " .. fixed .. " 2>/dev/null")))

  if _fail != 0
    print("")
    print("Cross-language benchmark FAILED: Duo must match reference C.")
    return 1

  print("")
  print("=== Timing (minimum of 3 runs, seconds) ===")
  print("  Timing Duo...")
  dt = _min_times(_OUT .. "/duo.out")
  print("  Timing C...")
  ct = _min_times(_OUT .. "/c.out")
  print("  Timing Lua...")
  lt = _min_times(lua .. " " .. fixed)
  print("  Timing LuaJIT...")
  jt = _min_times(luajit .. " " .. fixed)

  print("")
  print(_pad("Benchmark", 16) .. " " .. _lpad("Duo(s)", 10) .. " " .. _lpad("C(s)", 10) .. " " .. _lpad("Lua(s)", 10) .. " " .. _lpad("LuaJIT", 10))
  print(_pad("----------------", 16) .. " " .. _lpad("----------", 10) .. " " .. _lpad("----------", 10) .. " " .. _lpad("----------", 10) .. " " .. _lpad("----------", 10))

  dc = 0.0
  dl = 0.0
  dj = 0.0
  cnt = 0
  i = 1
  while i <= _BENCHES
    d = dt(i)
    c = ct(i)
    l = lt(i)
    j = jt(i)
    if d != nil and c != nil and l != nil and j != nil
      name = _names(i)
      if name == nil
        name = "bench-" .. i:to(str)
      print(_pad(name, 16) .. " " .. _lpad(_f6(d), 10) .. " " .. _lpad(_f6(c), 10) .. " " .. _lpad(_f6(l), 10) .. " " .. _lpad(_f6(j), 10))
      if d > 0.0 and c > 0.0
        dc = dc + c / d:log()
        dl = dl + l / d:log()
        dj = dj + j / d:log()
        cnt = cnt + 1
    i = i + 1

  print("")
  print("=== Summary (geometric mean speedup) ===")
  if cnt == 0
    print("no comparable benchmarks")
    return 1
  n = to(f64)(cnt)
  print("Duo vs C:       " .. to(str)(to(i64)(dc / n:exp() + 0.5)) .. "x faster")
  print("Duo vs Lua:     " .. to(str)(to(i64)(dl / n:exp() + 0.5)) .. "x faster")
  print("Duo vs LuaJIT:  " .. to(str)(to(i64)(dj / n:exp() + 0.5)) .. "x faster")
  0
