-- SIM and native C ABI gate.
--
-- Entity-bounded public serialization observations replace the former
-- in-process golden tests. The C rows replace the four tests in
-- src/pass5_foreign_tests.zig: emitted C stays unboxed, clang links the tracked
-- oracle fixtures, and the resulting programs return 25 and 10. Every compound
-- observation owns a private temporary directory.

here: str = ()
    std.script.chomp(std.script.capture("pwd"))

compiler: str = (root: str)
    "{root}/zig-out/bin/duo"

shout: void = (msg: str)
    print("sim: {msg}")

present: bool = (path: str)
    std.script.status("test -e {path}") == 0

capture: bool = (cmd: str, out: str)
    std.script.status("{cmd} >{out} 2>/dev/null") == 0

isolated: bool = (cmd: str)
    capture("d=$(mktemp -d) || exit 1; trap 'rm -rf $d' EXIT; " .. cmd, "/dev/null")

expect: i64 = (ok: bool, msg: str)
    if ok
        0
    else
        shout("FAIL — {msg}")
        1

row: str = (id: str)
    "awk -v id='\"id\":\"{id}\"' 'p=index($0,id) { s=substr($0,p); q=index(s,\"},{\\\"id\\\":\"); if (q) s=substr(s,1,q-1); print s; exit } END { if (!p) exit 1 }' $d/snap.json"

main = (): i64
    root = here()
    bin = compiler(root)
    fixtures = "{root}/examples/pass5/fixtures"
    examples = "{root}/examples/pass5"
    point = {
        header = "{fixtures}/point.h",
        oracle = "{fixtures}/point.c",
        source = "{examples}/c_point_smoke.duo",
    }
    rect = {
        header = "{fixtures}/big_rect.h",
        oracle = "{fixtures}/big_rect.c",
        source = "{examples}/c_big_rect_smoke.duo",
    }
    native = "{root}/examples/pass4_native_milestone.duo"
    boxes = "grep -E -q '(lua_Value|lua_val_|lua_to_|lua_table_|duo_retain|duo_release|duo_CPoint|duo_CBigRect)' "
    bad = 0

    -- Controls establish that the runner, tools, fixtures, matcher, and byte
    -- comparator can all convict a deliberately false observation.
    bad += expect(not capture("false", "/dev/null"),
        "control 1: capture called false a success")
    bad += expect(present(bin),
        "control 2: no compiler at {bin}; run zig build first")
    bad += expect(capture("command -v clang", "/dev/null"),
        "control 3: clang is unavailable")
    bad += expect(present(point.header), "control 4: missing point header")
    bad += expect(present(point.oracle), "control 4: missing point oracle")
    bad += expect(present(point.source), "control 4: missing point source")
    bad += expect(present(rect.header), "control 4: missing rectangle header")
    bad += expect(present(rect.oracle), "control 4: missing rectangle oracle")
    bad += expect(present(rect.source), "control 4: missing rectangle source")
    bad += expect(present(native), "control 4: missing fixture {native}")
    bad += expect(isolated("printf one > $d/one && printf two > $d/two && ! cmp -s $d/one $d/two"),
        "control 5: comparator called distinct values identical")
    bad += expect(isolated("printf 'lua_Value boxed' > $d/boxed.c && {boxes}$d/boxed.c"),
        "control 6: boxed-output detector missed lua_Value")

    call = row("c:function:distance2")
    shape = row("c:record:CPoint")
    probe = "cd '{root}' && '{bin}' sim --import-c examples/pass5/fixtures/point.h > $d/snap.json"
        .. ' && grep -q -F "\\\"schema\\\":\\\"sim-v0\\\",\\\"file\\\":\\\"examples/pass5/fixtures/point.h\\\",\\\"entity_count\\\":2" $d/snap.json'
        .. ' && (' .. call .. ' | grep -F "\\\"origin\\\":{\\\"language\\\":\\\"c\\\""'
        .. ' | grep -F "\\\"params\\\":[{\\\"name\\\":\\\"point\\\",\\\"type\\\":\\\"CPoint\\\"}]"'
        .. ' | grep -F "\\\"abi\\\":{\\\"calling_convention\\\":\\\"c\\\",\\\"pass_by\\\":\\\"value\\\"}"'
        .. ' | grep -q -F "\\\"contract\\\":{\\\"origin_language\\\":\\\"c\\\",\\\"semantic_completeness\\\":\\\"complete\\\",\\\"abi_completeness\\\":\\\"complete\\\"")'
        .. ' && (' .. shape .. ' | grep -F "\\\"storage_class\\\":\\\"native\\\""'
        .. ' | grep -q -F "\\\"contract\\\":{\\\"origin_language\\\":\\\"c\\\",\\\"semantic_completeness\\\":\\\"complete\\\",\\\"abi_completeness\\\":\\\"complete\\\"")'
    bad += expect(isolated(probe),
        "S1: point snapshot lost bounded identity, C ABI, value passing, or native storage")

    absent = row("c:function:absent")
    probe = "cd '{root}' && '{bin}' sim --import-c examples/pass5/fixtures/point.h > $d/snap.json"
        .. " && ! ({absent} >/dev/null)"
    bad += expect(isolated(probe),
        "control 7: bounded selector found an absent stable identity")

    stable = "cd '{root}' && '{bin}' sim --import-c examples/pass5/fixtures/point.h > $d/one.json"
        .. " && '{bin}' sim --import-c examples/pass5/fixtures/point.h > $d/two.json"
        .. " && cmp -s $d/one.json $d/two.json"
    bad += expect(isolated(stable),
        "S2: identical point imports rendered different bytes")

    call = row("duo:function:distance2")
    shape = row("duo:record:Point")
    probe = "cd '{root}' && '{bin}' sim examples/pass4_native_milestone.duo > $d/snap.json"
        .. ' && grep -q -F "\\\"schema\\\":\\\"sim-v0\\\",\\\"file\\\":\\\"examples/pass4_native_milestone.duo\\\",\\\"entity_count\\\":3" $d/snap.json'
        .. ' && (' .. call .. ' | grep -F "\\\"origin\\\":{\\\"language\\\":\\\"duo\\\""'
        .. ' | grep -q -F "\\\"contract\\\":{\\\"origin_language\\\":\\\"duo\\\",\\\"semantic_completeness\\\":\\\"complete\\\",\\\"abi_completeness\\\":\\\"complete\\\"")'
        .. ' && (' .. shape .. ' | grep -F "\\\"storage_class\\\":\\\"native\\\""'
        .. ' | grep -q -F "\\\"contract\\\":{\\\"origin_language\\\":\\\"duo\\\",\\\"semantic_completeness\\\":\\\"complete\\\",\\\"abi_completeness\\\":\\\"complete\\\"")'
    bad += expect(isolated(probe),
        "S3: native snapshot lost bounded identity, Duon origin, or native storage")

    stable = "cd '{root}' && '{bin}' sim examples/pass4_native_milestone.duo > $d/one.json"
        .. " && '{bin}' sim examples/pass4_native_milestone.duo > $d/two.json"
        .. " && cmp -s $d/one.json $d/two.json"
    bad += expect(isolated(stable),
        "S4: identical native exports rendered different bytes")

    call = row("c:function:sum4")
    shape = row("c:record:CBigRect")
    probe = "cd '{root}' && '{bin}' sim --import-c examples/pass5/fixtures/big_rect.h > $d/snap.json"
        .. ' && grep -q -F "\\\"schema\\\":\\\"sim-v0\\\",\\\"file\\\":\\\"examples/pass5/fixtures/big_rect.h\\\",\\\"entity_count\\\":2" $d/snap.json'
        .. ' && (' .. call .. ' | grep -F "\\\"origin\\\":{\\\"language\\\":\\\"c\\\""'
        .. ' | grep -F "\\\"params\\\":[{\\\"name\\\":\\\"rect\\\",\\\"type\\\":\\\"CBigRect*\\\"}]"'
        .. ' | grep -F "\\\"abi\\\":{\\\"calling_convention\\\":\\\"c\\\",\\\"pass_by\\\":\\\"pointer\\\"}"'
        .. ' | grep -q -F "\\\"contract\\\":{\\\"origin_language\\\":\\\"c\\\",\\\"semantic_completeness\\\":\\\"complete\\\",\\\"abi_completeness\\\":\\\"complete\\\"")'
        .. ' && (' .. shape .. ' | grep -F "\\\"storage_class\\\":\\\"native\\\""'
        .. ' | grep -q -F "\\\"contract\\\":{\\\"origin_language\\\":\\\"c\\\",\\\"semantic_completeness\\\":\\\"complete\\\",\\\"abi_completeness\\\":\\\"complete\\\"")'
    bad += expect(isolated(probe),
        "S5: rectangle snapshot lost bounded identity, pointer ABI, or native storage")

    source = point.source
    emit = "'{bin}' dump-c '{source}' > $d/point.c"
        .. " && grep -q -F 'fixtures/point.h' $d/point.c"
        .. " && grep -q -F 'extern double distance2(CPoint' $d/point.c"
        .. " && grep -q -F 'CPoint p = {' $d/point.c"
        .. " && grep -q -F '.x = ' $d/point.c"
        .. " && grep -q -F 'return distance2(p);' $d/point.c"
        .. " && ! {boxes}$d/point.c"
    bad += expect(isolated(emit),
        "S6: point C lost its native value call or introduced boxed machinery")

    oracle = point.oracle
    link = "'{bin}' dump-c '{source}' > $d/point.c"
        .. " && clang -std=c11 -O2 -I'{examples}' -I'{fixtures}'"
        .. " $d/point.c '{oracle}' -lm -o $d/point"
        .. " && ( $d/point; test $? -eq 25 )"
    bad += expect(isolated(link),
        "S7: point C did not link and return 25")

    source = rect.source
    emit = "'{bin}' dump-c '{source}' > $d/rect.c"
        .. " && grep -q -F 'extern double sum4' $d/rect.c"
        .. " && grep -q -F 'CBigRect r = {' $d/rect.c"
        .. " && grep -q -F 'return sum4(&r);' $d/rect.c"
        .. " && ! {boxes}$d/rect.c"
    bad += expect(isolated(emit),
        "S8: rectangle C lost its native pointer call or introduced boxed machinery")

    oracle = rect.oracle
    link = "'{bin}' dump-c '{source}' > $d/rect.c"
        .. " && clang -std=c11 -O2 -I'{examples}' -I'{fixtures}'"
        .. " $d/rect.c '{oracle}' -lm -o $d/rect"
        .. " && ( $d/rect; test $? -eq 10 )"
    bad += expect(isolated(link),
        "S9: rectangle C did not link and return 10")

    if bad == 0
        shout("PASS — stable snapshots and native C value/pointer ABI returned 25/10; 7 controls held")

    bad

std.os.exit(main())
