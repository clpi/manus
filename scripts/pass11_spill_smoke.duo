-- Pass 11 WP-03: register spill proof (macOS AArch64 host only).
--
-- Duo replacement for scripts/pass11_spill_smoke.sh (monoglot census).

_PROOF = "examples/pass11_spill_proof.duo"
_OUT = "/tmp/duo_pass11_spill_smoke.out"
_ASM = "/tmp/duo_pass11_spill_smoke.asm"

_wrong_host(): bool
    os_name = std.script.chomp(std.script.capture("uname -s"))
    arch = std.script.chomp(std.script.capture("uname -m"))
    if os_name != "Darwin"
        print("pass11_spill_smoke: SKIP (requires macOS host)")
        return true
    end
    if arch != "arm64"
        print("pass11_spill_smoke: SKIP (requires AArch64 host)")
        return true
    end
    false
end

-- The TAB before the mnemonic is load-bearing: without it `str x` also matches
-- inside comments and symbol names, and the proof would pass on assembly that
-- spills nothing. grep -c counts matching LINES, which is all we need.
_asm_has(mnemonic: str): bool
    n = std.script.chomp(std.script.capture(
        "grep -c \"" .. mnemonic .. "\" " .. _ASM .. " 2>/dev/null"))
    n != "" and n != "0"
end

main = (): i64
    if _wrong_host() return 0 end

    duo = "./zig-out/bin/duo"
    if not std.script.fs_exists(duo)
        zig = std.script.getenv_or("ZIG")
        if zig == "" zig = "zig" end
        if std.script.run(zig .. " build") != 0
            print("pass11_spill_smoke: FAIL — zig build")
            return 1
        end
    end

    if not std.script.fs_exists(_PROOF)
        print("pass11_spill_smoke: FAIL — missing " .. _PROOF)
        return 1
    end

    base = duo .. " compile " .. _PROOF .. " --backend=direct"
    if std.script.run(base .. " --target aarch64-macos --emit exe -o " .. _OUT) != 0
        print("pass11_spill_smoke: FAIL — exe compile")
        return 1
    end
    if std.script.run(base .. " --target native-asm -o " .. _ASM) != 0
        print("pass11_spill_smoke: FAIL — asm compile")
        return 1
    end

    if not _asm_has("\tstr x")
        print("pass11_spill_smoke: FAIL — expected spill stores in assembly")
        return 1
    end
    if not _asm_has("\tldr x")
        print("pass11_spill_smoke: FAIL — expected spill reloads in assembly")
        return 1
    end

    -- Exit 2 is v0+v21, the proof's answer with >20 live locals. Asserting the
    -- exact value (not merely "nonzero" or "zero") is what makes this a spill
    -- proof rather than a "it ran" check.
    --
    -- `status`, NOT `run`: std.os.execute collapses every nonzero status to 1,
    -- so `run` reported exit=1 here and this gate failed against a proof that
    -- was answering correctly. Any check comparing against a specific code
    -- needs the exact status.
    code = std.script.status(_OUT)
    if code != 2
        print("pass11_spill_smoke: FAIL — expected exit 2 (v0+v21 with >20 live locals), got exit="
            .. code:to(str))
        return 1
    end

    print("pass11_spill_smoke: PASS — spill lowering + runtime (exit=" .. code:to(str) .. ")")
    0
end
