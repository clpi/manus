# Tracked Zig bootstrap ledger for the self-hosting target.
#
# language_census proves the count is bounded. This file prints the exact
# tracked bootstrap files, including build.zig, so the remaining queue is
# inspectable from duon.

capture: str = (shellline: str)
    gatecap(shellline)

chomp: str = (text: str)
    if text == nil or text:len() == 0
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

cap: str = (shellline: str)
    chomp(gatecap(shellline))

status: i64 = (cmd: str)
    cap("( {cmd} ) >/dev/null 2>&1; echo $?"):to(i64)

lines: any = (text: str)
    out = {}
    start = 1
    i = 1
    n = text:len()
    while i <= n
        if text:byte(i) == 10
            if i > start
                out:push(text:sub(start, i - 1))
            start = i + 1
        i += 1
    if start <= n
        out:push(text:sub(start, n))
    out

starts: bool = (text: str, prefix: str)
    text:len() >= prefix:len() and text:sub(1, prefix:len()) == prefix

has: bool = (text: str, part: str)
    pos = text:find(part, 1, true)
    pos != nil and pos > 0

bucket: str = (path: str)
    if path == "build.zig"
        return "build"
    if has(path, "test") or has(path, "fixture")
        return "test"
    if has(path, "wasm")
        return "wasm"
    if has(path, "native") or has(path, "dnir") or has(path, "abi")
        return "native"
    if has(path, "semantic") or has(path, "graph") or has(path, "relation") or has(path, "realization")
        return "semantic"
    if has(path, "lexer") or has(path, "parser") or has(path, "token") or has(path, "sema")
        return "front"
    if has(path, "codegen") or has(path, "backend") or has(path, "lower") or has(path, "jit")
        return "back"
    "support"

control: i64 = ()
    bad = 0
    if bucket("build.zig") != "build"
        print("zigledger: fail control build")
        bad += 1
    if bucket("src/parser.zig") != "front"
        print("zigledger: fail control front")
        bad += 1
    if bucket("src/native_backend.zig") != "native"
        print("zigledger: fail control native")
        bad += 1
    if bucket("src/wasm_semantic.zig") != "wasm"
        print("zigledger: fail control wasm")
        bad += 1
    if bad == 0
        print("zigledger: control ok")
    bad

show: i64 = (name: str, files: any)
    count = 0
    for i = 1, files:len()
        if bucket(files[i]) == name
            count += 1
    print("{name} {count}")
    for i = 1, files:len()
        if bucket(files[i]) == name
            print("  {files[i]}")
    count

main: i64 = ()
    root = cap("git rev-parse --show-toplevel 2>/dev/null")
    if root == ""
        print("zigledger: fail no git root")
        return 3

    cmd = "cd '{root}' && git ls-files 'build.zig' 'src/*.zig' | sort"
    files = lines(capture(cmd))
    count = files:len()
    bad = control()
    if count == 0
        print("zigledger: pass tracked zig 0")
        return bad

    print("zigledger: fail tracked zig {count}")
    show("build", files)
    show("front", files)
    show("back", files)
    show("native", files)
    show("wasm", files)
    show("semantic", files)
    show("test", files)
    show("support", files)
    1
