-- Pass 11 WP-05: byte blob constants → direct Mach-O object (macOS AArch64 host only).
--
-- Duo replacement for scripts/pass11_blob_object_smoke.sh (monoglot census).

_PROOF = "examples/pass11_blob_object_smoke.duo"
_OUT = "/tmp/duo_pass11_blob_object_smoke.o"

_wrong_host(): bool
    os_name = std.script.chomp(std.script.capture("uname -s"))
    arch = std.script.chomp(std.script.capture("uname -m"))
    if os_name != "Darwin"
        print("pass11_blob_object_smoke: SKIP (requires macOS host)")
        return true
    end
    if arch != "arm64"
        print("pass11_blob_object_smoke: SKIP (requires AArch64 host)")
        return true
    end
    false
end

main = (): i64
    if _wrong_host() return 0 end

    duo = "./zig-out/bin/duo"
    if not std.script.fs_exists(duo)
        zig = std.script.getenv_or("ZIG")
        if zig == "" zig = "zig" end
        if std.script.run(zig .. " build") != 0
            print("pass11_blob_object_smoke: FAIL — zig build")
            return 1
        end
    end

    if not std.script.fs_exists(_PROOF)
        print("pass11_blob_object_smoke: FAIL — missing " .. _PROOF)
        return 1
    end

    cmd = duo .. " compile " .. _PROOF
        .. " --backend=direct --target aarch64-macos --emit obj -o " .. _OUT
    if std.script.run(cmd) != 0
        print("pass11_blob_object_smoke: FAIL — direct compile")
        return 1
    end

    -- The magic bytes ARE the assertion: `--emit obj` reporting success while
    -- writing some other format is a live failure mode in this compiler
    -- (GAP-015 — obj/dylib have emitted executables), so "it compiled" proves
    -- nothing about what landed on disk.
    magic = std.script.chomp(std.script.capture("xxd -p -l 4 " .. _OUT))
    if magic != "cffaedfe"
        print("pass11_blob_object_smoke: FAIL — expected Mach-O magic cffaedfe, got " .. magic)
        return 1
    end

    print("pass11_blob_object_smoke: PASS — Mach-O object from byte blob module")
    0
end
