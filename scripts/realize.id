-- Pass 8 realization plan + persistent semantic cache gate.
--
-- PORTED from src/pass8_realization_tests.zig (158 lines, 6 tests) and
-- src/pass8_codegen_realization_tests.zig (55 lines, 1 test), both deleted in
-- the same commit. Every one of those tests drove Lexer -> Parser -> sema ->
-- realization.buildFromGraph / compile_semantic_cache.refreshFromCheckedModule
-- IN PROCESS and asserted on Zig structs. Two shipping verbs already print
-- exactly that state, so the port asserts the CLI:
--
--   duo explain  -> realizations (the plan), optimization_outcomes (what
--                   codegen actually did with it), knowledge_snapshot
--                   (the shape fingerprint)
--   duo realize  -> reuse_audit (fresh / reused / invalidated),
--                   persistent_state (the cache entries, with `stale`),
--                   invalidation (the edges, with their kind)
--
-- The Zig originals, and where each landed:
--
--   module plan selects native aggregate for sealed Point  -> R1
--   persistent reuse rejects fingerprint drift             -> R3
--   fingerprint changes when shape identity changes        -> R2
--   merge reports invalidated on fingerprint drift         -> R3
--   compile cache refresh reuses then invalidates          -> R3, R4
--   entity removal marks stale cache entry                 -> R5
--   codegen logs realization.representation for Point      -> R6
--
-- WHAT THE PORT NEEDED FROM THE COMPILER. `optimization_outcome.writeJson`
-- printed only `reason`, a prose string, while the outcome record already
-- CARRIED `entity`, `before_repr` and `after_repr`. The Zig test asserted the
-- last two by field, so from outside the process they had to become fields:
-- that projection landed in the same commit and changed no semantics.
--
-- WHY THE RUNS ARE SANDBOXED. The persistent cache is
-- `.id/cache/semantic/state.json` RELATIVE TO CWD, and the fresh -> drift ->
-- removal sequence is the assertion — a stale entry from an earlier run, or a
-- concurrent session compiling in the repo root, would decide the answer. The
-- gate builds an empty directory and runs every `duo realize` from inside it,
-- so the cache it reads is the one it wrote.
--
-- WHAT THE PORT COULD NOT KEEP. Two Zig tests reached functions no verb calls:
-- `semantic_fingerprint.compute` on two synthetic descriptor_deps strings, and
-- `persistent_semantic_state.canReuse` on a hand-built Entry. Both are the
-- SAME fact one layer down from what R2 and R3 assert through real modules —
-- a shape change moves the fingerprint, and a moved fingerprint refuses reuse
-- — so the coverage is kept and only the synthetic inputs are lost.

here(): str
    std.script.chomp(std.script.capture("pwd"))
end

compiler(root: str): str
    "{root}/zig-out/bin/duo"
end

shout(msg: str): void
    print("realize: {msg}")
end

present(path: str): bool
    std.script.status("test -e {path}") == 0
end

-- One `duo realize` run, captured. Captured rather than re-run per assertion
-- because each run MUTATES the cache: greping the same command three times
-- would advance the fresh/invalidated sequence three times.
record(bin: str, dir: str, fixture: str, out: str): bool
    std.script.status("cd {dir} && {bin} realize {fixture} >{out} 2>/dev/null") == 0
end

explained(bin: str, fixture: str, out: str): bool
    std.script.status("{bin} explain {fixture} >{out} 2>/dev/null") == 0
end

-- Does a captured JSON document hold `want`? Split on commas first so a
-- field's own value cannot be matched across a neighbouring field.
held(path: str, want: str): bool
    std.script.status("tr ',' '\\n' < {path} | grep -q -F '{want}'") == 0
end

-- The FIRST fingerprint in an explain document: the sealed record's shape
-- identity. Two modules differing only in a field must not agree here.
mark(path: str): str
    std.script.chomp(std.script.capture("tr ',' '\\n' < {path} | grep -o '\"fingerprint\":\"[0-9a-f]*\"' | head -1"))
end

main = (): i64
    root = here()
    bin = compiler(root)
    dir = "/tmp/duo-realize-gate"
    bad = 0

    -- CONTROL 1 — the runner convicts.
    if std.script.status("false") == 0
        shout("FAIL — control: status() called `false` a success")
        bad += 1
    end

    -- CONTROL 2 — the compiler is here.
    if not present(bin)
        shout("FAIL — no compiler at {bin}; run `zig build` first")
        bad += 1
    end

    one = "{root}/examples/pass8/realization_smoke.id"
    two = "{root}/examples/pass8/realization_point_v2.id"
    gone = "{root}/examples/pass8/realization_norecord.id"

    -- CONTROL 3 — the fixtures are here. Held over a missing file is false for
    -- every want, which reads as a wall of real failures.
    if not present(one)
        shout("FAIL — missing fixture {one}")
        bad += 1
    end
    if not present(two)
        shout("FAIL — missing fixture {two}")
        bad += 1
    end
    if not present(gone)
        shout("FAIL — missing fixture {gone}")
        bad += 1
    end

    if std.script.status("rm -rf {dir} && mkdir -p {dir}") != 0
        shout("FAIL — could not build the sandbox at {dir}")
        bad += 1
    end

    -- The plan, and what codegen did with it. One explain run, two ports.
    plan = "{dir}/plan.json"
    if not explained(bin, one, plan)
        shout("FAIL — `duo explain` did not run on the sealed-record fixture")
        bad += 1
    end

    -- CONTROL 4 — held() can answer NO. Without this a grep that has stopped
    -- matching, or an explain that has stopped printing, scores a clean sweep.
    if held(plan, "duo-realize-this-string-does-not-exist")
        shout("FAIL — control: held() matched a string that is not in the output")
        bad += 1
    end

    -- R1 — the sealed Point plans one representation variable, four candidates
    -- are offered, and the register/native aggregate is the one selected.
    if not held(plan, "\"variable_count\":1")
        shout("FAIL — R1: the sealed record produced no realization variable")
        bad += 1
    end
    if not held(plan, "\"selected_id\":\"repr.native_aggregate\"")
        shout("FAIL — R1: the plan did not select repr.native_aggregate")
        bad += 1
    end
    if not held(plan, "\"selected_index\":3")
        shout("FAIL — R1: the selection carried no index")
        bad += 1
    end
    if not held(plan, "\"id\":\"repr.dynamic_table\"")
        shout("FAIL — R1: the dynamic-table candidate was never offered")
        bad += 1
    end
    if not held(plan, "\"id\":\"repr.native_sealed\"")
        shout("FAIL — R1: the sealed-struct candidate was never offered")
        bad += 1
    end

    -- R6 — codegen logged the representation it actually emitted, naming the
    -- entity and the representation as FIELDS, not as prose inside a reason.
    if not held(plan, "\"transformation\":\"realization.representation\"")
        shout("FAIL — R6: codegen logged no realization.representation outcome")
        bad += 1
    end
    if not held(plan, "\"status\":\"applied\"")
        shout("FAIL — R6: the realization outcome was not applied")
        bad += 1
    end
    if not held(plan, "\"entity\":\"duo:record:Point\"")
        shout("FAIL — R6: the outcome named no entity")
        bad += 1
    end
    if not held(plan, "\"after_repr\":\"native_aggregate\"")
        shout("FAIL — R6: the outcome did not report native_aggregate")
        bad += 1
    end

    -- R2 — shape identity moves when the shape moves. A third field on Point
    -- must change the fingerprint the snapshot publishes.
    drift = "{dir}/drift.json"
    if not explained(bin, two, drift)
        shout("FAIL — R2: `duo explain` did not run on the drifted fixture")
        bad += 1
    end
    before = mark(plan)
    after = mark(drift)
    if before == ""
        shout("FAIL — R2: no fingerprint was published for the sealed record")
        bad += 1
    end
    if before == after
        shout("FAIL — R2: adding a field left the fingerprint at {before}")
        bad += 1
    end

    -- R3 — an empty cache admits the entry FRESH; the same entity at a drifted
    -- shape is INVALIDATED, and the reason names the fingerprint.
    fresh = "{dir}/fresh.json"
    if not record(bin, dir, one, fresh)
        shout("FAIL — R3: `duo realize` did not run on the sealed-record fixture")
        bad += 1
    end
    if not held(fresh, "\"action\":\"fresh\"")
        shout("FAIL — R3: the first realize did not admit the entry fresh")
        bad += 1
    end
    if not held(fresh, "\"edge_count\":0")
        shout("FAIL — R3: the first realize invalidated something")
        bad += 1
    end

    -- R4 — and the drift raises exactly one fingerprint_change edge.
    stale = "{dir}/stale.json"
    if not record(bin, dir, two, stale)
        shout("FAIL — R4: `duo realize` did not run on the drifted fixture")
        bad += 1
    end
    if not held(stale, "\"action\":\"invalidated\"")
        shout("FAIL — R4: the drifted shape was reused instead of invalidated")
        bad += 1
    end
    if not held(stale, "\"reason\":\"semantic fingerprint mismatch\"")
        shout("FAIL — R4: the invalidation named no fingerprint")
        bad += 1
    end
    if not held(stale, "\"edge_count\":1")
        shout("FAIL — R4: the drift raised no invalidation edge")
        bad += 1
    end
    if not held(stale, "\"kind\":\"fingerprint_change\"")
        shout("FAIL — R4: the edge was not a fingerprint change")
        bad += 1
    end

    -- R5 — realizing a module the entity has LEFT marks the cached entry stale
    -- and raises an entity_removed edge. This is the one assertion that needs
    -- the two runs above to have happened first, in this cache.
    dropped = "{dir}/dropped.json"
    if not record(bin, dir, gone, dropped)
        shout("FAIL — R5: `duo realize` did not run on the record-free fixture")
        bad += 1
    end
    if not held(dropped, "\"stale\":true")
        shout("FAIL — R5: the removed entity's cache entry stayed fresh")
        bad += 1
    end
    if not held(dropped, "\"kind\":\"entity_removed\"")
        shout("FAIL — R5: removal raised no entity_removed edge")
        bad += 1
    end

    if bad == 0
        shout("PASS — plan, codegen outcome, fingerprint drift, invalidation and removal, 4 controls held")
    end
    bad
end

std.os.exit(main())
