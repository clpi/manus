#!/usr/bin/env duo
global s = req "std.script"

global DUO: str = tostring(s.getenv_or("DUO"))
if string.len(DUO) == 0
    DUO = "./zig-out/bin/duo"
end
DUO = "env DUO_BUILD_REPORT=plain " .. DUO

global any_failed: i64 = 0

pass(msg: str): void
    s.echo("OK:   " .. msg)
end

fail(msg: str, out: str)
    s.echo("FAIL: " .. msg)
    if string.len(out) > 0
        s.echo(out)
    end
    any_failed = 1
end

temp_file(): str
    tmp = tostring(s.fs_tmp())
    if string.len(tmp) == 0
        tmp = "/tmp/duo_test_" .. tostring(os.time())
    end
    return string.gsub(tmp, "\n", "")
end

run_fail(file: str, pattern: str)
    tmp = temp_file()
    rc = s.run(DUO .. " check " .. file .. " > " .. tmp .. " 2>&1")
    out = s.fs_read(tmp)
    os.remove(tmp)
    
    if rc == 0
        fail(file .. " should not compile", out)
    elseif string.find(out, pattern, 1, true) != nil
        pass(file .. "  (expected error found)")
    else
        fail(file .. "  expected pattern: " .. pattern, out)
    end
end

-- gap[082]: a refusal that only CODEGEN can make. `run_fail` runs `duo check`,
-- which stops before lowering, so a judgment made while emitting is invisible
-- to it — and reporting such a fixture as passing `check` is exactly the
-- false-green this repo has paid for before. This runner compiles.
--
-- That `duo check` cannot see a lossy-composition refusal is a real limitation
-- and is recorded on the gap: the class lattice belongs in sema, where it would
-- be one diagnostic in one place instead of a lowering-time veto. Until it
-- moves, the gate has to run the stage that holds the rule.
refuses(file: str, pattern: str)
    tmp = temp_file()
    rc = s.run("{DUO} compile {file} -o /dev/null > {tmp} 2>&1")
    out = s.fs_read(tmp)
    os.remove(tmp)

    if rc == 0
        fail("{file} should not compile", out)
    elseif string.find(out, pattern, 1, true) != nil
        pass("{file}  (expected error found)")
    else
        fail("{file}  expected pattern: {pattern}", out)
    end
end

run_ok(file: str)
    tmp = temp_file()
    rc = s.run(DUO .. " check " .. file .. " > " .. tmp .. " 2>&1")
    out = s.fs_read(tmp)
    os.remove(tmp)
    
    if rc == 0
        pass(file .. "  (check passes)")
    else
        fail(file .. "  should compile but got:", out)
    end
end

run_output(file: str, expected: str)
    tmp = temp_file()
    rc = s.run(DUO .. " run " .. file .. " > " .. tmp .. " 2>&1")
    out = s.fs_read(tmp)
    os.remove(tmp)
    
    if rc == 0
        if out == expected
            pass(file .. "  (run output matches)")
        else
            fail(file .. "  output mismatch\n--- want ---\n" .. expected .. "\n--- got ---\n" .. out, "")
        end
    else
        fail(file .. "  should compile+run but got:", out)
    end
end

run_shell_ok(label: str, script: str)
    tmp = temp_file()
    rc = s.run("bash " .. script .. " > " .. tmp .. " 2>&1")
    out = s.fs_read(tmp)
    os.remove(tmp)
    
    if rc == 0
        pass(label)
    else
        fail(label .. " failed:", out)
    end
end

run_duo_ok(label: str, script: str)
    tmp = temp_file()
    rc = s.run(DUO .. " run " .. script .. " > " .. tmp .. " 2>&1")
    out = s.fs_read(tmp)
    os.remove(tmp)
    
    if rc == 0
        pass(label)
    else
        fail(label .. " failed:", out)
    end
end

run_fail("examples/compile_fail/global_star_read.lua",    "use of undeclared global")
run_fail("examples/compile_fail/implicit_global_read.lua", "use of undeclared global")
run_fail("examples/compile_fail/global_star_assign.lua",  "attempt to assign to undeclared global")
run_fail("examples/compile_fail/for_assign_num.lua",      "cannot assign to for loop control variable")
run_fail("examples/compile_fail/for_assign_gen.lua",      "cannot assign to for loop control variable")
run_fail("examples/compile_fail/const_local_assign.lua",  "attempt to assign to const variable")
run_fail("examples/compile_fail/const_no_init.lua",       "must have an initializer")
run_fail("examples/compile_fail/close_no_init.lua",       "must have an initializer")
run_fail("examples/compile_fail/vararg_rest_assign.lua",  "read-only vararg table")
run_fail("examples/compile_fail/global_const_assign.lua", "attempt to assign to const variable")
refuses("examples/compile_fail/relation_lossy_compose.duo", "no silent conversion inch -> milli")
run_fail("examples/compile_fail/tensor_matmul_k_mismatch.duo", "tensor matmul inner dimension mismatch")
run_fail("examples/compile_fail/tensor_matmul_symbolic_k_mismatch.duo", "tensor matmul inner dimension mismatch")
run_fail("examples/compile_fail/tensor_broadcast_incompatible.duo", "tensor broadcast incompatible shapes")
run_fail("examples/compile_fail/tensor_return_mismatch.duo", "return type mismatch")
run_fail("examples/compile_fail/generic_concept_fail.duo", "does not satisfy concept 'Hashable'")
run_fail("examples/compile_fail/satisfies_fail.duo", "Empty lacks hash")
run_fail("examples/compile_fail/multi_concept_fail.duo", "does not satisfy concept 'Counter'")
-- Pass 100 §3 — offside layout DIAGNOSES rather than re-nests. Both rows fail
-- for indentation alone; both files are otherwise well-formed programs, which
-- is the point: the only thing wrong with them is a rendering that matches no
-- shallow shape, and that has to be an error rather than a second parse.
run_fail("examples/compile_fail/offside_misindent.duo", "indentation matches no block")
run_fail("examples/compile_fail/offside_end_column.duo", "closes a block opened at column")
-- Pass 100 §2 — the anchor has THREE stances and `.@name` is not one of them.
-- This row is a rejection and not a corpus value fixture on purpose: the form
-- shipped a wrong VALUE (`p.@x` = nil beside `p.x` = 3, both checking clean),
-- and a wrong value that type-checks is exactly the thing a value fixture
-- cannot pin. See docs/anchor_stance_conflict.md row 3.
run_fail("examples/compile_fail/anchor_metafield.duo", "is not an anchor stance")
-- GAP-059 — the half of the `@` token adjacency did not reconcile. 3f6ec4e
-- gave the GLUED spelling to the anchor (`p@x` retrieves; anchormove.duo pins
-- it at 353), but `infix_prec` still maps the token to `.matmul`, so the
-- SPACED spelling kept the false green: `p @ x` warned, checked clean, exited
-- 0, and then handed the C backend an identifier the user never wrote. This
-- row asserts the refusal; the row under it asserts the .lua twin still
-- compiles, which is what proves the operator was gated on the dialect rather
-- than removed. The pattern is the refusal line, and the hint beside it names
-- the repair — close the space — which is the only reason this can be an error
-- instead of a warning.
run_fail("examples/compile_fail/anchor_infix_at.duo", "has no meaning in .duo")
run_ok("examples/compile_fail/anchor_infix_at.lua")

-- Pass 100 §1 — deny-table rows enforced at the .duo surface. Each row is a
-- pair — the .duo file must be rejected, and its byte-identical .lua twin must
-- still compile. The .lua half is the load-bearing one — it is what proves the
-- construct was gated on the dialect rather than removed from the compiler,
-- so "lua native compile" keeps working. Drop the run_ok rows and this suite
-- can no longer tell "Duo rejects it" apart from "the compiler lost it".
--
-- The pattern each run_fail asserts is the REPAIR-bearing hint, not only the
-- refusal line, because a bare rejection makes the corpus unmigratable.
run_fail("examples/compile_fail/pass100_try_retired.duo", "'try' is retired in .duo files")
run_ok("examples/compile_fail/pass100_try_retired.lua")
run_fail("examples/compile_fail/pass100_goto_retired.duo", "dispatch table")
run_ok("examples/compile_fail/pass100_goto_retired.lua")

run_ok("tests/test.lua")
run_ok("examples/hello.lua")
run_ok("examples/fib.lua")
-- The benchmark's Lua mirror: half the correctness oracle, and the file that
-- proved layout had leaked out of `.duo`. It failed to `check` at 79d4e09
-- ("'end' at column 13 closes a block opened at column 9" at line 704), which
-- meant `zig build bench` could not reach a single RESULT row.
run_ok("examples/benchmark.lua")
run_ok("examples/fib.duo")
run_ok("examples/ml_showcase.duo")
run_ok("examples/direct_table_iteration.duo")

run_output("examples/control_defaults_mem.duo", "14\n16\n10\n")
run_output("examples/metatable_class_semantics.duo", "Vector(3, 4)\nVector(6, 8)\ntrue\n2\ntrue\n42\nmissing:anything\nVector\n")
run_output("examples/compound_metamethods.duo", "sub\nmul\ndiv\nmod\npow\n")
run_output("examples/metamethod_operator_compat.duo", "concat\ntrue\ntrue\nunm\nidiv\nband\nbor\nbxor\nbnot\nshl\nshr\n")
run_output("examples/metamethod_gc.duo", "1\n")
run_output("examples/metamethod_iter.duo", "60\n")
run_output("examples/metamethod_pairs_ipairs.lua", "15\n15\n")
run_output("examples/typed_string_builtins.duo", "abc\n42\nabc42\n7\n3\n")
run_output("examples/layout_attrs_test.duo", "6\n")
run_output("examples/layout_refinements_test.duo", "6\n")
run_output("examples/native_record_params.duo", "4\n12\n")

run_duo_ok("Property 11 test passes", "scripts/test_property_11.duo")
run_duo_ok("Property 12 test passes", "scripts/test_property_12.duo")

s.echo("")
if any_failed == 0
    s.echo("All compile-fail tests passed")
else
    s.echo("Some tests FAILED")
    os.exit(1)
end
