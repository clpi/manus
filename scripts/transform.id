
here: str = ()
  script.chomp(script.capture("pwd"))

compiler: str = (root: str)
  "{root}/zig-out/bin/idol"

shout = (msg: str)
  print("transform: {msg}")

present: bool = (path: str)
  script.status("test -e {path}") == 0

capture: bool = (cmd: str, out: str)
  script.status("{cmd} >{out} 2>/dev/null") == 0

row: bool = (path: str, want: str)
  script.status("grep -q -E '{want}' {path}") == 0

held: bool = (path: str, want: str)
  script.status("tr ',' '\\n' < {path} | grep -q -F '{want}'") == 0

literal: str = (path: str, name: str)
  std.script.chomp(std.script.capture("grep -o 'const char\\* {name} = \"[^\"]*\"' {path} | head -1 | sed 's/.*= //'"))

blocklit: str = (path: str)
  std.script.chomp(std.script.capture("grep -A1 'const char\\* parity()' {path} | grep -o 'return \"[^\"]*\"' | head -1 | sed 's/^return //'"))

main: i64 = ()
  root = here()
  bin = compiler(root)
  dir = "/tmp/duo-transform-gate"
  bad = 0

  if script.status("false") == 0
    shout("FAIL — control: status() called `false` a success")
    bad = bad + 1

  if not present(bin)
    shout("FAIL — no compiler at {bin}; run `zig build` first")
    bad = bad + 1

  if script.status("rm -rf {dir} && mkdir -p {dir}") != 0
    shout("FAIL — could not build the sandbox at {dir}")
    bad = bad + 1

  tier = { "match", "map", "each", "tabulate", "interpolate", "power", "derivepower", "fixpoint", "zip", "permute" }
  named = { "comp.match", "comp.map", "comp.each", "comp.tabulate", "comp.interpolate", "comp.power", "comp.derive.power", "comp.fixpoint", "comp.zip", "comp.permute" }
  hooks = { "__comptimemap", "__comptimematch", "__comptimepower", "__derivepower", "__comptimefixpoint", "__comptimetabulate", "__comptimeinterpolate", "__comptimeeach", "__metacatalog" }
  calls = { "call.inline", "call.specialize", "call.memo", "call.devirtualize", "call.gpu_lower", "call.simd_lower" }

  i = 1
  while i <= tier:len()
    leaf = tier(i)
    f = "{root}/examples/parity/{leaf}.id"
    if not present(f)
      shout("FAIL — missing parity fixture {f}")
      bad = bad + 1
    i = i + 1
  for extra in { "call", "hot", "pipeline" }
    f = "{root}/examples/parity/{extra}.id"
    if not present(f)
      shout("FAIL — missing fixture {f}")
      bad = bad + 1

  reg = "{dir}/registry.json"
  if not capture("DUO_TRANSFORM_GATE=1 {bin} explain {root}/examples/parity/map.id", reg)
    shout("FAIL — `duo explain` did not run under DUO_TRANSFORM_GATE=1")
    bad = bad + 1

  if held(reg, "duo-transform-this-string-does-not-exist")
    shout("FAIL — control: held() matched a string that is not in the output")
    bad = bad + 1

  if not held(reg, "\"tier1_count\":10")
    shout("FAIL — D1: the tier-1 registry is not ten transforms")
    bad = bad + 1
  i = 1
  while i <= named:len()
    n = named(i)
    if not row(reg, "\"transform\":\"{n}\"[^}}]*\"registered\":true")
      shout("FAIL — D1: {n} is not registered")
      bad = bad + 1
    if not row(reg, "\"transform\":\"{n}\"[^}}]*\"requires_parity\":true")
      shout("FAIL — D1: {n} does not require a parity test")
      bad = bad + 1
    if not row(reg, "\"transform\":\"{n}\"[^}}]*\"native_only\":true")
      shout("FAIL — D1: {n} has no native-only contract")
      bad = bad + 1
    if not row(reg, "\"transform\":\"{n}\"[^}}]*\"parity_contract_satisfied\":true")
      shout("FAIL — D1: {n} does not declare all three parity sites")
      bad = bad + 1
    if not row(reg, "\"transform\":\"{n}\"[^}}]*\"parse_as_expression\":true")
      shout("FAIL — M2: {n} would parse as a directive, not an expression")
      bad = bad + 1
    i = i + 1

  i = 1
  while i <= hooks:len()
    h = hooks(i)
    if not row(reg, "\"hook\":\"{h}\"[^}}]*\"dispatch_allowed\":true")
      shout("FAIL — D2: internal hook {h} is refused by the strict dispatch gate")
      bad = bad + 1
    i = i + 1

  if script.status("sed 's/.*\"transform_provenance\"//; s/\"transform_registry\".*//' {reg} | grep -q '\"transform\":\"__'") == 0
    shout("FAIL — D4: an internal __ hook name reached the provenance log")
    bad = bad + 1
  if not held(reg, "\"schema\":\"transform-provenance-v0\"")
    shout("FAIL — D4: no provenance was projected at all")
    bad = bad + 1

  i = 1
  while i <= calls:len()
    c = calls(i)
    if not row(reg, "\"transform\":\"{c}\"[^}}]*\"is_call\":true")
      shout("FAIL — C1: {c} is not classed a call transform")
      bad = bad + 1
    if not row(reg, "\"transform\":\"{c}\"[^}}]*\"registered\":true")
      shout("FAIL — C1: {c} is not registered")
      bad = bad + 1
    if not row(reg, "\"transform\":\"{c}\"[^}}]*\"native_only\":true")
      shout("FAIL — C1: {c} has no native-only contract")
      bad = bad + 1
    if not row(reg, "\"transform\":\"{c}\"[^}}]*\"parity_sites\":\\[\"emit_call\"\\]")
      shout("FAIL — C1: {c} does not declare exactly the emit_call site")
      bad = bad + 1
    i = i + 1

  plain = "{dir}/call.json"
  plainc = "{dir}/call.c"
  if not capture("{bin} explain {root}/examples/parity/call.id", plain)
    shout("FAIL — C3: `duo explain` did not run on the call fixture")
    bad = bad + 1
  if not capture("{bin} dump-c {root}/examples/parity/call.id", plainc)
    shout("FAIL — C2: `duo dump-c` did not run on the call fixture")
    bad = bad + 1
  if script.status("grep -q -F 'add(' {plainc}") != 0
    shout("FAIL — C2: the emitted C holds no direct add( call")
    bad = bad + 1
  if script.status("grep -q -F 'lua_invoke' {plainc}") == 0
    shout("FAIL — C2: the direct call still emitted lua_invoke")
    bad = bad + 1
  if not row(plain, "\"transform\":\"call.inline\"[^}}]*\"observed\":true")
    shout("FAIL — C3: call.inline never dispatched")
    bad = bad + 1

  hot = "{dir}/hot.json"
  if not capture("{bin} explain {root}/examples/parity/hot.id", hot)
    shout("FAIL — C4: `duo explain` did not run on the @hot fixture")
    bad = bad + 1
  if not row(hot, "\"transform\":\"call.simd_lower\"[^}}]*\"observed\":true")
    shout("FAIL — C4: the @hot callee did not dispatch call.simd_lower")
    bad = bad + 1
  if row(plain, "\"transform\":\"call.simd_lower\"[^}}]*\"observed\":true")
    shout("FAIL — C4: the NON-@hot twin also dispatched call.simd_lower, so the attribute proves nothing")
    bad = bad + 1

  pipec = "{dir}/pipeline.c"
  if not capture("{bin} dump-c {root}/examples/parity/pipeline.id", pipec)
    shout("FAIL — C5: `duo dump-c` did not run on the pipeline fixture")
    bad = bad + 1
  if script.status("grep -q -F 'int64_t y = double(21);' {pipec}") != 0
    shout("FAIL — C5: `21 |> double` did not lower to the direct call double(21)")
    bad = bad + 1
  if script.status("grep -q -F 'lua_invoke' {pipec}") == 0
    shout("FAIL — C5: the pipeline call site emitted lua_invoke")
    bad = bad + 1

  i = 1
  while i <= tier:len()
    stem = tier(i)
    n = named(i)
    src = "{root}/examples/parity/{stem}.id"
    out = "{dir}/{stem}.c"
    seen = "{dir}/{stem}.json"
    if not capture("{bin} dump-c {src}", out)
      shout("FAIL — M3: {stem}.id did not compile")
      bad = bad + 1
    top = literal(out, "TOP")
    nested = literal(out, "NESTED")
    block = blocklit(out)
    if top == ""
      shout("FAIL — M3: {n} produced no top-level literal (did it parse as a directive?)")
      bad = bad + 1
    if block == ""
      shout("FAIL — M3: {n} produced no block-body literal")
      bad = bad + 1
    if top != nested
      shout("FAIL — M3: {n} folded differently at top-level and nested-callback sites")
      bad = bad + 1
    if top != block
      shout("FAIL — M3: {n} folded differently at top-level and block-body sites")
      bad = bad + 1
    if not capture("{bin} explain {src}", seen)
      shout("FAIL — M4: `duo explain` did not run on {stem}.id")
      bad = bad + 1
    if not row(seen, "\"transform\":\"{n}\"[^}}]*\"parity_observed\":true")
      shout("FAIL — M4: {n} did not dispatch at all three parity sites")
      bad = bad + 1
    i = i + 1

  if not row("{dir}/match.json", "\"transform\":\"comp.zip\"[^}}]*\"parity_observed\":false")
    shout("FAIL — control: a combinator the match fixture never calls still reported full parity")
    bad = bad + 1

  if bad == 0
    shout("PASS — 10 tier-1 registry rows, 9 dispatch hooks, 6 call transforms, 10 three-site parities, 5 controls held")
  bad

os.exit(main())
