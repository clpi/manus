# Transform engine gate — tier-1 registry, dispatch, three-site parity, call algebra.
#
# PORTED from three deleted Zig files:
#
#   src/meta_transform_tests.zig       444 lines, 6 tests
#   src/call_transform_tests.zig       102 lines, 4 tests
#   the dispatch tests                  45 lines, 4 tests
#
# All fourteen reached `transform_engine` state that no verb printed: the
# registry, its contracts, the dispatch gate, and the provenance log. That
# state is now RENDERED — `duo explain` grew `transform_provenance` and
# `transform_registry` in the same commit, and `optimization_outcome` grew the
# `entity` / `before_repr` / `after_repr` fields it already carried. No
# compiler semantics changed; state that existed became state that leaves the
# process, which is what H-8 output totality asks for anyway.
#
# WHY THE PROVENANCE NEEDED A SNAPSHOT. `runForProvenance` enables the log and
# `defer`s `setProvenanceEnabled(false)`, which CLEARS it — so by the time any
# caller could render it, it was empty. `transform_engine.snapshotProvenance`
# fires first (LIFO) and preserves the run. That is the whole reason this
# state had no projection before.
#
# THE FIXTURES ARE TRACKED AND ARE OPENED. `meta_transform_tests.zig` BUILT
# its parity sources at runtime by string concatenation, which is how a
# harness ends up asserting against text no one can read or repair. The ten
# combinator fixtures now live in `examples/parity/` in the exact three-site
# shape, and this gate compiles those files.
#
# WHAT THE PORT FOUND. `call_transform_tests.zig` had a test named
# "call.simd_lower provenance for @hot callee" that asserted only that
# `call.simd_lower` was logged — and `call.simd_lower` is ALSO logged for a
# call in tail position with no `@hot` anywhere. The test could not fail for
# the reason it was named after. This gate keeps the claim falsifiable: the
# two fixtures differ ONLY by the attribute, and the gate asserts
# simd_lower observed on one and NOT observed on the other.
#
# WHAT THE PORT COULD NOT KEEP. One assertion, from dispatch test 4: that
# `dispatchMetaCombinator` called with a hook name that is in no registry
# appends nothing. Rendering it would mean printing a row for a hook that does
# not exist, which is fabricated data in a projection. What is kept is its
# OBSERVABLE consequence, asserted at D4: no provenance entry ever names an
# internal `__` hook — every logged transform is a public registry id.

here(): str
    script.chomp(script.capture("pwd"))

compiler(root: str): str
    "{root}/zig-out/bin/idol"

shout(msg: str): void
    print("transform: {msg}")

present(path: str): bool
    script.status("test -e {path}") == 0

capture(cmd: str, out: str): bool
    script.status("{cmd} >{out} 2>/dev/null") == 0

# A whole-line regex over the raw JSON. The registry rows are flat objects, so
# `[^}]*` cannot cross an object boundary — which is what lets one grep tie a
# transform's NAME to its own fields instead of to a neighbour's.
row(path: str, want: str): bool
    script.status("grep -q -E '{want}' {path}") == 0

# Substring, comma-split so a value cannot be matched across two fields.
held(path: str, want: str): bool
    script.status("tr ',' '\\n' < {path} | grep -q -F '{want}'") == 0

# The C string literal bound to `name` in emitted C, e.g. `TOP`. The binding's
# own name is stripped here so the three sites compare as VALUES — they are
# bound to three different names and would never be equal otherwise.
literal(path: str, name: str): str
    std.script.chomp(std.script.capture("grep -o 'const char\\* {name} = \"[^\"]*\"' {path} | head -1 | sed 's/.*= //'"))

# The literal returned by the block-body site's function. Anchored on the
# callee name rather than on the opening brace: `duo explain` and this gate
# share an interpolation syntax in which a brace is a hole, so the pattern
# stays brace-free on purpose.
blocklit(path: str): str
    std.script.chomp(std.script.capture("grep -A1 'const char\\* parity()' {path} | grep -o 'return \"[^\"]*\"' | head -1 | sed 's/^return //'"))

main: i64 = ()
    root = here()
    bin = compiler(root)
    dir = "/tmp/duo-transform-gate"
    bad = 0

    # CONTROL 1 — the runner convicts.
    if script.status("false") == 0
        shout("FAIL — control: status() called `false` a success")
        bad += 1

    # CONTROL 2 — the compiler is here.
    if !present(bin)
        shout("FAIL — no compiler at {bin}; run `zig build` first")
        bad += 1

    if script.status("rm -rf {dir} && mkdir -p {dir}") != 0
        shout("FAIL — could not build the sandbox at {dir}")
        bad += 1

    tier = { "match", "map", "each", "tabulate", "interpolate", "power", "derivepower", "fixpoint", "zip", "permute" }
    named = { "comp.match", "comp.map", "comp.each", "comp.tabulate", "comp.interpolate", "comp.power", "comp.derive.power", "comp.fixpoint", "comp.zip", "comp.permute" }
    hooks = { "__comptimemap", "__comptimematch", "__comptimepower", "__derivepower", "__comptimefixpoint", "__comptimetabulate", "__comptimeinterpolate", "__comptimeeach", "__metacatalog" }
    calls = { "call.inline", "call.specialize", "call.memo", "call.devirtualize", "call.gpu_lower", "call.simd_lower" }

    # CONTROL 3 — every fixture this gate reads is on disk. A grep over a
    # missing file is false for every want, which reads as real failures.
    i = 1
    while i <= tier:len()
        leaf = tier[i]
        f = "{root}/examples/parity/{leaf}.id"
        if !present(f)
            shout("FAIL — missing parity fixture {f}")
            bad += 1
        i += 1
    for extra in { "call", "hot", "pipeline" }
        f = "{root}/examples/parity/{extra}.id"
        if !present(f)
            shout("FAIL — missing fixture {f}")
            bad += 1

    # One strict-mode explain over one fixture answers every registry and
    # dispatch-gate question: the registry is static, the gate is a mode.
    reg = "{dir}/registry.json"
    if !capture("DUO_TRANSFORM_GATE=1 {bin} explain {root}/examples/parity/map.id", reg)
        shout("FAIL — `duo explain` did not run under DUO_TRANSFORM_GATE=1")
        bad += 1

    # CONTROL 4 — held() can answer NO.
    if held(reg, "duo-transform-this-string-does-not-exist")
        shout("FAIL — control: held() matched a string that is not in the output")
        bad += 1

    # D1 — the tier-1 registry is exactly ten, and every entry is registered,
    # native-only, and declares all three parity sites.
    if !held(reg, "\"tier1_count\":10")
        shout("FAIL — D1: the tier-1 registry is not ten transforms")
        bad += 1
    i = 1
    while i <= named:len()
        n = named[i]
        if !row(reg, "\"transform\":\"{n}\"[^}}]*\"registered\":true")
            shout("FAIL — D1: {n} is not registered")
            bad += 1
        if !row(reg, "\"transform\":\"{n}\"[^}}]*\"requires_parity\":true")
            shout("FAIL — D1: {n} does not require a parity test")
            bad += 1
        if !row(reg, "\"transform\":\"{n}\"[^}}]*\"native_only\":true")
            shout("FAIL — D1: {n} has no native-only contract")
            bad += 1
        if !row(reg, "\"transform\":\"{n}\"[^}}]*\"parity_contract_satisfied\":true")
            shout("FAIL — D1: {n} does not declare all three parity sites")
            bad += 1
        # M2 — and it must parse as an EXPRESSION, never as a block directive.
        if !row(reg, "\"transform\":\"{n}\"[^}}]*\"parse_as_expression\":true")
            shout("FAIL — M2: {n} would parse as a directive, not an expression")
            bad += 1
        i += 1

    # D2/D3 — every mapped internal hook clears the dispatch gate, under
    # STRICT mode. `__metacatalog` is in the list on purpose: it is mapped but
    # not tier-1, so it is the row that shows strict mode gating on the
    # registry rather than on the parity list.
    i = 1
    while i <= hooks:len()
        h = hooks[i]
        if !row(reg, "\"hook\":\"{h}\"[^}}]*\"dispatch_allowed\":true")
            shout("FAIL — D2: internal hook {h} is refused by the strict dispatch gate")
            bad += 1
        i += 1

    # D4 — the log names public registry ids only. An internal hook reaching
    # provenance means dispatch logged something the registry never admitted.
    if script.status("sed 's/.*\"transform_provenance\"//; s/\"transform_registry\".*//' {reg} | grep -q '\"transform\":\"__'") == 0
        shout("FAIL — D4: an internal __ hook name reached the provenance log")
        bad += 1
    if !held(reg, "\"schema\":\"transform-provenance-v0\"")
        shout("FAIL — D4: no provenance was projected at all")
        bad += 1

    # C1 — the whole call algebra is registered, native-only, and declares
    # exactly the emit_call site. Enumerated from the enum, so an unregistered
    # new variant shows up rather than going unmeasured.
    i = 1
    while i <= calls:len()
        c = calls[i]
        if !row(reg, "\"transform\":\"{c}\"[^}}]*\"is_call\":true")
            shout("FAIL — C1: {c} is not classed a call transform")
            bad += 1
        if !row(reg, "\"transform\":\"{c}\"[^}}]*\"registered\":true")
            shout("FAIL — C1: {c} is not registered")
            bad += 1
        if !row(reg, "\"transform\":\"{c}\"[^}}]*\"native_only\":true")
            shout("FAIL — C1: {c} has no native-only contract")
            bad += 1
        if !row(reg, "\"transform\":\"{c}\"[^}}]*\"parity_sites\":\\[\"emit_call\"\\]")
            shout("FAIL — C1: {c} does not declare exactly the emit_call site")
            bad += 1
        i += 1

    # C2/C3 — a plain typed call dispatches call.inline and lowers to a direct
    # C call with no boxed invoke anywhere in the translation unit.
    plain = "{dir}/call.json"
    plainc = "{dir}/call.c"
    if !capture("{bin} explain {root}/examples/parity/call.id", plain)
        shout("FAIL — C3: `duo explain` did not run on the call fixture")
        bad += 1
    if !capture("{bin} dump-c {root}/examples/parity/call.id", plainc)
        shout("FAIL — C2: `duo dump-c` did not run on the call fixture")
        bad += 1
    if script.status("grep -q -F 'add(' {plainc}") != 0
        shout("FAIL — C2: the emitted C holds no direct add( call")
        bad += 1
    if script.status("grep -q -F 'lua_invoke' {plainc}") == 0
        shout("FAIL — C2: the direct call still emitted lua_invoke")
        bad += 1
    if !row(plain, "\"transform\":\"call.inline\"[^}}]*\"observed\":true")
        shout("FAIL — C3: call.inline never dispatched")
        bad += 1

    # C4 — the `@hot` discrimination, kept falsifiable. The two fixtures
    # differ only by the attribute, so simd_lower must split them.
    hot = "{dir}/hot.json"
    if !capture("{bin} explain {root}/examples/parity/hot.id", hot)
        shout("FAIL — C4: `duo explain` did not run on the @hot fixture")
        bad += 1
    if !row(hot, "\"transform\":\"call.simd_lower\"[^}}]*\"observed\":true")
        shout("FAIL — C4: the @hot callee did not dispatch call.simd_lower")
        bad += 1
    if row(plain, "\"transform\":\"call.simd_lower\"[^}}]*\"observed\":true")
        shout("FAIL — C4: the NON-@hot twin also dispatched call.simd_lower, so the attribute proves nothing")
        bad += 1

    # C5 — the native pipeline lowers to a direct call, by the exact C line.
    pipec = "{dir}/pipeline.c"
    if !capture("{bin} dump-c {root}/examples/parity/pipeline.id", pipec)
        shout("FAIL — C5: `duo dump-c` did not run on the pipeline fixture")
        bad += 1
    if script.status("grep -q -F 'int64_t y = double(21);' {pipec}") != 0
        shout("FAIL — C5: `21 |> double` did not lower to the direct call double(21)")
        bad += 1
    if script.status("grep -q -F 'lua_invoke' {pipec}") == 0
        shout("FAIL — C5: the pipeline call site emitted lua_invoke")
        bad += 1

    # M3/M4 — three-site parity, per combinator, on the tracked fixture: the
    # top-level, nested-callback and block-body sites must fold to the SAME C
    # string literal, and the run must OBSERVE all three sites.
    i = 1
    while i <= tier:len()
        stem = tier[i]
        n = named[i]
        src = "{root}/examples/parity/{stem}.id"
        out = "{dir}/{stem}.c"
        seen = "{dir}/{stem}.json"
        if !capture("{bin} dump-c {src}", out)
            shout("FAIL — M3: {stem}.id did not compile")
            bad += 1
        top = literal(out, "TOP")
        nested = literal(out, "NESTED")
        block = blocklit(out)
        if top == ""
            shout("FAIL — M3: {n} produced no top-level literal (did it parse as a directive?)")
            bad += 1
        if block == ""
            shout("FAIL — M3: {n} produced no block-body literal")
            bad += 1
        if top != nested
            shout("FAIL — M3: {n} folded differently at top-level and nested-callback sites")
            bad += 1
        if top != block
            shout("FAIL — M3: {n} folded differently at top-level and block-body sites")
            bad += 1
        if !capture("{bin} explain {src}", seen)
            shout("FAIL — M4: `duo explain` did not run on {stem}.id")
            bad += 1
        if !row(seen, "\"transform\":\"{n}\"[^}}]*\"parity_observed\":true")
            shout("FAIL — M4: {n} did not dispatch at all three parity sites")
            bad += 1
        i += 1

    # CONTROL 5 — `parity_observed` can answer NO. Without it M4 would pass
    # for a field frozen at true, and ten assertions would be one constant.
    if !row("{dir}/match.json", "\"transform\":\"comp.zip\"[^}}]*\"parity_observed\":false")
        shout("FAIL — control: a combinator the match fixture never calls still reported full parity")
        bad += 1

    if bad == 0
        shout("PASS — 10 tier-1 registry rows, 9 dispatch hooks, 6 call transforms, 10 three-site parities, 5 controls held")
    bad

os.exit(main())
