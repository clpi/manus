-- duo-mcp/duo_shared.duo — shared MCP tool implementations for Duo MCP servers.
-- Pure Duo, replaces Python duo_mcp_shared.py.
-- Import as `shared = req "duo_shared"` from servers in this directory.

M = {}

script = req "std.script"

ROOT = os.getenv("DUO_ROOT", os.getenv("PWD", "."))
COORD_PATH = ROOT .. "/.agents/AGENT_COORDINATION.md"
PERF_PATH = ROOT .. "/docs/performance.md"
CANON_PATH = ROOT .. "/.agents/AGENT_CANONICAL.md"
DUO_BIN = os.getenv("DUO_BIN", ROOT .. "/zig-out/bin/duo")

-- Section heading that marks the open-gaps/findings table in the
-- coordination buffer. Kept as a constant so callers that search for it
-- (plain/literal find) and callers that emit it stay in sync.
GAPS_MARKER = "## Open Gaps & Findings"

-- Per-process counter for unique finding IDs (same-second collisions).
finding_seq = 0

-- === Coordination ===

fun coordination_read(): str
    if script.fs_exists(COORD_PATH)
        script.fs_read(COORD_PATH)
    else
        "Coordination buffer not yet initialized."
    end
end

fun coordination_update(action: str, agent_id: str, detail: str, files: str)
    timestamp = os.date("%Y-%m-%d %H:%M:%S")
    entry = "\n### [" .. timestamp .. "] " .. agent_id .. " — " .. string.upper(action) .. "\n"
    entry = entry .. "Detail: " .. detail .. "\n"
    if files ~= ""
        entry = entry .. "Files: " .. files .. "\n"
    end
    status = "ACTIVE"
    if action == "claim" then status = "LOCKED"
    elseif action == "release" then status = "UNLOCKED" end
    entry = entry .. "Status: " .. status .. "\n"
    script.fs_write(COORD_PATH, script.fs_read(COORD_PATH) .. entry)
    return "ok: " .. action .. " " .. agent_id
end

fun session_log(agent_id: str, summary: str, detail: str)
    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    entry = "\n| " .. timestamp .. " | " .. agent_id .. " | " .. summary .. " |"
    if detail ~= "" then entry = entry .. " " .. detail .. " |" else entry = entry .. " |" end
    content = script.fs_read(COORD_PATH)
    marker = "## Session log (newest first)"
    pos = string.find(content, marker)
    if pos
        before = string.sub(content, 1, pos + #marker - 1)
        after = string.sub(content, pos + #marker)
        -- find the table header
        table_pos = string.find(after, "| --- | --- | --- |")
        if table_pos
            after = string.sub(after, table_pos + 18)
        end
        content = before .. "\n\n| UTC date | Agent | Summary |\n| --- | --- | --- |\n" .. entry .. after
    else
        content = content .. "\n\n## Session log (newest first)\n\n| UTC date | Agent | Summary |\n| --- | --- | --- |\n" .. entry .. "\n"
    end
    script.fs_write(COORD_PATH, content)
    "ok: session logged"
end

fun open_p0_gaps(): any
    content = coordination_read()
    gaps = {}
    for line in string.gmatch(content, "| G-[^|]+ |[^|]+ | P0 |[^|]+ |[^|]+ |")
        gaps[#gaps + 1] = line
    end
    gaps
end

-- === Build gates ===

fun agent_smoke(timeout: int): any
    smoke_cmd = DUO_BIN .. " run scripts/agent_smoke.duo"
    locked = script.lock_cmd(smoke_cmd)
    rc = 0
    if os.getenv("DUO_LOCK_HELD") == "1"
        rc = script.run(smoke_cmd)
    else
        rc = script.run(locked)
    end
    { exit_code = rc, passed = rc == 0, gate = "agent-smoke" }
end

fun build_run(gate: str, timeout: int): any
    gates = {
        build = "zig build",
        test = "zig build test",
        ["unit-test"] = "zig build unit-test --summary all",
        ["fmt-check"] = "zig fmt src --check",
        ["agent-smoke"] = DUO_BIN .. " run scripts/agent_smoke.duo",
    }
    cmd = gates[gate]
    if cmd == nil then return { error = "unknown gate: " .. gate } end
    rc = 0
    if os.getenv("DUO_LOCK_HELD") == "1"
        rc = script.run(cmd)
    else
        rc = script.run(script.lock_cmd(cmd))
    end
    { exit_code = rc, passed = rc == 0, gate = gate }
end

-- === Repo tooling ===

fun repo_tooling(script_name: str, args: str): any
    full = ""
    if script.fs_exists("scripts/" .. script_name)
        full = DUO_BIN .. " run scripts/" .. script_name
    elseif script.fs_exists(script_name)
        full = DUO_BIN .. " run " .. script_name
    elseif script.fs_exists(ROOT .. "/scripts/" .. script_name)
        full = DUO_BIN .. " run " .. ROOT .. "/scripts/" .. script_name
    else
        return { error = "script not found: " .. script_name }
    end
    if args ~= "" then full = full .. " " .. args end
    rc = script.run(full)
    { exit_code = rc, passed = rc == 0, script = script_name }
end

-- === Native boxing audit ===

fun dump_c(file_path: str): str
    script.capture(DUO_BIN .. " dump-c " .. file_path .. " 2>&1")
end

fun audit_native_boxing(file_path: str): any
    c_code = dump_c(file_path)
    hits = {}
    for _, needle in {"lua_invoke(", "lua_table_get_str_lit(", "lua_Value ", "lua_table_new(", "lua_val_from_"}
        if string.find(c_code, needle)
            hits[#hits + 1] = needle
        end
    end
    -- Check comptime violations in main()
    main_pos = 0
    for i = #c_code, 1, -1
        if string.sub(c_code, i, i + 7) == "int main"
            main_pos = i
            break
        end
    end
    user = ""
    if main_pos > 0 then user = string.sub(c_code, main_pos) else user = string.sub(c_code, -4000) end
    comptime_violations = {}
    for ident, rhs in string.gmatch(user, "const char%* (%w+) = ([^;]+);")
        if string.find(rhs, "lua_")
            comptime_violations[#comptime_violations + 1] = { binding = ident, rhs = string.sub(rhs, 1, 120) }
        end
    end
    const_count = 0
    for _ in string.gmatch(c_code, "const char%*")
        const_count = const_count + 1
    end
    {
        file = file_path,
        boxing_hits = hits,
        boxing_hit_count = #hits,
        comptime_violations = comptime_violations,
        comptime_violation_count = #comptime_violations,
        const_char_ptr_bindings = const_count,
        pass = #comptime_violations == 0,
    }
end

-- === Canonical index ===

fun canonical_index(): str
    if script.fs_exists(CANON_PATH)
        return script.fs_read(CANON_PATH)
    end
    return "Canonical index not found at " .. CANON_PATH
end

fun perf_ledger(): str
    if script.fs_exists(PERF_PATH)
        return string.sub(script.fs_read(PERF_PATH), 1, 10000)
    end
    return "Performance ledger not found at " .. PERF_PATH
end
-- === Benchmark regression analysis ===
-- Interpret a benchmark run's own verdict (the bench script already compares Duo
-- RESULT lines against reference C and prints a pass marker). We extract RESULT
-- rows, detect failure/timing-regression lines, and return a structured verdict.
-- If bench_output is empty, run `zig build <bench_type>` under the build lock and
-- capture stdout. Pattern-free: literal find/sub only (the pattern engine mis-handles
-- checkmarks, ">=", and the "-" in RESULT names).
fun bench_regressions(bench_output: str, bench_type: str): any
    out = bench_output
    bt = bench_type
    if bt == nil then bt = "bench" end
    if bt == "" then bt = "bench" end
    if out == nil then out = "" end
    if out == "" then
        out = script.capture("scripts/duo_lock.sh -- zig build " .. bt .. " 2>&1")
    end
    pass_full = "All benchmarks: results match"
    pass_correct = "benchmark results match reference C"
    passed = false
    if string.find(out, pass_full, 1, true) ~= nil then passed = true end
    if string.find(out, pass_correct, 1, true) ~= nil then passed = true end
    results = {}
    failures = {}
    timing_notes = {}
    lines = string.split(out, "\n")
    i = 1
    while i <= #lines
        ln = lines[i]
        if string.sub(ln, 1, 7) == "RESULT " then
            rest = string.sub(ln, 8)
            sp = string.find(rest, " ", 1, true)
            nm = rest
            val = ""
            if sp ~= nil then
                nm = string.sub(rest, 1, sp - 1)
                val = string.sub(rest, sp + 1)
            end
            _ = table.insert(results, { name = nm, value = val })
        end
        is_fail = false
        if string.find(ln, "mismatch", 1, true) ~= nil then is_fail = true end
        if string.find(ln, "FAIL", 1, true) ~= nil then is_fail = true end
        if string.find(ln, "error:", 1, true) ~= nil then is_fail = true end
        if is_fail then _ = table.insert(failures, ln) end
        if string.find(ln, "regress", 1, true) ~= nil then _ = table.insert(timing_notes, ln) end
        i = i + 1
    end
    summary = ""
    if passed then
        summary = "PASS: " .. #results .. " RESULT lines verified; Duo .lua/.duo <= C gate met."
    else
        summary = "CHECK: pass marker absent; " .. #results .. " RESULT lines; " .. #failures .. " failure line(s); " .. #timing_notes .. " timing note(s)."
    end
    return {
        passed = passed,
        bench_type = bt,
        result_count = #results,
        results = results,
        failure_count = #failures,
        failures = failures,
        timing_notes = timing_notes,
        summary = summary,
    }
end

-- === Open performance gaps ===
-- Surface perf / native-lowering / codegen gaps that are still open in the
-- cross-agent gap buffer, plus a performance.md excerpt for context.
fun perf_gaps(): any
    content = coordination_read()
    lines = string.split(content, "\n")
    gaps = {}
    i = 1
    while i <= #lines
        ln = lines[i]
        if string.sub(ln, 1, 4) == "| F-" then
            kind_match = false
            if string.find(ln, "perf_gap", 1, true) ~= nil then kind_match = true end
            if string.find(ln, "native_lowering", 1, true) ~= nil then kind_match = true end
            if string.find(ln, "codegen_gap", 1, true) ~= nil then kind_match = true end
            status_open = false
            if string.find(ln, "| open |", 1, true) ~= nil then status_open = true end
            if kind_match
                if status_open then _ = table.insert(gaps, ln) end
            end
        end
        i = i + 1
    end
    perf = ""
    if script.fs_exists(PERF_PATH) then
        perf = string.sub(script.fs_read(PERF_PATH), 1, 4000)
    end
    return {
        open_perf_gap_count = #gaps,
        gaps = gaps,
        perf_ledger_excerpt = perf,
    }
end
-- === Codegen-pitfall audit ===
-- Detect the known silent-correctness codegen bugs (F-13813-2 call-as-tail
-- premature return; F-13813-3 nil-init void* inference) in a .duo source file,
-- with the verified workaround for each. Protects every duo developer from
-- spending hours on these. Literal scans only (pattern engine is unreliable).
fun audit_codegen_pitfalls(file_path: str): any
    if not script.fs_exists(file_path) then
        return { error = "file not found: " .. file_path }
    end
    src = script.fs_read(file_path)
    lines = string.split(src, "\n")
    findings = {}
    i = 1
    while i <= #lines
        ln = lines[i]
        tr = str_trim(ln)
        -- F-13813-3: `= nil` init risks void* type inference
        if string.find(tr, "= nil", 1, true) ~= nil then
            _ = table.insert(findings, {
                line = i,
                rule = "F-13813-3 nil-init",
                risk = "sema infers void*; later typed assignment fails to compile or mis-codes",
                fix = "initialize with a typed sentinel (\"\" / 0 / {} / false)",
            })
        end
        -- F-13813-2: a bare call statement as the LAST statement of an if/for/while
        -- block emits `return call(...)`, exiting the enclosing function early.
        is_tail = false
        if i < #lines then
            j = i + 1
            nxt = ""
            while j <= #lines
                nxt = str_trim(lines[j])
                if #nxt > 0 then break end
                j = j + 1
            end
            -- Prefix checks via string.find (NUMBER result); string == is
            -- unreliable inside while loops (duo codegen bug).
            if string.find(nxt, "end", 1, true) == 1 then is_tail = true end
            if string.find(nxt, "else", 1, true) == 1 then is_tail = true end
            if string.find(nxt, "elseif", 1, true) == 1 then is_tail = true end
        end
        if is_tail then
            bare_call = false
            has_assign = string.find(tr, " = ", 1, true) ~= nil
            starts_return = string.find(tr, "return ", 1, true) == 1
            if (not has_assign) and (not starts_return) then
                paren = string.find(tr, "(", 1, true)
                if paren ~= nil and paren > 1 then
                    head = string.sub(tr, 1, paren - 1)
                    -- head must be a bare identifier/path; validate via string.byte
                    -- (number comparison — string == fails inside loops).
                    head_ok = true
                    k = 1
                    while k <= #head
                        code = string.byte(head, k)
                        ok_c = false
                        if code >= 48 and code <= 57 then ok_c = true end
                        if code >= 65 and code <= 90 then ok_c = true end
                        if code >= 97 and code <= 122 then ok_c = true end
                        if code == 46 then ok_c = true end
                        if code == 95 then ok_c = true end
                        if not ok_c then head_ok = false end
                        k = k + 1
                    end
                    if head_ok then bare_call = true end
                end
            end
            if bare_call then
                _ = table.insert(findings, {
                    line = i,
                    rule = "F-13813-2 call-as-tail",
                    risk = "codegen emits premature return; enclosing function exits here",
                    fix = "prefix with `_ = `  (e.g.  `_ = table.insert(t, v)`)",
                })
            end
        end
        i = i + 1
    end
    return {
        file = file_path,
        finding_count = #findings,
        findings = findings,
        summary = "Scanned " .. #lines .. " lines; " .. #findings .. " codegen-pitfall(s).",
    }
end
-- === Exponential evaluator ===
-- Analyze Duo source for metaprogramming opportunities and emit @comp.* suggestions.
-- Pure-pattern detection; no lua_Value ever produced. Optionally audits native
-- boxing when file_path points at a real .duo file.
TYPE_SUFFIXES = { "i64", "f64", "i32", "f32", "str", "bool", "u64", "u32" }

fun str_trim(s: str): str
    -- Uses string.byte + NUMBER comparison, not string == / ~=. Duo codegen
    -- mis-compares string.sub results inside while loops (c == " " is false for
    -- a space). Number comparison (byte ~= 32) is reliable. Space=32, tab=9.
    a = 1
    b = #s
    while a <= b
        code = string.byte(s, a)
        if code ~= 32 and code ~= 9 then break end
        a = a + 1
    end
    while b >= a
        code = string.byte(s, b)
        if code ~= 32 and code ~= 9 then break end
        b = b - 1
    end
    return string.sub(s, a, b)
end

fun exponential_evaluate(code: str, file_path: str): any
    suggestions = {}
    lines = string.split(code, "\n")

    -- Detector A: manually monomorphized functions (fun name_SUFFIX(...))
    -- Pattern-free: duo's %s+ and [..] classes are unreliable, so we use find+sub.
    bases = {}
    for i = 1, #lines
        t = str_trim(lines[i])
        nm = ""
        if string.sub(t, 1, 4) == "fun "
            pp = string.find(t, "%(")
            if pp and pp > 5
                nm = str_trim(string.sub(t, 5, pp - 1))
            end
        end
        if #nm > 0
            for _, suf in TYPE_SUFFIXES
                slen = #suf + 1
                if #nm > slen and string.sub(nm, -slen) == "_" .. suf
                    base = string.sub(nm, 1, #nm - slen)
                    bases[base] = bases[base] or {}
                    bases[base][suf] = i
                end
            end
        end
    end
    for base, tys in bases
        cnt = 0
        first = 0
        for ty, ln in tys
            cnt = cnt + 1
            if first == 0 or ln < first then first = ln end
        end
        if cnt >= 2
            _ = table.insert(suggestions, {
                kind = "exponential_opportunity",
                line = first,
                construct = "@comp.map / @comp.derive",
                rationale = "'" .. base .. "' is hand-monomorphized across " .. tostring(cnt) .. " types; one @comp.map emits all variants with zero lua_Value.",
                multiplier = "O(" .. tostring(cnt) .. " decls <= 1 call)",
            })
        end
    end

    -- Detector B: runtime type-string dispatch (if t == "i64" ... elseif "f64")
    dispatch_hits = 0
    dispatch_line = 0
    for i = 1, #lines
        if string.find(lines[i], '== "i64"') or string.find(lines[i], '== "f64"') or string.find(lines[i], '== "i32"') or string.find(lines[i], '== "f32"')
            dispatch_hits = dispatch_hits + 1
            if dispatch_line == 0 then dispatch_line = i end
        end
    end
    if dispatch_hits >= 2
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = dispatch_line,
            construct = "@comp.select / @comp.product",
            rationale = "Runtime type-string branching (" .. tostring(dispatch_hits) .. " arms) collapses to a compile-time type dispatch.",
            multiplier = "O(branches -> 0 runtime cost)",
        })
    end

    -- Detector C: >=3 consecutive incrementing indexed writes (arr[1]=, arr[2]=, ...)
    run_len = 0
    run_prev = -1
    run_start = 0
    c_line = 0
    for i = 1, #lines
        t = str_trim(lines[i])
        b1 = string.find(t, "%[")
        b2 = string.find(t, "%]")
        eq = string.find(t, "=")
        if b1 and b2 and b2 > b1 and eq and eq > b2
            idx_s = str_trim(string.sub(t, b1 + 1, b2 - 1))
            idx = tonumber(idx_s)
            if idx
                if run_len > 0 and idx == run_prev + 1
                    run_len = run_len + 1
                else
                    run_len = 1
                    run_start = i
                end
                run_prev = idx
                if run_len >= 3 and c_line == 0 then c_line = run_start end
            else
                run_len = 0
            end
        else
            run_len = 0
        end
    end
    if c_line > 0
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = c_line,
            construct = "@comp.compile.unroll",
            rationale = "Sequential indexed writes form a bounded loop; @comp.compile.unroll expands it at compile time.",
            multiplier = "O(n statements -> 1 loop)",
        })
    end

    -- Detector D: repeated record-type boilerplate (>=3 'type X = {')
    type_defs = 0
    type_line = 0
    for i = 1, #lines
        t = str_trim(lines[i])
        if string.sub(t, 1, 5) == "type " and string.find(t, "{") and string.find(t, "=")
            type_defs = type_defs + 1
            if type_line == 0 then type_line = i end
        end
    end
    if type_defs >= 3
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = type_line,
            construct = "@comp.derive.bundle",
            rationale = tostring(type_defs) .. " record types; @comp.derive.bundle generates shared trait impls for all in one annotation.",
            multiplier = "O(types x traits <= 1 annotation)",
        })
    end

    -- Detector E: comptime-foldable literal arithmetic (var = digits op digits, no vars)
    for i = 1, #lines
        t = str_trim(lines[i])
        eq = string.find(t, "=")
        if eq and eq > 1 and string.sub(t, eq, eq + 1) ~= "=="
            rhs = str_trim(string.sub(t, eq + 1))
            if not string.find(rhs, "[%a]") and (string.find(rhs, "[%*]") or string.find(rhs, "[%+]") or string.find(rhs, "[/]"))
                _ = table.insert(suggestions, {
                    kind = "ergonomic_gap",
                    line = i,
                    construct = "@(expr)",
                    rationale = "Constant arithmetic '" .. rhs .. "' folds at compile time with @( ... ).",
                    multiplier = "O(1 runtime -> 0)",
                })
            end
        end
    end

    -- Annotated preview: prepend a discovery header listing every opportunity.
    optimized = code
    if #suggestions > 0
        optimized = "-- @comp exponential-eval: " .. tostring(#suggestions) .. " opportunity(s)\n"
        for _, s in suggestions
            optimized = optimized .. "-- [L" .. tostring(s.line) .. "] " .. s.construct .. ": " .. s.rationale .. "\n"
        end
        optimized = optimized .. code
    end

    result = {
        file = file_path or "<inline>",
        suggestion_count = #suggestions,
        suggestions = suggestions,
        optimized_preview = optimized,
    }
    if file_path and file_path ~= "" and script.fs_exists(file_path)
        result.boxing = audit_native_boxing(file_path)
    end
    result
end

-- === Exponential mentoring: Onboarding guidance for metaprogramming ===

fun exponential_onboard(question: str, code: str): any
    -- Step-by-step guidance for leveraging Duo's exponential metaprogramming
    questions = {
        "what is exponential metaprogramming" = [[
EXPOTENTIAL METAPROGRAMMING IN DUO
=====================================

The goal: Write LESS code, get MORE optimized native output.

Key @comp.* combinators (no underscores!):

1. @comp.map(type, callback) — Transform all types
   - One callback handles N types
   - Native fold → no lua_Value
   - Example: @comp.map(i32, f32, f64, my_func) generates specialized versions

2. @comp.derive.all(Type) — Auto-generate boilerplate
   - One declarative type → all getters/setters/methods
   - Native C emission
   - Example: @comp.derive.all(MyStruct) gives you .id(), .set_id(), etc.

3. @comp.burst(pattern) — Pattern expansion
   - One template → N concrete programs
   - For SIMD, unrolled loops, etc.

4. @comp.tensor(shape, dtype) — Tensor operations
   - Compile-time shape checking
   - @device(.auto) for CPU/CUDA/Metal

When to use: When you write nearly-identical code with minor variations
Never use: Single instance code, or when you need runtime flexibility
]],
        "when to use derive" = [[
USE @comp.derive.* WHEN:
- You have regular data structures with repeating patterns
- You need type-safe accessors without typing them all
- The structure is stable (fields don't change often)

EXAMPLE:
Before (manual):
```duo
fun user_get_id(u: User): i64
    u.id
end
fun user_get_name(u: User): str
    u.name
end
-- repeat for all types and fields...
```

After (exponential):
```duo
@comp.derive.all(User, Post, Comment)
-- ONE LINE generates all getters/setters for 3 types
```
]],
        "how map differs from regular function" = [[
@comp.MAP IS DIFFERENT FROM A REGULAR FUNCTION:

Regular function:
- One compile-time → one runtime call
- Must be called N times for N types

@comp.map:
- One declaration → N specialized native functions
- Each type gets optimized native code
- No runtime dispatch, no lua_Value

Example:
@comp.map(i32, i64, f32, f64, abs)
→ 4 native functions tailored for each type
→ No branching, no boxing, full optimization
]],
    }
    
    if question == "" or question == nil
        return { guidance = questions["what is exponential metaprogramming"], question = question }
    end
    
    q_lower = string.lower(question)
    for key, val in questions
        if string.find(q_lower, string.lower(key), 1, true) ~= nil
            return { guidance = val, question = question, matched = key }
        end
    end
    
    { error = "Question not recognized. Try: " .. table.concat({k for k in questions}, ", ") }
end

fun combinator_info(path: str): any
    result = {
        map = {
            name = "@comp.map",
            complexity = "O(n types × fields per type)",
            description = "Transform all types in a collection with a single callback",
            native_fold = true,
            example = [[
                fun add_one(x: i64): i64
                    x + 1
                end
                
                -- Generates specialized add_one for i32, i64, f32, f64
                @comp.map(i32, i64, f32, f64, add_one)
            ]],
        },
        ["derive.all"] = {
            name = "@comp.derive.all",
            complexity = "O(n types × fields per type)",
            description = "Auto-generate getters, setters, and methods for all fields",
            native_fold = true,
            example = [[
                concept User
                    id: i64
                    name: str
                end
                
                -- Generates: get_id, get_name, set_id, set_name for User
                @comp.derive.all(User)
            ]],
        },
        tensor = {
            name = "@comp.tensor",
            complexity = "O(n dimensions)",
            description = "Tensor operations with compile-time shape checking",
            native_fold = true,
            device_dispatch = true,
            example = [[
                T = @comp.tensor([256, 256], f32)
                result = @comp.tensor.matmul(T, T)  -- Native BLAS
            ]],
        },
        ladder = {
            name = "@comp.ladder",
            complexity = "O(1) string output",
            description = "Returns the exponential metaprogramming hierarchy",
            example = [[
                print(@comp.ladder())
                -- Output: map:O(n) derive:O(n×f) tensor:O(n³) ...
            ]],
        },
    }
    
    if path == "" or path == nil
        return { combinators = table.keys(result), info = "Available combinators: " .. table.concat(table.keys(result), ", ") }
    end
    
    if result[path]
        return result[path]
    end
    
    { error = "Unknown combinator: " .. path .. ". Available: " .. table.concat(table.keys(result), ", ") }
end

-- ====================================

fun file_finding(kind: str, title: str, detail: str, priority: str, files: str): str
    -- IDs must be unique within a second (batch calls share os.time()); use a
    -- per-process counter so same-second filings never collide.
    finding_seq = finding_seq + 1
    ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
    id = "F-" .. tostring(os.time() % 100000) .. "-" .. tostring(finding_seq)
    pr = priority
    if pr == "" or pr == nil then pr = "P1" end
    row = "| " .. id .. " | " .. title .. " | " .. pr .. " | " .. kind .. " | " .. ts .. " | open | " .. detail .. " |"
    if files ~= "" then row = row .. " Files: " .. files .. " |" end
    content = coordination_read()
    hdr = "| ID | Title | Priority | Kind | Logged | Status | Detail |"
    -- Use plain=true (literal) finds: the marker contains '-', the detail may
    -- contain '%', both of which are Lua-pattern metacharacters and would
    -- corrupt a pattern-based find/gsub.
    mpos = string.find(content, GAPS_MARKER, 1, true)
    if mpos ~= nil then
        hpos = string.find(content, hdr, mpos, true)
        if hpos ~= nil then
            hlen = string.len(hdr)
            content = string.sub(content, 1, hpos + hlen - 1) .. "\n" .. row .. string.sub(content, hpos + hlen)
        else
            content = content .. "\n" .. row .. "\n"
        end
    else
        content = content .. "\n\n" .. GAPS_MARKER .. "\n\n" .. hdr .. "\n| --- | --- | --- | --- | --- | --- | --- |\n" .. row .. "\n"
    end
    script.fs_write(COORD_PATH, content)
    return "ok: filed " .. id .. " (" .. kind .. ")"
end

fun agent_gaps_update(action: str, agent_id: str, gap_id: str, kind: str, title: str, detail: str, priority: str, files: str): str
    act = action
    if act == nil or act == "" then act = "open" end
    if act == "open"
        return file_finding(kind, title, detail, priority, files)
    end
    ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
    entry = "\n| " .. ts .. " | " .. agent_id .. " | gap-" .. act .. " | " .. gap_id .. ": " .. detail .. " |"
    content = coordination_read()
    marker = "### Findings log (append-only, newest first)"
    table_marker = "| UTC | Agent | Action | Detail |\n| --- | --- | --- | --- |"
    mpos = string.find(content, marker, 1, true)
    if mpos ~= nil
        hpos = string.find(content, table_marker, mpos, true)
        if hpos ~= nil
            content = string.sub(content, 1, hpos + string.len(table_marker) - 1) .. entry .. string.sub(content, hpos + string.len(table_marker))
        else
            content = content .. entry .. "\n"
        end
    else
        content = content .. "\n\n" .. marker .. "\n\n" .. table_marker .. entry .. "\n"
    end
    script.fs_write(COORD_PATH, content)
    return "ok: gap " .. act .. " " .. gap_id
end


