      if (comparisonOperators.has(node.operator) && left.type !== right.type) throw new IdolicError('comparison requires matching types', node.span, 'E203');
      if (booleanOperators.has(node.operator) && (left.type !== 'boolean' || right.type !== 'boolean')) throw new IdolicError('boolean operator requires booleans', node.span, 'E206');
