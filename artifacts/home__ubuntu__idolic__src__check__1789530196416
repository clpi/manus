import { IdolicError } from './errors.mjs';

const integerOperators = new Set(['+', '-', '*', '/']);
const comparisonOperators = new Set(['==', '!=', '<', '<=', '>', '>=']);
const booleanOperators = new Set(['&&', '||']);

function apply(operator, left, right) {
  if (integerOperators.has(operator)) {
    if (operator === '/' && right === 0) throw new IdolicError('division by zero', null, 'E204');
    if (operator === '+') return left + right;
    if (operator === '-') return left - right;
    if (operator === '*') return left * right;
    return Math.trunc(left / right);
