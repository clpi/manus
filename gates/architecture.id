# gates/architecture - semantic normalization architecture gate, C0 section 65.
#
# A grammar face may survive for readable density. It may not survive as the
# thing sema, optimization or lowering reasons about. This census separates
# five classifications instead of treating every syntax-shaped word alike:
# parser-only, provenance-only, physical-realization-only, documented
# irreducible meaning, and migration debt. The first three are bounded; the
# fourth is deliberately zero; every debt row ratchets down.
#
# The rows count LINES, not matches. The gate scans the proposed staged index,
# not the shared dirty worktree, so another session cannot move this run's
# evidence. These are migration censuses, never semantic verdicts. GAP-124 owns
# the graph queries that make world, subject, vocabulary, sentinel and control
# findings authoritative. Host/world boundary is NOT spelling-census here.
# Use gates/host.id + gates/idiom dot(world)(code) on ADDED lines; GAP-124 owns semantics.
#
# GAP-119 owns this gate's 34 process-capture namespace calls. Execution has
# no admitted subject/world/result vocabulary yet, and GAP-117 prevents hiding
# the repetition behind a canonically result-typed helper. The blocked row
# makes that bootstrap debt visible and monotone instead of aliasing it away.

# Bootstrap capture — direct-native gatecap (idol_io_bootstrap.c).
capture: str = (shellline: str)
    gatecap(shellline)


q = "'"

digits: i64 = (text: str)
    if text == nil or text:len() == 0
        return -1
    v = 0
    i = 1
    n = text:len()
    while i <= n
        c = text:sub(i, i)
        if c >= "0" and c <= "9"
            v = v * 10 + (c:byte() - 48)
            i += 1
        else
            if c:byte() == 10 or c:byte() == 13 or c:byte() == 32 or c:byte() == 9
                i += 1
            else
                return -1
    v

ascount: i64 = (cmd: str)
    digits(capture(cmd))

chomp: str = (text: str)
    if text == nil
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

tail: str = (cmd: str)
    chomp(capture(cmd))

all = "'src/*.zig'"
front = "src/ast.zig src/parser.zig src/macro_expand.zig"
after = "'src/*.zig' ':(exclude)src/ast.zig' ':(exclude)src/parser.zig' ':(exclude)src/macro_expand.zig' ':(exclude)src/pretty.zig'"
proven = "src/ast.zig src/parser.zig src/pretty.zig"
duofiles = "'*.id' ':(exclude)gates/architecture.id' ':(exclude)gates/idiom.id' ':(exclude)scripts/ingress/*'"

astpat = "ast\\.(Expr|Stmt|BinOp|UnOp|IfExpr|ElseIf|ListComprehension)"
dispatchpat = "\\.(if_stmt|while_loop|repeat_loop|num_for|gen_for|brk|cont|ret|binop|unop|call|method_call|index|field|if_expr|contains_expr)[[:space:],]*=>"
parserpat = "pub const (BinOp|UnOp|IfExpr|ListComprehension|Stmt)[[:space:]=]"
provenpat = "InvocationForm|\\.form[[:space:]]*(==|!=)"
facepat = "if \\(c\\.form != \\.braced\\)"
graphpat = "^[[:space:]]+(call|directive|pipeline),$"
physicalpat = "^[[:space:]]+(br|br_if|br_if_not|ret|ret_record),$"
irpat = "^[[:space:]]+(const_(i64|f64|str|req)|load_(local|field|index|global)|store_(local|field|index)|call_(direct|extern)|mov_arg|fp_mov_arg|br_if|br_if_not|ret_record|hw_(fence|spin|unary)|str_len|binop|cmp),$"
taxpat = "pub const (Op|BinOpTag|FieldKind)[[:space:]=]"
apipat = "pub const (CallSite|CallTransform|ReturnPack|ReturnConsumption|CalleeKind|CallShape|CallReturnSpecialization)[[:space:]=]"
newpat = "pub const (IfStmt|WhileStmt|ForStmt|BinaryExpr|UnaryExpr|CallExpr|IndexExpr|MemberExpr|ReturnStmt|BreakStmt|ContinueStmt)[[:space:]=]"
namespacepat = "std\\.(os|fs|mem)\\.[a-z][a-z0-9]*\\("
stdpat = "(^|[^a-z0-9.])std\\.[a-z]"
suffixpat = "^[[:space:]]*[a-z][a-z0-9]*[[:space:]]*=[[:space:]]*\\([^)]*\\)[[:space:]]*:[[:space:]]*[a-z][a-z0-9]*(\\([^)]*\\))?[[:space:]]*$"
envemptypat = "(getenv|envor|env_or|std\\.script\\.getenv).*\"\"|\"\".*(getenv|envor|env_or|std\\.script\\.getenv)"
nilpat = "^[[:space:]]*if .*(!=|==) nil"
notpat = "(^|[[:space:]])(if not |and not |or not |\\(not )"
existpat = "^[[:space:]]*if .*exists\\("
processpat = "(io\\.popen|io:popen|:popen\\(|popen\\(|std\\.proc\\.capture\\()"
processadmitpat = "process[[:space:]]*=[[:space:]]*lib\\.process"
processnspat = "process\\.(run|capture|exit|chomp)\\("
longbracketpat = "\\[\\["
boxpat = "lua_Value|lua_invoke|lua_require"
luanspat = "(^|[^a-z0-9.])(table|string|math|list|array)\\.[a-z]"
luansneg = "xs:push|text:sub|x:sqrt"

