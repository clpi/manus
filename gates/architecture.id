    cmd = "printf {q}%s\\n{q} {q}{vocab_positive}{q} | grep -c -E {q}{irpat}{q}"
    if ascount(cmd) != 1
        print("(semanticgate, control, ir, missed duplicate call identity)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{vocab_negative}{q} | grep -c -E {q}{irpat}{q}"
    if ascount(cmd) != 0
