    cmd = "printf {q}%s\\n{q} {q}out = process.capture(\\\"echo\\\"){q} | grep -q -E {q}{processnspat}{q} && printf {q}%s\\n{q} {q}out = std.script.capture(\\\"echo\\\"){q} | grep -q -E {q}std\\\\.script\\\\.capture\\\\({q} && printf 1"
