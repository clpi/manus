    cmd = "printf {q}%s\\n{q} {q}table.insert(t,v){q} | grep -q table\\\\. && printf {q}%s\\n{q} {q}list.append(t,v){q} | grep -q list\\\\. && printf 1"
    if ascount(cmd) != 1
