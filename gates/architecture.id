        unclassified = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{astpat}{q} -- {after} 2>/dev/null | wc -l | awk '{print $1}'"
        consumer = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{dispatchpat}{q} -- {after} 2>/dev/null | wc -l | awk '{print $1}'"
        dispatch = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{facepat}{q} -- {after} 2>/dev/null | wc -l | awk '{print $1}'"
        face = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{graphpat}{q} -- src/semantic_graph.zig 2>/dev/null | wc -l | awk '{print $1}'"
        graph = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{irpat}{q} -- src/duo_native_ir.zig 2>/dev/null | wc -l | awk '{print $1}'"
        ir = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{taxpat}{q} -- src/duo_native_ir.zig 2>/dev/null | wc -l | awk '{print $1}'"
        taxonomy = ascount(cmd)
        cmd = "files=$(git ls-files -- {all}); if test -z \"$files\"; then printf 99999999; else a=$(git grep --cached -h -E {q}{apipat}{q} -- {after} 2>/dev/null | wc -l); b=$(git grep --cached -h {q}lua_Value{q} -- $files 2>/dev/null | wc -l); printf {q}%s{q} $((a * 10000 + b)); fi"
        api = ascount(cmd)
        combined = api
        boxed = combined % 10000
        api = (combined - boxed) / 10000
        cmd = "git grep --cached -h -E {q}{namespacepat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*(--|source[[:space:]]*=|\"){q} | wc -l | awk '{print $1}'"
        namespace = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{stdpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*(--|source[[:space:]]*=|\"){q} | wc -l | awk '{print $1}'"
        standard = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{suffixpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l | awk '{print $1}'"
        suffix = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{envemptypat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l | awk '{print $1}'"
        envempty = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{nilpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l | awk '{print $1}'"
        nilabsence = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{notpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l | awk '{print $1}'"
        keywordnot = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{existpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*--{q} | wc -l | awk '{print $1}'"
        existence = ascount(cmd)
        cmd = "git show :gates/architecture.id | grep -E {q}std[.]proc[.]capture\\({q} | grep -v -E {q}^[[:space:]]*positive[[:space:]]*={q} | wc -l | awk '{print $1}'"
        bootstrap = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{processadmitpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*(--|source[[:space:]]*=|\"){q} | wc -l | awk '{print $1}'"
        processadmit = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{processnspat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*(--|source[[:space:]]*=|\"){q} | wc -l | awk '{print $1}'"
        processns = ascount(cmd)
        cmd = "git grep --cached -h -E {q}{longbracketpat}{q} -- {duofiles} 2>/dev/null | grep -v -E {q}^[[:space:]]*(\\\\-\\\\-|source[[:space:]]*=|\"){q} | wc -l | awk '{print $1}'"
        longbracket = ascount(cmd)
        cmd = "git ls-files '*.id' | grep -c {q}_{q}"
        fileword = ascount(cmd)

        over = 0
        print("(semanticgate, count, parser-only, faces, {parser}, cap=5)")
        if parser > 5 over += 1
        print("(semanticgate, count, provenance, faces, {provenance}, cap=10)")
        if provenance > 10 over += 1
        print("(semanticgate, count, provenance, render, {render}, cap=26)")
        if render > 26 over += 1
        print("(semanticgate, count, physical, control, {physical}, cap=5)")
        if physical > 5 over += 1
        print("(semanticgate, count, irreducible, documented, 0, cap=0)")
        print("(semanticgate, count, unclassified, syntax, {unclassified}, cap=0)")
        if unclassified > 0 over += 1
        print("(semanticgate, count, migration, consumers, {consumer}, cap=815)")
        if consumer > 815 over += 1
        print("(semanticgate, count, migration, dispatch, {dispatch}, cap=723)")
        if dispatch > 723 over += 1
        print("(semanticgate, count, migration, faceauth, {face}, cap=2)")
        if face > 2 over += 1
        print("(semanticgate, count, migration, graphkind, {graph}, cap=1)")
        if graph > 1 over += 1
        print("(semanticgate, census, {vocab_state}, {vocab_id}, {ir}, cap={vocab_cap}, law={vocab_law}, owner={vocab_owner})")
        if ir > vocab_cap over += 1
        print("(semanticgate, census, {taxonomy_state}, {taxonomy_id}, {taxonomy}, cap={taxonomy_cap}, law={taxonomy_law}, owner={taxonomy_owner})")
        if taxonomy > taxonomy_cap over += 1
        print("(semanticgate, census, {boxed_state}, {boxed_id}, {boxed}, cap={boxed_cap}, law={boxed_law}, owner={boxed_owner})")
        if boxed > boxed_cap over += 1
        print("(semanticgate, count, migration, api, {api}, cap=8)")
        if api > 8 over += 1
        print("(semanticgate, census, {namespace_state}, {namespace_id}, {namespace}, cap={namespace_cap}, law={namespace_law}, owner={namespace_owner})")
        if namespace > namespace_cap over += 1
        print("(semanticgate, census, {standard_state}, {standard_id}, {standard}, cap={standard_cap}, law={standard_law}, owner={standard_owner})")
        if standard > standard_cap over += 1
        print("(semanticgate, census, {result_state}, {result_id}, {suffix}, cap={result_cap}, law={result_law}, owner={result_owner})")
        if suffix > result_cap over += 1
        print("(semanticgate, census, {empty_state}, {empty_id}, {envempty}, cap={empty_cap}, law={empty_law}, owner={empty_owner})")
        if envempty > empty_cap over += 1
        print("(semanticgate, census, {absence_state}, {absence_id}, {nilabsence}, cap={absence_cap}, law={absence_law}, owner={absence_owner})")
        if nilabsence > absence_cap over += 1
        print("(semanticgate, census, {negation_state}, {negation_id}, {keywordnot}, cap={negation_cap}, law={negation_law}, owner={negation_owner})")
        if keywordnot > negation_cap over += 1
        print("(semanticgate, census, {existence_state}, {existence_id}, {existence}, cap={existence_cap}, law={existence_law}, owner={existence_owner})")
        if existence > existence_cap over += 1
        print("(semanticgate, census, {file_state}, {file_id}, {fileword}, cap={file_cap}, law={file_law}, owner={file_owner})")
        if fileword > file_cap over += 1
        print("(semanticgate, census, {process_state}, {process_id}, {bootstrap}, cap={process_cap}, law={process_law}, owner={process_owner})")
        if bootstrap > process_cap over += 1
        print("(semanticgate, census, {processadmit_state}, {processadmit_id}, {processadmit}, cap={processadmit_cap}, law={processadmit_law}, owner={processadmit_owner})")
        if processadmit > processadmit_cap over += 1
        print("(semanticgate, census, {processns_state}, {processns_id}, {processns}, cap={processns_cap}, law={processns_law}, owner={processns_owner})")
        if processns > processns_cap over += 1
        print("(semanticgate, census, {longbracket_state}, {longbracket_id}, {longbracket}, cap={longbracket_cap}, law={longbracket_law}, owner={longbracket_owner})")
        if longbracket > longbracket_cap over += 1
        print("(semanticgate, blocked, {blocked_world_state}, {blocked_world_id}, owner={blocked_world_owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked_subject_state}, {blocked_subject_id}, owner={blocked_subject_owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked_vocab_state}, {blocked_vocab_id}, owner={blocked_vocab_owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked_sentinel_state}, {blocked_sentinel_id}, owner={blocked_sentinel_owner}, evidence=graph-required)")
        print("(semanticgate, blocked, {blocked_control_state}, {blocked_control_id}, owner={blocked_control_owner}, evidence=graph-required)")

        if over > 0
            print("(semanticgate, fail, ratchet, raised, lower implementation or justify law change)")
            code = 1
        else
            print("(semanticgate, pass, law.surface.zero, staged census classified, debt may only descend, semantic verdicts remain gap.124)")
    if code != 0
        print("(semanticgate, blocked, canonicality, unresolved, see structured findings above)")
    code
