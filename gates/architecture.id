        code = 3
    cmd = "printf {q}%s\\n{q} {q}{syntax_positive}{q} | grep -c -E {q}{newpat}{q}"
    if ascount(cmd) != 1
        print("(semanticgate, control, unclassified, missed new syntax kind)")
        code = 3
    cmd = "printf {q}%s\\n{q} {q}{syntax_negative}{q} | grep -c -E {q}{newpat}{q}"
    if ascount(cmd) != 0
        print("(semanticgate, control, unclassified, convicted semantic kind)")
