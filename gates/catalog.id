# gates/catalog.id — admitted native relation census (projection producer).
#
# Consumed by gates/admission.id (tables inlined there — no req). Constitution
# this table is the text projection until GAP-124 graph queries replace it.
#
# Each row: relation id, typical subject class, world/effect hints, law, owner.

catalog = {
    push = { id = "push", subject = "collection", world = "", effect = "mutate", law = "law.collection.push", owner = "graph" },
    remove = { id = "remove", subject = "collection", world = "", effect = "mutate", law = "law.collection.remove", owner = "graph" },
    sort = { id = "sort", subject = "collection", world = "", effect = "mutate", law = "law.collection.sort", owner = "graph" },
    keys = { id = "keys", subject = "collection", world = "", effect = "observe", law = "law.collection.keys", owner = "graph" },
    join = { id = "join", subject = "collection", world = "", effect = "observe", law = "law.collection.join", owner = "graph" },
    len = { id = "len", subject = "value", world = "", effect = "observe", law = "law.axis.level", owner = "graph" },
    sub = { id = "sub", subject = "text", world = "", effect = "observe", law = "law.text.slice", owner = "graph" },
    find = { id = "find", subject = "text", world = "", effect = "observe", law = "law.text.find", owner = "graph" },
    match = { id = "match", subject = "text", world = "", effect = "observe", law = "law.text.match", owner = "graph" },
    gsub = { id = "gsub", subject = "text", world = "", effect = "mutate", law = "law.text.gsub", owner = "graph" },
    byte = { id = "byte", subject = "text", world = "", effect = "observe", law = "law.text.byte", owner = "graph" },
    has = { id = "has", subject = "text", world = "", effect = "observe", law = "law.text.has", owner = "graph" },
    read = { id = "read", subject = "stream|path|stdin", world = "io", effect = "observe", law = "law.relation.read", owner = "graph" },
    write = { id = "write", subject = "stream|path|sink", world = "io", effect = "mutate", law = "law.relation.write", owner = "graph" },
    open = { id = "open", subject = "path", world = "io", effect = "mutate", law = "law.world.grant", owner = "graph" },
    close = { id = "close", subject = "stream", world = "io", effect = "mutate", law = "law.stream.close", owner = "graph" },
    exists = { id = "exists", subject = "path", world = "io", effect = "observe", law = "law.path.exists", owner = "graph" },
    to = { id = "to", subject = "value", world = "", effect = "convert", law = "law.convert.descriptor", owner = "graph" },
    sqrt = { id = "sqrt", subject = "number", world = "", effect = "observe", law = "law.number.sqrt", owner = "graph" },
    abs = { id = "abs", subject = "number", world = "", effect = "observe", law = "law.number.abs", owner = "graph" },
    floor = { id = "floor", subject = "number", world = "", effect = "observe", law = "law.number.floor", owner = "graph" },
    each = { id = "each", subject = "collection", world = "", effect = "observe", law = "law.collection.each", owner = "graph" },
    run = { id = "run", subject = "command", world = "process", effect = "mutate", law = "law.shell.run", owner = "graph" },
    encode = { id = "encode", subject = "value", world = "", effect = "observe", law = "law.json.encode", owner = "json" },
    decode = { id = "decode", subject = "text", world = "", effect = "observe", law = "law.json.decode", owner = "json" },
}

namespaces = {
    table = "collection",
    string = "text",
    math = "number",
    list = "collection",
    array = "collection",
    std = "distribution",
    process = "process",
    proc = "process",
    fs = "filesystem",
    io = "io",
    os = "os",
    core = "vocabulary",
    ir = "realization",
}

respellings = {
    "table.insert" = "push",
    "table.remove" = "remove",
    "table.sort" = "sort",
    "table.keys" = "keys",
    "table.concat" = "join",
    "table.values" = "values",
    "string.sub" = "sub",
    "string.find" = "find",
    "string.match" = "match",
    "string.gsub" = "gsub",
    "string.byte" = "byte",
    "string.len" = "len",
    "math.sqrt" = "sqrt",
    "math.abs" = "abs",
    "math.floor" = "floor",
    "list.append" = "push",
    "list.insert" = "push",
    "std.script.capture" = "run",
    "std.proc.capture" = "run",
    "process.capture" = "run",
    "process.run" = "run",
    "process.exit" = "exit",
    "process.chomp" = "chomp",
}

globals = {
    tostring = "to",
    tonumber = "to",
    pairs = "each",
    ipairs = "each",
    pcall = "case",
    xpcall = "case",
    print = "emit",
    type = "descriptor",
    require = "reach",
    load = "foreign",
    loadfile = "foreign",
    dofile = "foreign",
}

predicates = " is has can exists valid "

admitted: bool = (rel: str)
    row = catalog[rel]
    if row
        return true
    false

namespace: bool = (home: str)
    if namespaces[home]
        return true
    false

respelling: str = (spell: str)
    r = respellings[spell]
    if r
        return r
    ""

globalop: str = (name: str)
    g = globals[name]
    if g
        return g
    ""
