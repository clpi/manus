# gates/build — build-step idiom preflight (git diff → gates/idiom.id).
#
# Direct backend only — gatecap/os.execute via idol_io_bootstrap.c.

capture: str = (shellline: str)
    gatecap(shellline)

chomp: str = (text: str)
    if text == nil or text:len() == 0
        return ""
    n = text:len()
    while n > 0
        c = text:byte(n)
        if c != 10 and c != 13 and c != 32 and c != 9
            break
        n -= 1
    text:sub(1, n)

cap: str = (shellline: str)
    chomp(capture(shellline))

run: i64 = (shellline: str)
    if os.execute(shellline)
        return 0
    1

main: i64 = ()
    root = cap("git rev-parse --show-toplevel 2>/dev/null")
    if root == ""
        print("gates/build: fail no git root")
        return 3

    bytes = cap("cd '{root}' && git diff -U0 --diff-filter=ACM -- '*.id' | wc -c | tr -d ' '")
    if bytes == "" or bytes == "0"
        print("gates/build: pass no added diff")
        return 0

    bin = "{root}/zig-out/bin/idol"
    rc = run("cd '{root}' && git diff -U0 --diff-filter=ACM -- '*.id' | {bin} run gates/idiom.id")
    if rc != 0
        return rc
    print("gates/build: pass")
    0
