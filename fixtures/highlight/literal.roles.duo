-- Expected (line, col, len, role) for literal.duo. HAND-WRITTEN from
-- docs/spec/roles.md §2.
--
-- What this fixture discriminates: the blue space is the ONLY hue whose
-- members a lexer can produce unaided — grammar.md §1 gives `number`,
-- `string`, `byte` and `rawstring` as lexical productions. It is also the
-- control on the coverage counter: if a run reports 0% here, the counter
-- is broken, not the law.
--
-- The comment on line 1 is the other half of the point. H-6 says the role
-- function is TOTAL over every character, and `comment` appears in NO hue
-- in H-4. It is emitted UNHUED and does not count. -- gap[071]
spans = {
    { 1, 1, 10, "comment" },
    { 2, 1, 1, "name" },
    { 2, 3, 1, "bind" },
    { 2, 5, 5, "literal" },
    { 3, 1, 1, "name" },
    { 3, 3, 1, "bind" },
    { 3, 5, 3, "literal" },
}
