-- Expected (line, col, len, role) for paren.duo. HAND-WRITTEN from
-- docs/spec/roles.md §5.3.
--
-- What this fixture discriminates: the three-way paren split. GROUPING is
-- decidable — grammar.md gives `primary -> "(" expr ")"` against
-- `postfix -> "(" [args] ")"`, and the two differ by whether an operand
-- precedes the paren — so line 3 resolves. LEVEL versus PARAMETER does
-- not: LAW-STRATA's litmus is "if the prefix MEANS something, it's a
-- level" and LAW-ROLE's is "a choice OPERANDS CANNOT DETERMINE", both
-- graph queries. The tempting heuristic (last group in a spine is the
-- parameters) is refuted by the law's own example — LAW-STRATA calls BOTH
-- groups in `map(symbol)(u32)` levels. Line 2 is five ambiguity spans.
--
-- This is the ONE fixture that does not `duo check`: `map` is undeclared, and
-- the two-level curried callable that would declare it is exactly the
-- construct the fixture exists to be ambiguous about. The golden token corpus
-- is LEXICAL — see docs/spec/roles.md §6. -- gap[071]
spans = {
    { 1, 1, 8, "comment" },
    { 2, 1, 1, "name" },
    { 2, 3, 1, "bind" },
    { 2, 5, 3, "ambiguous" },
    { 2, 8, 1, "ambiguous" },
    { 2, 9, 6, "name" },
    { 2, 15, 1, "ambiguous" },
    { 2, 16, 1, "ambiguous" },
    { 2, 17, 3, "name" },
    { 2, 20, 1, "ambiguous" },
    { 3, 1, 1, "name" },
    { 3, 3, 1, "bind" },
    { 3, 5, 1, "group" },
    { 3, 6, 1, "name" },
    { 3, 8, 1, "operator" },
    { 3, 10, 1, "name" },
    { 3, 11, 1, "group" },
    { 3, 13, 1, "operator" },
    { 3, 15, 1, "name" },
}
