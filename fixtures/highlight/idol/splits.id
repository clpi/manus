# surface: idol
# §0g FINE SPLITS, one per line. These are cards WITHIN roles, never new roles:
# the discriminator is HUE, and none of these forks it. Precision does.
n: i64 = 0
n += 1
same = n == 1
read(number) = (lx, b): u64
point.x = 3.0
area: m * m
xs = (n + 1) * 2
t = token{ kind = .eof }
# §4: ordinary application stays one role. Operand facts distinguish a
# descriptor projection from value-key retrieval; punctuation does not.
sig = to(str)
k = xs(0)
