-- surface: duon
-- §0g FINE SPLITS, one per line. These are cards WITHIN roles, never new roles
-- — H-2 still closes the taxonomy at 18. Hue never forks; precision does.
n: i64 = 0
n += 1
same = n == 1
read(number) = (lx, b): u64
point.x = 3.0
area: m * m
xs = (n + 1) * 2
t = token{ kind = .eof }
