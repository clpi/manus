-- Expected (line, col, len, role) for bind.id. HAND-WRITTEN from the law.
--
-- What this fixture discriminates: §0g's "FINE SPLITS ARE LAW" row for `=`
-- binds / `+=` update edge / `==` relation query. All three are lexically
-- decidable by spelling and NONE of them changes hue — all three are law, all
-- three are red, all three lower into the same dnir family. gaps/GAP-078.md
-- ruled that a split which does not change hue is a CARD, so the ROLE here is
-- `operator` three times and the precision lives in the cards `bind`, `update`
-- and `relation`. A renderer that drops the cards has lost the split the law
-- calls law; a renderer that gives them three hues has invented a taxonomy.
--
-- Line 5 is where the ruling paid: `print` is a WORLD action — purple and
-- italic under H-5, because §0a makes worlds the only capability namespaces and
-- the trust boundary is typographic. It is not `ambiguous(callable|descriptor)`
-- any more, because `print` is named in the ambient reach and a name in that
-- set is decided.
--
-- Line 6's `end` is a `keyword`. §0.7 DELETED it from the language; a
-- highlighter still has to colour the seven hundred files that carry it, which
-- is the same reason the generated tree-sitter query carries a legacy set.
-- -- gap[078]
spans = {
    { 1, 1, 7, "comment" },
    { 2, 1, 1, "place" },
    { 2, 3, 1, "operator" },
    { 2, 5, 1, "number" },
    { 3, 1, 1, "place" },
    { 3, 3, 2, "operator" },
    { 3, 6, 1, "number" },
    { 4, 1, 2, "keyword" },
    { 4, 4, 1, "place" },
    { 4, 6, 2, "operator" },
    { 4, 9, 1, "number" },
    { 5, 5, 5, "world" },
    { 5, 10, 1, "layout" },
    { 5, 11, 1, "place" },
    { 5, 12, 1, "layout" },
    { 6, 1, 3, "keyword" },
}
