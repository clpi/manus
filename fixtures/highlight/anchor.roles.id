-- Expected (line, col, len, role) for anchor.id. HAND-WRITTEN from the law.
--
-- What this fixture discriminates: bare `@` against postfix `X@rel`.
-- grammar.md R5 decides it with no lookahead — "postfix `@` requires a left
-- operand; bare `@` is a primary; immediately followed by `{` it is the
-- enclosing-descriptor constructor" — and closes the door on the third
-- reading: "No prefix-`@`-expression production exists: the grammar cannot
-- express a directive."
--
-- Both forms are ORANGE and H-4 splits them no further, so both are `anchor`
-- here and the FORM lives in the card: `bare` for `@{…}`, `rel` for `point@`.
-- That is the ruling of gaps/GAP-078.md applied — a split that does not change
-- hue is a card, not a role — and it is why the old worry about this fixture
-- pushing a count from 17 to 19 is void. There is no count to push.
--
-- `x` inside the brace is a `descriptor` carrying the card `slot`: §0.3 puts
-- the case-set inline at the field, so a bound name inside a descriptor brace
-- names part of a shape rather than a value. -- gap[078]
spans = {
    { 1, 1, 9, "comment" },
    { 2, 1, 5, "place" },
    { 2, 7, 1, "operator" },
    { 2, 9, 1, "anchor" },
    { 2, 10, 1, "layout" },
    { 2, 12, 1, "descriptor" },
    { 2, 14, 1, "operator" },
    { 2, 16, 1, "number" },
    { 2, 18, 1, "layout" },
    { 3, 1, 5, "place" },
    { 3, 7, 1, "operator" },
    { 3, 9, 5, "place" },
    { 3, 14, 1, "anchor" },
    { 3, 15, 5, "place" },
}
