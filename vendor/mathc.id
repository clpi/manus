# vendor/mathc - C math library bindings via @ffi
# Usage: local m = mathc
#        or at compile time: duo compile myapp.id #link m
# (-lm is already linked by default, so no #link needed for math)

@ffi("sin")
sin_c(x: f64): f64 

@ffi("cos")
cos_c(x: f64): f64 

@ffi("sqrt")
sqrt_c(x: f64): f64 

@ffi("pow")
pow_c(x: f64, y: f64): f64 

@ffi("ceil")
ceil_c(x: f64): f64 

@ffi("floor")
floor_c(x: f64): f64 

M = {}
M.sin = sin_c
M.cos = cos_c
M.sqrt = sqrt_c
M.pow = pow_c
M.ceil = ceil_c
M.floor = floor_c
M
