
@ffi("sin")
sin_c: f64 = (x: f64)
  void
@ffi("cos")
cos_c: f64 = (x: f64)
  void
@ffi("sqrt")
sqrt_c: f64 = (x: f64)
  void
@ffi("pow")
pow_c: f64 = (x: f64, y: f64)
  void
@ffi("ceil")
ceil_c: f64 = (x: f64)
  void
@ffi("floor")
floor_c: f64 = (x: f64)
  void
M = {}
M.sin = sin_c
M.cos = cos_c
M.sqrt = sqrt_c
M.pow = pow_c
M.ceil = ceil_c
M.floor = floor_c
M
