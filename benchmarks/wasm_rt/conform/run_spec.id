
_MASK32 = 0xFFFFFFFF

_env_or: str = (n: str, d: str)
    v = std.script.getenv_or(n)
    if v == "" return d 
    v

_sh: str = (c: str)
    std.script.chomp(std.script.capture(c))

_pad: str = (s: str, w: i64)
    o = s
    while o:len() < w
        o = o .. " "
    o

_lpad(s: str, w: i64): str
    o = s
    while o:len() < w
        o = " " .. o
    o

_is_nan_bits: bool = (t: str, n: i64)
    if t == "f32"
        return (n & 0x7F800000) == 0x7F800000 and (n & 0x007FFFFF) != 0
    if t == "f64"
        return (n & 0x7FF0000000000000) == 0x7FF0000000000000
            and (n & 0x000FFFFFFFFFFFFF) != 0
    false

_norm: str = (t: str, s: any)
    if type(s) == "table"
        parts = {}
        for _i, x in s
            parts[parts:len() + 1] = x:to(str)
        return "v128:" .. parts:concat(",")
    if s == "nan:canonical" or s == "nan:arithmetic" return "nan" 
    n = to(i64)(s)
    if n == nil return s:to(str) 
    if t == "i32" or t == "f32" return to(str)(n & _MASK32) 
    n:to(str)

_arg_str: str = (v: any)
    if type(v) == "table" return "" 
    v:to(str)

main: i64 = ()
    ward = script.getenv_or("WARD")
    if ward == "" or not script.fs_exists(ward)
        print("set WARD=/path/to/ward binary")
        os.exit(1)

    suite = "../wart/third_party/testsuite"
    only = ""
    args = os.args()
    i = 1
    while i <= args:len()
        a = args[i]
        if a == "--only"
            only = args[i + 1]
            i = i + 1
        else
            if a == "--jobs"
                i = i + 1
            else
                if a != "--" and a:sub(1, 1) != "-"
                    suite = a
        i = i + 1

    td = "/tmp/duo_wasm_conform"
    script.run("rm -rf " .. td .. " && mkdir -p " .. td)

    listing = script.capture("ls " .. suite .. "/*.wast 2>/dev/null")
    tot_ok = 0
    tot_bad = 0
    tot_skip = 0
    rows = {}
    fails = {}

    for _i, line in listing:split("\n")
        wast = script.chomp(line)
        if wast != ""
            name = _sh("basename " .. wast .. " .wast")
            wanted = only == "" or only:find(name, 1, true) != nil
            if wanted
                js = td .. "/" .. name .. ".json"
                if script.run("wast2json " .. wast .. " -o " .. js .. " >/dev/null 2>&1") != 0
                    tot_skip = tot_skip + 1
                    fails[fails:len() + 1] = name .. ": wast2json failed"
                else
                    spec = json.decode(script.capture("cat " .. js))
                    cur_mod = ""
                    ok = 0
                    bad = 0
                    skip = 0
                    for _j, cmd in spec.commands
                        k = cmd.type
                        if k == "module"
                            cur_mod = td .. "/" .. cmd.filename
                        else
                            act = cmd.action
                            runnable = (k == "assert_return" or k == "assert_trap")
                                and act != nil and act.type == "invoke" and cur_mod != ""
                            if not runnable
                                skip = skip + 1
                            else
                                parts = {}
                                unrunnable = false
                                if act.args != nil
                                    for _a, arg in act.args
                                        s = _arg_str(arg.value)
                                        if s == "" unrunnable = true 
                                        parts[parts:len() + 1] = s
                                if unrunnable
                                    skip = skip + 1
                                else
                                    argstr = parts:concat(" ")
                                    out = _sh("WARD_INVOKE='" .. act.field .. "' WARD_ARGS='"
                                        .. argstr .. "' " .. ward .. " run " .. cur_mod
                                        .. " 2>/dev/null | tail -1")
                                    if k == "assert_trap"
                                        if out == ""
                                            ok = ok + 1
                                        else
                                            bad = bad + 1
                                            if fails:len() < 25
                                                fails[fails:len() + 1] = name .. " " .. act.field
                                                    .. " expected trap, got " .. out
                                    else
                                        exp = cmd.expected
                                        if exp == nil or exp:len() == 0
                                            ok = ok + 1
                                        else
                                            et = exp[1].type
                                            want = _norm(et, exp[1].value)
                                            have = out
                                            n = nil
                                            if out != "" n = to(i64)(out) 
                                            if n != nil
                                                if et == "i32" or et == "f32"
                                                    n = n & _MASK32
                                                if want == "nan" and _is_nan_bits(et, n)
                                                    have = "nan"
                                                else
                                                    have = n:to(str)
                                            if have == want
                                                ok = ok + 1
                                            else
                                                bad = bad + 1
                                                if fails:len() < 25
                                                    fails[fails:len() + 1] = name .. " " .. act.field
                                                        .. " want=" .. want .. " got=" .. out
                    tot_ok = tot_ok + ok
                    tot_bad = tot_bad + bad
                    tot_skip = tot_skip + skip
                    if ok > 0 or bad > 0
                        rows[rows:len() + 1] = { name, ok, bad, skip }

    print(_pad("suite", 24) .. _lpad("pass", 7) .. _lpad("fail", 7) .. _lpad("skip", 7))
    for _i, r in rows
        print(_pad(r[1], 24) .. _lpad(to(str)(r[2]), 7) .. _lpad(to(str)(r[3]), 7)
            .. _lpad(to(str)(r[4]), 7))

    executed = tot_ok + tot_bad
    pct = 0
    if executed > 0 pct = (tot_ok * 1000 + executed / 2) / executed 
    print("")
    print("executed " .. executed:to(str) .. " assertions: " .. tot_ok:to(str)
        .. " pass, " .. tot_bad:to(str) .. " fail (" .. to(str)(pct / 10) .. "."
        .. to(str)(pct % 10) .. "% conformance); " .. tot_skip:to(str)
        .. " skipped (validation-only)")

    if fails:len() > 0
        print("")
        print("first failures:")
        for _i, f in fails
            print("  " .. f)

    if tot_bad != 0
        os.exit(1)
    0
