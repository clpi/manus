-- WebAssembly spec-conformance harness for ward.
--
-- Duo replacement for benchmarks/wasm_rt/conform/run_spec.py (monoglot census:
-- this is TOOLING, not a fixture -- a harness is a program).
--
-- Converts each .wast in the official testsuite to JSON + .wasm via wast2json,
-- then replays every `assert_return` / `assert_trap` against ward, comparing to
-- the value THE SPEC ITSELF states -- not to another runtime. That is the point:
-- a differential against wasmtime only proves agreement, not correctness.
--
-- ward is driven through WARD_INVOKE / WARD_ARGS rather than CLI flags, so the
-- harness does not depend on ward's option parsing.
--
-- Usage: WARD=/path/to/ward duo run run_spec.id -- [suite] [--only a,b]
--
-- The Python version used a ThreadPoolExecutor (--jobs). This runs serially:
-- the comparison is per-assertion and order-independent, so parallelism is a
-- speed choice, not a semantic one. --jobs is accepted and ignored.

_MASK32 = 0xFFFFFFFF

_env_or(n: str, d: str): str
    v = std.script.getenv_or(n)
    if v == "" return d end
    v
end

_sh(c: str): str
    std.script.chomp(std.script.capture(c))
end

_pad(s: str, w: i64): str
    o = s
    while #o < w
        o = o .. " "
    end
    o
end

_lpad(s: str, w: i64): str
    o = s
    while #o < w
        o = " " .. o
    end
    o
end

-- True when bit pattern n is a NaN in type t. The spec gives NaN symbolically
-- ("nan:canonical" / "nan:arithmetic"); ward returns the bit pattern, so the
-- comparison has to happen in bits.
_is_nan_bits(t: str, n: i64): bool
    if t == "f32"
        return (n & 0x7F800000) == 0x7F800000 and (n & 0x007FFFFF) != 0
    end
    if t == "f64"
        return (n & 0x7FF0000000000000) == 0x7FF0000000000000
            and (n & 0x000FFFFFFFFFFFFF) != 0
    end
    false
end

-- Spec values are UNSIGNED decimal strings; for f32/f64 they are IEEE bit
-- patterns. Comparing in the type's own width is what makes 4294967295 and -1
-- the same i32 -- without the mask this harness reports false failures on every
-- negative result.
_norm(t: str, s: any): str
    if type(s) == "table"
        parts = {}
        for _i, x in s
            parts[#parts + 1] = x:to(str)
        end
        return "v128:" .. table.concat(parts, ",")
    end
    if s == "nan:canonical" or s == "nan:arithmetic" return "nan" end
    n = to(i64)(s)
    if n == nil return s:to(str) end
    if t == "i32" or t == "f32" return to(str)(n & _MASK32) end
    n:to(str)
end

-- One argument as a scalar string. v128 lanes arrive as a list and are not
-- expressible through the env-var protocol; the caller reports those as
-- unrunnable rather than crashing or silently passing.
_arg_str(v: any): str
    if type(v) == "table" return "" end
    v:to(str)
end

main = (): i64
    ward = std.script.getenv_or("WARD")
    if ward == "" or not std.script.fs_exists(ward)
        print("set WARD=/path/to/ward binary")
        os.exit(1)
    end

    suite = "../wart/third_party/testsuite"
    only = ""
    args = std.os.args()
    i = 1
    while i <= #args
        a = args[i]
        if a == "--only"
            only = args[i + 1]
            i = i + 1
        else
            if a == "--jobs"
                i = i + 1
            else
                if a != "--" and std.string.sub(a, 1, 1) != "-"
                    suite = a
                end
            end
        end
        i = i + 1
    end

    td = "/tmp/duo_wasm_conform"
    std.script.run("rm -rf " .. td .. " && mkdir -p " .. td)

    listing = std.script.capture("ls " .. suite .. "/*.wast 2>/dev/null")
    tot_ok = 0
    tot_bad = 0
    tot_skip = 0
    rows = {}
    fails = {}

    for _i, line in std.string.split(listing, "\n")
        wast = std.script.chomp(line)
        if wast != ""
            name = _sh("basename " .. wast .. " .wast")
            wanted = only == "" or std.string.find(only, name, 1, true) != nil
            if wanted
                js = td .. "/" .. name .. ".json"
                if std.script.run("wast2json " .. wast .. " -o " .. js .. " >/dev/null 2>&1") != 0
                    tot_skip = tot_skip + 1
                    fails[#fails + 1] = name .. ": wast2json failed"
                else
                    spec = std.json.decode(std.script.capture("cat " .. js))
                    cur_mod = ""
                    ok = 0
                    bad = 0
                    skip = 0
                    for _j, cmd in spec.commands
                        k = cmd.type
                        if k == "module"
                            cur_mod = td .. "/" .. cmd.filename
                        else
                            -- Validation-only assertions need a validator entry
                            -- point, not an invoke. Counted as SKIPPED, never
                            -- as passing: silently passing them would inflate
                            -- the conformance number with tests never run.
                            act = cmd.action
                            runnable = (k == "assert_return" or k == "assert_trap")
                                and act != nil and act.type == "invoke" and cur_mod != ""
                            if not runnable
                                skip = skip + 1
                            else
                                parts = {}
                                unrunnable = false
                                if act.args != nil
                                    for _a, arg in act.args
                                        s = _arg_str(arg.value)
                                        if s == "" unrunnable = true end
                                        parts[#parts + 1] = s
                                    end
                                end
                                if unrunnable
                                    skip = skip + 1
                                else
                                    argstr = table.concat(parts, " ")
                                    out = _sh("WARD_INVOKE='" .. act.field .. "' WARD_ARGS='"
                                        .. argstr .. "' " .. ward .. " run " .. cur_mod
                                        .. " 2>/dev/null | tail -1")
                                    if k == "assert_trap"
                                        -- A trap must not produce a value.
                                        if out == ""
                                            ok = ok + 1
                                        else
                                            bad = bad + 1
                                            if #fails < 25
                                                fails[#fails + 1] = name .. " " .. act.field
                                                    .. " expected trap, got " .. out
                                            end
                                        end
                                    else
                                        exp = cmd.expected
                                        if exp == nil or #exp == 0
                                            ok = ok + 1
                                        else
                                            et = exp[1].type
                                            want = _norm(et, exp[1].value)
                                            have = out
                                            -- EMPTY OUTPUT IS NOT ZERO.
                                            -- `to(i64)("")` returns 0, not nil,
                                            -- so an absent ward result would
                                            -- normalise to "0" and compare
                                            -- EQUAL to every expected zero.
                                            -- Measured: that inflated i32 from
                                            -- 10 pass to 135 against the Python
                                            -- original's 10. A missing answer
                                            -- must never satisfy an assertion.
                                            n = nil
                                            if out != "" n = to(i64)(out) end
                                            if n != nil
                                                if et == "i32" or et == "f32"
                                                    n = n & _MASK32
                                                end
                                                if want == "nan" and _is_nan_bits(et, n)
                                                    have = "nan"
                                                else
                                                    have = n:to(str)
                                                end
                                            end
                                            if have == want
                                                ok = ok + 1
                                            else
                                                bad = bad + 1
                                                if #fails < 25
                                                    fails[#fails + 1] = name .. " " .. act.field
                                                        .. " want=" .. want .. " got=" .. out
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    tot_ok = tot_ok + ok
                    tot_bad = tot_bad + bad
                    tot_skip = tot_skip + skip
                    if ok > 0 or bad > 0
                        rows[#rows + 1] = { name, ok, bad, skip }
                    end
                end
            end
        end
    end

    print(_pad("suite", 24) .. _lpad("pass", 7) .. _lpad("fail", 7) .. _lpad("skip", 7))
    for _i, r in rows
        print(_pad(r[1], 24) .. _lpad(to(str)(r[2]), 7) .. _lpad(to(str)(r[3]), 7)
            .. _lpad(to(str)(r[4]), 7))
    end

    executed = tot_ok + tot_bad
    pct = 0
    -- Round, do not truncate: 10/374 is 2.673%, which the Python original
    -- prints as 2.7%. Truncating would report 2.6% and look like a
    -- divergence on every run.
    if executed > 0 pct = (tot_ok * 1000 + executed / 2) / executed end
    print("")
    print("executed " .. executed:to(str) .. " assertions: " .. tot_ok:to(str)
        .. " pass, " .. tot_bad:to(str) .. " fail (" .. to(str)(pct / 10) .. "."
        .. to(str)(pct % 10) .. "% conformance); " .. tot_skip:to(str)
        .. " skipped (validation-only)")

    if #fails > 0
        print("")
        print("first failures:")
        for _i, f in fails
            print("  " .. f)
        end
    end

    if tot_bad != 0
        os.exit(1)
    end
    0
end
