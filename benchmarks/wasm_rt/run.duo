-- Head-to-head WASM runtime benchmark: ward vs every other runtime on PATH.
--
-- Duo replacement for benchmarks/wasm_rt/run.sh (monoglot census).
--
-- Unlike scripts/run_wasm_benchmark.duo (which measures duo-compiled-to-WASM
-- running *under* other runtimes), this measures the runtimes themselves
-- executing the same module.
--
-- Every runtime must produce byte-identical stdout or its time is discarded:
-- a fast wrong answer is not a result.
--
-- The shell version shelled out to `python3` three times per measurement --
-- once for each timestamp and once to compare them. That was the only reason
-- python was needed anywhere in this repo's benchmark path. std.time.monotonic
-- is nanoseconds from the same clock, in-process, with no fork per sample.

_HERE = "benchmarks/wasm_rt"

_env_or(name: str, fallback: str): str
    v = std.script.getenv_or(name)
    if v == "" return fallback end
    v
end

_have(tool: str): bool
    std.script.chomp(std.script.capture("command -v " .. tool .. " 2>/dev/null")) != ""
end

-- Fixed-width column, so the table lines up without printf templates.
_pad(s: str, w: i64): str
    out = s
    while #out < w
        out = out .. " "
    end
    out
end

-- Seconds to 4 decimals, from integer ten-thousandths. `to(str)` on an f64
-- does not compile (it lowers to an undeclared `tostring`), so the fraction is
-- assembled from integers -- same reason as the other benchmark drivers.
_secs(ns: i64): str
    tenk = (ns + 50000) / 100000
    whole = tenk / 10000
    frac = tenk % 10000
    fs = frac:to(str)
    while #fs < 4
        fs = "0" .. fs
    end
    whole:to(str) .. "." .. fs
end

-- One timed run. Returns ns; the OUTPUT is read separately by the caller,
-- because piping through `tail` would put the pipeline in the timing window.
_time_run(cmd: str): i64
    t0 = std.time.monotonic()
    std.script.run("timeout 900 " .. cmd .. " >/dev/null 2>&1")
    std.time.monotonic() - t0
end

_last_line(cmd: str): str
    std.script.chomp(std.script.capture("timeout 900 " .. cmd .. " 2>/dev/null | tail -1"))
end

-- Best of N: the MINIMUM, not the mean. A benchmark's slow samples are noise
-- from the machine, not from the runtime.
-- A cursor loop, not `for i in range(0, runs)`: `range` does not resolve
-- inside a nested function here -- the emitted C carries an undeclared
-- `range` identifier -- though it works at the top level of `main`. Filed
-- against the FF-11 conformance row, which only covers the latter.
_best_of(cmd: str, runs: i64): i64
    best = 0
    i = 0
    while i < runs
        ns = _time_run(cmd)
        if best == 0 or ns < best
            best = ns
        end
        i = i + 1
    end
    best
end

main = (): i64
    ward = std.script.getenv_or("WARD_BIN")
    if ward == ""
        print("run: set WARD_BIN to the ward binary")
        return 1
    end

    dir = _env_or("BENCH_DIR", _HERE .. "/scaled")
    runs = to(i64)(_env_or("RUNS", "3"))
    if runs == nil or runs < 1 runs = 3 end

    -- name and command are kept as parallel entries in one row so the table
    -- header and the measurement loop cannot drift apart.
    candidates = {
        { "wasmtime", "wasmtime" },
        { "wasmer", "wasmer run" },
        { "wasm3", "wasm3" },
        { "iwasm", "iwasm" },
        { "wazero", "wazero run" },
    }
    runtimes = {}
    for _i, c in candidates
        if _have(c[1])
            runtimes[#runtimes + 1] = c
        end
    end

    if not _have("wasmtime")
        print("run: wasmtime is required as the reference runtime")
        return 1
    end

    header = _pad("bench", 9) .. _pad("ward", 14)
    for _i, e in runtimes
        header = header .. _pad(e[1], 14)
    end
    print(header)

    benches = _env_or("BENCHES", "loop_i32 loop_f64 memory calls fib brtable")
    for _i, b in std.string.split(benches, " ")
        if b != ""
            f = dir .. "/" .. b .. ".wasm"
            if not std.script.fs_exists(f)
                print(b .. ": MISSING " .. f)
            else
                -- The reference answer, from wasmtime. Every other runtime's
                -- time is only reported if its stdout matches this byte for
                -- byte.
                ref = _last_line("wasmtime " .. f)
                row = _pad(b, 9)

                wcmd = ward .. " run " .. f
                if _last_line(wcmd) == ref
                    row = row .. _pad(_secs(_best_of(wcmd, runs)) .. "s", 14)
                else
                    row = row .. _pad("WRONG", 14)
                end

                for _j, e in runtimes
                    cmd = e[2] .. " " .. f
                    if _last_line(cmd) == ref
                        row = row .. _pad(_secs(_best_of(cmd, runs)) .. "s", 14)
                    else
                        row = row .. _pad("WRONG", 14)
                    end
                end
                print(row)
            end
        end
    end
    0
end
