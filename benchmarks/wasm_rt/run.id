
_HERE = "benchmarks/wasm_rt"

_env_or: str = (name: str, fallback: str)
    v = std.script.getenv_or(name)
    if v == "" return fallback 
    v

_have: bool = (tool: str)
    std.script.chomp(std.script.capture("command -v " .. tool .. " 2>/dev/null")) != ""

_pad: str = (s: str, w: i64)
    out = s
    while out:len() < w
        out = out .. " "
    out

_secs(ns: i64): str
    tenk = (ns + 50000) / 100000
    whole = tenk / 10000
    frac = tenk % 10000
    fs = frac:to(str)
    while fs:len() < 4
        fs = "0" .. fs
    whole:to(str) .. "." .. fs

_time_run: i64 = (cmd: str)
    t0 = std.time.monotonic()
    std.script.run("timeout 900 " .. cmd .. " >/dev/null 2>&1")
    std.time.monotonic() - t0

_last_line: str = (cmd: str)
    std.script.chomp(std.script.capture("timeout 900 " .. cmd .. " 2>/dev/null | tail -1"))

_best_of: i64 = (cmd: str, runs: i64)
    best = 0
    i = 0
    while i < runs
        ns = _time_run(cmd)
        if best == 0 or ns < best
            best = ns
        i = i + 1
    best

main: i64 = ()
    ward = script.getenv_or("WARD_BIN")
    if ward == ""
        print("run: set WARD_BIN to the ward binary")
        return 1

    dir = _env_or("BENCH_DIR", _HERE .. "/scaled")
    runs = to(i64)(_env_or("RUNS", "3"))
    if runs == nil or runs < 1 runs = 3 

    candidates = {
        { "wasmtime", "wasmtime" },
        { "wasmer", "wasmer run" },
        { "wasm3", "wasm3" },
        { "iwasm", "iwasm" },
        { "wazero", "wazero run" },
    }
    runtimes = {}
    for _i, c in candidates
        if _have(c[1])
            runtimes[runtimes:len() + 1] = c

    if not _have("wasmtime")
        print("run: wasmtime is required as the reference runtime")
        return 1

    header = _pad("bench", 9) .. _pad("ward", 14)
    for _i, e in runtimes
        header = header .. _pad(e[1], 14)
    print(header)

    benches = _env_or("BENCHES", "loop_i32 loop_f64 memory calls fib brtable")
    for _i, b in benches:split(" ")
        if b != ""
            f = dir .. "/" .. b .. ".wasm"
            if not script.fs_exists(f)
                print(b .. ": MISSING " .. f)
            else
                ref = _last_line("wasmtime " .. f)
                row = _pad(b, 9)

                wcmd = ward .. " run " .. f
                if _last_line(wcmd) == ref
                    row = row .. _pad(_secs(_best_of(wcmd, runs)) .. "s", 14)
                else
                    row = row .. _pad("WRONG", 14)

                for _j, e in runtimes
                    cmd = e[2] .. " " .. f
                    if _last_line(cmd) == ref
                        row = row .. _pad(_secs(_best_of(cmd, runs)) .. "s", 14)
                    else
                        row = row .. _pad("WRONG", 14)
                print(row)
    0
