ev = req "duo_eval"
recs = "add_i32;i32;i32\nadd_i64;i64;i64\nadd_f64;f64;f64"
print("1 recs=[" .. recs .. "]")
f = ev.detect_op_families(recs)
print("2 families=[" .. f .. "]")
q = ev.detect_eq_count("eq_a;i64;bool\ngt_b;i64;bool")
print("3 eq=" .. q)
g = ev.emit_generate("add;i32|i64|f64;3")
print("4 gen=[" .. string.sub(g, 1, 120) .. "]")
print("5 done")
