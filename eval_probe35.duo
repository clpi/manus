json = req "std.json"

needles = { ["lua_invoke("] = 1, ["lua_table_get_str_lit("] = 1, ["lua_Value "] = 1 }
hit_marks = ""
first = 1
hits_csv = ""
for needle, _ in needles do
    hit_marks = hit_marks .. "."
    if first == 1 then hits_csv = needle; first = 0 else hits_csv = hits_csv .. "," .. needle end
end
hc = string.len(hit_marks)
print("hc=" .. tostring(hc) .. " type=" .. type(hc))
print("hit_marks=[" .. hit_marks .. "]")
t = { hit_count = hc, hit_marks = hit_marks }
print("t=" .. json.encode(t))
