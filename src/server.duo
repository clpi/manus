-- duo-lsp — Language Server Protocol implementation for the Duo language.
--
-- Written in Duo. Speaks LSP over stdio (JSON-RPC with Content-Length
-- framing). Diagnostics come from shelling out to the `duo` compiler's
-- `check` command; the symbol outline / hover / go-to-definition come from a
-- best-effort top-level declaration scanner.
--
-- Build:  duo compile -o duo-lsp src/server.duo
-- Run:    DUO_LSP_DUO_BIN=/path/to/duo ./duo-lsp   (reads LSP on stdin/stdout)
--
-- Requires a duo runtime that supports byte-accurate io.read(n) and
-- io.read("*a") (added to the compiler runtime for framed stdio).

-- ── JSON decoder ────────────────────────────────────────────────────────────
-- std.json.decode is a stub, so this is a hand-written recursive-descent
-- parser. JSON objects -> duo tables with string keys; arrays -> integer
-- keys 1..n; null -> nil.

fun j_skip_ws(cur)
    s = cur.s
    n = string.len(s)
    while cur.i <= n
        b = string.byte(s, cur.i)
        if b == 32 or b == 9 or b == 10 or b == 13 then
            cur.i = cur.i + 1
        else
            break
        end
    end
end

fun parse_hex4(s): i64
    v = 0
    i = 1
    while i <= 4
        b = string.byte(s, i)
        d = 0
        if b >= 48 and b <= 57 then
            d = b - 48
        elseif b >= 65 and b <= 70 then
            d = b - 55
        elseif b >= 97 and b <= 102 then
            d = b - 87
        end
        v = v * 16 + d
        i = i + 1
    end
    v
end

fun utf8_char(cp): str
    if cp < 128 then
        return string.char(cp)
    end
    if cp < 2048 then
        b1 = math.floor(cp / 64) + 192
        b2 = (cp % 64) + 128
        return string.char(b1) .. string.char(b2)
    end
    b1 = math.floor(cp / 4096) + 224
    b2 = math.floor((cp % 4096) / 64) + 128
    b3 = (cp % 64) + 128
    return string.char(b1) .. string.char(b2) .. string.char(b3)
end

fun j_string(cur): any
    cur.i = cur.i + 1
    s = cur.s
    n = string.len(s)
    out = {}
    while cur.i <= n
        b = string.byte(s, cur.i)
        if b == 34 then
            cur.i = cur.i + 1
            return table.concat(out)
        end
        if b == 92 then
            cur.i = cur.i + 1
            e = string.byte(s, cur.i)
            if e == 110 then
                out[rawlen(out) + 1] = "\n"
            elseif e == 116 then
                out[rawlen(out) + 1] = "\t"
            elseif e == 114 then
                out[rawlen(out) + 1] = "\r"
            elseif e == 34 then
                out[rawlen(out) + 1] = "\""
            elseif e == 92 then
                out[rawlen(out) + 1] = "\\"
            elseif e == 47 then
                out[rawlen(out) + 1] = "/"
            elseif e == 98 then
                out[rawlen(out) + 1] = string.char(8)
            elseif e == 102 then
                out[rawlen(out) + 1] = string.char(12)
            elseif e == 117 then
                hex = string.sub(s, cur.i + 1, cur.i + 4)
                cp = parse_hex4(hex)
                out[rawlen(out) + 1] = utf8_char(cp)
                cur.i = cur.i + 4
            else
                out[rawlen(out) + 1] = string.char(e)
            end
            cur.i = cur.i + 1
        else
            out[rawlen(out) + 1] = string.sub(s, cur.i, cur.i)
            cur.i = cur.i + 1
        end
    end
    table.concat(out)
end

fun j_number(cur): any
    s = cur.s
    start = cur.i
    n = string.len(s)
    while cur.i <= n
        b = string.byte(s, cur.i)
        if (b >= 48 and b <= 57) or b == 45 or b == 43 or b == 46 or b == 101 or b == 69 then
            cur.i = cur.i + 1
        else
            break
        end
    end
    num_str = string.sub(s, start, cur.i - 1)
    tonumber(num_str)
end

fun j_value(cur): any
    j_skip_ws(cur)
    s = cur.s
    if cur.i > string.len(s) then return nil end
    b = string.byte(s, cur.i)
    if b == 123 then
        cur.i = cur.i + 1
        obj = {}
        j_skip_ws(cur)
        if string.byte(cur.s, cur.i) == 125 then
            cur.i = cur.i + 1
            return obj
        end
        while true
            j_skip_ws(cur)
            key = j_string(cur)
            j_skip_ws(cur)
            cur.i = cur.i + 1
            val = j_value(cur)
            obj[key] = val
            j_skip_ws(cur)
            b2 = string.byte(cur.s, cur.i)
            if b2 == 44 then
                cur.i = cur.i + 1
            elseif b2 == 125 then
                cur.i = cur.i + 1
                break
            else
                break
            end
        end
        return obj
    end
    if b == 91 then
        cur.i = cur.i + 1
        arr = {}
        j_skip_ws(cur)
        if string.byte(cur.s, cur.i) == 93 then
            cur.i = cur.i + 1
            return arr
        end
        while true
            val = j_value(cur)
            arr[rawlen(arr) + 1] = val
            j_skip_ws(cur)
            b2 = string.byte(cur.s, cur.i)
            if b2 == 44 then
                cur.i = cur.i + 1
            elseif b2 == 93 then
                cur.i = cur.i + 1
                break
            else
                break
            end
        end
        return arr
    end
    if b == 34 then
        return j_string(cur)
    end
    if b == 116 then
        cur.i = cur.i + 4
        return true
    end
    if b == 102 then
        cur.i = cur.i + 5
        return false
    end
    if b == 110 then
        cur.i = cur.i + 4
        return nil
    end
    j_number(cur)
end

fun json_decode(s): any
    if s == nil or s == "" then return nil end
    cur = {}
    cur.s = s
    cur.i = 1
    j_skip_ws(cur)
    j_value(cur)
end

-- ── JSON encoder ────────────────────────────────────────────────────────────
fun j_escape(s): str
    if s == nil then return "" end
    out = {}
    n = string.len(s)
    i = 1
    hex = "0123456789abcdef"
    while i <= n
        b = string.byte(s, i)
        if b == 34 then
            out[rawlen(out) + 1] = "\\\""
        elseif b == 92 then
            out[rawlen(out) + 1] = "\\\\"
        elseif b == 10 then
            out[rawlen(out) + 1] = "\\n"
        elseif b == 13 then
            out[rawlen(out) + 1] = "\\r"
        elseif b == 9 then
            out[rawlen(out) + 1] = "\\t"
        elseif b == 8 then
            out[rawlen(out) + 1] = "\\b"
        elseif b == 12 then
            out[rawlen(out) + 1] = "\\f"
        elseif b < 32 then
            hi = math.floor(b / 16) + 1
            lo = (b % 16) + 1
            out[rawlen(out) + 1] = "\\u00" .. string.sub(hex, hi, hi) .. string.sub(hex, lo, lo)
        else
            out[rawlen(out) + 1] = string.sub(s, i, i)
        end
        i = i + 1
    end
    table.concat(out)
end

fun is_array(t): bool
    for k, _ in pairs(t)
        if type(k) == "string" then return false end
    end
    true
end

fun j_encode(v): str
    if v == nil then return "null" end
    t = type(v)
    if t == "boolean" then
        if v then return "true" else return "false" end
    end
    if t == "number" then
        return tostring(v)
    end
    if t == "string" then
        return "\"" .. j_escape(v) .. "\""
    end
    if t == "table" then
        if is_array(v) then
            parts = {}
            n = rawlen(v)
            i = 1
            while i <= n
                parts[rawlen(parts) + 1] = j_encode(v[i])
                i = i + 1
            end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        parts = {}
        for k, val in pairs(v)
            if type(k) == "string" then
                parts[rawlen(parts) + 1] = "\"" .. j_escape(k) .. "\":" .. j_encode(val)
            end
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    "null"
end

-- ── string helpers ──────────────────────────────────────────────────────────
fun trim(s): str
    if s == nil then return "" end
    n = string.len(s)
    i = 1
    while i <= n and string.byte(s, i) == 32 do
        i = i + 1
    end
    j = n
    while j >= i and string.byte(s, j) == 32 do
        j = j - 1
    end
    string.sub(s, i, j)
end

fun starts_with(s, prefix): bool
    if s == nil then return false end
    string.sub(s, 1, string.len(prefix)) == prefix
end

fun ends_with(s, suffix): bool
    if s == nil then return false end
    if string.len(suffix) > string.len(s) then return false end
    string.sub(s, string.len(s) - string.len(suffix) + 1) == suffix
end

fun find_from(s: any, sub: any, start: any): i64
    if s == nil then return 0 end
    sn = string.len(s)
    subn = string.len(sub)
    if subn == 0 then return start end
    i = start
    while i + subn - 1 <= sn
        is_match = true
        j = 0
        while j < subn
            if string.byte(s, i + j) ~= string.byte(sub, j + 1) then
                is_match = false
                break
            end
            j = j + 1
        end
        if is_match then return i end
        i = i + 1
    end
    0
end

fun contains_char(s, ch): bool
    if s == nil then return false end
    cb = string.byte(ch, 1)
    n = string.len(s)
    i = 1
    while i <= n
        if string.byte(s, i) == cb then return true end
        i = i + 1
    end
    false
end

fun count_char(s, ch): i64
    c = 0
    cb = string.byte(ch, 1)
    n = string.len(s)
    i = 1
    while i <= n
        if string.byte(s, i) == cb then c = c + 1 end
        i = i + 1
    end
    c
end

fun count_keyword(s, word): i64
    c = 0
    if s == nil then return c end
    n = string.len(s)
    wn = string.len(word)
    i = 1
    while i <= n
        b = string.byte(s, i)
        if is_ident_start(b) then
            j = i
            while j <= n and is_ident_char(string.byte(s, j)) do
                j = j + 1
            end
            if j - i == wn and string.sub(s, i, j - 1) == word then
                c = c + 1
            end
            i = j
        else
            i = i + 1
        end
    end
    c
end

fun count_end(s): i64
    count_keyword(s, "end")
end

fun starts_keyword(s, kw): bool
    r = trim(s)
    if not starts_with(r, kw) then return false end
    n = string.len(r)
    k = string.len(kw)
    if n == k then return true end
    not is_ident_char(string.byte(r, k + 1))
end

fun trim_after_keyword(s, kw): any
    r = trim(s)
    if starts_keyword(r, kw) then
        return trim(string.sub(r, string.len(kw) + 2))
    end
    r
end

fun name_after_keywords(rest): any
    r = trim(rest)
    if starts_keyword(r, "local") or starts_keyword(r, "global") then
        r = trim_after_keyword(r, "local")
        r = trim_after_keyword(r, "global")
    end
    if starts_keyword(r, "async") then
        r = trim_after_keyword(r, "async")
    end
    if starts_keyword(r, "fun") then
        r = trim_after_keyword(r, "fun")
    end
    if starts_keyword(r, "function") then
        r = trim_after_keyword(r, "function")
    end
    first_ident(r)
end

fun split_prefix_after_dot(prefix): str
    out = prefix
    p = find_from(out, ".", 1)
    while p ~= 0
        out = string.sub(out, p + 1)
        p = find_from(out, ".", 1)
    end
    out
end

fun word_prefix(text, line, col): str
    ln = get_line(text, line)
    if ln == nil then return "" end
    n = string.len(ln)
    if col < 0 then col = 0 end
    if col > n then col = n end
    start = col
    while start > 1 and is_word_char_byte(string.byte(ln, start)) do
        start = start - 1
    end
    if start >= col then return "" end
    split_prefix_after_dot(string.sub(ln, start, col))
end

fun completion_matches(name, prefix): bool
    if prefix == "" then return true end
    if starts_with(name, prefix) then return true end
    p = find_from(name, ":", 1)
    while p ~= 0
        if starts_with(string.sub(name, p + 1), prefix) then return true end
        p = find_from(name, ":", p + 1)
    end
    p = find_from(name, ".", 1)
    while p ~= 0
        if starts_with(string.sub(name, p + 1), prefix) then return true end
        p = find_from(name, ".", p + 1)
    end
    false
end

fun completion_kind_for_symbol(k): i64
    if k == 12 then return 3 end
    if k == 10 then return 10 end
    if k == 11 then return 11 end
    if k == 23 or k == 26 then return 7 end
    if k == 14 then return 21 end
    13
end

fun add_completion(out, seen, label, kind, detail, insert_text, sort_text): void
    if label == nil or label == "" then return end
    if seen[label] ~= nil then return end
    seen[label] = true
    item = {}
    item.label = label
    item.kind = kind
    if detail ~= nil and detail ~= "" then item.detail = detail end
    if insert_text ~= nil and insert_text ~= label then item.insertText = insert_text end
    if sort_text ~= nil then item.sortText = sort_text end
    out[rawlen(out) + 1] = item
end

fun add_keyword_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 14, "Duo keyword", nil, "k_" .. label)
    end
end

fun add_snippet_completion(out, seen, label, detail, insert_text, prefix, sort_text): void
    if completion_matches(label, prefix) then
        item = {}
        item.label = label
        item.kind = 15
        item.detail = detail
        item.insertText = insert_text
        item.insertTextFormat = 2
        item.sortText = sort_text
        out[rawlen(out) + 1] = item
    end
end

fun add_builtin_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 3, "Duo builtin", nil, "b_" .. label)
    end
end

fun add_std_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 9, "std module", nil, "m_" .. label)
    end
end

fun add_type_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 7, "Duo type", nil, "t_" .. label)
    end
end

