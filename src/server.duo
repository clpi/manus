-- duo-lsp — Language Server Protocol implementation for the Duo language.
--
-- Written in Duo, speaking LSP over stdio (JSON-RPC with Content-Length
-- framing). Diagnostics come from shelling out to the `duo` compiler's
-- `check` command; symbol outline / hover / go-to-definition / completion
-- come from a fast line-oriented scanner with per-document caching.
--
-- JSON-RPC is delegated to std.json (from the Duo standard library) —
-- the server pulls std.json in via require rather than rolling its own
-- encoder/parser. String helpers here are small and self-contained because
-- the std.string module's split/lines path currently triggers a sema bug
-- when re-checked; we avoid that dependency for a self-contained server.
--
-- Build:  duo compile -o duo-lsp src/server.duo
-- Run:    DUO_LSP_DUO_BIN=/path/to/duo ./duo-lsp   (reads LSP on stdin/stdout)
--
-- Performance notes
--   * Per-document line-offset table is computed once per text version and
--     reused by get_line / offset_at / word_end — O(log|text|) per lookup
--     instead of O(|text|) over a fresh scan.
--   *.scan_symbols result is cached per document version; hover / definition /
--     documentSymbol all share one scan.
--   * `duo check` is debounced to at most one invocation per second per
--     document (keyed on os.time), with a trailing flush on the next loop
--     iteration so editors that spam didChange never fork the compiler on
--     every keystroke.

-- ── standard library: JSON ──────────────────────────────────────────────────
-- Stored as a field on the io.lsp state table because module-level bindings
-- are not visible by name inside `fun` bodies in the current codegen.
io.lsp = {}
io.lsp.json = require "std.json"

-- ── byte predicates ─────────────────────────────────────────────────────────
fun is_ident_start(b: any): bool
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95
end

fun is_ident_char(b: any): bool
    return (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 95
end

fun is_word_char_byte(b: any): bool
    return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or
        b == 95 or b == 46 or b == 36 or b == 64
end

fun is_space_byte(b: any): bool
    return b == 32 or b == 9 or b == 10 or b == 13
end

-- ── string search ──────────────────────────────────────────────────────────
fun find_from(s, sub, start): i64
    if s == nil then return 0 end
    sn = string.len(s)
    subn = string.len(sub)
    if subn == 0 then return start end
    i = start
    while i + subn - 1 <= sn
        is_match = true
        j = 0
        while j < subn
            if string.byte(s, i + j) ~= string.byte(sub, j + 1) then
                is_match = false
                break
            end
            j = j + 1
        end
        if is_match then return i end
        i = i + 1
    end
    0
end

fun find_last(s, ch): i64
    n = string.len(s)
    cb = string.byte(ch, 1)
    j = n
    while j >= 1
        if string.byte(s, j) == cb then return j end
        j = j - 1
    end
    0
end

fun starts_with(s, prefix): bool
    if s == nil then return false end
    return string.sub(s, 1, string.len(prefix)) == prefix
end

fun ends_with(s, suffix): bool
    if s == nil then return false end
    if string.len(suffix) > string.len(s) then return false end
    return string.sub(s, string.len(s) - string.len(suffix) + 1) == suffix
end

fun trim(s): str
    if s == nil then return "" end
    n = string.len(s)
    i = 1
    while i <= n and is_space_byte(string.byte(s, i)) do
        i = i + 1
    end
    j = n
    while j >= i and is_space_byte(string.byte(s, j)) do
        j = j - 1
    end
    if j < i then return "" end
    string.sub(s, i, j)
end

fun contains_char(s, ch): bool
    if s == nil then return false end
    cb = string.byte(ch, 1)
    n = string.len(s)
    i = 1
    while i <= n
        if string.byte(s, i) == cb then return true end
        i = i + 1
    end
    false
end

fun count_char(s, ch): i64
    c = 0
    cb = string.byte(ch, 1)
    n = string.len(s)
    i = 1
    while i <= n
        if string.byte(s, i) == cb then c = c + 1 end
        i = i + 1
    end
    c
end

-- ── line-offset table ──────────────────────────────────────────────────────
-- compute_line_offs(text) returns an array `lo` where lo[i] is the 1-based
-- start byte index of logical line i-1 (0-based line indexing). Building it
-- is O(|text|) and done once per text version; every line/offset lookup after
-- that is O(1). This is the single biggest perf lever for the scanner.

fun compute_line_offs(text): any
    lo = {}
    lo[rawlen(lo) + 1] = 1
    n = string.len(text)
    pos = 1
    while pos <= n
        if string.byte(text, pos) == 10 then
            lo[rawlen(lo) + 1] = pos + 1
        end
        pos = pos + 1
    end
    lo
end

-- get_line_lo(text, lo, idx) — idx is 0-based; returns the line w/o newline
-- and w/o trailing CR, or nil if out of range.
fun get_line_lo(text, lo, idx): any
    if idx < 0 then return nil end
    hi = idx + 1
    if hi > rawlen(lo) then return nil end
    start = lo[hi]
    n = string.len(text)
    ende = n
    if hi + 1 <= rawlen(lo) then
        ende = lo[hi + 1] - 2
    end
    if ende < start - 1 then return "" end
    line = string.sub(text, start, ende)
    ln = string.len(line)
    if ln > 0 and string.byte(line, ln) == 13 then
        line = string.sub(line, 1, ln - 1)
    end
    line
end

-- offset_at_lo(text, lo, pos) — returns a 0-based byte offset into text, in
-- the same coordinate space as string.sub(text, off+1, ...).
fun offset_at_lo(text, lo, pos): i64
    line = pos.line
    chcol = pos.character
    if line < 0 then line = 0 end
    n = string.len(text)
    hi = line + 1
    if hi > rawlen(lo) then return n end
    start = lo[hi]
    off = start - 1 + chcol
    if off < 0 then off = 0 end
    if off > n then off = n end
    off
end

-- ── identifier / keyword helpers ────────────────────────────────────────────
fun first_ident(s): any
    if s == nil then return nil end
    s = trim(s)
    n = string.len(s)
    if n == 0 then return nil end
    b = string.byte(s, 1)
    if not is_ident_start(b) then return nil end
    i = 1
    while i <= n and is_ident_char(string.byte(s, i)) do
        i = i + 1
    end
    r = {}
    r.name = string.sub(s, 1, i - 1)
    r.rest = string.sub(s, i)
    r
end

fun count_keyword(s, word): i64
    c = 0
    if s == nil then return c end
    n = string.len(s)
    wn = string.len(word)
    i = 1
    while i <= n
        b = string.byte(s, i)
        if is_ident_start(b) then
            j = i
            while j <= n and is_ident_char(string.byte(s, j)) do
                j = j + 1
            end
            if j - i == wn and string.sub(s, i, j - 1) == word then
                c = c + 1
            end
            i = j
        else
            i = i + 1
        end
    end
    c
end

fun count_end(s): i64
    return count_keyword(s, "end")
end

fun starts_keyword(s, kw): bool
    r = trim(s)
    if not starts_with(r, kw) then return false end
    n = string.len(r)
    k = string.len(kw)
    if n == k then return true end
    return not is_ident_char(string.byte(r, k + 1))
end

fun trim_after_keyword(s, kw): any
    r = trim(s)
    if starts_keyword(r, kw) then
        return trim(string.sub(r, string.len(kw) + 2))
    end
    r
end

fun name_after_keywords(rest): any
    r = trim(rest)
    if starts_keyword(r, "local") or starts_keyword(r, "global") then
        r = trim_after_keyword(r, "local")
        r = trim_after_keyword(r, "global")
    end
    if starts_keyword(r, "async") then
        r = trim_after_keyword(r, "async")
    end
    if starts_keyword(r, "fun") then
        r = trim_after_keyword(r, "fun")
    end
    if starts_keyword(r, "function") then
        r = trim_after_keyword(r, "function")
    end
    first_ident(r)
end

fun split_prefix_after_dot(prefix): str
    out = prefix
    p = find_from(out, ".", 1)
    while p ~= 0
        out = string.sub(out, p + 1)
        p = find_from(out, ".", 1)
    end
    out
end

fun word_prefix_lo(text, lo, line, col): str
    ln = get_line_lo(text, lo, line)
    if ln == nil then return "" end
    n = string.len(ln)
    if col < 0 then col = 0 end
    if col > n then col = n end
    if col == 0 then return "" end
    start = col
    while start > 1 and is_word_char_byte(string.byte(ln, start - 1)) do
        start = start - 1
    end
    if start >= col then return "" end
    split_prefix_after_dot(string.sub(ln, start, col - 1))
end

-- ── comment stripping + head-keyword analysis ───────────────────────────────
fun strip_comment(line): str
    n = string.len(line)
    i = 1
    in_str = false
    str_ch = 0
    while i <= n
        b = string.byte(line, i)
        if in_str then
            if b == str_ch then in_str = false end
        elseif b == 34 or b == 39 then
            in_str = true
            str_ch = b
        elseif b == 45 and i < n and string.byte(line, i + 1) == 45 then
            return string.sub(line, 1, i - 1)
        end
        i = i + 1
    end
    line
end

fun head_keyword(line): any
    code = strip_comment(line)
    ctrim = trim(code)
    indent = 0
    while indent < string.len(line) and string.byte(line, indent + 1) == 32 do
        indent = indent + 1
    end
    if ctrim == "" then
        r = {}
        r.kw = ""
        r.rest = ""
        r.indent = indent
        return r
    end
    b = string.byte(ctrim, 1)
    if not is_ident_start(b) then
        r = {}
        r.kw = ""
        r.rest = ctrim
        r.indent = indent
        return r
    end
    i = 1
    n = string.len(ctrim)
    while i <= n and is_ident_char(string.byte(ctrim, i)) do
        i = i + 1
    end
    r = {}
    r.kw = string.sub(ctrim, 1, i - 1)
    r.rest = string.sub(ctrim, i)
    r.indent = indent
    r
end

fun is_block_opener(kw: any): bool
    return kw == "fun" or kw == "function" or kw == "enum" or kw == "concept" or
        kw == "match" or kw == "if" or kw == "while" or kw == "for" or
        kw == "do" or kw == "begin" or kw == "struct"
end

fun kind_of(kw: any)
    if kw == "fun" or kw == "function" then return 12 end
    if kw == "enum" then return 10 end
    if kw == "concept" then return 11 end
    return 23
end

fun kind_label(k): str
    if k == 12 then return "function" end
    if k == 10 then return "enum" end
    if k == 11 then return "concept" end
    if k == 23 then return "struct" end
    if k == 26 then return "alias" end
    if k == 14 then return "constant" end
    "variable"
end

fun is_upper(name): bool
    n = string.len(name)
    if n == 0 then return false end
    i = 1
    while i <= n
        b = string.byte(name, i)
        if not ((b >= 65 and b <= 90) or b == 95 or (b >= 48 and b <= 57)) then
            return false
        end
        i = i + 1
    end
    true
end

fun match_typed(code): any
    n = string.len(code)
    if n == 0 then return nil end
    i = 1
    b = string.byte(code, i)
    if not is_ident_start(b) then return nil end
    while i <= n and is_ident_char(string.byte(code, i)) do
        i = i + 1
    end
    name = string.sub(code, 1, i - 1)
    while i <= n and string.byte(code, i) == 32 do i = i + 1 end
    if i > n then return nil end
    if string.byte(code, i) ~= 58 then return nil end
    name
end

fun match_plain_assign(code): any
    n = string.len(code)
    if n == 0 then return nil end
    i = 1
    b = string.byte(code, i)
    if not is_ident_start(b) then return nil end
    while i <= n and is_ident_char(string.byte(code, i)) do
        i = i + 1
    end
    name = string.sub(code, 1, i - 1)
    while i <= n and string.byte(code, i) == 32 do i = i + 1 end
    if i > n then return nil end
    if string.byte(code, i) == 61 then return name end
    nil
end

fun mk_sym(name, kind, line, col, raw_line): any
    s = {}
    s.name = name
    s.kind = kind
    s.line = line
    s.col = col
    s.endLine = line
    s.endCol = string.len(raw_line)
    s.detail = trim(raw_line)
    s
end

-- ── symbol scanner ──────────────────────────────────────────────────────────
-- scan_symbols_lo(text, lo) iterates logical lines via the cached line-offset
-- table (no per-line O(n) scans, no array materialisation of every line).
fun scan_symbols_lo(text, lo): any
    syms = {}
    depth = 0
    brace = 0
    n = rawlen(lo)
    i = 1
    while i <= n
        raw = get_line_lo(text, lo, i - 1)
        if raw == nil then break end
        code = strip_comment(raw)
        opens = count_char(code, "{")
        closes = count_char(code, "}")
        top = (depth == 0 and brace == 0)
        ends = count_end(code)
        brace = brace + opens - closes
        if brace < 0 then brace = 0 end
        info = head_keyword(raw)
        kw = info.kw
        rest = info.rest
        indent = info.indent
        if kw == "end" then
            depth = depth + ends - 1
            if depth < 0 then depth = 0 end
        elseif is_block_opener(kw) and kw ~= "do" and kw ~= "begin" then
            if top and (kw == "fun" or kw == "function" or kw == "enum" or kw == "concept") then
                id = first_ident(rest)
                if id ~= nil then
                    syms[rawlen(syms) + 1] = mk_sym(id.name, kind_of(kw), i - 1, indent, raw)
                end
            elseif top and (kw == "local" or kw == "global") then
                if starts_keyword(rest, "fun") or starts_keyword(rest, "function") then
                    id = name_after_keywords(rest)
                    if id ~= nil then
                        syms[rawlen(syms) + 1] = mk_sym(id.name, 12, i - 1, indent, raw)
                    end
                else
                    id = first_ident(rest)
                    if id ~= nil then
                        k = 13
                        if kw == "global" or is_upper(id.name) then k = 14 end
                        syms[rawlen(syms) + 1] = mk_sym(id.name, k, i - 1, indent, raw)
                    end
                end
            elseif kw == "const" then
                id = first_ident(rest)
                if id ~= nil then
                    syms[rawlen(syms) + 1] = mk_sym(id.name, 14, i - 1, indent, raw)
                end
            else
                tb = match_typed(code)
                if tb ~= nil then
                    syms[rawlen(syms) + 1] = mk_sym(tb, 13, i - 1, indent, raw)
                else
                    pa = match_plain_assign(code)
                    if pa ~= nil and not starts_with(rest, ".") and not contains_char(raw, ".") then
                        syms[rawlen(syms) + 1] = mk_sym(pa, 13, i - 1, indent, raw)
                    end
                end
            end
        end
        i = i + 1
    end
    syms
end

fun symbol_at(syms, line, col): any
    n = rawlen(syms)
    i = 1
    while i <= n
        s = syms[i]
        if s.line == line then
            name_len = string.len(s.name)
            if col >= s.col and col < s.col + name_len then
                return s
            end
        end
        i = i + 1
    end
    nil
end

fun word_end_lo(text, lo, line, col): i64
    ln = get_line_lo(text, lo, line)
    if ln == nil then return col + 1 end
    n = string.len(ln)
    e = col
    while e < n
        b = string.byte(ln, e + 1)
        if is_word_char_byte(b) then
            e = e + 1
        else
            break
        end
    end
    if e == col then return col + 1 end
    e
end

-- ── LSP position / range ────────────────────────────────────────────────────
fun mk_pos(line, ch): any
    p = {}
    p.line = line
    p.character = ch
    p
end

fun mk_range(sl, sc, ec): any
    r = {}
    r.start = mk_pos(sl, sc)
    r["end"] = mk_pos(sl, ec)
    r
end

-- ── diagnostic parsing ──────────────────────────────────────────────────────
-- duo's compiler emits locations as a debug struct dump:
--   .{ .file = {bytes}, .line = L, .col = C }: error: msg
-- We also accept the clean `path:L:C: error: msg` form.

fun parse_digits(s, i): any
    n = string.len(s)
    v = 0
    any = false
    while i <= n
        b = string.byte(s, i)
        if b >= 48 and b <= 57 then
            v = v * 10 + (b - 48)
            any = true
            i = i + 1
        else
            break
        end
    end
    if not any then return nil end
    r = {}
    r.val = v
    r.next = i
    r
end

fun parse_diag_line(line): any
    n = string.len(line)
    p = find_from(line, ".line = ", 1)
    if p ~= 0 then
        i = p + 8
        ld = parse_digits(line, i)
        if ld == nil then return nil end
        lnum = ld.val
        p2 = find_from(line, ", .col = ", p + 8)
        if p2 == 0 then return nil end
        cd = parse_digits(line, p2 + 9)
        if cd == nil then return nil end
        cnum = cd.val
        p3 = find_from(line, "}: ", cd.next)
        if p3 == 0 then return nil end
        rest = string.sub(line, p3 + 3)
        sev = 1
        msg = rest
        if starts_with(rest, "error: ") then
            sev = 1
            msg = string.sub(rest, 8)
        elseif starts_with(rest, "warning: ") then
            sev = 2
            msg = string.sub(rest, 10)
        end
        r = {}
        r.line = lnum - 1
        r.col = cnum - 1
        r.severity = sev
        r.message = msg
        return r
    end
    e = find_from(line, ": error: ", 1)
    w = find_from(line, ": warning: ", 1)
    marker = 0
    mlen = 0
    sev = 1
    if e ~= 0 then
        marker = e
        mlen = 9
        sev = 1
    elseif w ~= 0 then
        marker = w
        mlen = 11
        sev = 2
    else
        return nil
    end
    msg = string.sub(line, marker + mlen)
    prefix = string.sub(line, 1, marker - 1)
    c1 = find_last(prefix, ":")
    if c1 == 0 then return nil end
    cnum_str = string.sub(prefix, c1 + 1)
    prefix2 = string.sub(prefix, 1, c1 - 1)
    c2 = find_last(prefix2, ":")
    if c2 == 0 then return nil end
    lnum_str = string.sub(prefix2, c2 + 1)
    lnum = tonumber(lnum_str)
    cnum = tonumber(cnum_str)
    if lnum == nil or cnum == nil then return nil end
    r = {}
    r.line = lnum - 1
    r.col = cnum - 1
    r.severity = sev
    r.message = msg
    r
end

fun parse_diagnostics(out, lo, text): any
    diags = {}
    if out == nil then return diags end
    pos = 1
    n = string.len(out)
    while pos <= n
        nl = find_from(out, "\n", pos)
        line = ""
        if nl == 0 then
            line = string.sub(out, pos)
            pos = n + 1
        else
            line = string.sub(out, pos, nl - 1)
            pos = nl + 1
        end
        d = parse_diag_line(line)
        if d ~= nil then
            ec = word_end_lo(text, lo, d.line, d.col)
            diag = {}
            diag.range = mk_range(d.line, d.col, ec)
            diag.severity = d.severity
            diag.source = "duo"
            diag.message = d.message
            diags[rawlen(diags) + 1] = diag
        end
    end
    diags
end

-- out_of_text_for_diag sentinel removed: parse_diagnostics now takes the doc
-- text explicitly, avoiding any mutable-module-global.

-- ── text sync ───────────────────────────────────────────────────────────────
-- offset_at is only used by apply_changes (which receives a fresh text with no
-- cached line table); we scan by line the simple way there.
fun offset_at(text, pos): i64
    line = pos.line
    chcol = pos.character
    n = string.len(text)
    i = 1
    cur_line = 0
    while i <= n and cur_line < line
        if string.byte(text, i) == 10 then
            cur_line = cur_line + 1
        end
        i = i + 1
    end
    off = i - 1 + chcol
    if off < 0 then off = 0 end
    off
end

fun apply_changes(text, changes): str
    out = text
    n = rawlen(changes)
    i = 1
    while i <= n
        ch = changes[i]
        txt = ch.text
        if txt == nil then txt = "" end
        if ch.range ~= nil then
            s = offset_at(out, ch.range.start)
            e = offset_at(out, ch.range["end"])
            if s < 0 then s = 0 end
            if e < s then e = s end
            out = string.sub(out, 1, s) .. txt .. string.sub(out, e + 1)
        else
            out = txt
        end
        i = i + 1
    end
    out
end

-- ── completion ─────────────────────────────────────────────────────────────
fun completion_matches(name, prefix): bool
    if prefix == "" then return true end
    if starts_with(name, prefix) then return true end
    p = find_from(name, ":", 1)
    while p ~= 0
        if starts_with(string.sub(name, p + 1), prefix) then return true end
        p = find_from(name, ":", p + 1)
    end
    p = find_from(name, ".", 1)
    while p ~= 0
        if starts_with(string.sub(name, p + 1), prefix) then return true end
        p = find_from(name, ".", p + 1)
    end
    false
end

fun completion_kind_for_symbol(k): i64
    if k == 12 then return 3 end
    if k == 10 then return 10 end
    if k == 11 then return 11 end
    if k == 23 or k == 26 then return 7 end
    if k == 14 then return 21 end
    return 13
end

fun add_completion(out, seen, label, kind, detail, insert_text, sort_text): void
    if label == nil or label == "" then return end
    if seen[label] ~= nil then return end
    seen[label] = true
    item = {}
    item.label = label
    item.kind = kind
    if detail ~= nil and detail ~= "" then item.detail = detail end
    if insert_text ~= nil and insert_text ~= label then item.insertText = insert_text end
    if sort_text ~= nil then item.sortText = sort_text end
    out[rawlen(out) + 1] = item
end

fun add_keyword_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 14, "Duo keyword", nil, "k_" .. label)
    end
end

fun add_snippet_completion(out, seen, label, detail, insert_text, prefix, sort_text): void
    if completion_matches(label, prefix) then
        item = {}
        item.label = label
        item.kind = 15
        item.detail = detail
        item.insertText = insert_text
        item.insertTextFormat = 2
        item.sortText = sort_text
        out[rawlen(out) + 1] = item
    end
end

fun add_builtin_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 3, "Duo builtin", nil, "b_" .. label)
    end
end

fun add_std_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 9, "std module", nil, "m_" .. label)
    end
end

fun add_type_completion(out, seen, label, prefix): void
    if completion_matches(label, prefix) then
        add_completion(out, seen, label, 7, "Duo type", nil, "t_" .. label)
    end
end

