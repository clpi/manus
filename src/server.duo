end

-- ── shell + io ────────────────────────────────────────────────────────────
fun shell_quote(s): str
    return "'" .. string.gsub(s, "'", "'\\''") .. "'"
end

fun resolve_duo_bin(): any
    b = os.getenv("DUO_LSP_DUO_BIN")
    if b ~= nil and b ~= "" then return b end
    b = os.getenv("DUO_BIN")
    if b ~= nil and b ~= "" then return b end
    f = io.popen("which duo 2>/dev/null", "r")
    if f ~= nil then
        out = f:read("*a")
        f:close()
        out = trim(out)
        if out ~= "" then return out end
    end
    nil
end

fun doc_ext(uri): str
    if ends_with(uri, ".duo") then return ".duo" end
    if ends_with(uri, ".lua") then return ".lua" end
    ".duo"
end

-- ── JSON-RPC transport (uses std.json.encode) ───────────────────────────────
fun send_message(t): void
    body = io.lsp.json.encode(t)
    header = string.format("Content-Length: %d\r\n\r\n", string.len(body))
    io.write(header, body)
    io.flush()
end

fun reply(id, result): void
    m = {}
    m.jsonrpc = "2.0"
    m.id = id
    m.result = result
    send_message(m)
end

fun reply_error(id, code, message): void
    e = {}
    e.code = code
    e.message = message
    m = {}
    m.jsonrpc = "2.0"
    m.id = id
    m.error = e
    send_message(m)
end

fun send_diagnostics(uri, diags): void
    params = {}
    params.uri = uri
    params.diagnostics = diags
    m = {}
    m.jsonrpc = "2.0"
    m.method = "textDocument/publishDiagnostics"
    m.params = params
    send_message(m)
end

-- ── server state ────────────────────────────────────────────────────────────
io.lsp.docs = {}
io.lsp.duo_bin = nil
io.lsp.counter = 0
io.lsp.shutdown = false
io.lsp.do_exit = false

fun now_secs(): i64
    return os.time()
end

fun doc_for(uri): any
    d = io.lsp.docs[uri]
    if d == nil then
        d = {}
        d.text = ""
        d.version = 0
        d.tmp = nil
        d.lo = nil
        d.syms = nil
        d.syms_version = -1
        d.dirty = false
        d.last_t = 0
        io.lsp.docs[uri] = d
    end
    d
end

-- Ensure d.lo matches d.text (recompute lazily on use).
fun ensure_lo(d): void
    if d.lo == nil then
        d.lo = compute_line_offs(d.text)
    end
end

-- Ensure d.syms matches d.text (cached per version).
fun ensure_syms(d): void
    ensure_lo(d)
    if d.syms == nil or d.syms_version ~= d.version then
        d.syms = scan_symbols_lo(d.text, d.lo)
        d.syms_version = d.version
    end
end

fun invalidate(d): void
    d.lo = nil
    d.syms = nil
end

fun run_check(uri): void
    d = io.lsp.docs[uri]
    if d == nil then return end
    if io.lsp.duo_bin == nil then
        send_diagnostics(uri, {})
        return
    end
    ext = doc_ext(uri)
    if d.tmp == nil then
        io.lsp.counter = io.lsp.counter + 1
        d.tmp = os.tmpname() .. "_" .. tostring(io.lsp.counter) .. ext
    end
    f = io.open(d.tmp, "w")
    if f ~= nil then
        f:write(d.text)
        f:close()
    end
    cmd = shell_quote(io.lsp.duo_bin) .. " check " .. shell_quote(d.tmp) .. " 2>&1"
    p = io.popen(cmd, "r")
    if p == nil then return end
    out = p:read("*a")
    p:close()
    ensure_lo(d)
    diags = parse_diagnostics(out, d.lo, d.text)
    send_diagnostics(uri, diags)
end

fun schedule_check(uri): void
    d = io.lsp.docs[uri]
    if d == nil then return end
    if io.lsp.duo_bin == nil then
        send_diagnostics(uri, {})
        return
    end
    t = now_secs()
    if d.last_t == 0 or t > d.last_t then
        run_check(uri)
        d.last_t = t
        d.dirty = false
    else
        d.dirty = true
    end
end

fun flush_dirty(): void
    docs = io.lsp.docs
    t = now_secs()
    for uri, d in pairs(docs) do
        if d.dirty then
            if t > d.last_t then
                run_check(uri)
                d.last_t = t
                d.dirty = false
            end
        end
    end
end

-- ── LSP message framing (uses std.json.decode) ─────────────────────────────
fun read_line(): any
    out = {}
    while true
        c = io.read(1)
        if c == nil then
            if rawlen(out) == 0 then return nil end
            break
        end
        if c == "\n" then break end
        if c ~= "\r" then out[rawlen(out) + 1] = c end
    end
    table.concat(out)
end

fun read_message(): any
    content_length = -1
    while true
        line = read_line()
        if line == nil then return nil end
        if line == "" then break end
        p = find_from(line, "Content-Length:", 1)
        if p ~= 0 then
            rest = trim(string.sub(line, p + 15))
            n = tonumber(rest)
            if n ~= nil then content_length = n end
        end
    end
    if content_length < 0 then return nil end
    body = io.read(content_length)
    if body == nil then return nil end
    io.lsp.json.decode(body)
end

-- ── LSP handlers ─────────────────────────────────────────────────────────────
fun handle_initialize(params): any
    caps = {}
    caps.textDocumentSync = 2
    caps.documentSymbolProvider = true
    caps.hoverProvider = true
    caps.definitionProvider = true
    cp = {}
    cp.resolveProvider = false
    triggers = {}
    triggers[rawlen(triggers) + 1] = "."
    triggers[rawlen(triggers) + 1] = ":"
    cp.triggerCharacters = triggers
    caps.completionProvider = cp
    info = {}
    info.name = "duo-lsp"
    info.version = "0.2.0"
    r = {}
    r.capabilities = caps
    r.serverInfo = info
    r
end

fun handle_did_open(params): void
    td = params.textDocument
    if td == nil then return end
    uri = td.uri
    if not (ends_with(uri, ".duo") or ends_with(uri, ".lua")) then return end
    d = doc_for(uri)
    d.text = td.text
    if d.text == nil then d.text = "" end
    d.version = td.version
    if d.version == nil then d.version = 0 end
    invalidate(d)
    schedule_check(uri)
end

fun handle_did_change(params): void
    td = params.textDocument
    if td == nil then return end
    uri = td.uri
    d = io.lsp.docs[uri]
    if d == nil then
        d = doc_for(uri)
    end
    new_version = td.version
    if new_version == nil then new_version = d.version + 1 end
    d.version = new_version
    d.text = apply_changes(d.text, params.contentChanges)
    invalidate(d)
    schedule_check(uri)
end

fun handle_did_close(params): void
    td = params.textDocument
    if td == nil then return end
    uri = td.uri
    d = io.lsp.docs[uri]
    if d ~= nil and d.tmp ~= nil then
        os.remove(d.tmp)
    end
    io.lsp.docs[uri] = nil
    send_diagnostics(uri, {})
end

fun handle_did_save(params): void
    td = params.textDocument
    if td == nil then return end
    uri = td.uri
    if io.lsp.docs[uri] ~= nil then
        d = io.lsp.docs[uri]
        if params.text ~= nil then
            d.text = params.text
            invalidate(d)
        end
        run_check(uri)
        d.last_t = now_secs()
        d.dirty = false
    end
end

fun handle_document_symbol(params): any
    uri = params.textDocument.uri
    d = io.lsp.docs[uri]
    if d == nil then return {} end
    ensure_syms(d)
    syms = d.syms
    out = {}
    n = rawlen(syms)
    i = 1
    while i <= n
        s = syms[i]
        o = {}
        o.name = s.name
        o.kind = s.kind
        o.range = mk_range(s.line, s.col, s.endCol)
        o.selectionRange = mk_range(s.line, s.col, s.col + string.len(s.name))
        out[rawlen(out) + 1] = o
        i = i + 1
    end
    out
end

fun handle_hover(params): any
    uri = params.textDocument.uri
    d = io.lsp.docs[uri]
    if d == nil then return nil end
    ensure_syms(d)
    s = symbol_at(d.syms, params.position.line, params.position.character)
    if s == nil then return nil end
    ensure_lo(d)
    ln = get_line_lo(d.text, d.lo, s.line)
    sig = ""
    if ln ~= nil then sig = trim(ln) end
    c = {}
    c.kind = "markdown"
    c.value = "```duo\n" .. sig .. "\n```\n_" .. kind_label(s.kind) .. "_ **" .. s.name .. "**"
    r = {}
    r.contents = c
    r.range = mk_range(s.line, s.col, s.col + string.len(s.name))
    r
end

fun handle_definition(params): any
    uri = params.textDocument.uri
    d = io.lsp.docs[uri]
    if d == nil then return nil end
    ensure_syms(d)
    s = symbol_at(d.syms, params.position.line, params.position.character)
    if s == nil then return nil end
    r = {}
    r.uri = uri
    r.range = mk_range(s.line, s.col, s.col + string.len(s.name))
    r
end

fun handle_completion(params): any
    uri = params.textDocument.uri
    d = io.lsp.docs[uri]
    if d == nil then return {} end
    ensure_lo(d)
    ensure_syms(d)
    line = params.position.line
    col = params.position.character
    prefix = word_prefix_lo(d.text, d.lo, line, col)
    out = {}
    seen = {}
    -- Document symbols as completion candidates.
    n = rawlen(d.syms)
    i = 1
    while i <= n
        s = d.syms[i]
        if completion_matches(s.name, prefix) then
            add_completion(out, seen, s.name, completion_kind_for_symbol(s.kind),
                kind_label(s.kind), nil, "z_" .. s.name)
        end
        i = i + 1
    end
    add_static_completions(out, seen, prefix)
    out
end

fun handle_message(msg): void
    method = msg.method
    id = msg.id
    params = msg.params
    if params == nil then params = {} end
    if method == "initialize" then
        reply(id, handle_initialize(params))
    elseif method == "shutdown" then
        io.lsp.shutdown = true
        reply(id, nil)
    elseif method == "exit" then
        io.lsp.do_exit = true
    elseif method == "initialized" then
        nil
    elseif method == "textDocument/didOpen" then
        handle_did_open(params)
    elseif method == "textDocument/didChange" then
        handle_did_change(params)
    elseif method == "textDocument/didClose" then
        handle_did_close(params)
    elseif method == "textDocument/didSave" then
        handle_did_save(params)
    elseif method == "textDocument/documentSymbol" then
        reply(id, handle_document_symbol(params))
    elseif method == "textDocument/hover" then
        reply(id, handle_hover(params))
    elseif method == "textDocument/definition" then
        reply(id, handle_definition(params))
    elseif method == "textDocument/completion" then
        reply(id, handle_completion(params))
    elseif id ~= nil then
        reply_error(id, -32601, "method not found: " .. tostring(method))
    end
end

-- ── main loop ───────────────────────────────────────────────────────────────
fun lsp_main(): void
    io.lsp.duo_bin = resolve_duo_bin()
    while true
        msg = read_message()
        if msg == nil then break end
        handle_message(msg)
        flush_dirty()
        if io.lsp.do_exit then break end
    end
    if io.lsp.shutdown then
        os.exit(0)
    else
        os.exit(1)
    end
end

lsp_main()