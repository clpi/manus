      pc = __r65[2]
      __r66 = read_u32(body, pc)
      mem_src = __r66[1]
      pc = __r66[2]
      n: i64 = op_pop_i64(w)
      src: i64 = op_pop_i64(w)
      dest: i64 = op_pop_i64(w)
      @c.emit([[ ward_do_memory_copy((WardRT*)w, (int64_t)dest, (int64_t)src, (int64_t)n) ]])
      return pc
    elseif sub == 0x0B then
      mem: i64
      __r67 = read_u32(body, pc)
      mem = __r67[1]
      pc = __r67[2]
      n: i64 = op_pop_i64(w)
      val: i64 = op_pop_i64(w)
      dest: i64 = op_pop_i64(w)
      @c.emit([[ ward_do_memory_fill((WardRT*)w, (int64_t)dest, (int64_t)val, (int64_t)n) ]])
      return pc
    else
      error("unsupported bulk memory opcode")
    end
  end
  case _ then do
    error("unsupported opcode: " .. tostring(opcode))
  end
  end

  pc
end

