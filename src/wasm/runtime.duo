-- ward WASM runtime interpreter
-- All hot-path state lives in a raw C struct (WardRT); operand stack,
-- locals, and globals are int64_t arrays with NO lua_Value boxing.
-- Floats are stored as IEEE bit-casts — type is known statically per WASM op.
-- The Lua `rt` table remains only for off-hot-path interop (module, imports,
-- exports_map, memory buffer snapshot, fuel mirror, call_stack).

@c.include("stdlib.h")
@c.include("string.h")
@c.include("math.h")

@c.emit([[
#include <sys/mman.h>
#include <signal.h>
#include <unistd.h>
#include <stdio.h>
#ifdef WARD_DEBUG
#define WARD_DBG(...) fprintf(stderr, __VA_ARGS__)
#else
#define WARD_DBG(...) ((void)0)
#endif
 #define WARD_STACK_SLOTS 65536
#define WARD_PAGE_SIZE   65536
#define WARD_MAX_LABELS  64
#define WARD_MAX_ARGS    32

typedef struct {
    int64_t pc;
    int64_t end_pc;
    int64_t else_pc;
    int64_t is_loop;
} WardLabel;

typedef struct WardFrame {
    int64_t   locals_count;
    int64_t  *locals;            /* raw int64_t (params + declared locals) */
    WardLabel labels[WARD_MAX_LABELS];
    int64_t   labels_len;
    int64_t   func_idx;
    int64_t   sp_base;
} WardFrame;

typedef struct WardRT {
    int64_t    pages;
    int64_t    max_pages;
    uint8_t   *memory;            /* raw heap pointer (NULL if no memory) */
    int64_t    memory_size;       /* bytes */
    int64_t  *stack;              /* raw int64_t operand stack (WARD_STACK_SLOTS slots) */
    int64_t   sp;                /* top index (0 = empty) */
    int64_t  *globals;            /* raw int64_t globals array (NULL if none) */
    int64_t   globals_count;
    int64_t   *table;             /* function index table for call_indirect */
    int64_t    table_size;
    uint8_t   *snapshot;          /* NULL if no snapshot */
    int64_t    snapshot_size;
    int64_t    fuel;
} WardRT;

/* ── Guard-page linear memory ────────────────────────────────────────────
 * A wasm32 access is computed as (uint32_t)addr + offset, so it can never
 * exceed 4GiB + 4GiB = 8GiB from the memory base. We reserve that whole
 * range as PROT_NONE up front and commit only the live pages, which buys
 * two things:
 *   1. Every out-of-bounds access lands in reserved-but-unmapped space and
 *      is trapped by the MMU — so loads/stores need NO explicit bounds
 *      check in the interpreter loop.
 *   2. The base pointer never moves, so memory.grow is an O(1) mprotect
 *      instead of a realloc+copy, and no cached pointer can dangle.
 * This mirrors what wasmtime and wasmer do for their wasm32 heaps. */
#define WARD_MAX_PAGES   65536   /* wasm32 spec limit: 4GiB */
#define WARD_MEM_RESERVE ((size_t)8 * 1024 * 1024 * 1024)

#ifndef MAP_NORESERVE
#define MAP_NORESERVE 0
#endif

/* Reserve the 8GiB guard region. Returns NULL on failure. */
static uint8_t* ward_mem_reserve(void) {
    void* p = mmap(NULL, WARD_MEM_RESERVE, PROT_NONE,
                   MAP_PRIVATE | MAP_ANON | MAP_NORESERVE, -1, 0);
    return (p == MAP_FAILED) ? NULL : (uint8_t*)p;
}

/* Commit [old_bytes, new_bytes) as readable/writable. Anonymous pages are
 * zero-filled by the kernel on first touch, so no memset is needed — that
 * is what keeps grow O(1). Returns 0 on success, -1 on failure. */
static int ward_mem_commit(uint8_t* base, size_t old_bytes, size_t new_bytes) {
    if (new_bytes <= old_bytes) return 0;
    if (new_bytes > WARD_MEM_RESERVE) return -1;
    return mprotect(base + old_bytes, new_bytes - old_bytes,
                    PROT_READ | PROT_WRITE);
}

/* Turn a guard-page fault into a proper wasm trap instead of a bare
 * SIGBUS/SIGSEGV. SA_SIGINFO gives us the faulting address, which we report
 * as an offset from the linear-memory base — that offset is exactly the
 * wasm address the module tried to touch, so a bad access points straight
 * at the opcode that computed it. */
static uint8_t* ward_fault_base = NULL;
static int64_t   ward_fault_size = 0;

static void ward_mem_fault(int sig, siginfo_t* si, void* uctx) {
    (void)sig; (void)uctx;
    char buf[192];
    int n;
    if (ward_fault_base != NULL && si != NULL) {
        long long off = (long long)((uint8_t*)si->si_addr - ward_fault_base);
        n = snprintf(buf, sizeof buf,
                     "wasm trap: out of bounds memory access "
                     "(addr=0x%llx, linear memory = %lld bytes)\n",
                     off, (long long)ward_fault_size);
    } else {
        n = snprintf(buf, sizeof buf, "wasm trap: out of bounds memory access\n");
    }
    if (n > 0) { ssize_t _w = write(2, buf, (size_t)n); (void)_w; }
#ifdef WARD_DEBUG
    for (int k = 0; k < 32; k++) {
        int idx = (dbg_ring_i + k) % 32;
        fprintf(stderr, "RING pc=%lld op=0x%02x sp=%lld\n",
                (long long)dbg_ring_pc[idx], dbg_ring_op[idx], (long long)dbg_ring_sp[idx]);
    }
#endif
    _exit(134);
}

static void ward_install_fault_handler(void) {
    struct sigaction sa;
    memset(&sa, 0, sizeof(sa));
    sa.sa_sigaction = ward_mem_fault;
    sa.sa_flags = SA_SIGINFO | SA_NODEFER;
    sigaction(SIGSEGV, &sa, NULL);
    sigaction(SIGBUS, &sa, NULL);
}

/* Reserve + commit the instance's linear memory and publish it into WardRT.
 * Returns the base pointer; aborts with a diagnostic if the host cannot
 * provide the region. Kept out of the inline @c.emit at the call site so the
 * message string literals live in a top-level emit block. */
static uint8_t* ward_mem_init_region(WardRT* w, int64_t initial_pages) {
    ward_install_fault_handler();
    uint8_t* base = ward_mem_reserve();
    if (base == NULL) {
        fprintf(stderr, "ward: cannot reserve %zu-byte linear memory region\n",
                WARD_MEM_RESERVE);
        _exit(1);
    }
    if (ward_mem_commit(base, 0, (size_t)(initial_pages * WARD_PAGE_SIZE)) != 0) {
        fprintf(stderr, "ward: cannot commit %lld initial pages\n",
                (long long)initial_pages);
        _exit(1);
    }
    w->memory = base;
    ward_fault_base = base;
    w->pages = initial_pages;
    w->memory_size = initial_pages * WARD_PAGE_SIZE;
    ward_fault_size = w->memory_size;
    return base;
}

/* Saturating float->int truncation (0xFC 0x00-0x07). Unlike the trapping
 * i32.trunc_* family these clamp instead of trapping: NaN yields 0 and
 * out-of-range values saturate to the destination's min/max. */
#ifdef WARD_DEBUG
/* Last-32-instruction trace ring, for post-mortem of a bad dispatch.
 * Debug-only: an unconditional store+modulo per opcode is far too costly
 * for the dispatch loop. */
static int64_t dbg_ring_pc[32];
static uint8_t dbg_ring_op[32];
static int64_t dbg_ring_sp[32];
static int      dbg_ring_i = 0;
#endif

static inline int32_t ward_trunc_sat_i32_s(double d) {
    if (d != d) return 0;
    if (d < -2147483648.0) return INT32_MIN;
    if (d >= 2147483648.0) return INT32_MAX;
    return (int32_t)d;
}
static inline uint32_t ward_trunc_sat_i32_u(double d) {
    if (d != d) return 0;
    if (d < 0.0) return 0;
    if (d >= 4294967296.0) return UINT32_MAX;
    return (uint32_t)d;
}
static inline int64_t ward_trunc_sat_i64_s(double d) {
    if (d != d) return 0;
    if (d < -9223372036854775808.0) return INT64_MIN;
    if (d >= 9223372036854775808.0) return INT64_MAX;
    return (int64_t)d;
}
static inline uint64_t ward_trunc_sat_i64_u(double d) {
    if (d != d) return 0;
    if (d < 0.0) return 0;
    if (d >= 18446744073709551616.0) return UINT64_MAX;
    return (uint64_t)d;
}

/* ─── SIMD (v128) support ────────────────────────────────────────────
 * A v128 lives in two operand-stack slots: lo pushed first, hi on top.
 * The WV_* macros generate every lane op, so each opcode costs one line. */
typedef union {
    int64_t  i64[2];  uint64_t u64[2];
    int32_t  i32[4];  uint32_t u32[4];
    int16_t  i16[8];  uint16_t u16[8];
    int8_t   i8[16];  uint8_t  u8[16];
    float    f32[4];  double   f64[2];
} WardV128;

#define WV_POP(v)   do { (v).i64[1] = stack[sp--]; (v).i64[0] = stack[sp--]; } while (0)
#define WV_PUSH(v)  do { stack[++sp] = (v).i64[0]; stack[++sp] = (v).i64[1]; } while (0)
#define WV_ONES(x)  ((__typeof__(x))~(__typeof__(x))0)

#define WV_SPLAT(F, N, EXPR) { WardV128 r_; __typeof__(r_.F[0]) s_ = (EXPR); \
    for (int L = 0; L < N; L++) r_.F[L] = s_; WV_PUSH(r_); break; }
#define WV_EXTRACT(F, CAST) { uint32_t l_ = (uint32_t)ward_leb_u32(body, &pc); \
    WardV128 a_; WV_POP(a_); stack[++sp] = (int64_t)(CAST a_.F[l_]); break; }
#define WV_REPLACE(F, T) { uint32_t l_ = (uint32_t)ward_leb_u32(body, &pc); \
    int64_t b_ = stack[sp--]; WardV128 a_; WV_POP(a_); a_.F[l_] = (T)b_; WV_PUSH(a_); break; }
#define WV_UN(F, N, EXPR) { WardV128 a_, r_; WV_POP(a_); \
    for (int L = 0; L < N; L++) r_.F[L] = (EXPR); WV_PUSH(r_); break; }
#define WV_BIN(F, N, EXPR) { WardV128 b_, a_, r_; WV_POP(b_); WV_POP(a_); \
    for (int L = 0; L < N; L++) r_.F[L] = (EXPR); WV_PUSH(r_); break; }
#define WV_CMP(F, UF, N, OP) { WardV128 b_, a_, r_; WV_POP(b_); WV_POP(a_); \
    for (int L = 0; L < N; L++) r_.UF[L] = (a_.F[L] OP b_.F[L]) ? WV_ONES(r_.UF[0]) : 0; \
    WV_PUSH(r_); break; }
#define WV_CMPU(F, UF, N, OP) WV_CMP(F, UF, N, OP)
#define WV_FNE(F, UF, N)      WV_CMP(F, UF, N, !=)
#define WV_BIT(OP) { WardV128 b_, a_, r_; WV_POP(b_); WV_POP(a_); \
    r_.u64[0] = a_.u64[0] OP b_.u64[0]; r_.u64[1] = a_.u64[1] OP b_.u64[1]; \
    WV_PUSH(r_); break; }

static inline int ward_mem_ok(WardRT* w, int64_t ea, int64_t n) {
    return ea >= 0 && w->memory != NULL && (ea + n) <= w->memory_size;
}
/* wasm min/max are not C's: NaN propagates, and +-0 ties pick by sign. */
static inline float  ward_f32_abs(float a)  { return a < 0.0f ? -a : (a == 0.0f ? 0.0f : a); }
static inline double ward_f64_abs(double a) { return a < 0.0  ? -a : (a == 0.0  ? 0.0  : a); }
static inline float ward_f32_min(float a, float b) {
    if (a != a || b != b) return (float)NAN;
    if (a == 0.0f && b == 0.0f) return (signbit(a) || signbit(b)) ? -0.0f : 0.0f;
    return a < b ? a : b;
}
static inline float ward_f32_max(float a, float b) {
    if (a != a || b != b) return (float)NAN;
    if (a == 0.0f && b == 0.0f) return (signbit(a) && signbit(b)) ? -0.0f : 0.0f;
    return a > b ? a : b;
}
static inline double ward_f64_min(double a, double b) {
    if (a != a || b != b) return (double)NAN;
    if (a == 0.0 && b == 0.0) return (signbit(a) || signbit(b)) ? -0.0 : 0.0;
    return a < b ? a : b;
}
static inline double ward_f64_max(double a, double b) {
    if (a != a || b != b) return (double)NAN;
    if (a == 0.0 && b == 0.0) return (signbit(a) && signbit(b)) ? -0.0 : 0.0;
    return a > b ? a : b;
}

static inline int64_t ward_pop_i64(WardRT* w) { return w->stack[w->sp--]; }
static inline void   ward_push_i64(WardRT* w, int64_t v) { w->stack[++w->sp] = v; }
static inline int64_t ward_peek_i64(WardRT* w) { return w->stack[w->sp]; }

static inline void   ward_push_f32(WardRT* w, float f) {
    int32_t i; memcpy(&i, &f, 4);
    w->stack[++w->sp] = (int64_t)(uint32_t)i;
}
static inline float  ward_pop_f32(WardRT* w) {
    int64_t b = w->stack[w->sp--]; int32_t i = (int32_t)b;
    float f; memcpy(&f, &i, 4); return f;
}
static inline void   ward_push_f64(WardRT* w, double d) {
    int64_t bits; memcpy(&bits, &d, 8);
    w->stack[++w->sp] = bits;
}
static inline double ward_pop_f64(WardRT* w) {
    int64_t b = w->stack[w->sp--]; double d;
    memcpy(&d, &b, 8); return d;
}

static inline int64_t ward_mem_load_i32(WardRT* w, int64_t addr) {
    int32_t v; memcpy(&v, w->memory + (uint32_t)(addr), 4); return (int64_t)v;
}
static inline void   ward_mem_store_i32(WardRT* w, int64_t addr, int64_t val) {
    int32_t v = (int32_t)val; memcpy(w->memory + (uint32_t)(addr), &v, 4);
}
static inline int64_t ward_mem_load_i64(WardRT* w, int64_t addr) {
    int64_t v; memcpy(&v, w->memory + (uint32_t)(addr), 8); return v;
}
static inline void   ward_mem_store_i64(WardRT* w, int64_t addr, int64_t val) {
    int64_t v = val; memcpy(w->memory + (uint32_t)(addr), &v, 8);
}
static inline double ward_mem_load_f32(WardRT* w, int64_t addr) {
    float v; memcpy(&v, w->memory + (uint32_t)(addr), 4); return (double)v;
}
static inline void   ward_mem_store_f32(WardRT* w, int64_t addr, double val) {
    float v = (float)val; memcpy(w->memory + (uint32_t)(addr), &v, 4);
}
static inline double ward_mem_load_f64(WardRT* w, int64_t addr) {
    double v; memcpy(&v, w->memory + (uint32_t)(addr), 8); return v;
}
static inline void   ward_mem_store_f64(WardRT* w, int64_t addr, double val) {
    double v = val; memcpy(w->memory + (uint32_t)(addr), &v, 8);
}
static inline int64_t ward_mem_read_byte(WardRT* w, int64_t addr) {
    return (int64_t)w->memory[(uint32_t)(addr)];
}
static inline void   ward_mem_write_byte(WardRT* w, int64_t addr, int64_t val) {
    w->memory[(uint32_t)(addr)] = (uint8_t)val;
}

static inline int64_t ward_mem_load_i32_8s(WardRT* w, int64_t addr) {
    int8_t v; memcpy(&v, w->memory + (uint32_t)(addr), 1); return (int64_t)v;
}
static inline int64_t ward_mem_load_i32_8u(WardRT* w, int64_t addr) {
    uint8_t v; memcpy(&v, w->memory + (uint32_t)(addr), 1);
    return (int64_t)v;
}
static inline int64_t ward_mem_load_i32_16s(WardRT* w, int64_t addr) {
    int16_t v; memcpy(&v, w->memory + (uint32_t)(addr), 2); return (int64_t)v;
}
static inline int64_t ward_mem_load_i32_16u(WardRT* w, int64_t addr) {
    uint16_t v; memcpy(&v, w->memory + (uint32_t)(addr), 2); return (int64_t)v;
}
static inline int64_t ward_mem_load_i64_8s(WardRT* w, int64_t addr) {
    int8_t v; memcpy(&v, w->memory + (uint32_t)(addr), 1); return (int64_t)v;
}
static inline int64_t ward_mem_load_i64_8u(WardRT* w, int64_t addr) {
    uint8_t v; memcpy(&v, w->memory + (uint32_t)(addr), 1); return (int64_t)v;
}
static inline int64_t ward_mem_load_i64_16s(WardRT* w, int64_t addr) {
    int16_t v; memcpy(&v, w->memory + (uint32_t)(addr), 2); return (int64_t)v;
}
static inline int64_t ward_mem_load_i64_16u(WardRT* w, int64_t addr) {
    uint16_t v; memcpy(&v, w->memory + (uint32_t)(addr), 2); return (int64_t)v;
}
static inline int64_t ward_mem_load_i64_32s(WardRT* w, int64_t addr) {
    int32_t v; memcpy(&v, w->memory + (uint32_t)(addr), 4); return (int64_t)v;
}
static inline int64_t ward_mem_load_i64_32u(WardRT* w, int64_t addr) {
    uint32_t v; memcpy(&v, w->memory + (uint32_t)(addr), 4); return (int64_t)v;
}

static inline void ward_mem_store_i32_8(WardRT* w, int64_t addr, int64_t val) {
    uint8_t v = (uint8_t)val; memcpy(w->memory + (uint32_t)(addr), &v, 1);
}
static inline void ward_mem_store_i32_16(WardRT* w, int64_t addr, int64_t val) {
    uint16_t v = (uint16_t)val; memcpy(w->memory + (uint32_t)(addr), &v, 2);
}
static inline void ward_mem_store_i64_8(WardRT* w, int64_t addr, int64_t val) {
    uint8_t v = (uint8_t)val; memcpy(w->memory + (uint32_t)(addr), &v, 1);
}
static inline void ward_mem_store_i64_16(WardRT* w, int64_t addr, int64_t val) {
    uint16_t v = (uint16_t)val; memcpy(w->memory + (uint32_t)(addr), &v, 2);
}
static inline void ward_mem_store_i64_32(WardRT* w, int64_t addr, int64_t val) {
    uint32_t v = (uint32_t)val; memcpy(w->memory + (uint32_t)(addr), &v, 4);
}

static inline int64_t ward_local_get(WardFrame* f, int64_t i) { return f->locals[i]; }
static inline void    ward_local_set(WardFrame* f, int64_t i, int64_t v) { f->locals[i] = v; }

static inline void ward_label_push(WardFrame* f, int64_t pc, int64_t end_pc,
                                    int64_t else_pc, int64_t is_loop) {
    int64_t n = f->labels_len;
    f->labels[n].pc = pc; f->labels[n].end_pc = end_pc;
    f->labels[n].else_pc = else_pc; f->labels[n].is_loop = is_loop;
    f->labels_len = n + 1;
}
static inline void ward_label_pop(WardFrame* f) { f->labels_len = f->labels_len - 1; }
static inline int64_t ward_label_top_end_pc(WardFrame* f) {
    return f->labels[f->labels_len - 1].end_pc;
}
static inline int64_t ward_label_branch_target(WardFrame* f, int64_t depth) {
    int64_t idx = f->labels_len - 1 - depth;
    if (f->labels[idx].is_loop) return f->labels[idx].pc;
    return f->labels[idx].end_pc;
}

static inline int64_t ward_skip_leb(const uint8_t* p, int64_t pc, int64_t body_len) {
    while (pc <= body_len && (p[pc - 1] & 0x80)) pc++;
    return pc + 1;
}

static inline int64_t ward_read_leb_u32(const uint8_t* p, int64_t pc, int64_t body_len, uint32_t* out) {
    uint64_t result = 0;
    int shift = 0;
    while (pc <= body_len) {
        uint8_t b = p[pc - 1];
        pc++;
        result |= (uint64_t)(b & 0x7F) << shift;
        if (!(b & 0x80)) { *out = (uint32_t)result; return pc; }
        shift += 7;
        if (shift >= 35) break;
    }
    *out = 0;
    return pc;
}

static inline int64_t ward_instr_len(const uint8_t* p, int64_t pc, int64_t body_len) {
    if (pc > body_len) return 1;
    uint8_t b = p[pc - 1];
    int64_t np = pc + 1;
    switch (b) {
        case 0x02: case 0x03: case 0x04: // block/loop/if: blocktype
            np = ward_skip_leb(p, np, body_len); break;
        case 0x0c: case 0x0d: // br/br_if: labelidx
            np = ward_skip_leb(p, np, body_len); break;
        case 0x0e: { // br_table: vec(labelidx) + default
            uint32_t cnt = 0;
            int64_t nnp = ward_read_leb_u32(p, np, body_len, &cnt);
            for (uint32_t i = 0; i < cnt; i++) nnp = ward_skip_leb(p, nnp, body_len);
            nnp = ward_skip_leb(p, nnp, body_len); // default
            np = nnp;
            break;
        }
        case 0x10: // call: funcidx
            np = ward_skip_leb(p, np, body_len); break;
        case 0x11: // call_indirect: typeidx + tableidx
            np = ward_skip_leb(p, np, body_len);
            np = ward_skip_leb(p, np, body_len);
            break;
        case 0x20: case 0x21: case 0x22: case 0x23: case 0x24: // local/global ops
            np = ward_skip_leb(p, np, body_len); break;
        case 0x28: case 0x29: case 0x2a: case 0x2b:
        case 0x2c: case 0x2d: case 0x2e: case 0x2f:
        case 0x30: case 0x31: case 0x32: case 0x33:
        case 0x34: case 0x35: case 0x36: case 0x37:
        case 0x38: case 0x39: case 0x3a: case 0x3b:
        case 0x3c: case 0x3d: case 0x3e: // memory load/store
            np = ward_skip_leb(p, np, body_len); // align
            np = ward_skip_leb(p, np, body_len); // offset
            break;
        case 0x3f: case 0x40: // memory.size/grow: memidx
            np++; break;
        case 0x41: // i32.const
            np = ward_skip_leb(p, np, body_len); break;
        case 0x42: // i64.const
            np = ward_skip_leb(p, np, body_len); break;
        case 0x43: // f32.const
            np += 4; break;
        case 0x44: // f64.const
            np += 8; break;
        case 0xfc: { // multi-byte prefix: 0xFC <sub:leb> <immediates...>
            if (np > body_len) break;
            uint32_t sub = 0;
            np = ward_read_leb_u32(p, np, body_len, &sub);  // consumes the sub-opcode
            if (sub <= 0x07) { /* trunc_sat: no immediates */ }
            else if (sub == 0x08) { np = ward_skip_leb(p, np, body_len); np += 1; } // memory.init dataidx memidx
            else if (sub == 0x09) { np = ward_skip_leb(p, np, body_len); } // data.drop dataidx
            else if (sub == 0x0a) { np += 2; } // memory.copy memidx memidx
            else if (sub == 0x0b) { np += 1; } // memory.fill memidx
            else if (sub == 0x0c) { np = ward_skip_leb(p, np, body_len); np = ward_skip_leb(p, np, body_len); } // table.init elemidx tableidx
            else if (sub == 0x0d) { np = ward_skip_leb(p, np, body_len); } // elem.drop elemidx
            else if (sub == 0x0e) { np = ward_skip_leb(p, np, body_len); np = ward_skip_leb(p, np, body_len); } // table.copy tableidx tableidx
            else if (sub == 0x0f || sub == 0x10 || sub == 0x11) { np = ward_skip_leb(p, np, body_len); } // table.grow/size/fill tableidx
            break;
        }
        case 0xfd: { // SIMD prefix: 0xFD <sub:leb> <immediates...>
            if (np > body_len) break;
            uint32_t sub = 0;
            np = ward_read_leb_u32(p, np, body_len, &sub);
            if (sub <= 11) {                      // v128 load/store family: memarg
                np = ward_skip_leb(p, np, body_len);
                np = ward_skip_leb(p, np, body_len);
            } else if (sub == 12 || sub == 13) {  // v128.const / i8x16.shuffle: 16 bytes
                np += 16;
            } else if (sub >= 21 && sub <= 34) {  // extract_lane / replace_lane: laneidx
                np += 1;
            } else if (sub >= 84 && sub <= 91) {  // load/store lane: memarg + laneidx
                np = ward_skip_leb(p, np, body_len);
                np = ward_skip_leb(p, np, body_len);
                np += 1;
            } else if (sub == 92 || sub == 93) {  // load32_zero / load64_zero: memarg
                np = ward_skip_leb(p, np, body_len);
                np = ward_skip_leb(p, np, body_len);
            }
            break;
        }
        default: break;
    }
    if (np > body_len + 1) np = body_len + 1;
    return np - pc;
}

static inline int64_t ward_find_end_pc(const uint8_t* p, int64_t pc, int64_t body_len) {
    int64_t scan = pc;
    int depth = 1;
    while (scan <= body_len && depth > 0) {
        uint8_t b = p[scan - 1];
        if (b == 0x02 || b == 0x03 || b == 0x04) depth++;
        else if (b == 0x0b) depth--;
        scan += ward_instr_len(p, scan, body_len);
    }
    return scan;
}

static inline int64_t ward_find_else_pc(const uint8_t* p, int64_t pc, int64_t body_len) {
    int64_t scan = pc;
    int depth = 1;
    while (scan <= body_len && depth > 0) {
        uint8_t b = p[scan - 1];
        if (b == 0x02 || b == 0x03 || b == 0x04) depth++;
        else if (b == 0x05 && depth == 1) return scan + 1;
        else if (b == 0x0b) depth--;
        scan += ward_instr_len(p, scan, body_len);
    }
    return 0;
}

static inline WardRT* ward_rt_from_i64(int64_t w_ptr) { return (WardRT*)w_ptr; }
static inline WardFrame* ward_frame_from_i64(int64_t f_ptr) { return (WardFrame*)f_ptr; }

/* ── Fast LEB128 readers (no Lua table allocation) ──────────────────── */
static inline int64_t ward_leb_u32(const uint8_t* p, int64_t* pc) {
    uint64_t result = 0; int shift = 0; uint8_t b;
    do { b = p[(*pc) - 1]; (*pc)++; result |= (uint64_t)(b & 0x7F) << shift; shift += 7; } while (b & 0x80);
    return (int64_t)(uint32_t)result;
}
static inline int64_t ward_leb_i32(const uint8_t* p, int64_t* pc) {
    int64_t result = 0; int shift = 0; uint8_t b;
    do { b = p[(*pc) - 1]; (*pc)++; result |= ((int64_t)(b & 0x7F)) << shift; shift += 7; } while (b & 0x80);
    if (shift < 32 && (b & 0x40)) result |= (((int64_t)-1) << shift);
    return result;
}
static inline int64_t ward_leb_i64(const uint8_t* p, int64_t* pc) {
    int64_t result = 0; int shift = 0; uint8_t b;
    do { b = p[(*pc) - 1]; (*pc)++; result |= ((int64_t)(b & 0x7F)) << shift; shift += 7; } while (b & 0x80);
    if (shift < 64 && (b & 0x40)) result |= (((int64_t)-1) << shift);
    return result;
}
static inline int64_t ward_leb_blocktype(const uint8_t* p, int64_t* pc) {
    /* blocktype is a single s33; empty = 0x40. We just skip it. */
    uint8_t b = p[(*pc) - 1]; (*pc)++;
    if (b & 0x80) { /* multi-byte, skip continuation */ while (p[(*pc) - 1] & 0x80) (*pc)++; (*pc)++; }
    return 0;
}

static inline void ward_do_memory_copy(WardRT* w, int64_t dest, int64_t src, int64_t n) {
    if (n > 0) memmove(w->memory + dest, w->memory + src, (size_t)n);
}

static inline void ward_do_memory_fill(WardRT* w, int64_t dest, int64_t val, int64_t n) {
    if (n > 0) memset(w->memory + dest, (int)val, (size_t)n);
}

static inline WardRT* ward_get_rt(lua_Value rt) {
    return (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
}
 ]])

global mem_mod = req "std.mem"
global module = req "src.wasm.module"
global wasi   = req "src.wasm.wasi"
global jit_mod = req "src.wasm.jit_arm64"

const WASM_PAGE_SIZE = 65536  -- 64KB WASM pages
const STACK_SLOTS = 65536

-- ═══════════════════════════════════════════════════════════════
-- Runtime state
-- ═══════════════════════════════════════════════════════════════
fun runtime_new(config: any): any
  rt = {
    memory = nil,
    pages = 0,
    max_pages = 65536,
    globals = {},
    c = @c.emit([[ ({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = calloc(1, sizeof(WardRT)); _v; }) ]]),
    sp = 0,
    call_stack = {},
    mod = nil,
    imports = {},
    exports_map = {},
    config = config or {},
    fuel = config and config.fuel or 0xFFFFFFFF,
    snapshot = nil,
    args = (config and config.args) or {"wasm"},
  }
  -- Initialise native WardRT (operand stack + fuel + max pages).
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                _w->stack = (int64_t*)calloc(WARD_STACK_SLOTS, sizeof(int64_t));
                _w->sp = 0;
                _w->memory = NULL; _w->memory_size = 0;
                _w->pages = 0; _w->max_pages = WARD_MAX_PAGES;
                _w->globals = NULL; _w->globals_count = 0;
                _w->table = NULL; _w->table_size = 0;
                _w->snapshot = NULL; _w->snapshot_size = 0;
                _w->fuel = (int64_t)lua_to_num(lua_table_get_raw(rt, lua_val_from_str("fuel"))); }) ]])
  rt
end

-- ═══════════════════════════════════════════════════════════════
-- Memory operations (public Lua-facing wrappers + raw-internal grow)
-- ═══════════════════════════════════════════════════════════════
fun mem_init(rt, initial_pages: i64)
  rt.pages = initial_pages
  -- Reserve the 8GiB guard region and commit only the initial pages. The
  -- base never moves for the life of the instance, so `rt.memory` and
  -- `_w->memory` stay in sync by construction (see ward_mem_reserve).
  rt.memory = @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                uint8_t* _base = ward_mem_init_region(_w, initial_pages);
                lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = (void*)_base; _v; }) ]])
end

fun mem_grow(rt, delta: i64): i64
  old_pages: i64 = rt.pages
  new_pages: i64 = old_pages + delta
  if new_pages > rt.max_pages return -1 end

  -- Commit more of the already-reserved guard region. The base pointer is
  -- unchanged, so there is no copy, no free, and nothing to re-sync into
  -- `rt.memory` — which is what makes the old realloc use-after-free
  -- impossible rather than merely fixed.
  ok: i64 = @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                int _r = ward_mem_commit(_w->memory,
                                         (size_t)(old_pages * WARD_PAGE_SIZE),
                                         (size_t)(new_pages * WARD_PAGE_SIZE));
                if (_r == 0) { _w->pages = new_pages;
                               _w->memory_size = new_pages * WARD_PAGE_SIZE; }
                (int64_t)_r; }) ]])
  if ok != 0 return -1 end
  rt.pages = new_pages
  old_pages
end

fun mem_load_i32(rt, addr: i64): i64
  return @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                       ward_mem_load_i32(_w, addr); }) ]])
end

fun mem_store_i32(rt, addr: i64, val: i64)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                ward_mem_store_i32(_w, addr, val); }) ]])
end

fun mem_load_i64(rt, addr: i64): i64
  return @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                       ward_mem_load_i64(_w, addr); }) ]])
end

fun mem_store_i64(rt, addr: i64, val: i64)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                ward_mem_store_i64(_w, addr, val); }) ]])
end

fun mem_load_f32(rt, addr: i64): float
  return @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                       ward_mem_load_f32(_w, addr); }) ]])
end

fun mem_store_f32(rt, addr: i64, val: float)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                ward_mem_store_f32(_w, addr, (double)val); }) ]])
end

fun mem_load_f64(rt, addr: i64): float
  return @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                       ward_mem_load_f64(_w, addr); }) ]])
end

fun mem_store_f64(rt, addr: i64, val: float)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                ward_mem_store_f64(_w, addr, (double)val); }) ]])
end

-- Byte-grained access (used by WASI fd_read/fd_write and random_get).
fun mem_read_byte(rt, addr: i64): i64
  return @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                       ward_mem_read_byte(_w, addr); }) ]])
end

fun mem_write_byte(rt, addr: i64, val: i64)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                ward_mem_write_byte(_w, addr, val); }) ]])
end

-- ═══════════════════════════════════════════════════════════════
-- Lua-facing stack wrappers (used by CLI/edge public API)
-- ═══════════════════════════════════════════════════════════════
fun push(rt, val)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                _w->stack[++_w->sp] = (int64_t)lua_to_num(val);
                lua_table_set_raw(rt, lua_val_from_str("sp"), lua_val_from_int(_w->sp)); }) ]])
end

fun pop(rt): any
  return @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                       int64_t _v = _w->stack[_w->sp--];
                       lua_table_set_raw(rt, lua_val_from_str("sp"), lua_val_from_int(_w->sp));
                       /* Box as an integer, not a double: a wasm i64 above 2^53
                        * loses precision through double and comes back as
                        * -9.2233720368547758e+18 instead of its exact value. */
                       lua_val_from_int(_v); }) ]])
end

fun peek(rt): any
  return @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                       int64_t _v = _w->stack[_w->sp];
                       lua_val_from_num((double)_v); }) ]])
end

-- Public sp/fuel accessors (edge runtime uses these to gate completion).
fun sp(rt): i64
  return @c.emit([[ (int64_t)((WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval)->sp ]])
end

fun get_fuel(rt): i64
  return @c.emit([[ (int64_t)((WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval)->fuel ]])
end

fun set_fuel(rt, fuel: i64)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                _w->fuel = fuel;
                lua_table_set_raw(rt, lua_val_from_str("fuel"), lua_val_from_int(_w->fuel)); }) ]])
end

fun set_table_entry(rt, idx: i64, func_idx: i64)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                WARD_DBG( "set_table_entry idx=%lld func_idx=%lld\n", (long long)idx, (long long)func_idx);
                if (_w->table && idx >= 0 && idx < _w->table_size) _w->table[idx] = func_idx; }) ]])
end

-- Tear down all heap-allocated state (memory, stack, globals, snapshot, WardRT itself).
fun destroy(rt)
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                if (_w->stack)     free(_w->stack);
                if (_w->globals)   free(_w->globals);
                if (_w->table)     free(_w->table);
                if (_w->snapshot)  free(_w->snapshot);
                if (_w->memory)    { lua_Value _mem = lua_table_get_raw(rt, lua_val_from_str("memory")); if (_mem.as.tval) free(_mem.as.tval); lua_val_nil(); }
                free(_w);
                lua_table_set_raw(rt, lua_val_from_str("memory"), lua_val_nil()); }) ]])
end

-- ═══════════════════════════════════════════════════════════════
-- Instantiation
-- ═══════════════════════════════════════════════════════════════
fun instantiate(rt, mod)
  @c.emit([[ WARD_DBG( "instantiate called\n"); ]])
  rt.mod = mod

  -- Init memory
  init_pages: i64 = mod.memory and mod.memory.initial or 0
  mem_init(rt, init_pages)
  rt.max_pages = mod.memory and mod.memory.maximum or 65536
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                _w->max_pages = (int64_t)lua_to_num(lua_table_get_raw(rt, lua_val_from_str("max_pages"))); }) ]])
  @c.emit([[ WARD_DBG( "after mem_init\n"); ]])

  -- Init globals — copy into raw int64_t array.
  n_globals: i64 = #mod.globals
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                _w->globals = (int64_t*)calloc((size_t)((n_globals == 0) ? 1 : n_globals), sizeof(int64_t));
                _w->globals_count = n_globals; }) ]])
  for i = 1, #mod.globals
    g = mod.globals[i]
    g_init: i64 = g.init
    @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                  int64_t _gi = g_init;
                  _w->globals[i - 1] = _gi; }) ]])
    -- Keep Lua rt.globals in sync for any off-hot-path readers.
    rt.globals[i] = g.init
  end
  @c.emit([[ WARD_DBG( "after globals\n"); ]])

  -- Load data segments
  for seg in mod.data
    if seg.flags == 0
      seg_data_len: i64 = #seg.data
      @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                    int64_t _offset = (int64_t)lua_to_num(lua_table_get_raw(seg, lua_val_from_str("offset")));
                    const char* _seg = lua_to_str(lua_table_get_raw(seg, lua_val_from_str("data")));
                    size_t _len = (size_t)seg_data_len;
                    if (_w->memory) memcpy(_w->memory + _offset, _seg, _len); }) ]])
    end
  end
  @c.emit([[ WARD_DBG( "after data\n"); ]])

  -- Init function table for call_indirect
  if #mod.tables > 0
    tbl = mod.tables[1]
    rt.table_size = tbl.initial
    -- Initialize function table for call_indirect
    @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                  _w->table_size = (int64_t)lua_to_num(lua_table_get_raw(rt, lua_val_from_str("table_size")));
                  _w->table = (int64_t*)calloc((size_t)_w->table_size, sizeof(int64_t));
                  WARD_DBG( "runtime C table_size=%lld table=%p\n", (long long)_w->table_size, (void*)_w->table); }) ]])
    for elem in mod.elements
      -- element entries
      for j = 1, #elem.entries
        @c.emit([[ WARD_DBG( "set table entry j=%lld\n", (long long)lua_to_num(lua_val_from_int(j))); ]])
        _ = set_table_entry(rt, elem.offset + j - 1, elem.entries[j])
      end
    end
  end
  @c.emit([[ WARD_DBG( "after table\n"); ]])

  @c.emit([[ WARD_DBG( "before export map\n"); ]])
  -- Build export map
  @c.emit([[ WARD_DBG( "exports count=%lld\n", (long long)lua_len_num(lua_table_get_raw(mod, lua_val_from_str("exports")))); ]])
  for exp in mod.exports
    @c.emit([[ ({ WARD_DBG( "export: %s kind=%lld idx=%lld\n", lua_to_str(lua_table_get_raw(exp, lua_val_from_str("name"))), (long long)lua_to_num(lua_table_get_raw(exp, lua_val_from_str("kind"))), (long long)lua_to_num(lua_table_get_raw(exp, lua_val_from_str("index")))); }) ]])
    rt.exports_map[exp.name] = exp
  end

  -- Register WASI imports
  wasi.register(rt, M)

  -- Take memory snapshot (for reset/re-execution)
  rt.snapshot = mem_mod.dup(rt.memory, rt.pages * WASM_PAGE_SIZE)
  -- Mirror snapshot raw pointer into WardRT.
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                _w->snapshot = (uint8_t*)lua_table_get_raw(rt, lua_val_from_str("snapshot")).as.tval;
                _w->snapshot_size = (int64_t)lua_to_num(lua_table_get_raw(rt, lua_val_from_str("pages"))) * WARD_PAGE_SIZE; }) ]])
  @c.emit([[ WARD_DBG( "instantiate done\n"); ]])
end

-- ═══════════════════════════════════════════════════════════════
-- Execution engine
-- Two entry points:
--   execute(rt, func_idx, args)        — public Lua API (args is a Lua table)
--   execute_raw(rt, func_idx, args_buf:i64, args_len:i64) — internal, raw int64_t* args
-- ═══════════════════════════════════════════════════════════════
@c.emit([[
/* ── Fast C interpreter: switch-based dispatch, no Lua table allocs ── */
/* Forward decl for recursive call */
static lua_Value src_wasm_runtime__execute_raw(lua_Value rt, int64_t func_idx, lua_Value args_buf, int64_t args_len);

/* Returns next PC. Falls back to Duo dispatch per-opcode for complex ops. */
/* ── Branch-target memo ──────────────────────────────────────────────────
 * end_pc/else_pc for a block/loop/if are a static property of the immutable
 * function body, but ward_find_end_pc rescans the remainder of the body on
 * every execution. That makes any loop containing a block O(body x iters)
 * instead of O(iters) -- it was 83% of runtime on a switch-in-a-loop workload.
 * Memoize on (body pointer, pc). Direct-mapped; a collision just recomputes,
 * so this is always correct, only ever a speed win. */
#define WARD_BT_BITS 16
#define WARD_BT_SIZE (1 << WARD_BT_BITS)
#define WARD_BT_MASK (WARD_BT_SIZE - 1)
#define WARD_BT_NO_ELSE INT64_MIN

typedef struct {
    const uint8_t* body;
    int64_t pc;
    int64_t end_pc;
    int64_t else_pc;   /* WARD_BT_NO_ELSE until resolved */
} WardBT;

static WardBT ward_bt_cache[WARD_BT_SIZE];

static inline size_t ward_bt_slot(const uint8_t* body, int64_t pc) {
    uint64_t h = (uint64_t)(uintptr_t)body ^ ((uint64_t)pc * 0x9E3779B97F4A7C15ull);
    h ^= h >> 32; h *= 0xC2B2AE3D27D4EB4Full; h ^= h >> 29;
    return (size_t)(h & WARD_BT_MASK);
}

static inline int64_t ward_cached_end_pc(const uint8_t* p, int64_t pc, int64_t body_len) {
    WardBT* e = &ward_bt_cache[ward_bt_slot(p, pc)];
    if (e->body == p && e->pc == pc) return e->end_pc;
    int64_t end_pc = ward_find_end_pc(p, pc, body_len);
    e->body = p; e->pc = pc; e->end_pc = end_pc; e->else_pc = WARD_BT_NO_ELSE;
    return end_pc;
}

/* Call after ward_cached_end_pc for the same pc so the entry is already live. */
static inline int64_t ward_cached_else_pc(const uint8_t* p, int64_t pc, int64_t body_len) {
    WardBT* e = &ward_bt_cache[ward_bt_slot(p, pc)];
    if (e->body == p && e->pc == pc && e->else_pc != WARD_BT_NO_ELSE) return e->else_pc;
    int64_t else_pc = ward_find_else_pc(p, pc, body_len);
    if (e->body != p || e->pc != pc) {
        e->body = p; e->pc = pc; e->end_pc = ward_find_end_pc(p, pc, body_len);
    }
    e->else_pc = else_pc;
    return else_pc;
}

/* ── Call-frame pool ─────────────────────────────────────────────────────
 * WardFrame embeds WardLabel labels[64] (~2KB), and every wasm call was doing
 * calloc(frame) + calloc(locals) + two frees. Bump-allocate both from a
 * contiguous pool instead: only the locals actually declared get zeroed
 * (wasm requires zero-init locals), and the 2KB label array is never touched
 * because labels_len is reset to 0. Falls back to malloc past the pool so
 * deep recursion still works. */
#define WARD_FRAME_POOL_DEPTH 4096
#define WARD_LOCALS_POOL_SLOTS (1 << 20)

static WardFrame ward_frame_pool[WARD_FRAME_POOL_DEPTH];
static int64_t   ward_locals_pool[WARD_LOCALS_POOL_SLOTS];
static int64_t   ward_frame_depth = 0;
static int64_t   ward_locals_top = 0;

static WardFrame* ward_frame_push(int64_t local_count) {
    WardFrame* f;
    if (ward_frame_depth < WARD_FRAME_POOL_DEPTH &&
        ward_locals_top + local_count <= WARD_LOCALS_POOL_SLOTS) {
        f = &ward_frame_pool[ward_frame_depth++];
        f->locals = local_count ? &ward_locals_pool[ward_locals_top] : NULL;
        ward_locals_top += local_count;
        f->locals_count = -local_count - 1;   /* negative => pooled */
    } else {
        f = (WardFrame*)malloc(sizeof(WardFrame));
        if (!f) return NULL;
        f->locals = local_count ? (int64_t*)malloc((size_t)local_count * sizeof(int64_t)) : NULL;
        f->locals_count = local_count;        /* non-negative => heap */
    }
    if (f->locals) memset(f->locals, 0, (size_t)local_count * sizeof(int64_t));
    f->labels_len = 0;
    return f;
}

static inline int64_t ward_frame_locals_count(const WardFrame* f) {
    return f->locals_count < 0 ? (-f->locals_count - 1) : f->locals_count;
}

static void ward_frame_pop(WardFrame* f) {
    if (f->locals_count < 0) {
        ward_locals_top -= (-f->locals_count - 1);
        ward_frame_depth--;
    } else {
        if (f->locals) free(f->locals);
        free(f);
    }
}

static int64_t ward_fast_run(lua_Value rt, WardRT* w, WardFrame* frame, const uint8_t* body, int64_t body_len, int64_t pc, int64_t* fuel_out) {
    int64_t sp = w->sp;
    int64_t* stack = w->stack;
    int64_t* locals = frame->locals;
    for (;;) {
        if (pc > body_len) { w->sp = sp; *fuel_out = -1; return pc; }
        uint8_t op = body[pc - 1];
#ifdef WARD_DEBUG
        dbg_ring_pc[dbg_ring_i] = pc; dbg_ring_op[dbg_ring_i] = op; dbg_ring_sp[dbg_ring_i] = sp;
        dbg_ring_i = (dbg_ring_i + 1) & 31;
#endif
        pc++;
        switch (op) {
        /* ── Control flow ── */
        case 0x01: break; /* nop */
        case 0x00: w->sp = sp; *fuel_out = -2; return pc; /* unreachable - caller handles error */
        case 0x02: { /* block */
            ward_leb_blocktype(body, &pc);
            int64_t end_pc = ward_cached_end_pc(body, pc, body_len);
            ward_label_push(frame, pc, end_pc, end_pc, 0);
            break;
        }
        case 0x03: { /* loop */
            ward_leb_blocktype(body, &pc);
            int64_t end_pc = ward_cached_end_pc(body, pc, body_len);
            ward_label_push(frame, pc, end_pc, end_pc, 1);
            break;
        }
        case 0x04: { /* if */
            ward_leb_blocktype(body, &pc);
            int64_t end_pc = ward_cached_end_pc(body, pc, body_len);
            int64_t else_pc = ward_cached_else_pc(body, pc, body_len);
            if (else_pc == 0) else_pc = end_pc;
            ward_label_push(frame, pc, end_pc, else_pc, 0);
            int64_t cond = stack[sp--];
            if (cond == 0) pc = else_pc;
            break;
        }
        case 0x05: { /* else */
            int64_t end_pc = frame->labels[frame->labels_len - 1].end_pc;
            frame->labels_len--;
            pc = end_pc;
            break;
        }
        case 0x0B: { /* end */
            if (frame->labels_len > 0) { frame->labels_len--; break; }
            w->sp = sp; *fuel_out = -1; return body_len + 1;
        }
        case 0x0C: { /* br */
            int64_t depth = ward_leb_u32(body, &pc);
            int64_t idx = frame->labels_len - 1 - depth;
            if (frame->labels[idx].is_loop) {
                pc = frame->labels[idx].pc;
                frame->labels_len -= depth;
            } else {
                pc = frame->labels[idx].end_pc;
                frame->labels_len -= (depth + 1);
            }
            break;
        }
        case 0x0D: { /* br_if */
            int64_t depth = ward_leb_u32(body, &pc);
            int64_t cond = stack[sp--];
            if (cond != 0) {
                int64_t idx = frame->labels_len - 1 - depth;
                if (frame->labels[idx].is_loop) {
                    pc = frame->labels[idx].pc;
                    frame->labels_len -= depth;
                } else {
                    pc = frame->labels[idx].end_pc;
                    frame->labels_len -= (depth + 1);
                }
            }
            break;
        }
        case 0x0F: { /* return */
            w->sp = sp; *fuel_out = -1; return body_len + 1;
        }
        case 0x0E: { /* br_table: vec(labelidx) + default labelidx */
            int64_t n = ward_leb_u32(body, &pc);
            int64_t sw = stack[sp--];
            int64_t target_depth = -1;
            if (sw >= 0 && sw < n) {
                for (int64_t i = 0; i < n; i++) {
                    int64_t d = ward_leb_u32(body, &pc);
                    if (i == sw) target_depth = d;
                }
            } else {
                for (int64_t i = 0; i < n; i++) ward_leb_u32(body, &pc);
            }
            int64_t default_depth = ward_leb_u32(body, &pc);
            if (target_depth < 0) target_depth = default_depth;
            int64_t idx = frame->labels_len - 1 - target_depth;
            if (frame->labels[idx].is_loop) {
                pc = frame->labels[idx].pc;
                frame->labels_len -= target_depth;
            } else {
                pc = frame->labels[idx].end_pc;
                frame->labels_len -= (target_depth + 1);
            }
            break;
        }
        /* ─── drop/select ─── */
        case 0x1A: sp--; break;
        /* select: stack is [val1, val2, c]; result is val1 when c != 0.
           val2 pops first because it is nearer the top -- do not swap these. */
        case 0x1B: { int64_t c = stack[sp--]; int64_t val2 = stack[sp--]; int64_t val1 = stack[sp--]; stack[++sp] = (c != 0) ? val1 : val2; break; }
        /* ─── Locals/globals ─── */
        case 0x20: { int64_t idx = ward_leb_u32(body, &pc); stack[++sp] = locals[idx]; break; }
        case 0x21: { int64_t idx = ward_leb_u32(body, &pc); locals[idx] = stack[sp--]; break; }
        case 0x22: { int64_t idx = ward_leb_u32(body, &pc); locals[idx] = stack[sp]; break; }
        case 0x23: { int64_t idx = ward_leb_u32(body, &pc); stack[++sp] = w->globals[idx]; break; }
        case 0x24: { int64_t idx = ward_leb_u32(body, &pc); w->globals[idx] = stack[sp--]; break; }
        /* ─── Constants ─── */
        case 0x41: { int64_t v = ward_leb_i32(body, &pc); stack[++sp] = v; break; }
        case 0x42: { int64_t v = ward_leb_i64(body, &pc); stack[++sp] = v; break; }
        case 0x43: { int32_t v; memcpy(&v, body + pc - 1, 4); pc += 4; stack[++sp] = (int64_t)(uint32_t)v; break; }
        case 0x44: { int64_t v; memcpy(&v, body + pc - 1, 8); pc += 8; stack[++sp] = v; break; }
        /* ─── i32 Comparison ─── */
        case 0x45: { int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a == 0) ? 1 : 0; break; }
        case 0x46: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a == (int32_t)b) ? 1 : 0; break; }
        case 0x47: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a != (int32_t)b) ? 1 : 0; break; }
        case 0x48: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a < (int32_t)b) ? 1 : 0; break; }
        case 0x49: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint32_t)a < (uint32_t)b) ? 1 : 0; break; }
        case 0x4A: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a > (int32_t)b) ? 1 : 0; break; }
        case 0x4B: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint32_t)a > (uint32_t)b) ? 1 : 0; break; }
        case 0x4C: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a <= (int32_t)b) ? 1 : 0; break; }
        case 0x4D: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint32_t)a <= (uint32_t)b) ? 1 : 0; break; }
        case 0x4E: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a >= (int32_t)b) ? 1 : 0; break; }
        case 0x4F: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint32_t)a >= (uint32_t)b) ? 1 : 0; break; }
        /* ─── i32 Arithmetic ─── */
        case 0x6A: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)(a + b); break; }
        case 0x6B: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)(a - b); break; }
        case 0x6C: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)(a * b); break; }
        case 0x6D: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if ((int32_t)b == 0) { w->sp = sp; *fuel_out = -4; return pc; } if ((int32_t)a == INT32_MIN && (int32_t)b == -1) { w->sp = sp; *fuel_out = -5; return pc; } stack[++sp] = (int64_t)(int32_t)((int32_t)a / (int32_t)b); break; }
        case 0x6E: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if ((uint32_t)b == 0) { w->sp = sp; *fuel_out = -4; return pc; } stack[++sp] = (int64_t)(int32_t)((uint32_t)a / (uint32_t)b); break; }
        case 0x6F: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if ((int32_t)b == 0) { w->sp = sp; *fuel_out = -4; return pc; } if ((int32_t)a == INT32_MIN && (int32_t)b == -1) { stack[++sp] = 0; break; } stack[++sp] = (int64_t)(int32_t)((int32_t)a % (int32_t)b); break; }
        case 0x70: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if ((uint32_t)b == 0) { w->sp = sp; *fuel_out = -4; return pc; } stack[++sp] = (int64_t)(int32_t)((uint32_t)a % (uint32_t)b); break; }
        case 0x71: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)(a & b); break; }
        case 0x72: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)(a | b); break; }
        case 0x73: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)(a ^ b); break; }
        case 0x74: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)(a << (b & 31)); break; }
        case 0x75: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)((int32_t)a >> (b & 31)); break; }
        case 0x76: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)((uint32_t)a >> (b & 31)); break; }
        case 0x77: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)__builtin_rotateleft32((int32_t)a, (b & 31)); break; }
        case 0x78: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)__builtin_rotateright32((int32_t)a, (b & 31)); break; }
        case 0x67: { int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a == 0) ? 32 : __builtin_clz((uint32_t)(int32_t)a); break; }
        case 0x68: { int64_t a = stack[sp--]; stack[++sp] = ((int32_t)a == 0) ? 32 : __builtin_ctz((uint32_t)(int32_t)a); break; }
        case 0x69: { int64_t a = stack[sp--]; stack[++sp] = __builtin_popcount((uint32_t)(int32_t)a); break; }
        /* ─── i64 Arithmetic ─── */
        case 0x7C: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a + b; break; }
        case 0x7D: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a - b; break; }
        case 0x7E: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a * b; break; }
        case 0x7F: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if (b == 0) { w->sp = sp; *fuel_out = -4; return pc; } if (a == INT64_MIN && b == -1) { w->sp = sp; *fuel_out = -5; return pc; } stack[++sp] = a / b; break; }
        case 0x80: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if ((uint64_t)b == 0) { w->sp = sp; *fuel_out = -4; return pc; } stack[++sp] = (int64_t)((uint64_t)a / (uint64_t)b); break; }
        case 0x81: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if (b == 0) { w->sp = sp; *fuel_out = -4; return pc; } if (a == INT64_MIN && b == -1) { stack[++sp] = 0; break; } stack[++sp] = a % b; break; }
        case 0x82: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; if ((uint64_t)b == 0) { w->sp = sp; *fuel_out = -4; return pc; } stack[++sp] = (int64_t)((uint64_t)a % (uint64_t)b); break; }
        case 0x83: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a & b; break; }
        case 0x84: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a | b; break; }
        case 0x85: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a ^ b; break; }
        case 0x86: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a << (b & 63); break; }
        case 0x87: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = a >> (b & 63); break; }
        case 0x88: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (int64_t)((uint64_t)a >> (b & 63)); break; }
        case 0x89: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = __builtin_rotateleft64(a, (b & 63)); break; }
        case 0x8A: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = __builtin_rotateright64(a, (b & 63)); break; }
        case 0x79: { int64_t a = stack[sp--]; stack[++sp] = (a == 0) ? 64 : __builtin_clzll((uint64_t)a); break; }
        case 0x7A: { int64_t a = stack[sp--]; stack[++sp] = (a == 0) ? 64 : __builtin_ctzll((uint64_t)a); break; }
        case 0x7B: { int64_t a = stack[sp--]; stack[++sp] = __builtin_popcountll((uint64_t)a); break; }
        /* ─── i64 Comparison ─── */
        case 0x50: { int64_t a = stack[sp--]; stack[++sp] = (a == 0) ? 1 : 0; break; }
        case 0x51: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (a == b) ? 1 : 0; break; }
        case 0x52: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (a != b) ? 1 : 0; break; }
        case 0x53: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (a < b) ? 1 : 0; break; }
        case 0x54: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint64_t)a < (uint64_t)b) ? 1 : 0; break; }
        case 0x55: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (a > b) ? 1 : 0; break; }
        case 0x56: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint64_t)a > (uint64_t)b) ? 1 : 0; break; }
        case 0x57: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (a <= b) ? 1 : 0; break; }
        case 0x58: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint64_t)a <= (uint64_t)b) ? 1 : 0; break; }
        case 0x59: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = (a >= b) ? 1 : 0; break; }
        case 0x5A: { int64_t b = stack[sp--]; int64_t a = stack[sp--]; stack[++sp] = ((uint64_t)a >= (uint64_t)b) ? 1 : 0; break; }
        /* ─── Conversions ─── */
        case 0xA7: { int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)a; break; } /* i32.wrap_i64 */
        case 0xAC: { int64_t a = stack[sp--]; stack[++sp] = (int64_t)(int32_t)a; break; } /* i64.extend_i32_s */
        case 0xAD: { int64_t a = stack[sp--]; stack[++sp] = (int64_t)(uint32_t)a; break; } /* i64.extend_i32_u */
        case 0xC0: { int64_t a = stack[sp--]; stack[++sp] = (int32_t)((int8_t)a); break; }
        case 0xC1: { int64_t a = stack[sp--]; stack[++sp] = (int32_t)((int16_t)a); break; }
        case 0xC2: { int64_t a = stack[sp--]; stack[++sp] = (int64_t)((int8_t)a); break; }
        case 0xC3: { int64_t a = stack[sp--]; stack[++sp] = (int64_t)((int16_t)a); break; }
        case 0xC4: { int64_t a = stack[sp--]; stack[++sp] = (int64_t)((int32_t)a); break; }
        /* ─── Memory loads/stores (common: align + offset LEB) ─── */
        case 0x28: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int64_t addr = stack[sp--] + off; int32_t v; memcpy(&v, w->memory + (uint32_t)addr, 4); stack[++sp] = (int64_t)v; break; }
        case 0x29: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int64_t addr = stack[sp--] + off; int64_t v; memcpy(&v, w->memory + (uint32_t)addr, 8); stack[++sp] = v; break; }
        case 0x2D: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int64_t addr = stack[sp--] + off; uint8_t v = w->memory[(uint32_t)addr]; stack[++sp] = (int64_t)v; break; }
        case 0x2C: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int64_t addr = stack[sp--] + off; int8_t v; memcpy(&v, w->memory + (uint32_t)addr, 1); stack[++sp] = (int64_t)v; break; }
        case 0x2E: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int64_t addr = stack[sp--] + off; int16_t v; memcpy(&v, w->memory + (uint32_t)addr, 2); stack[++sp] = (int64_t)v; break; }
        case 0x2F: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int64_t addr = stack[sp--] + off; uint16_t v; memcpy(&v, w->memory + (uint32_t)addr, 2); stack[++sp] = (int64_t)v; break; }
        case 0x36: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int32_t v = (int32_t)stack[sp--]; int64_t addr = stack[sp--] + off; memcpy(w->memory + (uint32_t)addr, &v, 4); break; }
        case 0x37: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int64_t v = stack[sp--]; int64_t addr = stack[sp--] + off; memcpy(w->memory + (uint32_t)addr, &v, 8); break; }
        case 0x3A: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); uint8_t v = (uint8_t)stack[sp--]; int64_t addr = stack[sp--] + off; w->memory[(uint32_t)addr] = v; break; }
        case 0x3B: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); int16_t v = (int16_t)stack[sp--]; int64_t addr = stack[sp--] + off; memcpy(w->memory + (uint32_t)addr, &v, 2); break; }
        case 0x3C: { ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc); uint16_t v = (uint16_t)stack[sp--]; int64_t addr = stack[sp--] + off; memcpy(w->memory + (uint32_t)addr, &v, 2); break; }
        case 0x3F: { pc++; /* memidx */ stack[++sp] = (int64_t)w->memory_size; break; }
        case 0x40: { pc++; int64_t delta = stack[sp--]; int64_t old = w->memory_size; int64_t new_sz = old + delta * WARD_PAGE_SIZE;
            /* mprotect within the reserved guard region: base never moves. */
            if (delta >= 0 && (w->max_pages <= 0 || w->pages + delta <= w->max_pages)
                && ward_mem_commit(w->memory, (size_t)old, (size_t)new_sz) == 0) {
                w->memory_size = new_sz; w->pages += delta; stack[++sp] = old / WARD_PAGE_SIZE;
            } else { stack[++sp] = -1; } break; }
        /* ─── Float ops (store as bit-cast in int64 stack) ─── */
        case 0x92: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); float r = a + b; int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0x93: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); float r = a - b; int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0x94: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); float r = a * b; int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0x95: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); float r = a / b; int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0xA0: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); double r = a + b; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xA1: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); double r = a - b; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xA2: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); double r = a * b; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xA3: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); double r = a / b; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0x9F: { int64_t ai = stack[sp--]; double a; memcpy(&a, &ai, 8); double r = sqrt(a); int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0x91: { int64_t ai = stack[sp--]; float a; memcpy(&a, &ai, 4); float r = sqrtf(a); int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0x99: { int64_t ai = stack[sp--]; double a; memcpy(&a, &ai, 8); double r = (a < 0.0) ? -a : a; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0x9A: { int64_t ai = stack[sp--]; double a; memcpy(&a, &ai, 8); double r = -a; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xB7: { int64_t a = stack[sp--]; double r = (double)(int32_t)a; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xB8: { int64_t a = stack[sp--]; double r = (double)(uint32_t)a; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xB9: { int64_t a = stack[sp--]; double r = (double)a; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xBA: { int64_t a = stack[sp--]; double r = (double)(uint64_t)a; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xA8: { int64_t ai = stack[sp--]; float a; memcpy(&a, &ai, 4); stack[++sp] = (int64_t)(int32_t)a; break; }
        case 0xB0: { int64_t ai = stack[sp--]; double a; memcpy(&a, &ai, 8); stack[++sp] = (int64_t)a; break; }
        case 0xB2: { int64_t a = stack[sp--]; float r = (float)(int32_t)a; int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0xB6: { int64_t ai = stack[sp--]; double a; memcpy(&a, &ai, 8); float r = (float)a; int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0xBB: { int64_t ai = stack[sp--]; float a; memcpy(&a, &ai, 4); double r = (double)a; int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        case 0xBC: { int64_t ai = stack[sp--]; float a; memcpy(&a, &ai, 4); int32_t ri; memcpy(&ri, &a, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0xBD: { int64_t ai = stack[sp--]; double a; memcpy(&a, &ai, 8); int64_t ri; memcpy(&ri, &a, 8); stack[++sp] = ri; break; }
        case 0xBE: { int64_t a = stack[sp--]; int32_t ai = (int32_t)a; float r; memcpy(&r, &ai, 4); int32_t ri; memcpy(&ri, &r, 4); stack[++sp] = (int64_t)(uint32_t)ri; break; }
        case 0xBF: { int64_t a = stack[sp--]; int64_t ai = a; double r; memcpy(&r, &ai, 8); int64_t ri; memcpy(&ri, &r, 8); stack[++sp] = ri; break; }
        /* f32 comparisons */
        case 0x5B: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); stack[++sp] = (a == b) ? 1 : 0; break; }
        case 0x5C: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); stack[++sp] = (a != b) ? 1 : 0; break; }
        case 0x5D: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); stack[++sp] = (a < b) ? 1 : 0; break; }
        case 0x5E: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); stack[++sp] = (a > b) ? 1 : 0; break; }
        case 0x5F: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); stack[++sp] = (a <= b) ? 1 : 0; break; }
        case 0x60: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; float a, b; memcpy(&a, &ai, 4); memcpy(&b, &bi, 4); stack[++sp] = (a >= b) ? 1 : 0; break; }
        case 0x61: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); stack[++sp] = (a == b) ? 1 : 0; break; }
        case 0x62: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); stack[++sp] = (a != b) ? 1 : 0; break; }
        case 0x63: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); stack[++sp] = (a < b) ? 1 : 0; break; }
        case 0x64: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); stack[++sp] = (a > b) ? 1 : 0; break; }
        case 0x65: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); stack[++sp] = (a <= b) ? 1 : 0; break; }
        case 0x66: { int64_t bi = stack[sp--]; int64_t ai = stack[sp--]; double a, b; memcpy(&a, &ai, 8); memcpy(&b, &bi, 8); stack[++sp] = (a >= b) ? 1 : 0; break; }
        /* ─── Call (0x10) — handled inline to avoid fallback ─── */
        case 0x10: {
            int64_t call_idx = ward_leb_u32(body, &pc);
            /* Resolve function signature to get param count */
            lua_Value mod = lua_table_get_str_lit(rt, "mod", 3751703171u, 3);
            int64_t n_imports = (int64_t)lua_len_num(lua_table_get_str_lit(mod, "imports", 2902570725u, 7));
            lua_Value sig_params;
            int64_t np;
            if (call_idx < n_imports) {
                lua_Value imp = lua_table_get(lua_table_get_str_lit(mod, "imports", 2902570725u, 7), lua_val_from_int(call_idx + 1));
                lua_Value type_idx = lua_table_get_str_lit(imp, "type_idx", 1889348969u, 8);
                lua_Value sig = lua_table_get(lua_table_get_str_lit(mod, "types", 4292920474u, 5), lua_add(type_idx, lua_val_from_int(1)));
                sig_params = lua_table_get_str_lit(sig, "params", 559900755u, 6);
            } else {
                lua_Value func_types = lua_table_get_str_lit(mod, "functions", 1162494286u, 9);
                lua_Value type_idx = lua_table_get(func_types, lua_val_from_int(call_idx - n_imports + 1));
                lua_Value sig = lua_table_get(lua_table_get_str_lit(mod, "types", 4292920474u, 5), lua_add(type_idx, lua_val_from_int(1)));
                sig_params = lua_table_get_str_lit(sig, "params", 559900755u, 6);
            }
            np = (int64_t)lua_len_num(sig_params);
            /* Pop args in reverse, build raw int64_t* buffer */
            int64_t* ab = (int64_t*)malloc(sizeof(int64_t) * (np > 0 ? np : 1));
            for (int64_t i = np - 1; i >= 0; i--) ab[i] = stack[sp--];
            /* Build VAL_BUFFER handle for execute_raw */
            lua_Value args_handle;
            args_handle.type = VAL_BUFFER;
            args_handle.as.tval = (void*)ab;
            /* Publish the local sp before recursing: execute_raw pushes the
               callee frame starting at w->sp, so a stale w->sp makes the callee
               overwrite operands this frame still has pending underneath the
               args (e.g. `i32.const 100; call $f; i32.add`). */
            w->sp = sp;
            /* Recursively call execute_raw */
            src_wasm_runtime__execute_raw(rt, call_idx, args_handle, np);
            free(ab);
            /* execute_raw pushed result onto stack if function returns a value.
               Read back sp from w since execute_raw may have modified it. */
            sp = w->sp;
            break;
        }
        /* ─── 0xFC prefix: saturating truncation + bulk memory ───
         * Handled here rather than falling back to the Duo dispatch: the
         * fallback only implemented memory.copy/fill, so trunc_sat (emitted
         * by clang for every float->int cast) was unreachable. */
        case 0xFC: {
            uint32_t sub = (uint32_t)ward_leb_u32(body, &pc);
            switch (sub) {
                case 0x00: case 0x01: case 0x02: case 0x03: {
                    double d;
                    if (sub <= 0x01) { int32_t bi = (int32_t)stack[sp--]; float f; memcpy(&f, &bi, 4); d = (double)f; }
                    else            { int64_t bb = stack[sp--]; memcpy(&d, &bb, 8); }
                    stack[++sp] = (sub == 0x00 || sub == 0x02)
                        ? (int64_t)ward_trunc_sat_i32_s(d)
                        : (int64_t)(int32_t)ward_trunc_sat_i32_u(d);
                    break;
                }
                case 0x04: case 0x05: case 0x06: case 0x07: {
                    double d;
                    if (sub <= 0x05) { int32_t bi = (int32_t)stack[sp--]; float f; memcpy(&f, &bi, 4); d = (double)f; }
                    else            { int64_t bb = stack[sp--]; memcpy(&d, &bb, 8); }
                    stack[++sp] = (sub == 0x04 || sub == 0x06)
                        ? ward_trunc_sat_i64_s(d)
                        : (int64_t)ward_trunc_sat_i64_u(d);
                    break;
                }
                case 0x0A: { /* memory.copy */
                    ward_leb_u32(body, &pc); ward_leb_u32(body, &pc);
                    int64_t n = stack[sp--]; int64_t src = stack[sp--]; int64_t dst = stack[sp--];
                    ward_do_memory_copy(w, dst, src, n); break;
                }
                case 0x0B: { /* memory.fill */
                    ward_leb_u32(body, &pc);
                    int64_t n = stack[sp--]; int64_t val = stack[sp--]; int64_t dst = stack[sp--];
                    ward_do_memory_fill(w, dst, val, n); break;
                }
                default:
                    w->sp = sp; *fuel_out = -3; return -(pc - 1);
            }
            break;
        }
        /* ─── 0xFD prefix: SIMD (v128) ───
         * A v128 occupies two operand-stack slots: lo pushed first, hi on top.
         * Every lane op is generated from the WV_* macros below, so ~100
         * opcodes cost a line each rather than a block each. */
        case 0xFD: {
            uint32_t sub = (uint32_t)ward_leb_u32(body, &pc);
            switch (sub) {
                case 0:   { /* v128.load */
                    ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc);
                    int64_t ea = stack[sp--] + off; WardV128 v_;
                    if (!ward_mem_ok(w, ea, 16)) { w->sp = sp; *fuel_out = -6; return pc; }
                    memcpy(v_.u8, w->memory + ea, 16); WV_PUSH(v_); break; }
                case 11:  { /* v128.store */
                    ward_leb_u32(body, &pc); int64_t off = ward_leb_u32(body, &pc);
                    WardV128 v_; WV_POP(v_); int64_t ea = stack[sp--] + off;
                    if (!ward_mem_ok(w, ea, 16)) { w->sp = sp; *fuel_out = -6; return pc; }
                    memcpy(w->memory + ea, v_.u8, 16); break; }
                case 12:  { /* v128.const */
                    WardV128 v_; memcpy(v_.u8, body + pc - 1, 16); pc += 16;
                    WV_PUSH(v_); break; }

                /* splat */
                case 15: WV_SPLAT(i8,  16, (int8_t)stack[sp--])
                case 16: WV_SPLAT(i16,  8, (int16_t)stack[sp--])
                case 17: WV_SPLAT(i32,  4, (int32_t)stack[sp--])
                case 18: WV_SPLAT(i64,  2, stack[sp--])
                case 19: { WardV128 r_; int32_t b_=(int32_t)stack[sp--]; float f_;
                           memcpy(&f_,&b_,4); for(int L=0;L<4;L++) r_.f32[L]=f_;
                           WV_PUSH(r_); break; }
                case 20: { WardV128 r_; int64_t b_=stack[sp--]; double d_;
                           memcpy(&d_,&b_,8); for(int L=0;L<2;L++) r_.f64[L]=d_;
                           WV_PUSH(r_); break; }

                /* extract_lane / replace_lane */
                case 21: WV_EXTRACT(i8,  (int64_t))
                case 22: WV_EXTRACT(u8,  (int64_t))
                case 23: WV_REPLACE(i8,  int8_t)
                case 24: WV_EXTRACT(i16, (int64_t))
                case 25: WV_EXTRACT(u16, (int64_t))
                case 26: WV_REPLACE(i16, int16_t)
                case 27: WV_EXTRACT(i32, (int64_t))
                case 28: WV_REPLACE(i32, int32_t)
                case 29: WV_EXTRACT(i64, (int64_t))
                case 30: WV_REPLACE(i64, int64_t)
                case 31: { uint32_t l_=(uint32_t)ward_leb_u32(body,&pc); WardV128 a_; WV_POP(a_);
                           int32_t bi_; memcpy(&bi_,&a_.f32[l_],4);
                           stack[++sp]=(int64_t)(uint32_t)bi_; break; }
                case 32: { uint32_t l_=(uint32_t)ward_leb_u32(body,&pc); int32_t b_=(int32_t)stack[sp--];
                           WardV128 a_; WV_POP(a_); memcpy(&a_.f32[l_],&b_,4); WV_PUSH(a_); break; }
                case 33: { uint32_t l_=(uint32_t)ward_leb_u32(body,&pc); WardV128 a_; WV_POP(a_);
                           int64_t bb_; memcpy(&bb_,&a_.f64[l_],8); stack[++sp]=bb_; break; }
                case 34: { uint32_t l_=(uint32_t)ward_leb_u32(body,&pc); int64_t b_=stack[sp--];
                           WardV128 a_; WV_POP(a_); memcpy(&a_.f64[l_],&b_,8); WV_PUSH(a_); break; }

                /* integer compares -> all-ones / all-zero lanes */
                case 35: WV_CMP(i8, u8, 16, ==) case 36: WV_CMP(i8, u8, 16, !=)
                case 37: WV_CMP(i8, u8, 16, <)  case 38: WV_CMPU(u8, u8, 16, <)
                case 39: WV_CMP(i8, u8, 16, >)  case 40: WV_CMPU(u8, u8, 16, >)
                case 41: WV_CMP(i8, u8, 16, <=) case 42: WV_CMPU(u8, u8, 16, <=)
                case 43: WV_CMP(i8, u8, 16, >=) case 44: WV_CMPU(u8, u8, 16, >=)
                case 45: WV_CMP(i16, u16, 8, ==) case 46: WV_CMP(i16, u16, 8, !=)
                case 47: WV_CMP(i16, u16, 8, <)  case 48: WV_CMPU(u16, u16, 8, <)
                case 49: WV_CMP(i16, u16, 8, >)  case 50: WV_CMPU(u16, u16, 8, >)
                case 51: WV_CMP(i16, u16, 8, <=) case 52: WV_CMPU(u16, u16, 8, <=)
                case 53: WV_CMP(i16, u16, 8, >=) case 54: WV_CMPU(u16, u16, 8, >=)
                case 55: WV_CMP(i32, u32, 4, ==) case 56: WV_CMP(i32, u32, 4, !=)
                case 57: WV_CMP(i32, u32, 4, <)  case 58: WV_CMPU(u32, u32, 4, <)
                case 59: WV_CMP(i32, u32, 4, >)  case 60: WV_CMPU(u32, u32, 4, >)
                case 61: WV_CMP(i32, u32, 4, <=) case 62: WV_CMPU(u32, u32, 4, <=)
                case 63: WV_CMP(i32, u32, 4, >=) case 64: WV_CMPU(u32, u32, 4, >=)

                /* float compares */
                case 65: WV_CMP(f32, u32, 4, ==) case 66: WV_FNE(f32, u32, 4)
                case 67: WV_CMP(f32, u32, 4, <)  case 68: WV_CMP(f32, u32, 4, >)
                case 69: WV_CMP(f32, u32, 4, <=) case 70: WV_CMP(f32, u32, 4, >=)
                case 71: WV_CMP(f64, u64, 2, ==) case 72: WV_FNE(f64, u64, 2)
                case 73: WV_CMP(f64, u64, 2, <)  case 74: WV_CMP(f64, u64, 2, >)
                case 75: WV_CMP(f64, u64, 2, <=) case 76: WV_CMP(f64, u64, 2, >=)

                /* bitwise */
                case 77: { WardV128 a_,r_; WV_POP(a_); r_.u64[0]=~a_.u64[0]; r_.u64[1]=~a_.u64[1];
                           WV_PUSH(r_); break; }
                case 78: WV_BIT(&)  case 80: WV_BIT(|)  case 81: WV_BIT(^)
                case 79: { WardV128 b_,a_,r_; WV_POP(b_); WV_POP(a_);
                           r_.u64[0]=a_.u64[0]&~b_.u64[0]; r_.u64[1]=a_.u64[1]&~b_.u64[1];
                           WV_PUSH(r_); break; }
                case 82: { WardV128 m_,b_,a_,r_; WV_POP(m_); WV_POP(b_); WV_POP(a_);
                           r_.u64[0]=(a_.u64[0]&m_.u64[0])|(b_.u64[0]&~m_.u64[0]);
                           r_.u64[1]=(a_.u64[1]&m_.u64[1])|(b_.u64[1]&~m_.u64[1]);
                           WV_PUSH(r_); break; }

                /* integer arithmetic */
                case 96:  WV_UN(i8, 16, a_.i8[L] < 0 ? -a_.i8[L] : a_.i8[L])
                case 97:  WV_UN(i8, 16, -a_.i8[L])
                case 110: WV_BIN(i8, 16, a_.i8[L] + b_.i8[L])
                case 113: WV_BIN(i8, 16, a_.i8[L] - b_.i8[L])
                case 128: WV_UN(i16, 8, a_.i16[L] < 0 ? -a_.i16[L] : a_.i16[L])
                case 129: WV_UN(i16, 8, -a_.i16[L])
                case 142: WV_BIN(i16, 8, a_.i16[L] + b_.i16[L])
                case 145: WV_BIN(i16, 8, a_.i16[L] - b_.i16[L])
                case 149: WV_BIN(i16, 8, a_.i16[L] * b_.i16[L])
                case 160: WV_UN(i32, 4, a_.i32[L] < 0 ? -a_.i32[L] : a_.i32[L])
                case 161: WV_UN(i32, 4, -a_.i32[L])
                case 174: WV_BIN(i32, 4, (int32_t)((uint32_t)a_.i32[L] + (uint32_t)b_.i32[L]))
                case 177: WV_BIN(i32, 4, (int32_t)((uint32_t)a_.i32[L] - (uint32_t)b_.i32[L]))
                case 181: WV_BIN(i32, 4, (int32_t)((uint32_t)a_.i32[L] * (uint32_t)b_.i32[L]))
                case 193: WV_UN(i64, 2, (int64_t)(0 - (uint64_t)a_.i64[L]))
                case 206: WV_BIN(i64, 2, (int64_t)((uint64_t)a_.i64[L] + (uint64_t)b_.i64[L]))
                case 209: WV_BIN(i64, 2, (int64_t)((uint64_t)a_.i64[L] - (uint64_t)b_.i64[L]))
                case 213: WV_BIN(i64, 2, (int64_t)((uint64_t)a_.i64[L] * (uint64_t)b_.i64[L]))

                /* f32x4 / f64x2 arithmetic */
                case 224: WV_UN(f32, 4, ward_f32_abs(a_.f32[L]))
                case 225: WV_UN(f32, 4, -a_.f32[L])
                case 227: WV_UN(f32, 4, (float)sqrt((double)a_.f32[L]))
                case 228: WV_BIN(f32, 4, a_.f32[L] + b_.f32[L])
                case 229: WV_BIN(f32, 4, a_.f32[L] - b_.f32[L])
                case 230: WV_BIN(f32, 4, a_.f32[L] * b_.f32[L])
                case 231: WV_BIN(f32, 4, a_.f32[L] / b_.f32[L])
                case 232: WV_BIN(f32, 4, ward_f32_min(a_.f32[L], b_.f32[L]))
                case 233: WV_BIN(f32, 4, ward_f32_max(a_.f32[L], b_.f32[L]))
                case 234: WV_BIN(f32, 4, b_.f32[L] < a_.f32[L] ? b_.f32[L] : a_.f32[L])
                case 235: WV_BIN(f32, 4, a_.f32[L] < b_.f32[L] ? b_.f32[L] : a_.f32[L])
                case 236: WV_UN(f64, 2, ward_f64_abs(a_.f64[L]))
                case 237: WV_UN(f64, 2, -a_.f64[L])
                case 239: WV_UN(f64, 2, sqrt(a_.f64[L]))
                case 240: WV_BIN(f64, 2, a_.f64[L] + b_.f64[L])
                case 241: WV_BIN(f64, 2, a_.f64[L] - b_.f64[L])
                case 242: WV_BIN(f64, 2, a_.f64[L] * b_.f64[L])
                case 243: WV_BIN(f64, 2, a_.f64[L] / b_.f64[L])
                case 244: WV_BIN(f64, 2, ward_f64_min(a_.f64[L], b_.f64[L]))
                case 245: WV_BIN(f64, 2, ward_f64_max(a_.f64[L], b_.f64[L]))
                case 246: WV_BIN(f64, 2, b_.f64[L] < a_.f64[L] ? b_.f64[L] : a_.f64[L])
                case 247: WV_BIN(f64, 2, a_.f64[L] < b_.f64[L] ? b_.f64[L] : a_.f64[L])

                default:
                    w->sp = sp; *fuel_out = -3; return -(pc - 1);
            }
            break;
        }
        /* ─── Fallback to Duo dispatch for complex opcodes ─── */
        default: {
            /* call (0x10), call_indirect (0x11), 0xFC multi-byte, etc. */
            w->sp = sp;
            *fuel_out = -3;
            return -(pc - 1);
        }
        } /* end switch */
        /* Fuel check (lightweight) */
        /* No fuel tracking in fast path - the caller checks after return */
    }
}
]])

@hot
fun execute(rt, func_idx: i64, args: any)
  execute_raw(rt, func_idx, args, -1)
end

@hot
fun execute_raw(rt, func_idx: i64, args_buf: any, args_len: i64)
  -- Resolve function (accounting for imports)
  n_imports: i64 = #rt.mod.imports
  if func_idx < n_imports
    -- Call host function: build a Lua args table from raw int64_t* args
    imp = rt.mod.imports[func_idx + 1]
    host_fn = rt.imports[imp.module .. "." .. imp.name]
    if host_fn
      -- args_len==-1 means args_buf is already a Lua table (public execute path)
      if args_len < 0
        -- public entry: args_buf is the Lua args table
        result = host_fn(rt, args_buf)
        if result ~= nil push(rt, result) end
        return
      end
      -- internal: args_buf is raw int64_t*; build a Lua table on the fly.
      n_params: i64 = #(imp.type_idx and rt.mod.types[imp.type_idx + 1].params or {})
      args_table = {}
      @c.emit([[ ({ lua_Value _av = args_buf; int64_t* _ab = (int64_t*)_av.as.tval;
                    lua_Value _t = args_table;
                    for (int64_t _i = 0; _i < args_len; _i++) {
                        lua_table_set_raw_i64(_t, _i + 1, lua_val_from_num((double)_ab[_i]));
                    }
                    if (0) { void* _force = _ab; } }) ]])
      result = host_fn(rt, args_table)
      if result ~= nil push(rt, result) end
      return
    end
    error("unresolved import: " .. imp.module .. "." .. imp.name)
  end

  -- Internal function
  code_idx = func_idx - n_imports
  code = rt.mod.code[code_idx + 1]
  type_idx = rt.mod.functions[code_idx + 1]
  sig = rt.mod.types[type_idx + 1]

  -- Determine how many caller-supplied args we have.
  if args_len < 0
    args_len = #(args_buf or {})
  end
  local_count: i64 = args_len + #code.locals

  -- Allocate native call frame + locals array (calloc-zeroed).
  frame_ptr: i64 = @c.emit([[ ({ WardFrame* _f = ward_frame_push(local_count);
                                  _f->func_idx = func_idx;
                                  _f->sp_base = (int64_t)((WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval)->sp;
                                  (int64_t)_f; }) ]])

  -- Copy args into raw locals.
  @c.emit([[ ({
      WardFrame* _f = (WardFrame*)frame_ptr;
      int64_t _al = (int64_t)args_len;
      if (_al > 0) {
          /* Distinguish raw int64_t* array from a Lua table: heuristic via tag.
             Internal callers pass a baked int64_t cast to (double), Lua callers
             pass a lua_Value with type != VAL_BUFFER. */
          lua_Value _av = args_buf;
          if (_av.type == VAL_BUFFER) {
              int64_t* _ab = (int64_t*)_av.as.tval;
              for (int64_t _i = 0; _i < _al; _i++) _f->locals[_i] = _ab[_i];
          } else {
              for (int64_t _i = 0; _i < _al; _i++)
                  _f->locals[_i] = (int64_t)lua_to_num(lua_table_get(_av, lua_val_from_int(_i + 1)));
          }
      }
  }) ]])

  -- Push call frame (as opaque lightuserdata handle) onto Lua call_stack.
  frame_handle = @c.emit([[ ({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = (void*)frame_ptr; _v; }) ]])
  rt.call_stack[#rt.call_stack + 1] = frame_handle

  -- Pull WardRT* once per call; pass to dispatch as an int64_t param.
  w_ptr: i64 = @c.emit([[ (int64_t)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval ]])

  -- Interpret bytecode
  body: any = code.body
  pc: i64 = 1
  body_len: i64 = #body
  fuel: i64 = @c.emit([[ (int64_t)((WardRT*)w_ptr)->fuel ]])

  -- Tier 1: if this body was compiled to native code, run that instead of
  -- interpreting. Compilation is attempted once per code object and cached on
  -- it; jit_mod.compile returns nil for any body outside the supported opcode
  -- set, so an unsupported function simply keeps interpreting.
  if jit_mod ~= nil and jit_mod.available and code.jit == nil and code.jit_tried == nil
    code.jit_tried = true
    code.jit = jit_mod.compile(body, body_len)
  end
  if code.jit ~= nil
    @c.emit([[ ({ WardRT* _w = (WardRT*)w_ptr; _w->sp = ((WardFrame*)frame_ptr)->sp_base; }) ]])
    jit_mod.invoke(code.jit, w_ptr, frame_ptr)
    @c.emit([[ ({ ((WardRT*)w_ptr)->fuel = fuel; }) ]])
    @c.emit([[ ward_frame_pop((WardFrame*)frame_ptr) ]])
    rt.fuel = fuel
    rt.call_stack[#rt.call_stack] = nil
    return
  end

  -- Fast path: run the C interpreter directly on raw bytes.
  -- Reset sp to sp_base for the new call frame (args are in locals, not on stack).
  fast_fuel: i64 = 0
  fast_pc: i64 = @c.emit([[ ({ int64_t _fuel = 0; WardRT* _w = (WardRT*)w_ptr; _w->sp = ((WardFrame*)frame_ptr)->sp_base; int64_t _pc = ward_fast_run(rt, _w, (WardFrame*)frame_ptr, (const uint8_t*)lua_to_str(body), body_len, 1, &_fuel); fast_fuel = _fuel; _pc; }) ]])

  if fast_fuel == -3
    -- Fallback: re-run from the fallback PC using the Duo dispatch loop.
    pc = -fast_pc
    while pc <= body_len
      opcode: i64 = @c.emit([[ ((int64_t)((unsigned char*)lua_to_str(body))[pc - 1]) ]])
      pc = pc + 1
      pc = @c.emit([[ src_wasm_runtime__dispatch(rt, frame_ptr, body, pc, opcode, w_ptr) ]])
      fuel = fuel - 1
      if fuel <= 0
        error("fuel exhausted")
      end
    end
  elseif fast_fuel == -2
    error("unreachable executed")
  elseif fast_fuel == -4
    error("integer divide by zero")
  elseif fast_fuel == -5
    error("integer overflow")
  else
    fuel = fuel - body_len
  end

  -- Persist remaining fuel + pop the frame.
  @c.emit([[ ({ ((WardRT*)w_ptr)->fuel = fuel; }) ]])
  -- Free local array + frame struct.
  @c.emit([[ ward_frame_pop((WardFrame*)frame_ptr) ]])
  -- Mirror rt.fuel for Lua-side consumers.
  rt.fuel = fuel
  rt.call_stack[#rt.call_stack] = nil
end

-- ═══════════════════════════════════════════════════════════════
-- Public API
-- ═══════════════════════════════════════════════════════════════
fun call(rt, name: str, args: any)
  exp = rt.exports_map[name]
  if not exp
    error("export not found: " .. name)
  end
  assert(exp.kind == module.EXPORT_KIND.func, "not a function export")
  execute(rt, exp.index, args or {})

  -- Return the function's result (nil for a void function). The value was
  -- previously popped and discarded, which made every export unobservable.
  if sp(rt) > 0
    return pop(rt)
  end
  return nil
end

fun reset(rt)
  -- Restore memory snapshot (for re-execution / serverless)
  if rt.snapshot
    mem_mod.copy(rt.memory, rt.snapshot, rt.pages * WASM_PAGE_SIZE)
  end
  -- Determine new fuel: config.fuel if set, else 0xFFFFFFFF.
  new_fuel: i64 = rt.config.fuel or 0xFFFFFFFF
  -- Zero-fill operand stack, reset sp + fuel inside WardRT.
  @c.emit([[ ({ WardRT* _w = (WardRT*)lua_table_get_raw(rt, lua_val_from_str("c")).as.tval;
                if (_w->stack) memset(_w->stack, 0, WARD_STACK_SLOTS * sizeof(int64_t));
                _w->sp = 0;
                _w->fuel = new_fuel;
                }) ]])
  rt.sp = 0
  rt.fuel = new_fuel
  rt.call_stack = {}
end

fun exports(rt)
  rt.exports_map
end

fun register_import(rt, module_name: str, fn_name: str, fn)
  rt.imports[module_name .. "." .. fn_name] = fn
end

-- ═══════════════════════════════════════════════════════════════
-- Hot-path stack accessors (take WardRT* pointer as int64).
-- ═══════════════════════════════════════════════════════════════
@inline
fun op_push_i64(w: i64, v: i64)
  @c.emit([[ ({ WardRT* _w = (WardRT*)w; _w->stack[++_w->sp] = v; }) ]])
end

@inline
fun op_pop_i64(w: i64): i64
  return @c.emit([[ (int64_t)((WardRT*)w)->stack[((WardRT*)w)->sp--] ]])
end

@inline
fun op_push_f32(w: i64, v: float)
  @c.emit([[ ({ WardRT* _w = (WardRT*)w; float _f = (float)(v); int32_t _i; memcpy(&_i, &_f, 4); _w->stack[++_w->sp] = (int64_t)(uint32_t)_i; }) ]])
end

@inline
fun op_pop_f32(w: i64): float
  @c.emit([[ ({ WardRT* _w = (WardRT*)w; int64_t _b = _w->stack[_w->sp--]; int32_t _i = (int32_t)_b; float _f; memcpy(&_f, &_i, 4); (double)_f; }) ]])
end

@inline
fun op_push_f64(w: i64, v: float)
  @c.emit([[ ({ WardRT* _w = (WardRT*)w; double _d = (double)(v); int64_t _i; memcpy(&_i, &_d, 8); _w->stack[++_w->sp] = _i; }) ]])
end

@inline
fun op_pop_f64(w: i64): float
  @c.emit([[ ({ WardRT* _w = (WardRT*)w; int64_t _b = _w->stack[_w->sp--]; double _d; memcpy(&_d, &_b, 8); _d; }) ]])
end

-- ═══════════════════════════════════════════════════════════════
-- LEB128/byte readers (return { value, pc } to avoid duo multi-return bug)
-- ═══════════════════════════════════════════════════════════════
fun read_u32(body: any, pc: i64): any
  return @c.emit([[ ({ const uint8_t* _p = (const uint8_t*)lua_to_str(body); int64_t _pc = pc; int64_t _result = 0; int64_t _shift = 0; uint8_t _b; lua_Value _t; do { _b = _p[_pc - 1]; _pc++; _result |= ((int64_t)(_b & 0x7F)) << _shift; _shift += 7; } while ((_b & 0x80) != 0); _t = lua_table_new_with_capacity(0, 2); lua_table_set_raw_i64(_t, 1, lua_val_from_int(_result)); lua_table_set_raw_i64(_t, 2, lua_val_from_int(_pc)); _t; }) ]])
end

fun read_i32(body: any, pc: i64): any
  return @c.emit([[ ({ const uint8_t* _p = (const uint8_t*)lua_to_str(body); int64_t _pc = pc; int64_t _result = 0; int64_t _shift = 0; uint8_t _b; lua_Value _t; do { _b = _p[_pc - 1]; _pc++; _result |= ((int64_t)(_b & 0x7F)) << _shift; _shift += 7; } while ((_b & 0x80) != 0); if (_shift < 32 && (_b & 0x40)) _result |= (((int64_t)-1) << _shift); _t = lua_table_new_with_capacity(0, 2); lua_table_set_raw_i64(_t, 1, lua_val_from_int(_result)); lua_table_set_raw_i64(_t, 2, lua_val_from_int(_pc)); _t; }) ]])
end

fun read_i64(body: any, pc: i64): any
  return @c.emit([[ ({ const uint8_t* _p = (const uint8_t*)lua_to_str(body); int64_t _pc = pc; int64_t _result = 0; int64_t _shift = 0; uint8_t _b; lua_Value _t; do { _b = _p[_pc - 1]; _pc++; _result |= ((int64_t)(_b & 0x7F)) << _shift; _shift += 7; } while ((_b & 0x80) != 0); if (_shift < 64 && (_b & 0x40)) _result |= (((int64_t)-1) << _shift); _t = lua_table_new_with_capacity(0, 2); lua_table_set_raw_i64(_t, 1, lua_val_from_int(_result)); lua_table_set_raw_i64(_t, 2, lua_val_from_int(_pc)); _t; }) ]])
end

fun read_f32(body: any, pc: i64): any
  return @c.emit([[ ({ const uint8_t* _p = (const uint8_t*)lua_to_str(body); float _v; memcpy(&_v, _p + pc - 1, sizeof(float)); lua_Value _t; _t = lua_table_new_with_capacity(0, 2); lua_table_set_raw_i64(_t, 1, lua_val_from_num((double)_v)); lua_table_set_raw_i64(_t, 2, lua_val_from_int(pc + 4)); _t; }) ]])
end

fun read_f64(body: any, pc: i64): any
  return @c.emit([[ ({ const uint8_t* _p = (const uint8_t*)lua_to_str(body); double _v; memcpy(&_v, _p + pc - 1, sizeof(double)); lua_Value _t; _t = lua_table_new_with_capacity(0, 2); lua_table_set_raw_i64(_t, 1, lua_val_from_num(_v)); lua_table_set_raw_i64(_t, 2, lua_val_from_int(pc + 8)); _t; }) ]])
end

-- ═══════════════════════════════════════════════════════════════
-- Control-flow helpers
-- ═══════════════════════════════════════════════════════════════
@inline
fun find_end_pc(body: any, pc: i64, body_len: i64): i64
  return @c.emit([[ ward_find_end_pc((const uint8_t*)lua_to_str(body), pc, body_len) ]])
end

@inline
fun find_else_pc(body: any, pc: i64, body_len: i64): i64
  return @c.emit([[ ward_find_else_pc((const uint8_t*)lua_to_str(body), pc, body_len) ]])
end

@inline
fun op_branch_target(frame: i64, depth: i64): i64
  return @c.emit([[ ({ int64_t _d = (int64_t)depth; WardFrame* _f = (WardFrame*)frame; int64_t _idx = _f->labels_len - 1 - _d; (_f->labels[_idx].is_loop) ? _f->labels[_idx].pc : _f->labels[_idx].end_pc; }) ]])
end

@inline
fun op_branch_pc(frame: i64, depth: i64): i64
  return @c.emit([[ ({ int64_t _d = (int64_t)depth; WardFrame* _f = (WardFrame*)frame; int64_t _idx = _f->labels_len - 1 - _d; int64_t _target; if (_f->labels[_idx].is_loop) { _target = _f->labels[_idx].pc; _f->labels_len -= _d; } else { _target = _f->labels[_idx].end_pc; _f->labels_len -= (_d + 1); } _target; }) ]])
end

-- ═══════════════════════════════════════════════════════════════
-- Main dispatch
-- ═══════════════════════════════════════════════════════════════
@inline
fun dispatch(rt, frame: i64, body: any, pc: i64, opcode: i64, w: i64): i64
  body_len: i64 = #body

  match opcode
  -- ─── Control ─────────────────────────────────────────────────
  case 0x01 then pc;
  case 0x00 then error("unreachable executed")
  case 0x02 then do
    __r1 = read_i32(body, pc)
    blocktype = __r1[1]
    pc = __r1[2]
    end_pc: i64 = find_end_pc(body, pc, body_len)
    @c.emit([[ ward_label_push((WardFrame*)frame, pc, end_pc, end_pc, 0) ]])
    pc
  end
  case 0x03 then do
    __r2 = read_i32(body, pc)
    blocktype = __r2[1]
    pc = __r2[2]
    end_pc: i64 = find_end_pc(body, pc, body_len)
    @c.emit([[ ward_label_push((WardFrame*)frame, pc, end_pc, end_pc, 1) ]])
    pc
  end
  case 0x04 then do
    __r3 = read_i32(body, pc)
    blocktype = __r3[1]
    pc = __r3[2]
    else_pc: i64 = find_else_pc(body, pc, body_len)
    end_pc: i64 = find_end_pc(body, pc, body_len)
    if else_pc == 0 then else_pc = end_pc end
    @c.emit([[ ward_label_push((WardFrame*)frame, pc, end_pc, else_pc, 0) ]])
    cond: i64 = op_pop_i64(w)
    if cond ~= 0 return pc else return else_pc end
  end
  case 0x05 then do
    -- `else`: jump past the else body (to the matching block's end_pc),
    -- AFTER popping the if-block's label (which is currently on top).
    return @c.emit([[ ({ int64_t _end = ((WardFrame*)frame)->labels[((WardFrame*)frame)->labels_len - 1].end_pc;
                       ((WardFrame*)frame)->labels_len--; _end; }) ]])
  end
  case 0x0B then do
    labels_n: i64 = @c.emit([[ (int64_t)((WardFrame*)frame)->labels_len ]])
    if labels_n > 0
      @c.emit([[ if (((WardFrame*)frame)->labels_len > 0) ((WardFrame*)frame)->labels_len--; ]])
    end
    if labels_n > 0
      return pc
    end
    return body_len + 1
  end
  case 0x0C then do
    __r4 = read_u32(body, pc)
    depth: i64 = __r4[1]
    pc = __r4[2]
    target: i64 = op_branch_pc(frame, depth)
    return target
  end
  case 0x0D then do
    __r5 = read_u32(body, pc)
    depth: i64 = __r5[1]
    pc = __r5[2]
    cond: i64 = op_pop_i64(w)
    if cond ~= 0
      return op_branch_pc(frame, depth)
    end
    pc
  end
  case 0x0E then do
    __bt_n = read_u32(body, pc)
    n_labels: i64 = __bt_n[1]
    pc = __bt_n[2]
    sw_val: i64 = op_pop_i64(w)
    target_depth: i64 = -1
    for i = 0, n_labels - 1
      __bt_e = read_u32(body, pc)
      d: i64 = __bt_e[1]
      pc = __bt_e[2]
      if i == sw_val then target_depth = d end
    end
    __bt_d = read_u32(body, pc)
    default_d: i64 = __bt_d[1]
    pc = __bt_d[2]
    if target_depth < 0 then target_depth = default_d end
    return op_branch_pc(frame, target_depth)
  end
  case 0x0F then do
    return body_len + 1
  end
  case 0x10 then do
    __r6 = read_u32(body, pc)
    call_func_idx = __r6[1]
    pc = __r6[2]
    n_imports: i64 = #rt.mod.imports
    type_idx: any = nil
    if call_func_idx < n_imports
      type_idx = rt.mod.imports[call_func_idx + 1].type_idx
    else
      type_idx = rt.mod.functions[call_func_idx - n_imports + 1]
    end
    sig_rt: any = rt.mod.types[type_idx + 1]
    sig_params: any = sig_rt.params
    -- Build a raw int64_t* args buffer on the heap; pop args in reverse.
    np: i64 = #sig_params
    args_buf: i64 = @c.emit([[ ({ int64_t* _ab = (int64_t*)malloc(sizeof(int64_t) * (size_t)((np == 0) ? 1 : np)); (int64_t)_ab; }) ]])
    @c.emit([[ ({ WardRT* _w = (WardRT*)w; int64_t _np = np; int64_t* _ab = (int64_t*)args_buf;
                  for (int64_t _i = _np - 1; _i >= 0; _i--) { _ab[_i] = _w->stack[_w->sp--]; } }) ]])
    -- Wrap args_buf as a VAL_BUFFER so execute_raw detects it as raw (vs Lua table).
    args_handle = @c.emit([[ ({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = (void*)args_buf; _v; }) ]])
    @c.emit([[ src_wasm_runtime__execute_raw(rt, (int64_t)lua_to_num(call_func_idx), args_handle, np) ]])
    @c.emit([[ free((void*)((uintptr_t)args_buf)) ]])
    pc
  end
  case 0x11 then do
    __r7 = read_u32(body, pc)
    type_idx = __r7[1]
    pc = __r7[2]
    __r8 = read_u32(body, pc)
    _reserved = __r8[1]
    pc = __r8[2]
    tbl_idx: i64 = op_pop_i64(w)
    @c.emit([[ WARD_DBG( "call_indirect tbl_idx=%lld rt.table_size=%lld w=%p C table_size=%d\n", (long long)(tbl_idx), (long long)lua_to_num(lua_table_get_raw(rt, lua_val_from_str("table_size"))), (void*)w, ((WardRT*)w)->table_size); ]])
    if tbl_idx < 0 or tbl_idx >= rt.table_size
      error("call_indirect: table index out of bounds")
    end
    call_func_idx: i64 = @c.emit([[ ((WardRT*)w)->table[(int64_t)tbl_idx] ]])
    nimports: i64 = #rt.mod.imports
    ncode: i64 = #rt.mod.code
    @c.emit([[ WARD_DBG( "call_indirect call_func_idx=%lld imports=%lld code=%lld\n", (long long)(call_func_idx), (long long)(nimports), (long long)(ncode)); ]])
    if call_func_idx < 0 or call_func_idx >= (nimports + ncode)
      error("call_indirect: uninitialized table entry")
    end
    sig_rt: any = rt.mod.types[type_idx + 1]
    sig_params: any = sig_rt.params
    np: i64 = #sig_params
    args_buf: i64 = @c.emit([[ ({ int64_t* _ab = (int64_t*)malloc(sizeof(int64_t) * (size_t)((np == 0) ? 1 : np)); (int64_t)_ab; }) ]])
    @c.emit([[ ({ WardRT* _w = (WardRT*)w; int64_t _np = np; int64_t* _ab = (int64_t*)args_buf;
                  for (int64_t _i = _np - 1; _i >= 0; _i--) { _ab[_i] = _w->stack[_w->sp--]; } }) ]])
    args_handle = @c.emit([[ ({ lua_Value _v; _v.type = VAL_BUFFER; _v.as.tval = (void*)args_buf; _v; }) ]])
    @c.emit([[ src_wasm_runtime__execute_raw(rt, (int64_t)call_func_idx, args_handle, np) ]])
    @c.emit([[ free((void*)((uintptr_t)args_buf)) ]])
    pc
  end

  -- ─── Stack/params ────────────────────────────────────────────
  case 0x1A then do
    op_pop_i64(w)
    pc
  end
  case 0x1B then do
    -- select: stack is [val1, val2, c]; result is val1 when c ~= 0.
    -- val2 pops first because it is nearer the top -- do not swap these.
    c: i64 = op_pop_i64(w)
    val2: i64 = op_pop_i64(w)
    val1: i64 = op_pop_i64(w)
    op_push_i64(w, @c.emit([[ (c != 0 ? val1 : val2) ]]))
    pc
  end

  -- ─── Locals/globals ──────────────────────────────────────────
  case 0x20 then do
    __r9 = read_u32(body, pc)
    idx = __r9[1]
    pc = __r9[2]
