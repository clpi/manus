    op_push(rt, @c.emit([[lua_val_from_num(copysign(lua_to_num(a), lua_to_num(b)))]]))
    pc
  end
  case 0x99 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num(lua_to_num(a) < 0.0 ? -lua_to_num(a) : lua_to_num(a))]]))
    pc
  end
  case 0x9A then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num(-lua_to_num(a))]]))
    pc
  end
  case 0x9B then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num(ceil(lua_to_num(a)))]]))
    pc
  end
  case 0x9C then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num(floor(lua_to_num(a)))]]))
    pc
  end
  case 0x9D then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num(trunc(lua_to_num(a)))]]))
    pc
  end
  case 0x9E then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num(round(lua_to_num(a)))]]))
    pc
  end
  case 0x9F then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num(sqrt(lua_to_num(a)))]]))
    pc
  end

  -- ─── f64 Comparison ─────────────────────────────────────────
  case 0x61 then do
    b = op_pop(rt); a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int(lua_to_num(a) == lua_to_num(b) ? 1 : 0)]]))
    pc
  end
  case 0x62 then do
    b = op_pop(rt); a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int(lua_to_num(a) != lua_to_num(b) ? 1 : 0)]]))
    pc
  end
  case 0x63 then do
    b = op_pop(rt); a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int(lua_to_num(a) < lua_to_num(b) ? 1 : 0)]]))
    pc
  end
  case 0x64 then do
    b = op_pop(rt); a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int(lua_to_num(a) > lua_to_num(b) ? 1 : 0)]]))
    pc
  end
  case 0x65 then do
    b = op_pop(rt); a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int(lua_to_num(a) <= lua_to_num(b) ? 1 : 0)]]))
    pc
  end
  case 0x66 then do
    b = op_pop(rt); a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int(lua_to_num(a) >= lua_to_num(b) ? 1 : 0)]]))
    pc
  end

  -- ─── Conversions ────────────────────────────────────────────
  case 0xA7 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int32_t)(int64_t)lua_to_num(a))]]))
    pc
  end
  case 0xA8 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int32_t)(float)lua_to_num(a))]]))
    pc
  end
  case 0xA9 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)(uint32_t)(float)lua_to_num(a))]]))
    pc
  end
  case 0xAA then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int32_t)lua_to_num(a))]]))
    pc
  end
  case 0xAB then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)(uint32_t)lua_to_num(a))]]))
    pc
  end
  case 0xAC then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)(int32_t)lua_to_num(a))]]))
    pc
  end
  case 0xAD then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)(uint32_t)lua_to_num(a))]]))
    pc
  end
  case 0xAE then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)(float)lua_to_num(a))]]))
    pc
  end
  case 0xAF then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)(uint64_t)(float)lua_to_num(a))]]))
    pc
  end
  case 0xB0 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)lua_to_num(a))]]))
    pc
  end
  case 0xB1 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)(uint64_t)lua_to_num(a))]]))
    pc
  end
  case 0xB2 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(float)(int32_t)lua_to_num(a))]]))
    pc
  end
  case 0xB3 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(float)(uint32_t)lua_to_num(a))]]))
    pc
  end
  case 0xB4 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(float)(int64_t)lua_to_num(a))]]))
    pc
  end
  case 0xB5 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(float)(uint64_t)lua_to_num(a))]]))
    pc
  end
  case 0xB6 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(float)lua_to_num(a))]]))
    pc
  end
  case 0xB7 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(int32_t)lua_to_num(a))]]))
    pc
  end
  case 0xB8 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(uint32_t)lua_to_num(a))]]))
    pc
  end
  case 0xB9 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(int64_t)lua_to_num(a))]]))
    pc
  end
  case 0xBA then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(uint64_t)lua_to_num(a))]]))
    pc
  end
  case 0xBB then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_num((double)(float)lua_to_num(a))]]))
    pc
  end
  case 0xBC then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[({ float _v = (float)lua_to_num(a); int32_t _i; memcpy(&_i, &_v, sizeof(int32_t)); lua_val_from_int((int64_t)_i); })]]))
    pc
  end
  case 0xBD then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[({ double _v = lua_to_num(a); int64_t _i; memcpy(&_i, &_v, sizeof(int64_t)); lua_val_from_int(_i); })]]))
    pc
  end
  case 0xBE then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[({ int32_t _i = (int32_t)lua_to_num(a); float _v; memcpy(&_v, &_i, sizeof(float)); lua_val_from_num((double)_v); })]]))
    pc
  end
  case 0xBF then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[({ int64_t _i = (int64_t)lua_to_num(a); double _v; memcpy(&_v, &_i, sizeof(double)); lua_val_from_num(_v); })]]))
    pc
  end
  case 0xC0 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int32_t)((int8_t)lua_to_num(a)))]]))
    pc
  end
  case 0xC1 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int32_t)((int16_t)lua_to_num(a)))]]))
    pc
  end
  case 0xC2 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)((int8_t)lua_to_num(a)))]]))
    pc
  end
  case 0xC3 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)((int16_t)lua_to_num(a)))]]))
    pc
  end
  case 0xC4 then do
    a = op_pop(rt)
    op_push(rt, @c.emit([[lua_val_from_int((int64_t)((int32_t)lua_to_num(a)))]]))
    pc
  end

  case _ then do
    error("unsupported opcode: " .. tostring(opcode))
  end
  end

  pc
end

M = {}
