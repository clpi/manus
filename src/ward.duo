jitm = req "std.jit"

-- ward — WASM runtime in Duo. Pure Duo: no @c.emit, no @c.include, no C.
--
-- Execution strategy is chosen at run time and is CROSS-ARCHITECTURE
-- CONSISTENT: every path computes the same result on every host.
--
--   arm64  -> JIT to native ARM64 (std.jit mmap/seal/call)
--   other  -> the interpreter, which is architecture-independent
--
-- The JIT also falls back to the interpreter whenever it meets an opcode it
-- cannot yet emit, so adding architectures or opcodes never changes observable
-- behaviour -- only speed. `--interp` forces the fallback path, which is how
-- the two are checked against each other (pass14 s2.4 cross-architecture parity).

-- ward WASM interpreter — PURE DUO, zero @c.emit/@c.include.
--
-- Opcode constants below are generated from the Pass 12 M2 descriptor chain
-- (src/wasm_semantic.zig -> `duo wasm-tables emit` -> lib/std/wasm/ward_mvp_opcodes.duo)
-- by ward/scripts_gen_interp.py, so the canonical table stays the single source
-- of truth. They are inlined rather than `req`d because requiring a std module
-- currently fails to compile (BUG C: export table references DCE'd symbols).
--
-- Codegen constraints (filed 2026-08-05, src/codegen.zig locked):
--   BUG A  a branch may not end on a void call -> explicit non-void tail.
--   BUG B  pointer locals must not cross a function boundary -> one function.
--   BUG C  no `req "std.mem"`; mem.* is intercepted by name.
--   BUG D  named consts are illegal as `match` patterns -> if/elseif, which
--          compares properly and lets the descriptor names be used directly.
--   BUG E  mem.alloc local + while + `match` is a compiler panic -> if/elseif.
--   BUG G  variable shift >= 32 is 32-bit -> no LEB sign-extension (masking
--          the raw accumulated bits to 32 already yields the correct i32).
--
-- Shape: ONE hoisted LEB128 decode (was 6 copies), binops share operand
-- fetch/stack adjust (was 15 near-identical blocks), hot opcodes tested first.

const OP_loop = 3
const OP_end_ = 11
const OP_br = 12
const OP_br_if = 13
const OP_return_ = 15
const OP_local_get = 32
const OP_local_set = 33
const OP_local_tee = 34
const OP_i32_const = 65
const OP_i32_eqz = 69
const OP_i32_ne = 71
const OP_i32_lt_u = 73
const OP_i32_add = 106
const OP_i32_sub = 107
const OP_i32_mul = 108
const OP_i32_and = 113
const OP_i32_or = 114
const OP_i32_xor = 115
const OP_i32_shl = 116
const OP_i32_shr_u = 118
const M32 = 0xFFFFFFFF


-- ── Minimal WASM module decoder (pure Duo) ───────────────────────────────
-- Operates on the module image as a Lua string and returns byte offsets, so
-- no pointer ever crosses a function boundary (BUG B).

-- unsigned LEB128 at 1-based offset `i`. Two scanning helpers instead of an
-- out-parameter: mem.* cannot take an `any`-typed buffer param, and decoding
-- is one-time (not on the hot path), so scanning twice costs nothing.
uleb_val(s: any, i: i64): i64
  v: i64 = 0
  sh: i64 = 0
  p: i64 = i
  cont: i64 = 1
  n: i64 = #s
  while cont == 1 and p <= n
    b: i64 = string.byte(s, p)
    p += 1
    v = v | ((b & 0x7F) << sh)
    sh += 7
    if b < 0x80
      cont = 0
    end
  end
  v
end

uleb_end(s: any, i: i64): i64
  p: i64 = i
  cont: i64 = 1
  n: i64 = #s
  while cont == 1 and p <= n
    b: i64 = string.byte(s, p)
    p += 1
    if b < 0x80
      cont = 0
    end
  end
  p
end

-- Locate the body of the function exported as `run` (falls back to the
-- largest body). Returns offset packed as off * 65536 + len.
find_run_body(s: any, n: i64): i64
  i: i64 = 9                       -- skip 8-byte header (1-based)
  code_off: i64 = 0
  code_len: i64 = 0
  exp_off: i64 = 0
  nimp: i64 = 0
  while i <= n
    sid: i64 = string.byte(s, i)
    i += 1
    sz: i64 = uleb_val(s, i)

    i = uleb_end(s, i)
    if sid == 10
      code_off = i
      code_len = sz
    elseif sid == 7
      exp_off = i
    elseif sid == 2
      cnt: i64 = uleb_val(s, i)
      j: i64 = uleb_end(s, i)
      k: i64 = 0
      while k < cnt and j <= n
        l1: i64 = uleb_val(s, j)

        j = uleb_end(s, j) + l1
        l2: i64 = uleb_val(s, j)

        j = uleb_end(s, j) + l2
        kind: i64 = string.byte(s, j)
        j += 1
        if kind == 0
          nimp += 1
          _d: i64 = uleb_val(s, j)

          j = uleb_end(s, j)
        elseif kind == 1
          j += 1
          fl: i64 = string.byte(s, j)
          j += 1
          _a: i64 = uleb_val(s, j)

          j = uleb_end(s, j)
          if fl == 1
            _b: i64 = uleb_val(s, j)

            j = uleb_end(s, j)
          end
        else
          j += 2
        end
        k += 1
      end
    end
    i += sz
  end

  -- export section: find "run"
  target: i64 = -1
  if exp_off > 0
    cnt2: i64 = uleb_val(s, exp_off)
    q: i64 = uleb_end(s, exp_off)
    e: i64 = 0
    while e < cnt2 and q <= n
      ln: i64 = uleb_val(s, q)

      q = uleb_end(s, q)
      is_run: i64 = 0
      if ln == 3
        if string.byte(s, q) == 114 and string.byte(s, q + 1) == 117 and string.byte(s, q + 2) == 110
          is_run = 1
        end
      end
      q += ln
      kind2: i64 = string.byte(s, q)
      q += 1
      idx2: i64 = uleb_val(s, q)

      q = uleb_end(s, q)
      if is_run == 1 and kind2 == 0
        target = idx2 - nimp
      end
      e += 1
    end
  end

  -- code section: walk to the target body, skip its locals prefix
  best_off: i64 = 0
  best_len: i64 = 0
  nfn: i64 = uleb_val(s, code_off)
  p2: i64 = uleb_end(s, code_off)
  fi: i64 = 0
  while fi < nfn and p2 <= n
    bsz: i64 = uleb_val(s, p2)
    bstart: i64 = uleb_end(s, p2)
    take: i64 = 0
    if target >= 0
      if fi == target
        take = 1
      end
    elseif bsz > best_len
      take = 1
    end
    if take == 1
      nl: i64 = uleb_val(s, bstart)
      r2: i64 = uleb_end(s, bstart)
      g: i64 = 0
      while g < nl
        _c: i64 = uleb_val(s, r2)

        r2 = uleb_end(s, r2) + 1
        g += 1
      end
      best_off = r2 - 1
      best_len = bsz - (r2 - bstart)
    end
    p2 = bstart + bsz
    fi += 1
  end
  best_off * 65536 + best_len
end


run_body(body: any, body_off: i64, body_len: i64, guard: i64): i64
  code = mem.alloc(body_len + 16)
  st   = mem.alloc(4096 * 8)
  lo   = mem.alloc(64 * 8)
  ltgt = mem.alloc(64 * 8)
  lelse = mem.alloc(64 * 8)
  gl   = mem.alloc(64 * 8)
  lin  = mem.alloc(65536)
  himm = mem.alloc(256)
  mem.zero(code, body_len + 16)
  mem.zero(st, 4096 * 8)
  mem.zero(lo, 64 * 8)
  mem.zero(ltgt, 64 * 8)
  mem.zero(lelse, 64 * 8)
  mem.zero(gl, 64 * 8)
  mem.zero(lin, 65536)
  mem.zero(himm, 256)
  -- wasm-libc expects a usable shadow stack pointer in global 0
  mem.write_i64(gl, 0, 65536)
  -- Opcodes carrying a LEB128 immediate that the cold path must consume.
  -- Missing an entry desyncs `pc` and decodes garbage, so this must cover
  -- every immediate-carrying opcode not handled inline in the hot path.
  mem.write_byte(himm, 33, 1)   -- local.set
  mem.write_byte(himm, 35, 1)   -- global.get
  mem.write_byte(himm, 36, 1)   -- global.set
  mem.write_byte(himm, 12, 1)   -- br
  mem.write_byte(himm, 13, 1)   -- br_if
  ci: i64 = 0
  while ci < body_len
    mem.write_byte(code, ci, string.byte(body, body_off + ci + 1))
    ci += 1
  end
  sp: i64 = 0
  pc: i64 = 0
  lsp: i64 = 0

  while pc < body_len
    op: i64 = mem.read_byte(code, pc)
    pc += 1

    if op == OP_i32_const
      sh: i64 = 0
      cont: i64 = 1
      imm: i64 = 0
      ib: i64 = 0
      while cont == 1
        ib = mem.read_byte(code, pc)
        pc += 1
        imm = imm | ((ib & 0x7F) << sh)
        sh += 7
        if ib < 0x80
          cont = 0
        end
      end
      -- i32.const is SIGNED LEB128: sign-extend when the last byte's 0x40 bit
      -- is set. `i32.const -1` is the single byte 0x7F and decodes as 127
      -- without this. Requires a correct 64-bit variable shift, which the
      -- compiler now performs.
      if sh < 64 and (ib & 0x40) ~= 0
        imm = imm | (0 - (1 << sh))
      end
      imm = imm & M32
      sp += 1
      mem.write_i64(st, sp * 8, imm)
      sp = sp

    elseif op == OP_local_get
      sh: i64 = 0
      cont: i64 = 1
      imm: i64 = 0
      while cont == 1
        ib: i64 = mem.read_byte(code, pc)
        pc += 1
        imm = imm | ((ib & 0x7F) << sh)
        sh += 7
        if ib < 0x80
          cont = 0
        end
      end
      imm = imm & M32
      if imm < 0 or imm >= 64
        return -1
      end
      sp += 1
      mem.write_i64(st, sp * 8, mem.read_i64(lo, imm * 8))
      sp = sp

    elseif op >= OP_i32_add and op <= OP_i32_shr_u
      -- i32 binary ALU: operand fetch and stack adjust shared by all arms.
      if sp < 2
        return -1
      end
      b: i64 = mem.read_i64(st, sp * 8)
      a: i64 = mem.read_i64(st, (sp - 1) * 8)
      sp -= 1
      r: i64 = 0
      if op == OP_i32_mul
        -- split multiply: a*b with 32-bit operands overflows signed i64
        r = (((a & 0xFFFF) * b) + (((((a >> 16) & 0xFFFF) * b) & 0xFFFF) << 16)) & M32
      elseif op == OP_i32_xor
        r = a ~ b
      elseif op == OP_i32_or
        r = a | b
      elseif op == OP_i32_shr_u
        r = (a & M32) >> (b & 31)
      elseif op == OP_i32_add
        r = (a + b) & M32
      elseif op == OP_i32_sub
        r = (a - b) & M32
      elseif op == OP_i32_and
        r = a & b
      elseif op == OP_i32_shl
        r = ((a & (M32 >> (b & 31))) << (b & 31)) & M32
      end
      mem.write_i64(st, sp * 8, r)
      sp = sp

    elseif op == OP_local_tee
      sh: i64 = 0
      cont: i64 = 1
      imm: i64 = 0
      while cont == 1
        ib: i64 = mem.read_byte(code, pc)
        pc += 1
        imm = imm | ((ib & 0x7F) << sh)
        sh += 7
        if ib < 0x80
          cont = 0
        end
      end
      imm = imm & M32
      mem.write_i64(lo, imm * 8, mem.read_i64(st, sp * 8))
      sp = sp

    else
      -- Cold path: one table-guarded decode shared by every remaining opcode.
      imm2: i64 = 0
      if mem.read_byte(himm, op) ~= 0
        sh2: i64 = 0
        c2: i64 = 1
        while c2 == 1
          jb: i64 = mem.read_byte(code, pc)
          pc += 1
          imm2 = imm2 | ((jb & 0x7F) << sh2)
          sh2 += 7
          if jb < 0x80
            c2 = 0
          end
        end
        imm2 = imm2 & M32
      end

      if op == OP_br_if
        cv: i64 = mem.read_i64(st, sp * 8)
        sp -= 1
        if cv ~= 0
          pc = mem.read_i64(ltgt, (lsp - 1 - imm2) * 8)
          lsp -= imm2
        end
      elseif op == OP_local_set
        if sp < 1 or imm2 < 0 or imm2 >= 64
          return -1
        end
        mem.write_i64(lo, imm2 * 8, mem.read_i64(st, sp * 8))
        sp -= 1
      elseif op >= OP_i32_eqz and op <= OP_i32_lt_u
        if op == OP_i32_eqz
          av: i64 = mem.read_i64(st, sp * 8)
          rv: i64 = 0
          if (av & M32) == 0
            rv = 1
          end
          mem.write_i64(st, sp * 8, rv)
          sp = sp
        else
          b2: i64 = mem.read_i64(st, sp * 8)
          a2: i64 = mem.read_i64(st, (sp - 1) * 8)
          sp -= 1
          r2: i64 = 0
          if op == OP_i32_ne
            if a2 ~= b2
              r2 = 1
            end
          elseif op == OP_i32_lt_u
            if (a2 & M32) < (b2 & M32)
              r2 = 1
            end
          end
          mem.write_i64(st, sp * 8, r2)
          sp = sp
        end
      elseif op == 2 or op == 4
        -- block (0x02) / if (0x04): branch target is just past the matching
        -- `end`. Scan forward tracking nesting; also record the `else` for `if`.
        if lsp >= 63
          return -1
        end
        pc += 1                       -- blocktype
        d: i64 = 1
        sc: i64 = pc
        epc: i64 = 0
        -- Skip immediates by opcode. This must cover EVERY immediate-carrying
        -- opcode, not just the ones the cold path decodes: an unskipped operand
        -- byte is read as an opcode and the scan desyncs, so the block gets a
        -- wrong branch target. (`himm` is not usable here -- it deliberately
        -- omits local.get/local.tee, which the hot path decodes inline.)
        while sc < body_len and d > 0
          sb: i64 = mem.read_byte(code, sc)
          sc += 1
          if sb == 2 or sb == 3 or sb == 4
            d += 1
            sc += 1                       -- blocktype byte
          elseif sb == 11
            d -= 1
          elseif sb == 5 and d == 1
            epc = sc
          elseif sb == 14
            -- br_table: count, then count+1 depths
            ncase: i64 = 0
            shc: i64 = 0
            cc2: i64 = 1
            while cc2 == 1 and sc < body_len
              cb: i64 = mem.read_byte(code, sc)
              sc += 1
              ncase = ncase | ((cb & 0x7F) << shc)
              shc += 7
              if cb < 0x80
                cc2 = 0
              end
            end
            kc: i64 = 0
            while kc <= ncase and sc < body_len
              while sc < body_len and mem.read_byte(code, sc) >= 0x80
                sc += 1
              end
              sc += 1
              kc += 1
            end
          elseif sb == 63 or sb == 64
            sc += 1                       -- memory.size / memory.grow: memidx
          elseif sb == 67
            sc += 4                       -- f32.const
          elseif sb == 68
            sc += 8                       -- f64.const
          elseif (sb >= 40 and sb <= 62) or sb == 17
            -- loads/stores carry align+offset; call_indirect type+table
            while sc < body_len and mem.read_byte(code, sc) >= 0x80
              sc += 1
            end
            sc += 1
            while sc < body_len and mem.read_byte(code, sc) >= 0x80
              sc += 1
            end
            sc += 1
          elseif sb == 12 or sb == 13 or sb == 16 or (sb >= 32 and sb <= 36) or sb == 65 or sb == 66
            -- br, br_if, call, local.*/global.*, i32.const, i64.const
            while sc < body_len and mem.read_byte(code, sc) >= 0x80
              sc += 1
            end
            sc += 1
          end
        end
        mem.write_i64(ltgt, lsp * 8, sc)
        mem.write_i64(lelse, lsp * 8, epc)
        lsp += 1
        if op == 4
          if sp < 1
            return -1
          end
          cv2: i64 = mem.read_i64(st, sp * 8)
          sp -= 1
          if cv2 == 0
            if epc ~= 0
              pc = epc
            else
              pc = sc
              lsp -= 1
            end
          end
        end

      elseif op == 5
        -- else: reached only by falling out of the taken `if` arm; skip to end
        if lsp < 1
          return -1
        end
        pc = mem.read_i64(ltgt, (lsp - 1) * 8)
        lsp -= 1

      elseif op == 14
        -- br_table: count, then count+1 target depths; index from the stack
        if sp < 1
          return -1
        end
        nt: i64 = 0
        shn: i64 = 0
        cn: i64 = 1
        while cn == 1
          nb: i64 = mem.read_byte(code, pc)
          pc += 1
          nt = nt | ((nb & 0x7F) << shn)
          shn += 7
          if nb < 0x80
            cn = 0
          end
        end
        idxv: i64 = mem.read_i64(st, sp * 8)
        sp -= 1
        chosen: i64 = 0
        ti: i64 = 0
        while ti <= nt
          dv: i64 = 0
          shd2: i64 = 0
          cd2: i64 = 1
          while cd2 == 1
            db: i64 = mem.read_byte(code, pc)
            pc += 1
            dv = dv | ((db & 0x7F) << shd2)
            shd2 += 7
            if db < 0x80
              cd2 = 0
            end
          end
          if ti == idxv or (idxv >= nt and ti == nt)
            chosen = dv
          end
          ti += 1
        end
        lt2: i64 = lsp - 1 - chosen
        if lt2 < 0 or lt2 >= 64
          return -1
        end
        pc = mem.read_i64(ltgt, lt2 * 8)
        lsp = lsp - chosen

      elseif op >= 103 and op <= 105
        -- i32.clz / ctz / popcnt
        if sp < 1
          return -1
        end
        xv: i64 = mem.read_i64(st, sp * 8) & M32
        rr: i64 = 0
        if op == 103
          if xv == 0
            rr = 32
          else
            bi: i64 = 31
            while bi >= 0 and ((xv >> bi) & 1) == 0
              rr += 1
              bi -= 1
            end
          end
        elseif op == 104
          if xv == 0
            rr = 32
          else
            bj: i64 = 0
            while bj < 32 and ((xv >> bj) & 1) == 0
              rr += 1
              bj += 1
            end
          end
        else
          bk: i64 = 0
          while bk < 32
            rr = rr + ((xv >> bk) & 1)
            bk += 1
          end
        end
        mem.write_i64(st, sp * 8, rr)
        sp = sp

      elseif op >= 44 and op <= 47
        -- i32.load8_s/8_u/16_s/16_u
        if sp < 1
          return -1
        end
        while pc < body_len and mem.read_byte(code, pc) >= 0x80
          pc += 1
        end
        pc += 1
        offv: i64 = 0
        sho: i64 = 0
        co: i64 = 1
        while co == 1
          ob: i64 = mem.read_byte(code, pc)
          pc += 1
          offv = offv | ((ob & 0x7F) << sho)
          sho += 7
          if ob < 0x80
            co = 0
          end
        end
        av2: i64 = (mem.read_i64(st, sp * 8) + offv) & 0xFFFF
        lv: i64 = 0
        if op == 44 or op == 45
          lv = mem.read_byte(lin, av2)
          if op == 44 and lv >= 128
            lv = lv - 256
          end
        else
          lv = mem.read_byte(lin, av2) | (mem.read_byte(lin, av2 + 1) << 8)
          if op == 46 and lv >= 32768
            lv = lv - 65536
          end
        end
        mem.write_i64(st, sp * 8, lv & M32)
        sp = sp

      elseif op == 58 or op == 59
        -- i32.store8 / store16
        if sp < 2
          return -1
        end
        while pc < body_len and mem.read_byte(code, pc) >= 0x80
          pc += 1
        end
        pc += 1
        offs: i64 = 0
        shs: i64 = 0
        cs2: i64 = 1
        while cs2 == 1
          sb2: i64 = mem.read_byte(code, pc)
          pc += 1
          offs = offs | ((sb2 & 0x7F) << shs)
          shs += 7
          if sb2 < 0x80
            cs2 = 0
          end
        end
        sv2: i64 = mem.read_i64(st, sp * 8)
        ad2: i64 = (mem.read_i64(st, (sp - 1) * 8) + offs) & 0xFFFF
        mem.write_byte(lin, ad2, sv2 & 255)
        if op == 59
          mem.write_byte(lin, ad2 + 1, (sv2 >> 8) & 255)
          sp = sp
        end
        sp -= 2

      elseif op == OP_loop
        if lsp >= 63
          return -1
        end
        pc += 1
        mem.write_i64(ltgt, lsp * 8, pc)
        lsp += 1
      elseif op == OP_end_
        if lsp > 0
          lsp -= 1
        end
      elseif op == OP_br
        lb: i64 = lsp - 1 - imm2
        if lb < 0 or lb >= 64
          return -1
        end
        pc = mem.read_i64(ltgt, lb * 8)
        lsp -= imm2
      elseif op == OP_return_
        pc = body_len

      elseif op == 26
        -- drop
        if sp < 1
          return -1
        end
        sp -= 1

      elseif op == 66
        -- i64.const: signed LEB128, up to 10 bytes, NO 32-bit mask (an i64
        -- fills the whole stack slot).
        shq: i64 = 0
        cq: i64 = 1
        vq: i64 = 0
        qb: i64 = 0
        while cq == 1
          qb = mem.read_byte(code, pc)
          pc += 1
          vq = vq | ((qb & 0x7F) << shq)
          shq += 7
          if qb < 0x80
            cq = 0
          end
        end
        if shq < 64 and (qb & 0x40) ~= 0
          vq = vq | (0 - (1 << shq))
        end
        sp += 1
        mem.write_i64(st, sp * 8, vq)
        sp = sp

      elseif op == 124 or op == 125 or op == 126 or op == 131 or op == 132 or op == 133 or op == 134 or op == 135 or op == 136
        -- i64 ALU: add sub mul and or xor shl shr_s shr_u.
        -- No masking: i64 results already occupy the full slot. Shifts use 63.
        if sp < 2
          return -1
        end
        bq: i64 = mem.read_i64(st, sp * 8)
        aq: i64 = mem.read_i64(st, (sp - 1) * 8)
        sp -= 1
        rq: i64 = 0
        if op == 124
          rq = aq + bq
        elseif op == 125
          rq = aq - bq
        elseif op == 126
          rq = aq * bq
        elseif op == 131
          rq = aq & bq
        elseif op == 132
          rq = aq | bq
        elseif op == 133
          rq = aq ~ bq
        elseif op == 134
          rq = aq << (bq & 63)
        elseif op == 135
          rq = aq >> (bq & 63)
        else
          -- shr_u: logical shift. Duo i64 is signed, so a negative value must
          -- not sign-extend; clear the bits shifted in from the top.
          sq: i64 = bq & 63
          if sq == 0
            rq = aq
          else
            -- Keep only the 64-sq low bits. For sq >= 1 this is exact:
            -- (1 << 63) is i64 min, so (1 << 63) - 1 is i64 max, the right
            -- mask for a shift of 1. A shift of 0 is handled above because
            -- 1 << 64 would overflow.
            rq = (aq >> sq) & ((1 << (64 - sq)) - 1)
          end
        end
        mem.write_i64(st, (sp - 1) * 8, rq)
        sp = sp

      elseif op == 80
        -- i64.eqz
        if sp < 1
          return -1
        end
        zq: i64 = 0
        if mem.read_i64(st, sp * 8) == 0
          zq = 1
        end
        mem.write_i64(st, sp * 8, zq)
        sp = sp

      elseif op >= 81 and op <= 90
        -- i64 comparisons: eq ne lt_s lt_u gt_s gt_u le_s le_u ge_s ge_u.
        -- Unsigned forms cannot use the signed operators directly: when the two
        -- operands differ in sign bit, the one with the bit set is the larger
        -- unsigned value.
        if sp < 2
          return -1
        end
        bw: i64 = mem.read_i64(st, sp * 8)
        aw: i64 = mem.read_i64(st, (sp - 1) * 8)
        sp -= 1
        lt_signed: i64 = 0
        if aw < bw
          lt_signed = 1
        end
        lt_unsigned: i64 = lt_signed
        if (aw < 0) ~= (bw < 0)
          lt_unsigned = 0
          if aw >= 0
            lt_unsigned = 1
          end
        end
        rw: i64 = 0
        if op == 81 and aw == bw
          rw = 1
        elseif op == 82 and aw ~= bw
          rw = 1
        elseif op == 83 and lt_signed == 1
          rw = 1
        elseif op == 84 and lt_unsigned == 1
          rw = 1
        elseif op == 85 and lt_signed == 0 and aw ~= bw
          rw = 1
        elseif op == 86 and lt_unsigned == 0 and aw ~= bw
          rw = 1
        elseif op == 87 and (lt_signed == 1 or aw == bw)
          rw = 1
        elseif op == 88 and (lt_unsigned == 1 or aw == bw)
          rw = 1
        elseif op == 89 and lt_signed == 0
          rw = 1
        elseif op == 90 and lt_unsigned == 0
          rw = 1
        end
        mem.write_i64(st, (sp - 1) * 8, rw)
        sp = sp

      elseif op == 167 or op == 172 or op == 173
        -- i32.wrap_i64 / i64.extend_i32_s / i64.extend_i32_u
        if sp < 1
          return -1
        end
        xw: i64 = mem.read_i64(st, sp * 8)
        yw: i64 = xw & M32
        if op == 172 and yw >= 0x80000000
          yw = yw - 0x100000000
        end
        mem.write_i64(st, sp * 8, yw)
        sp = sp

      elseif op == 27
        -- select: c = top, then b, then a; result = c ~= 0 ? a : b
        if sp < 3
          return -1
        end
        csel: i64 = mem.read_i64(st, sp * 8)
        bsel: i64 = mem.read_i64(st, (sp - 1) * 8)
        asel: i64 = mem.read_i64(st, (sp - 2) * 8)
        rsel: i64 = bsel
        if csel ~= 0
          rsel = asel
        end
        mem.write_i64(st, (sp - 2) * 8, rsel)
        sp -= 2

      elseif op == 119 or op == 120
        -- i32.rotl / i32.rotr
        if sp < 2
          return -1
        end
        brot: i64 = mem.read_i64(st, sp * 8) & 31
        arot: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
        lsh: i64 = brot
        if op == 120
          lsh = (32 - brot) & 31
        end
        rsh: i64 = (32 - lsh) & 31
        vrot: i64 = arot
        if lsh ~= 0
          vrot = ((arot << lsh) | (arot >> rsh)) & M32
        end
        mem.write_i64(st, (sp - 1) * 8, vrot)
        sp -= 1

      elseif op >= 109 and op <= 112
        -- i32.div_s / div_u / rem_s / rem_u
        if sp < 2
          return -1
        end
        bd: i64 = mem.read_i64(st, sp * 8) & M32
        ad: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
        if bd == 0
          return -1
        end
        asi: i64 = ad
        bsi: i64 = bd
        if ad >= 0x80000000
          asi = ad - 0x100000000
        end
        if bd >= 0x80000000
          bsi = bd - 0x100000000
        end
        rd: i64 = 0
        if op == 109
          rd = asi // bsi
        elseif op == 110
          rd = ad // bd
        elseif op == 111
          rd = asi - (asi // bsi) * bsi
        else
          rd = ad - (ad // bd) * bd
        end
        mem.write_i64(st, (sp - 1) * 8, rd & M32)
        sp -= 1

      elseif op == 72 or op == 74 or op == 76 or op == 78
        -- signed i32 comparisons: lt_s gt_s le_s ge_s
        if sp < 2
          return -1
        end
        bc: i64 = mem.read_i64(st, sp * 8) & M32
        ac: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
        if ac >= 0x80000000
          ac -= 0x100000000
        end
        if bc >= 0x80000000
          bc -= 0x100000000
        end
        rc: i64 = 0
        if op == 72 and ac < bc
          rc = 1
        elseif op == 74 and ac > bc
          rc = 1
        elseif op == 76 and ac <= bc
          rc = 1
        elseif op == 78 and ac >= bc
          rc = 1
        end
        mem.write_i64(st, (sp - 1) * 8, rc)
        sp -= 1

      else
        -- Unimplemented opcode: its stack effect is unknown, so continuing
        -- would silently unbalance sp and eventually fault. Refuse instead.
        return -1
      end
    end
  end

  last: i64 = 0
  if sp > 0
    last = mem.read_i64(st, sp * 8) & M32
  end
  mem.free(code)
  mem.free(st)
  mem.free(lo)
  mem.free(ltgt)
  mem.free(lelse)
  mem.free(lin)
  mem.free(gl)
  mem.free(himm)
  last
end


-- ALU ops are one code path driven by a table: opcode -> ARM64 base word.
-- Adding an op is one row, not a new branch.
ALU_OPS = {
  {106, 0x0B000000},   -- i32.add   ADD  Wd, Wn, Wm
  {107, 0x4B000000},   -- i32.sub   SUB
  {108, 0x1B007C00},   -- i32.mul   MADD Wd, Wn, Wm, WZR
  {113, 0x0A000000},   -- i32.and   AND
  {114, 0x2A000000},   -- i32.or    ORR
  {115, 0x4A000000},   -- i32.xor   EOR
  {116, 0x1AC02000},   -- i32.shl   LSLV
  {118, 0x1AC02400},   -- i32.shr_u LSRV
}

-- Comparisons: opcode -> ARM64 condition code used by CSET.
CMP_OPS = {
  {70, 0},   -- i32.eq   EQ
  {71, 1},   -- i32.ne   NE
  {73, 3},   -- i32.lt_u CC (unsigned lower)
  {75, 8},   -- i32.gt_u HI
  {77, 9},   -- i32.le_u LS
  {79, 2},   -- i32.ge_u CS
}

alu_word(op: i64): i64
  i: i64 = 1
  while i <= #ALU_OPS
    row = ALU_OPS[i]
    if row[1] == op
      return row[2]
    end
    i += 1
  end
  0
end

cmp_cond(op: i64): i64
  i: i64 = 1
  while i <= #CMP_OPS
    row = CMP_OPS[i]
    if row[1] == op
      return row[2]
    end
    i += 1
  end
  -1
end

-- Compile body bytes [off, off+len) to ARM64 in `code`; returns word count,
-- or -1 if an unsupported opcode is hit (caller falls back to the interpreter).
jit_compile(s: any, off: i64, blen: i64, code: any): i64
  n: i64 = 0                       -- emitted instruction words
  sp: i64 = 0                      -- compile-time operand-stack depth
  pc: i64 = 1                      -- 1-based cursor into the body
  loop_word: i64 = -1              -- word index of the innermost loop head

  while pc <= blen
    op: i64 = string.byte(s, off + pc)
    pc += 1

    -- Register budget: stack slots occupy w0..w8, locals w9..w16. Emitting
    -- past either would silently alias a local, so refuse and let the caller
    -- fall back to the interpreter. Correctness before speed (pass14 s1.1:
    -- a fast path that changes semantics is not proof).
    if sp > 8 or sp < 0
      return -1
    end

    aw: i64 = alu_word(op)
    cc: i64 = cmp_cond(op)

    if op == 65
      -- i32.const -> MOVZ/MOVK into the next stack register
      v: i64 = uleb_val(s, off + pc)
      pc = uleb_end(s, off + pc) - off
      d: i64 = sp
      lo: i64 = v & 0xFFFF
      hi: i64 = (v >> 16) & 0xFFFF
      jitm.w32(code, n, 0x52800000 | (lo << 5) | d)
      n += 1
      if hi ~= 0
        jitm.w32(code, n, 0x72A00000 | (hi << 5) | d)
        n += 1
      end
      sp += 1

    elseif op == 32
      -- local.get -> MOV Wd, Wlocal   (ORR Wd, WZR, Wn)
      idx: i64 = uleb_val(s, off + pc)
      pc = uleb_end(s, off + pc) - off
      if idx > 7
        return -1
      end
      jitm.w32(code, n, 0x2A0003E0 | ((9 + idx) << 16) | sp)
      n += 1
      sp += 1

    elseif op == 33 or op == 34
      -- local.set / local.tee -> MOV Wlocal, Wtop
      idx2: i64 = uleb_val(s, off + pc)
      pc = uleb_end(s, off + pc) - off
      if idx2 > 7 or sp < 1
        return -1
      end
      jitm.w32(code, n, 0x2A0003E0 | ((sp - 1) << 16) | (9 + idx2))
      n += 1
      if op == 33
        sp -= 1
      end

    elseif aw ~= 0
      -- binary ALU: Wd = W(sp-2) op W(sp-1)
      if sp < 2
        return -1
      end
      a: i64 = sp - 2
      b: i64 = sp - 1
      jitm.w32(code, n, aw | (b << 16) | (a << 5) | a)
      n += 1
      sp -= 1

    elseif cc >= 0
      -- comparison: CMP W(sp-2), W(sp-1) then CSET W(sp-2), cond
      if sp < 2
        return -1
      end
      a2: i64 = sp - 2
      b2: i64 = sp - 1
      jitm.w32(code, n, 0x6B00001F | (b2 << 16) | (a2 << 5))
      n += 1
      jitm.w32(code, n, 0x1A9F07E0 | ((cc ~ 1) << 12) | a2)
      n += 1
      sp -= 1

    elseif op == 69
      -- i32.eqz -> CMP Wt, #0 ; CSET Wt, EQ
      t: i64 = sp - 1
      jitm.w32(code, n, 0x7100001F | (t << 5))
      n += 1
      jitm.w32(code, n, 0x1A9F07E0 | (1 << 12) | t)
      n += 1

    elseif op == 3
      -- loop: header is here; branch target for depth 0
      pc += 1
      loop_word = n

    elseif op == 13
      -- br_if 0 -> CBNZ Wtop, <loop head>  (backward, offset known now)
      d3: i64 = uleb_val(s, off + pc)
      pc = uleb_end(s, off + pc) - off
      sp -= 1
      if d3 ~= 0 or loop_word < 0
        return -1
      end
      delta: i64 = loop_word - n
      jitm.w32(code, n, 0x35000000 | ((delta & 0x7FFFF) << 5) | sp)
      n += 1

    elseif op == 11
      -- end: closes the loop (or the function)
      loop_word = -1

    elseif op == 15
      pc = blen + 1

    else
      return -1
    end
  end

  -- result in w0, then RET
  if sp > 0
    jitm.w32(code, n, 0x2A0003E0 | ((sp - 1) << 16) | 0)
    n += 1
  end
  jitm.w32(code, n, 0xD65F03C0)
  n += 1
  n
end


-- ── entry ────────────────────────────────────────────────────────────────
-- Compiled binaries do not populate Lua's `arg`, so selection comes from the
-- environment: WARD_WASM picks the module, WARD_ENGINE=interp forces the
-- architecture-independent path (used to check JIT/interpreter parity).
path = os.getenv("WARD_WASM") or "/tmp/hash.wasm"
force_interp: i64 = 0
if os.getenv("WARD_ENGINE") == "interp"
  force_interp = 1
end

f = io.open(path, "rb")
if not f
  print("ward: cannot open " .. path)
  return
end
bytes = f:read("*a")
f:close()

packed: i64 = find_run_body(bytes, #bytes)
boff: i64 = packed // 65536
blen: i64 = packed - boff * 65536

-- The decoder is a minimal section walker; on a module shape it does not
-- handle it can desync. Validate before anything indexes the image, so a
-- desync is a clean diagnostic rather than an out-of-bounds read.
if blen <= 0 or boff < 0 or boff + blen > #bytes
  print("ward: could not locate an exported `run` body in " .. path)
  print("      (decoded offset=" .. tostring(boff) .. " len=" .. tostring(blen) .. " of " .. tostring(#bytes) .. " bytes)")
  return
end

engine = "interp"
result: i64 = 0
t0 = os.clock()

if force_interp == 0 and jitm.arch() == "arm64"
  code = jitm.alloc(1 << 20)
  if code
    words: i64 = jit_compile(bytes, boff, blen, code)
    if words > 0 and jitm.seal(code, words * 4)
      engine = "jit-arm64"
      result = jitm.call0(code) & M32
    end
  end
end

if engine == "interp"
  result = run_body(bytes, boff, blen, 0)
end

t1 = os.clock()
print("engine=" .. engine)
print("result=" .. tostring(result))
print("seconds=" .. tostring(t1 - t0))
