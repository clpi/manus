
concept HasXY
  x: f64
  y: f64

pair: { x: f64, y: f64 }
vector: { x: f64, y: f64, z: f64 }
point: { x: f64, y: f64 }

type_sig: str = m
m.name .. ";"

NAMES = @comp.map("HasXY", type_sig)

expand: str = (frag: str)
  "/* each[" .. to(str)(frag.index) .. "/" .. to(str)(frag.count) .. "] = " .. frag.name .. " */\n"

expanded = @comp.each(NAMES, expand)

print("=== @comp.map output ===")
print(NAMES)
print("=== @comp.each re-expansion (composition) ===")
print(expanded)

LINES = @comp.str.countlines(expanded)
print("map→each fragments = " .. to(str)(LINES) .. "  (expect 3 = one per type)")

subset_sig: str = subset
subset.name .. ";"

SUBSETS = @comp.power("HasXY", subset_sig)

stamp: str = (frag: str)
  "/* pow[" .. to(str)(frag.index) .. "/" .. to(str)(frag.count) .. "] " .. frag.name .. " */\n"

POWER_EACH = @comp.each(SUBSETS, stamp)
POWER_LINES = @comp.str.countlines(POWER_EACH)
print("power→each fragments = " .. to(str)(POWER_LINES) .. "  (expect 7 = 2^3-1)")

ok = LINES == 3 and POWER_LINES == 7
print("=== RESULT ===")
print("compose_each_ok = " .. to(str)(ok))
