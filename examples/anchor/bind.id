
enum token__kind
  name
  number
  string
  symbol
  eof
token: { kind: token__kind, span: i64 }

enum mode
  fast
  slow

n = 0
k = token__kind.eof
if k == token__kind.eof
  n = n + 1
if k == token__kind.number
  n = n + 100
if k != token__kind.number
  n = n + 8
if k != token__kind.eof
  n = n + 400
if token__kind.symbol == token__kind.symbol
  n = n + 32
if token__kind.name == token__kind.symbol
  n = n + 700
m = mode.slow
if m == mode.slow
  n = n + 64
if m == mode.fast
  n = n + 200
print("{n}")
