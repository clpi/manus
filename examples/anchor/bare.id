# @corpus current
# it to a callable it retrieved from a table: `if r = read[b] return r(@)`.
#
# A slot body's anchor is its RECEIVER, which the slot parser already binds as
# the first parameter, so naming it is the entire lowering — no new node, and
# nothing downstream re-deriving a stance from a spelling. That claim is what
# the middle number tests: `@` and `self` are compared on the SAME data
# through the same free function, so they must land on one value.
#
# TWO RECEIVERS, NOT ONE, and that is the whole point. With a single box every
# degenerate reading agrees with the correct one — an anchor resolved to a
# constant, to the first receiver ever seen, or to the descriptor rather than
# the value all print the same number. Two boxes separate them:
#
#   5 9 5   `@` is THIS call's receiver
#   5 5 5   the anchor is fixed, or is the descriptor rather than a value
#
# The third number is the control: `self.n` read directly, so a run that
# printed 5 5 5 could not be blamed on the field access.
# expect: 5 9 5

box: {
    n: i64
    viaat = (): i64 size(@)
    direct = (): i64 self.n
}

size = (b: box): i64 b.n

small: box = { n = 5 }
large: box = { n = 9 }
one = small:viaat()
two = large:viaat()
plain = small:direct()
print("{one} {two} {plain}")
