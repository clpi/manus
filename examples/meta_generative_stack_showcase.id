
stamp: str = frag
"/* each[" .. to(str)(frag.index) .. "/" .. to(str)(frag.count) .. "] " .. frag.name .. " */\n"

TMPL_VARIANTS = "i64:int64_t|f64:double"
TMPL = @comp.template(TMPL_VARIANTS, "/* tmpl[$0:$1] */\n")
TMPL_EACH = @comp.each(TMPL, stamp)
TMPL_N = @comp.str.countlines(TMPL_EACH)
TMPL_SPEC_N = @comp.str.splitcount(TMPL_VARIANTS, "|")

GEN_SPEC = "ops: add|sub\ntypes: i64:int64_t|f64:double\ntemplate: /* gen[$0:$1] */\n"
GEN = @comp.generate(GEN_SPEC, "")
GEN_EACH = @comp.each(GEN, stamp)
GEN_N = @comp.str.countlines(GEN_EACH)

DECLS = "type Point { x: double, y: double } | fn add(a: Point, b: Point) -> Point"
SCHEME = @comp.scheme(DECLS, "/* scheme[$kind $name] */\n")
SCHEME_EACH = @comp.each(SCHEME, stamp)
SCHEME_N = @comp.str.countlines(SCHEME_EACH)

ok = TMPL_N == 2 and TMPL_SPEC_N == 2 and GEN_N == 4 and SCHEME_N == 2

print("=== generative stack (template / generate / scheme → each) ===")
print("template→each fragments = " .. to(str)(TMPL_N) .. "  (expect 2)")
print("generate→each fragments = " .. to(str)(GEN_N) .. "  (expect 4 = 2×2)")
print("scheme→each fragments   = " .. to(str)(SCHEME_N) .. "  (expect 2)")
print("RESULT generative_stack_ok = " .. to(str)(ok))
