# Break the linear codegen ceiling: one @comp.* line → O(types² × fields) output
# Run: duo run examples/meta_ceiling_breaker.id

concept HasXY
  x: f64
  y: f64

concept HasTag
  tag: str

point: { x: f64, y: f64, tag: str }
pair: { x: f64, y: f64, tag: str }
label: { tag: str }

# One @comp.ceiling line → O(types × fields) + O(types² × fields) C

@comp.define.derive("PairApi", generate: str = (meta)
    acc = "/* pair " .. meta.name .. " */\n"
    if meta.left != nil
        acc = acc .. "/* left=" .. meta.left.name .. " right=" .. meta.right.name .. " */\n"
    else
        for i = 1, meta.fields:len()
            f = meta.fields[i]
            acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    acc
)

__emit(@comp.ceiling("HasXY", PairApi, "HasTag"))

pair_sig: str = (a, b)
  a.name .. "x" .. b.name .. ";"

PAIRS = @comp.product("HasXY", "HasTag", pair_sig)
NAMES = @comp.type.names()

print("=== meta ceiling breaker ===")
print("pairs = " .. PAIRS)
print("all = " .. NAMES)
print("point ok = true")
print("ok")
