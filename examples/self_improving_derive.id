# A self-improving derive macro that reads its own source, registers a follow-up
# version of itself, and evaluates that version recursively at compile time.
# Each generation emits a C function with a unique name and return value.
# The recursion terminates once three generations have been generated.

@comp.define.derive("Evolving", generate: str = (meta)
    derives = @comp.derive.list()
    gen = 0
    for i = 1, derives:len()
        if derives[i]:sub(1, 8) == "Evolving"
            gen = gen + 1
    if gen > 3 return ""

    marker = gen - 1
    code = "int64_t duo_" .. meta.name .. "_evolve_marker_v" .. to(str)(marker) .. "(void) { return " .. to(str)(marker) .. "; }\n"
    next_name = "Evolving_" .. to(str)(gen + 1)
    @comp.register.derive(next_name, @comp.derive.lookup("Evolving"))
    rest = @comp.derive.eval(next_name, meta)
    return code .. rest
end)

@derive(Evolving)
Point: { x: i64, y: i64 }

v0: i64 = @c.call("duo_Point_evolve_marker_v0")
v1: i64 = @c.call("duo_Point_evolve_marker_v1")
v2: i64 = @c.call("duo_Point_evolve_marker_v2")
if v0 != 0 or v1 != 1 or v2 != 2
    error("self-improving derive did not generate all three generations")

print("Self-improving derive ok")
