-- Pass 16 Phase 1 — ByteCursor line/col semantics (inline; mirrors source_cursor.zig differential).

walk_to_line(bytes: str, stop_line: i64): i64
    pos = 1
    line = 1
    col = 1
    while pos <= string.len(bytes)
        if line == stop_line and col == 1
            return 0
        end
        ch = string.byte(bytes, pos)
        pos = pos + 1
        if ch == 10
            line = line + 1
            col = 1
        else
            col = col + 1
        end
    end
    1
end

fail = 0
if walk_to_line("a\nb\nc", 3) != 0
    fail = 1
end
if walk_to_line("fun\nend", 2) != 0
    fail = 1
end
if walk_to_line("x", 1) != 0
    fail = 1
end
if fail != 0
    std.os.exit(1)
end
print("pass16_source_cursor_proof: PASS")
