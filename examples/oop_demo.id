

Point2D: { x: f64, y: f64 }

Float: f64



point = {
    x = 3.0,
    y = 4.0,
    distance = (self): f64
        self.x * self.x + self.y * self.y:sqrt()
    ,
    move = (self, dx: f64, dy: f64): void
        self.x = self.x + dx
        self.y = self.y + dy
    end,
}

print("Point: (" .. to(str)(point.x) .. ", " .. to(str)(point.y) .. ")")
print("Distance: " .. to(str)(point.distance(point)))

point.move(point, 1.0, 2.0)
print("After move: (" .. to(str)(point.x) .. ", " .. to(str)(point.y) .. ")")
print("New distance: " .. to(str)(point.distance(point)))


Point_base = (x: f64, y: f64)
    {
        x = x,
        y = y,
        describe = (self): str
            "Point(" .. to(str)(self.x) .. ", " .. to(str)(self.y) .. ")"
        ,
    }

Point3D_base = (x: f64, y: f64, z: f64)
    base = Point_base(x, y)
    setmetatable(
        { z = z,
          describe = (self): str
            "Point3D(" .. to(str)(self.x) .. ", " .. to(str)(self.y)
                .. ", " .. to(str)(self.z) .. ")"
          ,
        },
        { __index = base }
    )

p1 = Point_base(1.0, 2.0)
print(p1.describe(p1))

p2 = Point3D_base(3.0, 4.0, 5.0)
print(p2.describe(p2))


Counter_new = ()
    {
        _value = 0,
        increment = (self): void self._value = self._value + 1 end,
        decrement = (self): void self._value = self._value - 1 end,
        value = (self): i64 self._value,
    }

counter = Counter_new()
counter.increment(counter)
counter.increment(counter)
counter.increment(counter)
print("Counter: " .. to(str)(counter.value(counter)))

counter.decrement(counter)
print("After decrement: " .. to(str)(counter.value(counter)))


concept Describable
    describe(self): str

concept Measurable
    measure(self, unit: str): f64

shape = {}
shape.describe = (self): str
    "Circle(radius=" .. to(str)(self.radius) .. ")"
shape.measure = (self, unit: str): f64
    area = 3.14159 * self.radius * self.radius
    if unit == "mm"
        area * 100.0
    else
        area
shape.radius = 5.0

print(shape.describe(shape))
print("Area (mm): " .. to(str)(shape.measure(shape, "mm")))


greet: str = (name: str = "World", greeting: str = "Hello")
    greeting .. ", " .. name .. "!"

power: f64 = (base: f64, exp: f64 = 2.0)
    if exp == 0 return 1.0
    result: f64 = base
    i: i64 = 1
    while i < exp:floor()
        result *= base
        i += 1
    result

print(greet())
print(greet("Duo"))
print(greet("Solo", "Hi"))
print("3^2 = " .. to(str)(power(3.0)))
print("2^10 = " .. to(str)(power(2.0, 10.0)))

print("\n=== OOP Demo Complete ===")
