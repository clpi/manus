-- Pass 9 — native decode path smoke (P9-06): i32.const 42 from bytes.

Decode = req "std.wasm.decode"

main(): i64
    data = string.char(0x41) .. string.char(0x2A)
    c = Decode.new_cursor(data)
    d = Decode.decode_i32_const(c)
    if d.status ~= "ok" return 1 end
    if d.imm ~= 42 return 2 end
    if Decode.semantic_table_owner() ~= "src/wasm_semantic.zig:mvp_opcode_index" return 3 end
    if Decode.cursor_substrate() ~= "decode-local-table" return 4 end
    0
end
