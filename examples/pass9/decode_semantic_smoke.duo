-- Pass 9 — semantic-id dispatch smoke (P9-M1).
-- Validates generated opcode_lookup + decode_instruction end-to-end.

Decode = req "std.wasm.decode"
Lookup = req "std.wasm.opcode_lookup"

main(): i64
    if Lookup.instruction_count() != 63 return 1 end
    if Lookup.opcode_for_index(44) != 79 return 5 end
    if Lookup.semantic_id_for_opcode(0x6A) != "wasm.i32.add" return 2 end
    if Lookup.stack_pop_for_index(45) != 2 return 3 end
    if Lookup.stack_push_for_index(45) != 1 return 4 end

    -- i32.const 42
    data = string.char(0x41) .. string.char(0x2A)
    c = Decode.new_cursor(data)
    d = Decode.decode_instruction(c)
    if d.status != "ok" return 10 end
    if d.id != "wasm.i32.const" return 11 end
    if d.immediate != 42 return 12 end
    if d.stack_pop != 0 or d.stack_push != 1 return 13 end

    -- i32.add (no immediate)
    c2 = Decode.new_cursor(string.char(0x6A))
    d2 = Decode.decode_instruction(c2)
    if d2.status != "ok" return 20 end
    if d2.id != "wasm.i32.add" return 21 end
    if d2.immediate_form != "none" return 22 end
    if d2.stack_pop != 2 or d2.stack_push != 1 return 23 end

    if Decode.lookup_table_owner() != "lib/std/wasm/opcode_lookup.duo" return 30 end
    0
end
