-- Pass 9 — LEB128 smoke (native scalar). Wasm headers contain NUL bytes — use
-- numeric LEB128 proof here; full cursor over binary blobs needs byte slice + len (P9-WS3).

decode_leb128_624485(): i64
    b0 = 0xE5
    b1 = 0x8E
    b2 = 0x26
    (b0 & 0x7F) | ((b1 & 0x7F) << 7) | ((b2 & 0x7F) << 14)
end

read_u32_le_bytes(b0: i64, b1: i64, b2: i64, b3: i64): i64
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
end

main(): i64
    -- Wasm magic/version as separate bytes (avoids embedded NUL in C strings).
    magic = read_u32_le_bytes(0x00, 0x61, 0x73, 0x6D)
    if magic != 0x6D736100 return 1001 end
    version = read_u32_le_bytes(0x01, 0x00, 0x00, 0x00)
    if version != 1 return 1002 end
    leb = decode_leb128_624485()
    if leb != 624485 return leb end
    0
end
