# Nested match → derive.power: comptime-only cascade on the O(2^n) derive axis.
# Run: duo run examples/meta_derive_power_cascade.id

concept HasXY
  x: f64
  y: f64

pair: { x: f64, y: f64 }
vector: { x: f64, y: f64, z: f64 }
point: { x: f64, y: f64 }

@comp.define.derive("SubsetStub", generate: str = (meta)
    "/* subset " .. meta.name .. " mask=" .. to(str)(meta.mask) .. " */\n"
)

FRAGS = @comp.match("HasXY|Ordered", fun(c)
  @comp.derive.power(c.pattern, SubsetStub)
)

LINES = @comp.str.countlines(FRAGS)
HAS_SUBSET = @comp.str.contains(FRAGS, "subset pair")

ok = LINES >= 7 and HAS_SUBSET
print("=== match → derive.power cascade ===")
print("fragment_lines = " .. to(str)(LINES) .. "  (expect >= 7 from HasXY power-set)")
print("RESULT derive_power_cascade_ok = " .. to(str)(ok))
