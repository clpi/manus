# An Idol program that emits real ARM64 machine code to a file.
#
# Writes `mov x0, #42; ret` as little-endian words and returns the byte count.
# Verify with:  xxd /tmp/idol_emit_probe.bin
#   4005 80d2  -> 0xd2800540  mov x0, #42
#   c003 5fd6  -> 0xd65f03c0  ret
#
# This source is retained as the byte oracle only. Direct lowering currently
# refuses its unresolved cross-home applications; it is not direct-native
# capability evidence until graph-owned targets and a current gate consume it.
main: i64 = ()
  E = emit
  E.emit_begin("/tmp/idol_emit_probe.bin")
  E.emit_u32("/tmp/idol_emit_probe.bin", 3531605312)
  E.emit_u32("/tmp/idol_emit_probe.bin", 3596551104)
  E.emit_size("/tmp/idol_emit_probe.bin")
