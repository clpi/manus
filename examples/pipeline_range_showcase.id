
@comp.pipeline({
    fn = "sum_range",
    source = "range",
    start = 1,
    stop = 101,
    elem = "int64_t",
    kind = "reduce",
    init = "0",
})

total: i64 = ()
    @comp.c.call("sum_range")

print("=== @comp.pipeline range showcase ===")
print("sum 1..100 = " .. to(str)(total()))
print("ok")
