# Exponential product: cartesian codegen + @comp.derive.all + module introspection
# Run: duo run examples/exponential_product_showcase.id

concept HasXY
  x: f64
  y: f64

concept HasId
  id: i64

Point: { x: f64, y: f64 }
Pair: { x: f64, y: f64 }

Entity: { id: i64, name: str }
Node: { id: i64, next: i64 }

@comp.define.derive("TouchApi", generate: str = (meta)
    acc = "/* " .. meta.name .. " */\n"
    for i = 1, meta.fields:len()
        f = meta.fields[i]
        acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    acc
end)


@comp.derive.all("HasXY", TouchApi)

pair_line: str = (a, b)
  a.name .. "x" .. b.name .. ";"

type_line: str = meta
meta.name .. ":"

PAIRS = @comp.product("HasXY", "HasId", pair_line)
FILTERED = @comp.map("HasXY+HasId", type_line)
TYPE_NAMES = @comp.type.names()

_meta =
  tag = "exponential_product"

print("=== exponential product showcase ===")
print("pairs = " .. PAIRS)
print("filtered = " .. FILTERED)
print("type_names = " .. TYPE_NAMES)
print("ok")
