# @corpus current
# A FIELD THAT IS WRITTEN IS NOT A CONSTANT, and the write is what a relation
# must read.
#
# `M.a` is bound to 1 by the literal and then assigned 2. `ModuleConsts` records
# the literal's 1 and would fold every read to it — measured: with the
# `keyed-table-export` precheck deleted and no storage behind the field, this
# program prints 1 and exits 0. Registering the field as storage is what removes
# it from the constant pool, so the read resolves through the word the second
# write left behind.
# expect: 2
M = { a = 1 }
M.a = 2

read: i64 = ()
  M.a

print(read())
