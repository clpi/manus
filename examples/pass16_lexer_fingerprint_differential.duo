-- Pass 16 MP4-B02 — Duo lexer vs production Zig lexer, token-kind differential.
--
-- The Duo-native tokenizer fingerprints the same corpus as
-- `src/lexer_differential.zig` using the same mix
-- (`h = h * 31 + kind` per source, `H = H * 131 + fh` across the corpus) and must
-- land on the identical value. That makes this a *differential* against the
-- production lexer, not a self-consistency check: the two implementations agree
-- token-for-token, including EOF, over every corpus entry.
--
-- `expected_fingerprint` in the Zig side is the u64 14826766157002701032; the
-- same bits read as i64 are -3619977916706850584.
--
-- Exit code is the failing check number; 0 means the tokenizers agree.

corpus_fingerprint(): i64
    h = 0
    h = h * 131 + std.compiler.lexer.duo_lexer_kind_fingerprint("fun add(a: i64): i64 = a + 1 end", "corpus.duo")
    h = h * 131 + std.compiler.lexer.duo_lexer_kind_fingerprint("42 + 1", "corpus.duo")
    h = h * 131 + std.compiler.lexer.duo_lexer_kind_fingerprint("x? y!", "corpus.duo")
    h = h * 131 + std.compiler.lexer.duo_lexer_kind_fingerprint("\"hi\" 'there'", "corpus.duo")
    h = h * 131 + std.compiler.lexer.duo_lexer_kind_fingerprint("-- line\nfun", "corpus.duo")
    -- Corpus data, not Duo source: this string must stay byte-identical to
    -- `lexer_differential.fingerprint_corpus`. `!=` is graveyarded as *syntax*
    -- (Pass 41 A5) but the lexer must still tokenize it, and that is exactly what
    -- this entry checks — do not "canonicalize" it to `!=`.
    h = h * 131 + std.compiler.lexer.duo_lexer_kind_fingerprint("a == b != c", "corpus.duo")
    h = h * 131 + std.compiler.lexer.duo_lexer_kind_fingerprint("...", "corpus.duo")
    h
end

-- Spot checks that fail loudly before the aggregate, so a mismatch says which
-- shape diverged rather than only that the corpus hash moved.
spot_checks(): i64
    -- "" is just EOF (kind 105): h = 0 * 31 + 105.
    if std.compiler.lexer.duo_lexer_kind_fingerprint("", "c.duo") != 105 return 1 end
    -- "fun" is kw_fun (14) then EOF (105): h = (0*31+14)*31 + 105 = 539.
    if std.compiler.lexer.duo_lexer_kind_fingerprint("fun", "c.duo") != 539 return 2 end
    0
end

main(): i64
    r = spot_checks()
    if r != 0 return r end
    if corpus_fingerprint() != -3619977916706850584 return 3 end
    0
end
