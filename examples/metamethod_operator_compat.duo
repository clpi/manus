concat_obj = setmetatable({}, {
  __concat = (a: any, b: any) -> str
    "concat"
  end
})
lt_obj = setmetatable({}, {
  __lt = (a: any, b: any) -> bool
    true
  end
})
le_obj = setmetatable({}, {
  __le = (a: any, b: any) -> bool
    true
  end
})
unm_obj = setmetatable({}, {
  __unm = (a: any) -> any
    "unm"
  end
})
idiv_obj = setmetatable({}, {
  __idiv = (a: any, b: any) -> any
    "idiv"
  end
})
band_obj = setmetatable({}, {
  __band = (a: any, b: any) -> any
    "band"
  end
})
bor_obj = setmetatable({}, {
  __bor = (a: any, b: any) -> any
    "bor"
  end
})
bxor_obj = setmetatable({}, {
  __bxor = (a: any, b: any) -> any
    "bxor"
  end
})
bnot_obj = setmetatable({}, {
  __bnot = (a: any) -> any
    "bnot"
  end
})
shl_obj = setmetatable({}, {
  __shl = (a: any, b: any) -> any
    "shl"
  end
})
shr_obj = setmetatable({}, {
  __shr = (a: any, b: any) -> any
    "shr"
  end
})
print(concat_obj .. "x")
print(to(str)(lt_obj < 1))
print(to(str)(le_obj <= 1))
print(-unm_obj)
print(idiv_obj // 1)
print(band_obj & 1)
print(bor_obj | 1)
print(bxor_obj ~ 1)
print(~bnot_obj)
print(shl_obj << 1)
print(shr_obj >> 1)
