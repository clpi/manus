# Self-extending derive: @comp.register.derive inside @comp.define.derive macro body
# Run: duo run examples/self_extending_derive.id

@comp.define.derive("Factory", generate: str = (meta)
  child = "fun generate(meta) -> str return \"static int \" .. meta.name .. \"_magic() { return 42; }\" end"
  @comp.register.derive(meta.name .. "Kind", child)
  ""
end)

@derive(Factory)
Point: { x: f64, y: f64 }

@derive(PointKind)
Box: { w: f64, h: f64 }

print("Self-extending derive compiled")
