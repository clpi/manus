# @comp.expand: one call → O(types × fields) derive C (+ optional sweep comment)
# Run: duo run examples/meta_expand_showcase.id

concept HasXY
  x: f64
  y: f64

Point: { x: f64, y: f64 }
Pair: { x: f64, y: f64 }

@comp.assert(@comp.satisfies(Point, "HasXY"))

@comp.define.derive("TouchApi", generate: str = (meta)
    acc = ""
    for i = 1, meta.fields:len()
        f = meta.fields[i]
        acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    acc
)

registry_line: str = meta
meta.name .. ";"

# Derive sweep only (2-arg form)
__emit(@comp.expand("HasXY", TouchApi))

# Registry sweep separately (comptime string, not C)
SWEEP = @comp.map("HasXY", registry_line)

print("=== meta.expand showcase ===")
print("Point ok = true")
print("sweep = " .. SWEEP)
print("ok")
