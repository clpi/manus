-- Multi-concept constraints: fun f<T: A + B>(x: T)

concept Hashable
    fun hash(self) -> i64
end

concept Counter
    fun value(self) -> i64
end

Both = {}
fun Both:hash() -> i64
    return 11
end
fun Both:value() -> i64
    return 3
end

Half = {}
fun Half:hash() -> i64
    return 7
end

fun use_both<T: Hashable + Counter>(target: T): i64
    target:hash() + target:value()
end

@static_assert(@satisfies(Both, "Hashable"), "Both is Hashable")
@static_assert(@satisfies(Both, "Counter"), "Both is Counter")

print("use_both(Both): " .. tostring(use_both(Both)))
