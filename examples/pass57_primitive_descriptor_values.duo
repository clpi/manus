-- Pass 57 / spec 2.10 G3 — a primitive type name is an ORDINARY VALUE.
--
-- Before this proof existed, `to(str)(x)` worked only because the call emitter
-- pattern-matched the AST shape and never evaluated `str`. The same name in
-- value position emitted a bare C identifier:
--
--     t = str            -->  error: use of undeclared identifier 'str'
--     print(str)         -->  error: use of undeclared identifier 'str'
--     str.from(42)       -->  error: use of undeclared identifier 'str'
--
-- That is the "third category" the de-magicking test forbids: a std name that
-- is neither an ordinary value nor a relation with inspectable edges. This file
-- pins both halves — descriptors as data, and the conversion edge having ONE
-- meaning under all four of its spellings.

fails = 0

check(label: str, got: str, want: str): void
    if got != want
        fails = fails + 1
        print("FAIL " .. label .. ": got " .. got .. ", want " .. want)
    end
end

main(): void
    -- 1. A descriptor is data: storable, printable, comparable.
    --    Its identity IS its canonical name, so equality needs no registry.
    check("descriptor is printable", to(str)(str), "str")
    held = i64
    check("descriptor is storable", to(str)(held), "i64")
    check("descriptor equality", to(str)(str == str), "true")
    check("descriptor distinctness", to(str)(str == i64), "false")

    -- 2. ONE conversion edge, four spellings (gate 6: `to(str)` and
    --    `str.from(T)` must share one edge id, and canonical Duo writes `.`).
    check("to(T)(v)", to(str)(42), "42")
    check("T.from(v)", str.from(42), "42")
    check("T.from(S)(v)", str.from(i64)(42), "42")
    check("reverse target", to(str)(i64.from("42")), "42")

    -- 3. The edge is total in its SOURCE, not just its target. A native C cast
    --    is only valid on a numeric source; applied to a `str` it used to cast
    --    the `const char*` and return a POINTER silently
    --    (`to(i64)("42")` -> 4338831547), and on an `any` it did not compile.
    check("str source", to(str)(to(i64)("42")), "42")
    check("float source truncates", to(str)(to(i64)(3.9)), "3")
    s = "42"
    check("str local source", to(str)(to(i64)(s)), "42")
    boxed: any = "42"
    check("any source", to(str)(to(i64)(boxed)), "42")
    boxed_num: any = 7
    check("any numeric source", to(str)(to(i64)(boxed_num)), "7")

    -- Exit STATUS, not just stdout: a harness that only diffs output will read
    -- a segfaulting or failing proof as passing. Verified by negative control
    -- (flip any `want` above and this exits 1).
    if fails == 0
        print("pass57_primitive_descriptor_values: PASS (13 checks)")
    else
        print("pass57_primitive_descriptor_values: FAIL")
        os.exit(1)
    end
end
