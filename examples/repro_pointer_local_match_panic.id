f: i64 = (n: i64)
  code = mem.alloc(64)
  mem.zero(code, 64)
  pc: i64 = 0
  acc: i64 = 0
  while pc < n
    op: i64 = mem.read_byte(code, pc)
    pc = pc + 1
    imm: i64 = 0
    sh: i64 = 0
    cont: i64 = 0
    if op == 0x41
      cont = 1
    while cont == 1
      b: i64 = mem.read_byte(code, pc)
      pc = pc + 1
      imm = imm | ((b & 0x7F) << sh)
      sh = sh + 7
      if b < 0x80
        cont = 0
    match op
    case 0x41
      acc = acc + imm
    case _
      acc = acc
  acc

main()
  print("acc=" .. to(str)(f(4)))

main()
