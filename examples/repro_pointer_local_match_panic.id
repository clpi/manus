# REPRO: duo compiler panic (not a miscompile — a hard crash).
#   thread panic: access of union field 'table_type' while field 'pointer' is active
#   src/codegen.zig:4616 ensure_record_decl  <- emit_stmt (codegen.zig:9360)
#
# Trigger: a `mem.alloc` pointer local in a function that also has a `while`
# loop and a `match` in the same body. Removing the mem.alloc, the inner
# while, or the match each make it compile.
#
# Repro: duo compile examples/repro_pointer_local_match_panic.id
f(n: i64): i64
  code = mem.alloc(64)
  mem.zero(code, 64)
  pc: i64 = 0
  acc: i64 = 0
  while pc < n
    op: i64 = mem.read_byte(code, pc)
    pc = pc + 1
    imm: i64 = 0
    sh: i64 = 0
    cont: i64 = 0
    if op == 0x41
      cont = 1
    end
    while cont == 1
      b: i64 = mem.read_byte(code, pc)
      pc = pc + 1
      imm = imm | ((b & 0x7F) << sh)
      sh = sh + 7
      if b < 0x80
        cont = 0
      end
    end
    match op
    case 0x41 do
      acc = acc + imm
    end
    case _ do
      acc = acc
    end
    end
  end
  acc
end

main()
  print("acc=" .. to(str)(f(4)))
end

main()
