# @comp.map: one concept + one fn → code for every matching type in the module
# Run: duo run examples/comptime_map_showcase.id

concept HasXY
  x: f64
  y: f64

point: { x: f64, y: f64 }
pair: { x: f64, y: f64 }
identity: { id: i64 }

@comp.assert(@comp.satisfies(point, "HasXY"), "point has x and y")
@comp.assert(not @comp.satisfies(identity, "HasXY"), "identity lacks x/y")

c_type_comment: str = meta
"/* " .. meta.name .. " */\n"

type_registry_line: str = meta
meta.name .. ";"

__emit(@comp.map("HasXY", c_type_comment))

TYPE_MARKS = @comp.map("HasXY", type_registry_line)

print("=== comptime_map showcase ===")
print("satisfies point = " .. to(str)(@comp.satisfies(point, "HasXY")))
print("type_marks = " .. TYPE_MARKS)
print("ok")
