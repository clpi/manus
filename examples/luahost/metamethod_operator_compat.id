local concat_obj = setmetatable({}, {
  __concat = (a: any, b: any)
    "concat"
  end
})

local lt_obj = setmetatable({}, {
  __lt = (a: any, b: any)
    true
  end
})

local le_obj = setmetatable({}, {
  __le = (a: any, b: any)
    true
  end
})

local unm_obj = setmetatable({}, {
  __unm = (a: any)
    "unm"
  end
})

local idiv_obj = setmetatable({}, {
  __idiv = (a: any, b: any)
    "idiv"
  end
})

local band_obj = setmetatable({}, {
  __band = (a: any, b: any)
    "band"
  end
})

local bor_obj = setmetatable({}, {
  __bor = (a: any, b: any)
    "bor"
  end
})

local bxor_obj = setmetatable({}, {
  __bxor = (a: any, b: any)
    "bxor"
  end
})

local bnot_obj = setmetatable({}, {
  __bnot = (a: any)
    "bnot"
  end
})

local shl_obj = setmetatable({}, {
  __shl = (a: any, b: any)
    "shl"
  end
})

local shr_obj = setmetatable({}, {
  __shr = (a: any, b: any)
    "shr"
  end
})

print(concat_obj .. "x")
print(tostring(lt_obj < 1))
print(tostring(le_obj <= 1))
print(-unm_obj)
print(idiv_obj // 1)
print(band_obj & 1)
print(bor_obj | 1)
print(bxor_obj ~ 1)
print(~bnot_obj)
print(shl_obj << 1)
print(shr_obj >> 1)
