local sub = setmetatable({}, {
  __sub: any = (a: any, b: any)
    "sub"
  end
})
sub = sub - 1

local mul = setmetatable({}, {
  __mul: any = (a: any, b: any)
    "mul"
  end
})
mul = mul * 1

local div = setmetatable({}, {
  __div: any = (a: any, b: any)
    "div"
  end
})
div = div / 1

local mod = setmetatable({}, {
  __mod: any = (a: any, b: any)
    "mod"
  end
})
mod = mod % 1

local pow = setmetatable({}, {
  __pow: any = (a: any, b: any)
    "pow"
  end
})
pow = pow ^ 1

print(sub)
print(mul)
print(div)
print(mod)
print(pow)
