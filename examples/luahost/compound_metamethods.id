sub = setmetatable({}, {
  __sub = fun(a: any, b: any) -> any
    "sub"
  end
})
sub = sub - 1

mul = setmetatable({}, {
  __mul = fun(a: any, b: any) -> any
    "mul"
  end
})
mul = mul * 1

div = setmetatable({}, {
  __div = fun(a: any, b: any) -> any
    "div"
  end
})
div = div / 1

mod = setmetatable({}, {
  __mod = fun(a: any, b: any) -> any
    "mod"
  end
})
mod = mod % 1

pow = setmetatable({}, {
  __pow = fun(a: any, b: any) -> any
    "pow"
  end
})
pow = pow ^ 1

print(sub)
print(mul)
print(div)
print(mod)
print(pow)
