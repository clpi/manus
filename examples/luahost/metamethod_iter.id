custom_iter: any = (state: any, index: any)
    local nxt = index + 1
    if nxt > 3
        return nil
    end
    return nxt, nxt * 10
end

local iterable = setmetatable({}, {
    __iter = fun(self: any): any
        return custom_iter, nil, 0
    end,
})

local sum = 0
for i, value in iterable
    sum += value
end

print(sum)
