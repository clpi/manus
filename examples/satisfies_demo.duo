-- @satisfies — compile-time concept membership for table modules and typed records

concept Hashable
    fun hash(self) -> i64
end

alias M = {}
fun M:hash() -> i64
    return 42
end

alias S = {}
fun S:hash() -> i64
    return 13
end

alias X = {}
fun X:nope() -> i64
    return 0
end

@static_assert(@satisfies(M, "Hashable"), "M is Hashable")
@static_assert(@satisfies(S, "Hashable"), "S is Hashable")
@static_assert(not @satisfies(X, "Hashable"), "X is not Hashable")

print("satisfies demo ok")
