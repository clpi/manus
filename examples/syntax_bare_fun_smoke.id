# Bare function syntax + if-expressions (GR-001, GR-002). Gate: agent-smoke.

add: i64 = (x: i64, y: i64)
  x + y

mul: i64 = (a: i64, b: i64)
  a * b

pick: i64 = (a: i64, b: i64, c: i64, value: i64)
  if a < b
    value
  else
    if b < c
      value * 2
    else
      value * 3

run_smoke: i64 = ()
  x = if 1 < 2 10 else if 2 < 3 20 else 30 end end
add(1, 2) + mul(3, 4) + pick(1, 2, 3, 5) + x

RESULT = run_smoke()
print("RESULT syntax_bare_fun = " .. to(str)(RESULT))
if RESULT != 30
  error("syntax bare fun smoke failed")
