-- Test metaprogramming support with @ compile-time evaluation

-- Basic compile-time constant evaluation
a = @(42)
print("a = @(42): " .. tostring(a))

b = @(10 + 20)
print("b = @(10 + 20): " .. tostring(b))

-- String constant
c = @("hello")
print("c = @(\"hello\"): " .. c)

-- Compile-time complex expression
d = @(2 * 3 + 4 * 5)
print("d = @(2*3+4*5): " .. tostring(d))
