
@hot
matmul_256: f64 = ()
  return ml.matmul_256()

@hot
conv2d: f64 = ()
  return ml.conv2d()

@hot
softmax_1k: f64 = ()
  return ml.softmax_1k()

@hot
attention: f64 = ()
  return ml.attention()

@hot
mlp_forward: f64 = ()
  return ml.mlp_forward()

_f6: str = (x: f64)
  neg = false
  v = x
  if v < 0.0
    neg = true
    v = -v
  n = to(i64)(v * 1000000.0 + 0.5)
  w = n / 1000000
  f = n % 1000000
  fs = to(str)(f)
  while fs:len() < 6
    fs = "0" .. fs
  s = to(str)(w) .. "." .. fs
  if neg
    return "-" .. s
  s

_report = (name: str, elapsed: f64, value: f64)
  print("Time: " .. _f6(elapsed) .. " seconds")
  print("RESULT " .. name .. " " .. _f6(value))
  print("----------------------------------------")

print("========================================")
print("       ML BENCHMARK SUITE (Duo)         ")
print("========================================")

print("Running matmul_256...")
t0a: f64 = os.clock()
r1: f64 = matmul_256()
t1a: f64 = os.clock()
_report("matmul_256", t1a - t0a, r1)

print("Running conv2d...")
t0b: f64 = os.clock()
r2: f64 = conv2d()
t1b: f64 = os.clock()
_report("conv2d", t1b - t0b, r2)

print("Running softmax_1k...")
t0c: f64 = os.clock()
r3: f64 = softmax_1k()
t1c: f64 = os.clock()
_report("softmax_1k", t1c - t0c, r3)

print("Running attention...")
t0d: f64 = os.clock()
r4: f64 = attention()
t1d: f64 = os.clock()
_report("attention", t1d - t0d, r4)

print("Running mlp_forward...")
t0e: f64 = os.clock()
r5: f64 = mlp_forward()
t1e: f64 = os.clock()
_report("mlp_forward", t1e - t0e, r5)

print("========================================")
print("       ML BENCHMARK SUITE COMPLETE       ")
print("========================================")
