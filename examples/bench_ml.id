# ML Benchmark Suite for Duo
# Native kernels via ml.* — one call per workload, zero @c.emit boilerplate.

@hot
matmul_256(): f64
    return ml.matmul_256()
end

@hot
conv2d(): f64
    return ml.conv2d()
end

@hot
softmax_1k(): f64
    return ml.softmax_1k()
end

@hot
attention(): f64
    return ml.attention()
end

@hot
mlp_forward(): f64
    return ml.mlp_forward()
end

# Six decimals, assembled from integer millionths.
#
# This replaces ten `@c.emit("printf(...%.6f...)")` calls, which existed only
# because `to(str)` on an f64 does not compile and printing a float raw gives
# full binary precision. They were also BROKEN: a file-scope `@c.emit` is
# emitted at C *file* scope rather than inside `main`, so the generated C
# carried bare `printf(...)` statements at top level and clang rejected the
# whole program ("expected parameter declarator", "conflicting types for
# printf"). This benchmark had not compiled for some time, which in turn made
# scripts/run_compile_size_benchmark.sh crash and left it unportable.
#
# Doing it in Duo fixes the bug and removes foreign code from a .id file at
# the same time. The output format is unchanged, so the harnesses that scrape
# "Time: <n> seconds" and "RESULT <name> <n>" still read it.
_f6(x: f64): str
    neg = false
    v = x
    if v < 0.0
        neg = true
        v = -v
    end
    n = to(i64)(v * 1000000.0 + 0.5)
    w = n / 1000000
    f = n % 1000000
    fs = to(str)(f)
    while #fs < 6
        fs = "0" .. fs
    end
    s = to(str)(w) .. "." .. fs
    if neg return "-" .. s end
    s
end

_report(name: str, elapsed: f64, value: f64): void
    print("Time: " .. _f6(elapsed) .. " seconds")
    print("RESULT " .. name .. " " .. _f6(value))
    print("----------------------------------------")
end

print("========================================")
print("       ML BENCHMARK SUITE (Duo)         ")
print("========================================")

print("Running matmul_256...")
t0a: f64 = os.clock()
r1: f64 = matmul_256()
t1a: f64 = os.clock()
_report("matmul_256", t1a - t0a, r1)

print("Running conv2d...")
t0b: f64 = os.clock()
r2: f64 = conv2d()
t1b: f64 = os.clock()
_report("conv2d", t1b - t0b, r2)

print("Running softmax_1k...")
t0c: f64 = os.clock()
r3: f64 = softmax_1k()
t1c: f64 = os.clock()
_report("softmax_1k", t1c - t0c, r3)

print("Running attention...")
t0d: f64 = os.clock()
r4: f64 = attention()
t1d: f64 = os.clock()
_report("attention", t1d - t0d, r4)

print("Running mlp_forward...")
t0e: f64 = os.clock()
r5: f64 = mlp_forward()
t1e: f64 = os.clock()
_report("mlp_forward", t1e - t0e, r5)

print("========================================")
print("       ML BENCHMARK SUITE COMPLETE       ")
print("========================================")
