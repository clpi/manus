
add: i64 = (x: i64, y: i64)
  return x + y

Point: { x: f64, y: f64 }

distance: f64 = (a: Point, b: Point)
  dx = a.x - b.x
  dy = a.y - b.y
  return dx * dx + dy * dy:sqrt()


p: Point = { x = 3.0, y = 4.0 }
print("RESULT distance " .. to(str)(distance(p, { x = 0.0, y = 0.0 })))
print("RESULT add " .. to(str)(add(20, 22)))
