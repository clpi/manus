-- Stdlib req at comptime: @comp.map with std.meta.codegen callbacks
-- Run: duo run examples/stdlib_comptime_showcase.duo

meta = req "std.meta.codegen"

concept HasXY
    x: f64
    y: f64
end

Point: { x: f64, y: f64 }
Pair: { x: f64, y: f64 }

TYPED = @comp.map("HasXY", meta.type_registry_line)
COMMENTS = @comp.map("HasXY", meta.c_type_comment)

print("=== stdlib comptime showcase ===")
print("typed = " .. TYPED)
print("comments_len = " .. to(str)(#COMMENTS))
print("ok")
