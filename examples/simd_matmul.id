print("=== SIMD matmul demo ===")

a: v4f64 = simd.v4f64(1.0, 2.0, 3.0, 4.0)
b: v4f64 = simd.v4f64(0.5, 0.5, 0.5, 0.5)
c: v4f64 = simd.fma(a, b, simd.v4f64(0.0, 0.0, 0.0, 0.0))
assert(c[0] == 0.5, "fma lane 0")
assert(c[3] == 2.0, "fma lane 3")

mask: v4i64 = simd.le(c, simd.v4f64(1.0, 1.0, 1.0, 2.0))
assert(simd.any(mask) == true, "simd.any")
assert(simd.all(mask) == false, "simd.all partial")

checksum: f64 = ml.matmul_256()
print("ml.matmul_256 checksum:", checksum)
assert(checksum > 0.0, "matmul checksum positive")

dot_sum: f64 = ml.dot_1m()
print("ml.dot_1m checksum:", dot_sum)
assert(dot_sum > 0.0, "dot checksum positive")

print("SIMD matmul demo OK")
