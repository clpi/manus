# Higher-order derive macros: introspect the derive registry at compile time.
# Demonstrates @comp.derive.list, @comp.derive.lookup, and @comp.derive.eval.

# Compose all other user-defined derives via @comp.derive.list / @comp.derive.eval.

@comp.define.derive("TraceFields", generate: str = (meta)
  acc = "/* TraceFields for " .. meta.name .. " */\n"
  for i = 1, meta.fields:len()
    f = meta.fields[i]
    acc = acc .. "// field " .. f.name .. " : " .. f.type .. "\n"
  acc
)


@comp.define.derive("Offsets", generate: str = (meta)
  acc = "/* Offsets for " .. meta.name .. " */\n"
  for i = 1, meta.fields:len()
    f = meta.fields[i]
    acc = acc .. "// offset of " .. f.name .. " = " .. to(str)(i - 1) .. "\n"
  acc
)


@comp.define.derive("ComposeAll", generate: str = (meta)
  derives = @comp.derive.list()
  acc = "/* ComposeAll output for " .. meta.name .. " */\n"
  for i = 1, derives:len()
    dname = derives[i]
    if dname != "ComposeAll"
      acc = acc .. "/* === from " .. dname .. " === */\n"
      acc = acc .. @comp.derive.eval(dname, meta)
  self_src = @comp.derive.lookup("ComposeAll")
  acc = acc .. "// ComposeAll source length: " .. to(str)(self_src:len()) .. "\n"
  acc
)

@derive(ComposeAll)
Point: { x: f64, y: f64 }

print("Higher-order derive composed")
