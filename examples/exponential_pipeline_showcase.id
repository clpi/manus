
concept HasN
    n: i64

counter: { n: i64 }
tally: { n: i64, tag: str }

@comp.define.derive("CountApi", generate: str = (meta)
    "static inline int64_t duo_" .. meta.name .. "_get_n(const duo_" .. meta.name .. "* v) { return v->n; }\n"
)

@comp.pipeline({
    fn = "sum_n",
    source = "range",
    start = 1,
    stop = 101,
    elem = "int64_t",
    kind = "reduce",
    init = "0",
})

registry_line: str = (meta)
    meta.name .. ";"

@comp.c.emit(@comp.derive("HasN", CountApi))

typed = @comp.map("HasN", registry_line)
derived = @comp.derive("HasN", CountApi)

total: i64 = ()
    @comp.c.call("sum_n")

print("=== exponential pipeline showcase ===")
print("sum 1..100 = " .. to(str)(total()))
print("typed_sweep = " .. typed)
print("derive_bytes = " .. to(str)(derived:len()))
print("ok")
