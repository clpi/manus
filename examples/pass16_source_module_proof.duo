-- Pass 16 Phase 1 — req'd source module cursor walk (record-by-ref codegen).
-- Parity: src/source_cursor.zig differentialProductionParity / walkReference.
walk_reference(): i64
    c = std.compiler.source.cursornew("a\nb\nc", "test.duo")
    if std.compiler.source.cursorpeek(c) != 97
        return 1
    end
    ch = std.compiler.source.cursoradvance(c)
    if ch != 97
        return 2
    end
    while not std.compiler.source.cursoreof(c)
        std.compiler.source.cursoradvance(c)
        loc = std.compiler.source.cursorloc(c)
        if loc.line == 3 and loc.col == 1
            break
        end
    end
    loc = std.compiler.source.cursorloc(c)
    if loc.line != 3
        return 3
    end
    if loc.col != 1
        return 4
    end
    print("pass16_source_module_proof: PASS " .. std.compiler.source.formatloc(loc))
    0
end

code = walk_reference()
if code != 0
    std.os.exit(code)
end
