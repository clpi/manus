-- Pass 16 Phase 1 — req'd source module cursor walk (record-by-ref codegen).
-- Parity: src/source_cursor.zig differentialProductionParity / walkReference.
walk_reference(): i64
    c = std.compiler.source.cursor_new("a\nb\nc", "test.duo")
    if std.compiler.source.cursor_peek(c) != 97
        return 1
    end
    ch = std.compiler.source.cursor_advance(c)
    if ch != 97
        return 2
    end
    while not std.compiler.source.cursor_eof(c)
        std.compiler.source.cursor_advance(c)
        loc = std.compiler.source.cursor_loc(c)
        if loc.line == 3 and loc.col == 1
            break
        end
    end
    loc = std.compiler.source.cursor_loc(c)
    if loc.line != 3
        return 3
    end
    if loc.col != 1
        return 4
    end
    print("pass16_source_module_proof: PASS " .. std.compiler.source.format_loc(loc))
    0
end

code = walk_reference()
if code != 0
    std.os.exit(code)
end
