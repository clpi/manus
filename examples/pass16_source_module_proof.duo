-- Historical source-module cursor walk. The default backend checks C-backed
-- behavior only; direct execution currently refuses at cursornew (GAP-127).
walk: i64 = ()
    c = std.compiler.source.cursornew("a\nb\nc", "test.duo")
    if std.compiler.source.cursorpeek(c) != 97
        return 1
    end
    ch = std.compiler.source.cursoradvance(c)
    if ch != 97
        return 2
    end
    while not std.compiler.source.cursoreof(c)
        std.compiler.source.cursoradvance(c)
        loc = std.compiler.source.cursorloc(c)
        if loc.line == 3 and loc.col == 1
            break
        end
    end
    loc = std.compiler.source.cursorloc(c)
    if loc.line != 3
        return 3
    end
    if loc.col != 1
        return 4
    end
    print("source module: C-backed behavior only; direct frontier is cursornew {std.compiler.source.formatloc(loc)}")
    0
end

main: i64 = ()
    walk()
