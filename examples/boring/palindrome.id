-- Palindrome over bytes. A palindrome and a near miss, so a checker that
-- compares nothing cannot pass both.
-- expect: 1 0
check = (s: str): i64
    i = 0
    j = #s - 1
    while i < j
        a = s[i]
        b = s[j]
        if a != b
            return 0
        end
        i = i + 1
        j = j - 1
    end
    1
end

main = (): i64
    a = check("racecar")
    b = check("racecars")
    print("{a} {b}")
    0
end
