-- Sieve of Eratosthenes below 30. Two values: the count and the last prime,
-- because a sieve that marks nothing still counts something.
-- expect: 10 29
main = (): i64
    limit = 30
    flag = { }
    for i = 1, limit
        flag:push(true)
    end
    for i = 2, limit
        if flag[i]
            j = i + i
            while j <= limit
                flag[j] = false
                j = j + i
            end
        end
    end
    count = 0
    last = 0
    for i = 2, limit
        if flag[i]
            count = count + 1
            last = i
        end
    end
    print("{count} {last}")
    0
end
