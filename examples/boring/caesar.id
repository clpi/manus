# Caesar cipher, shift 3, lowercase only. Encode then decode: the round trip
# must return the original, which a shift of zero would also do, so the
# ciphertext is asserted too.
# expect: kdo hal
shift: str = (s: str, by: i64)
    out = ""
    i = 0
    n = s:len()
    while i < n
        b = s[i]
        c = b
        if b >= 97 and b <= 122
            c = 97 + (b - 97 + by) % 26
        end
        piece = str{ c }
        out = "{out}{piece}"
        i = i + 1
    end
    out
end

main: i64 = ()
    a = shift("hal", 3)
    b = shift(a, 23)
    print("{a} {b}")
    0
end
