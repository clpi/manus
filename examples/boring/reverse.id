# String reversal, byte by byte. §0.8 builds a string from bytes with the
# str descriptor rather than a char function.
# expect: olleh
main: i64 = ()
    s = "hello"
    out = ""
    i = #s - 1
    while i >= 0
        # §0.8 writes this `str{ b }`. Rung (a) of the constructor ladder does
        # not lower — `call to undeclared function 'str'`, gap[088] — so the
        # canonical spelling cannot be used here yet. A one-byte slice is the
        # form that builds and it reads the same byte.
        piece = s:sub(i + 1, i + 1)
        out = "{out}{piece}"
        i = i - 1
    end
    print("{out}")
    0
end
