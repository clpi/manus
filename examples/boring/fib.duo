-- Fibonacci both ways. The recursive and iterative answers must AGREE, so a
-- broken accumulator cannot pass by matching a frozen literal.
-- expect: 6765 6765
fib = (n: i64): i64
    if n < 2
        return n
    end
    fib(n - 1) + fib(n - 2)
end

loop = (n: i64): i64
    a = 0
    b = 1
    for i = 1, n
        c = a + b
        a = b
        b = c
    end
    a
end

main = (): i64
    r = fib(20)
    l = loop(20)
    print("{r} {l}")
    0
end
