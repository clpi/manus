-- Celsius to Fahrenheit and back. The float path, so the rendering of the
-- result is part of the assertion.
-- expect: 98.6 37.0 -40.0
far = (c: f64): f64
    c * 9.0 / 5.0 + 32.0
end

cel = (f: f64): f64
    (f - 32.0) * 5.0 / 9.0
end

main = (): i64
    a = far(37.0)
    b = cel(98.6)
    c = far(-40.0)
    print("{a} {b} {c}")
    0
end
