src = "{\"a\": {\"b\": 7}}"
depth = 0
deepest = 0
i = 0
n = src:len()
while i < n
  b = src(i)
  if b == 123
    depth = depth + 1
  if b == 125
    depth = depth - 1
  if depth > deepest
    deepest = depth
  i = i + 1
value = 0
i = 0
while i < n
  b = src(i)
  if b >= 48 and b <= 57
    value = value * 10 + b - 48
  i = i + 1
print("{deepest} {value}")
