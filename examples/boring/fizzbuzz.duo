-- FizzBuzz, 1..15. §0.7: every hole is interpolation, never `..` beside a
-- literal. The value is the whole line, so a wrong branch cannot hide.
-- expect: 1 2 fizz 4 buzz fizz 7 8 fizz buzz 11 fizz 13 14 fizzbuzz
main = (): i64
    out = ""
    for i = 1, 15
        word = "{i}"
        if i % 15 == 0
            word = "fizzbuzz"
        end
        if i % 15 != 0 and i % 3 == 0
            word = "fizz"
        end
        if i % 15 != 0 and i % 5 == 0
            word = "buzz"
        end
        if out == ""
            out = word
        end
        if out != word
            out = "{out} {word}"
        end
    end
    print("{out}")
    0
end
