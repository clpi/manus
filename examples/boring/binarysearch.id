find: i64 = (xs, n: i64, key: i64)
  lo = 1
  hi = n
  while lo <= hi
    mid = lo + (hi - lo) / 2
    v = xs[mid]
    if v == key
      return mid
    if v < key
      lo = mid + 1
    if v >= key
      hi = mid - 1
  0

main: i64 = ()
  xs = { 2, 4, 6, 8, 10, 12, 14 }
  a = find(xs, 7, 10)
  b = find(xs, 7, 11)
  c = find(xs, 7, 2)
  print("{a} {b} {c}")
  0
