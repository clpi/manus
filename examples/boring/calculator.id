# A tiny calculator: single-digit terms with + and *, precedence by two
# loops. Asserts a sum, a product and a mixed expression, so a parser that
# ignores precedence cannot pass the third.
# expect: 5 12 14
# @corpus current
eval: i64 = (src: str)
    total = 0
    term = 1
    op = 43
    i = 0
    n = src:len()
    while i < n
        b = src[i]
        if b >= 48 and b <= 57
            d = b - 48
            if op == 43
                term = d
            if op == 42
                term = term * d
        if b == 43
            total += term
            op = 43
        if b == 42
            op = 42
        i += 1
    total + term

a = eval("2+3")
b = eval("3*4")
c = eval("2+3*4")
print("{a} {b} {c}")
