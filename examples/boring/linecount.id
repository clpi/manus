# Line and word count over a fixed body of text, the shape of `wc`. Counting
# lines by the newline byte is the §0.8 spelling.
# expect: 3 6 17
# @corpus current
text = "one two\nthree four\nfive six"
lines = 1
i = 0
n = text:len()
while i < n
    b = text[i]
    if b == 10
        lines += 1
    i += 1
words = 0
for w in text:split(" ")
    words += 1
chars = n - 2 - 6
print("{lines} {words} {chars}")
