-- A tiny calculator: single-digit terms with + and *, precedence by two
-- loops. Asserts a sum, a product and a mixed expression, so a parser that
-- ignores precedence cannot pass the third.
-- expect: 5 12 14
eval = (src: str): i64
    total = 0
    term = 1
    op = 43
    i = 0
    n = #src
    while i < n
        b = src[i]
        if b >= 48 and b <= 57
            d = b - 48
            if op == 43
                term = d
            end
            if op == 42
                term = term * d
            end
        end
        if b == 43
            total = total + term
            op = 43
        end
        if b == 42
            op = 42
        end
        i = i + 1
    end
    total + term
end

main = (): i64
    a = eval("2+3")
    b = eval("3*4")
    c = eval("2+3*4")
    print("{a} {b} {c}")
    0
end
