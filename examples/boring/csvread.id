# A CSV reader over three fixed rows. Asserts a field from the middle row and
# the row count, because a splitter that drops its last field still counts.
# expect: 3 bob 30
# @corpus current
rows = { "name,age", "bob,30", "eve,41" }
count = 0
who = ""
age = ""
for row in rows
  count = count + 1
  cells = row:split(",")
  if count == 2
    who = cells(1)
    age = cells(2)
print("{count} {who} {age}")
