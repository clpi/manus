
point: { x: f64, y: f64 }

@sealed
box: { label: str, count: i64 }

enum Color
  Red
  Green
  Blue

main = ()
  p: point =
    x = 3.0
    y = 4.0
  pt2: { x: f64, y: f64 } =
    x = 1.0
    y = 2.0
  b: box =
    label = "ok"
    count = 1

  point_shape = @comp.type.shape(p)
  inline_shape = @comp.type.shape(pt2)
  box_shape = @comp.type.shape(b)
  point_why = @comp.why.shape(p)
  box_why = @comp.why(b)
  point_origin = @comp.origin(p)

  print("point_shape=", point_shape, " inline_shape=", inline_shape, " box_shape=", box_shape, "\n")
  print("point_why=", point_why, "\n")
  print("box_why=", box_why, "\n")
  print("point_origin=", point_origin, "\n")
  print("p.x=", p.x, " pt2.x=", pt2.x, "\n")

  red = Color.Red
  print("color=", red, "\n")

  ok = point_shape == "native" and inline_shape == "native" and box_shape == "sealed" and p.x == 3.0
  ok = ok and point_why:find("native C scalars") != nil and box_why:find("@sealed") != nil
  ok = ok and point_origin:find("shape_id=") != nil and red == 0
  print("ok=", ok, "\n")
