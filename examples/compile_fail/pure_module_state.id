# @corpus proof
# DENIED TEXT IS THE ASSERTION. `@pure` reading mutable module state.
#
# Measured 2026-08-09, BEFORE this was rejected, by running it:
#
#     a = peek(1)   # 8
#     seed = 100
#     b = peek(1)   # 8, and the right answer is 101
#
# `@pure` lowers to `__attribute__((const))`, which promises the C compiler the
# body reads nothing but its arguments. Nothing checked the promise, so the
# compiler cashed it and reused the first call's result. This is not a
# decorative contract — an unchecked `@pure` is a wrong-answer generator, and
# that is why it is diagnosed alongside `@noalloc`.
#
# Its twin is examples/pass7/pure_ok.id. The pair is the assertion: the
# diagnostic must fire here and must NOT fire there.
seed: i64 = 7

@pure
peek(x: i64): i64
    seed + x
end

main(): i64
    a = peek(1)
    seed = 100
    b = peek(1)
    a + b
end
