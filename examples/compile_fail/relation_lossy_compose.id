
stretch = (v: i64): i64
    v * 25400

shrink = (v: i64): i64
    v // 25400

swell = (v: i64): i64
    v * 1000

shrivel = (v: i64): i64
    v // 1000

to(micron)(inch) = stretch@exact
to(inch)(micron) = shrink@narrowing
to(micron)(milli) = swell@exact
to(milli)(micron) = shrivel@narrowing

main = (): i64
    bore: i64 = milli.from(inch)(5)
    print("{bore}")
    0
