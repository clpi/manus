# Comprehensive stdlib test — tests all new and existing functions

str_mod = string
num = math
tbl = table

test.start("stdlib comprehensive test")
pass = 0
fail = 0

check = (desc, cond)
    if cond
        pass += 1
    else
        fail += 1
        io.write("  FAIL: " .. desc .. "\n")

# ── string ──────────────────────────────────────────────────────────

io.write("\n--- std.string ---\n")

check("trim_prefix", str_mod.trim_prefix("hello world", "hello ") == "world")
check("trim_prefix no match", str_mod.trim_prefix("hello", "xyz") == "hello")
check("trim_suffix", str_mod.trim_suffix("file.txt", ".txt") == "file")
check("trim_suffix no match", str_mod.trim_suffix("hello", ".txt") == "hello")
check("is_alpha", str_mod.is_alpha("abcXYZ"))
check("is_alpha digits", not str_mod.is_alpha("abc123"))
check("is_digit", str_mod.is_digit("12345"))
check("is_digit alpha", not str_mod.is_digit("12ab"))
check("is_alphanumeric", str_mod.is_alphanumeric("abc123"))
check("is_alphanumeric special", not str_mod.is_alphanumeric("abc 123"))
check("split_n", str_mod.split_n("a,b,c,d", ",", 2):len() == 2)
check("split_n values", str_mod.split_n("a,b,c,d", ",", 2)[1] == "a")
check("to_title_case", str_mod.to_title_case("hello world") == "Hello World")
check("to_title_case dashes", str_mod.to_title_case("hello-world") == "Hello-World")
check("repeat", str_mod.repeat("ab", 3) == "ababab")
check("replace first", str_mod.replace("a-b-c", "-", ":", 1) == "a:b-c")
check("replace all via replace_all", str_mod.replace_all("a-b-c", "-", ":") == "a:b:c")

# ── table ───────────────────────────────────────────────────────────

io.write("\n--- std.table ---\n")

check("flat", tbl.flat({{1, 2}, {3, {4}}}):len() == 4)
check("flat values", tbl.flat({{1, 2}, {3}})[2] == 2)
check("unique", tbl.unique({1, 2, 2, 3, 3}):len() == 3)
check("unique order", tbl.unique({3, 1, 3, 2})[1] == 3)
check("zip", tbl.zip({{1, 2}, {3, 4}}):len() == 2)
check("zip pairs", tbl.zip({{1, 2}, {3, 4}})[1][2] == 3)
check("from_pairs", tbl.from_pairs({{"a", 1}, {"b", 2}})["b"] == 2)
check("to_pairs", tbl.to_pairs({a = 1, b = 2}):len() == 2)
check("pick", tbl.pick({a = 1, b = 2, c = 3}, {"a", "c"})["a"] == 1)
check("pick omit", tbl.pick({a = 1, b = 2, c = 3}, {"a", "c"})["b"] == nil)
check("omit", tbl.omit({a = 1, b = 2, c = 3}, {"b"})["a"] == 1)
check("omit removed", tbl.omit({a = 1, b = 2, c = 3}, {"b"})["b"] == nil)
check("find", tbl.find({1, 2, 3, 4}, (v) v > 2) == 3)
check("every true", tbl.every({2, 4, 6}, (v) v % 2 == 0))
check("every false", not tbl.every({2, 3, 6}, (v) v % 2 == 0))
check("some true", tbl.some({1, 3, 4}, (v) v % 2 == 0))
check("some false", not tbl.some({1, 3, 5}, (v) v % 2 == 0))

# ── math ────────────────────────────────────────────────────────────

io.write("\n--- std.math ---\n")

check("median odd", num.median({3, 1, 2}) == 2)
check("median even", num.median({1, 2, 3, 4}) == 2.5)
check("variance", num.approx_eq(num.variance({2, 4, 4, 4, 5, 5, 7, 9}), 4.0))
check("std_dev", num.approx_eq(num.std_dev({2, 4, 4, 4, 5, 5, 7, 9}), 2.0))
check("smoothstep", num.approx_eq(num.smoothstep(0, 1, 0.5), 0.5))
check("smoothstep 0", num.approx_eq(num.smoothstep(0, 1, -1), 0))
check("smoothstep 1", num.approx_eq(num.smoothstep(0, 1, 2), 1))
check("approx_eq", num.approx_eq(1.0, 1.0000000001))
check("approx_eq diff", not num.approx_eq(1.0, 2.0))
check("min_of", num.min_of({5, 3, 8, 1, 9}) == 1)
check("max_of", num.max_of({5, 3, 8, 1, 9}) == 9)

# ── crypto ──────────────────────────────────────────────────────────

io.write("\n--- std.crypto ---\n")

check("hex_encode", crypto.hex_encode("Hi") == "4869")
check("hex_decode", crypto.hex_decode("4869") == "Hi")
check("hex_roundtrip", crypto.hex_decode(crypto.hex_encode("test")) == "test")
check("base64 roundtrip", crypto.base64_decode(crypto.base64_encode("hello world")) == "hello world")
check("base64_url encode", crypto:len().base64_url_encode("test?data&more") > 0)
check("base64_url roundtrip", crypto.base64_url_decode(crypto.base64_url_encode("binary+data/here")) == "binary+data/here")
check("compare_digest same", crypto.compare_digest("abc", "abc"))
check("compare_digest diff", not crypto.compare_digest("abc", "abd"))
check("compare_digest length", not crypto.compare_digest("abc", "abcd"))
check("hmac_sha256", crypto:len().hmac_sha256("key", "message") == 64)
check("secure_random_hex", crypto:len().secure_random_hex(16) == 32)

# ── fmt ─────────────────────────────────────────────────────────────

io.write("\n--- std.fmt ---\n")

check("bytes B", fmt.bytes(512) == "512 B")
check("bytes KB", fmt.bytes(2048) == "2.0 KB")
check("bytes MB", fmt.bytes(1048576 * 5) == "5.0 MB")
check("bytes GB", fmt.bytes(1073741824) == "1.00 GB")
check("join", fmt.join({1, 2, 3}, ", ") == "1, 2, 3")
check("join default", fmt.join({"a", "b"}) == "a, b")
check("repr string", fmt.repr("hello") == "\"hello\"")
check("repr number", fmt.repr(42) == "42")
check("repr nil", fmt.repr(nil) == "nil")
check("repr bool", fmt.repr(true) == "true")

# ── log ─────────────────────────────────────────────────────────────

io.write("\n--- std.log ---\n")

log.set_level("ERROR")
check("log set_level", log.get_level() == "ERROR")
log.set_level("DEBUG")
check("log reset", log.get_level() == "DEBUG")
log.with_fields("INFO", {user = "test", id = 42}, "action performed")
check("log with_fields", true)

# ── zip ─────────────────────────────────────────────────────────────

io.write("\n--- std.zip ---\n")

check("zip module loaded", zip != nil)
check("zip.test exists", type(zip.test) == "function")
check("zip.list exists", type(zip.list) == "function")
check("zip.info exists", type(zip.info) == "function")
check("zip.info nil", zip.info("/nonexistent.zip") == nil)

# ── iter ────────────────────────────────────────────────────────────

io.write("\n--- std.iter ---\n")

check("iter enumerate", iter.enumerate({10, 20, 30}):len() == 3)
check("iter enumerate idx", iter.enumerate({10, 20, 30})[2][1] == 2)
check("iter enumerate val", iter.enumerate({10, 20, 30})[2][2] == 20)
check("iter zip", iter.zip({1, 2, 3}, {4, 5, 6}):len() == 3)
check("iter zip pair", iter.zip({1, 2}, {3, 4})[1][2] == 3)
check("iter take", iter.take({1, 2, 3, 4, 5}, 3):len() == 3)
check("iter take values", iter.take({10, 20, 30}, 2)[2] == 20)
check("iter drop", iter.drop({1, 2, 3, 4, 5}, 2):len() == 3)
check("iter drop values", iter.drop({10, 20, 30, 40}, 2)[1] == 30)
check("iter sliding_window", iter.sliding_window({1, 2, 3, 4}, 2):len() == 3)
check("iter sliding_window values", iter.sliding_window({1, 2, 3, 4}, 2)[1][2] == 2)
check("iter unique", iter.unique({1, 2, 2, 3}):len() == 3)
check("iter flat_map", iter.flat_map({1, 2, 3}, (x) {x, x * 10}):len() == 6)

# ── Summary ─────────────────────────────────────────────────────────────

io.write("\n=== Results: %d passed, %d failed ===\n":format(pass, fail))
test.assert_eq(fail, 0, "no failures expected")
test.done()
