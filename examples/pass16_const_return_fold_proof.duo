-- gap[023] regression — a guard clause must never fold to its guard value.
--
-- region_transform.calleeConstI64Return accepted any single-BLOCK function and
-- returned its FIRST constant `ret`. DNIR keeps br/br_if/br_if_not and several
-- `ret`s inside ONE block, so a single block is not a single exit: the callee
-- `if 1 != 1 return 41 end / 9` compiled correctly on its own, while every
-- CALLER was folded to the literal 41 and never emitted the call at all.
--
-- The two backends therefore disagreed in silence -- `--backend c` returned 9,
-- `--backend direct` returned 41 -- and any guard clause, one of the most
-- common shapes in the language, returned its guard value unconditionally.
--
-- Exit code is the failing check number; 0 means the fold is sound.

untaken = (): i64
    if 1 != 1 return 41 end
    9
end

taken = (): i64
    if 1 == 1 return 41 end
    9
end

second = (): i64
    if 1 != 1 return 41 end
    if 1 == 1 return 42 end
    9
end

-- Must STILL fold: one straight line, one constant exit, no control flow.
-- Guarding the unsound case must not cost the sound optimization.
folds = (): i64
    9
end

main = (): i64
    if untaken() != 9 return 1 end
    if taken() != 41 return 2 end
    if second() != 42 return 3 end
    if folds() != 9 return 4 end
    0
end
