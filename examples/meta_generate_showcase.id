# @comp.generate constraint block → O(ops×types) cartesian native C
# Run: duo run examples/meta_generate_showcase.id

CONSTRAINTS = [[
ops: add|sub
types: i64:int64_t|f64:double
template: /* gen[$0:$1] */
]]

CODE = @comp.generate(CONSTRAINTS, "/* fallback $0:$1 */\n")

SIMPLE = @comp.generate("add,sub", "/* op=$0 */\n")

print("=== @comp.generate showcase ===")
print(CODE)
print(SIMPLE)
print("RESULT generate_ok = true")
