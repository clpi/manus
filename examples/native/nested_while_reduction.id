
apply: i64 = (o: i64, a: i64, b: i64)
    if o == 43
        return a + b
    return a - b

main: i64 = ()
    val = { 0, 0, 0, 0, 0, 0, 0, 0 }
    ops = { 0, 0, 0, 0, 0, 0, 0, 0 }
    vt = 0
    ot = 0
    i = 1
    while i <= 5
        vt += 1
        val[vt] = i
        if i <= 4
            while ot > 0
                o = ops[ot]
                ot -= 1
                b = val[vt]
                vt -= 1
                a = val[vt]
                val[vt] = apply(o, a, b)
            ot += 1
            ops[ot] = 43
        i += 1
    while ot > 0
        o = ops[ot]
        ot -= 1
        b = val[vt]
        vt -= 1
        a = val[vt]
        val[vt] = apply(o, a, b)
    val[1]
