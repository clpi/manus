-- Duo Architectural Proof — Demonstrates Passes 1-5 in one file
-- Run: duo run examples/architecture_proof.duo
-- Native: duo compile examples/architecture_proof.duo --target native-asm

-- ═══ Pass 1: Lua semantics, progressively specialized ═══
-- Ordinary Lua-shaped table construction and field access
config = {
    name = "duo"
    version = "0.5.0"
    workers = 8
}

-- ═══ Pass 2: Knowledge Lattice → native lowering ═══
-- Typed functions: compiler KNOWS types → emits native C (no boxing)
-- (In full-native modules these compile to direct scalar operations)
fun add(a: i64, b: i64): i64 return a + b end
fun mul(a: i64, b: i64): i64 return a * b end

-- ═══ Pass 3: Compact grammar without keywords ═══
-- Descriptors replace enum/struct keywords
Direction: @{ North, South, East, West }
Point: @{ x: f64, y: f64 }

-- Table spread (GP-004)
defaults = { color = "blue", size = 10 }
custom = { ..defaults, color = "red" }

-- Field projections (GP-001)
fun map(t, f)
    result = {}
    for i = 1, #t do result[i] = f(t[i]) end
    return result
end

items = {
    { name = "alpha", score = 95 },
    { name = "beta", score = 87 },
    { name = "gamma", score = 92 }
}
names = map(items, .name)
scores = map(items, .score)

-- Direct iteration (GP-008)
total = 0
for s in scores do
    total = total + s
end

-- If-expression (GS-003)
grade = if total > 250 then "excellent" else "good" end

-- ═══ Pass 4: Native compilation without boxing ═══
-- This function compiles to pure arm64 via --target native-asm:
--   fmul d2, d0, d0; fmul d3, d1, d1; fadd d4, d2, d3; ret
fun distance2(p: Point): f64
    return p.x * p.x + p.y * p.y
end

-- ═══ Pass 5: Foreign interface (manual today, automated future) ═══
-- Today: @ffi declares external C functions for direct native calls
-- Future: @c.import("header.h") will parse and import automatically

-- ═══ Results ═══
print("RESULT config " .. config.name .. " v" .. config.version)
print("RESULT typed_math " .. tostring(add(mul(3, 4), 5)))
print("RESULT spread " .. custom.color .. " " .. tostring(custom.size))
print("RESULT projections " .. names[1] .. "," .. names[2] .. "," .. names[3])
print("RESULT iteration " .. tostring(total))
print("RESULT grade " .. grade)
print("RESULT distance " .. tostring(distance2({ x = 3.0, y = 4.0 })))
