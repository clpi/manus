-- Generative combinator algebra: template / generate / scheme → @comp.each
-- Run: duo run examples/meta_generative_stack_showcase.duo
--
-- One author pattern per stage; @comp.each closes the algebra by re-expanding
-- every comptime fragment. Fragment counts use @comp.str.countlines (native i64).

fun stamp(frag) -> str
    "/* each[" .. tostring(frag.index) .. "/" .. tostring(frag.count) .. "] " .. frag.name .. " */\n"
end

-- Stage A: O(n) template axis
TMPL_VARIANTS = "i64:int64_t|f64:double"
TMPL = @comp.template(TMPL_VARIANTS, "/* tmpl[$0:$1] */\n")
TMPL_EACH = @comp.each(TMPL, stamp)
TMPL_N = @comp.str.countlines(TMPL_EACH)
TMPL_SPEC_N = @comp.str.splitcount(TMPL_VARIANTS, "|")

-- Stage B: O(ops×types) constraint cartesian
GEN_SPEC = [[
ops: add|sub
types: i64:int64_t|f64:double
template: /* gen[$0:$1] */
]]
GEN = @comp.generate(GEN_SPEC, "")
GEN_EACH = @comp.each(GEN, stamp)
GEN_N = @comp.str.countlines(GEN_EACH)

-- Stage C: O(units) declarative scheme
DECLS = "type Point { x: double, y: double } | fn add(a: Point, b: Point) -> Point"
SCHEME = @comp.scheme(DECLS, "/* scheme[$kind $name] */\n")
SCHEME_EACH = @comp.each(SCHEME, stamp)
SCHEME_N = @comp.str.countlines(SCHEME_EACH)

ok = (TMPL_N == 2 and TMPL_SPEC_N == 2 and GEN_N == 4 and SCHEME_N == 2)

print("=== generative stack (template / generate / scheme → each) ===")
print("template→each fragments = " .. tostring(TMPL_N) .. "  (expect 2)")
print("generate→each fragments = " .. tostring(GEN_N) .. "  (expect 4 = 2×2)")
print("scheme→each fragments   = " .. tostring(SCHEME_N) .. "  (expect 2)")
print("RESULT generative_stack_ok = " .. tostring(ok))
