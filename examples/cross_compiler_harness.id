# Cross-compiler metaprogramming harness
# Demonstrates @comp.run composing with @comp.c.emit and @embed
# Run: duo run examples/cross_compiler_harness.id

print("=== Cross-compiler harness ===")

@comp.c.include("stdio.h")

# Inject C discovered/generated at compile time
@comp.c.emit(@comp.run("printf 'static const char duo_harness_tag[] = {99,111,109,112,105,108,101,100,0};'"))

# Compile-time string from a host command
BUILD_ID: str = @comp.run("printf duo-20260725")
print("BUILD_ID = " .. BUILD_ID)

# Embed this file at compile time
FIRST_BYTES: str = @comp.embed.str("examples/cross_compiler_harness.id")
print("embedded starts with: " .. FIRST_BYTES:sub(1, 2))

len: i64 = @comp.c.call("strlen", BUILD_ID)
print("BUILD_ID length = " .. to(str)(len))

print("=== done ===")
