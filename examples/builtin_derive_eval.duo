-- Demonstrate that @comp.derive.eval works on built-in derives too.
-- The macro evaluates Display, Eq, and Hash and reports how much code each produces.

@comp.define.derive("ReportBuiltins", generate(meta) -> str
    display_src = @comp.derive.eval("Display", meta)
    eq_src = @comp.derive.eval("Eq", meta)
    hash_src = @comp.derive.eval("Hash", meta)
    acc = "/* Built-in derive report for " .. meta.name .. " */\n"
    acc = acc .. "/* Display length: " .. to(str)(#display_src) .. " */\n"
    acc = acc .. "/* Eq length: " .. to(str)(#eq_src) .. " */\n"
    acc = acc .. "/* Hash length: " .. to(str)(#hash_src) .. " */\n"
    acc = acc .. display_src .. "\n"
    acc = acc .. eq_src .. "\n"
    acc = acc .. hash_src .. "\n"
    return acc
end)

@derive(ReportBuiltins)
type Point = { x: i64, y: i64 }

print("Built-in derive eval ok")
