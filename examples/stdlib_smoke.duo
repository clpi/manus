-- Test stdlib modules using builtin req (lua_require)
log = req "std.log"
memo = req "std.memo"
json = req "std.json"
hash = req "std.hash"
fmt = req "std.fmt"
atomic = req "std.atomic"
crypto = req "std.crypto"
test = req "std.test"
meta = req "std.meta"

total_passes = 0
total_fails = 0

fun count_result(p)
    if p then total_passes += 1 else total_fails += 1 end
end

log.info("duo stdlib smoke-test")

count_result(meta.typeof(42) == "number")
count_result(meta.is_nil(nil))
count_result(meta.is_bool(true))
count_result(not meta.is_func(1))

count_result(hash.simple("hello") == hash.simple("hello"))

b64 = crypto.base64_encode("Hey!")
count_result(b64 == "SGV5IA==")

count_result(fmt.pad("x", 5) == "x    ")
count_result(#json.encode({1, 2, 3}) > 3)

mem = memo.table_new()
memo.table_set(mem, "k", 1)
count_result(memo.table_get(mem, "k") == 1)
count_result(not memo.table_has(mem, "nope"))

a = atomic.mutex_new()
a.locked = true
count_result(a.locked)

count_result(memo.wrap(fun(x) return x * 2 end)(21) == 42)

test.start("stdlib smoke")
test.assert_eq(total_fails, 0, "no failures expected")
test.done()