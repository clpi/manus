# =============================================================================
# Duo Language Full Feature Demo
# Demonstrates: functions, concepts, meta blocks, early returns, derive helpers,
# reflection, and the req-only import system.
# =============================================================================

# ── Section 1: Functions ───────────────────────────────────────────────────

identity(value)
    value

make_pair(first, second)
    { first = first, second = second }

swap: any = (a, b)
    return b, a

safe_div: any = (a, b)
    if b == 0
        return a
    a // b

map_list: any = (xs, fn)
    result = {}
    for i = 1, xs:len()
        result[i] = fn(xs[i])
    result

# ── Section 2: Concepts ─────────────────────────────────────────────────────

concept Measurable
    measure(self, unit: str): f64
    label(self): str

concept Combinable
    combine(self, other): any

distance = {}
distance.x = 3.0
distance.y = 4.0
distance.measure = (self, unit: str): f64
    mag = self.x * self.x + self.y * self.y:sqrt()
    if unit == "km"
        return mag / 1000.0
    mag
distance.label = (self): str
    "Distance(" .. to(str)(self.x) .. ", " .. to(str)(self.y) .. ")"

# ── Section 3: Meta Blocks (@ compile-time evaluation) ─────────────────────

MAX_ITEMS = @(100)
BUFFER_SIZE = @(1024 * 16)
APP_NAME = @("duo_demo")
IS_DEBUG = @(false)

# ── Section 4: Derive helpers ──────────────────────────────────────────────

derive_clone(val)
    if type(val) != "table" return val 
    c = {}
    for k, v in val do c[k] = v 
    c

derive_display: str = (val)
    if val == nil return "nil" 
    if type(val) == "boolean"
        if val return "true" else return "false" 
    if type(val) == "number" return to(str)(val) 
    if type(val) == "string" return val 
    if type(val) == "table"
        parts = {}
        for k, v in val
            if type(k) == "string"
                parts[parts:len() + 1] = k .. ": " .. derive_display(v)
        return "{" .. parts:concat(", ") .. "}"
    to(str)(val)

# ── Section 5: Memory Allocators ───────────────────────────────────────────

demo_arena = ()
    arena = { _bufs = {}, _offset = 0, _capacity = 4096, _total = 0 }
    print("Arena created, capacity: " .. to(str)(arena._capacity))

demo_pool = ()
    print("Pool created, block_size: 128, count: 64")

# ── Section 6: WASI Types ──────────────────────────────────────────────────

demo_wasi = ()
    print("WASI stdin fd:  0")
    print("WASI stdout fd: 1")
    print("WASI stderr fd: 2")
    print("WASI exit success: 0")
    print("WASI exit failure: 1")

# ── Section 7: Reflection ───────────────────────────────────────────────────

demo_reflection = (val)
    print("typeof: " .. type(val))
    print("is_nil: " .. to(str)(val == nil))
    print("is_str: " .. to(str)(type(val) == "string"))
    print("is_number: " .. to(str)(type(val) == "number"))
    print("is_table: " .. to(str)(type(val) == "table"))
    print("is_func: " .. to(str)(type(val) == "function"))

    if type(val) == "table"
        count = 0
        for _k, _v in val do count += 1 
        print("Field count: " .. to(str)(count))

# ── Section 8: Functions with/without return types ────────────────────────

typed_add(a: i64, b: i64): i64
    a + b

untyped_add(a, b)
    a + b

classify: str = (n: i64)
    if n < 0
        return "negative"
    if n == 0
        return "zero"
    "positive"

validate_input: bool = (val)
    if val == nil
        if true
            return false
    if type(val) == "number"
        if val < 0
            return false
        if val > 1000
            return false
    true

# ── Main: run all demos ─────────────────────────────────────────────────────

print("=== Duo Full Feature Demo ===")

# Functions
print("\n-- Functions --")
print("identity(42): " .. to(str)(identity(42)))
print("identity('hello'): " .. identity("hello"))

pair = make_pair(1, "one")
print("pair: " .. to(str)(pair.first) .. " => " .. pair.second)

x, y = swap(10, 20)
print("swap(10, 20): " .. to(str)(x) .. ", " .. to(str)(y))

# Early returns
print("\n-- Early Returns --")
print("classify(-5): " .. classify(-5))
print("classify(0): " .. classify(0))
print("classify(42): " .. classify(42))
print("validate_input(nil): " .. to(str)(validate_input(nil)))
print("validate_input(501): " .. to(str)(validate_input(501)))
print("validate_input(50): " .. to(str)(validate_input(50)))

# Safe div with early return
print("safe_div(10, 2): " .. to(str)(safe_div(10, 2)))
print("safe_div(10, 0): " .. to(str)(safe_div(10, 0)))

# Meta blocks
print("\n-- Meta Blocks --")
print("MAX_ITEMS: " .. to(str)(MAX_ITEMS))
print("BUFFER_SIZE: " .. to(str)(BUFFER_SIZE))
print("APP_NAME: " .. APP_NAME)
print("IS_DEBUG: " .. to(str)(IS_DEBUG))

# Concepts
print("\n-- Concepts --")
print("Distance label: " .. distance:label())
print("Distance measure (m): " .. to(str)(distance:measure("m")))
print("Distance measure (km): " .. to(str)(distance:measure("km")))

# Derive
print("\n-- Derive --")
original = { a = 1, b = 2, c = { d = 3 } }
cloned = derive_clone(original)
print("clone: " .. derive_display(cloned))

# Memory
print("\n-- Memory Allocators --")
demo_arena()
demo_pool()

# WASI
print("\n-- WASI --")
demo_wasi()

# Reflection
print("\n-- Reflection --")
demo_reflection("hello world")
demo_reflection({ a = 1, b = 2 })

# Return types
print("\n-- Return Types --")
print("typed_add(5, 3): " .. to(str)(typed_add(5, 3)))
print("untyped_add(5, 3): " .. to(str)(untyped_add(5, 3)))

print("\n=== All demos complete ===")
