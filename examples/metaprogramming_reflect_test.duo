-- Metaprogramming test: type reflection on records and enums

-- ═══════════════════════════════════════════════════════════════
-- @comp.fields on typed records
-- ═══════════════════════════════════════════════════════════════

point: { x: f64, y: f64, z: f64 } = { x = 1.0, y = 2.0, z = 3.0 }

-- @comp.fields returns a table of field descriptors
fields = @comp.fields(point)
print("field count = " .. tostring(#fields))
for i = 1, #fields do
    print("  field " .. tostring(i) .. ": name=" .. fields[i].name .. " type=" .. fields[i].type)
end

-- ═══════════════════════════════════════════════════════════════
-- @comp.has.field on typed records
-- ═══════════════════════════════════════════════════════════════

print("has x = " .. tostring(@comp.has.field(point, "x")))
print("has w = " .. tostring(@comp.has.field(point, "w")))

-- ═══════════════════════════════════════════════════════════════
-- @comp.field.type on typed records
-- ═══════════════════════════════════════════════════════════════

print("field_type(x) = " .. @comp.field.type(point, "x"))
print("field_type(y) = " .. @comp.field.type(point, "y"))

-- ═══════════════════════════════════════════════════════════════
-- @comp.field.offset and @comp.field.size
-- ═══════════════════════════════════════════════════════════════

off_x = @comp.field.offset(point, "x")
off_y = @comp.field.offset(point, "y")
off_z = @comp.field.offset(point, "z")
sz_x = @comp.field.size(point, "x")

print("offset(x) = " .. tostring(off_x))
print("offset(y) = " .. tostring(off_y))
print("offset(z) = " .. tostring(off_z))
print("size(x) = " .. tostring(sz_x))

-- ═══════════════════════════════════════════════════════════════
-- Enum reflection with @comp.fields (returns variant info)
-- ═══════════════════════════════════════════════════════════════

enum Color
    Red
    Green
    Blue
end

c = Color.Red
color_fields = @comp.fields(c)
print("enum variant count = " .. tostring(#color_fields))
for i = 1, #color_fields do
    print("  variant " .. tostring(i) .. ": name=" .. color_fields[i].name)
end

-- ═══════════════════════════════════════════════════════════════
-- @comp.variants on enums (more detailed)
-- ═══════════════════════════════════════════════════════════════

variants = @comp.variants(c)
print("variants count = " .. tostring(#variants))
for i = 1, #variants do
    print("  " .. variants[i].name .. " tag=" .. tostring(variants[i].tag) .. " arity=" .. tostring(variants[i].arity))
end

-- ═══════════════════════════════════════════════════════════════
-- @comp.bit.field — packed bitfield definition
-- ═══════════════════════════════════════════════════════════════

bf_size = @comp.bit.field("Flags", "active", 1, "priority", 3, "mode", 4)
print("bitfield size = " .. tostring(bf_size))

-- ═══════════════════════════════════════════════════════════════
-- @comp.union — union type definition
-- ═══════════════════════════════════════════════════════════════

union_size = @comp.union("NumericValue", "i", "int64_t", "f", "double", "p", "void*")
print("union size = " .. tostring(union_size))

print("ALL REFLECTION TESTS PASSED")
