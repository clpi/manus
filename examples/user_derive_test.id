# Test user-defined @comp.define.derive macro generating code at compile time.

@comp.define.derive("Printable", generate(meta) -> str
  acc = "static char* " .. meta.name .. "_to_string(void* self) {\n"
  acc = acc .. "  return \"" .. meta.name .. "("
  for i = 1, meta:len().fields
    f = meta.fields[i]
    if i > 1
      acc = acc .. ", "
    end
    acc = acc .. f.name .. "="
  end
  acc = acc .. ")\";\n}\n"
  acc
end)

@derive(Printable)
Vec2: { x: f64, y: f64 }

print("User-defined derive test compiled")
