
@comp.define.derive("Printable", generate: str = (meta)
  acc = "static char* " .. meta.name .. "_to_string(void* self) {\n"
  acc = acc .. "  return \"" .. meta.name .. "("
  for i = 1, meta.fields:len()
    f = meta.fields[i]
    if i > 1
      acc = acc .. ", "
    acc = acc .. f.name .. "="
  acc = acc .. ")\";\n}\n"
  acc
)

@derive(Printable)
pair: { x: f64, y: f64 }

print("User-defined derive test compiled")
