-- Meta concept descriptor demo
-- Shows runtime concept creation via meta.make_concept

meta = req "std.meta"
derive = req "std.meta.derive"

Drawable = meta.make_concept("Drawable", {
    fields = { "id" },
    methods = { "draw" },
})

shape = {
    id = 7,
    draw = fun(self): str
        "shape"
    end,
    to_string = fun(self): str
        "drawable"
    end,
}

-- Runtime concept checking
print("Drawable name: " .. Drawable.name)
print("satisfies Drawable: " .. tostring(meta.satisfies_concept(shape, Drawable)))
print("satisfies Display: " .. tostring(meta.satisfies_concept(shape, derive.Display)))

-- Use : method syntax
print("draw: " .. shape:draw())
print("to_string: " .. shape:to_string())
