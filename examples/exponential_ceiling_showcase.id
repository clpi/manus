# Exponential ceiling: stacked @comp.* metaprogramming (concept sweep + migration + derive)
# Run: duo run examples/exponential_ceiling_showcase.id

concept HasXY
    x: f64
    y: f64
end

Point: { x: f64, y: f64 }
BadXY: { x: i64, y: f64 }
Pair: { x: f64, y: f64 }

@comp.define.derive("TouchApi", generate(meta) -> str
    acc = ""
    for i = 1, meta:len().fields
        f = meta.fields[i]
        acc = acc .. "void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    end
    acc
end)

@comp.assert(@comp.satisfies(Point, "HasXY"))
@comp.assert(not @comp.satisfies(BadXY, "HasXY"))

registry_line(meta): str
    meta.name .. ";"
end

# One @comp.expand line → O(types × fields) C for every concept match
@c.emit(@comp.expand("HasXY", TouchApi))

TYPED_SWEEP = @comp.map("HasXY", registry_line)

UserV1: { id: i64, nick: str }
UserV2: { id: i64, email: str }

MIGRATION = @comp.diff(UserV1, UserV2)
@c.emit(MIGRATION)

print("=== exponential ceiling showcase ===")
print("typed_sweep = " .. TYPED_SWEEP)
print("migration_lines = " .. to(str)(MIGRATION:len()))
print("Point satisfies HasXY = " .. to(str)(@comp.satisfies(Point, "HasXY")))
print("BadXY satisfies HasXY = " .. to(str)(@comp.satisfies(BadXY, "HasXY")))
print("ok")
