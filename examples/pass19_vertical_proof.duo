-- Pass 19 §90 — initial vertical proof scaffold: search(pattern, paths)
-- Target: one semantic declaration → CLI, shell, MCP, HTTP, docs, tests, native/SIMD/fallback.
-- Status: scaffold only (M0); realization competition and projections not yet wired.

std = req "std"

-- Placeholder: structured path search over direct table iteration (matches current stdlib).
search_paths(pattern: str, paths: any): any
    hits: any = {}
    for i = 1, #paths
        p = tostring(paths[i])
        if string.find(p, pattern, 1, true)
            hits[#hits + 1] = p
        end
    end
    hits
end

paths = { "src/main.zig", "src/parser.zig", "lib/std/json.duo" }
hits = search_paths("parser", paths)
if #hits != 1 or hits[1] != "src/parser.zig"
    error("pass19 vertical proof scaffold: expected one parser path hit")
end

print("RESULT pass19_vertical_proof scaffold ok")
