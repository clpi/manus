grow: f64 = (v: f64)
  v * 25400.0

shrink: f64 = (v: f64)
  v / 25400.0

swell: f64 = (v: f64)
  v * 1000.0

to(micron)(inch) = grow@lossless
to(inch)(micron) = shrink@lossless
to(micron)(milli) = swell@lossless

main: i64 = ()
  m: f64 = 1.0:to(micron)(inch)
  n: i64 = m:to(i64)
  k: i64 = 0
  chars: i64 = 0
  for src, conv in to(micron)
    k = k + 1
    chars = chars + src:len()
  print("{n} {k} {chars}")
  0
