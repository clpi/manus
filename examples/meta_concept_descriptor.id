# Meta concept descriptor demo
# Shows runtime concept creation via meta.make_concept

Drawable = meta.make_concept("Drawable", {
  fields = { "id" },
  methods = { "draw" }
})

shape =
  id = 7
  draw = (self) -> str
    "shape"
  to_string = (self) -> str
    "drawable"

# Runtime concept checking
print("Drawable name: " .. Drawable.name)
print("satisfies Drawable: " .. to(str)(meta.satisfies_concept(shape, Drawable)))
print("satisfies Display: " .. to(str)(meta.satisfies_concept(shape, derive.Display)))

# Use : method syntax
print("draw: " .. shape:draw())
print("to_string: " .. shape:to_string())
