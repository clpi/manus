# ml_showcase.id — Mojo-class ML workflow in Duo (minimal syntax)
#
# Demonstrates: @device, @autodiff, @profile, nn.build, ml.* intrinsics, ml.*

NN = nn
Ops = ops
Shape = shape
Device = device
Fusion = fusion
Transformer = transformer
Deploy = deploy

@device(.auto)
@profile
bench_all: f64 = ()
  s = 0.0
  s = s + ml.matmul_256()
  s = s + ml.softmax_1k()
  s = s + ml.gelu_1k()
  s = s + ml.layernorm_1k()
  s = s + ml.dot_1m()
  s = s + ml.conv1d()
  return s

@autodiff
@device(.auto)
loss_mnist: f64 = (model, x, target)
  pred = NN.forward(model, x)
  return NN.cross_entropy(pred, target)

main = ()
  print("=== Duo ML Showcase (Mojo-class path) ===")
  print("")

  # Shape templates (compile-time dims as const + runtime assert)
  spec = Shape.mnist_mlp()
  print(string.format("MNIST MLP: in=%d h1=%d h2=%d out=%d", spec.input.rows, spec.hidden1.rows, spec.hidden2.rows, spec.output.rows))

  # Device placement metadata
  dev = Device.best()
  print("Device: auto (compiler selects CPU/Metal/CUDA)")

  # Model = nn { linear; relu; … } (desugars to ml.nn.build)
  model = req("std.ml.nn").build(req("std.ml.nn"):linear(784, 256), req("std.ml.nn"):relu(), req("std.ml.nn"):linear(256, 10), req("std.ml.nn"):softmax())
  print("Model layers: %d":format(model.n_layers))

  # `@grad` desugars to ml.autodiff:grad (pairs with @autodiff on loss)
  grad_hook = @grad(loss_mnist, model)

  fused = Fusion.fuse_sequential(model)
  print("Fused layers: %d (rules: %d)":format(fused.n_layers, Fusion.rules():len()))

  tx = Transformer.stack(2, 8, 64)
  print(string.format("Transformer: %d layers x %d heads x dim %d", tx.layers, tx.heads, tx.dim))

  pipe = Deploy.edge_pipeline(model)
  print(string.format("Edge deploy: target=%s simd=%s", Deploy.wasm_opts().target, to(str)(Deploy.wasm_opts().simd)))

  # Native kernel checksum (validates ml.* path)
  checksum = bench_all()
  print("Kernel checksum: %.6f":format(checksum))

  # Stdlib tensor path
  x = Ops.matmul({ rows = 4, cols = 4, size = 16, data = { [1] = 1, [2] = 0, [3] = 0, [4] = 0, [5] = 0, [6] = 1, [7] = 0, [8] = 0, [9] = 0, [10] = 0, [11] = 1, [12] = 0, [13] = 0, [14] = 0, [15] = 1, [16] = 0 } }, { rows = 4, cols = 4, size = 16, data = { [1] = 2, [2] = 0, [3] = 0, [4] = 0, [5] = 0, [6] = 2, [7] = 0, [8] = 0, [9] = 0, [10] = 0, [11] = 2, [12] = 0, [13] = 0, [14] = 0, [15] = 2, [16] = 0 } })
  print("4x4 matmul corner: %.1f":format(x.data(1)))

  print("")
  print("PASS — showcase complete")

  main()
