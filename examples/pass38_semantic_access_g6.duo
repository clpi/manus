-- Pass 38 G6 / Pass 40 — `value.@name` is SEMANTIC access.
--
-- The projection calculus sits at phase0_status "recorded_only": the catalog
-- records eleven grammar forms and the compiler implements none of them. G6 is
-- the first, and its blocker was documented exactly —
-- docs/plans/pass38_projection_calculus.md records `point.@eq` failing with
-- "expected 'name', got '@'" because the postfix field path demanded a `name`
-- token after `.`.
--
-- The central rule (§1):
--     .   ordinary access
--     @   semantic access
--
-- `p.eq` is the member. `p.@eq` is the effective metatable entry. §8.5 maps
-- `@x` onto Lua's `__x`, so this reads through the same metafield the runtime
-- already maintains — one lookup against existing machinery, not a new
-- dispatch mechanism.
--
-- Note what CANNOT go wrong here, in contrast to a method-name projection:
-- `.@name` is distinct syntax, so it can never capture a table that happens to
-- carry a member of the same name. "Data always wins the name" holds by
-- construction rather than by a guard.

fails = 0

check(label: str, got: str, want: str): void
    if got != want
        fails = fails + 1
        print("FAIL {label}: got {got}, want {want}")
    end
end

myeq(a: any, b: any): bool
    true
end

main(): void
    mt = { __eq = myeq }
    p = {}
    setmetatable(p, mt)

    -- 1. The semantic entry is RETRIEVABLE as a value (§1.3). Retrieval, never
    --    binding: `p.@eq` is the value of the relation, not a call of it.
    check("semantic present", to(str)(p.@eq != nil), "true")

    -- 2. An ABSENT relation yields nil rather than erroring. §9 is normative
    --    from the start: an unconsumed projection is a graph fact, never an
    --    emitted symbol, so asking about one that does not exist is a legal
    --    question with the answer "no".
    q = {}
    check("semantic absent", to(str)(q.@eq == nil), "true")

    -- 3. The two worlds do not collide. A table carrying an ORDINARY member
    --    named `eq` still returns it through `.eq`, and its semantic world is
    --    still empty — the sigil selects the world, so neither can shadow the
    --    other.
    r = { eq = 5 }
    check("ordinary member", to(str)(r.eq), "5")
    check("ordinary is not semantic", to(str)(r.@eq == nil), "true")

    -- 4. Semantic access composes with ordinary access on the same chain.
    holder = { inner = p }
    check("chained", to(str)(holder.inner.@eq != nil), "true")

    if fails == 0
        print("pass38_semantic_access_g6: PASS (5 checks)")
    else
        print("pass38_semantic_access_g6: FAIL")
        os.exit(1)
    end
end
