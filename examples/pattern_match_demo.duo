-- Pattern matching demo: enum payloads, array/table destructuring, guards

enum Shape
    Circle(radius: f64)
    Rect(w: f64, h: f64)
    Triangle(base: f64, height: f64)
    Point
end

fun area(s: Shape): f64
    a: f64 = 0.0
    match s
        Shape.Circle(r) => a = 3.14159265 * r * r
        Shape.Rect(w, h) => a = w * h
        Shape.Triangle(b, h) => a = 0.5 * b * h
        Shape.Point => a = 0.0
    end
    a
end

fun tag_of(s: Shape): i64
    tag: i64 = -1
    match s
        Shape.Circle(_) => tag = 0
        Shape.Rect(_, _) => tag = 1
        Shape.Triangle(_, _) => tag = 2
        Shape.Point => tag = 3
    end
    tag
end

fun is_unit_square(s: Shape): bool
    yes: bool = false
    match s
        Shape.Rect(1.0, 1.0) => yes = true
        _ => yes = false
    end
    yes
end

fun sum3(nums: any): f64
    result: f64 = 0.0
    match nums
        [a, b, c] => result = a + b + c
        _ => result = -1.0
    end
    result
end

fun head(xs: any): any
    h: any = nil
    match xs
        [first, _] => h = first
        [only] => h = only
        _ => h = nil
    end
    h
end

circ: Shape = Shape.Circle(2.0)
rect: Shape = Shape.Rect(3.0, 4.0)
unit: Shape = Shape.Rect(1.0, 1.0)
print(area(circ))
print(area(rect))
print(tag_of(Shape.Point))
print(is_unit_square(rect))
print(is_unit_square(unit))
v3 = {10, 20, 30}
print(sum3(v3))
print(head(v3))
