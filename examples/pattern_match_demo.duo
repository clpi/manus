-- Pattern matching demo: enum payloads, array/table destructuring, guards

enum Shape
    Circle(radius: f64)
    Rect(w: f64, h: f64)
    Triangle(base: f64, height: f64)
    Point
end

fun area(s: Shape): f64
    a: f64 = 0.0
    match s
        case Shape.Circle(r) then a = 3.14159265 * r * r
        case Shape.Rect(w, h) then a = w * h
        case Shape.Triangle(b, h) then a = 0.5 * b * h
        case Shape.Point then a = 0.0
    end
    a
end

fun tag_of(s: Shape): i64
    tag: i64 = -1
    match s
        case Shape.Circle(_) then tag = 0
        case Shape.Rect(_, _) then tag = 1
        case Shape.Triangle(_, _) then tag = 2
        case Shape.Point then tag = 3
    end
    tag
end

fun is_unit_square(s: Shape): bool
    yes: bool = false
    match s
        case Shape.Rect(1.0, 1.0) then yes = true
        case _ then yes = false
    end
    yes
end

fun sum3(nums: any): f64
    result: f64 = 0.0
    match nums
        case [a, b, c] then result = a + b + c
        case _ then result = -1.0
    end
    result
end

fun head(xs: any): any
    h: any = nil
    match xs
        case [first, _] then h = first
        case [only] then h = only
        case _ then h = nil
    end
    h
end

circ: Shape = Shape.Circle(2.0)
rect: Shape = Shape.Rect(3.0, 4.0)
unit: Shape = Shape.Rect(1.0, 1.0)
print(area(circ))
print(area(rect))
print(tag_of(Shape.Point))
print(is_unit_square(rect))
print(is_unit_square(unit))
v3 = {10, 20, 30}
print(sum3(v3))
print(head(v3))
