-- Smoke for Duo-native locked command helpers.
--
-- RL-13 deleted scripts/duo_lock.sh, so the assertion that matters is that the
-- helpers hand out the DUO wrapper and never the shell one. This used to pin
-- the exact bash string, which meant the gate failed on the deletion rather
-- than on anything being wrong -- a literal expectation testing the spelling
-- instead of the property.
--
-- Note `duo run x.duo -- cmd` consumes the first `--` itself, which is why the
-- timeout form carries two.

cmd = std.script.lock_cmd("printf script_lock")
cmd_timeout = std.script.lock_cmd_timeout("printf script_lock", 7)

wraps_duo = std.string.find(cmd, "scripts/duo_lock.duo") != nil
no_shell = std.string.find(cmd, "duo_lock.sh") == nil
carries_cmd = std.string.find(cmd, "printf script_lock") != nil
has_timeout = std.string.find(cmd_timeout, "--timeout 7") != nil

-- The functional half: inside `zig build agent-smoke` the lock is already held,
-- so locked_run sees DUO_LOCK_HELD=1 and runs directly. That reentrancy is the
-- reason wrapping the gate in the lock does not deadlock against itself.
ran = std.script.locked_ok("printf script_lock >/dev/null")

ok = wraps_duo and no_shell and carries_cmd and has_timeout and ran

print("=== script lock smoke ===")
print("wraps_duo_lock_duo = " .. to(str)(wraps_duo))
print("no_shell_wrapper = " .. to(str)(no_shell))
print("carries_command = " .. to(str)(carries_cmd))
print("timeout_cmd_ok = " .. to(str)(has_timeout))
print("locked_run_ok = " .. to(str)(ran))
print("RESULT script_lock_ok = " .. to(str)(ok))
if not ok
    error("script lock smoke failed")
end
