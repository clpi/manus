
churn: i64 = (n: i64)
  h: u32 = 2166136261
  i: u32 = 0
  while i < n
    h = h ~ i
    h = h * 16777619
    h = h << 13 | h >> 19
    i = i + 1
  h

main: i64 = ()
  print(churn(0))
  print(churn(1))
  print(churn(2))
  print(churn(3))
  print(churn(10))
  print(churn(100))
  print(churn(1000))
  print(churn(10000))
  print(churn(100000))
  print(churn(1000000))
  0
