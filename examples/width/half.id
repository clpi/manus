
rise: i64 = (p: i64)
  h: u16 = p
  h = h + 1
  h

fall: i64 = (p: i64)
  h: u16 = p
  h = h - 1
  h

scale: i64 = (p: i64)
  h: u16 = p
  h = h * 3
  h

shift: i64 = (p: i64)
  h: u16 = p
  h = h << 1
  h

mask: i64 = (p: i64)
  h: u16 = p
  h = h & 255
  h

merge: i64 = (p: i64)
  h: u16 = p
  h = h | 1
  h

flip: i64 = (p: i64)
  h: u16 = p
  h = h ~ 1
  h

drop: i64 = (p: i64)
  h: u16 = p
  h = h >> 1
  h

main: i64 = ()
  print(rise(0))
  print(rise(1))
  print(rise(32767))
  print(rise(32768))
  print(rise(32769))
  print(rise(65534))
