-- Pass 27 P0 — ten-benchmark proof matrix (explicit types; all bench backends).
-- Reference: examples/pass27_proof_matrix_c.c

fib(n: i64): i64
    if n <= 1
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

count_primes(limit: i64): i64
    count: i64 = 0
    n: i64 = 2
    while n <= limit
        is_prime: i64 = 1
        d: i64 = 2
        while d * d <= n
            if n % d == 0
                is_prime = 0
            end
            d = d + 1
        end
        if is_prime != 0
            count = count + 1
        end
        n = n + 1
    end
    return count
end

mandel_iter(cx: f64, cy: f64): i64
    zx: f64 = 0.0
    zy: f64 = 0.0
    i: i64 = 0
    while i < 1000
        zx2: f64 = zx * zx
        zy2: f64 = zy * zy
        if zx2 + zy2 > 4.0
            return i
        end
        zy = 2.0 * zx * zy + cy
        zx = zx2 - zy2 + cx
        i = i + 1
    end
    return 1000
end

eval_A(i: f64, j: f64): f64
    1.0 / ((i + j) * (i + j + 1.0) / 2.0 + i + 1.0)
end

compute_grid_sum(size: i64): f64
    total: f64 = 0.0
    i: i64 = 0
    while i < size
        j: i64 = 0
        while j < size
            total = total + eval_A(i * 1.0, j * 1.0)
            j = j + 1
        end
        i = i + 1
    end
    return total
end

simulate_nbody(steps: i64): f64
    x1: f64 = 0.0
    y1: f64 = 0.0
    vx1: f64 = 0.0
    vy1: f64 = 0.0
    m1: f64 = 1000.0
    x2: f64 = 10.0
    y2: f64 = 0.0
    vx2: f64 = 0.0
    vy2: f64 = 0.0
    m2: f64 = 1.0
    x3: f64 = 0.0
    y3: f64 = -10.0
    vx3: f64 = -10.0
    vy3: f64 = 0.0
    m3: f64 = 1.0
    dt: f64 = 0.001
    i: i64 = 0
    while i < steps
        dx12: f64 = x2 - x1
        dy12: f64 = y2 - y1
        dist12_sq: f64 = dx12 * dx12 + dy12 * dy12 + 0.001
        dist12: f64 = math.sqrt(dist12_sq)
        f12: f64 = (m1 * m2) / dist12_sq
        vx1 = vx1 + (f12 * dx12 / dist12) * dt / m1
        vy1 = vy1 + (f12 * dy12 / dist12) * dt / m1
        vx2 = vx2 - (f12 * dx12 / dist12) * dt / m2
        vy2 = vy2 - (f12 * dy12 / dist12) * dt / m2
        dx13: f64 = x3 - x1
        dy13: f64 = y3 - y1
        dist13_sq: f64 = dx13 * dx13 + dy13 * dy13 + 0.001
        dist13: f64 = math.sqrt(dist13_sq)
        f13: f64 = (m1 * m3) / dist13_sq
        vx1 = vx1 + (f13 * dx13 / dist13) * dt / m1
        vy1 = vy1 + (f13 * dy13 / dist13) * dt / m1
        vx3 = vx3 - (f13 * dx13 / dist13) * dt / m3
        vy3 = vy3 - (f13 * dy13 / dist13) * dt / m3
        x1 = x1 + vx1 * dt
        y1 = y1 + vy1 * dt
        x2 = x2 + vx2 * dt
        y2 = y2 + vy2 * dt
        x3 = x3 + vx3 * dt
        y3 = y3 + vy3 * dt
        i = i + 1
    end
    return x1 + y1 + x2 + y2 + x3 + y3
end

table_array_sum(n: i64): i64
    sum: i64 = 0
    i: i64 = 1
    while i <= n
        sum = sum + i
        i = i + 1
    end
    return sum
end

trig_sum(n: i64): f64
    sum: f64 = 0.0
    i: i64 = 0
    while i < n
        sum = sum + math.sin(i * 1.0) * math.cos(i * 1.0)
        i = i + 1
    end
    return sum
end

rolling_hash(n: i64): i64
    h: i64 = 0
    i: i64 = 0
    while i < n
        h = (h * 31 + (i % 256)) % 1000000007
        i = i + 1
    end
    return h
end

dot2d(n: i64): f64
    sum: f64 = 0.0
    i: i64 = 0
    while i < n
        sum = sum + (i * 1.0) * ((n - i) * 1.0)
        i = i + 1
    end
    return sum
end

reduce_xor(n: i64): i64
    x: i64 = 0
    i: i64 = 1
    while i <= n
        x = x ~ i
        i = i + 1
    end
    return x
end

main(): i64
    fib_res: i64 = fib(32)
    print("RESULT fib " .. to(str)(fib_res))

    prime_res: i64 = count_primes(10000)
    print("RESULT primes " .. to(str)(prime_res))

    mandel: i64 = 0
    y: i64 = -20
    while y <= 20
        x: i64 = -20
        while x <= 20
            mandel = mandel + mandel_iter(x / 20.0, y / 20.0)
            x = x + 1
        end
        y = y + 1
    end
    print("RESULT mandel " .. to(str)(mandel))

    grid_res: f64 = compute_grid_sum(200)
    print("RESULT grid " .. to(str)(grid_res))

    nbody_res: f64 = simulate_nbody(50000)
    print("RESULT nbody " .. to(str)(nbody_res))

    tbl_res: i64 = table_array_sum(50000)
    print("RESULT table_sum " .. to(str)(tbl_res))

    trig_res: f64 = trig_sum(500000)
    print("RESULT trig " .. to(str)(trig_res))

    hash_res: i64 = rolling_hash(80000)
    print("RESULT hash " .. to(str)(hash_res))

    dot_res: f64 = dot2d(50000)
    print("RESULT dot " .. to(str)(dot_res))

    xor_res: i64 = reduce_xor(65535)
    print("RESULT xor " .. to(str)(xor_res))

    0
end
