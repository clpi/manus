# Nested match → fixpoint: comptime-only, no runtime closures.
# Run: duo run examples/meta_match_fixpoint_showcase.id

out = @comp.match("alpha|beta", fun(m)
  @comp.fixpoint(m.pattern, fun(s)
    "tag=" .. m.pattern .. " iter=" .. to(str)(s.iteration) .. "\n"
  , 2)
)

LINES = @comp.str.countlines(out)
HAS_ALPHA = "tag=alpha iter=0" in out
HAS_BETA1 = "tag=beta iter=1" in out

ok = LINES == 4 and HAS_ALPHA and HAS_BETA1
print("=== match → fixpoint cascade ===")
print("line_count = " .. to(str)(LINES) .. "  (expect 4 = 2 patterns × 2 iterations)")
print("RESULT match_fixpoint_ok = " .. to(str)(ok))
