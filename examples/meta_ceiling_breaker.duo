-- Break the linear codegen ceiling: one @comp.* line → O(types² × fields) output
-- Run: duo run examples/meta_ceiling_breaker.duo

concept HasXY
    x: f64
    y: f64
end

concept HasTag
    tag: str
end

type Point = { x: f64, y: f64, tag: str }
type Pair = { x: f64, y: f64, tag: str }
type Label = { tag: str }

@comp.define.derive("PairApi", generate(meta) -> str
    acc = "/* pair " .. meta.name .. " */\n"
    if meta.left != nil
        acc = acc .. "/* left=" .. meta.left.name .. " right=" .. meta.right.name .. " */\n"
    else
        for i = 1, #meta.fields
            f = meta.fields[i]
            acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
        end
    end
    acc
end)

-- One @comp.ceiling line → O(types × fields) + O(types² × fields) C
@c.emit(@comp.ceiling("HasXY", PairApi, "HasTag"))

pair_sig(a, b) -> str
    a.name .. "x" .. b.name .. ";"
end

PAIRS = @comp.product("HasXY", "HasTag", pair_sig)
NAMES = @comp.type.names()

print("=== meta ceiling breaker ===")
print("pairs = " .. PAIRS)
print("all = " .. NAMES)
print("Point ok = true")
print("ok")
