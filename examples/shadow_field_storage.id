# @corpus current
# THE SHADOW THAT SURVIVED THE FIRST REPAIR — a module table that OWNS FIELD
# STORAGE and is shadowed anyway.
#
# `examples/shadow.id` covers the shadow whose module table owns NO storage.
# This is the other half, and b879de84 recorded it as still wrong: `poke`'s
# `bank.x = 7` is a genuine write to the MODULE's binding, so `bank.x` gets a
# `__DATA` word. `bump` then declares its OWN `bank`, and the record-literal
# explosion looked the field key up in `ctx.module_globals` BY SPELLING — so
# the shadow's `{ x = 5 }` and its `bank.x = 99` both landed in the module's
# word, and `read()` answered 99.
#
# Measured at 09b20611: `0 99 99`. The identical program with the shadow spelled
# `vault` answered `0 99 7`, which is the answer — nothing in `bump` writes the
# module's `bank`, so `read()` sees `poke`'s 7. Spelling decided identity and
# the program got a confident wrong number.
#
# The control in the other direction is `examples/keyed_table_write_wins.id`:
# there the write really IS the module's and must keep its storage.
# expect: 0 99 7
cell: { x: i64 }
bank = { x = 1 }

poke: i64 = ()
  bank.x = 7
  0

bump: i64 = ()
  bank: cell = { x = 5 }
  bank.x = 99
  bank.x

read: i64 = ()
  bank.x

print(poke())
print(bump())
print(read())
