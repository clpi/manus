
config = {
  name = "duo",
  version = "0.5.0",
  workers = 8
}


enum Direction
  North
  South
  East
  West
end
Point: { x: f64, y: f64 }

name: { name: str }
color: { color: str }
Sprite: { ..name, ..color, x: f64 }

defaults = { color = "blue", size = 10 }
custom = { ..defaults, color = "red" }

fun map(t, f)
  result = {}
  for i = 1, t:len()
    result[i] = f(t[i])
  end
  return result
end

items = {
  { name = "alpha", score = 95 },
  { name = "beta", score = 87 },
  { name = "gamma", score = 92 }
}
names = map(items, .name)
scores = map(items, .score)

total = 0
for s in scores
  total = total + s
end

grade = (if total > 250 "excellent" else "good" end)

point = {
  x = 3.0,
  y = 4.0
}



sprite: Sprite = { name = "hero", color = "blue", x = 5.0 }
print("RESULT config " .. (config.name .. (" v" .. config.version)))
print("RESULT composition " .. (sprite.name .. (" " .. (sprite.color .. (" " .. to(str)(sprite.x))))))
print("RESULT spread " .. (custom.color .. (" " .. to(str)(custom.size))))
print("RESULT projections " .. (names[1] .. ("," .. (names[2] .. ("," .. names[3])))))
print("RESULT iteration " .. to(str)(total))
print("RESULT grade " .. grade)
print("RESULT newline_fields " .. to(str)(point.x + point.y))
print("RESULT workers " .. to(str)(config.workers))
