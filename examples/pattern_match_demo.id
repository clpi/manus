
enum Shape
    Circle(radius: f64)
    Rect(w: f64, h: f64)
    Triangle(base: f64, height: f64)
    Point

area: f64 = (s: Shape)
    a: f64 = 0.0
    match s
        Shape.Circle(r) a = 3.14159265 * r * r
        Shape.Rect(w, h) a = w * h
        Shape.Triangle(b, h) a = 0.5 * b * h
        Shape.Point a = 0.0
    a

tag_of: i64 = (s: Shape)
    tag: i64 = -1
    match s
        Shape.Circle(_) tag = 0
        Shape.Rect(_, _) tag = 1
        Shape.Triangle(_, _) tag = 2
        Shape.Point tag = 3
    tag

is_unit_square: bool = (s: Shape)
    yes: bool = false
    match s
        Shape.Rect(1.0, 1.0) yes = true
        _ yes = false
    yes

sum3: f64 = (nums: any)
    result: f64 = 0.0
    match nums
        [a, b, c] result = a + b + c
        _ result = -1.0
    result

head: any = (xs: any)
    h: any = nil
    match xs
        [first, _] h = first
        [only] h = only
        _ h = nil
    h

circ: Shape = Shape.Circle(2.0)
rect: Shape = Shape.Rect(3.0, 4.0)
unit: Shape = Shape.Rect(1.0, 1.0)
print(area(circ))
print(area(rect))
print(tag_of(Shape.Point))
print(is_unit_square(rect))
print(is_unit_square(unit))
v3 = {10, 20, 30}
print(sum3(v3))
print(head(v3))
