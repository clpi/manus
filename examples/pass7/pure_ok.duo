-- Positive half of the `@pure` contract pair. The twin is
-- examples/compile_fail/pure_module_state.duo.
--
-- `tripled` depends on its argument and on nothing else, so lowering it to
-- `__attribute__((const))` is a promise the body keeps: two calls with the same
-- argument MUST answer the same thing, and here they do. `scale` is read at the
-- CALL SITE, outside the contract, which is where module state is allowed to be.
scale: i64 = 3

@pure
tripled(x: i64): i64
    x * 3
end

main(): i64
    tripled(scale)
end
