-- F-13813-4: branch-assigned implicit locals must be visible after if/else

branch_sum(cond: bool): i64
    if cond
        v = 10
    else
        v = 20
    end
    v
end

branch_str(cond: bool): str
    if cond
        msg = "yes"
    else
        msg = "no"
    end
    msg
end

main(): i64
    if branch_sum(true) != 10 return 1 end
    if branch_sum(false) != 20 return 2 end
    if branch_str(true) != "yes" return 3 end
    if branch_str(false) != "no" return 4 end
    print("PASS branch_scope_smoke")
    0
end
