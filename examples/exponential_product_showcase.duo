-- Exponential product: cartesian codegen + @meta.derive.all + module introspection
-- Run: duo run examples/exponential_product_showcase.duo

concept HasXY
    x: f64
    y: f64
end

concept HasId
    id: i64
end

type Point = { x: f64, y: f64 }
type Pair = { x: f64, y: f64 }

type Entity = { id: i64, name: str }
type Node = { id: i64, next: i64 }

@meta.define.derive("TouchApi", fun generate(meta) -> str
    acc = "/* " .. meta.name .. " */\n"
    for i = 1, #meta.fields
        f = meta.fields[i]
        acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    end
    acc
end)

@meta.derive.all("HasXY", TouchApi)

fun pair_line(a, b) -> str
    a.name .. "x" .. b.name .. ";"
end

fun type_line(meta) -> str
    meta.name .. ":"
end

PAIRS = @meta.product("HasXY", "HasId", pair_line)
FILTERED = @meta.map("HasXY+HasId", type_line)
TYPE_NAMES = @meta.type.names()

_meta = { tag = "exponential_product" }

print("=== exponential product showcase ===")
print("pairs = " .. PAIRS)
print("filtered = " .. FILTERED)
print("type_names = " .. TYPE_NAMES)
print("ok")
