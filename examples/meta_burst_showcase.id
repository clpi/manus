# @comp.burst: one module directive → derive.all + emit.omni (exponential ceiling breaker)
# Run: duo run examples/meta_burst_showcase.id

concept HasXY
  x: f64
  y: f64

concept HasTag
  tag: str

point: { x: f64, y: f64, tag: str }
pair: { x: f64, y: f64, tag: str }

# One line: apply TouchApi to all HasXY types AND emit omni C (ceiling + sweep comment).

@comp.define.derive("TouchApi", generate: str = (meta)
    acc = ""
    for i = 1, meta.fields:len()
        f = meta.fields[i]
        acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    acc
)

@comp.burst("HasXY", TouchApi, "HasTag")

mark: str = meta
meta.name .. ";"

COMBOS = @comp.catalog("combinators")
SWEEP = @comp.map("HasXY", mark)

print("=== meta burst showcase ===")
print("combinators_has_burst = " .. to(str)(@comp.str.contains(COMBOS, "meta.burst")))
print("sweep = " .. SWEEP)
print("point ok = true")
print("ok")
