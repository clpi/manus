x: int = 3
y: i32 = 8
exp: float = 99.3
age: f32 = 29.0

getAge = (self)
    self.age

setAge = (self, age: num)
    self.age = age

props = {
    hobbies: [string] = {
        "golf",
        "table tennis",
    },
    hasHobby = (self, hobby: string)
        self.hobbies:contains(hobby)
    end,
}

incExp = (self)
    self.age += 0.1
