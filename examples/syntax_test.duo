-- Syntax highlighting test for Duo

fun greet(name: str): str
    return "Hello, " .. name
end

fun add<T>(a: T, b: T): T
    return a + b
end

local result: i64 = ##1 + 2
global counter: i64 = 0

struct Point
    x: f64
    y: f64
end

fun calculate(): void
    local x: i64 = 10
    local y: i64 = 20
    
    if x > y then
        print "x is greater"
    else
        print "y is greater"
    end
    
    while x < 100 do
        x = x + 1
    end
    
    for i = 1, 10 do
        print i
    end
end

