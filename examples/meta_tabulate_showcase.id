
squares = @comp.tabulate(16, fun(m)
  to(str)(m.index * m.index)
)
print("=== @comp.tabulate: squares ===")
print(squares)

init = @comp.tabulate(8, fun(m)
  to(str)(m.index * 3 + 1)
)
print("=== @comp.tabulate: arithmetic progression ===")
print(init)

parity = @comp.tabulate(10, fun(m)
  to(str)(m.index % 2)
)
print("=== @comp.tabulate: parity ===")
print(parity)
