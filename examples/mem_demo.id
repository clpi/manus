
arena_new = (size: i64)
  {
    _bufs = {},
    _offset = 0,
    _capacity = size or 65536,
    _total = 0
  }

arena_alloc = (self, bytes: i64)
  if self._offset + bytes > self._capacity
    self._bufs(self._bufs:len() + 1) = ".":rep(bytes)
    self._offset = 0
  ptr =
    addr = self._total + self._offset
    size = bytes
  self._offset = self._offset + bytes
  ptr

arena_used: i64 = self
self._total + self._offset

arena_free_all = self
self._bufs = {}
self._offset = 0
self._total = 0

arena = arena_new(4096)
ptr1 = arena_alloc(arena, 256)
ptr2 = arena_alloc(arena, 512)
print("Arena used: " .. to(str)(arena_used(arena)))
arena_free_all(arena)
print("Arena after free: " .. to(str)(arena_used(arena)))

align_up: i64 = (n: i64, alignment: i64)
  if n % alignment == 0
    return n
  n + alignment - n % alignment

align_down: i64 = (n: i64, alignment: i64)
  n - n % alignment

is_power_of_two: bool = (n: i64)
  if n <= 0
    return false
  while n > 1
    if n % 2 != 0
      return false
    n = n // 2
  true

print("align_up(13, 8): " .. to(str)(align_up(13, 8)))
print("align_down(13, 8): " .. to(str)(align_down(13, 8)))
print("is_power_of_two(16): " .. to(str)(is_power_of_two(16)))
print("is_power_of_two(15): " .. to(str)(is_power_of_two(15)))
