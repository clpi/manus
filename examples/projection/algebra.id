# @corpus current
# law.paren.one / law.projection.head — relation projection is not curry.
#
# `to(str) = (value)` declares relation to with projection target str and
# subject value. `value:to(str)` invokes with subject first — not to(str)(value).
#
# expect: 17

to(str) = (value)
    value:to(str)

read(number) = (lx, b)
    lx:read(number)(b)

main: i64 = ()
    n: i64 = 17
    print(n:to(str))
    0
