# @corpus current
# law.projection.one / law.paren.one / law.projection.head — one projection algebra;
# relation projection is not curry.
#
# Declaration: `to(str) = (value)` → relation to, projection str, subject value.
# Invocation ladder (shortest unique form): value:to(str) → value
# when graph proves each step (INFER-ONE). value:to() is not a canonical rung.
#
# expect: 17

to(str) = (value)
    value:to(str)

# Declaration projection uses a concrete descriptor — not an adjective protocol.
read(i64) = (lx, b)
    lx:read(i64)(b)

n: i64 = 17
print(n:to(str))
