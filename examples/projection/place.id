# @corpus current
# THE ENVIRONMENT IS A PLACE — the write face of the injected `os` world.
#
# The ruling, in the user's own words: "and setting an env var
# env("HOME") = ...". `os` is default-injected, so the bare spelling is the
# CANONICAL one and the anchor is the disambiguator, not the other way round.
# All four faces below name ONE edge, POSIX `setenv(k, v, 1)`:
#
#     env(k) = v        canonical
#     env k = v         canonical, string face (APPLY-ONE: the face is a
#                       recorded fact about how it was written, never a
#                       different application)
#     os.env(k) = v     lawful where an anchor disambiguates
#     os.env[k] = v     legacy bracket accessor
#
# THE OVERWRITE FLAG IS 1, so a store always takes effect — the last write
# wins, which is what the four checks below read back.
#
# THE EMPTY STRING IS NOT SPECIAL. `env(k) = ""` sets the variable to the
# EMPTY value and leaves it PRESENT; it does not remove it. Removal is
# `env:remove(k)`, a different edge — see `examples/projection/remove.id`.
#
# An exit-status fixture: it prints nothing, so the agreement count IS the
# answer. Both backends must produce it.
#
#
# CACHE NOTE, and it is not incidental. The compiler keys a build cache
# (`/tmp/idol-cache-*`) on SOURCE TEXT, and with fifteen lanes compiling on one
# machine an entry can be written by a compiler that no longer exists. While
# this fixture was being measured, `gate/place.sh` alternated between the broken
# and the fixed verdict across consecutive runs of the same script against the
# same binary — the "fixed" readings were cache hits on artifacts built by a
# patched compiler. `gate/place.sh` now gives every probe a per-run nonce for
# exactly this reason; a corpus fixture cannot, so its ledger row in
# `gate/expect.sh` is measured with the cache in whatever state it is in.
# expect-exit: 5

main: i64 = ()
    n = 0

    env("IDOLPLACE") = "one"
    if env("IDOLPLACE") == "one"
        n += 1

    env "IDOLPLACE" = "two"
    if env("IDOLPLACE") == "two"
        n += 1

    os.env("IDOLPLACE") = "three"
    if env("IDOLPLACE") == "three"
        n += 1

    os.env["IDOLPLACE"] = "four"
    if env("IDOLPLACE") == "four"
        n += 1

    # The empty value is a VALUE. `or` takes the fallback only on ABSENCE, so
    # a variable set to "" must not take it — that is the distinction the
    # removal edge exists to preserve, checked here from the write side.
    env("IDOLPLACE") = ""
    if (env("IDOLPLACE") or "ABSENT") == ""
        n += 1

    n
