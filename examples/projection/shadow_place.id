
localwins: i64 = ()
    env = (10, 20, 30)
    env(2) = 99
    env(2)

localread: i64 = ()
    env = (7, 8, 9)
    env(3)

worldreaches: i64 = ()
    os.env("IDOLSHADOW") = "world"
    if os.env("IDOLSHADOW") == "world"
        1
    else
        0

main: i64 = ()
    n = 0
    if localwins() == 99
        n += 1
    if localread() == 9
        n += 1
    if worldreaches() == 1
        n += 1
    n
