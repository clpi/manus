# @corpus current
# AN INJECTED WORLD ADDS REACH AND NEVER TAKES A NAME — the WRITE face.
#
# The read-side corollary is already gated (`gate/shadow.id`, `gate/access.id`)
# and was violated twice in the wild: a user relation `arg(v) = v * 7` silently
# returned 0 instead of 42, and `lib/build.id` defines its own `env` so the bare
# spelling silently read the local function. The write face has the SAME hazard
# and it is sharper, because `a[i]` canonicalizes to `a(i)`: `env(k) = v` is
# also exactly how a table named `env` is written to. Without the guard a local
# table store is silently rewritten into a `setenv` call — a wrong answer that
# also escapes the process.
#
# `localwins` is the whole point: the store must land in the LOCAL TABLE, and
# nothing about it may reach the environment. `gate/place.sh` checks the second
# half by disassembling this file's binary and requiring NO `_setenv` import in
# the shadowed shape.
#
# `worldreaches` is the POSITIVE CONTROL, without which this file also passes on
# a compiler that deleted the projection entirely — the most likely way to
# "fix" a capture defect.
#
#
# CACHE NOTE, and it is not incidental. The compiler keys a build cache
# (`/tmp/idol-cache-*`) on SOURCE TEXT, and with fifteen lanes compiling on one
# machine an entry can be written by a compiler that no longer exists. While
# this fixture was being measured, `gate/place.sh` alternated between the broken
# and the fixed verdict across consecutive runs of the same script against the
# same binary — the "fixed" readings were cache hits on artifacts built by a
# patched compiler. `gate/place.sh` now gives every probe a per-run nonce for
# exactly this reason; a corpus fixture cannot, so its ledger row in
# `gate/expect.sh` is measured with the cache in whatever state it is in.
# expect: 3

localwins: i64 = ()
    env = (10, 20, 30)
    env(2) = 99
    env(2)

localread: i64 = ()
    env = (7, 8, 9)
    env(3)

worldreaches: i64 = ()
    os.env("IDOLSHADOW") = "world"
    if os.env("IDOLSHADOW") == "world"
        1
    else
        0

main: i64 = ()
    n = 0
    if localwins() == 99
        n += 1
    if localread() == 9
        n += 1
    if worldreaches() == 1
        n += 1
    n
