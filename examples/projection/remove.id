
main: i64 = ()
    n = 0

    env("IDOLREMOVE") = ""
    if (env("IDOLREMOVE") or "ABSENT") == ""
        n += 1

    env:remove("IDOLREMOVE")
    if (env("IDOLREMOVE") or "ABSENT") == "ABSENT"
        n += 1

    os.env("IDOLREMOVE") = "back"
    if (env("IDOLREMOVE") or "ABSENT") == "back"
        n += 1

    os.env:remove("IDOLREMOVE")
    if (env("IDOLREMOVE") or "ABSENT") == "ABSENT"
        n += 1

    n
