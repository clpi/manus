-- ml_showcase.duo — Mojo-class ML workflow in Duo (minimal syntax)
--
-- Demonstrates: @device, @autodiff, @profile, nn.build, ml.* intrinsics, std.ml.*

NN = req "std.ml.nn"
Ops = req "std.ml.ops"
Shape = req "std.ml.shape"
Device = req "std.ml.device"
Fusion = req "std.ml.fusion"
Transformer = req "std.ml.transformer"
Deploy = req "std.ml.deploy"

@device(.auto)
@profile
bench_all(): f64
    s = 0.0
    s += ml.matmul_256()
    s += ml.softmax_1k()
    s += ml.gelu_1k()
    s += ml.layernorm_1k()
    s += ml.dot_1m()
    s += ml.conv1d()
    return s
end

@autodiff
@device(.auto)
loss_mnist(model, x, target): f64
    pred = NN.forward(model, x)
    return NN.cross_entropy(pred, target)
end

main()
    print("=== Duo ML Showcase (Mojo-class path) ===")
    print("")

    -- Shape templates (compile-time dims as const + runtime assert)
    spec = Shape.mnist_mlp()
    print(string.format("MNIST MLP: in=%d h1=%d h2=%d out=%d",
        spec.input.rows, spec.hidden1.rows, spec.hidden2.rows, spec.output.rows))

    -- Device placement metadata
    dev = Device.best()
    print("Device: auto (compiler selects CPU/Metal/CUDA)")

    -- Model = nn { linear; relu; … } (desugars to std.ml.nn.build)
    model = nn {
        linear(784, 256)
        relu
        linear(256, 10)
        softmax
    }
    print(string.format("Model layers: %d", model.n_layers))

    -- `@grad` desugars to std.ml.autodiff:grad (pairs with @autodiff on loss)
    grad_hook = @grad(loss_mnist, model)

    fused = Fusion.fuse_sequential(model)
    print(string.format("Fused layers: %d (rules: %d)", fused.n_layers, #Fusion.rules()))

    tx = Transformer.stack(2, 8, 64)
    print(string.format("Transformer: %d layers x %d heads x dim %d",
        tx.layers, tx.heads, tx.dim))

    pipe = Deploy.edge_pipeline(model)
    print(string.format("Edge deploy: target=%s simd=%s",
        Deploy.wasm_opts().target, to(str)(Deploy.wasm_opts().simd)))

    -- Native kernel checksum (validates ml.* path)
    checksum = bench_all()
    print(string.format("Kernel checksum: %.6f", checksum))

    -- Stdlib tensor path
    x = Ops.matmul(
        { rows = 4, cols = 4, size = 16, data = { [1]=1,[2]=0,[3]=0,[4]=0,[5]=0,[6]=1,[7]=0,[8]=0,[9]=0,[10]=0,[11]=1,[12]=0,[13]=0,[14]=0,[15]=1,[16]=0 } },
        { rows = 4, cols = 4, size = 16, data = { [1]=2,[2]=0,[3]=0,[4]=0,[5]=0,[6]=2,[7]=0,[8]=0,[9]=0,[10]=0,[11]=2,[12]=0,[13]=0,[14]=0,[15]=2,[16]=0 } }
    )
    print(string.format("4x4 matmul corner: %.1f", x.data[1]))

    print("")
    print("PASS — showcase complete")
end

main()
