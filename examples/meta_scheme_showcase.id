-- @comp.scheme: declarative program scheme -> full native C implementation
-- Run: duo run examples/meta_scheme_showcase.id
--
-- One pipe-separated declaration list -> C struct typedefs + function
-- signatures, synthesized through a per-unit template. Declaring a record type
-- once yields a typed struct; declaring operations once yields their signatures.
-- Comptime-only: folds to a native C string literal (no lua_Value).

-- Declare program structure once: a record type and two operations on it.
TYPES = "type Vec3 { x: double, y: double, z: double }"
FNS   = "fn add(a: Vec3, b: Vec3) -> Vec3 | fn sub(a: Vec3, b: Vec3) -> Vec3"

-- One template line per unit kind -> a complete, typed C module fragment.
STRUCTS = @comp.scheme(TYPES, "typedef struct { $fields; } $name;\n")
SIGS    = @comp.scheme(FNS,   "$ret $name($params);\n")

print("=== @comp.scheme showcase ===")
print(STRUCTS)
print(SIGS)
print("RESULT scheme_ok = true")
