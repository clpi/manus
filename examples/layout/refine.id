# @corpus current
# The refinement spelling of examples/layout/attr.id.
#
# Packed/aligned/endian/at-address are "layout FACTS", and
# LAW-STRATA makes `&` the refinement edge that carries them. The `@packed` /
# `@align(n)` attributes in the sibling file store exactly the same fact
# through `ast.Attribute`; this file stores it on the descriptor.
#
# Both files print 6 and emit byte-identical C. That equality is the point:
# the attribute was never a second mechanism, only a second spelling.
global gp: { x: i8, y: i64 } = { x = 1, y = 2 }

p: { x: i8, y: i64 } =
  x = 3
  y = 4

print(gp.y + p.y)
