# @corpus current
#
# §20's leb128 encoder ends `while v >= 0x80 out:write(…); v >>= 7`, and that
# one operator was the LAST wall in front of the whole block. GAP-025 had it
# filed as a two-lexer change plus a regeneration of
# `src/duo_lexer_tokenize.c`, because it assumed a new TOKEN was needed.
# It was not: `>>=` IS `>>` immediately followed by `=`, and ADJACENCY is the
# whole rule. The two lexers stay field-for-field identical and the generated
# artifact does not move — this is a grammar fact, not a lexical one.
#
# All four are asserted BY VALUE with operands that separate them: 64>>3 and
# 1<<4 are not each other's answers, and 8|5 = 13 while 8&5 = 0, so a wrong
# operator mapping cannot land on the right number by accident.
#
# `e` is the negative control and the reason adjacency is not decoration: it
# is a bare `e >> 1` expression statement, which must still be an EXPRESSION
# and leave `e` at 5. The spaced form `a >> = 3` still reports "expected
# expression, got '='" exactly as it did before.
# expect: 8 16 13 8 5

main: i64 = ()
    a = 64
    a >>= 3
    b = 1
    b <<= 4
    c = 8
    c |= 5
    d = 12
    d &= 10
    e = 5
    e >> 1
    print("{a} {b} {c} {d} {e}")
    0
end
