# Pass 34 PH1 — L1 module sealing witness + direct cross-module call.
helper = l1_sealed_helper
why: str = @comp.why.module(helper)
expected = "module_sealed=true; req binding frozen after load; cross-module calls may devirtualize"
if why != expected
  print("FAIL: module_sealed witness mismatch")
  print("  got: " .. why)
  os.exit(1)

result: i64 = helper.add(40, 2)
if result != 42
  print("FAIL: helper.add returned wrong value")
  os.exit(2)

print("pass34_l1_module_sealed: PASS")
