-- Pass 16 M1 — token descriptor + native record returns + keyword classify.
-- Full std.compiler.lexer embed: remaining blockers are same-module self-calls
-- and `any`-typed pending_hints (see docs/plans/pass16_self_hosted_compiler.md).

Classify = req "std.token.classify"
Token = req "std.compiler.token"

Loc: {
    file: str,
    line: i64,
    col: i64
}

make_loc(): Loc
    return { file = "proof.duo", line = 42, col = 7 }
end

main(): i64
    if Classify.classify("fun") != Token.KIND_FUN return 1 end
    if Classify.classify("end") != Token.KIND_END return 2 end
    if Classify.classify("i64") != Token.KIND_I64 return 3 end
    if Token.KIND_EOF != 105 return 4 end
    loc = make_loc()
    if loc.line != 42 return 5 end
    if loc.col != 7 return 6 end
    0
end
