-- @comp.expand: one call → O(types × fields) derive C (+ optional sweep comment)
-- Run: duo run examples/meta_expand_showcase.duo

concept HasXY
    x: f64
    y: f64
end

type Point = { x: f64, y: f64 }
type Pair = { x: f64, y: f64 }

@comp.assert(@comp.satisfies(Point, "HasXY"))

@comp.define.derive("TouchApi", fun generate(meta) -> str
    acc = ""
    for i = 1, #meta.fields
        f = meta.fields[i]
        acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    end
    acc
end)

fun registry_line(meta) -> str
    meta.name .. ";"
end

-- Derive sweep only (2-arg form)
@c.emit(@comp.expand("HasXY", TouchApi))

-- Registry sweep separately (comptime string, not C)
SWEEP = @comp.sweep("HasXY", registry_line)

print("=== meta.expand showcase ===")
print("Point ok = true")
print("sweep = " .. SWEEP)
print("ok")
