# Deep nested combinator algebra (G-059): arbitrary depth inside callbacks.
# Run: duo run examples/meta_nested_algebra_showcase.id
#
# Proves match→interpolate, match→zip(folded concat), and power→each→template
# all fold to native C with no lua_Value and no dead closure thunks.

# Level A: match callback calls interpolate (original G-059 repro)
TYPEDEFS = @comp.match("i32|i64|f64", fun(m)
    @comp.interpolate("typedef {name} duo_t_{idx};\n", {name = m.pattern, idx = to(str)(m.index)})
end)

# Level B: match callback calls zip with folded-concat specs
OPS = "add|" .. "mul"
PAIRS = @comp.match("i32|i64", fun(m)
    @comp.zip(m.pattern .. "|f64", OPS, fun(p)
        p.a .. "_" .. p.b .. " "
    end)
end)

# Level C: power → each → template (full exponential cascade)
concept HasXY
    x: f64
    y: f64

Vec2: { x: f64, y: f64 }
Vec3: { x: f64, y: f64, z: f64 }
Pt: { x: f64, y: f64 }

SUBSETS = @comp.power("HasXY", fun(s)
    s.name .. ";"
end)

CASCADE = @comp.each(SUBSETS, fun(frag)
    @comp.template(frag.name .. ":int64_t", "int64_t id_$0() { return $0 }\n")
end)

TD_N = @comp.str.countlines(TYPEDEFS)
CASCADE_N = @comp.str.countlines(CASCADE)

has_i32_add = @comp.str.contains(PAIRS, "i32_add")
has_i64_mul = @comp.str.contains(PAIRS, "i64_mul")
has_f64_mul = @comp.str.contains(PAIRS, "f64_mul")

ok = (TD_N == 3 and has_i32_add and has_i64_mul and has_f64_mul and CASCADE_N == 7)
print("=== nested algebra showcase ===")
print("typedef_lines = " .. to(str)(TD_N) .. "  (expect 3)")
print("nested_zip_ok = " .. to(str)(has_i32_add and has_i64_mul and has_f64_mul))
print("cascade_lines = " .. to(str)(CASCADE_N) .. "  (expect 7 = 2^3-1)")
print("RESULT nested_algebra_ok = " .. to(str)(ok))
