# @comp.generate → @comp.each — O(ops×types) cartesian then per-fragment re-expansion
# Run: duo run examples/meta_generate_each_showcase.id

CONSTRAINTS = "ops: add|sub\ntypes: i64:int64_t|f64:double\ntemplate: /* gen[$0:$1] */\n"

GEN = @comp.generate(CONSTRAINTS, "")

stamp: str = (frag: str)
  "/* each[" .. to(str)(frag.index) .. "/" .. to(str)(frag.count) .. "] " .. frag.name .. " */\n"

EXPANDED = @comp.each(GEN, stamp)

# The parameter carried NO annotation, so codegen inferred `int64_t` for it
# while the body used it as a string: `strs:len()` and `duo_str_sub_cstr(s, ...)`
# on an int64_t, three -Wint-conversion errors, and the whole translation unit
# was rejected. A bare parameter is not "untyped" here, it is typed WRONG.
count_lines: i64 = (s: str)
  n = 0
  for i = 1, s:len()
    if s:sub(i, i) == "\n"
      n = n + 1
  n

LINES = count_lines(EXPANDED)

print("=== @comp.generate → @comp.each ===")
print(EXPANDED)
print("fragments = " .. to(str)(LINES) .. "  (expect 4 = 2 ops × 2 types)")
print("RESULT generate_each_ok = " .. to(str)(LINES == 4))
