-- Pass 27 P1 — Ward bounded cursor + LEB128 + error-code return pack (direct ARM64).
Point: @{ x: f64, y: f64 }

wasm_header = { 0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00 }
leb_bytes = { 0xE5, 0x8E, 0x26 }

read_u8_at(base: i64, off: i64): i64
    @comp.native.load.u8(base, off)
end

length2(p: Point): f64
    p.x * p.x + p.y * p.y
end

decode_leb128_bounded(base: i64, len: i64): i64
    if len < 3
        return 1
    end
    b0: i64 = read_u8_at(base, 0)
    b1: i64 = read_u8_at(base, 1)
    b2: i64 = read_u8_at(base, 2)
    v: i64 = (b0 & 0x7F) | ((b1 & 0x7F) << 7) | ((b2 & 0x7F) << 14)
    if v != 624485
        return 4
    end
    0
end

main(): i64
    p: Point = { x = 3.0, y = 4.0 }
    if length2(p) != 25.0
        return 101
    end

    hdr = wasm_header
    leb = leb_bytes

    if read_u8_at(hdr, 0) != 0
        return 201
    end
    if read_u8_at(hdr, 3) != 0x6D
        return 202
    end
    if read_u8_at(hdr, 4) != 1
        return 203
    end

    lerr: i64 = decode_leb128_bounded(leb, 3)
    if lerr != 0
        return 210 + lerr
    end

    if decode_leb128_bounded(leb, 2) != 1
        return 302
    end

    0
end
