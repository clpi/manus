# Typed pipeline: x |> f |> g lowers to direct C calls (no lua_invoke)
# Run: duo run examples/pipeline_typed_showcase.id

twice: i64 = (x: i64)
  x * 2

inc: i64 = (x: i64)
  x + 1

run_chain: i64 = (n: i64)
  n |> twice |> inc

print("=== pipeline typed showcase ===")
print("3 |> twice |> inc = " .. to(str)(run_chain(3)))
print("ok")
