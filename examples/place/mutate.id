
global ring: i64 = 0

bump(): i64
  ring = 1
  7

probe(): i64
  bump()

shadow(): i64
  ring: i64 = 5
  ring

deep(): i64
  ring = 2
  if ring > 100
    ring: i64 = 5
    return ring
  ring = ring * 3
  3

check(): i64
  got: i64 = probe()
  if got != 7
    print("place mutate: probe did not answer 7, it answered")
    print(got)
    return 1
  if ring != 1
    print("place mutate: the module write was ERASED, ring is")
    print(ring)
    return 2
  hid: i64 = shadow()
  if hid != 5
    print("place mutate: the shadowing local did not answer 5, it answered")
    print(hid)
    return 3
  if ring != 1
    print("place mutate: the shadow's declaration MOVED the module word, ring is")
    print(ring)
    return 6
  low: i64 = deep()
  if low != 3
    print("place mutate: deep did not answer 3, it answered")
    print(low)
    return 4
  if ring != 6
    print("place mutate: a write beside the inner declaration missed the module word, ring is")
    print(ring)
    return 5
  print("place mutate: OK")
  0

check()
