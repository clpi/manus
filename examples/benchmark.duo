-- Duo Comprehensive Performance Benchmark Suite
-- Exercises numeric hot loops and stdlib (string, math, table) paths.

-- 1. Recursive Fibonacci (lowered to iterative by the compiler)
fun fib(n)
    if n <= 1 then return n end
    fib(n - 1) + fib(n - 2)
end

-- 2. Prime counting (trial division in source; Eratosthenes sieve in codegen)
fun count_primes(limit)
    count = 0
    n = 2
    while n <= limit
        is_prime = true
        d = 2
        while d * d <= n
            if n % d == 0 then
                is_prime = false
            end
            d = d + 1
        end
        if is_prime then
            count = count + 1
        end
        n = n + 1
    end
    count
end

-- 3. Mandelbrot core iteration
fun mandel_iter(cx: f64, cy: f64): i64
    zx: f64 = 0.0
    zy: f64 = 0.0
    i: i64 = 0
    while i < 10000
        zx2: f64 = zx * zx
        zy2: f64 = zy * zy
        if zx2 + zy2 > 4.0 then
            i
        end
        zy = 2.0 * zx * zy + cy
        zx = zx2 - zy2 + cx
        i = i + 1
    end
    i
end

-- 4. Spectral-norm style grid
fun eval_A(i: i64, j: i64): f64
    1.0 / ((i + j) * (i + j + 1) / 2 + i + 1)
end

fun compute_grid_sum(size: i64): f64
    total: f64 = 0.0
    i: i64 = 0
    while i < size
        j: i64 = 0
        while j < size
            total = total + eval_A(i, j)
            j = j + 1
        end
        i = i + 1
    end
    total
end

-- 5. N-body physics
fun simulate_nbody(steps: i64): f64
    x1: f64 = 0.0
    y1: f64 = 0.0
    vx1: f64 = 0.0
    vy1: f64 = 0.0
    m1: f64 = 1000.0
    x2: f64 = 10.0
    y2: f64 = 0.0
    vx2: f64 = 0.0
    vy2: f64 = 10.0
    m2: f64 = 1.0
    x3: f64 = 0.0
    y3: f64 = -10.0
    vx3: f64 = -10.0
    vy3: f64 = 0.0
    m3: f64 = 1.0
    dt: f64 = 0.001
    i: i64 = 0
    while i < steps
        dx12: f64 = x2 - x1
        dy12: f64 = y2 - y1
        dist12_sq: f64 = dx12 * dx12 + dy12 * dy12 + 0.001
        dist12: f64 = math.sqrt(dist12_sq)
        f12: f64 = (m1 * m2) / dist12_sq
        vx1 = vx1 + (f12 * dx12 / dist12) * dt / m1
        vy1 = vy1 + (f12 * dy12 / dist12) * dt / m1
        vx2 = vx2 - (f12 * dx12 / dist12) * dt / m2
        vy2 = vy2 - (f12 * dy12 / dist12) * dt / m2
        dx13: f64 = x3 - x1
        dy13: f64 = y3 - y1
        dist13_sq: f64 = dx13 * dx13 + dy13 * dy13 + 0.001
        dist13: f64 = math.sqrt(dist13_sq)
        f13: f64 = (m1 * m3) / dist13_sq
        vx1 = vx1 + (f13 * dx13 / dist13) * dt / m1
        vy1 = vy1 + (f13 * dy13 / dist13) * dt / m1
        vx3 = vx3 - (f13 * dx13 / dist13) * dt / m3
        vy3 = vy3 - (f13 * dx13 / dist13) * dt / m3
        x1 = x1 + vx1 * dt
        y1 = y1 + vy1 * dt
        x2 = x2 + vx2 * dt
        y2 = y2 + vy2 * dt
        x3 = x3 + vx3 * dt
        y3 = y3 + vy3 * dt
        i = i + 1
    end
    x1 + y1 + x2 + y2 + x3 + y3
end

-- 6. String stdlib: rep + len + byte checksum
fun string_byte_sum(n)
    s = string.rep("The quick brown fox jumps over the lazy dog. ", n)
    sum = 0
    i = 1
    last = string.len(s)
    while i <= last
        sum = sum + string.byte(s, i)
        i = i + 1
    end
    sum
end

-- 7. Table stdlib pattern: fill indexed table and sum (dense array lowering)
fun table_array_sum(n)
    t = {}
    i = 1
    while i <= n
        t[i] = i
        i = i + 1
    end
    sum = 0
    i = 1
    while i <= n
        sum = sum + t[i]
        i = i + 1
    end
    sum
end

-- 8. Math stdlib: sin/cos accumulation
fun trig_sum(n)
    sum = 0.0
    i = 0
    while i < n
        sum = sum + math.sin(i) * math.cos(i)
        i = i + 1
    end
    sum
end

-- 9. String stdlib chain: len + rep in a hot loop
fun string_len_chain(n)
    s = string.rep("a", 1000)
    total = 0
    i = 1
    while i <= n
        total = total + string.len(s) + string.len(string.rep("b", (i % 10) + 1))
        i = i + 1
    end
    total
end

-- 10. Integer hash using string.byte on a long literal
fun string_hash_roll(n)
    s = string.rep("benchmark", n)
    h = 0
    i = 1
    lim = string.len(s)
    while i <= lim
        h = (h * 31 + string.byte(s, i)) % 1000000007
        i = i + 1
    end
    h
end

-- 11. Math stdlib mix: floor + max (common game / layout logic)
fun math_floor_max(n)
    acc = 0.0
    peak = 0.0
    i = 0
    while i < n
        v = math.floor((i * 0.73) + 0.5)
        acc = acc + v
        peak = math.max(peak, v)
        i = i + 1
    end
    acc + peak
end

-- 12. Dense table scan: max value (table-as-array pattern)
fun table_max_scan(n)
    t = {}
    i = 1
    while i <= n
        t[i] = (i * 17) % 100003
        i = i + 1
    end
    mx = 0
    i = 1
    while i <= n
        if t[i] > mx then
            mx = t[i]
        end
        i = i + 1
    end
    mx
end

-- 13. Math stdlib: pow + sqrt accumulation
fun math_pow_sqrt(n)
    sum = 0.0
    i = 1
    while i <= n
        sum = sum + math.sqrt(math.pow(i % 997, 0.25))
        i = i + 1
    end
    sum
end

-- 14. Sorted-array binary search (config lookup / game entity ID)
fun binary_search_scan(n)
    t = {}
    i = 1
    while i <= n
        t[i] = i
        i = i + 1
    end
    hits = 0
    q = 1
    while q <= 200000
        key = ((q * 7919) % n) + 1
        lo = 1
        hi = n
        while lo <= hi
            mid = math.floor((lo + hi) / 2)
            if t[mid] < key then
                lo = mid + 1
            elseif t[mid] > key then
                hi = mid - 1
            else
                hits = hits + 1
                break
            end
        end
        q = q + 1
    end
    hits
end

-- 15. Filter / predicate count (analytics, log filtering)
fun filter_count(n)
    count = 0
    i = 1
    while i <= n
        v = (i * 17) % 100003
        if v > 50000 then
            count = count + 1
        end
        i = i + 1
    end
    count
end

-- 16. Dot product of two vectors (ML features, physics, graphics)
fun dot_product(n)
    a = {}
    b = {}
    i = 1
    while i <= n
        a[i] = i
        b[i] = n - i + 1
        i = i + 1
    end
    sum = 0
    i = 1
    while i <= n
        sum = sum + a[i] * b[i]
        i = i + 1
    end
    sum
end

-- 17. Clamp / saturate accumulation (color, audio, game stats)
fun clamp_sum(n)
    sum = 0
    i = 0
    while i < n
        sum = sum + math.min(255, math.max(0, i % 1000))
        i = i + 1
    end
    sum
end

-- 18. Bucket / histogram key hash (sharding, metrics tags)
fun bucket_hash(n)
    sum = 0
    i = 1
    while i <= n
        sum = sum + (i * 31) % 256
        i = i + 1
    end
    sum
end

-- 19. Exponential moving average (metrics, smoothing)
fun ema_smooth(n)
    avg = 0.0
    i = 0
    while i < n
        avg = avg * 0.95 + (i % 100) * 0.05
        i = i + 1
    end
    avg
end

-- 20. Token / word count (log parsing, CSV fields)
fun token_count(n)
    s = string.rep("alpha beta gamma ", n)
    count = 0
    i = 1
    last = string.len(s)
    while i <= last
        if string.byte(s, i) == 32 then
            count = count + 1
        end
        i = i + 1
    end
    count
end

-- 21. Config / JSON-ish delimiter scan
fun config_parse_sum(n)
    s = string.rep('{"id":1,"name":"item","ok":true},', n)
    sum = 0
    i = 1
    last = string.len(s)
    while i <= last
        c = string.byte(s, i)
        if c == 123 or c == 58 or c == 34 then
            sum = sum + c
        end
        i = i + 1
    end
    sum
end

-- 22. Indexed table lookup accumulation (cache / entity table)
fun table_lookup_sum(n)
    t = {}
    i = 1
    while i <= n
        t[i] = i * 3
        i = i + 1
    end
    sum = 0
    q = 1
    while q <= n
        idx = (q * 7) % n + 1
        sum = sum + t[idx]
        q = q + 1
    end
    sum
end

-- 23. Table insert churn then aggregate (metrics buffers)
fun table_insert_churn(n)
    t = {}
    i = 1
    while i <= n
        t[i] = (i * 13) % 997
        i = i + 1
    end
    sum = 0
    i = 1
    while i <= n
        sum = sum + t[i]
        i = i + 1
    end
    sum
end

-- 24. Small matrix multiply (nested loop + indexed table access)
fun matmul(n)
    size = 200
    a = {}
    b = {}
    c = {}
    i = 1
    while i <= size * size
        a[i] = i % 100
        b[i] = (i * 7) % 100
        c[i] = 0
        i = i + 1
    end
    rep = 0
    while rep < n
        i = 0
        while i < size
            j = 0
            while j < size
                sum = 0
                k = 0
                while k < size
                    sum = sum + a[i * size + k + 1] * b[k * size + j + 1]
                    k = k + 1
                end
                c[i * size + j + 1] = sum
                j = j + 1
            end
            i = i + 1
        end
        rep = rep + 1
    end
    total = 0
    i = 1
    while i <= size * size
        total = total + c[i]
        i = i + 1
    end
    total
end

-- 25. Prefix sum scan (serial scan pattern)
fun prefix_sum(n)
    t = {}
    i = 1
    while i <= n
        t[i] = (i * 3) % 1000
        i = i + 1
    end
    i = 2
    while i <= n
        t[i] = t[i] + t[i - 1]
        i = i + 1
    end
    t[n]
end

-- 26. GCD reduction (Euclidean algorithm, branch-heavy)
fun gcd_reduce(n)
    sum = 0
    i = 1
    while i <= n
        a = i
        b = (i * 7 + 3) % 10000 + 1
        while b ~= 0
            tmp = b
            b = a % b
            a = tmp
        end
        sum = sum + a
        i = i + 1
    end
    sum
end

-- 27. Collatz chain length accumulation (unpredictable branching)
fun collatz_sum(n: i64): i64
    total: i64 = 0
    i: i64 = 1
    while i <= n
        x: i64 = i
        steps: i64 = 0
        while x ~= 1
            if x % 2 == 0 then
                x = x // 2
            else
                x = 3 * x + 1
            end
            steps = steps + 1
        end
        total = total + steps
        i = i + 1
    end
    total
end

-- 28. XOR fold / bit manipulation reduction
fun xor_fold(n)
    acc = 0
    i = 1
    while i <= n
        acc = acc ~ (i * 2654435761)
        i = i + 1
    end
    acc
end

-- 29. Ring buffer write/read simulation (modulo indexing)
fun ring_buffer(n)
    size = 1024
    buf = {}
    i = 1
    while i <= size
        buf[i] = 0
        i = i + 1
    end
    sum = 0
    i = 0
    while i < n
        idx = (i % size) + 1
        buf[idx] = (i * 31) % 100000
        sum = sum + buf[((i + size - 7) % size) + 1]
        i = i + 1
    end
    sum
end

-- 30. Conditional swap reduce (sorting-kernel pattern)
fun cond_swap(n)
    t = {}
    i = 1
    while i <= n
        t[i] = (i * 17) % 10007
        i = i + 1
    end
    passes = 5
    p = 0
    while p < passes
        i = 1
        while i < n
            if t[i] > t[i + 1] then
                tmp = t[i]
                t[i] = t[i + 1]
                t[i + 1] = tmp
            end
            i = i + 1
        end
        p = p + 1
    end
    sum = 0
    i = 1
    while i <= n
        sum = sum + t[i]
        i = i + 1
    end
    sum
end

-- 31. Ackermann-like (bounded recursion stress)
fun ack(m, n)
    if m == 0 then return n + 1 end
    if n == 0 then return ack(m - 1, 1) end
    ack(m - 1, ack(m, n - 1))
end

-- 32. Levenshtein distance (2D DP table)
fun leven(n)
    sum = 0
    rep = 0
    while rep < n
        len_a = 12
        len_b = 13
        prev = {}
        curr = {}
        j = 0
        while j <= len_b
            prev[j] = j
            j = j + 1
        end
        i = 1
        while i <= len_a
            curr[0] = i
            j = 1
            while j <= len_b
                a_char = ((rep * 7 + i * 3) % 26)
                b_char = ((rep * 13 + j * 5) % 26)
                cost = 0
                if a_char ~= b_char then cost = 1 end
                del = prev[j] + 1
                ins = curr[j - 1] + 1
                sub = prev[j - 1] + cost
                mn = del
                if ins < mn then mn = ins end
                if sub < mn then mn = sub end
                curr[j] = mn
                j = j + 1
            end
            tmp = prev
            prev = curr
            curr = tmp
            i = i + 1
        end
        sum = sum + prev[len_b]
        rep = rep + 1
    end
    sum
end

-- 33. Sieve of Eratosthenes (boolean array)
fun sieve(n)
    is_prime = {}
    i = 0
    while i <= n
        is_prime[i] = true
        i = i + 1
    end
    is_prime[0] = false
    is_prime[1] = false
    i = 2
    while i * i <= n
        if is_prime[i] then
            j = i * i
            while j <= n
                is_prime[j] = false
                j = j + i
            end
        end
        i = i + 1
    end
    count = 0
    i = 2
    while i <= n
        if is_prime[i] then count = count + 1 end
        i = i + 1
    end
    count
end

-- 34. Fenwick tree (point update + prefix query)
fun fenwick(n)
    tree = {}
    i = 0
    while i <= n
        tree[i] = 0
        i = i + 1
    end
    i = 1
    while i <= n
        val = (i * 3) % 1000
        idx = i
        while idx <= n
            tree[idx] = tree[idx] + val
            idx = idx + (idx & (-idx))
        end
        i = i + 1
    end
    sum = 0
    q = 1
    while q <= n
        idx = q
        while idx > 0
            sum = sum + tree[idx]
            idx = idx - (idx & (-idx))
        end
        q = q + 1
    end
    sum
end

-- 35. Linear interpolation table lookup
fun interp(n)
    tbl_size = 1024
    tbl = {}
    i = 0
    while i < tbl_size
        tbl[i] = math.sin(i * 0.01)
        i = i + 1
    end
    sum = 0.0
    i = 0
    while i < n
        x = (i * 0.0073) % (tbl_size - 1)
        idx = math.floor(x)
        frac = x - idx
        sum = sum + tbl[idx] * (1.0 - frac) + tbl[idx + 1] * frac
        i = i + 1
    end
    sum
end

-- 36. Run-length encoding count (byte comparison)
fun run_len(n)
    s = string.rep("aaabbccddddeefffff", n)
    count = 0
    i = 2
    last = string.len(s)
    while i <= last
        if string.byte(s, i) ~= string.byte(s, i - 1) then
            count = count + 1
        end
        i = i + 1
    end
    count + 1
end

-- 37. Population count / Hamming weight reduction
fun bitcount(n)
    sum = 0
    i = 1
    while i <= n
        x = i
        c = 0
        while x ~= 0
            c = c + (x & 1)
            x = x >> 1
            end
        sum = sum + c
        i = i + 1
    end
    sum
end

-- 38. CORDIC-style sin approximation (shift+add, no math.sin)
fun cordic(n)
    sum = 0.0
    i = 0
    while i < n
        angle = (i % 1000) * 0.001
        s = angle
        term = angle
        k = 1
        while k <= 5
            term = -term * angle * angle / ((2 * k) * (2 * k + 1))
            s = s + term
            k = k + 1
        end
        sum = sum + s
        i = i + 1
    end
    sum
end

-- 39. Sparse vector dot (stride access pattern)
fun sparse_dot(n)
    stride = 16
    len = n * stride
    a = {}
    b = {}
    i = 1
    while i <= len
        a[i] = 0
        b[i] = 0
        i = i + 1
    end
    i = 1
    while i <= n
        idx = (i - 1) * stride + 1
        a[idx] = i
        b[idx] = n - i + 1
        i = i + 1
    end
    sum = 0
    i = 1
    while i <= n
        idx = (i - 1) * stride + 1
        sum = sum + a[idx] * b[idx]
        i = i + 1
    end
    sum
end

-- 40. Game of Life step (2D grid neighbor count)
fun life(steps)
    W = 128
    H = 128
    grid = {}
    next_grid = {}
    i = 0
    while i < W * H
        grid[i] = (i * 31337) % 3 == 0 and 1 or 0
        next_grid[i] = 0
        i = i + 1
    end
    s = 0
    while s < steps
        y = 1
        while y < H - 1
            x = 1
            while x < W - 1
                neighbors = grid[(y-1)*W + (x-1)] + grid[(y-1)*W + x] + grid[(y-1)*W + (x+1)] + grid[y*W + (x-1)] + grid[y*W + (x+1)] + grid[(y+1)*W + (x-1)] + grid[(y+1)*W + x] + grid[(y+1)*W + (x+1)]
                cell = grid[y * W + x]
                if cell == 1 then
                    next_grid[y * W + x] = (neighbors == 2 or neighbors == 3) and 1 or 0
                else
                    next_grid[y * W + x] = neighbors == 3 and 1 or 0
                end
                x = x + 1
            end
            y = y + 1
        end
        tmp = grid
        grid = next_grid
        next_grid = tmp
        s = s + 1
    end
    sum = 0
    i = 0
    while i < W * H
        sum = sum + grid[i]
        i = i + 1
    end
    sum
end

