
math = math

h1 = vector.hash32("parse")
h2 = vector.hash32("parse")
assert(h1 == h2, "hash deterministic")
assert(h1 >= 0 and h1 < 4294967296, "hash in u32 range")

toks = vector.tokens("Parse_TheThing!! 42 x")
assert(toks:len() == 3, "token count: got " .. toks:len())
assert(toks[1] == "parse", "tok1: " .. toks[1])
assert(toks[2] == "thething", "tok2: " .. toks[2])
assert(toks[3] == "42", "tok3: " .. toks[3])

e = vector.embed("parse bare function declaration", 256)
assert(e.norm > 0, "embed norm > 0")
assert(e.dim == 256, "dim recorded")
has_feat = false
for k, _v in e
  if k:len() > 1 and k:sub(1, 1) == "f"
    has_feat = true
assert(has_feat, "embed produced feature keys")

q = vector.embed("how does the parser handle function declarations", 256)
sym_parse = vector.embed("parse bare function declaration (GR-001)", 256)
sym_net = vector.embed("tcp socket connect retry backoff", 256)
score_parse = vector.cosine(q, sym_parse)
score_net = vector.cosine(q, sym_net)
assert(score_parse > score_net, "related ranks above unrelated: " .. score_parse .. " vs " .. score_net)
assert(score_parse > 0.1, "related similarity positive & nontrivial: " .. score_parse)

recs = {
  { name = "parse_bare_func", file = "parser.zig", kind = "fn", doc = "parse bare function declaration", vec = sym_parse },
  { name = "socket_connect", file = "net.id", kind = "fn", doc = "tcp socket connect retry backoff", vec = sym_net }
}
ranked = vector.rank(q, recs, 5)
assert(ranked:len() == 2, "rank count")
assert(ranked[1].name == "parse_bare_func", "top result is parser fn: " .. ranked[1].name)
assert(ranked[1].score >= ranked[2].score, "sorted desc")

print("vector_embed_smoke: PASS  (parse=" .. score_parse .. " net=" .. score_net .. ")")
