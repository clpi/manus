-- G-061 tier-1 three-site parity fixture for `comp.power`.
-- TOP = top_level_assign · NESTED = nested_callback · BLOCK = block_body.
-- All three C string literals must be IDENTICAL; scripts/transform.duo asserts it.

concept Has1
    x: i64
end
type T1 = { x: i64 }
sig(t): str
    t.name .. "\n"
end

TOP = @comp.power("Has1", sig)
NESTED = @comp.map("q", fun(seed)
    @comp.power("Has1", sig)
end)
parity(): str
    @comp.power("Has1", sig)
end
BLOCK = parity()
