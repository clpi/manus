# G-061 tier-1 three-site parity fixture for `comp.tabulate`.
# TOP = top_level_assign · NESTED = nested_callback · BLOCK = block_body.
# All three C string literals must be IDENTICAL; scripts/transform.id asserts it.

TOP = @comp.tabulate(2, fun(i)
  tostring(i) .. "\n"
end)
NESTED = @comp.map("q", fun(seed)
  @comp.tabulate(2, fun(i)
    tostring(i) .. "\n"
  end)
end)
parity: str = {}
@comp.tabulate(2, fun(i)
  tostring(i) .. "\n"
end)
BLOCK = parity()
