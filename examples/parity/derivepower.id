# G-061 tier-1 three-site parity fixture for `comp.derive.power`.
# TOP = top_level_assign · NESTED = nested_callback · BLOCK = block_body.
# All three C string literals must be IDENTICAL; scripts/transform.id asserts it.

concept Has1
  x: i64
T1: { x: i64 }

@comp.define.derive("Stub", generate: str = (meta)
    meta.name .. "\n"
)

TOP = @comp.derive.power("Has1", Stub)
NESTED = @comp.map("q", fun(seed)
  @comp.derive.power("Has1", Stub)
)
parity: str = {}
@comp.derive.power("Has1", Stub)
BLOCK = parity()
