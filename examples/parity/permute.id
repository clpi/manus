
concept Has1
  x: i64
offset: { x: i64 }
point: { x: i64, y: i64 }

top = @comp.permute("Has1", fun(ordered)
  ordered.name .. "\n"
)
nested = @comp.map("q", fun(seed)
  @comp.permute("Has1", fun(ordered)
    ordered.name .. "\n"
  )
)
parity: str = {}
@comp.permute("Has1", fun(ordered)
  ordered.name .. "\n"
)
block = parity()
