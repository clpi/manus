@comp.define.derive("Printable", fun generate(type_info)
    local out = "static void duo_" .. type_info.name .. "_print(duo_" .. type_info.name .. " val) {\n"
    out = out .. "    printf(\"" .. type_info.name .. " { \");\n"
    local i = 1
    while i <= #type_info.fields do
        local f = type_info.fields[i]
        if f.type == "int64_t" then
            out = out .. "    printf(\"" .. f.name .. ": %lld \", val." .. f.name .. ");\n"
        elseif f.type == "const char*" then
            out = out .. "    printf(\"" .. f.name .. ": %s \", val." .. f.name .. ");\n"
        end
        i = i + 1
    end
    out = out .. "    printf(\"}\\n\");\n"
    out = out .. "}\n"
    return out
end)

@derive(Printable)
alias Foo = {
    x: i64,
    y: str
}

local f: Foo = { x = 42, y = "hello metaprogramming" }
@c.call("duo_Foo_print", f)
