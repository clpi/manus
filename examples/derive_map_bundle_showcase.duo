-- @meta.derive + @meta.define.bundle: one concept + bundle → O(types × derives × fields) C
-- Run: duo run examples/derive_map_bundle_showcase.duo

concept HasXY
    x: f64
    y: f64
end

type Point = { x: f64, y: f64 }
type Pair = { x: f64, y: f64 }

@meta.define.derive("TouchApi", fun generate(meta) -> str
    "static inline void duo_" .. meta.name .. "_touch(const duo_" .. meta.name .. "* v) { (void)v->x; (void)v->y; }\n"
end)

@meta.define.derive("LayoutApi", fun generate(meta) -> str
    acc = ""
    for i = 1, #meta.fields
        f = meta.fields[i]
        acc = acc .. "static inline size_t duo_" .. meta.name .. "_off_" .. f.name .. "(void) { return offsetof(duo_" .. meta.name .. ", " .. f.name .. "); }\n"
    end
    acc
end)

@meta.define.bundle("FullApi", TouchApi, LayoutApi)

@c.emit(@meta.derive("HasXY", FullApi))

BUNDLE_LEN = @meta.derive("HasXY", FullApi)

print("bundle_len = " .. tostring(#BUNDLE_LEN))
print("ok")
