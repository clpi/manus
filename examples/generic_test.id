
fun identity<T>(value: T): T
    value

fun pair<A, B>(first: A, second: B)
    { first = first, second = second }

fun safe_div<T>(a: T, b: T): T
    if b == 0
        return a
    a // b

fun swap<T>(a: T, b: T)
    return b, a

fun print_if_str<T>(val: T): void
    if type(val) == "string"
        print("str value: " .. val)
        return
    if type(val) == "number"
        print("num value: " .. to(str)(val))
        return
    print("other type")

result = identity(42)
print("identity(42): " .. to(str)(result))

result2 = identity("hello")
print("identity('hello'): " .. result2)

p = pair(1, "one")
print("pair: " .. to(str)(p.first) .. " => " .. p.second)

print("safe_div(10, 2): " .. to(str)(safe_div(10, 2)))
print("safe_div(10, 0): " .. to(str)(safe_div(10, 0)))

x, y = swap(100, 200)
print("swap(100, 200): " .. to(str)(x) .. ", " .. to(str)(y))

print_if_str("hello")
print_if_str(42)
print_if_str(true)
