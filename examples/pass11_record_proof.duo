-- Pass 11 WP-04: sealed f64 record → direct ARM64 (no C, no boxing, no heap).
Point: @{ x: f64, y: f64 }

length2(p: Point): f64
    p.x * p.x + p.y * p.y
end

-- Exit 0 when length2(p) == 25; exit 1 otherwise (Lua: `cond and 0 or 1`).
main(): i64
    p = { x = 3.0, y = 4.0 }
    length2(p) == 25 and 0 or 1
end
