-- Pass 42 §1.2 — direct iteration over a table literal.
--
-- `for v in tbl` is the canonical form (it replaced pairs/ipairs), but in a typed
-- module it did not compile at all: sema densified the table to a bare
-- `int64_t*`, generic-for lowers through the dynamic `__iter` protocol and needs
-- a boxed value, and the two met as `lua_Value tbl = __dt_t;`. A table used as a
-- for-iterator is now excluded from densification.
--
-- Exit code is the failing check number; 0 means every check held.

sum_values(): i64
    t = { 10, 20, 30 }
    s = 0
    for v in t
        s = s + v
    end
    s
end

count_values(): i64
    t = { 1, 1, 1, 1 }
    n = 0
    for v in t
        n = n + v
    end
    n
end

-- A table that is *not* iterated still densifies; only the iterator position is
-- disqualified, so this path keeps the dense representation.
indexed_sum(): i64
    t = { 5, 6, 7 }
    t[1] + t[2] + t[3]
end

main(): i64
    if sum_values() != 60 return 1 end
    if count_values() != 4 return 2 end
    if indexed_sum() != 18 return 3 end
    0
end
