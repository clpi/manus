-- bench_alloc_churn.duo
-- Tests table churn and dynamic array growth overhead compared to native C arrays.

bench_alloc_churn(n)
    collectgarbage("stop")
    t = {}
    for i = 1, n do
        t[i] = i
    end
    for i = 1, n do
        t[i] = nil
    end
    collectgarbage("restart")
    return 1
end

run_bench()
    n = 10000000
    
    -- Warm up
    bench_alloc_churn(1000)

    start = os.clock()
    bench_alloc_churn(n)
    time_taken = os.clock() - start

    print("RESULT alloc_churn")
    print(time_taken)
end

run_bench()
