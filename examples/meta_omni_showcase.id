# @comp.omni / @comp.stack: one agent line → linear + quadratic codegen output
# Run: duo run examples/meta_omni_showcase.id

concept HasXY
  x: f64
  y: f64

concept HasTag
  tag: str

Point: { x: f64, y: f64, tag: str }
Pair: { x: f64, y: f64, tag: str }
Label: { tag: str }

@comp.define.derive("PairApi", generate(meta) -> str
    if meta.left != nil
        "/* omni " .. meta.left.name .. " x " .. meta.right.name .. " */\n"
    else
        acc = ""
        for i = 1, meta:len().fields
            f = meta.fields[i]
            acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
        end
        acc
    end
end)

registry_line: str = (meta)
  meta.name .. ";"

# Expression form: ceiling + sweep comment in one call
__emit(@comp.omni("HasXY", PairApi, "HasTag", registry_line))

print("=== meta omni showcase ===")
print("Point ok = true")
print("ok")
