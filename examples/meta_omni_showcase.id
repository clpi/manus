
concept HasXY
  x: f64
  y: f64

concept HasTag
  tag: str

point: { x: f64, y: f64, tag: str }
pair: { x: f64, y: f64, tag: str }
label: { tag: str }

@comp.define.derive("PairApi", generate: str = (meta)
    if meta.left != nil
        "/* omni " .. meta.left.name .. " x " .. meta.right.name .. " */\n"
    else
        acc = ""
        for i = 1, meta.fields:len()
            f = meta.fields[i]
            acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
        acc
)

registry_line: str = meta
meta.name .. ";"

__emit(@comp.omni("HasXY", PairApi, "HasTag", registry_line))

print("=== meta omni showcase ===")
print("point ok = true")
print("ok")
