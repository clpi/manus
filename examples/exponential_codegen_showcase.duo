-- Exponential codegen: @meta.* bundles, @c.emit, concept sweeps
-- Run: duo run examples/exponential_codegen_showcase.duo

@meta.define.derive("CStruct", fun generate(meta) -> str
    acc = "typedef struct " .. meta.name .. " {\n"
    for i = 1, #meta.fields
        f = meta.fields[i]
        acc = acc .. "    " .. f.type .. " " .. f.name .. ";\n"
    end
    acc .. "} " .. meta.name .. ";\n"
end)

@meta.define.derive("GetterBundle", fun generate(meta) -> str
    acc = ""
    for i = 1, #meta.fields
        f = meta.fields[i]
        acc = acc .. "static inline " .. f.type .. " " .. meta.name .. "_get_" .. f.name .. "(const " .. meta.name .. "* v) { return v->" .. f.name .. "; }\n"
    end
    acc
end)

@meta.define.bundle("Api", CStruct, GetterBundle, Debug)

@meta.derive.bundle("Debug", Api)
type Point = { x: f64, y: f64 }

concept HasXY
    x: f64
    y: f64
end

type Pair = { x: f64, y: f64 }

fun type_mark(meta) -> str
    meta.name .. ";"
end

p: Point = { x = 3.0, y = 4.0 }

@c.emit(@meta.fields.map(p, "/* field %n (%t) */\n"))

FIELD_SIGS = @meta.fields.map(p, "%n:%t;")
UNROLL = @(@meta.loop(0, 4, "init_%i();"))
TYPE_MARKS = @meta.map("HasXY", type_mark)

print("=== exponential codegen showcase ===")
print("field_sigs = " .. FIELD_SIGS)
print("unroll = " .. UNROLL)
print("types = " .. TYPE_MARKS)
print("Point fields = " .. tostring(#@meta.fields(p)))
print("ok")
