-- Table shape foundation smoke (2026-08-04)
-- Typed records infer storage class; @comp.type.shape / @comp.shape expose it at compile time.
-- Run: duo check examples/table_shape_smoke.duo
--      DUO_GRAPH=1 duo check examples/table_shape_smoke.duo
--      DUO_PROVENANCE=1 duo compile examples/table_shape_smoke.duo -o /tmp/table_shape_smoke
-- Unit tests: zig test src/types.zig --test-filter inferStorageClass
--              zig test src/semantic_graph.zig --test-filter liftAliasShapes
--              zig test src/codegen.zig --test-filter type_shape

Point: { x: f64, y: f64 }

@sealed
Box: { label: str, count: i64 }

enum Color
    Red
    Green
    Blue
end

main()
    p: Point = { x = 3.0, y = 4.0 }
    pt2: { x: f64, y: f64 } = { x = 1.0, y = 2.0 }
    b: Box = { label = "ok", count = 1 }

    point_shape = @comp.type.shape(p)
    alias_shape = @comp.shape(p)
    inline_shape = @comp.type.shape(pt2)
    box_shape = @comp.type.shape(b)
    point_why = @comp.why.shape(p)
    box_why = @comp.why(b)
    point_origin = @comp.origin(p)

    print("point_shape=", point_shape, " alias_shape=", alias_shape, " inline_shape=", inline_shape, " box_shape=", box_shape, "\n")
    print("point_why=", point_why, "\n")
    print("box_why=", box_why, "\n")
    print("point_origin=", point_origin, "\n")
    print("p.x=", p.x, " pt2.x=", pt2.x, "\n")

    red = Color.Red
    print("color=", red, "\n")

    -- Graph export (duo graph examples/table_shape_smoke.duo) lists table_shapes + enum_shapes.
    ok = point_shape == "native" and alias_shape == "native" and inline_shape == "native" and box_shape == "sealed" and p.x == 3.0
    ok = ok and string.find(point_why, "native C scalars") != nil and string.find(box_why, "@sealed") != nil
    ok = ok and string.find(point_origin, "shape_id=") != nil and red == 0
    print("ok=", ok, "\n")
end
