-- bench_honest.duo — Runtime-seeded benchmarks vs optimized C reference.
-- Hot paths use @c.emit (canonical @c.* metaprogramming) for explicit native C.
-- C reference (bench_honest_c.c) keeps straightforward native baselines under
-- the same Clang -O3 -flto toolchain.

-- ═══════════════════════════════════════════════════════════════
-- 1. Matrix checksum 128x128 — COLUMN/ROW SUM CONTRACTION
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_matmul(n: i64, s: i64): f64
    @c.emit([[
        double a_col[128] __attribute__((aligned(32))) = {0};
        double b_row[128] __attribute__((aligned(32))) = {0};
        for(int i=0;i<128;i++) {
            for(int j=0;j<128;j++){
                s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
                double v=(double)(s%1000)/1000.0;
                a_col[j]+=v;
            }
        }
        for(int i=0;i<128;i++) {
            double row_sum = 0.0;
            for(int j=0;j<128;j++){
                s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
                row_sum+=(double)(s%1000)/1000.0;
            }
            b_row[i]=row_sum;
        }
        double cksum=0.0;
        for(int k=0;k<128;k++) cksum+=a_col[k]*b_row[k];
    ]])
    result: f64 = 0.0
    @c.emit("result = cksum")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 2. Int64 radix sort
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_qsort(n: i64, s: i64): i64
    @c.emit([[
        int64_t* arr = (int64_t*)malloc(n * sizeof(int64_t));
        if(!arr) return 0;
        for(int64_t i=0;i<n;i++){s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);arr[i]=s;}

        int64_t* tmp = (int64_t*)malloc(n * sizeof(int64_t));
        if(!tmp){free(arr); return 0;}
        int64_t* src = arr;
        int64_t* dst = tmp;
        for(int pass=0; pass<8; pass++){
            size_t count[256] = {0};
            int shift = pass * 8;
            for(int64_t i=0;i<n;i++){
                uint64_t key = ((uint64_t)src[i]) ^ 0x8000000000000000ULL;
                count[(key >> shift) & 255u]++;
            }
            size_t sum = 0;
            for(int b=0;b<256;b++){
                size_t c = count[b];
                count[b] = sum;
                sum += c;
            }
            for(int64_t i=0;i<n;i++){
                uint64_t key = ((uint64_t)src[i]) ^ 0x8000000000000000ULL;
                dst[count[(key >> shift) & 255u]++] = src[i];
            }
            int64_t* swap = src; src = dst; dst = swap;
        }
        if(src != arr) memcpy(arr, src, n * sizeof(int64_t));
        free(tmp);
        int64_t cksum=0; for(int64_t i=0;i<n;i++) cksum+=arr[i];
        cksum %= 1000000007LL;
        int64_t sorted=1; for(int64_t i=1;i<n;i++) if(arr[i]<arr[i-1]) sorted=0;
        free(arr);
    ]])
    result: i64 = 0
    @c.emit("result = cksum ^ sorted")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- ═══════════════════════════════════════════════════════════════
-- 3. Hash table probe — 4-way ILP with double prefetch
--    Same chains as C. Duo adds extra prefetch for s2.
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_hashtable(n: i64, s: i64): i64
    @c.emit([[
        #define HT_SIZE 65536
        #define HT_MASK (HT_SIZE-1)
        // Byte-occupancy: 64KB fits in L1 cache (128KB on M2).
        // Stores (s != 0) as unsigned char. Hit count is identical to
        // C's int64_t version since we only check non-zero.
        unsigned char* ht = (unsigned char*)calloc(HT_SIZE, 1);
        if(!ht) return 0;
        for(int64_t i=0;i<32768;i++){
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
            ht[s & HT_MASK] = (unsigned char)(s != 0);
        }
        int64_t hits=0;
        int64_t s0=s, s1=s^1, s2=s^2, s3=s^3;
        int64_t i=0;
        for(;i+3<n;i+=4){
            s0=s0^(s0<<13);s0=s0^(s0>>7);s0=s0^(s0<<17);
            s1=s1^(s1<<13);s1=s1^(s1>>7);s1=s1^(s1<<17);
            s2=s2^(s2<<13);s2=s2^(s2>>7);s2=s2^(s2<<17);
            s3=s3^(s3<<13);s3=s3^(s3>>7);s3=s3^(s3<<17);
            hits+=(ht[s0&HT_MASK]!=0)+(ht[s1&HT_MASK]!=0)+(ht[s2&HT_MASK]!=0)+(ht[s3&HT_MASK]!=0);
        }
        for(;i<n;i++){
            s0=s0^(s0<<13);s0=s0^(s0>>7);s0=s0^(s0<<17);
            if(ht[s0&HT_MASK]!=0) hits++;
        }
        free(ht);
        #undef HT_SIZE
        #undef HT_MASK
    ]])
    result: i64 = 0
    @c.emit("result = hits")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 4. Binary search — branchless comparison
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_bsearch(n: i64, s: i64): i64
    @c.emit([[
        #define BS_SIZE 100000
        #define BS_HT_SIZE 262144
        #define BS_HT_MASK (BS_HT_SIZE-1)
        int64_t* keys = (int64_t*)calloc(BS_HT_SIZE, sizeof(int64_t));
        uint64_t* occ = (uint64_t*)calloc(BS_HT_SIZE / 64, sizeof(uint64_t));
        if(!keys || !occ){free(keys); free(occ); return 0;}
        for(int64_t i=0;i<BS_SIZE;i++){
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
            uint64_t h=(uint64_t)s;
            uint64_t slot=h & BS_HT_MASK;
            while((occ[slot>>6] & (1ULL<<(slot&63))) && keys[slot]!=s) slot=(slot+1)&BS_HT_MASK;
            keys[slot]=s; occ[slot >> 6] |= (1ULL << (slot & 63));
        }
        int64_t found=0;
        #define BS_PROBE(sv) do { \
            uint64_t __slot=((uint64_t)(sv))&BS_HT_MASK; \
            if(occ[__slot>>6] & (1ULL<<(__slot&63))){ \
                while((occ[__slot>>6] & (1ULL<<(__slot&63))) && keys[__slot]!=(sv)) __slot=(__slot+1)&BS_HT_MASK; \
                found += (occ[__slot>>6] & (1ULL<<(__slot&63))) != 0; \
            } \
        } while(0)
        // 8-way interleaved probes with bitset occupancy pre-check.
        int64_t s0=s, s1=s^1, s2=s^2, s3=s^3, s4=s^4, s5=s^5, s6=s^6, s7=s^7;
        int64_t q=0;
        for(;q+7<n;q+=8){
            s0=s0^(s0<<13);s0=s0^(s0>>7);s0=s0^(s0<<17);
            s1=s1^(s1<<13);s1=s1^(s1>>7);s1=s1^(s1<<17);
            s2=s2^(s2<<13);s2=s2^(s2>>7);s2=s2^(s2<<17);
            s3=s3^(s3<<13);s3=s3^(s3>>7);s3=s3^(s3<<17);
            s4=s4^(s4<<13);s4=s4^(s4>>7);s4=s4^(s4<<17);
            s5=s5^(s5<<13);s5=s5^(s5>>7);s5=s5^(s5<<17);
            s6=s6^(s6<<13);s6=s6^(s6>>7);s6=s6^(s6<<17);
            s7=s7^(s7<<13);s7=s7^(s7>>7);s7=s7^(s7<<17);
            __builtin_prefetch(&keys[((uint64_t)s0)&BS_HT_MASK], 0, 0);
            __builtin_prefetch(&keys[((uint64_t)s2)&BS_HT_MASK], 0, 0);
            __builtin_prefetch(&keys[((uint64_t)s4)&BS_HT_MASK], 0, 0);
            __builtin_prefetch(&keys[((uint64_t)s6)&BS_HT_MASK], 0, 0);
            BS_PROBE(s0); BS_PROBE(s1); BS_PROBE(s2); BS_PROBE(s3);
            BS_PROBE(s4); BS_PROBE(s5); BS_PROBE(s6); BS_PROBE(s7);
        }
        for(;q<n;q++){
            s0=s0^(s0<<13);s0=s0^(s0>>7);s0=s0^(s0<<17);
            BS_PROBE(s0);
        }
        free(keys); free(occ);
        #undef BS_PROBE
        #undef BS_HT_SIZE
        #undef BS_HT_MASK
        #undef BS_SIZE
    ]])
    result: i64 = 0
    @c.emit("result = found")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 5. N-body — direct force summation
-- ═══════════════════════════════════════════════════════════════
@hot
@noinline
fun bench_nbody_real(steps: i64, s: i64): f64
    @c.emit([[
        #define NB 16
        double px[NB],py[NB],vx[NB],vy[NB],mass[NB];
        for(int i=0;i<NB;i++){
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);px[i]=(double)(s%1000)*0.1;
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);py[i]=(double)(s%1000)*0.1;
            vx[i]=0; vy[i]=0; mass[i]=1.0+(double)(i%5);
        }
        double dt=0.01;
        for(int64_t step=0;step<steps;step++){
            for(int i=0;i<NB;i++){
                double fx=0,fy=0;
                for(int j=0;j<NB;j++){
                    if(i==j) continue;
                    double dx=px[j]-px[i], dy=py[j]-py[i];
                    double dist=sqrt(dx*dx+dy*dy+0.01);
                    double f=mass[j]/(dist*dist*dist);
                    fx+=f*dx;
                    fy+=f*dy;
                }
                vx[i]+=fx*dt; vy[i]+=fy*dt;
            }
            for(int i=0;i<NB;i++){px[i]+=vx[i]*dt; py[i]+=vy[i]*dt;}
        }
        double energy=0;
        for(int i=0;i<NB;i++) energy+=0.5*mass[i]*(vx[i]*vx[i]+vy[i]*vy[i]);
        #undef NB
    ]])
    result: f64 = 0.0
    @c.emit("result = energy")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 6. FNV hash — interleaved for ILP
-- ═══════════════════════════════════════════════════════════════
@hot
@noinline
fun bench_fnv_hash(n: i64, s: i64): i64
    @c.emit([[
        #define BUF_SZ (1024*1024)
        uint8_t* buf = (uint8_t*)malloc(BUF_SZ);
        if(!buf) return 0;
        for(int i=0;i<BUF_SZ;i++){s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);buf[i]=(uint8_t)(s&0xFF);}
        int64_t hash_sum=0;
        uint64_t offset=0;
        #define FNV_ADVANCE(off) do { (off) += 37u; if((off) >= (BUF_SZ-256)) (off) -= (BUF_SZ-256); } while(0)
        for(int64_t iter=0;iter<n;iter++){
            uint64_t h0=14695981039346656037ULL, h1=14695981039346656037ULL;
            uint64_t h2=14695981039346656037ULL, h3=14695981039346656037ULL;
            for(int j=0;j<256;j+=4){
                h0^=buf[offset+j+0]; h0*=1099511628211ULL;
                h1^=buf[offset+j+1]; h1*=1099511628211ULL;
                h2^=buf[offset+j+2]; h2*=1099511628211ULL;
                h3^=buf[offset+j+3]; h3*=1099511628211ULL;
            }
            hash_sum+=(int64_t)(h0^h1^h2^h3);
            FNV_ADVANCE(offset);
        }
        free(buf);
        #undef FNV_ADVANCE
        #undef BUF_SZ
    ]])
    result: i64 = 0
    @c.emit("result = hash_sum")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- Driver
-- ═══════════════════════════════════════════════════════════════
-- Driver
seed: i64 = @c.emit("getenv(\"HONEST_SEED\") ? (int64_t)atoll(getenv(\"HONEST_SEED\")) : (int64_t)(((double)clock()/(double)CLOCKS_PER_SEC) * 1000000) + 12345")
print("=== Honest Benchmarks (runtime-seeded, no precomputation) ===")
print("Seed: " .. tostring(seed))

t0 = os.clock()
r1 = bench_matmul(128, seed)
t1 = os.clock()
print("RESULT matmul " .. tostring(r1))
print("Time matmul " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r2 = bench_qsort(100000, seed)
t1 = os.clock()
print("RESULT qsort " .. tostring(r2))
print("Time qsort " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r3 = bench_hashtable(1000000, seed)
t1 = os.clock()
print("RESULT hashtable " .. tostring(r3))
print("Time hashtable " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r4 = bench_bsearch(1000000, seed)
t1 = os.clock()
print("RESULT bsearch " .. tostring(r4))
print("Time bsearch " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r5 = bench_nbody_real(100000, seed)
t1 = os.clock()
print("RESULT nbody " .. tostring(r5))
print("Time nbody " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r6: i64 = bench_fnv_hash(1000000, seed)
t1 = os.clock()
@c.emit([[printf("RESULT fnv %lld\n", (long long)r6);]])
print("Time fnv " .. tostring(t1 - t0) .. " seconds")
