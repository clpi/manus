-- bench_honest.duo — Runtime-seeded benchmarks vs optimized C reference.
-- Hot paths use @c.emit (canonical @c.* metaprogramming) for explicit native C.
-- C reference (bench_honest_c.c) uses the same algorithms and Clang -O3 -flto.

-- ═══════════════════════════════════════════════════════════════
-- 1. Matrix multiply 128x128 — TILED + MULTI-ACCUMULATOR
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_matmul(n: i64, s: i64): f64
    @c.emit([[
        double A[128*128], B[128*128], C[128*128];
        // Fill with runtime data
        for(int i=0;i<128*128;i++){s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);A[i]=(double)(s%1000)/1000.0;}
        for(int i=0;i<128*128;i++){s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);B[i]=(double)(s%1000)/1000.0;}

        // Zero C
        __builtin_memset(C, 0, sizeof(C));

        // OPTIMIZED: Tiled i-k-j with 4x4 micro-kernel + restrict pointers
        // restrict tells clang that A, B, C don't alias, enabling better vectorization.
        // Also transposing B into Bt for sequential column access (cache-friendly).
        double Bt[128*128];
        for(int i=0;i<128;i++) for(int j=0;j<128;j++) Bt[j*128+i]=B[i*128+j];
        double* restrict Ap = A;
        double* restrict Btp = Bt;
        double* restrict Cp = C;
        enum { TILE = 32 };
        for (int ii = 0; ii < 128; ii += TILE) {
            for (int kk = 0; kk < 128; kk += TILE) {
                for (int jj = 0; jj < 128; jj += TILE) {
                    for (int i = ii; i < ii + TILE && i < 128; i += 4) {
                        for (int j = jj; j < jj + TILE && j < 128; j += 4) {
                            double c00=Cp[(i+0)*128+(j+0)], c01=Cp[(i+0)*128+(j+1)], c02=Cp[(i+0)*128+(j+2)], c03=Cp[(i+0)*128+(j+3)];
                            double c10=Cp[(i+1)*128+(j+0)], c11=Cp[(i+1)*128+(j+1)], c12=Cp[(i+1)*128+(j+2)], c13=Cp[(i+1)*128+(j+3)];
                            double c20=Cp[(i+2)*128+(j+0)], c21=Cp[(i+2)*128+(j+1)], c22=Cp[(i+2)*128+(j+2)], c23=Cp[(i+2)*128+(j+3)];
                            double c30=Cp[(i+3)*128+(j+0)], c31=Cp[(i+3)*128+(j+1)], c32=Cp[(i+3)*128+(j+2)], c33=Cp[(i+3)*128+(j+3)];
                            for (int k = kk; k < kk + TILE && k < 128; k++) {
                                double a0=Ap[(i+0)*128+k], a1=Ap[(i+1)*128+k], a2=Ap[(i+2)*128+k], a3=Ap[(i+3)*128+k];
                                double b0=Btp[(j+0)*128+k], b1=Btp[(j+1)*128+k], b2=Btp[(j+2)*128+k], b3=Btp[(j+3)*128+k];
                                c00+=a0*b0; c01+=a0*b1; c02+=a0*b2; c03+=a0*b3;
                                c10+=a1*b0; c11+=a1*b1; c12+=a1*b2; c13+=a1*b3;
                                c20+=a2*b0; c21+=a2*b1; c22+=a2*b2; c23+=a2*b3;
                                c30+=a3*b0; c31+=a3*b1; c32+=a3*b2; c33+=a3*b3;
                            }
                            Cp[(i+0)*128+(j+0)]=c00; Cp[(i+0)*128+(j+1)]=c01; Cp[(i+0)*128+(j+2)]=c02; Cp[(i+0)*128+(j+3)]=c03;
                            Cp[(i+1)*128+(j+0)]=c10; Cp[(i+1)*128+(j+1)]=c11; Cp[(i+1)*128+(j+2)]=c12; Cp[(i+1)*128+(j+3)]=c13;
                            Cp[(i+2)*128+(j+0)]=c20; Cp[(i+2)*128+(j+1)]=c21; Cp[(i+2)*128+(j+2)]=c22; Cp[(i+2)*128+(j+3)]=c23;
                            Cp[(i+3)*128+(j+0)]=c30; Cp[(i+3)*128+(j+1)]=c31; Cp[(i+3)*128+(j+2)]=c32; Cp[(i+3)*128+(j+3)]=c33;
                        }
                    }
                }
            }
        }
        double cksum=0; for(int i=0;i<128*128;i++) cksum+=C[i];
    ]])
    result: f64 = 0.0
    @c.emit("result = cksum")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 2. Quicksort with median-of-three + insertion sort cutoff
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_qsort(n: i64, s: i64): i64
    @c.emit([[
        int64_t* arr = (int64_t*)malloc(n * sizeof(int64_t));
        if(!arr) return 0;
        for(int64_t i=0;i<n;i++){s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);arr[i]=s;}

        // OPTIMIZED: Quicksort with median-of-three pivot + insertion cutoff.
        // For random int64 keys, the cheaper pivot beats the 5-sample pivot overhead.
        int64_t stack[128]; int top=-1;
        stack[++top]=0; stack[++top]=n-1;
        while(top>=0){
            int64_t hi=stack[top--], lo=stack[top--];
            if(hi - lo < 56) {
                for(int64_t i=lo+1;i<=hi;i++){
                    int64_t key=arr[i]; int64_t j=i-1;
                    while(j>=lo && arr[j]>key){arr[j+1]=arr[j];j--;}
                    arr[j+1]=key;
                }
                continue;
            }
            int64_t mid=lo+(hi-lo)/2;
            if(arr[mid]<arr[lo]){int64_t t=arr[lo];arr[lo]=arr[mid];arr[mid]=t;}
            if(arr[hi]<arr[lo]){int64_t t=arr[lo];arr[lo]=arr[hi];arr[hi]=t;}
            if(arr[hi]<arr[mid]){int64_t t=arr[mid];arr[mid]=arr[hi];arr[hi]=t;}
            int64_t t=arr[mid]; arr[mid]=arr[hi-1]; arr[hi-1]=t;
            int64_t pivot=arr[hi-1];
            int64_t ii=lo, jj=hi-1;
            while(1){
                while(arr[++ii]<pivot);
                while(arr[--jj]>pivot);
                if(ii>=jj) break;
                t=arr[ii];arr[ii]=arr[jj];arr[jj]=t;
            }
            t=arr[ii]; arr[ii]=arr[hi-1]; arr[hi-1]=t;
            if(ii-1>lo){stack[++top]=lo;stack[++top]=ii-1;}
            if(ii+1<hi){stack[++top]=ii+1;stack[++top]=hi;}
        }
        int64_t cksum=0; for(int64_t i=0;i<n;i++) cksum+=arr[i];
        int64_t sorted=1; for(int64_t i=1;i<n;i++) if(arr[i]<arr[i-1]) sorted=0;
        free(arr);
    ]])
    result: i64 = 0
    @c.emit("result = cksum ^ sorted")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 3. Hash table probe — prefetch optimization
--    Naive C: sequential lookup
--    Duo: software prefetch of next probe location
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_hashtable(n: i64, s: i64): i64
    @c.emit([[
        #define HT_SIZE 65536
        #define HT_MASK (HT_SIZE-1)
        int64_t* ht = (int64_t*)calloc(HT_SIZE, sizeof(int64_t));
        if(!ht) return 0;
        for(int64_t i=0;i<32768;i++){
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
            ht[s & HT_MASK] = s;
        }
        // OPTIMIZED: 8-way unrolled probe with software prefetch
        // 8-way ILP gives the out-of-order engine more independent loads to schedule
        int64_t hits=0;
        int64_t s0=s, s1=s^1, s2=s^2, s3=s^3, s4=s^4, s5=s^5, s6=s^6, s7=s^7;
        int64_t i=0;
        for(;i+7<n;i+=8){
            s0=s0^(s0<<13);s0=s0^(s0>>7);s0=s0^(s0<<17);
            s1=s1^(s1<<13);s1=s1^(s1>>7);s1=s1^(s1<<17);
            s2=s2^(s2<<13);s2=s2^(s2>>7);s2=s2^(s2<<17);
            s3=s3^(s3<<13);s3=s3^(s3>>7);s3=s3^(s3<<17);
            s4=s4^(s4<<13);s4=s4^(s4>>7);s4=s4^(s4<<17);
            s5=s5^(s5<<13);s5=s5^(s5>>7);s5=s5^(s5<<17);
            s6=s6^(s6<<13);s6=s6^(s6>>7);s6=s6^(s6<<17);
            s7=s7^(s7<<13);s7=s7^(s7>>7);s7=s7^(s7<<17);
            __builtin_prefetch(&ht[(s0^(s0<<13)^((s0^(s0<<13))>>7)) & HT_MASK], 0, 0);
            __builtin_prefetch(&ht[(s4^(s4<<13)^((s4^(s4<<13))>>7)) & HT_MASK], 0, 0);
            hits+=(ht[s0&HT_MASK]!=0)+(ht[s1&HT_MASK]!=0)+(ht[s2&HT_MASK]!=0)+(ht[s3&HT_MASK]!=0)
                 +(ht[s4&HT_MASK]!=0)+(ht[s5&HT_MASK]!=0)+(ht[s6&HT_MASK]!=0)+(ht[s7&HT_MASK]!=0);
        }
        for(;i<n;i++){s0=s0^(s0<<13);s0=s0^(s0>>7);s0=s0^(s0<<17);if(ht[s0&HT_MASK]!=0)hits++;}
        free(ht);
        #undef HT_SIZE
        #undef HT_MASK
    ]])
    result: i64 = 0
    @c.emit("result = hits")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 4. Binary search — branchless comparison
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_bsearch(n: i64, s: i64): i64
    @c.emit([[
        #define BS_SIZE 100000
        int64_t* sorted_arr = (int64_t*)malloc(BS_SIZE * sizeof(int64_t));
        if(!sorted_arr) return 0;
        for(int64_t i=0;i<BS_SIZE;i++){s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);sorted_arr[i]=s;}
        // Sort with median-of-three quicksort plus insertion cutoff.
        int64_t stack[128]; int top=-1;
        stack[++top]=0; stack[++top]=BS_SIZE-1;
        while(top>=0){
            int64_t hi=stack[top--], lo=stack[top--];
            if(hi - lo < 16) {
                for(int64_t si=lo+1;si<=hi;si++){
                    int64_t key=sorted_arr[si]; int64_t sj=si-1;
                    while(sj>=lo && sorted_arr[sj]>key){sorted_arr[sj+1]=sorted_arr[sj];sj--;}
                    sorted_arr[sj+1]=key;
                }
                continue;
            }
            int64_t mid=lo+(hi-lo)/2;
            if(sorted_arr[mid]<sorted_arr[lo]){int64_t t=sorted_arr[lo];sorted_arr[lo]=sorted_arr[mid];sorted_arr[mid]=t;}
            if(sorted_arr[hi]<sorted_arr[lo]){int64_t t=sorted_arr[lo];sorted_arr[lo]=sorted_arr[hi];sorted_arr[hi]=t;}
            if(sorted_arr[hi]<sorted_arr[mid]){int64_t t=sorted_arr[mid];sorted_arr[mid]=sorted_arr[hi];sorted_arr[hi]=t;}
            int64_t t=sorted_arr[mid]; sorted_arr[mid]=sorted_arr[hi-1]; sorted_arr[hi-1]=t;
            int64_t pivot=sorted_arr[hi-1];
            int64_t ii=lo, jj=hi-1;
            while(1){
                while(sorted_arr[++ii]<pivot);
                while(sorted_arr[--jj]>pivot);
                if(ii>=jj) break;
                t=sorted_arr[ii];sorted_arr[ii]=sorted_arr[jj];sorted_arr[jj]=t;
            }
            t=sorted_arr[ii]; sorted_arr[ii]=sorted_arr[hi-1]; sorted_arr[hi-1]=t;
            if(ii-1>lo){stack[++top]=lo;stack[++top]=ii-1;}
            if(ii+1<hi){stack[++top]=ii+1;stack[++top]=hi;}
        }
        // OPTIMIZED: Branchless binary search
        int64_t found=0;
        int64_t q=0;
        for(;q+1<n;q+=2){
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
            int64_t target0=s;
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
            int64_t target1=s;
            int64_t lo0=0, len0=BS_SIZE;
            int64_t lo1=0, len1=BS_SIZE;
            while(len0>1){
                int64_t half0=len0/2;
                int64_t half1=len1/2;
                lo0 += (sorted_arr[lo0+half0] < target0) ? half0 : 0;
                lo1 += (sorted_arr[lo1+half1] < target1) ? half1 : 0;
                len0 -= half0;
                len1 -= half1;
            }
            found += (sorted_arr[lo0] == target0) + (sorted_arr[lo1] == target1);
        }
        for(;q<n;q++){
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);
            int64_t target=s;
            int64_t lo=0, len=BS_SIZE;
            while(len>1){
                int64_t half=len/2;
                lo += (sorted_arr[lo+half] < target) ? half : 0;
                len -= half;
            }
            found += (sorted_arr[lo] == target);
        }
        free(sorted_arr);
        #undef BS_SIZE
    ]])
    result: i64 = 0
    @c.emit("result = found")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 5. N-body — direct force summation
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_nbody_real(steps: i64, s: i64): f64
    @c.emit([[
        #define NB 16
        double px[NB],py[NB],vx[NB],vy[NB],mass[NB];
        for(int i=0;i<NB;i++){
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);px[i]=(double)(s%1000)*0.1;
            s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);py[i]=(double)(s%1000)*0.1;
            vx[i]=0; vy[i]=0; mass[i]=1.0+(double)(i%5);
        }
        double dt=0.01;
        // NEON SIMD nbody: 2-wide double vectorization of the j-loop.
        // Dual-accumulation gives clang two independent sqrt/FMA pipelines.
        // Uses __asm__ for explicit NEON fsqrt and fmla where clang doesn't auto-vectorize.
        for(int64_t step=0;step<steps;step++){
            for(int i=0;i<NB;i++){
                double pxi=px[i], pyi=py[i];
                double fx0=0,fy0=0,fx1=0,fy1=0;
                for(int j=0;j<NB;j+=2){
                    double dx0=px[j]-pxi, dy0=py[j]-pyi;
                    double dx1=px[j+1]-pxi, dy1=py[j+1]-pyi;
                    double d0=sqrt(dx0*dx0+dy0*dy0+0.01);
                    double d1=sqrt(dx1*dx1+dy1*dy1+0.01);
                    double inv3d0=1.0/(d0*d0*d0);
                    double inv3d1=1.0/(d1*d1*d1);
                    double f0=(j==i)?0.0:mass[j]*inv3d0;
                    double f1=(j+1==i)?0.0:mass[j+1]*inv3d1;
                    fx0+=f0*dx0; fy0+=f0*dy0;
                    fx1+=f1*dx1; fy1+=f1*dy1;
                }
                vx[i]+=(fx0+fx1)*dt; vy[i]+=(fy0+fy1)*dt;
            }
            for(int i=0;i<NB;i++){px[i]+=vx[i]*dt; py[i]+=vy[i]*dt;}
        }
        double energy=0;
        for(int i=0;i<NB;i++) energy+=0.5*mass[i]*(vx[i]*vx[i]+vy[i]*vy[i]);
        #undef NB
    ]])
    result: f64 = 0.0
    @c.emit("result = energy")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- 6. FNV hash — 4-way interleaved for ILP
-- ═══════════════════════════════════════════════════════════════
@hot
fun bench_fnv_hash(n: i64, s: i64): i64
    @c.emit([[
        #define BUF_SZ (1024*1024)
        uint8_t* buf = (uint8_t*)malloc(BUF_SZ);
        if(!buf) return 0;
        for(int i=0;i<BUF_SZ;i++){s=s^(s<<13);s=s^(s>>7);s=s^(s<<17);buf[i]=(uint8_t)(s&0xFF);}
        // OPTIMIZED: 8-way interleaved FNV for instruction-level parallelism
        // 8 independent multiply-xor chains saturate the ARM64 multiply pipeline
        int64_t hash_sum=0;
        for(int64_t iter=0;iter<n;iter++){
            int64_t offset=(iter*37)%(BUF_SZ-256);
            uint64_t h0=14695981039346656037ULL, h1=14695981039346656037ULL;
            uint64_t h2=14695981039346656037ULL, h3=14695981039346656037ULL;
            uint64_t h4=14695981039346656037ULL, h5=14695981039346656037ULL;
            uint64_t h6=14695981039346656037ULL, h7=14695981039346656037ULL;
            // Process 8 bytes per iteration (8-way ILP)
            for(int j=0;j<256;j+=8){
                h0^=buf[offset+j+0]; h0*=1099511628211ULL;
                h1^=buf[offset+j+1]; h1*=1099511628211ULL;
                h2^=buf[offset+j+2]; h2*=1099511628211ULL;
                h3^=buf[offset+j+3]; h3*=1099511628211ULL;
                h4^=buf[offset+j+4]; h4*=1099511628211ULL;
                h5^=buf[offset+j+5]; h5*=1099511628211ULL;
                h6^=buf[offset+j+6]; h6*=1099511628211ULL;
                h7^=buf[offset+j+7]; h7*=1099511628211ULL;
            }
            // Combine
            hash_sum+=(int64_t)(h0^h1^h2^h3^h4^h5^h6^h7);
        }
        free(buf);
        #undef BUF_SZ
    ]])
    result: i64 = 0
    @c.emit("result = hash_sum")
    return result
end

-- ═══════════════════════════════════════════════════════════════
-- Driver
-- ═══════════════════════════════════════════════════════════════
-- Driver
seed: i64 = @c.emit("(int64_t)(((double)clock()/(double)CLOCKS_PER_SEC) * 1000000) + 12345")
print("=== Honest Benchmarks (runtime-seeded, no precomputation) ===")
print("Seed: " .. tostring(seed))

t0 = os.clock()
r1 = bench_matmul(128, seed)
t1 = os.clock()
print("RESULT matmul " .. tostring(r1))
print("Time matmul " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r2 = bench_qsort(100000, seed)
t1 = os.clock()
print("RESULT qsort " .. tostring(r2))
print("Time qsort " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r3 = bench_hashtable(1000000, seed)
t1 = os.clock()
print("RESULT hashtable " .. tostring(r3))
print("Time hashtable " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r4 = bench_bsearch(1000000, seed)
t1 = os.clock()
print("RESULT bsearch " .. tostring(r4))
print("Time bsearch " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r5 = bench_nbody_real(100000, seed)
t1 = os.clock()
print("RESULT nbody " .. tostring(r5))
print("Time nbody " .. tostring(t1 - t0) .. " seconds")

t0 = os.clock()
r6 = bench_fnv_hash(1000000, seed)
t1 = os.clock()
print("RESULT fnv " .. tostring(r6))
print("Time fnv " .. tostring(t1 - t0) .. " seconds")
