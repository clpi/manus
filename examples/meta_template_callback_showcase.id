# @comp.template with named top-level callback (G-035: heap-stable meta table)
# Run: duo run examples/meta_template_callback_showcase.id

tmpl_unit: str = (m)
  "/* tmpl[" .. m.name .. ":" .. m.ctype .. "] */\n"

inst = "i64:int64_t|f64:double"
code = @comp.template(inst, "", tmpl_unit)
N = @comp.str.countlines(code)

ok = N == 2 and @comp.str.contains(code, "i64:int64_t") and @comp.str.contains(code, "f64:double")

print("=== @comp.template + named callback ===")
print(code)
print("RESULT template_callback_ok = " .. to(str)(ok))
