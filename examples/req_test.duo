-- Test 'req' as the module import mechanism
-- 'req' is a regular identifier, NOT a keyword
-- It supports destructured imports for pulling out named exports

-- Define req locally for standalone use
-- (In the full runtime, req is provided by the standard library)
req(module: str)
    return "loaded: " .. module
end

-- Standard require pattern
sync = req "std.sync"
print("sync module loaded: " .. tostring(type(sync)))

-- req can be used as a function name
my_req(module: str): str
    "loaded: " .. module
end

print(my_req("custom_module"))

-- Note: 'import' is never a keyword in Duo; always use 'req'
-- Destructured imports: { name1, name2 } = req "module"
-- This pulls specific exports from the returned module table
