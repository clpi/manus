xs = {1, 2, 3}

sum = 0
for x in xs
    sum += x
    x += 10
end

assert(sum == 6)
assert(xs[1] == 11)
assert(xs[2] == 12)
assert(xs[3] == 13)

for i, v in xs
    v += i
end

assert(xs[1] == 12)
assert(xs[2] == 14)
assert(xs[3] == 16)

scores = {
    ada = 10,
    lua = 20,
}

seen = 0
for name, score in scores
    if name == "ada" then
        score += 1
    elseif name == "lua" then
        score += 2
    end
    seen += 1
end

assert(seen == 2)
assert(scores.ada == 11)
assert(scores.lua == 22)

legacy = 0
for _, v in xs
    legacy += v
    v += 1
end

assert(legacy == 42)
assert(xs[1] == 13)
assert(xs[2] == 15)
assert(xs[3] == 17)

print("direct table iteration ok")
