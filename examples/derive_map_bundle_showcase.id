
concept HasXY
  x: f64
  y: f64

point: { x: f64, y: f64 }
pair: { x: f64, y: f64 }

@comp.define.derive("TouchApi", generate: str = (meta)
    "static inline void duo_" .. meta.name .. "_touch(const duo_" .. meta.name .. "* v) { (void)v->x; (void)v->y; }\n"
)


@comp.define.derive("LayoutApi", generate: str = (meta)
    acc = ""
    for i = 1, meta.fields:len()
        f = meta.fields[i]
        acc = acc .. "static inline size_t duo_" .. meta.name .. "_off_" .. f.name .. "(void) { return offsetof(duo_" .. meta.name .. ", " .. f.name .. "); }\n"
    acc
)


@comp.define.bundle("FullApi", TouchApi, LayoutApi)

__emit(@comp.derive("HasXY", FullApi))

BUNDLE_LEN = @comp.derive("HasXY", FullApi)

print("bundle_len = " .. to(str)(BUNDLE_LEN:len()))
print("ok")
