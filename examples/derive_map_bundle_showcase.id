-- @comp.derive + @comp.define.bundle: one concept + bundle → O(types × derives × fields) C
-- Run: duo run examples/derive_map_bundle_showcase.id

concept HasXY
    x: f64
    y: f64
end

Point: { x: f64, y: f64 }
Pair: { x: f64, y: f64 }

@comp.define.derive("TouchApi", generate(meta) -> str
    "static inline void duo_" .. meta.name .. "_touch(const duo_" .. meta.name .. "* v) { (void)v->x; (void)v->y; }\n"
end)

@comp.define.derive("LayoutApi", generate(meta) -> str
    acc = ""
    for i = 1, #meta.fields
        f = meta.fields[i]
        acc = acc .. "static inline size_t duo_" .. meta.name .. "_off_" .. f.name .. "(void) { return offsetof(duo_" .. meta.name .. ", " .. f.name .. "); }\n"
    end
    acc
end)

@comp.define.bundle("FullApi", TouchApi, LayoutApi)

@c.emit(@comp.derive("HasXY", FullApi))

BUNDLE_LEN = @comp.derive("HasXY", FullApi)

print("bundle_len = " .. to(str)(#BUNDLE_LEN))
print("ok")
