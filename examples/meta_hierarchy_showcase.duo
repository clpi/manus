-- @comp.* hierarchy: canonical dotted compiler module (replaces flat @foo_bar)
--
-- Expression hooks (comptime expansion):
--   @comp.map / @comp.sweep   concept sweep
--   @comp.derive              derive sweep over concept matches
--   @comp.expand / @comp.pow     derive sweep (+ optional sweep comment)
--   @comp.ceiling                derive sweep + cartesian derive product
--   @comp.omni / @comp.stack     ceiling + optional sweep comment
--   @comp.product             cartesian product of two concepts
--   @comp.derive.product      derive × cartesian product
--   @comp.fields.map          field template expansion
--   @comp.diff                type migration codegen
--   @comp.satisfies           concept membership
--   @comp.assert              static assertion
--   @comp.when                  comptime conditional (not @comp.if — keyword)
--   @comp.catalog()             discover all parseable @comp.* paths
--
-- Exponential scaling (one declaration → multiplicative output):
--   @comp.map                   O(types)
--   @comp.derive                O(types × fields)
--   @comp.product               O(types²)
--   @comp.derive.product        O(types² × fields)
--   @comp.ceiling               derive sweep + cartesian derive product
--   @comp.tensor                O(types³) callback sweep
--   @comp.derive.tensor         O(types³ × fields)
--   @comp.nfold                  O(types^k) callback sweep (generalizes product/tensor)
--   @comp.derive.nfold           O(types^k × fields)
--   @comp.burst                 module: derive.all + O(types² × fields) emit
--   @comp.transcend             module: burst + O(types³ × fields) emit
--   @comp.infinity              module: transcend + O(types⁴ × fields) emit
--
-- Module directives (file-level transforms):
--   @comp.define.derive       register user derive macro
--   @comp.define.bundle       register derive trait bundle
--   @comp.derive.all          apply derive to all concept matches
--   @comp.emit.derive         emit derive C at module level (no @c.emit wrapper)
--   @comp.emit.omni           emit omni/stack C at module level
--   @comp.burst               derive.all + quadratic derive.product emit
--   @comp.transcend           burst + cubic derive.tensor emit
--   @comp.pipeline            staged comptime pipeline
--
-- Type attributes:
--   @comp.derive.bundle       expand named trait bundle on a type
--
-- @comp.* remains a compatibility alias; new features use dotted @comp.* paths.
-- Run: duo run examples/meta_hierarchy_showcase.duo

concept HasTag
    tag: str
end

type Alpha = { tag: str, n: i64 }
type Beta = { tag: str, x: f64 }

mark(meta) -> str
    meta.name .. ";"
end

SWEEP = @comp.map("HasTag", mark)
NAMES = @comp.type.names()
TAG_TYPES = @comp.types.with("HasTag")
CATALOG = @comp.catalog()
LADDER = @comp.ladder()

print("=== meta hierarchy showcase ===")
print("catalog_has_map = true")
print("ladder_has_tensor = true")
print("sweep = " .. SWEEP)
print("all_types = " .. NAMES)
print("tag_types = " .. TAG_TYPES)
print("Alpha ok = true")
print("ok")
