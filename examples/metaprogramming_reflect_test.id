

point: { x: f64, y: f64, z: f64 } =
  x = 1.0
  y = 2.0
  z = 3.0

fields = @comp.fields(point)
print("field count = " .. to(str)(fields:len()))
for i = 1, fields:len()
  print("  field " .. to(str)(i) .. ": name=" .. fields(i).name .. " type=" .. fields(i).type)


print("has x = " .. to(str)(@comp.has.field(point, "x")))
print("has w = " .. to(str)(@comp.has.field(point, "w")))


print("field_type(x) = " .. @comp.field.type(point, "x"))
print("field_type(y) = " .. @comp.field.type(point, "y"))


off_x = @comp.field.offset(point, "x")
off_y = @comp.field.offset(point, "y")
off_z = @comp.field.offset(point, "z")
sz_x = @comp.field.size(point, "x")

print("offset(x) = " .. to(str)(off_x))
print("offset(y) = " .. to(str)(off_y))
print("offset(z) = " .. to(str)(off_z))
print("size(x) = " .. to(str)(sz_x))


enum Color
  Red
  Green
  Blue

c = Color.Red
color_fields = @comp.fields(c)
print("enum variant count = " .. to(str)(color_fields:len()))
for i = 1, color_fields:len()
  print("  variant " .. to(str)(i) .. ": name=" .. color_fields(i).name)


variants = @comp.variants(c)
print("variants count = " .. to(str)(variants:len()))
for i = 1, variants:len()
  print("  " .. variants(i).name .. " tag=" .. to(str)(variants(i).tag) .. " arity=" .. to(str)(variants(i).arity))


bf_size = @comp.bit.field("Flags", "active", 1, "priority", 3, "mode", 4)
print("bitfield size = " .. to(str)(bf_size))


union_size = @comp.union("NumericValue", "i", "int64_t", "f", "double", "p", "void*")
print("union size = " .. to(str)(union_size))

print("ALL REFLECTION TESTS PASSED")
