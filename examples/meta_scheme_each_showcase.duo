-- @comp.scheme → @comp.each — declarative units then per-fragment re-expansion
-- Run: duo run examples/meta_scheme_each_showcase.duo

DECLS = "type Point { x: double, y: double } | fn add(a: Point, b: Point) -> Point"
TMPL = "/* scheme[$kind $name] fields={$fields} params={$params} */\n"

SCHEME = @comp.scheme(DECLS, TMPL)

fun stamp(frag) -> str
    "/* each[" .. tostring(frag.index) .. "/" .. tostring(frag.count) .. "] " .. frag.name .. " */\n"
end

EXPANDED = @comp.each(SCHEME, stamp)

fun count_lines(s) -> i64
    n = 0
    for i = 1, #s
        if string.sub(s, i, i) == "\n" then n += 1 end
    end
    n
end

LINES = count_lines(EXPANDED)

print("=== @comp.scheme → @comp.each ===")
print(EXPANDED)
print("fragments = " .. tostring(LINES) .. "  (expect 2 = type + fn)")
print("RESULT scheme_each_ok = " .. tostring(LINES == 2))
