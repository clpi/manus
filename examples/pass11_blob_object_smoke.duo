-- Pass 11 WP-05: byte blob constants + @comp.native.load.u8 → direct Mach-O object.
-- Matches native_backend.zig unit test "Pass 11 WP-05: byte blob + load_u8 intrinsic".
wasm_header = { 0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00 }

read_u8_at(base: i64, off: i64): i64
    @comp.native.load.u8(base, off)
end

main(): i64
    base = wasm_header
    b0 = read_u8_at(base, 0)
    b3 = read_u8_at(base, 3)
    if b0 != 0 return 1001 end
    if b3 != 0x6D return 1004 end
    0
end
