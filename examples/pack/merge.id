
scan: i64 | error = (b: i64)
    if b > 63
        return nil, "over"
    if b > 0
        return b, nil
    nil, "trunc"

good = "?"
high = "?"
low = "?"
if v, e = scan(42)
    good = "{v}"
else
    good = "err {e}"
if v, e = scan(99)
    high = "ok {v}"
else
    high = e
if v, e = scan(0)
    low = "ok {v}"
else
    low = e
print("{good} {high} {low}")
