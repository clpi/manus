
point: { x: f64, y: f64 }

first: any = (t: any)
    t.x

second: any = (t: any)
    t.y

kind: { eof, ident }

p: point = { x = 3.0, y = 4.0 }
print(p.x)
print(p.y)

braced = first{ x = 7.0, y = 8.0 }
parened = first({ x = 7.0, y = 8.0 })
print(braced)
print(parened)

print(second{ x = 1.0, y = 9.0 })

print(kind.ident)

q = point{ x = 3.0, y = 4.0 }
print(q.x)
print(q.y)

r = point{ 5.0, 6.0 }
print(r.x)

