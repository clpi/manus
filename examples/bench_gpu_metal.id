# bench_gpu_metal.id — GPU (Metal) vs CPU matrix multiplication benchmark
# Demonstrates Duo FFI to Metal compute shaders on macOS Apple Silicon.
#
# Build: see scripts/run_gpu_benchmark.sh
# Requires: macOS with Metal-capable GPU

# FFI declarations for the Metal helper (metal_compute.m)
@ffi("metal_init")
metal_init: i32 = ()
  void
@ffi("metal_matmul")
metal_matmul: i32 = (a: ptr, b: ptr, c: ptr, M: i32, N: i32, K: i32)
  void
@ffi("metal_sync")
metal_sync()

@ffi("metal_cleanup")
metal_cleanup()

# C stdlib timing
@comp.c.include("time.h")

@comp.c.include("stdlib.h")

@comp.c.include("stdio.h")

@comp.c.include("string.h")


# Helper: get time in seconds
clock_sec: float = ()
  @comp.c.emit([[
    struct timespec _ts;
    clock_gettime(CLOCK_MONOTONIC, &_ts);
    return (double)_ts.tv_sec + (double)_ts.tv_nsec * 1e-9;
  ]])
  

# Helper: allocate float array
alloc_floats: ptr = (n: i32)
  @comp.c.emit("return calloc((size_t)n, sizeof(float));")
  

# Helper: free float array
free_floats = (p: ptr)
  @comp.c.emit("free(p);")
  

# Helper: set float at index
set_float = (p: ptr, idx: i32, val: float)
  @comp.c.emit("((float*)p)[idx] = val;")
  

# Helper: get float at index
get_float: float = (p: ptr, idx: i32)
  @comp.c.emit("return ((float*)p)[idx];")
  

# CPU matmul: C = A * B, all MxN with inner dim K
# Emitted as raw C for fair comparison (typed Duo compiles to this anyway)
@hot
cpu_matmul: void = (a: ptr, b: ptr, c: ptr, M: i32, N: i32, K: i32)
  @comp.c.emit([[
    float* A = (float*)a;
    float* B = (float*)b;
    float* C = (float*)c;
    for (int r = 0; r < M; r++) {
      for (int c_idx = 0; c_idx < N; c_idx++) {
        float sum = 0.0f;
        for (int i = 0; i < K; i++) {
          sum += A[r * K + i] * B[i * N + c_idx];
        }
        C[r * N + c_idx] = sum;
      }
    }
  ]])
  

# Fill matrix with pseudo-random values
fill_random = (p: ptr, n: i32)
  @comp.c.emit([[
    float* arr = (float*)p;
    for (int i = 0; i < n; i++) {
      arr[i] = (float)(i % 97) * 0.01f;
    }
  ]])
  

# Verify results match (returns max absolute error)
max_error: float = (a: ptr, b: ptr, n: i32)
  @comp.c.emit([[
    float* x = (float*)a;
    float* y = (float*)b;
    float maxe = 0.0f;
    for (int i = 0; i < n; i++) {
      float d = x[i] - y[i]; if (d < 0) d = -d;
      if (d > maxe) maxe = d;
    }
    return maxe;
  ]])
  

# Main benchmark
run_bench = ()
  const DIM = 1024
  const SIZE = DIM * DIM

  print("=== Duo GPU (Metal) vs CPU Matmul Benchmark ===")
  print("Matrix size: ", DIM, "x", DIM)
  print("")

  # Allocate matrices
  a = alloc_floats(SIZE)
  b = alloc_floats(SIZE)
  c_gpu = alloc_floats(SIZE)
  c_cpu = alloc_floats(SIZE)

  # Fill with data
  fill_random(a, SIZE)
  fill_random(b, SIZE)

  # Initialize Metal
  print("[bench] Initializing Metal...")
  rc = metal_init()
  if rc != 0
    print("ERROR: Metal initialization failed")
    free_floats(a)
    free_floats(b)
    free_floats(c_gpu)
    free_floats(c_cpu)
    return

  # GPU benchmark (warm-up + timed)
  print("[bench] GPU warm-up...")
  metal_matmul(a, b, c_gpu, DIM, DIM, DIM)
  metal_sync()

  print("[bench] GPU timed run...")
  t0 = clock_sec()
  metal_matmul(a, b, c_gpu, DIM, DIM, DIM)
  metal_sync()
  t1 = clock_sec()
  gpu_time = t1 - t0

  # CPU benchmark (warm-up + timed)
  print("[bench] CPU timed run...")
  t0 = clock_sec()
  cpu_matmul(a, b, c_cpu, DIM, DIM, DIM)
  t1 = clock_sec()
  cpu_time = t1 - t0

  # Verify correctness
  err = max_error(c_gpu, c_cpu, SIZE)

  # Results
  print("")
  print("=== Results ===")
  print("GPU (Metal): ", gpu_time, " s")
  print("CPU (naive): ", cpu_time, " s")
  print("Speedup:     ", cpu_time / gpu_time, "x")
  print("Max error:   ", err)
  print("")

  if err < 0.01
    print("PASS — GPU and CPU results match within tolerance")
  else
    print("FAIL — Results diverge (max error too large)")

  # Cleanup
  metal_cleanup()
  free_floats(a)
  free_floats(b)
  free_floats(c_gpu)
  free_floats(c_cpu)

run_bench()
