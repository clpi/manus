
@ffi("metal_init")
fun metal_init() -> i32
  void
end
@ffi("metal_matmul")
fun metal_matmul(a: ptr, b: ptr, c: ptr, M: i32, N: i32, K: i32) -> i32
  void
end
@ffi("metal_sync")
metal_sync()

@ffi("metal_cleanup")
metal_cleanup()

@cinclude("time.h")


@cinclude("stdlib.h")


@cinclude("stdio.h")


@cinclude("string.h")


fun clock_sec() -> float
  @comp.c.emit([[
    struct timespec _ts;
    clock_gettime(CLOCK_MONOTONIC, &_ts);
    return (double)_ts.tv_sec + (double)_ts.tv_nsec * 1e-9;
  ]])
  
end

fun alloc_floats(n: i32) -> ptr
  @comp.c.emit("return calloc((size_t)n, sizeof(float));")
  
end

fun free_floats(p: ptr)
  @comp.c.emit("free(p);")
  
end

fun set_float(p: ptr, idx: i32, val: float)
  @comp.c.emit("((float*)p)[idx] = val;")
  
end

fun get_float(p: ptr, idx: i32) -> float
  @comp.c.emit("return ((float*)p)[idx];")
  
end

@hot
fun cpu_matmul(a: ptr, b: ptr, c: ptr, M: i32, N: i32, K: i32) -> void
  @comp.c.emit([[
    float* A = (float*)a;
    float* B = (float*)b;
    float* C = (float*)c;
    for (int r = 0; r < M; r++) {
      for (int c_idx = 0; c_idx < N; c_idx++) {
        float sum = 0.0f;
        for (int i = 0; i < K; i++) {
          sum += A[r * K + i] * B[i * N + c_idx];
        }
        C[r * N + c_idx] = sum;
      }
    }
  ]])
  
end

fun fill_random(p: ptr, n: i32)
  @comp.c.emit([[
    float* arr = (float*)p;
    for (int i = 0; i < n; i++) {
      arr[i] = (float)(i % 97) * 0.01f;
    }
  ]])
  
end

fun max_error(a: ptr, b: ptr, n: i32) -> float
  @comp.c.emit([[
    float* x = (float*)a;
    float* y = (float*)b;
    float maxe = 0.0f;
    for (int i = 0; i < n; i++) {
      float d = x[i] - y[i]; if (d < 0) d = -d;
      if (d > maxe) maxe = d;
    }
    return maxe;
  ]])
  
end

fun run_bench()
  const DIM = 1024
  const SIZE = DIM * DIM

  print("=== Duo GPU (Metal) vs CPU Matmul Benchmark ===")
  print("Matrix size: ", DIM, "x", DIM)
  print("")

  a = alloc_floats(SIZE)
  b = alloc_floats(SIZE)
  c_gpu = alloc_floats(SIZE)
  c_cpu = alloc_floats(SIZE)

  fill_random(a, SIZE)
  fill_random(b, SIZE)

  print("[bench] Initializing Metal...")
  rc = metal_init()
  if rc != 0 then
    print("ERROR: Metal initialization failed")
    free_floats(a)
    free_floats(b)
    free_floats(c_gpu)
    free_floats(c_cpu)
    return
  end

  print("[bench] GPU warm-up...")
  metal_matmul(a, b, c_gpu, DIM, DIM, DIM)
  metal_sync()

  print("[bench] GPU timed run...")
  t0 = clock_sec()
  metal_matmul(a, b, c_gpu, DIM, DIM, DIM)
  metal_sync()
  t1 = clock_sec()
  gpu_time = t1 - t0

  print("[bench] CPU timed run...")
  t0 = clock_sec()
  cpu_matmul(a, b, c_cpu, DIM, DIM, DIM)
  t1 = clock_sec()
  cpu_time = t1 - t0

  err = max_error(c_gpu, c_cpu, SIZE)

  print("")
  print("=== Results ===")
  print("GPU (Metal): ", gpu_time, " s")
  print("CPU (naive): ", cpu_time, " s")
  print("Speedup:     ", cpu_time / gpu_time, "x")
  print("Max error:   ", err)
  print("")

  if err < 0.01 then
    print("PASS — GPU and CPU results match within tolerance")
  else
    print("FAIL — Results diverge (max error too large)")
  end

  metal_cleanup()
  free_floats(a)
  free_floats(b)
  free_floats(c_gpu)
  free_floats(c_cpu)
end

run_bench()
