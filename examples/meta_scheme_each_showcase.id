
DECLS = "type Point { x: double, y: double } | fn add(a: Point, b: Point) -> Point"
tmpl = "/* scheme[$kind $name] fields={$fields} params={$params} */\n"

SCHEME = @comp.scheme(DECLS, tmpl)

stamp: str = (frag: str)
  "/* each[" .. to(str)(frag.index) .. "/" .. to(str)(frag.count) .. "] " .. frag.name .. " */\n"

expanded = @comp.each(SCHEME, stamp)

count_lines: i64 = (s: str)
  n = 0
  for i = 1, s:len()
    if s:sub(i, i) == "\n"
      n = n + 1
  n

LINES = count_lines(expanded)

print("=== @comp.scheme → @comp.each ===")
print(expanded)
print("fragments = " .. to(str)(LINES) .. "  (expect 2 = type + fn)")
print("RESULT scheme_each_ok = " .. to(str)(LINES == 2))
