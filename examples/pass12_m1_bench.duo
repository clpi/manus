-- Pass 12 M1 — measured benchmark for the Duo-native keyword classifier.
-- Compares the three candidate realizations (branch chain / sorted lookup /
-- length bucket) over native `const char*` inputs. The hot loop classifies
-- literals directly (fully native strcmp path, zero boxing) and rotates
-- through representative keywords + a negative.
-- Run: duo run examples/pass12_m1_bench.duo
C = req "std.token.classify"

main(): i64
    ITER = 400000
    -- Warm the pipeline.
    j = 1
    while j <= 1000
        _ = C.classify_branch_chain("and")
        j = j + 1
    end

    t0 = os.clock()
    acc = 0
    it = 1
    while it <= ITER
        acc = acc + C.classify_branch_chain("function")
        it = it + 1
    end
    t1 = os.clock()

    it = 1
    while it <= ITER
        acc = acc + C.classify_sorted_lookup("function")
        it = it + 1
    end
    t2 = os.clock()

    it = 1
    while it <= ITER
        acc = acc + C.classify_length_bucket("function")
        it = it + 1
    end
    t3 = os.clock()

    it = 1
    while it <= ITER
        acc = acc + C.classify_branch_chain("let")
        it = it + 1
    end
    t4 = os.clock()

    it = 1
    while it <= ITER
        acc = acc + C.classify_branch_chain("identifier_xy")
        it = it + 1
    end
    t5 = os.clock()

    tb = t1 - t0
    ts = t2 - t1
    tl = t3 - t2
    t_let = t4 - t3
    t_neg = t5 - t4
    print("RESULT m1_iters_per_phase " .. ITER)
    print("RESULT m1_branch_chain_function_s " .. string.format("%.4f", tb))
    print("RESULT m1_sorted_lookup_function_s " .. string.format("%.4f", ts))
    print("RESULT m1_length_bucket_function_s " .. string.format("%.4f", tl))
    print("RESULT m1_branch_chain_let_s " .. string.format("%.4f", t_let))
    print("RESULT m1_branch_chain_neg_s " .. string.format("%.4f", t_neg))
    print("RESULT m1_ns_per_call_branch " .. string.format("%.2f", tb * 1e9 / ITER))
    print("RESULT m1_ns_per_call_sorted " .. string.format("%.2f", ts * 1e9 / ITER))
    print("RESULT m1_ns_per_call_length " .. string.format("%.2f", tl * 1e9 / ITER))
    print("RESULT m1_ns_per_call_let " .. string.format("%.2f", t_let * 1e9 / ITER))
    print("RESULT m1_ns_per_call_neg " .. string.format("%.2f", t_neg * 1e9 / ITER))
    print("RESULT m1_smoke " .. acc)

    0
end
