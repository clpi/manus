
concept Equatable
    eq(self, other): bool

point = {}
point.x = 10.0
point.y = 20.0
point.clone = (self)
    c = {}
    c.x = self.x
    c.y = self.y
    c
point.eq = (self, other): bool
    if other == nil return false 
    self.x == other.x and self.y == other.y
point.tostring = (self): str
    "Point(" .. to(str)(self.x) .. ", " .. to(str)(self.y) .. ")"

cloned = point:clone()
print("Original: " .. point:tostring())
print("Cloned:   " .. cloned:tostring())
print("Eq:       " .. to(str)(point:eq(cloned)))

print("\nPoint fields:")
fields = {}
for k, _ in point
    fields[fields:len() + 1] = k
for _, name in fields
    print("  " .. name .. ": " .. type(point[name]))

print("\nType sizes (bytes):")
print("  i64: 8")
print("  f64: 8")
print("  i32: 4")
print("  f32: 4")
print("  bool: 1")
print("  str pointer: 8")
