-- @meta.each — universal composition glue (closes the combinator algebra).
--
-- The combinator ladder (map→derive→product→tensor→nfold→power→permute) enumerates
-- type sets exponentially, but each combinator is one-shot: its output cannot feed
-- into another. @meta.each fixes that — it splits any combinator's string output
-- into fragments and applies a callback to each, so ONE declaration can chain
-- multiple exponential stages:
--
--   @meta.map  : O(n)                ─┐
--   @meta.each( map_output, fn )      ─┘  re-expand each fragment → O(n × per-frag work)
--
-- meta.name = fragment text, meta.index = 0-based, meta.count = total fragments.
-- All output is native C, folded at compile time — no lua_Value intermediaries.

concept HasXY
    x: f64
    y: f64
end

type Vec2 = { x: f64, y: f64 }
type Vec3 = { x: f64, y: f64, z: f64 }
type Pt = { x: f64, y: f64 }

-- Stage 1: @meta.map produces "Name;" fragments for each matching type.
fun type_sig(m) -> str
    m.name .. ";"
end

NAMES = @meta.map("HasXY", type_sig)

-- Stage 2: @meta.each splits that output and re-expands each fragment.
fun expand(frag) -> str
    "/* each[" .. tostring(frag.index) .. "/" .. tostring(frag.count) .. "] = " .. frag.name .. " */\n"
end

EXPANDED = @meta.each(NAMES, expand)

print("=== @meta.map output ===")
print(NAMES)
print("=== @meta.each re-expansion (composition) ===")
print(EXPANDED)

LINES = @comp.str.countlines(EXPANDED)
print("map→each fragments = " .. tostring(LINES) .. "  (expect 3 = one per type)")

-- Stage 3: compose @meta.power (2^n) with @meta.each — nest an exponential
-- stage inside the composition glue. 3 types → 2^3-1 = 7 subsets.
fun subset_sig(subset) -> str
    subset.name .. ";"
end

SUBSETS = @meta.power("HasXY", subset_sig)

fun stamp(frag) -> str
    "/* pow[" .. tostring(frag.index) .. "/" .. tostring(frag.count) .. "] " .. frag.name .. " */\n"
end

POWER_EACH = @meta.each(SUBSETS, stamp)
POWER_LINES = @comp.str.countlines(POWER_EACH)
print("power→each fragments = " .. tostring(POWER_LINES) .. "  (expect 7 = 2^3-1)")

ok = (LINES == 3 and POWER_LINES == 7)
print("=== RESULT ===")
print("compose_each_ok = " .. tostring(ok))
