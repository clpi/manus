
@comp.pipeline({
    fn = "sum_mapped",
    elem = "int64_t",
    kind = "reduce",
    init = "0",
    map = "map_double",
    filter = "keep_positive",
    reduce = "acc_add",
})

@comp.c.emit([[
static inline int64_t map_double(int64_t x) { return x * 2; }
static inline int keep_positive(int64_t x) { return x > 0; }
static inline int64_t acc_add(int64_t a, int64_t b) { return a + b; }
static const int64_t pipeline_data[] = { 1, 2, 3, 4, 5 };
]])

total: i64 = ()
    @comp.c.call("sum_mapped", @(pipeline_data), @(5))

print("=== @comp.pipeline table showcase ===")
print("sum_mapped(1..5, map*2, >0) = " .. to(str)(total()))
