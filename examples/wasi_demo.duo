-- WASI type system demo: WebAssembly System Interface types
-- Demonstrates WASI type constants and bindings

-- WASI errno constants
errno_success(): u16    0 end
errno_badf(): u16       8 end
errno_exist(): u16      20 end
errno_noent(): u16      44 end
errno_perm(): u16       63 end
errno_inval(): u16      28 end
errno_notdir(): u16     54 end
errno_overflow(): u16   61 end

-- WASI file descriptor types
fd_stdin(): i32    0 end
fd_stdout(): i32   1 end
fd_stderr(): i32   2 end

-- WASI rights
right_fd_read(): u64        1 end
right_fd_write(): u64       2 end
right_fd_seek(): u64        4 end
right_fd_fdstat_get(): u64  16 end
right_poll_oneoff(): u64    256 end
right_sock_accept(): u64    65536 end

-- WASI open flags
oflags_creat(): u16      1 end
oflags_directory(): u16  2 end
oflags_excl(): u16       4 end
oflags_trunc(): u16      8 end

-- WASI file types
filetype_unknown(): u8            0 end
filetype_block_device(): u8       1 end
filetype_character_device(): u8   2 end
filetype_directory(): u8          3 end
filetype_regular_file(): u8       4 end
filetype_socket_dgram(): u8       5 end
filetype_socket_stream(): u8      6 end
filetype_symlink(): u8            7 end

-- WASI clock IDs
clockid_realtime(): u32               0 end
clockid_monotonic(): u32              1 end
clockid_process_cputime_id(): u32     2 end
clockid_thread_cputime_id(): u32      3 end

-- WASI event types
eventtype_clock(): u8     0 end
eventtype_fd_read(): u8   1 end
eventtype_fd_write(): u8  2 end

-- WASI whence (seek origin)
whence_set(): u8  0 end
whence_cur(): u8  1 end
whence_end(): u8  2 end

-- WASI signal constants
signal_hup(): u8   1 end
signal_int(): u8   2 end
signal_quit(): u8  3 end
signal_kill(): u8  9 end
signal_term(): u8  15 end

-- WASI exit codes
exit_success(): u32  0 end
exit_failure(): u32  1 end

-- WASI timestamp helpers
timestamp_second(): u64      1000000000 end
timestamp_millisecond(): u64 1000000 end
timestamp_microsecond(): u64 1000 end

print("=== WASI File Descriptors ===")
print("stdin:  " .. to(str)(fd_stdin()))
print("stdout: " .. to(str)(fd_stdout()))
print("stderr: " .. to(str)(fd_stderr()))

print("\n=== WASI Rights ===")
print("fd_read:  " .. to(str)(right_fd_read()))
print("fd_write: " .. to(str)(right_fd_write()))
print("fd_seek:  " .. to(str)(right_fd_seek()))
print("poll_one: " .. to(str)(right_poll_oneoff()))
print("sock_accept: " .. to(str)(right_sock_accept()))

print("\n=== WASI Open Flags ===")
print("oflags_creat: " .. to(str)(oflags_creat()))
print("oflags_dir:   " .. to(str)(oflags_directory()))
print("oflags_excl:  " .. to(str)(oflags_excl()))
print("oflags_trunc: " .. to(str)(oflags_trunc()))

print("\n=== WASI File Types ===")
print("regular_file: " .. to(str)(filetype_regular_file()))
print("directory:     " .. to(str)(filetype_directory()))
print("symlink:       " .. to(str)(filetype_symlink()))
print("sock_stream:   " .. to(str)(filetype_socket_stream()))

print("\n=== WASI Clock IDs ===")
print("realtime:   " .. to(str)(clockid_realtime()))
print("monotonic:  " .. to(str)(clockid_monotonic()))

print("\n=== WASI Whence (Seek) ===")
print("set: " .. to(str)(whence_set()))
print("cur: " .. to(str)(whence_cur()))
print("end: " .. to(str)(whence_end()))

print("\n=== WASI Signals ===")
print("SIGHUP:  " .. to(str)(signal_hup()))
print("SIGINT:  " .. to(str)(signal_int()))
print("SIGTERM: " .. to(str)(signal_term()))
print("SIGKILL: " .. to(str)(signal_kill()))

print("\n=== WASI Exit Codes ===")
print("success: " .. to(str)(exit_success()))
print("failure: " .. to(str)(exit_failure()))

print("\n=== WASI Timestamps ===")
print("1 second in ns: " .. to(str)(timestamp_second()))
print("1 ms in ns:     " .. to(str)(timestamp_millisecond()))
print("1 us in ns:     " .. to(str)(timestamp_microsecond()))

print("\n=== WASI Errnos ===")
print("success:  " .. to(str)(errno_success()))
print("noent:    " .. to(str)(errno_noent()))
print("perm:     " .. to(str)(errno_perm()))
print("inval:    " .. to(str)(errno_inval()))
print("overflow: " .. to(str)(errno_overflow()))
