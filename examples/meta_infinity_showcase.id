# @comp.infinity: quartic ceiling breaker — transcend + O(n^4 × fields) in one directive
# Run: duo run examples/meta_infinity_showcase.id

concept HasXY
  x: f64
  y: f64

concept HasTag
  tag: str

concept HasId
  id: i64

concept HasExtra
  extra: i64

point: { x: f64, y: f64, tag: str, id: i64, extra: i64 }
pair: { x: f64, y: f64, tag: str, id: i64, extra: i64 }
label: { tag: str, id: i64, extra: i64 }

# One line: derive.all + quadratic + cubic + quartic emit

@comp.define.derive("QuadApi", generate: str = (meta)
    if meta.parts != nil and meta.parts:len() >= 4
        "/* quad " .. meta.name .. " */\n"
    else
        acc = ""
        for i = 1, meta.fields:len()
            f = meta.fields[i]
            acc = acc .. "static inline void duo_" .. meta.name .. "_touch_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
        acc
)

@comp.infinity("HasXY", QuadApi, "HasTag", "HasId", "HasExtra")

quad_sig: str = (a, b, c, d)
  a.name .. "x" .. b.name .. "x" .. c.name .. "x" .. d.name .. ";"

NFOLD = @comp.nfold({ "HasXY", "HasTag", "HasId", "HasExtra" }, quad_sig)
LADDER = @comp.ladder()

print("=== meta infinity showcase ===")
print("has_infinity = " .. to(str)(@comp.str.contains(LADDER, "infinity:")))
print("nfold = " .. NFOLD)
print("point ok = true")
print("ok")
