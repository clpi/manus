# Reflection demo: runtime type introspection using Duo's type system

# Test basic type introspection
typeof_str(x): str
    if x == nil return "nil" end
    if type(x) != "table" return type(x) end
    mt = getmetatable(x)
    if mt != nil and mt.type != nil return mt.type end
    "table"
end

is_nil(x): bool    x == nil end
is_bool(x): bool   type(x) == "boolean" end
is_number(x): bool type(x) == "number" end
is_str(x): bool    type(x) == "string" end
is_table(x): bool  type(x) == "table" end
is_integer(x): bool
    if type(x) != "number" return false end
    x == x:floor()
end

# Test values
print("typeof(nil): " .. typeof_str(nil))
print("typeof(true): " .. typeof_str(true))
print("typeof(42): " .. typeof_str(42))
print("typeof(3.14): " .. typeof_str(3.14))
print("typeof('hello'): " .. typeof_str("hello"))
print("typeof({}): " .. typeof_str({}))

# Detailed checks
print("\nDetailed checks:")
print("is_nil(nil):        " .. to(str)(is_nil(nil)))
print("is_bool(true):      " .. to(str)(is_bool(true)))
print("is_number(42):      " .. to(str)(is_number(42)))
print("is_integer(42):     " .. to(str)(is_integer(42)))
print("is_float(3.14):     " .. to(str)(not is_integer(3.14)))
print("is_str('hi'):       " .. to(str)(is_str("hi")))
print("is_table({}):       " .. to(str)(is_table({})))

# Field introspection on a table
person = {
    name = "Alice",
    age = 30,
}

print("\nPerson introspection:")
print("has field 'name': " .. to(str)(person.name != nil))
print("has field 'email': " .. to(str)(person.email != nil))

# Table utilities
clone(t)
    if type(t) != "table" return t end
    c = {}
    for k, v in t do c[k] = v end
    c
end

shallow_eq(a, b): bool
    if a == b return true end
    if type(a) != "table" or type(b) != "table" return false end
    for k, v in a do
        if b[k] != v return false end
    end
    for k, _ in b do
        if a[k] == nil return false end
    end
    true
end

t = { a = 1, b = 2, c = 3 }
print("\nTable utils:")
print("len: " .. to(str)(t:len()))
print("has 'b': " .. to(str)(t.b != nil))

shallow = clone(t)
print("shallow_eq: " .. to(str)(shallow_eq(t, shallow)))
