-- Test basic bash-style fun calls

-- Define a simple fun
greet(name: str): str
    "Hello, " .. name
end

-- Traditional Lua-style call
print(greet("World"))

-- Bash-style call (no parentheses)
print greet "Duo"

-- Multiple arguments
add(a: i64, b: i64): i64
    a + b
end

-- Bash-style call with multiple arguments
print add 5 3