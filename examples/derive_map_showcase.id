
concept HasXY
  x: f64
  y: f64

point: { x: f64, y: f64 }
pair: { x: f64, y: f64 }

@comp.define.derive("TouchApi", generate: str = (meta)
    acc = "/* " .. meta.name .. " touch API */\n"
    for i = 1, meta.fields:len()
        f = meta.fields[i]
        acc = acc .. "static inline void duo_" .. meta.name .. "_read_" .. f.name .. "(const duo_" .. meta.name .. "* v) { (void)v->" .. f.name .. "; }\n"
    acc
)

__emit(@comp.derive("HasXY", TouchApi))

API_LEN = @comp.derive("HasXY", TouchApi)

print("=== derive_map showcase ===")
print("generated_bytes = " .. to(str)(API_LEN:len()))
print("ok")
