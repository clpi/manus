@comp.define.derive("Printable", generate(type_info)
    out = "static void duo_" .. type_info.name .. "_print(duo_" .. type_info.name .. " val) {\n"
    out = out .. "    printf(\"" .. type_info.name .. " { \");\n"
    i = 1
    while i <= type_info.fields:len()
        f = type_info.fields[i]
        if f.type == "int64_t"
            out = out .. "    printf(\"" .. f.name .. ": %lld \", val." .. f.name .. ");\n"
        else if f.type == "const char*"
            out = out .. "    printf(\"" .. f.name .. ": %s \", val." .. f.name .. ");\n"
        i = i + 1
    out = out .. "    printf(\"}\\n\");\n"
    out = out .. "}\n"
    return out
)

@derive(Printable)
foo: {
    x: i64,
    y: str
}

f: foo = { x = 42, y = "hello metaprogramming" }
@comp.c.call("duo_foo_print", f)
