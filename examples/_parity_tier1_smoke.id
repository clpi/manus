
const rows = @comp.match("a|b", (m) if m == "a" "alpha" else "beta")

pick: str = (n: i64)
  if n > 0
    @comp.tabulate(2, (i) "x")
  else
    @comp.map("p q", (t) t)

const grid = @comp.tabulate(2, fun(i)
  @comp.match("even|odd", fun(m)
    if m == "even" "E" else "O"
  )
)

print(rows)
print(pick(1))
print(grid)
