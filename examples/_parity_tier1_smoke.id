# Pass 2.3: G-061 tier-1 parity smoke (manual / CI provenance check)
# Verify: DUO_PROVENANCE=1 duo compile examples/_parity_tier1_smoke.id
# Expect comp.match/map/each/tabulate/interpolate/power/derive.power/fixpoint
# at top_level_assign, nested_callback, and block_body sites.

# top_level_assign site (const fold path)
const rows = @comp.match("a|b", fun(m) if m == "a" "alpha" else "beta" end)

# block_body site (inside function)
pick(n: i64): str
  if n > 0
    @comp.tabulate(2, fun(i) "x" end)
  else
    @comp.map("p q", fun(t) t end)

# nested_callback site (match inside tabulate callback chain)
const grid = @comp.tabulate(2, fun(i)
  @comp.match("even|odd", fun(m)
    if m == "even" "E" else "O"
  end)
end)

print(rows)
print(pick(1))
print(grid)
