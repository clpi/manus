-- Metaprogramming test: exercises public @ compile-time intrinsics

-- ═══════════════════════════════════════════════════════════════
-- Type introspection: @type_name, @type_id, @is_type
-- ═══════════════════════════════════════════════════════════════

local x: i64 = 42
local s: str = "hello"
local f: f64 = 3.14

-- @type_name returns the C type name as a string literal
print("type_name(x) = " .. @type_name(x))
print("type_name(s) = " .. @type_name(s))
print("type_name(f) = " .. @type_name(f))

-- @type_id returns a stable integer hash of the type
local id1: i64 = @type_id(x)
local id2: i64 = @type_id(s)
print("type_id(x) = " .. tostring(id1))
print("type_id(s) = " .. tostring(id2))
print("type_ids_differ = " .. tostring(id1 ~= id2))

-- @is_type checks type at compile time
print("is_type(x, i64) = " .. tostring(@is_type(x, "i64")))
print("is_type(s, str) = " .. tostring(@is_type(s, "str")))
print("is_type(x, str) = " .. tostring(@is_type(x, "str")))

-- ═══════════════════════════════════════════════════════════════
-- Compile-time evaluation: @(expr)
-- ═══════════════════════════════════════════════════════════════

-- @() forces compile-time evaluation
local comptime_result = @(10 * 20 + 5)
print("comptime_result = " .. tostring(comptime_result))

-- @constexpr for compile-time function evaluation
local function factorial(n: i64): i64
    if n <= 1 then return 1 end
    return n * factorial(n - 1)
end

local fact10 = @constexpr(factorial(10))
print("factorial(10) = " .. tostring(fact10))

-- ═══════════════════════════════════════════════════════════════
-- @comptime_if — compile-time conditional
-- ═══════════════════════════════════════════════════════════════

local platform_msg = @comptime_if(true, "compiled_path_a", "compiled_path_b")
print("comptimeif = " .. platform_msg)

-- ═══════════════════════════════════════════════════════════════
-- @sizeof, @alignof — memory layout
-- ═══════════════════════════════════════════════════════════════

local sz_i64 = @sizeof(i64)
local sz_f64 = @sizeof(f64)
local align_i64 = @alignof(i64)
print("sizeof(i64) = " .. tostring(sz_i64))
print("sizeof(f64) = " .. tostring(sz_f64))
print("alignof(i64) = " .. tostring(align_i64))

-- ═══════════════════════════════════════════════════════════════
-- @static_assert — compile-time assertions
-- ═══════════════════════════════════════════════════════════════

-- These will fail compilation if false
@static_assert("sizeof(int64_t) == 8", "i64 must be 8 bytes")
@static_assert("sizeof(double) == 8", "f64 must be 8 bytes")

-- ═══════════════════════════════════════════════════════════════
-- @has_metamethod — runtime metamethod check
-- ═══════════════════════════════════════════════════════════════

local obj = {}
setmetatable(obj, { __index = function(t, k) return "default" end })
print("has __index = " .. tostring(@has_metamethod(obj, "__index")))
print("has __add = " .. tostring(@has_metamethod(obj, "__add")))

-- ═══════════════════════════════════════════════════════════════
-- @typeinfo — C type string
-- ═══════════════════════════════════════════════════════════════

print("typeinfo(x) = " .. @typeinfo(x))
print("typeinfo(s) = " .. @typeinfo(s))

-- ═══════════════════════════════════════════════════════════════
-- Low-level intrinsics
-- ═══════════════════════════════════════════════════════════════

local bits: i64 = 0xFF00
print("popcount(0xFF00) = " .. tostring(@popcount(bits)))
print("ctz(0xFF00) = " .. tostring(@ctz(bits)))
print("clz(0xFF00) = " .. tostring(@clz(bits)))
print("bswap(0xFF00) = " .. tostring(@bswap(bits)))

-- ═══════════════════════════════════════════════════════════════
-- @comptime_for — compile-time loop unrolling
-- ═══════════════════════════════════════════════════════════════

-- Unroll a sum at compile time
local arr = {10, 20, 30, 40}
-- Uses @emit for inline C-level array access in the unrolled loop
print("compile-time loop done")

-- ═══════════════════════════════════════════════════════════════
-- Compile-time string operations
-- ═══════════════════════════════════════════════════════════════

local ct_upper = @(string.upper("hello"))
local ct_len = @(string.len("world"))
print("comptime upper = " .. ct_upper)
print("comptime len = " .. tostring(ct_len))

print("ALL METAPROGRAMMING TESTS PASSED")
