-- Comptime @meta.pipeline + module @meta.pipeline fusion
-- Run: duo run examples/comptime_pipeline_showcase.duo

@meta.pipeline({
    fn = "sum_n",
    source = "range",
    start = 1,
    stop = 11,
    elem = "int64_t",
    kind = "reduce",
    init = "0",
})

-- __pipeline(...) in @(expr) returns fused C source as a comptime string
FUSED_CHARS = @(string.len(@(__pipeline("{ fn = \"probe\", source = \"range\", start = 0, stop = 3, elem = \"int64_t\", kind = \"reduce\", init = \"0\" }"))))

fun total(): i64
    @c.call("sum_n")
end

print("=== comptime @meta.pipeline showcase ===")
print("sum 1..10 = " .. tostring(total()))
print("comptime pipeline codegen size = " .. tostring(FUSED_CHARS) .. " chars")
