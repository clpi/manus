-- Generic type parameters with concept constraints: fun f<T: Concept>(x: T)
-- Constraints are checked at instantiation; methods dispatch to table modules.

concept Hashable
    hash(self) -> i64
end

Good = {}
Good:hash() -> i64
    return 99
end

Bad = {}

fun digest<T: Hashable>(value: T): i64
    value:hash()
end

@comp.assert(@satisfies(Good, "Hashable"), "Good satisfies Hashable")
@comp.assert(not @satisfies(Bad, "Hashable"), "Bad lacks hash")

result = digest(Good)
print("digest(Good): " .. tostring(result))
