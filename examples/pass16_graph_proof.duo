-- SH-07 — the semantic graph's first query, on fixtures and then the corpus.
--
-- NODES are a module's top-level bindings; EDGES are references between them.
-- The query that shape makes answerable, and that no earlier pass can:
--
--   a `_`-prefixed binding with in-degree 0 inside its own file is unreachable
--
-- Unreachable, not merely unused — scripts/module_surface_gate.duo already
-- proves nothing outside the file reaches a `_` name. A PUBLIC binding with
-- in-degree 0 is not dead: it is the module surface. That asymmetry is the
-- whole reason the query means something, and fixture 3 pins it.
--
-- Corpus result on first run: one hit, lib/std/sqlite.duo `_const`. It was not
-- dead code — its own comment said "Constants exported for user code", so it
-- was a binding documented as public and named private, which is why nothing
-- could reach it. Renamed to `constant`. The graph found a visibility
-- contradiction, which is a better class of finding than dead code.
--
-- GRAPH_FLOOR (default 0) ratchets: no new unreachable privates.
--
-- Exit: 0 pass, 1..N failing fixture, 100 corpus floor.

global strm = req "std.str"
global G = req "std.compiler.graph"

fixtures = (): i64
    -- a private that IS referenced is not dead
    if G.dead_private("_helper(a: i64): i64\n    a\nend\nf(b: i64): i64\n    _helper(b)\nend\n", "t.duo", false) != 0
        return 1
    end
    -- the case that must FIRE
    if G.dead_private("_helper(a: i64): i64\n    a\nend\nf(b: i64): i64\n    b\nend\n", "t.duo", false) != 1
        return 2
    end
    -- a PUBLIC binding with in-degree 0 is the surface, not dead
    if G.dead_private("f(b: i64): i64\n    b\nend\n", "t.duo", false) != 0
        return 3
    end
    0
end

main(): i64
    bad: i64 = fixtures()
    if bad != 0
        print("graph_proof: FAIL — fixture " .. to(str)(bad))
        return bad
    end

    listing = std.script.capture("find " .. std.script.getenv("DUO_ROOT", ".")
        .. "/lib/std -name '*.duo' 2>/dev/null | grep -v '/os/linux.duo'")
    n: i64 = #listing
    files: i64 = 0
    total: i64 = 0
    start: i64 = 1
    i: i64 = 1
    while i <= n + 1
        at_end = i > n
        eol = false
        if not at_end
            eol = string.byte(listing, i) == 10
        end
        if at_end or eol
            if i > start
                path = strm.sub(listing, start, i - 1)
                fh = io.open(path, "r")
                if fh
                    src = fh:read("a")
                    fh:close()
                    files += 1
                    total += G.dead_private(src, path, true)
                end
            end
            start = i + 1
        end
        i += 1
    end

    print("graph_proof: fixtures 3/3; corpus " .. to(str)(files) .. " files, "
        .. to(str)(total) .. " unreachable private bindings")
    ceiling: i64 = to(i64)(std.script.getenv("GRAPH_FLOOR", "0"))
    if total > ceiling
        print("graph_proof: FAIL — ceiling is " .. to(str)(ceiling))
        return 100
    end
    print("graph_proof: PASS")
    0
end
