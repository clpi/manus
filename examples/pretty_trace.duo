-- std.trace — beautiful, semantically-formatted trace & debug output
--
-- Design:
--   * Every event is signed with a beautiful Unicode glyph and colored
--     by severity. Bold/italic/dim/underline carry semantic meaning
--     (see LEGEND below).
--   * Spans can be opened/closed and timed.
--   * Field values are colored by Lua TYPE so a glance reveals shape:
--       string  => green       ("…")
--       number  => yellow      (123 / 1.5)
--       boolean => magenta     (true / false)
--       nil     => dim italic  (nil)
--       table   => cyan        ({…})
--       function=> italic cyan(⟪fn⟫)
--   * Source locations are underline; function names are magenta-italic;
--     timestamps are dim; slow durations are bold-yellow.
--   * Honors NO_COLOR / DUO_COLOR env vars.
--
-- LEGEND of formatting semantics:
--   bold      = essential payload (msg, error text, slow span durs)
--   italic   = identity (function names, type names, nil)
--   dim      = ancillary (timestamps, caller meta, trace level)
--   underline= location references (file:line, field keys)
--   color    = severity / type class
--
-- NOTE: this module is intentionally self-contained — it does not
-- `req` other stdlib modules at top level. The current codegen drops
-- top-level `local x = req "stdlib"` bindings when a stdlib module is
-- inlined under `duo run`; inlining ANSI codes + tty detection here
-- keeps std.trace compilable today. When that codegen gap is fixed,
-- trace.duo can switch back to `local color = req "std.color"` etc.

global M = {}

-- ─── ANSI codes (inline copy of std.color) ─────────────────────────
M.RESET     = "\x1b[0m"
M.BOLD      = "\x1b[1m"
M.DIM       = "\x1b[2m"
M.ITALIC    = "\x1b[3m"
M.UNDERLINE = "\x1b[4m"
M.BLACK     = "\x1b[30m"
M.RED       = "\x1b[31m"
M.GREEN     = "\x1b[32m"
M.YELLOW    = "\x1b[33m"
M.BLUE      = "\x1b[34m"
M.MAGENTA   = "\x1b[35m"
M.CYAN      = "\x1b[36m"
M.WHITE     = "\x1b[37m"

-- ─── Glyphs ────────────────────────────────────────────────────────
M.G_TRACE      = "∘"
M.G_DEBUG      = "⊙"
M.G_INFO       = "✦"
M.G_WARN       = "▲"
M.G_ERROR      = "✕"
M.G_FATAL      = "☠"
M.G_SPAN_BEGIN = "┌─"
M.G_SPAN_END   = "└─"
M.G_ARROW      = "⤳"
M.G_DUR        = "⊹"
M.G_KV_SEP     = "="
M.G_PIPE       = "│"
M.G_BULLET     = "•"

-- ─── Levels ────────────────────────────────────────────────────────
M.LV_TRACE = 0
M.LV_DEBUG = 1
M.LV_INFO  = 2
M.LV_WARN  = 3
M.LV_ERROR = 4
M.LV_FATAL = 5

M.level_value = {
    trace = M.LV_TRACE, debug = M.LV_DEBUG, info = M.LV_INFO,
    warn = M.LV_WARN, error = M.LV_ERROR, fatal = M.LV_FATAL,
}
M.level_name = {
    [0] = "trace", [1] = "debug", [2] = "info",
    [3] = "warn", [4] = "error", [5] = "fatal",
}

global __trace_level = M.LV_INFO
global __trace_show_caller = true
global __trace_show_ts = true
global __trace_spans = {}

-- ─── tty detection ────────────────────────────────────────────────
fun tty(): bool
    local ok, val = pcall(os.getenv, "DUO_COLOR")
    if ok and val ~= nil and val ~= "" and val ~= "0" then
        return true
    end
    local ok2, val2 = pcall(os.getenv, "NO_COLOR")
    if ok2 and val2 ~= nil and val2 ~= "" then
        return false
    end
    return true
end

-- ─── Style wrappers ───────────────────────────────────────────────
fun s(prefix: str, text: str, suffix: str): str
    if prefix == nil then prefix = "" end
    if suffix == nil then suffix = M.RESET end
    if not tty() then
        return tostring(text)
    end
    return prefix .. tostring(text) .. suffix
end

fun bold(text: str): str
    return M.BOLD .. tostring(text) .. M.RESET
end

fun dim(text: str): str
    return M.DIM .. tostring(text) .. M.RESET
end

fun italic(text: str): str
    return M.ITALIC .. tostring(text) .. M.RESET
end

fun underline(text: str): str
    return M.UNDERLINE .. tostring(text) .. M.RESET
end

fun red(text: str): str
    return M.RED .. tostring(text) .. M.RESET
end

fun green(text: str): str
    return M.GREEN .. tostring(text) .. M.RESET
end

fun yellow(text: str): str
    return M.YELLOW .. tostring(text) .. M.RESET
end

fun blue(text: str): str
    return M.BLUE .. tostring(text) .. M.RESET
end

fun magenta(text: str): str
    return M.MAGENTA .. tostring(text) .. M.RESET
end

fun cyan(text: str): str
    return M.CYAN .. tostring(text) .. M.RESET
end

-- ─── Value formatting ─────────────────────────────────────────────
fun tbl_summary(t: any): str
    if t == nil then return "nil" end
    local n = rawlen(t)
    if n > 0 then
        return "array(" .. tostring(n) .. ")"
    end
    local count = 0
    local first = ""
    for k, _v in t
        count += 1
        if count == 1 then first = tostring(k) end
    end
    if count == 0 then return "{}" end
    if count <= 3 then
        return "{" .. first .. ", ...}"
    end
    return "{" .. tostring(count) .. " keys}"
end

fun pretty_val(value: any): str
    if value == nil then
        return dim(italic("nil"))
    end
    local t = type(value)
    if t:find("string") == 1 then
        return green('"' .. tostring(value) .. '"')
    elseif t:find("number") == 1 then
        return yellow(tostring(value))
    elseif t:find("boolean") == 1 then
        return magenta(tostring(value))
    elseif t:find("function") == 1 then
        return cyan(italic("⟪fn⟫"))
    elseif t:find("table") == 1 then
        local n = rawlen(value)
        if n > 0 then
            return cyan("⟦array " .. tostring(n) .. "⟧")
        end
        return cyan(italic("{" .. tbl_summary(value) .. "}"))
    end
    return cyan(tostring(value))
end

fun pretty_kv(k: str, v: any): str
    return underline(tostring(k)) .. dim(" " .. M.G_KV_SEP .. " ") .. pretty_val(v)
end

-- ─── Caller info ───────────────────────────────────────────────────
fun caller(level: int): str
    local info = debug.getinfo(level, "Snl")
    if info == nil then return "" end
    local name_part = info.name
    if name_part == nil or name_part == "" then
        name_part = "?"
    end
    local src = info.short_src
    if src == nil then src = info.source end
    if src == nil then src = "?" end
    local loc = src
    if info.currentline and info.currentline > 0 then
        loc = src .. dim(":") .. yellow(tostring(info.currentline))
    end
    return magenta(italic(name_part)) .. dim(" " .. M.G_ARROW .. " ") .. underline(loc)
end

-- ─── Timestamp ─────────────────────────────────────────────────────
fun ts(): str
    local secs = os.time()
    local ms = math.floor((os.clock() * 1000) % 1000)
    local frac = "." .. tostring(ms)
    if ms < 10 then frac = ".00" .. tostring(ms)
    elseif ms < 100 then frac = ".0" .. tostring(ms)
    end
    return dim(os.date("%H:%M:%S", secs) .. frac)
end

-- ─── Level tag ─────────────────────────────────────────────────────
fun level_tag(level: int): str
    local glyph = M.G_TRACE
    local tag = "trace"
    if level == M.LV_DEBUG then
        glyph = M.G_DEBUG; tag = "debug"
    elseif level == M.LV_INFO then
        glyph = M.G_INFO;  tag = " info"
    elseif level == M.LV_WARN then
        glyph = M.G_WARN;  tag = " warn"
    elseif level == M.LV_ERROR then
        glyph = M.G_ERROR; tag = "error"
    elseif level == M.LV_FATAL then
        glyph = M.G_FATAL; tag = "fatal"
    end
    local body = glyph .. " " .. tag
    if level == M.LV_TRACE then return dim(body) end
    if level == M.LV_DEBUG then return blue(body) end
    if level == M.LV_INFO  then return green(body) end
    if level == M.LV_WARN  then return yellow(body) end
    if level == M.LV_ERROR then return red(bold(body)) end
    if level == M.LV_FATAL then return red(bold(underline(body))) end
    return body
end

-- ─── Span indent ───────────────────────────────────────────────────
fun span_indent(): str
    local n = rawlen(__trace_spans)
    if n <= 0 then return "" end
    local rep = string.rep(M.G_PIPE .. " ", n)
    if rep == nil or rep == "" then return "" end
    return dim(rep)
end

-- ─── Emit ──────────────────────────────────────────────────────────
fun emit(level: int, msg: str, fields: any, skip: int): void
    if level < __trace_level then return end
    local parts = {}
    parts[rawlen(parts) + 1] = level_tag(level)
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if __trace_show_caller then
        local c = caller(skip + 1)
        if c ~= "" then
            parts[rawlen(parts) + 1] = dim("(") .. c .. dim(")")
        end
    end
    parts[rawlen(parts) + 1] = span_indent()
    if msg ~= nil and msg ~= "" then
        parts[rawlen(parts) + 1] = bold(msg)
    end
    if fields ~= nil and type(fields) == "table" then
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
end

-- ─── Public API ─────────────────────────────────────────────────
fun set_level(level: any): void
    if type(level) == "string" then
        local v = M.level_value[string.lower(level)]
        if v ~= nil then
            __trace_level = v
        end
        return
    end
    if type(level) == "number" then
        if level >= M.LV_TRACE and level <= M.LV_FATAL then
            __trace_level = level
        end
    end
end

fun get_level(): str
    return M.level_name[__trace_level] or "info"
end

fun show_caller(on: bool): void
    __trace_show_caller = on and true or false
end

fun show_timestamp(on: bool): void
    __trace_show_ts = on and true or false
end

fun trace(msg: str, fields: any): void
    emit(M.LV_TRACE, msg, fields, 2)
end

fun _debug(msg: str, fields: any): void
    emit(M.LV_DEBUG, msg, fields, 2)
end

fun info(msg: str, fields: any): void
    emit(M.LV_INFO, msg, fields, 2)
end

fun warn(msg: str, fields: any): void
    emit(M.LV_WARN, msg, fields, 2)
end

fun error(msg: str, fields: any): void
    emit(M.LV_ERROR, msg, fields, 2)
end

fun fatal(msg: str, fields: any): void
    emit(M.LV_FATAL, msg, fields, 2)
end

-- ─── Spans ────────────────────────────────────────────────────────
-- Format a millisecond duration as a string like "12.34ms" without
-- relying on string.format (the codegen currently mishandles %f).
fun _fmt_ms(ms: float): str
    local whole = math.floor(ms)
    local frac = math.floor((ms - whole) * 100)
    local frac_str = tostring(frac)
    if frac < 10 then frac_str = "0" .. tostring(frac) end
    return tostring(whole) .. "." .. frac_str .. "ms"
end

fun span(name: str, fields: any): any
    local h = {
        name = name or "span",
        start = os.clock(),
        depth = rawlen(__trace_spans) + 1,
    }
    __trace_spans[rawlen(__trace_spans) + 1] = h
    local ind = dim(string.rep(M.G_PIPE .. " ", h.depth - 1))
    local parts = {}
    parts[rawlen(parts) + 1] = magenta(M.G_SPAN_BEGIN)
    parts[rawlen(parts) + 1] = bold(italic(name or "span"))
    parts[rawlen(parts) + 1] = dim(M.G_ARROW)
    if __trace_show_ts then
        parts[rawlen(parts) + 1] = dim("[") .. ts() .. dim("]")
    end
    if __trace_show_caller then
        local c = caller(2)
        if c ~= "" then
            parts[rawlen(parts) + 1] = dim("(") .. c .. dim(")")
        end
    end
    parts[rawlen(parts) + 1] = ind
    if fields ~= nil and type(fields) == "table" then
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
    return h
end

fun span_end(h: any, fields: any): void
    if h == nil then return end
    local n = rawlen(__trace_spans)
    while n > 0
        if __trace_spans[n] == h then
            table.remove(__trace_spans, n)
            break
        end
        n -= 1
    end
    local dur_s = os.clock() - h.start
    local dur_ms = dur_s * 1000
    local dur_str
    if dur_ms >= 16 then
        dur_str = bold(yellow(_fmt_ms(dur_ms)))
    else
        dur_str = dim(_fmt_ms(dur_ms))
    end
    local ind = dim(string.rep(M.G_PIPE .. " ", (h.depth - 1)))
    local parts = {}
    parts[rawlen(parts) + 1] = magenta(M.G_SPAN_END)
    parts[rawlen(parts) + 1] = italic(h.name)
    parts[rawlen(parts) + 1] = dim(M.G_DUR)
    parts[rawlen(parts) + 1] = dur_str
    parts[rawlen(parts) + 1] = ind
    if fields ~= nil and type(fields) == "table" then
        for k, v in fields
            parts[rawlen(parts) + 1] = pretty_kv(k, v)
        end
    end
    print(table.concat(parts, " "))
end

-- ─── Banner / divider / legend ────────────────────────────────────
fun banner(title: str, subtitle: str): void
    if title == nil then title = "trace" end
    if tty() then
        print(cyan("╭─── " .. title .. " ") .. dim("─") .. dim(string.rep("─", 40)))
        if subtitle ~= nil and subtitle ~= "" then
            print(dim("│  " .. subtitle))
        end
    else
        print("=== " .. title .. " ===")
        if subtitle ~= nil and subtitle ~= "" then
            print("    " .. subtitle)
        end
    end
end

fun divider(): void
    print(span_indent() .. dim(string.rep("─", 60)))
end

fun legend(): void
    print(bold(italic("trace legend:")))
    print("  " .. level_tag(M.LV_TRACE) .. "  " .. dim("fine-grained, usually off"))
    print("  " .. level_tag(M.LV_DEBUG) .. "  " .. dim("development detail"))
    print("  " .. level_tag(M.LV_INFO)  .. "  " .. dim("general progress"))
    print("  " .. level_tag(M.LV_WARN)  .. "  " .. dim("something suspicious"))
    print("  " .. level_tag(M.LV_ERROR) .. "  " .. dim("failure, recoverable"))
    print("  " .. level_tag(M.LV_FATAL) .. "  " .. dim("unrecoverable"))
    print("")
    print("  " .. bold("bold") .. " = essential payload    " ..
          italic("italic") .. " = identity / type    " ..
          dim("dim") .. " = ancillary meta")
    print("  " .. underline("underline") .. " = location / field key    " ..
          "color = severity + Lua type class")
    print("  " .. magenta(M.G_SPAN_BEGIN) .. "/" .. magenta(M.G_SPAN_END) ..
          " = span begin/end    " .. dim(M.G_DUR) .. " = measured duration")
end

-- ─── Recursive pretty printer for dump() ───────────────────────────
fun _seen(seen: any, value: any): bool
    if seen == nil then return false end
    local i = 1
    local n = rawlen(seen)
    while i <= n
        if seen[i] == value then return true end
        i += 1
    end
    return false
end

fun _seen_add(seen: any, value: any): void
    seen[rawlen(seen) + 1] = value
end

fun pretty_repr(value: any, depth: int, seen: any): str
    if depth == nil then depth = 0 end
    if seen == nil then seen = {} end
    if value == nil then return "nil" end
    local t = type(value)
    if t:find("string") == 1 then
        return '"' .. tostring(value) .. '"'
    elseif t:find("number") == 1 then
        return tostring(value)
    elseif t:find("boolean") == 1 then
        return tostring(value)
    elseif t:find("function") == 1 then
        return "<function>"
    elseif t:find("table") ~= 1 then
        return tostring(value)
    end
    -- table branch — use table identity (== by reference) stored in a
    -- flat array, because the codegen's tostring(table) always returns
    -- the bare type name "table" regardless of which table.
    if _seen(seen, value) then return "<circular>" end
    _seen_add(seen, value)
    local n = rawlen(value)
    local parts = {}
    if n > 0 then
        local i = 1
        while i <= n
            parts[rawlen(parts) + 1] = string.rep("  ", depth + 1) ..
                pretty_repr(value[i], depth + 1, seen)
            i += 1
        end
        if rawlen(parts) <= 3 then
            return "[" .. table.concat(parts, ", ") .. "]"
        end
        return "[\n" .. table.concat(parts, ",\n") .. "\n" ..
            string.rep("  ", depth) .. "]"
    end
    for k, v in value
        parts[rawlen(parts) + 1] = string.rep("  ", depth + 1) ..
            tostring(k) .. " = " .. pretty_repr(v, depth + 1, seen)
    end
    if rawlen(parts) == 0 then return "{}" end
    return "{\n" .. table.concat(parts, "\n") .. "\n" ..
        string.rep("  ", depth) .. "}"
end

fun dump(label: str, value: any): void
    if label == nil then label = "dump" end
    local ind = span_indent()
    local header = ind .. cyan(M.G_BULLET) .. " " .. bold(label) ..
        dim(" ⟜ ") .. pretty_val(value)
    print(header)
    if value ~= nil and type(value) == "table" then
        local rendered = pretty_repr(value, 1, nil)
        -- split on newlines manually; the codegen mishandles gmatch
        local i = 1
        local n = #rendered
        local line_start = 1
        while i <= n
            local ch = string.sub(rendered, i, i)
            if ch == "\n" then
                local seg = string.sub(rendered, line_start, i - 1)
                if seg ~= "" then
                    print(dim(M.G_PIPE .. " ") .. cyan(seg))
                end
                line_start = i + 1
            end
            i += 1
        end
        if line_start <= n then
            print(dim(M.G_PIPE .. " ") .. cyan(string.sub(rendered, line_start)))
        end
    end
end

-- ─── Exports ──────────────────────────────────────────────────────
M.set_level = set_level
M.get_level = get_level
M.show_caller = show_caller
M.show_timestamp = show_timestamp
M.trace = trace
M.debug = _debug
M.info = info
M.warn = warn
M.error = error
M.fatal = fatal
M.span = span
M.span_end = span_end
M.banner = banner
M.divider = divider
M.legend = legend
M.dump = dump
M.LV_TRACE = M.LV_TRACE
M.LV_DEBUG = M.LV_DEBUG
M.LV_INFO  = M.LV_INFO
M.LV_WARN  = M.LV_WARN
M.LV_ERROR = M.LV_ERROR
M.LV_FATAL = M.LV_FATAL

M
-- ─── DEMO ─────────────────────────────────────────────────────────────
-- Beautiful, semantically-formatted trace & debug.
-- Run with:  DUO_COLOR=1 ./zig-out/bin/duo run examples/pretty_trace.duo
-- Set NO_COLOR=1 to disable ANSI.

local T = M

T.set_level("trace")
T.banner("trace demo", "colored + iconed + semantic formatting")
print(" ")
T.legend()
print(" ")

T.info("booting runtime", {pid = 1234, mode = "release", threads = 8})
T.debug("config loaded", {path = "/etc/duo/config.duo", bytes = 2048})
T.warn("buffer near limit", {used = 0.92, capacity = 4096})

T.divider()

local h1 = T.span("compile_module", {module = "std.math.fft", size = 8192})
local h2 = T.span("parse", {tokens = 4096})
for _x = 1, 2000 do end
T.span_end(h2)

local h3 = T.span("type_check", {fns = 24, errors = 0})
for _y = 1, 5000 do end
T.span_end(h3, {note = "cleared all predicates"})
T.span_end(h1, {emitted_bytes = 16384})

T.divider()

local sample_tbl = {
    name = "my_callback",
    count = 42,
    enabled = true,
    children = {1, 2, 3, "four"},
    callback = function() return nil end,
}
T.dump("sample_tbl", sample_tbl)
T.dump("plain_string", "hello, world")
T.dump("integer", 1337)
T.dump("truth", false)
T.dump("nothing", nil)

T.divider()

T.trace("very fine, opt-in only", {where = "hot loop", iter = 7})
T.debug("developer detail here")
T.info("general progress update")
T.warn("something looked off")
T.error("something failed, but recoverable", {file = "src/io.duo", line = 217})
T.fatal("unrecoverable — will exit", {reason = "kernel panic", code = 0xC0DE})

T.divider()

print(" ")
print(span_indent() .. "pure-pretty stack trace below:")
local i = 2
while i < 12
    local info = debug.getinfo(i, "Snl")
    if info == nil then break end
    local fname = "?"
    if info.name ~= nil then fname = tostring(info.name) end
    local src = "?"
    if info.short_src ~= nil then src = tostring(info.short_src) end
    local line = src
    if info.currentline ~= nil and tonumber(info.currentline) > 0 then
        line = src .. ":" .. tostring(info.currentline)
    end
    print("  " .. magenta(italic(fname .. "()")) .. "  " .. underline(line))
    i += 1
end
