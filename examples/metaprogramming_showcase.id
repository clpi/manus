
print("=== Duo Metaprogramming Showcase ===")


print("\n-- 1. Compile-time evaluation --")

COMPUTE_RESULT = @(42 * 10 + 8)
print("42 * 10 + 8 = " .. to(str)(COMPUTE_RESULT))

GREETING = @("Hello" .. ", " .. "Duo!")
print("GREETING = " .. GREETING)

IS_RELEASE = @(true)
BUILD_MODE = @comp.if(IS_RELEASE, "release", "debug")
print("BUILD_MODE = " .. BUILD_MODE)

MAX_BUFFER = @(64 * 1024)
PI_APPROX = @(3.14159)
print("MAX_BUFFER = " .. to(str)(MAX_BUFFER))
print("PI_APPROX = " .. to(str)(PI_APPROX))


print("\n-- 2. Type introspection --")

x: i64 = 42
s: str = "hello"
f: f64 = 3.14

print("type_name(x) = " .. @comp.type.name(x))
print("type_name(s) = " .. @comp.type.name(s))
print("type_name(f) = " .. @comp.type.name(f))

id1: i64 = @comp.type.id(x)
id2: i64 = @comp.type.id(s)
print("type_id(x) = " .. to(str)(id1))
print("type_id(s) = " .. to(str)(id2))
print("type_ids_differ = " .. to(str)(id1 != id2))

print("is_type(x, i64) = " .. to(str)(@comp.type.is(x, "i64")))
print("is_type(s, str) = " .. to(str)(@comp.type.is(s, "str")))
print("is_type(x, str) = " .. to(str)(@comp.type.is(x, "str")))

print("typeinfo(x) = " .. @comp.type.info(x))


print("\n-- 3. Memory layout --")

print("sizeof(i64) = " .. to(str)(@sizeof(i64)))
print("sizeof(f64) = " .. to(str)(@sizeof(f64)))
print("sizeof(i32) = " .. to(str)(@sizeof(i32)))
print("sizeof(bool) = " .. to(str)(@sizeof(bool)))
print("alignof(i64) = " .. to(str)(@alignof(i64)))
print("alignof(f64) = " .. to(str)(@alignof(f64)))


print("\n-- 4. Static assertions --")

@comp.assert("sizeof(int64_t) == 8", "i64 must be 8 bytes")
@comp.assert("sizeof(double) == 8", "f64 must be 8 bytes")
print("All static assertions passed")


print("\n-- 5. Type casting --")

val_f: f64 = @as(f64, 42)
print("@as(f64, 42) = " .. to(str)(val_f))

val_i: i64 = @comp.as.type(3.14, "int64_t")
print("@comp.as.type(3.14, 'int64_t') = " .. to(str)(val_i))


print("\n-- 6. Bit intrinsics --")

bits: i64 = 0xFF00
print("popcount(0xFF00) = " .. to(str)(@popcount(bits)))
print("ctz(0xFF00) = " .. to(str)(@ctz(bits)))
print("clz(0xFF00) = " .. to(str)(@clz(bits)))
print("bswap(0xFF00) = " .. to(str)(@bswap(bits)))


print("\n-- 7. Branch hints --")

x_val: i64 = 42
if @likely(x_val > 0)
    print("x is positive (likely branch)")
if @unlikely(x_val < 0)
    print("x is negative (unlikely branch)")


print("\n-- 8. Compile-time conditional --")

platform = @comp.if(true, "native", "wasm")
print("platform = " .. platform)

debug_level = @comp.if(false, "verbose", "quiet")
print("debug_level = " .. debug_level)


print("\n-- 9. Concepts --")

concept Printable
    tostring(self): str

concept Counter
    increment(self): void
    value(self): i64

counter = { _val = 0 }
counter.increment = (self): void
    self._val = self._val + 1
counter.value = (self): i64
    self._val
counter.tostring = (self): str
    "Counter(" .. to(str)(self._val) .. ")"

counter:increment()
counter:increment()
counter:increment()
print("Counter: " .. counter:tostring())
print("Counter value: " .. to(str)(counter:value()))

M = {}
M:hash(): i64
    42

@comp.assert(not @satisfies(M, "Printable"), "M lacks tostring")
print("@satisfies(M, Printable) = " .. to(str)(@satisfies(M, "Printable")))

Ctable = {}
Ctable:increment(): void
Ctable:value(): i64
    0
@comp.assert(@satisfies(Ctable, "Counter"), "Ctable satisfies Counter")
print("@satisfies(Ctable, Counter) = " .. to(str)(@satisfies(Ctable, "Counter")))

concept Hashable
    hash(self): i64

Bump = {}
Bump:hash(): i64
    100

fun bump<T: Hashable>(target: T): i64
    target:hash() + 1

@comp.assert(@satisfies(Bump, "Hashable"), "Bump satisfies Hashable")
print("bump(Bump) = " .. to(str)(bump(Bump)))

hashable_members = @comp.concepts.methods("Hashable")
print("@comp.concepts.methods('Hashable') count = " .. to(str)(hashable_members:len()))



print("\n-- 10. @derive --")


@derive(Display, Eq, Add, Sub, Mul, Neg, Len, Hash, Clone, Default)
pair: { x: f64, y: f64 }

@derive(Div, Rem)
ratio: { num: f64, den: f64 }

@derive("Display", "Eq")
enum Color
    Red
    Green
    Blue

c1 = Color.Red
c2 = Color.Green
print("Enum c1 = " .. to(str)(c1))
print("Enum c2 = " .. to(str)(c2))
print("c1 == c1: " .. to(str)(c1 == c1))
print("c1 == c2: " .. to(str)(c1 == c2))



print("\n-- 12. Runtime metamethods --")

vector_mt = {}
vector_mt.__index = vector_mt

vector_mt.new = (x, y)
    setmetatable({ x = x, y = y }, vector_mt)

vector_mt.__add = (a, b)
    vector_mt.new(a.x + b.x, a.y + b.y)

vector_mt.__tostring = (self)
    "Vec(" .. to(str)(self.x) .. ", " .. to(str)(self.y) .. ")"

v1 = vector_mt.new(1, 2)
v2 = vector_mt.new(3, 4)
v3 = v1 + v2
print("v1 = " .. to(str)(v1))
print("v2 = " .. to(str)(v2))
print("v1 + v2 = " .. to(str)(v3))


print("\n-- 13. Compile-time string operations --")

upper = @("hello world":upper())
len = @("duo language":len())
print("comptime upper = " .. upper)
print("comptime len = " .. to(str)(len))


print("\n-- 14. Has metamethod --")

print("v1 has __add = " .. to(str)(@comp.has.metamethod(v1, "__add")))
print("v1 has __mul = " .. to(str)(@comp.has.metamethod(v1, "__mul")))


print("\n-- 15. Compile-time diagnostics --")

@comp.compile.log("This is a compile-time log message")
@comp.compile.warn("This is a compile-time warning")
print("Compile-time diagnostics emitted")


print("\n-- 17. Type aliases --")

uid: i64 = 12345
sc: f64 = 98.6
print("UserId(12345) = " .. to(str)(uid))
print("Score(98.6) = " .. to(str)(sc))


print("\n=== All metaprogramming features demonstrated ===")
