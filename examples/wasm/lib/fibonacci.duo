-- Typed fibonacci exports for WAST testing.

@export
fun fib(n: int): int
    if n <= 1 then
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

@export
fun fib_iter(n: int): int
    if n <= 1 then
        return n
    end
    a: int = 0
    b: int = 1
    for i = 2, n
        c: int = a + b
        a = b
        b = c
    end
    return b
end

@export
fun factorial(n: int): int
    if n <= 1 then
        return 1
    end
    return n * factorial(n - 1)
end

@export
fun gcd(a: int, b: int): int
    while b ~= 0
        t: int = b
        b = a % b
        a = t
    end
    return a
end

@export
fun lcm(a: int, b: int): int
    return (a // gcd(a, b)) * b
end

@export
fun pow_int(base: int, exp: int): int
    result: int = 1
    while exp > 0
        if exp % 2 == 1 then
            result = result * base
        end
        base = base * base
        exp = exp >> 1
    end
    return result
end
