# Typed arithmetic exports for WAST testing.

@export
add: int = (a: int, b: int)
  a + b

@export
sub: int = (a: int, b: int)
  a - b

@export
mul: int = (a: int, b: int)
  a * b

@export
idiv: int = (a: int, b: int)
  a // b

@export
imod: int = (a: int, b: int)
  a % b

@export
neg: int = (a: int)
  0 - a

@export
band: int = (a: int, b: int)
  a & b

@export
bor: int = (a: int, b: int)
  a | b

@export
bxor: int = (a: int, b: int)
  a ~ b

@export
lshift: int = (a: int, b: int)
  a << b

@export
rshift: int = (a: int, b: int)
  a >> b

@export
abs: int = (a: int)
  if a < 0
    0 - a
  a

@export
max: int = (a: int, b: int)
  if a > b
    a
  b

@export
min: int = (a: int, b: int)
  if a < b
    a
  b
