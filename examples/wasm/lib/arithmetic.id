# Typed arithmetic exports for WAST testing.

@export
add(a: int, b: int): int
    a + b

@export
sub(a: int, b: int): int
    a - b

@export
mul(a: int, b: int): int
    a * b

@export
idiv(a: int, b: int): int
    a // b

@export
imod(a: int, b: int): int
    a % b

@export
neg(a: int): int
    0 - a

@export
band(a: int, b: int): int
    a & b

@export
bor(a: int, b: int): int
    a | b

@export
bxor(a: int, b: int): int
    a ~ b

@export
lshift(a: int, b: int): int
    a << b

@export
rshift(a: int, b: int): int
    a >> b

@export
abs_val(a: int): int
    if a < 0
        0 - a
    a

@export
max_val(a: int, b: int): int
    if a > b
        a
    b

@export
min_val(a: int, b: int): int
    if a < b
        a
    b
