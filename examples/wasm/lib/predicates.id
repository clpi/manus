# Boolean predicate exports for WAST testing.

@export
is_even: int = (n: int)
  if n % 2 == 0
    1
  0

@export
is_odd: int = (n: int)
  if n % 2 != 0
    1
  0

@export
is_positive: int = (n: int)
  if n > 0
    1
  0

@export
is_negative: int = (n: int)
  if n < 0
    1
  0

@export
sign: int = (n: int)
  if n > 0
    1
  else
    if n < 0
      0 - 1
    else
      0

@export
clamp: int = (val: int, lo: int, hi: int)
  if val < lo
    lo
  else
    if val > hi
      hi
    else
      val

@export
in_range: int = (val: int, lo: int, hi: int)
  if val >= lo and val <= hi
    1
  0
