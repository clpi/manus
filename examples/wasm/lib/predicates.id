# Boolean predicate exports for WAST testing.

@export
is_even(n: int): int
    if n % 2 == 0
        1
    end
    0
end

@export
is_odd(n: int): int
    if n % 2 != 0
        1
    end
    0
end

@export
is_positive(n: int): int
    if n > 0
        1
    end
    0
end

@export
is_negative(n: int): int
    if n < 0
        1
    end
    0
end

@export
sign(n: int): int
    if n > 0
        1
    elseif n < 0
        0 - 1
    else
        0
    end
end

@export
clamp(val: int, lo: int, hi: int): int
    if val < lo
        lo
    elseif val > hi
        hi
    else
        val
    end
end

@export
in_range(val: int, lo: int, hi: int): int
    if val >= lo and val <= hi
        1
    end
    0
end
