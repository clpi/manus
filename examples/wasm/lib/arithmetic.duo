-- Typed arithmetic exports for WAST testing.

@export
function add(a: int, b: int): int
    return a + b
end

@export
function sub(a: int, b: int): int
    return a - b
end

@export
function mul(a: int, b: int): int
    return a * b
end

@export
function idiv(a: int, b: int): int
    return a // b
end

@export
function imod(a: int, b: int): int
    return a % b
end

@export
function neg(a: int): int
    return -a
end

@export
function band(a: int, b: int): int
    return a & b
end

@export
function bor(a: int, b: int): int
    return a | b
end

@export
function bxor(a: int, b: int): int
    return a ~ b
end

@export
function lshift(a: int, b: int): int
    return a << b
end

@export
function rshift(a: int, b: int): int
    return a >> b
end

@export
function abs_val(a: int): int
    if a < 0 then
        return -a
    end
    return a
end

@export
function max_val(a: int, b: int): int
    if a > b then
        return a
    end
    return b
end

@export
function min_val(a: int, b: int): int
    if a < b then
        return a
    end
    return b
end
