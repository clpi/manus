-- Typed arithmetic exports for WAST testing.

@export
fun add(a: int, b: int): int
    a + b
end

@export
fun sub(a: int, b: int): int
    a - b
end

@export
fun mul(a: int, b: int): int
    a * b
end

@export
fun idiv(a: int, b: int): int
    a // b
end

@export
fun imod(a: int, b: int): int
    a % b
end

@export
fun neg(a: int): int
    -a
end

@export
fun band(a: int, b: int): int
    a & b
end

@export
fun bor(a: int, b: int): int
    a | b
end

@export
fun bxor(a: int, b: int): int
    a ~ b
end

@export
fun lshift(a: int, b: int): int
    a << b
end

@export
fun rshift(a: int, b: int): int
    a >> b
end

@export
fun abs_val(a: int): int
    if a < 0 then
        -a
    end
    a
end

@export
fun max_val(a: int, b: int): int
    if a > b then
        a
    end
    b
end

@export
fun min_val(a: int, b: int): int
    if a < b then
        a
    end
    b
end
