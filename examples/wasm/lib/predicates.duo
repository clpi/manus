-- Boolean predicate exports for WAST testing.

@export
fun is_even(n: int): int
    if n % 2 == 0 then
        1
    end
    0
end

@export
fun is_odd(n: int): int
    if n % 2 ~= 0 then
        1
    end
    0
end

@export
fun is_positive(n: int): int
    if n > 0 then
        1
    end
    0
end

@export
fun is_negative(n: int): int
    if n < 0 then
        1
    end
    0
end

@export
fun sign(n: int): int
    if n > 0 then
        1
    elseif n < 0 then
        0 - 1
    else
        0
    end
end

@export
fun clamp(val: int, lo: int, hi: int): int
    if val < lo then
        lo
    elseif val > hi then
        hi
    else
        val
    end
end

@export
fun in_range(val: int, lo: int, hi: int): int
    if val >= lo and val <= hi then
        1
    end
    0
end
