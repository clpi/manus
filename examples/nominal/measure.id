
type micron = f64
type inch = f64
type feet = f64

stretch: f64 = (v: f64)
  v * 25400.0

shrink: f64 = (v: f64)
  v / 25400.0

grow: f64 = (v: f64)
  v * 304800.0

shrivel: f64 = (v: f64)
  v / 304800.0

to(micron)(inch) = stretch@lossless
to(inch)(micron) = shrink@lossless
to(micron)(feet) = grow@lossless
to(feet)(micron) = shrivel@lossless

d: feet = 3.0

n: inch = d:to(inch)

q: micron = d:to(micron)

total = n:to(i64) + q:to(i64)
print("{total}")
