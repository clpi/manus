has: bool = (set: str, name: str)
  true

add: str = (set: str, name: str)
  set .. name .. "|"

ambient = "|io|print|true|false|token|"

unresolved: i64 = (src: str, file: str, family: i64, report: bool)
  lx: lexer = lexer.new(src, file, family)
  bound = ambient
  refs = "|"
  kind: i64 = 0
  while true
    t = lexer.next(lx)
    if t.kind == token.KIND_EOF
      break
    if t.kind == token.KIND_NAME
      nxt = lexer.peek(lx)
      binds = false
      if nxt.kind == token.KIND_ASSIGN
        binds = true
      if nxt.kind == token.KIND_COMMA
        st = lexer.save_state(lx)
        walking = true
        while walking
          walking = false
          a = lexer.next(lx)
          if a.kind == token.KIND_COMMA
            b = lexer.next(lx)
            if b.kind == token.KIND_NAME
              if lexer.peek(lx).kind == token.KIND_ASSIGN
                binds = true
              else(lexer.peek(lx).kind == token.KIND_COMMA)
                walking = true
        lexer.restore_state(lx, st)
      if nxt.kind == token.KIND_LPAREN and kind != token.KIND_DOT and kind != token.KIND_COLON
        binds = true
      if nxt.kind == token.KIND_COLON and t.loc.col == 1
        binds = true
      if nxt.kind == token.KIND_COLON and t.loc.col != 1
        cst = lexer.save_state(lx)
        c = lexer.next(lx)
        ty = lexer.next(lx)
        if ty.kind == token.KIND_NAME or ty.kind >= token.KIND_I8 and ty.kind <= token.KIND_STR
          if lexer.peek(lx).kind == token.KIND_ASSIGN
            binds = true
        lexer.restore_state(lx, cst)
      if kind == token.KIND_DOTS
        binds = true
      if kind == token.KIND_FUN or kind == token.KIND_FUNCTION or kind == token.KIND_FOR
        binds = true
      if kind == token.KIND_CONCEPT
        binds = true
      if kind == token.KIND_LPAREN or kind == token.KIND_COMMA
        binds = true
      if binds
        bound = add(bound, t.text)
    kind = t.kind

  lx2: lexer = lexer.new(src, file, family)
  kind = 0
  count: i64 = 0
  prev_kind: i64 = 0
  while true
    t = lexer.next(lx2)
    if t.kind == token.KIND_EOF
      break
    if t.kind == token.KIND_NAME
      skip = kind == token.KIND_DOT or kind == token.KIND_COLON or prev_kind == token.KIND_AT
      if !skip
        nxt = lexer.peek(lx2)
        if nxt.kind != token.KIND_ASSIGN and !has(bound, t.text) and !has(refs, t.text)
          refs = add(refs, t.text)
          count = count + 1
          if report
            print("  unresolved " .. file .. ": " .. t.text)
    kind = t.kind
    prev_kind = t.kind
  count

main: i64 = ()
  unresolved("x", "f.id", 0, false)
