-- @specialize table batch — pre-generate monomorphizations without call sites
-- Run: duo run examples/specialize_batch_showcase.duo

@specialize({ fn = "twice", types = "i64, f64" })

fun twice<T>(x: T): T
    x
end

-- Concrete call sites still monomorphize at use; batch ensures bodies exist early.
print("=== @specialize batch showcase ===")
print("twice(21) = " .. tostring(twice(21)))
print("twice(2.5) = " .. tostring(twice(2.5)))
