# =============================================================================
# Duo C Interop Showcase
# Demonstrates the full @c.* metaprogramming interface for cross-language FFI:
#   @c.include  — bring in C headers
#   @c.call      — call C functions directly (no Lua runtime overhead)
#   @c.emit      — inject raw C code
#
# Run: duo run examples/c_interop_showcase.id
# =============================================================================

--- @c.include("stdio.h")
--- @c.include("stdlib.h")
--- @c.include("string.h")
--- @c.include("math.h")

print("=== Duo C Interop Showcase ===")

# ═══════════════════════════════════════════════════════════════════════════════
# 1. @c.call — direct C function calls
# ═══════════════════════════════════════════════════════════════════════════════

print("\n-- 1. @c.call: direct C function calls --")

# printf with format string
@c.call("printf", "  printf via @c.call: %d\n", @(42))

# Math functions via C library
abs_val: i64 = @c.call("llabs", @(-12345))
@c.call("printf", "  llabs(-12345) = %lld\n", abs_val)

sqrt_val: f64 = @c.call("sqrt", @(2.0))
@c.call("printf", "  sqrt(2.0) = %.6f\n", sqrt_val)

pow_val: f64 = @c.call("pow", @(2.0), @(10.0))
@c.call("printf", "  pow(2.0, 10.0) = %.1f\n", pow_val)

# ═══════════════════════════════════════════════════════════════════════════════
# 2. Combining @c.call with Duo functions
# ═══════════════════════════════════════════════════════════════════════════════

print("\n-- 2. Duo + C interop --")

fast_sum: i64 = (a: i64, b: i64)
    return a + b

print_sum: i64 = (a: i64, b: i64)
    result: i64 = fast_sum(a, b)
    return @c.call("printf", "  fast_sum(%lld, %lld) = %lld\n", a, b, result)

print_sum(@(10), @(20))
print_sum(@(100), @(200))

# ═══════════════════════════════════════════════════════════════════════════════
# 3. C string operations
# ═══════════════════════════════════════════════════════════════════════════════

print("\n-- 3. C string operations --")

strlen_result: i64 = @c.call("strlen", "Duo rocks!")
@c.call("printf", "  str\"Duo rocks!\":len() = %lld\n", strlen_result)

# ═══════════════════════════════════════════════════════════════════════════════
# 4. C memory operations
# ═══════════════════════════════════════════════════════════════════════════════

print("\n-- 4. C memory operations --")

demo_malloc_free: i64 = ()
    ptr: *@c.type("void") = @c.call("malloc", @(64))
    if ptr == nil
        return -1
    @c.call("memset", ptr, @(0), @(64))
    @c.call("free", ptr)
    return 0

mem_result: i64 = demo_malloc_free()
@c.call("printf", "  malloc/memset/free result: %lld\n", mem_result)

# ═══════════════════════════════════════════════════════════════════════════════
# 5. Performance: C math in a tight loop
# ═══════════════════════════════════════════════════════════════════════════════

print("\n-- 5. C math in a tight loop --")

sqrt_sum: i64 = (n: i64)
    result: i64 = 0
    for i = 1, n
        result = result + i
    return result

n: i64 = @(1000)
result: i64 = sqrt_sum(n)
@c.call("printf", "  sum of 1..%lld = %lld\n", n, result)

# ═══════════════════════════════════════════════════════════════════════════════
# Summary
# ═══════════════════════════════════════════════════════════════════════════════

print("\n=== Summary ===")
print("  @c.include — import C headers")
print("  @c.call    — call C functions with zero overhead")
print("  @c.type    — reference C types in Duo type annotations")
print("")
print("Duo's @c.* interface provides seamless C interop without")
print("sacrificing native performance or compile-time safety.")