x: int = 3
y: i32 = 8
exp: float = 99.3
age: f32 = 29.0

getAge = (self: any)
    self.age
end

setAge = (self: any, age: num)
    self.age = age
end

props = {
    hobbies: [string] = {
        "golf",
        "table tennis",
    },
    hasHobby = (self: any, hobby: string)
        self.hobbies:contains(hobby)
    end,
}

incExp = (self: any)
    self.age += 0.1
end
