# Nested ambient std access: os and json reached through dotted paths,
# no activity namespace. script is a denied junk drawer (Pass 100 §15), so
# the file is written and read through os directly.
path = "/tmp/duo_nested_req_smoke.json"
os.write_file(path, "{\"ok\":true,\"n\":7}")

data = json.decode(os.read_file(path))
ok = data.ok == true and data.n == 7

# `..` joins existing string bindings only (B-5); a bool needs the str edge.
print("RESULT nested_std_req_ok = " .. tostring(ok))
