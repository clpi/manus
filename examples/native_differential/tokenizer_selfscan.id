
Kind: { eof, ident, number, punct }

tok: { kind: i64, start: i64, len: i64 }

digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

alpha: i64 = (c: i64)
    if c >= 97 and c <= 122
        return 1
    if c >= 65 and c <= 90
        return 1
    if c == 95
        return 1
    0

space: i64 = (c: i64)
    if c == 32
        return 1
    if c == 9
        return 1
    if c == 10
        return 1
    0

scan: tok = (src: str, pos: i64)
    n = src:len()
    i = pos
    while i <= n and src:byte(i):space() == 1
        i += 1
    if i > n
        return { kind = Kind.eof, start = i, len = 0 }
    c = src:byte(i)
    if c:alpha() == 1
        j = i
        while j <= n and src:byte(j):alpha() == 1
            j += 1
        return { kind = Kind.ident, start = i, len = j - i }
    if c:digit() == 1
        j = i
        while j <= n and src:byte(j):digit() == 1
            j += 1
        return { kind = Kind.number, start = i, len = j - i }
    { kind = Kind.punct, start = i, len = 1 }

count: i64 = (src: str)
    total = 0
    pos = 1
    n = src:len()
    while pos <= n
        t: tok = scan(src, pos)
        if t.kind == Kind.eof
            return total
        total += 1
        pos = t.start + t.len
    total

main: i64 = ()
    "digit = (c: i64): i64 if c >= 48 and c <= 57 return 1 end 0 end":count()
