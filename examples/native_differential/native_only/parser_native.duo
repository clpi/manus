-- expect: 7
-- SH-04 step: a recursive-descent expression parser written in Duo and compiled
-- to native ARM64.
--
-- This is the core shape of `src/parser.zig` — precedence climbing over a token
-- stream, with recursive descent through the grammar levels — reduced to the
-- arithmetic subset so it fits the proven native subset:
--
--   expr   := term   (('+' | '-') term)*
--   term   := factor (('*' | '/') factor)*
--   factor := NUMBER | '(' expr ')'
--
-- Recursive descent needs each level to return BOTH a value and the position it
-- consumed to. There are no tuples in the native subset, so the parse result is
-- a 2-field record — which rides the ABI registers and never allocates.
--
-- Gated `native_only` because the C backend cannot compile this shape; the
-- direct backend is strictly more capable here, so C is not a valid oracle.

-- A parse result: the value produced, and the position after it.
Res: @{ val: i64, pos: i64 }

is_digit = (c: i64): i64
    if c >= 48 and c <= 57
        return 1
    end
    0
end

skip_spaces = (src: str, pos: i64): i64
    n = #src
    i = pos
    while i <= n and string.byte(src, i) == 32
        i = i + 1
    end
    i
end

-- factor := NUMBER | '(' expr ')'
--
-- Mutual recursion with parse_expr: `factor` calls `expr` for a parenthesised
-- group, and `expr` calls `factor` through `term`. Proving that mutual recursion
-- lowers natively is half the point of this file — a recursive-descent parser is
-- nothing but a cycle of such calls.
parse_factor = (src: str, pos: i64): Res
    n = #src
    i = skip_spaces(src, pos)
    if i > n
        return { val = 0, pos = i }
    end
    c = string.byte(src, i)
    if c == 40
        inner: Res = parse_expr(src, i + 1)
        j = skip_spaces(src, inner.pos)
        if j <= n and string.byte(src, j) == 41
            return { val = inner.val, pos = j + 1 }
        end
        return { val = inner.val, pos = j }
    end
    acc = 0
    j = i
    while j <= n and is_digit(string.byte(src, j)) == 1
        acc = acc * 10 + string.byte(src, j) - 48
        j = j + 1
    end
    { val = acc, pos = j }
end

-- term := factor (('*' | '/') factor)*
parse_term = (src: str, pos: i64): Res
    n = #src
    left: Res = parse_factor(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = string.byte(src, i)
        if op == 42
            rhs: Res = parse_factor(src, i + 1)
            acc = acc * rhs.val
            i = skip_spaces(src, rhs.pos)
        end
        if op == 47
            rhs2: Res = parse_factor(src, i + 1)
            acc = acc / rhs2.val
            i = skip_spaces(src, rhs2.pos)
        end
        if op != 42 and op != 47
            return { val = acc, pos = i }
        end
    end
    { val = acc, pos = i }
end

-- expr := term (('+' | '-') term)*
parse_expr = (src: str, pos: i64): Res
    n = #src
    left: Res = parse_term(src, pos)
    acc = left.val
    i = skip_spaces(src, left.pos)
    while i <= n
        op = string.byte(src, i)
        if op == 43
            rhs: Res = parse_term(src, i + 1)
            acc = acc + rhs.val
            i = skip_spaces(src, rhs.pos)
        end
        if op == 45
            rhs2: Res = parse_term(src, i + 1)
            acc = acc - rhs2.val
            i = skip_spaces(src, rhs2.pos)
        end
        if op != 43 and op != 45
            return { val = acc, pos = i }
        end
    end
    { val = acc, pos = i }
end

main(): i64
    -- Precedence must bind `*` tighter than `+`: 1 + 2*3 = 7, not 9.
    r: Res = parse_expr("1 + 2 * 3", 1)
    r.val
end
