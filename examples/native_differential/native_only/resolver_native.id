
span: { start: i64, len: i64 }

alpha: i64 = (c: i64)
    if c >= 97 and c <= 122
        return 1
    if c >= 65 and c <= 90
        return 1
    if c == 95
        return 1
    0

ident: i64 = (c: i64)
    if c:alpha() == 1
        return 1
    if c >= 48 and c <= 57
        return 1
    0

space: i64 = (c: i64)
    if c == 32
        return 1
    if c == 10
        return 1
    0

equal: i64 = (src: str, a_start: i64, scope: str, b_start: i64, len: i64)
    k = 0
    while k < len
        if src:byte(a_start + k) != scope:byte(b_start + k)
            return 0
        k += 1
    1

has: i64 = (scope: str, src: str, start: i64, len: i64)
    m = scope:len()
    i = 1
    while i <= m
        while i <= m and scope:byte(i):space() == 1
            i += 1
        if i > m
            return 0
        j = i
        while j <= m and scope:byte(j):ident() == 1
            j += 1
        if j - i == len and src:equal(start, scope, i, len) == 1
            return 1
        i = j
        if i <= m and scope:byte(i):space() == 0
            i += 1
    0

unbound: i64 = (src: str, scope: str)
    n = src:len()
    count = 0
    i = 1
    while i <= n
        while i <= n and src:byte(i):alpha() == 0
            i += 1
        if i > n
            return count
        j = i
        while j <= n and src:byte(j):ident() == 1
            j += 1
        if scope:has(src, i, j - i) == 0
            count += 1
        i = j
    count

main: i64 = ()
    "x + total + y + z":unbound("x total")
