# expect: 45
# The first call remains live in x0 while the second call returns a pack through
# x0/x1; the selected member must survive caller restoration without clobbering
# the earlier value.
identity(n: i64): i64
  n

pair(n: i64): (i64, i64)
  return n, n + 1

main: i64 = ()
  identity(5) + pair(40)
