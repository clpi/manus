
_shifted: i64 = ()
    t = (1, 7, 7, 7, 9, 7, 7, 7)
    s = 0
    i = 1
    while i <= 4
        s += t[i]
        i += 1
    s

_partial: i64 = ()
    u = (10, 20, 30, 40, 50, 60)
    s = 0
    i = 2
    while i <= 4
        s += u[i]
        i += 1
    s

_chained: i64 = ()
    w = (3, 1, 4, 2)
    v = (10, 20, 30, 40)
    s = 0
    i = 1
    while i <= 4
        s += v[w[i]]
        i += 1
    s

_written: i64 = ()
    m: [4]i64 = {1, 2, 3, 4}
    m[2] = 50
    s = 0
    i = 1
    while i <= 4
        s += m[i]
        i += 1
    s

_check: i64 = ()
    if _shifted() != 22
        return 1
    if _partial() != 90
        return 2
    if _chained() != 100
        return 3
    if _written() != 58
        return 4
    0

_check()
