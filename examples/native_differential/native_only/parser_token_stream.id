# expect: 15
# The capability SH-04 was actually waiting on: a token-driven recursive-descent
# parser lowering to native ARM64.
#
# Recursive descent needs the token array shared across mutually recursive
# functions, plus a cursor they all advance. Both are positional tables passed
# by base address, so this exercises shared reads (`toks[p]`), shared writes
# (`st[1] = ...`), and mutual recursion in one program.
#
# Tokens: a value >= 0 is a literal, -1 is `+`, -2 is `*`. The input is
# 2 + 3 * 4 + 1, so precedence must be respected: 2 + 12 + 1 = 15, not 21.
parse_factor: i64 = (toks: ptr, st: ptr)
  p: i64 = st[1]
  v: i64 = toks[p]
  st[1] = p + 1
  v

parse_term: i64 = (toks: ptr, st: ptr, n: i64)
  acc: i64 = parse_factor(toks, st)
  while st[1] <= n and toks(st[1]) == -2
    st[1] = st[1] + 1
    rhs: i64 = parse_factor(toks, st)
    acc = acc * rhs
  acc

parse_expr: i64 = (toks: ptr, st: ptr, n: i64)
  acc: i64 = parse_term(toks, st, n)
  while st[1] <= n and toks(st[1]) == -1
    st[1] = st[1] + 1
    rhs: i64 = parse_term(toks, st, n)
    acc = acc + rhs
  acc

main: i64 = ()
  toks = { 2, -1, 3, -2, 4, -1, 1 }
  st = { 1 }
  r: i64 = parse_expr(toks, st, 7)
  r
