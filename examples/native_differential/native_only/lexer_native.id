# expect-exit: 84
# SH-03 step: a Duo lexer that lowers to native ARM64 and emits the CANONICAL
# token kind IDs — the same ids `src/lexer.zig` uses.
#
# The kind ids are not invented here. They come from `lib/token/classify.id`
# (SH-02, already `duo_canonical`, generated from `src/token_classify_gen.zig`)
# via `req`, and fold to immediates at compile time — so the Duo lexer and the
# host lexer agree on token identity by construction, not by convention.
#
# Why this shape rather than `lib/compiler/lexer.id`: that lexer's `Lexer`
# record has 18 fields including strings, nested records and floats, which
# exceeds the direct backend's 8-slot register ABI for aggregates. Keeping lexer
# state in scalars and a 3-field token record puts the whole thing inside the
# proven native subset. The 18-field design is a choice, not a requirement.

Classify = classify

tok: { kind: i64, start: i64, len: i64 }

# Non-keyword kinds. `classify.id` covers only the 54 reserved words, so these
# two live here and are deliberately outside the canonical keyword range.
kindname = 0
KIND_NUMBER = 1

digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

alpha: i64 = (c: i64)
    if c >= 97 and c <= 122
        return 1
    if c >= 65 and c <= 90
        return 1
    if c == 95
        return 1
    0

space: i64 = (c: i64)
    if c == 32
        return 1
    if c == 9
        return 1
    if c == 10
        return 1
    0

# Keyword recognition by length then bytes. A real lexer does exactly this;
# substring slicing is not in the native subset, and byte tests compile to
# register compares with no allocation.
classify_word: i64 = (src: str, start: i64, len: i64)
    b0 = src:byte(start)
    if len == 2
        if b0 == 105 and src:byte(start + 1) == 102
            return Classify.kindif
        if b0 == 100 and src:byte(start + 1) == 111
            return Classify.kinddo
    if len == 3
        if b0 == 101 and src:byte(start + 1) == 110 and src:byte(start + 2) == 100
            return Classify.kindend
        if b0 == 97 and src:byte(start + 1) == 110 and src:byte(start + 2) == 100
            return Classify.kindand
        if b0 == 102 and src:byte(start + 1) == 117 and src:byte(start + 2) == 110
            return Classify.kindfun
    if len == 5
        if b0 == 108 and src:byte(start + 1) == 111 and src:byte(start + 4) == 108
            return Classify.kindlocal
    if len == 6
        if b0 == 114 and src:byte(start + 1) == 101 and src:byte(start + 5) == 110
            return Classify.kindreturn
    kindname

nexttoken: tok = (src: str, pos: i64)
    n = src:len()
    i = pos
    while i <= n and src:byte(i):space() == 1
        i += 1
    if i > n
        return { kind = 0 - 1, start = i, len = 0 }
    c = src:byte(i)
    if c:alpha() == 1
        j = i
        while j <= n and src:byte(j):alpha() == 1
            j += 1
        return { kind = classify_word(src, i, j - i), start = i, len = j - i }
    if c:digit() == 1
        j = i
        while j <= n and src:byte(j):digit() == 1
            j += 1
        return { kind = KIND_NUMBER, start = i, len = j - i }
    { kind = 0 - 2, start = i, len = 1 }

# Sum the canonical kind ids of every reserved word found. Because the ids come
# from `classify.id`, this total is a fact about the shared token vocabulary —
# if the Duo lexer and the host lexer ever disagreed on an id, it would move.
sum_keyword_kinds: i64 = (src: str)
    total = 0
    pos = 1
    n = src:len()
    while pos <= n
        t: tok = nexttoken(src, pos)
        if t.kind == 0 - 1
            return total
        if t.kind > 1
            total += t.kind
        pos = t.start + t.len
    total

main: i64 = ()
    # Real Duo source. Reserved words present, with canonical ids:
    #   local(19) + if(17) + and(4) + return(24) + end(10) + end(10) = 84
    sum_keyword_kinds("local x = 1 if x and x return x end end")
