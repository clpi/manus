
Classify = classify

tok: { kind: i64, start: i64, len: i64 }

kindname = 0
KIND_NUMBER = 1

digit: i64 = (c: i64)
    if c >= 48 and c <= 57
        return 1
    0

alpha: i64 = (c: i64)
    if c >= 97 and c <= 122
        return 1
    if c >= 65 and c <= 90
        return 1
    if c == 95
        return 1
    0

space: i64 = (c: i64)
    if c == 32
        return 1
    if c == 9
        return 1
    if c == 10
        return 1
    0

classify_word: i64 = (src: str, start: i64, len: i64)
    b0 = src:byte(start)
    if len == 2
        if b0 == 105 and src:byte(start + 1) == 102
            return Classify.kindif
        if b0 == 100 and src:byte(start + 1) == 111
            return Classify.kinddo
    if len == 3
        if b0 == 101 and src:byte(start + 1) == 110 and src:byte(start + 2) == 100
            return Classify.kindend
        if b0 == 97 and src:byte(start + 1) == 110 and src:byte(start + 2) == 100
            return Classify.kindand
        if b0 == 102 and src:byte(start + 1) == 117 and src:byte(start + 2) == 110
            return Classify.kindfun
    if len == 5
        if b0 == 108 and src:byte(start + 1) == 111 and src:byte(start + 4) == 108
            return Classify.kindlocal
    if len == 6
        if b0 == 114 and src:byte(start + 1) == 101 and src:byte(start + 5) == 110
            return Classify.kindreturn
    kindname

nexttoken: tok = (src: str, pos: i64)
    n = src:len()
    i = pos
    while i <= n and src:byte(i):space() == 1
        i += 1
    if i > n
        return { kind = 0 - 1, start = i, len = 0 }
    c = src:byte(i)
    if c:alpha() == 1
        j = i
        while j <= n and src:byte(j):alpha() == 1
            j += 1
        return { kind = classify_word(src, i, j - i), start = i, len = j - i }
    if c:digit() == 1
        j = i
        while j <= n and src:byte(j):digit() == 1
            j += 1
        return { kind = KIND_NUMBER, start = i, len = j - i }
    { kind = 0 - 2, start = i, len = 1 }

sum_keyword_kinds: i64 = (src: str)
    total = 0
    pos = 1
    n = src:len()
    while pos <= n
        t: tok = nexttoken(src, pos)
        if t.kind == 0 - 1
            return total
        if t.kind > 1
            total += t.kind
        pos = t.start + t.len
    total

main: i64 = ()
    sum_keyword_kinds("local x = 1 if x and x return x end end")
