
lookup: i64 = (t0: i64, t1: i64, t2: i64, t3: i64, sym: i64)
    if t0 == sym
        return 1
    if t1 == sym
        return 2
    if t2 == sym
        return 3
    if t3 == sym
        return 4
    0

main: i64 = ()
    scope = { 0, 0, 0, 0 }

    n = 1
    while n <= 3
        scope[n] = n * 100
        n += 1

    a = lookup(scope[1], scope[2], scope[3], scope[4], 100)
    b = lookup(scope[1], scope[2], scope[3], scope[4], 200)
    c = lookup(scope[1], scope[2], scope[3], scope[4], 300)
    d = lookup(scope[1], scope[2], scope[3], scope[4], 999)

    scope[1] = 999
    e = lookup(scope[1], scope[2], scope[3], scope[4], 999)

    (a + b + c + d + e) * 3
