# expect: 100
# Native tables, step 3: MUTABLE dynamic stores — `t[i] = v` with `i` a loop
# variable. Reference `lua` gives 100; the C backend cannot compile this, so the
# gate uses Lua's answer. Lowers as a select-chain of stores over register-
# resident slots: no memory, no allocation.
main(): i64
    t = { 0, 0, 0, 0 }
    i = 1
    while i <= 4
        t[i] = i * 10
        i = i + 1
    end
    t[1] + t[2] + t[3] + t[4]
end
