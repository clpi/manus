
shout: i64 = (v: i64)
  print(v)
  0

bare: i64 = ()
  for i = 1, 3
    print(i)
  0

stepped: i64 = ()
  for i = 1, 3, 1
    print(i)
  0

viafn: i64 = ()
  for i = 1, 3
    shout(i)
  0

nested: i64 = ()
  for i = 1, 2
    for j = 1, 2
      print(j)
  0

control: i64 = ()
  i = 1
  while i <= 3
    print(i)
    i = i + 1
  0

summed: i64 = ()
  s = 0
  for i = 1, 3
    s = s + i
  s

main: i64 = ()
  bare()
  stepped()
  viafn()
  nested()
  control()
  summed()
