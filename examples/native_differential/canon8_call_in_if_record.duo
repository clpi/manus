Tok: @{ kind: i64, start: i64, len: i64 }
pred = (c: i64): i64
    if c > 5
        return 1
    end
    0
end
scan = (pos: i64): Tok
    if pred(pos) == 1
        return { kind = 1, start = pos, len = 1 }
    end
    { kind = 2, start = pos, len = 1 }
end
main(): i64
    t: Tok = scan(9)
    t.kind
end
