# Descending numeric `for`. The C backend emitted an unconditional `<=` as the
# continuation test, so `for i = 4, 1, -1` became
# `for (int64_t i = 4; i <= 1; i += (-1))` and ran ZERO iterations # every
# descending loop silently did nothing and returned the accumulator untouched.
#
# The direct ARM64 backend lowered the same loop correctly the whole time,
# which is why nothing caught it: examples/native_for_smoke.id exercises a
# descending loop but compiles native, so it passed while the C backend was
# wrong. A differential entry is the only thing that pins BOTH columns.
#
# Covers the three shapes that lower differently: a constant negative step, a
# constant negative step larger than 1, and a step whose sign is not known
# until run time (which needs a hoisted runtime test rather than a fixed
# comparison operator).

down_sum(n: i64): i64
    t = 0
    for i = n, 1, -1
        t += i
    end
    t
end

down_by_two(n: i64): i64
    t = 0
    for i = n, 1, -2
        t += i
    end
    t
end

# Step arrives as a value, so the comparison direction cannot be chosen at
# compile time. `0 - k` rather than a literal keeps it opaque to folding.
runtime_step(a: i64, b: i64, k: i64): i64
    t = 0
    for i = a, b, 0 - k
        t += i
    end
    t
end

# An empty range must stay empty: a descending loop whose start is already
# below its stop runs zero times, and must not wrap into a near-infinite one.
empty_range(): i64
    t = 0
    for i = 1, 4, -1
        t += 1000
    end
    t
end

main(): i64
    total = 0
    total += down_sum(4)          # 4+3+2+1        = 10
    total += down_by_two(6)       # 6+4+2          = 12
    total += runtime_step(5, 1, 2) # 5+3+1         = 9
    total += empty_range()        # 0
    # 31, and it must be identical under every backend column.
    total
end
