
down_sum: i64 = (n: i64)
  t = 0
  for i = n, 1, -1
    t = t + i
  t

down_by_two: i64 = (n: i64)
  t = 0
  for i = n, 1, -2
    t = t + i
  t

runtime_step: i64 = (a: i64, b: i64, k: i64)
  t = 0
  for i = a, b, 0 - k
    t = t + i
  t

empty_range: i64 = ()
  t = 0
  for i = 1, 4, -1
    t = t + 1000
  t

main: i64 = ()
  total = 0
  total = total + down_sum(4)
  total = total + down_by_two(6)
  total = total + runtime_step(5, 1, 2)
  total = total + empty_range()
  total
