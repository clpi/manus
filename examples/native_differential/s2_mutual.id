odd: i64 = (n: i64)
  if n == 0
    return 0
  # BLOCKED: `(n - 1):even()` is REFUSED — DNB011 unresolved-application-facts.
  # Subject-first application requires the relation to be ALREADY DECLARED, and
  # mutual recursion makes one of the two edges a forward reference by
  # construction. Measured: reversing the pair only moves the refusal to the
  # other edge. The operand-first face has no such restriction, so the canonical
  # face is refused exactly where the retired one works.
  return even(n - 1)
even: i64 = (n: i64)
  if n == 0
    return 1
  return odd(n - 1)
main: i64 = ()
  return 10:even()
