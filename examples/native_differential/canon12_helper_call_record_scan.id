tok: @{ kind: i64, start: i64, len: i64 }
is_alpha: i64 = (c: i64)
    if c >= 97 and c <= 122
        return 1
    0
scan: tok = (src: str, pos: i64)
    n = src:len()
    i = pos
    c = src:byte(i)
    if is_alpha(c) == 1
        j = i
        while j < n
            j += 1
        return { kind = 1, start = j, len = 1 }
    { kind = 2, start = i, len = 1 }
main: i64 = ()
    t: tok = scan("abcd", 1)
    t.start
