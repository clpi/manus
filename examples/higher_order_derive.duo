-- Higher-order derive macros: introspect the derive registry at compile time.
-- Demonstrates __list_derives, __lookup_derive, and __eval_derive.

@meta.define.derive("TraceFields", fun generate(meta) -> str
  acc = "/* TraceFields for " .. meta.name .. " */\n"
  for i = 1, #meta.fields
    f = meta.fields[i]
    acc = acc .. "// field " .. f.name .. " : " .. f.type .. "\n"
  end
  acc
end)

@meta.define.derive("Offsets", fun generate(meta) -> str
  acc = "/* Offsets for " .. meta.name .. " */\n"
  for i = 1, #meta.fields
    f = meta.fields[i]
    acc = acc .. "// offset of " .. f.name .. " = " .. tostring(i - 1) .. "\n"
  end
  acc
end)

-- Compose all other user-defined derives via @meta.derive.list / @meta.derive.eval.
@meta.define.derive("ComposeAll", fun generate(meta) -> str
  derives = @meta.derive.list()
  acc = "/* ComposeAll output for " .. meta.name .. " */\n"
  for i = 1, #derives
    dname = derives[i]
    if dname ~= "ComposeAll" then
      acc = acc .. "/* === from " .. dname .. " === */\n"
      acc = acc .. @meta.derive.eval(dname, meta)
    end
  end
  self_src = @meta.derive.lookup("ComposeAll")
  acc = acc .. "// ComposeAll source length: " .. tostring(#self_src) .. "\n"
  acc
end)

@derive(ComposeAll)
type Point = { x: f64, y: f64 }

print("Higher-order derive composed")
