
concept Hashable
    hash(self) -> i64

concept Counter
    value(self) -> i64

Both = {}
Both:hash() -> i64
    return 11
Both:value() -> i64
    return 3

half = {}
half:hash() -> i64
    return 7

fun use_both<T: Hashable + Counter>(target: T): i64
    target:hash() + target:value()

@comp.assert(@satisfies(Both, "Hashable"), "Both is Hashable")
@comp.assert(@satisfies(Both, "Counter"), "Both is Counter")

print("use_both(Both): " .. to(str)(use_both(Both)))
