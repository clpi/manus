# @comp.satisfies + @comp.map on typed records (type X = { ... })
# Run: duo run examples/comptime_map_satisfies_smoke.id

concept HasXY
    x: f64
    y: f64
end

Point: { x: f64, y: f64 }
IdOnly: { id: i64 }

@comp.assert(@comp.satisfies(Point, "HasXY"), "Point has x and y")
@comp.assert(not @comp.satisfies(IdOnly, "HasXY"), "IdOnly lacks x/y")

mark(meta): str
    meta.name .. ";"
end

MARKS = @comp.map("HasXY", mark)

print("satisfies Point = " .. to(str)(@comp.satisfies(Point, "HasXY")))
print("satisfies IdOnly = " .. to(str)(@comp.satisfies(IdOnly, "HasXY")))
print("marks = " .. MARKS)
print("ok")
