-- Example: Neural Network in Duo (self-contained)

-- Tensor helpers
zeros(rows, cols)
    t = { rows = rows, cols = cols, size = rows * cols, data = {} }
    for i = 1, rows * cols t.data[i] = 0.0 end
    return t
end

rand_tensor(rows, cols)
    t = zeros(rows, cols)
    for i = 1, t.size t.data[i] = math.random() * 0.1 - 0.05 end
    return t
end

matmul(a, b)
    r = zeros(a.rows, b.cols)
    for i = 1, a.rows
        for j = 1, b.cols
            s = 0.0
            for k = 1, a.cols s += a.data[(i-1)*a.cols+k] * b.data[(k-1)*b.cols+j] end
            r.data[(i-1)*b.cols+j] = s
        end
    end
    return r
end

add_bias(t, bias)
    r = zeros(t.rows, t.cols)
    for i = 1, t.rows
        for j = 1, t.cols
            r.data[(i-1)*t.cols+j] = t.data[(i-1)*t.cols+j] + bias.data[j]
        end
    end
    return r
end

relu(t)
    r = zeros(t.rows, t.cols)
    for i = 1, t.size
        if t.data[i] > 0 r.data[i] = t.data[i] end
    end
    return r
end

softmax(t)
    r = zeros(t.rows, t.cols)
    for row = 1, t.rows
        mx = t.data[(row-1)*t.cols+1]
        for i = 2, t.cols
            v = t.data[(row-1)*t.cols+i]
            if v > mx mx = v end
        end
        sm = 0.0
        for i = 1, t.cols
            r.data[(row-1)*t.cols+i] = math.exp(t.data[(row-1)*t.cols+i] - mx)
            sm += r.data[(row-1)*t.cols+i]
        end
        for i = 1, t.cols
            r.data[(row-1)*t.cols+i] = r.data[(row-1)*t.cols+i] / sm
        end
    end
    return r
end

-- Network forward pass (defined as local function, captures nothing)
nn_forward(x, w1, b1, w2, b2)
    h = relu(add_bias(matmul(x, w1), b1))
    return softmax(add_bias(matmul(h, w2), b2))
end

-- Initialize and run
math.randomseed(42)
w1 = rand_tensor(4, 8)
b1 = zeros(1, 8)
w2 = rand_tensor(8, 3)
b2 = zeros(1, 3)

input = { rows = 1, cols = 4, size = 4, data = {5.1, 3.5, 1.4, 0.2} }

print("Duo Neural Network")
print("  Architecture: 4 → 8 (ReLU) → 3 (Softmax)")

output = nn_forward(input, w1, b1, w2, b2)

print("  Output:")
print("    P(class 1) = " .. to(str)(output.data[1]))
print("    P(class 2) = " .. to(str)(output.data[2]))
print("    P(class 3) = " .. to(str)(output.data[3]))

sum = output.data[1] + output.data[2] + output.data[3]
assert(math.abs(sum - 1.0) < 0.01, "softmax broken")
print("    Sum = " .. to(str)(sum) .. " ✓")
print("")
print("✓ No Python. No PyTorch. Just Duo.")
