-- Demo of bash-style fun calls

fun greet(name: str): str
    return "Hello, " .. name
end

-- Bash-style call with string literal
print greet "World"

-- Bash-style call with name variable
name: str = "Duo"
print greet name

-- Bash-style call with number
fun double(x: i64): i64
    return x * 2
end

print double 21

-- Multiple arguments
fun add(a: i64, b: i64): i64
    return a + b
end

print add 10 20