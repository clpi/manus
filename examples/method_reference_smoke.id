
each = (t, f)
    for i = 1, t:len()
        f(t[i])

map_method = (t, f)
    result = {}
    for i = 1, t:len()
        result[i] = f(t[i])
    return result

Greeter = {}
Greeter.__index = Greeter
Greeter:greet()
    return "Hello, " .. self.name .. "!"
Greeter.new(name)
    return setmetatable({ name = name }, Greeter)

greeters = {
    Greeter.new("Alice"),
    Greeter.new("Bob"),
    Greeter.new("Charlie")
}

greetings = map_method(greeters, :greet)
print("RESULT method_ref " .. greetings[1] .. " | " .. greetings[2] .. " | " .. greetings[3])
