-- SH-03 — PRODUCTION DISPATCH: a foreign host calling the Duo lexer.
--
-- Every earlier SH-03 proof calls the Duo lexer from Duo. That shows the lexer
-- is IMPLEMENTED; it cannot show it is CALLABLE, which is the whole content of
-- the `duo_canonical` column. This proof closes that gap by leaving the
-- process boundary entirely:
--
--     lib/std/compiler/host.duo --lib --emit obj   ->  a linkable artifact
--     a C `main` that knows nothing but the ABI    ->  links against it
--     ./exe <file>                                 ->  prints kind,kind,...
--                                                            |
--     std.compiler.lexer, in THIS process          ->  the same list?
--
-- The differential is the point. A C host that merely does not crash proves
-- nothing — an uninitialized module returns plausible zeros, which is exactly
-- how this seam failed for most of its life (gaps/GAP-020.md). So the foreign
-- answer is compared token-for-token against the in-process answer on the same
-- bytes, and a disagreement names the source.
--
-- The synthetic cases are chosen for the paths where a lexer that "works" is
-- usually wrong: escapes, adjacent operators that could glue, comments that
-- could swallow code, and numeric forms. The last case is a real 135-line
-- module, because scale finds what fixtures do not.
--
-- Exit: 0 all agree, 1..N the failing case, 90 SKIP (no toolchain — visible,
-- never a silent pass), 91 the artifact would not build, 92 the host would not
-- link.

global L = std.compiler.lexer

global ART = "/tmp/duo_sh03_host.dylib"
global CSRC = "/tmp/duo_sh03_main.c"
global EXE = "/tmp/duo_sh03_host.out"
global EXE_FULL = "/tmp/duo_sh03_full.out"
global CSRC_FULL = "/tmp/duo_sh03_full.c"
global SRC = "/tmp/duo_sh03_input.duo"

-- The foreign side of the seam. It knows the four flat symbols and the record
-- stride, and nothing else about Duo — no headers, no runtime, no Duo types.
global HOST_C = "#include <stdio.h>\n"
    .. "#include <stdlib.h>\n"
    .. "#include <stdint.h>\n"
    .. "extern int64_t duo_lexer_tokenize_all(const char*, const char*, int64_t, int64_t);\n"
    .. "extern int64_t duo_lexer_host_stride(void);\n"
    .. "static int64_t buf[1 << 20];\n"
    .. "int main(int argc, char** argv) {\n"
    .. "    FILE* f = fopen(argv[1], \"rb\");\n"
    .. "    if (!f) return 3;\n"
    .. "    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);\n"
    .. "    char* src = malloc(n + 1);\n"
    .. "    if (fread(src, 1, n, f) != (size_t)n) return 4;\n"
    .. "    src[n] = 0; fclose(f);\n"
    .. "    int64_t stride = duo_lexer_host_stride();\n"
    .. "    int64_t cap = (int64_t)((1 << 20) / stride);\n"
    .. "    int64_t got = duo_lexer_tokenize_all(src, argv[1], (int64_t)(intptr_t)buf, cap);\n"
    .. "    if (got < 0) return 5;\n"
    .. "    for (int64_t i = 0; i < got; i++) {\n"
    .. "        if (i) putchar(',');\n"
    .. "        printf(\"%lld\", (long long)buf[i * stride]);\n"
    .. "    }\n"
    .. "    return 0;\n"
    .. "}\n"

-- The VALUES half of the seam. Kinds and text were already differentialed; the
-- numeric payloads never were, and that is exactly where a real bug was living:
-- every float literal lexed to its integer part (GAP-021), invisible to both
-- fingerprints because neither reads int_val or float_val.
--
-- Floats cross as a SCALED INTEGER rather than as text: C's "%g" and Duo's
-- to(str) disagree on formatting (0.025 vs 0.025000000000000001) without
-- disagreeing on the value, and a proof that fails on formatting is a proof
-- nobody will keep.
global HOST_FULL_C = "#include <stdio.h>\n"
    .. "#include <stdlib.h>\n"
    .. "#include <stdint.h>\n"
    .. "#include <string.h>\n"
    .. "extern int64_t duo_lexer_tokenize_full(const char*, const char*, int64_t, int64_t, int64_t, int64_t);\n"
    .. "static int64_t buf[1 << 20];\n"
    .. "static char txt[1 << 20];\n"
    .. "int main(int argc, char** argv) {\n"
    .. "    FILE* f = fopen(argv[1], \"rb\");\n"
    .. "    if (!f) return 3;\n"
    .. "    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);\n"
    .. "    char* src = malloc(n + 1);\n"
    .. "    if (fread(src, 1, n, f) != (size_t)n) return 4;\n"
    .. "    src[n] = 0; fclose(f);\n"
    .. "    int64_t got = duo_lexer_tokenize_full(src, argv[1],\n"
    .. "        (int64_t)(intptr_t)buf, (int64_t)((1 << 20) / 7),\n"
    .. "        (int64_t)(intptr_t)txt, 1 << 20);\n"
    .. "    if (got < 0) return 5;\n"
    .. "    for (int64_t i = 0; i < got; i++) {\n"
    .. "        int64_t* r = &buf[i * 7];\n"
    .. "        double fv; memcpy(&fv, &r[6], 8);\n"
    .. "        if (i) putchar(',');\n"
    .. "        printf(\"%lld:%lld:%lld\", (long long)r[0], (long long)r[3],\n"
    .. "            (long long)(fv * 1000000.0));\n"
    .. "    }\n"
    .. "    return 0;\n"
    .. "}\n"

_write = (path: str, text: str): bool
    fh = io.open(path, "w")
    if not fh
        return false
    end
    fh:write(text)
    fh:close()
    true
end

_read = (path: str): str
    fh = io.open(path, "r")
    if not fh
        return ""
    end
    text = fh:read("a")
    fh:close()
    text
end

-- The in-process answer, built without a buffer: the same lexer, driven one
-- token at a time, so the two sides share only the source bytes.
_native_kinds = (src: str, file: str): str
    lex = L.new(src, file)
    acc = ""
    first = true
    while true
        tok = L.next_tok(lex)
        if first
            acc = to(str)(tok.kind)
            first = false
        else
            acc = acc .. "," .. to(str)(tok.kind)
        end
        if tok.kind == std.compiler.token.KIND_EOF return acc end
    end
    acc
end

_foreign_kinds = (src: str, file: str): str
    if not _write(SRC, src)
        return ""
    end
    out = std.script.capture(EXE .. " " .. SRC)
    n: i64 = #out
    while n > 0 and (string.byte(out, n) == 10 or string.byte(out, n) == 32)
        n -= 1
    end
    string.sub(out, 1, n)
end

-- kind:int_val:scaled_float per token, built in-process for comparison.
_native_values = (src: str, file: str): str
    lex = L.new(src, file)
    acc = ""
    first = true
    while true
        tok = L.next_tok(lex)
        one = to(str)(tok.kind) .. ":" .. to(str)(tok.int_val) .. ":"
            .. to(str)(to(i64)(tok.float_val * 1000000.0))
        if first
            acc = one
            first = false
        else
            acc = acc .. "," .. one
        end
        if tok.kind == std.compiler.token.KIND_EOF return acc end
    end
    acc
end

_foreign_values = (src: str, file: str): str
    if not _write(SRC, src)
        return ""
    end
    out = std.script.capture(EXE_FULL .. " " .. SRC)
    n: i64 = #out
    while n > 0 and (string.byte(out, n) == 10 or string.byte(out, n) == 32)
        n -= 1
    end
    string.sub(out, 1, n)
end

_check_values = (n: i64, label: str, src: str): i64
    want = _native_values(src, SRC)
    got = _foreign_values(src, SRC)
    if got == ""
        print("lexer_host: FAIL {n} ({label}): no values from host")
        return n
    end
    if got != want
        print("lexer_host: FAIL {n} ({label}) — kind:int:float*1e6")
        print("  in-process: {want}")
        print("  foreign   : {got}")
        return n
    end
    0
end

-- VALUE CORRECTNESS needs an oracle that is not the lexer.
--
-- _check_values above compares in-process Duo against foreign Duo, so it proves
-- the ABI transports the payload faithfully — and provably cannot catch a wrong
-- payload, because both sides run the same lexer and a lexer bug cancels. Red-
-- tested: restoring GAP-021's `tonumber(text) or 0.0` leaves it green.
--
-- The independent oracle is the HOST COMPILER's own literal parsing. `1.5` on
-- the right is parsed by the compiler building this proof; `"a = 1.5"` on the
-- left is parsed by the lexer under test. Two implementations, one number.
_check_float = (n: i64, src: str, want: f64): i64
    lex = L.new(src, "lit.duo")
    tok = L.next_tok(lex)
    if tok.float_val != want
        print("lexer_host: FAIL {n}: [{src}] lexed float_val {tok.float_val}, the host compiler says {want}")
        return n
    end
    0
end

_check_int = (n: i64, src: str, want: i64): i64
    lex = L.new(src, "lit.duo")
    tok = L.next_tok(lex)
    if tok.int_val != want
        print("lexer_host: FAIL {n}: [{src}] lexed int_val {tok.int_val}, the host compiler says {want}")
        return n
    end
    0
end

_check = (n: i64, label: str, src: str): i64
    want = _native_kinds(src, SRC)
    got = _foreign_kinds(src, SRC)
    if got == ""
        print("lexer_host: FAIL {n} ({label}): host produced nothing")
        return n
    end
    if got != want
        print("lexer_host: FAIL {n} ({label})")
        print("  in-process: {want}")
        print("  foreign   : {got}")
        return n
    end
    0
end

main(): i64
    root = std.script.getenv("DUO_ROOT", ".")
    duo = root .. "/zig-out/bin/duo"
    cc = std.script.getenv("DUO_HOST_CC", "xcrun clang")

    -- 1. Build the artifact from the anchor module, not from lexer.duo. That
    --    distinction is the fix; see lib/std/compiler/host.duo.
    build = duo .. " compile " .. root .. "/lib/std/compiler/host.duo"
        .. " --backend=c --lib --emit obj -o " .. ART .. " > /dev/null 2>&1"
    if std.script.run(build) != 0
        print("lexer_host: FAIL — artifact did not build")
        return 91
    end

    -- 2. Link a C main that has never heard of Duo.
    if not _write(CSRC, HOST_C)
        print("lexer_host: SKIP — cannot write " .. CSRC)
        return 90
    end
    if std.script.run(cc .. " -o " .. EXE .. " " .. CSRC .. " " .. ART .. " 2>/dev/null") != 0
        print("lexer_host: FAIL — C host did not link against the artifact")
        return 92
    end

    -- 3. A live-boundary control BEFORE any comparison. If the artifact were
    --    uninitialized it would answer 0 tokens here, and every later case
    --    would compare empty against empty and pass.
    if _foreign_kinds("x", "probe.duo") == ""
        print("lexer_host: SKIP — host runs but returns nothing")
        return 90
    end

    r: i64 = 0
    r = _check(1, "declaration", "fun add(a: i64): i64 = a + 1 end")
    if r != 0 return r end
    r = _check(2, "string escapes", "s = \"a\\tb\\nc\\\\d\\\"e\"")
    if r != 0 return r end
    r = _check(3, "gluing operators", "x = a<=b and c>=d or e~=f")
    if r != 0 return r end
    r = _check(4, "comment vs code", "-- x = 1\ny = 2 -- trailing\nz = 3")
    if r != 0 return r end
    r = _check(5, "numeric forms", "a = 0xFF b = 1.5 c = 100 d = 0")
    if r != 0 return r end
    r = _check(6, "long bracket", "s = [[raw \\n not an escape]]")
    if r != 0 return r end
    r = _check(7, "empty source", "")
    if r != 0 return r end

    -- 8. Scale: a real module, tokenized on both sides of the boundary.
    real = _read(root .. "/lib/std/compiler/token.duo")
    if real == ""
        print("lexer_host: FAIL 8: could not read the corpus module")
        return 8
    end
    r = _check(8, "lib/std/compiler/token.duo", real)
    if r != 0 return r end

    -- 9..12. The VALUES seam, through duo_lexer_tokenize_full. Case 9 is the
    -- one that was silently wrong for the whole life of the Duo lexer.
    if not _write(CSRC_FULL, HOST_FULL_C)
        print("lexer_host: SKIP — cannot write " .. CSRC_FULL)
        return 90
    end
    if std.script.run(cc .. " -o " .. EXE_FULL .. " " .. CSRC_FULL .. " " .. ART .. " 2>/dev/null") != 0
        print("lexer_host: FAIL — full-record host did not link")
        return 92
    end
    r = _check_values(9, "float literals", "a = 1.5 b = 2.25 c = 0.5")
    if r != 0 return r end
    r = _check_values(10, "int and hex", "a = 42 b = 0xFF c = 0")
    if r != 0 return r end
    r = _check_values(11, "exponents", "a = 1e3 b = 2.5e-2")
    if r != 0 return r end
    r = _check_values(12, "mixed with code", real)
    if r != 0 return r end

    -- 13..20. VALUE CORRECTNESS against the host compiler's own literals. This
    -- is the group that actually catches GAP-021; cases 9..12 above prove only
    -- that whatever the lexer produced arrived intact.
    r = _check_float(13, "1.5", 1.5)
    if r != 0 return r end
    r = _check_float(14, "2.25", 2.25)
    if r != 0 return r end
    r = _check_float(15, "0.5", 0.5)
    if r != 0 return r end
    r = _check_float(16, "1e3", 1e3)
    if r != 0 return r end
    r = _check_float(17, "2.5e-2", 2.5e-2)
    if r != 0 return r end
    r = _check_int(18, "42", 42)
    if r != 0 return r end
    r = _check_int(19, "0xFF", 0xFF)
    if r != 0 return r end
    r = _check_int(20, "0", 0)
    if r != 0 return r end

    os.remove(CSRC_FULL)
    os.remove(EXE_FULL)
    os.remove(CSRC)
    os.remove(EXE)
    os.remove(SRC)
    os.remove(ART)
    print("lexer_host: 20 cases — a C host linked against the Duo lexer and")
    print("            agreed on kinds, text, int_val and float_val.")
    print("            SH-03 production dispatch: PROVEN.")
    0
end
