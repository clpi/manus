-- Exponential pipeline: @comp.pipeline + @comp.map + @comp.derive stacked
-- Run: duo run examples/exponential_pipeline_showcase.duo

concept HasN
    n: i64
end

type CounterA = { n: i64 }
type CounterB = { n: i64, tag: str }

@comp.define.derive("CountApi", generate(meta) -> str
    "static inline int64_t duo_" .. meta.name .. "_get_n(const duo_" .. meta.name .. "* v) { return v->n; }\n"
end)

@comp.pipeline({
    fn = "sum_n",
    source = "range",
    start = 1,
    stop = 101,
    elem = "int64_t",
    kind = "reduce",
    init = "0",
})

registry_line(meta): str
    meta.name .. ";"
end

@c.emit(@comp.derive("HasN", CountApi))

TYPED = @comp.map("HasN", registry_line)
DERIVED = @comp.derive("HasN", CountApi)

total(): i64
    @c.call("sum_n")
end

print("=== exponential pipeline showcase ===")
print("sum 1..100 = " .. to(str)(total()))
print("typed_sweep = " .. TYPED)
print("derive_bytes = " .. to(str)(#DERIVED))
print("ok")
