
menu: str = (key: str, label: str)
    "  [{key}] {label}\n"

listfiles: str = (path: str)
    cmd: str = "ls -1 {path} 2>&1 | head -20"
    gatecap(cmd)

fib: str = ()
    gatecap('awk '\''BEGIN{a=0;b=1;for(i=1;i<=10;i++){print "fib("i")="a;t=a+b;a=b;b=t}}'\''')

main: i64 = ()
    path: str = os.env("HOME")
    running: i64 = 1

    q: str = "q":menu("quit")
    l: str = "l":menu("list files")
    d: str = "d":menu("date")
    f: str = "f":menu("fibonacci")
    h: str = "h":menu("host")
    g: str = "g":menu("git")
    s: str = "s":menu("status")
    stdout:write("\n{q}{l}{d}{f}{h}{g}{s}\n")

    while running
        stdout:write("> ")
        line: str = stdin:line()

        if line:has("q")
            running = 0
        else
            if line:has("l")
                files: str = path:listfiles()
                stdout:write("{files}\n")
            else
                if line:has("d")
                    dateout: str = gatecap('date "+%Y-%m-%d %H:%M:%S"')
                    stdout:write("{dateout}\n")
                else
                    if line:has("f")
                        out: str = fib()
                        stdout:write("{out}\n")
                    else
                        if line:has("h")
                            host: str = gatecap("hostname")
                            stdout:write("{host}\n")
                        else
                            if line:has("g")
                                cmd: str = "git -C {path} status --short --branch 2>&1 | head -10"
                                gitout: str = gatecap(cmd)
                                stdout:write("{gitout}\n")
                            else
                                if line:has("s")
                                    stdout:write("mode:normal path:{path}\n")
                                else
                                    if line:len() > 0
                                        stdout:write("unknown — try q l d f h g s\n")

    stdout:write("bye\n")
    0