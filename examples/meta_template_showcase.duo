-- @comp.template parametric expansion → O(n) native C fragments
-- Run: duo run examples/meta_template_showcase.duo

INSTANCES = "i64:int64_t | f64:double"
BODY = "/* template[$0:$1] */\n"

CODE = @comp.template(INSTANCES, BODY)

GEN = @comp.generate("add,sub,mul", "/* op=$0 */\n")

print("=== @comp.template showcase ===")
print(CODE)
print(GEN)
print("RESULT template_ok = true")
