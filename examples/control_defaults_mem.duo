const default_step: i64 = 3

score(base: i64, step: i64 = default_step, factor: i64 = 2): i64
    return base + step * factor
end

skipped_sum(limit: i64): i64
    local total: i64 = 0
    for i = 1, limit
        if i % 2 == 0
            continue
        end
        total += i
    end
    return total
end

local block = [[alpha
beta]]
local bracket = [=[contains ]] without ending]=]

if block ~= "alpha\nbeta"
    error("bad long string")
end

if bracket ~= "contains ]] without ending"
    error("bad equal-delimited long string")
end

local raw: *u8 = mem.alloc(16)
mem.assume(not mem.is_null(raw))
mem.prefetch(raw)

local slot: *i64 = mem.cast("i64", raw)
mem.store("i64", slot, score(4))
local got: i64 = mem.load("i64", slot)

if got ~= 10
    mem.trap()
end

if got == 0
    mem.unreachable()
end

mem.free(raw)

print(score(4, 5))
print(skipped_sum(7))
print(got)
