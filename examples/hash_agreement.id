
box: any = (x: any)
  return x

main: i64 = ()
  fails = 0

  shortlit = box("shortkey")
  shortbuilt = box("shortkey!":sub(1, 8))
  if shortlit != shortbuilt
    print("FAIL short: literal and runtime-built are different objects")
    fails = fails + 1

  longlit = box("a very long table key that is definitely more than thirty-two bytes long")
  longbuilt = box("a very long table key that is definitely more than thirty-two bytes long" .. "!":sub(1, 72))
  if longlit != longbuilt
    print("FAIL long: literal and runtime-built are different objects")
    fails = fails + 1

  t = {}
  t[shortbuilt] = 11
  t[longbuilt] = 22
  if t[shortlit] != 11
    print("FAIL short key: inserted by runtime hash, read by literal hash")
    fails = fails + 1
  if t[longlit] != 22
    print("FAIL long key: inserted by runtime hash, read by literal hash")
    fails = fails + 1

  u = {}
  i = 0
  while i < 200
    u("x":rep(500) .. i:to(str)) = i
    i = i + 1
  bad = 0
  i = 0
  while i < 200
    if u("x":rep(500) .. i:to(str)) != i
      bad = bad + 1
    i = i + 1
  if bad != 0
    print("FAIL long distinct keys: " .. bad:to(str) .. " of 200 merged")
    fails = fails + 1

  if u("x":rep(500) .. "999") != nil
    print("FAIL control: a long key never inserted answered non-nil")
    fails = fails + 1

  print("hash agreement: 6 checks ran")
  if fails == 0
    print("hash agreement: PASS")
    return 0
  print("hash agreement: FAIL " .. fails:to(str))
  return 1
