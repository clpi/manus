# User-defined @comp.define.derive + @comp.fields.map exponential codegen showcase
# Run: duo run examples/user_derive_showcase.id

@comp.define.derive("CStruct", generate: str = (meta)
    acc = "typedef struct " .. meta.name .. " {\n"
    for i = 1, meta.fields:len()
        f = meta.fields[i]
        acc = acc .. "    " .. f.type .. " " .. f.name .. ";\n"
    acc = acc .. "} " .. meta.name .. ";\n"
    acc
)

@comp.define.derive("GetterBundle", generate: str = (meta)
    acc = ""
    for i = 1, meta.fields:len()
        f = meta.fields[i]
        acc = acc .. "static inline " .. f.type .. " " .. meta.name .. "_get_" .. f.name .. "(const " .. meta.name .. "* v) { return v->" .. f.name .. "; }\n"
    acc
)

@derive(CStruct, GetterBundle)
vector: { x: f64, y: f64, z: f64 }

@derive(CStruct)
color: { r: f64, g: f64, b: f64 }

v3: vector = { x = 1.0, y = 2.0, z = 3.0 }
rgb: color = { r = 1.0, g = 0.5, b = 0.0 }

FIELD_MAP = @comp.fields.map(v3, "/* %n:%t */")

UNROLL = @(@comp.for(0, 5, "slot_%i=0;"))

print("=== user derive showcase ===")
print("field_map = " .. FIELD_MAP)
print("unrolled = " .. UNROLL)
print("vector fields = " .. to(str)(@fields(v3):len()))
print("color fields = " .. to(str)(@fields(rgb):len()))
print("ok")
