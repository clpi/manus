
enum token__kind
  name
  number
  eof
token: { kind: token__kind, span: i64 }

enum glyph__form
  circle
  square
  number
glyph: { form: glyph__form, area: f64 }

n = 0
k = token__kind.eof
f = glyph__form.number

if k == eof
  n = n + 1
if eof == k
  n = n + 10
if k != number
  n = n + 5

if f == number
  n = n + 200

if f == circle
  n = n + 30000
if k == number
  n = n + 1000

print("{n}")
