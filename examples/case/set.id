
enum token__kind
  name
  number
  string
  symbol
  eof
token: { kind: token__kind, span: i64 }

n = 0
k = token__kind.eof
if k == token__kind.eof
  n = n + 1
if k == token__kind.number
  n = n + 100
if token__kind.number == token__kind.number
  n = n + 8
if token__kind.name == token__kind.symbol
  n = n + 400
print("{n}")
