-- Pass 16 — DNIR hardware direct path.
-- `@comp.hint.fence` + `@comp.bit.popcount` → sovereign ARM64 (`dmb ish`, `cnt`).
-- No C emit floor; machine code is canonical.

main(): i64
    @comp.hint.fence()
    bits = @comp.bit.popcount(47)
    if bits ~= 5 return 1 end
    @comp.hint.fence()
    0
end
