# @corpus verified
# Pass 100 §9 — conversion algebra: one relation `to`, hub derivation, enumerable trie.
# FROM-ZERO (law.from.zero): `from` normalizes to the same `to` edge — no second
# relation universe. Canonical invocation is subject-first `value:to(target)`.
#
#     to(micron)(inch) = stretch@lossless   # declaration projection — not call site
#     for src, conv in to[micron]
#     feet: f64 = 3.0:to(inch)              # was inch:from(foot)(3.0) — migration debt
#
# Six authored edges, six derived through micron hub. SER = 12/6 = 2.00 at N = 4.
# expect: 189

stretch: f64 = (v: f64)
    v * 25400.0

shrink: f64 = (v: f64)
    v / 25400.0

swell: f64 = (v: f64)
    v * 1000.0

shrivel: f64 = (v: f64)
    v / 1000.0

expand: f64 = (v: f64)
    v * 304800.0

compress: f64 = (v: f64)
    v / 304800.0

to(micron)(inch) = stretch@lossless
to(inch)(micron) = shrink@lossless
to(micron)(milli) = swell@lossless
to(milli)(micron) = shrivel@lossless
to(micron)(foot) = expand@lossless
to(foot)(micron) = compress@lossless

main: i64 = ()
    # Hub-derived spoke conversions — subject-first to, not from (law.from.zero)
    feet: f64 = 3.0:to(inch)
    bore: f64 = 5.0:to(milli)
    span: f64 = 254.0:to(inch)

    n = 0
    n = n + feet:to(i64)
    n = n + bore:to(i64)
    n = n + span:to(i64)

    for src, conv in to[micron]
        n = n + 1
        n = n + #src

    print("{n}")
    0
