  63
errno_inval: u16 = ()
  28
errno_notdir: u16 = ()
  54
errno_overflow: u16 = ()
  61

fd_stdin: i32 = ()
  0
fd_stdout: i32 = ()
  1
fd_stderr: i32 = ()
  2

