  4
right_fd_fdstat_get: u64 = ()
  16
right_poll_oneoff: u64 = ()
  256
right_sock_accept: u64 = ()
  65536

oflags_creat: u16 = ()
  1
oflags_directory: u16 = ()
  2
oflags_excl: u16 = ()
  4
oflags_trunc: u16 = ()
  8

filetype_unknown: u8 = ()
  0
filetype_block_device: u8 = ()
  1
filetype_character_device: u8 = ()
  2
filetype_directory: u8 = ()
  3
filetype_regular_file: u8 = ()
  4
filetype_socket_dgram: u8 = ()
  5
filetype_socket_stream: u8 = ()
  6
filetype_symlink: u8 = ()
  7

