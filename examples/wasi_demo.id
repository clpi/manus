print("=== WASI File Descriptors ===")
print("stdin:  " .. to(str)(fd_stdin()))
print("stdout: " .. to(str)(fd_stdout()))
print("stderr: " .. to(str)(fd_stderr()))

print("\n=== WASI Rights ===")
print("fd_read:  " .. to(str)(right_fd_read()))
print("fd_write: " .. to(str)(right_fd_write()))
print("fd_seek:  " .. to(str)(right_fd_seek()))
print("poll_one: " .. to(str)(right_poll_oneoff()))
print("sock_accept: " .. to(str)(right_sock_accept()))

print("\n=== WASI Open Flags ===")
print("oflags_creat: " .. to(str)(oflags_creat()))
print("oflags_dir:   " .. to(str)(oflags_directory()))
print("oflags_excl:  " .. to(str)(oflags_excl()))
print("oflags_trunc: " .. to(str)(oflags_trunc()))

print("\n=== WASI File Types ===")
print("regular_file: " .. to(str)(filetype_regular_file()))
print("directory:     " .. to(str)(filetype_directory()))
print("symlink:       " .. to(str)(filetype_symlink()))
print("sock_stream:   " .. to(str)(filetype_socket_stream()))

print("\n=== WASI Clock IDs ===")
print("realtime:   " .. to(str)(clockid_realtime()))
print("monotonic:  " .. to(str)(clockid_monotonic()))

print("\n=== WASI Whence (Seek) ===")
print("set: " .. to(str)(whence_set()))
print("cur: " .. to(str)(whence_cur()))
print("end: " .. to(str)(whence_end()))

print("\n=== WASI Signals ===")
print("SIGHUP:  " .. to(str)(signal_hup()))
print("SIGINT:  " .. to(str)(signal_int()))
print("SIGTERM: " .. to(str)(signal_term()))
print("SIGKILL: " .. to(str)(signal_kill()))

print("\n=== WASI Exit Codes ===")
print("success: " .. to(str)(exit_success()))
print("failure: " .. to(str)(exit_failure()))

print("\n=== WASI Timestamps ===")
print("1 second in ns: " .. to(str)(timestamp_second()))
print("1 ms in ns:     " .. to(str)(timestamp_millisecond()))
print("1 us in ns:     " .. to(str)(timestamp_microsecond()))

print("\n=== WASI Errnos ===")
print("success:  " .. to(str)(errno_success()))
print("noent:    " .. to(str)(errno_noent()))
print("perm:     " .. to(str)(errno_perm()))
print("inval:    " .. to(str)(errno_inval()))
print("overflow: " .. to(str)(errno_overflow()))
