-- @comp.match — compile-time pattern-match codegen (switch/case of codegen)
-- One declarative line produces N specialized branches from a pipe-separated spec.
-- Composes with @comp.each, @comp.burst, etc. Comptime-only — folds to native C string.

-- Basic: generate typed typedefs from pattern alternatives
typedefs = @comp.match("i32|i64|f64|str", (m: any)
    "typedef " .. m.pattern .. " variant_" .. to(str)(m.index) .. ";\n"
end)
print("=== @comp.match: typed typedefs ===")
print(typedefs)

-- Generate function signatures for arithmetic operations
ops = @comp.match("add|sub|mul|div", (m: any)
    "i64 " .. m.pattern .. "(i64 a, i64 b);\n"
end)
print("=== @comp.match: function signatures ===")
print(ops)

-- Compose with @comp.each: match → split → annotate each fragment
annotated = @comp.each(ops, (f: any)
    "/* fragment " .. to(str)(f.index) .. ": " .. f.name .. " */\n"
end)
print("=== @comp.match + @comp.each: composition ===")
print(annotated)

-- Generate switch-case dispatch table
dispatch = @comp.match("get|set|del|has", (m: any)
    "case OP_" .. m.pattern .. ": return handle_" .. m.pattern .. "(args);\n"
end)
print("=== @comp.match: dispatch table ===")
print(dispatch)