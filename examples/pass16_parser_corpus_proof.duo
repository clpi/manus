-- Pass 16 WS6 (P16-WS6 / MP-06) — token-stream statement-level parser corpus.
-- The L3 family in lib/std/compiler/parser.duo projects a bounded Duo subset to
-- s-expressions over the lexer token stream. This proof runs the positive
-- projection differential (exact sexpr) and the compile-fail differential
-- (parse_status must reject malformed input), all through the NATIVE backend.
--
-- Exit code: 0 on full pass, 1..55 positive mismatch index, 101+ compile-fail
-- index, 200 clean-input misclassification.

positives = {
    { "x = 42", "(program (assign x 42))" },
    { "add(a, b)", "(program (call add a b))" },
    { "2 + 3 * (4 - 1)", "(program (+ 2 (* 3 (- 4 1))))" },
    { "fun add(a: i64, b: i64): i64 = a + b end", "(program (fun add (params (param a i64) (param b i64)) (ret i64) (+ a b)))" },
    { "fun sub(a, b) a - b end", "(program (fun sub (params (param a) (param b)) (- a b)))" },
    { "if ready run() end", "(program (if ready (call run)))" },
    { "if a < b x else y end", "(program (if (< a b) x (else y)))" },
    { "while n > 0 n = n - 1 end", "(program (while (> n 0) (assign n (- n 1))))" },
    { "return 42", "(program (return 42))" },
    { "@fence", "(program (at fence))" },
    { "d = { x = 1, y = 2 }", "(program (assign d (desc x 1 y 2)))" },
    { "bar = foo@7", "(program (assign bar (anchor foo 7)))" },
    { "print \"hi\"", "(program (call print \"hi\"))" },
    { "x = if a < b value else value * 2 end", "(program (assign x (if (< a b) value (else (* value 2)))))" },
    { "a + b == c", "(program (= (+ a b) c))" },
    { "-x", "(program (- x))" },
    { "@comp.c.export(\"x\")", "(program (at comp c export \"x\"))" },
    { "add(a: i64, b: i64): i64 = a + b end", "(program (fun add (params (param a i64) (param b i64)) (ret i64) (+ a b)))" },
    -- `for`, both forms. The `range` grouping is load-bearing: without it a
    -- three-expression header and a two-expression header followed by a body
    -- statement project to the same s-expression.
    { "for i = 1, n x = i end", "(program (for i (range 1 n) (assign x i)))" },
    { "for i = 1, n, 2 x = i end", "(program (for i (range 1 n 2) (assign x i)))" },
    { "for i = 1, n do x = i end", "(program (for i (range 1 n) (assign x i)))" },
    { "for i = 1, n end", "(program (for i (range 1 n)))" },
    { "for v in t x = v end", "(program (forin (names v) t (assign x v)))" },
    { "for k, v in pairs(t) x = k end", "(program (forin (names k v) (call pairs t) (assign x k)))" },
    { "for i = 1, n for j = 1, m x = j end end", "(program (for i (range 1 n) (for j (range 1 m) (assign x j))))" },
    -- Postfix: length, indexing, method calls. `join` on the method arglist is
    -- what keeps a no-argument call `(method obj close)` rather than
    -- `(method obj close )`.
    { "x = #t", "(program (assign x (len t)))" },
    { "x = t[i]", "(program (assign x (index t i)))" },
    { "x = t[i].f[2]", "(program (assign x (index (dot (index t i) f) 2)))" },
    { "obj:m(1, 2)", "(program (method obj m 1 2))" },
    { "obj:close()", "(program (method obj close))" },
    { "f:read(\"a\")", "(program (method f read \"a\"))" },
    -- Assignment to a target that is not a bare name, and multiple assignment.
    { "t[i] = 5", "(program (assign (index t i) 5))" },
    { "a.b[i].c = 5", "(program (assign (dot (index (dot a b) i) c) 5))" },
    { "t[i] += 5", "(program (assign-op += (index t i) 5))" },
    { "a, b = 1, 2", "(program (assign-multi (targets a b) (values 1 2)))" },
    { "t.x, t.y = 1, 2", "(program (assign-multi (targets (dot t x) (dot t y)) (values 1 2)))" },
    -- Declarations, break, repeat.
    { "local n: i64 = 5", "(program (local n (type i64) 5))" },
    { "global x", "(program (global x))" },
    { "while a break end", "(program (while a (break)))" },
    { "repeat x = 1 until a", "(program (repeat (assign x 1) (until a)))" },
    -- `!=` must not collapse into `=`. These two cases exist as a pair on
    -- purpose: either alone would pass while the parser conflated them.
    { "x = a != b", "(program (assign x (!= a b)))" },
    { "x = a == b", "(program (assign x (= a b)))" },
    -- `^` binds tighter than unary minus and is right-associative.
    { "x = a ^ b ^ c", "(program (assign x (^ a (^ b c))))" },
    { "x = -a ^ b", "(program (assign x (- (^ a b))))" },
    -- Table constructors: positional, keyed, and mixed.
    { "x = { 1, 2, 3 }", "(program (assign x (desc (item 1) (item 2) (item 3))))" },
    { "x = { a, b }", "(program (assign x (desc (item a) (item b))))" },
    { "x = { 1, y = 2 }", "(program (assign x (desc (item 1) y 2)))" },
    -- Anonymous functions, varargs, do-blocks, semicolons.
    { "f = fun(a) a end", "(program (assign f (lambda (params (param a)) a)))" },
    { "f(...)", "(program (call f (varargs)))" },
    { "do x = 1 end", "(program (do (assign x 1)))" },
    { "x = 1; y = 2", "(program (assign x 1) (assign y 2))" },
    -- A block-bodied function with a return type. This is the case the greedy
    -- proj_type mis-parsed as `(ret i64 a)` — the body absorbed into the type.
    { "add(a: i64): i64 a end", "(program (fun add (params (param a i64)) (ret i64) a))" },
    { "f = fun(a: i64): i64 a end", "(program (assign f (lambda (params (param a i64)) (ret i64) a)))" },
    { "g(l: Lexer): Tok l end", "(program (fun g (params (param l Lexer)) (ret Tok) l))" },
    { "f(x: std.str): std.str x end", "(program (fun f (params (param x std.str)) (ret std.str) x))" },
    -- An expression STATEMENT whose head is a postfix chain. proj_target_or_expr
    -- speculates that a NAME followed by `.`/`[`/`,` is an assignment target; when
    -- no assignment operator follows it must rewind, not return the postfix it
    -- already parsed. Without the rewind this projected `(dot a x)` and silently
    -- dropped the rest of the expression.
    { "a.x * b.x + a.y * b.y", "(program (+ (* (dot a x) (dot b x)) (* (dot a y) (dot b y))))" },
    { "t[i].f + 1", "(program (+ (dot (index t i) f) 1))" },
    -- The declaration-vs-call discriminator (GR-001). All three are needed:
    -- a parameter annotation with NO return type, a return type with NO
    -- parameter annotation, and a plain call that must stay a call. Two earlier
    -- versions of params_have_colon each satisfied one of the first two and
    -- broke the other, and the corpus could not tell.
    { "f(d: any) 1 end", "(program (fun f (params (param d any)) 1))" },
    { "f(a, b): i64 a end", "(program (fun f (params (param a) (param b)) (ret i64) a))" },
    { "g(x, h)", "(program (call g x h))" },
    -- FF-1 value-form functions in expression position — the canonical function
    -- form, which the parser could not read at all (including in its own source
    -- after that file's FF-1 migration).
    { "g = (a: i64): i64 a end", "(program (assign g (lambda (params (param a i64)) (ret i64) a)))" },
    { "f(x, (a: i64): i64 a end)", "(program (call f x (lambda (params (param a i64)) (ret i64) a)))" },
    -- ...and the paired negative: a parenthesised expression must NOT become a
    -- lambda. `(a + b)` has neither a parameter annotation nor a `:` after the
    -- closing paren, which is exactly what is_lambda_head tests.
    { "x = (a + b) * c", "(program (assign x (* (+ a b) c)))" },
    -- A binding carrying its shape. `:` is IS, `=` is HOLDS. Speculative,
    -- because `obj:m(1, 2)` above starts identically — only the `=` separates
    -- them, so both must be in the corpus.
    { "n: i64 = 5", "(program (bind n (type i64) 5))" },
    -- LAW-STRATA: a type name is an ordinary value, so specialization is just a
    -- call whose argument happens to be a type.
    { "x = store(i32)(v)", "(program (assign x (call (call store i32) v)))" },
    -- Bitwise levels. The mixed case is the one that matters: four precedence
    -- levels (| < ~ < & < shift) rather than one, because a single level would
    -- associate `a | b & c` correctly only by luck of token order, and Ward's
    -- decoders are nothing but mixed masks and shifts.
    { "v = a | ((b & 0x7f) << s)", "(program (assign v (| a (<< (& b 0x7f) s))))" },
    { "v = a ~ b ~ c", "(program (assign v (~ (~ a b) c)))" },
    { "if b & 1 != 0 x end", "(program (if (!= (& b 1) 0) x))" },
    -- Correlated packs are the error idiom, so a single-value return would
    -- reject most failure paths in the stdlib.
    { "f(): i64 return nil, \"bad\" end", "(program (fun f (params) (ret i64) (return nil \"bad\")))" },
    -- A leading `.` is a lens on the ambient subject.
    { "x = map(.name)", "(program (assign x (call map (lens name))))" },
    -- Computed keys in a table constructor.
    { "t = { [0] = \"a\", [1] = \"b\" }", "(program (assign t (desc (key 0 \"a\") (key 1 \"b\"))))" },
    -- Prefix `~` is bitwise NOT and shares its token with infix XOR; position
    -- decides, so both spellings are pinned together.
    { "f = (b & c) | ((~b) & d)", "(program (assign f (| (& b c) (& (bnot b) d))))" },
    { "x = ~a", "(program (assign x (bnot a)))" },
    -- `@` directives appear in expression position, not just as statements.
    { "f(): i64 return @as(i64, 1) end", "(program (fun f (params) (ret i64) (return (at as i64 1))))" },
    -- The compact value form: single-expression body, no `end`. Neither `()`
    -- nor `(a, b)` is a legal parenthesised expression, which is what makes
    -- recognising them unambiguous — and `(a + b)` below is the paired negative
    -- that keeps arithmetic out of the lambda path.
    { "cmp = ((a, b) a < b)", "(program (assign cmp (lambda (params (param a) (param b)) (< a b))))" },
    { "spawn(() f(1))", "(program (call spawn (lambda (params) (call f 1))))" },
    -- `;` separates statements inside a one-line if body.
    { "if n < 0 neg = true; n = -n end", "(program (if (< n 0) (assign neg true) (assign n (- n))))" },
    -- Descriptor declarations — the primary data form, and the parser had no
    -- production for it. `:` is IS, so a brace on the right is a descriptor,
    -- not a typed binding; `@{` is the staged spelling of the same thing.
    -- These sit beside `n: i64 = 5` and `obj:m(1, 2)` above, which start with
    -- the identical two tokens.
    { "span: { start: u32, stop: u32 }", "(program (descriptor span (desc start u32 stop u32)))" },
    { "ByteCursor: @{ data: str, pos: i64 }", "(program (descriptor ByteCursor (desc data str pos i64)))" },
    -- A directive ends with its LINE. The existing `@fence` / `@comp.c.export`
    -- cases above are single lines with nothing after them, so they passed while
    -- the loop happily ate the next line: a directive followed by the
    -- declaration it annotates parsed as one directive and swallowed the whole
    -- function. This case is the one that can tell.
    { "@comp.c.export(\"x\")\nsub(s: str): str\n    s\nend\n", "(program (at comp c export \"x\") (fun sub (params (param s str)) (ret str) s))" },
    -- `(): void` has empty parens, so the BARE lambda test matches it too. The
    -- annotated path has to win, or the return type is never read and the body
    -- is taken as a single expression. Pinned beside the bare form above, which
    -- must keep working.
    { "closure = (): void\n    f()\nend\n", "(program (assign closure (lambda (params) (ret void) (call f))))" },
    -- One-token statements. These are the shape the no-progress guard got wrong:
    -- `peek` advances `pos` and consuming the peeked token clears `has_peeked`
    -- without moving `pos` again, so a pos-only stall check rejected every
    -- `break` in the corpus. The existing `while a break end` case passed
    -- because it predates the guard.
    { "break", "(program (break))" },
    { "break; x = 1", "(program (break) (assign x 1))" },
    -- The bare value form has two body shapes and LAYOUT picks between them,
    -- which is the canon's own rule: a one-liner is a single expression and
    -- closes at the newline; a body starting on the next line is a block and
    -- closes with `end`. Both spellings pinned, since the one-liner above would
    -- pass against a parser that only knew the block form.
    { "co = create(()\n    fn(1)\nend)\n", "(program (assign co (call create (lambda (params) (call fn 1)))))" },
    { "each(xs, (a, b)\n    g(a)\nend)\n", "(program (call each xs (lambda (params (param a) (param b)) (call g a))))" },
    -- `do` is optional in .duo and mandatory in .lua, and the lexer feeds both.
    -- proj_for tolerated it from the start; proj_while did not, so one `do`
    -- swallowed the loop's `end` and left the enclosing function unterminated to
    -- end of file — which is why so many blockers reported at EOF with nothing
    -- wrong at the reported line.
    { "while a do x = 1 end", "(program (while a (assign x 1)))" },
    -- An ANNOTATED lambda can be a one-liner too, with or without a trailing
    -- `end`. All three shapes are pinned because each passes against a parser
    -- that gets one of the others wrong.
    { "fh.close = (self: any) nil", "(program (assign (dot fh close) (lambda (params (param self any)) nil)))" },
    -- A one-line lambda's trailing `end` is taken only when it is on the SAME
    -- line. Here the `end` belongs to the enclosing `if`, and eating it closed
    -- the wrong block.
    { "f(): any\n    if a\n        less = (a: any, b: any) a < b\n    end\n    less\nend\n", "(program (fun f (params) (ret any) (if a (assign less (lambda (params (param a any) (param b any)) (< a b)))) less))" },
    -- Bodiless declarations: an FFI binding has no body and no `end`. Layout is
    -- the signal — a body is indented, so a later line at column 1 is the next
    -- top-level construct. Four modules failed entirely without this.
    { "@ffi(\"X\")\nf(a: any): any\n\n@ffi(\"Y\")\ng(): any\n", "(program (at ffi \"X\") (fun f (params (param a any)) (ret any)) (at ffi \"Y\") (fun g (params) (ret any)))" },
}

fails = { "x =", "end", "x = +", "fun f(", "return +", "{ nope } = 1",
    "for = 1, n end", "for i = 1 end", "for k, in t end",
    "a, b", "repeat x = 1", "obj:m", "x = t[i", "local = 1",
    "f = fun a end", "x = { 1,", "do x = 1" }

main(): i64
    for i = 1, #positives
        c = positives[i]
        got = std.compiler.parser.proj_program(c[1], "corpus.duo")
        if got != c[2]
            return i
        end
    end
    for i = 1, #fails
        st = std.compiler.parser.parse_status(fails[i], "corpus.duo")
        if st == 0
            return 100 + i
        end
    end
    if std.compiler.parser.parse_status("fun ok(a: i64) a end", "corpus.duo") != 0
        return 200
    end
    0
end
