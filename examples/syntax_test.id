# Syntax highlighting test for Duo
#
# Note: Duo has no `struct` or `class` keyword. Typed records are declared
# via inline type-literal annotations on bindings:
#   p: { x: f64, y: f64 } = { x = 1.0, y = 2.0 }
# OO-style objects are just table literals with method fields. Concept
# satisfaction is declared via `@implements(...)` on the binding.

greet: str = (name: str)
    "Hello, " .. name

add<T>(a: T, b: T): T
    a + b

result: i64 = ##1 + 2
global counter: i64 = 0

calculate = ()
    x: i64 = 10
    y: i64 = 20

    if x > y
        print("x is greater")
    else
        print("y is greater")

    while x < 100
        x += 1

    for i = 1, 10
        print(i)

print(greet("World"))
print(add(5, 3))