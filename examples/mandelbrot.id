# Mandelbrot set renderer — fully typed, compiles to pure C at -O3.
# Run: duo run examples/mandelbrot.id

const WIDTH: i64 = 80
const HEIGHT: i64 = 40
const MAX_ITER: i64 = 100

mandel: i64 = (cx: f64, cy: f64)
  x: f64 = 0.0
  y: f64 = 0.0
  i: i64 = 0
  while i < MAX_ITER
    x2: f64 = x * x
    y2: f64 = y * y
    if x2 + y2 > 4.0
      return i
    y = 2.0 * x * y + cy
    x = x2 - y2 + cx
    i = i + 1
  MAX_ITER

render = ()
  row: i64 = 0
  while row < HEIGHT
    col: i64 = 0
    while col < WIDTH
      cx: f64 = (col - WIDTH / 2) * 3.5 / WIDTH
      cy: f64 = (row - HEIGHT / 2) * 2.0 / HEIGHT
      m: i64 = mandel(cx, cy)
      if m == MAX_ITER
        print(" ")
      else
        print(".")
      col = col + 1
    print("\n")
    row = row + 1

render()
