-- Pass 12 M1 — differential validation for Duo-native keyword classifier.
-- Canonical source: src/token_semantic.zig
-- Generated classifier: lib/std/token/classify.duo (duo token-tables emit)
NEG = { "foo", "bar", "identifier", "notkw", "Function", "asyncio", "matchx" }

main(): i64
    i = 1
    while i <= std.token.classify.KEYWORD_COUNT
        w = std.token.classify.SORTED_TEXT[i]
        id = std.token.classify.SORTED_ID[i]
        if std.token.classify.classify(w) != id return 100 + i end
        if std.token.classify.classify_branch_chain(w) != id return 200 + i end
        if std.token.classify.classify_sorted_lookup(w) != id return 300 + i end
        if std.token.classify.classify_length_bucket(w) != id return 400 + i end
        if std.token.classify.category_of(id) != std.token.classify.SORTED_CATEGORY[i] return 500 + i end
        if std.token.classify.spelling_of(id) != w return 600 + i end
        i = i + 1
    end

    for w in NEG
        if std.token.classify.classify(w) != 0 return 700 end
        if std.token.classify.classify_branch_chain(w) != 0 return 701 end
        if std.token.classify.classify_sorted_lookup(w) != 0 return 702 end
        if std.token.classify.classify_length_bucket(w) != 0 return 703 end
        b = std.token.classify.classify_branch_chain(w)
        if std.token.classify.classify_sorted_lookup(w) != b return 704 end
        if std.token.classify.classify_length_bucket(w) != b return 705 end
    end

    0
end
