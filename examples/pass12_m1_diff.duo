-- Pass 12 M1 — differential validation for Duo-native keyword classifier.
-- Canonical source: src/token_semantic.zig
-- Generated classifier: lib/std/token/classify.duo (duo token-tables emit)
C = req "std.token.classify"

NEG = { "foo", "bar", "identifier", "notkw", "Function", "asyncio", "matchx" }

main(): i64
    i = 1
    while i <= C.KEYWORD_COUNT
        w = C.SORTED_TEXT[i]
        id = C.SORTED_ID[i]
        if C.classify(w) != id return 100 + i end
        if C.classify_branch_chain(w) != id return 200 + i end
        if C.classify_sorted_lookup(w) != id return 300 + i end
        if C.classify_length_bucket(w) != id return 400 + i end
        if C.category_of(id) != C.SORTED_CATEGORY[i] return 500 + i end
        if C.spelling_of(id) != w return 600 + i end
        i = i + 1
    end

    for w in NEG
        if C.classify(w) != 0 return 700 end
        if C.classify_branch_chain(w) != 0 return 701 end
        if C.classify_sorted_lookup(w) != 0 return 702 end
        if C.classify_length_bucket(w) != 0 return 703 end
        b = C.classify_branch_chain(w)
        if C.classify_sorted_lookup(w) != b return 704 end
        if C.classify_length_bucket(w) != b return 705 end
    end

    0
end
