-- @meta.pipeline table descriptor → fused reduce loop
-- Run: duo run examples/pipeline_table_showcase.duo
--
-- @meta.pipeline emits forward declarations for map/filter/reduce helpers,
-- so helper definitions may follow the fused loop.

@meta.pipeline({
    fn = "sum_mapped",
    elem = "int64_t",
    kind = "reduce",
    init = "0",
    map = "map_double",
    filter = "keep_positive",
    reduce = "acc_add",
})

@c.emit([[
static inline int64_t map_double(int64_t x) { return x * 2; }
static inline int keep_positive(int64_t x) { return x > 0; }
static inline int64_t acc_add(int64_t a, int64_t b) { return a + b; }
static const int64_t pipeline_data[] = { 1, 2, 3, 4, 5 };
]])

fun total(): i64
    @c.call("sum_mapped", @(pipeline_data), @(5))
end

print("=== @meta.pipeline table showcase ===")
print("sum_mapped(1..5, map*2, >0) = " .. tostring(total()))
