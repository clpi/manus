
concept HasXY
  x: f64
  y: f64

pair: { x: f64, y: f64 }
vector: { x: f64, y: f64, z: f64 }
point: { x: f64, y: f64 }

power_sig: str = subset
subset.name .. ";"

POWER = @comp.power("HasXY", power_sig)
print("=== @comp.power (2^3 - 1 = 7 subsets) ===")
print(POWER)


perm_sig: str = ordered
ordered.name .. ";"

PERMUTE = @comp.permute("HasXY", perm_sig)
print("=== @comp.permute (3! = 6 orderings) ===")
print(PERMUTE)

count_semicolons: i64 = (s: str)
  n = 0
  for i = 1, s:len()
    if s:sub(i, i) == ";"
      n = n + 1
  n

POWER_COUNT = count_semicolons(POWER)
PERMUTE_COUNT = count_semicolons(PERMUTE)
print("power fragments   = " .. POWER_COUNT .. "  (expect 7 = 2^3-1)")
print("permute fragments  = " .. PERMUTE_COUNT .. "  (expect 6 = 3!)")


@comp.define.derive("SubsetStub", generate: str = (meta)
    "/* subset " .. meta.name .. " mask=" .. to(str)(meta.mask) .. " count=" .. to(str)(meta.count) .. " */\n"
)

SUBSET_CODE = @comp.derive.power("HasXY", SubsetStub)
print("=== @comp.derive.power (7 derive fragments) ===")
print(SUBSET_CODE)

ok = POWER_COUNT == 7 and PERMUTE_COUNT == 6
print("=== RESULT ===")
print("power_and_permute_ok = " .. to(str)(ok))
