# @corpus history
# Concept introspection: query required members at compile time

concept Hashable
    hash(self): i64
end

M = {}
M:hash(): i64
    42
end

members = @comp.concepts.methods("Hashable")
print("@comp.concepts.methods('Hashable') entries: " .. to(str)(members:len()))
print("@methods(M) entries: " .. to(str)(#@methods(M)))
print("@satisfies(M, Hashable): " .. to(str)(@satisfies(M, "Hashable")))
