print("--- Testing SIMD ---")

v1: v4f64 = simd.v4f64(1.0, 2.0, 3.0, 4.0)
v2: v4f64 = simd.v4f64(10.0, 20.0, 30.0, 40.0)

v3: v4f64 = v1 + v2
print("v3[0]:", v3(0))
print("v3[1]:", v3(1))
print("v3[2]:", v3(2))
print("v3[3]:", v3(3))

assert(v3(0) == 11.0, "v3[0] mismatch")
assert(v3(3) == 44.0, "v3[3] mismatch")

v4: v4f64 = simd.sqrt(v3)
print("sqrt(v3)[3]:", v4(3))

mask: v4i64 = simd.le(v3, simd.v4f64(20.0, 20.0, 20.0, 50.0))
picked: v4f64 = simd.select(mask, v3, simd.v4f64(0.0, 0.0, 0.0, 0.0))
assert(picked(0) == 11.0, "select lane 0")
assert(picked(1) == 0.0, "select lane 1 masked out")
assert(picked(2) == 0.0, "select lane 2 masked out")
assert(picked(3) == 44.0, "select lane 3")

vi: v4i64 = simd.v4i64(1, 2, 3, 4)
assert(simd.sum(vi) == 10, "simd.sum")
assert(simd.any(mask) == true, "simd.any true")

dead: v4i64 = simd.v4i64(0, 0, 0, 0)
assert(simd.any(dead) == false, "simd.any false")

print("\nSIMD verification successful!")
