# Comptime @comp.pipeline + module @comp.pipeline fusion
# Run: duo run examples/comptime_pipeline_showcase.id

@comp.pipeline({
    fn = "sum_n",
    source = "range",
    start = 1,
    stop = 11,
    elem = "int64_t",
    kind = "reduce",
    init = "0",
})

# @comp.pipeline(...) in @(expr) returns fused C source as a comptime string
FUSED_CHARS = @(@(@comp.pipeline("{ fn = \"probe\", source = \"range\", start = 0, stop = 3, elem = \"int64_t\", kind = \"reduce\", init = \"0\" }")):len())

total(): i64
    @c.call("sum_n")
end

print("=== comptime @comp.pipeline showcase ===")
print("sum 1..10 = " .. to(str)(total()))
print("comptime pipeline codegen size = " .. to(str)(FUSED_CHARS) .. " chars")
