
io.stdout:setvbuf("no")

x: i64 = 42
s: str = "hello"
print("[type] x=" .. @comp.type.name(x) .. "  s=" .. @comp.type.name(s))
print("[is]   x is i64=" .. to(str)(@comp.type.is(x, "i64")) .. "  x is str=" .. to(str)(@comp.type.is(x, "str")))
print("[id]   distinct=" .. to(str)(@comp.type.id(x) != @comp.type.id(s)))

@comp.assert(@comp.type.is(x, "i64"), "x must be i64")

SUM = @(@comp.for(0, 5, "%i"))
print("[for]  sum 0..4 = " .. to(str)(SUM) .. "  (expect 10)")
COUNT = @(@comp.for(0, 4, "1"))
print("[for]  count   = " .. to(str)(COUNT) .. "  (expect 4)")

@comp.compile.log("showcase built with canonical @comp.* directives")

print("RESULT comp_canonical_ok = true")
