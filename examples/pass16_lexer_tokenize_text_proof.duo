-- Pass 16 MP4-B02 — `duo_lexer_tokenize_text` carries per-token TEXT, and pins
-- the one place that text does NOT match src/lexer.zig.
--
-- `duo_lexer_tokenize_all` is enough to fingerprint a stream but not to drive a
-- parser: the host needs each token's text. Check 6 is the important one — it
-- shows the Duo lexer hands back the RAW source span for an escaped string
-- while src/lexer.zig decodes it, a divergence no kind-only fingerprint can
-- see.
--
-- The text arena belongs to the HOST (a second address argument), so the
-- no-writable-__DATA constraint in lexer.duo's header still holds: nothing is
-- allocated Duo-side beyond what std.str already does.
--
-- The kind stream is differenced against `duo_lexer_kind_fingerprint`, the same
-- oracle `pass16_lexer_fingerprint_differential` proves equal to src/lexer.zig.
-- Checking the text against itself would prove nothing about equivalence.
--
-- Called through a `req` binding, not the dotted `std.compiler.lexer` path: the
-- dotted form round-trips str arguments through `lua_to_str` and diverges on
-- exactly the escape-carrying inputs this proof depends on.
--
-- Exit code is the failing check number; 0 means text marshalling behaves as
-- pinned here — which for escaped strings means DIVERGING from the host.

L = req "std.compiler.lexer"

-- Fold the kinds written by the text-carrying entry (stride 6).
fold_text(src: str): u64
    b = mem.alloc(4096 * 8)
    t = mem.alloc(8192)
    mem.zero(b, 4096 * 8)
    mem.zero(t, 8192)
    n: i64 = L.duo_lexer_tokenize_text(src, "c.duo", mem.addr(b), 500, mem.addr(t), 8000)
    h: u64 = 0
    i: i64 = 0
    while i < n
        h = h * 31 + mem.read_i64(b, (i * 6) * 8)
        i += 1
    end
    h
end

-- The kind stream must still match the host oracle with text carried alongside.
kinds_agree(): i64
    if fold_text("") != L.duo_lexer_kind_fingerprint("", "c.duo") return 1 end
    if fold_text("abc + 42") != L.duo_lexer_kind_fingerprint("abc + 42", "c.duo") return 2 end
    if fold_text("fun add(a: i64): i64 = a + 1 end") != L.duo_lexer_kind_fingerprint("fun add(a: i64): i64 = a + 1 end", "c.duo") return 3 end
    if fold_text("-- line\nfun") != L.duo_lexer_kind_fingerprint("-- line\nfun", "c.duo") return 4 end
    0
end

-- An identifier's text arrives byte-for-byte in the host arena.
identifier_text(): i64
    b = mem.alloc(4096 * 8)
    t = mem.alloc(8192)
    mem.zero(b, 4096 * 8)
    mem.zero(t, 8192)
    n: i64 = L.duo_lexer_tokenize_text("abc + 42", "c.duo", mem.addr(b), 500, mem.addr(t), 8000)
    if n != 4 return 5 end
    if mem.read_i64(b, (0 * 6 + 5) * 8) != 3 return 5 end
    if mem.read_byte(t, 0) != 97 return 5 end
    if mem.read_byte(t, 1) != 98 return 5 end
    if mem.read_byte(t, 2) != 99 return 5 end
    -- int_val still carried
    if mem.read_i64(b, (2 * 6 + 3) * 8) != 42 return 5 end
    0
end

-- THE LOAD-BEARING CHECK, and it records a DIVERGENCE rather than agreement.
--
-- Source `"a\nb"` is six bytes. The Duo lexer returns the RAW four-byte span
-- a, backslash, n, b: `read_str` advances past escapes to validate them but
-- returns `strm.sub` of the source. `src/lexer.zig` instead runs
-- `decode_lua_short_string`, yielding the THREE decoded bytes a, LF, b (it has
-- tests for \n, \x41 and \u{0041}).
--
-- So the two lexers agree on token KINDS — all `duo_lexer_kind_fingerprint`
-- hashes — and disagree on token TEXT wherever a string literal carries an
-- escape. No existing proof catches that, because text is never differenced.
-- This check pins the CURRENT Duo behaviour so the divergence is visible and
-- cannot regress silently; closing SH-03 requires making these agree.
escaped_string_is_raw_span_DIVERGES_from_zig(): i64
    b = mem.alloc(4096 * 8)
    t = mem.alloc(8192)
    mem.zero(b, 4096 * 8)
    mem.zero(t, 8192)
    n: i64 = L.duo_lexer_tokenize_text("\"a\\nb\"", "c.duo", mem.addr(b), 500, mem.addr(t), 8000)
    if n != 2 return 6 end
    -- four raw bytes, NOT three decoded ones
    if mem.read_i64(b, (0 * 6 + 5) * 8) != 4 return 6 end
    if mem.read_byte(t, 0) != 97 return 6 end
    if mem.read_byte(t, 1) != 92 return 6 end
    if mem.read_byte(t, 2) != 110 return 6 end
    if mem.read_byte(t, 3) != 98 return 6 end
    0
end

-- Both capacity guards refuse rather than overrun.
guards(): i64
    b = mem.alloc(4096 * 8)
    t = mem.alloc(8192)
    mem.zero(b, 4096 * 8)
    mem.zero(t, 8192)
    if L.duo_lexer_tokenize_text("a b c d", "c.duo", mem.addr(b), 2, mem.addr(t), 8000) != -1 return 7 end
    if L.duo_lexer_tokenize_text("abcdef ghijkl", "c.duo", mem.addr(b), 500, mem.addr(t), 4) != -1 return 8 end
    0
end

main(): i64
    r = kinds_agree()
    if r != 0 return r end
    r2 = identifier_text()
    if r2 != 0 return r2 end
    r3 = escaped_string_is_raw_span_DIVERGES_from_zig()
    if r3 != 0 return r3 end
    guards()
end
