# @corpus current
# Same test as agreement.id but the box():any re-bind is bypassed — the test
# proves compile-time hash vs runtime hash agree; the box wrapper just delays
# the literal through a no-op edge.  This is a sandbox to determine whether the
# remaining DNB bail (result-type-unsupported:box) is the only gap, or whether
# further extensions are required for the dynamic-keyed table store + :rep loop.
#
fails = 0
shortlit = "shortkey"
shortbuilt = "shortkey!":sub(1, 8)
if shortlit != shortbuilt
    print("FAIL short: literal and runtime-built are different objects")
    fails += 1
longlit = "a very long table key that is definitely more than thirty-two bytes long"
longbuilt = "a very long table key that is definitely more than thirty-two bytes long" .. "!":sub(1, 72)
if longlit != longbuilt
    print("FAIL long: literal and runtime-built are different objects")
    fails += 1
print("hash agreement (no-box): 2 checks ran")
if fails == 0
    print("hash agreement: PASS")
if fails != 0
    print("hash agreement: FAIL {fails:to(str)}")
    os.exit(1)
0
