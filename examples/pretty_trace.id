# trace — beautiful, semantically-formatted trace & debug output
#
# Design:
#   * Every event is signed with a beautiful Unicode glyph and colored
#     by severity. Bold/italic/dim/underline carry semantic meaning
#     (see LEGEND below).
#   * Spans can be opened/closed and timed.
#   * Field values are colored by Lua TYPE so a glance reveals shape:
#       string  => green       ("…")
#       number  => yellow      (123 / 1.5)
#       boolean => magenta     (true / false)
#       nil     => dim italic  (nil)
#       table   => cyan        ({…})
#       function=> italic cyan(⟪fn⟫)
#   * Source locations are underline; function names are magenta-italic;
#     timestamps are dim; slow durations are bold-yellow.
#   * Honors NO_COLOR / DUO_COLOR env vars.
#
# LEGEND of formatting semantics:
#   bold      = essential payload (msg, error text, slow span durs)
#   italic   = identity (function names, type names, nil)
#   dim      = ancillary (timestamps, caller meta, trace level)
#   underline= location references (file:line, field keys)
#   color    = severity / type class
#
# NOTE: this module is intentionally self-contained — it does not
# `req` other stdlib modules at top level. The current codegen drops
# top-level `local x = stdlib` bindings when a stdlib module is
# inlined under `duo run`; inlining ANSI codes + tty detection here
# keeps trace compilable today. When that codegen gap is fixed,
# trace.id can switch back to `local color = color` etc.

global M = {}

# ─── ANSI codes (inline copy of color) ─────────────────────────
M.RESET     = "\x1b[0m"
M.BOLD      = "\x1b[1m"
M.DIM       = "\x1b[2m"
M.ITALIC    = "\x1b[3m"
M.UNDERLINE = "\x1b[4m"
M.BLACK     = "\x1b[30m"
M.RED       = "\x1b[31m"
M.GREEN     = "\x1b[32m"
M.YELLOW    = "\x1b[33m"
M.BLUE      = "\x1b[34m"
M.MAGENTA   = "\x1b[35m"
M.CYAN      = "\x1b[36m"
M.WHITE     = "\x1b[37m"

# ─── Glyphs ────────────────────────────────────────────────────────
M.G_TRACE      = "∘"
M.G_DEBUG      = "⊙"
M.G_INFO       = "✦"
M.G_WARN       = "▲"
M.G_ERROR      = "✕"
M.G_FATAL      = "☠"
M.G_SPAN_BEGIN = "┌─"
M.G_SPAN_END   = "└─"
M.G_ARROW      = "⤳"
M.G_DUR        = "⊹"
M.G_KV_SEP     = "="
M.G_PIPE       = "│"
M.G_BULLET     = "•"

# ─── Levels ────────────────────────────────────────────────────────
M.LV_TRACE = 0
M.LV_DEBUG = 1
M.LV_INFO  = 2
M.LV_WARN  = 3
M.LV_ERROR = 4
M.LV_FATAL = 5

M.level_value = {
    trace = M.LV_TRACE, debug = M.LV_DEBUG, info = M.LV_INFO,
    warn = M.LV_WARN, error = M.LV_ERROR, fatal = M.LV_FATAL,
}
M.level_name = {
    [0] = "trace", [1] = "debug", [2] = "info",
    [3] = "warn", [4] = "error", [5] = "fatal",
}

global trace_level = M.LV_INFO
global trace_show_caller = true
global trace_show_ts = true
global trace_spans = {}

# ─── tty detection ────────────────────────────────────────────────
tty: bool = ()
    ok, val = pcall(os.getenv, "DUO_COLOR")
    if ok and val != nil and val != "" and val != "0"
        return true
    ok2, val2 = pcall(os.getenv, "NO_COLOR")
    if ok2 and val2 != nil and val2 != ""
        return false
    return true

# ─── Style wrappers ───────────────────────────────────────────────
s: str = (prefix: str, text: str, suffix: str)
    if prefix == nil prefix = "" 
    if suffix == nil suffix = M.RESET 
    if not tty()
        return to(str)(text)
    return prefix .. to(str)(text) .. suffix

bold: str = (text: str)
    return M.BOLD .. to(str)(text) .. M.RESET

dim: str = (text: str)
    return M.DIM .. to(str)(text) .. M.RESET

italic: str = (text: str)
    return M.ITALIC .. to(str)(text) .. M.RESET

underline: str = (text: str)
    return M.UNDERLINE .. to(str)(text) .. M.RESET

red: str = (text: str)
    return M.RED .. to(str)(text) .. M.RESET

green: str = (text: str)
    return M.GREEN .. to(str)(text) .. M.RESET

yellow: str = (text: str)
    return M.YELLOW .. to(str)(text) .. M.RESET

blue: str = (text: str)
    return M.BLUE .. to(str)(text) .. M.RESET

magenta: str = (text: str)
    return M.MAGENTA .. to(str)(text) .. M.RESET

cyan: str = (text: str)
    return M.CYAN .. to(str)(text) .. M.RESET

# ─── Value formatting ─────────────────────────────────────────────
tbl_summary: str = (t: any)
    if t == nil return "nil" 
    n = t:len()
    if n > 0
        return "array(" .. to(str)(n) .. ")"
    count = 0
    first = ""
    for k, _v in t
        count += 1
        if count == 1 first = to(str)(k) 
    if count == 0 return "{}" 
    if count <= 3
        return "{" .. first .. ", ...}"
    return "{" .. to(str)(count) .. " keys}"

pretty_val: str = (value: any)
    if value == nil
        return dim(italic("nil"))
    t = type(value)
    if t:find("string") == 1
        return green('"' .. to(str)(value) .. '"')
    elseif t:find("number") == 1
        return yellow(to(str)(value))
    elseif t:find("boolean") == 1
        return magenta(to(str)(value))
    elseif t:find("function") == 1
        return cyan(italic("⟪fn⟫"))
    elseif t:find("table") == 1
        n = value:len()
        if n > 0
            return cyan("⟦array " .. to(str)(n) .. "⟧")
        return cyan(italic("{" .. tbl_summary(value) .. "}"))
    return cyan(to(str)(value))

pretty_kv: str = (k: str, v: any)
    return underline(to(str)(k)) .. dim(" " .. M.G_KV_SEP .. " ") .. pretty_val(v)

# ─── Caller info ───────────────────────────────────────────────────
caller: str = (level: int)
    info = debug.getinfo(level, "Snl")
    if info == nil return "" 
    name_part = info.name
    if name_part == nil or name_part == ""
        name_part = "?"
    src = info.short_src
    if src == nil src = info.source 
    if src == nil src = "?" 
    loc = src
    if info.currentline and info.currentline > 0
        loc = src .. dim(":") .. yellow(to(str)(info.currentline))
    return magenta(italic(name_part)) .. dim(" " .. M.G_ARROW .. " ") .. underline(loc)

# ─── Timestamp ─────────────────────────────────────────────────────
ts: str = ()
    secs = os.time()
    ms = (os.clock() * 1000) % 1000:floor()
    frac = "." .. to(str)(ms)
    if ms < 10 frac = ".00" .. to(str)(ms)
    elseif ms < 100 frac = ".0" .. to(str)(ms)
    return dim(os.date("%H:%M:%S", secs) .. frac)

# ─── Level tag ─────────────────────────────────────────────────────
level_tag: str = (level: int)
    glyph = M.G_TRACE
    tag = "trace"
    if level == M.LV_DEBUG
        glyph = M.G_DEBUG
        tag = "debug"
    elseif level == M.LV_INFO
        glyph = M.G_INFO
        tag = " info"
    elseif level == M.LV_WARN
        glyph = M.G_WARN
        tag = " warn"
    elseif level == M.LV_ERROR
        glyph = M.G_ERROR
        tag = "error"
    elseif level == M.LV_FATAL
        glyph = M.G_FATAL
        tag = "fatal"
    body = glyph .. " " .. tag
    if level == M.LV_TRACE return dim(body) 
    if level == M.LV_DEBUG return blue(body) 
    if level == M.LV_INFO return green(body) 
    if level == M.LV_WARN return yellow(body) 
    if level == M.LV_ERROR return red(bold(body)) 
    if level == M.LV_FATAL return red(bold(underline(body))) 
    return body

# ─── Span indent ───────────────────────────────────────────────────
span_indent: str = ()
    n = trace_spans:len()
    if n <= 0 return "" 
    rep = M.G_PIPE .. " ":rep(n)
    if rep == nil or rep == "" return "" 
    return dim(rep)

# ─── Emit ──────────────────────────────────────────────────────────
emit = (level: int, msg: str, fields: any, skip: int)
    if level < trace_level return 
    parts = {}
    parts[parts:len() + 1] = level_tag(level)
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    if trace_show_caller
        c = caller(skip + 1)
        if c != ""
            parts[parts:len() + 1] = dim("(") .. c .. dim(")")
    parts[parts:len() + 1] = span_indent()
    if msg != nil and msg != ""
        parts[parts:len() + 1] = bold(msg)
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[parts:len() + 1] = pretty_kv(k, v)
    print(parts:concat(" "))

# ─── Public API ─────────────────────────────────────────────────
set_level = (level: any)
    if type(level) == "string"
        v = M.level_value[level:lower()]
        if v != nil
            trace_level = v
        return
    if type(level) == "number"
        if level >= M.LV_TRACE and level <= M.LV_FATAL
            trace_level = level

get_level: str = ()
    return M.level_name[trace_level] or "info"

show_caller = (on: bool)
    trace_show_caller = on and true or false

show_timestamp = (on: bool)
    trace_show_ts = on and true or false

trace = (msg: str, fields: any)
    emit(M.LV_TRACE, msg, fields, 2)

_debug = (msg: str, fields: any)
    emit(M.LV_DEBUG, msg, fields, 2)

info = (msg: str, fields: any)
    emit(M.LV_INFO, msg, fields, 2)

warn = (msg: str, fields: any)
    emit(M.LV_WARN, msg, fields, 2)

error = (msg: str, fields: any)
    emit(M.LV_ERROR, msg, fields, 2)

fatal = (msg: str, fields: any)
    emit(M.LV_FATAL, msg, fields, 2)

# ─── Spans ────────────────────────────────────────────────────────
# Format a millisecond duration as a string like "12.34ms" without
# relying on string.format (the codegen currently mishandles %f).
_fmt_ms: str = (ms: float)
    whole = ms:floor()
    frac = (ms - whole) * 100:floor()
    frac_str = to(str)(frac)
    if frac < 10 frac_str = "0" .. to(str)(frac) 
    return to(str)(whole) .. "." .. frac_str .. "ms"

span: any = (name: str, fields: any)
    h = {
        name = name or "span",
        start = os.clock(),
        depth = trace_spans:len() + 1,
    }
    trace_spans[trace_spans:len() + 1] = h
    ind = dim(M.G_PIPE .. " ":rep(h.depth - 1))
    parts = {}
    parts[parts:len() + 1] = magenta(M.G_SPAN_BEGIN)
    parts[parts:len() + 1] = bold(italic(name or "span"))
    parts[parts:len() + 1] = dim(M.G_ARROW)
    if trace_show_ts
        parts[parts:len() + 1] = dim("[") .. ts() .. dim("]")
    if trace_show_caller
        c = caller(2)
        if c != ""
            parts[parts:len() + 1] = dim("(") .. c .. dim(")")
    parts[parts:len() + 1] = ind
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[parts:len() + 1] = pretty_kv(k, v)
    print(parts:concat(" "))
    return h

span_end = (h: any, fields: any)
    if h == nil return 
    n = trace_spans:len()
    while n > 0
        if trace_spans[n] == h
            trace_spans:remove(n)
            break
        n -= 1
    dur_s = os.clock() - h.start
    dur_ms = dur_s * 1000
    dur_str
    if dur_ms >= 16
        dur_str = bold(yellow(_fmt_ms(dur_ms)))
    else
        dur_str = dim(_fmt_ms(dur_ms))
    ind = dim(M.G_PIPE .. " ":rep((h.depth - 1)))
    parts = {}
    parts[parts:len() + 1] = magenta(M.G_SPAN_END)
    parts[parts:len() + 1] = italic(h.name)
    parts[parts:len() + 1] = dim(M.G_DUR)
    parts[parts:len() + 1] = dur_str
    parts[parts:len() + 1] = ind
    if fields != nil and type(fields) == "table"
        for k, v in fields
            parts[parts:len() + 1] = pretty_kv(k, v)
    print(parts:concat(" "))

# ─── Banner / divider / legend ────────────────────────────────────
banner = (title: str, subtitle: str)
    if title == nil title = "trace" 
    if tty()
        print(cyan("╭─── " .. title .. " ") .. dim("─") .. dim("─":rep(40)))
        if subtitle != nil and subtitle != ""
            print(dim("│  " .. subtitle))
    else
        print("=== " .. title .. " ===")
        if subtitle != nil and subtitle != ""
            print("    " .. subtitle)

divider = ()
    print(span_indent() .. dim("─":rep(60)))

legend = ()
    print(bold(italic("trace legend:")))
    print("  " .. level_tag(M.LV_TRACE) .. "  " .. dim("fine-grained, usually off"))
    print("  " .. level_tag(M.LV_DEBUG) .. "  " .. dim("development detail"))
    print("  " .. level_tag(M.LV_INFO)  .. "  " .. dim("general progress"))
    print("  " .. level_tag(M.LV_WARN)  .. "  " .. dim("something suspicious"))
    print("  " .. level_tag(M.LV_ERROR) .. "  " .. dim("failure, recoverable"))
    print("  " .. level_tag(M.LV_FATAL) .. "  " .. dim("unrecoverable"))
    print("")
    print("  " .. bold("bold") .. " = essential payload    " ..
          italic("italic") .. " = identity / type    " ..
          dim("dim") .. " = ancillary meta")
    print("  " .. underline("underline") .. " = location / field key    " ..
          "color = severity + Lua type class")
    print("  " .. magenta(M.G_SPAN_BEGIN) .. "/" .. magenta(M.G_SPAN_END) ..
          " = span begin/end    " .. dim(M.G_DUR) .. " = measured duration")

# ─── Recursive pretty printer for dump() ───────────────────────────
_seen: bool = (seen: any, value: any)
    if seen == nil return false 
    i = 1
    n = seen:len()
    while i <= n
        if seen[i] == value return true 
        i += 1
    return false

_seen_add = (seen: any, value: any)
    seen[seen:len() + 1] = value

pretty_repr: str = (value: any, depth: int, seen: any)
    if depth == nil depth = 0 
    if seen == nil seen = {} 
    if value == nil return "nil" 
    t = type(value)
    if t:find("string") == 1
        return '"' .. to(str)(value) .. '"'
    elseif t:find("number") == 1
        return to(str)(value)
    elseif t:find("boolean") == 1
        return to(str)(value)
    elseif t:find("function") == 1
        return "<function>"
    elseif t:find("table") != 1
        return to(str)(value)
    # table branch — use table identity (== by reference) stored in a
    # flat array, because the codegen's to(str)(table) always returns
    # the bare type name "table" regardless of which table.
    if _seen(seen, value) return "<circular>" 
    _seen_add(seen, value)
    n = value:len()
    parts = {}
    if n > 0
        i = 1
        while i <= n
            parts[parts:len() + 1] = "  ":rep(depth + 1) ..
                pretty_repr(value[i], depth + 1, seen)
            i += 1
        if parts:len() <= 3
            return "[" .. parts:concat(", ") .. "]"
        return "[\n" .. parts:concat(",\n") .. "\n" ..
            "  ":rep(depth) .. "]"
    for k, v in value
        parts[parts:len() + 1] = "  ":rep(depth + 1) ..
            to(str)(k) .. " = " .. pretty_repr(v, depth + 1, seen)
    if parts:len() == 0 return "{}" 
    return "{\n" .. parts:concat("\n") .. "\n" ..
        "  ":rep(depth) .. "}"

dump = (label: str, value: any)
    if label == nil label = "dump" 
    ind = span_indent()
    header = ind .. cyan(M.G_BULLET) .. " " .. bold(label) ..
        dim(" ⟜ ") .. pretty_val(value)
    print(header)
    if value != nil and type(value) == "table"
        rendered = pretty_repr(value, 1, nil)
        # split on newlines manually; the codegen mishandles gmatch
        i = 1
        n = rendered:len()
        line_start = 1
        while i <= n
            ch = rendered:sub(i, i)
            if ch == "\n"
                seg = rendered:sub(line_start, i - 1)
                if seg != ""
                    print(dim(M.G_PIPE .. " ") .. cyan(seg))
                line_start = i + 1
            i += 1
        if line_start <= n
            print(dim(M.G_PIPE .. " ") .. cyan(rendered:sub(line_start)))

# ─── Exports ──────────────────────────────────────────────────────
M.set_level = set_level
M.get_level = get_level
M.show_caller = show_caller
M.show_timestamp = show_timestamp
M.trace = trace
M.debug = _debug
M.info = info
M.warn = warn
M.error = error
M.fatal = fatal
M.span = span
M.span_end = span_end
M.banner = banner
M.divider = divider
M.legend = legend
M.dump = dump
M.LV_TRACE = M.LV_TRACE
M.LV_DEBUG = M.LV_DEBUG
M.LV_INFO  = M.LV_INFO
M.LV_WARN  = M.LV_WARN
M.LV_ERROR = M.LV_ERROR
M.LV_FATAL = M.LV_FATAL

M
# ─── DEMO ─────────────────────────────────────────────────────────────
# Beautiful, semantically-formatted trace & debug.
# Run with:  DUO_COLOR=1 ./zig-out/bin/duo run examples/pretty_trace.id
# Set NO_COLOR=1 to disable ANSI.

T = M

T.set_level("trace")
T.banner("trace demo", "colored + iconed + semantic formatting")
print(" ")
T.legend()
print(" ")

T.info("booting runtime", {pid = 1234, mode = "release", threads = 8})
T.debug("config loaded", {path = "/etc/duo/config.id", bytes = 2048})
T.warn("buffer near limit", {used = 0.92, capacity = 4096})

T.divider()

h1 = T.span("compile_module", {module = "std.math.fft", size = 8192})
h2 = T.span("parse", {tokens = 4096})
for _x = 1, 2000 _x
T.span_end(h2)

h3 = T.span("type_check", {fns = 24, errors = 0})
for _y = 1, 5000 _y
T.span_end(h3, {note = "cleared all predicates"})
T.span_end(h1, {emitted_bytes = 16384})

T.divider()

sample_tbl = {
    name = "my_callback",
    count = 42,
    enabled = true,
    children = {1, 2, 3, "four"},
    callback = () nil,
}
T.dump("sample_tbl", sample_tbl)
T.dump("plain_string", "hello, world")
T.dump("integer", 1337)
T.dump("truth", false)
T.dump("nothing", nil)

T.divider()

T.trace("very fine, opt-in only", {where = "hot loop", iter = 7})
T.debug("developer detail here")
T.info("general progress update")
T.warn("something looked off")
T.error("something failed, but recoverable", {file = "src/io.id", line = 217})
T.fatal("unrecoverable — will exit", {reason = "kernel panic", code = 0xC0DE})

T.divider()

print(" ")
print(span_indent() .. "pure-pretty stack trace below:")
i = 2
while i < 12
    frame = debug.getinfo(i, "Snl")
    if frame == nil break 
    fname = "?"
    if frame.name != nil fname = to(str)(frame.name) 
    src = "?"
    if frame.short_src != nil src = to(str)(frame.short_src) 
    line = src
    if frame.currentline != nil and tonumber(frame.currentline) > 0
        line = src .. ":" .. to(str)(frame.currentline)
    print("  " .. magenta(italic(fname .. "()")) .. "  " .. underline(line))
    i += 1
