-- SH-09 — the transformation registry, proven on fixtures and at corpus scale.
--
-- THREE PROPERTIES, and the third is the one that matters most here.
--
--   VALUE      a folded site equals what the HOST computes for the same
--              expression — `check("2 + 3 * 4", 2 + 3 * 4)`, so a fixture
--              cannot encode my arithmetic
--   IDEMPOTENT applying the transformation twice equals applying it once
--   SAFE       applying it to all of lib/std leaves every file still PARSING
--
-- SAFE is the interesting one. A source-to-source rewrite that edits text it
-- does not understand corrupts data, and this session produced that bug twice
-- from the same blind spot: an FF-2 regex rewrote `->` inside C code held in a
-- Duo string, and the canonicalizer's `rstrip` would have deleted meaningful
-- trailing spaces inside `[[ ... ]]`. Both times the corpus was silent and only
-- a control caught it. So the registry's rewrite is run over 249 real modules
-- and the parser — at 249/249 — is asked whether the output is still Duo.
--
-- Exit: 0 pass, 1..N failing fixture, 100 a corpus file stopped parsing,
-- 101 a corpus file was not idempotent.

global strm = req "std.str"
global R = req "std.compiler.rewrite"
global P = req "std.compiler.parser"

_expect = (n: i64, src: str, want: str): i64
    got = R.apply("fold_constants", src)
    if got != want
        print("rewrite_proof: FAIL " .. to(str)(n) .. ": [" .. src .. "] -> ["
            .. got .. "], expected [" .. want .. "]")
        return n
    end
    0
end

fixtures = (): i64
    r: i64 = 0
    -- VALUE: the right side is built from the host's own arithmetic
    r = _expect(1, "x = 2 + 3 * 4", "x = " .. to(str)(2 + 3 * 4))
    if r != 0 return r end
    r = _expect(2, "x = (2 + 3) * 4", "x = " .. to(str)((2 + 3) * 4))
    if r != 0 return r end
    r = _expect(3, "x = 1 << 10", "x = " .. to(str)(1 << 10))
    if r != 0 return r end

    -- a site with a name in it is NOT closed and must be left alone
    r = _expect(4, "x = a + b", "x = a + b")
    if r != 0 return r end

    -- SAFETY of the site boundary: a digit inside an identifier is not the
    -- start of an expression, and a trailing name is not part of one
    r = _expect(5, "x2 = 1 + 1", "x2 = " .. to(str)(1 + 1))
    if r != 0 return r end
    r = _expect(6, "t.x1 = 2 + 2", "t.x1 = " .. to(str)(2 + 2))
    if r != 0 return r end

    -- floats are outside the integer folder and must be untouched
    r = _expect(7, "x = 1.5 + 1", "x = 1.5 + 1")
    if r != 0 return r end

    -- the registry is browsable, which is the point of it being a registry
    if R.describe("fold_constants") == ""
        print("rewrite_proof: FAIL 8: registered transformation has no description")
        return 8
    end
    if R.describe("no_such_transform") != ""
        print("rewrite_proof: FAIL 9: unregistered name described")
        return 9
    end
    0
end

main(): i64
    bad: i64 = fixtures()
    if bad != 0
        return bad
    end

    listing = std.script.capture("find " .. std.script.getenv("DUO_ROOT", ".")
        .. "/lib/std -name '*.duo' 2>/dev/null | grep -v '/os/linux.duo'")
    n: i64 = #listing
    files: i64 = 0
    changed: i64 = 0
    start: i64 = 1
    i: i64 = 1
    while i <= n + 1
        at_end = i > n
        eol = false
        if not at_end
            eol = string.byte(listing, i) == 10
        end
        if at_end or eol
            if i > start
                path = strm.sub(listing, start, i - 1)
                fh = io.open(path, "r")
                if fh
                    src = fh:read("a")
                    fh:close()
                    files += 1
                    once = R.apply("fold_constants", src)
                    if once != src
                        changed += 1
                    end
                    -- SAFE: the rewrite must not have produced non-Duo
                    if P.parse_status(once, path) != 0
                        print("rewrite_proof: STOPPED PARSING after rewrite: " .. path)
                        return 100
                    end
                    if R.apply("fold_constants", once) != once
                        print("rewrite_proof: NOT IDEMPOTENT: " .. path)
                        return 101
                    end
                end
            end
            start = i + 1
        end
        i += 1
    end

    print("rewrite_proof: fixtures 9/9; " .. to(str)(files) .. " files rewritten, "
        .. to(str)(changed) .. " changed, all still parse, all idempotent")
    0
end
