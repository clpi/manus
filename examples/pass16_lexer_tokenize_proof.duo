-- Pass 16 MP-04 — Duo lexer embed tokenize (MP4-B01 regression).

embed_tokenize(): i64
    lex = std.compiler.lexer.new("fun", "proof.duo")
    tok = std.compiler.lexer.next(lex)
    if tok.kind != std.compiler.token.KIND_FUN return 1 end
    tok2 = std.compiler.lexer.next(lex)
    if tok2.kind != std.compiler.token.KIND_EOF return 2 end
    0
end

main(): i64
    embed_tokenize()
end
