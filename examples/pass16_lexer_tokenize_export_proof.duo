-- Pass 16 MP4-B02 — the streaming tokenize primitive.
--
-- `duo_lexer_step(src, file, pos)` packs one token as `kind * 2^40 + next_pos`,
-- so walking a source is O(n): feed `next_pos` back in. Everything a host
-- tokenizer needs (counts, kind at an index, spans) derives from this here in
-- the caller, which is also the only shape that stays linear.
--
-- Exit code is the failing check number; 0 means every check held.

-- 2^40 — the shift `duo_lexer_step` packs `kind` above `next_pos` with. Written
-- literally in each accessor: a module-level binding here does not survive
-- lowering (`duo_g_SHIFT` is referenced but never declared).
kind_of(step: i64): i64
    step // 1099511627776
end

pos_of(step: i64): i64
    step % 1099511627776
end

-- Kind of the token at `index`, walked in one pass.
kind_at(src: str, index: i64): i64
    pos = 1
    i = 0
    while true
        step = std.compiler.lexer.duo_lexer_step(src, "p.duo", pos)
        k = kind_of(step)
        if i == index return k end
        -- `return k`, not `return std.compiler.token.KIND_EOF`: a module constant lowers to a
        -- native constant in comparison position but to a dynamic table read in
        -- return position, and `k` is already EOF here.
        if k == std.compiler.token.KIND_EOF return k end
        pos = pos_of(step)
        i = i + 1
    end
    0
end

-- Tokens before EOF, walked in one pass.
count(src: str): i64
    pos = 1
    n = 0
    while true
        step = std.compiler.lexer.duo_lexer_step(src, "p.duo", pos)
        if kind_of(step) == std.compiler.token.KIND_EOF return n end
        pos = pos_of(step)
        n = n + 1
    end
    n
end

check_step(): i64
    step = std.compiler.lexer.duo_lexer_step("fun", "p.duo", 1)
    if kind_of(step) != std.compiler.token.KIND_FUN return 1 end
    -- "fun" is 3 bytes from offset 1, so the next token starts at 4.
    if pos_of(step) != 4 return 2 end
    0
end

check_kinds(): i64
    if kind_at("fun", 0) != std.compiler.token.KIND_FUN return 3 end
    if kind_at("fun", 1) != std.compiler.token.KIND_EOF return 4 end
    if kind_at("x", 0) != std.compiler.token.KIND_NAME return 5 end
    if kind_at("7", 0) != std.compiler.token.KIND_INT_LIT return 6 end
    -- Past the end collapses to EOF rather than trapping.
    if kind_at("x", 99) != std.compiler.token.KIND_EOF return 7 end
    0
end

check_counts(): i64
    if count("fun") != 1 return 8 end
    if count("") != 0 return 9 end
    if count("x = 1") != 3 return 10 end
    0
end

main(): i64
    r = check_step()
    if r != 0 return r end
    r = check_kinds()
    if r != 0 return r end
    check_counts()
end
