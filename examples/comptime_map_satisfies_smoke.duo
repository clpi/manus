-- @comp.satisfies + @comp.map on typed records (type X = { ... })
-- Run: duo run examples/comptime_map_satisfies_smoke.duo

concept HasXY
    x: f64
    y: f64
end

type Point = { x: f64, y: f64 }
type IdOnly = { id: i64 }

@comp.assert(@comp.satisfies(Point, "HasXY"), "Point has x and y")
@comp.assert(not @comp.satisfies(IdOnly, "HasXY"), "IdOnly lacks x/y")

fun mark(meta) -> str
    meta.name .. ";"
end

MARKS = @comp.map("HasXY", mark)

print("satisfies Point = " .. tostring(@comp.satisfies(Point, "HasXY")))
print("satisfies IdOnly = " .. tostring(@comp.satisfies(IdOnly, "HasXY")))
print("marks = " .. MARKS)
print("ok")
