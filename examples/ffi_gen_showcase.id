-- Auto-generate extern declarations from a C header at compile time
-- Run: duo run examples/ffi_gen_showcase.id

@c.include("string.h")
@comp.ffi("string.h")

demo_len(s: str): i64
  return @c.call("strlen", s)
end

print("=== @comp.ffi showcase ===")
print("strlen('duo') = " .. to(str)(demo_len("duo")))
