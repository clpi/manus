-- Pass 11 WP-05: module-level byte blob on direct ARM64 (no C string / NUL issues).
wasm_header = { 0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00 }

ByteCursor: @{ data: i64, pos: i64, len: i64 }

read_u8_at(base: i64, off: i64): i64
    @comp.native.load.u8(base, off)
end

main(): i64
    c = { data = wasm_header, pos = 0, len = 8 }
    b0 = read_u8_at(c.data, 0)
    b1 = read_u8_at(c.data, 1)
    b2 = read_u8_at(c.data, 2)
    b3 = read_u8_at(c.data, 3)
    if b0 != 0 return 1001 end
    if b1 != 0x61 return 1002 end
    if b2 != 0x73 return 1003 end
    if b3 != 0x6D return 1004 end
    if read_u8_at(c.data, 4) != 1 return 1005 end
    c.pos = c.pos + 1
    if c.pos != 1 return 1006 end
    0
end
