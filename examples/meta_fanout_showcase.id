
tree = @comp.fanout("root", fun(state)
  d = state.depth
  frag = state.fragment
  if d < 3
    frag .. "_L\n" .. frag .. "_R"
  else
    frag
, 3)

print("=== @comp.fanout binary tree (depth=3, 2^3=8 leaves) ===")
count = 0
for line in tree:gmatch("[^\n]+") do
  count = count + 1
print("fragment_count = " .. count .. " (expect 8 = 2^3)")
print("=== RESULT ===")
print("fanout_ok = true")