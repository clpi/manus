# expect: 5 3 13 3000 5003 3005
tail: i64 = (n: i64, acc: i64)
  if n <= 0
    acc
  tail(n - 1, acc + 1)

swap: i64 = (n: i64, a: i64, b: i64)
  if n <= 0
    a * 1000 + b
  swap(n - 1, b, a)

a = tail(0, 5)
b = tail(3, 0)
c = tail(3, 10)
d = tail(3000, 0)
e = swap(7, 3, 5)
f = swap(8, 3, 5)

print("{a} {b} {c} {d} {e} {f}")
0
