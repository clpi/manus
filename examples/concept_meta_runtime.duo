meta = req("std.meta")
concept Drawable
  draw(self) -> str
  id: i64
end
shape = {
  id = 7,
  draw = (self) -> str
    "shape-" .. to(str)(self.id)
  end
}
print(shape:draw())
DrawableConcept = meta.make_concept("Drawable", {
  fields = {
    "id"
  },
  methods = {
    "draw"
  }
})
print("satisfies Drawable: " .. to(str)(meta.satisfies_concept(shape, DrawableConcept)))
