-- Concept + runtime meta demo
-- Shows how parser-level concepts and runtime meta.satisfies_concept interact

meta = req "std.meta"

concept Drawable
    id: i64
    fun draw(self): str
end

shape = {
    id = 7,
    draw = fun(self): str
        "shape-" .. tostring(self.id)
    end,
}

-- Use : method syntax for calling
print(shape:draw())

-- Runtime concept checking works with meta.make_concept descriptors
DrawableConcept = meta.make_concept("Drawable", {
    fields = { "id" },
    methods = { "draw" },
})
print("satisfies Drawable: " .. tostring(meta.satisfies_concept(shape, DrawableConcept)))
