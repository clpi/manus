concat_obj = setmetatable({}, {
  __concat: str = (a: any, b: any)
    "concat"
})

lt_obj = setmetatable({}, {
  __lt: bool = (a: any, b: any)
    true
})

le_obj = setmetatable({}, {
  __le: bool = (a: any, b: any)
    true
})

unm_obj = setmetatable({}, {
  __unm: any = (a: any)
    "unm"
})

idiv_obj = setmetatable({}, {
  __idiv: any = (a: any, b: any)
    "idiv"
})

band_obj = setmetatable({}, {
  __band: any = (a: any, b: any)
    "band"
})

bor_obj = setmetatable({}, {
  __bor: any = (a: any, b: any)
    "bor"
})

bxor_obj = setmetatable({}, {
  __bxor: any = (a: any, b: any)
    "bxor"
})

bnot_obj = setmetatable({}, {
  __bnot: any = (a: any)
    "bnot"
})

shl_obj = setmetatable({}, {
  __shl: any = (a: any, b: any)
    "shl"
})

shr_obj = setmetatable({}, {
  __shr: any = (a: any, b: any)
    "shr"
})

print(concat_obj .. "x")
print(to(str)(lt_obj < 1))
print(to(str)(le_obj <= 1))
print(-unm_obj)
print(idiv_obj // 1)
print(band_obj & 1)
print(bor_obj | 1)
print(bxor_obj ~ 1)
print(~bnot_obj)
print(shl_obj << 1)
print(shr_obj >> 1)
