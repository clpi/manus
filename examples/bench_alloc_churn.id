
_bench_alloc_churn: i64 = (n: i64)
  collectgarbage("stop")
  t = {}
  i = 1
  while i <= n
    t[i] = i
    i = i + 1
  i = 1
  while i <= n
    t[i] = nil
    i = i + 1
  collectgarbage("restart")
  1

main: i64 = ()
  n = 10000000

  _bench_alloc_churn(1000)

  start = os.clock()
  _bench_alloc_churn(n)
  time_taken = os.clock() - start

  print("RESULT alloc_churn")
  print(time_taken)
  0
