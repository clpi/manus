typed_sub: str = (s: str)
  a: str = s:sub(1, 3)
  return a

typed_tostring: str = (n: i64)
  b: str = to(str)(n)
  return b

combined: str = (s: str, n: i64)
  a: str = s:sub(1, 3)
  b: str = to(str)(n)
  return a .. b

typed_find: i64 = (s: str)
  p: i64 = s:find("Duo", 1, true)
  return p

method_find: i64 = (s: str)
  p: i64 = s:find("o", 1, true)
  return p

print(typed_sub("abcdef"))
print(typed_tostring(42))
print(combined("abcdef", 42))
print(typed_find("Hello Duo"))
print(method_find("Duo"))
