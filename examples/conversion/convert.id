# expect: 17 -17 9007199254740993 42 2.5 true

s: str = "17"
neg: str = "-17"
wide: str = "9007199254740993"
n: i64 = 42
f: f64 = 2.5
b: bool = true
a: i64 = s:to(i64)
c: i64 = neg:to(i64)
d: i64 = wide:to(i64)
e: str = n:to(str)
g: str = f:to(str)
h: str = b:to(str)
print("{a} {c} {d} {e} {g} {h}")
