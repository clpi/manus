-- Sieve of Eratosthenes — typed duo, generates native C
-- Shows typed array usage and numeric loops at C speed.

const LIMIT: i64 = 10000

fun count_primes(limit: i64): i64
    count: i64 = 0
    n: i64 = 2
    while n <= limit
        is_prime: bool = true
        d: i64 = 2
        while d * d <= n
            if n % d == 0 then
                is_prime = false
            end
            d = d + 1
        end
        if is_prime then
            count = count + 1
        end
        n = n + 1
    end
    count
end

print(count_primes(LIMIT))
