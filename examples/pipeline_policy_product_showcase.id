-- @pipeline product: one descriptor emits types x windows x operation policies
-- Run: duo run examples/pipeline_policy_product_showcase.id

@c.emit([[
static inline int64_t double_i64(int64_t v) { return v * 2; }
static inline int keep_pos_i64(int64_t v) { return v > 0; }
static inline int64_t max_i64(int64_t a, int64_t b) { return a > b ? a : b; }
static const int64_t values[] = { -5, 2, 7, 4 };
]])

@pipeline({
    name = "fold",
    types = "i64:int64_t:0",
    takes = "all: | first3:3",
    maps = "id: | dbl:double_i64",
    filters = "all: | pos:keep_pos_i64",
    reducers = "sum: | max:max_i64",
    kind = "reduce",
})

sum_all(): i64
    @c.call("fold_i64_all_id_all_sum", @(values), @(4))
end

doubled_positive_max(): i64
    @c.call("fold_i64_all_dbl_pos_max", @(values), @(4))
end

first3_doubled_sum(): i64
    @c.call("fold_i64_first3_dbl_all_sum", @(values), @(4))
end

print("=== @pipeline policy product showcase ===")
print("sum_all = " .. to(str)(sum_all()))
print("doubled_positive_max = " .. to(str)(doubled_positive_max()))
print("first3_doubled_sum = " .. to(str)(first3_doubled_sum()))
