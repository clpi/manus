{
  "enabled": true,
  "name": "Update Docs on Source Change",
  "description": "When Zig source files, build files, or example files are edited, asks the agent to review the changes and update the README or docs to reflect any user-facing changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.zig",
      "build.zig.zon",
      "*.lua",
      "*.duo"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if it affects any user-facing behavior, CLI commands, compilation pipeline, or performance characteristics. If so, update the README.md (and any files in a docs/ folder if one exists) to keep documentation accurate and in sync with the code. Only make documentation changes when the code change is meaningful to users — ignore internal refactors or formatting-only changes."
  }
}