fib: i64 = (n: i64)
  if n <= 1
    return n
  return fib(n - 1) + fib(n - 2)

fact: i64 = (n: i64)
  if n <= 1
    return 1
  return n * fact(n - 1)

main: i64 = ()
  d = 1
  if fib(0) != 0 then d = 0 end
  if fib(1) != 1 then d = 0 end
  if fib(10) != 55 then d = 0 end
  if fib(20) != 6765 then d = 0 end
  if fib(30) != 832040 then d = 0 end
  if fact(0) != 1 then d = 0 end
  if fact(1) != 1 then d = 0 end
  if fact(5) != 120 then d = 0 end
  if fact(10) != 3628800 then d = 0 end
  if fact(20) != 2432902008176640000 then d = 0 end
  return d
end
main()
