#!/usr/bin/env duo
-- duo-mcp/duo_bench.duo — MCP server: benchmarks, build gates, perf audit, coordination.
-- Pure Duo. Run from the Duo repo root: duo run /Users/clp/x/duo-mcp/duo_bench.duo

mcp = req "std.mcp"
shared = req "duo_shared"
json_mod = req "std.json"

mcp.register_tool("duo_bench_run", {
    description = "Run a benchmark suite under build lock",
    type = "object",
    properties = {
        bench_type = { type = "string", description = "bench|ml-bench|honest-bench|cross-bench" },
        timeout = { type = "number" },
    },
    required = { "bench_type" },
}, fun(args)
    sx = req "std.script"
    if args.bench_type == nil or args.bench_type == ""
        return "no bench type"
        end
    locked = sx.lock_cmd("zig build " .. args.bench_type)
    rc = sx.run(locked)
    json_mod.encode({ exit_code = rc, passed = rc == 0, bench_type = args.bench_type })
end)

mcp.register_tool("duo_build_run", {
    description = "Run a build/test gate",
    type = "object",
    properties = {
        gate = { type = "string" },
        timeout = { type = "number" },
    },
    required = { "gate" },
}, fun(args)
    json_mod.encode(shared.build_run(args.gate, args.timeout or 600))
end)

mcp.register_tool("duo_agent_smoke", {
    description = "Run tier-0 agent-smoke gate under lock",
    type = "object",
    properties = {
        timeout = { type = "number" },
    },
}, fun(args)
    json_mod.encode(shared.agent_smoke(args.timeout or 600))
end)

mcp.register_tool("duo_coordination_read", {
    description = "Read the shared agent coordination buffer",
    type = "object",
    properties = {},
}, fun(_args)
    shared.coordination_read()
end)

mcp.register_tool("duo_coordination_update", {
    description = "Update the coordination buffer (claim/release/note)",
    type = "object",
    properties = {
        action = { type = "string" },
        agent_id = { type = "string" },
        detail = { type = "string" },
        files = { type = "string" },
    },
    required = { "action", "agent_id", "detail" },
}, fun(args)
    shared.coordination_update(args.action, args.agent_id, args.detail, args.files or "")
end)

mcp.register_tool("duo_session_log", {
    description = "Append a structured session log entry",
    type = "object",
    properties = {
        agent_id = { type = "string" },
        summary = { type = "string" },
        detail = { type = "string" },
    },
    required = { "agent_id", "summary" },
}, fun(args)
    shared.session_log(args.agent_id, args.summary, args.detail or "")
end)

mcp.register_tool("duo_repo_tooling", {
    description = "Run a Duo repo-tooling script",
    type = "object",
    properties = {
        script_name = { type = "string" },
        args = { type = "string" },
    },
    required = { "script_name" },
}, fun(args)
    json_mod.encode(shared.repo_tooling(args.script_name, args.args or ""))
end)

mcp.register_tool("duo_perf_ledger", {
    description = "Read the performance ledger summary",
    type = "object",
    properties = {},
}, fun(_args)
    shared.perf_ledger()
end)

mcp.register_tool("duo_agent_canonical_index", {
    description = "Read the canonical agent index router",
    type = "object",
    properties = {},
}, fun(_args)
    shared.canonical_index()
end)

mcp.register_tool("duo_audit_native_boxing", {
    description = "Dump C for a .duo file and flag lua_Value boxing",
    type = "object",
    properties = {
        file_path = { type = "string" },
    },
    required = { "file_path" },
}, fun(args)
    json_mod.encode(shared.audit_native_boxing(args.file_path))
end)

mcp.register_tool("duo_audit_metaprogramming_smokes", {
    description = "Batch native-boxing audit on generative showcases",
    type = "object",
    properties = {},
}, fun(_args)
    paths = {
        "examples/meta_template_showcase.duo",
        "examples/meta_generate_showcase.duo",
        "examples/meta_scheme_showcase.duo",
        "examples/meta_grammar_showcase.duo",
        "examples/meta_weave_showcase.duo",
        "examples/meta_power_permute_showcase.duo",
        "examples/meta_choose_showcase.duo",
    }
    passed = 0
    failed = 0
    results = {}
    for _, p in paths
        r = shared.audit_native_boxing(p)
        results[#results + 1] = r
        if r.pass
            passed = passed + 1 else failed = failed + 1
            end
    end
    json_mod.encode({ total = #paths, passed = passed, failed = failed, results = results })
end)

mcp.register_tool("duo_agent_gaps_read", {
    description = "Read open P0 gaps from coordination buffer",
    type = "object",
    properties = {},
}, fun(_args)
    json_mod.encode({ open_p0 = shared.open_p0_gaps() })
end)

mcp.register_tool("duo_agent_gaps_update", {
    description = "Open or log updates for the canonical cross-agent gap buffer",
    type = "object",
    properties = {
        action = { type = "string", description = "open|claim|delegate|close|note" },
        agent_id = { type = "string" },
        gap_id = { type = "string", description = "Existing gap id for non-open actions" },
        kind = { type = "string", description = "perf|native|meta|script|agent|backend|expressiveness_gap|native_lowering_gap" },
        title = { type = "string" },
        detail = { type = "string" },
        priority = { type = "string", description = "P0|P1|P2" },
        files = { type = "string" },
    },
    required = { "action", "agent_id", "detail" },
}, fun(args)
    shared.agent_gaps_update(
        args.action or "open",
        args.agent_id or "agent",
        args.gap_id or "",
        args.kind or "agent",
        args.title or "untitled gap",
        args.detail or "",
        args.priority or "P1",
        args.files or ""
    )
end)

mcp.register_tool("duo_agent_session_start", {
    description = "Session bootstrap: coordination + gaps + canonical index",
    type = "object",
    properties = {
        agent_id = { type = "string" },
    },
}, fun(args)
    coord = shared.coordination_read()
    p0 = shared.open_p0_gaps()
    canon = shared.canonical_index()
    json_mod.encode({
        agent_id = args.agent_id or "agent",
        coordination_path = shared.COORD_PATH,
        canonical_index_path = shared.CANON_PATH,
        open_p0_count = #p0,
        next_steps = {
            "duo_coordination_update(action='claim', ...) before shared edits",
            "scripts/duo_lock.sh -- ./zig-out/bin/duo run scripts/agent_smoke.duo",
        },
        coordination_excerpt = string.sub(coord, 1, 4000),
        canonical_excerpt = string.sub(canon, 1, 2000),
    })
end)

mcp.register_tool("duo_bench_regressions", {
    description = "Detect benchmark regressions: compare Duo RESULT/timing vs reference C. Pass bench_output to analyze captured stdout, else runs `zig build <bench_type>` under lock.",
    type = "object",
    properties = {
        bench_output = { type = "string", description = "Captured bench stdout (optional; if empty, runs bench)" },
        bench_type = { type = "string", description = "bench|ml-bench|honest-bench (default bench)" },
    },
}, fun(args)
    bo = args.bench_output
    if bo == nil
        bo = ""
        end
    bt = args.bench_type
    if bt == nil
        bt = "bench"
        end
    json_mod.encode(shared.bench_regressions(bo, bt))
end)

mcp.register_tool("duo_perf_gaps", {
    description = "List open performance / native-lowering / codegen gaps from the coordination buffer, plus a performance.md excerpt.",
    type = "object",
    properties = {},
}, fun(_args)
    json_mod.encode(shared.perf_gaps())
end)

mcp.register_tool("duo_file_finding", {
    description = "File a finding (bug/exponential_opportunity/ergonomic_gap/regression) to the coordination buffer",
    type = "object",
    properties = {
        kind = { type = "string", description = "bug|exponential_opportunity|ergonomic_gap|regression" },
        title = { type = "string" },
        detail = { type = "string" },
        priority = { type = "string", description = "P0|P1|P2" },
        file_path = { type = "string" },
    },
    required = { "kind", "title", "detail", "priority" },
}, fun(args)
    fs = req "std.fs"
    coord_path = shared.COORD_PATH
    ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
    fp_line = ""
    if args.file_path and args.file_path ~= ""
        fp_line = "\n  file: " .. args.file_path
    end
    entry = "\n\n### [" .. (args.priority or "P1") .. "] [" .. (args.kind or "bug") .. "] " .. (args.title or "") .. "\n- filed: " .. ts .. fp_line .. "\n- detail: " .. (args.detail or "") .. "\n"
    existing = fs.read_file(coord_path) or ""
    marker = "## Cross-Agent Gap Buffer"
    idx = string.find(existing, marker, 1, true)
    if idx
        before = string.sub(existing, 1, idx + #marker - 1)
        after = string.sub(existing, idx + #marker)
        fs.write_file(coord_path, before .. entry .. after)
    else
        fs.write_file(coord_path, existing .. "\n" .. marker .. entry)
    end
    json_mod.encode({ filed = true, kind = args.kind, title = args.title, priority = args.priority })
end)

mcp.register_tool("duo_exponential_eval", {
    description = "Exponential evaluator: input Duo source -> metaprogramming-enhanced, minimized Duo intermediary using @comp.* combinators (collapses type-polymorphic fn families into @comp.generate, equality boilerplate into @derive, dispatch chains into tables), plus a native-boxing (lua_Value) audit and LOC metrics. Returns JSON.",
    type = "object",
    properties = {
        source = { type = "string", description = "Duo source code to analyze" },
        goal = { type = "string", description = "Optional description of what the code does" },
    },
    required = { "source" },
}, fun(args)
    eval = req "duo_eval"
    res = eval.evaluate(args.source or "", args.goal or "")
    if res ~= nil and res ~= "" then return res end
    -- fallback only if the evaluator module is unavailable
    json_mod.encode({ error = "duo_eval.evaluate returned no result", fallback = true, goal = args.goal or "" })
end)

mcp.register_tool("duo_grammar_spec_read", {
    description = "Read the canonical Duo grammar spec",
    type = "object",
    properties = {},
}, fun(_args)
    fs = req "std.fs"
    fs.read_file(shared.ROOT .. "/docs/GRAMMAR_SPEC.md") or "GRAMMAR_SPEC.md not found"
end)

mcp.register_tool("duo_grammar_spec_update", {
    description = "Append a grammar rule to the canonical Duo grammar spec",
    type = "object",
    properties = {
        rule_id = { type = "string" },
        status = { type = "string", description = "preferred|accepted|deprecated|removed" },
        title = { type = "string" },
        content = { type = "string" },
    },
    required = { "rule_id", "status", "title", "content" },
}, fun(args)
    fs = req "std.fs"
    spec_path = shared.ROOT .. "/docs/GRAMMAR_SPEC.md"
    existing = fs.read_file(spec_path) or ""
    ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
    entry = "\n\n## Rule: " .. (args.rule_id or "") .. " [" .. (args.status or "accepted") .. "]\n### " .. (args.title or "") .. "\n_Updated: " .. ts .. "_\n\n" .. (args.content or "") .. "\n"
    fs.write_file(spec_path, existing .. entry)
    jm = req "std.json"
    jm.encode({ appended = true, rule_id = args.rule_id, status = args.status })
end)

mcp.register_tool("duo_directive_hierarchy_read", {
    description = "Read the @comp.* directive hierarchy documentation",
    type = "object",
    properties = {},
}, fun(_args)
    fs = req "std.fs"
    fs.read_file(shared.ROOT .. "/docs/DIRECTIVE_HIERARCHY.md") or "DIRECTIVE_HIERARCHY.md not found"
end)

mcp.register_tool("duo_embed_symbols", {
    description = "Symbol-level VECTOR embedding search over compiler+stdlib (Duo-native std.vector: hashed bag-of-n-grams + cosine similarity, NOT keyword matching). Builds docs/symbol_index.json on first call or when force_rebuild=true.",
    type = "object",
    properties = {
        query         = { type = "string",  description = "Natural language or code query" },
        top_k         = { type = "number",  description = "Number of results (default 10)" },
        scope         = { type = "string",  description = "compiler|stdlib|all (default all)" },
        force_rebuild = { type = "boolean", description = "Rebuild symbol index from source" },
    },
    required = { "query" },
}, fun(args)
    jm    = req "std.json"
    fs    = req "std.fs"
    sx    = req "std.script"
    vec   = req "std.vector"
    ipath = "/Users/clp/x/duo/docs/symbol_index.json"
    k     = args.top_k or 10
    sc    = args.scope or "all"

    if args.force_rebuild or not fs.exists(ipath)
        rc = sx.run("cd /Users/clp/x/duo && scripts/duo_lock.sh -- ./zig-out/bin/duo run scripts/build_symbol_index.duo -- " .. ipath)
        if rc ~= 0
            return jm.encode({ error = "symbol index build failed", exit_code = rc })
        end
    end

    raw = fs.read_file(ipath)
    if not raw
        return jm.encode({ error = "symbol index not found at " .. ipath })
    end

    idx = jm.decode(raw)
    dim = idx.dim or 256
    decoded = #(idx.symbols or {})
    indexed = idx.count or decoded
    -- embed the query into the same vector space as the indexed symbols
    qvec = vec.embed(args.query or "", dim)

    -- scope filter (derived from file path), then vector cosine rank
    records = {}
    for _, sym in idx.symbols or {}
        f = sym.file or ""
        if sc == "all"
            records[#records+1] = sym
        elseif sc == "compiler" and string.find(f, "src", 1, true) == 1
            records[#records+1] = sym
        elseif sc == "stdlib" and string.find(f, "lib/std", 1, true) == 1
            records[#records+1] = sym
        end
    end

    results = vec.rank(qvec, records, k)
    note = nil
    if decoded < indexed
        note = "partial decode: " .. decoded .. "/" .. indexed .. " symbols visible — runtime tonumber heap-corruption bug (see findings 2026-08-02T23:10) reduces recall until codegen.zig fix lands"
    end
    jm.encode({ results = results, decoded = decoded, indexed = indexed, note = note, query = args.query, dim = dim })
end)



mcp.register_tool("duo_cross_lang_meta", {
    description = "Guide for injecting Duo @comp.* exponential metaprogramming into any host language project.",
    type = "object",
    properties = {
        host_lang = { type = "string", description = "python|rust|zig|c|js|ts|go|any" },
        goal      = { type = "string", description = "What to achieve (e.g. derive, pipeline, embed-json)" },
    },
}, fun(args)
    jm   = req "std.json"
    lang = args.host_lang or "any"
    goal = args.goal or ""
    hdr  = "# Using Duo metaprogramming from " .. lang .. "\n\n"
    body = "## Drop-in: a standalone meta.duo in your project\n\n"
        .. "  @comp.derive(Serialize, Hash, Eq)\n"
        .. "  MyType = { x: i64, y: i64 }\n\n"
        .. "  @comp.pipeline(\"load -> validate -> transform -> emit\")\n"
        .. "  process(item: Item): Result\n\n"
        .. "Duo build step emits C/asm/object your toolchain links directly.\n\n"
        .. "## Via duo_exponential_eval MCP tool\n\n"
        .. "Pass any code snippet; Duo returns native C + @comp.* expansion.\n\n"
        .. "## Scaling ladder\n\n"
        .. "  @comp.map      1 type  -> N\n"
        .. "  @comp.product  2 types -> N^2\n"
        .. "  @comp.burst    N types -> derives x product\n"
        .. "  @comp.transcend 3      -> N^3\n"
        .. "  @comp.power    N       -> 2^N specializations\n"
        .. "  @comp.permute  N       -> N! orderings\n\n"
        .. "## Agent workflow\n\n"
        .. "1. duo_exponential_eval(source=...) -> optimized Duo\n"
        .. "2. duo_meta_catalog() -> browse @comp.* constructs\n"
        .. "3. duo_meta_ladder() -> understand scaling\n"
        .. "4. duo_file_finding(kind=\"ergonomic_gap\", ...) -> file gaps\n"
    jm.encode({ guide = hdr .. body, host_lang = lang, goal = goal })
end)

mcp.register_tool("duo_semantic_snapshot", {
    description = "Export SIM v0 semantic snapshot JSON for a .duo file (Pass 5)",
    type = "object",
    properties = {
        file_path = { type = "string" },
    },
    required = { "file_path" },
}, fun(args)
    cmd = "/Users/clp/x/duo/zig-out/bin/duo sim " .. (args.file_path or "") .. " 2>/dev/null"
    f = io.popen(cmd, "r")
    if f == nil then return "{\"error\":\"popen failed\"}" end
    output = f:read("*a")
    f:close()
    if output == nil or string.len(output) == 0 then return "{\"error\":\"empty output\"}" end
    i = string.find(output, "{")
    if i then string.sub(output, i) else "{\"error\":\"no JSON in output\"}" end
end)

mcp.register_tool("duo_foreign_import_preview", {
    description = "Preview C header import as SIM v0 entities (Pass 5)",
    type = "object",
    properties = {
        header_path = { type = "string" },
        source_dir = { type = "string" },
    },
    required = { "header_path" },
}, fun(args)
    src_dir = args.source_dir or ""
    if src_dir == "" then
        dir = string.match(args.header_path, "^(.*)/[^/]+$")
        if dir then src_dir = dir end
    end
    json_mod.encode(shared.foreign_import_preview(args.header_path, src_dir))
end)

mcp.register_tool("duo_pass5_catalog", {
    description = "Pass 5 workstream and milestone status from duo catalog",
    type = "object",
    properties = {},
}, fun(_args)
    json_mod.encode(shared.pass5_catalog())
end)

mcp.register_tool("duo_pass6_catalog", {
    description = "Pass 6 architectural reconciliation catalog",
    type = "object",
    properties = {},
}, fun(_args)
    json_mod.encode(shared.pass6_catalog())
end)

mcp.serve()

