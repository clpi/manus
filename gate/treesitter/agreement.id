# gate/treesitter/agreement.id — the second grammar authority, measured
# against the first.
#
# GAP-134 / law.grammar.one. `ext/tree-sitter-idol/grammar.js` is an EDITOR
# PROJECTION and must consume the one grammar-fact owner. It does not: it
# carries its own binding-power ladder, authored in scripts/treesitter_emit.id.
# Two authored ladders that must merely "agree" is the shape docs/spec/law.md
# §4 forbids. This gate does not repair that. It makes the disagreement EXACT
# and fails closed on any disagreement that is not already pinned.
#
# TWO INPUTS, AND THE OWNER SIDE IS THE PRODUCTION ONE.
#
#   src/grammar_role_table.zig       the owner's generated bridge — one row per
#                                    producer slot carrying identity, SPELLING,
#                                    infix face, precedence and associativity
#   ext/tree-sitter-idol/grammar.js  the editor projection under test
#
# An earlier version took spelling from `src/lexer.zig`'s switch. That was the
# host differential oracle, not the production authority: had the production
# lexer changed a spelling without the oracle following, this gate would have
# reported AGREEMENT while the compiler and the editor actually disagreed.
# Spelling now has one producer, `lib/compiler/token.id`, and `src/lexer.zig`
# answers `spelling()` out of the SAME generated row read here. Reading a
# generated file is an act of reading the owner precisely because
# `gate/grammar-projection.sh` regenerates privately and fails unless the
# tracked bytes are identical.
#
# WHY THE SCANS ARE REPEATED INLINE. Substring search, line walk, field split
# and numeric scan want to be four shared relations. They cannot be:
# `gate/vocabulary.sh` refuses every new module-scope declaration that takes
# parameters, and the only door it leaves — an underscore-private name —
# `gate/idiom.id` forbids in `.id` source under LAW-ONE. A relation nested in
# an enclosing body would be the way out and does not lower
# (`DNB001 ... missing: func-body`). A relation with NO parameters is lawful in
# both directions, so the structure below is zero-parameter relations and the
# primitives are written out where they are used. `lib/compiler/token.id`
# `zigrow` carries the same duplication for the same reason. Fold them into
# shared relations when the freeze lifts (GAP-224).
#
# Run: idol run gate/treesitter/agreement.id
# Exit 0 agreement is exactly the pinned baseline
#      1 a divergence appeared, or a pinned one is gone and the pin is stale
#      3 a reader returned nothing, which is how a broken gate reports success

# ── the editor projection's operator table ───────────────────────────────────
#
# One line per binary row tree-sitter declares: `<spelling> <level> <side>`.
# `side` is `none` where tree-sitter writes a bare `prec(` and resolves no
# conflict, which is how it spells what the owner calls `nonassoc`.

editor(): str
  ts = "ext/tree-sitter-idol/grammar.js":read()
  size = ts:len()
  mark = "seq($.expression, '"
  want = mark:len()
  out = ""
  i = 1
  while i <= size
    e = i
    while e <= size and ts:byte(e) != 10
      e += 1
    row = ts:sub(i, e - 1)
    width = row:len()
    m = 0
    seen = false
    k = 1
    while k + want - 1 <= width and !seen
      j = 1
      ok = true
      while j <= want and ok
        if row:byte(k + j - 1) != mark:byte(j)
          ok = false
        j += 1
      if ok
        m = k
        seen = true
      k += 1
    p = 0
    lit = false
    k = 1
    while k + 4 <= width and !lit
      if row:sub(k, k + 4) == "prec."
        p = k
        lit = true
      k += 1
    if seen and lit
      q = p + 5
      while q <= width and row:byte(q) != 40
        q += 1
      side = row:sub(p + 5, q - 1)
      if side:len() < 1
        side = "none"
      lvl = 0
      k = q + 1
      while k <= width and row:byte(k) >= 48 and row:byte(k) <= 57
        lvl *= 10
        lvl += row:byte(k) - 48
        k += 1
      q = m + want
      while q <= width and row:byte(q) != 39
        q += 1
      out = "{out}{row:sub(m + want, q - 1)} {lvl} {side}\n"
    i = e + 1
  out

# ── the join ─────────────────────────────────────────────────────────────────
#
# One line per INFIX identity the owner declares:
#
#   <spelling> <owner precedence> <owner associativity> <editor level> <editor side>
#
# Every owner field comes off the SAME bridge row, so no join can pair one
# identity's spelling with another's binding power. `absent` in the last field
# is an operator the editor grammar does not carry; it is not a spelling any
# token has.

joined(): str
  own = "src/grammar_role_table.zig":read()
  ts = editor()
  size = own:len()
  out = ""
  i = 1
  while i <= size
    e = i
    while e <= size and own:byte(e) != 10
      e += 1
    row = own:sub(i, e - 1)
    width = row:len()
    infix = false
    key = ".infix = true"
    want = key:len()
    k = 1
    while k + want - 1 <= width and !infix
      j = 1
      ok = true
      while j <= want and ok
        if row:byte(k + j - 1) != key:byte(j)
          ok = false
        j += 1
      if ok
        infix = true
      k += 1
    if infix
      key = ".spell = \""
      want = key:len()
      at = 0
      hit = false
      k = 1
      while k + want - 1 <= width and !hit
        j = 1
        ok = true
        while j <= want and ok
          if row:byte(k + j - 1) != key:byte(j)
            ok = false
          j += 1
        if ok
          at = k
          hit = true
        k += 1
      q = at + want
      while q <= width and row:byte(q) != 34
        q += 1
      spell = row:sub(at + want, q - 1)
      key = ".precedence = "
      want = key:len()
      at = 0
      hit = false
      k = 1
      while k + want - 1 <= width and !hit
        j = 1
        ok = true
        while j <= want and ok
          if row:byte(k + j - 1) != key:byte(j)
            ok = false
          j += 1
        if ok
          at = k
          hit = true
        k += 1
      prec = 0
      k = at + want
      while k <= width and row:byte(k) >= 48 and row:byte(k) <= 57
        prec *= 10
        prec += row:byte(k) - 48
        k += 1
      key = ".assoc = ."
      want = key:len()
      at = 0
      hit = false
      k = 1
      while k + want - 1 <= width and !hit
        j = 1
        ok = true
        while j <= want and ok
          if row:byte(k + j - 1) != key:byte(j)
            ok = false
          j += 1
        if ok
          at = k
          hit = true
        k += 1
      assoc = "none"
      if hit
        q = at + want
        while q <= width and row:byte(q) != 44
          q += 1
        assoc = row:sub(at + want, q - 1)
      lvl = 0
      side = "absent"
      tsize = ts:len()
      a = 1
      while a <= tsize
        b = a
        while b <= tsize and ts:byte(b) != 10
          b += 1
        line = ts:sub(a, b - 1)
        c = 1
        while c <= line:len() and line:byte(c) != 32
          c += 1
        if line:sub(1, c - 1) == spell
          d = c + 1
          while d <= line:len() and line:byte(d) != 32
            d += 1
          lvl = 0
          k = c + 1
          while k < d
            lvl *= 10
            lvl += line:byte(k) - 48
            k += 1
          side = line:sub(d + 1, line:len())
        a = b + 1
      out = "{out}{spell} {prec} {assoc} {lvl} {side}\n"
    i = e + 1
  out

# ── the comparison ───────────────────────────────────────────────────────────
#
# Order is compared PAIRWISE and never by value: the two ladders count in the
# same direction but on different scales, and only the induced order is a
# shared fact. Associativity is compared directly, because `nonassoc` declared
# `prec.left` is the difference between refusing `a < b < c` and accepting it.
#
# Returns the divergence keys, one per line, and decides nothing about them.
# One traversal, one result: an earlier shape ran this twice under a selector
# and the two runs disagreed.

keys(): str
  tab = joined()
  ts = editor()
  size = tab:len()
  out = ""

  # coverage and associativity
  i = 1
  while i <= size
    e = i
    while e <= size and tab:byte(e) != 10
      e += 1
    row = tab:sub(i, e - 1)
    width = row:len()
    a = 1
    while a <= width and row:byte(a) != 32
      a += 1
    spell = row:sub(1, a - 1)
    b = a + 1
    while b <= width and row:byte(b) != 32
      b += 1
    c = b + 1
    while c <= width and row:byte(c) != 32
      c += 1
    assoc = row:sub(b + 1, c - 1)
    d = c + 1
    while d <= width and row:byte(d) != 32
      d += 1
    side = row:sub(d + 1, width)
    if side == "absent"
      out = "{out}missing {spell}\n"
    else
      want = assoc
      if assoc == "nonassoc"
        want = "none"
      if side != want
        out = "{out}assoc {spell} {assoc} {side}\n"
    i = e + 1

  # operators the editor grammar recognizes and the owner does not own
  tsize = ts:len()
  i = 1
  while i <= tsize
    e = i
    while e <= tsize and ts:byte(e) != 10
      e += 1
    row = ts:sub(i, e - 1)
    a = 1
    while a <= row:len() and row:byte(a) != 32
      a += 1
    spell = row:sub(1, a - 1)
    held = false
    k = 1
    while k <= size
      m = k
      while m <= size and tab:byte(m) != 10
        m += 1
      line = tab:sub(k, m - 1)
      c = 1
      while c <= line:len() and line:byte(c) != 32
        c += 1
      if line:sub(1, c - 1) == spell
        held = true
      k = m + 1
    if !held
      out = "{out}extra {spell}\n"
    i = e + 1

  # induced binding order, every pair both tables carry
  i = 1
  while i <= size
    ei = i
    while ei <= size and tab:byte(ei) != 10
      ei += 1
    rowa = tab:sub(i, ei - 1)
    wa = rowa:len()
    a = 1
    while a <= wa and rowa:byte(a) != 32
      a += 1
    spella = rowa:sub(1, a - 1)
    b = a + 1
    while b <= wa and rowa:byte(b) != 32
      b += 1
    preca = 0
    k = a + 1
    while k < b
      preca *= 10
      preca += rowa:byte(k) - 48
      k += 1
    c = b + 1
    while c <= wa and rowa:byte(c) != 32
      c += 1
    d = c + 1
    while d <= wa and rowa:byte(d) != 32
      d += 1
    lvla = 0
    k = c + 1
    while k < d
      lvla *= 10
      lvla += rowa:byte(k) - 48
      k += 1
    sidea = rowa:sub(d + 1, wa)
    j = ei + 1
    while j <= size
      ej = j
      while ej <= size and tab:byte(ej) != 10
        ej += 1
      rowb = tab:sub(j, ej - 1)
      wb = rowb:len()
      a = 1
      while a <= wb and rowb:byte(a) != 32
        a += 1
      spellb = rowb:sub(1, a - 1)
      b = a + 1
      while b <= wb and rowb:byte(b) != 32
        b += 1
      precb = 0
      k = a + 1
      while k < b
        precb *= 10
        precb += rowb:byte(k) - 48
        k += 1
      c = b + 1
      while c <= wb and rowb:byte(c) != 32
        c += 1
      d = c + 1
      while d <= wb and rowb:byte(d) != 32
        d += 1
      lvlb = 0
      k = c + 1
      while k < d
        lvlb *= 10
        lvlb += rowb:byte(k) - 48
        k += 1
      sideb = rowb:sub(d + 1, wb)
      if sidea != "absent" and sideb != "absent"
        ownerside = 0
        if preca > precb
          ownerside = 1
        if preca < precb
          ownerside = 0 - 1
        editorside = 0
        if lvla > lvlb
          editorside = 1
        if lvla < lvlb
          editorside = 0 - 1
        if ownerside != editorside
          out = "{out}order {spella} {spellb}\n"
      j = ej + 1
    i = ei + 1
  out

# ── the pinned baseline ──────────────────────────────────────────────────────
#
# Print each divergence with its state; return how many are NOT pinned.

loose(): i64
  found = keys()
  pins = "gate/treesitter/agreement.baseline":read()
  size = found:len()
  psize = pins:len()
  bad = 0
  i = 1
  while i <= size
    e = i
    while e <= size and found:byte(e) != 10
      e += 1
    key = found:sub(i, e - 1)
    if key:len() > 0
      held = false
      k = 1
      while k <= psize
        m = k
        while m <= psize and pins:byte(m) != 10
          m += 1
        if pins:sub(k, m - 1) == key
          held = true
        k = m + 1
      state = "pinned"
      if !held
        state = "NEW"
        bad += 1
      print("  {state}  {key}")
    i = e + 1
  bad

# Pins that no longer describe a divergence. A baseline that only grows is not
# a ratchet, so a stale pin is a failure and not a courtesy.

stale(): i64
  found = keys()
  pins = "gate/treesitter/agreement.baseline":read()
  size = found:len()
  psize = pins:len()
  gone = 0
  i = 1
  while i <= psize
    e = i
    while e <= psize and pins:byte(e) != 10
      e += 1
    pin = pins:sub(i, e - 1)
    if pin:len() > 0 and pin:byte(1) != 35
      held = false
      k = 1
      while k <= size
        m = k
        while m <= size and found:byte(m) != 10
          m += 1
        if found:sub(k, m - 1) == pin
          held = true
        k = m + 1
      if !held
        print("  STALE   {pin}")
        gone += 1
    i = e + 1
  gone

# How many pins the baseline carries, comments and blanks excluded.

held(): i64
  pins = "gate/treesitter/agreement.baseline":read()
  size = pins:len()
  n = 0
  i = 1
  while i <= size
    e = i
    while e <= size and pins:byte(e) != 10
      e += 1
    row = pins:sub(i, e - 1)
    if row:len() > 0 and row:byte(1) != 35
      n += 1
    i = e + 1
  n

# Non-empty lines of a text.

rows(): i64
  found = keys()
  size = found:len()
  n = 0
  i = 1
  while i <= size
    e = i
    while e <= size and found:byte(e) != 10
      e += 1
    if e > i
      n += 1
    i = e + 1
  n

check(): i64
  tab = joined()
  ts = editor()
  if tab:len() < 1 or ts:len() < 1
    print("treesitter agreement: FAIL — a reader found no operators. A reader")
    print("  that returns nothing reports agreement, which is the failure this")
    print("  exit status exists to distinguish.")
    return 3
  nown = 0
  size = tab:len()
  i = 1
  while i <= size
    e = i
    while e <= size and tab:byte(e) != 10
      e += 1
    if e > i
      nown += 1
    i = e + 1
  nts = 0
  size = ts:len()
  i = 1
  while i <= size
    e = i
    while e <= size and ts:byte(e) != 10
      e += 1
    if e > i
      nts += 1
    i = e + 1
  print("treesitter agreement: owner declares {nown} infix identities; the editor")
  print("  projection declares {nts} operator rows. Both read from their producers.")
  bad = loose()
  gone = stale()
  seen = rows()
  pins = held()
  print("  divergences found {seen}, pinned {pins}, unpinned {bad}, stale {gone}")
  agree = true
  if bad > 0
    print("treesitter agreement: FAIL — {bad} divergence(s) are not pinned.")
    print("  The editor projection and lib/compiler/token.id disagree about a")
    print("  binding power, an associativity, or which operators exist. One of")
    print("  them is authoring grammar that the other did not (law.grammar.one).")
    agree = false
  if gone > 0
    print("treesitter agreement: FAIL — {gone} pin(s) describe no divergence.")
    print("  Delete the line in the diff that fixed it; a baseline that only")
    print("  grows is not a ratchet.")
    agree = false
  out = 1
  if agree
    print("treesitter agreement: OK — no divergence outside the pinned baseline.")
    out = 0
  out

check()
