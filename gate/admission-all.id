chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

indexof: i64 = (hay: str, needle: str, from: i64)
  h = hay:len()
  n = needle:len()
  i = from
  while i + n - 1 <= h
    if hay:sub(i, i + n - 1) == needle
      return i
    i = i + 1
  0

runrc: i64 = (cmd: str)
  raw = gatecap(cmd .. " 2>&1; echo RC=$?")
  rcl = indexof(raw, "RC=", 1)
  body = ""
  rcstr = "2"
  if rcl != 0
    body = raw:sub(1, rcl - 1)
    rcstr = chomp(raw:sub(rcl + 3, raw:len()))
  if body != ""
    print(chomp(body))
  if rcstr == "0"
    return 0
  if rcstr == "1"
    return 1
  2

main: i64 = ()
  prog = "admission-all.sh"
  run_gates = true
  run_controls = false
  base_rev = ""
  i = 1
  while true
    a = os.args(i)
    if a == nil
      break
    astr: str = a
    if astr == "--controls"
      run_gates = false
      run_controls = true
    else if astr == "--all"
      run_controls = true
    else if astr == "--base"
      i = i + 1
      rev = os.args(i)
      if rev == nil
        print(prog .. ": --base needs a revision")
        return 1
      base_rev = rev
    else
      print(prog .. ": unknown argument: " .. astr)
      return 1
    i = i + 1
  rc = 0
  here = "gate"
  if run_gates
    if runrc("sh " .. here .. "/subject.sh --tree") != 0
      print(prog .. ": BLOCKED — admission requires a real Git work tree.")
      return 1
    g1 = "admission"
    print("")
    print("--- gate/" .. g1 .. ".sh ---")
    cmd1 = "sh " .. here .. "/" .. g1 .. ".sh"
    if base_rev != ""
      cmd1 = cmd1 .. " --base '" .. base_rev .. "'"
    if runrc(cmd1) != 0
      rc = 1
    g2 = "vocabulary"
    print("")
    print("--- gate/" .. g2 .. ".sh ---")
    cmd2 = "sh " .. here .. "/" .. g2 .. ".sh"
    if base_rev != ""
      cmd2 = cmd2 .. " --base '" .. base_rev .. "'"
    if runrc(cmd2) != 0
      rc = 1
    g3 = "layering"
    print("")
    print("--- gate/" .. g3 .. ".sh ---")
    cmd3 = "sh " .. here .. "/" .. g3 .. ".sh"
    if base_rev != ""
      cmd3 = cmd3 .. " --base '" .. base_rev .. "'"
    if runrc(cmd3) != 0
      rc = 1
    print("")
    print("--- gate/directive.sh ---")
    if runrc("sh " .. here .. "/directive.sh") != 0
      rc = 1
    print("")
    print("--- gate/frontier.sh ---")
    if runrc("sh " .. here .. "/frontier.sh") != 0
      rc = 1
  if run_controls
    c1 = "admission"
    print("")
    print("--- gate/" .. c1 .. "-controls.sh ---")
    if runrc("sh " .. here .. "/" .. c1 .. "-controls.sh") != 0
      rc = 1
    c2 = "vocabulary"
    print("")
    print("--- gate/" .. c2 .. "-controls.sh ---")
    if runrc("sh " .. here .. "/" .. c2 .. "-controls.sh") != 0
      rc = 1
    c3 = "layering"
    print("")
    print("--- gate/" .. c3 .. "-controls.sh ---")
    if runrc("sh " .. here .. "/" .. c3 .. "-controls.sh") != 0
      rc = 1
    print("")
    print("--- gate/frontier.sh --selftest ---")
    if runrc("sh " .. here .. "/frontier.sh --selftest") != 0
      rc = 1
  print("")
  if rc == 0
    print(prog .. ": ADMITTED.")
  else
    print(prog .. ": BLOCKED. See the named gate above.")
  rc
