chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

indexof: i64 = (hay: str, needle: str, from: i64)
  h = hay:len()
  n = needle:len()
  i = from
  while i + n - 1 <= h
    if hay:sub(i, i + n - 1) == needle
      return i
    i = i + 1
  0

findline: i64 = (src: str, line: str, from: i64)
  n = line:len()
  i = indexof(src, "\n" .. line, from)
  while i != 0
    after = i + 1 + n
    if after > src:len() or src:sub(after, after) == "\n"
      return i + 1
    i = indexof(src, "\n" .. line, i + 1)
  0

linehasprefix: bool = (src: str, prefix: str)
  plen = prefix:len()
  slen = src:len()
  if plen == 0
    return true
  if slen >= plen and src:sub(1, plen) == prefix
    return true
  pos = 1
  while true
    nl = indexof(src, "\n", pos)
    if nl == 0
      return false
    ls = nl + 1
    if ls + plen - 1 <= slen and src:sub(ls, ls + plen - 1) == prefix
      return true
    pos = ls
  false

refuse: i64 = (msg: str)
  print("grammar-projection: FAIL — " .. msg)
  2

main: i64 = ()
  emit = "./tools/node/dev/grammar/emit"
  if chomp(gatecap("test -x '" .. emit .. "' && echo yes || echo no")) != "yes"
    return refuse("no executable producer at " .. emit .. " — the counterfactual cannot have been run")
  owner = "lib/compiler/token.id"
  zigout = "src/grammar_role_table.zig"
  idout = "lib/token/grammarrole.id"
  if chomp(gatecap("test -s '" .. owner .. "' && echo yes || echo no")) != "yes"
    return refuse("subject absent or empty: " .. owner)
  if chomp(gatecap("test -s '" .. zigout .. "' && echo yes || echo no")) != "yes"
    return refuse("subject absent or empty: " .. zigout)
  if chomp(gatecap("test -s '" .. idout .. "' && echo yes || echo no")) != "yes"
    return refuse("subject absent or empty: " .. idout)
  idolbin = os.env["IDOL"]
  if idolbin == nil or idolbin == ""
    idolbin = "./zig-out/bin/idol"
  tmpdir = os.env["TMPDIR"]
  if tmpdir == nil or tmpdir == ""
    tmpdir = "/tmp"
  work = chomp(gatecap("mktemp -d '" .. tmpdir .. "/idol-grammar-gate.XXXXXX'"))
  if work == ""
    print("grammar-projection: FAIL — mktemp failed")
    return 2
  selfrc = chomp(gatecap("IDOL=" .. idolbin .. " " .. emit .. " --selftest >" .. work .. "/self.out 2>" .. work .. "/self.err; echo $?"))
  selfout = gatecap("cat " .. work .. "/self.out 2>/dev/null")
  selferr = gatecap("cat " .. work .. "/self.err 2>/dev/null")
  if selfout != ""
    print(chomp(selfout))
  if selferr != ""
    print(chomp(selferr))
  if selfrc != "0"
    gatecap("rm -rf " .. work)
    code = chomp(selfrc):to(i64)
    if code != 0
      return code
    return refuse("no exit code from {emit} --selftest")
  if not linehasprefix(selfout, "grammar projection control: PASS")
    gatecap("rm -rf " .. work)
    return refuse(emit .. " --selftest exited 0 without reporting a control verdict — a silent control refused nothing")
  checkrc = chomp(gatecap("IDOL=" .. idolbin .. " " .. emit .. " --check >" .. work .. "/check.out 2>" .. work .. "/check.err; echo $?"))
  checkout = gatecap("cat " .. work .. "/check.out 2>/dev/null")
  checkerr = gatecap("cat " .. work .. "/check.err 2>/dev/null")
  if checkout != ""
    print(chomp(checkout))
  if checkerr != ""
    print(chomp(checkerr))
  if checkrc != "0"
    gatecap("rm -rf " .. work)
    code = chomp(checkrc):to(i64)
    if code != 0
      return code
    return refuse("no exit code from {emit} --check")
  want1 = "grammar projection: " .. zigout .. " regenerates byte-identically"
  want2 = "grammar projection: " .. idout .. " regenerates byte-identically"
  if findline("\n" .. checkout, want1, 1) == 0
    gatecap("rm -rf " .. work)
    return refuse(emit .. " --check exited 0 without asserting that " .. zigout .. " regenerates byte-identically")
  if findline("\n" .. checkout, want2, 1) == 0
    gatecap("rm -rf " .. work)
    return refuse(emit .. " --check exited 0 without asserting that " .. idout .. " regenerates byte-identically")
  if not linehasprefix(checkout, "grammar projection entry: PASS")
    gatecap("rm -rf " .. work)
    return refuse(emit .. " --check exited 0 without the entry-selection verdict — the owner root was never exercised")
  gatecap("rm -rf " .. work)
  print("grammar-projection: PASS — control refused a wrong dense-table producer; " .. zigout .. " and " .. idout .. " regenerate byte-identically from " .. owner)
  0
