chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

main: i64 = ()
  if chomp(gatecap("uname -s")) != "Linux"
    print("elfexec: NOT MEASURED — the emitted x86_64 ELF executes only on Linux")
    return 0
  root = chomp(gatecap("pwd"))
  idol = os.env["IDOL_BIN"]
  if idol == nil or idol == ""
    idol = "{root}/zig-out/bin/idol"
  else
    if idol:sub(1, 1) != "/"
      idol = "{root}/{idol}"
  fail = 0
  if gatecap("test -x '{idol}'; echo $?") != "0\n"
    print("elfexec: FAIL compiler is not executable: {idol}")
    return 1
  work = chomp(gatecap("mktemp -d /tmp/idol-elfexec.XXXXXX"))
  mk = gatecap("'{idol}' run --backend=direct '{root}/lib/compiler/elfx86hi.id' >'{work}/hi.elf' 2>'{work}/emit.log'; echo $?")
  if mk != "0\n"
    print("elfexec: FAIL emitter exited nonzero")
    fail = 1
  else
    size = chomp(gatecap("wc -c <'{work}/hi.elf' | tr -d ' '"))
    if size != "165"
      print("elfexec: FAIL emitted {size} bytes, expected 165")
      fail = 1
    else
      gatecap("chmod +x '{work}/hi.elf'")
      got = gatecap("'{work}/hi.elf'; echo \"rc=$?\"")
      if got != "hi\nrc=0\n"
        print("elfexec: FAIL executable did not print hi with exit 0")
        fail = 1
  cleaned = gatecap("rm -rf '{work}'")
  if fail == 0
    print("elfexec: PASS Idol source emitted a 165-byte x86_64 ELF that printed hi and exited 0")
  fail
