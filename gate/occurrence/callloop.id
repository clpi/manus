# gate/occurrence/copy.sh §4 subject — a loop whose body IS a published
# application occurrence. `dnir_lower.unrollExprIsCopyable` asks the graph's
# occurrence index (`ctx.occurrences`) and refuses, so no copy of this body is
# ever emitted and `IDOL_UNROLL=4` must leave the bytes exactly as they were.
#
# It is the executable form of the occurrence law: a transformation may copy an
# identity-free instruction, and may not copy an occurrence.
bump(): i64
  return 1
check(): i64
  t = 0
  i = 1
  while i <= 9
    t = t + bump()
    i = i + 1
  return t
main(): i64
  return check()
