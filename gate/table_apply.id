
chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

exitedzero: bool = (shellline: str)
  chomp(gatecap("( {shellline} ) >/dev/null 2>&1; echo $?")) == "0"

present: bool = (path: str)
  exitedzero("test -r '{path}'")

contains: bool = (path: str, needle: str)
  exitedzero("grep -F -- '{needle}' '{path}'")

checkpath: i64 = (root: str, path: str, needle: str, fail: i64)
  file = "{root}/{path}"
  if !present(file)
    print("table_apply gate: FAIL missing {path}")
    return fail + 1
  if !contains(file, needle)
    print("table_apply gate: FAIL {path} does not call table_apply.normalizeModule")
    return fail + 1
  fail

checkmodule: i64 = (root: str, mod: str, fail: i64)
  rel = "lib/compiler/{mod}.id"
  if !present("{root}/{rel}")
    print("table_apply gate: FAIL missing {rel}")
    return fail + 1
  fail

main: i64 = ()
  root = os.env["TABLE_APPLY_ROOT"]
  if root == nil or root == ""
    root = "."
  tapply = "{root}/src/table_apply.zig"
  if !present(tapply)
    print("table_apply gate: FAIL missing {tapply}")
    return 1
  fail = 0
  if !contains(tapply, "pub fn normalizeModule")
    print("table_apply gate: FAIL table_apply.zig lost pub fn normalizeModule")
    fail = fail + 1
  fail = checkpath(root, "src/graph/lower.zig", "table_apply.normalizeModule", fail)
  fail = checkpath(root, "src/native.zig", "table_apply.normalizeModule", fail)
  fail = checkpath(root, "src/main.zig", "table_apply.normalizeModule", fail)
  fail = checkpath(root, "src/graph.zig", "table_apply.normalizeModule", fail)
  fail = checkmodule(root, "bind", fail)
  fail = checkmodule(root, "lexer", fail)
  fail = checkmodule(root, "parser", fail)
  fail = checkmodule(root, "graph", fail)
  fail = checkmodule(root, "monolith", fail)
  if fail != 0
    return fail
  print("table_apply gate: PASS — normalizeModule on all direct lowering paths")
  0
