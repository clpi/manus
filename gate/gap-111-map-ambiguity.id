chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

digits: i64 = (text: str)
  if !text or text:len() == 0
    return -1
  v = 0
  i = 1
  n = text:len()
  while i <= n
    c = text:sub(i, i)
    if c >= "0" and c <= "9"
      v = v * 10 + (text:byte(i) - 48)
      i = i + 1
    else
      return -1
  v

main: i64 = ()
  idol = os.env["IDOL_BIN"]
  if idol == nil or idol == ""
    idol = "./zig-out/bin/idol"
  work = chomp(gatecap("mktemp -d \"$\{TMPDIR:-/tmp\}/idol-gap111-amb.XXXXXX\""))
  fail = 0
  if gatecap("test -x '{idol}'; echo $?") == "0\n"
    gatecap("cat >'{work}/ambiguous.id' <<'PROBE'\ntwice = (x) x * 2\nxs = \{1, 2, 3\}\nmain: i64 = ()\n    r = xs:map(twice)\n    0\nPROBE\n")
    log = "{work}/check.log"
    ec = digits(chomp(gatecap("'{idol}' check '{work}/ambiguous.id' >'{log}' 2>&1; echo $?")))
    if ec == 0
      print("gap-111-map-ambiguity gate: FAIL xs:map(twice) was admitted despite duplicate map in iter and table")
      fail = 1
    else
      found = gatecap("grep -F -- 'ambiguous subject-first relation' '{log}' >/dev/null 2>&1; echo $?") == "0\n"
      if !found
        print("gap-111-map-ambiguity gate: FAIL expected explicit ambiguity refusal for xs:map, not silent first-wins")
        fail = 1
  else
    print("gap-111-map-ambiguity gate: FAIL compiler is not executable: {idol}")
    fail = 1
  gatecap("rm -rf '{work}'")
  if fail == 0
    print("gap-111-map-ambiguity gate: PASS")
  fail
