chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

digits: i64 = (text: str)
  if not text or text:len() == 0
    return -1
  v = 0
  i = 1
  n = text:len()
  while i <= n
    c = text:sub(i, i)
    if c >= "0" and c <= "9"
      v = v * 10 + (text:byte(i) - 48)
      i = i + 1
    else
      return -1
  v

main: i64 = ()
  idol = os.env["IDOL_BIN"]
  if idol == nil or idol == ""
    idol = "./zig-out/bin/idol"
  fail = 0
  if gatecap("test -x '{idol}'; echo $?") == "0\n"
    ec = digits(chomp(gatecap("'{idol}' run examples/typed_array_bracket_assign.id >/dev/null 2>&1; echo $?")))
    if ec != 42
      print("delimiter-projection-law gate: FAIL typed_array_bracket_assign.id exited {ec}, not 42")
      fail = 1
    else
      ec = digits(chomp(gatecap("'{idol}' run examples/call_index_assign.id >/dev/null 2>&1; echo $?")))
      if ec == 42
        print("delimiter-projection-law gate: FAIL call_index_assign.id treated arr(i) as indexing")
        fail = 1
  else
    print("delimiter-projection-law gate: FAIL compiler is not executable: {idol}")
    fail = 1
  if fail == 0
    print("delimiter-projection-law gate: PASS")
  fail
