chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

digits: i64 = (text: str)
  if !text or text:len() == 0
    return -1
  v = 0
  i = 1
  n = text:len()
  while i <= n
    c = text:sub(i, i)
    if c >= "0" and c <= "9"
      v = v * 10 + (text:byte(i) - 48)
      i = i + 1
    else
      return -1
  v

probe: i64 = (idol: str, cc: str, work: str, label: str, body: str)
  gatecap("cat >'{work}/{label}.id' <<'PROBE'\n{body}PROBE\n")
  dump = digits(chomp(gatecap("cd '{work}' && '{idol}' dump-c '{label}.id' >'{label}.c' 2>'{label}.dump.log'; echo $?")))
  if dump != 0
    print("gap-114-boxed-len gate: FAIL {label} did not emit C")
    return 1
  comp = digits(chomp(gatecap("'{cc}' '{work}/{label}.c' -o '{work}/{label}.bin' -lm 2>'{work}/{label}.cc.log'; echo $?")))
  if comp != 0
    print("gap-114-boxed-len gate: FAIL {label} emitted C that {cc} refused")
    return 1
  gatecap("'{work}/{label}.bin' >'{work}/{label}.log' 2>'{work}/{label}.run.log'")
  same = digits(chomp(gatecap("printf '8\\n7\\n' | cmp -s - '{work}/{label}.log'; echo $?")))
  if same != 0
    print("gap-114-boxed-len gate: FAIL {label} values diverged from 8 then 7")
    return 1
  0

main: i64 = ()
  root = chomp(gatecap("pwd"))
  idol = os.env["IDOL_BIN"]
  if idol == nil or idol == ""
    idol = "{root}/zig-out/bin/idol"
  else
    if idol:sub(1, 1) != "/"
      idol = "{root}/{idol}"
  cc = os.env["CC"]
  if cc == nil or cc == ""
    cc = "cc"
  work = chomp(gatecap("mktemp -d \"$\{TMPDIR:-/tmp\}/idol-gap114.XXXXXX\""))
  ctl = "main: i64 = ()\n    s = \"/tmp/xyz\"\n    print(s:len())\n    t = s:sub(1, s:len() - 1)\n    print(t:len())\n    0\n"
  box = "main: i64 = ()\n    fh = io.popen(\"printf %s /tmp/xyz\", \"r\")\n    raw = fh:read(\"a\")\n    fh:close()\n    print(raw:len())\n    trimmed = raw:sub(1, raw:len() - 1)\n    print(trimmed:len())\n    0\n"
  fail = 0
  if gatecap("test -x '{idol}'; echo $?") == "0\n"
    if gatecap("command -v '{cc}' >/dev/null 2>&1; echo $?") == "0\n"
      if probe(idol, cc, work, "control", ctl) != 0
        fail = 1
      else
        if probe(idol, cc, work, "boxed", box) != 0
          fail = 1
        else
          if gatecap("grep -E 'lua_str_buf_len_i64\\(raw' '{work}/boxed.c' >/dev/null 2>&1; echo $?") == "0\n"
            print("gap-114-boxed-len gate: FAIL boxed probe lowers :len() through the buffer intrinsic again")
            fail = 1
    else
      print("gap-114-boxed-len gate: FAIL C compiler is unavailable: {cc}")
      fail = 1
  else
    print("gap-114-boxed-len gate: FAIL compiler is not executable: {idol}")
    fail = 1
  gatecap("rm -rf '{work}'")
  if fail == 0
    print("gap-114-boxed-len gate: PASS")
  fail
