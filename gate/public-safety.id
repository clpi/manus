chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

host: str = (idol: str, work: str)
  gatecap("cat >'{work}/control.id' <<'PROBE'\nmain: i64 = ()\n  0\nPROBE\n")
  gatecap("'{idol}' compile --backend=direct -o '{work}/control.bin' '{work}/control.id' >'{work}/control.log' 2>&1 </dev/null")
  if chomp(gatecap("test -s '{work}/control.bin'; echo $?")) == "0"
    return "yes"
  if chomp(gatecap("grep -q 'DNB004' '{work}/control.log'; echo $?")) == "0"
    return "no"
  "broken"

main: i64 = ()
  root = chomp(gatecap("pwd"))
  idol = os.env["IDOL_BIN"]
  if idol == nil or idol == ""
    idol = "{root}/zig-out/bin/idol"
  else
    if idol:sub(1, 1) != "/"
      idol = "{root}/{idol}"
  work = ""
  cleaned = ""
  fail = 0
  if chomp(gatecap("test -x '{idol}'; echo $?")) == "0"
    work = chomp(gatecap("mktemp -d /tmp/idol-publicsafety.XXXXXX"))
    state = host(idol, work)
    if state == "no"
      print("public-safety.id: NOT MEASURED — the tracked-file public-safety scan (its gatecap round-trip runs through the auto backend). This host has no direct-native realization: the compiler refused a trivial program with DNB004.")
      cleaned = gatecap("rm -rf '{work}'")
      return 1
    if state == "broken"
      print("public-safety gate: FAIL the host probe failed for a reason other than DNB004")
      print(chomp(gatecap("tail -20 '{work}/control.log'")))
      cleaned = gatecap("rm -rf '{work}'")
      return 1
    rc = chomp(gatecap("'{idol}' run --backend=direct scripts/public_safety_scan.id >'{work}/scan.log' 2>&1; echo $?"))
    if rc != "0"
      print("public-safety gate: FAIL scan exited {rc}")
      print(chomp(gatecap("tail -20 '{work}/scan.log'")))
      fail = 1
    cleaned = gatecap("rm -rf '{work}'")
  else
    print("public-safety gate: FAIL compiler is not executable: {idol}")
    fail = 1
  if fail == 0
    print("public-safety gate: PASS")
  fail
