chomp: str = (text: str)
  if text == nil or text == ""
    return ""
  n = text:len()
  while n > 0
    c = text:sub(n, n)
    if c != "\n" and c != "\r" and c != " " and c != "\t"
      break
    n = n - 1
  text:sub(1, n)

digits: i64 = (text: str)
  if !text or text:len() == 0
    return -1
  v = 0
  i = 1
  n = text:len()
  while i <= n
    c = text:sub(i, i)
    if c >= "0" and c <= "9"
      v = v * 10 + (text:byte(i) - 48)
      i = i + 1
    else
      return -1
  v

main: i64 = ()
  root = chomp(gatecap("pwd"))
  idol = os.env["IDOL_BIN"]
  if idol == nil or idol == ""
    idol = "{root}/zig-out/bin/idol"
  else
    if idol:sub(1, 1) != "/"
      idol = "{root}/{idol}"
  work = ""
  cleaned = ""
  fail = 0
  if gatecap("test -x '{idol}'; echo $?") == "0\n"
    work = chomp(gatecap("mktemp -d /tmp/idol-publicsafety.XXXXXX"))
    rc = digits(chomp(gatecap("'{idol}' run --backend=direct scripts/public_safety_scan.id >'{work}/scan.log' 2>&1; echo $?")))
    if rc != 0
      print("public-safety gate: FAIL scan exited {rc}")
      print(chomp(gatecap("tail -20 '{work}/scan.log'")))
      fail = 1
    cleaned = gatecap("rm -rf '{work}'")
  else
    print("public-safety gate: FAIL compiler is not executable: {idol}")
    fail = 1
  if fail == 0
    print("public-safety gate: PASS")
  fail
