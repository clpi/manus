src = "line1\nline2\nline3\n"
print("src=[" .. src .. "] len=" .. string.len(src))

count = 0
for ln in string.gmatch(src, "([^\n]*)\n") do
    count = count + 1
    print("ln[" .. count .. "]=[" .. tostring(ln) .. "]")
end
print("total=" .. count)

-- test: does gmatch iterate?
count2 = 0
for x in string.gmatch("a,b,c", ",") do
    count2 = count2 + 1
    print("comma[" .. count2 .. "]=[" .. x .. "]")
end
print("total2=" .. count2)
