
base = 4294967296
ring = 2147483647
inv3 = 715827883

pk: i64 = (p: i64, v: i64)
  p * base + v

quo: i64 = (a: i64, b: i64)
  q = 0
  x = a
  while x >= b
    x = x - b
    q = q + 1
  q

pos: i64 = (z: i64)
  quo(z, base)

val: i64 = (z: i64)
  z - quo(z, base) * base

movz: i64 = (d: i64, imm: i64, hw: i64)
  3531603968 | hw << 21 | (imm & 65535) << 5 | d

movk: i64 = (d: i64, imm: i64, hw: i64)
  4068474880 | hw << 21 | (imm & 65535) << 5 | d

ret: i64 = ()
  3596551104

factor: i64 = (src: str, p: i64, xv: i64)
  n = src:len()
  q = p
  sp = 1
  while sp == 1
    sp = 0
    if q <= n
      if src:byte(q) == 32
        q = q + 1
        sp = 1
  paren = 0
  isx = 0
  if q <= n
    if src:byte(q) == 40
      paren = 1
  if q <= n
    if src:byte(q) == 120
      isx = 1
    if src:byte(q) == 105
      isx = 1
  fv = 0
  if paren == 1
    e = expr(src, q + 1, xv)
    q = pos(e)
    fv = val(e)
    s2 = 1
    while s2 == 1
      s2 = 0
      if q <= n
        if src:byte(q) == 32
          q = q + 1
          s2 = 1
    q = q + 1
  if isx == 1
    fv = xv
    q = q + 1
  if paren == 0 and isx == 0
    d = 1
    while d == 1
      d = 0
      if q <= n
        b = src:byte(q)
        if b >= 48 and b <= 57
          fv = fv * 10 + b - 48
          q = q + 1
          d = 1
  ts = 1
  while ts == 1
    ts = 0
    if q <= n
      if src:byte(q) == 32
        q = q + 1
        ts = 1
  pk(q, fv)

term: i64 = (src: str, p: i64, xv: i64)
  n = src:len()
  f = factor(src, p, xv)
  q = pos(f)
  acc = val(f)
  go = 1
  while go == 1
    op = 0
    if q <= n
      op = src:byte(q)
    go = 0
    if op == 42 or op == 47
      go = 1
      r = factor(src, q + 1, xv)
      q = pos(r)
      if op == 42
        acc = acc * val(r) & ring
      if op == 47
        acc = quo(acc, val(r))
  pk(q, acc)

expr: i64 = (src: str, p: i64, xv: i64)
  n = src:len()
  t = term(src, p, xv)
  q = pos(t)
  acc = val(t)
  go = 1
  while go == 1
    op = 0
    if q <= n
      op = src:byte(q)
    go = 0
    if op == 43 or op == 45
      go = 1
      r = term(src, q + 1, xv)
      q = pos(r)
      if op == 43
        acc = (acc + val(r)) & ring
      if op == 45
        acc = (acc - val(r)) & ring
  pk(q, acc)


affine: i64 = (aa: i64, cc: i64, seed: i64, nn: i64)
  ra = 1
  rc = 0
  ba = aa
  bc = cc
  k = nn
  while k > 0
    if k & 1 == 1
      nra = ra * ba & ring
      nrc = (ra * bc + rc) & ring
      ra = nra
      rc = nrc
    nba = ba * ba & ring
    nbc = (ba * bc + bc) & ring
    ba = nba
    bc = nbc
    k = k >> 1
  (ra * seed + rc) & ring

powmod: i64 = (a: i64, nn: i64)
  r = 1
  b = a & ring
  k = nn
  while k > 0
    if k & 1 == 1
      r = r * b & ring
    b = b * b & ring
    k = k >> 1
  r

fib: i64 = (nn: i64)
  top = 0
  t = nn
  while t > 0
    t = t >> 1
    top = top + 1
  a = 0
  b = 1
  i = top
  while i > 0
    i = i - 1
    db = (b + b - a) & ring
    c = a * db & ring
    d = (a * a + b * b) & ring
    bit = nn >> i & 1
    if bit == 0
      a = c
      b = d
    if bit == 1
      a = d
      b = (c + d) & ring
  a

sumi: i64 = (nn: i64)
  o = nn + 1
  res = 0
  if nn & 1 == 0
    hh = nn >> 1
    res = hh & ring * o & ring & ring
  if nn & 1 == 1
    hh = o >> 1
    res = nn & ring * hh & ring & ring
  res

sumsq: i64 = (nn: i64)
  o = nn + 1
  tw = nn + nn + 1
  fa = 0
  fb = 0
  fc = tw & ring
  if nn & 1 == 0
    fa = nn >> 1 & ring
    fb = o & ring
  if nn & 1 == 1
    fa = nn & ring
    fb = o >> 1 & ring
  p = fa * fb & ring * fc & ring
  p * inv3 & ring

sumcube: i64 = (nn: i64)
  t = sumi(nn)
  t * t & ring

binom3: i64 = (nn: i64)
  a = nn - 1
  b = nn + 1
  ha = a
  hb = nn
  if a & 1 == 0
    ha = a >> 1
  if a & 1 == 1
    hb = nn >> 1
  p = ha & ring * hb & ring & ring
  p = p * b & ring & ring
  p * inv3 & ring

binom4: i64 = (nn: i64)
  a = nn - 2
  b = nn - 1
  c = nn
  e = nn + 1
  ha = a
  hb = b
  hc = c
  he = e
  if a & 1 == 0
    ha = a >> 1
  if b & 1 == 0
    hb = b >> 1
  if c & 1 == 0
    hc = c >> 1
  if e & 1 == 0
    he = e >> 1
  if a & 3 == 0
    ha = a >> 2
  if b & 3 == 0
    hb = b >> 2
  if c & 3 == 0
    hc = c >> 2
  if e & 3 == 0
    he = e >> 2
  p = ha & ring * hb & ring & ring
  p = p * hc & ring & ring
  p = p * he & ring & ring
  p * inv3 & ring

polysum: i64 = (d0: i64, d1: i64, d2: i64, d3: i64, nn: i64)
  s = d0 * nn & ring & ring
  s = (s + d1 * sumi(nn)) & ring
  s = (s + d2 * binom3(nn)) & ring
  s = (s + d3 * binom4(nn)) & ring
  s & ring

doloop: i64 = (src: str)
  q = 5
  s1 = 1
  while s1 == 1
    s1 = 0
    if src:byte(q) == 32
      q = q + 1
      s1 = 1
  nn = 0
  g1 = 1
  while g1 == 1
    g1 = 0
    b = src:byte(q)
    if b >= 48 and b <= 57
      nn = nn * 10 + b - 48
      q = q + 1
      g1 = 1
  s2 = 1
  while s2 == 1
    s2 = 0
    if src:byte(q) == 32
      q = q + 1
      s2 = 1
  x0 = 0
  g2 = 1
  while g2 == 1
    g2 = 0
    b = src:byte(q)
    if b >= 48 and b <= 57
      x0 = x0 * 10 + b - 48
      q = q + 1
      g2 = 1
  cc = 1
  while cc == 1
    cc = 0
    if src:byte(q) != 58
      q = q + 1
      cc = 1
  bs = q + 1
  b0 = val(expr(src, bs, 0)) & ring
  b1 = val(expr(src, bs, 1)) & ring
  b2 = val(expr(src, bs, 2)) & ring
  aa = (b1 - b0) & ring
  bb = b0
  chk = (2 * aa + bb) & ring
  r = 248
  if chk == b2
    r = affine(aa, bb, x0 & ring, nn) & 255
  r

dosum: i64 = (src: str)
  q = 5
  s1 = 1
  while s1 == 1
    s1 = 0
    if src:byte(q) == 32
      q = q + 1
      s1 = 1
  nn = 0
  g1 = 1
  while g1 == 1
    g1 = 0
    b = src:byte(q)
    if b >= 48 and b <= 57
      nn = nn * 10 + b - 48
      q = q + 1
      g1 = 1
  cc = 1
  while cc == 1
    cc = 0
    if src:byte(q) != 58
      q = q + 1
      cc = 1
  bs = q + 1
  f0 = val(expr(src, bs, 0)) & ring
  f1 = val(expr(src, bs, 1)) & ring
  f2 = val(expr(src, bs, 2)) & ring
  f3 = val(expr(src, bs, 3)) & ring
  f4 = val(expr(src, bs, 4)) & ring
  e1 = (f1 - f0) & ring
  e2 = (f2 - 2 * f1 + f0) & ring
  e3 = (f3 - 3 * f2 + 3 * f1 - f0) & ring
  e4 = (f4 - 4 * f3 + 6 * f2 - 4 * f1 + f0) & ring
  r = 249
  if e4 == 0
    r = polysum(f0, e1, e2, e3, nn) & 255
  r

run: i64 = (src: str)
  good = 0
  if movz(0, 9, 0) == 3531604256
    good = good + 1
  if movk(0, 1, 1) == 4070572064
    good = good + 1
  if ret() == 3596551104
    good = good + 1
  if good != 3
    return 250

  n = src:len()
  isloop = 0
  if n >= 4
    if src:byte(1) == 108 and src:byte(2) == 111 and src:byte(3) == 111 and src:byte(4) == 112
      isloop = 1
  issum = 0
  if n >= 4
    if src:byte(1) == 115 and src:byte(2) == 117 and src:byte(3) == 109 and src:byte(4) == 32
      issum = 1
  result = 0
  if isloop == 1
    result = doloop(src)
  if issum == 1
    result = dosum(src)
  if isloop == 0 and issum == 0
    lp = 0
    i = 1
    while i <= n
      if src:byte(i) == 40 and lp == 0
        lp = i
      i = i + 1
    if lp == 0
      result = val(expr(src, 1, 0))
    if lp > 0
      nn = 0
      q = lp + 1
      d = 1
      while d == 1
        d = 0
        b = src:byte(q)
        if b >= 48 and b <= 57
          nn = nn * 10 + b - 48
          q = q + 1
          d = 1
      fc = src:byte(1)
      nl = lp - 1
      if fc == 102 and nl == 4
        result = affine(1103515245, 12345, 12345, nn) & 255
      if fc == 108 and nl == 3
        result = affine(1103515245, 12345, 12345, nn) & 255
      if fc == 112 and nl == 3
        result = powmod(1103515245, nn) & 255
      if fc == 102 and nl == 3
        result = fib(nn) & 255
      if fc == 103 and nl == 3
        result = affine(1103515245, 1, 0, nn) & 255
      if fc == 115 and nl == 4
        result = sumi(nn) & 255
      if fc == 115 and nl == 5
        result = sumsq(nn) & 255
      if fc == 115 and nl == 7
        result = sumcube(nn) & 255

  result

main: i64 = ()
  p = 0
  if run("fold(1000000000)") == 57
    p = p + 1
  if run("fold(987654321)") == 14
    p = p + 1
  if run("lcg(987654321)") == 14
    p = p + 1
  if run("pow(1000000000)") == 1
    p = p + 1
  if run("pow(987654321)") == 45
    p = p + 1
  if run("fib(1000000000)") == 59
    p = p + 1
  if run("fib(987654321)") == 98
    p = p + 1
  if run("geo(1000000000)") == 0
    p = p + 1
  if run("geo(987654321)") == 81
    p = p + 1
  if run("sumi(1000000000)") == 0
    p = p + 1
  if run("sumi(987654321)") == 137
    p = p + 1
  if run("sumsq(1000000000)") == 0
    p = p + 1
  if run("sumsq(987654321)") == 169
    p = p + 1
  if run("sumcube(1000000000)") == 0
    p = p + 1
  if run("sumcube(987654321)") == 81
    p = p + 1
  if run("loop 1000000000 12345 : 1103515245 * x + 12345") == 57
    p = p + 1
  if run("loop 987654321 5 : (x + 3) * 2") == 250
    p = p + 1
  if run("loop 1000000000 1 : 1103515245 * x") == 1
    p = p + 1
  if run("loop 1000000000 0 : 1103515245 * x + 1") == 0
    p = p + 1
  if run("loop 500 7 : 3 * x + 1") == 255
    p = p + 1
  if run("loop 123456789 1 : 7 * x + 13") == 36
    p = p + 1
  if run("sum 987654321 : i") == 137
    p = p + 1
  if run("sum 987654321 : i * i") == 169
    p = p + 1
  if run("sum 987654321 : i * i * i") == 81
    p = p + 1
  if run("sum 987654321 : 3 * i * i + 2 * i + 1") == 190
    p = p + 1
  if run("sum 987654321 : i * i * i + i") == 218
    p = p + 1
  if run("sum 987654321 : 5") == 117
    p = p + 1
  if run("sum 555555555 : 2 * i * i * i + 5 * i + 7") == 107
    p = p + 1
  if run("sum 100 : i * i * i * i") == 249
    p = p + 1
  p
