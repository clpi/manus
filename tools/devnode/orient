#!/bin/sh
set -eu

repo="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$repo"

head="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
dirty="$(git status --short 2>/dev/null | wc -l | tr -d ' ')"
p0="$(
  count=0
  for gap in gaps/GAP-*.md; do
    header="$(sed -n '1,8p' "$gap")"
    if printf '%s\n' "$header" | grep -Eiq '^\*\*Status:\*\*[[:space:]]*(OPEN|REOPENED)([[:space:]·(:—-]|$)' &&
       printf '%s\n' "$header" | grep -Eiq '^\*\*(Status|Priority):\*\*.*P0'; then
      count=$((count + 1))
    fi
  done
  echo "$count"
)"

origin="$(git remote get-url origin 2>/dev/null || echo unknown)"
echo "project: Idol"
echo "language: idol"
echo "canonicalsource: .id"
echo "devrepository: clpi/duo"
echo "releaserepository: idollang/idol"
echo "releasestatus: untouched until RELEASE_READINESS authorization"
echo "worktree: $repo"
echo "origin: $origin"
echo "head: $head"
echo "branch: $branch"
echo "dirtyentries: $dirty"
echo "host: $(uname -s) $(uname -m)"
echo "authority: AGENTS.md -> docs/spec/constitution.md -> CLAUDE.md -> docs/spec/AUTHORITY.md -> docs/bootstrap.md"
echo "pipeline: source/import -> graph -> demand -> realization -> machine"
echo "updateface: AGENTS.md -> scripts/idiomgate.id (bootstrap candidate gate; graph witness required)"
echo "bootstrapstage: S0 pinned Zig seed builds host compiler; executed lexer boundary; parser and later stages remain host-owned"
echo "activep0: $p0"
echo "frontier: close GAP-145 lexical identities, then GAP-134 generated grammar roles and immutable token view"
echo "mcpmanifest: tools/devnode/mcp.manifest.json"
mcp_log="$(mktemp "${TMPDIR:-/tmp}/idol-orient-mcp.XXXXXX")"
trap 'rm -f "$mcp_log"' EXIT
if "$repo/tools/devnode/probe-mcp" >"$mcp_log" 2>&1; then
  echo "mcphealth: raw initialize pass"
else
  echo "mcphealth: raw initialize fail"
  detail="$(sed -n '1p' "$mcp_log" | tr '\n' ' ')"
  [ -n "$detail" ] && echo "mcphealthdetail: $detail"
fi
echo "coordination: use duo_dev_claim_acquire for exact paths; never stash or hard reset; commit explicit pathspecs only"
echo "evidence: exact tree, command, executed path, outcome, and positive controls"
echo "avoid: historical .id semantics, pass documents as law, copied machine state, shadow specs, source-text identity reconstruction"
echo "nextboundary: smallest owned slice on lexical identity or grammar-role frontier after claiming paths"
