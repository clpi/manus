#!/bin/sh
set -eu

repo="$(cd "$(dirname "$0")/../.." && pwd)"
manifest="${IDSEM_MCP_MANIFEST:-$repo/tools/devnode/mcp.manifest.json}"
duo="${IDSEM_DUO_BIN:-$repo/zig-out/bin/duo}"

if ! command -v jq >/dev/null 2>&1; then
  echo "probe-mcp: jq is required" >&2
  exit 1
fi

if [ ! -x "$duo" ]; then
  echo "probe-mcp: missing compiler artifact: $duo" >&2
  exit 1
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/idsem-probe.XXXXXX")"
cleanup_root_artifacts() {
  find "$repo" -maxdepth 1 -type f \( -name '*.out' -o -name '*.profraw' -o -name 'test_*.c' -o -name 'test_*.wasm' \) -delete
}

trap 'rm -rf "$work"; cleanup_root_artifacts' EXIT

printf '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}\n' > "$work/init.json"

fail=0
jq -r '.servers[] | [.name, .entry, .backend] | @tsv' "$manifest" |
while IFS='	' read -r name entry backend; do
  out="$work/$name.response.json"
  if ! (cd "$work" && DUO_ROOT="$repo" DUO_BIN="$duo" "$duo" run "--backend=$backend" "$repo/$entry" < "$work/init.json" > "$out" 2>"$work/$name.err"); then
    echo "probe-mcp: $name process failed" >&2
    cat "$work/$name.err" >&2 || true
    exit 20
  fi
  if ! grep -q '"protocolVersion":"2024-11-05"' "$out"; then
    echo "probe-mcp: $name did not answer initialize" >&2
    cat "$out" >&2 || true
    exit 21
  fi
  echo "ok $name initialize"
done || fail=$?

exit "$fail"
