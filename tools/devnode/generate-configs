#!/bin/sh
set -eu

repo="$(cd "$(dirname "$0")/../.." && pwd)"
manifest="$repo/tools/devnode/mcp.manifest.json"
duo="$repo/zig-out/bin/duo"

if ! command -v jq >/dev/null 2>&1; then
  echo "generate-configs: jq is required" >&2
  exit 1
fi

if [ ! -x "$duo" ]; then
  echo "generate-configs: missing compiler artifact: $duo" >&2
  exit 1
fi

tmp="$(mktemp -d "${TMPDIR:-/tmp}/idsem-mcp.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$repo/.codex" "$repo/.cursor"

codex_out="$tmp/codex.toml"
cursor_out="$tmp/cursor.json"

{
  echo "# Generated from tools/devnode/mcp.manifest.json. Do not edit by hand."
  jq -r --arg repo "$repo" --arg duo "$duo" '
    .servers[] |
    "[mcp_servers." + .name + "]\n" +
    "command = " + ($duo|@json) + "\n" +
    "args = [\"run\", \"--backend=" + .backend + "\", " + (($repo + "/" + .entry)|@json) + "]\n" +
    "cwd = " + ($repo|@json) + "\n" +
    "startup_timeout_sec = " + (.startup_timeout_sec|tostring) + "\n" +
    "tool_timeout_sec = " + (.tool_timeout_sec|tostring) + "\n" +
    "required = " + (.required|tostring) + "\n\n" +
    "[mcp_servers." + .name + ".env]\n" +
    "DUO_ROOT = " + ($repo|@json) + "\n" +
    "DUO_BIN = " + ($duo|@json) + "\n"
  ' "$manifest"
} > "$codex_out"

jq --arg repo "$repo" --arg duo "$duo" '
  {
    mcpServers: (
      .servers
      | map({
          key: .name,
          value: {
            command: $duo,
            args: ["run", ("--backend=" + .backend), ($repo + "/" + .entry)],
            cwd: $repo,
            env: { DUO_ROOT: $repo, DUO_BIN: $duo }
          }
        })
      | from_entries
    )
  }
' "$manifest" > "$cursor_out"

if [ "${1:-}" = "--check" ]; then
  cmp -s "$codex_out" "$repo/.codex/mcp.generated.toml" || {
    echo "generate-configs: stale .codex/mcp.generated.toml" >&2
    exit 1
  }
  cmp -s "$cursor_out" "$repo/.cursor/mcp.json" || {
    echo "generate-configs: stale .cursor/mcp.json" >&2
    exit 1
  }
  exit 0
fi

cp "$codex_out" "$repo/.codex/mcp.generated.toml"
cp "$cursor_out" "$repo/.cursor/mcp.json"

codex_home="${CODEX_HOME:-$HOME/.codex}"
codex_config="$codex_home/config.toml"
mkdir -p "$codex_home"
touch "$codex_config"

clean="$tmp/config.toml"
awk '
  /^# BEGIN IDSEM MCP$/ { skip=1; next }
  /^# END IDSEM MCP$/ { skip=0; next }
  skip != 1 { print }
' "$codex_config" > "$clean"
{
  cat "$clean"
  printf "\n# BEGIN IDSEM MCP\n"
  cat "$repo/.codex/mcp.generated.toml"
  printf "# END IDSEM MCP\n"
} > "$codex_config"

echo "generated .codex/mcp.generated.toml"
echo "generated .cursor/mcp.json"
echo "updated $codex_config"
