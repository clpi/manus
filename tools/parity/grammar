#!/bin/sh
# parity/grammar — compare grammar-role projections by token identity.
#
# REPORT ONLY (Pickle Mission E): reports drift between the existing
# projections of the one grammar authority. Never chooses which side is
# correct and never rewrites a grammar role.
#
# Projections compared:
#   canonical   src/lexer.zig TokenKind ordinal count
#   current     lib/token/grammar_role.id   (ROLE_COUNT / KIND_EOF / BEGIN_EXPR)
#   legacy      lib/token/grammarrole.id    (ROLECOUNT / KINDEOF / BEGINEXPR)
#   tree-sitter ext/tree-sitter-idol/src/grammar.json (rule count, context)

set -eu
repo="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$repo"

python3 - <<'PY'
import json, re, sys

def enum_count(path):
    src = open(path).read()
    m = re.search(r'pub const TokenKind = enum\b(.*?\n\};)', src, re.S)
    if not m:
        return None
    fields = [l for l in m.group(1).split('\n')
              if re.match(r'\s*[a-z_0-9]+\s*(=\s*[0-9]+)?\s*,?\s*(//.*)?$', l)]
    return len(fields)

def id_projection(path, count_pat, eof_pat, vec_pat):
    try:
        src = open(path).read()
    except FileNotFoundError:
        return None
    c = re.search(count_pat, src)
    e = re.search(eof_pat, src)
    v = re.search(vec_pat, src, re.S)
    if not (c and e and v):
        return None
    vec = [int(x) for x in re.findall(r'-?\d+', v.group(1))]
    return {'count': int(c.group(1)), 'eof': int(e.group(1)), 'begin_expr': vec}

canonical = enum_count('src/lexer.zig')
current   = id_projection('lib/token/grammar_role.id',
                          r'ROLE_COUNT\s*=\s*(\d+)', r'KIND_EOF\s*=\s*(\d+)',
                          r'BEGIN_EXPR\s*=\s*\{(.*?)\}')
legacy    = id_projection('lib/token/grammarrole.id',
                          r'ROLECOUNT\s*=\s*(\d+)', r'KINDEOF\s*=\s*(\d+)',
                          r'BEGINEXPR\s*=\s*\{(.*?)\}')
try:
    ts = len(json.load(open('ext/tree-sitter-idol/src/grammar.json'))['rules'])
except Exception:
    ts = None

rows = [
    ('src/lexer.zig TokenKind (canonical)', canonical),
    ('lib/token/grammar_role.id (current)',  current['count'] if current else None),
    ('lib/token/grammarrole.id (legacy)',    legacy['count'] if legacy else None),
    ('tree-sitter idol rules (context)',     ts),
]
print('%-42s %s' % ('projection', 'token/rule count'))
for name, n in rows:
    print('%-42s %s' % (name, n if n is not None else 'ABSENT'))

print()
drift = []
if canonical and current and current['count'] != canonical:
    drift.append('current lib/token/grammar_role.id ROLE_COUNT=%d != canonical TokenKind=%d (stale by %d)'
                 % (current['count'], canonical, canonical - current['count']))
if canonical and legacy and legacy['count'] != canonical:
    drift.append('legacy lib/token/grammarrole.id ROLECOUNT=%d != canonical TokenKind=%d'
                 % (legacy['count'], canonical))
if current and legacy:
    a, b = current['begin_expr'], legacy['begin_expr']
    if a != b:
        i = next((k for k in range(min(len(a), len(b))) if a[k] != b[k]), min(len(a), len(b)))
        drift.append('BEGIN_EXPR vectors diverge at ordinal %d (lengths %d vs %d)'
                     % (i, len(a), len(b)))
    else:
        print('BEGIN_EXPR vectors agree (%d entries)' % len(a))
if current and canonical and current['eof'] is not None and current['eof'] >= current['count']:
    drift.append('current KIND_EOF=%d out of range for ROLE_COUNT=%d' % (current['eof'], current['count']))

if drift:
    print('DRIFT (report only — no side is chosen):')
    for d in drift:
        print('  - ' + d)
else:
    print('parity: all projections agree')
PY
