#!/bin/sh
set -u

# Regenerate the executed Idol lexer projection and prove both its derivation
# and its C ABI. This is a bounded bootstrap witness: delete it when the build
# consumes the Idol lexer directly and src/lexer_tokenize.c ceases to be a
# tracked bridge artifact.

LC_ALL=C
export LC_ALL

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../../../.." && pwd -P) || exit 1
compiler=${IDOL-}
tracked=${TRACKED-"$root/src/lexer_tokenize.c"}
cc=${CC-cc}

if [ -z "$compiler" ]; then
    printf '%s\n' 'lexer artifact: FAIL — set IDOL to the exact compiler binary' >&2
    exit 1
fi

case "$compiler" in
    */*)
        case "$compiler" in
            /*) ;;
            *)
                compiler_dir=$(CDPATH='' cd -- "$(dirname -- "$compiler")" && pwd -P) || {
                    printf 'lexer artifact: FAIL — compiler directory is unavailable: %s\n' "$compiler" >&2
                    exit 1
                }
                compiler="$compiler_dir/$(basename -- "$compiler")"
                ;;
        esac
        ;;
    *)
        compiler=$(command -v -- "$compiler") || {
            printf 'lexer artifact: FAIL — compiler is not executable: %s\n' "$compiler" >&2
            exit 1
        }
        case "$compiler" in
            /*) ;;
            *)
                compiler_dir=$(CDPATH='' cd -- "$(dirname -- "$compiler")" && pwd -P) || {
                    printf 'lexer artifact: FAIL — compiler directory is unavailable: %s\n' "$compiler" >&2
                    exit 1
                }
                compiler="$compiler_dir/$(basename -- "$compiler")"
                ;;
        esac
        ;;
esac

if [ ! -x "$compiler" ]; then
    printf 'lexer artifact: FAIL — compiler is not executable: %s\n' "$compiler" >&2
    exit 1
fi
case "$tracked" in
    /*) ;;
    *)
        tracked_dir=$(CDPATH='' cd -- "$(dirname -- "$tracked")" && pwd -P) || {
            printf 'lexer artifact: FAIL — tracked artifact directory is unavailable: %s\n' "$tracked" >&2
            exit 1
        }
        tracked="$tracked_dir/$(basename -- "$tracked")"
        ;;
esac
if [ ! -s "$tracked" ]; then
    printf 'lexer artifact: FAIL — tracked artifact is absent or empty: %s\n' "$tracked" >&2
    exit 1
fi
if ! command -v -- "$cc" >/dev/null 2>&1; then
    printf 'lexer artifact: FAIL — C compiler is unavailable: %s\n' "$cc" >&2
    exit 1
fi

base=${TMPDIR:-/tmp}
case "$base" in
    /*) ;;
    *)
        requested_base=$base
        base=$(CDPATH='' cd -- "$base" && pwd -P) || {
            printf 'lexer artifact: FAIL — temporary directory is unavailable: %s\n' "$requested_base" >&2
            exit 1
        }
        ;;
esac
work=$(mktemp -d "$base/idol-lexer-artifact.XXXXXX") || exit 1
cleanup() {
    rm -rf -- "$work"
}
trap cleanup EXIT HUP INT TERM

candidate="$work/candidate.c"
candidate_object="$work/candidate.o"
candidate_probe="$work/candidate-probe"
candidate_result="$work/candidate.result"
tracked_object="$work/tracked.o"
tracked_probe="$work/tracked-probe"
tracked_result="$work/tracked.result"
harness_object="$work/harness.o"

cd "$root" || exit 1
if ! "$compiler" dump-c lib/compiler/lexer.id --lib > "$candidate"; then
    printf '%s\n' 'lexer artifact: FAIL — canonical dump-c recipe failed' >&2
    exit 1
fi
if [ ! -s "$candidate" ]; then
    printf '%s\n' 'lexer artifact: FAIL — canonical dump-c recipe produced zero bytes' >&2
    exit 1
fi

status=0
if cmp -s "$candidate" "$tracked"; then
    printf '%s\n' 'lexer artifact: generated bytes match tracked artifact'
else
    candidate_bytes=$(wc -c < "$candidate" | tr -d ' ')
    tracked_bytes=$(wc -c < "$tracked" | tr -d ' ')
    printf 'lexer artifact: FAIL — byte mismatch (generated %s, tracked %s)\n' \
        "$candidate_bytes" "$tracked_bytes" >&2
    status=1
fi

if ! "$cc" -std=c11 -O0 -w -x c -c -o "$harness_object" - <<'EOF'
#include <inttypes.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

extern int64_t duo_lexer_tokenize_full(
    const char *, const char *, int64_t, int64_t, int64_t, int64_t, int64_t
);
extern int64_t recordslots(void);
extern int64_t fieldkind(void);
extern int64_t fieldline(void);
extern int64_t fieldcol(void);
extern int64_t fieldint(void);
extern int64_t fieldoff(void);
extern int64_t fieldlen(void);
extern int64_t fieldfloat(void);
extern const char *kindname(int64_t);

static int schema(int64_t slots, int64_t fields[7]) {
    fields[0] = fieldkind();
    fields[1] = fieldline();
    fields[2] = fieldcol();
    fields[3] = fieldint();
    fields[4] = fieldoff();
    fields[5] = fieldlen();
    fields[6] = fieldfloat();
    for (int64_t i = 0; i < 7; ++i) {
        if (fields[i] < 0 || fields[i] >= slots) return 0;
        for (int64_t j = 0; j < i; ++j) {
            if (fields[i] == fields[j]) return 0;
        }
    }
    return 1;
}

int main(void) {
    static const char source[] = "x = 1\n";
    static const char *const names[4] = {"name", "assign", "int_lit", "eof"};
    static const int64_t lines[4] = {1, 1, 1, 2};
    static const int64_t cols[4] = {1, 3, 5, 1};
    static const int64_t ints[4] = {0, 0, 1, 0};
    static const int64_t offsets[4] = {0, 2, 4, 6};
    static const int64_t lengths[4] = {1, 1, 1, 0};
    int64_t slots = recordslots();
    if (slots <= 0 || slots > 64) {
        fprintf(stderr, "probe: invalid record slot count: %" PRId64 "\n", slots);
        return 90;
    }
    int64_t fields[7];
    if (!schema(slots, fields)) {
        fprintf(stderr, "probe: record fields are not unique in-range positions\n");
        return 91;
    }

    int64_t *records = calloc((size_t)(16 * slots), sizeof(int64_t));
    if (records == NULL) return 92;

    int64_t count = duo_lexer_tokenize_full(
        source,
        "probe.id",
        1,
        (int64_t)(uintptr_t)records,
        16,
        0,
        0
    );
    if (count != 4) {
        fprintf(stderr, "probe: expected four token records, received %" PRId64 "\n", count);
        free(records);
        return 93;
    }

    for (int64_t i = 0; i < count; ++i) {
        const int64_t *record = records + i * slots;
        const char *name = kindname(record[fields[0]]);
        if (name == NULL || strcmp(name, names[i]) != 0) {
            fprintf(stderr, "probe: token %" PRId64 " kind is %s, expected %s\n",
                i, name == NULL ? "<null>" : name, names[i]);
            free(records);
            return 94;
        }
        if (record[fields[1]] != lines[i] || record[fields[2]] != cols[i]) {
            fprintf(stderr, "probe: token %" PRId64 " location is %" PRId64 ":%" PRId64
                ", expected %" PRId64 ":%" PRId64 "\n",
                i, record[fields[1]], record[fields[2]], lines[i], cols[i]);
            free(records);
            return 95;
        }
        if (record[fields[3]] != ints[i]) {
            fprintf(stderr, "probe: token %" PRId64 " integer is %" PRId64
                ", expected %" PRId64 "\n", i, record[fields[3]], ints[i]);
            free(records);
            return 96;
        }
        if (record[fields[4]] != offsets[i] || record[fields[5]] != lengths[i]) {
            fprintf(stderr, "probe: token %" PRId64 " span is %" PRId64 "+%" PRId64
                ", expected %" PRId64 "+%" PRId64 "\n",
                i, record[fields[4]], record[fields[5]], offsets[i], lengths[i]);
            free(records);
            return 97;
        }
        if ((uint64_t)record[fields[6]] != UINT64_C(0)) {
            fprintf(stderr, "probe: token %" PRId64 " has nonzero float bits\n", i);
            free(records);
            return 98;
        }
    }

    printf("records=%" PRId64 " slots=%" PRId64 "\n", count, slots);
    for (int64_t i = 0; i < count * slots; ++i) {
        printf("%016" PRIx64 "\n", (uint64_t)records[i]);
    }
    free(records);
    return 0;
}
EOF
then
    printf '%s\n' 'lexer artifact: FAIL — semantic probe harness did not compile' >&2
    exit 1
fi

compile() {
    label=$1
    source=$2
    object=$3
    executable=$4
    if ! "$cc" -std=c11 -O0 -w -Dmain=duo_lexer_tokenize_main \
        -c "$source" -o "$object"
    then
        printf 'lexer artifact: FAIL — %s artifact did not compile\n' "$label" >&2
        return 1
    fi
    if ! "$cc" "$harness_object" "$object" -lm -o "$executable"; then
        printf 'lexer artifact: FAIL — %s semantic probe did not link\n' "$label" >&2
        return 1
    fi
}

candidate_ready=1
tracked_ready=1
compile candidate "$candidate" "$candidate_object" "$candidate_probe" || candidate_ready=0
compile tracked "$tracked" "$tracked_object" "$tracked_probe" || tracked_ready=0
if [ "$candidate_ready" -eq 0 ] || [ "$tracked_ready" -eq 0 ]; then
    exit 1
fi

if ! "$candidate_probe" > "$candidate_result"; then
    printf '%s\n' 'lexer artifact: FAIL — candidate semantic probe failed' >&2
    status=1
fi
if ! "$tracked_probe" > "$tracked_result"; then
    printf '%s\n' 'lexer artifact: FAIL — tracked semantic probe failed' >&2
    status=1
fi
if [ "$status" -eq 0 ] || { [ -s "$candidate_result" ] && [ -s "$tracked_result" ]; }; then
    if cmp -s "$candidate_result" "$tracked_result"; then
        printf '%s\n' 'lexer artifact: generated and tracked token records agree'
    else
        printf '%s\n' 'lexer artifact: FAIL — generated token records differ from tracked artifact' >&2
        status=1
    fi
fi

if [ "$status" -ne 0 ]; then
    exit 1
fi
printf '%s\n' 'lexer artifact: PASS'
