#!/bin/sh
# hostcensus — classified host/world pattern census (migration evidence only).
#
# NOT semantic authority. Shell + git grep only — never std/proc/io namespaces.
# Authority: docs/spec/host.md · docs/spec/world.md · GAP-154
#
# Run: ./tools/node/dev/hostcensus

set -eu

repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo"

count() {
  needle="$1"
  n="$(git grep -F "$needle" -- \
    '*.id' '*.zig' '*.md' '*.mdc' '*.yaml' '*.ts' \
    2>/dev/null | wc -l | tr -d ' ')"
  printf '%s' "${n:-0}"
}

# Idol source only. Some needles are not violations outside `.id` at all --
# `std.` over `*.zig` is 12631 `@import("std")` lines that
# docs/spec/convergence-directive.md §6 states explicitly are NOT Idol
# violations, and a row that reports 13325 for a debt of 332 is not a ratchet,
# it is noise with a number on it.
countid() {
  needle="$1"
  n="$(git grep -F "$needle" -- '*.id' 2>/dev/null | wc -l | tr -d ' ')"
  printf '%s' "${n:-0}"
}

emit() {
  name="$1"
  class="$2"
  needle="$3"
  n="$(count "$needle")"
  total=$((total + n))
  printf '%s  %s  %s\n' "$name" "$class" "$n"
}

emitid() {
  name="$1"
  class="$2"
  needle="$3"
  n="$(countid "$needle")"
  total=$((total + n))
  printf '%s  %s  %s\n' "$name" "$class" "$n"
}

total=0

printf 'hostcensus: classified host/world pattern counts (migration evidence)\n'
printf 'authority: docs/spec/host.md · docs/spec/world.md · gap: GAP-154\n'
printf '\n'
printf '# --- violations (must ratchet down) ---\n'

emit os_args_call VIOLATION 'os.args('
emit os_getenv VIOLATION 'os.getenv('
emit environment_bracket VIOLATION 'environment['
emit environment_colon VIOLATION 'environment:'
emit io_read_dot VIOLATION 'io.read('
emit io_write_dot VIOLATION 'io.write('
emit io_open_dot VIOLATION 'io.open('
emit io_popen VIOLATION 'io.popen'
emit popen MIGRATION 'popen('
emit os_execute VIOLATION 'os.execute'
emit getenv MIGRATION 'getenv('
emitid std_dot VIOLATION 'std.'
emit proc_dot VIOLATION 'proc.'
emit use_paren VIOLATION 'use('
emit using_paren VIOLATION 'using('
emit core_dot VIOLATION 'core.'

printf '\n'
printf '# --- canonical targets (should grow as backfill proceeds) ---\n'

emit os_args_table CANONICAL 'os.args['
emit os_env_table CANONICAL 'os.env['
emit os_env_call CANONICAL 'os.env('
emit io_read_rel CANONICAL 'io:read'
emit io_write_rel CANONICAL 'io:write'

printf '\n'
printf 'total violation+migration hits: %s\n' "$total"
printf 'ratchet: new os.args( os.getenv environment io.read io.write std on added lines = 0\n'
printf '\n'
printf 'NOTE: std_dot here is `.id`-only and LINE-based -- a line with two reaches\n'
printf 'counts once, and a `std.` in a comment or a string literal counts as one.\n'
printf 'It is a trend line, not the ratchet. The GAP-157 authority is the\n'
printf 'position-aware census in gate/admission.sh:\n'
printf '\n'
printf '    sh gate/admission.sh --census-only\n'
printf '\n'
printf 'which lexes each line and charges only CODE-position reaches.\n'
