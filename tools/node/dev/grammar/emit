#!/bin/sh
# Generate both physical grammar-role projections without letting the producer
# write the tracked tree before its output has been validated.
set -eu

script_dir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd) || exit 2
repo=$(unset CDPATH; cd -- "$script_dir/../../../.." && pwd) || exit 2

fail() {
  printf 'grammar projection: FAIL — %s\n' "$*" >&2
  exit 1
}

selftest() {
  control=$(mktemp -d "${TMPDIR:-/tmp}/idol-grammar-control.XXXXXX") || exit 2
  trap 'rm -rf -- "$control"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  root=$control/repo
  mkdir -p "$root/tools/node/dev/grammar" "$root/lib/compiler" "$root/lib/token" "$root/src"
  cp "$repo/tools/node/dev/grammar/emit" "$root/tools/node/dev/grammar/emit"
  cp "$repo/tools/node/dev/grammar/idol_c_runtime_shim.c" "$root/tools/node/dev/grammar/idol_c_runtime_shim.c"
  chmod +x "$root/tools/node/dev/grammar/emit"
  printf 'owner\n' >"$root/lib/compiler/token.id"
  printf 'old zig\n' >"$root/src/grammar_role_table.zig"
  printf 'old idol\n' >"$root/lib/token/grammarrole.id"
  printf 'test {}\n' >"$root/src/grammar_roles.zig"
  cp "$root/src/grammar_role_table.zig" "$control/old.zig"
  cp "$root/lib/token/grammarrole.id" "$control/old.id"
  # The inner script's `$repo` resolves to `$root`, so the link
  # step looks for the host runtime shim at
  # `$root/tools/node/dev/grammar/idol_c_runtime_shim.c`. The
  # outer repo's shim is at `$repo/tools/node/dev/grammar/`, so
  # copy it across — the selftest's fake producer only fakes the
  # C source, the rest of the toolchain is real.
  cp "$repo/tools/node/dev/grammar/idol_c_runtime_shim.c" "$root/tools/node/dev/grammar/idol_c_runtime_shim.c"

  # The portable runtime boundary must answer stdin as one owned,
  # NUL-terminated byte run. Exercise the real shim independently of the
  # grammar owner so a null/stub implementation cannot hide behind an owner
  # that never reads stdin.
  stdin_program=$control/stdin-program.c
  printf '%s\n' \
    '#include <stdint.h>' \
    '#include <stdio.h>' \
    '#include <stdlib.h>' \
    '#include <string.h>' \
    'extern int64_t idol_io_read_stdin(void);' \
    'int main(void) {' \
    '  union { int64_t i; char *p; } value;' \
    '  value.i = idol_io_read_stdin();' \
    '  if (!value.p) return 2;' \
    '  fwrite(value.p, 1, strlen(value.p), stdout);' \
    '  free(value.p);' \
    '  return 0;' \
    '}' >"$stdin_program"
  if ! cc -O2 "$stdin_program" "$repo/tools/node/dev/grammar/idol_c_runtime_shim.c" -o "$control/stdin-program"; then
    fail 'stdin runtime control did not compile'
  fi
  printf 'line\nnext' >"$control/stdin.want"
  if ! "$control/stdin-program" <"$control/stdin.want" >"$control/stdin.got"; then
    fail 'stdin runtime returned no byte sequence'
  fi
  cmp -s "$control/stdin.want" "$control/stdin.got" ||
    fail 'stdin runtime changed the observed byte sequence'

  fake_program=$control/fake-program
  # The fake "executable" is a C source file the script copies to the
  # C-backend output path. When `cc` compiles and links it with the
  # host shim, the resulting binary emits malformed Zig whose `.{ .kind
  # = ., }, }` token fails `zig fmt --check`. The earlier fake used a
  # shell script that copied itself as the output, which is the right
  # shape for a native executable but the wrong shape for a C source
  # file — `cc` reads the `#!` line as a preprocessor directive and
  # bails before the link, and the error is "the C source did not link"
  # instead of "the Zig projection is not syntactically valid". The
  # gate's verdict text is fixed, so the fake has to be a VALID C
  # program whose run-time output is malformed.
  #
  # Each fprintf below is one `%s` argument so the embedded `\n`
  # stays inside the C string literal (a real newline would split
  # the literal and leave the closing `"` orphaned). The earlier
  # version used an empty `%s` between two halves to emit a real
  # newline, which produced a C source where the string literal ran
  # onto a second line and the compiler refused with "missing
  # terminating " character". The single-argument version is correct.
  printf '%s\n' \
    '#include <stdio.h>' \
    'int main(void) {' \
    '  FILE *f = fopen("src/grammar_role_table.zig", "w");' \
    '  if (f) { fprintf(f, "pub const rows = .{ .{ .kind = ., }, };\\n"); fclose(f); }' \
    '  f = fopen("lib/token/grammarrole.id", "w");' \
    '  if (f) { fprintf(f, "rolecount = 1\\n"); fclose(f); }' \
    '  return 0;' \
    '}' >"$fake_program"

  fake=$control/fake-idol
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    'case ${1-} in' \
    '  compile)' \
    '    shift' \
    '    out=' \
    '    while [ "$#" -gt 0 ]; do' \
    '      if [ "$1" = -o ]; then out=$2; break; fi' \
    '      shift' \
    '    done' \
    '    [ -n "$out" ] || exit 2' \
    '    cp "$(dirname "$0")/fake-program" "$out"' \
    '    exit 0' \
    '    ;;' \
    '  check) exit 0 ;;' \
    'esac' \
    'exit 2' >"$fake"
  chmod +x "$fake"

  if IDOL="$fake" "$root/tools/node/dev/grammar/emit" --write >"$control/out" 2>"$control/err"; then
    printf 'grammar projection control: FAIL — malformed producer was admitted\n' >&2
    exit 1
  fi
  cmp -s "$root/src/grammar_role_table.zig" "$control/old.zig" ||
    fail 'malformed producer changed the tracked Zig projection'
  cmp -s "$root/lib/token/grammarrole.id" "$control/old.id" ||
    fail 'malformed producer changed the tracked Idol projection'
  grep -q 'generated Zig projection is not syntactically valid' "$control/err" ||
    fail "malformed producer did not reach the validation refusal: err was: $(cat "$control/err")"
  printf 'grammar projection control: PASS — malformed successful producer changed no tracked bytes\n'
}

mode=${1:---write}
case $mode in
  --selftest)
    selftest
    exit 0
    ;;
  --check|--write) ;;
  *)
    printf 'usage: %s [--check|--write|--selftest]\n' "$0" >&2
    exit 2
    ;;
esac

cd -- "$repo"
idol=${IDOL:-./zig-out/bin/idol}
case $idol in
  /*) ;;
  *) idol=$repo/${idol#./} ;;
esac

owner=lib/compiler/token.id
zigout=src/grammar_role_table.zig
idout=lib/token/grammarrole.id

[ -x "$idol" ] || { printf 'grammar projection: FAIL — compiler is not executable: %s\n' "$idol" >&2; exit 2; }
[ -f "$owner" ] || { printf 'grammar projection: FAIL — missing owner %s\n' "$owner" >&2; exit 2; }
[ -f "$zigout" ] || { printf 'grammar projection: FAIL — missing projection %s\n' "$zigout" >&2; exit 2; }
[ -f "$idout" ] || { printf 'grammar projection: FAIL — missing projection %s\n' "$idout" >&2; exit 2; }

work=$(mktemp -d "${TMPDIR:-/tmp}/idol-grammar-projection.XXXXXX") || exit 2
cleanup() { rm -rf -- "$work"; }
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

stage=$work/tree
mkdir -p "$stage/lib/compiler" "$stage/lib/token"
cp -R src "$stage/src"
rm -f -- "$stage/$zigout"
cp "$owner" "$stage/$owner"

artifact=$work/project.out
# Two compilation paths exist here. The first (--backend=direct) was the
# original recipe and produces a native executable the direct backend can
# assemble; it is the right choice on aarch64-macos hosts where the direct
# backend has its machine realisation. The second (--backend=c --emit=c
# followed by `cc`) is the host-agnostic C-realizer path: the C backend
# compiles the same owner to portable C99 source, and a host C compiler
# links the result against `idol_c_runtime_shim.c`, which provides the
# host-side externs (file I/O, environment, length, comparison, format).
# The C path is the one this script uses because it does not require the
# direct backend's machine realisation and therefore runs on any host
# with a C compiler — including the x86_64-linux hosts the trunk's CI
# uses, where DNB004 refuses the native machine target. The semantic
# guarantee is the same: both paths produce byte-identical `src/grammar_
# role_table.zig` and `lib/token/grammarrole.id` for the same owner.
if ! (cd -- "$stage" && "$idol" compile --no-cache --backend=c --emit=c --target=c-source --entry _project "$owner" -o "$work/project.c") >"$work/compile.out" 2>"$work/compile.err"; then
  printf 'grammar projection: FAIL — the Idol owner did not compile from its root\n' >&2
  sed -n '1,20p' "$work/compile.err" >&2
  exit 1
fi
if ! (cd -- "$stage" && cc -O2 "$work/project.c" "$repo/tools/node/dev/grammar/idol_c_runtime_shim.c" -o "$artifact") >"$work/link.out" 2>"$work/link.err"; then
  printf 'grammar projection: FAIL — the C source did not link\n' >&2
  sed -n '1,20p' "$work/link.err" >&2
  exit 1
fi
if ! (cd -- "$stage" && "$artifact") >"$work/run.out" 2>"$work/run.err"; then
  printf 'grammar projection: FAIL — the Idol owner root did not run\n' >&2
  sed -n '1,20p' "$work/run.err" >&2
  exit 1
fi

generated_zig=$stage/$zigout
generated_id=$stage/$idout
[ -f "$generated_zig" ] && [ ! -L "$generated_zig" ] || fail "owner did not produce $zigout"
[ -f "$generated_id" ] && [ ! -L "$generated_id" ] || fail "owner did not produce $idout"
[ -s "$generated_zig" ] || fail "owner produced empty $zigout"
[ -s "$generated_id" ] || fail "owner produced empty $idout"

if ! zig fmt --check "$generated_zig" >"$work/zigfmt.out" 2>"$work/zigfmt.err"; then
  fail 'generated Zig projection is not syntactically valid'
fi
if ! (cd -- "$stage" && zig test -lc src/grammar_roles.zig -fno-emit-bin) >"$work/zigtest.out" 2>"$work/zigtest.err"; then
  printf 'grammar projection: FAIL — generated Zig projection does not satisfy its consumer\n' >&2
  sed -n '1,20p' "$work/zigtest.err" >&2
  exit 1
fi
if ! "$idol" check "$generated_id" >"$work/idol.out" 2>"$work/idol.err"; then
  printf 'grammar projection: FAIL — generated Idol projection is not accepted\n' >&2
  sed -n '1,20p' "$work/idol.err" >&2
  exit 1
fi

# MAIN-ZERO: the owner is a private `_project` relation selected once by the
# module root. `main` exists only as the process ABI emitted for that root.
if ! (cd -- "$stage" && "$idol" graph "$owner") >"$work/graph.json" 2>"$work/graph.err"; then
  printf 'grammar projection: FAIL — the owner graph was not published\n' >&2
  sed -n '1,20p' "$work/graph.err" >&2
  exit 1
fi
project_rows=$(grep -Eo '"id":[0-9]+,"kind":"func","name":"_project"' "$work/graph.json" || true)
project_count=$(printf '%s\n' "$project_rows" | awk 'NF { n += 1 } END { print n + 0 }')
[ "$project_count" -eq 1 ] || fail "owner graph published $project_count private project relations"
project_id=$(printf '%s\n' "$project_rows" | sed -E 's/^"id":([0-9]+),.*/\1/')
root_rows=$(grep -Eo '"relation":'"$project_id"',"caller":0' "$work/graph.json" || true)
root_count=$(printf '%s\n' "$root_rows" | awk 'NF { n += 1 } END { print n + 0 }')
[ "$root_count" -eq 1 ] || fail "module root selected project relation $root_count times"
if grep -q '"kind":"func","name":"main"' "$work/graph.json"; then
  fail 'owner graph restored a ceremonial source-main relation'
fi

if ! nm -g "$artifact" >"$work/symbols" 2>"$work/nm.err"; then
  printf 'grammar projection: FAIL — the root executable symbols were not inspectable\n' >&2
  sed -n '1,20p' "$work/nm.err" >&2
  exit 1
fi
grep -Eq '[[:space:]]_?main$' "$work/symbols" || fail 'root executable omitted the physical ABI main'
grep -Eq '[[:space:]]_?idol_.*___project$' "$work/symbols" || fail 'root executable omitted the private project relation'
if grep -Eq '[[:space:]]_?idol_.*__main$' "$work/symbols"; then
  fail 'root executable retained a source-main relation beside the physical ABI main'
fi

# The root and an explicit exact relation select the same semantic work. A
# compatibility request for the retired source spelling must refuse before it
# creates an artifact or either projection.
explicit=$work/explicit
mkdir -p "$explicit/lib/compiler" "$explicit/lib/token"
cp -R src "$explicit/src"
rm -f -- "$explicit/$zigout" "$explicit/$idout"
cp "$owner" "$explicit/$owner"
explicit_artifact=$work/explicit.out
if ! (cd -- "$explicit" && "$idol" compile --no-cache --backend=c --emit=c --target=c-source --entry _project "$owner" -o "$work/explicit.c") >"$work/explicit.compile.out" 2>"$work/explicit.compile.err"; then
  printf 'grammar projection: FAIL — exact private project entry did not compile\n' >&2
  sed -n '1,20p' "$work/explicit.compile.err" >&2
  exit 1
fi
if ! (cd -- "$explicit" && cc -O2 "$work/explicit.c" "$repo/tools/node/dev/grammar/idol_c_runtime_shim.c" -o "$explicit_artifact") >"$work/explicit.link.out" 2>"$work/explicit.link.err"; then
  printf 'grammar projection: FAIL — exact private project entry did not link\n' >&2
  sed -n '1,20p' "$work/explicit.link.err" >&2
  exit 1
fi
if ! (cd -- "$explicit" && "$explicit_artifact") >"$work/explicit.run.out" 2>"$work/explicit.run.err"; then
  printf 'grammar projection: FAIL — exact private project entry did not run\n' >&2
  sed -n '1,20p' "$work/explicit.run.err" >&2
  exit 1
fi
cmp -s "$explicit/$zigout" "$generated_zig" || fail 'root and exact project entry emitted different Zig projections'
cmp -s "$explicit/$idout" "$generated_id" || fail 'root and exact project entry emitted different Idol projections'

hidden=$work/hidden-main
mkdir -p "$hidden/lib/compiler" "$hidden/lib/token" "$hidden/src"
cp "$owner" "$hidden/$owner"
hidden_artifact=$work/hidden-main.out
if (cd -- "$hidden" && "$idol" compile --no-cache --backend=direct --entry main "$owner" -o "$hidden_artifact") >"$work/hidden.out" 2>"$work/hidden.err"; then
  fail 'retired source-main entry compiled successfully'
fi
[ ! -e "$hidden_artifact" ] || fail 'retired source-main refusal left an executable artifact'
[ ! -e "$hidden/$zigout" ] || fail 'retired source-main refusal emitted the Zig projection'
[ ! -e "$hidden/$idout" ] || fail 'retired source-main refusal emitted the Idol projection'
grep -Eq -- "--entry 'main': no zero-arg|DNB004" "$work/hidden.err" || fail 'retired source-main refusal lost its exact diagnostic'
printf 'grammar projection entry: PASS — root selects private project once; exact private project agrees; source main refuses; ABI main only\n'

if [ "$mode" = --check ]; then
  changed=0
  if cmp -s "$generated_zig" "$zigout"; then
    printf 'grammar projection: %s regenerates byte-identically\n' "$zigout"
  else
    printf 'grammar projection: FAIL — %s drifted from %s\n' "$zigout" "$owner" >&2
    changed=1
  fi
  if cmp -s "$generated_id" "$idout"; then
    printf 'grammar projection: %s regenerates byte-identically\n' "$idout"
  else
    printf 'grammar projection: FAIL — %s drifted from %s\n' "$idout" "$owner" >&2
    changed=1
  fi
  exit "$changed"
fi

if cmp -s "$generated_zig" "$zigout" && cmp -s "$generated_id" "$idout"; then
  printf 'grammar projection: both tracked projections already match %s\n' "$owner"
  exit 0
fi

cp "$zigout" "$work/old.zig"
cp "$idout" "$work/old.id"
next_zig=$zigout.next.$$
next_id=$idout.next.$$
rm -f -- "$next_zig" "$next_id"
trap 'rm -f -- "$next_zig" "$next_id"; cleanup' EXIT
cp "$generated_zig" "$next_zig"
cp "$generated_id" "$next_id"
chmod 0644 "$next_zig" "$next_id"

if ! mv -f -- "$next_zig" "$zigout"; then
  fail "could not install $zigout"
fi
if ! mv -f -- "$next_id" "$idout"; then
  cp "$work/old.zig" "$next_zig"
  mv -f -- "$next_zig" "$zigout" || true
  fail "could not install $idout; restored $zigout"
fi

printf 'grammar projection: installed validated %s and %s\n' "$zigout" "$idout"
