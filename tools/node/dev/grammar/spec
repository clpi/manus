#!/bin/sh
# tools/node/dev/grammar/spec — project owner grammar facts into the
# generated region of docs/spec/grammar.md (GAP-134 item 5).
#
# One producer: reads src/grammar_role_table.zig, the bridge lib/compiler/
# token.id regenerates (law.grammar.one). Every row below is a fact the
# owner already publishes; nothing is invented here.
#
# GEN_ROOT overrides the repo root (used by the gate's damage control).
# Output: the FULL markdown file on stdout (generated region spliced
# between markers). Exit 3 = the bridge or markers could not be read.
set -u
root=${GEN_ROOT:-$(unset CDPATH; cd -- "$(dirname -- "$0")/../../../.." && pwd)}
bridge=$root/src/grammar_role_table.zig
md=$root/docs/spec/grammar.md

fail() { printf 'grammar spec generator: %s\n' "$*" >&2; exit 3; }
[ -s "$bridge" ] || fail "missing owner bridge $bridge"
[ -s "$md" ] || fail "missing projection target $md"

rows=$(awk '
  /^    \.\{ \.kind = \./ {
    line=$0; sub(/^    \.\{ /,"",line); sub(/ \},$/,"",line)
    print line
  }
' "$bridge")
[ -n "$rows" ] || fail "owner bridge carries no role rows"

region=$(printf '%s\n' "$rows" | awk -F', ' '
  function esc(s) { gsub(/\|/, "\\|", s); return s }
  BEGIN { n = 0; ids = ""; nprec = 0 }
  {
    kind=""; spell=""; prec=""; assoc="none"; be=0
    for (i=1; i<=NF; i++) {
      if ($i ~ /^\.kind = /) { kind=$i; sub(/^\.kind = \./,"",kind) }
      if ($i ~ /^\.spell = /) { spell=$i; sub(/^\.spell = "/,"",spell); sub(/"$/,"",spell) }
      if ($i ~ /^\.precedence = /) { prec=$i; sub(/^\.precedence = /,"",prec) }
      if ($i ~ /^\.assoc = \./) { assoc=$i; sub(/^\.assoc = \./,"",assoc) }
      if ($i == ".begin_expr = true") be=1
    }
    if (be) {
      if (ids != "") ids = ids " "
      ids = ids kind " " esc(spell)
      n++
    }
    if (prec != "") {
      nprec++
      precline[nprec] = sprintf("  %-4s %-14s %s", prec, spell, assoc)
    }
  }
  END {
    print "| 1 | <!-- grammar:begin --> |"
    print ""
    print "| section |"
    print "|---|---|"
    print "| Grammar facts (generated) |"
    print ""
    print "| # | directive |"
    print "|---|---|"
    print "| 1 | <!-- Generated from lib/compiler/token.id via src/grammar_role_table.zig. |"
    print "| 2 | Regenerate: idol run lib/compiler/token.id, then sh gate/grammar/spec.sh. |"
    print "| 3 | Every row is an owner fact; the prose around it is authored law. --> |"
    print ""
    print "| # | directive |"
    print "|---|---|"
    print "| 1 | One grammar-fact owner (law.grammar.one): lib/compiler/token.id. |"
    print ""
    print "| # | directive |"
    print "|---|---|"
    print "| 1 | " ids " |"
    print ""
    print "| # | directive |"
    print "|---|---|"
    printf "| 1 | Total: %d identities. |\n", n
    print ""
    print "| section |"
    print "|---|---|"
    print "| Operator precedence and associativity |"
    print ""
    print "| # | directive |"
    print "|---|---|"
    print "| 1 | Highest number binds tightest (Pratt binding power from the owner): |"
    print ""
    print "```text"
    for (i=1; i<=nprec; i++) print precline[i]
    print "```"
    print "| # | directive |"
    print "|---|---|"
    print "| 1 | <!-- grammar:end --> |"
  }
')
[ -n "$region" ] || fail "owner bridge projected to an empty region"

GEN_CONTENT="$region" awk '
  BEGIN { gen=ENVIRON["GEN_CONTENT"]; mb="<!-- grammar:begin -->"; me="<!-- grammar:end -->" }
  index($0, mb) { skipping=1; if (!done) { print gen; done=1 }; next }
  index($0, me) { skipping=0; next }
  !skipping { print }
' "$md"
