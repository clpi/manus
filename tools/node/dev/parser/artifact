static int verify_declaration(const char *source, int64_t expected) {
    int64_t facts[256] = {0};
    int64_t events[256] = {0};
    int64_t count = tokenize(source, facts);
    int64_t written = idol_parser_event(facts, count, events, count * 2, true);
    int64_t found = (events[count] >> 9) & 15;
    if (written != count || found != expected) {
        fprintf(stderr, "%s declaration-event=%lld written=%lld expected=%lld\n", source, (long long)found, (long long)written, (long long)expected);
