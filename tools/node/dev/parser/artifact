result() {
    [ -s "$1" ] || return 1
    line_count=$(wc -l < "$1" | tr -d ' ')
    [ "$line_count" = 1 ] || return 1
    IFS= read -r line < "$1" || return 1
    [ "$line" = "$expected_cursor_result" ]
}

require_result() {
    label=$1
    path=$2
    if result "$path"; then
        return 0
    fi
    if [ ! -s "$path" ]; then
        printf 'parser artifact: FAIL — %s cursor/pack result is absent or empty\n' "$label" >&2
    else
        printf 'parser artifact: FAIL — %s cursor/pack result is not the exact passing verdict\n' "$label" >&2
        tr -d '\n' < "$path" >&2
        printf '\n' >&2
    fi
    return 1
}

