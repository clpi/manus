compile_and_run() {
    label=$1
    source=$2
    object="$work/$label.o"
    cursor_executable="$work/$label-cursor"
    cursor_result="$work/$label.cursor.result"
    if ! "$cc" -std=c11 -O2 -w \
        -Dmain=idol_parser_projection_main \
        '-Dboundary(...)=idol_parser_boundary(__VA_ARGS__)' \
        '-Devent(...)=idol_parser_event(__VA_ARGS__)' \
        -Dis_digit=idol_parser_is_digit \
        -c "$source" -o "$object"
    then
        printf 'parser artifact: FAIL — %s projection did not compile\n' "$label" >&2
        return 1
    fi
    if ! "$cc" -std=c11 -O2 -w \
        -Dmain=idol_parser_projection_main \
        '-Dboundary(...)=idol_parser_boundary(__VA_ARGS__)' \
        '-Devent(...)=idol_parser_event(__VA_ARGS__)' \
        -Dis_digit=idol_parser_is_digit \
        -include "$source" "$cursor_harness" -lm -o "$cursor_executable"
    then
        printf 'parser artifact: FAIL — %s cursor/pack probe did not compile\n' "$label" >&2
        return 1
    fi
    rm -f -- "$cursor_result"
    if ! "$cursor_executable" > "$cursor_result"; then
        printf 'parser artifact: FAIL — %s cursor/pack probe disagreed\n' "$label" >&2
        return 1
    fi
    require_result "$label" "$cursor_result"
}

