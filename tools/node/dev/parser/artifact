static int64_t projected_ordinal(const char *row, size_t kind) {
    const unsigned char code = (unsigned char)row[kind];
    if (code == '.') return -1;
    if (code < 'A' || code > 'Z') return -2;
    return (int64_t)(code - 'A');
}

static bool row_bit(const char *row, size_t kind) {
    return row[kind] == '1';
}

static int64_t expected_statement(int64_t kind) {
    switch (kind) {
        case 81: return 1;  /* at */
        case 19: return 2;  /* local */
        case 15: return 3;  /* global */
        case 29: return 4;  /* const */
        case 13: case 14: return 5;  /* function / fun */
        case 48: return 6;  /* async */
        case 30: return 7;  /* enum */
        case 50: return 8;  /* concept */
        case 51: return 9;  /* alias */
        case 17: return 10; /* if */
        case 28: return 11; /* while */
        case 23: return 12; /* repeat */
        case 12: return 13; /* for */
        case 7: return 14;  /* do */
        case 44: return 15; /* match */
        case 45: return 16; /* try */
        case 47: return 17; /* defer */
        case 16: return 18; /* goto */
        case 5: return 19;  /* break */
        case 6: return 20;  /* continue */
        case 95: return 21; /* dcolon label */
        case 0: return 22;  /* contextual name */
        default: return 0;  /* expression */
    }
}

static int64_t expected_admission_row(int64_t kind) {
    switch (kind) {
        case 54: return 1;             /* macro: always denied */
        case 45: case 46: return 2;    /* try / catch */
        case 47: return 3;             /* defer */
        case 16: return 4;             /* goto */
        case 53: return 5;             /* extends */
        case 52: return 6;             /* private */
        case 48: case 49: return 7;    /* async / await */
        case 57: return 8;             /* let */
        default: return 0;
    }
}

static int64_t expected_admission(int64_t kind, bool idol) {
    const int64_t face = expected_admission_row(kind);
    return face == 1 || idol ? face : 0;
}

static int64_t expected_infix(int64_t kind) {
    if (!token_grammarrole___roleinfix(kind)) return 0;
    const int64_t prec = token_grammarrole__roleprecedence(kind);
    const int64_t assoc = token_grammarrole__roleassoc(kind);
    const int64_t op = projected_ordinal(token_grammarrole__relation(), (size_t)kind);
    if (prec == 0 || assoc == 0 || op < 0) return 0;
    int64_t right = prec;
    if (assoc == 1) right = prec + 1;
    if (assoc == 2) right = prec - 1;
    return op | (prec << 8) | (right << 16);
}

static int64_t expected_face(const char *row, bool admitted, int64_t kind) {
    if (!admitted) return 0;
    const int64_t ordinal = projected_ordinal(row, (size_t)kind);
    return ordinal < 0 ? 0 : ordinal + 1;
}

static int64_t first_kind(const char *source);
static int64_t first_kind_at(const char *source, const char *file);

static int64_t expected_event(int64_t kind, bool idol) {
    const int64_t member = kind == 0 || (kind >= 4 && kind <= 57);
    const int64_t boundary = kind == 10 || kind == 27 || kind == 59 ||
        kind == 61 || kind == 63 || kind == 109;
    const int64_t branch = kind == 9 ? 1 : (kind == 8 ? 2 : 0);
    const int64_t returns = kind == 24;
    const int64_t ending = kind == 10;
    const int64_t terminator = kind == 8 || kind == 9 || kind == 10 ||
        kind == 27 || kind == 46 || kind == 109;
    const int64_t empty = terminator && kind != 109;
    const int64_t primitive = token_grammarrole__roledescriptor(kind);
    const int64_t literal = row_bit(token_grammarrole__literal(), (size_t)kind);
    const int64_t quoted = row_bit(token_grammarrole__quoted(), (size_t)kind);
    const int64_t prefix = row_bit(token_grammarrole__prefix(), (size_t)kind);
    const int64_t demand = row_bit(token_grammarrole__demand(), (size_t)kind);
    const int64_t lead = row_bit(token_grammarrole__lead(), (size_t)kind);
    const int64_t infix = expected_infix(kind);
    const int64_t unary = expected_face(token_grammarrole__unary(), true, kind);
    const int64_t glue = expected_face(token_grammarrole__relation(), token_grammarrole___roleglue(kind), kind);
    const int64_t update = expected_face(token_grammarrole__relation(), token_grammarrole___roleupdate(kind), kind);
    const int64_t primary = kind == first_kind("x") ||
        kind == first_kind("42") || kind == first_kind("3.5") ||
        kind == first_kind("*") || kind == first_kind("?") ||
        kind == first_kind("(") || kind == first_kind("<");
    const int64_t layout_type = primitive || kind == first_kind("*") ||
        kind == first_kind("?") || kind == first_kind("[") || kind == first_kind("{");
    const int64_t callface = kind == first_kind("(");
    return expected_statement(kind) |
        (expected_admission(kind, idol) << 5) |
        (member << 9) | (boundary << 10) | (branch << 11) |
        (returns << 13) | (ending << 14) | (terminator << 15) |
        (empty << 16) | (primitive << 17) | (literal << 18) |
        (quoted << 19) | (prefix << 20) | (demand << 21) | (lead << 22) |
        (infix << 23) | (unary << 47) | (glue << 52) | (update << 57) |
        (primary << 61) | (layout_type << 62) | (callface << 63);
}

static int verify_event(void) {
    int64_t facts[229] = {0};
    int failed = 0;
    for (int64_t kind = 0; kind < 114; ++kind) {
        facts[1 + kind * 2] = kind + (kind + 1) * INT64_C(256) + INT64_C(68719476736);
    }
    for (int idol = 0; idol <= 1; ++idol) {
        int64_t short_out[230];
        int64_t out[230];
        for (int i = 0; i < 230; ++i) short_out[i] = 777;
        if (idol_parser_event(facts, 114, &short_out[1], 227, idol != 0) != -1) failed += 1;
        for (int i = 0; i < 230; ++i) if (short_out[i] != 777) failed += 1;
        for (int i = 0; i < 230; ++i) out[i] = 0;
        out[0] = 71;
        out[229] = 75;
        if (idol_parser_event(facts, 114, &out[1], 228, idol != 0) != 114) failed += 1;
        if (out[0] != 71 || out[229] != 75) failed += 1;
        for (int64_t kind = 0; kind < 114; ++kind) {
            if (out[1 + kind] != expected_event(kind, idol != 0)) failed += 1;
            const int64_t decision = out[1 + 114 + kind];
            const int64_t delimiter = decision >> 13;
            if (decision < 0 || delimiter > 114) failed += 1;
            if (((decision >> 5) & 1) != (kind == first_kind("x"))) failed += 1;
            int64_t expected_delimiter = 0;
            if (kind == first_kind("|")) expected_delimiter = 1;
            else if (kind == first_kind("42")) expected_delimiter = 2;
            else if (kind == first_kind("3.5")) expected_delimiter = 3;
            else if (kind == first_kind("nil")) expected_delimiter = 4;
            else if (kind == 107) expected_delimiter = 5;
            else if (kind == first_kind("\"text\"")) expected_delimiter = 6;
            else if (kind == first_kind("'bytes'")) expected_delimiter = 7;
            else if (kind == first_kind_at("[[compat]]", "probe.duo")) expected_delimiter = 8;
            else if (kind == first_kind("true")) expected_delimiter = 9;
            else if (kind == first_kind("false")) expected_delimiter = 10;
            else if (kind == first_kind("...")) expected_delimiter = 11;
            else if (kind == first_kind("function") || kind == first_kind("fun")) expected_delimiter = 12;
            else if (kind == first_kind("if")) expected_delimiter = 13;
            else if (kind == first_kind("match")) expected_delimiter = 14;
            else if (kind == first_kind(".")) expected_delimiter = 15;
            else if (kind == first_kind(":")) expected_delimiter = 16;
            else if (kind == first_kind("@")) expected_delimiter = 17;
            else if (kind == 84) expected_delimiter = 18;
            else if (kind == first_kind("[")) expected_delimiter = 19;
            else if (kind == first_kind("else")) expected_delimiter = 20;
            else if (kind == first_kind("-")) expected_delimiter = 21;
            else if (kind == first_kind("..")) expected_delimiter = 22;
            else if (kind == first_kind("?")) expected_delimiter = 24;
            else if (kind == first_kind("!")) expected_delimiter = 25;
            else if (kind == first_kind("await")) expected_delimiter = 27;
            else if (kind == first_kind("comptime")) expected_delimiter = 28;
            else if (kind == first_kind("not")) expected_delimiter = 29;
            else if (kind == first_kind("by")) expected_delimiter = 30;
            else if (kind == first_kind("then") || kind == first_kind("do") || kind == first_kind("=>")) expected_delimiter = 31;
            else if (kind == first_kind("catch")) expected_delimiter = 32;
            else if (kind == first_kind("(")) expected_delimiter = 60;
            if (delimiter != expected_delimiter) failed += 1;
        }
    }
    return failed;
}

static int verify_event_lead_trivia(void) {
    const char *row = token_grammarrole__lead();
    int64_t lead_kind = -1;
    for (int64_t kind = 0; kind < 110; ++kind) {
        if (row_bit(row, (size_t)kind)) {
            lead_kind = kind;
            break;
        }
    }
    if (lead_kind < 0) return 1;
    int64_t facts[7] = {0};
    int64_t out[6] = {0};
    facts[1] = INT64_C(0) + INT64_C(1) * 256;       /* visible name, line 1 */
    facts[3] = INT64_C(111) + INT64_C(2) * 256;     /* skipped comment, line 2 */
    facts[5] = lead_kind + INT64_C(2) * 256;        /* new visible line */
    int failed = idol_parser_event(facts, 3, out, 6, true) != 3;
    if (((out[1] >> 22) & 1) != 0) failed += 1;
    if (((out[2] >> 22) & 1) != 1) failed += 1;
    facts[5] = lead_kind + INT64_C(1) * 256;        /* same visible line */
    if (idol_parser_event(facts, 3, out, 6, true) != 3) failed += 1;
    if (((out[2] >> 22) & 1) != 0) failed += 1;
    return failed;
}

static int64_t expected_event_boundary(int64_t kind) {
    int64_t action = 0;
    int64_t face = 0;
    if (kind == 10 || kind == 27 || kind == 59 || kind == 61 || kind == 63 || kind == 109)
        action = 1;
    if (kind == 9) { action = 1; face = 1; }
    if (kind == 8) { action = 1; face = 2; }
    if (kind == 24) action = 3;
    const int64_t closing = kind == 10 ? 1 : 4;
    return action | (face << 2) | (closing << 4);
}

static int verify_event_boundary(void) {
    int failed = 0;
    for (int64_t kind = 0; kind < 114; ++kind) {
        const int64_t got = idol_parser_boundary(
            false, 0, false, 0, 5, 0, expected_event(kind, false), 1, 1, 8, false);
        if (got != expected_event_boundary(kind)) failed += 1;
    }
    return failed;
}

static int verify_admission(void) {
    const char *row = token_grammarrole__admission();
    const size_t count = strlen(row);
    int failed = count != 114;
    for (size_t kind = 0; kind < count; ++kind) {
        if (projected_ordinal(row, kind) != expected_admission_row((int64_t)kind)) failed += 1;
    }
    return failed;
}

static int verify_statement_face(void) {
    const char *row = token_grammarrole__statement();
    const size_t count = strlen(row);
    int failed = count != 114;
    for (size_t kind = 0; kind < count; ++kind) {
        const int64_t expected = expected_statement((int64_t)kind);
        if (projected_ordinal(row, kind) != expected) failed += 1;
    }
    return failed;
}

static int verify_boundary(void) {
    const char *ends = token_grammarrole__boundary();
    const char *branches = token_grammarrole__branch();
    const size_t count = strlen(ends);
    int failed = count == 0 || strlen(branches) != count;
    size_t end_count = 0;
    size_t branch_count = 0;
    for (size_t kind = 0; kind < count; ++kind) {
        const int64_t event = expected_event((int64_t)kind, false);
        const int64_t got = idol_parser_boundary(false, 0, false, 0, 5, 0, event, 1, 1, 8, false);
        int64_t expected = 0;
        if (row_bit(ends, kind) || row_bit(branches, kind)) expected = 1;
        if (kind == 24) expected = 3; /* kw_return */
        if ((got & 0x3) != expected) failed += 1;
        end_count += row_bit(ends, kind);
        branch_count += row_bit(branches, kind);
    }
    if (end_count != 6 || branch_count != 2) failed += 1;

    const int64_t ordinary = expected_event(0, false);
    const int64_t branch = expected_event(8, false);
    const int64_t established = idol_parser_boundary(false, 1, true, 0, 5, 0, ordinary, 2, 1, 8, false);
    if ((established & 0x3) != 0 || ((established >> 8) & 0x0FFFFFFF) != 8) failed += 1;
    if ((idol_parser_boundary(false, 1, true, 0, 5, 8, ordinary, 2, 1, 7, false) & 0x3) != 2) failed += 1;
    if ((idol_parser_boundary(false, 1, true, 0, 5, 8, branch, 2, 1, 8, false) & 0x3) != 0) failed += 1;
    if ((idol_parser_boundary(false, 1, true, 0, 5, 8, branch, 2, 1, 7, false) & 0x3) != 1) failed += 1;
    if ((idol_parser_boundary(false, 1, true, 0, 5, 8, branch, 1, 1, 8, false) & 0x3) != 0) failed += 1;
    if ((idol_parser_boundary(false, 0, false, 0, 5, 0, expected_event(24, false), 1, 1, 8, false) & 0x3) != 3) failed += 1;
    return failed;
}

static int verify_boundary_clause(void) {
    int failed = 0;
    for (int64_t actual = 0; actual < 114; ++actual) {
        for (int offside = 0; offside <= 1; ++offside) {
            for (int64_t delta = -1; delta <= 1; ++delta) {
                const int64_t open = 5;
                int64_t expected = 0;
                if (!offside || open + delta >= open) {
                    if (actual == 9) expected = 1;      /* kw_elseif */
                    else if (actual == 8) expected = 2; /* kw_else */
                }
                const int64_t decision = idol_parser_boundary(
                    false, 0, offside, 0, open, 0, expected_event(actual, false), 1, 1, open + delta, false);
                const int64_t got = (decision >> 2) & 0x3;
                if (got != expected) failed += 1;
            }
        }
    }
    /* Branch face 3 is not produced by event and must fail closed to none. */
    if (((idol_parser_boundary(false, 0, false, 0, 5, 0, INT64_C(3) << 11, 1, 1, 5, false) >> 2) & 0x3) != 0) failed += 1;
    return failed;
}

static int verify_boundary_closure(void) {
    int failed = 0;
    for (int offside = 0; offside <= 1; ++offside) {
        for (int idol = 0; idol <= 1; ++idol) {
            for (int is_end = 0; is_end <= 1; ++is_end) {
                for (int new_line = 0; new_line <= 1; ++new_line) {
                    for (int relation = -1; relation <= 1; ++relation) {
                        const int64_t event = expected_event(is_end ? 10 : 0, false);
                        const int64_t line = new_line ? 2 : 1;
                        const int64_t before = 1;
                        const int64_t open = 5;
                        const int64_t col = open + relation;
                        int64_t expected;
                        if (is_end) {
                            if (offside && new_line && relation > 0) expected = 2;
                            else if (offside && new_line && relation < 0) expected = 0;
                            else expected = 1;
                        } else if (offside) expected = 0;
                        else if (idol) expected = 3;
                        else expected = 4;
                        const int64_t decision = idol_parser_boundary(
                            false, 0, offside, 0, open, 0, event, line, before, col, idol);
                        if (((decision >> 4) & 0x7) != expected) failed += 1;
                    }
