#!/bin/sh
set -u

# Regenerate the executed Idol parser-recognition projection and prove both its
# derivation and primitive C ABI. This is a bounded bootstrap bridge: delete it
# when the production parser consumes the Idol token pack without a C seam.

LC_ALL=C
export LC_ALL

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../../../.." && pwd -P) || exit 1
compiler=${IDOL-}
tracked=${TRACKED-"$root/src/parser/projection.c"}
cc=${CC-cc}
mode=${1-}

if [ -z "$compiler" ]; then
    printf '%s\n' 'parser artifact: FAIL — set IDOL to the exact compiler binary' >&2
    exit 1
fi
case "$compiler" in
    */*)
        case "$compiler" in
            /*) ;;
            *) compiler="$(CDPATH='' cd -- "$(dirname -- "$compiler")" && pwd -P)/$(basename -- "$compiler")" ;;
        esac
        ;;
    *) compiler=$(command -v -- "$compiler") || exit 1 ;;
esac
if [ ! -x "$compiler" ]; then
    printf 'parser artifact: FAIL — compiler is not executable: %s\n' "$compiler" >&2
    exit 1
fi
if ! command -v -- "$cc" >/dev/null 2>&1; then
    printf 'parser artifact: FAIL — C compiler is unavailable: %s\n' "$cc" >&2
    exit 1
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/idol-parser-artifact.XXXXXX") || exit 1
cleanup() {
    rm -rf -- "$work"
}
trap cleanup EXIT HUP INT TERM
candidate="$work/candidate.c"

cd "$root" || exit 1
if ! "$compiler" dump-c lib/compiler/parser.id --lib > "$candidate"; then
    printf '%s\n' 'parser artifact: FAIL — canonical dump-c recipe failed' >&2
    exit 1
fi
if [ ! -s "$candidate" ]; then
    printf '%s\n' 'parser artifact: FAIL — canonical dump-c recipe produced zero bytes' >&2
    exit 1
fi

if [ "$mode" = "--write" ]; then
    mkdir -p -- "$(dirname -- "$tracked")"
    cp -- "$candidate" "$tracked"
    printf 'parser artifact: wrote %s\n' "$tracked"
elif [ -n "$mode" ]; then
    printf 'usage: %s [--write]\n' "$0" >&2
    exit 64
fi

if [ ! -s "$tracked" ]; then
    printf 'parser artifact: FAIL — tracked artifact is absent or empty: %s\n' "$tracked" >&2
    exit 1
fi

status=0
if cmp -s "$candidate" "$tracked"; then
    printf '%s\n' 'parser artifact: generated bytes match tracked artifact'
else
    candidate_bytes=$(wc -c < "$candidate" | tr -d ' ')
    tracked_bytes=$(wc -c < "$tracked" | tr -d ' ')
    printf 'parser artifact: FAIL — byte mismatch (generated %s, tracked %s)\n' \
        "$candidate_bytes" "$tracked_bytes" >&2
    status=1
fi

cursor_harness="$work/cursor.c"
cat > "$cursor_harness" <<'EOF'
#undef main
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>

static int64_t word(const char *text) {
    size_t length = strlen(text);
    int64_t encoded = length > 6 ? 7 : (int64_t)length;
    size_t extent = length < 6 ? length : 6;
    for (size_t i = 0; i < extent; ++i) {
        encoded |= (int64_t)(uint8_t)text[i] << (8 * (i + 1));
    }
    return encoded;
}

static int64_t tokenize(const char *source, int64_t facts[256]) {
    duo_lexer producer = compiler_lexer__new(source, "probe.id", 1);
    duo_lexer edge = compiler_lexer__new("", "probe.id", 1);
    int64_t eof = compiler_lexer__next(&edge).kind;
    int64_t count = 0;
    for (;;) {
        duo_token token = compiler_lexer__next(&producer);
        facts[1 + count * 2] = token.kind + token.loc.line * 256 + token.loc.col * INT64_C(68719476736);
        facts[2 + count * 2] = word(token.text);
        count += 1;
        if (token.kind == eof || count == 127) break;
    }
    return count;
}

static int verify(const char *source, bool allow, int64_t offside, int64_t before, bool expected) {
    int64_t facts[256] = {0};
    int64_t count = tokenize(source, facts);
    duo_lexer cursor = compiler_lexer__new(source, "probe.id", 1);
    bool from_cursor = paren_header_signal_lx(&cursor, allow, offside, before);
    bool from_pack = idol_parser_header_pack(facts, count, 0, allow, offside, before);
    if (from_cursor != expected || from_pack != expected || from_cursor != from_pack) {
        fprintf(stderr, "%s cursor=%d pack=%d expected=%d\n", source, from_cursor, from_pack, expected);
        return 1;
    }
    return 0;
}

static int verify_clause(const char *source, int64_t expected) {
    int64_t facts[256] = {0};
    int64_t count = tokenize(source, facts);
    int64_t found = idol_parser_match_clause(facts, count, 0);
    if (found != expected) {
        fprintf(stderr, "%s clause=%lld expected=%lld\n", source, (long long)found, (long long)expected);
        return 1;
    }
    return 0;
}

static int verify_statement(const char *source, bool expected) {
    duo_lexer cursor = compiler_lexer__new(source, "probe.id", 1);
    duo_token name = compiler_lexer__peek(&cursor);
    bool found = statement_header_signal_lx(&cursor, &name, false);
    if (found != expected) {
        fprintf(stderr, "%s statement=%d expected=%d\n", source, found, expected);
        return 1;
    }
    return 0;
}

static int verify_lead(void) {
    const char *bits = token_grammarrole__lead();
    const size_t count = strlen(bits);
    size_t positives = 0;
    int failed = count == 0;
    for (size_t kind = 0; kind < count; ++kind) {
        const bool expected = bits[kind] == '1';
        if (expected) positives += 1;
        if (idol_parser_lead((int64_t)kind, 2, 2)) failed += 1;
        if (idol_parser_lead((int64_t)kind, 2, 1) != expected) failed += 1;
    }
    if (positives == 0) failed += 1;
    return failed;
}

static int verify_prefix(void) {
    const char *bits = token_grammarrole__prefix();
    const size_t count = strlen(bits);
    size_t positives = 0;
    int failed = count == 0;
    for (size_t kind = 0; kind < count; ++kind) {
        const bool expected = bits[kind] == '1';
        if (expected) positives += 1;
        if (idol_parser_prefix((int64_t)kind) != expected) failed += 1;
    }
    if (positives == 0) failed += 1;
    return failed;
}

static int64_t projected_ordinal(const char *row, size_t kind) {
    const unsigned char code = (unsigned char)row[kind];
    if (code == '.') return -1;
    if (code < 'A' || code > 'Z') return -2;
    return (int64_t)(code - 'A');
}

static int verify_relation_faces(void) {
    const char *relations = token_grammarrole__relation();
    const char *unaries = token_grammarrole__unary();
    const size_t count = strlen(relations);
    size_t unary_positive = 0;
    size_t glue_positive = 0;
    size_t update_positive = 0;
    int failed = count == 0 || strlen(unaries) != count;
    for (size_t kind = 0; kind < count; ++kind) {
        const int64_t relation = projected_ordinal(relations, kind);
        const int64_t unary_value = projected_ordinal(unaries, kind);
        const bool glue_face = token_grammarrole___roleglue((int64_t)kind);
        const bool update_face = token_grammarrole___roleupdate((int64_t)kind);
        const int64_t expected_glue = glue_face ? relation : -1;
        const int64_t expected_update = update_face ? relation : -1;
        if (unary_value >= 0) unary_positive += 1;
        if (glue_face) glue_positive += 1;
        if (update_face) update_positive += 1;
        if ((glue_face || update_face) && relation < 0) failed += 1;
        if (idol_parser_unary((int64_t)kind) != unary_value) failed += 1;
        if (idol_parser_glue((int64_t)kind) != expected_glue) failed += 1;
        if (idol_parser_update((int64_t)kind) != expected_update) failed += 1;
    }
    if (unary_positive == 0 || glue_positive == 0 || update_positive == 0) failed += 1;
    if (idol_parser_unary(-1) != -1 || idol_parser_unary((int64_t)count) != -1) failed += 1;
    if (idol_parser_glue(-1) != -1 || idol_parser_glue((int64_t)count) != -1) failed += 1;
    if (idol_parser_update(-1) != -1 || idol_parser_update((int64_t)count) != -1) failed += 1;
    return failed;
}

static bool row_bit(const char *row, size_t kind) {
    return row[kind] == '1';
}

static int verify_layout_faces(void) {
    const char *layout_row = token_grammarrole__layoutterminator();
    const char *empty_row = token_grammarrole__emptybodyterminator();
    const size_t count = strlen(layout_row);
    int failed = count == 0 || strlen(empty_row) != count;
    size_t layout_positive = 0;
    size_t empty_positive = 0;
    for (size_t kind = 0; kind < count; ++kind) {
        const bool expected_layout = row_bit(layout_row, kind);
        const bool expected_empty = row_bit(empty_row, kind);
        if (expected_layout) layout_positive += 1;
        if (expected_empty) empty_positive += 1;
        if (idol_parser_layout_terminator((int64_t)kind) != expected_layout) failed += 1;
        if (idol_parser_empty_body_terminator((int64_t)kind) != expected_empty) failed += 1;
        if (expected_empty && !expected_layout) failed += 1;
    }
    if (layout_positive != 6 || empty_positive != 5) failed += 1;
    if (idol_parser_layout_terminator(-1) != false) failed += 1;
    if (idol_parser_layout_terminator((int64_t)count) != false) failed += 1;
    if (idol_parser_empty_body_terminator(-1) != false) failed += 1;
    if (idol_parser_empty_body_terminator((int64_t)count) != false) failed += 1;
    return failed;
}

static int verify_opening(void) {
    int failed = 0;
    const int64_t k = 0;
    const int64_t op_line = 1;
    const int64_t op_col = 5;
    // 1. Lua mode: returns 0 (no layout).
    if (idol_parser_opening(false, op_line, op_col, k, 1, 6) != 0) failed += 1;
    // 2. No opener (open_line 0): returns 0.
    if (idol_parser_opening(true, 0, 0, k, 1, 6) != 0) failed += 1;
    // 3. Lua mode + first_is_terminator path: returns 0.
    if (idol_parser_opening(false, op_line, op_col, 10, 1, 6) != 0) failed += 1;
    // 4. Open line, inline body (first.line == open_line, not terminator):
    //    bit 0 = offside, bit 2 = inline, open_col shifted into bits 8..35.
    const int64_t inline_bits =
        idol_parser_opening(true, op_line, op_col, k, op_line, op_col + 1);
    if ((inline_bits & 1) == 0) failed += 1;
    if ((inline_bits & 4) == 0) failed += 1;
    if (((inline_bits >> 8) & 0x0FFFFFFF) != op_col) failed += 1;
    // 5. Indented body (first.line > open_line AND first.col > open_col):
    //    bit 0 = offside, body_col shifted into bits 36..63.
    const int64_t first_line = 2;
    const int64_t first_col = 9;
    const int64_t indented_bits =
        idol_parser_opening(true, op_line, op_col, k, first_line, first_col);
    if ((indented_bits & 1) == 0) failed += 1;
    if (((indented_bits >> 36) & 0x0FFFFFFF) != first_col) failed += 1;
    // 6. First token is a layout terminator (e.g. kw_end = 10):
    //    offside bit NOT set; terminator reading via layout_terminator.
    if (idol_parser_layout_terminator(10) != true) failed += 1;
    const int64_t term_bits =
        idol_parser_opening(true, op_line, op_col, 10, first_line, first_col);
    if ((term_bits & 1) != 0) failed += 1;
    return failed;
}

static int verify_layout_verdict(void) {
    int failed = 0;
    const int64_t op_col = 5;
    // 1. No offside: verdict 0 (keep), regardless of column.
    if ((idol_parser_layout_verdict(false, op_col, 0, 0, 2, 3) & 0x3) != 0) failed += 1;
    if ((idol_parser_layout_verdict(false, op_col, 0, 10, 2, 100) & 0x3) != 0) failed += 1;
    // 2. Column left of opener: verdict 1 (close).
    if ((idol_parser_layout_verdict(true, op_col, 0, 0, 2, 5) & 0x3) != 1) failed += 1;
    if ((idol_parser_layout_verdict(true, op_col, 0, 0, 2, 3) & 0x3) != 1) failed += 1;
    // 3. Body col not yet established, column > opener: verdict 0 (keep)
    //    with the new body column shifted into bits 8..35.
    const int64_t set_body =
        idol_parser_layout_verdict(true, op_col, 0, 0, 2, 8);
    if ((set_body & 0x3) != 0) failed += 1;
    if (((set_body >> 8) & 0x0FFFFFFF) != 8) failed += 1;
    // 4. Exact body column: verdict 0 (keep).
    if ((idol_parser_layout_verdict(true, op_col, 8, 0, 2, 8) & 0x3) != 0) failed += 1;
    // 5. Odd-column terminator: verdict 1 (close). kw_end = 10.
    if ((idol_parser_layout_verdict(true, op_col, 8, 10, 2, 7) & 0x3) != 1) failed += 1;
    // 6. Odd-column ordinary token: verdict 2 (misindent). kind = 0 (name).
    if ((idol_parser_layout_verdict(true, op_col, 8, 0, 2, 7) & 0x3) != 2) failed += 1;
    return failed;
}

static int64_t first_kind(const char *source) {
    duo_lexer lexer = compiler_lexer__new(source, "probe.id", 1);
    return compiler_lexer__next(&lexer).kind;
}

int main(void) {
    int failed = 0;
    int64_t name = first_kind("x");
    int64_t keyword = first_kind("if");
    failed += verify("(a: i64) = a", false, 0, name, true);
    failed += verify("(a + 1)", true, 0, name, false);
    failed += verify("(): i64", false, 0, name, true);
    failed += verify("(t:concat(\"-\"))", false, 0, name, false);
    failed += verify("(t)\n    x", true, 1, name, true);
    failed += verify("(flag)\n    x", true, 1, keyword, false);
    failed += verify("(a, b) x", true, 0, name, true);
    failed += verify("(less(arr(1), v))\n    x", true, 1, name, false);
    failed += verify_statement("f(a: i64) = a", true);
    failed += verify_statement("print(t:concat(\"-\"))", false);
    failed += verify_clause("case", 2);
    failed += verify_clause("else", 3);
    failed += verify_clause("x =>", 1);
    failed += verify_clause("{x} then", 1);
    failed += verify_clause("x", 0);
    failed += verify_clause("x\n=>", 0);
    failed += verify_clause("+ =>", 0);
    failed += verify_clause(") =>", 0);
    failed += verify_lead();
    failed += verify_prefix();
    failed += verify_relation_faces();
    failed += verify_layout_faces();
    failed += verify_opening();
    failed += verify_layout_verdict();
    printf("typed=1 call=0 offside=1 condition=0 empty=1 nested=0 cursor-pack-cases=8 statement-cases=2 clause-cases=8 lead-slots=%zu prefix-slots=%zu relation-slots=%zu layout-terminators=%zu empty-terminators=%zu failed=%d\n", strlen(token_grammarrole__lead()), strlen(token_grammarrole__prefix()), strlen(token_grammarrole__relation()), strlen(token_grammarrole__layoutterminator()), strlen(token_grammarrole__emptybodyterminator()), failed);
    return failed != 0;
}
EOF

compile_and_run() {
    label=$1
    source=$2
    object="$work/$label.o"
    cursor_executable="$work/$label-cursor"
    cursor_result="$work/$label.cursor.result"
    if ! "$cc" -std=c11 -O2 -w \
        -Dmain=idol_parser_projection_main \
        -Dheader_signal_lx=idol_parser_header_pack \
        -Dreturn_starts_value_lx=idol_parser_return_starts_value \
        -D_clause=idol_parser_match_clause \
        -Dlead=idol_parser_lead \
        -Dprefix=idol_parser_prefix \
        -Dinfix_prec=idol_parser_infix_prec \
        -D_unary=idol_parser_unary \
        -D_glue=idol_parser_glue \
        -D_update=idol_parser_update \
        -Dis_digit=idol_parser_is_digit \
        -D_layout_terminator=idol_parser_layout_terminator \
        -D_empty_body_terminator=idol_parser_empty_body_terminator \
        -D_opening=idol_parser_opening \
        -D_layout_verdict=idol_parser_layout_verdict \
        -c "$source" -o "$object"
    then
        printf 'parser artifact: FAIL — %s projection did not compile\n' "$label" >&2
        return 1
    fi
    if ! "$cc" -std=c11 -O2 -w \
        -Dmain=idol_parser_projection_main \
        -Dheader_signal_lx=idol_parser_header_pack \
        -Dreturn_starts_value_lx=idol_parser_return_starts_value \
        -D_clause=idol_parser_match_clause \
        -Dlead=idol_parser_lead \
        -Dprefix=idol_parser_prefix \
        -Dinfix_prec=idol_parser_infix_prec \
        -D_unary=idol_parser_unary \
        -D_glue=idol_parser_glue \
        -D_update=idol_parser_update \
        -Dis_digit=idol_parser_is_digit \
        -D_layout_terminator=idol_parser_layout_terminator \
        -D_empty_body_terminator=idol_parser_empty_body_terminator \
        -D_opening=idol_parser_opening \
        -D_layout_verdict=idol_parser_layout_verdict \
        -include "$source" "$cursor_harness" -lm -o "$cursor_executable"
    then
        printf 'parser artifact: FAIL — %s cursor/pack probe did not compile\n' "$label" >&2
        return 1
    fi
    if ! "$cursor_executable" > "$cursor_result"; then
        printf 'parser artifact: FAIL — %s cursor/pack probe disagreed\n' "$label" >&2
        return 1
    fi
}

compile_and_run candidate "$candidate" || status=1
compile_and_run tracked "$tracked" || status=1
if [ -s "$work/candidate.cursor.result" ] && [ -s "$work/tracked.cursor.result" ]; then
    if cmp -s "$work/candidate.cursor.result" "$work/tracked.cursor.result"; then
        printf 'parser artifact: %s\n' "$(tr -d '\n' < "$work/candidate.cursor.result")"
    else
        printf '%s\n' 'parser artifact: FAIL — generated and tracked cursor/pack probes disagree' >&2
        status=1
    fi
fi
if [ "$status" -ne 0 ]; then
    exit 1
fi
printf '%s\n' 'parser artifact: PASS'
