static int verify_statement(const char *source, bool expected) {
    int64_t facts[256] = {0};
    int64_t events[256] = {0};
    int64_t count = tokenize(source, facts);
    int64_t written = idol_parser_event(facts, count, events, count * 2, true);
    bool from_event = ((events[count] >> 7) & 1) != 0;
    duo_lexer cursor = compiler_lexer__new(source, "probe.id", 1);
    duo_token name = compiler_lexer__peek(&cursor);
    bool from_cursor = statement_header_signal_lx(&cursor, &name, false);
    if (written != count || from_cursor != expected || from_event != expected || from_cursor != from_event) {
        fprintf(stderr, "%s statement-cursor=%d event=%d written=%lld expected=%d\n", source, from_cursor, from_event, (long long)written, expected);
