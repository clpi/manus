static int verify_face(const char *source, int64_t expected) {
    int64_t facts[256] = {0};
    int64_t events[256] = {0};
    int64_t count = tokenize(source, facts);
    int64_t written = idol_parser_event(facts, count, events, count * 2, true);
    int64_t found = -1;
    for (int64_t index = 0; index < count; index += 1) {
        if ((facts[index * 2 + 1] & 255) == 60) {
            found = events[count + index] >> 13;
            break;
        }
    }
    if (written != count || found != expected) {
        fprintf(stderr, "%s bracket-face=%lld written=%lld expected=%lld\n", source, (long long)found, (long long)written, (long long)expected);
        return 1;
