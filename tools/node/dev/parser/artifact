static int verify_delimiter(const char *source, int64_t expected) {
    int64_t facts[256] = {0};
    int64_t events[256] = {0};
    int64_t count = tokenize(source, facts);
    int64_t written = idol_parser_event(facts, count, events, count * 2, true);
    int64_t found = events[count] >> 13;
    if (written != count || found != expected) {
        fprintf(stderr, "%s delimiter-event=%lld written=%lld expected=%lld\n", source, (long long)found, (long long)written, (long long)expected);
        return 1;
    }
    return 0;
