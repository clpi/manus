#!/bin/sh
set -u

repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo" || exit 1

repository="$repo/tools/node/dev/repository"
development="$("$repository" development)"
release="$("$repository" release)"

fail=0

ok() { printf 'ok %s\n' "$1"; }
bad() { printf 'FAIL %s\n' "$1" >&2; fail=$((fail + 1)); }

# PRIVATE EVIDENCE ROOT. Every probe below that captures a child's output and
# greps it for a verdict used to write a fixed `/tmp/idol-*.out` path. Two
# concurrent doctors then graded one another's bytes, and any writer that knew
# the fixed name could invert a verdict — 'keychain is locked' or
# '<server>: ready' are grep targets, not just display (GAP-115).
work="$(mktemp -d "${TMPDIR:-/tmp}/idol-doctor.XXXXXX")" || exit 1

cleanup_root_artifacts() {
  find "$repo" -maxdepth 1 -type f \( -name '*.out' -o -name '*.profraw' -o -name 'test_*.c' -o -name 'test_*.wasm' \) -exec rm {} \;
}

# `cleanup_root_artifacts` is also called mid-run, so the private evidence
# root is only released on exit.
cleanup_doctor() {
  cleanup_root_artifacts
  rm -rf "$work"
}

trap cleanup_doctor EXIT

need_cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    ok "$1 on PATH"
  else
    bad "$1 missing from PATH"
  fi
}

want_version() {
  name="$1"
  want="$2"
  got="$3"
  if [ "$got" = "$want" ]; then
    ok "$name version $want"
  else
    bad "$name version is '$got', expected '$want'"
  fi
}

[ -f AGENTS.md ] || bad "AGENTS.md missing"
[ -f docs/spec/constitution.md ] || bad "C0 missing"
[ -f CLAUDE.md ] || bad "CLAUDE.md missing"

need_cmd git
need_cmd gh
need_cmd rg
need_cmd zig
need_cmd clang
need_cmd cc
need_cmd jq
need_cmd zls
need_cmd codex
need_cmd cursor
need_cmd cursor-agent
need_cmd tree-sitter
need_cmd node
need_cmd npm
need_cmd lua
need_cmd luajit
need_cmd wasmtime
need_cmd wasmer

if [ "$(uname -s)" = "Darwin" ]; then
  ok "host platform Darwin"
else
  bad "host platform is not Darwin"
fi

if [ "$(uname -m)" = "arm64" ]; then
  ok "host architecture arm64"
else
  bad "host architecture is not arm64"
fi

avail_kb="$(df -k . | awk 'NR == 2 { print $4 }')"
if [ "${avail_kb:-0}" -ge 10485760 ]; then
  ok "disk has at least 10 GiB free"
else
  bad "disk has less than 10 GiB free"
fi

if [ "$(git rev-parse --show-toplevel 2>/dev/null || true)" = "$repo" ]; then
  ok "repository root is $repo"
else
  bad "wrong repository root"
fi

if repository_result="$("$repository" check 2>&1)"; then
  ok "$repository_result"
else
  bad "$repository_result"
fi
if repository_control="$("$repository" selftest 2>&1)"; then
  ok "$repository_control"
else
  bad "$repository_control"
fi

if [ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)" = "main" ]; then
  ok "branch is main"
else
  bad "branch is not main"
fi

if gh api user --jq .login >"$work/gh-auth.out" 2>&1; then
  ok "GitHub CLI authenticated"
else
  bad "GitHub CLI authentication failed"
fi

if command -v zig >/dev/null 2>&1; then
  want_version zig "0.17.0-dev.1567+f0354179a" "$(zig version 2>/dev/null || true)"
fi
if command -v zls >/dev/null 2>&1; then
  want_version zls "0.16.0" "$(zls --version 2>/dev/null | head -1 || true)"
fi
if command -v codex >/dev/null 2>&1; then
  want_version codex "codex-cli 0.147.0" "$(codex --version 2>/dev/null | head -1 || true)"
fi
if command -v cursor >/dev/null 2>&1; then
  cursor_v="$(cursor --version 2>/dev/null | head -1 || true)"
  want_version cursor "3.5.33" "$cursor_v"
fi
if command -v cursor-agent >/dev/null 2>&1; then
  cursor_agent_v="$(cursor-agent --version 2>/dev/null | head -1 || true)"
  want_version cursor-agent "2026.08.11-e8db854" "$cursor_agent_v"
fi

duo="${IDOL_BOOTSTRAP_BIN:-${IDOL_BIN:-${DUO_BIN:-$repo/zig-out/bin/idol}}}"
if [ ! -x "$duo" ]; then
  bad "missing fresh compiler artifact $duo"
else
  if ! (cd "$repo" && zig build install >/dev/null 2>&1); then
    bad "zig build install failed"
  fi
  # A `while` loop reading a pipe destroys the enumerator's status, and an
  # empty enumeration takes the `ok` branch below — so a tree with no `.git`
  # certified the compiler artifact as newer than sources it never looked at.
  # Assert the subject set first, where the status survives (GAP-220).
  if ! sh "$repo/gate/subject.sh" build.zig.zon src >/dev/null; then
    bad "cannot enumerate compiler sources — staleness NOT MEASURED"
    stale=
  else
  stale="$(git ls-files build.zig.zon src | while IFS= read -r p; do [ "$p" -nt "$duo" ] && echo "$p" && break; done)"
  if [ -n "$stale" ]; then
    bad "compiler artifact is older than tracked source: $stale"
  else
    ok "compiler artifact is newer than compiler sources"
  fi
  fi
fi

cleanup_root_artifacts

root_artifacts="$(find "$repo" -maxdepth 1 -type f \( -name '*.out' -o -name '*.profraw' -o -name 'test_*.c' -o -name 'test_*.wasm' \) -print | head -1)"
if [ -n "$root_artifacts" ]; then
  bad "stale root generated artifact exists: $root_artifacts"
else
  ok "no stale root generated artifacts"
fi

"$repo/tools/node/dev/generate-configs" --check || bad "generated MCP projections are missing or stale"
"$repo/tools/node/dev/generate-harness" --check || bad "generated harness orientation is missing or stale"
"$repo/tools/node/dev/install-skills" || bad "idol-dev skill installation failed"
for skill in idol-dev idol; do
  source_skill="$repo/.pi/skills/$skill/SKILL.md"
  installed_skill="${CODEX_HOME:-$HOME/.codex}/skills/$skill/SKILL.md"
  if git check-ignore -q "$source_skill"; then
    bad "canonical skill source is ignored: $source_skill"
  else
    ok "canonical skill source is visible: $skill"
  fi
  if [ -f "$installed_skill" ]; then
    ok "Codex skill $skill installed"
  else
    bad "Codex skill $skill missing after install-skills"
  fi
  if grep -q "^name: $skill" "$installed_skill" 2>/dev/null; then
    ok "Codex skill $skill names $skill"
  else
    bad "Codex skill $skill has wrong skill name"
  fi
  if cmp -s "$source_skill" "$installed_skill"; then
    ok "Codex skill $skill matches canonical source"
  else
    bad "Codex skill $skill differs from canonical source"
  fi
done

for name in $(jq -r '.servers[] | select(.enabled == true) | .name' "$repo/tools/node/dev/mcp.manifest.json"); do
  required=$(jq -r --arg name "$name" '.servers[] | select(.name == $name) | (.required // false)' "$repo/tools/node/dev/mcp.manifest.json")
  if codex mcp get "$name" >/dev/null 2>&1; then
    ok "Codex has MCP server $name"
  elif [ "$required" = false ]; then
    ok "Codex optional MCP server unavailable: $name"
  else
    bad "Codex missing MCP server $name"
  fi
done

cursor_expected="$(jq -r '[.servers[] | select(.enabled == true) | .name] | join(" ")' "$repo/tools/node/dev/mcp.manifest.json")"
if [ -f "$repo/.cursor/mcp.json" ] && jq -e --arg expected "$cursor_expected" '
    ($expected | split(" ")) as $names |
    [ $names[] as $n | select(.mcpServers[$n] == null) ] | length == 0
  ' "$repo/.cursor/mcp.json" >/dev/null 2>&1; then
  ok "Cursor project MCP config has every manifest-enabled server"
else
  bad "Cursor project MCP config missing manifest-enabled servers"
fi

if [ -f "$repo/.cursor/rules/00-authority.mdc" ] && grep -q 'AGENTS.md' "$repo/.cursor/rules/00-authority.mdc" && grep -q 'docs/spec/constitution.md' "$repo/.cursor/rules/00-authority.mdc"; then
  ok "Cursor rule projects AGENTS.md and C0"
else
  bad "Cursor authority rule missing AGENTS.md or C0"
fi

for rule in 00-authority 10-language 20-graph 30-realization 40-selfhost 50-mcp-lsp 60-performance 70-evidence 80-coordination; do
  if [ -f "$repo/.cursor/rules/$rule.mdc" ]; then
    ok "Cursor rule exists: $rule"
  else
    bad "Cursor rule missing: $rule"
  fi
done

if [ -f "$repo/.cursorignore" ] && grep -q '^zig-out/$' "$repo/.cursorignore"; then
  ok "Cursor indexing exclusions configured"
else
  bad "Cursor indexing exclusions missing"
fi

if "$repo/tools/node/dev/orient" >"$work/orient.out" 2>&1 \
  && grep -q '^project: Idol$' "$work/orient.out" \
  && grep -Fq "devrepository: $development" "$work/orient.out" \
  && grep -Fq "releaserepository: $release" "$work/orient.out" \
  && grep -q '^authority:' "$work/orient.out"; then
  ok "orientation command reports current repository facts"
else
  bad "orientation command failed"
fi

gate="$(mktemp -t idiomgate)" || bad "could not create idiom gate probe"
trap 'rm -f "$gate"; cleanup_doctor' EXIT
printf '+++ b/updateface.id\n@@ -0,0 +1 @@\n+step = step + 1\n' > "$gate"
if ! "$duo" check "$repo/gate/idiom.id" >/dev/null 2>&1; then
  bad "gate/idiom update-face positive control fails semantic check"
elif grep -q 'law.update.face' "$repo/gate/idiom.id" && grep -q 'expand(code)' "$repo/gate/idiom.id" && grep -q 'opafter' "$repo/gate/idiom.id"; then
  ok "gate/idiom update-face positive control (semantic check + detector wiring)"
else
  bad "gate/idiom update-face positive control missing law.update.face"
fi
rm -f "$gate"
trap cleanup_doctor EXIT

"$repo/tools/node/dev/probe-mcp" || bad "direct MCP initialize probe failed"

if TERM=xterm-256color codex --strict-config doctor >"$work/codex-doctor.out" 2>&1; then
  if grep -q 'app-server.*stale or unreachable' "$work/codex-doctor.out"; then
    bad "codex doctor reports stale or unreachable app-server socket"
  else
    ok "codex doctor"
  fi
else
  bad "codex doctor failed"
fi

if cursor agent --help >"$work/cursor-agent.out" 2>&1; then
  ok "Cursor Agent starts far enough to read CLI help"
else
  if grep -qi 'keychain is locked' "$work/cursor-agent.out"; then
    bad "Cursor Agent blocked by locked macOS login keychain"
  else
    bad "Cursor Agent CLI failed"
  fi
fi

if cursor agent mcp list >"$work/cursor-mcp.out" 2>&1; then
  missing_cursor_mcp=0
  for name in $(jq -r '.servers[] | select(.enabled == true) | .name' "$repo/tools/node/dev/mcp.manifest.json"); do
    required=$(jq -r --arg name "$name" '.servers[] | select(.name == $name) | (.required // false)' "$repo/tools/node/dev/mcp.manifest.json")
    if grep -q "^$name: ready" "$work/cursor-mcp.out"; then
      ok "Cursor MCP server ready: $name"
    elif [ "$required" = false ]; then
      ok "Cursor optional MCP server unavailable: $name"
    else
      bad "Cursor MCP server is not ready: $name"
      missing_cursor_mcp=1
    fi
  done
  if [ "$missing_cursor_mcp" -eq 0 ]; then
    ok "Cursor required MCP servers approved"
  fi
else
  bad "Cursor MCP server list failed"
fi

if cursor agent --print --mode=ask --trust --workspace "$repo" "Start at AGENTS.md. Answer with the sole Idol semantic law file path only." >"$work/cursor-agent-smoke.out" 2>&1; then
  if grep -q 'docs/spec/constitution.md' "$work/cursor-agent-smoke.out"; then
    ok "Cursor Agent fresh headless session orients through AGENTS.md"
  else
    bad "Cursor Agent fresh headless session did not identify C0"
  fi
else
  if grep -qi 'keychain is locked' "$work/cursor-agent-smoke.out"; then
    bad "Cursor Agent fresh headless session blocked by locked macOS login keychain"
  elif grep -qi 'Authentication required' "$work/cursor-agent-smoke.out"; then
    bad "Cursor Agent fresh headless session requires login"
  else
    bad "Cursor Agent fresh headless session failed"
  fi
fi

run_gate() {
  label="$1"
  shift
  if "$@"; then
    ok "$label"
  else
    bad "$label"
  fi
}

run_gate "identity projection census" "$repo/tools/node/dev/census/identity"
run_gate "corpus tag census" "$repo/tools/node/dev/corpuscensus"
run_gate "zero-history census" "$repo/tools/node/dev/census/history/zero"
run_gate "compound census" "$repo/tools/node/dev/census/compound"
run_gate "convergence census" "$repo/tools/node/dev/convergencecensus"
run_gate "projection debt census" "$repo/tools/node/dev/projectioncensus"
run_gate "foreign licence census" "$repo/tools/node/dev/foreigncensus"

extra_gate="${IDOL_DOCTOR_EXTRA_GATE:-}"
if [ "$extra_gate" != "" ]; then
  run_gate "extra child gate" sh -c "$extra_gate"
fi

skip_gates="${IDOL_DOCTOR_SKIP_GATES:-0}"
full_gates="${IDOL_DOCTOR_FULL_GATES:-0}"
if [ "$skip_gates" != "1" ]; then
  lock="$repo/tools/node/dev/idol-lock"
  run_gate "mcp-gate" "$lock" -- zig build mcp-gate
  run_gate "repo hygiene gate" "$repo/tools/node/dev/repo-hygiene"
  if [ "$full_gates" = "1" ]; then
    run_gate "semantic architecture gate" "$lock" -- zig build semantic-architecture
    run_gate "unit gate" "$lock" -- zig build unit-test --summary all
  else
    ok "semantic architecture gate deferred (set IDOL_DOCTOR_FULL_GATES=1  -  gate/architecture.id C embed debt)"
    ok "unit gate deferred (set IDOL_DOCTOR_FULL_GATES=1  -  verify the current aggregate debt live)"
  fi
fi

if [ "$fail" -eq 0 ]; then
  cleanup_root_artifacts
  printf 'idol doctor: PASS\n'
  exit 0
fi

printf 'idol doctor: FAIL (%s failure(s))\n' "$fail" >&2
exit 1
