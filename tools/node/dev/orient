#!/bin/sh
set -eu

if [ "${1-}" = --mcp ]; then
    case ${IDOL_MODE-} in
        '')
            case ${2-} in
                head) result=$(git rev-parse HEAD 2>&1) ;;
                status) result=$(git status --short --branch 2>&1) ;;
                orient) result=$("$0" 2>&1) ;;
                *) result='unknown tool' ;;
            esac
            jq -cjn --arg text "$result" '{content:[{type:"text",text:$text}]}'
            exit 0
            ;;
        *) set -- --read "${2-}" ;;
    esac
fi

if [ "${1-}" = --read ]; then
    if ! command -v python3 >/dev/null 2>&1; then
        printf '%s' '{"isError":true,"content":[{"type":"text","text":"orientation runtime unavailable"}]}'
        exit 0
    fi
    exec python3 - "${2-}" <<'PY'
import hashlib, json, os, pathlib, re, signal, subprocess, sys, time

fact = {'repo': None, 'root': os.environ.get('IDOL_ROOT'), 'mode': os.environ.get('IDOL_MODE'), 'head': None,
         'branch': None, 'dirty': None, 'remote': {'head': None},
         'artifact': {'path': os.environ.get('IDOL_BIN'), 'digest': None, 'source': None},
         'state': 'unavailable'}

def emit(state, reason=None, text=None):
    fact['state'] = state
    if reason:
        fact['reason'] = reason
    print(json.dumps({'isError': state != 'current', 'content': [{'type': 'text',
          'text': text if text is not None else json.dumps(fact, sort_keys=True)}]}), end='')
    raise SystemExit()

def run(argv, second=3):
    env = dict(os.environ, GIT_OPTIONAL_LOCKS='0', GIT_TERMINAL_PROMPT='0',
               GIT_SSH_COMMAND='ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=3')
    with subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, env=env, start_new_session=True) as child:
        try:
            out, err = child.communicate(timeout=second)
        except subprocess.TimeoutExpired:
            os.killpg(child.pid, signal.SIGKILL)
            child.communicate()
            raise ValueError()
        if child.returncode or len(out) > 65536 or len(err) > 65536:
            raise ValueError()
        return out.decode('utf-8').rstrip('\n')

if fact['mode'] != 'read':
    emit('invalid', 'mode')
if sys.argv[1:] not in (['head'], ['status'], ['orient']):
    emit('invalid', 'action')
try:
    root = pathlib.Path(fact['root'])
    if not root.is_absolute() or root.resolve(strict=True) != root or not root.is_dir():
        emit('invalid', 'root')
    git = ['git', '--no-optional-locks', '-c', 'core.fsmonitor=false', '-C', str(root)]
    if run(git + ['rev-parse', '--show-toplevel']) != str(root):
        emit('invalid', 'root')
    fact['head'] = run(git + ['rev-parse', 'HEAD'])
    fact['branch'] = run(git + ['rev-parse', '--abbrev-ref', 'HEAD'])
    status = run(git + ['status', '--porcelain=v1', '--untracked-files=all'])
    fact['dirty'] = len(status.splitlines())
    origin = run(git + ['remote', 'get-url', 'origin'])
    if origin not in ('git@github.com:clpi/idol.git', 'https://github.com/clpi/idol.git',
                       'ssh://git@github.com/clpi/idol.git'):
        emit('foreign', 'origin')
    fact['repo'] = 'clpi/idol'
    fact['remote']['url'] = origin
    try:
        remote = run(git + ['ls-remote', '--refs', 'origin', 'refs/heads/main'], 8)
        match = re.fullmatch(r'([a-f0-9]{40})\trefs/heads/main', remote)
        if not match:
            raise ValueError()
        fact['remote']['head'] = match[1]
        fact['remote']['time'] = time.time()
    except (OSError, ValueError):
        emit('unavailable', 'remote')
    artifact = fact['artifact']['path']
    if artifact:
        binary = pathlib.Path(artifact)
        if binary.is_file() and os.access(binary, os.X_OK) and binary.stat().st_size <= 268435456:
            fact['artifact']['digest'] = hashlib.sha256(binary.read_bytes()).hexdigest()
    if fact['head'] != run(git + ['rev-parse', 'HEAD']) or status != run(git + ['status', '--porcelain=v1', '--untracked-files=all']):
        emit('changed', 'source')
    if fact['head'] != fact['remote']['head']:
        emit('stale', 'head')
    if fact['dirty']:
        emit('dirty', 'source')
    if sys.argv[1] == 'head':
        emit('current', text=fact['head'])
    if sys.argv[1] == 'status':
        emit('current', text=run(git + ['status', '--short', '--branch']))
    emit('current')
except (OSError, TypeError, ValueError):
    emit('unavailable', 'source')
PY
fi

repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo"

repository="$repo/tools/node/dev/repository"
development="$("$repository" development)"
release="$("$repository" release)"
authority="$("$repository" authority)"
development_pair="$("$repository" remote)"
development_remote="$(printf '%s\n' "$development_pair" | cut -f1)"
development_url="$(printf '%s\n' "$development_pair" | cut -f2-)"

head="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
dirty="$(git status --short 2>/dev/null | wc -l | tr -d ' ')"
# md_field <file> <field>: print the value cell of a | field | value |
# metadata-table row. Structural replacement for **Field:** header lines.
md_field() {
  sed -n "s/^|[[:space:]]*$2[[:space:]]*|[[:space:]]*\(.*\)[[:space:]]*|[[:space:]]*$/\1/p" "$1" | head -n 1
}

p0="$(
  count=0
  for gap in gaps/GAP-*.md; do
    status="$(md_field "$gap" status)"
    priority="$(md_field "$gap" priority)"
    if printf '%s' "$status" | grep -Eiq '^(OPEN|REOPENED)([[:space:]·(:—-]|$)' &&
       printf '%s\n%s' "$status" "$priority" | grep -Eiq 'P0'; then
      count=$((count + 1))
    fi
  done
  echo "$count"
)"

origin="$(git remote get-url origin 2>/dev/null || echo unknown)"
echo "project: Idol"
echo "language: idol"
echo "canonicalsource: .id"
echo "devrepository: $development"
echo "devremote: $development_remote"
echo "devurl: $development_url"
echo "releaserepository: $release"
echo "releasestatus: untouched until RELEASE_READINESS authorization"
echo "worktree: $repo"
echo "origin: $origin"
echo "head: $head"
echo "branch: $branch"
echo "dirtyentries: $dirty"
echo "host: $(uname -s) $(uname -m)"
echo "authority: $authority"
echo "skill: idol-dev (.pi/skills/idol-dev/SKILL.md) and idol (.pi/skills/idol/SKILL.md); installed to Codex/Claude/OpenCode/Devin by tools/node/dev/install-skills"
echo "pipeline: source -> graph -> demand -> realization -> machine"
echo "updateface: AGENTS.md -> gate/idiom.id (migration firewall; graph witness required)"
echo "bootstrapstage: S0 pinned Zig seed builds host compiler; executed lexer boundary; parser and later stages remain host-owned"
echo "activep0: $p0"
echo "frontier: close GAP-145 lexical identities, then GAP-134 generated grammar roles and immutable token view"
echo "mcpmanifest: tools/node/dev/mcp.manifest.json"
mcp_log="$(mktemp "${TMPDIR:-/tmp}/idol-orient-mcp.XXXXXX")"
trap 'rm -f "$mcp_log"' EXIT
if "$repo/tools/node/dev/probe-mcp" >"$mcp_log" 2>&1; then
  echo "mcphealth: raw initialize pass"
else
  echo "mcphealth: raw initialize fail"
  detail="$(sed -n '1p' "$mcp_log" | tr '\n' ' ')"
  [ -n "$detail" ] && echo "mcphealthdetail: $detail"
fi
echo "coordination: use tools/node/dev/claim for exact paths; never stash or hard reset; commit explicit pathspecs only"
echo "evidence: exact tree, command, executed path, outcome, and positive controls"
echo "avoid: historical .id semantics, pass documents as law, copied machine state, shadow specs, source-text identity reconstruction"
echo "harnesslaw: docs/spec/harness-projection.md"
if "$repo/tools/node/dev/generate-harness" >/dev/null 2>&1; then
  echo "harnesscontext: .agents/HARNESS.md"
else
  echo "harnesscontext: generate-harness failed — run tools/node/dev/generate-harness"
fi
echo "nextboundary: smallest owned slice on lexical identity or grammar-role frontier after claiming paths"
if [ -x "$repo/tools/node/dev/hostcensus" ]; then
  hosttotal="$("$repo/tools/node/dev/hostcensus" 2>/dev/null | sed -n 's/^total violation+migration hits: //p' | tail -1)"
  if [ -n "$hosttotal" ]; then
    echo "hostdebt: $hosttotal classified hits (tools/node/dev/hostcensus · GAP-154)"
  else
    echo "hostdebt: census unavailable — run tools/node/dev/hostcensus"
  fi
fi
mkdir -p "$repo/evidence"
tree_state=clean
if [ "$dirty" != "0" ]; then
  tree_state="dirty ($dirty entries)"
fi
{
  echo "HEAD: $(git rev-parse HEAD 2>/dev/null || echo unknown)"
  echo "Date: $(date -Iseconds 2>/dev/null || date)"
  echo "Branch: $branch"
  echo "Tree: $tree_state"
  echo "Integration: present"
  echo "Measurement: absent"
  echo "Compiler_B: absent"
  echo "Performance_admission: denied"
  echo "Derived: tools/node/dev/orient (law.control.derived — do not hand-edit)"
} >"$repo/evidence/HEAD.txt"
