#!/bin/sh
# explain-gate — the answerability surface, asserted BY VALUE, in a shell that runs.
#
# WHY THIS FILE EXISTS. `idol explain` is the compiler's only projection of live
# codegen state: optimization outcomes, assumption guards, the transform engine's
# provenance log and its tier-1 registry. HPLS §7 counts diagnostics and tooling
# as causal consumers — but only if something CONSUMES them. Measured on
# 2026-08-15, nothing did:
#
#   scripts/explain.id      ran as `idol run --backend=c …`   -> refused, exit 1
#   scripts/contract.id     ran as `idol run --backend=c …`   -> refused, exit 1
#   scripts/transform.id    ran as `idol run --backend=c …`   -> refused, exit 1
#   scripts/cfloor.id       ran on the direct backend         -> DNB001, exit 1
#
# The legacy AST/Lua C bridge refuses, and the three `.id` gates are outside the
# direct backend's subset (DNB001 `mod-global-written`, DNB011
# `unresolved-application-facts`). So every consumer of `explain` scored the
# FLAG or the BACKEND GAP, never the surface. `consumers = 0`, which HPLS §8
# calls P0 architecture debt. A future explicitly selected graph-backed C
# realizer is orthogonal and cannot supply this direct-native evidence.
#
# This gate is written in `sh` for exactly one reason: it is the only gate form
# that executes today. When the direct backend grows `mod-global-written` and
# `unresolved-application-facts`, the `.id` gates become runnable and this one
# should be folded into them — it is a bridge, and its own header says so.
#
# It asserts BYTES, never exit status: `explain` exits 0 on a contract violation
# too (that is deliberate — its job is to project the graph, not to judge it),
# so exit status cannot decide any row here. Positive-controlled by row P0,
# which searches for a string that must NOT be present.
set -eu

repo="$(cd "$(dirname "$0")/../../.." && pwd)"
bin="${IDOL_BIN:-${DUO_BIN:-$repo/zig-out/bin/idol}}"
work="${TMPDIR:-/tmp}/idol-explain-gate"
fails=0
reached=0

report() {
  reached=$((reached + 1))
  if [ "$1" = ok ]; then
    printf '  ok   %s\n' "$2"
  else
    printf '  FAIL %s — %s\n' "$2" "$3" >&2
    fails=$((fails + 1))
  fi
}

# Does the document hold `want`? Substring over the whole JSON, which is one
# line, so a key present under the wrong parent would still pass — every row
# below therefore pins a key TOGETHER WITH a value it could not have by accident.
holds() {
  case "$(cat "$1")" in *"$2"*) return 0 ;; esac
  return 1
}

rm -rf "$work"
mkdir -p "$work"
doc="$work/explain.json"
fixture="$repo/examples/cfloor/fact.id"

printf 'explain-gate: `idol explain` projects live compiler state, asserted by value\n'

[ -f "$fixture" ] || { printf '  FAIL fixture missing — %s\n' "$fixture" >&2; exit 1; }

rc=0
( cd "$repo" && "$bin" explain "$fixture" ) >"$doc" 2>"$work/explain.err" || rc=$?
if [ "$rc" != 0 ]; then
  printf '  FAIL explain runs — exit %s\n' "$rc" >&2
  sed 's/^/       /' "$work/explain.err" >&2
  printf 'explain-gate: FAIL — the surface did not render; nothing below was measured\n'
  exit 1
fi
report ok "explain renders a document ($(wc -c <"$doc" | tr -d ' ') bytes)"

# P0 — positive control. A gate that passes every row by matching everything is
# not a gate. This string is not in any document the compiler can produce.
if holds "$doc" "idol-explain-this-string-is-not-in-any-document"; then
  report fail "P0 positive control" "the matcher accepts a string that cannot be present"
else
  report ok "P0 positive control (a fabricated string is absent)"
fi

# S1 — schema identity. The consumer contract is the schema name, not the shape
# that happens to come out today.
holds "$doc" '"schema":"idol-explain-v1"' \
  && report ok "S1 schema is idol-explain-v1" \
  || report fail "S1 schema is idol-explain-v1" "schema key absent or renamed"

# K1 — the knowledge snapshot reaches the document with entities in it. `mix`
# and `main` are the two callables in the fixture; an empty snapshot renders the
# same keys, so the entity NAME is what is pinned.
holds "$doc" '"schema":"knowledge-snapshot-v1"' \
  && report ok "K1 knowledge snapshot present" \
  || report fail "K1 knowledge snapshot present" "no knowledge-snapshot-v1 block"
holds "$doc" '"name":"mix"' \
  && report ok "K1b the snapshot names the fixture's callable by value" \
  || report fail "K1b the snapshot names the fixture's callable by value" "no entity named mix"
holds "$doc" '"entity":{"incarnation":' \
  && report ok "K1c snapshot identity is an exact graph reference" \
  || report fail "K1c snapshot identity is an exact graph reference" "no incarnation-qualified graph entity"
if holds "$doc" '"entity_id":'; then
  report fail "K1d name-derived identity is absent" "snapshot still emits a textual entity_id"
else
  report ok "K1d name-derived identity is absent"
fi

# T1/T2 — the transform engine is LIVE machinery in the direct-backend codegen
# path (`publicNameForInternal` / `requireMetaDispatchBeforeHook` gate every
# meta-dispatch site). `explain` is its only projection, so these two rows are
# what make that engine's registry non-scenery.
holds "$doc" '"transform_provenance":' \
  && report ok "T1 transform provenance is projected" \
  || report fail "T1 transform provenance is projected" "no transform_provenance key"
holds "$doc" '"transform_registry":' \
  && report ok "T2 transform registry is projected" \
  || report fail "T2 transform registry is projected" "no transform_registry key"

# O1 — optimization outcomes. The one field a performance miss must be
# diagnosable through (AGENTS.md: "a performance miss is a knowledge failure").
holds "$doc" '"optimization_outcomes":' \
  && report ok "O1 optimization outcomes are projected" \
  || report fail "O1 optimization outcomes are projected" "no optimization_outcomes key"

# A1 — assumption guards, the ledger's third field.
holds "$doc" '"assumptions":' \
  && report ok "A1 assumption guards are projected" \
  || report fail "A1 assumption guards are projected" "no assumptions key"

# R1 — THE DELETION, ASSERTED. `explain` used to render a `realizations` block
# whose every lowering variable SELECTED `lower.cequiv`, the C-equivalent
# lowering, with `"retained":true` — a plan naming a backend that refuses at
# exit 1. It carried zero cost facts (`LOWERING_COST_FACTS_ATTACHED = 0`) and a
# scalar `static_cost`, which is on this project's what-not-to-build list. It is
# gone, and this row keeps that legacy semantic authority gone: a re-introduction
# of its C-equivalent lowering fails rather than misinforming the next reader.
if holds "$doc" "lower.cequiv" || holds "$doc" "c_translation_unit"; then
  report fail "R1 no candidate names the legacy AST C lowering" "explain offers a non-graph lowering"
else
  report ok "R1 no candidate names the legacy AST C lowering"
fi

# D1 — refusal totality. A file the lexer refuses must still produce a
# DIAGNOSTIC rather than a host error name, and explain must not exit 0 on it.
bad="$work/lex_bad.id"
printf '// a C comment, which the idol lexer refuses\nmain: i64 = ()\n  0\n' >"$bad"
brc=0
( cd "$repo" && "$bin" explain "$bad" ) >"$work/bad.out" 2>"$work/bad.err" || brc=$?
if [ "$brc" = 0 ]; then
  report fail "D1 explain refuses a file the lexer refuses" "exited 0"
else
  report ok "D1 explain refuses a file the lexer refuses (exit $brc)"
fi
if grep -q "UnexpectedChar" "$work/bad.err" "$work/bad.out" 2>/dev/null; then
  report fail "D2 the refusal is a diagnostic, not a host error name" "printed UnexpectedChar"
else
  report ok "D2 the refusal is a diagnostic, not a host error name"
fi

printf '\n'
if [ "$fails" -eq 0 ]; then
  printf 'explain-gate: PASS — %s checks\n' "$reached"
  exit 0
fi
printf 'explain-gate: FAIL — %s of %s checks failed\n' "$fails" "$reached"
exit "$fails"
