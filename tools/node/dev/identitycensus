#!/bin/sh
# Identity census — law.zero.history current identity only.
set -eu
repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo"

paths="
AGENTS.md
CLAUDE.md
docs/orientation.md
docs/AGENT_ALIGNMENT.md
docs/METRICS.md
.agents/AGENT_CANONICAL.md
.agents/AGENT_COORDINATION.md
.agents/HARNESS.md
docs/spec/harness-projection.md
.cursor/rules/00-authority.mdc
.cursor/rules/10-language.mdc
.cursor/rules/50-mcp-lsp.mdc
"

retired='Idsem|idsem|Duon|duon|\.duo\b|language\.history'
count=0
for f in $paths; do
  [ -f "$f" ] || continue
  hits=$(rg -n "$retired" "$f" 2>/dev/null | rg -v 'law\.zero|ZERO-HISTORY|retired name|git stores|zerohistorycensus' || true)
  if [ -n "$hits" ]; then
    echo "identitycensus: FAIL $f"
    echo "$hits" | sed 's/^/  /'
    count=$((count + $(echo "$hits" | wc -l | tr -d ' ')))
  fi
done

if [ "$count" -gt 0 ]; then
  echo "identitycensus: $count retired identity reference(s) in agent projections"
  exit 1
fi
echo "identitycensus: pass agent projections current-only"
exit 0
