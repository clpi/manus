#!/bin/sh
# Serialize heavy Idol/Zig builds across concurrent agent sessions.
set -eu

lockdir="${IDOL_BUILD_LOCK:-/tmp/idol-lock}"
timeout="${IDOL_LOCK_TIMEOUT:-1800}"

usage() {
  echo "idol-lock: usage: idol-lock [--timeout N] -- cmd..." >&2
  exit 64
}

holder() {
  for entry in "$lockdir"/owner.*.*; do
    [ -d "$entry" ] || continue
    name=${entry##*/}
    printf '%s\n' "${name#owner.}"
    return 0
  done
  if [ -f "$lockdir/owner" ]; then
    name=$(cat "$lockdir/owner" 2>/dev/null || true)
    [ "$name" = "" ] || { printf '%s\n' "$name"; return 0; }
  fi
  printf 'unavailable\n'
}

if [ "$#" -eq 0 ]; then
  usage
fi

if [ "$1" = "status" ]; then
  if [ -d "$lockdir" ]; then
    printf 'LOCKED by %s\n' "$(holder)"
  else
    printf 'FREE\n'
  fi
  exit 0
fi

if [ "$1" = "--timeout" ]; then
  shift
  timeout="${1:-1800}"
  shift
fi

if [ "${1:-}" = "--" ]; then
  shift
fi

if [ "$#" -eq 0 ]; then
  usage
fi

if [ "${IDOL_LOCK_HELD:-}" = "1" ]; then
  exec "$@"
fi

waited=0
while ! mkdir "$lockdir" 2>/dev/null; do
  if [ "$waited" -ge "$timeout" ]; then
    echo "idol-lock: timed out after ${timeout}s waiting for lock ($(holder))" >&2
    exit 75
  fi
  sleep 1
  waited=$((waited + 1))
done

nonce=$(date +%s)
token="$lockdir/owner.$$.$nonce"
mkdir "$token"
export IDOL_LOCK_HELD=1
export IDOL_BUILD_LOCK="$lockdir"

cleanup() {
  rmdir "$token" 2>/dev/null || return 0
  rmdir "$lockdir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

set +e
"$@"
rc=$?
set -e
exit "$rc"
