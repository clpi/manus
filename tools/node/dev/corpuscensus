#!/bin/sh
# Interim @corpus tag census — GAP-161 / law.zero.history
# Durable states: current | foreign only.
set -eu
repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo"

# GAP-220 / GAP-201. EVERY enumeration below is `git ls-files` at the head of a
# pipeline, so its exit status is destroyed before anything can read it: in a
# tree with no `.git` each one yields nothing, every `rg` finds nothing, and
# this census prints `pass` for each check having examined NOTHING. Assert the
# tree and the subject set once, HERE, in the one position where the status
# survives. `gate/subject.sh` owns both rulings; if it is missing, `sh` exits
# 127 and this still refuses to run, which is the correct direction.
sh "$repo/gate/subject.sh" "*.id" >/dev/null || {
  echo "corpuscensus: REFUSED — subject enumeration is not trustworthy here" >&2
  exit 3
}

fail=0

check_first_line() {
  f="$1"
  want="$2"
  first=$(head -1 "$f")
  echo "$first" | rg -q "^# @corpus ${want}\$" || {
    echo "corpuscensus: FAIL $f — need '# @corpus ${want}'"
    fail=$((fail + 1))
  }
}

# Current teaching fixtures under semantic example homes
for f in examples/conversion/*.id examples/demand/*.id examples/nominal/*.id \
         examples/infer/*.id examples/projection/*.id examples/layout/*.id \
         examples/pack/*.id examples/anchor/*.id examples/case/*.id \
         examples/read/*.id; do
  [ -f "$f" ] || continue
  check_first_line "$f" current
done

for f in examples/compile_fail/*.id; do
  [ -f "$f" ] || continue
  check_first_line "$f" current
done

# Retired corpus labels must not appear
bad=$(git ls-files '*.id' 2>/dev/null | xargs rg -l '@corpus (verified|proof|history|migration|compat|legacy)' 2>/dev/null || true)
if [ -n "$bad" ]; then
  echo "corpuscensus: FAIL retired @corpus labels:"
  echo "$bad" | sed 's/^/  /'
  fail=$((fail + 1))
fi

if [ "$fail" -gt 0 ]; then
  echo "corpuscensus: $fail issue(s)"
  exit 1
fi
echo "corpuscensus: pass current corpus tags"
