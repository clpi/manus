#!/usr/bin/env python3
"""Exact-range structural candidate admission.

This is a bounded control-plane bridge.  It does not decide Idol semantics or
own public vocabulary.  Full admission remains unavailable unless the existing
Idol admission, host, and architecture programs execute successfully.

This verifier deliberately cannot admit changes to itself, its workflow, its
gates, or its protected ledgers.  Those controls are updated only through a
trusted bootstrap: review the exact base/new blobs, run both versions' damage
controls with an exact compiler, install the new base, then let this verifier
govern later candidates.  A candidate-declared lane can never grant that trust.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time


REJECT = 1
USAGE = 64
UNAVAILABLE = 125
HEX40 = re.compile(r"[0-9a-f]{40}\Z")
HEX64 = re.compile(r"[0-9a-f]{64}\Z")
PATH = re.compile(r"[A-Za-z0-9._/-]+\Z")
GATES = ("gate/path.id", "gate/idiom.id")
FULL = ("gate/admission.id", "gate/host.id", "gate/architecture.id")
BOOTSTRAP = (".github/workflows/candidate.yml", "tools/node/dev/candidate")
LANES = frozenset(("ingress", "grammar", "graph", "demand", "memory", "native", "wasm", "evidence"))
CONTROL = frozenset(
    GATES
    + FULL
    + (
        ".github/workflows/candidate.yml",
        "docs/spec/std-zero-ledger.json",
        "tools/node/dev/candidate",
    )
)
LAW = {
    "AGENTS.md",
    "CLAUDE.md",
    "docs/spec/canonical.md",
    "docs/spec/constitution.md",
    "docs/spec/law.md",
    "docs/spec/source.md",
}
MARKER = "<!-- idol-candidate\n"
MARKEREND = "\n-->"


class Refusal(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def refuse(message):
    raise Refusal(REJECT, message)


def unavailable(message):
    raise Refusal(UNAVAILABLE, message)


def sha(data):
    return hashlib.sha256(data).hexdigest()


def filebytes(path):
    try:
        return path.read_bytes()
    except OSError as error:
        unavailable(f"cannot read {path}: {error}")


def call(argv, cwd, body=None, limit=60, environment=None):
    try:
        return subprocess.run(
            argv,
            cwd=str(cwd),
            input=body,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=limit,
            check=False,
            env=environment,
        )
    except subprocess.TimeoutExpired:
        unavailable(f"command timed out after {limit}s: {argv[0]}")
    except OSError as error:
        unavailable(f"cannot execute {argv[0]}: {error}")


def processrow(label, event, status, stdout, stderr):
    print(
        f"candidate.process label={label} event={event} status={status} "
        f"stdout_bytes={len(stdout)} stdout_sha256={sha(stdout)} "
        f"stderr_bytes={len(stderr)} stderr_sha256={sha(stderr)}"
    )


def callgroup(argv, cwd, body=None, limit=60, environment=None, label="process"):
    try:
        process = subprocess.Popen(
            argv,
            cwd=str(cwd),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
            env=environment,
        )
    except OSError as error:
        unavailable(f"cannot execute {argv[0]}: {error}")
    try:
        stdout, stderr = process.communicate(body, timeout=limit)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        stdout, stderr = process.communicate()
        processrow(label, "timeout", process.returncode, stdout, stderr)
        unavailable(f"command process group timed out after {limit}s: {argv[0]}")
    event = f"signal:{-process.returncode}" if process.returncode < 0 else "ok"
    processrow(label, event, process.returncode, stdout, stderr)
    return subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)


def git(repo, *args, ok=True):
    result = call(["git", *args], repo)
    if ok and result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip()
        unavailable(f"git {' '.join(args)} failed: {detail}")
    return result


def root():
    result = call(["git", "rev-parse", "--show-toplevel"], Path.cwd())
    if result.returncode != 0:
        unavailable("candidate must run inside a Git worktree")
    return Path(result.stdout.decode().strip()).resolve()


def validpath(value):
    if not PATH.fullmatch(value) or value.startswith("/") or value.endswith("/"):
        return False
    parts = value.split("/")
    return all(part not in ("", ".", "..") for part in parts)


def strictjson(body, label):
    def objectpairs(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError(f"duplicate JSON key: {key}")
            value[key] = item
        return value

    def constant(value):
        raise ValueError(f"non-standard JSON constant: {value}")

    try:
        return json.loads(body, object_pairs_hook=objectpairs, parse_constant=constant)
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        raise Refusal(USAGE, f"{label} is not exact JSON: {error}")


def jsonfile(path):
    try:
        body = Path(path).read_bytes()
    except OSError as error:
        unavailable(f"cannot read candidate contract: {error}")
    return strictjson(body, "candidate contract"), sha(body)


def eventfile(path):
    event, eventsha = jsonfile(path)
    try:
        request = event["pull_request"]
        body = request["body"] or ""
        eventbase = request["base"]["sha"]
        eventhead = request["head"]["sha"]
        default = event["repository"]["default_branch"]
        baseref = request["base"]["ref"]
    except (KeyError, TypeError):
        raise Refusal(USAGE, "GitHub event is not a pull_request event")
    if baseref != default:
        refuse(f"pull request base is not the protected default branch: {baseref}")
    if body.count(MARKER) != 1:
        raise Refusal(USAGE, "pull request body must contain exactly one idol-candidate JSON block")
    start = body.index(MARKER) + len(MARKER)
    end = body.find(MARKEREND, start)
    if end < 0:
        raise Refusal(USAGE, "idol-candidate JSON block is not terminated")
    encoded = body[start:end].encode("utf-8")
    contract = strictjson(encoded, "idol-candidate block")
    return contract, sha(encoded), eventsha, eventbase, eventhead


def contract(args):
    if args.event:
        value, digest, eventsha, eventbase, eventhead = eventfile(args.event)
        print(f"candidate.event sha256={eventsha}")
    else:
        value, digest = jsonfile(args.contractfile)
        eventbase = None
        eventhead = None
    if not isinstance(value, dict) or type(value.get("version")) is not int or value["version"] not in (1, 2):
        raise Refusal(USAGE, "candidate contract version must be 1 or 2")
    fields = {"version", "base", "head", "lane", "paths", "compatibility"}
    if value["version"] == 2:
        fields.add("rename")
    if set(value) != fields:
        raise Refusal(USAGE, "candidate contract fields differ from its version")
    if not isinstance(value["base"], str) or not HEX40.fullmatch(value["base"]):
        raise Refusal(USAGE, "candidate contract base must be exact lowercase 40-hex")
    if not isinstance(value["head"], str) or not HEX40.fullmatch(value["head"]):
        raise Refusal(USAGE, "candidate contract head must be exact lowercase 40-hex")
    if value["lane"] not in LANES:
        raise Refusal(USAGE, f"candidate lane is not declared: {value['lane']!r}")
    if not isinstance(value["paths"], list) or not value["paths"]:
        raise Refusal(USAGE, "candidate contract paths must be a nonempty array")
    paths = []
    expected = {}
    for row in value["paths"]:
        if not isinstance(row, dict) or set(row) != {"path", "sha256"}:
            raise Refusal(USAGE, "each candidate path row must have exactly path/sha256")
        path = row["path"]
        digestrow = row["sha256"]
        if not isinstance(path, str) or not validpath(path):
            raise Refusal(USAGE, "candidate contract contains an invalid path")
        if digestrow is not None and (not isinstance(digestrow, str) or not HEX64.fullmatch(digestrow)):
            raise Refusal(USAGE, f"candidate blob digest is invalid: {path}")
        if path in expected:
            raise Refusal(USAGE, f"candidate contract repeats path: {path}")
        paths.append(path)
        expected[path] = digestrow
    if paths != sorted(paths):
        raise Refusal(USAGE, "candidate contract paths must be sorted")
    compatibility = value["compatibility"]
    if not isinstance(compatibility, list) or any(not isinstance(path, str) for path in compatibility):
        raise Refusal(USAGE, "candidate compatibility must be an array of paths")
    if compatibility != sorted(set(compatibility)):
        raise Refusal(USAGE, "candidate compatibility paths must be sorted and unique")
    if any(not validpath(path) or path not in expected for path in compatibility):
        raise Refusal(USAGE, "candidate compatibility paths must be declared changed paths")
    if value["version"] == 2:
        if not isinstance(value["rename"], list) or not value["rename"]:
            raise Refusal(USAGE, "candidate rename must be a nonempty array")
        endpoints = []
        order = []
        for row in value["rename"]:
            if not isinstance(row, dict) or set(row) not in ({"from", "to", "sha256"}, {"from", "to", "sha256", "reference"}):
                raise Refusal(USAGE, "each candidate rename must have from/to/sha256 and optional reference")
            if not isinstance(row["sha256"], str) or not HEX64.fullmatch(row["sha256"]):
                raise Refusal(USAGE, "candidate rename source digest is invalid")
            for field in ("from", "to"):
                path = row[field]
                if not isinstance(path, str) or not validpath(path) or path not in expected:
                    raise Refusal(USAGE, "candidate rename endpoints must be declared changed paths")
                if any(path == prior or path.startswith(prior + "/") or prior.startswith(path + "/") for prior in endpoints):
                    raise Refusal(USAGE, "candidate rename endpoints overlap")
                if path in compatibility:
                    refuse("candidate rename endpoints cannot declare compatibility")
                endpoints.append(path)
            if expected[row["from"]] is not None or expected[row["to"]] is None:
                refuse("candidate rename must declare a deleted source and a surviving destination")
            order.append((row["from"], row["to"]))
        if order != sorted(order):
            raise Refusal(USAGE, "candidate rename rows must be sorted")
        for row in value["rename"]:
            if "reference" not in row:
                continue
            if not isinstance(row["reference"], list) or not row["reference"]:
                raise Refusal(USAGE, "candidate reference must be a nonempty array")
            paths = []
            for reference in row["reference"]:
                if not isinstance(reference, dict) or set(reference) != {"path", "sha256"}:
                    raise Refusal(USAGE, "each candidate reference must have exactly path/sha256")
                path = reference["path"]
                if not isinstance(path, str) or not validpath(path) or path not in expected:
                    raise Refusal(USAGE, "candidate reference must name a declared changed path")
                if path in endpoints or path in compatibility or expected[path] is None:
                    refuse("candidate reference must be a surviving carrier outside rename endpoints and compatibility")
                if not isinstance(reference["sha256"], str) or not HEX64.fullmatch(reference["sha256"]):
                    raise Refusal(USAGE, "candidate reference source digest is invalid")
                paths.append(path)
            if paths != sorted(set(paths)):
                raise Refusal(USAGE, "candidate reference paths must be sorted and unique")
    if eventbase is not None and (value["base"] != eventbase or value["head"] != eventhead):
        refuse("candidate contract base/head differs from pull_request event")
    return value, expected, set(compatibility), digest


def changes(repo, base, head):
    raw = git(
        repo,
        "diff",
        "--no-ext-diff",
        "--no-textconv",
        "--name-status",
        "-z",
        "--find-renames",
        "--find-copies",
        base,
        head,
        "--",
    ).stdout
    fields = raw.split(b"\0")
    if fields and fields[-1] == b"":
        fields.pop()
    rows = []
    renamed = []
    index = 0
    while index < len(fields):
        statusname = fields[index].decode("ascii", "strict")
        index += 1
        if statusname.startswith(("R", "C")):
            if index + 1 >= len(fields):
                unavailable("malformed Git rename/copy record")
            old = fields[index].decode("utf-8", "strict")
            new = fields[index + 1].decode("utf-8", "strict")
            if statusname.startswith("C"):
                refuse(f"copy is outside structural admission: {old} -> {new}")
            if not validpath(old) or not validpath(new):
                refuse("unsupported repository rename path spelling")
            renamed.append((old, new))
            rows.extend((("D", old), ("A", new)))
            index += 2
            continue
        if index >= len(fields):
            unavailable("malformed Git changed-path record")
        path = fields[index].decode("utf-8", "strict")
        index += 1
        if statusname == "T":
            refuse(f"candidate file type changes are outside structural admission: {path}")
        if statusname not in ("A", "M", "D"):
            refuse(f"unsupported Git change status {statusname}: {path}")
        if not validpath(path):
            refuse(f"unsupported repository path spelling: {path!r}")
        rows.append((statusname, path))
    return rows, renamed


def rename(repo, value, actual):
    declared = value.get("rename", [])
    if sorted(actual) != [(row["from"], row["to"]) for row in declared]:
        refuse("candidate rename relation differs from exact Git range")
    for row in declared:
        old, new = row["from"], row["to"]
        if git(repo, "ls-tree", "-z", value["head"], "--", old).stdout:
            refuse(f"candidate rename source survives at head: {old}")
        if git(repo, "ls-tree", "-z", value["base"], "--", new).stdout:
            refuse(f"candidate rename destination existed at base: {new}")
        before = blobmode(repo, value["base"], old)
        after = blobmode(repo, value["head"], new)
        if before != after:
            refuse(f"candidate rename changed file mode: {old} -> {new}")
        digest = sha(blob(repo, value["base"], old))
        if digest != row["sha256"]:
            refuse(f"candidate rename source digest mismatch: {old}")
        print(f"candidate.rename source={old} destination={new} source_sha256={digest}")
    return {row["from"] for row in declared}


def reference(repo, value, statuses):
    carriers = {}
    for row in value.get("rename", []):
        for declared in row.get("reference", []):
            carriers.setdefault(declared["path"], []).append((row["from"], row["to"], declared["sha256"]))
    for path, relations in carriers.items():
        if statuses.get(path) != "M":
            refuse(f"candidate reference must modify an existing carrier: {path}")
        if blobmode(repo, value["base"], path) != blobmode(repo, value["head"], path):
            refuse(f"candidate reference changed carrier mode: {path}")
        before = sourceblob(repo, value["base"], path)
        after = sourceblob(repo, value["head"], path)
        digest = sha(before)
        spans = []
        for old, new, expected in relations:
            if digest != expected:
                refuse(f"candidate reference source digest mismatch: {path}")
            if any(source in new for source, _, _ in relations):
                refuse(f"candidate reference mappings cascade: {path}")
            old, new = old.encode(), new.encode()
            index = before.find(old)
            if index < 0:
                refuse(f"candidate reference has no source occurrence: {path}")
            while index >= 0:
                spans.append((index, index + len(old), new))
                index = before.find(old, index + 1)
        spans.sort()
        chunks = []
        cursor = 0
        for start, end, replacement in spans:
            if start < cursor:
                refuse(f"candidate reference occurrences overlap: {path}")
            chunks.extend((before[cursor:start], replacement))
            cursor = end
        chunks.append(before[cursor:])
        if b"".join(chunks) != after:
            refuse(f"candidate reference contains changes outside declared rebinding: {path}")
        print(f"candidate.reference path={path} source_sha256={digest} occurrences={len(spans)}")
    return set(carriers)


def diff(repo, base, head, paths):
    if not paths:
        return b""
    return git(
        repo,
        "diff",
        "--no-ext-diff",
        "--no-textconv",
        "--text",
        "--no-color",
        "--no-renames",
        "--unified=0",
        base,
        head,
        "--",
        *paths,
    ).stdout


def additions(body):
    return [
        line[1:]
        for line in body.splitlines()
        if line.startswith(b"+") and not line.startswith(b"+++")
    ]


def blob(repo, revision, path):
    result = git(repo, "show", f"{revision}:{path}", ok=False)
    if result.returncode != 0:
        unavailable(f"head does not contain required gate: {path}")
    return result.stdout


def blobmode(repo, revision, path):
    result = git(repo, "ls-tree", "-z", revision, "--", path)
    rows = [row for row in result.stdout.split(b"\0") if row]
    if len(rows) != 1:
        unavailable(f"head has no unique tree entry for changed path: {path}")
    try:
        metadata, actual = rows[0].split(b"\t", 1)
        mode, kind, _ = metadata.split(b" ", 2)
    except ValueError:
        unavailable(f"head has malformed tree metadata for changed path: {path}")
    if actual.decode("utf-8", "strict") != path or kind != b"blob":
        refuse(f"candidate path is not an ordinary blob: {path}")
    if mode not in (b"100644", b"100755"):
        refuse(f"candidate path has an unsupported file mode {mode.decode()}: {path}")
    return mode.decode()


def gitblobid(data):
    return hashlib.sha1(f"blob {len(data)}\0".encode("ascii") + data).hexdigest()


def trustedmanifest(trustedroot):
    rows = git(trustedroot, "ls-files", "--stage", "-z").stdout.split(b"\0")
    framed = []
    files = 0
    for raw in rows:
        if not raw:
            continue
        try:
            metadata, encoded = raw.split(b"\t", 1)
            mode, objectid, stage = metadata.split(b" ", 2)
            path = encoded.decode("utf-8", "strict")
        except ValueError:
            unavailable("protected-base index contains malformed metadata")
        if stage != b"0" or not validpath(path):
            unavailable(f"protected-base index contains unmerged or unsafe path: {path!r}")
        target = trustedroot / path
        try:
            filestat = target.lstat()
        except OSError as error:
            unavailable(f"protected-base worktree lost tracked path {path}: {error}")
        if mode == b"120000":
            if not stat.S_ISLNK(filestat.st_mode):
                unavailable(f"protected-base worktree changed tracked type: {path}")
            data = os.readlink(target).encode("utf-8")
        elif mode in (b"100644", b"100755"):
            if not stat.S_ISREG(filestat.st_mode):
                unavailable(f"protected-base worktree changed tracked type: {path}")
            if bool(filestat.st_mode & stat.S_IXUSR) != (mode == b"100755"):
                unavailable(f"protected-base worktree changed executable mode: {path}")
            data = filebytes(target)
        else:
            unavailable(f"protected-base worktree has unsupported tracked mode {mode.decode()}: {path}")
        if gitblobid(data) != objectid.decode("ascii"):
            unavailable(f"protected-base worktree bytes differ from index: {path}")
        framed.append(mode + b"\0" + encoded + b"\0" + sha(data).encode() + b"\n")
        files += 1
    if files == 0:
        unavailable("protected-base worktree contains zero tracked files")
    return sha(b"".join(framed)), files


def bindtrusted(repo, trustedroot, revision):
    trustedroot = trustedroot.resolve()
    if trustedroot == repo.resolve():
        unavailable("protected-base execution root must be separate from the candidate worktree")
    top = git(trustedroot, "rev-parse", "--show-toplevel").stdout.decode().strip()
    if Path(top).resolve() != trustedroot:
        unavailable("protected-base execution root is not an exact Git worktree root")
    head = git(trustedroot, "rev-parse", "HEAD").stdout.decode().strip()
    if head != revision:
        unavailable(f"protected-base execution root has wrong HEAD: expected {revision}, got {head}")
    wanttree = git(repo, "rev-parse", revision + "^{tree}").stdout.decode().strip()
    gottree = git(trustedroot, "rev-parse", "HEAD^{tree}").stdout.decode().strip()
    if gottree != wanttree:
        unavailable(f"protected-base execution root has wrong tree: expected {wanttree}, got {gottree}")
    statusbody = git(trustedroot, "status", "--porcelain=v1", "-z", "--untracked-files=all").stdout
    if statusbody:
        unavailable("protected-base execution root is dirty or has untracked files")
    ignored = git(
        trustedroot,
        "ls-files",
        "--others",
        "--ignored",
        "--exclude-standard",
        "-z",
    ).stdout
    if ignored:
        unavailable("protected-base execution root contains ignored files")
    manifest, files = trustedmanifest(trustedroot)
    identity = sha((head + "\0" + gottree + "\0" + manifest).encode())
    print(
        f"candidate.protected_base root={trustedroot} commit={head} "
        f"tree={gottree} files={files} manifest_sha256={manifest} identity_sha256={identity}"
    )
    return trustedroot, identity


def gates(repo, trustedroot, base, head, paths):
    bound = {}
    for path in paths:
        committed = blob(repo, head, path)
        baseblob = blob(repo, base, path)
        if committed != baseblob:
            refuse(f"admission gate changed inside candidate range: {path}")
        disk = filebytes(trustedroot / path)
        if disk != committed:
            unavailable(f"gate differs from exact head: {path}")
        bound[path] = sha(disk)
        print(f"candidate.gate path={path} sha256={bound[path]}")
    return bound


def bootstrap(repo, trustedroot, base, head):
    executed = Path(__file__).resolve()
    expected = (trustedroot / "tools/node/dev/candidate").resolve()
    if executed != expected:
        unavailable(f"verifier did not execute from protected-base root: {executed}")
    bound = {}
    for path in BOOTSTRAP:
        basebody = blob(repo, base, path)
        headbody = blob(repo, head, path)
        diskbody = filebytes(trustedroot / path)
        if basebody != headbody:
            refuse(f"base-owned admission control changed inside candidate: {path}")
        if diskbody != basebody:
            unavailable(f"protected bootstrap bytes differ from exact base: {path}")
        bound[path] = sha(diskbody)
        print(f"candidate.bootstrap path={path} sha256={bound[path]}")
    return bound


def clean(repo):
    statusout = git(repo, "status", "--porcelain=v1", "-z", "--untracked-files=all").stdout
    if statusout:
        refuse("candidate worktree is dirty or has untracked files")


def generated(repo, head, rows):
    for statusname, path in rows:
        if statusname == "D":
            continue
        # Generated artifacts carry their warning at the file boundary.  Do not
        # let a detector's own planted marker turn the detector into an artifact.
        data = b"\n".join(blob(repo, head, path).splitlines()[:8]).lower()
        marker = b"do not edit" in data and (
            b"generated" in data or b"auto-generated" in data or b"autogenerated" in data
        )
        named = any(
            part.endswith(("_gen", "-gen")) or "_gen." in part or "-gen." in part
            for part in path.split("/")
        )
        if marker or named:
            refuse(f"generated projection changed in candidate: {path}")


def protected(rows):
    for _, path in rows:
        if path in CONTROL:
            refuse(
                f"base-owned admission control changed inside candidate: {path}; "
                "trusted bootstrap installation is required"
            )


def compatclasses(repo, base):
    data = blob(repo, base, "docs/spec/std-zero-ledger.json")
    try:
        ledger = strictjson(data, "protected std ledger")
    except Refusal as error:
        unavailable(error.message)
    if not isinstance(ledger, dict) or ledger.get("schema") != "std-zero-ledger/1":
        unavailable("protected std ledger schema is unavailable")
    rows = ledger.get("files")
    if not isinstance(rows, list):
        unavailable("protected std ledger has no file rows")
    classes = {}
    for row in rows:
        if (
            not isinstance(row, dict)
            or not isinstance(row.get("path"), str)
            or not validpath(row["path"])
            or not isinstance(row.get("class"), str)
            or not isinstance(row.get("code_budget"), int)
            or isinstance(row.get("code_budget"), bool)
            or row["code_budget"] < 0
        ):
            unavailable("protected std ledger has a malformed file row")
        path = row["path"]
        if path in classes:
            unavailable(f"protected std ledger repeats path: {path}")
        classes[path] = (row["class"], row["code_budget"])
    return classes, sha(data)


def codeface(data):
    try:
        source = data.decode("utf-8")
    except UnicodeDecodeError as error:
        unavailable(f"Idol source is not UTF-8: {error}")
    visible = []
    state = "code"
    index = 0
    while index < len(source):
        char = source[index]
        if state == "comment":
            if char in "\r\n":
                state = "code"
                visible.append(char)
            else:
                visible.append(" ")
            index += 1
            continue
        if state in ("'", '"'):
            if char == "\\" and index + 1 < len(source):
                visible.extend((" ", "\n" if source[index + 1] == "\n" else " "))
                index += 2
                continue
            if char == state:
                state = "code"
            visible.append("\n" if char == "\n" else " ")
            index += 1
            continue
        if char == "#":
            state = "comment"
            visible.append(" ")
        elif char in ("'", '"'):
            state = char
            visible.append(" ")
        else:
            visible.append(char)
        index += 1
    return "".join(visible)


def stdsites(data):
    return len(re.findall(r"(?<![A-Za-z0-9_])std\.", codeface(data)))


def mainsites(data):
    source = codeface(data)
    # Top-level source bindings only.  Physical ABI symbols are not Idol
    # declarations, nested bindings are not entry faces, and a bare `main()`
    # expression is a call rather than a declaration.  Both descriptor-before
    # and descriptor-after-pack forms remain debt under this non-increase
    # ratchet, as does the retired callable-head face.
    total = 0
    for match in re.finditer(r"^main(?=[ \t:=\(])", source, re.MULTILINE):
        cursor = match.end()
        while cursor < len(source) and source[cursor] in " \t":
            cursor += 1
        if cursor < len(source) and source[cursor] == ":":
            equal = source.find("=", cursor + 1, source.find("\n", cursor + 1) if "\n" in source[cursor + 1 :] else len(source))
            if equal < 0:
                continue
            cursor = equal
        if cursor < len(source) and source[cursor] == "=":
            cursor += 1
            while cursor < len(source) and source[cursor].isspace():
                cursor += 1
            if cursor < len(source) and source[cursor] == "(":
                total += 1
            continue
        if cursor >= len(source) or source[cursor] != "(":
            continue
        depth = 0
        while cursor < len(source):
            if source[cursor] == "(":
                depth += 1
            elif source[cursor] == ")":
                depth -= 1
                if depth == 0:
                    cursor += 1
                    break
            cursor += 1
        while cursor < len(source) and source[cursor] in " \t":
            cursor += 1
        if cursor < len(source) and source[cursor] in ":=":
            total += 1
    return total


def sourceblob(repo, revision, path):
    result = git(repo, "show", f"{revision}:{path}", ok=False)
    if result.returncode != 0:
        unavailable(f"cannot read exact source blob {revision}:{path}")
    return result.stdout


def compatibility(repo, base, head, rows, paths):
    classes, digest = compatclasses(repo, base)
    print(f"candidate.ledger path=docs/spec/std-zero-ledger.json sha256={digest}")
    for path in paths:
        row = classes.get(path)
        if row is None or row[0] not in ("compatibility", "negative-fixture"):
            refuse(f"compatibility declaration escapes its protected fixture class: {path}")
    for statusname, path in rows:
        if not path.endswith(".id"):
            continue
        old = b"" if statusname == "A" else sourceblob(repo, base, path)
        new = b"" if statusname == "D" else sourceblob(repo, head, path)
        budget = classes[path][1] if path in classes else 0
        before = stdsites(old)
        actual = stdsites(new)
        if actual > budget or actual > before:
            refuse(
                f"std code-site budget increased: {path} "
                f"base={before} budget={budget} actual={actual}"
            )
        oldmain = mainsites(old)
        newmain = mainsites(new)
        if newmain > oldmain:
            refuse(f"ceremonial main count increased: {path} base={oldmain} head={newmain}")


def public(repo, base, head, rows):
    for statusname, path in rows:
        if path in LAW:
            refuse(f"semantic-law/public-vocabulary authority is outside structural admission: {path}")
        if statusname == "A" and path.startswith("lib/") and path.endswith(".id"):
            refuse(f"new canonical library surface requires semantic admission: {path}")

    for statusname, path in rows:
        if statusname == "D" or not path.startswith("lib/") or not path.endswith(".id"):
            continue
        body = diff(repo, base, head, [path])
        for line in additions(body):
            text = line.decode("utf-8", "strict")
            if text and not text[0].isspace() and not text.startswith("#"):
                refuse(f"new top-level library vocabulary requires semantic admission: {path}")


def output(result):
    return result.stdout.decode("utf-8", "replace") + result.stderr.decode("utf-8", "replace")


def freshcompile(idol, repo, source, target, limit, environment, extra=()):
    argv = [str(idol), "compile", "--build-report", "plain", "--no-color"]
    argv.extend(extra)
    argv.extend((str(source), "-o", str(target)))
    result = callgroup(
        argv,
        repo,
        limit=limit,
        environment=environment,
        label=f"compile:{source}",
    )
    exactlog = result.stderr == f"✓ {target}\n".encode("utf-8")
    print(
        f"candidate.compiler source={source} output={target} exit={result.returncode} "
        f"stdout_sha256={sha(result.stdout)} stderr_sha256={sha(result.stderr)} cache=miss"
    )
    if result.returncode != 0 or result.stdout or not exactlog:
        text = output(result)
        if text:
            sys.stderr.write(text)
            if not text.endswith("\n"):
                sys.stderr.write("\n")
        unavailable(
            f"compile tuple disagrees with exact source/output/cold-cache request: {source} "
            f"(exit {result.returncode})"
        )
    try:
        targetmode = target.stat().st_mode
    except OSError as error:
        unavailable(f"compile produced no artifact for {source}: {error}")
    if not stat.S_ISREG(targetmode) or not os.access(str(target), os.X_OK):
        unavailable(f"compile produced no executable regular artifact: {source}")
    return sha(filebytes(target))


def rungate(repo, idol, path, body, marker, failmark, limit, outdir):
    target = outdir / path.replace("/", "-").replace(".id", "")
    scratch = outdir / (target.name + "-tmp")
    scratch.mkdir()
    environment = os.environ.copy()
    environment.update(
        {
            "TMPDIR": str(scratch),
            "TMP": str(scratch),
            "TEMP": str(scratch),
        }
    )
    freshcompile(idol, repo, path, target, limit, environment)

    result = callgroup(
        [str(target)],
        repo,
        body,
        limit,
        environment,
        label=f"run:{path}",
    )
    print(
        f"candidate.runner path={path} exit={result.returncode} "
        f"stdout_sha256={sha(result.stdout)} stderr_sha256={sha(result.stderr)}"
    )
    stdout = result.stdout.decode("utf-8", "replace")
    stderr = result.stderr.decode("utf-8", "replace")
    poisoned = "[control: fail]" in stdout or "control FAIL" in stdout
    if marker == "[control: pass]":
        name = path.removesuffix(".id")
        summaries = re.findall(
            rf"^{re.escape(name)}: ([0-9]+) finding\(s\).*  \[control: pass\]$",
            stdout,
            re.MULTILINE,
        )
        if result.returncode == 0 and summaries == ["0"] and not poisoned and not stderr:
            print(f"candidate.runner path={path} outcome=pass")
            return
        if (
            result.returncode == 1
            and len(summaries) == 1
            and int(summaries[0]) > 0
            and not poisoned
            and not stderr
        ):
            sys.stderr.write(stdout)
            refuse(f"candidate findings reported by {path}")
    else:
        successmark = marker in stdout and (marker == failmark or failmark not in stdout)
        failuremark = failmark in stdout and (marker == failmark or marker not in stdout)
        if result.returncode == 0 and successmark and not poisoned and not stderr:
            print(f"candidate.runner path={path} outcome=pass")
            return
        if result.returncode == 1 and failuremark and not poisoned and not stderr:
            sys.stderr.write(stdout)
            refuse(f"candidate findings reported by {path}")
    text = stdout + stderr
    if text:
        sys.stderr.write(text)
        if not text.endswith("\n"):
            sys.stderr.write("\n")
    unavailable(f"runner unavailable or failed its controls: {path} (exit {result.returncode})")


def verify(repo, args):
    value, expected, compat, contractsha = contract(args)
    base = value["base"]
    head = value["head"]
    lane = value["lane"]
    declared = list(expected)
    if not HEX40.fullmatch(args.protectedbase):
        raise Refusal(USAGE, "protected base must be exact lowercase 40-hex")
    if base != args.protectedbase:
        refuse(f"candidate base is stale or not the protected-main event base: {base}")
    if not HEX64.fullmatch(args.idolsha):
        raise Refusal(USAGE, "idol sha256 must be exact lowercase 64-hex")
    if args.limit <= 0:
        raise Refusal(USAGE, "timeout must be a positive decimal")
    trustedroot = Path(args.trustedroot)

    idol = Path(args.idol).resolve()
    try:
        mode = idol.stat().st_mode
    except OSError as error:
        unavailable(f"compiler is unavailable: {error}")
    if not stat.S_ISREG(mode) or not os.access(str(idol), os.X_OK):
        unavailable("compiler must be an executable regular file")
    idolbefore = sha(filebytes(idol))
    if idolbefore != args.idolsha:
        unavailable(f"compiler digest mismatch: expected {args.idolsha}, got {idolbefore}")

    clean(repo)
    actualhead = git(repo, "rev-parse", "HEAD").stdout.decode().strip()
    if actualhead != head:
        refuse(f"checked-out head mismatch: expected {head}, got {actualhead}")
    for revision in (base, head):
        result = git(repo, "cat-file", "-e", f"{revision}^{{commit}}", ok=False)
        if result.returncode != 0:
            unavailable(f"declared revision is unavailable: {revision}")
    ancestor = git(repo, "merge-base", "--is-ancestor", base, head, ok=False)
    if ancestor.returncode != 0:
        refuse("declared base is not an ancestor of declared head")
    if base == head:
        refuse("candidate range is empty")

    rows, renamed = changes(repo, base, head)
    if not rows:
        refuse("candidate range changes zero paths")
    actual = sorted(path for _, path in rows)
    if actual != declared:
        refuse(f"declared path set differs from exact range: declared={declared!r} actual={actual!r}")
    retired = rename(repo, value, renamed)
    statuses = {path: statusname for statusname, path in rows}
    carriers = reference(repo, value, statuses)
    for path in actual:
        want = expected[path]
        if statuses[path] == "D":
            if want is not None:
                refuse(f"deleted candidate path must declare null blob digest: {path}")
        else:
            got = sha(blob(repo, head, path))
            if want != got:
                refuse(f"candidate blob digest mismatch: {path} expected={want} actual={got}")
            blobmode(repo, head, path)

    pathset = b"".join(
        path.encode() + b"\0" + ((expected[path] or "null").encode()) + b"\n" for path in actual
    )
    compatset = ("\n".join(sorted(compat)) + ("\n" if compat else "")).encode()
    print(
        f"candidate.subject base={base} head={head} lane={lane} contract_sha256={contractsha} "
        f"paths={len(actual)} pathset_sha256={sha(pathset)} compatibility_paths={len(compat)} "
        f"compatibility_pathset_sha256={sha(compatset)} compiler_sha256={idolbefore}"
    )
    protected(rows)
    compatibility(repo, base, head, rows, compat)
    generated(repo, base, [("M", path) for path in sorted(retired | carriers)])
    generated(repo, head, rows)
    idpaths = [path for _, path in rows if path.endswith(".id")]
    iddiff = diff(repo, base, head, idpaths)
    canonicalpaths = [path for path in idpaths if path not in compat]
    canonicaldiff = diff(repo, base, head, canonicalpaths)
    public(repo, base, head, rows)

    namepacket = "\n".join(path for path in actual if path not in retired | carriers).encode() + b"\n"
    packet = b"IDOLGATE staged\n" + namepacket + b"IDOLGATE namediff\n" + iddiff + b"\nIDOLGATE end\n"
    with tempfile.TemporaryDirectory(prefix="idol-candidate-output-") as temporary:
        private = Path(temporary)
        trustedroot, trustedbefore = bindtrusted(repo, trustedroot, base)
        bound = bootstrap(repo, trustedroot, base, head)
        bound.update(gates(repo, trustedroot, base, head, GATES + (FULL if args.mode == "full" else ())))
        outdir = private / "output"
        outdir.mkdir()
        rungate(trustedroot, idol, "gate/path.id", packet, "[control: pass]", "[control: pass]", args.limit, outdir)
        idadds = additions(canonicaldiff)
        if idadds:
            rungate(
                trustedroot,
                idol,
                "gate/idiom.id",
                canonicaldiff,
                "[control: pass]",
                "[control: pass]",
                args.limit,
                outdir,
            )
        else:
            print("candidate.runner path=gate/idiom.id outcome=not-applicable subjects=0")

        if args.mode == "full":
            probe = b"--- /dev/null\n+++ b/examples/probe.id\n@@ -0,0 +1 @@\n+value = text:len()\n"
            semanticbody = canonicaldiff if idadds else probe
            rungate(
                trustedroot,
                idol,
                "gate/admission.id",
                semanticbody,
                "[controls: A-H pass]",
                "[controls: A-H pass]",
                args.limit,
                outdir,
            )
            alldiff = diff(repo, base, head, actual)
            hostbody = alldiff if additions(alldiff) else probe
            rungate(
                trustedroot,
                idol,
                "gate/host.id",
                hostbody,
                "[control: pass]",
                "[control: pass]",
                args.limit,
                outdir,
            )
            rungate(
                trustedroot,
                idol,
                "gate/architecture.id",
                b"",
                "(semanticgate, pass,",
                "(semanticgate, fail,",
                args.limit,
                outdir,
            )

        _, trustedafter = bindtrusted(repo, trustedroot, base)
        if trustedafter != trustedbefore:
            unavailable("protected-base execution root moved during admission")
        for path, before in bound.items():
            if sha(filebytes(trustedroot / path)) != before or sha(blob(repo, base, path)) != before:
                unavailable(f"gate moved during admission: {path}")
    if sha(filebytes(idol)) != idolbefore:
        unavailable("compiler moved during admission")
    clean(repo)
    print(f"candidate.structural=pass full={'pass' if args.mode == 'full' else 'not-requested'}")


