#!/bin/sh
# TOTAL CONVERGENCE census — blocking contract verification (P0-A/B subset).
set -eu
repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo"

# GAP-220 / GAP-201. EVERY enumeration below is `git ls-files` at the head of a
# pipeline, so its exit status is destroyed before anything can read it: in a
# tree with no `.git` each one yields nothing, every `rg` finds nothing, and
# this census prints `pass` for each check having examined NOTHING. Assert the
# tree and the subject set once, HERE, in the one position where the status
# survives. `gate/subject.sh` owns both rulings; if it is missing, `sh` exits
# 127 and this still refuses to run, which is the correct direction.
for spec in "src/*.zig"; do
  sh "$repo/gate/subject.sh" "$spec" >/dev/null || {
    echo "convergencecensus: REFUSED — subject enumeration is not trustworthy here" >&2
    exit 3
  }
done

fail=0

scan() {
  pat="$1"
  label="$2"
  ex="${3:-^$}"
  hits=$(git ls-files 'src/*.zig' 2>/dev/null | rg -v "$ex" | xargs rg -n "$pat" 2>/dev/null || true)
  n=$(printf '%s\n' "$hits" | sed '/^$/d' | wc -l | tr -d ' ')
  if [ "$n" -gt 0 ]; then
    echo "convergencecensus: FAIL $label ($n)"
    printf '%s\n' "$hits" | head -10 | sed 's/^/  /'
    fail=$((fail + n))
  else
    echo "convergencecensus: pass $label"
  fi
}

echo "convergencecensus: TOTAL CONVERGENCE P0-A/B"

scan 'duo_mode' 'duo_mode field'
scan 'duo_native' 'duo_native authority tag' 'lexer_bridge\.zig'
scan 'duo_classify' 'duo_classify authority'
scan 'duo_type|duo_contextual' 'duo token categories'
scan 'isEntrypointPath\(".*\.duo"\)|build\.duo' 'entrypoint .duo acceptance' 'build_framework\.zig'
scan 'sourceFacts\(".*\.duo"\).*idol|\.duo.*canonical' 'idol law for .duo suffix' 'lexer_bridge\.zig'
scan '@import\("native_req_support\.zig"\)' 'native_req_support import'

if [ -f src/native_req_support.zig ]; then
  echo "convergencecensus: FAIL native_req_support.zig still present"
  fail=$((fail + 1))
else
  echo "convergencecensus: pass native_req_support deleted"
fi

if rg -n '\.duo' gate/census.id 2>/dev/null | rg -q '.'; then
  echo "convergencecensus: FAIL gate/census.id references .duo"
  fail=$((fail + 1))
else
  echo "convergencecensus: pass gate/census.id .id only"
fi

if git ls-files --error-unmatch .agents/session/ENVELOPE.md >/dev/null 2>&1; then
  echo "convergencecensus: FAIL committed session envelope"
  fail=$((fail + 1))
else
  echo "convergencecensus: pass ephemeral session envelope"
fi

if [ ! -f docs/spec/convergence-contract.md ]; then
  echo "convergencecensus: FAIL missing convergence-contract.md"
  fail=$((fail + 1))
fi

# Positive control: retired suffix must not classify as canonical Idol law.
probe='compiler.duo'
if ! rg -q 'compiler\.duo' src/lexer_bridge.zig 2>/dev/null; then
  echo "convergencecensus: WARN missing .duo negative control test in lexer_bridge"
else
  echo "convergencecensus: pass .duo negative control present"
fi

if [ "$fail" -gt 0 ]; then
  echo "convergencecensus: $fail violation(s) — see docs/spec/convergence-contract.md"
  exit 1
fi
echo "convergencecensus: P0-A/B subset pass"
exit 0
