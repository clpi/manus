#!/bin/sh
# Repository hygiene gate — shell transport until repo_hygiene.id C embed stabilizes.
set -eu
repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo"
fails=0

report() {
  if [ "$1" -eq 1 ]; then
    printf 'repo_hygiene: FAIL — %s\n' "$2" >&2
    fails=$((fails + 1))
  fi
}

# EMPTY IS THE LAWFUL ANSWER HERE — this asks "is this forbidden artifact
# tracked?" and "no" is the result the gate wants — so `--any` waives the
# zero-subject ruling and keeps the tree ruling. Without it, a tree with no
# `.git` answered "not tracked" to EVERY question and this gate reported a
# perfectly clean repository having checked nothing (GAP-220).
tracked() {
  sh "$repo/gate/subject.sh" --any "$1" 2>/dev/null | head -1 | grep -q .
}

sh "$repo/gate/subject.sh" --tree || {
  printf 'repo_hygiene: REFUSED — every tracked-file probe below would answer "no" here\n' >&2
  exit 3
}

report "$( [ -f '-' ] && echo 1 || echo 0 )" "root file '-' must be removed"

for f in .all_bench_output.log .run_all_bench_cmds.sh; do
  if tracked "$f"; then
    report 1 "tracked scratch file $f (git rm or archive)"
  fi
done

for pat in '*.out' '*.profraw' 'test_*.c' 'test_*.wasm'; do
  hit="$(find . -maxdepth 1 -type f -name "$pat" 2>/dev/null | head -1 || true)"
  if [ -n "$hit" ] && tracked "$(basename "$hit")"; then
    report 1 "tracked root artifact $(basename "$hit")"
  fi
done

if git ls-files --error-unmatch .agents/session/ENVELOPE.md >/dev/null 2>&1; then
  report 1 "committed session envelope .agents/session/ENVELOPE.md"
fi

if [ "$fails" -gt 0 ]; then
  exit 1
fi
printf 'repo_hygiene: pass\n'
exit 0
