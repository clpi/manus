#!/bin/sh
# gapc0 — research-GAP C0 alignment census (role-aware).
#
# Every gaps/GAP-*.md numbered >= 175, plus gaps/RESEARCH-SPINE.md, must carry
# a complete "## C0 alignment" block (schema: gaps/RESEARCH-SPINE.md) whose
# kind, registry, and source syntax deltas are literally 0. A missing block, a
# missing field, an empty field, or a nonzero delta is one violation each. A
# research note that needs a new kind/registry/syntax is a constitutional
# amendment request, not a GAP, and it fails here until C0 itself is amended.
#
# Role checks (law.md 111-115): canonicality belongs to (spelling, role, law),
# never to a word blacklist. Mechanically decided roles only —
#   law.subject.zero (111): no parameter-position receiver binding
#     (self/this/receiver/current/instance/object in a parameter list shape);
#   law.any.descriptor.zero (112): no annotation-position open type
#     (": any" in descriptor position; the existential relation face
#     xs:any(p) is canonical and passes);
#   law.result.zero (113): no annotation-position void descriptor.
# English quantifiers, backticked citations, hyphenated project vocabulary,
# and law ids are not these roles and pass. Scanner fixtures (audit100,
# GAP-071) are the law's own test data and are outside this census, the same
# way audit100 excludes its own patterns.
#
# Exit code = violation count. checked == 0 is itself a failure (exit 2): a
# census that examined no files has not passed.
set -eu

repo=$(unset CDPATH; cd -- "$(dirname -- "$0")/../../.." && pwd)
gaps=${IDOL_GAPS_DIR:-$repo/gaps}

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

[ -d "$gaps" ] || fail "gapc0: no gaps directory at $gaps"

number() {
  printf '%s' "$1" | sed -n 's/^GAP-0*\([0-9][0-9]*\)\.md$/\1/p'
}

viol=0
checked=0

report() {
  printf '%s: %s\n' "$1" "$2"
  viol=$((viol + 1))
}

# law.subject.zero: receiver spelling in a parameter-list shape:
# "(self," "(self: ..." ", this)" — the synthetic-subject role.
subj_pat='[(,][[:space:]]*(self|this|receiver|current|instance|object)([[:space:]]*[,)]|[[:space:]]*:)'

# law.any.descriptor.zero / law.result.zero: open type or void in
# annotation position — the flag class is the type-position tail (closer,
# comma, equals, or end of line). The relation faces xs:any(p) and the
# quoted selector `:any` end in "(" or a citation mark and pass.
anno_any_pat=':[[:space:]]*any([[:space:]]*[,)=]|[[:space:]]*$)'
anno_void_pat=':[[:space:]]*void([[:space:]]*[,)=]|[[:space:]]*$)'

role_check() {
  f=$1
  base=${f##*/}
  if grep -qE "$subj_pat" "$f"; then
    report "$base" "parameter-position receiver binding (law.subject.zero)"
  fi
  if grep -qE "$anno_any_pat" "$f"; then
    report "$base" "annotation-position open type (law.any.descriptor.zero)"
  fi
  if grep -qE "$anno_void_pat" "$f"; then
    report "$base" "annotation-position void descriptor (law.result.zero)"
  fi
}

check_file() {
  f=$1
  base=${f##*/}

  if ! grep -q '^## C0 alignment$' "$f"; then
    report "$base" "missing C0 alignment block"
    return
  fi

  block=$(sed -n '/^## C0 alignment$/,$p' "$f")

  for fld in \
    "constitutional owners" \
    "kind delta" \
    "registry delta" \
    "source syntax delta" \
    "semantic invariant" \
    "physical mechanism" \
    "prerequisites" \
    "foreign implication" \
    "world implication" \
    "projection implication" \
    "demand implication" \
    "realization implication" \
    "evidence" \
    "deletion witness"
  do
    case $fld in
      "kind delta"|"registry delta"|"source syntax delta")
        printf '%s\n' "$block" | grep -q -- "^- \*\*$fld:\*\* 0$" || {
          report "$base" "field [$fld] missing or not exactly 0"
        }
        ;;
      *)
        printf '%s\n' "$block" | grep -q -- "^- \*\*$fld:\*\* ..*" || {
          report "$base" "field [$fld] missing or empty"
        }
        ;;
    esac
  done

  role_check "$f"
}

for f in "$gaps"/GAP-*.md; do
  [ -f "$f" ] || continue
  n=$(number "${f##*/}")
  [ -n "$n" ] || continue
  if [ "$n" -ge 175 ]; then
    checked=$((checked + 1))
    check_file "$f"
  elif [ "$n" -ge 170 ]; then
    checked=$((checked + 1))
    role_check "$f"
  fi
done

spine="$gaps/RESEARCH-SPINE.md"
if [ -f "$spine" ]; then
  checked=$((checked + 1))
  role_check "$spine"
else
  report "RESEARCH-SPINE.md" "schema home missing"
fi

[ "$checked" -gt 0 ] || {
  printf '%s\n' "gapc0: examined 0 research GAPs — the census did not run" >&2
  exit 2
}

printf '%s\n' "gapc0: $checked research GAPs checked, $viol violations"
exit "$viol"
