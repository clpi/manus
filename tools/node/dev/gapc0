#!/bin/sh
# gapc0 — research-GAP C0 alignment census (role-aware).
#
# Every GAP that DECLARES `**Kind:** research_gap` (GAP-175 onward), plus
# gaps/RESEARCH-SPINE.md, must carry a complete C0 alignment block
# (schema: gaps/RESEARCH-SPINE.md) whose kind, registry, and source syntax
# deltas are literally 0. A missing block, a missing field, an empty field, or
# a nonzero delta is one violation each. A research note that needs a new
# kind/registry/syntax is a constitutional amendment request, not a GAP, and it
# fails here until C0 itself is amended.
#
# The C0 alignment block is a structural directive table delimited by the
# machine markers `<!-- idol-gap-c0:v1:begin -->` /
# `<!-- idol-gap-c0:v1:end -->` (the frontier-block convention), NOT a
# Markdown heading, and its fields are `| field | value |` rows, NOT a
# Markdown list. Exactly one begin/end pair, in order, is required.
#
# THE SUBJECT IS A KIND, NOT A NUMBER RANGE. This census selected `>= 175`
# because, on the day it was written, every GAP at or above 175 was a research
# GAP. The numbering is shared with defect GAPs, so by GAP-203 the range had
# stopped naming its subject and the census was convicting `wrong_answer`,
# `crash`, `regression` and `evidence_gap` reports of missing a research
# admission block they were never required to carry. The declared Kind is the
# subject; a GAP >= 175 that declares NO Kind is a violation, because then the
# census cannot select at all. Selecting zero research GAPs is exit 2.
#
# Role checks (law.md 111-115): canonicality belongs to (spelling, role, law),
# never to a word blacklist. Mechanically decided roles only —
#   law.subject.zero (111): no parameter-position receiver binding
#     (self/this/receiver/current/instance/object in a parameter list shape);
#   law.any.descriptor.zero (112): no annotation-position open type
#     (": any" in descriptor position; the existential relation face
#     xs:any(p) is canonical and passes);
#   law.result.zero (113): no annotation-position void descriptor.
# English quantifiers, backticked citations, hyphenated project vocabulary,
# and law ids are not these roles and pass. Scanner fixtures (audit100,
# GAP-071) are the law's own test data and are outside this census, the same
# way audit100 excludes its own patterns.
#
# Quoted non-Idol code is not Idol source: fenced blocks that name a
# non-Idol language (```zig, ```sh, ```text, ...) are evidence quotations and
# are excluded from the role census. ```id blocks and unfenced prose stay in.
# (GAP-240 quoted Zig host code whose `self: *Parser` receiver tripped
# law.subject.zero.)
#
# Exit code = violation count. checked == 0 is itself a failure (exit 2): a
# census that examined no files has not passed.
set -eu

repo=$(unset CDPATH; cd -- "$(dirname -- "$0")/../../.." && pwd)
gaps=${IDOL_GAPS_DIR:-$repo/gaps}

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

[ -d "$gaps" ] || fail "gapc0: no gaps directory at $gaps"

number() {
  printf '%s' "$1" | sed -n 's/^GAP-0*\([0-9][0-9]*\)\.md$/\1/p'
}

viol=0
checked=0

report() {
  printf '%s: %s\n' "$1" "$2"
  viol=$((viol + 1))
}

# c0_field <block-text> <field-name>: print the | field | value | cell for a
# C0 field, unescaping \|. Prints nothing when the row is absent.
c0_field() {
  printf '%s\n' "$1" | awk -v fld="$2" '
    {
      line = $0
      gsub(/\\[|]/, "\034", line)
      n = split(line, c, "[|]")
      if (n >= 4) {
        f2 = c[2]; gsub(/^[ \t]+|[ \t]+$/, "", f2)
        if (f2 == fld) {
          v = c[3]
          gsub(/^[ \t]+|[ \t]+$/, "", v)
          gsub(/\034/, "|", v)
          print v
          exit
        }
      }
    }'
}

check_file() {
  f=$1
  base=${f##*/}

  nbegin=$(grep -c -F -x '<!-- idol-gap-c0:v1:begin -->' "$f")
  nend=$(grep -c -F -x '<!-- idol-gap-c0:v1:end -->' "$f")
  if [ "$nbegin" != "1" ] || [ "$nend" != "1" ]; then
    report "$base" "missing C0 alignment block"
    return
  fi
  begin=$(grep -n -F -x '<!-- idol-gap-c0:v1:begin -->' "$f" | cut -d: -f1)
  end=$(grep -n -F -x '<!-- idol-gap-c0:v1:end -->' "$f" | cut -d: -f1)
  if [ "$begin" -ge "$end" ]; then
    report "$base" "missing C0 alignment block"
    return
  fi

  block=$(sed -n "$((begin + 1)),$((end - 1))p" "$f")

  for fld in \
    "constitutional owners" \
    "kind delta" \
    "registry delta" \
    "source syntax delta" \
    "semantic invariant" \
    "physical mechanism" \
    "prerequisites" \
    "foreign implication" \
    "world implication" \
    "projection implication" \
    "demand implication" \
    "realization implication" \
    "evidence" \
    "deletion witness"
  do
    val=$(c0_field "$block" "$fld")
    case $fld in
      "kind delta"|"registry delta"|"source syntax delta")
        [ "$val" = "0" ] || report "$base" "field [$fld] missing or not exactly 0"
        ;;
      *)
        [ -n "$val" ] || report "$base" "field [$fld] missing or empty"
        ;;
    esac
  done
}

subj_pat='[(,][[:space:]]*(self|this|receiver|current|instance|object)([[:space:]]*[,)]|[[:space:]]*:)'
anno_any_pat=':[[:space:]]*any([[:space:]]*[,)=]|[[:space:]]*$)'
anno_void_pat=':[[:space:]]*void([[:space:]]*[,)=]|[[:space:]]*$)'
role_check() {
  f=$1
  base=${f##*/}
  # Fenced quotations that name a non-Idol language are evidence, not Idol
  # source: law.md 111-115 governs Idol roles, so a ```zig/```sh/```text
  # quotation cannot instantiate them. ```id blocks and unfenced text stay
  # in the census. (GAP-240 quoted Zig host code tripped law.subject.zero.)
  scan=$(awk '
    /^```/ {
      info = $0; sub(/^```[ \t]*/, "", info); sub(/[ \t]*$/, "", info)
      if (in_fence) { in_fence = 0; skip = 0 }
      else { in_fence = 1; skip = (info != "" && info != "id") }
      next
    }
    skip { next }
    { print }
  ' "$f")
  if printf '%s\n' "$scan" | grep -qE "$subj_pat"; then
    report "$base" "parameter-position receiver binding (law.subject.zero)"
  fi
  if printf '%s\n' "$scan" | grep -qE "$anno_any_pat"; then
    report "$base" "annotation-position open type (law.any.descriptor.zero)"
  fi
  if printf '%s\n' "$scan" | grep -qE "$anno_void_pat"; then
    report "$base" "annotation-position void descriptor (law.result.zero)"
  fi
}

kind_of() {
  # The declared kind, from the metadata table every GAP carries.
  # `| kind delta |` rows must not match: after `kind` the next character
  # must be the cell boundary.
  sed -n 's/^|[[:space:]]*kind[[:space:]]*|[[:space:]]*\([a-z_]*\).*/\1/p' "$1" | head -n 1
}

research=0
for f in "$gaps"/GAP-*.md; do
  [ -f "$f" ] || continue
  n=$(number "${f##*/}")
  [ -n "$n" ] || continue
  [ "$n" -ge 170 ] || continue
  checked=$((checked + 1))
  # law.md 111-115 roles apply to every GAP in range regardless of kind, and
  # they run BEFORE the block test: a GAP missing its block used to `return`
  # out of check_file and escape role checking entirely.
  role_check "$f"
  [ "$n" -ge 175 ] || continue
  kind=$(kind_of "$f")
  case $kind in
    research_gap)
      research=$((research + 1))
      check_file "$f"
      ;;
    "")
      report "${f##*/}" "no **Kind:** declared — the research census cannot select its subject"
      ;;
    *) ;;
  esac
done

spine="$gaps/RESEARCH-SPINE.md"
if [ -f "$spine" ]; then
  checked=$((checked + 1))
  role_check "$spine"
else
  report "RESEARCH-SPINE.md" "schema home missing"
fi

[ "$checked" -gt 0 ] || {
  printf '%s\n' "gapc0: examined 0 GAPs — the census did not run" >&2
  exit 2
}
# A kind-selected census that selects NOTHING is the failure mode a range
# selector could not have: it reads green while measuring an empty set.
[ "$research" -gt 0 ] || {
  printf '%s\n' "gapc0: 0 GAPs declare Kind: research_gap — the C0 admission census selected an empty subject" >&2
  exit 2
}

printf '%s\n' "gapc0: $checked GAPs in range, $research research GAPs C0-checked, $viol violations"
exit "$viol"
