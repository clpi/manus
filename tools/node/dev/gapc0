#!/bin/sh
# gapc0 — research-GAP C0 alignment census.
#
# Every gaps/GAP-*.md numbered >= 175, plus gaps/RESEARCH-SPINE.md, must carry
# a complete "## C0 alignment" block (schema: gaps/RESEARCH-SPINE.md) whose
# kind, registry, and source syntax deltas are literally 0. A missing block, a
# missing field, an empty field, or a nonzero delta is one violation each. A
# research note that needs a new kind/registry/syntax is a constitutional
# amendment request, not a GAP, and it fails here until C0 itself is amended.
#
# Also enforced: every GAP numbered >= 170 plus the spine avoids the two
# retired spellings — the receiver parameter (retired by the receiver-zero
# law) and the open type (never made explicit) — in prose as in code, and the
# redundant solution selector spelling for the witness quotient is deleted in
# favour of `exists` (a second spelling for one quotient is a plurality
# defect). The ban is on standalone spellings: hyphenated project vocabulary
# (the hosting term, recursion kinds) and law ids are not the receiver and are
# exempt by the boundary class. The two spellings survive only inside the
# pattern below and in scanner fixtures (audit100/GAP-071), which are that
# law's own test data and are exempt from their own census, the same way
# audit100 excludes its patterns.
#
set -eu

repo=$(unset CDPATH; cd -- "$(dirname -- "$0")/../../.." && pwd)
gaps=${IDOL_GAPS_DIR:-$repo/gaps}

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

[ -d "$gaps" ] || fail "gapc0: no gaps directory at $gaps"

number() {
  printf '%s' "$1" | sed -n 's/^GAP-0*\([0-9][0-9]*\)\.md$/\1/p'
}

viol=0
checked=0

report() {
  printf '%s: %s\n' "$1" "$2"
  viol=$((viol + 1))
}

check_file() {
  f=$1
  base=${f##*/}

  if ! grep -q '^## C0 alignment$' "$f"; then
    report "$base" "missing C0 alignment block"
    return
  fi

  block=$(sed -n '/^## C0 alignment$/,$p' "$f")

  for fld in \
    "constitutional owners" \
    "kind delta" \
    "registry delta" \
    "source syntax delta" \
    "semantic invariant" \
    "physical mechanism" \
    "prerequisites" \
    "foreign implication" \
    "world implication" \
    "projection implication" \
    "demand implication" \
    "realization implication" \
    "evidence" \
    "deletion witness"
  do
    case $fld in
      "kind delta"|"registry delta"|"source syntax delta")
        printf '%s\n' "$block" | grep -q -- "^- \*\*$fld:\*\* 0$" || {
          report "$base" "field [$fld] missing or not exactly 0"
        }
        ;;
      *)
        printf '%s\n' "$block" | grep -q -- "^- \*\*$fld:\*\* ..*" || {
          report "$base" "field [$fld] missing or empty"
        }
        ;;
    esac
  done

  if grep -qE '(^|[^A-Za-z0-9_-])(self|any)([^A-Za-z0-9_-]|$)' "$f"; then
    report "$base" "standalone receiver/open-type spelling present"
  fi
}

for f in "$gaps"/GAP-*.md; do
  [ -f "$f" ] || continue
  n=$(number "${f##*/}")
  [ -n "$n" ] || continue
  if [ "$n" -ge 175 ]; then
    checked=$((checked + 1))
    check_file "$f"
  elif [ "$n" -ge 170 ]; then
    checked=$((checked + 1))
    if grep -qE '(^|[^A-Za-z0-9_-])(self|any)([^A-Za-z0-9_-]|$)' "$f"; then
      report "${f##*/}" "standalone receiver/open-type spelling present"
    fi
  fi
done

spine="$gaps/RESEARCH-SPINE.md"
if [ -f "$spine" ]; then
  checked=$((checked + 1))
  if grep -qE '(^|[^A-Za-z0-9_-])(self|any)([^A-Za-z0-9_-]|$)' "$spine"; then
    report "RESEARCH-SPINE.md" "standalone receiver/open-type spelling present"
  fi
else
  report "RESEARCH-SPINE.md" "schema home missing"
fi

[ "$checked" -gt 0 ] || {
  printf '%s\n' "gapc0: examined 0 research GAPs — the census did not run" >&2
  exit 2
}

printf '%s\n' "gapc0: $checked research GAPs checked, $viol violations"
exit "$viol"
