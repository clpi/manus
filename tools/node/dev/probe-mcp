#!/bin/sh
set -eu

repo="$(cd "$(dirname "$0")/../../.." && pwd)"
parent="$(dirname "$repo")"
manifest="${IDOL_MCP_MANIFEST:-$repo/tools/node/dev/mcp.manifest.json}"
idol="${IDOL_BOOTSTRAP_BIN:-${IDOL_BIN:-$repo/zig-out/bin/idol}}"

if ! command -v jq >/dev/null 2>&1; then
  echo "probe-mcp: jq is required" >&2
  exit 1
fi
if [ ! -r "$manifest" ]; then
  echo "probe-mcp: unreadable manifest: $manifest" >&2
  exit 1
fi
if ! jq -e '.servers | type == "array"' "$manifest" >/dev/null 2>&1; then
  echo "probe-mcp: invalid manifest: $manifest" >&2
  exit 1
fi
if [ ! -x "$idol" ]; then
  echo "probe-mcp: missing compiler artifact: $idol" >&2
  exit 1
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/idol-probe.XXXXXX")"
retain=0
cleanup_probe() {
  if [ "$retain" -eq 0 ]; then
    rm -rf "$work"
  else
    echo "probe-mcp: preserved artifacts=$work" >&2
  fi
}
trap cleanup_probe EXIT

printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' >"$work/init.json"

# name <tab> root <tab> bin <tab> entry <tab> backend (enabled only); sibling
# servers resolve against their own checkout root and launcher binary.
jq -r --arg repo "$repo" --arg parent "$parent" --arg mainbin "$idol" '
  .servers[] | select((.enabled // .required // false) == true) |
  (if .sibling then ($parent + "/" + .sibling) else $repo end) as $root |
  (if .sibling then ($root + "/" + (.bin // "bin/idol")) else $mainbin end) as $bin |
  [.name, $root, $bin, .entry, .backend] | @tsv
' "$manifest" >"$work/enabled.tsv"
jq -r '.servers[] | select((.enabled // .required // false) != true) | .name' "$manifest" >"$work/disabled.txt"

while IFS= read -r name; do
  if [ -n "$name" ]; then
    echo "probe-mcp: disabled $name" >&2
  fi
done <"$work/disabled.txt"

enabled=0
fail=0
tab="$(printf '\t')"
while IFS="$tab" read -r name root bin entry backend; do
  if [ -z "$name" ]; then
    continue
  fi
  enabled=$((enabled + 1))
  response="$work/$name.response.json"
  check="$work/$name.check"
  err="$work/$name.err"

  if [ ! -r "$root/$entry" ]; then
    echo "probe-mcp: $name entry is unreadable: $root/$entry" >&2
    fail=$((fail + 1))
    continue
  fi
  if [ ! -x "$bin" ]; then
    echo "probe-mcp: $name launcher is not executable: $bin" >&2
    fail=$((fail + 1))
    continue
  fi

  if ! (cd "$root" && "$bin" check "$root/$entry" >"$check" 2>&1); then
    echo "probe-mcp: $name check failed" >&2
    cat "$check" >&2
    fail=$((fail + 1))
    continue
  fi
  if grep -Eq '(^|[[:space:]])error:' "$check"; then
    echo "probe-mcp: $name check printed an error despite a zero exit status" >&2
    cat "$check" >&2
    fail=$((fail + 1))
    continue
  fi

  echo "probe-mcp: launch name=$name backend=$backend entry=$root/$entry" >&2
  rc=0
  case "$backend" in
    native)
      (cd "$root" && IDOL_ROOT="$root" IDOL_BIN="$bin" \
        "$bin" run "$root/$entry" <"$work/init.json" >"$response" 2>"$err") || rc=$?
      ;;
    direct)
      (cd "$root" && IDOL_ROOT="$root" IDOL_BIN="$bin" \
        "$bin" run --backend=direct "$root/$entry" <"$work/init.json" >"$response" 2>"$err") || rc=$?
      ;;
    *)
      echo "probe-mcp: $name uses unsupported or retired backend: $backend" >&2
      fail=$((fail + 1))
      continue
      ;;
  esac

  if [ "$rc" -ne 0 ]; then
    echo "probe-mcp: $name process exited $rc" >&2
    cat "$err" >&2
    fail=$((fail + 1))
    continue
  fi
  if ! jq -s -e '[.[] | select(.jsonrpc == "2.0" and .id == 1 and .result.protocolVersion == "2024-11-05")] | length == 1' "$response" >/dev/null 2>&1; then
    echo "probe-mcp: $name did not return exactly one valid initialize response" >&2
    cat "$response" >&2
    fail=$((fail + 1))
    continue
  fi
  echo "ok $name initialize"
done <"$work/enabled.tsv"

if [ "$enabled" -eq 0 ]; then
  echo "probe-mcp: manifest enables zero servers" >&2
  fail=$((fail + 1))
fi
if [ "$fail" -ne 0 ]; then
  retain=1
  echo "probe-mcp: FAIL ($fail)" >&2
  exit 1
fi
echo "probe-mcp: PASS ($enabled enabled server(s))"
