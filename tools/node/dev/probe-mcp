#!/bin/sh
set -eu

repo="$(cd "$(dirname "$0")/../../.." && pwd)"
manifest="${IDOL_MCP_MANIFEST:-$repo/tools/node/dev/mcp.manifest.json}"
idol="${IDOL_BOOTSTRAP_BIN:-${IDOL_BIN:-$repo/zig-out/bin/idol}}"
pair="$repo/tools/node/dev/mcp-pair"

if ! command -v jq >/dev/null 2>&1; then
  echo "probe-mcp: jq is required" >&2
  exit 1
fi
if [ ! -r "$manifest" ]; then
  echo "probe-mcp: unreadable manifest: $manifest" >&2
  exit 1
fi
if ! jq -e '.servers | type == "array"' "$manifest" >/dev/null 2>&1; then
  echo "probe-mcp: invalid manifest: $manifest" >&2
  exit 1
fi
if [ ! -x "$idol" ]; then
  echo "probe-mcp: INFRASTRUCTURE: missing compiler artifact: $idol" >&2
  exit 2
fi
if [ ! -x "$pair" ]; then
  echo "probe-mcp: INFRASTRUCTURE: missing paired-root validator: $pair" >&2
  exit 2
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/idol-probe.XXXXXX")"
retain=0
cleanup_probe() {
  if [ "$retain" -eq 0 ]; then
    rm -rf "$work"
  else
    echo "probe-mcp: preserved artifacts=$work" >&2
  fi
}
trap cleanup_probe EXIT

# Every explicit pair is validated before any compiler or server process starts.
# name <tab> root <tab> bin <tab> absolute-entry <tab> backend <tab> pair-kind
jq -r '
  .servers[] | select((.enabled // .required // false) == true) |
  [.name, (.root_input // "-"), .entry, .backend] | @tsv
' "$manifest" >"$work/declared.tsv"
jq -r '.servers[] | select((.enabled // .required // false) != true) | .name' "$manifest" >"$work/disabled.txt"

while IFS= read -r name; do
  if [ -n "$name" ]; then
    echo "probe-mcp: disabled $name" >&2
  fi
done <"$work/disabled.txt"

tab="$(printf '\t')"
enabled=0
infra=0
: >"$work/enabled.tsv"
while IFS="$tab" read -r name root_input entry backend; do
  if [ -z "$name" ]; then
    continue
  fi
  enabled=$((enabled + 1))
  if [ "$root_input" != - ]; then
    if validated="$("$pair" validate "$manifest" "$name")"; then
      printf '%s\tpair\n' "$validated" >>"$work/enabled.tsv"
    else
      infra=$((infra + 1))
    fi
    continue
  fi
  if [ ! -r "$repo/$entry" ]; then
    echo "probe-mcp: INFRASTRUCTURE: $name entry is unreadable: $repo/$entry" >&2
    infra=$((infra + 1))
    continue
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$name" "$repo" "$idol" "$repo/$entry" "$backend" "$(git -C "$repo" rev-parse HEAD)" "$(git -C "$repo" rev-parse 'HEAD^{tree}')" - local \
    >>"$work/enabled.tsv"
done <"$work/declared.tsv"

if [ "$enabled" -eq 0 ]; then
  echo "probe-mcp: INFRASTRUCTURE: manifest enables zero servers" >&2
  infra=$((infra + 1))
fi
if [ "$infra" -ne 0 ]; then
  retain=1
  echo "probe-mcp: INFRASTRUCTURE FAIL ($infra); no server executed" >&2
  exit 2
fi

fail=0
runtime_infra=0
while IFS="$tab" read -r name root bin entry backend revision tree authority_revision kind; do
  if [ -z "$name" ]; then
    continue
  fi
  response="$work/$name.response.json"
  request="$work/$name.request.json"
  check="$work/$name.check"
  err="$work/$name.err"

  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' >"$request"
  if [ "$kind" = pair ]; then
    printf '0\n' >"$work/$name-artifact-smoke.id"
    jq -cn --arg file "$work/$name-artifact-smoke.id" '{jsonrpc:"2.0",id:2,method:"tools/call",params:{name:"check",arguments:{file:$file}}}' >>"$request"
  fi

  if ! (cd "$root" && "$bin" check "$entry" >"$check" 2>&1); then
    echo "probe-mcp: $name check failed" >&2
    cat "$check" >&2
    fail=$((fail + 1))
    continue
  fi
  if grep -Eq '(^|[[:space:]])error:' "$check"; then
    echo "probe-mcp: $name check printed an error despite a zero exit status" >&2
    cat "$check" >&2
    fail=$((fail + 1))
    continue
  fi

  echo "probe-mcp: launch name=$name backend=$backend entry=$entry revision=$revision tree=$tree authority_revision=$authority_revision" >&2
  rc=0
  case "$backend" in
    native|direct)
      # Each launch is an evidence subject: commit, dirty state, compiler
      # hash, command, inner exit, and output hashes (evidence/subject).
      if [ "$kind" = pair ]; then
        # evidence/subject reads the completed subject after its child closes stdout.
        # shellcheck disable=SC2094
        "$repo/tools/evidence/subject" -o "$work/$name.subject.json" -s "$response" \
          --label "probe=$name" --label "backend=$backend" --label "paired_revision=$revision" --label "paired_tree=$tree" -- \
          env IDOL_PAIR_COMPILER="$idol" "$pair" launch "$manifest" "$name" \
          <"$request" >"$response" 2>"$err" || rc=$?
      else
        executable="$work/$name.server"
        compile_out="$work/$name.compile.out"
        compile_err="$work/$name.compile.err"
        # The inner shell is deliberately positional; no outer expansion is wanted.
        # evidence/subject reads the completed subject after its child closes stdout.
        # shellcheck disable=SC2016,SC2094
        "$repo/tools/evidence/subject" -o "$work/$name.subject.json" -s "$response" \
          --label "probe=$name" --label "backend=$backend" -- \
          sh -c '
            cd "$1" || exit 2
            "$2" compile --no-cache "$3" "--backend=$4" --emit exe -o "$5" >"$6" 2>"$7" || { cat "$6" "$7" >&2; exit 2; }
            if grep -Fq "(cached)" "$6" "$7"; then cat "$6" "$7" >&2; echo "probe-mcp: INFRASTRUCTURE: compiler ignored --no-cache" >&2; exit 2; fi
            [ -x "$5" ] || { echo "probe-mcp: INFRASTRUCTURE: cold compile produced no executable" >&2; exit 2; }
            exec env IDOL_ROOT="$1" IDOL_BIN="$2" "$5"
          ' _ "$root" "$bin" "$entry" "$backend" "$executable" "$compile_out" "$compile_err" \
          <"$request" >"$response" 2>"$err" || rc=$?
      fi
      ;;
    *)
      echo "probe-mcp: $name uses unsupported or retired backend: $backend" >&2
      fail=$((fail + 1))
      continue
      ;;
  esac

  if [ "$rc" -ne 0 ]; then
    if [ "$rc" -eq 2 ]; then
      echo "probe-mcp: INFRASTRUCTURE: $name process exited $rc" >&2
      runtime_infra=$((runtime_infra + 1))
    else
      echo "probe-mcp: $name process exited $rc" >&2
    fi
    cat "$err" >&2
    fail=$((fail + 1))
    continue
  fi
  if ! jq -s -e '[.[] | select(.jsonrpc == "2.0" and .id == 1 and .result.protocolVersion == "2024-11-05")] | length == 1' "$response" >/dev/null 2>&1; then
    echo "probe-mcp: $name did not return exactly one valid initialize response" >&2
    cat "$response" >&2
    fail=$((fail + 1))
    continue
  fi
  if [ "$kind" = pair ] && ! jq -s -e '[.[] | select(.jsonrpc == "2.0" and .id == 2 and (.result.content[0].text | test("EXIT:0\\n?$")))] | length == 1' "$response" >/dev/null 2>&1; then
    echo "probe-mcp: $name did not exercise the exact paired compiler artifact successfully" >&2
    cat "$response" >&2
    fail=$((fail + 1))
    continue
  fi
  echo "ok $name initialize"
  cat "$work/$name.subject.json" >&2
done <"$work/enabled.tsv"
if [ "$runtime_infra" -ne 0 ]; then
  retain=1
  echo "probe-mcp: INFRASTRUCTURE FAIL ($runtime_infra)" >&2
  exit 2
fi
if [ "$fail" -ne 0 ]; then
  retain=1
  echo "probe-mcp: FAIL ($fail)" >&2
  exit 1
fi
echo "probe-mcp: PASS ($enabled enabled server(s))"
