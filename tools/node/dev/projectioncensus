#!/bin/sh
# PROJECTION-ONE + INFER-ONE text debt census (GAP-165).
# Runs the Idol census entries. Shell here is transport only.
set -eu
repo="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repo"
idol="${IDOL:-$repo/zig-out/bin/idol}"
fail=0
if ! "$idol" run scripts/census/infer.id; then
  echo "projectioncensus: FAIL census/infer" >&2
  fail=1
fi
if ! "$idol" run scripts/census/projection.id; then
  echo "projectioncensus: FAIL census/projection" >&2
  fail=1
fi
[ "$fail" -eq 0 ] || exit 1
exit 0
