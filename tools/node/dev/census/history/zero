#!/bin/sh
# ZERO-HISTORY whole-tree census — law.zero.history merge priority verification.
set -eu
repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo"

fail=0
warn=0
filter='census/history/zero|law\.zero\.history|ZERO-HISTORY|retired name|git stores|foreign provenance|Zig @import|No `language\.history`|no language\.history|path-migration\.md|Forbidden \| Canonical'

# Project-owned paths (exclude constitution law text, census tools, idiom ratchets).
owned_files() {
  git ls-files 2>/dev/null \
    | rg -v '\.(png|jpg|wasm|o|dylib|profraw)$' \
    | rg -v '^\.claude/' \
    | rg -v '^vendor/' \
    | rg -v '^ext/' \
    | rg -v '^docs/spec/constitution\.md$' \
    | rg -v '^(gate/idiom\.id|tools/node/dev/census/identity|tools/node/dev/census/history/zero|\.githooks/)'
}

scan() {
  pat="$1"
  label="$2"
  hits=$(owned_files | xargs rg -n "$pat" 2>/dev/null | rg -v "$filter" || true)
  n=$(printf '%s\n' "$hits" | sed '/^$/d' | wc -l | tr -d ' ')
  if [ "$n" -gt 0 ]; then
    echo "census/history/zero: FAIL $label ($n hits)"
    printf '%s\n' "$hits" | head -12 | sed 's/^/  /'
    fail=$((fail + n))
  else
    echo "census/history/zero: pass $label"
  fi
}

scan_id_files() {
  pat="$1"
  label="$2"
  hits=$(git ls-files '*.id' 2>/dev/null \
    | rg -v '^lib/std/' \
    | rg -v '^scripts/ingress/' \
    | rg -v '^scripts/census/' \
    | rg -v '^scripts/ledger/' \
    | rg -v '^examples/compile_fail/' \
    | rg -v '^tools/lsp/' \
    | rg -v '^scripts/vscodeemit\.id$' \
    | rg -v '^(gate/idiom\.id|gate/admission\.id|gate/architecture\.id)$' \
    | xargs rg -n "$pat" 2>/dev/null | rg -v "$filter" || true)
  n=$(printf '%s\n' "$hits" | sed '/^$/d' | wc -l | tr -d ' ')
  if [ "$n" -gt 0 ]; then
    echo "census/history/zero: FAIL $label ($n hits)"
    printf '%s\n' "$hits" | head -12 | sed 's/^/  /'
    fail=$((fail + n))
  else
    echo "census/history/zero: pass $label"
  fi
}

echo "census/history/zero: ZERO-HISTORY audit (law.zero.history)"

scan 'language\.history' 'language.history table'
scan '(^|[^a-zA-Z])Idsem([^a-zA-Z]|$)|idsem' 'Idsem identity'
scan '(^|[^a-zA-Z])Duon([^a-zA-Z]|$)|duon' 'Duon identity'
scan '\.duo\b' 'retired .duo suffix'
scan 'spec100|pass[0-9]+|Pass [0-9]+' 'pass/spec-number taxonomy'
scan '@corpus (verified|proof|history|migration|compat|legacy|deprecated)' 'retired @corpus labels'
scan 'examples/spec100/' 'spec100 path references'
scan_id_files '\bstd\.' 'std. in canonical .id (excl lib/std migration)'
scan_id_files '\blib\.(std|process|clock)|req "lib\.|process = lib\.' 'lib. admission in .id'
scan_id_files 'process\.' 'process. namespace in .id'
scan_id_files ':from\(' ':from( inverse face in .id'
scan_id_files ': (readable|writable|iterable|hashable|convertible)' 'adjective protocols in .id'
scan_id_files 'req\(|require\(|import\(' 'admission syntax in .id'

# Active bridges allowlist — must carry deletion condition in bootstrap.md or gap.
bridge_allow='idol_lock\.id|IDOL_TRANSFORM|bootstrap.*duo|@import\("std"\)|tree-sitter-duo|vscode-duo|duo_keyword|duo_lexer'
duo_hits=$(owned_files | xargs rg -n '(^|[^a-zA-Z])duo([^a-zA-Z]|$)|DUO_' 2>/dev/null \
  | rg -v "$filter" \
  | rg -v "$bridge_allow" || true)
duo_n=$(printf '%s\n' "$duo_hits" | sed '/^$/d' | wc -l | tr -d ' ')
if [ "$duo_n" -gt 0 ]; then
  echo "census/history/zero: FAIL duo/DUO_ identity debt ($duo_n hits)"
  printf '%s\n' "$duo_hits" | head -12 | sed 's/^/  /'
  fail=$((fail + duo_n))
else
  echo "census/history/zero: pass duo/DUO_ (bridges allowlisted)"
fi

# PATH-ONE: ledger and census homes must decompose — no mashed *ledger / *census stems on disk.
mashed_paths=$(
  find scripts -maxdepth 1 -type f \( -name '*ledger*.id' -o -name '*census*.id' -o -name '*_census.id' \) 2>/dev/null
  find tools/node/dev -maxdepth 1 -type f -name '*census' 2>/dev/null
)
mashed_n=$(printf '%s\n' "$mashed_paths" | sed '/^$/d' | wc -l | tr -d ' ')
if [ "$mashed_n" -gt 0 ]; then
  echo "census/history/zero: FAIL mashed ledger/census paths ($mashed_n)"
  printf '%s\n' "$mashed_paths" | sed 's/^/  /'
  fail=$((fail + mashed_n))
else
  echo "census/history/zero: pass ledger/census path hierarchy"
fi

if git ls-files --error-unmatch .agents/session/ENVELOPE.md >/dev/null 2>&1; then
  echo "census/history/zero: FAIL committed session envelope"
  fail=$((fail + 1))
else
  echo "census/history/zero: pass session envelope not committed"
fi

if git ls-files --error-unmatch .agents/harness.generated.md >/dev/null 2>&1; then
  if rg -q 'generated at|dirty entries|open P0' .agents/harness.generated.md 2>/dev/null; then
    echo "census/history/zero: WARN harness.generated.md may contain stale envelope"
    warn=$((warn + 1))
  fi
fi

# Positive control: census must detect forbidden class.
probe=$(mktemp)
printf '+++ b/probe.id\n@@ -0,0 +1 @@\n+x = Idsem\n' >"$probe"
if cat "$probe" | "$repo/zig-out/bin/idol" run "$repo/gate/idiom.id" >/dev/null 2>&1; then
  echo "census/history/zero: FAIL positive control (Idsem not convicted)"
  fail=$((fail + 1))
else
  echo "census/history/zero: pass positive control (identity ratchet fires)"
fi
rm -f "$probe"

if [ "$fail" -gt 0 ]; then
  echo "census/history/zero: $fail violation(s) ($warn bridge warnings)"
  exit 1
fi
echo "census/history/zero: census complete ($warn warnings)"
exit 0
