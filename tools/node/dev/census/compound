#!/bin/sh
# census/compound — non-authoritative path-name migration-pressure census.
# It reads temporary detector inputs from gate/path.id plus local suffix
# heuristics. Hits and misses are not law: only constitution-owned graph facts
# establish identity. This heuristic may miss or over-report.
#
# Scope v1: tracked path components (file leaf stems + directory parts),
# owned() paths only (ext/ is foreign; benchmarks/ and vendor/ historical).
# The source-token scan (gate/idiom.id) is a separate census.
#
# usage: census/compound [--record]
# default: report + ratchet against the migration-pressure baseline

set -eu
repo="$(cd "$(dirname "$0")/../../../.." && pwd)"
cd "$repo"
baseline="tools/node/dev/census/compound.baseline"

python3 - "$@" <<'PY'
import re, subprocess, sys

src = open('gate/path.id').read()

def wordlist(varname):
    m = re.search(r'^%s = " (.*?) "\s*$' % varname, src, re.M | re.S)
    if not m:
        sys.exit('census/compound: detector input not found: %s' % varname)
    return set(m.group(1).split())

words       = wordlist('words')
roles       = wordlist('roles')
collisions  = wordlist('collisions')
cardinals   = wordlist('cardinals')
ables       = wordlist('ables')
histwords   = wordlist('histwords')
orghomes    = wordlist('orghomes')
mediatorhomes = wordlist('mediatorhomes')

def known(w):     return len(w) >= 2 and w in words
def sep(name):
    return any(c in '_-' or c.isupper() for c in name)
def tail(name):
    n = len(name)
    if n < 2 or not name[-1].isdigit(): return False
    i = n - 1
    while i >= 1 and name[i].isdigit(): i -= 1
    return i == 0 or name[i].isalpha() or name[i] == '_'
def mash(name):
    if known(name): return False
    n = len(name)
    if n >= 5 and name.endswith('proof'):
        left = name[:n-5]
        if len(left) >= 2 and known(left): return True
    if n < 4: return False
    for i in range(2, n):
        left, right = name[:i-1], name[i-1:]
        if len(left) >= 2 and len(right) >= 2 and known(left) and known(right):
            return True
    return False
def rolestem(name):
    if known(name) or len(name) < 4: return False
    if name in roles: return True
    return any(name.endswith(s) for s in ('reader','writer','runner','caller','encoder',
        'decoder','parser','formatter','checker','validator','builder','emitter',
        'generator','scanner','resolver','provider','producer','consumer'))
def collisionstem(name):
    if known(name) or len(name) < 4: return False
    if name in collisions: return True
    return any(name.endswith(s) for s in ('router','gateway','dispatcher','registry',
        'manager','factory','adapter','broker','mediator','controller','coordinator',
        'orchestrator','handler','executor','pipeline','scheduler','loader','bridge',
        'wrapper','context','session','service','framework','container'))
def cardinalstem(name): return name in cardinals
def ables_tem(name):
    if name in ables: return True
    return len(name) >= 6 and (name.endswith('able') or name.endswith('ible'))
def histstem(name):
    if name in ('pass', 'gap', 'phase'): return True
    return name in histwords or name.endswith('showcase') or name.endswith('legacy') \
        or name.endswith('deprecated') or name.endswith('compat')
def orghome(name):
    if known(name): return False
    return name in orghomes or name.endswith('utils') or name.endswith('helpers')
def mediatorhome(name):
    if known(name): return False
    return name in mediatorhomes

def leaf(path):
    base = path.rsplit('/', 1)[-1]
    dot = base.find('.')
    return base if dot <= 0 else base[:dot]
def owned(path):
    return not path.startswith('ext/') and not path.startswith('benchmarks/') \
        and not path.startswith('vendor/')

findings = []
def verdict(where, name):
    if not name: return
    if sep(name):
        findings.append('%s  [migration] separator `%s`' % (where, name))
    if tail(name):
        findings.append('%s  [migration] numeric taxonomy `%s`' % (where, name))
    if mash(name):
        findings.append('%s  [migration] possible compound `%s`' % (where, name))
    is_file = not where.endswith(':')
    if is_file:
        if rolestem(name):     findings.append('%s  [migration] role `%s`' % (where, name))
        if collisionstem(name):findings.append('%s  [migration] mediator `%s`' % (where, name))
        if cardinalstem(name): findings.append('%s  [migration] cardinal `%s`' % (where, name))
        if ables_tem(name):    findings.append('%s  [migration] protocol `%s`' % (where, name))
        if histstem(name):     findings.append('%s  [migration] history `%s`' % (where, name))
    else:
        if orghome(name):      findings.append('%s  [migration] org home `%s`' % (where, name))
        if mediatorhome(name): findings.append('%s  [migration] mediator home `%s`' % (where, name))

try: paths = subprocess.check_output(['git','ls-files'], text=True).split('\n')
except subprocess.CalledProcessError: sys.exit('census/compound: tracked-path census failed')
if next((path for path in paths if path and owned(path)), None) is None: sys.exit('census/compound: zero owned paths examined')
for path in paths:
    if not path or not owned(path): continue
    verdict(path, leaf(path))
    for part in path.split('/')[:-1]:
        verdict(path + ':', part)

n = len(findings)
baseline_path = "tools/node/dev/census/compound.baseline"
record = '--record' in sys.argv
if record:
    open(baseline_path, 'w').write('%d\n' % n)
    print('census/compound: migration-pressure baseline recorded = %d' % n)
else:
    try:
        base = int(open(baseline_path).read().strip())
    except FileNotFoundError:
        base = None
    for f in findings[:40]:
        print(f)
    if len(findings) > 40:
        print('... %d more' % (len(findings) - 40))
    print('census/compound: %d candidate(s)%s' % (n, '' if base is None else ' (baseline %d)' % base))
    if base is not None and n > base:
        print('census/compound: FAIL — above baseline' , file=sys.stderr)
        sys.exit(1)
PY
