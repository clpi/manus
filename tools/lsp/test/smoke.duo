-- End-to-end smoke test for the Duo-written LSP server.
--
-- Duo replacement for test/smoke.js. The server is Duo; so is its harness now
-- (monoglot census).
--
-- The Node version drove the server with an async bidirectional pipe, resolving
-- each response before sending the next request. That is not needed: every
-- request in this session is predetermined, so the whole JSON-RPC stream is
-- written up front, fed to the server on stdin in one shot, and the transcript
-- parsed afterwards. LSP over stdio is a stream protocol -- the server reads
-- framed requests in order and writes framed replies in order -- so batching
-- changes the timing and nothing else. It also removes the `setTimeout(800)`
-- sleeps the Node harness needed to wait for diagnostics, which were the
-- flakiest part of it.
--
-- Verifies: initialize handshake, diagnostics via `duo check`, documentSymbol
-- outline, hover, incremental didOpen, shutdown/exit.

_SERVER = "./duo-lsp"
_REQ = "/tmp/duo_lsp_smoke_req.txt"
_OUT = "/tmp/duo_lsp_smoke_out.txt"

_failed = 0

_check(name: str, cond: bool, extra: str): void
    if cond
        print("  ok  " .. name)
    else
        _failed = _failed + 1
        if extra == ""
            print("  FAIL " .. name)
        else
            print("  FAIL " .. name .. " :: " .. extra)
        end
    end
end

-- LSP framing. Content-Length counts BYTES of the body, which is why this
-- takes #body and not a character count -- the corpus below is ASCII, but a
-- header that lies is the one framing bug a server cannot recover from.
_frame(body: str): str
    "Content-Length: " .. to(str)(#body) .. "\r\n\r\n" .. body
end

_has(hay: str, needle: str): bool
    std.string.find(hay, needle, 1, true) != nil
end

-- A .duo document as a JSON string body. Only the escapes this corpus actually
-- needs: newline and quote. A general JSON escaper would be the wrong thing to
-- grow here -- if this test ever needs one, it wants a real encoder instead.
_json_text(s: str): str
    out = std.string.gsub(s, "\\", "\\\\")
    out = std.string.gsub(out, "\"", "\\\"")
    out = std.string.gsub(out, "\n", "\\n")
    out
end

_did_open(uri: str, text: str): str
    _frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{"
        .. "\"uri\":\"" .. uri .. "\",\"languageId\":\"duo\",\"version\":1,\"text\":\""
        .. _json_text(text) .. "\"}}}")
end

_doc_symbol(id: i64, uri: str): str
    _frame("{\"jsonrpc\":\"2.0\",\"id\":" .. to(str)(id)
        .. ",\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":\""
        .. uri .. "\"}}}")
end

main = (): i64
    if not std.script.fs_exists(_SERVER)
        print("smoke: server binary not found at " .. _SERVER .. " (run: duo run build.duo)")
        return 2
    end

    duo = std.script.getenv_or("DUO_LSP_DUO_BIN")
    if duo == "" duo = "../duo/zig-out/bin/duo" end
    if not std.script.fs_exists(duo)
        print("smoke: duo binary not found at " .. duo .. " (run zig build)")
        return 2
    end

    bad_uri = "file:///tmp/duo_smoke_bad.duo"
    sym_uri = "file:///tmp/duo_smoke_symbols.duo"
    pm_uri = "file:///tmp/duo_smoke_pm.duo"

    sym_text = "x: i64 = 1\nf(a: i64): i64\n    a + x\nend\nprint(f(x))\n"

    -- A real, known-clean program from the duo corpus: the outline assertion
    -- below is only meaningful against a file whose symbols are known.
    --
    -- This used to be examples/pattern_match_demo.duo, which has since ROTTED
    -- -- it still uses `match`/`case`, so `duo check` now rejects it outright
    -- ("expected '=>', 'then' or 'do'"). The Node harness this replaces fails
    -- the same assertion with the same two messages, so the rot predates the
    -- port. A no-diagnostics control has to point at a file that actually has
    -- none, or it stops testing the server and starts testing the corpus.
    pm_path = "../duo/examples/agent_hooks_showcase.duo"
    if not std.script.fs_exists(pm_path)
        print("smoke: corpus file not found at " .. pm_path)
        return 2
    end
    pm_text = std.script.fs_read(pm_path)

    stream = _frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
        .. _frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
        .. _did_open(bad_uri, "x =\n")
        .. _did_open(sym_uri, sym_text)
        .. _doc_symbol(2, sym_uri)
        .. _frame("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\""
            .. sym_uri .. "\"},\"position\":{\"line\":1,\"character\":0}}}")
        .. _did_open(pm_uri, pm_text)
        .. _doc_symbol(4, pm_uri)
        .. _frame("{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"shutdown\",\"params\":null}")
        .. _frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":{}}")

    std.script.fs_write(_REQ, stream)
    rc = std.script.run("DUO_LSP_DUO_BIN=" .. duo .. " " .. _SERVER .. " < " .. _REQ .. " > " .. _OUT .. " 2>/dev/null")
    out = std.script.fs_read(_OUT)

    _check("initialize returns capabilities", _has(out, "\"capabilities\""), "")
    _check("serverInfo.name == duo-lsp", _has(out, "\"duo-lsp\""), "")

    -- Diagnostics are published per-URI, so the malformed document's own
    -- notification is what must carry a non-empty array. A bare
    -- `"diagnostics":[` match would pass on the CLEAN document's empty one.
    _check("malformed duo doc publishes a diagnostic",
        _has(out, bad_uri) and not _has(out, "\"uri\":\"" .. bad_uri .. "\",\"diagnostics\":[]"), "")
    _check("diagnostic mentions expected expression", _has(out, "expected expression"), "")

    _check("documentSymbol finds f and x", _has(out, "\"f\"") and _has(out, "\"x\""), "")
    _check("hover returns a value for f", _has(out, "\"contents\""), "")

    _check("clean duo doc -> no diagnostics",
        _has(out, "\"uri\":\"" .. pm_uri .. "\",\"diagnostics\":[]"), "")
    _check("duo outline finds HOOKS/POLICY", _has(out, "\"HOOKS\"") and _has(out, "\"POLICY\""), "")

    -- Symbol-scanner edge cases, recovered from test/run-tests.js.
    --
    -- Those tests drove lib/symbols.js -- a JavaScript REIMPLEMENTATION of
    -- logic src/server.duo already owns, which nothing shipped. The assertions
    -- were worth keeping and the twin was not, so the cases that are observable
    -- through documentSymbol now run against the actual server binary. That is
    -- strictly better coverage: it tests the code that ships.
    --
    -- Each case is a nesting the scanner must NOT treat as a top-level
    -- declaration -- the failure mode is an outline polluted with locals.
    nest_uri = "file:///tmp/duo_smoke_nest.duo"
    -- Canonical value form (`name = (): t`), not the bare form. Measured while
    -- writing this: the scanner finds `real = (): i64` and MISSES a zero-param
    -- bare `other(): i64` -- a bare declaration with at least one parameter is
    -- found, so the gap is specifically zero-param bare decls. Filed in the
    -- report; the corpus uses the form the canon asks for regardless.
    nest_text = "-- fake = (): i64 is a comment, not a declaration\n"
        .. "real = (): i64\n"
        .. "    inner_local = 1\n"
        .. "    inner_local\n"
        .. "end\n"
        .. "point = { distance = 3 }\n"
        .. "print(real())\n"

    -- A fresh session needs its own handshake: the server answers no request
    -- before `initialize`. Leaving it out made every negative assertion below
    -- pass against an EMPTY outline, which is why "finds the real declaration"
    -- is here as a positive control -- it is the one that caught it.
    std.script.fs_write(_REQ, _frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
        .. _frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
        .. _did_open(nest_uri, nest_text) .. _doc_symbol(6, nest_uri)
        .. _frame("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"shutdown\",\"params\":null}")
        .. _frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":{}}"))
    -- A second session: the first one was told to exit.
    std.script.run("DUO_LSP_DUO_BIN=" .. duo .. " " .. _SERVER .. " < " .. _REQ .. " > " .. _OUT .. "2 2>/dev/null")
    nest = std.script.fs_read(_OUT .. "2")

    _check("outline finds the real declaration", _has(nest, "\"real\""), "")
    _check("comment does not start a block", not _has(nest, "\"fake\""), "")
    _check("nested local is not top-level", not _has(nest, "\"inner_local\""), "")
    _check("brace-nested member is not top-level", not _has(nest, "\"distance\""), "")
    _check("top-level call is not a declaration", not _has(nest, "\"print\""), "")

    _check("exit code 0 after shutdown", rc == 0, "got " .. to(str)(rc))

    print("")
    if _failed == 0
        print("ALL PASS")
        return 0
    end
    print(to(str)(_failed) .. " FAILED")
    1
end
