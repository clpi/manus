-- tools/lsp/gate.duo — tier-0 gate: the LSP actually SERVES, and by VALUE.
--
-- Why this exists. `build.zig` had `mcp-gate` and NOTHING for the LSP. That is
-- the position all three MCP servers were in when they turned out to be dead
-- for an unknown length of time and nothing noticed. The LSP is the same kind
-- of program — a long-lived stdio server whose only failure signal is silence
-- — and it was carrying the same class of defect on the day this was written:
--
--   `textDocument/didClose` SEGFAULTED the server. Exit 139, no diagnostic, no
--   partial answer, no further response to anything. `t[k] = nil` does not
--   remove a key in Duo, so `flush_dirty` — which runs after EVERY message —
--   walked the docs table, found the nil, and dereferenced it. Every editor
--   closes documents. Nobody had run one.
--
-- What this gate refuses to accept as evidence:
--
--   * "it compiled" — the server compiled fine on the day it segfaulted.
--   * "it started" — a server that starts and then dies mid-session is
--     byte-for-byte indistinguishable from a working one in the first reply.
--   * "initialize answered" — initialize answered on the day didClose killed
--     it. Every check below happens AFTER a document has been opened, changed
--     and CLOSED, so the session has to survive to score.
--
-- So every check is a real LSP-framed JSON-RPC round trip over stdio
-- (`Content-Length: N\r\n\r\n{…}`) whose RESPONSE BYTES are asserted. Counts
-- and token arrays are asserted EXACTLY, never as floors: a floor silently
-- tolerates the handler that stopped answering.
--
-- POSITIVE CONTROLS.
--
--   in-band, every run — an unknown method must come back as a -32601 ERROR.
--     That is the control that separates "answered" from "did not answer": if
--     the transport were broken, or the reader were counting bytes that are
--     not there, this row could not pass while the others do.
--   out-of-band, and RUN — `LSPGATE_SERVER` points this gate at a corrupted
--     copy of the server. A gate that has never been shown failing is not
--     known to be able to fail. Three corruptions were run on 2026-08-08 and
--     each is recorded with what it cost:
--
--       revert the didClose repair (both layers)  →  18 rows red, exit 1
--       decide copula/invoke by SPACING, not R1   →   1 row red, exit 1
--       hand-edit one name in the generated legend →  3 rows red, exit 1
--
--     The middle one is the point: painting `count:u32` purple is the exact
--     H-1 failure docs/spec/roles.md §5.1 warns about, it changes nothing a
--     human would notice in a screenshot, and it moves exactly one integer in
--     the asserted token array.
--
-- TAXONOMY, AND WHOSE. The legend and token rows below assert the taxonomy in
-- `docs/spec/roles.md` §2/§3 and the R1 copula/invoke decider in §5.1.
-- `tools/lsp/src/highlight.duo` implements a DIFFERENT one — 18 members,
-- spacing-decided `:` — and the two give different answers on the fixture line
-- this gate asserts. gaps/GAP-078.md carries the conflict; do not "fix" a red
-- row here by adopting the other taxonomy without that ruling.
--
-- LSPGATE_SERVER   drive a different server file (the controls use it).

root = std.os.getenv("DUO_ROOT")
if root == nil or root == ""
    root = std.os.getenv("PWD")
end
if root == nil or root == ""
    root = "."
end

duobin = std.os.getenv("DUO_BIN")
if duobin == nil or duobin == ""
    duobin = root .. "/zig-out/bin/duo"
end

server = std.os.getenv("LSPGATE_SERVER")
if server == nil or server == ""
    server = root .. "/tools/lsp/src/server.duo"
end

-- `duo run x.duo` drops `x.out` in the CURRENT directory. Run from the repo
-- root and the gate litters the root with server.out, which `zig build
-- repo-hygiene` is entitled to fail on. Work in a scratch dir.
work = "/tmp/duo-lsp-gate"

fails = 0

report(ok: bool, what: str, detail: str): void
    if ok
        io.write("  ok   " .. what .. "\n")
    else
        io.write("  FAIL " .. what .. " — " .. detail .. "\n")
    end
end

-- LSP framing. Not newline-delimited JSON: the server reads a header, parses
-- Content-Length, and then reads exactly that many bytes. A gate that spoke
-- the wrong transport would hang rather than fail, so the frame is built here
-- from the body's own byte length and never from a constant.
frame(body: str): str
    n = #body
    "Content-Length: " .. to(str)(n) .. "\r\n\r\n" .. body
end

-- Feed the server a session on stdin, hand back everything it wrote. stdin is
-- a FILE, not a pipe: a half-written pipe would look like a hang rather than a
-- failure, and this gate exists because silence is the failure mode.
drive(lines: str): str
    reqf = work .. "/req.lsp"
    respf = work .. "/resp.lsp"
    std.fs.write_file(reqf, lines)
    os.execute("cd " .. work .. " && DUO_ROOT='" .. root .. "' '" .. duobin
        .. "' run '" .. server .. "' < '" .. reqf .. "' > '" .. respf .. "' 2>/dev/null")
    std.fs.read_file(respf) or ""
end

has(blob: str, needle: str): bool
    hn = #blob
    nn = #needle
    if nn == 0 or nn > hn
        return false
    end
    i = 1
    while i + nn - 1 <= hn
        j = 1
        ok = true
        while j <= nn
            if blob:byte(i + j - 1) != needle:byte(j)
                ok = false
                j = nn
            end
            j = j + 1
        end
        if ok
            return true
        end
        i = i + 1
    end
    false
end

hasnot(blob: str, needle: str): bool
    not has(blob, needle)
end

check(ok: bool, what: str, detail: str): void
    report(ok, what, detail)
    if not ok
        fails = fails + 1
    end
end

-- The fixture, as one JSON string literal. It is `fixtures/highlight/copula.duo`
-- byte for byte, because that file is the one the golden corpus uses to
-- separate the copula from the invoke — the H-1 discrimination the whole role
-- taxonomy turns on — and a gate should assert against the corpus the law
-- names rather than a fixture it invented for itself.
doc = "-- copula\\ntotal: f64\\ncount:u32\\nn = lx:read(number)\\n"
uri = "file:///tmp/duo-lsp-gate/fixture.duo"

-- A second document, for the CDR half. The copula fixture declares every
-- contract it has, so it has nothing to infer and an inlay-hint check against
-- it would pass on an empty list — which is exactly what a dead handler
-- returns. This one declares a parameter and NOT a return, and binds a bare
-- literal, so both hint paths have something true to say.
cdr = "scale(v: i64)\\n  v * 3\\nend\\ntotal = 7\\n"
cdruri = "file:///tmp/duo-lsp-gate/cdr.duo"

msg(id: i64, method: str, params: str): str
    frame("{\"jsonrpc\":\"2.0\",\"id\":" .. to(str)(id) .. ",\"method\":\"" .. method
        .. "\",\"params\":" .. params .. "}")
end

note(method: str, params: str): str
    frame("{\"jsonrpc\":\"2.0\",\"method\":\"" .. method .. "\",\"params\":" .. params .. "}")
end

at(line: i64, col: i64): str
    "{\"textDocument\":{\"uri\":\"" .. uri .. "\"},\"position\":{\"line\":" .. to(str)(line)
        .. ",\"character\":" .. to(str)(col) .. "}}"
end

main(): i64
    std.fs.mkdir_all(work)
    io.write("lsp-gate: the LSP must SERVE, not merely compile\n")
    io.write("  server: " .. server .. "\n")

    session = msg(1, "initialize", "{}")
        .. note("initialized", "{}")
        .. note("textDocument/didOpen", "{\"textDocument\":{\"uri\":\"" .. uri
            .. "\",\"languageId\":\"duo\",\"version\":1,\"text\":\"" .. doc .. "\"}}")
        -- CLOSE THE DOCUMENT, THEN REOPEN IT. Everything scored below happens
        -- after this pair. On the day this gate was written the close alone
        -- took the process down with SIGSEGV and every later id went
        -- unanswered — which is exactly how the seven dead MCP handlers
        -- looked, and exactly why counts are asserted after the close and not
        -- before it.
        .. note("textDocument/didClose", "{\"textDocument\":{\"uri\":\"" .. uri .. "\"}}")
        .. msg(2, "workspace/symbol", "{\"query\":\"total\"}")
        .. note("textDocument/didOpen", "{\"textDocument\":{\"uri\":\"" .. uri
            .. "\",\"languageId\":\"duo\",\"version\":1,\"text\":\"" .. doc .. "\"}}")
        .. msg(3, "textDocument/documentSymbol", "{\"textDocument\":{\"uri\":\"" .. uri .. "\"}}")
        .. msg(4, "textDocument/hover", at(1, 2))
        .. msg(5, "textDocument/definition", at(1, 2))
        .. msg(6, "textDocument/semanticTokens/full", "{\"textDocument\":{\"uri\":\"" .. uri .. "\"}}")
        .. note("textDocument/didOpen", "{\"textDocument\":{\"uri\":\"" .. cdruri
            .. "\",\"languageId\":\"duo\",\"version\":1,\"text\":\"" .. cdr .. "\"}}")
        .. msg(7, "textDocument/inlayHint", "{\"textDocument\":{\"uri\":\"" .. cdruri .. "\"}}")
        .. msg(8, "textDocument/codeLens", "{\"textDocument\":{\"uri\":\"" .. uri .. "\"}}")
        .. msg(9, "textDocument/nosuch", "{}")
        .. msg(99, "shutdown", "{}")
        .. frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")

    out = drive(session)

    if #out == 0
        check(false, "the server wrote anything at all", "zero bytes on stdout — it did not start, or it died before the first reply")
        io.write("\nlsp-gate: FAIL — no session\n")
        std.os.exit(1)
        return 1
    end

    -- ── handshake and the capability set ─────────────────────────────────
    check(has(out, "\"serverInfo\":{\"name\":\"duo-lsp\""), "initialize handshakes",
        "no serverInfo in the response — the server never handshook")

    for i, cap in {"hoverProvider", "definitionProvider", "documentSymbolProvider",
            "referencesProvider", "renameProvider", "foldingRangeProvider",
            "documentHighlightProvider", "workspaceSymbolProvider",
            "completionProvider", "semanticTokensProvider", "inlayHintProvider",
            "codeLensProvider"}
        check(has(out, "\"" .. cap .. "\""), "initialize advertises " .. cap,
            "absent from capabilities — a client will never send the request")
    end

    -- The legend, EXACTLY, in order. It is GENERATED from docs/spec/roles.md
    -- §2 and §3 by tools/lsp/legend.duo; a hand edit anywhere in that block is
    -- an H-1 drift finding (CLAUDE.md §0d) and this row is where it surfaces.
    -- If the taxonomy legitimately moves, update this string ON PURPOSE.
    legend = "\"tokenTypes\":[\"keyword\",\"copula\",\"descriptor\",\"anchor\",\"union\","
        .. "\"callable\",\"invoke\",\"action\",\"opcode\",\"mnemonic\",\"number\",\"case\","
        .. "\"literal\",\"register\",\"walk\",\"pipe\",\"witness\",\"bind\",\"update\","
        .. "\"relation\",\"levelparen\",\"paramparen\",\"group\",\"brace\",\"bracket\","
        .. "\"comma\",\"operator\",\"bor\",\"comment\",\"name\"]"
    check(has(out, legend), "the semantic-token legend is the generated 17 + 13",
        "the legend drifted from docs/spec/roles.md §2/§3 — regenerate with `duo run tools/lsp/legend.duo`")

    -- ── THE DIDCLOSE REGRESSION ──────────────────────────────────────────
    -- id 2 is asked immediately after a close. If the close crashed the
    -- process this id — and every id after it — is simply missing, which is
    -- what a dead server looks like from the outside.
    check(has(out, "\"id\":2"), "the session SURVIVES textDocument/didClose",
        "no answer after the close — SIGSEGV again; see `forget` in server.duo")
    check(has(out, "{\"id\":2,\"result\":[],\"jsonrpc\":\"2.0\"}"), "the close really FORGETS the document",
        "workspace/symbol still answers for a closed document, so removal did not remove")

    -- ── VALUE round trips ────────────────────────────────────────────────
    check(has(out, "\"name\":\"total\"") and has(out, "\"name\":\"count\"") and has(out, "\"name\":\"n\""),
        "documentSymbol answers by value (total, count, n)",
        "the three top-level bindings of the fixture did not all come back")

    check(has(out, "```duo\\ntotal: f64\\n```"), "hover answers by value",
        "the hover body does not carry the fixture's own declaration line")
    check(has(out, "`why(span)` · role **name**"), "hover carries why(span) — the role at the cursor",
        "H-7: every (span, role) carries a rule citation; the hover answered prose only")
    -- `total` is an ordinary binding, and H-4 gives an ordinary binding NO hue
    -- (roles.md §3: "`name` is the largest hole"). The honest citation is the
    -- one that says so, and the hover must carry it rather than inventing a
    -- rule that would make the token look decided.
    check(has(out, "rule: roles.md §3"), "hover carries the rule that decided the role",
        "H-7: the why-chain has no rule behind it")

    check(has(out, "{\"id\":5,\"result\":{\"uri\":\"" .. uri
        .. "\",\"range\":{\"end\":{\"character\":5,\"line\":1},\"start\":{\"character\":0,\"line\":1}}}"),
        "definition answers by value (line 1, cols 0-5)",
        "the definition range for `total` is not the fixture's line 1")

    -- ── semantic tokens, byte for byte ───────────────────────────────────
    -- Delta-encoded five-tuples. This array IS the copula/invoke ruling in
    -- numbers: `count:u32` on line 2 is tight and groupless, so its `:` must
    -- come back as role 1 (copula) and not role 6 (invoke). Painting it purple
    -- moves one integer here and this row goes red.
    tokens = "\"data\":[0,0,9,28,0,1,0,5,29,1,0,5,1,1,0,0,2,3,2,0,1,0,5,29,1,0,5,1,1,0,"
        .. "0,1,3,2,0,1,0,1,29,1,0,2,1,17,0,0,2,2,29,0,0,2,1,6,0,0,1,4,5,0,0,5,6,29,0]"
    check(has(out, tokens), "semanticTokens answers the corpus token stream exactly",
        "the token array moved; compare against fixtures/highlight/copula.roles.duo")
    -- And the ambiguous spans send NO token. Line 4's two parens are
    -- ambiguous(levelparen|paramparen) under roles.md §5.3, so the stream has
    -- 13 tokens for 15 spans. A fallback role would make this 15 and would be
    -- the guess G-TOTAL forbids wearing a different hat.
    check(hasnot(out, ",20,0") and hasnot(out, ",21,0"),
        "ambiguous spans emit NO token (mixed-space diagnostic, not a guess)",
        "a levelparen/paramparen token appeared — the scanner guessed")

    -- ── inlay hints: CDR-inferred descriptors ────────────────────────────
    check(has(out, "\"id\":7"), "inlayHint answers",
        "no response for id 7 — the handler killed the session")
    check(has(out, "\"label\":\": i64\""), "inlayHint shows the CDR-inferred descriptor by value",
        "no `: i64` hint — `scale` declares no return contract and `duo sim` resolves it to int64_t")
    check(has(out, "B-13 CDR"), "inlayHint carries its CDR citation",
        "a hint with no why-chain is a guess with a label")
    check(has(out, "\"dnir\":\"sim-v0 entity\""), "inlayHint carries its dnir correspondence",
        "H-7: a hint with no provenance cannot be checked against the compiler that produced it")

    -- ── code lenses: lenses count witnesses ──────────────────────────────
    check(has(out, "\"id\":8"), "codeLens answers",
        "no response for id 8 — the handler killed the session")
    check(has(out, "G-TOTAL — roles 13/43 bytes"), "the file lens counts the role census by value",
        "the G-TOTAL witness count moved; 13 of 43 non-whitespace bytes carry a closed-17 role in this fixture")
    check(has(out, "· ambiguity 2 spans"), "the file lens counts unresolved ambiguity",
        "G-TOTAL wants 0; the fixture has 2, and a lens that says otherwise is not measuring")
    check(has(out, "\"role\":\"witness\""), "every lens carries its (role, why, dnir) tuple",
        "H-8: a lens whose only payload is a title string is plain-text output")

    -- ── THE IN-BAND POSITIVE CONTROL ─────────────────────────────────────
    -- An unknown method must come back as an ERROR, not as silence and not as
    -- a result. If the transport were broken every `has` above could fail
    -- together and look like one bug; this row can only pass when the reader
    -- and the writer are both real.
    check(has(out, "{\"id\":9,\"error\":{\"code\":-32601"), "an unknown method ERRORS (positive control)",
        "the server answered an unknown method with silence or with a result")

    check(has(out, "{\"id\":99,\"jsonrpc\":\"2.0\"}"), "shutdown answers last",
        "the session did not reach shutdown; something between opened and it died")

    -- ── the legend is GENERATED, and still current ───────────────────────
    -- Re-derive from the taxonomy and require no change. This is the H-1 drift
    -- check with teeth: it runs the real generator against the real document.
    src = root .. "/docs/spec/roles.md"
    if std.fs.exists(src)
        rc = os.execute("cd " .. work .. " && DUO_ROOT='" .. root .. "' '" .. duobin
            .. "' run '" .. root .. "/tools/lsp/legend.duo' > '" .. work .. "/legend.txt' 2>/dev/null")
        gen = std.fs.read_file(work .. "/legend.txt") or ""
        check(has(gen, "already current"), "the committed legend re-derives from docs/spec/roles.md",
            "regenerating changed the block — commit the regeneration, do not hand-edit it")
    else
        io.write("  OWED docs/spec/roles.md is absent — the legend cannot be re-derived, so H-1 drift is UNCHECKED this run\n")
    end

    os.execute("rm -f ./gate.out")

    io.write("\n")
    if fails == 0
        io.write("lsp-gate: PASS — the server handshakes, survives a close, and answers by value\n")
        return 0
    end
    io.write("lsp-gate: FAIL — " .. to(str)(fails) .. " check(s) failed\n")
    -- `std.os.exit`, NOT `return 1`. A Duo script's `main` return value is
    -- DROPPED, so a gate that returns 1 exits 0 and `zig build` reads success.
    -- mcp-gate learned this by printing 13 failures into a green build.
    std.os.exit(1)
    1
end
