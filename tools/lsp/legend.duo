-- tools/lsp/legend.duo — GENERATE the LSP semantic-token legend.
--
-- CLAUDE.md §0d: "`highlights.scm` and the LSP legend are GENERATED from the
-- graph service — hand edits are an H-1 drift finding." This is the generator
-- for the LSP half. It reads the role taxonomy out of `docs/spec/roles.md` —
-- the ONE written-down scale — and rewrites the marked block in
-- `tools/lsp/src/server.duo`. Nothing here invents a role, orders one, or
-- renames one: every name emitted is a name the taxonomy document already
-- carries, and if the document stops carrying seventeen hued roles this
-- generator REFUSES to write rather than emit a legend it made up.
--
-- Two lists come out, and the split matters:
--
--   closed   the CLOSED 17 of H-2/H-4 (roles.md §2). Coverage counts only
--            these. G-TOTAL wants 100% of non-whitespace bytes here.
--   unhued   the roles the law REQUIRES and assigns no hue (roles.md §3).
--            H-6 says the role function is total, so these must exist and be
--            emittable; §7 says they do not count toward coverage. Both.
--
-- The legend the LSP publishes is closed ++ unhued, because a token type the
-- server emits must have an index in the legend the client was handed. The
-- boundary between them is emitted too, so the coverage counter can key on
-- the role set rather than on a byte total — the control CLAUDE.md §3 asks
-- for by name.
--
-- WHY NOT read `scripts/role_scan.duo`. That file is the fixture-corpus gate,
-- not a service: it enumerates the same seventeen in a `hued()` predicate.
-- Deriving the legend from ANOTHER front end's copy would make two copies
-- agree with each other and neither with the law. Both derive from §2.
--
-- AND THE OTHER TAXONOMY — read gaps/GAP-078.md before changing anything here.
-- `tools/lsp/src/highlight.duo` landed the same day with a DIFFERENT closed
-- set: 18 members, `place` where §2 says `name`, `text` where §2 says
-- `literal`, the §0g fine splits demoted to "cards", no `ambiguous` member —
-- and it decides the copula/invoke split by SPACING where §5.1 decides it by
-- grammar.md R1. On `count:u32` the two answer differently. This generator
-- reads `docs/spec/roles.md` because that is the tracked spec in `docs/spec/`,
-- NOT because the question is settled. It is not settled, and until a ruling
-- lands in CLAUDE.md neither of these two may quietly become the other.
--
-- Run: duo run tools/lsp/legend.duo    (writes in place, prints what changed)
-- Exit 0 wrote or already current · 2 the taxonomy source could not be read
-- or did not enumerate seventeen hued roles — no file was touched.

root = std.os.getenv("DUO_ROOT")
if root == nil or root == ""
    root = std.os.getenv("PWD")
end
if root == nil or root == ""
    root = "."
end

opener = "-- <legend generated by tools/lsp/legend.duo — DO NOT HAND-EDIT>"
closer = "-- </legend>"

lines(s: str): any
    out = {}
    cur = ""
    i = 1
    n = #s
    while i <= n
        b = s:byte(i)
        if b == 10
            out[#out + 1] = cur
            cur = ""
        else
            cur = cur .. s:sub(i, i)
        end
        i = i + 1
    end
    out[#out + 1] = cur
    out
end

-- The backticked word in a markdown table cell, "" when the cell carries none.
-- Deliberately narrow: it reads the FIRST backtick pair on the line and stops,
-- so a decider column full of citations cannot contribute a role name.
ticked(row: str, from: i64): str
    n = #row
    i = from
    while i <= n and row:byte(i) != 96
        i = i + 1
    end
    if i > n
        return ""
    end
    j = i + 1
    while j <= n and row:byte(j) != 96
        j = j + 1
    end
    if j > n
        return ""
    end
    row:sub(i + 1, j - 1)
end

-- A §2 row: `| <digits> | \`role\` | …`. The leading number is what separates a
-- role row from a header, a separator, or prose that happens to hold a table.
numbered(row: str): str
    n = #row
    if n < 4 or row:byte(1) != 124
        return ""
    end
    i = 2
    while i <= n and row:byte(i) == 32
        i = i + 1
    end
    seen = 0
    while i <= n and row:byte(i) >= 48 and row:byte(i) <= 57
        seen = seen + 1
        i = i + 1
    end
    if seen == 0
        return ""
    end
    ticked(row, i)
end

-- A §3 row: `| \`role\` | …`. First cell is the backticked name itself.
firsttick(row: str): str
    n = #row
    if n < 4 or row:byte(1) != 124
        return ""
    end
    i = 2
    while i <= n and row:byte(i) == 32
        i = i + 1
    end
    if i > n or row:byte(i) != 96
        return ""
    end
    ticked(row, i)
end

heading(row: str, want: str): bool
    row:sub(1, #want) == want
end

-- Literal substring search. Written out rather than reached for in std: the
-- ambient `std.string` path has resolved to a missing member before in this
-- tree, and a search that answers nil for "absent" and nil for "not wired"
-- would make the marker check below pass by accident.
findat(hay: str, needle: str): i64
    hn = #hay
    nn = #needle
    if nn == 0 or nn > hn
        return 0
    end
    i = 1
    while i + nn - 1 <= hn
        j = 1
        ok = true
        while j <= nn
            if hay:byte(i + j - 1) != needle:byte(j)
                ok = false
                j = nn
            end
            j = j + 1
        end
        if ok
            return i
        end
        i = i + 1
    end
    0
end

main(): i64
    src = "{root}/docs/spec/roles.md"
    text = std.fs.read_file(src)
    if text == nil or text == ""
        print("legend: FAIL — cannot read {src}")
        print("legend: the taxonomy is the SOURCE. Refusing to write a legend with no citation behind it.")
        std.os.exit(2)
        return 2
    end

    rows = lines(text)
    closed = {}
    unhued = {}
    zone = 0
    i = 1
    while i <= #rows
        row = rows[i]
        if heading(row, "## 2.")
            zone = 2
        elseif heading(row, "## 3.")
            zone = 3
        elseif heading(row, "## 4.")
            zone = 0
        elseif heading(row, "## ")
            zone = 0
        end
        if zone == 2
            got = numbered(row)
            if got != ""
                closed[#closed + 1] = got
            end
        end
        if zone == 3
            got = firsttick(row)
            if got != ""
                unhued[#unhued + 1] = got
            end
        end
        i = i + 1
    end

    -- H-2 asserts the taxonomy is CLOSED AT 18 and roles.md §4 shows the
    -- enumeration reaching 17. Seventeen is what the document can produce, so
    -- seventeen is what this generator accepts; any other count means the
    -- document moved and a human has to say what the legend should be.
    nclosed = #closed
    nunhued = #unhued
    if nclosed != 17
        print("legend: FAIL — {src} §2 enumerates {nclosed} hued roles, not 17.")
        print("legend: roles.md §4 does this arithmetic out loud. Fix the document, then regenerate.")
        std.os.exit(2)
        return 2
    end
    if nunhued == 0
        print("legend: FAIL — {src} §3 enumerates no unhued roles; H-6 makes the role function total, so this cannot be empty.")
        std.os.exit(2)
        return 2
    end

    body = ""
    body = body .. opener .. "\n"
    body = body .. "-- Source: docs/spec/roles.md §2 (the CLOSED 17 of H-2/H-4) and §3 (the roles\n"
    body = body .. "-- the law requires and assigns no hue). Regenerate with:\n"
    body = body .. "--     duo run tools/lsp/legend.duo\n"
    body = body .. "-- `zig build lsp-gate` re-derives this block and fails if it drifted, so a\n"
    body = body .. "-- hand edit here is caught on the commit that makes it (H-1).\n"
    body = body .. "io.lsp.legend = {"
    i = 1
    while i <= #closed
        body = body .. "\"" .. closed[i] .. "\""
        if i < #closed or #unhued > 0
            body = body .. ", "
        end
        i = i + 1
    end
    i = 1
    while i <= #unhued
        body = body .. "\"" .. unhued[i] .. "\""
        if i < #unhued
            body = body .. ", "
        end
        i = i + 1
    end
    body = body .. "}\n"
    body = body .. "-- Roles 1.." .. nclosed:to(str) .. " are the closed set coverage is measured over; the rest\n"
    body = body .. "-- are roles.md §3 and do NOT count toward coverage (§7).\n"
    body = body .. "io.lsp.closed = " .. nclosed:to(str) .. "\n"
    body = body .. closer

    target = "{root}/tools/lsp/src/server.duo"
    cur = std.fs.read_file(target)
    if cur == nil or cur == ""
        print("legend: FAIL — cannot read {target}")
        std.os.exit(2)
        return 2
    end

    -- Splice between the markers. Both must be present: a generator that
    -- APPENDS when it cannot find its own block silently doubles the legend,
    -- and the second copy wins at load time.
    a = findat(cur, opener)
    b = findat(cur, closer)
    if a == 0 or b == 0 or b < a
        print("legend: FAIL — the generated block markers are missing from {target}")
        print("legend: expected a line {opener}")
        std.os.exit(2)
        return 2
    end
    head = cur:sub(1, a - 1)
    tail = cur:sub(b + #closer)
    out = head .. body .. tail

    if out == cur
        print("legend: already current — {nclosed} hued + {nunhued} unhued roles from {src}")
        return 0
    end
    std.fs.write_file(target, out)
    print("legend: wrote {nclosed} hued + {nunhued} unhued roles into {target}")
    0
end
