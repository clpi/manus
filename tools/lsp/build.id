# Build the duo-lsp server binary from the Duo source.
#
# Duo replacement for build.sh (monoglot census: a build script is a program,
# and this repo's program language is Duo). Locates the compiler the same way
# the shell version did, so DUO_LSP_DUO_BIN keeps working.

_first_executable(candidates: any): str
    for _i, c in candidates
        if c != "" and std.script.fs_exists(c)
            return c
        end
    end
    ""
end

_locate_duo(): str
    # Explicit override wins, then the sibling checkout, then PATH. `which`
    # is asked LAST so a locally built compiler is preferred over an
    # installed one # this repo tracks duo's main branch.
    override = std.script.getenv_or("DUO_LSP_DUO_BIN")
    on_path = std.script.chomp(std.script.capture("command -v duo 2>/dev/null"))
    _first_executable({ override, "../duo/zig-out/bin/duo", "../../zig-out/bin/duo", on_path })
end

main: i64 = ()
    duo = _locate_duo()
    if duo == ""
        print("error: duo compiler not found. Build it with 'zig build' or set DUO_LSP_DUO_BIN.")
        return 1
    end

    print("compiling duo-lsp with: " .. duo)
    rc = std.script.run(duo .. " compile -o duo-lsp src/server.id")
    if rc != 0
        print("error: compile failed (exit " .. rc:to(str) .. ")")
        return rc
    end

    std.script.run("chmod +x duo-lsp")
    print("built: duo-lsp")
    0
end
