# Build the idol-lsp server binary from Idol source.
#
# Locates the compiler via IDOL_LSP_BIN override, the repository root, or PATH.
# Public command identity is `idol`.

_first_executable: str = (candidates: any)
  for _i, c in candidates
    if c != "" and script.fs_exists(c)
      return c
  ""

_locate_idol: str = ()
  # Explicit override wins, then the repository root, then PATH.
  override = script.getenv_or("IDOL_LSP_BIN")
  on_path = script.chomp(script.capture("command -v idol 2>/dev/null"))
  _first_executable({ override, "../../zig-out/bin/idol", on_path })

main: i64 = ()
  idol = _locate_idol()
  if idol == ""
    print("error: idol compiler not found. Build it with 'zig build' or set IDOL_LSP_BIN.")
    return 1

  print("compiling idol-lsp with: " .. idol)
  rc = script.run(idol .. " compile -o idol-lsp src/server.id")
  if rc != 0
    print("error: compile failed (exit " .. rc:to(str) .. ")")
    return rc

  script.run("chmod +x idol-lsp")
  print("built: idol-lsp")
  0
