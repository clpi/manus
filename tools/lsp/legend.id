# tools/lsp/legend.id — GENERATE the LSP semantic-token legend.
#
# CLAUDE.md §0d: "`highlights.scm` and the LSP legend are GENERATED from the
# graph service — hand edits are an H-1 drift finding." This is the generator
# for the LSP half, and it does not own a taxonomy. It asks the one the RULING
# settled on.
#
# WHERE IT ASKS, AND WHY THAT CHANGED. This generator first read
# `docs/spec/roles.md` §2/§3 — 17 hued roles plus 13 the law required and left
# unhued. Two implementations had landed with opposite readings and gap[078]
# recorded the conflict rather than picking. §0d then RULED:
#
#     H-2 RULES CLOSURE, NOT A COUNT. FINE SPLITS ARE CARDS, NOT ROLES, and the
#     discriminator is HUE — a split that changes hue is a role, a split within
#     one hue is a card, EXCEPT where the law names a role outright (§4 does,
#     for the space walk). The ordinary binding is `place`.
#
# So the winning enumeration is the one in `tools/lsp/src/highlight.id`, and
# this file reads it through that file's own published interface —
# `hlmode=legend`, which prints `<index> <role> <modifier>` — rather than
# re-deriving it. One vocabulary, two consumers: `highlights.scm` for
# tree-sitter and this legend for the LSP, both out of the same table.
#
# WHAT THE GENERATOR STILL REFUSES TO DO. It does not invent, reorder or
# rename a role, and it will not write a legend at all if the source enumerates
# nothing. `zig build lsp-gate` re-derives this block on every run and fails if
# the committed copy drifted, so a hand edit is caught on the commit that makes
# it.
#
# Run: duo run tools/lsp/legend.id    (writes in place, prints what changed)
# Exit 0 wrote or already current · 2 the taxonomy source could not be read or
# enumerated no roles at all — no file was touched.

root = std.os.getenv("IDOL_ROOT")
if root == nil or root == ""
  root = std.os.getenv("DUO_ROOT")
if root == nil or root == ""
  root = std.os.getenv("PWD")
if root == nil or root == ""
  root = "."

opener = "-- <legend generated by tools/lsp/legend.id — DO NOT HAND-EDIT>"
closer = "-- </legend>"

lines: any = (s: str)
  out = {}
  cur = ""
  i = 1
  n = s:len()
  while i <= n
    b = s:byte(i)
    if b == 10
      out(out:len() + 1) = cur
      cur = ""
    else
      cur = cur .. s:sub(i, i)
    i = i + 1
  out(out:len() + 1) = cur
  out

# Field `want` of a space-separated record, "" when the record is shorter.
# `hlmode=legend` prints `<index> <role> <modifier>`, and a modifier of "-"
# means the role carries none.
field: str = (rec: str, want: i64)
  n = rec:len()
  i = 1
  seen = 0
  start = 0
  while i <= n
    if rec:byte(i) == 32
      i = i + 1
    else
      seen = seen + 1
      start = i
      while i <= n and rec:byte(i) != 32
        i = i + 1
      if seen == want
        return rec:sub(start, i - 1)
  ""

second: str = (rec: str)
  field(rec, 2)

third: str = (rec: str)
  field(rec, 3)

# Literal substring search. Written out rather than reached for in std: the
# ambient `std.string` path has resolved to a missing member before in this
# tree, and a search that answers nil for "absent" and nil for "not wired"
# would make the marker check below pass by accident.
findat: i64 = (hay: str, needle: str)
  hn = hay:len()
  nn = needle:len()
  if nn == 0 or nn > hn
    return 0
  i = 1
  while i + nn - 1 <= hn
    j = 1
    ok = true
    while j <= nn
      if hay:byte(i + j - 1) != needle:byte(j)
        ok = false
        j = nn
      j = j + 1
    if ok
      return i
    i = i + 1
  0

main: i64 = ()
  src = "{root}/tools/lsp/src/highlight.id"
  dump = "/tmp/idol-lsp-legend.txt"
  os.execute("cd /tmp && hlmode=legend IDOL_ROOT='" .. root .. "' DUO_ROOT='" .. root .. "' '" .. root .. "/zig-out/bin/idol' run --backend=c '" .. src .. "' > '" .. dump .. "' 2>/dev/null")
  text = std.fs.read_file(dump)
  if text == nil or text == ""
    print("legend: FAIL — {src} printed no legend under hlmode=legend")
    print("legend: the taxonomy is the SOURCE. Refusing to write a legend with no citation behind it.")
    std.os.exit(2)
    return 2

  rows = lines(text)
  closed = {}
  mods = {}
  seen = {}
  i = 1
  while i <= rows:len()
    row = rows(i)
    nm = second(row)
    md = third(row)
    if nm != ""
      closed(closed:len() + 1) = nm
      if md != "" and md != "-" and seen(md) == nil
        seen(md) = true
        mods(mods:len() + 1) = md
    i = i + 1

  # H-2 rules CLOSURE, not a count (gaps/GAP-078.md), so no number is asserted
  # here. What this generator refuses is a legend with nothing behind it: an
  # empty enumeration, or one whose rows carry no modifier axis. A fixed count
  # would have refused the taxonomy the moment §4 named a nineteenth
  # role, which is exactly the event closure is supposed to survive.
  nclosed = closed:len()
  nmods = mods:len()
  if nclosed == 0
    print("legend: FAIL — {src} enumerates no roles at all under hlmode=legend.")
    print("legend: the taxonomy is the SOURCE. Refusing to write an empty legend.")
    std.os.exit(2)
    return 2
  if nmods == 0
    print("legend: FAIL — the source names no modifiers; H-3 weight and H-5 italic are axes and must reach the client.")
    std.os.exit(2)
    return 2

  body = ""
  body = body .. opener .. "\n"
  body = body .. "-- Source: tools/lsp/src/highlight.id, read through its own `hlmode=legend`\n"
  body = body .. "-- interface. gaps/GAP-078.md merged two taxonomies into that one: H-2 rules\n"
  body = body .. "-- CLOSURE and no count, the fine splits are CARDS, the ordinary binding is\n"
  body = body .. "-- `place`, and the string role is `literal`. Regenerate with:\n"
  body = body .. "--     duo run tools/lsp/legend.id\n"
  body = body .. "-- `zig build lsp-gate` re-derives this block and fails if it drifted, so a\n"
  body = body .. "-- hand edit here is caught on the commit that makes it (H-1).\n"
  body = body .. "io.lsp.legend = {"
  i = 1
  while i <= nclosed
    body = body .. "\"" .. closed(i) .. "\""
    if i < nclosed
      body = body .. ", "
    i = i + 1
  body = body .. "}\n"
  body = body .. "io.lsp.mods = {"
  i = 1
  while i <= nmods
    body = body .. "\"" .. mods(i) .. "\""
    if i < nmods
      body = body .. ", "
    i = i + 1
  body = body .. "}\n"
  body = body .. "-- Roles 1.." .. nclosed:to(str) .. " are the closed set coverage is measured over;\n"
  body = body .. "-- the rest are roles.md §3 and do NOT count toward coverage (§7).\n"
  body = body .. "-- The role function is TOTAL (H-6): every legend member is coverable.\n"
  body = body .. "io.lsp.closed = " .. nclosed:to(str) .. "\n"
  body = body .. closer

  target = "{root}/tools/lsp/src/server.id"
  cur = std.fs.read_file(target)
  if cur == nil or cur == ""
    print("legend: FAIL — cannot read {target}")
    std.os.exit(2)
    return 2

  # Splice between the markers. Both must be present: a generator that
  # APPENDS when it cannot find its own block silently doubles the legend,
  # and the second copy wins at load time.
  a = findat(cur, opener)
  b = findat(cur, closer)
  if a == 0 or b == 0 or b < a
    print("legend: FAIL — the generated block markers are missing from {target}")
    print("legend: expected a line {opener}")
    std.os.exit(2)
    return 2
  head = cur:sub(1, a - 1)
  tail = cur:sub(b + closer:len())
  out = head .. body .. tail

  if out == cur
    print("legend: already current — {nclosed} roles + {nmods} modifiers from {src}")
    return 0
  std.fs.write_file(target, out)
  print("legend: wrote {nclosed} roles + {nmods} modifiers into {target}")
  0
