# Duo LSP Server — full LSP implementation in Duo
io.lsp = {}

# <legend generated by tools/lsp/legend.id — DO NOT HAND-EDIT>
# Source: tools/lsp/src/highlight.id, read through its own `hlmode=legend`
# interface. gaps/GAP-078.md merged two taxonomies into that one: H-2 rules
# CLOSURE and no count, the fine splits are CARDS, the ordinary binding is
# `place`, and the string role is `literal`. Regenerate with:
#     duo run tools/lsp/legend.id
# `zig build lsp-gate` re-derives this block and fails if it drifted, so a
# hand edit here is caught on the commit that makes it (H-1).
io.lsp.legend = { "keyword", "copula", "operator", "layout", "descriptor", "union", "anchor", "retrieve", "invoke", "callable", "world", "foreign", "place", "number", "literal", "case", "comment", "walk", "pipe" }
io.lsp.mods = { "declaration", "defaultlibrary" }
# Roles 1..19 are the closed set coverage is measured over;
# the rest are roles.md §3 and do NOT count toward coverage (§7).
# The role function is TOTAL (H-6): every legend member is coverable.
io.lsp.closed = 19
# </legend>

# ── byte predicates ──────────────────────────────────────────────────────────
is_ident_start: bool = (b: any)
  b >= 65 and b <= 90 or b >= 97 and b <= 122 or b == 95
is_ident_char: bool = (b: any)
  b >= 65 and b <= 90 or b >= 97 and b <= 122 or b >= 48 and b <= 57 or b == 95
is_word_char_byte: bool = (b: any)
  b >= 48 and b <= 57 or b >= 65 and b <= 90 or b >= 97 and b <= 122 or b == 95 or b == 46 or b == 36 or b == 64
is_space_byte: bool = (b: any)
  b == 32 or b == 9 or b == 10 or b == 13

# ── string helpers ───────────────────────────────────────────────────────────
find_from: i64 = (s, sub, start)
  if s == nil
    return 0
  sn = s:len()
  subn = sub:len()
  if subn == 0
    return start
  i = start
  while i + subn - 1 <= sn
    is_match = true
    j = 0
    while j < subn
      if s:byte(i + j) != sub:byte(j + 1)
        is_match = false
        break
      j = j + 1
    if is_match
      return i
    i = i + 1
  0
find_last: i64 = (s, ch)
  n = s:len()
  cb = ch:byte(1)
  j = n
  while j >= 1
    if s:byte(j) == cb
      return j
    j = j - 1
  0
starts_with: bool = (s, prefix)
  if s == nil
    return false
  s:sub(1, prefix:len()) == prefix
ends_with: bool = (s, suffix)
  if s == nil
    return false
  if suffix:len() > s:len()
    return false
  s:sub(s:len() - suffix:len() + 1) == suffix
trim: str = s
if s == nil
  return ""
n = s:len()
i = 1
while i <= n and is_space_byte(s:byte(i))
  i = i + 1
j = n
while j >= i and is_space_byte(s:byte(j))
  j = j - 1
if j < i
  return ""
s:sub(i, j)
contains_char: bool = (s, ch)
  if s == nil
    return false
  cb = ch:byte(1)
  n = s:len()
  i = 1
  while i <= n
    if s:byte(i) == cb
      return true
    i = i + 1
  false
count_char: i64 = (s, ch)
  c = 0
  cb = ch:byte(1)
  n = s:len()
  i = 1
  while i <= n
    if s:byte(i) == cb
      c = c + 1
    i = i + 1
  c
substring_after: str = (s, sep)
  p = find_from(s, sep, 1)
  if p == 0
    return s
  s:sub(p + sep:len())
substring_before: str = (s, sep)
  p = find_from(s, sep, 1)
  if p == 0
    return s
  s:sub(1, p - 1)

# ── forgetting a key ─────────────────────────────────────────────────────────
# `t[k] = nil` DOES NOT REMOVE THE KEY. It stores nil at it, and every later
# `for k, v in t` still yields that key with a nil value. This server crashed
# on `textDocument/didClose` for exactly that reason: the handler wrote
# `io.lsp.docs[uri] = nil`, and `flush_dirty` — which runs after EVERY message
# — then walked the same table and dereferenced `d.dirty` on the nil. SIGSEGV,
# exit 139, no diagnostic, no partial answer; the editor sees a server that
# stopped. Measured 2026-08-08: removing that one line was the difference
# between exit 139 and exit 0 on an otherwise identical session.
#
# So removal is a REBUILD, and it returns the new table — a caller that
# forgets to reassign gets no silent half-removal, it gets no removal at all
# and the gate's close probe says so.
forget: any = (t: any, key: any)
  out = {}
  for k, v in t
    if k != key and v != nil
      out[k] = v
  out

# ── line offsets ─────────────────────────────────────────────────────────────
compute_line_offs: any = text
lo = {}
lo[lo:len() + 1] = 1
n = text:len()
pos = 1
while pos <= n
  if text:byte(pos) == 10
    lo[lo:len() + 1] = pos + 1
  pos = pos + 1
lo
get_line_lo: any = (text, lo, idx)
  if idx < 0
    return nil
  hi = idx + 1
  if hi > lo:len()
    return nil
  start = lo[hi]
  n = text:len()
  ende = n
  if hi + 1 <= lo:len()
    ende = lo[hi + 1] - 2
  if ende < start - 1
    return ""
  line = text:sub(start, ende)
  ln = line:len()
  if ln > 0 and line:byte(ln) == 13
    line = line:sub(1, ln - 1)
  line
offset_at_lo: i64 = (text, lo, pos)
  line = pos.line
  chcol = pos.character
  if line < 0
    line = 0
  n = text:len()
  hi = line + 1
  if hi > lo:len()
    return n
  start = lo[hi]
  off = start - 1 + chcol
  if off < 0
    off = 0
  if off > n
    off = n
  off
word_end_lo: i64 = (text, lo, line, col)
  ln = get_line_lo(text, lo, line)
  if ln == nil
    return col + 1
  n = ln:len()
  e = col
  while e < n
    b = ln:byte(e + 1)
    if is_word_char_byte(b)
      e = e + 1
    else
      break
  if e == col
    return col + 1
  e
word_at_lo: str = (text, lo, line, col)
  ln = get_line_lo(text, lo, line)
  if ln == nil
    return ""
  n = ln:len()
  if col < 0
    col = 0
  if col > n
    col = n
  if col == 0
    return ""
  start = col
  while start > 1 and is_word_char_byte(ln:byte(start - 1))
    start = start - 1
  en = col
  while en < n and is_word_char_byte(ln:byte(en + 1))
    en = en + 1
  if start > en
    return ""
  ln:sub(start, en)
word_prefix_lo: str = (text, lo, line, col)
  ln = get_line_lo(text, lo, line)
  if ln == nil
    return ""
  n = ln:len()
  if col < 0
    col = 0
  if col > n
    col = n
  if col == 0
    return ""
  start = col
  while start > 1 and is_word_char_byte(ln:byte(start - 1))
    start = start - 1
  if start >= col
    return ""
  split_prefix_after_dot(ln:sub(start, col - 1))
split_prefix_after_dot: str = prefix
out = prefix
p = find_from(out, ".", 1)
while p != 0
  out = out:sub(p + 1)
  p = find_from(out, ".", 1)
out

# ── comment / keyword helpers ────────────────────────────────────────────────
strip_comment: str = line
n = line:len()
i = 1
in_str = false
str_ch = 0
while i <= n
  b = line:byte(i)
  if in_str
    if b == str_ch
      in_str = false
  else(b == 34 or b == 39)
    in_str = true
    str_ch = b
  else(b == 45 and i < n and line:byte(i + 1) == 45)
    return line:sub(1, i - 1)
  i = i + 1
line
head_keyword: any = line
code = strip_comment(line)
ctrim = trim(code)
indent = 0
while indent < line:len() and line:byte(indent + 1) == 32
  indent = indent + 1
if ctrim == ""
  r = {}
  r.kw = ""
  r.rest = ""
  r.indent = indent
  return r
b = ctrim:byte(1)
if not is_ident_start(b)
  r = {}
  r.kw = ""
  r.rest = code
  r.indent = indent
  return r
i = 1
n = ctrim:len()
while i <= n and is_ident_char(ctrim:byte(i))
  i = i + 1
r = {}
r.kw = ctrim:sub(1, i - 1)
kw_len: any = r.kw:len()
# The keyword is read off the TRIMMED line and the remainder was being
# sliced out of the UNTRIMMED one, so every indented declaration lost its
# leading `indent` bytes off the wrong end: `  fun helper(b)` yielded
# kw="fun" and rest="un helper(b)", and the symbol came back NAMED `un`.
# It was invisible for as long as documentSymbol returned a flat list —
# nothing nested ever reached a client to be read. Measured 2026-08-08.
r.rest = code:sub(indent + kw_len + 1)
r.indent = indent
r
starts_keyword: bool = (s, kw)
  r = trim(s)
  if not starts_with(r, kw)
    return false
  n = r:len()
  k = kw:len()
  if n == k
    return true
  not is_ident_char(r:byte(k + 1))
count_keyword: i64 = (s, word)
  c = 0
  if s == nil
    return c
  n = s:len()
  wn = word:len()
  i = 1
  while i <= n
    b = s:byte(i)
    if is_ident_start(b)
      j = i
      while j <= n and is_ident_char(s:byte(j))
        j = j + 1
      if j - i == wn and s:sub(i, j - 1) == word
        c = c + 1
      i = j
    else
      i = i + 1
  c
count_end: i64 = s
count_keyword(s, "end")
is_block_opener: bool = (kw: any)
  kw == "fun" or kw == "function" or kw == "enum" or kw == "concept" or kw == "match" or kw == "if" or kw == "while" or kw == "for" or kw == "do" or kw == "begin" or kw == "struct"
kind_of: any = (kw: any)
  if kw == "fun" or kw == "function"
    return 12
  if kw == "enum"
    return 10
  if kw == "concept"
    return 11
  23
kind_label: str = k
if k == 12
  return "function"
if k == 10
  return "enum"
if k == 11
  return "concept"
if k == 23
  return "struct"
if k == 26
  return "alias"
if k == 14
  return "constant"
"variable"

# ── name extraction ──────────────────────────────────────────────────────────
first_ident: any = s
if s == nil
  return nil
n = s:len()
if n == 0
  return nil
start_pos = 1
while start_pos <= n and is_space_byte(s:byte(start_pos))
  start_pos = start_pos + 1
if start_pos > n
  return nil
b = s:byte(start_pos)
if not is_ident_start(b)
  return nil
i = start_pos
while i <= n and is_ident_char(s:byte(i))
  i = i + 1
r = {}
r.name = s:sub(start_pos, i - 1)
r.rest = s:sub(i)
r.col_offset = start_pos - 1
r
name_after_keywords: any = rest
offset = 0
r = rest
while r:len() > 0 and r[1] == " "
  offset = offset + 1
  r = r:sub(2)
if starts_keyword(r, "local") or starts_keyword(r, "global")
  kw_len = "local":len()
  if starts_keyword(r, "global")
    kw_len = "global":len()
  r = r:sub(kw_len + 1)
  while r:len() > 0 and r[1] == " "
    offset = offset + 1
    r = r:sub(2)
if starts_keyword(r, "async")
  r = r:sub("async":len() + 1)
  while r:len() > 0 and r[1] == " "
    offset = offset + 1
    r = r:sub(2)
kw_len = 0
if starts_keyword(r, "fun")
  kw_len = "fun":len()
else(starts_keyword(r, "function"))
  kw_len = "function":len()
if kw_len > 0
  r = r:sub(kw_len + 1)
  while r:len() > 0 and r[1] == " "
    offset = offset + 1
    r = r:sub(2)
result = first_ident(r)
if result != nil
  result.col_offset = result.col_offset + offset
result
match_typed: any = code
n = code:len()
if n == 0
  return nil
i = 1
b = code:byte(i)
if not is_ident_start(b)
  return nil
while i <= n and is_ident_char(code:byte(i))
  i = i + 1
name = code:sub(1, i - 1)
while i <= n and code:byte(i) == 32
  i = i + 1
if i > n
  return nil
if code:byte(i) != 58
  return nil
name
match_plain_assign: any = code
n = code:len()
if n == 0
  return nil
i = 1
b = code:byte(i)
if not is_ident_start(b)
  return nil
while i <= n and is_ident_char(code:byte(i))
  i = i + 1
name = code:sub(1, i - 1)
while i <= n and code:byte(i) == 32
  i = i + 1
if i > n
  return nil
if code:byte(i) == 61
  return name
nil

match_bare_function: any = code
n = code:len()
if n == 0
  return nil
i = 1
b = code:byte(i)
if not is_ident_start(b)
  return nil
while i <= n and is_ident_char(code:byte(i))
  i = i + 1
name = code:sub(1, i - 1)
while i <= n and is_space_byte(code:byte(i))
  i = i + 1
if i > n or code:byte(i) != 40
  return nil
depth = 1
has_typed_param = false
i = i + 1
while i <= n and depth > 0
  ch = code:byte(i)
  if ch == 40
    depth = depth + 1
  else(ch == 41)
    depth = depth - 1
  else(ch == 58)
    has_typed_param = true
  i = i + 1
if depth != 0 or not has_typed_param
  return nil
name

# ── symbol construction ──────────────────────────────────────────────────────
mk_sym: any = (name, kind, line, col, container, raw_line)
  s = {}
  s.name = name
  s.kind = kind
  s.line = line
  s.col = col
  s.endLine = line
  s.endCol = raw_line:len()
  s.detail = trim(raw_line)
  s.container = container
  s
mk_ref: any = (uri, line, col, end_col)
  r = {}
  r.uri = uri
  r.line = line
  r.col = col
  r.endCol = end_col
  r
mk_edit: any = (uri, line, col, end_col, new_name)
  e = {}
  e.uri = uri
  e.line = line
  e.col = col
  e.endCol = end_col
  e.newName = new_name
  e

# ── symbol scanning ──────────────────────────────────────────────────────────
scan_symbols_lo: any = (text, lo)
  syms = {}
  depth = 0
  brace = 0
  n = lo:len()
  container = ""
  container_kind = 0
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil
      break
    code = strip_comment(raw)
    opens = count_char(code, "{")
    closes = count_char(code, "}")
    top = depth == 0 and brace == 0
    ends = count_end(code)
    brace = brace + opens - closes
    if brace < 0
      brace = 0
    info = head_keyword(raw)
    kw = info.kw
    rest = info.rest
    indent = info.indent
    if kw == "end"
      depth = depth + ends - 1
      if depth < 0
        depth = 0
      if depth == 0
        container = ""
        container_kind = 0
    else(top and (kw == "local" or kw == "global"))
      if starts_keyword(rest, "fun") or starts_keyword(rest, "function")
        id = name_after_keywords(rest)
        if id != nil
          syms[syms:len() + 1] = mk_sym(id.name, 12, i - 1, indent + kw:len() + id.col_offset, "", raw)
          container = id.name
          container_kind = 12
      else
        id = first_ident(rest)
        if id != nil
          k = 13
          if kw == "global" or is_upper(id.name)
            k = 14
          syms[syms:len() + 1] = mk_sym(id.name, k, i - 1, indent + kw:len() + id.col_offset, "", raw)
    else(kw == "const")
      id = first_ident(rest)
      if id != nil
        syms[syms:len() + 1] = mk_sym(id.name, 14, i - 1, indent + kw:len() + id.col_offset, "", raw)
    else(is_block_opener(kw) and kw != "do" and kw != "begin")
      if kw == "fun" or kw == "function" or kw == "enum" or kw == "concept"
        id = first_ident(rest)
        if id != nil
          syms[syms:len() + 1] = mk_sym(id.name, kind_of(kw), i - 1, indent + kw:len() + id.col_offset, container, raw)
          if container == ""
            container = id.name
            container_kind = kind_of(kw)
    else
      # TRIMMED, not raw. `match_bare_function` rejects a line that does not
      # START with an identifier, so every indented bare declaration failed
      # the first byte test and was never lifted at all — which is why the
      # trie had no depth to show on canonical source. `indent` is passed
      # separately as the column, so trimming loses nothing.
      bf = match_bare_function(trim(code))
      if bf != nil
        syms[syms:len() + 1] = mk_sym(bf, 12, i - 1, indent, container, raw)
        if container == ""
          container = bf
          container_kind = 12
        depth = depth + 1
      else
        tb = match_typed(code)
        if tb != nil
          syms[syms:len() + 1] = mk_sym(tb, 13, i - 1, indent, container, raw)
        else
          pa = match_plain_assign(code)
          if pa != nil and not starts_with(rest, ".") and not contains_char(raw, ".")
            syms[syms:len() + 1] = mk_sym(pa, 13, i - 1, indent, container, raw)
    i = i + 1
  syms
symbol_at: any = (syms, line, col)
  n = syms:len()
  i = 1
  while i <= n
    s = syms[i]
    if s.line == line
      name_len = s.name:len()
      if col >= s.col and col < s.col + name_len
        return s
    i = i + 1
  nil
is_upper: bool = name
n = name:len()
if n == 0
  return false
i = 1
while i <= n
  b = name:byte(i)
  if not (b >= 65 and b <= 90 or b == 95 or b >= 48 and b <= 57)
    return false
  i = i + 1
true

# ── reference finding ────────────────────────────────────────────────────────
find_refs_in_text: any = (text, lo, name, uri)
  refs = {}
  if name == nil or name == ""
    return refs
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil
      break
    p = 1
    rn = raw:len()
    nn = name:len()
    while p <= rn
      b = raw:byte(p)
      if is_ident_start(b)
        j = p
        while j <= rn and is_ident_char(raw:byte(j))
          j = j + 1
        if j - p == nn
          is_match = true
          k = 0
          while k < nn
            if raw:byte(p + k) != name:byte(k + 1)
              is_match = false
              break
            k = k + 1
          if is_match
            before_ok = true
            if p > 1
              pb = raw:byte(p - 1)
              if is_ident_char(pb)
                before_ok = false
            after_ok = true
            if j <= rn
              ab = raw:byte(j)
              if is_ident_char(ab)
                after_ok = false
            if before_ok and after_ok
              refs[refs:len() + 1] = mk_ref(uri, i - 1, p - 1, j - 1)
        p = j
      else
        p = p + 1
    i = i + 1
  refs

# ── rename edits ─────────────────────────────────────────────────────────────
find_rename_edits_in_text: any = (text, lo, name, new_name, uri)
  edits = {}
  if name == nil or name == "" or new_name == nil or new_name == ""
    return edits
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil
      break
    p = 1
    rn = raw:len()
    nn = name:len()
    while p <= rn
      b = raw:byte(p)
      if is_ident_start(b)
        j = p
        while j <= rn and is_ident_char(raw:byte(j))
          j = j + 1
        if j - p == nn
          is_match = true
          k = 0
          while k < nn
            if raw:byte(p + k) != name:byte(k + 1)
              is_match = false
              break
            k = k + 1
          if is_match
            before_ok = true
            if p > 1
              pb = raw:byte(p - 1)
              if is_ident_char(pb)
                before_ok = false
            after_ok = true
            if j <= rn
              ab = raw:byte(j)
              if is_ident_char(ab)
                after_ok = false
            if before_ok and after_ok
              edits[edits:len() + 1] = mk_edit(uri, i - 1, p - 1, j - 1, new_name)
        p = j
      else
        p = p + 1
    i = i + 1
  edits

# ── folding ranges ───────────────────────────────────────────────────────────
compute_folding_ranges: any = (text, lo)
  folds = {}
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil
      break
    code = strip_comment(raw)
    ctrim = trim(code)
    if ctrim != ""
      b = ctrim:byte(1)
      is_block = false
      if is_ident_start(b)
        kw = ""
        j = 1
        cn = ctrim:len()
        while j <= cn and is_ident_char(ctrim:byte(j))
          j = j + 1
        kw = ctrim:sub(1, j - 1)
        is_block = is_block_opener(kw) or kw == "do" or kw == "begin"
      if not is_block
        if count_char(code, "{") > 0
          is_block = true
      if is_block
        f = {}
        f.startLine = i - 1
        f.startCharacter = 0
        # find matching end line
        k = i
        depth = 1
        while k <= n and depth > 0
          eraw = get_line_lo(text, lo, k)
          if eraw == nil
            break
          ecode = strip_comment(eraw)
          depth = depth - count_end(ecode)
          if depth <= 0
            f.endLine = k
            f.endCharacter = 0
          k = k + 1
        if f.endLine != nil
          folds[folds:len() + 1] = f
    i = i + 1
  folds

# ── workspace index ──────────────────────────────────────────────────────────
ws_index_new: any = ()
  idx = {}
  idx.entries = {}
  idx.paths = {}
  idx
ws_index_add: any = (idx, uri, text)
  lo = compute_line_offs(text)
  syms = scan_symbols_lo(text, lo)
  idx.entries[uri] = syms
ws_index_remove = (idx, uri)
  idx.entries = forget(idx.entries, uri)
ws_find_all_refs: any = (idx, name, exclude_uri)
  refs = {}
  for uri, syms in idx.entries
    if uri != exclude_uri
      lo = compute_line_offs(idx._texts[uri] or "")
      if idx._texts[uri] != nil
        r = find_refs_in_text(idx._texts[uri], lo, name, uri)
        j = 1
        while j <= r:len()
          refs[refs:len() + 1] = r[j]
          j = j + 1
  refs
ws_find_all_edits: any = (idx, name, new_name, exclude_uri)
  edits = {}
  for uri, syms in idx.entries
    if uri != exclude_uri
      txt = idx._texts[uri]
      if txt != nil
        lo = compute_line_offs(txt)
        r = find_rename_edits_in_text(txt, lo, name, new_name, uri)
        j = 1
        while j <= r:len()
          edits[edits:len() + 1] = r[j]
          j = j + 1
  edits
ws_search_symbols: any = (idx, query)
  results = {}
  seen = {}
  for uri, syms in idx.entries
    j = 1
    while syms != nil and j <= syms:len()
      s = syms[j]
      is_public = s.name:sub(1, 1) != "_"
      if is_public and seen[s.name] == nil
        if query == "" or completion_matches(s.name, query)
          o = {}
          o.name = s.name
          o.kind = s.kind
          o.location = {}
          o.location.uri = uri
          o.location.range = mk_range(s.line, s.col, s.col + s.name:len())
          o.containerName = s.container
          results[results:len() + 1] = o
          seen[s.name] = true
      j = j + 1
  results

# ── document highlight ───────────────────────────────────────────────────────
find_doc_highlights: any = (text, lo, syms, line, col)
  name = word_at_lo(text, lo, line, col)
  if name == ""
    return {}
  # check if cursor is on a declared symbol
  s = symbol_at(syms, line, col)
  kind = 1
  if s != nil and s.name == name
    kind = 2
  highlights = {}
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil
      break
    p = 1
    rn = raw:len()
    nn = name:len()
    while p <= rn
      b = raw:byte(p)
      if is_ident_start(b)
        j = p
        while j <= rn and is_ident_char(raw:byte(j))
          j = j + 1
        if j - p == nn
          is_match = true
          k = 0
          while k < nn
            if raw:byte(p + k) != name:byte(k + 1)
              is_match = false
              break
            k = k + 1
          if is_match
            before_ok = true
            if p > 1
              pb = raw:byte(p - 1)
              if is_ident_char(pb)
                before_ok = false
            after_ok = true
            if j <= rn
              ab = raw:byte(j)
              if is_ident_char(ab)
                after_ok = false
            if before_ok and after_ok
              h = {}
              h.range = mk_range(i - 1, p - 1, j - 1)
              h.kind = kind
              highlights[highlights:len() + 1] = h
        p = j
      else
        p = p + 1
    i = i + 1
  highlights

# ── JSON helpers ─────────────────────────────────────────────────────────────
shell_quote: str = s
"'" .. s:gsub("'", "'\\''") .. "'"
resolve_check_flags: str = ()
  f = env("DUO_LSP_CHECK_FLAGS")
  if f != nil and f != ""
    return f .. " "
  h = env("DUO_LSP_HINTS")
  if h != nil and (h == "1" or h == "true" or h == "yes")
    return "--hints "
  ""
resolve_duo_bin: any = ()
  b = env("DUO_LSP_DUO_BIN")
  if b != nil and b != ""
    return b
  b = env("DUO_BIN")
  if b != nil and b != ""
    return b
  f = io.popen("which duo 2>/dev/null", "r")
  if f != nil
    out = f:read("*a")
    f:close()
    out = trim(out)
    if out != ""
      return out
  nil
doc_ext: str = uri
if ends_with(uri, ".id")
  return ".id"
if ends_with(uri, ".lua")
  return ".lua"
".id"

# ── LSP protocol ────────────────────────────────────────────────────────────
send_message: void = t
body = io.lsp.json.encode(t)
header = "Content-Length: %d\r\n\r\n":format(body:len())
stdout:write(header, body)
stdout:flush()
reply: void = (id, result)
  m = {}
  m.jsonrpc = "2.0"
  m.id = id
  m.result = result
  send_message(m)
reply_error: void = (id, code, message)
  e = {}
  e.code = code
  e.message = message
  m = {}
  m.jsonrpc = "2.0"
  m.id = id
  m.error = e
  send_message(m)
send_diagnostics: void = (uri, diags)
  params = {}
  params.uri = uri
  params.diagnostics = diags
  m = {}
  m.jsonrpc = "2.0"
  m.method = "textDocument/publishDiagnostics"
  m.params = params
  send_message(m)

# ── document store ───────────────────────────────────────────────────────────
io.lsp.docs = {}
io.lsp.id_bin = nil
io.lsp.check_flags = ""
io.lsp.counter = 0
io.lsp.shutdown = false
io.lsp.do_exit = false
io.lsp.ws = ws_index_new()
io.lsp.ws._texts = {}
io.lsp.root_uri = nil

now_secs: i64 = ()
  os.time()
doc_for: any = uri
d = io.lsp.docs[uri]
if d == nil
  d = {}
  d.text = ""
  d.version = 0
  d.tmp = nil
  d.lo = nil
  d.syms = nil
  d.syms_version = -1
  d.graph = nil
  d.graph_version = -1
  d.dirty = false
  d.last_t = 0
  io.lsp.docs[uri] = d
d
ensure_lo: void = d
if d.lo == nil
  d.lo = compute_line_offs(d.text)
ensure_syms: void = d
ensure_lo(d)
if d.syms == nil or d.syms_version != d.version
  d.syms = scan_symbols_lo(d.text, d.lo)
  d.syms_version = d.version
invalidate: void = d
d.lo = nil
d.syms = nil
d.graph = nil
d.graph_version = -1
# The compiler reads files, not buffers, so every query about an UNSAVED
# document goes through a temp file. `run_check` grew its own copy of this;
# the graph client needs the same file, so it is one function now and the
# two callers share the buffer instead of racing to write it twice.
doc_tmp_write: any = (d, uri)
  if d.tmp == nil
    io.lsp.counter = io.lsp.counter + 1
    d.tmp = os.tmpname() .. "_" .. tostring(io.lsp.counter) .. doc_ext(uri)
  f = io.open(d.tmp, "w")
  if f == nil
    return nil
  f:write(d.text)
  f:close()
  d.tmp

# ── diagnostics ──────────────────────────────────────────────────────────────
parse_diag_line: any = line
n = line:len()
p = find_from(line, ".line = ", 1)
if p != 0
  i = p + 8
  ld = parse_digits(line, i)
  if ld == nil
    return nil
  lnum = ld.val
  p2 = find_from(line, ", .col = ", p + 8)
  if p2 == 0
    return nil
  cd = parse_digits(line, p2 + 9)
  if cd == nil
    return nil
  cnum = cd.val
  p3 = find_from(line, "}: ", cd.next)
  if p3 == 0
    return nil
  rest = line:sub(p3 + 3)
  sev = 1
  msg = rest
  if starts_with(rest, "error: ")
    sev = 1
    msg = rest:sub(8)
  else(starts_with(rest, "warning: "))
    sev = 2
    msg = rest:sub(10)
  else(starts_with(rest, "hint: "))
    sev = 4
    msg = rest:sub(7)
  else(starts_with(rest, "info: "))
    sev = 3
    msg = rest:sub(7)
  r = {}
  r.line = lnum - 1
  r.col = cnum - 1
  r.severity = sev
  r.message = msg
  return r
e = find_from(line, ": error: ", 1)
w = find_from(line, ": warning: ", 1)
h = find_from(line, ": hint: ", 1)
inf = find_from(line, ": info: ", 1)
marker = 0
mlen = 0
sev = 1
if e != 0
  marker = e
  mlen = 9
  sev = 1
else(w != 0)
  marker = w
  mlen = 11
  sev = 2
else(h != 0)
  marker = h
  mlen = 8
  sev = 4
else(inf != 0)
  marker = inf
  mlen = 8
  sev = 3
else
  return nil
msg = line:sub(marker + mlen)
prefix = line:sub(1, marker - 1)
c1 = find_last(prefix, ":")
if c1 == 0
  return nil
cnum_str = prefix:sub(c1 + 1)
prefix2 = prefix:sub(1, c1 - 1)
c2 = find_last(prefix2, ":")
if c2 == 0
  return nil
lnum_str = prefix2:sub(c2 + 1)
lnum = tonumber(lnum_str)
cnum = tonumber(cnum_str)
if lnum == nil or cnum == nil
  return nil
r = {}
r.line = lnum - 1
r.col = cnum - 1
r.severity = sev
r.message = msg
r
parse_digits: any = (s, i)
  n = s:len()
  v = 0
  any = false
  while i <= n
    b = s:byte(i)
    if b >= 48 and b <= 57
      v = v * 10 + b - 48
      any = true
      i = i + 1
    else
      break
  if not any
    return nil
  r = {}
  r.val = v
  r.next = i
  r
parse_diagnostics: any = (out, lo, text)
  diags = {}
  if out == nil
    return diags
  pos = 1
  n = out:len()
  while pos <= n
    nl = find_from(out, "\n", pos)
    line = ""
    if nl == 0
      line = out:sub(pos)
      pos = n + 1
    else
      line = out:sub(pos, nl - 1)
      pos = nl + 1
    d = parse_diag_line(line)
    if d != nil
      ec = word_end_lo(text, lo, d.line, d.col)
      diag = {}
      diag.range = mk_range(d.line, d.col, ec)
      diag.severity = d.severity
      diag.source = "duo"
      diag.message = d.message
      diags[diags:len() + 1] = diag
  diags
run_check: void = uri
d = io.lsp.docs[uri]
if d == nil
  return
if io.lsp.id_bin == nil
  send_diagnostics(uri, {})
  return
if doc_tmp_write(d, uri) == nil
  return
cmd = shell_quote(io.lsp.id_bin) .. " check --plain-diagnostics " .. io.lsp.check_flags .. " " .. shell_quote(d.tmp) .. " 2>&1"
p = io.popen(cmd, "r")
if p == nil
  return
out = p:read("*a")
p:close()
ensure_lo(d)
diags = parse_diagnostics(out, d.lo, d.text)
if diags:len() == 0
  ep = find_from(out, "error:", 1)
  if ep != 0
    diag = {}
    diag.range = mk_range(0, 0, word_end_lo(d.text, d.lo, 0, 0))
    diag.severity = 1
    diag.source = "duo"
    diag.message = trim(out:sub(ep + 6))
    diags[diags:len() + 1] = diag
send_diagnostics(uri, diags)
schedule_check: void = uri
d = io.lsp.docs[uri]
if d == nil
  return
if io.lsp.id_bin == nil
  send_diagnostics(uri, {})
  return
t = now_secs()
if d.last_t == 0 or t > d.last_t
  run_check(uri)
  d.last_t = t
  d.dirty = false
else
  d.dirty = true
flush_dirty: void = ()
  docs = io.lsp.docs
  t = now_secs()
  for uri, d in docs
    # `d ~= nil` is not paranoia, it is the crash site. See `forget` above.
    if d != nil and d.dirty
      if t > d.last_t
        run_check(uri)
        d.last_t = t
        d.dirty = false

# ── workspace indexing ───────────────────────────────────────────────────────
scan_workspace: void = ()
  if io.lsp.root_uri == nil
    return
  root = io.lsp.root_uri
  if starts_with(root, "file://")
    root = root:sub(8)
  cmd = "find " .. shell_quote(root) .. " -name '*.id' -o -name '*.lua' 2>/dev/null | head -200"
  p = io.popen(cmd, "r")
  if p == nil
    return
  out = p:read("*a")
  p:close()
  pos = 1
  n = out:len()
  while pos <= n
    nl = find_from(out, "\n", pos)
    fp = ""
    if nl == 0
      fp = trim(out:sub(pos))
      pos = n + 1
    else
      fp = trim(out:sub(pos, nl - 1))
      pos = nl + 1
    if fp != ""
      f = io.open(fp, "r")
      if f != nil
        txt = f:read("*a")
        f:close()
        # reconstruct file:// URI
        uri = "file://" .. fp
        io.lsp.ws._texts[uri] = txt
        ws_index_add(io.lsp.ws, uri, txt)

# ── message I/O ──────────────────────────────────────────────────────────────
read_line: any = ()
  out = {}
  while true
    c = stdin:read(1)
    if c == nil
      if out:len() == 0
        return nil
      break
    if c == "\n"
      break
    if c != "\r"
      out[out:len() + 1] = c
  out:concat()
read_message: any = ()
  content_length = -1
  while true
    line = read_line()
    if line == nil
      return nil
    if line == ""
      break
    p = find_from(line, "Content-Length:", 1)
    if p != 0
      rest = trim(line:sub(p + 15))
      n = tonumber(rest)
      if n != nil
        content_length = n
  if content_length < 0
    return nil
  body = stdin:read(content_length)
  if body == nil
    return nil
  io.lsp.json.decode(body)

# ── text sync ────────────────────────────────────────────────────────────────
offset_at: i64 = (text, pos)
  line = pos.line
  chcol = pos.character
  n = text:len()
  i = 1
  cur_line = 0
  while i <= n and cur_line < line
    if text:byte(i) == 10
      cur_line = cur_line + 1
    i = i + 1
  off = i - 1 + chcol
  if off < 0
    off = 0
  off
apply_changes: str = (text, changes)
  out = text
  n = changes:len()
  i = 1
  while i <= n
    ch = changes[i]
    txt = ch.text
    if txt == nil
      txt = ""
    if ch.range != nil
      s = offset_at(out, ch.range.start)
      e = offset_at(out, ch.range["end"])
      if s < 0
        s = 0
      if e < s
        e = s
      out = out:sub(1, s) .. txt .. out:sub(e + 1)
    else
      out = txt
    i = i + 1
  out

# ── completion helpers ───────────────────────────────────────────────────────
completion_matches: bool = (name, prefix)
  if prefix == ""
    return true
  if starts_with(name, prefix)
    return true
  p = find_from(name, ":", 1)
  while p != 0
    if starts_with(name:sub(p + 1), prefix)
      return true
    p = find_from(name, ":", p + 1)
  p = find_from(name, ".", 1)
  while p != 0
    if starts_with(name:sub(p + 1), prefix)
      return true
    p = find_from(name, ".", p + 1)
  false
completion_kind_for_symbol: i64 = k
if k == 12
  return 3
if k == 10
  return 10
if k == 11
  return 11
if k == 23 or k == 26
  return 7
if k == 14
  return 21
13
add_completion: void = (out, seen, label, kind, detail, insert_text, sort_text)
  if label == nil or label == ""
    return
  if seen[label] != nil
    return
  seen[label] = true
  item = {}
  item.label = label
  item.kind = kind
  if detail != nil and detail != ""
    item.detail = detail
  if insert_text != nil and insert_text != label
    item.insertText = insert_text
  if sort_text != nil
    item.sortText = sort_text
  out[out:len() + 1] = item
add_keyword_completion: void = (out, seen, label, prefix)
  if completion_matches(label, prefix)
    add_completion(out, seen, label, 14, "Duo keyword", nil, "k_" .. label)
add_snippet_completion: void = (out, seen, label, detail, insert_text, prefix, sort_text)
  if completion_matches(label, prefix)
    item = {}
    item.label = label
    item.kind = 15
    item.detail = detail
    item.insertText = insert_text
    item.insertTextFormat = 2
    item.sortText = sort_text
    out[out:len() + 1] = item
add_builtin_completion: void = (out, seen, label, prefix)
  if completion_matches(label, prefix)
    add_completion(out, seen, label, 3, "Duo builtin", nil, "b_" .. label)
add_std_completion: void = (out, seen, label, prefix)
  if completion_matches(label, prefix)
    add_completion(out, seen, label, 9, "std module", nil, "m_" .. label)
add_type_completion: void = (out, seen, label, prefix)
  if completion_matches(label, prefix)
    add_completion(out, seen, label, 7, "Duo type", nil, "t_" .. label)
add_static_completions: void = (out, seen, prefix)
  add_keyword_completion(out, seen, "and", prefix)
  add_keyword_completion(out, seen, "alias", prefix)
  add_keyword_completion(out, seen, "async", prefix)
  add_keyword_completion(out, seen, "break", prefix)
  add_keyword_completion(out, seen, "case", prefix)
  add_keyword_completion(out, seen, "catch", prefix)
  add_keyword_completion(out, seen, "const", prefix)
  add_keyword_completion(out, seen, "defer", prefix)
  add_keyword_completion(out, seen, "do", prefix)
  add_keyword_completion(out, seen, "else", prefix)
  add_keyword_completion(out, seen, "elseif", prefix)
  add_keyword_completion(out, seen, "end", prefix)
  add_keyword_completion(out, seen, "false", prefix)
  add_keyword_completion(out, seen, "for", prefix)
  add_keyword_completion(out, seen, "global", prefix)
  add_keyword_completion(out, seen, "goto", prefix)
  add_keyword_completion(out, seen, "if", prefix)
  add_keyword_completion(out, seen, "in", prefix)
  add_keyword_completion(out, seen, "local", prefix)
  add_keyword_completion(out, seen, "match", prefix)
  add_keyword_completion(out, seen, "nil", prefix)
  add_keyword_completion(out, seen, "not", prefix)
  add_keyword_completion(out, seen, "or", prefix)
  add_keyword_completion(out, seen, "repeat", prefix)
  add_keyword_completion(out, seen, "return", prefix)
  add_keyword_completion(out, seen, "true", prefix)
  add_keyword_completion(out, seen, "try", prefix)
  add_keyword_completion(out, seen, "type", prefix)
  add_keyword_completion(out, seen, "until", prefix)
  add_keyword_completion(out, seen, "while", prefix)
  add_type_completion(out, seen, "any", prefix)
  add_type_completion(out, seen, "bool", prefix)
  add_type_completion(out, seen, "f32", prefix)
  add_type_completion(out, seen, "f64", prefix)
  add_type_completion(out, seen, "i8", prefix)
  add_type_completion(out, seen, "i16", prefix)
  add_type_completion(out, seen, "i32", prefix)
  add_type_completion(out, seen, "i64", prefix)
  add_type_completion(out, seen, "str", prefix)
  add_type_completion(out, seen, "u8", prefix)
  add_type_completion(out, seen, "u16", prefix)
  add_type_completion(out, seen, "u32", prefix)
  add_type_completion(out, seen, "u64", prefix)
  add_type_completion(out, seen, "void", prefix)
  add_builtin_completion(out, seen, "assert", prefix)
  add_builtin_completion(out, seen, "collectgarbage", prefix)
  add_builtin_completion(out, seen, "error", prefix)
  add_builtin_completion(out, seen, "pcall", prefix)
