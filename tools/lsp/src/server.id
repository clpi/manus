  add_builtin_completion(out, seen, "type", prefix)
  add_builtin_completion(out, seen, "xpcall", prefix)
  add_std_completion(out, seen, "argparse", prefix)
  add_std_completion(out, seen, "base32", prefix)
  add_std_completion(out, seen, "base64", prefix)
  add_std_completion(out, seen, "build", prefix)
