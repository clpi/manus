# Duo LSP Server — full LSP implementation in Duo
io.lsp = {}

# <legend generated by tools/lsp/legend.id — DO NOT HAND-EDIT>
# Source: tools/lsp/src/highlight.id, read through its own `hlmode=legend`
# interface. gaps/GAP-078.md merged two taxonomies into that one: H-2 rules
# CLOSURE and no count, the fine splits are CARDS, the ordinary binding is
# `place`, and the string role is `literal`. Regenerate with:
#     duo run tools/lsp/legend.id
# `zig build lsp-gate` re-derives this block and fails if it drifted, so a
# hand edit here is caught on the commit that makes it (H-1).
io.lsp.legend = {"keyword", "copula", "operator", "layout", "descriptor", "union", "anchor", "retrieve", "invoke", "callable", "world", "foreign", "place", "number", "literal", "case", "comment", "walk", "pipe"}
io.lsp.mods = {"declaration", "defaultlibrary"}
# Roles 1..19 are the closed set coverage is measured over;
# the rest are roles.md §3 and do NOT count toward coverage (§7).
# The role function is TOTAL (H-6): every legend member is coverable.
io.lsp.closed = 19
# </legend>


# ── byte predicates ──────────────────────────────────────────────────────────
fun is_ident_start(b: any) -> bool
  b >= 65 and b <= 90 or b >= 97 and b <= 122 or b == 95
end
fun is_ident_char(b: any) -> bool
  b >= 65 and b <= 90 or b >= 97 and b <= 122 or b >= 48 and b <= 57 or b == 95
end
fun is_word_char_byte(b: any) -> bool
  b >= 48 and b <= 57 or b >= 65 and b <= 90 or b >= 97 and b <= 122 or b == 95 or b == 46 or b == 36 or b == 64
end
fun is_space_byte(b: any) -> bool
  b == 32 or b == 9 or b == 10 or b == 13
end

# ── string helpers ───────────────────────────────────────────────────────────
fun find_from(s, sub, start) -> i64
  if s == nil then
    return 0
  end
  sn = s:len()
  subn = sub:len()
  if subn == 0 then
    return start
  end
  i = start
  while i + subn - 1 <= sn
    is_match = true
    j = 0
    while j < subn
      if s:byte(i + j) != sub:byte(j + 1) then
        is_match = false
        break
      end
      j += 1
    end
    if is_match then
      return i
    end
    i += 1
  end
  0
end
fun find_last(s, ch) -> i64
  n = s:len()
  cb = ch:byte(1)
  j = n
  while j >= 1
    if s:byte(j) == cb then
      return j
    end
    j -= 1
  end
  0
end
fun starts_with(s, prefix) -> bool
  if s == nil then
    return false
  end
  s:sub(1, prefix:len()) == prefix
end
fun ends_with(s, suffix) -> bool
  if s == nil then
    return false
  end
  if suffix:len() > s:len() then
    return false
  end
  s:sub(s:len() - suffix:len() + 1) == suffix
end
fun trim(s) -> str
  if s == nil then
    return ""
  end
  n = s:len()
  i = 1
  while i <= n and is_space_byte(s:byte(i))
    i += 1
  end
  j = n
  while j >= i and is_space_byte(s:byte(j))
    j -= 1
  end
  if j < i then
    return ""
  end
  s:sub(i, j)
end
fun contains_char(s, ch) -> bool
  if s == nil then
    return false
  end
  cb = ch:byte(1)
  n = s:len()
  i = 1
  while i <= n
    if s:byte(i) == cb then
      return true
    end
    i += 1
  end
  false
end
fun count_char(s, ch) -> i64
  c = 0
  cb = ch:byte(1)
  n = s:len()
  i = 1
  while i <= n
    if s:byte(i) == cb then
      c += 1
    end
    i += 1
  end
  c
end
fun substring_after(s, sep) -> str
  p = find_from(s, sep, 1)
  if p == 0 then
    return s
  end
  s:sub(p + sep:len())
end
fun substring_before(s, sep) -> str
  p = find_from(s, sep, 1)
  if p == 0 then
    return s
  end
  s:sub(1, p - 1)
end

# ── forgetting a key ─────────────────────────────────────────────────────────
# `t[k] = nil` DOES NOT REMOVE THE KEY. It stores nil at it, and every later
# `for k, v in t` still yields that key with a nil value. This server crashed
# on `textDocument/didClose` for exactly that reason: the handler wrote
# `io.lsp.docs[uri] = nil`, and `flush_dirty` — which runs after EVERY message
# — then walked the same table and dereferenced `d.dirty` on the nil. SIGSEGV,
# exit 139, no diagnostic, no partial answer; the editor sees a server that
# stopped. Measured 2026-08-08: removing that one line was the difference
# between exit 139 and exit 0 on an otherwise identical session.
#
# So removal is a REBUILD, and it returns the new table — a caller that
# forgets to reassign gets no silent half-removal, it gets no removal at all
# and the gate's close probe says so.
forget(t: any, key: any): any
  out = {}
  for k, v in t
    if k != key and v != nil then
      out[k] = v
    end
  end
  out
end

# ── line offsets ─────────────────────────────────────────────────────────────
fun compute_line_offs(text) -> any
  lo = {}
  lo[lo:len() + 1] = 1
  n = text:len()
  pos = 1
  while pos <= n
    if text:byte(pos) == 10 then
      lo[lo:len() + 1] = pos + 1
    end
    pos += 1
  end
  lo
end
fun get_line_lo(text, lo, idx) -> any
  if idx < 0 then
    return nil
  end
  hi = idx + 1
  if hi > lo:len() then
    return nil
  end
  start = lo[hi]
  n = text:len()
  ende = n
  if hi + 1 <= lo:len() then
    ende = lo[hi + 1] - 2
  end
  if ende < start - 1 then
    return ""
  end
  line = text:sub(start, ende)
  ln = line:len()
  if ln > 0 and line:byte(ln) == 13 then
    line = line:sub(1, ln - 1)
  end
  line
end
fun offset_at_lo(text, lo, pos) -> i64
  line = pos.line
  chcol = pos.character
  if line < 0 then
    line = 0
  end
  n = text:len()
  hi = line + 1
  if hi > lo:len() then
    return n
  end
  start = lo[hi]
  off = start - 1 + chcol
  if off < 0 then
    off = 0
  end
  if off > n then
    off = n
  end
  off
end
fun word_end_lo(text, lo, line, col) -> i64
  ln = get_line_lo(text, lo, line)
  if ln == nil then
    return col + 1
  end
  n = ln:len()
  e = col
  while e < n
    b = ln:byte(e + 1)
    if is_word_char_byte(b) then
      e += 1
    else
      break
    end
  end
  if e == col then
    return col + 1
  end
  e
end
fun word_at_lo(text, lo, line, col) -> str
  ln = get_line_lo(text, lo, line)
  if ln == nil then
    return ""
  end
  n = ln:len()
  if col < 0 then
    col = 0
  end
  if col > n then
    col = n
  end
  if col == 0 then
    return ""
  end
  start = col
  while start > 1 and is_word_char_byte(ln:byte(start - 1))
    start -= 1
  end
  en = col
  while en < n and is_word_char_byte(ln:byte(en + 1))
    en += 1
  end
  if start > en then
    return ""
  end
  ln:sub(start, en)
end
fun word_prefix_lo(text, lo, line, col) -> str
  ln = get_line_lo(text, lo, line)
  if ln == nil then
    return ""
  end
  n = ln:len()
  if col < 0 then
    col = 0
  end
  if col > n then
    col = n
  end
  if col == 0 then
    return ""
  end
  start = col
  while start > 1 and is_word_char_byte(ln:byte(start - 1))
    start -= 1
  end
  if start >= col then
    return ""
  end
  split_prefix_after_dot(ln:sub(start, col - 1))
end
fun split_prefix_after_dot(prefix) -> str
  out = prefix
  p = find_from(out, ".", 1)
  while p != 0
    out = out:sub(p + 1)
    p = find_from(out, ".", 1)
  end
  out
end

# ── comment / keyword helpers ────────────────────────────────────────────────
fun strip_comment(line) -> str
  n = line:len()
  i = 1
  in_str = false
  str_ch = 0
  while i <= n
    b = line:byte(i)
    if in_str then
      if b == str_ch then
        in_str = false
      end
    elseif b == 34 or b == 39 then
      in_str = true
      str_ch = b
    elseif b == 45 and i < n and line:byte(i + 1) == 45 then
      return line:sub(1, i - 1)
    end
    i += 1
  end
  line
end
fun head_keyword(line) -> any
  code = strip_comment(line)
  ctrim = trim(code)
  indent = 0
  while indent < line:len() and line:byte(indent + 1) == 32
    indent += 1
  end
  if ctrim == "" then
    r = {}
    r.kw = ""
    r.rest = ""
    r.indent = indent
    return r
  end
  b = ctrim:byte(1)
  if not is_ident_start(b) then
    r = {}
    r.kw = ""
    r.rest = code
    r.indent = indent
    return r
  end
  i = 1
  n = ctrim:len()
  while i <= n and is_ident_char(ctrim:byte(i))
    i += 1
  end
  r = {}
  r.kw = ctrim:sub(1, i - 1)
  kw_len: any = r.kw:len()
  # The keyword is read off the TRIMMED line and the remainder was being
  # sliced out of the UNTRIMMED one, so every indented declaration lost its
  # leading `indent` bytes off the wrong end: `  fun helper(b)` yielded
  # kw="fun" and rest="un helper(b)", and the symbol came back NAMED `un`.
  # It was invisible for as long as documentSymbol returned a flat list —
  # nothing nested ever reached a client to be read. Measured 2026-08-08.
  r.rest = code:sub(indent + kw_len + 1)
  r.indent = indent
  r
end
fun starts_keyword(s, kw) -> bool
  r = trim(s)
  if not starts_with(r, kw) then
    return false
  end
  n = r:len()
  k = kw:len()
  if n == k then
    return true
  end
  not is_ident_char(r:byte(k + 1))
end
fun count_keyword(s, word) -> i64
  c = 0
  if s == nil then
    return c
  end
  n = s:len()
  wn = word:len()
  i = 1
  while i <= n
    b = s:byte(i)
    if is_ident_start(b) then
      j = i
      while j <= n and is_ident_char(s:byte(j))
        j += 1
      end
      if j - i == wn and s:sub(i, j - 1) == word then
        c += 1
      end
      i = j
    else
      i += 1
    end
  end
  c
end
fun count_end(s) -> i64
  count_keyword(s, "end")
end
fun is_block_opener(kw: any) -> bool
  kw == "fun" or kw == "function" or kw == "enum" or kw == "concept" or kw == "match" or kw == "if" or kw == "while" or kw == "for" or kw == "do" or kw == "begin" or kw == "struct"
end
fun kind_of(kw: any) -> any
  if kw == "fun" or kw == "function" then
    return 12
  end
  if kw == "enum" then
    return 10
  end
  if kw == "concept" then
    return 11
  end
  23
end
fun kind_label(k) -> str
  if k == 12 then
    return "function"
  end
  if k == 10 then
    return "enum"
  end
  if k == 11 then
    return "concept"
  end
  if k == 23 then
    return "struct"
  end
  if k == 26 then
    return "alias"
  end
  if k == 14 then
    return "constant"
  end
  "variable"
end

# ── name extraction ──────────────────────────────────────────────────────────
fun first_ident(s) -> any
  if s == nil then
    return nil
  end
  n = s:len()
  if n == 0 then
    return nil
  end
  start_pos = 1
  while start_pos <= n and is_space_byte(s:byte(start_pos))
    start_pos += 1
  end
  if start_pos > n then
    return nil
  end
  b = s:byte(start_pos)
  if not is_ident_start(b) then
    return nil
  end
  i = start_pos
  while i <= n and is_ident_char(s:byte(i))
    i += 1
  end
  r = {}
  r.name = s:sub(start_pos, i - 1)
  r.rest = s:sub(i)
  r.col_offset = start_pos - 1
  r
end
fun name_after_keywords(rest) -> any
  offset = 0
  r = rest
  while r:len() > 0 and r[1] == " "
    offset += 1
    r = r:sub(2)
  end
  if starts_keyword(r, "local") or starts_keyword(r, "global") then
    kw_len = "local":len()
    if starts_keyword(r, "global") then kw_len = "global":len() end
    r = r:sub(kw_len + 1)
    while r:len() > 0 and r[1] == " "
      offset += 1
      r = r:sub(2)
    end
  end
  if starts_keyword(r, "async") then
    r = r:sub("async":len() + 1)
    while r:len() > 0 and r[1] == " "
      offset += 1
      r = r:sub(2)
    end
  end
  kw_len = 0
  if starts_keyword(r, "fun") then kw_len = "fun":len()
  elseif starts_keyword(r, "function") then kw_len = "function":len()
  end
  if kw_len > 0 then
    r = r:sub(kw_len + 1)
    while r:len() > 0 and r[1] == " "
      offset += 1
      r = r:sub(2)
    end
  end
  result = first_ident(r)
  if result != nil then
    result.col_offset = result.col_offset + offset
  end
  result
end
fun match_typed(code) -> any
  n = code:len()
  if n == 0 then
    return nil
  end
  i = 1
  b = code:byte(i)
  if not is_ident_start(b) then
    return nil
  end
  while i <= n and is_ident_char(code:byte(i))
    i += 1
  end
  name = code:sub(1, i - 1)
  while i <= n and code:byte(i) == 32
    i += 1
  end
  if i > n then
    return nil
  end
  if code:byte(i) != 58 then
    return nil
  end
  name
end
fun match_plain_assign(code) -> any
  n = code:len()
  if n == 0 then
    return nil
  end
  i = 1
  b = code:byte(i)
  if not is_ident_start(b) then
    return nil
  end
  while i <= n and is_ident_char(code:byte(i))
    i += 1
  end
  name = code:sub(1, i - 1)
  while i <= n and code:byte(i) == 32
    i += 1
  end
  if i > n then
    return nil
  end
  if code:byte(i) == 61 then
    return name
  end
  nil
end

fun match_bare_function(code) -> any
  n = code:len()
  if n == 0 then
    return nil
  end
  i = 1
  b = code:byte(i)
  if not is_ident_start(b) then
    return nil
  end
  while i <= n and is_ident_char(code:byte(i))
    i += 1
  end
  name = code:sub(1, i - 1)
  while i <= n and is_space_byte(code:byte(i))
    i += 1
  end
  if i > n or code:byte(i) != 40 then
    return nil
  end
  depth = 1
  has_typed_param = false
  i += 1
  while i <= n and depth > 0
    ch = code:byte(i)
    if ch == 40 then
      depth += 1
    elseif ch == 41 then
      depth -= 1
    elseif ch == 58 then
      has_typed_param = true
    end
    i += 1
  end
  if depth != 0 or not has_typed_param then
    return nil
  end
  name
end

# ── symbol construction ──────────────────────────────────────────────────────
fun mk_sym(name, kind, line, col, container, raw_line) -> any
  s = {}
  s.name = name
  s.kind = kind
  s.line = line
  s.col = col
  s.endLine = line
  s.endCol = raw_line:len()
  s.detail = trim(raw_line)
  s.container = container
  s
end
fun mk_ref(uri, line, col, end_col) -> any
  r = {}
  r.uri = uri
  r.line = line
  r.col = col
  r.endCol = end_col
  r
end
fun mk_edit(uri, line, col, end_col, new_name) -> any
  e = {}
  e.uri = uri
  e.line = line
  e.col = col
  e.endCol = end_col
  e.newName = new_name
  e
end

# ── symbol scanning ──────────────────────────────────────────────────────────
fun scan_symbols_lo(text, lo) -> any
  syms = {}
  depth = 0
  brace = 0
  n = lo:len()
  container = ""
  container_kind = 0
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil then
      break
    end
    code = strip_comment(raw)
    opens = count_char(code, "{")
    closes = count_char(code, "}")
    top = depth == 0 and brace == 0
    ends = count_end(code)
    brace += opens - closes
    if brace < 0 then
      brace = 0
    end
    info = head_keyword(raw)
    kw = info.kw
    rest = info.rest
    indent = info.indent
    if kw == "end" then
      depth += ends - 1
      if depth < 0 then
        depth = 0
      end
      if depth == 0 then
        container = ""
        container_kind = 0
      end
    elseif top and (kw == "local" or kw == "global") then
      if starts_keyword(rest, "fun") or starts_keyword(rest, "function") then
        id = name_after_keywords(rest)
        if id != nil then
          syms[syms:len() + 1] = mk_sym(id.name, 12, i - 1, indent + kw:len() + id.col_offset, "", raw)
          container = id.name
          container_kind = 12
        end
      else
        id = first_ident(rest)
        if id != nil then
          k = 13
          if kw == "global" or is_upper(id.name) then
            k = 14
          end
          syms[syms:len() + 1] = mk_sym(id.name, k, i - 1, indent + kw:len() + id.col_offset, "", raw)
        end
      end
    elseif kw == "const" then
      id = first_ident(rest)
      if id != nil then
        syms[syms:len() + 1] = mk_sym(id.name, 14, i - 1, indent + kw:len() + id.col_offset, "", raw)
      end
    elseif is_block_opener(kw) and kw != "do" and kw != "begin" then
      if kw == "fun" or kw == "function" or kw == "enum" or kw == "concept" then
        id = first_ident(rest)
        if id != nil then
          syms[syms:len() + 1] = mk_sym(id.name, kind_of(kw), i - 1, indent + kw:len() + id.col_offset, container, raw)
          if container == "" then
            container = id.name
            container_kind = kind_of(kw)
          end
        end
      end
    else
      # TRIMMED, not raw. `match_bare_function` rejects a line that does not
      # START with an identifier, so every indented bare declaration failed
      # the first byte test and was never lifted at all — which is why the
      # trie had no depth to show on canonical source. `indent` is passed
      # separately as the column, so trimming loses nothing.
      bf = match_bare_function(trim(code))
      if bf != nil then
        syms[syms:len() + 1] = mk_sym(bf, 12, i - 1, indent, container, raw)
        if container == "" then
          container = bf
          container_kind = 12
        end
        depth += 1
      else
        tb = match_typed(code)
        if tb != nil then
          syms[syms:len() + 1] = mk_sym(tb, 13, i - 1, indent, container, raw)
        else
          pa = match_plain_assign(code)
          if pa != nil and not starts_with(rest, ".") and not contains_char(raw, ".") then
            syms[syms:len() + 1] = mk_sym(pa, 13, i - 1, indent, container, raw)
          end
        end
      end
    end
    i += 1
  end
  syms
end
fun symbol_at(syms, line, col) -> any
  n = syms:len()
  i = 1
  while i <= n
    s = syms[i]
    if s.line == line then
      name_len = s.name:len()
      if col >= s.col and col < s.col + name_len then
        return s
      end
    end
    i += 1
  end
  nil
end
fun is_upper(name) -> bool
  n = name:len()
  if n == 0 then
    return false
  end
  i = 1
  while i <= n
    b = name:byte(i)
    if not (b >= 65 and b <= 90 or b == 95 or b >= 48 and b <= 57) then
      return false
    end
    i += 1
  end
  true
end

# ── reference finding ────────────────────────────────────────────────────────
fun find_refs_in_text(text, lo, name, uri) -> any
  refs = {}
  if name == nil or name == "" then
    return refs
  end
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil then
      break
    end
    p = 1
    rn = raw:len()
    nn = name:len()
    while p <= rn
      b = raw:byte(p)
      if is_ident_start(b) then
        j = p
        while j <= rn and is_ident_char(raw:byte(j))
          j += 1
        end
        if j - p == nn then
          is_match = true
          k = 0
          while k < nn
            if raw:byte(p + k) != name:byte(k + 1) then
              is_match = false
              break
            end
            k += 1
          end
          if is_match then
            before_ok = true
            if p > 1 then
              pb = raw:byte(p - 1)
              if is_ident_char(pb) then
                before_ok = false
              end
            end
            after_ok = true
            if j <= rn then
              ab = raw:byte(j)
              if is_ident_char(ab) then
                after_ok = false
              end
            end
            if before_ok and after_ok then
              refs[refs:len() + 1] = mk_ref(uri, i - 1, p - 1, j - 1)
            end
          end
        end
        p = j
      else
        p += 1
      end
    end
    i += 1
  end
  refs
end

# ── rename edits ─────────────────────────────────────────────────────────────
fun find_rename_edits_in_text(text, lo, name, new_name, uri) -> any
  edits = {}
  if name == nil or name == "" or new_name == nil or new_name == "" then
    return edits
  end
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil then
      break
    end
    p = 1
    rn = raw:len()
    nn = name:len()
    while p <= rn
      b = raw:byte(p)
      if is_ident_start(b) then
        j = p
        while j <= rn and is_ident_char(raw:byte(j))
          j += 1
        end
        if j - p == nn then
          is_match = true
          k = 0
          while k < nn
            if raw:byte(p + k) != name:byte(k + 1) then
              is_match = false
              break
            end
            k += 1
          end
          if is_match then
            before_ok = true
            if p > 1 then
              pb = raw:byte(p - 1)
              if is_ident_char(pb) then
                before_ok = false
              end
            end
            after_ok = true
            if j <= rn then
              ab = raw:byte(j)
              if is_ident_char(ab) then
                after_ok = false
              end
            end
            if before_ok and after_ok then
              edits[edits:len() + 1] = mk_edit(uri, i - 1, p - 1, j - 1, new_name)
            end
          end
        end
        p = j
      else
        p += 1
      end
    end
    i += 1
  end
  edits
end

# ── folding ranges ───────────────────────────────────────────────────────────
fun compute_folding_ranges(text, lo) -> any
  folds = {}
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil then
      break
    end
    code = strip_comment(raw)
    ctrim = trim(code)
    if ctrim != "" then
      b = ctrim:byte(1)
      is_block = false
      if is_ident_start(b) then
        kw = ""
        j = 1
        cn = ctrim:len()
        while j <= cn and is_ident_char(ctrim:byte(j))
          j += 1
        end
        kw = ctrim:sub(1, j - 1)
        is_block = is_block_opener(kw) or kw == "do" or kw == "begin"
      end
      if not is_block then
        if count_char(code, "{") > 0 then
          is_block = true
        end
      end
      if is_block then
        f = {}
        f.startLine = i - 1
        f.startCharacter = 0
        # find matching end line
        k = i
        depth = 1
        while k <= n and depth > 0
          eraw = get_line_lo(text, lo, k)
          if eraw == nil then
            break
          end
          ecode = strip_comment(eraw)
          depth -= count_end(ecode)
          if depth <= 0 then
            f.endLine = k
            f.endCharacter = 0
          end
          k += 1
        end
        if f.endLine != nil then
          folds[folds:len() + 1] = f
        end
      end
    end
    i += 1
  end
  folds
end

# ── workspace index ──────────────────────────────────────────────────────────
fun ws_index_new() -> any
  idx = {}
  idx.entries = {}
  idx.paths = {}
  idx
end
fun ws_index_add(idx, uri, text) -> any
  lo = compute_line_offs(text)
  syms = scan_symbols_lo(text, lo)
  idx.entries[uri] = syms
end
fun ws_index_remove(idx, uri)
  idx.entries = forget(idx.entries, uri)
end
fun ws_find_all_refs(idx, name, exclude_uri) -> any
  refs = {}
  for uri, syms in idx.entries
    if uri != exclude_uri then
      lo = compute_line_offs(idx._texts[uri] or "")
      if idx._texts[uri] != nil then
        r = find_refs_in_text(idx._texts[uri], lo, name, uri)
        j = 1
        while j <= r:len()
          refs[refs:len() + 1] = r[j]
          j += 1
        end
      end
    end
  end
  refs
end
fun ws_find_all_edits(idx, name, new_name, exclude_uri) -> any
  edits = {}
  for uri, syms in idx.entries
    if uri != exclude_uri then
      txt = idx._texts[uri]
      if txt != nil then
        lo = compute_line_offs(txt)
        r = find_rename_edits_in_text(txt, lo, name, new_name, uri)
        j = 1
        while j <= r:len()
          edits[edits:len() + 1] = r[j]
          j += 1
        end
      end
    end
  end
  edits
end
fun ws_search_symbols(idx, query) -> any
  results = {}
  seen = {}
  for uri, syms in idx.entries
    j = 1
    while syms != nil and j <= syms:len()
      s = syms[j]
      is_public = s.name:sub(1, 1) != "_"
      if is_public and seen[s.name] == nil then
        if query == "" or completion_matches(s.name, query) then
          o = {}
          o.name = s.name
          o.kind = s.kind
          o.location = {}
          o.location.uri = uri
          o.location.range = mk_range(s.line, s.col, s.col + s.name:len())
          o.containerName = s.container
          results[results:len() + 1] = o
          seen[s.name] = true
        end
      end
      j += 1
    end
  end
  results
end

# ── document highlight ───────────────────────────────────────────────────────
fun find_doc_highlights(text, lo, syms, line, col) -> any
  name = word_at_lo(text, lo, line, col)
  if name == "" then
    return {}
  end
  # check if cursor is on a declared symbol
  s = symbol_at(syms, line, col)
  kind = 1
  if s != nil and s.name == name then
    kind = 2
  end
  highlights = {}
  n = lo:len()
  i = 1
  while i <= n
    raw = get_line_lo(text, lo, i - 1)
    if raw == nil then
      break
    end
    p = 1
    rn = raw:len()
    nn = name:len()
    while p <= rn
      b = raw:byte(p)
      if is_ident_start(b) then
        j = p
        while j <= rn and is_ident_char(raw:byte(j))
          j += 1
        end
        if j - p == nn then
          is_match = true
          k = 0
          while k < nn
            if raw:byte(p + k) != name:byte(k + 1) then
              is_match = false
              break
            end
            k += 1
          end
          if is_match then
            before_ok = true
            if p > 1 then
              pb = raw:byte(p - 1)
              if is_ident_char(pb) then
                before_ok = false
              end
            end
            after_ok = true
            if j <= rn then
              ab = raw:byte(j)
              if is_ident_char(ab) then
                after_ok = false
              end
            end
            if before_ok and after_ok then
              h = {}
              h.range = mk_range(i - 1, p - 1, j - 1)
              h.kind = kind
              highlights[highlights:len() + 1] = h
            end
          end
        end
        p = j
      else
        p += 1
      end
    end
    i += 1
  end
  highlights
end

# ── JSON helpers ─────────────────────────────────────────────────────────────
fun shell_quote(s) -> str
  "'" .. s:gsub("'", "'\\''") .. "'"
end
fun resolve_check_flags() -> str
  f = os.getenv("DUO_LSP_CHECK_FLAGS")
  if f != nil and f != "" then
    return f .. " "
  end
  h = os.getenv("DUO_LSP_HINTS")
  if h != nil and (h == "1" or h == "true" or h == "yes") then
    return "--hints "
  end
  ""
end
fun resolve_duo_bin() -> any
  b = os.getenv("DUO_LSP_DUO_BIN")
  if b != nil and b != "" then
    return b
  end
  b = os.getenv("DUO_BIN")
  if b != nil and b != "" then
    return b
  end
  f = io.popen("which duo 2>/dev/null", "r")
  if f != nil then
    out = f:read("*a")
    f:close()
    out = trim(out)
    if out != "" then
      return out
    end
  end
  nil
end
fun doc_ext(uri) -> str
  if ends_with(uri, ".id") then
    return ".id"
  end
  if ends_with(uri, ".lua") then
    return ".lua"
  end
  ".id"
end

# ── LSP protocol ────────────────────────────────────────────────────────────
fun send_message(t) -> void
  body = io.lsp.json.encode(t)
  header = "Content-Length: %d\r\n\r\n":format(body:len())
  io.write(header, body)
  io.flush()
end
fun reply(id, result) -> void
  m = {}
  m.jsonrpc = "2.0"
  m.id = id
  m.result = result
  send_message(m)
end
fun reply_error(id, code, message) -> void
  e = {}
  e.code = code
  e.message = message
  m = {}
  m.jsonrpc = "2.0"
  m.id = id
  m.error = e
  send_message(m)
end
fun send_diagnostics(uri, diags) -> void
  params = {}
  params.uri = uri
  params.diagnostics = diags
  m = {}
  m.jsonrpc = "2.0"
  m.method = "textDocument/publishDiagnostics"
  m.params = params
  send_message(m)
end

# ── document store ───────────────────────────────────────────────────────────
io.lsp.docs = {}
io.lsp.id_bin = nil
io.lsp.check_flags = ""
io.lsp.counter = 0
io.lsp.shutdown = false
io.lsp.do_exit = false
io.lsp.ws = ws_index_new()
io.lsp.ws._texts = {}
io.lsp.root_uri = nil

fun now_secs() -> i64
  os.time()
end
fun doc_for(uri) -> any
  d = io.lsp.docs[uri]
  if d == nil then
    d = {}
    d.text = ""
    d.version = 0
    d.tmp = nil
    d.lo = nil
    d.syms = nil
    d.syms_version = -1
    d.graph = nil
    d.graph_version = -1
    d.dirty = false
    d.last_t = 0
    io.lsp.docs[uri] = d
  end
  d
end
fun ensure_lo(d) -> void
  if d.lo == nil then
    d.lo = compute_line_offs(d.text)
  end
end
fun ensure_syms(d) -> void
  ensure_lo(d)
  if d.syms == nil or d.syms_version != d.version then
    d.syms = scan_symbols_lo(d.text, d.lo)
    d.syms_version = d.version
  end
end
fun invalidate(d) -> void
  d.lo = nil
  d.syms = nil
  d.graph = nil
  d.graph_version = -1
end
# The compiler reads files, not buffers, so every query about an UNSAVED
# document goes through a temp file. `run_check` grew its own copy of this;
# the graph client needs the same file, so it is one function now and the
# two callers share the buffer instead of racing to write it twice.
fun doc_tmp_write(d, uri) -> any
  if d.tmp == nil then
    io.lsp.counter = io.lsp.counter + 1
    d.tmp = os.tmpname() .. "_" .. tostring(io.lsp.counter) .. doc_ext(uri)
  end
  f = io.open(d.tmp, "w")
  if f == nil then
    return nil
  end
  f:write(d.text)
  f:close()
  d.tmp
end

# ── diagnostics ──────────────────────────────────────────────────────────────
fun parse_diag_line(line) -> any
  n = line:len()
  p = find_from(line, ".line = ", 1)
  if p != 0 then
    i = p + 8
    ld = parse_digits(line, i)
    if ld == nil then
      return nil
    end
    lnum = ld.val
    p2 = find_from(line, ", .col = ", p + 8)
    if p2 == 0 then
      return nil
    end
    cd = parse_digits(line, p2 + 9)
    if cd == nil then
      return nil
    end
    cnum = cd.val
    p3 = find_from(line, "}: ", cd.next)
    if p3 == 0 then
      return nil
    end
    rest = line:sub(p3 + 3)
    sev = 1
    msg = rest
    if starts_with(rest, "error: ") then
      sev = 1
      msg = rest:sub(8)
    elseif starts_with(rest, "warning: ") then
      sev = 2
      msg = rest:sub(10)
    elseif starts_with(rest, "hint: ") then
      sev = 4
      msg = rest:sub(7)
    elseif starts_with(rest, "info: ") then
      sev = 3
      msg = rest:sub(7)
    end
    r = {}
    r.line = lnum - 1
    r.col = cnum - 1
    r.severity = sev
    r.message = msg
    return r
  end
  e = find_from(line, ": error: ", 1)
  w = find_from(line, ": warning: ", 1)
  h = find_from(line, ": hint: ", 1)
  inf = find_from(line, ": info: ", 1)
  marker = 0
  mlen = 0
  sev = 1
  if e != 0 then
    marker = e
    mlen = 9
    sev = 1
  elseif w != 0 then
    marker = w
    mlen = 11
    sev = 2
  elseif h != 0 then
    marker = h
    mlen = 8
    sev = 4
  elseif inf != 0 then
    marker = inf
    mlen = 8
    sev = 3
  else
    return nil
  end
  msg = line:sub(marker + mlen)
  prefix = line:sub(1, marker - 1)
  c1 = find_last(prefix, ":")
  if c1 == 0 then
    return nil
  end
  cnum_str = prefix:sub(c1 + 1)
  prefix2 = prefix:sub(1, c1 - 1)
  c2 = find_last(prefix2, ":")
  if c2 == 0 then
    return nil
  end
  lnum_str = prefix2:sub(c2 + 1)
  lnum = tonumber(lnum_str)
  cnum = tonumber(cnum_str)
  if lnum == nil or cnum == nil then
    return nil
  end
  r = {}
  r.line = lnum - 1
  r.col = cnum - 1
  r.severity = sev
  r.message = msg
  r
end
fun parse_digits(s, i) -> any
  n = s:len()
  v = 0
  any = false
  while i <= n
    b = s:byte(i)
    if b >= 48 and b <= 57 then
      v = v * 10 + b - 48
      any = true
      i += 1
    else
      break
    end
  end
  if not any then
    return nil
  end
  r = {}
  r.val = v
  r.next = i
  r
end
fun parse_diagnostics(out, lo, text) -> any
  diags = {}
  if out == nil then
    return diags
  end
  pos = 1
  n = out:len()
  while pos <= n
    nl = find_from(out, "\n", pos)
    line = ""
    if nl == 0 then
      line = out:sub(pos)
      pos = n + 1
    else
      line = out:sub(pos, nl - 1)
      pos = nl + 1
    end
    d = parse_diag_line(line)
    if d != nil then
      ec = word_end_lo(text, lo, d.line, d.col)
      diag = {}
      diag.range = mk_range(d.line, d.col, ec)
      diag.severity = d.severity
      diag.source = "duo"
      diag.message = d.message
      diags[diags:len() + 1] = diag
    end
  end
  diags
end
fun run_check(uri) -> void
  d = io.lsp.docs[uri]
  if d == nil then
    return
  end
  if io.lsp.id_bin == nil then
    send_diagnostics(uri, {})
    return
  end
  if doc_tmp_write(d, uri) == nil then
    return
  end
  cmd = shell_quote(io.lsp.id_bin) .. " check --plain-diagnostics " .. io.lsp.check_flags .. " " .. shell_quote(d.tmp) .. " 2>&1"
  p = io.popen(cmd, "r")
  if p == nil then
    return
  end
  out = p:read("*a")
  p:close()
  ensure_lo(d)
  diags = parse_diagnostics(out, d.lo, d.text)
  if diags:len() == 0 then
    ep = find_from(out, "error:", 1)
    if ep != 0 then
      diag = {}
      diag.range = mk_range(0, 0, word_end_lo(d.text, d.lo, 0, 0))
      diag.severity = 1
      diag.source = "duo"
      diag.message = trim(out:sub(ep + 6))
      diags[diags:len() + 1] = diag
    end
  end
  send_diagnostics(uri, diags)
end
fun schedule_check(uri) -> void
  d = io.lsp.docs[uri]
  if d == nil then
    return
  end
  if io.lsp.id_bin == nil then
    send_diagnostics(uri, {})
    return
  end
  t = now_secs()
  if d.last_t == 0 or t > d.last_t then
    run_check(uri)
    d.last_t = t
    d.dirty = false
  else
    d.dirty = true
  end
end
fun flush_dirty() -> void
  docs = io.lsp.docs
  t = now_secs()
  for uri, d in docs
    # `d ~= nil` is not paranoia, it is the crash site. See `forget` above.
    if d != nil and d.dirty then
      if t > d.last_t then
        run_check(uri)
        d.last_t = t
        d.dirty = false
      end
    end
  end
end

# ── workspace indexing ───────────────────────────────────────────────────────
fun scan_workspace() -> void
  if io.lsp.root_uri == nil then
    return
  end
  root = io.lsp.root_uri
  if starts_with(root, "file://") then
    root = root:sub(8)
  end
  cmd = "find " .. shell_quote(root) .. " -name '*.id' -o -name '*.lua' 2>/dev/null | head -200"
  p = io.popen(cmd, "r")
  if p == nil then
    return
  end
  out = p:read("*a")
  p:close()
  pos = 1
  n = out:len()
  while pos <= n
    nl = find_from(out, "\n", pos)
    fp = ""
    if nl == 0 then
      fp = trim(out:sub(pos))
      pos = n + 1
    else
      fp = trim(out:sub(pos, nl - 1))
      pos = nl + 1
    end
    if fp != "" then
      f = io.open(fp, "r")
      if f != nil then
        txt = f:read("*a")
        f:close()
        # reconstruct file:// URI
        uri = "file://" .. fp
        io.lsp.ws._texts[uri] = txt
        ws_index_add(io.lsp.ws, uri, txt)
      end
    end
  end
end

# ── message I/O ──────────────────────────────────────────────────────────────
fun read_line() -> any
  out = {}
  while true
    c = io.read(1)
    if c == nil then
      if out:len() == 0 then
        return nil
      end
      break
    end
    if c == "\n" then
      break
    end
    if c != "\r" then
      out[out:len() + 1] = c
    end
  end
  out:concat()
end
fun read_message() -> any
  content_length = -1
  while true
    line = read_line()
    if line == nil then
      return nil
    end
    if line == "" then
      break
    end
    p = find_from(line, "Content-Length:", 1)
    if p != 0 then
      rest = trim(line:sub(p + 15))
      n = tonumber(rest)
      if n != nil then
        content_length = n
      end
    end
  end
  if content_length < 0 then
    return nil
  end
  body = io.read(content_length)
  if body == nil then
    return nil
  end
  io.lsp.json.decode(body)
end

# ── text sync ────────────────────────────────────────────────────────────────
fun offset_at(text, pos) -> i64
  line = pos.line
  chcol = pos.character
  n = text:len()
  i = 1
  cur_line = 0
  while i <= n and cur_line < line
    if text:byte(i) == 10 then
      cur_line += 1
    end
    i += 1
  end
  off = i - 1 + chcol
  if off < 0 then
    off = 0
  end
  off
end
fun apply_changes(text, changes) -> str
  out = text
  n = changes:len()
  i = 1
  while i <= n
    ch = changes[i]
    txt = ch.text
    if txt == nil then
      txt = ""
    end
    if ch.range != nil then
      s = offset_at(out, ch.range.start)
      e = offset_at(out, ch.range["end"])
      if s < 0 then
        s = 0
      end
      if e < s then
        e = s
      end
      out = out:sub(1, s) .. txt .. out:sub(e + 1)
    else
      out = txt
    end
    i += 1
  end
  out
end

# ── completion helpers ───────────────────────────────────────────────────────
fun completion_matches(name, prefix) -> bool
  if prefix == "" then
    return true
  end
  if starts_with(name, prefix) then
    return true
  end
  p = find_from(name, ":", 1)
  while p != 0
    if starts_with(name:sub(p + 1), prefix) then
      return true
    end
    p = find_from(name, ":", p + 1)
  end
  p = find_from(name, ".", 1)
  while p != 0
    if starts_with(name:sub(p + 1), prefix) then
      return true
    end
    p = find_from(name, ".", p + 1)
  end
  false
end
fun completion_kind_for_symbol(k) -> i64
  if k == 12 then
    return 3
  end
  if k == 10 then
    return 10
  end
  if k == 11 then
    return 11
  end
  if k == 23 or k == 26 then
    return 7
  end
  if k == 14 then
    return 21
  end
  13
end
fun add_completion(out, seen, label, kind, detail, insert_text, sort_text) -> void
  if label == nil or label == "" then
    return
  end
  if seen[label] != nil then
    return
  end
  seen[label] = true
  item = {}
  item.label = label
  item.kind = kind
  if detail != nil and detail != "" then
    item.detail = detail
  end
  if insert_text != nil and insert_text != label then
    item.insertText = insert_text
  end
  if sort_text != nil then
    item.sortText = sort_text
  end
  out[out:len() + 1] = item
end
fun add_keyword_completion(out, seen, label, prefix) -> void
  if completion_matches(label, prefix) then
    add_completion(out, seen, label, 14, "Duo keyword", nil, "k_" .. label)
  end
end
fun add_snippet_completion(out, seen, label, detail, insert_text, prefix, sort_text) -> void
  if completion_matches(label, prefix) then
    item = {}
    item.label = label
    item.kind = 15
    item.detail = detail
    item.insertText = insert_text
    item.insertTextFormat = 2
    item.sortText = sort_text
    out[out:len() + 1] = item
  end
end
fun add_builtin_completion(out, seen, label, prefix) -> void
  if completion_matches(label, prefix) then
    add_completion(out, seen, label, 3, "Duo builtin", nil, "b_" .. label)
  end
end
fun add_std_completion(out, seen, label, prefix) -> void
  if completion_matches(label, prefix) then
    add_completion(out, seen, label, 9, "std module", nil, "m_" .. label)
  end
end
fun add_type_completion(out, seen, label, prefix) -> void
  if completion_matches(label, prefix) then
    add_completion(out, seen, label, 7, "Duo type", nil, "t_" .. label)
  end
end
fun add_static_completions(out, seen, prefix) -> void
  add_keyword_completion(out, seen, "and", prefix)
  add_keyword_completion(out, seen, "alias", prefix)
  add_keyword_completion(out, seen, "async", prefix)
  add_keyword_completion(out, seen, "break", prefix)
  add_keyword_completion(out, seen, "case", prefix)
  add_keyword_completion(out, seen, "catch", prefix)
  add_keyword_completion(out, seen, "const", prefix)
  add_keyword_completion(out, seen, "defer", prefix)
  add_keyword_completion(out, seen, "do", prefix)
  add_keyword_completion(out, seen, "else", prefix)
  add_keyword_completion(out, seen, "elseif", prefix)
  add_keyword_completion(out, seen, "end", prefix)
  add_keyword_completion(out, seen, "false", prefix)
  add_keyword_completion(out, seen, "for", prefix)
  add_keyword_completion(out, seen, "global", prefix)
  add_keyword_completion(out, seen, "goto", prefix)
  add_keyword_completion(out, seen, "if", prefix)
  add_keyword_completion(out, seen, "in", prefix)
  add_keyword_completion(out, seen, "local", prefix)
  add_keyword_completion(out, seen, "match", prefix)
  add_keyword_completion(out, seen, "nil", prefix)
  add_keyword_completion(out, seen, "not", prefix)
  add_keyword_completion(out, seen, "or", prefix)
  add_keyword_completion(out, seen, "repeat", prefix)
  add_keyword_completion(out, seen, "return", prefix)
  add_keyword_completion(out, seen, "true", prefix)
  add_keyword_completion(out, seen, "try", prefix)
  add_keyword_completion(out, seen, "type", prefix)
  add_keyword_completion(out, seen, "until", prefix)
  add_keyword_completion(out, seen, "while", prefix)
  add_type_completion(out, seen, "any", prefix)
  add_type_completion(out, seen, "bool", prefix)
  add_type_completion(out, seen, "f32", prefix)
  add_type_completion(out, seen, "f64", prefix)
