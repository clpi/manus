  add_std_completion(out, seen, "toml", prefix)
  add_std_completion(out, seen, "uuid", prefix)
  add_std_completion(out, seen, "xml", prefix)
  add_std_completion(out, seen, "yaml", prefix)
  add_std_completion(out, seen, "zip", prefix)
  add_std_completion(out, seen, "color", prefix)
  add_snippet_completion(out, seen, "fn", "bare function declaration", "${1:name}(${2:arg}: ${3:any}): ${4:any}\n    ${0}\nend", prefix, "s_fn")
  add_snippet_completion(out, seen, "if", "if expression/statement", "if ${1:cond}\n    ${0}\nend", prefix, "s_if")
  add_snippet_completion(out, seen, "match", "match expression", "match ${1:value}\n    case ${2:pattern}\n        ${0}\nend", prefix, "s_match")
  add_snippet_completion(out, seen, "enum", "enum declaration", "enum ${1:Name}\n    ${2:Variant}\nend", prefix, "s_enum")
  add_snippet_completion(out, seen, "concept", "concept declaration", "concept ${1:Name}\n    ${2:method}(${3:arg}: ${4:any}): ${5:any}\nend", prefix, "s_concept")
  add_snippet_completion(out, seen, "@inline", "inline function", "@inline", prefix, "d_inline")
  add_snippet_completion(out, seen, "@hot", "hot function (optimize)", "@hot", prefix, "d_hot")
  add_snippet_completion(out, seen, "@cold", "cold function", "@cold", prefix, "d_cold")
  add_snippet_completion(out, seen, "@raw", "raw native ABI (no wrapper)", "@raw", prefix, "d_raw")
  add_snippet_completion(out, seen, "@packed", "packed struct layout", "@packed", prefix, "d_packed")
  add_snippet_completion(out, seen, "@derive", "derive trait impl", "@derive(${1:Display, Eq})", prefix, "d_derive")
  add_snippet_completion(out, seen, "@ffi", "FFI declaration", "@ffi(\"${1:name}\")", prefix, "d_ffi")
  add_snippet_completion(out, seen, "@export", "export with C ABI", "@export(\"${1:name}\")", prefix, "d_export")
  add_snippet_completion(out, seen, "@comp.c.include", "include C header", "@comp.c.include(\"${1:header.h}\")", prefix, "d_c_include")
  add_snippet_completion(out, seen, "@comp.c.emit", "emit raw C code", "@comp.c.emit(\"${1:code}\")", prefix, "d_c_emit")
  add_snippet_completion(out, seen, "@comp.c.export", "export to C", "@comp.c.export(\"${1:name}\")", prefix, "d_c_export")
  add_snippet_completion(out, seen, "@comp.c.import", "import C declarations", "@comp.c.import(\"${1:header.h}\")", prefix, "d_c_import")
  add_snippet_completion(out, seen, "@device", "target device", "@device(${1:.auto})", prefix, "d_device")
  add_snippet_completion(out, seen, "@autodiff", "automatic differentiation", "@autodiff", prefix, "d_autodiff")
  add_snippet_completion(out, seen, "@(", "compile-time eval", "@(${1:expr})", prefix, "d_comptime")
  add_snippet_completion(out, seen, "struct", "struct definition", "${1:Name} = struct\n    ${2:x}: ${3:i64}\nend", prefix, "s_struct")

# ── range helpers ────────────────────────────────────────────────────────────
mk_pos: any = (line, ch)
  p = {}
  p.line = line
  p.character = ch
  p
mk_range: any = (sl, sc, ec)
  r = {}
  r.start = mk_pos(sl, sc)
  r["end"] = mk_pos(sl, ec)
  r

# ── LSP handlers ─────────────────────────────────────────────────────────────

handle_initialize: any = params
if params != nil and params.rootUri != nil
  io.lsp.root_uri = params.rootUri
scan_workspace()
caps = {}
caps.textDocumentSync = 2
caps.documentSymbolProvider = true
caps.hoverProvider = true
caps.definitionProvider = true
caps.referencesProvider = true
caps.renameProvider = true
caps.foldingRangeProvider = true
caps.documentHighlightProvider = true
caps.workspaceSymbolProvider = true
cp = {}
cp.resolveProvider = false
triggers = {}
triggers[triggers:len() + 1] = "."
triggers[triggers:len() + 1] = ":"
triggers[triggers:len() + 1] = "("
cp.triggerCharacters = triggers
caps.completionProvider = cp
# §0g. The legend is the GENERATED taxonomy above, handed to the
# client verbatim: a client that renders a role this server never emits is
# reading the law's list, not a list this file invented.
lg = {}
lg.tokenTypes = io.lsp.legend
lg.tokenModifiers = io.lsp.mods
st = {}
st.legend = lg
st.full = true
caps.semanticTokensProvider = st
caps.inlayHintProvider = true
clp = {}
clp.resolveProvider = false
caps.codeLensProvider = clp
info = {}
info.name = "idol-lsp"
info.version = "0.3.0"
r = {}
r.capabilities = caps
r.serverInfo = info
r

handle_did_open: void = params
td = params.textDocument
if td == nil
  return
uri = td.uri
if not (ends_with(uri, ".id") or ends_with(uri, ".lua"))
  return
d = doc_for(uri)
d.text = td.text
if d.text == nil
  d.text = ""
d.version = td.version
if d.version == nil
  d.version = 0
invalidate(d)
# update workspace index
io.lsp.ws._texts[uri] = d.text
ensure_lo(d)
ws_index_add(io.lsp.ws, uri, d.text)
schedule_check(uri)

handle_did_change: void = params
td = params.textDocument
if td == nil
  return
uri = td.uri
d = io.lsp.docs[uri]
if d == nil
  d = doc_for(uri)
new_version = td.version
if new_version == nil
  new_version = d.version + 1
d.version = new_version
d.text = apply_changes(d.text, params.contentChanges)
invalidate(d)
# update workspace index
io.lsp.ws._texts[uri] = d.text
ensure_lo(d)
ws_index_add(io.lsp.ws, uri, d.text)
schedule_check(uri)

handle_did_close: void = params
td = params.textDocument
if td == nil
  return
uri = td.uri
d = io.lsp.docs[uri]
if d != nil and d.tmp != nil
  os.remove(d.tmp)
io.lsp.docs = forget(io.lsp.docs, uri)
ws_index_remove(io.lsp.ws, uri)
io.lsp.ws._texts = forget(io.lsp.ws._texts, uri)
send_diagnostics(uri, {})

handle_did_save: void = params
td = params.textDocument
if td == nil
  return
uri = td.uri
if io.lsp.docs[uri] != nil
  d = io.lsp.docs[uri]
  if params.text != nil
    d.text = params.text
    invalidate(d)
    io.lsp.ws._texts[uri] = d.text
    ensure_lo(d)
    ws_index_add(io.lsp.ws, uri, d.text)
  run_check(uri)
  d.last_t = now_secs()
  d.dirty = false

# A range that can cross lines. `mk_range` is single-line by construction, and
# LSP requires a DocumentSymbol's range to CONTAIN its children's — a parent
# whose range stops at its own declaration line makes every client drop the
# nesting and render the flat list back.
mk_wide: any = (sl, sc, el, ec)
  r = {}
  r.start = mk_pos(sl, sc)
  r["end"] = mk_pos(el, ec)
  r

# §0g: "document symbols ARE the trie." This returned a FLAT list with a
# `containerName` string on each entry, which is a hint to the client rather
# than a structure — the client is free to ignore it and every one of them
# renders it as a sibling list.
#
# The trie is built from INDENTATION, which is the offside layout §0.7 already
# makes normative, so no new information is needed and none is invented: a
# symbol indented past the one above it is BELOW it. Column, not `container`:
# the scanner makes the FIRST top-level declaration the container of every
# later one (measured — in a flat file `total` comes back containered by
# `scale`), so nesting on `container` would produce one root and a single
# chain, which looks like a trie and is not one.
handle_document_symbol: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return {}
ensure_syms(d)
syms = d.syms
out = {}
# Parallel stacks: the open ancestors and the column each was declared at.
open = {}
cols = {}
n = syms:len()
i = 1
while i <= n
  s = syms[i]
  o = {}
  o.name = s.name
  o.kind = s.kind
  o.range = mk_wide(s.line, s.col, s.line, s.endCol)
  o.selectionRange = mk_range(s.line, s.col, s.col + s.name:len())
  o.children = {}
  if s.detail != nil and s.detail != ""
    o.detail = s.detail
  # Close every ancestor this symbol is not inside, extending each closed
  # ancestor's range to the line before this one. A parent whose range never
  # grew would not contain the children it just adopted.
  while cols:len() > 0 and s.col <= cols[cols:len()]
    top = open[open:len()]
    top.range["end"] = mk_pos(s.line - 1, 0)
    open[open:len()] = nil
    cols[cols:len()] = nil
  if open:len() > 0
    parent = open[open:len()]
    parent.children[parent.children:len() + 1] = o
  else
    out[out:len() + 1] = o
  open[open:len() + 1] = o
  cols[cols:len() + 1] = s.col
  i = i + 1
# Whatever is still open runs to the end of the document.
ensure_lo(d)
last = d.lo:len()
while open:len() > 0
  top = open[open:len()]
  top.range["end"] = mk_pos(last, 0)
  open[open:len()] = nil
out

# ── foreign descriptor hover (SIM via @comp.c.import) ─────────────
uri_to_path: str = uri
if starts_with(uri, "file://")
  return uri:sub(8)
uri

dirname: str = path
d = path:match("^(.*)/[^/]+$")
if d != nil
  return d
"."

run_duo_capture: str = args
bin = io.lsp.id_bin
if bin == nil
  return ""
cmd = shell_quote(bin) .. " " .. args .. " 2>/dev/null"
p = io.popen(cmd, "r")
if p == nil
  return ""
out = p:read("*a")
p:close()
out

find_c_import_headers: any = text
headers = {}
for header in text:gmatch("@c%.import%(\"([^\"]+)\"%)")
  headers[headers:len() + 1] = header
for header in text:gmatch("@c%.import%('([^']+)'%)")
  headers[headers:len() + 1] = header
headers

foreign_entity_in_doc: any = (text, uri, symbol)
  path = uri_to_path(uri)
  base = dirname(path)
  headers = find_c_import_headers(text)
  i = 1
  while i <= headers:len()
    header = headers[i]
    resolved = header
    if header:sub(1, 1) != "/"
      resolved = base .. "/" .. header
    out = run_duo_capture("sim --import-c " .. resolved)
    if out != ""
      snap = io.lsp.json.decode(out)
      if snap != nil and snap.entities != nil
        j = 1
        while j <= snap.entities:len()
          ent = snap.entities[j]
          if ent != nil and ent.name == symbol
            ent._resolved_header = resolved
            return ent
          j = j + 1
    i = i + 1
  nil

format_foreign_hover: str = ent
lines = {}
lines[lines:len() + 1] = "**foreign " .. (ent.kind or "entity") .. "** `" .. ent.name .. "`"
if ent.origin != nil
  lines[lines:len() + 1] = ""
  lines[lines:len() + 1] = "- **origin:** " .. (ent.origin.language or "?") .. " · `" .. (ent.origin.artifact or "?") .. "`"
if ent._resolved_header != nil
  lines[lines:len() + 1] = "- **header:** `" .. ent._resolved_header .. "`"
if ent.storage_class != nil
  lines[lines:len() + 1] = "- **storage:** " .. ent.storage_class
if ent.size_bytes != nil
  sz = tostring(ent.size_bytes)
  al = ent.align_bytes
  if al != nil
    lines[lines:len() + 1] = "- **layout:** " .. sz .. " bytes, align " .. tostring(al)
  else
    lines[lines:len() + 1] = "- **layout:** " .. sz .. " bytes"
if ent.fields != nil and ent.fields:len() > 0
  lines[lines:len() + 1] = ""
  lines[lines:len() + 1] = "**fields**"
  fi = 1
  while fi <= ent.fields:len()
    f = ent.fields[fi]
    off = ""
    if f.offset != nil
      off = " @+" .. tostring(f.offset)
    lines[lines:len() + 1] = "- `" .. f.name .. "`: " .. f.type .. off
    fi = fi + 1
if ent.params != nil and ent.params:len() > 0
  lines[lines:len() + 1] = ""
  lines[lines:len() + 1] = "**params**"
  pi = 1
  while pi <= ent.params:len()
    p = ent.params[pi]
    lines[lines:len() + 1] = "- `" .. p.name .. "`: " .. p.type
    pi = pi + 1
if ent.return_type != nil
  lines[lines:len() + 1] = "- **returns:** " .. ent.return_type
if ent.abi != nil
  lines[lines:len() + 1] = ""
  lines[lines:len() + 1] = "**ABI:** " .. (ent.abi.calling_convention or "?") .. ", pass-by " .. (ent.abi.pass_by or "?")
if ent.contract != nil
  lines[lines:len() + 1] = ""
  lines[lines:len() + 1] = "_semantic: " .. (ent.contract.semantic_completeness or "?") .. " · abi: " .. (ent.contract.abi_completeness or "?") .. " · layout: " .. (ent.contract.layout_completeness or "?") .. "_"
lines:concat("\n")

# ── graph service client ──────────────────────────────────────────────────────
#
# `idol graph <file>` IS the query surface a front-end asks to project.
# Per node it emits the kind the COMPILER assigned, the declaration line/col,
# a content-addressed `stable_id`, and for calls the callee kind, arity,
# specializability and the knowledge/stage lattice position. None of
# that is recoverable by scanning text, and the scanner's answers were wrong
# where they overlapped: measured on `lib/compiler/graph.id`, hover over
# `_has` (a `func` in the graph) reported "_variable_", and hover over a call
# site or a local returned nil because the scanner only indexes declarations.
#
# Coordinates: the graph is 1-based in line AND col; LSP positions are 0-based
# in both.
graph_bare_name: str = n
if n == nil
  return ""
p = find_from(n, "::", 1)
if p != 0
  return n:sub(p + 2)
n
graph_owner_name: str = n
if n == nil
  return ""
p = find_from(n, "::", 1)
if p == 0
  return ""
n:sub(1, p - 1)
# One spawn per document version, cached on the doc. A negative result is
# cached too, so a file the compiler cannot parse does not spawn a process on
# every keystroke.
graph_for: any = uri
d = io.lsp.docs[uri]
if d == nil
  return nil
if d.graph_version == d.version
  return d.graph
d.graph = nil
d.graph_version = d.version
if io.lsp.id_bin == nil
  return nil
path = doc_tmp_write(d, uri)
if path == nil
  return nil
out = run_duo_capture("graph " .. shell_quote(path))
# A parse failure prints diagnostics, not JSON. Decide on the first byte
# rather than handing the decoder something it will answer nil to anyway.
if out:sub(1, 1) != "{"
  return nil
g = io.lsp.json.decode(out)
if g == nil or g.nodes == nil
  return nil
d.graph = g
g
# The identifier under the cursor, with its bounds. Deliberately NOT
# `word_at_lo`: that one treats `.`, `@` and `$` as word bytes, so on
# `agent.discover()` it answers the whole dotted path, and starting it on a
# non-word byte makes it span the punctuation into the next token. The graph is
# keyed by bare names, so bare names are what the cursor must resolve to.
ident_span_lo: any = (text, lo, line, col)
  ln = get_line_lo(text, lo, line)
  if ln == nil
    return nil
  n = ln:len()
  if col < 0
    col = 0
  if col >= n
    col = n - 1
  if col < 0 or not is_ident_char(ln:byte(col + 1))
    return nil
  start = col
  while start > 0 and is_ident_char(ln:byte(start))
    start = start - 1
  stop = col
  while stop + 1 < n and is_ident_char(ln:byte(stop + 2))
    stop = stop + 1
  sp = {}
  sp.name = ln:sub(start + 1, stop + 1)
  sp.start = start
  sp.stop = stop + 1
  sp
# The node the cursor is inside, else the nearest node on the line carrying
# that name.
#
# MEASURED: a `call` node's col is NOT the callee's first byte. On
# `lib/compiler/graph.id:78` (`acc = _add(acc, t.text)`) the graph puts
# `_add` at col 27, which is the `(`; on `:61` the method call `byte` lands on
# the `:` at col 23. So containment can only decide a declaration, and the
# caller must take the hover RANGE from the cursor's own token, never from
# `node.col`.
graph_node_here: any = (g, name, line, col)
  nodes = g.nodes
  best = nil
  bestd = 0
  n = nodes:len()
  i = 1
  while i <= n
    e = nodes[i]
    if e.line == line + 1 and graph_bare_name(e.name) == name
      sc = e.col - 1
      if col >= sc and col < sc + name:len()
        return e
      dist = sc - col
      if dist < 0
        dist = col - sc
      if best == nil or dist < bestd
        best = e
        bestd = dist
    i = i + 1
  best
# Where the compiler says the name is DECLARED, anywhere in the module.
graph_def_node: any = (g, name)
  nodes = g.nodes
  n = nodes:len()
  i = 1
  while i <= n
    e = nodes[i]
    k = e.kind
    if k == "func" or k == "local" or k == "table_shape" or k == "enum_shape"
      if graph_bare_name(e.name) == name
        return e
    i = i + 1
  nil
graph_add_line: void = (lines, s)
  lines[lines:len() + 1] = s
format_graph_hover: str = (node, def, sig)
  lines = {}
  if sig != ""
    graph_add_line(lines, "```duo")
    graph_add_line(lines, sig)
    graph_add_line(lines, "```")
  graph_add_line(lines, "_" .. tostring(node.kind) .. "_ **" .. graph_bare_name(node.name) .. "**")
  owner = graph_owner_name(node.name)
  if owner != ""
    graph_add_line(lines, "- **in:** `" .. owner .. "`")
  if node.callee_kind != nil
    graph_add_line(lines, "- **callee:** " .. tostring(node.callee_kind) .. " · **arity:** " .. tostring(node.arg_count))
  if node.specializable != nil
    spec = "no"
    if node.specializable
      spec = "yes"
    graph_add_line(lines, "- **specializable:** " .. spec)
  if node.knowledge != nil
    graph_add_line(lines, "- **knowledge:** " .. tostring(node.knowledge) .. " · **stage:** " .. tostring(node.stage))
  if def != nil and def != node and def.line != nil and def.line > 0
    graph_add_line(lines, "- **declared:** " .. tostring(def.kind) .. " at line " .. tostring(def.line))
  # `stable_id` is deliberately NOT shown. It hashes the module PATH, and an
  # unsaved buffer is queried through a temp file, so the value shown would
  # differ from the one the same symbol has on disk. A durable-looking hash
  # that is not durable is worse than no hash.
  graph_add_line(lines, "")
  graph_add_line(lines, "_from `duo graph` — the compiler's own semantic graph_")
  lines:concat("\n")

handle_hover: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return nil
ensure_lo(d)
line = params.position.line
col = params.position.character
span = ident_span_lo(d.text, d.lo, line, col)

if span != nil
  # Foreign descriptors keep answering from the SIM snapshot: they are
  # C entities, so the Idol semantic graph has nothing to say about them.
  foreign = foreign_entity_in_doc(d.text, uri, span.name)
  if foreign != nil
    c = {}
    c.kind = "markdown"
    c.value = format_foreign_hover(foreign) .. why_lines(d.text, line, col)
    r = {}
    r.contents = c
    r.range = mk_range(line, span.start, span.stop)
    return r

g = graph_for(uri)
if g != nil
  node = graph_node_here(g, span.name, line, col)
  if node != nil
    sig = ""
    ln = get_line_lo(d.text, d.lo, node.line - 1)
    if ln != nil
      sig = trim(ln)
    c = {}
    c.kind = "markdown"
    c.value = format_graph_hover(node, graph_def_node(g, span.name), sig) .. why_lines(d.text, line, col)
    r = {}
    r.contents = c
    r.range = mk_range(line, span.start, span.stop)
    return r

# Residue, not a parallel implementation: MEASURED, `duo graph` lifts no
# node for a top-level module binding # `x: i64 = 1` in a 5-line file yields
# module/func/param/call nodes and nothing for `x`. Until the lift covers
# them, dropping the scanner here would delete hover for every module-level
# constant. It answers only what the graph did not.
ensure_syms(d)
s = symbol_at(d.syms, line, col)
if s == nil
  return nil
ln = get_line_lo(d.text, d.lo, s.line)
sig = ""
if ln != nil
  sig = trim(ln)
c = {}
c.kind = "markdown"
c.value = "```duo\n" .. sig .. "\n```\n_" .. kind_label(s.kind) .. "_ **" .. s.name .. "**"
if s.container != nil and s.container != ""
  c.value = c.value .. "  (in " .. s.container .. ")"
c.value = c.value .. "\n\n_not lifted into the semantic graph; scanned from text_"
c.value = c.value .. why_lines(d.text, line, col)
r = {}
r.contents = c
r.range = mk_range(s.line, s.col, s.col + s.name:len())
r

handle_definition: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return nil
ensure_syms(d)
s = symbol_at(d.syms, params.position.line, params.position.character)
if s == nil
  return nil
r = {}
r.uri = uri
r.range = mk_range(s.line, s.col, s.col + s.name:len())
r

handle_references: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return {}
ensure_syms(d)
s = symbol_at(d.syms, params.position.line, params.position.character)
if s == nil
  return {}
refs = find_refs_in_text(d.text, d.lo, s.name, uri)
# also search open workspace files
for wuri, wd in io.lsp.docs
  if wuri != uri and wd != nil
    ensure_lo(wd)
    r = find_refs_in_text(wd.text, wd.lo, s.name, wuri)
    j = 1
    while j <= r:len()
      refs[refs:len() + 1] = r[j]
      j = j + 1
out = {}
i = 1
while i <= refs:len()
  rr = {}
  rr.uri = refs[i].uri
  rr.range = mk_range(refs[i].line, refs[i].col, refs[i].endCol)
  out[out:len() + 1] = rr
  i = i + 1
out

handle_rename: any = params
uri = params.textDocument.uri
new_name = params.newName
if new_name == nil or new_name == ""
  return nil
d = io.lsp.docs[uri]
if d == nil
  return nil
ensure_syms(d)
s = symbol_at(d.syms, params.position.line, params.position.character)
if s == nil
  return nil
old_name = s.name
# collect edits from current doc
edits = find_rename_edits_in_text(d.text, d.lo, old_name, new_name, uri)
# collect edits from open workspace docs
for wuri, wd in io.lsp.docs
  if wuri != uri and wd != nil
    ensure_lo(wd)
    r = find_rename_edits_in_text(wd.text, wd.lo, old_name, new_name, wuri)
    j = 1
    while j <= r:len()
      edits[edits:len() + 1] = r[j]
      j = j + 1
# build WorkspaceEdit
changes = {}
i = 1
while i <= edits:len()
  e = edits[i]
  if changes[e.uri] == nil
    changes[e.uri] = {}
  te = {}
  te.range = mk_range(e.line, e.col, e.endCol)
  te.newText = e.newName
  changes[e.uri][changes[e.uri]:len() + 1] = te
  i = i + 1
we = {}
we.changes = changes
we

handle_folding_range: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return {}
ensure_lo(d)
compute_folding_ranges(d.text, d.lo)

handle_document_highlight: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return {}
ensure_syms(d)
ensure_lo(d)
find_doc_highlights(d.text, d.lo, d.syms, params.position.line, params.position.character)

handle_workspace_symbol: any = params
query = params.query
if query == nil
  query = ""
ws_search_symbols(io.lsp.ws, query)

handle_completion: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return {}
ensure_lo(d)
ensure_syms(d)
line = params.position.line
col = params.position.character
prefix = word_prefix_lo(d.text, d.lo, line, col)
out = {}
seen = {}
n = d.syms:len()
i = 1
while i <= n
  s = d.syms[i]
  if completion_matches(s.name, prefix)
    add_completion(out, seen, s.name, completion_kind_for_symbol(s.kind), kind_label(s.kind), nil, "z_" .. s.name)
  i = i + 1
# add workspace symbols not already in local scope
for uri2, syms2 in io.lsp.ws.entries
  if uri2 != uri
    j = 1
    while syms2 != nil and j <= syms2:len()
      s2 = syms2[j]
      is_public = s2.name:sub(1, 1) != "_"
      if is_public and completion_matches(s2.name, prefix)
        detail = kind_label(s2.kind)
        if s2.container != nil and s2.container != ""
          detail = detail .. " (in " .. s2.container .. ")"
        add_completion(out, seen, s2.name, completion_kind_for_symbol(s2.kind), detail, nil, "z_" .. s2.name)
      j = j + 1
add_static_completions(out, seen, prefix)
out

# ── roles: the G-TOTAL projection (§0g) ─────────────────────────────
#
# CLAUDE.md §0g gates every rendered artifact and front-end on role coverage
# of 100% of non-whitespace bytes and ZERO unresolved-ambiguity spans, and
# §0d H-6 makes the role function TOTAL. This section is the LSP's half.
#
# The legend above is GENERATED from `docs/spec/roles.md` and nothing here may
# add to it: a role this scanner cannot find a citation for is not emitted at
# all. Where two roles are live and no cited rule separates them the span is
# `ambiguous` and NO token is sent — "two candidates is a MIXED-SPACE
# DIAGNOSTIC, never a guess", and a fallback role would be the guess wearing a
# different hat.
#
# STATED PLAINLY: this is a SECOND lexical implementation of the discriminations
# in `docs/spec/roles.md` §5, beside `scripts/role_scan.id`. Two front ends
# deciding the same question independently is exactly the H-1 drift §0d warns
# about, and the honest reason it exists is that the one graph service §0f
# rules for does not answer role queries yet — `duo graph` lifts nodes and no
# roles at all (measured). What keeps the two honest is the golden corpus:
# `zig build lsp-gate` runs THIS scanner over `fixtures/highlight/*.id` and
# convicts it against the hand-written `.roles.id` sidecars, span for span.
# When the graph service answers roles, delete this and ask it. # gap[071]
#
# THERE IS NOW A THIRD. `tools/lsp/src/highlight.id` landed the same day with
# an 18-member closed set, different member names, and the copula/invoke split
# decided by SPACING rather than by grammar.md R1 — which answers `count:u32`
# the other way. This scanner follows roles.md §5.1 and R1. Read
# gaps/GAP-078.md before reconciling them; the conflict is a RULING that is
# owed, not a bug in either. # gap[078]

roleid: i64 = (name: any)
  i = 1
  while i <= io.lsp.legend:len()
    if io.lsp.legend[i] == name
      return i - 1
    i = i + 1 - 1

digit: bool = (b: any)
  b >= 48 and b <= 57
namestart: bool = (b: any)
  b >= 97 and b <= 122 or b >= 65 and b <= 90 or b == 95
namebyte: bool = (b: any)
  namestart(b) or digit(b)
# grammar.md level 1: `.name`, `:name(…)`, `[…]`, `(…)`, `@rel` and the
# brace/string calls all require a left operand. That requirement is what
# separates an application group from a grouping paren, and R5 makes it the
# decider for `@` as well.
operandend: bool = (b: any)
  namebyte(b) or b == 41 or b == 93 or b == 125 or b == 34 or b == 39
# grammar.md §3's closed terminal set. `end` is in it because §1 lists it as a
# token the reader accepts and deletes; a highlighter still has to colour it.
keyword: bool = (w: any)
  w == "if" or w == "else" or w == "elseif" or w == "while" or w == "for" or w == "in" or w == "break" or w == "continue" or w == "check" or w == "and" or w == "or" or w == "not" or w == "end" or w == "return" or w == "then" or w == "do"

push_span: void = (out, line, col, wide, role, card)
  s = {}
  s.line = line
  s.col = col
  s.wide = wide
  s.role = role
  # The CARD is §0d's ruling made operational: a split that changes hue is a
  # ROLE, a split within one hue is a CARD. `=` `+=` `==` all sit in the red
  # law space, so they are one role wearing three cards, and the card is what
  # gives the token a statement MORE SPECIFIC than its lexical class — the
  # SPECIFICITY bar the ruling sets and coverage alone does not clear.
  s.card = card
  out[out:len() + 1] = s

# One line, left to right. `line` is 0-based (LSP); `col` in the emitted span
# is 0-based too. Every non-whitespace byte leaves with exactly one span —
# byte totality is control 2 of the gate, and it is what makes the coverage
# denominator mean anything.
scan_line: i64 = (ln, line, out)
  n = ln:len()
  i = 1
  amb = 0
  shape = false
  stack = {}
  while i <= n
    b = ln:byte(i)
    if b == 32 or b == 9 or b == 13
      i = i + 1
    else(b == 45 and i < n and ln:byte(i + 1) == 45)
      push_span(out, line, i - 1, n - i + 1, "comment", "line")
      i = n + 1
    else(b == 34 or b == 39)
      j = i + 1
      while j <= n and ln:byte(j) != b
        if ln:byte(j) == 92
          j = j + 1
        j = j + 1
      if j > n
        j = n
      push_span(out, line, i - 1, j - i + 1, "literal", "quoted")
      i = j + 1
    else(digit(b))
      j = i
      while j <= n and (digit(ln:byte(j)) or ln:byte(j) == 46)
        j = j + 1
      push_span(out, line, i - 1, j - i, "number", "literal")
      i = j
      shape = false
    else(namestart(b))
      j = i
      while j <= n and namebyte(ln:byte(j))
        j = j + 1
      w = ln:sub(i, j - 1)
      # §0d RULING: the eighteenth role is `place` — the ordinary binding.
      # GAP-073 was right that this was the largest hole; H-4's blue names
      # "numbers, .cases, literals, registers" and a plain name is none of
      # them, while H-6 says the function is TOTAL. Naming it is what lets
      # coverage reach 100% instead of 20%.
      role = "place"
      card = "bound"
      if keyword(w)
        role = "keyword"
        card = "clause"
      else(shape)
        role = "descriptor"
        card = "shape"
      else(j <= n and ln:byte(j) == 40)
        # roles.md §5.4: a bare call head is a purple world action, an orange
        # constructor, or a callable-as-value, spelled identically. The Pass
        # 118 SPECIFICITY finding in its purest form.
        role = "ambiguous"
        card = "callable|descriptor"
        amb = amb + 1
      push_span(out, line, i - 1, j - i, role, card)
      # A descriptor stays in shape position only while `|`/`&` keep joining
      # operands to it (grammar.md `shape → postfixexpr {("|"|"&") postfixexpr}`).
      if role == "descriptor"
        k = j
        while k <= n and (ln:byte(k) == 32 or ln:byte(k) == 9)
          k = k + 1
        shape = k <= n and (ln:byte(k) == 124 or ln:byte(k) == 38)
      i = j
    else(b == 58)
      # roles.md §5.1. The decider is grammar.md R1 — IS never takes an
      # argument group, INVOKE always does — NOT the spacing. `count:u32` is
      # tight and groupless, so it is a copula, and a front end that paints
      # it purple has failed H-1.
      k = i + 1
      if k <= n and namestart(ln:byte(k))
        m = k
        while m <= n and namebyte(ln:byte(m))
          m = m + 1
        opens = m <= n and (ln:byte(m) == 40 or ln:byte(m) == 123 or ln:byte(m) == 34)
        if opens
          push_span(out, line, i - 1, 1, "invoke", "tight")
          push_span(out, line, k - 1, m - k, "callable", "invoked")
          shape = false
        else
          push_span(out, line, i - 1, 1, "copula", "ascribe")
          push_span(out, line, k - 1, m - k, "descriptor", "shape")
          p = m
          while p <= n and (ln:byte(p) == 32 or ln:byte(p) == 9)
            p = p + 1
          shape = p <= n and (ln:byte(p) == 124 or ln:byte(p) == 38)
        i = m
      else
        push_span(out, line, i - 1, 1, "copula")
        shape = true
        i = i + 1
    else(b == 61)
      if i < n and ln:byte(i + 1) == 61
        push_span(out, line, i - 1, 2, "operator", "relation")
        i = i + 2
      else
        push_span(out, line, i - 1, 1, "operator", "bind")
        i = i + 1
      shape = false
    else((b == 43 or b == 45 or b == 42 or b == 47 or b == 37) and i < n and ln:byte(i + 1) == 61)
      push_span(out, line, i - 1, 2, "operator", "update")
      i = i + 2
      shape = false
    else(b == 64)
      # R5: postfix `X@rel` needs a left operand, bare `@` is a primary. Both
      # are orange and H-4 splits them no further, so both are `anchor` and
      # the form goes in the why-chain.
      push_span(out, line, i - 1, 1, "anchor", "dyad")
      i = i + 1
    else(b == 46)
      j = i + 1
      while j <= n and namebyte(ln:byte(j))
        j = j + 1
      if j == i + 1
        push_span(out, line, i - 1, 1, "operator", "dot")
      else(i > 1 and operandend(ln:byte(i - 1)))
        push_span(out, line, i - 1, j - i, "walk", "read")
      else
        # roles.md §5.5: leading `.name` is semantic by R2 — argument position
        # is a lens, descriptor-expected position is the case, neither is a
        # diagnostic. The parser makes ONE node and resolution is semantic.
        push_span(out, line, i - 1, j - i, "ambiguous", "case|walk")
        amb = amb + 1
      i = j
    else(b == 124)
      if shape
        push_span(out, line, i - 1, 1, "union", "shape")
      else
        # roles.md §5.2: outside shape position `pipe` and `bor` are separated
        # by OPERAND SPACE, which is a graph question. Two candidates.
        push_span(out, line, i - 1, 1, "ambiguous", "union|pipe")
        amb = amb + 1
      i = i + 1
    else(b == 40)
      app = i > 1 and operandend(ln:byte(i - 1))
      stack[stack:len() + 1] = app
      if app
        # §0d RULING: level parens and parameter parens are a split WITHIN one
        # hue, so they are two CARDS of one role, not two roles. The role is
        # decided; only the card is open, and a card that cannot be decided is
        # a SPECIFICITY finding rather than a mixed-space diagnostic.
        push_span(out, line, i - 1, 1, "layout", "level|param")
      else
        push_span(out, line, i - 1, 1, "layout", "group")
      i = i + 1
    else(b == 41)
      app = false
      if stack:len() > 0
        app = stack[stack:len()]
        stack[stack:len()] = nil
      if app
        push_span(out, line, i - 1, 1, "layout", "level|param")
      else
        push_span(out, line, i - 1, 1, "layout", "group")
      i = i + 1
    else(b == 123 or b == 125)
      push_span(out, line, i - 1, 1, "layout", "brace")
      i = i + 1
    else(b == 91 or b == 93)
      push_span(out, line, i - 1, 1, "layout", "bracket")
      i = i + 1
    else(b == 44)
      push_span(out, line, i - 1, 1, "layout", "stratify")
      i = i + 1
      shape = false
    else
      push_span(out, line, i - 1, 1, "operator", "infix")
      i = i + 1
  amb

# The whole document. `bytes` counts non-whitespace bytes independently of the
# scanner, so `covered + unhued + ambiguous` disagreeing with it is a byte the
# scanner dropped, and the gate says so rather than moving the percentage.
scan: any = text
out = {}
amb = 0
bytes = 0
n = text:len()
i = 1
line = 0
start = 1
while i <= n + 1
  b = 0
  if i <= n
    b = text:byte(i)
  if i > n or b == 10
    lntext = text:sub(start, i - 1)
    was = out:len()
    amb = amb + scan_line(lntext, line, out)
    # BYTE TOTALITY. A span's WIDTH is its extent on the line; the bytes it
    # can be credited for are the NON-WHITESPACE ones inside it. A comment
    # span covers `-- copula`, nine bytes wide and eight of them solid, and
    # crediting nine against a denominator of eight is how a coverage number
    # reaches 102% — measured, before this line existed. The denominator is
    # counted independently below, so the two can only agree by being right.
    k = was + 1
    while k <= out:len()
      sp = out[k]
      solid = 0
      q = sp.col + 1
      while q <= sp.col + sp.wide
        sb = lntext:byte(q)
        if sb != nil and sb != 32 and sb != 9 and sb != 13
          solid = solid + 1
        q = q + 1
      sp.solid = solid
      k = k + 1
    line = line + 1
    start = i + 1
  else(b != 32 and b != 9 and b != 13)
    bytes = bytes + 1
  i = i + 1
hits = 0
told = 0
vague = 0
seen = 0
j = 1
while j <= out:len()
  s = out[j]
  seen = seen + s.solid
  rid = roleid(s.role)
  if rid >= 0 and rid < io.lsp.closed
    hits = hits + s.solid
    # PROVENANCE, the third G-TOTAL number (§0g): a role counts only when it
    # carries a rule citation. `cite` has no default arm, so a role with no
    # rule behind it answers "" and is counted as UNCITED rather than
    # silently credited.
    if cite(s.role) != ""
      told = told + s.solid
  # A card that cannot decide between two refinements of one role is the
  # SPECIFICITY finding. It is NOT role ambiguity — the hue is
  # settled — so it is counted on its own line and never folded in.
  if contains_char(s.card, "|")
    vague = vague + 1
  j = j + 1
r = {}
r.spans = out
r.ambiguity = amb
r.bytes = bytes
r.hits = hits
r.told = told
r.vague = vague
# Non-whitespace bytes NO span claimed. H-6 makes the role function TOTAL,
# so this is 0 or the scanner dropped a byte — and a dropped byte moves the
# percentage with nothing in the report to show for it.
r.naked = bytes - seen
r

# LSP semantic tokens are a flat delta encoding: five integers per token,
# (deltaLine, deltaStartChar, length, tokenType, tokenModifiers). Ambiguous
# spans contribute NO token — the client renders them unstyled, which is what
# a mixed-space diagnostic should look like, and the count of them reaches the
# user through the code lens rather than through a colour that pretends.
semantic_tokens: any = text
sc = scan(text)
data = {}
prev_line = 0
prev_col = 0
i = 1
while i <= sc.spans:len()
  s = sc.spans[i]
  rid = roleid(s.role)
  if rid >= 0
    dl = s.line - prev_line
    dc = s.col
    if dl == 0
      dc = s.col - prev_col
    # H-3/H-5: definition adds WEIGHT. A declaration is a name or callable
    # starting at column 0 — the only definition site this front end can
    # decide without the graph, and it declines everywhere else.
    # H-3/H-5: definition adds WEIGHT. Bit 0 of the generated modifier list
    # is `declaration`, which is the modifier `highlight.id` attaches to
    # exactly the roles whose row says `heavy`. A declaration this front end
    # can decide without the graph is a symbol at column 0; it declines
    # everywhere else rather than weighting a use.
    mods = 0
    if s.col == 0 and (s.role == "place" or s.role == "callable" or s.role == "descriptor" or s.role == "anchor")
      mods = 1
    data[data:len() + 1] = dl
    data[data:len() + 1] = dc
    data[data:len() + 1] = s.wide
    data[data:len() + 1] = rid
    data[data:len() + 1] = mods
    prev_line = s.line
    prev_col = s.col
  i = i + 1
r = {}
r.data = data
r

# ── why(span) IS the hover (H-7) ─────────────────────────────────────────────
#
# §0d H-7: "every (span, role) carries a rule citation + dnir correspondence;
# `why(span)` IS the LSP hover; provenance maps are bidirectional DATA." The
# hover below used to answer prose and stop. It now carries the role at the
# cursor and the rule that decided it, so the answer is checkable against the
# law rather than merely readable. It is still delivered inside LSP's
# `MarkupContent.value`, which is one string by protocol — that is an H-8
# OUTPUT TOTALITY finding this front end cannot repair alone, and the gate
# reports the count rather than hiding it.
roleat: any = (text: any, line: any, col: any)
  sc = scan(text)
  i = 1
  while i <= sc.spans:len()
    s = sc.spans[i]
    if s.line == line and col >= s.col and col < s.col + s.wide
      return s
    i = i + 1
  nil

# The citation each decider comes from. Absent a citation the role would not
# have been emitted, so there is no default arm and no "see the spec" filler.
cite: any = (role: any)
  if role == "copula"
    return "grammar.md R1 — IS never takes an argument group; §0d RULED that R1 decides and spacing only renders"
  if role == "invoke" or role == "callable"
    return "grammar.md R1 — INVOKE always takes an argument group; LAW-CALL §0.5 calls at the value"
  if role == "descriptor"
    return "grammar.md `shape → postfixexpr {(\"|\"|\"&\") postfixexpr}` — shape position; H-4 orange"
  if role == "union"
    return "H-1/H-4 — the union edge between descriptor operands, orange, and NOT the pipe"
  if role == "anchor"
    return "grammar.md R5 — the @ DYAD; no prefix-@ production exists, so the grammar cannot express a directive"
  if role == "walk"
    return "§4 — data access `a.b`, walk from the left operand; H-4 green"
  if role == "keyword"
    return "grammar.md §3 closed terminal set; H-4 red law space"
  if role == "number" or role == "literal"
    return "grammar.md §1 literal production; H-4 blue, value at rest"
  if role == "place"
    return "gaps/GAP-078.md RULING — an ordinary binding is a PLACE, blue, heavy at its definition"
  if role == "operator"
    return "§0g THE LAST SPLITS — `=` binds, `+=` updates, `==` relates; one red role, three cards"
  if role == "layout"
    return "§0g fine splits — level/param/grouping parens, braces, brackets and the stratifying comma; red, faint (H-6 inferable)"
  if role == "comment"
    return "grammar.md §1 `comment → \"--\" to end of line`; H-6 faint, fully inferable"
  if role == "case"
    return "§0.3 INFERRED CASES — a case of a case-set, read from descriptor-expected position; H-4 blue"
  if role == "world" or role == "foreign"
    return "H-5 — ambient and foreign are ITALIC; the trust boundary is typographic"
  if role == "pipe"
    return "§0i — channels are stream places composed by `|`; H-4 green, and NOT the union edge"
  if role == "ambiguous"
    return "G-TOTAL: two candidates in two HUES and no cited rule between them — MIXED-SPACE DIAGNOSTIC, never a guess (§0g)"
  # No default arm. A role with no rule behind it answers "" and `scan` counts
  # it as UNCITED, which moves the provenance number down where it belongs.
  ""

why_lines: str = (text, line, col)
  s = roleat(text, line, col)
  if s == nil
    return ""
  hued = "outside the closed set"
  rid = roleid(s.role)
  if rid >= 0 and rid < io.lsp.closed
    hued = "closed set"
  rule = cite(s.role)
  if rule == ""
    rule = "UNCITED — this role carries no rule, which is a provenance finding under G-TOTAL"
  "\n\n---\n\n`why(span)` · role **" .. s.role .. "** · card **" .. s.card .. "** (" .. hued .. ")" .. "\n\nrule: " .. rule .. "\n\nspan: line " .. tostring(s.line) .. ", col " .. tostring(s.col) .. ", " .. tostring(s.wide) .. " bytes"

handle_semantic_tokens: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  r = {}
  r.data = {}
  return r
semantic_tokens(d.text)

# ── inlay hints: the CDR-inferred descriptor (§0g, B-13) ────────────
#
# CDR says a DECLARED contract directs realization and a restated conversion
# erases. The hint is the other half: what the compiler inferred where the
# source declared nothing. It is not this server's inference — it is `duo
# sim`'s, the compiler's own semantic export, asked through the same temp file
# the graph client uses (§0f: one graph service, N front ends).
#
# sim-v0 answers in C spellings because that is its published vocabulary. The
# map back to idol descriptors is exhaustive over what sim emits today and
# DECLINES on anything else — an unmapped spelling produces no hint at all,
# because a hint that guesses a descriptor is worse than no hint.
descriptor: any = (c: any)
  if c == "int64_t"
    return "i64"
  if c == "double"
    return "f64"
  if c == "bool"
    return "bool"
  if c == "const char*" or c == "char*"
    return "str"
  if c == "void"
    return "void"
  nil

sim_for: any = uri
d = io.lsp.docs[uri]
if d == nil or io.lsp.id_bin == nil
  return nil
path = doc_tmp_write(d, uri)
if path == nil
  return nil
out = run_duo_capture("sim " .. shell_quote(path))
if out:sub(1, 1) != "{"
  return nil
s = io.lsp.json.decode(out)
if s == nil or s.entities == nil
  return nil
s

# A function's declaration line already carries a return descriptor when it
# ends `): T` or `)`-then-`:`; only when it does NOT is there anything to show.
states_return: bool = ln
p = find_last(ln, ")")
if p == 0
  return false
contains_char(ln:sub(p + 1), ":")

mk_hint: any = (line, col, label, kind, why)
  h = {}
  h.position = mk_pos(line, col)
  h.label = label
  h.kind = kind
  h.paddingLeft = false
  # H-7: every (span, role) carries a rule citation and a dnir
  # correspondence, and provenance maps are bidirectional DATA. The label is
  # what LSP renders; `data` is the tuple, and it travels with every hint.
  dt = {}
  dt.role = "descriptor"
  dt.why = why
  dt.dnir = "sim-v0 entity"
  h.data = dt
  h

handle_inlay_hint: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return {}
ensure_lo(d)
out = {}
s = sim_for(uri)
if s != nil
  i = 1
  while i <= s.entities:len()
    e = s.entities[i]
    if e.kind == "function" and e.return_type != nil
      want = descriptor(e.return_type)
      j = 0
      nl = d.lo:len()
      while want != nil and j < nl
        ln = get_line_lo(d.text, d.lo, j)
        if ln != nil and starts_with(trim(ln), e.name) and contains_char(ln, "(") and not states_return(ln)
          p = find_last(ln, ")")
          if p > 0
            out[out:len() + 1] = mk_hint(j, p, ": " .. want, 1, "B-13 CDR — the source declares no return contract; `duo sim` resolved it")
            j = nl
        j = j + 1
    i = i + 1
# Module bindings. `duo sim` lifts no entity for `total = 7` (measured — a
# five-line file yields the functions and nothing else), and a literal's
# descriptor is READ, not inferred: grammar.md §1 decides it from the
# literal's own production. Anything that is not a literal gets no hint.
ensure_syms(d)
k = 1
while k <= d.syms:len()
  sym = d.syms[k]
  ln = get_line_lo(d.text, d.lo, sym.line)
  if ln != nil and not contains_char(substring_before(ln, "="), ":")
    rhs = trim(substring_after(ln, "="))
    want = nil
    if rhs != "" and starts_with(rhs, "\"")
      want = "str"
    else(rhs != "" and digit(rhs:byte(1)))
      want = "i64"
      if contains_char(rhs, ".")
        want = "f64"
    else(rhs == "true" or rhs == "false")
      want = "bool"
    if want != nil
      out[out:len() + 1] = mk_hint(sym.line, sym.col + sym.name:len(), ": " .. want, 1, "B-13 CDR — no contract declared; the descriptor is the literal's own (grammar.md §1)")
  k = k + 1
out

# ── code lenses: lenses COUNT WITNESSES (§0g) ───────────────────────
#
# Stated so the number is not read as more than it is: the admission
# witnesses have NO SURFACE in this tree — `witness` is role 17 in
# docs/spec/roles.md §2 with the decider column empty, and `why` is undeclared
# (gap[064]). So what these lenses count is the evidence that DOES exist and
# is named on each lens: the G-TOTAL role census for the file, and the use
# sites for each top-level symbol. When admission witnesses gain a surface,
# they belong here beside these, not instead of them.
handle_code_lens: any = params
uri = params.textDocument.uri
d = io.lsp.docs[uri]
if d == nil
  return {}
ensure_lo(d)
ensure_syms(d)
out = {}
sc = scan(d.text)
pct = 0
if sc.bytes > 0
  pct = sc.hits * 100 / sc.bytes
prov = 0
if sc.hits > 0
  prov = sc.told * 100 / sc.hits
c = {}
# §0g gates THREE numbers, not two. Printing coverage alone is how a front
# end reports 100% while every role it emits is uncited.
c.title = "G-TOTAL — coverage " .. tostring(pct) .. "% (" .. tostring(sc.hits) .. "/" .. tostring(sc.bytes) .. " bytes) · ambiguity " .. tostring(sc.ambiguity) .. " · provenance " .. tostring(prov) .. "% · specificity findings " .. tostring(sc.vague) .. " · unclaimed bytes " .. tostring(sc.naked)
c.command = ""
l = {}
l.range = mk_range(0, 0, 0)
l.command = c
dt = {}
dt.role = "witness"
dt.why = "CLAUDE.md §0g G-TOTAL: coverage 100%, ambiguity 0, provenance 100% — three gated numbers, and a specificity finding is a card that cannot beat its lexical class"
dt.dnir = "role-scan"
dt.hits = sc.hits
dt.bytes = sc.bytes
dt.ambiguity = sc.ambiguity
dt.provenance = prov
dt.specificity = sc.vague
dt.naked = sc.naked
l.data = dt
out[out:len() + 1] = l

i = 1
while i <= d.syms:len()
  sym = d.syms[i]
  # Column, not `container`. The symbol scanner makes the FIRST top-level
  # declaration the container of every later one (measured: `total` comes
  # back containered by `scale` in a flat file), so filtering on container
  # would put a lens on exactly one symbol per file and look like it worked.
  if sym.col == 0
    refs = find_refs_in_text(d.text, d.lo, sym.name, uri)
    cc = {}
    cc.title = tostring(refs:len()) .. " references"
    cc.command = ""
    ll = {}
    ll.range = mk_range(sym.line, sym.col, sym.col + sym.name:len())
    ll.command = cc
    dd = {}
    dd.role = "witness"
    dd.why = "use sites of `" .. sym.name .. "` — the only witness class this front end can count today"
    dd.dnir = "ref-scan"
    dd.count = refs:len()
    ll.data = dd
    out[out:len() + 1] = ll
  i = i + 1
out

# ── message dispatch ─────────────────────────────────────────────────────────
handle_message: void = msg
method = msg.method
id = msg.id
params = msg.params
if params == nil
  params = {}
if method == "initialize"
  reply(id, handle_initialize(params))
else(method == "shutdown")
  io.lsp.shutdown = true
  reply(id, nil)
else(method == "exit")
  io.lsp.do_exit = true
else(method == "initialized")
  nil
else(method == "textDocument/didOpen")
  handle_did_open(params)
else(method == "textDocument/didChange")
  handle_did_change(params)
else(method == "textDocument/didClose")
  handle_did_close(params)
else(method == "textDocument/didSave")
  handle_did_save(params)
else(method == "textDocument/documentSymbol")
  reply(id, handle_document_symbol(params))
else(method == "textDocument/hover")
  reply(id, handle_hover(params))
else(method == "textDocument/definition")
  reply(id, handle_definition(params))
else(method == "textDocument/references")
  reply(id, handle_references(params))
else(method == "textDocument/rename")
  reply(id, handle_rename(params))
else(method == "textDocument/foldingRange")
  reply(id, handle_folding_range(params))
else(method == "textDocument/documentHighlight")
  reply(id, handle_document_highlight(params))
else(method == "workspace/symbol")
  reply(id, handle_workspace_symbol(params))
else(method == "textDocument/completion")
  reply(id, handle_completion(params))
else(method == "textDocument/semanticTokens/full")
  reply(id, handle_semantic_tokens(params))
else(method == "textDocument/semanticTokens")
  reply(id, handle_semantic_tokens(params))
else(method == "textDocument/inlayHint")
  reply(id, handle_inlay_hint(params))
else(method == "textDocument/codeLens")
  reply(id, handle_code_lens(params))
else(id != nil)
  reply_error(id, -32601, "method not found: " .. tostring(method))

# ── main loop ────────────────────────────────────────────────────────────────
lsp_main: void = ()
  io.lsp.id_bin = resolve_duo_bin()
  io.lsp.check_flags = resolve_check_flags()
  io.lsp.json = json
  while true
    msg = read_message()
    if msg == nil
      break
    handle_message(msg)
    flush_dirty()
    if io.lsp.do_exit
      break
  if io.lsp.shutdown
    os.exit(0)
  else
    os.exit(1)
lsp_main()
