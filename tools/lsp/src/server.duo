  add_std_completion(out, seen, "proc", prefix)
  add_std_completion(out, seen, "random", prefix)
  add_std_completion(out, seen, "regex", prefix)
  add_std_completion(out, seen, "sqlite", prefix)
  add_std_completion(out, seen, "string", prefix)
  add_std_completion(out, seen, "table", prefix)
  add_std_completion(out, seen, "tar", prefix)
