# tools/wasm/ingest.id — canonical idol Wasm fact ingestion (lane 3).
#
# Wasm bytes are source-law provenance: this reads a module and emits
# fact lines (module identity, section census) in the graph vocabulary.
# Runtime need is NEVER inferred here — realization reads demand, not
# opcodes. Lawful shape: flat bindings, subject-first relations, no
# module globals, no compound spellings.
#
# usage: idol run tools/wasm/ingest.id -- <module.wasm>

ulebval: i64 = (s: str, i: i64)
  r: i64 = 0
  k: i64 = 0
  p: i64 = i
  hit: bool = true
  while hit
    x: i64 = byteat(s, p)
    r = r + (x - (x / 128) * 128) * pow2(k)
    p = p + 1
    hit = x >= 128 and p <= bytecount(s)
    k = k + 7
  r

ulebafter: i64 = (s: str, i: i64)
  p: i64 = i
  hit: bool = true
  while hit
    x: i64 = byteat(s, p)
    p = p + 1
    hit = x >= 128 and p <= bytecount(s)
  p

pow2: i64 = (k: i64)
  out: i64 = 1
  n: i64 = 0
  while n < k
    out = out * 2
    n = n + 1
  out

fact: str = (key: str, val: str)
  '{"fact":"' .. key .. '","value":' .. val .. '}'

num: str = (n: i64)
  n:to(str)

emit: i64 = (key: str, val: str)
  stdout:write(fact(key, "\"" .. val .. "\"") .. "\n")
  0

hexdigit: i64 = (c: i64)
  if c >= 48 and c <= 57
    c - 48
  else
    if c >= 97 and c <= 102
      c - 87
    else
      0

# DECLARED TRANSPORT (until H9 lands a bytes face): the module is hex
# text; bytes are read IN PLACE (hex pair -> value). O(1) per access,
# zero materialization. The binary face replaces this accessor alone.

byteat: i64 = (s: str, n: i64)
  hexdigit(s:byte(2 * n - 1)) * 16 + hexdigit(s:byte(2 * n))

bytecount: i64 = (s: str)
  s:len() / 2

immclass: i64 = (op: i64)
  if op == 14 or op == 28
    -1
  else
    if op == 65 or op == 66
      -2
    else
      if op == 67
        -3
      else
        if op == 68
          -4
        else
          if op >= 40 and op <= 62
            -5
          else
            if op == 32 or op == 33 or op == 34 or op == 35 or op == 36 or op == 16 or op == 12 or op == 13
              1
            else
              if op == 17
                2
              else
                0

slebend: i64 = (s: str, i: i64)
  p: i64 = i
  hit: bool = true
  while hit
    x: i64 = byteat(s, p)
    p = p + 1
    hit = x >= 128 and p <= bytecount(s)
  p

main: i64 = ()
  path: str = args(1)
  if path == ""
    stdout:write("usage: idol run tools/wasm/ingest.id -- <module.wasm.hex>\n")
    return 1
  src: str = path:read()
  if src:len() < 8
    stdout:write("error: too short for a module\n")
    return 1
  b0: i64 = byteat(src, 1)
  b1: i64 = byteat(src, 2)
  b2: i64 = byteat(src, 3)
  b3: i64 = byteat(src, 4)
  if b0 != 0 or b1 != 97 or b2 != 115 or b3 != 109
    stdout:write("error: not a wasm module\n")
    return 1
  v: i64 = byteat(src, 5) + byteat(src, 6) * 256 + byteat(src, 7) * 65536 + byteat(src, 8) * 16777216
  emit("module.magic", "wasm")
  emit("module.version", num(v))
  # section census: each section is one fact line (id, byte size)
  i: i64 = 9
  walk: bool = true
  while walk and i + 1 < bytecount(src)
    sid: i64 = byteat(src, i)
    size: i64 = ulebval(src, i + 1)
    after: i64 = ulebafter(src, i + 1)
    emit("section." .. num(sid), num(size))
    if sid == 1
      n1c: i64 = ulebval(src, after)
      emit("types.count", num(n1c))
    if sid == 3
      n3c: i64 = ulebval(src, after)
      emit("functions.count", num(n3c))
    if sid == 10
      n10c: i64 = ulebval(src, after)
      emit("bodies.count", num(n10c))
      bp: i64 = ulebafter(src, after)
      fi: i64 = 0
      totalinstr: i64 = 0
      totallocals: i64 = 0
      while fi < n10c and bp < bytecount(src)
        bsz: i64 = ulebval(src, bp)
        bstart: i64 = ulebafter(src, bp)
        bend: i64 = bstart + bsz - 1
        nld: i64 = ulebval(src, bstart)
        lp: i64 = ulebafter(src, bstart)
        flocals: i64 = 0
        li: i64 = 0
        while li < nld and lp < bend
          cnt: i64 = ulebval(src, lp)
          lp = ulebafter(src, lp) + 1
          flocals = flocals + cnt
          li = li + 1
        ninstr: i64 = 0
        ip: i64 = lp
        walking: bool = true
        while walking and ip <= bend
          op: i64 = byteat(src, ip)
          ip = ip + 1
          cl: i64 = immclass(op)
          if cl == 1
            ip = ulebafter(src, ip)
          if cl == 2
            ip = ulebafter(src, ip)
            ip = ulebafter(src, ip)
          if cl == -2
            ip = slebend(src, ip)
          if cl == -3
            ip = ip + 4
          if cl == -4
            ip = ip + 8
          if cl == -5
            ip = ulebafter(src, ip)
            ip = ulebafter(src, ip)
          if cl == -1
            walking = false
          ninstr = ninstr + 1
        emit("body." .. num(fi) .. ".locals", num(flocals))
        emit("body." .. num(fi) .. ".instr", num(ninstr))
        totalinstr = totalinstr + ninstr
        totallocals = totallocals + flocals
        bp = bstart + bsz
        fi = fi + 1
      emit("code.totalinstr", num(totalinstr))
      emit("code.totallocals", num(totallocals))
    if sid == 7
      n7c: i64 = ulebval(src, after)
      emit("exports.count", num(n7c))
    if sid == 2
      n2c: i64 = ulebval(src, after)
      emit("imports.count", num(n2c))
    i = after + size
    walk = i > 0
  0
