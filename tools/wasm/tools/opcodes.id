# JIT projections. Both are keyed by NAME, so the opcode number they used to
# repeat now comes from OPS. A name that is not in OPS is a hard error.

# ARM64 base word for the one shared ALU emit path.
ALUWORD = {
  { "i32.add", 184549376 },
  { "i32.sub", 1258291200 },
  { "i32.mul", 453016576 },
  { "i32.div_s", 448793600 },
  { "i32.div_u", 448792576 },
  { "i32.and", 167772160 },
  { "i32.or", 704643072 },
  { "i32.xor", 1241513984 },
  { "i32.shl", 448798720 },
  { "i32.shr_s", 448800768 },
  { "i32.shr_u", 448799744 },
  { "i32.rotr", 448801792 },
  { "i64.add", 2332033024 },
  { "i64.sub", 3405774848 },
  { "i64.mul", 2600500224 },
  { "i64.div_s", 2596277248 },
  { "i64.div_u", 2596276224 },
  { "i64.and", 2315255808 },
  { "i64.or", 2852126720 },
  { "i64.xor", 3388997632 },
  { "i64.shl", 2596282368 },
  { "i64.shr_s", 2596284416 },
  { "i64.shr_u", 2596283392 },
  { "i64.rotr", 2596285440 }
}

# ARM64 condition code fed to CSET. The i64 rows reuse the i32 conditions on a
# 64-bit CMP; the CSET stays 32-bit because a wasm compare yields i32.
CMPCOND = {
  { "i32.eq", 0 },
  { "i32.ne", 1 },
  { "i32.lt_s", 11 },
  { "i32.lt_u", 3 },
  { "i32.gt_s", 12 },
  { "i32.gt_u", 8 },
  { "i32.le_s", 13 },
  { "i32.le_u", 9 },
  { "i32.ge_s", 10 },
  { "i32.ge_u", 2 },
  { "i64.eq", 0 },
  { "i64.ne", 1 },
  { "i64.lt_s", 11 },
  { "i64.lt_u", 3 },
  { "i64.gt_s", 12 },
  { "i64.gt_u", 8 },
  { "i64.le_s", 13 },
  { "i64.le_u", 9 },
  { "i64.ge_s", 10 },
  { "i64.ge_u", 2 }
}

# Duo keywords cannot be bare identifiers, so those four names take a trailing
# underscore. The set matches lib/wasm/ward_mvp_opcodes.id exactly, which
# is what lets `_agree` compare the two files name-for-name.
_reserved = { "if", "else", "end", "return" }

_isreserved: bool = (name: str)
  for _i, k in _reserved
    if k == name
      return true
  false

# "i32.load8_s" -> "OP_i32_load8_s"; "if" -> "OP_if_".
_const: str = (name: str)
  out = ""
  i = 1
  while i <= name:len()
    c = name:sub(i, i)
    if c == "."
      out = out .. "_"
    else
      out = out .. c
    i = i + 1
  if _isreserved(name)
    out = out .. "_"
  "OP_" .. out

# `return -1`, NOT a bare `-1` tail — and the difference is a PARSER DEFECT,
# not a style preference. This was a SILENT WRONG ANSWER, not a build failure.
#
# The shape this relation had, from the day it was written until now, was
#
#     if row[2] == name
#       return row[1]
#     -1                      <- intended: fall-through "not found" sentinel
#
# and a block-tail expression that BEGINS WITH A UNARY MINUS is absorbed as a
# BINARY minus onto the preceding expression, across the newline and the dedent.
# So the parser built `return row[1] - 1` and there was no tail left at all.
# Measured 2026-08-15, eleven lines, one two-row table, three shapes side by
# side (the only difference between them is the last line of the body):
#
#     tail `-1`        -> hit 105, miss 0     WRONG on both
#     tail `return -1` -> hit 106, miss -1    correct
#     tail `99`        -> hit 106, miss 99    correct
#
# So it is unary-minus-in-tail-position specifically; a positive literal tail is
# fine. Routed to the src lane as a parser bug.
#
# WHAT IT COST HERE. `_num` feeds `_resolve()` and the `_body_alu()` /
# `_body_cmp()` projections, so every opcode number this file would have written
# into src/engine.id's JIT tables was ONE TOO LOW, and `_resolve` — which
# rejects a row whose `_num(...) < 0` — could never fire, because the sentinel
# came back as 0 rather than -1.
#
# AND THE FORMATTER DID NOT CAUSE THIS, it only made it visible. Commit
# c4a35dee ("De-Lua: 38 more files...") reprinted this relation as the single
# line `return row[1] - 1`. That is `idol fmt` faithfully rendering the AST the
# parser had actually built — the meaning had been wrong since the file was
# written, and the sweep is simply where the text finally agreed with it. The
# reprint is evidence, not the defect.
_num: i64 = (name: str)
  for _i, row in OPS
    if row[2] == name
      return row[1]
  return -1

_pad: str = (s: str, w: i64)
  out = s
  while out:len() < w
    out = out .. " "
  out

_hex8: str = (v: i64)
  digits = "0123456789ABCDEF"
  out = ""
  i = 0
  while i < 8
    nyb = v >> (28 - i * 4) & 15
    out = out .. digits:sub(nyb + 1, nyb + 1)
    i = i + 1
  "0x" .. out

# ── the four projected bodies ────────────────────────────────────────────

_body_consts: str = ()
  out = ""
  for _i, row in OPS
    out = out .. _const(row[2]) .. " = " .. to(str)(row[1]) .. "\n"
  out

_body_names: str = ()
  out = "OP_NAMES = {\n"
  for _i, row in OPS
    out = out .. "  {" .. _pad(to(str)(row[1]) .. ",", 5) .. " \"" .. row[2] .. "\"},\n"
  out .. "}\n"

_body_alu: str = ()
  out = "ALU_OPS = {\n"
  for _i, row in ALUWORD
    out = out .. "  {" .. _pad(_const(row[1]) .. ",", 22) .. " " .. _hex8(row[2]) .. "},\n"
  out .. "}\n"

_body_cmp: str = ()
  out = "CMP_OPS = {\n"
  for _i, row in CMPCOND
    out = out .. "  {" .. _pad(_const(row[1]) .. ",", 16) .. " " .. to(str)(row[2]) .. "},\n"
  out .. "}\n"

# ── region rewrite ───────────────────────────────────────────────────────
#
# Replaces the text between `-- derived(<tag>) begin` and `-- derived end`,
# markers included in neither. Byte-exact round trip when the body is already
# current, which is the whole idempotency property; `_selfcheck` proves the
# round trip rather than assuming it.
# `str:trim()` RETURNS NIL. Measured 2026-08-15, one line, no library:
#
#     print("[" .. "  hi  ":trim() .. "]")   ->   [nil]
#     print("[" .. "abc":trim() .. "]")      ->   [nil]
#
# It is not "returns empty" — it is nil, and `nil:find(pat, 1, true)` inside the
# loop below is what killed this file with SIGBUS (exit 138) rather than any
# diagnostic. `s:len()` on the same subject is correct, so it is `trim`
# specifically. Routed to the src lane. `_trim` below is the local replacement,
# built only from `:len()`, `:byte()` and `:sub()`, all measured working.
_trim: str = (s: str)
  a = 1
  n = s:len()
  while a <= n and (s:byte(a) == 32 or s:byte(a) == 9)
    a = a + 1
  while n >= a and (s:byte(n) == 32 or s:byte(n) == 9 or s:byte(n) == 13 or s:byte(n) == 10)
    n = n - 1
  s:sub(a, n)

# THE MARKERS ARE `#`, NOT `--`, and this file was still looking for `--`.
#
# src/engine.id carries `# derived(wasm.opcodes.constants) begin` and
# `# derived end`; the de-Lua migration moved every comment from `--` to `#` and
# these two string literals were not moved with them. So `_render` matched
# nothing in the real target, `seen` stayed 0, and the `seen != 1` guard would
# have refused the projection — correctly, but for a reason that names the
# region rather than the marker syntax. `_selfcheck` did not catch it because
# its synthetic buffer used `--` too: the control and the code agreed with each
# other and both disagreed with the file being projected. It now uses `#`.
_render: str = (text: str, tag: str, body: str)
  open = "# derived(" .. tag .. ") begin"
  out = ""
  inside = false
  seen = 0
  for _i, line in text:split("\n")
    t = _trim(line)
    if t:find(open, 1, true) == 1
      inside = true
      seen = seen + 1
      out = out .. line .. "\n" .. body
    elseif t == "# derived end"
      inside = false
      out = out .. line .. "\n"
    elseif not inside
      out = out .. line .. "\n"
  if seen != 1
    print("*** region '" .. tag .. "' appears " .. seen:to(str) .. " times, expected 1 ***")
    os.exit(1)
  # Splitting a "…\n"-terminated text yields a trailing empty element, which
  # the loop turned back into a newline. Drop it so the round trip is exact.
  out:sub(1, out:len() - 1)

# ── answerability to duo's canonical table ───────────────────────────────
#
# Parses lib/wasm/ward_mvp_opcodes.id (63 ops, emitted by
# `duo wasm-tables emit`) and demands OPS agree on every one. Reported as a
# count, not a boolean, because a parser that matched nothing would otherwise
# read as unanimous agreement.
# NO `:match`, BECAUSE `:match` CANNOT RETURN A CAPTURE HERE.
#
# This was `nm = line:match("^(OP_[%w_]+) = (%d+)$")` followed by
# `if nm != nil`. `str:match(pat)` is typed BOOL by this compiler — not the
# capture, and not nil-on-miss. Two consequences, both silent:
#
#   * `nm != nil` is true for EVERY line, because a bool is never nil, so the
#     body ran on comment lines and blank lines as well as opcode rows;
#   * `nm` then carried `true`/`false` into the name comparison, which is
#     exactly what the harness printed on its first successful run:
#     `*** false: canonical table says 0, tools/opcodes.id says -1 ***`.
#
# Measured 2026-08-15: `to(str)(s:match(pat))` does not even compile — the C
# backend emits `duo_str_from_bool(...)` for it and clang rejects the argument
# type. Same defect family as `s:find(p) == nil`, which is also always false.
# Routed to the src lane.
#
# The parse below uses only `:len()`, `:sub()` and `:byte()`, all measured
# working, and is STRICTER than the pattern it replaces: the name must start
# `OP_`, the separator must be exactly " = ", and every remaining character must
# be a digit. A line that does not match all three is skipped, which is what
# keeps `checked` an honest count — and `main` refuses to project when it is 0.
_digits: bool = (s: str)
  if s:len() == 0
    return false
  i = 1
  while i <= s:len()
    if s:byte(i) < 48 or s:byte(i) > 57
      return false
    i = i + 1
  return true

_agree: i64 = (path: str)
  text = script.fs_read(path)
  checked = 0
  for _i, line in text:split("\n")
    if line:len() > 6 and line:sub(1, 3) == "OP_"
      eq = 0
      i = 4
      while i <= line:len() - 2
        if eq == 0 and line:sub(i, i + 2) == " = "
          eq = i
        i = i + 1
      if eq > 0
        nm = line:sub(1, eq - 1)
        numtxt = line:sub(eq + 3)
        if _digits(numtxt)
          want = to(i64)(numtxt)
          got = -1
          for _j, row in OPS
            if _const(row[2]) == nm
              got = row[1]
          if got != want
            print("*** " .. nm .. ": canonical table says " .. want:to(str) .. ", tools/opcodes.id says " .. got:to(str) .. " ***")
            os.exit(1)
          checked = checked + 1
  checked

# ── controls ─────────────────────────────────────────────────────────────
#
# Three things could each read "green" while broken, so each gets a probe that
# must FAIL for the harness to trust the one that must pass.
# RESTORED. Commit c4a35dee ("De-Lua: 38 more files after the concept and
# directive round-trip fixes") rewrote this declaration from `()` to `{}` and
# DE-INDENTED its entire body, which turned the negative control into a
# top-level value binding and a run of loose statements. `_selfcheck` is the
# probe that stops `_agree` from reading as unanimous agreement when it parsed
# nothing, so the sweep deleted exactly the check this file leans on. The body
# below is byte-identical to c4a35dee~1; only the `()` and the indentation are
# restored. `_resolve` two declarations down kept its `()` and shows the shape.
_selfcheck: bool = ()
  # 1. the region rewriter round-trips a buffer byte for byte
  src = "a\n# derived(t) begin\nold\n# derived end\nb\n"
  if _render(src, "t", "old\n") != src
    print("selfcheck: _render is not an identity on an already-current body")
    return false
  # 2. and actually replaces when the body differs
  if _render(src, "t", "new\n") != "a\n# derived(t) begin\nnew\n# derived end\nb\n"
    print("selfcheck: _render did not replace the region body")
    return false
  # 3. name mangling, including the reserved-word suffix
  if _const("i32.load8_s") != "OP_i32_load8_s"
    print("selfcheck: _const mangled i32.load8_s wrongly")
    return false
  if _const("end") != "OP_end_"
    print("selfcheck: _const did not suffix the reserved word `end`")
    return false
  # 4. the number lookup rejects an unknown name instead of inventing one
  if _num("i32.nonesuch") != -1
    print("selfcheck: _num invented a number for an unknown opcode")
    return false
  if _num("i32.add") != 106
    print("selfcheck: _num lost a known opcode")
    return false
  if _hex8(184549376) != "0x0B000000"
    print("selfcheck: _hex8 is not round-tripping")
    return false
  true

# Every JIT row must resolve through OPS. This is the property that makes OPS
# the single source: a row that could not resolve would otherwise be silently
# dropped from the projected table and the JIT would just stop compiling that
# opcode # which is invisible, because the JIT falls back to the interpreter
# and the correctness gate stays green.
_resolve: bool = ()
  ok = true
  for _i, row in ALUWORD
    if _num(row[1]) < 0
      print("*** ALUWORD row '" .. row[1] .. "' is not in OPS ***")
      ok = false
  for _i, row in CMPCOND
    if _num(row[1]) < 0
      print("*** CMPCOND row '" .. row[1] .. "' is not in OPS ***")
      ok = false
  ok

main: i64 = ()
  if not _selfcheck()
    print("*** projection harness is BROKEN; its output would not be evidence ***")
    return 1
  if not _resolve()
    return 1
  
  # NOT a hardcoded default. A personal path here is a public_safety_scan
  # failure (A19) and it is also wrong for everyone but one machine;
  # ask git where the checkout is instead. `_agree` below is the control:
  # a root that does not resolve parses 0 rows and the tool refuses.
  root = script.getenv("DUO_ROOT", "")
  if root == ""
    root = script.chomp(script.capture("git rev-parse --show-toplevel 2>/dev/null"))
  canon = root .. "/lib/wasm/ward_mvp_opcodes.id"
  n = _agree(canon)
  if n == 0
    print("*** parsed 0 rows out of " .. canon .. "; the agreement check is broken ***")
    return 1
  print("agrees with duo's canonical table on " .. n:to(str) .. " opcode(s)")

  # RE-INDENTED. Everything from here to the final `0` was DE-INDENTED out of
  # `main` by commit c4a35dee, so the projection ran as top-level statements
  # and `main` ended at the print above — an `i64` relation falling off the end
  # of its body, which the C backend emits as `return lua_val_nil();` from an
  # `int64_t` function and clang rejects. The `return 0` / `return 1` arms below
  # were returning from a relation they were no longer inside.
  target = "src/engine.id"
  before = script.fs_read(target)
  after = _render(before, "wasm.opcodes.constants", _body_consts())
  after = _render(after, "wasm.opcodes.names", _body_names())
  after = _render(after, "wasm.opcodes.aluword", _body_alu())
  after = _render(after, "wasm.opcodes.cmpcond", _body_cmp())

  # Mode selection is an ENV VAR, not argv: duo-compiled binaries do not
  # populate Lua's `arg`, and an argv-driven flag would silently take the
  # write path in a gate that meant to check.
  if script.getenv("DUO_WASM_DERIVE", "") != ""
    if after != before
      print("*** " .. target .. " is STALE against tools/opcodes.id ***")
      print("    run: duo run tools/opcodes.id")
      return 1
    print(target .. " is current (" .. to(str)(OPS:len()) .. " opcodes, " .. to(str)(ALUWORD:len()) .. " alu rows, " .. to(str)(CMPCOND:len()) .. " cmp rows)")
    return 0

  if after == before
    print(target .. " already current -- no write")
    return 0
  script.fs_write(target, after)
  print("projected " .. to(str)(OPS:len()) .. " opcodes into " .. target)
  0
