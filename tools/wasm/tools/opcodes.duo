-- JIT projections. Both are keyed by NAME, so the opcode number they used to
-- repeat now comes from OPS. A name that is not in OPS is a hard error.

-- ARM64 base word for the one shared ALU emit path.
ALUWORD = {
    {"i32.add", 0x0B000000},
    {"i32.sub", 0x4B000000},
    {"i32.mul", 0x1B007C00},
    {"i32.div_s", 0x1AC00C00},
    {"i32.div_u", 0x1AC00800},
    {"i32.and", 0x0A000000},
    {"i32.or", 0x2A000000},
    {"i32.xor", 0x4A000000},
    {"i32.shl", 0x1AC02000},
    {"i32.shr_s", 0x1AC02800},
    {"i32.shr_u", 0x1AC02400},
    {"i32.rotr", 0x1AC02C00},
    {"i64.add", 0x8B000000},
    {"i64.sub", 0xCB000000},
    {"i64.mul", 0x9B007C00},
    {"i64.div_s", 0x9AC00C00},
    {"i64.div_u", 0x9AC00800},
    {"i64.and", 0x8A000000},
    {"i64.or", 0xAA000000},
    {"i64.xor", 0xCA000000},
    {"i64.shl", 0x9AC02000},
    {"i64.shr_s", 0x9AC02800},
    {"i64.shr_u", 0x9AC02400},
    {"i64.rotr", 0x9AC02C00},
}

-- ARM64 condition code fed to CSET. The i64 rows reuse the i32 conditions on a
-- 64-bit CMP; the CSET stays 32-bit because a wasm compare yields i32.
CMPCOND = {
    {"i32.eq", 0},
    {"i32.ne", 1},
    {"i32.lt_s", 11},
    {"i32.lt_u", 3},
    {"i32.gt_s", 12},
    {"i32.gt_u", 8},
    {"i32.le_s", 13},
    {"i32.le_u", 9},
    {"i32.ge_s", 10},
    {"i32.ge_u", 2},
    {"i64.eq", 0},
    {"i64.ne", 1},
    {"i64.lt_s", 11},
    {"i64.lt_u", 3},
    {"i64.gt_s", 12},
    {"i64.gt_u", 8},
    {"i64.le_s", 13},
    {"i64.le_u", 9},
    {"i64.ge_s", 10},
    {"i64.ge_u", 2},
}

-- Duo keywords cannot be bare identifiers, so those four names take a trailing
-- underscore. The set matches lib/std/wasm/ward_mvp_opcodes.duo exactly, which
-- is what lets `_agree` compare the two files name-for-name.
_reserved = {"if", "else", "end", "return"}

_isreserved(name: str): bool
    for _i, k in _reserved
        if k == name
            return true
        end
    end
    false
end

-- "i32.load8_s" -> "OP_i32_load8_s"; "if" -> "OP_if_".
_const(name: str): str
    out = ""
    i = 1
    while i <= string.len(name)
        c = string.sub(name, i, i)
        if c == "."
            out = out .. "_"
        else
            out = out .. c
        end
        i += 1
    end
    if _isreserved(name)
        out = out .. "_"
    end
    "OP_" .. out
end

_num(name: str): i64
    for _i, row in OPS
        if row[2] == name
            return row[1]
        end
    end
    -1
end

_pad(s: str, w: i64): str
    out = s
    while string.len(out) < w
        out = out .. " "
    end
    out
end

_hex8(v: i64): str
    digits = "0123456789ABCDEF"
    out = ""
    i = 0
    while i < 8
        nyb = (v >> (28 - i * 4)) & 15
        out = out .. string.sub(digits, nyb + 1, nyb + 1)
        i += 1
    end
    "0x" .. out
end

-- ── the four projected bodies ────────────────────────────────────────────

_body_consts(): str
    out = ""
    for _i, row in OPS
        out = out .. _const(row[2]) .. " = " .. to(str)(row[1]) .. "\n"
    end
    out
end

_body_names(): str
    out = "OP_NAMES = {\n"
    for _i, row in OPS
        out = out .. "  {" .. _pad(to(str)(row[1]) .. ",", 5) .. " \"" .. row[2] .. "\"},\n"
    end
    out .. "}\n"
end

_body_alu(): str
    out = "ALU_OPS = {\n"
    for _i, row in ALUWORD
        out = out .. "  {" .. _pad(_const(row[1]) .. ",", 22) .. " " .. _hex8(row[2])
            .. "},\n"
    end
    out .. "}\n"
end

_body_cmp(): str
    out = "CMP_OPS = {\n"
    for _i, row in CMPCOND
        out = out .. "  {" .. _pad(_const(row[1]) .. ",", 16) .. " " .. to(str)(row[2]) .. "},\n"
    end
    out .. "}\n"
end

-- ── region rewrite ───────────────────────────────────────────────────────
--
-- Replaces the text between `-- derived(<tag>) begin` and `-- derived end`,
-- markers included in neither. Byte-exact round trip when the body is already
-- current, which is the whole idempotency property; `_selfcheck` proves the
-- round trip rather than assuming it.
_render(text: str, tag: str, body: str): str
    open = "-- derived(" .. tag .. ") begin"
    out = ""
    inside = false
    seen = 0
    for _i, line in std.string.split(text, "\n")
        t = std.string.trim(line)
        if string.find(t, open, 1, true) == 1
            inside = true
            seen += 1
            out = out .. line .. "\n" .. body
        elseif t == "-- derived end"
            inside = false
            out = out .. line .. "\n"
        elseif not inside
            out = out .. line .. "\n"
        end
    end
    if seen != 1
        print("*** region '" .. tag .. "' appears " .. seen:to(str) .. " times, expected 1 ***")
        os.exit(1)
    end
    -- Splitting a "…\n"-terminated text yields a trailing empty element, which
    -- the loop turned back into a newline. Drop it so the round trip is exact.
    string.sub(out, 1, string.len(out) - 1)
end

-- ── answerability to duo's canonical table ───────────────────────────────
--
-- Parses lib/std/wasm/ward_mvp_opcodes.duo (63 ops, emitted by
-- `duo wasm-tables emit`) and demands OPS agree on every one. Reported as a
-- count, not a boolean, because a parser that matched nothing would otherwise
-- read as unanimous agreement.
_agree(path: str): i64
    text = std.script.fs_read(path)
    checked = 0
    for _i, line in std.string.split(text, "\n")
        nm = string.match(line, "^(OP_[%w_]+) = (%d+)$")
        if nm != nil
            want = to(i64)(string.match(line, "= (%d+)$"))
            got = -1
            for _j, row in OPS
                if _const(row[2]) == nm
                    got = row[1]
                end
            end
            if got != want
                print("*** " .. nm .. ": canonical table says " .. want:to(str)
                    .. ", tools/opcodes.duo says " .. got:to(str) .. " ***")
                os.exit(1)
            end
            checked += 1
        end
    end
    checked
end

-- ── controls ─────────────────────────────────────────────────────────────
--
-- Three things could each read "green" while broken, so each gets a probe that
-- must FAIL for the harness to trust the one that must pass.
_selfcheck(): bool
    -- 1. the region rewriter round-trips a buffer byte for byte
    src = "a\n-- derived(t) begin\nold\n-- derived end\nb\n"
    if _render(src, "t", "old\n") != src
        print("selfcheck: _render is not an identity on an already-current body")
        return false
    end
    -- 2. and actually replaces when the body differs
    if _render(src, "t", "new\n") != "a\n-- derived(t) begin\nnew\n-- derived end\nb\n"
        print("selfcheck: _render did not replace the region body")
        return false
    end
    -- 3. name mangling, including the reserved-word suffix
    if _const("i32.load8_s") != "OP_i32_load8_s"
        print("selfcheck: _const mangled i32.load8_s wrongly")
        return false
    end
    if _const("end") != "OP_end_"
        print("selfcheck: _const did not suffix the reserved word `end`")
        return false
    end
    -- 4. the number lookup rejects an unknown name instead of inventing one
    if _num("i32.nonesuch") != -1
        print("selfcheck: _num invented a number for an unknown opcode")
        return false
    end
    if _num("i32.add") != 106
        print("selfcheck: _num lost a known opcode")
        return false
    end
    if _hex8(0x0B000000) != "0x0B000000"
        print("selfcheck: _hex8 is not round-tripping")
        return false
    end
    true
end

-- Every JIT row must resolve through OPS. This is the property that makes OPS
-- the single source: a row that could not resolve would otherwise be silently
-- dropped from the projected table and the JIT would just stop compiling that
-- opcode -- which is invisible, because the JIT falls back to the interpreter
-- and the correctness gate stays green.
_resolve(): bool
    ok = true
    for _i, row in ALUWORD
        if _num(row[1]) < 0
            print("*** ALUWORD row '" .. row[1] .. "' is not in OPS ***")
            ok = false
        end
    end
    for _i, row in CMPCOND
        if _num(row[1]) < 0
            print("*** CMPCOND row '" .. row[1] .. "' is not in OPS ***")
            ok = false
        end
    end
    ok
end

main(): i64
    if not _selfcheck()
        print("*** projection harness is BROKEN; its output would not be evidence ***")
        return 1
    end
    if not _resolve()
        return 1
    end

    -- NOT a hardcoded default. A personal path here is a public_safety_scan
    -- failure (Pass 10 A19) and it is also wrong for everyone but one machine;
    -- ask git where the checkout is instead. `_agree` below is the control:
    -- a root that does not resolve parses 0 rows and the tool refuses.
    root = std.script.getenv("DUO_ROOT", "")
    if root == ""
        root = std.script.chomp(std.script.capture("git rev-parse --show-toplevel 2>/dev/null"))
    end
    canon = root .. "/lib/std/wasm/ward_mvp_opcodes.duo"
    n = _agree(canon)
    if n == 0
        print("*** parsed 0 rows out of " .. canon .. "; the agreement check is broken ***")
        return 1
    end
    print("agrees with duo's canonical table on " .. n:to(str) .. " opcode(s)")

    target = "src/engine.duo"
    before = std.script.fs_read(target)
    after = _render(before, "wasm.opcodes.constants", _body_consts())
    after = _render(after, "wasm.opcodes.names", _body_names())
    after = _render(after, "wasm.opcodes.aluword", _body_alu())
    after = _render(after, "wasm.opcodes.cmpcond", _body_cmp())

    -- Mode selection is an ENV VAR, not argv: duo-compiled binaries do not
    -- populate Lua's `arg`, and an argv-driven flag would silently take the
    -- write path in a gate that meant to check.
    if std.script.getenv("DUO_WASM_DERIVE", "") != ""
        if after != before
            print("*** " .. target .. " is STALE against tools/opcodes.duo ***")
            print("    run: duo run tools/opcodes.duo")
            return 1
        end
        print(target .. " is current (" .. to(str)(#OPS) .. " opcodes, "
            .. to(str)(#ALUWORD) .. " alu rows, " .. to(str)(#CMPCOND) .. " cmp rows)")
        return 0
    end

    if after == before
        print(target .. " already current -- no write")
        return 0
    end
    std.script.fs_write(target, after)
    print("projected " .. to(str)(#OPS) .. " opcodes into " .. target)
    0
end
