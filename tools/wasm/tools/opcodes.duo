    {192, "i32.extend8_s"},
    {193, "i32.extend16_s"},
    {194, "i64.extend8_s"},
    {195, "i64.extend16_s"},
    {196, "i64.extend32_s"},
    {208, "ref.null"},
    {209, "ref.is_null"},
    {210, "ref.func"},
    {252, "prefix.fc"},
    {253, "prefix.simd"},
