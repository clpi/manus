
script = require("script")

_ms_per_ns: i64 = ()
  1000000

_time_ms: i64 = (cmd: str)
  a: i64 = time.monotonic()
  script.status(cmd)
  b: i64 = time.monotonic()
  to(i64)((b - a) / _ms_per_ns())

_median: i64 = (xs: any, n: i64)
  i = 2
  while i <= n
    key = xs(i)
    j = i - 1
    while j >= 1 and xs(j) > key
      xs(j + 1) = xs(j)
      j = j - 1
    xs(j + 1) = key
    i = i + 1
  xs((n + 1) / 2)

_min_of: i64 = (xs: any, n: i64)
  m = xs(1)
  i = 2
  while i <= n
    if xs(i) < m
      m = xs(i)
    i = i + 1
  m

main: i64 = ()
  binary = script.getenv("DUO_WASM_BIN", "/tmp/duowasm")
  mod = script.arg(1, "bench/hash.wasm")
  n: i64 = to(i64)(script.getenv("N", "7"))

  if not script.fs_exists(mod)
    print("perf: module not found: " .. mod)
    return 1
  abs = script.chomp(script.capture("cd \"$(dirname " .. mod .. ")\" && pwd")) .. "/" .. script.path_basename(mod)

  invocation = "DUO_WASM_MODULE=" .. abs .. " " .. binary
  wasmtime_cmd = "wasmtime --invoke run " .. mod

  w = {}
  m = {}
  i = 1
  while i <= n
    w(i) = _time_ms(invocation)
    m(i) = _time_ms(wasmtime_cmd)
    i = i + 1

  wmin = _min_of(w, n)
  mmin = _min_of(m, n)
  wmed = _median(w, n)
  mmed = _median(m, n)

  print("module   " .. mod)
  print("the engine     median " .. wmed:to(str) .. " ms  min " .. wmin:to(str))
  print("wasmtime median " .. mmed:to(str) .. " ms  min " .. mmin:to(str))
  if mmed > 0
    print("ratio    " .. to(str)(wmed * 100 / mmed) .. "%  (<100 means the engine is faster)")
  0
