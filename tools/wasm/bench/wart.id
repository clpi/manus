
script = require("script")

_next: i64 = (s: i64)
  (s * 1103515245 + 12345) % 2147483648

_pad: str = (s: str, w: i64)
  out = s
  while out:len() < w
    out = out .. " "
  out

_rule = (n: i64)
  line = ""
  i = 1
  while i <= n
    line = line .. "-"
    i = i + 1
  print(line)

_body: str = (seed: i64, iters: i64)
  a = seed % 1048576
  b = seed / 7 % 99991 + 3
  rot = seed % 13 + 3
  op = "i32.add"
  k = seed % 5
  if k == 1
    op = "i32.mul"
  else(k == 2)
    op = "i32.xor"
  else(k == 3)
    op = "i32.sub"
  else(k == 4)
    op = "i32.or"
  "\n  (local.set $acc (i32.const " .. a:to(str) .. "))" .. "\n  (block $B (loop $L" .. "\n    (br_if $B (i32.ge_s (local.get $i) (i32.const " .. iters:to(str) .. ")))" .. "\n    (local.set $acc (" .. op .. " (local.get $acc) (i32.const " .. b:to(str) .. ")))" .. "\n    (local.set $acc (i32.mul (i32.xor (local.get $acc) (local.get $i)) (i32.const 16777619)))" .. "\n    (local.set $acc (i32.rotl (local.get $acc) (i32.const " .. rot:to(str) .. ")))" .. "\n    (local.set $i (i32.add (local.get $i) (i32.const 1)))" .. "\n    (br $L)))"

_run_wat: str = (body: str)
  "(module\n (func (export \"run\") (result i32)\n  (local $i i32) (local $acc i32)" .. body .. "\n  (local.get $acc)))\n"

_assert_wat: str = (body: str, want: str)
  "(module\n (func (export \"run\") (result i32)\n  (local $i i32) (local $acc i32)" .. body .. "\n  (if (i32.ne (local.get $acc) (i32.const " .. want .. ")) (then (unreachable)))\n  (local.get $acc)))\n"

_build: str = (dir: str, name: str, text: str)
  wat = dir .. "/" .. name .. ".wat"
  wasm = dir .. "/" .. name .. ".wasm"
  script.fs_write(wat, text)
  if script.status("wat2wasm " .. wat .. " -o " .. wasm .. " 2>/dev/null") != 0
    return ""
  wasm

_ms: i64 = (a: i64, b: i64)
  to(i64)((b - a) / 1000000)

_time_ms: i64 = (cmd: str)
  a: i64 = std.time.monotonic()
  script.status(cmd)
  b: i64 = std.time.monotonic()
  _ms(a, b)

_field: str = (raw: str, key: str)
  m = raw:match("\n" .. key .. "=([^\n]*)")
  if m == nil
    m = raw:match("^" .. key .. "=([^\n]*)")
  if m == nil
    return ""
  script.chomp(m)

_expect: str = (binary: str, wasm: str)
  cmd = "DUO_WASM_MODULE=" .. wasm .. " DUO_WASM_INVOKE=run DUO_WASM_ENGINE=jit timeout 300 " .. binary
  rc = script.status(cmd .. " >/dev/null 2>&1")
  raw = script.capture(cmd .. " 2>/dev/null")
  r = _field(raw, "result")
  if rc == 0 and r != ""
    return "agree"
  if rc != 0
    return "DISAGREE"
  "no-result"

_wart_assert: str = (wart: str, wasm: str)
  if script.status("timeout 300 " .. wart .. " run --jit --function run " .. wasm) == 0
    return "agree"
  "DISAGREE"

main: i64 = ()
  binary = script.getenv("IDOL_WASM_BIN", "/tmp/idolwasm")
  wart = script.getenv("WART", script.getenv("HOME", ".") .. "/x/wart/zig-out/bin/wart")
  wasmtime = script.getenv("WASMTIME", "wasmtime")
  kn: i64 = to(i64)(script.getenv("K", "8"))
  reps: i64 = to(i64)(script.getenv("N", "3"))
  seed0: i64 = to(i64)(script.getenv("SEED", "20260808"))
  iters: i64 = to(i64)(script.getenv("ITERS", "100000000"))

if not script.fs_exists(binary)
  print("no the engine binary at " .. binary .. " -- build it with bench/run.id first")
  return 1
if not script.fs_exists(wart)
  print("no wart binary at " .. wart)
  print("wart is the differential baseline; without it this table cannot be produced.")
  return 1
if script.status("command -v wat2wasm >/dev/null 2>&1") != 0
  print("wat2wasm not found -- the generated differential needs it")
  return 1

dir = script.fs_tmpdir() .. "/_delta"
script.fs_mkdir(dir)

cbody = _body(_next(seed0), 200000)
crun = _build(dir, "ctl_run", _run_wat(cbody))
if crun == ""
  print("control module failed to assemble")
  return 1
cref = script.chomp(script.capture(wasmtime .. " --invoke run " .. crun .. " 2>/dev/null | tail -1"))
if cref == ""
  print("wasmtime produced no reference value for the control")
  return 1
cpos = _build(dir, "ctl_pos", _assert_wat(cbody, cref))
cneg = _build(dir, "ctl_neg", _assert_wat(cbody, "1"))

print("== controls ==")
pw = _wart_assert(wart, cpos)
nw = _wart_assert(wart, cneg)
pd = _expect(binary, cpos)
nd = _expect(binary, cneg)
print("  wart  correct-assert=" .. pw .. "  wrong-assert=" .. nw)
print("  the engine  correct-assert=" .. pd .. "  wrong-assert=" .. nd)
if pw != "agree" or nw == "agree"
  print("*** wart control FAILED -- its exit status is not evidence; nothing below is reportable ***")
  return 1
if pd != "agree" or nd == "agree"
  print("*** the engine control FAILED -- its result field is not evidence; nothing below is reportable ***")
  return 1
print("  both directions proved; the table below is evidence.")
print("")

print(_pad("KERNEL", 10) .. _pad("WASMTIME", 14) .. _pad("WARD", 14) .. _pad("wart", 10) .. _pad("the engine", 10) .. _pad("the engine ms", 9) .. _pad("wart ms", 9) .. _pad("wtime ms", 9) .. "the engine/wart")
_rule(104)

seed = seed0
bad = 0
sidol = 0
swart = 0
i = 1
while i <= kn
  seed = _next(seed)
  body = _body(seed, iters)
  rmod = _build(dir, "k" .. i:to(str) .. "_run", _run_wat(body))
  ref = script.chomp(script.capture(wasmtime .. " --invoke run " .. rmod .. " 2>/dev/null | tail -1"))
  amod = _build(dir, "k" .. i:to(str) .. "_assert", _assert_wat(body, ref))

vwart = _wart_assert(wart, amod)
vidol = _expect(binary, amod)

wraw = script.capture("DUO_WASM_MODULE=" .. rmod .. " DUO_WASM_INVOKE=run DUO_WASM_ENGINE=jit timeout 300 " .. binary .. " 2>/dev/null")
got = _field(wraw, "result")

tidol = 9999999
twart = 9999999
twt = 9999999
j = 1
while j <= reps
  a = _time_ms("DUO_WASM_MODULE=" .. rmod .. " DUO_WASM_INVOKE=run DUO_WASM_ENGINE=jit " .. binary .. " >/dev/null 2>&1")
  if a < tidol
    tidol = a
  b = _time_ms(wart .. " run --jit " .. amod .. " >/dev/null 2>&1")
  if b < twart
    twart = b
  c = _time_ms(wasmtime .. " --invoke run " .. rmod .. " >/dev/null 2>&1")
  if c < twt
    twt = c
  j = j + 1
sidol = sidol + tidol
swart = swart + twart

ratio = "-"
if twart > 0
  ratio = to(str)(tidol * 100 / twart) .. "%"
if vwart != "agree" or vidol != "agree"
  bad = bad + 1
print(_pad("k" .. i:to(str), 10) .. _pad(ref, 14) .. _pad(got, 14) .. _pad(vwart, 10) .. _pad(vidol, 10) .. _pad(tidol:to(str), 9) .. _pad(twart:to(str), 9) .. _pad(twt:to(str), 9) .. ratio)
i = i + 1

_rule(104)
if swart > 0
  print("aggregate the engine/wart = " .. to(str)(sidol * 100 / swart) .. "%   (<100% means the engine is faster -- the target asks for < 100%)")
print("kernels where a runtime disagreed with the oracle: " .. bad:to(str) .. "/" .. kn:to(str))

if bad != 0
  return 1
if swart > 0 and sidol >= swart
  print("")
  print("*** PASS 101 §4 UNMET: the engine is not faster than wart on this corpus ***")
  return 1
0
