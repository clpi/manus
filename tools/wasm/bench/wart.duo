-- Pass 101 §4: wart as the differential BASELINE, plus the claim table.
--
--   duo run bench/wart.duo            # generated differential + timing
--   K=16 N=5 duo run bench/wart.duo   # more kernels, more reps
--
-- Pass 101 asks for "wart enters the differential harness as the baseline" and
-- for the claim to "ship as a table, not an adjective". Before 2026-08-08 no
-- harness compared the engine to wart at all: bench/verify.duo differences the engine
-- against wasmtime, bench/run.duo has a wart column that only reports SIGILL or
-- a wall time, and bench/perf.duo has no wart column at all.
--
-- THE PROBLEM THIS HARNESS SOLVES. `wart run <mod>` can only invoke `_start`,
-- and it prints nothing for a function that returns a value. 24 of the 44
-- modules in bench/ export only `run`, so wart cannot reach them; of the 17
-- that export `_start`, only 2 print anything. So on the existing corpus wart's
-- ANSWER is observable for 2 modules out of 44, and a "the engine vs wart" row built
-- on the other 42 would be timing two runtimes with no evidence either computed
-- the right thing. That is the shape of claim CLAUDE.md §3 was written about.
--
-- THE REPAIR. Generate the kernel, ask wasmtime for the answer, then emit a
-- SECOND module with the same kernel whose `_start` traps unless the value
-- matches. wart's exit status becomes a value check, and the engine's `result=-1`
-- bail becomes one too. The expected constant comes from the oracle at run
-- time, never from this file -- and the kernels are generated from a seed, so
-- no recognizer anywhere can key on a function name, a literal, or a loop
-- bound and still pass.
--
-- CONTROLS. A trap-on-mismatch check that never traps proves nothing, so the
-- first thing this runs is a deliberately WRONG assert. If wart or the engine accepts
-- it, the harness refuses to report and exits non-zero.

-- Deterministic 32-bit LCG. The kernels must be arbitrary but the run must be
-- reproducible, so the seed is an input rather than a clock read.
_next(s: i64): i64
    (s * 1103515245 + 12345) % 2147483648
end

_pad(s: str, w: i64): str
    out = s
    while string.len(out) < w
        out = out .. " "
    end
    out
end

_rule(n: i64): void
    line = ""
    i = 1
    while i <= n
        line = line .. "-"
        i += 1
    end
    print(line)
end

-- One arbitrary i32 loop kernel as WAT body text, driven entirely by `seed`.
-- `ops` is indexed by the seed too, so the instruction MIX varies between
-- kernels and not just the constants -- a runtime that special-cased one shape
-- would still have to be right on the others.
_body(seed: i64, iters: i64): str
    a = seed % 1048576
    b = (seed / 7) % 99991 + 3
    rot = seed % 13 + 3
    op = "i32.add"
    k = seed % 5
    if k == 1
        op = "i32.mul"
    elseif k == 2
        op = "i32.xor"
    elseif k == 3
        op = "i32.sub"
    elseif k == 4
        op = "i32.or"
    end
    "\n  (local.set $acc (i32.const " .. a:to(str) .. "))"
        .. "\n  (block $B (loop $L"
        .. "\n    (br_if $B (i32.ge_s (local.get $i) (i32.const " .. iters:to(str) .. ")))"
        .. "\n    (local.set $acc (" .. op .. " (local.get $acc) (i32.const " .. b:to(str) .. ")))"
        .. "\n    (local.set $acc (i32.mul (i32.xor (local.get $acc) (local.get $i)) (i32.const 16777619)))"
        .. "\n    (local.set $acc (i32.rotl (local.get $acc) (i32.const " .. rot:to(str) .. ")))"
        .. "\n    (local.set $i (i32.add (local.get $i) (i32.const 1)))"
        .. "\n    (br $L)))"
end

-- The value-returning form. wasmtime reads the answer out of this one.
_run_wat(body: str): str
    "(module\n (func (export \"run\") (result i32)\n  (local $i i32) (local $acc i32)"
        .. body .. "\n  (local.get $acc)))\n"
end

-- The trapping form. Identical kernel; `_start` is void, so the only thing that
-- escapes is whether it trapped -- which is exactly what makes wart, whose CLI
-- prints no return value, into a checkable oracle.
_assert_wat(body: str, want: str): str
    "(module\n (func (export \"_start\")\n  (local $i i32) (local $acc i32)"
        .. body
        .. "\n  (if (i32.ne (local.get $acc) (i32.const " .. want .. ")) (then (unreachable)))))\n"
end

_build(dir: str, name: str, text: str): str
    wat = dir .. "/" .. name .. ".wat"
    wasm = dir .. "/" .. name .. ".wasm"
    std.script.fs_write(wat, text)
    if std.script.status("wat2wasm " .. wat .. " -o " .. wasm .. " 2>/dev/null") != 0
        return ""
    end
    wasm
end

_ms(a: i64, b: i64): i64
    to(i64)((b - a) / 1000000)
end

_time_ms(cmd: str): i64
    a: i64 = std.time.monotonic()
    std.script.status(cmd)
    b: i64 = std.time.monotonic()
    _ms(a, b)
end

_field(raw: str, key: str): str
    m = string.match(raw, "\n" .. key .. "=([^\n]*)")
    if m == nil
        m = string.match(raw, "^" .. key .. "=([^\n]*)")
    end
    if m == nil
        return ""
    end
    std.script.chomp(m)
end

-- the engine's verdict on a trapping module. Both signals are required, because each
-- one alone has been wrong at some point:
--
--   exit status  -- since 981b1f0 a trap exits non-zero (71) and prints a
--                   diagnostic to stderr. Before that commit a trap and a
--                   legitimate result were both `result=-1`, indistinguishable
--                   from a function that genuinely returns -1.
--   result=0     -- a void `_start` that ran to completion. Checking only the
--                   exit status would score "the engine never started" as agreement.
--
-- Requiring both means a future change to either channel shows up as
-- `no-result` rather than as a silent pass.
_expect(binary: str, wasm: str): str
    cmd = "DUO_WASM_MODULE=" .. wasm
        .. " DUO_WASM_INVOKE=_start DUO_WASM_ENGINE=jit timeout 300 " .. binary
    rc = std.script.status(cmd .. " >/dev/null 2>&1")
    raw = std.script.capture(cmd .. " 2>/dev/null")
    r = _field(raw, "result")
    if rc == 0 and r == "0"
        return "agree"
    end
    if rc != 0
        return "DISAGREE"
    end
    "no-result"
end

_wart_assert(wart: str, wasm: str): str
    if std.script.status("timeout 300 " .. wart .. " run --jit " .. wasm) == 0
        return "agree"
    end
    "DISAGREE"
end

main(): i64
    binary = std.script.getenv("DUO_WASM_BIN", "/tmp/duowasm")
    wart = std.script.getenv("WART", std.script.getenv("HOME", ".") .. "/x/wart/zig-out/bin/wart")
    wasmtime = std.script.getenv("WASMTIME", "wasmtime")
    kn: i64 = to(i64)(std.script.getenv("K", "8"))
    reps: i64 = to(i64)(std.script.getenv("N", "3"))
    seed0: i64 = to(i64)(std.script.getenv("SEED", "20260808"))
    -- 100M keeps the kernel an order of magnitude above the ~13 ms process
    -- floor all three runtimes pay. At 4M every row read 14/14/16 ms and the
    -- ratio column was measuring `fork` and dyld, not code generation.
    iters: i64 = to(i64)(std.script.getenv("ITERS", "100000000"))

    if not std.script.fs_exists(binary)
        print("no the engine binary at " .. binary .. " -- build it with bench/run.duo first")
        return 1
    end
    if not std.script.fs_exists(wart)
        print("no wart binary at " .. wart)
        print("wart is the Pass 101 baseline; without it this table cannot be produced.")
        return 1
    end
    if std.script.status("command -v wat2wasm >/dev/null 2>&1") != 0
        print("wat2wasm not found -- the generated differential needs it")
        return 1
    end

    dir = std.script.fs_tmpdir() .. "/_delta"
    std.script.fs_mkdir(dir)

    -- ── CONTROLS ─────────────────────────────────────────────────────────
    -- A trap-on-mismatch oracle that cannot detect a mismatch reports a clean
    -- sweep for a runtime that computes garbage. Prove both directions before
    -- believing a single row below.
    cbody = _body(_next(seed0), 200000)
    crun = _build(dir, "ctl_run", _run_wat(cbody))
    if crun == ""
        print("control module failed to assemble")
        return 1
    end
    cref = std.script.chomp(std.script.capture(
        wasmtime .. " --invoke run " .. crun .. " 2>/dev/null | tail -1"))
    if cref == ""
        print("wasmtime produced no reference value for the control")
        return 1
    end
    cpos = _build(dir, "ctl_pos", _assert_wat(cbody, cref))
    -- "1" is not the answer to a 200000-iteration FNV-ish chain; if it reads as
    -- one, the check is not checking.
    cneg = _build(dir, "ctl_neg", _assert_wat(cbody, "1"))

    print("== controls ==")
    pw = _wart_assert(wart, cpos)
    nw = _wart_assert(wart, cneg)
    pd = _expect(binary, cpos)
    nd = _expect(binary, cneg)
    print("  wart  correct-assert=" .. pw .. "  wrong-assert=" .. nw)
    print("  the engine  correct-assert=" .. pd .. "  wrong-assert=" .. nd)
    if pw != "agree" or nw == "agree"
        print("*** wart control FAILED -- its exit status is not evidence; nothing below is reportable ***")
        return 1
    end
    if pd != "agree" or nd == "agree"
        print("*** the engine control FAILED -- its result field is not evidence; nothing below is reportable ***")
        return 1
    end
    print("  both directions proved; the table below is evidence.")
    print("")

    -- ── GENERATED DIFFERENTIAL + TIMING ──────────────────────────────────
    print(_pad("KERNEL", 10) .. _pad("WASMTIME", 14) .. _pad("WARD", 14)
        .. _pad("wart", 10) .. _pad("duon", 10) .. _pad("the engine ms", 9)
        .. _pad("wart ms", 9) .. _pad("wtime ms", 9) .. "the engine/wart")
    _rule(104)

    seed = seed0
    bad = 0
    sduon = 0
    swart = 0
    i = 1
    while i <= kn
        seed = _next(seed)
        body = _body(seed, iters)
        rmod = _build(dir, "k" .. i:to(str) .. "_run", _run_wat(body))
        ref = std.script.chomp(std.script.capture(
            wasmtime .. " --invoke run " .. rmod .. " 2>/dev/null | tail -1"))
        amod = _build(dir, "k" .. i:to(str) .. "_assert", _assert_wat(body, ref))

        vwart = _wart_assert(wart, amod)
        vduon = _expect(binary, amod)

        -- the engine's own value, read the way bench/verify.duo reads it, so the row
        -- carries a number and not only a verdict. wasmtime prints i32 signed
        -- and the engine prints it unsigned; the two columns are the same 32-bit
        -- value when they differ only by 2^32.
        wraw = std.script.capture("DUO_WASM_MODULE=" .. rmod
            .. " DUO_WASM_INVOKE=run DUO_WASM_ENGINE=jit timeout 300 " .. binary .. " 2>/dev/null")
        got = _field(wraw, "result")

        -- Interleaved, min of `reps`. Interleaving matters: this box drifts
        -- measurably under sustained load, and a sequential sweep charges the
        -- drift to whichever runtime ran last.
        tduon = 9999999
        twart = 9999999
        twt = 9999999
        j = 1
        while j <= reps
            a = _time_ms("DUO_WASM_MODULE=" .. rmod .. " DUO_WASM_INVOKE=run DUO_WASM_ENGINE=jit "
                .. binary .. " >/dev/null 2>&1")
            if a < tduon
                tduon = a
            end
            b = _time_ms(wart .. " run --jit " .. amod .. " >/dev/null 2>&1")
            if b < twart
                twart = b
            end
            c = _time_ms(wasmtime .. " --invoke run " .. rmod .. " >/dev/null 2>&1")
            if c < twt
                twt = c
            end
            j += 1
        end
        sduon = sduon + tduon
        swart = swart + twart

        ratio = "-"
        if twart > 0
            ratio = to(str)(tduon * 100 / twart) .. "%"
        end
        if vwart != "agree" or vduon != "agree"
            bad += 1
        end
        print(_pad("k" .. i:to(str), 10) .. _pad(ref, 14) .. _pad(got, 14)
            .. _pad(vwart, 10) .. _pad(vduon, 10) .. _pad(tduon:to(str), 9)
            .. _pad(twart:to(str), 9) .. _pad(twt:to(str), 9) .. ratio)
        i += 1
    end

    _rule(104)
    if swart > 0
        print("aggregate the engine/wart = " .. to(str)(sduon * 100 / swart)
            .. "%   (<100% means the engine is faster -- Pass 101 §4 asks for < 100%)")
    end
    print("kernels where a runtime disagreed with the oracle: " .. bad:to(str) .. "/" .. kn:to(str))

    if bad != 0
        return 1
    end
    if swart > 0 and sduon >= swart
        print("")
        print("*** PASS 101 §4 UNMET: the engine is not faster than wart on this corpus ***")
        return 1
    end
    0
end
