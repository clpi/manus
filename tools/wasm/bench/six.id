
script = require("script")

_msns: i64 = ()
  1000000

_time_ms: i64 = (cmd: str)
  a: i64 = time.monotonic()
  script.status(cmd)
  b: i64 = time.monotonic()
  to(i64)((b - a) / _msns())

_min_of: i64 = (xs: any, n: i64)
  m = xs(1)
  i = 2
  while i <= n
    if xs(i) < m
      m = xs(i)
    i = i + 1
  m

_pad: str = (s: str, w: i64)
  out = s
  while out:len() < w
    out = out .. " "
  out

_lpad: str = (s: str, w: i64)
  out = s
  while out:len() < w
    out = " " .. out
  out

_isnum: bool = (s: str)
  if s == ""
    return false
  s:match("^%-?%d+%.?%d*$") != nil

_hexdigit: i64 = (c: str)
  at = "0123456789abcdef":find(c:lower(), 1, true)
  if at == nil
    return -1
  at - 1

_unhex: str = (s: str)
  v: i64 = 0
  i: i64 = 3
  n: i64 = s:len()
  if n < 3
    return s
  while i <= n
    d: i64 = _hexdigit(s:sub(i, i))
    if d < 0
      return s
    v = v * 16 + d
    i = i + 1
  v:to(str)

_norm: str = (raw: str)
  t = script.chomp(raw)
  t = t:gsub(":i32", "")
  t = t:gsub(":i64", "")
  t = t:gsub(":f32", "")
  t = t:gsub(":f64", "")
  t = t:gsub("Result: ", "")
  t = t:trim()
  if t:match("^0[xX]%x+$") != nil
    t = _unhex(t)
  if not _isnum(t)
    return t
  f: f64 = to(f64)(t)
  i: i64 = to(i64)(f)
  if to(f64)(i) == f
    u = i % 4294967296
    if u < 0
      u = u + 4294967296
    return u:to(str)
  f:to(str)

_protocol: bool = (line: str)
  if line:match("^engine=") != nil
    return true
  if line:match("^result=") != nil
    return true
  if line:match("^seconds=") != nil
    return true
  if line:match("^wasm: ") != nil
    return true
  if line:match("^Result: ") != nil
    return true
  if line:match("^warning:") != nil
    return true
  if line:match("^0[xX]%x+:[if]%d+$") != nil
    return true
  false

_answer: str = (raw: str)
  body = ""
  proto = ""
  for _i, line in raw:split("\n")
    t = line:trim()
    if t != ""
      if _protocol(t)
        proto = t
      else
        body = t
  if body != ""
    return body
  m = raw:match("result=([^\n]*)")
  if m != nil
    return script.chomp(m)
  proto

_errored: bool = (raw: str)
  if raw:match("Error:") != nil
    return true
  if raw:match("error:") != nil
    return true
  false

main: i64 = ()
  binary = script.getenv("IDOL_WASM_BIN", "/tmp/idolwasm")
  engine = script.getenv("DUO_WASM_ENGINE", "jit")
  wart = script.getenv("WART_BIN", script.getenv("HOME", "") .. "/x/wart/zig-out/bin/wart")
  n: i64 = to(i64)(script.getenv("N", "5"))
  secs = script.getenv("SIX_TIMEOUT", "120")
  root = script.chomp(script.capture("pwd"))

  have = {}
  for _i, r in { "wasmtime", "wasmer", "wasm3", "iwasm" }
    have(r) = script.status(r .. " --help >/dev/null 2>&1") == 0
    if not have(r)
      have(r) = script.status("command -v " .. r .. " >/dev/null 2>&1") == 0
  have("the engine") = script.fs_is_file(binary)
  have("wart") = script.fs_is_file(wart)
  line = "runtimes:"
  for _i, r in { "the engine", "wart", "wasmtime", "wasmer", "wasm3", "iwasm" }
    mark = " MISSING"
    if have(r)
      mark = " ok"
    line = line .. "  " .. r .. mark
  print(line)
  if not have("the engine")
    print("refusing to measure: no the engine binary at " .. binary)
    return 3
  if not have("wasmtime")
    print("refusing to measure: wasmtime is the oracle and it is missing")
    return 3

  fixtures = {}
  nfix = 0
  for _g, pat in {
    script.getenv("SIX_FIXTURES", "bench/*.wasm"),
    script.getenv("SIX_FIXTURES2", "../../benchmarks/wasm_rt/*.wasm")
  }
    for _i, m in script.fs_glob(pat)
      nfix = nfix + 1
      fixtures(nfix) = m
  if nfix == 0
    print("refusing to measure: the fixture globs matched nothing")
    return 3

  print("")
  print(_pad("MODULE", 30) .. " " .. _pad("ENTRY", 7) .. _lpad("the engine", 9) .. _lpad("wart", 9) .. _lpad("wasmtime", 10) .. _lpad("wasmer", 9) .. _lpad("wasm3", 9) .. _lpad("iwasm", 9) .. "   FASTEST")
  rule = ""
  ri = 1
  while ri <= 104
    rule = rule .. "-"
    ri = ri + 1
  print(rule)

  firsts = 0
  rows = 0
  losses = {}
  nloss = 0
  floor: i64 = to(i64)(script.getenv("FLOOR_MS", "40"))
  startup = 0

  for _i, mod in fixtures
    abs = root .. "/" .. mod
    name = script.path_stem(mod)
    for _j, entry in { "run", "_start" }
      if script.status("wasmtime --invoke " .. entry .. " " .. mod .. " >/dev/null 2>&1") == 0
        oracle = _norm(_answer(script.capture("wasmtime --invoke " .. entry .. " " .. mod .. " 2>/dev/null")))

        cmd = {}
        cmd("the engine") = "DUO_WASM_MODULE=" .. abs .. " DUO_WASM_INVOKE=" .. entry .. " DUO_WASM_ENGINE=" .. engine .. " timeout " .. secs .. " " .. binary
        cmd("wasmtime") = "timeout " .. secs .. " wasmtime --invoke " .. entry .. " " .. mod
        cmd("wasmer") = "timeout " .. secs .. " wasmer run -i " .. entry .. " " .. mod
        cmd("wasm3") = "timeout " .. secs .. " wasm3 --func " .. entry .. " " .. mod
        cmd("iwasm") = "timeout " .. secs .. " iwasm -f " .. entry .. " " .. mod
        cmd("wart") = "timeout " .. secs .. " " .. wart .. " run " .. mod
        errpol = {}
        errpol("the engine") = " 2>/dev/null"
        errpol("wasmtime") = " 2>/dev/null"
        errpol("wasmer") = " 2>/dev/null"
        errpol("wasm3") = " 2>&1"
        errpol("iwasm") = " 2>&1"
        errpol("wart") = " 2>&1"

        okrt = {}
        miss = {}
        errd = {}
        for _k, r in { "the engine", "wart", "wasmtime", "wasmer", "wasm3", "iwasm" }
          okrt(r) = false
          miss(r) = false
          errd(r) = false
          if have(r)
            if r == "wart" and entry != "_start"
              okrt(r) = false
            else
              raw = script.capture(cmd(r) .. errpol(r))
              got = _norm(_answer(raw))
              if oracle == ""
                okrt(r) = false
              else(got == oracle)
                okrt(r) = true
              else(got == "" or _errored(raw))
                miss(r) = true
                if _errored(raw)
                  errd(r) = true

        if okrt("the engine") or okrt("wasmtime")
          t = {}
          for _k, r in { "the engine", "wart", "wasmtime", "wasmer", "wasm3", "iwasm" }
            t(r) = {}
          q = 1
          while q <= n
            for _k, r in { "the engine", "wart", "wasmtime", "wasmer", "wasm3", "iwasm" }
              if okrt(r)
                t(r)(q) = _time_ms(cmd(r) .. " >/dev/null 2>&1")
            q = q + 1

          best = -1
          bestr = "-"
          idolms: i64 = floor
          cells = ""
          for _k, r in { "the engine", "wart", "wasmtime", "wasmer", "wasm3", "iwasm" }
            w = 9
            if r == "wasmtime"
              w = 10
            if okrt(r)
              v = _min_of(t(r), n)
              if r == "the engine"
                idolms = v
              cells = cells .. _lpad(v:to(str), w)
              if best < 0 or v < best
                best = v
                bestr = r
            else
              mark = "WRONG"
              if miss(r) or r == "wart"
                mark = "n/a"
              if errd(r)
                mark = "err"
              if not have(r)
                mark = "-"
              cells = cells .. _lpad(mark, w)
          rows = rows + 1
          if best < floor and idolms < floor
            startup = startup + 1
            bestr = bestr .. " (startup)"
          else(bestr == "the engine")
            firsts = firsts + 1
          else
            nloss = nloss + 1
            wv = "n/a"
            if okrt("the engine")
              wv = to(str)(_min_of(t("the engine"), n))
            losses(nloss) = _pad(name .. " (" .. entry .. ")", 34) .. " the engine " .. _lpad(wv, 6) .. " ms vs " .. bestr .. " " .. _lpad(best:to(str), 6) .. " ms"
          print(_pad(name, 30) .. " " .. _pad(entry, 7) .. cells .. "   " .. bestr)

  print(rule)
  print("timed rows " .. rows:to(str) .. " — " .. startup:to(str) .. " below the " .. floor:to(str) .. " ms startup floor and attributed to NOBODY")
  print("of the " .. to(str)(rows - startup) .. " rows that do measurable work: the engine first on " .. firsts:to(str) .. ", NOT first on " .. nloss:to(str))
  print("(ms, min of " .. n:to(str) .. " interleaved runs; only VERIFIED runtimes are timed;")
  print(" n/a = cannot be driven to that export; err = refused the module; WRONG = ran and disagreed)")
  if nloss > 0
    print("")
    print("every workload where the engine is NOT first:")
    for _i, l in losses
      print("  " .. l)
  0
