
wabi = req "src.wasm.wasi_abi"

fails: i64 = 0
checks: i64 = 0

eq: i64 = (what: str, got: i64, want: i64)
  r: i64 = 0
  if got != want
    io.stderr:write("FAIL " .. what .. ": got " .. got:to(str) .. ", want " .. want:to(str) .. "\n")
    r = 1
  r

eqs: i64 = (what: str, got: str, want: str)
  r: i64 = 0
  if got != want
    io.stderr:write("FAIL " .. what .. ": got '" .. got .. "', want '" .. want .. "'\n")
    r = 1
  r

cap_main = ()
  nproc: i64 = 0
  nclock: i64 = 0
  nenv: i64 = 0
  nfs: i64 = 0
  nnet: i64 = 0
  ndev: i64 = 0
  nnone: i64 = 0
  k: i64 = 1
  while k <= 46
    w: str = wabi.grant_world(k)
    if w == "process"
      nproc += 1
    elseif w == "clock"
      nclock += 1
    elseif w == "environment"
      nenv += 1
    elseif w == "filesystem"
      nfs += 1
    elseif w == "network"
      nnet += 1
    elseif w == "device"
      ndev += 1
    else
      nnone += 1
    k += 1
  fails += eq("world/process", nproc, 5)
  fails += eq("world/clock", nclock, 2)
  fails += eq("world/environment", nenv, 2)
  fails += eq("world/filesystem", nfs, 31)
  fails += eq("world/network", nnet, 4)
  fails += eq("world/device", ndev, 2)
  fails += eq("world/unassigned", nnone, 0)
  fails += eq("world/total", nproc + nclock + nenv + nfs + nnet + ndev, 46)
  fails += eqs("world/off-roster-low", wabi.grant_world(0), "")
  fails += eqs("world/off-roster-high", wabi.grant_world(47), "")
  checks += 10

  na: i64 = 0
  nn: i64 = 0
  ne: i64 = 0
  k = 1
  while k <= 46
    na += wabi.grant_admits("all", k)
    nn += wabi.grant_admits("none", k)
    ne += wabi.grant_admits("", k)
    k += 1
  fails += eq("all grants 46", na, 46)
  fails += eq("none grants 0", nn, 0)
  fails += eq("empty spec grants 0", ne, 0)
  fails += eq("all is total", wabi.grant_is_total("all"), 1)
  fails += eq("none is not total", wabi.grant_is_total("none"), 0)
  checks += 5

  fails += eq("fd_write alone: fd_write", wabi.grant_admits("fd_write", wabi.i_fd_write), 1)
  fails += eq("fd_write alone: fd_read", wabi.grant_admits("fd_write", wabi.i_fd_read), 0)
  fails += eq("fd_write alone: proc_exit", wabi.grant_admits("fd_write", wabi.i_proc_exit), 0)
  n1: i64 = 0
  k = 1
  while k <= 46
    n1 += wabi.grant_admits("fd_write", k)
    k += 1
  fails += eq("fd_write alone grants exactly 1", n1, 1)
  checks += 4

  fails += eq("all,-fd_write: fd_write denied", wabi.grant_admits("all,-fd_write", wabi.i_fd_write), 0)
  fails += eq("all,-fd_write: fd_read granted", wabi.grant_admits("all,-fd_write", wabi.i_fd_read), 1)
  fails += eq("all,-fd_write: proc_exit granted", wabi.grant_admits("all,-fd_write", wabi.i_proc_exit), 1)
  n2: i64 = 0
  k = 1
  while k <= 46
    n2 += wabi.grant_admits("all,-fd_write", k)
    k += 1
  fails += eq("all,-fd_write grants 45", n2, 45)
  fails += eq("all,-fd_write is not total", wabi.grant_is_total("all,-fd_write"), 0)
  checks += 5

  n3: i64 = 0
  k = 1
  while k <= 46
    n3 += wabi.grant_admits("all,-filesystem", k)
    k += 1
  fails += eq("all,-filesystem grants 15", n3, 15)
  fails += eq("all,-filesystem: fd_write denied", wabi.grant_admits("all,-filesystem", wabi.i_fd_write), 0)
  fails += eq("all,-filesystem: clock granted", wabi.grant_admits("all,-filesystem", wabi.i_clock_time_get), 1)
  checks += 3

  n4: i64 = 0
  k = 1
  while k <= 46
    n4 += wabi.grant_admits("clock,random_get", k)
    k += 1
  fails += eq("clock,random_get grants 3", n4, 3)
  fails += eq("clock,random_get: clock_time_get", wabi.grant_admits("clock,random_get", wabi.i_clock_time_get), 1)
  fails += eq("clock,random_get: random_get", wabi.grant_admits("clock,random_get", wabi.i_random_get), 1)
  fails += eq("clock,random_get: fd_write", wabi.grant_admits("clock,random_get", wabi.i_fd_write), 0)
  checks += 4

  fails += eq("all,-fd_write,fd_write re-grants", wabi.grant_admits("all,-fd_write,fd_write", wabi.i_fd_write), 1)
  fails += eq("none,fd_write grants it", wabi.grant_admits("none,fd_write", wabi.i_fd_write), 1)
  fails += eq("fd_write,none takes it back", wabi.grant_admits("fd_write,none", wabi.i_fd_write), 0)
  checks += 3

  fails += eqs("valid spec has no bad token", wabi.grant_bad_token("all,-fd_write"), "")
  fails += eqs("valid world spec", wabi.grant_bad_token("clock,network"), "")
  fails += eqs("typo is reported verbatim", wabi.grant_bad_token("all,-fd_wrote"), "-fd_wrote")
  fails += eqs("first bad token wins", wabi.grant_bad_token("all,-nope,-alsonope"), "-nope")
  fails += eq("known: fd_write", wabi.grant_token_known("fd_write"), 1)
  fails += eq("known: filesystem", wabi.grant_token_known("filesystem"), 1)
  fails += eq("unknown: fd_wrote", wabi.grant_token_known("fd_wrote"), 0)
  fails += eq("unknown: fdxwrite", wabi.grant_token_known("fdxwrite"), 0)
  checks += 8

  fails += eq("notcapable is 76", wabi.ERRNO_notcapable, 76)
  fails += eq("notcapable != success", wabi.ERRNO_notcapable == wabi.ERRNO_success, false)
  fails += eq("notcapable != badf", wabi.ERRNO_notcapable == wabi.ERRNO_badf, false)
  fails += eq("notcapable != inval", wabi.ERRNO_notcapable == wabi.ERRNO_inval, false)
  fails += eq("notcapable != nosys", wabi.ERRNO_notcapable == wabi.ERRNO_nosys, false)
  fails += eq("notcapable != notsup", wabi.ERRNO_notcapable == wabi.ERRNO_notsup, false)
  fails += eq("notcapable != spipe", wabi.ERRNO_notcapable == wabi.ERRNO_spipe, false)
  nc: i64 = 0
  k = 1
  while k <= 46
    if wabi.static_errno(k) == wabi.ERRNO_notcapable
      nc += 1
    k += 1
  fails += eq("no static arm returns notcapable", nc, 0)
  checks += 8

  io.stderr:write("grant unit: " .. checks:to(str) .. " group(s), " .. fails:to(str) .. " failure(s)\n")
  if fails != 0
    os.exit(1)
  print("grant unit: PASS")
  os.exit(0)

cap_main()
