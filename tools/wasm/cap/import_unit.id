
nib: i64 = (c: i64)
  r: i64 = -1
  if c >= 48 and c <= 57
    r = c - 48
  elseif c >= 97 and c <= 102
    r = c - 87
  elseif c >= 65 and c <= 70
    r = c - 55
  r

ub: i64 = (h: str, at: i64, n: i64)
  r: i64 = -1
  if at >= 0 and at < n
    hi: i64 = nib(h:byte(at * 2 + 1))
    lo: i64 = nib(h:byte(at * 2 + 2))
    if hi >= 0 and lo >= 0
      r = hi * 16 + lo
  r

uleb_val: i64 = (h: str, at: i64, n: i64)
  r: i64 = 0
  m: i64 = 1
  i: i64 = at
  go: i64 = 1
  while go == 1 and i < n
    b: i64 = ub(h, i, n)
    if b < 0
      go = 0
    else
      lo: i64 = b - (b // 128) * 128
      r += lo * m
      m = m * 128
      if b < 128
        go = 0
      i += 1
  r

uleb_end: i64 = (h: str, at: i64, n: i64)
  i: i64 = at
  go: i64 = 1
  while go == 1 and i < n
    b: i64 = ub(h, i, n)
    if b < 0
      go = 0
    else
      i += 1
      if b < 128
        go = 0
  i

namestr: str = (h: str, at: i64, ln: i64, n: i64)
  out: str = ""
  k: i64 = 0
  while k < ln
    b: i64 = ub(h, at + k, n)
    if b >= 0
      c: str = string.char(b)
      out = out .. c
    k += 1
  out

kindname: str = (kd: i64)
  r: str = "entity of an unrecognised kind"
  if kd == 0
    r = "function"
  elseif kd == 1
    r = "table"
  elseif kd == 2
    r = "memory"
  elseif kd == 3
    r = "global"
  r

main: void = ()
  h: str = env("IMPORT_UNIT_HEX") or ""
  hl: i64 = h:len()
  if hl == 0
    stdout:write("unit: IMPORT_UNIT_HEX is empty -- nothing was measured\n")
    os.exit(2)
  half: i64 = hl // 2
  if half * 2 != hl
    stdout:write("unit: IMPORT_UNIT_HEX has an odd length -- nothing was measured\n")
    os.exit(2)
  n: i64 = half
  m0: i64 = ub(h, 0, n)
  m1: i64 = ub(h, 1, n)
  m2: i64 = ub(h, 2, n)
  m3: i64 = ub(h, 3, n)
  if m0 != 0 or m1 != 97 or m2 != 115 or m3 != 109
    stdout:write("unit: not a wasm image (magic) -- nothing was measured\n")
    os.exit(2)

  nfunc: i64 = 0
  nimp: i64 = 0
  si: i64 = 8
  while si < n
    sid: i64 = ub(h, si, n)
    si += 1
    ssz: i64 = uleb_val(h, si, n)
    si = uleb_end(h, si, n)
    if sid == 2
      ic: i64 = uleb_val(h, si, n)
      ij: i64 = uleb_end(h, si, n)
      ik: i64 = 0
      while ik < ic and ij < n
        la: i64 = uleb_val(h, ij, n)
        ms: i64 = uleb_end(h, ij, n)
        ij = ms + la
        flen: i64 = uleb_val(h, ij, n)
        fs: i64 = uleb_end(h, ij, n)
        ij = fs + flen
        kd: i64 = ub(h, ij, n)
        ij += 1
        nimp += 1
        if kd == 0
          nfunc += 1
          ij = uleb_end(h, ij, n)
        else
          mn: str = namestr(h, ms, la, n)
          fn: str = namestr(h, fs, flen, n)
          kn: str = kindname(kd)
          line: str = "refuse " .. kn .. " " .. mn .. "::" .. fn .. "\n"
          stdout:write(line)
          os.exit(1)
        ik += 1
    si += ssz
  ns: str = nimp:to(str)
  fsx: str = nfunc:to(str)
  line: str = "admit " .. fsx .. " function import(s) of " .. ns .. " import(s)\n"
  stdout:write(line)
  os.exit(0)
