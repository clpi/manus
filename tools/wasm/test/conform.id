

_chomp: str = (s: str)
    n: i64 = string.len(s)
    while n > 0 and (string.byte(s, n) == 10 or string.byte(s, n) == 13 or string.byte(s, n) == 32 or string.byte(s, n) == 9)
        n -= 1
    end
    string.sub(s, 1, n)
end

_trim: str = (s: str)
    a: i64 = 1
    n: i64 = string.len(s)
    while a <= n and (string.byte(s, a) == 32 or string.byte(s, a) == 9 or string.byte(s, a) == 13 or string.byte(s, a) == 10)
        a += 1
    end
    _chomp(string.sub(s, a, n))
end

_getenv: str = (name: str, fallback: str)
    v = os.env[name]
    r: str = fallback
    if v != nil
        if v != ""
            r = v
        end
    end
    r
end

_capture: str = (cmd: str)
    h = io.popen(cmd, "r")
    if h == nil
        return ""
    end
    t = h:read("*a")
    h:close()
    if t == nil
        return ""
    end
    t
end

_hash: str = (path: str)
    _chomp(_capture("shasum -a 256 " .. path .. " 2>/dev/null | cut -d ' ' -f 1"))
end

_status: i64 = (cmd: str)
    to(i64)(_chomp(_capture("( " .. cmd .. " ) >/dev/null 2>&1; echo $?")))
end

_run: i64 = (cmd: str)
    _status(cmd)
end

_isfile: bool = (path: str)
    _status("test -f " .. path) == 0
end

_rm = (path: str)
    _status("rm -f " .. path)
    0
end

_cp = (src: str, dst: str)
    _status("cp " .. src .. " " .. dst)
    0
end

_split = (s: str, sep: str)
    out = {}
    n: i64 = 0
    cur: str = ""
    i: i64 = 1
    L: i64 = string.len(s)
    sb: i64 = string.byte(sep, 1)
    while i <= L
        b: i64 = string.byte(s, i)
        if b == sb
            n += 1
            out[n] = cur
            cur = ""
        else
            cur = cur .. string.char(b)
        end
        i += 1
    end
    n += 1
    out[n] = cur
    out
end

_pathstem: str = (path: str)
    n: i64 = string.len(path)
    cut: i64 = 0
    k: i64 = n
    while k >= 1
        if string.byte(path, k) == 47 and cut == 0
            cut = k
        end
        k -= 1
    end
    base: str = string.sub(path, cut + 1, n)
    d: i64 = 0
    j: i64 = string.len(base)
    while j >= 1
        if string.byte(base, j) == 46 and d == 0
            d = j
        end
        j -= 1
    end
    if d > 1
        return string.sub(base, 1, d - 1)
    end
    base
end

_glob = (pat: str)
    out = {}
    n: i64 = 0
    raw: str = _capture("ls -1d " .. pat .. " 2>/dev/null")
    for _i, line in _split(raw, "\n")
        t = _trim(line)
        if t != ""
            n += 1
            out[n] = t
        end
    end
    out
end

_isnum: bool = (s: str)
    if s == "" return false end
    string.match(s, "^%-?%d+%.?%d*$") != nil
end

_norm: str = (s: str)
    t = _chomp(s)
    if !_isnum(t)
        return t
    end
    f: f64 = to(f64)(t)
    i: i64 = to(i64)(f)
    if to(f64)(i) == f
        u = i % 4294967296
        if u < 0
            u += 4294967296
        end
        return u:to(str)
    end
    f:to(str)
end

_lines: str = (raw: str)
    out = ""
    for _i, line in _split(raw, "\n")
        t = _trim(line)
        if t != ""
            if out == ""
                out = t
            else
                out = out .. " " .. t
            end
        end
    end
    out
end

_emitted: str = (raw: str)
    out = ""
    for _i, line in _split(raw, "\n")
        keep = true
        if string.match(line, "^engine=") != nil keep = false end
        if string.match(line, "^result=") != nil keep = false end
        if string.match(line, "^seconds=") != nil keep = false end
        if string.match(line, "^wasm: ") != nil keep = false end
        t = _trim(line)
        if keep and t != ""
            if out == ""
                out = t
            else
                out = out .. " " .. t
            end
        end
    end
    out
end

_field: str = (raw: str, key: str)
    m = string.match(raw, "\n" .. key .. "=([^\n]*)")
    if m == nil
        m = string.match(raw, "^" .. key .. "=([^\n]*)")
    end
    if m == nil
        return ""
    end
    _chomp(m)
end

_pad: str = (s: str, w: i64)
    out = s
    while out:len() < w
        out = out .. " "
    end
    out
end

_rule: void = ()
    line = ""
    i = 1
    while i <= 104
        line = line .. "-"
        i += 1
    end
    print(line)
end

_refusal: str = (raw: str)
    m = string.match(raw, "wasm: unimplemented opcode ([^\n]*)")
    if m == nil
        m = string.match(raw, "wasm: cannot execute opcode ([^\n]*)")
    end
    if m == nil
        m = string.match(raw, "wasm: cannot decode module ([^\n]*)")
    end
    if m == nil
        return ""
    end
    _chomp(m)
end

_verdict: str = (ref: str, got: str, raw: str)
    if _getenv("DUO_WASM_DAMAGE", "") == "comparator"
        return "PASS"
    end
    if _refusal(raw) != ""
        return "UNSUPPORTED"
    end
    if got == ""
        return "NORESULT"
    end
    if got == "-1"
        return "BAIL"
    end
    if _norm(ref) == _norm(got)
        return "PASS"
    end
    "DIFF"
end

_engine: str = (bin: str, mod: str, invoke: str, engine: str, secs: i64)
    sel = "DUO_WASM_ENGINE=" .. engine .. " "
    if engine == "default"
        sel = ""
    end
    pre = "env -u DUO_WASM_ENGINE "
    _capture(pre .. sel .. "DUO_WASM_MODULE=" .. mod .. " DUO_WASM_INVOKE=" .. invoke
        .. " timeout " .. secs:to(str) .. " "
        .. bin .. " 2>&1")
end

_answer: str = (raw: str)
    em = _emitted(raw)
    if em != ""
        return em
    end
    _field(raw, "result")
end

binary = _getenv("DUO_WASM_BIN", "/tmp/duowasm")
wasmtime = _getenv("WASMTIME", "wasmtime")
wasmtimepin = _getenv("WASMTIME_VERSION", "47.0.3")
secs: i64 = to(i64)(_getenv("DUO_WASM_TIMEOUT", "240"))
root = _chomp(_capture("pwd"))
repo = root .. "/../.."
tmpbase = _getenv("TMPDIR", "/tmp")
tmp = _chomp(_capture("mktemp -d " .. tmpbase .. "/idol-wasm-evidence.XXXXXX"))

if tmp == ""
    print("CONTROL FAIL: could !create a private evidence directory")
    return 3
end

revision = _chomp(_capture("git -C " .. repo .. " rev-parse HEAD 2>/dev/null"))
dirt = _capture("git -C " .. repo .. " status --porcelain=v1 --untracked-files=all")
dirtstate = "clean"
if dirt != "" dirtstate = "dirty" end
dirthash = _chomp(_capture(
    "git -C " .. repo .. " status --porcelain=v1 --untracked-files=all | shasum -a 256 | cut -d ' ' -f 1"))
enginehash = _hash(root .. "/src/engine.id")
wasiabihash = _hash(root .. "/src/wasm/wasi_abi.id")
jithash = _hash(repo .. "/lib/jit.id")
harnesshash = _hash(root .. "/test/conform.id")
wartpin = "ca2b0b9c0fb8c397987be2b4475fd1ccfe4d150b"
wartrepo = _getenv("WART_ORACLE_REPO", "")
wartbin = _getenv("WART_ORACLE_BIN", wartrepo .. "/zig-out/bin/wart")
wartrevision = _chomp(_capture("git -C " .. wartrepo .. " rev-parse HEAD 2>/dev/null"))
wartdirty = _capture("git -C " .. wartrepo .. " status --porcelain=v1 --untracked-files=all")
warthash = _hash(wartbin)
wartversion = _chomp(_capture(wartbin .. " --version 2>&1"))
wartprovenance = _getenv("WART_ORACLE_PROVENANCE", wartbin .. ".provenance")
wartprovenancerevision = _chomp(_capture(
    "sed -n 's/^revision=//p' " .. wartprovenance .. " 2>/dev/null"))
wartprovenancehash = _chomp(_capture(
    "sed -n 's/^binary_sha256=//p' " .. wartprovenance .. " 2>/dev/null"))
wartprovenancefilehash = _hash(wartprovenance)

if revision == "" or dirthash == "" or enginehash == "" or wasiabihash == ""
    print("CONTROL FAIL: revision/source hash binding is incomplete")
    return 3
end
if jithash == "" or harnesshash == ""
    print("CONTROL FAIL: revision/source hash binding is incomplete")
    return 3
end
if wartrepo == "" or wartrevision != wartpin or wartdirty != ""
    print("CONTROL FAIL: frozen Wart oracle source is !at clean revision " .. wartpin)
    return 3
end
if string.sub(wartbin, 1, wartrepo:len() + 1) != wartrepo .. "/"
    print("CONTROL FAIL: Wart oracle binary is !attributable to its frozen source tree")
    return 3
end
if wartversion == "" or warthash == ""
    print("CONTROL FAIL: frozen Wart oracle binary is missing or does !run")
    return 3
end
if wartprovenancerevision != wartrevision or wartprovenancehash != warthash
    print("CONTROL FAIL: Wart oracle binary provenance does !bind frozen source and bytes")
    return 3
end
if wartprovenancefilehash == ""
    print("CONTROL FAIL: Wart oracle provenance is missing")
    return 3
end

print("== binding ==")
print("command=" .. _getenv("DUO_WASM_BINDING", "zig build wasm-test"))
print("subject_revision=" .. revision)
print("evidence_revision=" .. revision)
print("dirty=" .. dirtstate .. " dirty_sha256=" .. dirthash)
print("engine_source_sha256=" .. enginehash)
print("wasi_abi_source_sha256=" .. wasiabihash)
print("jit_source_sha256=" .. jithash)
print("harness_source_sha256=" .. harnesshash)
print("requested_modes=interpreter,forced-jit,default,fallback")
print("oracle=wart revision=" .. wartrevision .. " version=" .. wartversion
    .. " binary_sha256=" .. warthash .. " provenance_sha256=" .. wartprovenancefilehash
    .. " role=test-only dynamic_competitor=no")

ctlfail = 0

print("== controls ==")

if !_isfile(binary)
    print("CONTROL FAIL: the engine binary !found at " .. binary)
    print("  engine artifact was !produced")
    ctlfail += 1
else
    probe = _capture("env -u DUO_WASM_MODULE " .. binary .. " 2>&1")
    if string.match(probe, "DUO_WASM_MODULE") == nil
        print("CONTROL FAIL: " .. binary .. " does !respond as the engine")
        ctlfail += 1
    else
        print("ok   the engine binary runs: " .. binary)
    end
    artifacthash = _hash(binary)
    if artifacthash == ""
        print("CONTROL FAIL: could !hash the private engine artifact")
        ctlfail += 1
    else
        print("engine_artifact_sha256=" .. artifacthash)
    end
end
if _status(wasmtime .. " --version >/dev/null 2>&1") != 0
    print("CONTROL FAIL: oracle `" .. wasmtime .. "` does !run")
    ctlfail += 1
else
    version = _chomp(_capture(wasmtime .. " --version 2>&1 | head -1"))
    want = "wasmtime {wasmtimepin}"
    if version != want and version:sub(1, want:len() + 1) != "{want} "
        print("CONTROL FAIL: oracle pin expected " .. wasmtimepin .. " got " .. version)
        ctlfail += 1
    else
        oraclepath = _chomp(_capture("command -v " .. wasmtime))
        oraclehash = _hash(oraclepath)
        if oraclepath == "" or oraclehash == ""
            print("CONTROL FAIL: could !bind the oracle binary hash")
            ctlfail += 1
        else
            print("ok   oracle=wasmtime version=" .. version
                .. " binary_sha256=" .. oraclehash)
        end
    end
end

if ctlfail != 0
    print("refusing to score: the things under test are !both present")
    return 3
end

fixtures = {}
nfix = 0
for _g, pat in {_getenv("DUO_WASM_FIXTURES", "bench/*.wasm"),
                _getenv("DUO_WASM_FIXTURES2", "examples/*.wasm"),
                _getenv("DUO_WASM_FIXTURES3", "../../benchmarks/wasm_rt/*.wasm")}
    for _i, m in _glob(pat)
        nfix += 1
        fixtures[nfix] = m
    end
end
if nfix == 0
    print("CONTROL FAIL: the fixture globs matched nothing — cwd is " .. root)
    return 3
end
print("ok   " .. nfix:to(str) .. " fixture module(s) found")
for _i, m in fixtures
    inputhash = _hash(root .. "/" .. m)
    if inputhash == ""
        print("CONTROL FAIL: could !hash input " .. m)
        return 3
    end
    print("input=" .. m .. " sha256=" .. inputhash)
end

omod = {}
oent = {}
oval = {}
nora = 0
for _i, m in fixtures
    for _j, cand in {"run", "_start"}
        if _status(wasmtime .. " --invoke " .. cand .. " " .. m .. " >/dev/null 2>&1") == 0
            v = _lines(_capture(
                wasmtime .. " --invoke " .. cand .. " " .. m .. " 2>/dev/null"))
            nora += 1
            omod[nora] = m
            oent[nora] = cand
            oval[nora] = v
        end
    end
end
if nora == 0
    print("CONTROL FAIL: wasmtime could !invoke ANY fixture — the oracle is !working")
    return 3
end
print("ok   " .. nora:to(str) .. " (module, entry) pair(s) the oracle can answer")

wartcontrol = root .. "/bench/hash.wasm"
if _status(wartbin .. " --no-jit --no-color -f run " .. wartcontrol .. " >/dev/null 2>&1") != 0
    print("CONTROL FAIL: frozen Wart interpreter could !execute " .. wartcontrol)
    return 3
end
wartpert = tmp .. "/wart-perturbed.wasm"
_cp(wartcontrol, wartpert)
_run("printf '\\x00' | dd of=" .. wartpert .. " bs=1 seek=3 conv=notrunc >/dev/null 2>&1")
if _status(wartbin .. " --no-jit --no-color -f run " .. wartpert .. " >/dev/null 2>&1") == 0
    print("CONTROL FAIL: frozen Wart interpreter ACCEPTED its positive control with a broken magic number")
    return 3
end
print("ok   oracle=wart tier=interpreter control=bench/hash.wasm entry=run observable=execution-status damage=broken-magic-refused")

ai = 0
bi = 0
for k = 1, nora
    if oval[k] != "" and ai == 0
        ai = k
    elseif oval[k] != "" and bi == 0 and _norm(oval[k]) != _norm(oval[ai])
        bi = k
    end
end
if ai == 0 or bi == 0
    print("CONTROL FAIL: could !find two fixtures with different oracle answers")
    return 3
end
ra = _engine(binary, root .. "/" .. omod[ai], oent[ai], "interp", secs)
rb = _engine(binary, root .. "/" .. omod[bi], oent[bi], "interp", secs)
aa = _answer(ra)
ab = _answer(rb)
if aa == "" or ab == ""
    print("CONTROL FAIL: the engine produced no answer for a control fixture")
    return 3
end
if _norm(aa) == _norm(ab)
    print("CONTROL FAIL: two different modules gave the engine the SAME answer (" .. aa .. ")")
    print("  the module path is !reaching the runtime")
    return 3
end
print("ok   input reaches the runtime: " .. _pathstem(omod[ai]) .. "=" .. aa
    .. " vs " .. _pathstem(omod[bi]) .. "=" .. ab)

if _verdict(oval[ai], aa, ra) != "PASS"
    print("CONTROL FAIL: the comparator does !accept a known-good pair")
    return 3
end
if _verdict(oval[bi], aa, ra) != "DIFF"
    print("CONTROL FAIL: the comparator does !reject a known-bad pair")
    return 3
end
print("ok   comparator says PASS on a matched pair and DIFF on a mismatched one")

pert = tmp .. "/wasmconform-perturbed.wasm"
_cp(root .. "/" .. omod[ai], pert)
_run("printf '\\x00' | dd of=" .. pert .. " bs=1 seek=3 conv=notrunc >/dev/null 2>&1")
if _status(wasmtime .. " --invoke " .. oent[ai] .. " " .. pert .. " >/dev/null 2>&1") == 0
    print("CONTROL FAIL: the oracle ACCEPTED a module with a broken magic number")
    print("  the perturbation did !take — dd may !have written")
    return 3
end
rp = _engine(binary, pert, oent[ai], "interp", secs)
ap = _answer(rp)
if ap != "" and _norm(ap) == _norm(aa)
    print("CONTROL FAIL: the engine answered " .. ap .. " for a module with a broken magic number")
    return 3
end
print("ok   perturbed module refused by both (the engine said: "
    .. _trim(_split(rp, "\n")[1]) .. ")")

miss = tmp .. "/wasmconform-no-such-module.wasm"
_rm(miss)
rm = _engine(binary, miss, "run", "interp", secs)
if _field(rm, "result") != ""
    print("CONTROL FAIL: the engine printed a result for a nonexistent module")
    return 3
end
print("ok   missing module refused rather than defaulted")

_tailmod = tmp .. "/tailcall.wasm"
_tailsrc = repo .. "/examples/table/tailcall.id"
_tailcmd = "IDOL_WASM_TAILCALL=1 " .. repo .. "/zig-out/bin/idol compile " .. _tailsrc
    .. " --backend=wasm --target wasm32-wasi -o " .. _tailmod .. " >/dev/null 2>&1"
if _status(_tailcmd) != 0
    print("CONTROL FAIL: could !compile a tail-call wasm fixture from examples/table/tailcall.id")
    return 3
end
_tailoracle = _lines(_capture(wasmtime .. " run " .. _tailmod .. " 2>/dev/null"))
if _norm(_tailoracle) != "10000000"
    print("CONTROL FAIL: the oracle did !answer the tail-call fixture as expected")
    return 3
end
_tailinterp = _engine(binary, _tailmod, "_start", "interp", secs)
_tailanswer = _answer(_tailinterp)
if _verdict(_tailoracle, _tailanswer, _tailinterp) != "PASS"
    print("CONTROL FAIL: the interpreter did !execute a wasm module containing return_call (0x12)")
    return 3
end
_taildefault = _engine(binary, _tailmod, "_start", "default", secs)
_taildefaultanswer = _answer(_taildefault)
if _verdict(_tailoracle, _taildefaultanswer, _taildefault) != "PASS"
    print("CONTROL FAIL: the default engine path did !execute a wasm module containing return_call (0x12)")
    return 3
end
print("ok   tail-call proposal opcode 0x12 runs under interp and default (_start -> "
    .. _tailanswer .. ")")

engines = {}
engines[1] = "interp"
engines[2] = "jit"
engines[3] = "default"

_jitrefused: bool = (raw: str)
    string.match(raw, "DUO_WASM_ENGINE=jit was requested") != nil
end

print("")
print("== matrix: " .. nora:to(str) .. " (module, entry) x 3 requested modes ==")
print(_pad("MODULE", 34) .. " " .. _pad("ENTRY", 7) .. " " .. _pad("ENGINE-ASKED", 7)
    .. " " .. _pad("RAN", 10) .. " " .. _pad("WASMTIME", 18) .. " "
    .. _pad("IDOL", 18) .. " VERDICT")
_rule()

pass = 0
diff = 0
bail = 0
none = 0
voidok = 0
unsup = 0
jitran = 0
jitasked = 0
jitdecl = 0
jitdeclrow = {}
fallbackrows = 0
crossok = 0
crossbad = 0
interpans = {}
defok = 0
defbad = 0
defran = {}

for k = 1, nora
    fx = omod[k]
    name = _pathstem(fx)
    for _e, engine in engines
        raw = _engine(binary, root .. "/" .. fx, oent[k], engine, secs)
        ran = _field(raw, "engine")
        if ran == "" ran = "?" end
        if engine == "jit"
            jitasked += 1
            if ran == "jit-arm64"
                jitran += 1
            end
        end
        got = _answer(raw)
        ref = oval[k]
        if engine == "interp"
            interpans[k] = got
        end
        selected = ran
        fallback = "none"
        reason = "forced-interpreter"
        if engine == "jit"
            reason = "forced-jit"
            if _jitrefused(raw)
                selected = "refused"
                reason = "jit-declined"
                jitdeclrow[k] = true
            end
        else
            if engine == "default"
                reason = "default-policy"
                if ran == "jit-arm64"
                    reason = "jit-selected"
                else
                    if ran == "interp" and jitdeclrow[k]
                        fallback = "interpreter"
                        reason = "jit-declined"
                        fallbackrows += 1
                    end
                end
            end
        end
        print("MODE module=" .. name .. " entry=" .. oent[k]
            .. " requested=" .. engine .. " selected=" .. selected
            .. " fallback=" .. fallback .. " reason=" .. reason)
        if engine == "jit" and _jitrefused(raw)
            jitdecl += 1
            print(_pad(name, 34) .. " " .. _pad(oent[k], 7) .. " " .. _pad(engine, 7)
                .. " " .. _pad("declined", 10) .. " " .. _pad(ref, 18) .. " "
                .. _pad("-", 18) .. " JIT-DECLINED")
        else
        if engine == "jit"
            if _norm(got) == _norm(interpans[k])
                crossok += 1
            else
                crossbad += 1
                print("*** INTERP/JIT DISAGREE on " .. name .. " (" .. oent[k]
                    .. "): interp=" .. interpans[k] .. " jit=" .. got .. " ***")
            end
        end
        if engine == "default"
            defran[ran] = (defran[ran] or 0) + 1
            if _norm(got) == _norm(interpans[k])
                defok += 1
            else
                defbad += 1
                print("*** DEFAULT/INTERP DISAGREE on " .. name .. " (" .. oent[k]
                    .. "): interp=" .. interpans[k] .. " default=" .. got
                    .. " (ran " .. ran .. ") ***")
            end
        end
        if ref == ""
            v = "OK(void)"
            if _refusal(raw) != ""
                v = "UNSUPPORTED"
                unsup += 1
            elseif got == "" or got == "-1"
                v = "BAIL"
                bail += 1
            else
                voidok += 1
            end
            print(_pad(name, 34) .. " " .. _pad(oent[k], 7) .. " " .. _pad(engine, 7)
                .. " " .. _pad(ran, 10) .. " " .. _pad("<void>", 18) .. " "
                .. _pad(got, 18) .. " " .. v)
        else
            v = _verdict(ref, got, raw)
            if v == "PASS" pass += 1 end
            if v == "DIFF" diff += 1 end
            if v == "BAIL" bail += 1 end
            if v == "NORESULT" none += 1 end
            if v == "UNSUPPORTED"
                unsup += 1
                if got == "" got = _refusal(raw) end
            end
            mark = v
            if v == "DIFF" mark = "*** DIFF ***" end
            print(_pad(name, 34) .. " " .. _pad(oent[k], 7) .. " " .. _pad(engine, 7)
                .. " " .. _pad(ran, 10) .. " " .. _pad(ref, 18) .. " "
                .. _pad(got, 18) .. " " .. mark)
        end
        end
    end
end

fallbackprobe = 0
for k = 1, nora
    if jitdeclrow[k] and fallbackprobe == 0
        fallbackprobe = k
    end
end
if fallbackprobe == 0
    print("CAPABILITY BLOCKED fallback-witness: no forced-JIT decline was available")
    return 1
end
fallbackraw = _engine(binary, root .. "/" .. omod[fallbackprobe],
    oent[fallbackprobe], "default", secs)
fallbackselected = _field(fallbackraw, "engine")
fallbackanswer = _answer(fallbackraw)
print("MODE module=" .. _pathstem(omod[fallbackprobe]) .. " entry=" .. oent[fallbackprobe]
    .. " requested=fallback selected=" .. fallbackselected
    .. " fallback=interpreter reason=forced-jit-declined")
if fallbackselected != "interp" or _norm(fallbackanswer) != _norm(interpans[fallbackprobe])
    print("CONTROL FAIL: explicit fallback run did !select the agreeing interpreter")
    return 1
end

_rule()
total = pass + diff + bail + none + voidok + unsup
print("rows " .. total:to(str)
    .. "   PASS " .. pass:to(str)
    .. "   DIFF " .. diff:to(str)
    .. "   UNSUPPORTED " .. unsup:to(str)
    .. "   BAIL " .. bail:to(str)
    .. "   NORESULT " .. none:to(str)
    .. "   OK(void) " .. voidok:to(str))
print("jit asked " .. jitasked:to(str) .. ", jit actually COMPILED " .. jitran:to(str)
    .. ", DECLINED " .. jitdecl:to(str)
    .. " (a declined body is a named gap, not a fallback in disguise)")
print("interp-vs-jit on the " .. jitran:to(str) .. " compiled row(s): AGREE "
    .. crossok:to(str) .. ", DIFFER " .. crossbad:to(str))
defline = ""
for rname, rcount in defran
    if defline != "" defline = defline .. ", " end
    defline = defline .. rname .. "=" .. rcount:to(str)
end
print("DEFAULT path (nobody asked for an engine) selected: " .. defline)
print("fallback rows " .. fallbackrows:to(str)
    .. " (requested=default selected=interpreter reason=jit-declined)")
print("interp-vs-default: AGREE " .. defok:to(str) .. ", DIFFER " .. defbad:to(str)
    .. " (this is the path the world runs; the jit's default-off arm cannot be"
    .. " deleted on the jit column alone)")

if jitran == 0
    print("")
    print("STATED GAP: not one row was compiled by the jit — the two columns are")
    print("  the same program and this table cannot fail. Not reported as agreement.")
end

_hostarch = _chomp(_capture("uname -m"))
_floordef = "0"
if _hostarch == "arm64" or _hostarch == "aarch64"
    _floordef = "69"
end
floor: i64 = to(i64)(_getenv("JIT_FLOOR", _floordef))
if jitran < floor
    print("*** JIT ENGAGEMENT REGRESSION: " .. jitran:to(str) .. " < floor " .. floor:to(str) .. " ***")
    return 1
end

budget: i64 = to(i64)(_getenv("DUO_WASM_UNSUPPORTED", "0"))
bad = 0
if crossbad != 0
    print("*** " .. crossbad:to(str) .. " row(s): THE JIT AND THE INTERPRETER DISAGREE ***")
    bad += 1
end
if defbad != 0
    print("*** " .. defbad:to(str) .. " row(s): THE DEFAULT PATH AND THE INTERPRETER DISAGREE ***")
    bad += 1
end
if diff != 0
    print("*** " .. diff:to(str) .. " row(s) DISAGREE with the oracle ***")
    bad += 1
end
if none != 0
    print("*** " .. none:to(str) .. " row(s) produced NOTHING (timeout or crash) ***")
    bad += 1
end
if bail != 0
    print("*** " .. bail:to(str) .. " row(s) returned the -1 sentinel with no diagnostic ***")
    bad += 1
end
if unsup > budget
    print("*** UNSUPPORTED went up: " .. unsup:to(str) .. " > budget " .. budget:to(str)
        .. " — a new opcode gap landed ***")
    bad += 1
end
if bad != 0
    return 1
end
0
