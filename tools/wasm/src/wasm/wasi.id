M.fd_fdstat_set_flags = wasi_fd_fdstat_set_flags
M.fd_fdstat_set_rights = wasi_fd_fdstat_set_rights
M.fd_filestat_get = wasi_fd_filestat_get
M.fd_filestat_set_size = wasi_fd_filestat_set_size
M.fd_filestat_set_times = wasi_fd_filestat_set_times
M.fd_pread = wasi_fd_pread
M.fd_prestat_dir_name = wasi_fd_prestat_dir_name
M.fd_prestat_get = wasi_fd_prestat_get
M.fd_pwrite = wasi_fd_pwrite
M.fd_read = wasi_fd_read
M.fd_readdir = wasi_fd_readdir
M.fd_renumber = wasi_fd_renumber
M.fd_seek = wasi_fd_seek
M.fd_sync = wasi_fd_sync
M.fd_tell = wasi_fd_tell
M.fd_write = wasi_fd_write
M.path_create_directory = wasi_path_create_directory
M.path_filestat_get = wasi_path_filestat_get
M.path_filestat_set_times = wasi_path_filestat_set_times
M.path_link = wasi_path_link
M.path_open = wasi_path_open
M.path_readlink = wasi_path_readlink
M.path_remove_directory = wasi_path_remove_directory
M.path_rename = wasi_path_rename
M.path_symlink = wasi_path_symlink
M.path_unlink_file = wasi_path_unlink_file
M.poll_oneoff = wasi_poll_oneoff
M.proc_exit = wasi_proc_exit
M.proc_raise = wasi_proc_raise
M.random_get = wasi_random_get
M.sched_yield = wasi_sched_yield
M.sock_accept = wasi_sock_accept
M.sock_recv = wasi_sock_recv
M.sock_send = wasi_sock_send
M.sock_shutdown = wasi_sock_shutdown
M
