# the engine WASI host implementation (Preview 1/2/3)
# Replaces wart's src/wasm/wasi.zig (113K) + wasi/*.zig (~200K) with ~250 lines
# Key insight: Duo's table dispatch + closures = trivial host binding

global mem_mod = mem
global string_mod = string

# ═══════════════════════════════════════════════════════════════
# WASI errno codes
# ═══════════════════════════════════════════════════════════════
ERRNO = {
  success = 0, badf = 8, inval = 28, nosys = 52, overflow = 61,
  perm = 63, io = 29, noent = 44, exist = 20, again = 6,
}

# ═══════════════════════════════════════════════════════════════
# WASI Preview 1 — fd_write, fd_read, proc_exit, args, environ, clocks
#
# `rt_mod` holds the runtime module, handed over by runtime.register at
# registration time. runtime requires wasi, so wasi must not require runtime
# back — that cycle is what forced the old per-function lazy `req`.
global rt_mod: any = nil
# ═══════════════════════════════════════════════════════════════

fun wasi_fd_write(rt, args)
  fd = args[1]
  iovs_ptr = args[2]
  iovs_len = args[3]
  nwritten_ptr = args[4]

  runtime = rt_mod
  total = 0
  for i = 0, iovs_len - 1
    base_addr = iovs_ptr + i * 8
    buf_ptr = runtime.mem_load_i32(rt, base_addr)
    buf_len = runtime.mem_load_i32(rt, base_addr + 4)

    # Read bytes from WASM memory
    data = ""
    for j = 0, buf_len - 1
      data = data .. mem_mod.read_byte(rt.memory, buf_ptr + j):char()
    end

    if os.getenv("DUO_WASM_TRACE_FD")
      io.stderr:write("[fd_write fd=" .. tostring(fd) .. " iov=" .. tostring(i)
        .. "/" .. tostring(iovs_len) .. " ptr=" .. tostring(buf_ptr)
        .. " len=" .. tostring(buf_len) .. " got=" .. tostring(#data) .. "]\n")
    end

    if fd == 1
      io.write(data)
    elseif fd == 2
      io.stderr:write(data)
    end
    total = total + buf_len
  end

  runtime.mem_store_i32(rt, nwritten_ptr, total)
  ERRNO.success
end

fun wasi_fd_read(rt, args)
  fd = args[1]
  iovs_ptr = args[2]
  iovs_len = args[3]
  nread_ptr = args[4]

  runtime = rt_mod
  total = 0
  # Simplified: stdin read
  if fd == 0
    for i = 0, iovs_len - 1
      base_addr = iovs_ptr + i * 8
      buf_ptr = runtime.mem_load_i32(rt, base_addr)
      buf_len = runtime.mem_load_i32(rt, base_addr + 4)
      data = io.read(buf_len)
      if data
        for j = 1, #data
          mem_mod.write_byte(rt.memory, buf_ptr + j - 1, data:byte(j))
        end
        total = total + #data
      end
    end
  end

  runtime.mem_store_i32(rt, nread_ptr, total)
  ERRNO.success
end

fun wasi_fd_fdstat_get(rt, args)
  fd = args[1]
  ptr = args[2]
  runtime = rt_mod
  filetype = 2 # character device for stdio fds
  flags = 0
  if fd ~= 0 and fd ~= 1 and fd ~= 2
    filetype = 0
  else
    # stdout/stderr are treated as non-tty so line-buffered output flushes
    # on newline instead of waiting for __stdio_exit (which the engine does not emulate).
    if fd == 1 or fd == 2
      flags = 4
    end
  end
  runtime.mem_write_byte(rt, ptr, filetype)
  runtime.mem_store_i32(rt, ptr + 2, flags)
  runtime.mem_store_i32(rt, ptr + 4, 0)
  # rights_base / rights_inheriting: grant all rights so wasi-libc's
  # write()/read() rights checks never reject stdio operations.
  runtime.mem_store_i32(rt, ptr + 8, -1)
  runtime.mem_store_i32(rt, ptr + 12, -1)
  runtime.mem_store_i32(rt, ptr + 16, -1)
  runtime.mem_store_i32(rt, ptr + 20, -1)
  ERRNO.success
end

fun wasi_fd_close(rt, args)
  ERRNO.success
end

fun wasi_fd_seek(rt, args)
  ERRNO.success
end

fun wasi_fd_prestat_get(rt, args)
  ERRNO.badf
end

fun wasi_fd_prestat_dir_name(rt, args)
  ERRNO.badf
end

fun wasi_proc_exit(rt, args)
  os.exit(args[1])
end

fun wasi_args_sizes_get(rt, args)
  runtime = rt_mod
  argc_ptr = args[1]
  argv_buf_size_ptr = args[2]
  argv = rt.args or {"wasm"}
  buf_size = 0
  for i = 1, #argv
    buf_size = buf_size + #argv[i] + 1
  end
  runtime.mem_store_i32(rt, argc_ptr, #argv)
  runtime.mem_store_i32(rt, argv_buf_size_ptr, buf_size)
  ERRNO.success
end

fun wasi_args_get(rt, args)
  runtime = rt_mod
  argv_ptr = args[1]
  argv_buf_ptr = args[2]
  argv = rt.args or {"wasm"}
  cursor = argv_buf_ptr
  for i = 1, #argv
    s = argv[i]
    runtime.mem_store_i32(rt, argv_ptr + (i - 1) * 4, cursor)
    for j = 1, #s
      mem_mod.write_byte(rt.memory, cursor + j - 1, s:byte(j))
    end
    mem_mod.write_byte(rt.memory, cursor + #s, 0)
    cursor = cursor + #s + 1
  end
  ERRNO.success
end

fun wasi_environ_sizes_get(rt, args)
  runtime = rt_mod
  runtime.mem_store_i32(rt, args[1], 0)
  runtime.mem_store_i32(rt, args[2], 0)
  ERRNO.success
end

fun wasi_environ_get(rt, args)
  ERRNO.success
end

fun wasi_clock_time_get(rt, args)
  runtime = rt_mod
  clock_id = args[1]
  precision = args[2]
  time_ptr = args[3]
  t = time.now_ns()
  runtime.mem_store_i64(rt, time_ptr, t)
  ERRNO.success
end

fun wasi_clock_res_get(rt, args)
  runtime = rt_mod
  runtime.mem_store_i64(rt, args[2], 1)  # nanosecond resolution
  ERRNO.success
end

fun wasi_random_get(rt, args)
  buf_ptr = args[1]
  buf_len = args[2]
  for i = 0, buf_len - 1
    mem_mod.write_byte(rt.memory, buf_ptr + i, 0:random(255))
  end
  ERRNO.success
end

# ═══════════════════════════════════════════════════════════════
# WASI Preview 2 stubs (component model host bindings)
# ═══════════════════════════════════════════════════════════════
fun wasi_p2_io_poll(rt, args)
  ERRNO.success
end
fun wasi_p2_io_streams(rt, args)
  ERRNO.success
end
fun wasi_p2_clocks(rt, args)
  wasi_clock_time_get(rt, args)
end
fun wasi_p2_random(rt, args)
  wasi_random_get(rt, args)
end
fun wasi_p2_filesystem(rt, args)
  ERRNO.nosys
end
fun wasi_p2_sockets(rt, args)
  ERRNO.nosys
end
fun wasi_p2_http(rt, args)
  ERRNO.nosys
end

# ═══════════════════════════════════════════════════════════════
# Registration table
# ═══════════════════════════════════════════════════════════════
global host_functions = {
  ["wasi_snapshot_preview1.fd_write"]           = wasi_fd_write,
  ["wasi_snapshot_preview1.fd_read"]            = wasi_fd_read,
  ["wasi_snapshot_preview1.fd_fdstat_get"]      = wasi_fd_fdstat_get,
  ["wasi_snapshot_preview1.fd_close"]           = wasi_fd_close,
  ["wasi_snapshot_preview1.fd_seek"]            = wasi_fd_seek,
  ["wasi_snapshot_preview1.fd_prestat_get"]     = wasi_fd_prestat_get,
  ["wasi_snapshot_preview1.fd_prestat_dir_name"]= wasi_fd_prestat_dir_name,
  ["wasi_snapshot_preview1.proc_exit"]          = wasi_proc_exit,
  ["wasi_snapshot_preview1.args_sizes_get"]     = wasi_args_sizes_get,
  ["wasi_snapshot_preview1.args_get"]           = wasi_args_get,
  ["wasi_snapshot_preview1.environ_sizes_get"]  = wasi_environ_sizes_get,
  ["wasi_snapshot_preview1.environ_get"]        = wasi_environ_get,
  ["wasi_snapshot_preview1.clock_time_get"]     = wasi_clock_time_get,
  ["wasi_snapshot_preview1.clock_res_get"]      = wasi_clock_res_get,
  ["wasi_snapshot_preview1.random_get"]         = wasi_random_get,
  # Preview 2
  ["wasi:io/poll@0.2.0.poll"]                   = wasi_p2_io_poll,
  ["wasi:io/streams@0.2.0.read"]               = wasi_p2_io_streams,
  ["wasi:clocks/monotonic-clock@0.2.0.now"]    = wasi_p2_clocks,
  ["wasi:random/random@0.2.0.get-random-bytes"]= wasi_p2_random,
}

fun wasi_register(rt, runtime)
  rt_mod = runtime
  # Register Preview 1 host functions explicitly (table iteration is currently
  # fragile in the Duo generic-for codegen).
  runtime.register_import(rt, "wasi_snapshot_preview1", "fd_write",           host_functions["wasi_snapshot_preview1.fd_write"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "fd_read",            host_functions["wasi_snapshot_preview1.fd_read"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "fd_fdstat_get",      host_functions["wasi_snapshot_preview1.fd_fdstat_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "fd_close",           host_functions["wasi_snapshot_preview1.fd_close"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "fd_seek",            host_functions["wasi_snapshot_preview1.fd_seek"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "fd_prestat_get",     host_functions["wasi_snapshot_preview1.fd_prestat_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "fd_prestat_dir_name", host_functions["wasi_snapshot_preview1.fd_prestat_dir_name"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "proc_exit",          host_functions["wasi_snapshot_preview1.proc_exit"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "args_sizes_get",      host_functions["wasi_snapshot_preview1.args_sizes_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "args_get",            host_functions["wasi_snapshot_preview1.args_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "environ_get",         host_functions["wasi_snapshot_preview1.environ_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "environ_sizes_get",  host_functions["wasi_snapshot_preview1.environ_sizes_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "clock_time_get",      host_functions["wasi_snapshot_preview1.clock_time_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "clock_res_get",       host_functions["wasi_snapshot_preview1.clock_res_get"])
  runtime.register_import(rt, "wasi_snapshot_preview1", "random_get",          host_functions["wasi_snapshot_preview1.random_get"])
end

# ═══════════════════════════════════════════════════════════════
# Module exports
# ═══════════════════════════════════════════════════════════════
M = {}
M.register = wasi_register
M.ERRNO = ERRNO
M.host_functions = host_functions
M
