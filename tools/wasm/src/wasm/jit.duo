-- the engine JIT compiler stub
-- Strategy: emit C and invoke clang -O2 to produce a shared library.
-- Codegen prefers native i64 / str throughout; calls are kept in
-- statement position so the compiler emits direct C calls rather than
-- lua_invoke indirect dispatch (which previously failed to wrap
-- function references with their lua-arity adapters).

req "std.os"
req "std.fmt"

-- ═══════════════════════════════════════════════════════════════
-- valtype_to_c — translate a WASM value type byte to a C type name.
-- Defined first so callers can dispatch directly without forward
-- references.
-- ═══════════════════════════════════════════════════════════════
fun valtype_to_c(vt: i64): str
  match vt
  case 0x7F "int32_t"
  case 0x7E "int64_t"
  case 0x7D "float"
  case 0x7C "double"
  else "int64_t"
  end
end

-- ═══════════════════════════════════════════════════════════════
-- emit_c_function — produce a C source string for one WASM function.
-- Calls to valtype_to_c go through locals (statement form) so the
-- codegen wraps them in __lua arity adapters correctly.
-- ═══════════════════════════════════════════════════════════════
fun emit_c_function(mod: any, func_idx: i64, code: any, sig: any): str
  lines: any = {}
  lines[#lines + 1] = "#include <stdint.h>"
  lines[#lines + 1] = "#include <math.h>"
  lines[#lines + 1] = ""

  n_params: i64 = #sig.params
  n_locals: i64 = #code.locals
  n_results: i64 = #sig.results

  -- Determine return type. Extract the table lookup to a native i64
  -- first so the call to valtype_to_c gets a native int64_t argument.
  ret_type: str = "void"
  if n_results > 0
    r1: i64 = sig.results[1]
    ret_type = valtype_to_c(r1)
  end

  -- Build parameter list.
  params: any = {}
  for i = 1, n_params
    p: i64 = sig.params[i]
    c_type: str = valtype_to_c(p)
    params[i] = c_type .. " p" .. tostring(i - 1)
  end
  params[#params + 1] = "uint8_t* memory"
  lines[#lines + 1] = ret_type .. " ward_jit_f" .. tostring(func_idx) ..
    "(" .. table.concat(params, ", ") .. ") {"

  -- Locals.
  for i = 1, n_locals
    l: i64 = code.locals[i]
    l_type: str = valtype_to_c(l)
    lines[#lines + 1] = "  " .. l_type .. " l" .. tostring(i + n_params - 1) .. " = 0;"
  end

  lines[#lines + 1] = "  // TODO: bytecode-to-C translation"
  lines[#lines + 1] = "  return 0;"
  lines[#lines + 1] = "}"

  table.concat(lines, "\n")
end

-- ═══════════════════════════════════════════════════════════════
-- compile_function — JIT: compile a hot WASM function to a .so.
-- ═══════════════════════════════════════════════════════════════
fun compile_function(mod: any, func_idx: i64): any
  n_imports: i64 = #mod.imports
  code_idx: i64 = func_idx - n_imports
  code: any = mod.code[code_idx + 1]
  type_idx: i64 = mod.functions[code_idx + 1]
  sig: any = mod.types[type_idx + 1]

  -- Call in statement form so the codegen emits a direct C call.
  c_src: str = emit_c_function(mod, func_idx, code, sig)

  tmp_c: str = os.tmpname() .. ".c"
  tmp_so: str = os.tmpname() .. ".so"
  os.write_file(tmp_c, c_src)
  os.exec("clang -O2 -shared -o " .. tmp_so .. " " .. tmp_c)
  os.remove(tmp_c)

  { path = tmp_so, func_idx = func_idx }
end

-- ═══════════════════════════════════════════════════════════════
-- Tiered JIT threshold.
-- ═══════════════════════════════════════════════════════════════
fun tiered_new(): any
  {
    hot_counts = {},
    threshold = 100,
    compiled = {},
  }
end

fun tiered_should_compile(jit: any, func_idx: i64): bool
  prev: i64 = jit.hot_counts[func_idx] or 0
  new_count: i64 = prev + 1
  jit.hot_counts[func_idx] = new_count
  thr: i64 = jit.threshold
  new_count >= thr
end

M = {}
M.compile_function = compile_function
M.emit_c_function = emit_c_function
M.tiered_new = tiered_new
M.tiered_should_compile = tiered_should_compile
M