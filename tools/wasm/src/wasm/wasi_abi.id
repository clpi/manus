# wasi_snapshot_preview1 — THE ABI TABLE, shared by every implementation.
#
# WHY THIS FILE EXISTS. There are two host implementations of preview1 in this
# tree and there has to be: `src/wasm/wasi.id` is a host module over an `rt`
# object, and `src/engine.id` performs its imports INLINE. They cannot be
# merged, and the reason is a toolchain limit that was measured, not assumed:
#
#   * every preview1 function writes its result into GUEST LINEAR MEMORY, so a
#     host implementation must be handed the engine's memory block;
#   * the engine's linear memory is a `mem.alloc` pointer local;
#   * a `mem.alloc` pointer passed through a FUNCTION boundary is silently
#     corrupted — measured: `poke(b,3,77)` through a `(p: ptr)` parameter left
#     `mem.read_byte(b,3)` reading 0 and a `peek(b,3)` through the same
#     parameter answering 5. Through a `req` boundary it segfaults;
#   * `mem.read_byte`/`mem.write_byte` REFUSE an integer address
#     ("argument 1 must be a pointer"), so the address cannot be marshalled as
#     a scalar either.
#
# So the engine cannot call `wasi.id`, and `wasi.id` cannot reach the engine's
# memory. What CAN be shared is everything that is not a memory access: the
# function roster, the numbering, and the errno policy. All of it lives here,
# both implementations read it from here, and a policy change therefore cannot
# land in one and miss the other. That is the part of the divergence that was
# actually dangerous: an errno that differs between two hosts is invisible
# until a guest hits it.
#
# EVERY VALUE BELOW WAS MEASURED against wasmtime 47.0.3 with a single-import
# probe, not read off the witx. The probes are regenerated by the differential
# harness; the measurements they produced are quoted at each entry that is not
# simply `badf`.

# ── errno ordinals (the witx enumeration; the ordinal IS the ABI) ──────────
ERRNO_success = 0
ERRNO_badf = 8
ERRNO_inval = 28
ERRNO_nosys = 52
ERRNO_notsup = 58
ERRNO_spipe = 70

# ── filetype ordinals ─────────────────────────────────────────────────────
FILETYPE_unknown = 0
FILETYPE_character_device = 2

# ── clock ids ─────────────────────────────────────────────────────────────
CLOCK_realtime = 0
CLOCK_monotonic = 1
CLOCK_process_cputime = 2
CLOCK_thread_cputime = 3

# ── the roster ────────────────────────────────────────────────────────────
# 46 functions, alphabetical. The INDEX is the identity both implementations
# dispatch on, so the order here is load-bearing: do not reorder, only append
# (preview1 is frozen, so there is nothing to append).
NAMES = {
  "args_get",
  "args_sizes_get",
  "clock_res_get",
  "clock_time_get",
  "environ_get",
  "environ_sizes_get",
  "fd_advise",
  "fd_allocate",
  "fd_close",
  "fd_datasync",
  "fd_fdstat_get",
  "fd_fdstat_set_flags",
  "fd_fdstat_set_rights",
  "fd_filestat_get",
  "fd_filestat_set_size",
  "fd_filestat_set_times",
  "fd_pread",
  "fd_prestat_dir_name",
  "fd_prestat_get",
  "fd_pwrite",
  "fd_read",
  "fd_readdir",
  "fd_renumber",
  "fd_seek",
  "fd_sync",
  "fd_tell",
  "fd_write",
  "path_create_directory",
  "path_filestat_get",
  "path_filestat_set_times",
  "path_link",
  "path_open",
  "path_readlink",
  "path_remove_directory",
  "path_rename",
  "path_symlink",
  "path_unlink_file",
  "poll_oneoff",
  "proc_exit",
  "proc_raise",
  "random_get",
  "sched_yield",
  "sock_accept",
  "sock_recv",
  "sock_send",
  "sock_shutdown",
}

wasi_name: str = (i: i64)
  # if/else with an explicit false path — see the note on `wasi_static` for
  # what the `if <cond> / return` + bare-tail shape does inside a req'd module.
  n = NAMES[i]
  r = ""
  if n != nil
    r = n
  r

# ── static policy ─────────────────────────────────────────────────────────
# `wasi_static(i)` is the errno a function answers for EVERY input, or -1 when
# the answer depends on an argument or the call has an effect. -1 means "the
# implementation must do the work"; it never means "return success".
#
# SANDBOX SHAPE this is derived from: exactly three descriptors (0/1/2), no
# preopened directories, no sockets. A capability that does not exist answers
# `badf`; it never answers `success`.
wasi_static: i64 = (i: i64)
  # ONE accumulator and an if/elseif chain that ENDS IN `else`. Written as a
  # sequence of `if <cond> / return <errno>` guards ending in a bare `-1`, the
  # compiler reports "`if` without `else` leaves the function with no value on
  # the false path" — and inside a `req`'d module that diagnostic does NOT
  # fail the build: the module compiles and the LAST guard returns a wrong
  # constant. Measured: `static_errno(43..46)` answered 7 where the source
  # says 8, so every sock_* differed from wasmtime by one. The same source
  # compiled as a top-level program is a hard error. Do not reintroduce the
  # guard-sequence shape here.
  r: i64 = -1
  if i <= 4
    # args_get, args_sizes_get, clock_res_get, clock_time_get
    r = -1
  elseif i == 5
    # environ_get: the environment world is empty by policy, so there is
    # nothing to write and `success` is the whole answer. MEASURED: 0.
    r = ERRNO_success
  elseif i == 6
    # environ_sizes_get writes two zero counts
    r = -1
  elseif i == 7 or i == 8
    # fd_advise / fd_allocate: MEASURED badf on fd 0, 1, 2 AND on 999 — stdio
    # carries no such right, so there is no fd for which this succeeds.
    r = ERRNO_badf
  elseif i == 9
    # fd_close: depends on the fd (success on stdio, badf otherwise)
    r = -1
  elseif i == 10
    # fd_datasync: MEASURED badf on 0, 1, 2 and 999
    r = ERRNO_badf
  elseif i == 11
    # fd_fdstat_get: depends on the fd
    r = -1
  elseif i == 12 or i == 13
    # fd_fdstat_set_flags / fd_fdstat_set_rights: MEASURED badf on stdio too
    r = ERRNO_badf
  elseif i == 14
    # fd_filestat_get: depends on the fd
    r = -1
  elseif i == 15 or i == 16
    # fd_filestat_set_size / fd_filestat_set_times
    r = ERRNO_badf
  elseif i == 17
    # fd_pread: MEASURED badf on stdio and on 999
    r = ERRNO_badf
  elseif i == 18 or i == 19
    # fd_prestat_dir_name / fd_prestat_get: no preopens exist. MEASURED badf
    # on 0, 1, 2 and on 3 (the first descriptor a preopen would occupy).
    r = ERRNO_badf
  elseif i == 20
    # fd_pwrite: NOT uniformly badf. MEASURED spipe (70) on fd 1 and fd 2 — a
    # positional write to a stream is refused for being unseekable, not for
    # the descriptor being absent — and badf (8) on fd 0 and on 999.
    r = -1
  elseif i == 21
    # fd_read: depends on the fd
    r = -1
  elseif i == 22 or i == 23
    # fd_readdir / fd_renumber
    r = ERRNO_badf
  elseif i == 24
    # fd_seek: MEASURED spipe on 0, 1, 2; badf otherwise
    r = -1
  elseif i == 25
    # fd_sync
    r = ERRNO_badf
  elseif i == 26
    # fd_tell: same shape as fd_seek
    r = -1
  elseif i == 27
    # fd_write: depends on the fd
    r = -1
  elseif i >= 28 and i <= 37
    # every path_*: no preopen exists, so no directory descriptor can be
    # resolved. MEASURED badf against fd 3 with no --dir.
    r = ERRNO_badf
  elseif i == 38
    # poll_oneoff: MEASURED inval (28) for nsubscriptions = 0, success (0) for
    # a clock subscription. Argument-dependent.
    r = -1
  elseif i == 39
    # proc_exit: terminates. Never returns a value at all.
    r = -1
  elseif i == 40
    # proc_raise: deprecated. MEASURED notsup (58) for signal 0 and signal 1.
    r = ERRNO_notsup
  elseif i == 41
    # random_get: fills a buffer
    r = -1
  elseif i == 42
    # sched_yield: MEASURED success
    r = ERRNO_success
  elseif i >= 43 and i <= 46
    # every sock_*: no socket world is admitted
    r = ERRNO_badf
  else
    r = -1
  r

# argv[0], stated once.
#
# MEASURED: wasmtime supplies the module's BASENAME as argv[0], not the path it
# was invoked with — `/tmp/ab.wasm` and `ab.wasm` both report an argv buffer of
# 8 bytes, i.e. `strlen("ab.wasm") + 1`. Both hosts here use the same rule so a
# guest that prints its own argv[0] agrees with wasmtime.
argv0_of: str = (path: str)
  n: i64 = string.len(path)
  k: i64 = n
  cut: i64 = 0
  while k >= 1
    if string.byte(path, k) == 47 and cut == 0
      cut = k
    k -= 1
  string.sub(path, cut + 1, n)

# fd policy, stated once. `fd_kind` is 1 for a descriptor this host holds
# (0 stdin, 1 stdout, 2 stderr) and 0 for every other number.
fd_kind: i64 = (fd: i64)
  r: i64 = 0
  if fd == 0 or fd == 1 or fd == 2
    r = 1
  r

# ── proc_exit: the PROCESS STATUS, which is not the argument ──────────────
#
# MEASURED against wasmtime 47.0.3, one single-import probe per code:
#
#   0 -> 0    1 -> 1    42 -> 42   100 -> 100   124 -> 124   125 -> 125
#   126 -> 1  127 -> 1  128 -> 1   200 -> 1     255 -> 1
#
# i.e. 0..125 pass through and 126 and above are NOT a status at all: wasmtime
# refuses the run ("failed to invoke `run`" on stderr) and exits 1. preview1
# reserves 126+ and this is where the boundary actually is — measured exactly,
# 125 passes and 126 does not.
#
# This matters because both hosts previously called `os.exit(code)` with the
# raw argument, so a guest calling `proc_exit(255)` produced status 255 where
# wasmtime produces 1. A guest can otherwise fabricate a status the oracle
# never emits, which is the same class of bug as an import performed for a
# module that never asked: the runtime inventing an observable.
PROC_EXIT_MAX = 125

proc_exit_status: i64 = (code: i64)
  r: i64 = code
  if code < 0 or code > PROC_EXIT_MAX
    r = 1
  r

# 1 when the code is outside what preview1 permits, so the host can say so on
# stderr before exiting rather than exiting 1 for an unstated reason.
proc_exit_refused: i64 = (code: i64)
  r: i64 = 0
  if code < 0 or code > PROC_EXIT_MAX
    r = 1
  r

# The filetype both hosts report for descriptors 0/1/2.
#
# MEASURED, three ways, because this one is environment-dependent in wasmtime:
# with stdout a PIPE it reports 0 (unknown); with stdout a regular FILE it
# reports 0; on a TTY it reports 2 (character_device). This toolchain exposes
# no `isatty`, so the engine cannot make that distinction and reports the
# non-tty answer, which is the one that holds whenever output is captured —
# i.e. in every automated comparison. On an interactive terminal wasmtime says
# 2 and this says 0; that difference is stated, not hidden.
STDIO_FILETYPE = FILETYPE_unknown

M = {}
M.count = 46
M.module_name = "wasi_snapshot_preview1"
M.name = wasi_name
M.static_errno = wasi_static
M.fd_kind = fd_kind
M.argv0_of = argv0_of
M.ERRNO_success = ERRNO_success
M.ERRNO_badf = ERRNO_badf
M.ERRNO_inval = ERRNO_inval
M.ERRNO_nosys = ERRNO_nosys
M.ERRNO_notsup = ERRNO_notsup
M.ERRNO_spipe = ERRNO_spipe
M.FILETYPE_unknown = FILETYPE_unknown
M.FILETYPE_character_device = FILETYPE_character_device
M.stdio_filetype = STDIO_FILETYPE
M.proc_exit_status = proc_exit_status
M.proc_exit_refused = proc_exit_refused
M.PROC_EXIT_MAX = PROC_EXIT_MAX
# Indices of the functions whose answer is NOT a constant. Both
# implementations read these rather than writing the numbers down twice.
M.i_args_get = 1
M.i_args_sizes_get = 2
M.i_clock_res_get = 3
M.i_clock_time_get = 4
M.i_environ_sizes_get = 6
M.i_fd_close = 9
M.i_fd_fdstat_get = 11
M.i_fd_filestat_get = 14
M.i_fd_pwrite = 20
M.i_fd_read = 21
M.i_fd_seek = 24
M.i_fd_tell = 26
M.i_fd_write = 27
M.i_poll_oneoff = 38
M.i_proc_exit = 39
M.i_random_get = 41
M
