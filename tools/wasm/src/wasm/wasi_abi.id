
ERRNO_success = 0
ERRNO_badf = 8
ERRNO_inval = 28
ERRNO_nosys = 52
ERRNO_notsup = 58
ERRNO_spipe = 70
ERRNO_notcapable = 76

FILETYPE_unknown = 0
FILETYPE_character_device = 2

CLOCK_realtime = 0
CLOCK_monotonic = 1
CLOCK_process_cputime = 2
CLOCK_thread_cputime = 3

NAMES = {
  "args_get",
  "args_sizes_get",
  "clock_res_get",
  "clock_time_get",
  "environ_get",
  "environ_sizes_get",
  "fd_advise",
  "fd_allocate",
  "fd_close",
  "fd_datasync",
  "fd_fdstat_get",
  "fd_fdstat_set_flags",
  "fd_fdstat_set_rights",
  "fd_filestat_get",
  "fd_filestat_set_size",
  "fd_filestat_set_times",
  "fd_pread",
  "fd_prestat_dir_name",
  "fd_prestat_get",
  "fd_pwrite",
  "fd_read",
  "fd_readdir",
  "fd_renumber",
  "fd_seek",
  "fd_sync",
  "fd_tell",
  "fd_write",
  "path_create_directory",
  "path_filestat_get",
  "path_filestat_set_times",
  "path_link",
  "path_open",
  "path_readlink",
  "path_remove_directory",
  "path_rename",
  "path_symlink",
  "path_unlink_file",
  "poll_oneoff",
  "proc_exit",
  "proc_raise",
  "random_get",
  "sched_yield",
  "sock_accept",
  "sock_recv",
  "sock_send",
  "sock_shutdown",
}

wasi_name: str = (i: i64)
  n = NAMES[i]
  r = ""
  if n != nil
    r = n
  r

wasi_static: i64 = (i: i64)
  r: i64 = -1
  if i <= 4
    r = -1
  elseif i == 5
    r = ERRNO_success
  elseif i == 6
    r = -1
  elseif i == 7 or i == 8
    r = ERRNO_badf
  elseif i == 9
    r = -1
  elseif i == 10
    r = ERRNO_badf
  elseif i == 11
    r = -1
  elseif i == 12 or i == 13
    r = ERRNO_badf
  elseif i == 14
    r = -1
  elseif i == 15 or i == 16
    r = ERRNO_badf
  elseif i == 17
    r = ERRNO_badf
  elseif i == 18 or i == 19
    r = ERRNO_badf
  elseif i == 20
    r = -1
  elseif i == 21
    r = -1
  elseif i == 22 or i == 23
    r = ERRNO_badf
  elseif i == 24
    r = -1
  elseif i == 25
    r = ERRNO_badf
  elseif i == 26
    r = -1
  elseif i == 27
    r = -1
  elseif i >= 28 and i <= 37
    r = ERRNO_badf
  elseif i == 38
    r = -1
  elseif i == 39
    r = -1
  elseif i == 40
    r = ERRNO_notsup
  elseif i == 41
    r = -1
  elseif i == 42
    r = ERRNO_success
  elseif i >= 43 and i <= 46
    r = ERRNO_badf
  else
    r = -1
  r

argv0_of: str = (path: str)
  n: i64 = string.len(path)
  k: i64 = n
  cut: i64 = 0
  while k >= 1
    if string.byte(path, k) == 47 and cut == 0
      cut = k
    k -= 1
  string.sub(path, cut + 1, n)

fd_kind: i64 = (fd: i64)
  r: i64 = 0
  if fd == 0 or fd == 1 or fd == 2
    r = 1
  r

PROC_EXIT_MAX = 125

proc_exit_status: i64 = (code: i64)
  r: i64 = code
  if code < 0 or code > PROC_EXIT_MAX
    r = 1
  r

proc_exit_refused: i64 = (code: i64)
  r: i64 = 0
  if code < 0 or code > PROC_EXIT_MAX
    r = 1
  r

STDIO_FILETYPE = FILETYPE_unknown


grant_world: str = (i: i64)
  r: str = "device"
  if i == 1 or i == 2 or i == 39 or i == 40 or i == 42
    r = "process"
  elseif i == 3 or i == 4
    r = "clock"
  elseif i == 5 or i == 6
    r = "environment"
  elseif i >= 7 and i <= 37
    r = "filesystem"
  elseif i >= 43 and i <= 46
    r = "network"
  elseif i == 38 or i == 41
    r = "device"
  else
    r = ""
  r

grant_token_covers: i64 = (tok: str, i: i64)
  r: i64 = 0
  if tok == "all"
    r = 1
  elseif tok == grant_world(i)
    r = 1
  elseif tok == wasi_name(i)
    r = 1
  r

grant_token_known: i64 = (tok: str)
  r: i64 = 0
  if tok == "all" or tok == "none"
    r = 1
  elseif tok == "process" or tok == "clock" or tok == "environment"
    r = 1
  elseif tok == "filesystem" or tok == "network" or tok == "device"
    r = 1
  else
    k: i64 = 1
    while k <= 46
      if tok == wasi_name(k)
        r = 1
      k += 1
  r

grant_tok_at: str = (spec: str, a: i64)
  n: i64 = string.len(spec)
  b: i64 = a
  while b <= n and string.byte(spec, b) != 44
    b += 1
  string.sub(spec, a, b - 1)

grant_next_at: i64 = (spec: str, a: i64)
  n: i64 = string.len(spec)
  b: i64 = a
  while b <= n and string.byte(spec, b) != 44
    b += 1
  b + 1

grant_admits: i64 = (spec: str, i: i64)
  r: i64 = 0
  n: i64 = string.len(spec)
  a: i64 = 1
  while a <= n
    raw: str = grant_tok_at(spec, a)
    neg: i64 = 0
    tok: str = raw
    if string.len(raw) > 0 and string.byte(raw, 1) == 45
      neg = 1
      tok = string.sub(raw, 2, string.len(raw))
    if tok == "none"
      r = 0
    elseif grant_token_covers(tok, i) == 1
      if neg == 1
        r = 0
      else
        r = 1
    a = grant_next_at(spec, a)
  r

grant_bad_token: str = (spec: str)
  r: str = ""
  n: i64 = string.len(spec)
  a: i64 = 1
  while a <= n
    raw: str = grant_tok_at(spec, a)
    tok: str = raw
    if string.len(raw) > 0 and string.byte(raw, 1) == 45
      tok = string.sub(raw, 2, string.len(raw))
    if r == "" and grant_token_known(tok) == 0
      r = raw
    a = grant_next_at(spec, a)
  r

grant_is_total: i64 = (spec: str)
  r: i64 = 1
  k: i64 = 1
  while k <= 46
    if grant_admits(spec, k) == 0
      r = 0
    k += 1
  r

M = {}
M.count = 46
M.module_name = "wasi_snapshot_preview1"
M.name = wasi_name
M.static_errno = wasi_static
M.fd_kind = fd_kind
M.argv0_of = argv0_of
M.ERRNO_success = ERRNO_success
M.ERRNO_badf = ERRNO_badf
M.ERRNO_inval = ERRNO_inval
M.ERRNO_nosys = ERRNO_nosys
M.ERRNO_notsup = ERRNO_notsup
M.ERRNO_spipe = ERRNO_spipe
M.ERRNO_notcapable = ERRNO_notcapable
M.grant_world = grant_world
M.grant_admits = grant_admits
M.grant_bad_token = grant_bad_token
M.grant_is_total = grant_is_total
M.grant_token_known = grant_token_known
M.FILETYPE_unknown = FILETYPE_unknown
M.FILETYPE_character_device = FILETYPE_character_device
M.stdio_filetype = STDIO_FILETYPE
M.proc_exit_status = proc_exit_status
M.proc_exit_refused = proc_exit_refused
M.PROC_EXIT_MAX = PROC_EXIT_MAX
M.i_args_get = 1
M.i_args_sizes_get = 2
M.i_clock_res_get = 3
M.i_clock_time_get = 4
M.i_environ_sizes_get = 6
M.i_fd_close = 9
M.i_fd_fdstat_get = 11
M.i_fd_filestat_get = 14
M.i_fd_pwrite = 20
M.i_fd_read = 21
M.i_fd_seek = 24
M.i_fd_tell = 26
M.i_fd_write = 27
M.i_poll_oneoff = 38
M.i_proc_exit = 39
M.i_random_get = 41
M
