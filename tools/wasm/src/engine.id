  {159,  "f64.sqrt"},
  {160,  "f64.add"},
  {161,  "f64.sub"},
  {162,  "f64.mul"},
  {163,  "f64.div"},
  {164,  "f64.min"},
  {165,  "f64.max"},
  {166,  "f64.copysign"},
  {167,  "i32.wrap_i64"},
  {168,  "i32.trunc_f32_s"},
  {169,  "i32.trunc_f32_u"},
  {170,  "i32.trunc_f64_s"},
  {171,  "i32.trunc_f64_u"},
  {172,  "i64.extend_i32_s"},
  {173,  "i64.extend_i32_u"},
  {174,  "i64.trunc_f32_s"},
  {175,  "i64.trunc_f32_u"},
  {176,  "i64.trunc_f64_s"},
  {177,  "i64.trunc_f64_u"},
  {178,  "f32.convert_i32_s"},
  {179,  "f32.convert_i32_u"},
  {180,  "f32.convert_i64_s"},
  {181,  "f32.convert_i64_u"},
  {182,  "f32.demote_f64"},
  {183,  "f64.convert_i32_s"},
  {184,  "f64.convert_i32_u"},
  {185,  "f64.convert_i64_s"},
  {186,  "f64.convert_i64_u"},
  {187,  "f64.promote_f32"},
  {188,  "i32.reinterpret_f32"},
  {189,  "i64.reinterpret_f64"},
  {190,  "f32.reinterpret_i32"},
  {191,  "f64.reinterpret_i64"},
  {192,  "i32.extend8_s"},
  {193,  "i32.extend16_s"},
  {194,  "i64.extend8_s"},
  {195,  "i64.extend16_s"},
  {196,  "i64.extend32_s"},
  {208,  "ref.null"},
  {209,  "ref.is_null"},
  {210,  "ref.func"},
  {252,  "prefix.fc"},
  {253,  "prefix.simd"},
}
# derived end

opname: str = (op: i64)
  i: i64 = 1
  # `T:len()` on a TABLE answers 0 in this toolchain (measured: a 3-row
  # literal reports 0), so this loop never ran and every opcode was named
  # "(unknown)". Walking to the first nil observes the real row count.
  while OP_NAMES[i] != nil
    row = OP_NAMES[i]
    if row[1] == op
      return "(" .. row[2] .. ")"
    i += 1
  "(unknown)"

# -1 AS A NAME, AND WHY IT MAY NOT BE WRITTEN AS A LITERAL TAIL HERE.
#
# A function whose last statement is followed by a tail line that STARTS WITH
# `-` has the two joined into one expression by this toolchain. `i += 1`
# followed by a `-1` tail compiles to `i = (i + 0)`; `os.exit(70)` followed by a
# `-1` tail compiles to `return lua_sub(lua_os_exit(70), 1)`. Both are silent.
#
# The first one cost the entire JIT. `cmp_cond` below is a linear scan whose
# cursor is advanced by `i += 1` and whose miss value is `-1`, and its
# increment therefore compiled to `+ 0` — an INFINITE LOOP, entered on the
# first opcode that is not a comparison, i.e. on the first real body the
# emitter ever walked. Measured: `alu_word`, the byte-identical function four
# lines above it whose miss value is `0`, compiled correctly to `i = (i + 1)`.
# One character of difference in the tail, one function that hangs.
#
# Minimal repro, for the compiler side (27 lines): two identical linear scans
# ending `i += 1` / <tail>. tail `0` -> `i + 1`; tail `7` -> `i + 1`;
# tail `-1` -> `i + 0`; tail `-2` -> `i + -1`. The tail literal is being
# ADDED INTO the previous line's compound assignment, so the newline is not
# terminating the statement.
#
# Naming the constant is what makes the tail start with a letter. Do not
# inline these back to `-1`.
DECLINED: i64 = -1
NOCOND: i64 = -1

# A guard inside an arm that DOES exist refused: operand-stack underflow, a
# label/frame depth ceiling, a memory bound. The opcode is named because it
# localises the refusal, not because the opcode is missing.
bail: i64 = (op: i64, pos: i64)
  io.stderr:write("wasm: cannot execute opcode " .. op:to(str) .. " " .. opname(op) .. " at body offset " .. pos:to(str) .. " (unsupported operand shape, or an interpreter limit inside its arm)\n")
  os.exit(70)
  DECLINED

# No arm at all. This is the ranked-worklist signal the old `-1` swallowed: a
# corpus sweep now reports exactly which opcodes to implement next.
bailop: i64 = (op: i64, pos: i64)
  io.stderr:write("wasm: unimplemented opcode " .. op:to(str) .. " " .. opname(op) .. " at body offset " .. pos:to(str) .. "\n")
  os.exit(70)
  DECLINED

# `unreachable` is the MODULE trapping, which every conforming runtime does
# too. It is not a gap in the engine and must not be counted as one.
bailtrap: i64 = (pos: i64)
  io.stderr:write("wasm: wasm trap (unreachable) at body offset " .. pos:to(str) .. "\n")
  os.exit(71)
  DECLINED

# The decoder gave up before any opcode was reached, so there is no opcode to
# name # the module shape itself is what the engine cannot handle.
bailshape: i64 = (why: str)
  io.stderr:write("wasm: cannot decode module (" .. why .. ")\n")
  os.exit(1)
  DECLINED

# THE OTHER EXIT-1 REFUSAL: an import this host cannot satisfy because it is
# not a FUNCTION. It is a separate helper from `bailshape` for one reason —
# `bailshape` says "cannot decode module", and a module with an imported memory
# DECODES PERFECTLY WELL. Telling a guest its module is malformed when the
# module is fine, and the host is simply not offering what it asked for, is the
# same class of lie as collapsing exit 1 into exit 5. The text still carries the
# words `unknown import`, because that is the event, and because it is the event
# wasmtime reports for the identical module.
bailimport: i64 = (mod: str, field: str, kd: i64)
  kind: str = "entity of an unrecognised kind"
  if kd == 1
    kind = "table"
  elseif kd == 2
    kind = "memory"
  elseif kd == 3
    kind = "global"
  io.stderr:write("wasm: unknown import \"" .. mod .. "\".\"" .. field .. "\": an imported " .. kind .. "\n")
  io.stderr:write("      this host offers wasi_snapshot_preview1 functions to import and nothing else\n")
  io.stderr:write("      refused at instantiation, before any guest code ran\n")
  os.exit(1)
  DECLINED

# `len` bytes of the module image from `at`, as a `str`, for a DIAGNOSTIC only.
# `string.sub` is never used on the image anywhere in this file: the image is a
# `str` holding a wasm binary, whose first byte is 0x00, and a NUL-terminated
# view of it is empty. Built a character at a time from `:byte()`, which is how
# every other read of the image works, and only on a refusal path, so the O(n)
# concatenation is paid once per refused module and never in a run.
bytes_str: str = (img: str, at: i64, len: i64)
  out: str = ""
  k: i64 = 0
  while k < len
    out = out .. string.char(img:byte(at + k))
    k += 1
  out

# A CAPABILITY REFUSAL, and it exits 5 so that it is not the same event as any
# other refusal this engine can produce.
#
#   1   the module is malformed, or names an import this host does not HAVE
#   4   the jit was required and could not run
#   5   the module names an import this host HAS and was NOT GRANTED
#   70  an opcode with no arm            71  the guest trapped
#
# The 1/5 split is the whole point. `unknown import` means the name does not
# exist; `outside the grant` means it exists, this host can perform it, and the
# policy said no. A guest — or a harness — that could not tell those apart
# would be told a lie about why it did not run. wasmtime cannot draw this
# distinction at all: its only withhold is declining to define the import, so
# both cases arrive as one "unknown import" instantiation failure and exit 1.
# That divergence is deliberate and is recorded in docs/wasm-capability.md §4.
bailgrant: i64 = (mod: str, field: str, spec: str)
  io.stderr:write("wasm: import \"" .. mod .. "\".\"" .. field .. "\" is outside this guest's grant\n")
  io.stderr:write("      grant: DUO_WASM_GRANT=" .. spec .. "\n")
  io.stderr:write("      refused at instantiation, before any guest code ran\n")
  os.exit(5)
  DECLINED

# The written policy itself is wrong — a token that names no function and no
# world. Refused BEFORE enforcement, because the alternative is that a typo
# silently withholds and the diagnostic then blames the guest. `test_utils.id`
# in docs/capability-algebra.md §3.2 is the same class of accident one level up:
# a capability decided by a spelling nobody wrote on purpose.
bailgrantspec: i64 = (tok: str, spec: str)
  io.stderr:write("wasm: DUO_WASM_GRANT names nothing with '" .. tok .. "'\n")
  io.stderr:write("      grant: DUO_WASM_GRANT=" .. spec .. "\n")
  io.stderr:write("      a token is `all`, `none`, a world (filesystem, process, environment,\n")
  io.stderr:write("      clock, network, device), or one wasi_snapshot_preview1 function name;\n")
  io.stderr:write("      a leading `-` withholds. Refusing rather than withholding by accident.\n")
  os.exit(5)
  DECLINED

# THE DEFAULT GRANT, and it is a RULING rather than a convenience.
#
# Deny-by-default is the safe reading and this is not it. The argument for
# `all`, stated so it can be attacked:
#
#  1. THE DIFFERENTIAL IS THE CONTRACT. This engine's correctness claim is 244
#     rows differenced against wasmtime by value. wasmtime grants the whole of
#     preview1 to any guest that names it; a host that denied by default would
#     disagree with the oracle on every row that touches an import, and the
#     disagreement would be POLICY, not behaviour. The measured cost is in
#     docs/wasm-capability.md §3: under `DUO_WASM_GRANT=none` the corpus loses
#     rows to refusal, and every one of those losses is this host declining to
#     be wasmtime.
#  2. A CAPABILITY THAT IS ON BY DEFAULT IS STILL A CAPABILITY, so long as the
#     default is WRITTEN and the withhold is REACHABLE. `none` is one token.
#     What was wrong before was not the default; it was that there was no knob
#     at any setting.
#  3. THE HONEST COST, said out loud: an opt-in capability protects only the
#     callers who ask. A guest run by a launcher that never sets
#     DUO_WASM_GRANT gets all 46, exactly as before. If this project wants
#     deny-by-default it is one constant below and 244 rows of oracle
#     divergence to argue about — that is a RULING for the language, not a
#     defect in this mechanism, and it is routed in docs/wasm-capability.md §6.
GRANT_DEFAULT = "all"

# The grant as WRITTEN by the launcher. Read in one place so the default is
# stated once. The guest cannot reach this: nothing in a .wasm file names an
# environment variable of the host process.
grant_spec: str = ()
  env("DUO_WASM_GRANT") or GRANT_DEFAULT

# 1 when a denied import should be admitted and answer `notcapable` at every
# call, instead of being refused at instantiation.
#
# WHY BOTH MODES EXIST. Refusing at instantiation is what wasmtime does with an
# import it cannot satisfy, so it is the mode that keeps this host comparable
# with the oracle. But it cannot answer the question a guest actually asks —
# "may I write?" — because the guest never runs to ask it. `errno` mode lets
# the guest run and DISCOVER the denial, which is the only way a program can
# adapt to a partial grant. It has no wasmtime counterpart and is therefore
# never the default.
grant_errno_mode: i64 = ()
  r: i64 = 0
  # THE `or ""` IS LOAD-BEARING AND IT IS NOT STYLE. `env(k)` answers nil for an
  # unset key — that is the presence test, and the reason the retired spelling
  # left this file — but comparing that nil against a STRING LITERAL SEGFAULTS
  # the produced binary. Minimal repro, re-measured against idol ae8fb29f on
  # 2026-08-15 after that defect was reported fixed:
  #
  #   main: void = ()
  #     if env("NOT_SET") == "errno"
  #       stdout:write("y\n")
  #   -> exit 139, NO OUTPUT AT ALL, on --backend=direct
  #
  # `env(k) == nil` is fine and `env(k) == "lit"` with the key SET is fine; it
  # is only the nil-against-a-literal comparison that dies. Binding first does
  # not dodge it (`v = env(k)` then `v == "errno"` also exits 139); giving the
  # binding a `str` type and a default does. So every comparison of an
  # environment read against a literal in this file goes through `or ""`, which
  # is what the retired spelling meant here — verified equal across unset /
  # empty / matching / other. Do not "simplify" it back. Routed to the lead in
  # docs/wasm-import-kinds.md §4.
  if (env("DUO_WASM_GRANT_MODE") or "") == "errno"
    r = 1
  r

# The JIT declines a whole body by returning -1, and `main` then runs the
# interpreter without saying so. That is why `hot_big.wasm` could print a
# correct answer 31x behind wasmtime for weeks: the answer was right and the
# refusal was invisible. `DUO_WASM_JIT_TRACE=1` makes every refusal name itself #
# the reason, the opcode, and the byte offset inside the body.
#
# Unlike `bail`/`bailop` this does NOT exit: declining to compile is legal, the
# interpreter still has to run. Only the silence was the bug.
jitbail: i64 = (why: str, op: i64, pos: i64)
  if env("DUO_WASM_JIT_TRACE")
    if op >= 0
      io.stderr:write("wasm: jit declined -- " .. why .. " -- opcode " .. op:to(str) .. " " .. opname(op) .. " at body offset " .. pos:to(str) .. "\n")
    else
      io.stderr:write("wasm: jit declined -- " .. why .. "\n")
  end
  DECLINED

# ── the JIT GATE, which is where the whole ARM64 emitter was lost ──────────
#
# The gate below `engine_main` read `jitm.arch() == "arm64"` and it was wrong
# in two independent ways at once, so the ~2,200 lines of ARM64 emitter in this
# file HAVE NEVER EXECUTED — not once — and every benchmark in this project
# attributing a 5x-18x gap to "the interpreter" was measuring the only engine
# there is.
#
#   1. `jit.arch` is a VALUE, not a function: `src/jit.zig` emits
#      `lua_table_init_lit(m, "arch", lua_val_lit("native"))`. Calling it
#      returns nil silently (measured: `src/probe_jit.id` prints `arch=nil`),
#      so the comparison was nil == "arm64", false, forever, with no diagnostic.
#   2. Its value is "native" and never "arm64", so even read correctly the
#      comparison fails.
#
# ...and a third, which is the one that actually matters and which fixing the
# string would NOT have found: THE JIT SUBSTRATE DOES NOT EXIST. `jit.alloc`,
# `jit.seal`, `jit.call2`, `jit.w32`, `jit.r32` and `jit.sym` are all nil at
# this revision — the `jit` table the compiler builds holds only
# on/off/flush/status/version/version_num/opt/os/arch. `src/probe_jit.id`, run
# at this revision, answers `arch=nil` / `jit: mmap refused` / `jit result=-1
# expect 42`. Correcting the arch string alone would have moved the failure
# from a silent `false` to a nil call on `jitm.alloc`.
#
# So both halves are checked, separately, and each names itself. The arch test
# accepts the value AND the call, and both "arm64" and "aarch64", because the
# spelling is being changed in `src/jit.zig` by another agent and a second
# string mismatch would reproduce exactly the bug this comment is about.
jit_is_arm64: i64 = ()
  r: i64 = 0
  av = jitm.arch
  if av == "arm64" or av == "aarch64"
    r = 1
  # Calling a string yields nil here rather than faulting (measured), so this
  # is safe whichever shape `arch` ends up with.
  ac = jitm.arch()
  if ac == "arm64" or ac == "aarch64"
    r = 1
  r

jit_arch_name: str = ()
  av = jitm.arch
  r: str = "nil"
  if av != nil
    r = to(str)(av)
  ac = jitm.arch()
  if ac != nil
    r = to(str)(ac)
  r

# THE SUBSTRATE SELF-TEST. Names the first thing that does not WORK, or "" when
# the substrate carries this engine end to end.
#
# It used to be six `jitm.X == nil` comparisons, and every one of them is a lie
# in both directions on this toolchain:
#
#   * FALSE ABSENT. `req "jit"` registers `lib/jit.id` in `duo_modules`, but the
#     generated `lua_require` tests the HARDCODED builtin names FIRST
#     (`else if (strcmp(name, "jit") == 0) mod = jit;`), so the binding still
#     holds the builtin table — which has no `alloc` — while every CALL through
#     that binding was compiled to a direct `jit__alloc(...)` against the real
#     Idol module and works. So the nil ladder reported `jit.alloc` missing for
#     a substrate that answers correctly, and the emitter stayed switched off.
#   * FALSE PRESENT, which is the dangerous direction. A member can be non-nil
#     and still DO NOTHING: `lib/jit.id`'s `w32` was
#     `static lua_Value jit__w32(...) { return lua_val_nil(); }` because
#     `@comp.c.emit` in statement position is dropped by the C backend. Present,
#     callable, and hollow. The JIT would have allocated a page, written 1,700
#     lines of instructions into the void, sealed a page of ZEROS and BRANCHED
#     INTO IT — an all-zero ARM64 word is `udf #0`, so the symptom is SIGILL
#     from inside generated code with no line of Idol to blame.
#
# So nothing here is asked whether it EXISTS; each thing is asked to DO ITS JOB
# and is checked by value. The order is load-bearing: the word writer is proved
# by READ-BACK, before a single byte is executed, so a hollow writer is a clean
# refusal and a fallback to the interpreter rather than a fault.
#
# Costs one 4 KiB mapping and two instructions, once per process, and only on a
# run that was already going to compile — `--interp` and DUO_WASM_ARGS refuse
# above this and never reach it.
jit_substrate_gap: str = ()
  probe = jitm.alloc(4096)
  if not probe
    return "jit.alloc refused the mapping"
  # 1. THE WORD WRITER, proved by read-back before anything is executed.
  #    ADD x0, x0, x1 / RET — chosen so the call below also proves that the
  #    two arguments ARRIVE, which is what the compiled entry sequence depends
  #    on (x0 = linear memory, x1 = globals).
  jitm.w32(probe, 0, 0x8B010000)
  jitm.w32(probe, 1, 0xD65F03C0)
  if jitm.r32(probe, 0) != 0x8B010000
    return "jit.w32 wrote nothing (jit.r32 read back " .. to(str)(jitm.r32(probe, 0)) .. ", expected 0x8B010000) -- the word writer is a no-op"
  if jitm.r32(probe, 1) != 0xD65F03C0
    return "jit.w32 wrote nothing at word 1 -- the word writer is a no-op"
  # 2. The address of an emitted buffer, which `call_indirect` bakes into the
  #    dispatch table it branches through.
  if jitm.addr(probe) == 0
    return "jit.addr answers 0 for a live buffer"
  # 3. Host symbol resolution, which every emitted call to `write`/`exit` needs.
  if jitm.sym("write") == 0
    return "jit.sym cannot resolve `write`"
  # 4. W^X publication.
  if not jitm.seal(probe, 8)
    return "jit.seal refused to make the buffer executable"
  # 5. ENTRY, by value, through the exact arity the compiled body is entered
  #    with. 40 + 2 is not a formality: it fails if the writer wrote garbage,
  #    if the icache was not flushed, or if the arguments do not land in
  #    x0/x1.
  got: i64 = jitm.call2(probe, 40, 2)
  if got != 42
    return "jit.call2 returned " .. got:to(str) .. " for `ADD x0,x0,x1` on (40, 2) -- expected 42"
  jitm.release(probe, 4096)
  ""

# Interprets function `target` of the module image `img`.
#
# This legacy path still re-walks the module and builds its function/type/code
# tables inline. Pointer transport no longer requires that shape; decomposition
# now waits on graph-owned cross-home modules and exact outcome alternatives;
# ordinary fixed GP result packs already cross without an aggregate.
run_body: i64 = (img: str, n: i64, target: i64, guard: i64)
  # The only module name whose functions this host provides. Bound to a `str`
  # local so `:byte()` indexes it; the roster it names lives in
  # `wasm/wasi_abi.id` and is shared with `wasm/wasi.id`.
  wmodname: str = wabi.module_name
  # `random_get` seeds once per process, lazily, so two calls in one run differ
  # while the cost is not paid by a module that never asks for entropy.
  # NOT a cryptographic source — see OPEN QUESTION 4 in src/wasm/wasi.id.
  rngseeded: i64 = 0
  # Allocated BEFORE the section walk because the walk is what fills it:
  # imported-function type indices, in import order.
  imtab = mem.alloc(256 * 8)
  imfn  = mem.alloc(256 * 8)
  mem.zero(imtab, 256 * 8)
  mem.zero(imfn, 256 * 8)
  # Per FUNCTION import: 1 when the grant DENIED it and `errno` mode admitted
  # it anyway. Zero for every import under the default grant, which is what
  # makes the total-grant path byte-identical to the path before the grant
  # existed.
  imgd = mem.alloc(256 * 8)
  mem.zero(imgd, 256 * 8)

  # ── THE GRANT, materialized once, before the section walk ───────────────
  # `gmask[i]` is 1 when roster index `i` is granted. Built here rather than
  # asked per import because the answer cannot change during instantiation:
  # the spec is a host-side string and no guest byte can reach it.
  gspec: str = grant_spec()
  gbad: str = wabi.grant_bad_token(gspec)
  if gbad != ""
    return bailgrantspec(gbad, gspec)
  gerrno: i64 = grant_errno_mode()
  gmask = mem.alloc(64 * 8)
  mem.zero(gmask, 64 * 8)
  gi: i64 = 1
  while gi <= wabi.count
    if wabi.grant_admits(gspec, gi) == 1
      mem.write_i64(gmask, gi * 8, 1)
    gi += 1

  # ── section walk: locate the type / function / code sections ──────────
  ty_off: i64 = 0
  fn_off: i64 = 0
  cd_off: i64 = 0
  cd_len: i64 = 0
  gb_off: i64 = 0
  da_off: i64 = 0
  tb_off: i64 = 0
  el_off: i64 = 0
  tbsize: i64 = 0
  nimp: i64 = 0
  # LINEAR MEMORY SIZE. This was a hardcoded ONE page and every effective
  # address was masked `& 0xFFFF` to fit it, so a module declaring two pages
  # had its upper half FOLDED ONTO THE LOWER HALF: `benchmarks/wasm_rt/memory`
  # answered 792579638 for 3674599702, and seven wasi-libc modules whose printf
  # buffers live above 64 KiB emitted nothing at all while exiting 0. Wrapping
  # is not a legal wasm behaviour in either direction — an out-of-range access
  # traps. Size from the memory section, and let the bounds checks below bail.
  mempages: i64 = 1
  si: i64 = 9
  while si <= n
    sid2: i64 = img:byte(si)
    si += 1
    ssz: i64 = uleb_val(img, si, n)
    si = uleb_end(img, si, n)
    if sid2 == 1
      ty_off = si
    elseif sid2 == 3
      fn_off = si
    elseif sid2 == 6
      gb_off = si
    elseif sid2 == 11
      da_off = si
    elseif sid2 == 5
      # memory section: count, then limits (flags byte, min uleb, opt max)
      mc: i64 = uleb_val(img, si, n)
      mj: i64 = uleb_end(img, si, n)
      if mc > 0
        mj += 1
        mempages = uleb_val(img, mj, n)
        if mempages < 1
          mempages = 1
    elseif sid2 == 4
      tb_off = si
    elseif sid2 == 9
      el_off = si
    elseif sid2 == 10
      cd_off = si
      cd_len = ssz
    elseif sid2 == 2
      # imported functions shift every function index; count them.
      ic: i64 = uleb_val(img, si, n)
      ij: i64 = uleb_end(img, si, n)
      ik: i64 = 0
      while ik < ic and ij <= n
        la: i64 = uleb_val(img, ij, n)
        ms: i64 = uleb_end(img, ij, n)
        ij = ms + la
        flen: i64 = uleb_val(img, ij, n)
        fs: i64 = uleb_end(img, ij, n)
        ij = fs + flen
        kd: i64 = img:byte(ij)
        ij += 1
        if kd == 0
          # IMPORT RESOLUTION IS BY (MODULE NAME, FIELD NAME), BOTH EXACT.
          #
          # This used to be a NAME MASK on the field alone — length 8 with
          # name[0]='f', name[1]='d', name[3]='w' — and the module name was
          # never read at all. A module importing `"totally_not_wasi"
          # "fdxwrite"` therefore got the host's `fd_write` performed for it,
          # bytes on the console and `success` returned, where wasmtime
          # refuses to instantiate the module at all: `unknown import:
          # totally_not_wasi::fdxwrite`. That is a soundness bug, not a
          # conformance gap: the engine was executing host effects on behalf
          # of a module that never asked for them, and any four-letter field
          # name of the right shape was a key to them.
          #
          # `hid` is the preview1 roster index from `wasm/wasi_abi.id`, or 0
          # for an import this host does not provide. The roster is shared
          # with `wasm/wasi.id` so the two hosts cannot disagree about which
          # names exist.
          hid: i64 = 0
          modok: i64 = 0
          if la == string.len(wmodname)
            modok = 1
            mq: i64 = 0
            while mq < la
              if img:byte(ms + mq) != wmodname:byte(mq + 1)
                modok = 0
              mq += 1
          if modok == 1
            wk: i64 = 1
            while wk <= wabi.count and hid == 0
              wnm: str = wabi.name(wk)
              if flen == string.len(wnm)
                wsame: i64 = 1
                wq: i64 = 0
                while wq < flen
                  if img:byte(fs + wq) != wnm:byte(wq + 1)
                    wsame = 0
                  wq += 1
                if wsame == 1
                  hid = wk
              wk += 1
          if hid == 0
            # wasmtime refuses to INSTANTIATE a module with an import it
            # cannot satisfy. So does this: an unresolved import is a refusal
            # at load time, never a stub that returns zero at call time.
            return bailshape("unknown import (not a wasi_snapshot_preview1 function this host provides)")

          # ── THE CAPABILITY CHECK, AND IT DOES NOT READ `hid` ────────────
          #
          # DEFENCE IN DEPTH IS A CLAIM ABOUT INDEPENDENCE, so this scan shares
          # no value with the resolver above. It compares the guest's bytes
          # against the GRANTED names only — a name that is withheld, and a
          # name that is not in the roster at all, both fail the same loop —
          # and it repeats the module-name test rather than trusting `modok`.
          #
          # THAT REPETITION IS THE MECHANISM, not an oversight. The defect this
          # host actually had (fixed above, comment retained) was a FIELD-NAME
          # MASK that never read the module name, and it handed
          # `"totally_not_wasi" "fdxwrite"` the host's `fd_write`. Restore that
          # mask and the resolver above is wrong again — but this loop still
          # answers 0, because `fdxwrite` matches no granted name under ANY
          # grant including `all`, and `totally_not_wasi` fails a module-name
          # test the masking resolver does not perform. A single check cannot
          # be defended in depth; two checks over the same bytes can, and the
          # cost is one more exact match per import at load time.
          #
          # Measured: with the mask restored and this loop removed, the hijack
          # module executes `fd_write` and prints. With the mask restored and
          # this loop present, it is refused. See cap/hijack/ and
          # docs/wasm-capability.md §5.
          gadm: i64 = 0
          gmok: i64 = 0
          if la == string.len(wmodname)
            gmok = 1
            gz: i64 = 0
            while gz < la
              if img:byte(ms + gz) != wmodname:byte(gz + 1)
                gmok = 0
              gz += 1
          if gmok == 1
            gj: i64 = 1
            while gj <= wabi.count and gadm == 0
              if mem.read_i64(gmask, gj * 8) == 1
                gnm: str = wabi.name(gj)
                if flen == string.len(gnm)
                  gsm: i64 = 1
                  gp: i64 = 0
                  while gp < flen
                    if img:byte(fs + gp) != gnm:byte(gp + 1)
                      gsm = 0
                    gp += 1
                  if gsm == 1
                    gadm = gj
              gj += 1
          if gadm == 0
            # `errno` mode admits the import and denies every CALL; the default
            # refuses here, which is the shape wasmtime has. Either way the
            # guest can tell what happened — exit 5 with a named import, or
            # `notcapable` from a call that would otherwise have had an effect.
            if gerrno == 0
              return bailgrant(bytes_str(img, ms, la), bytes_str(img, fs, flen), gspec)
            # A DENIAL THAT CANNOT BE RECORDED IS A DENIAL THAT DOES NOT HAPPEN.
            # `imgd` holds 256 slots, so past the 256th function import there is
            # nowhere to write the deny bit and the call would take the ORDINARY
            # path — the host performing an effect it had just refused. Found by
            # building a 300-import module and calling the 300th: it answered
            # `20` where a denied call must answer 76. Refuse instead. This is
            # the fail-closed arm and it is unreachable below 256 imports, which
            # is every module in both corpora (largest: 6).
            if nimp >= 256
              return bailgrant(bytes_str(img, ms, la), bytes_str(img, fs, flen), gspec)
            mem.write_i64(imgd, nimp * 8, 1)
          if nimp >= 256
            # THE SAME CAP, ON THE PATH THAT HAS NOTHING TO DO WITH THE GRANT,
            # and it was answering wrongly rather than refusing. `imfn`/`imtab`
            # are 256 slots and the walk used to keep counting past them, so
            # import 257 and beyond resolved to `hid = 0` at dispatch — the
            # 300-import module above answers `result=20` and prints NOTHING
            # where wasmtime answers 0 and prints. MEASURED on the engine
            # before this lane touched it, so it is not a regression here; it
            # is a silent wrong answer this file's own doctrine forbids. A
            # module the engine cannot represent is refused by shape.
            return bailshape("more than 256 function imports (this host indexes imports in a 256-slot table)")
          if nimp < 256
            mem.write_i64(imfn, nimp * 8, hid)
          # remember the type index so an imported call knows its arity
          ity: i64 = uleb_val(img, ij, n)
          if nimp < 256
            mem.write_i64(imtab, nimp * 8, ity)
          nimp += 1
          ij = uleb_end(img, ij, n)
        else
          # ── A NON-FUNCTION IMPORT IS REFUSED ────────────────────────────
          #
          # `kd` is 1 (table), 2 (memory) or 3 (global). This walk used to SKIP
          # all three without reading their names: the table arm decoded the
          # limits correctly and discarded them, and memory and global advanced
          # by a hard-coded two bytes. So a guest importing
          # `wasi_snapshot_preview1.memory` INSTANTIATED AND RAN under every
          # grant including `none` — the one shape a capability system may not
          # have — where wasmtime answers `unknown import:
          # wasi_snapshot_preview1::memory has not been defined` and exit 1.
          #
          # It was never a capability LEAK: the host allocates its own linear
          # memory from the memory section and ignores the import, so the guest
          # received nothing the host held. Two measurements made refusing right
          # rather than resolving.
          #
          # 1. THERE IS NOTHING TO RESOLVE TO. This host exports no memory, no
          #    table and no global to a guest. Resolving would mean honouring an
          #    imported memory's declared limits in place of the memory
          #    section's — a feature, not a repair — and pretending to resolve
          #    while ignoring the limits is a silent wrong answer of exactly the
          #    kind the 1/5 split above exists to prevent.
          #
          # 2. THE SKIP WAS AN OUT-OF-BOUNDS READ. `ij += 2` is the right width
          #    for a global (valtype, mut) and for a memory whose limits are a
          #    zero flags byte and a one-byte minimum — and for nothing else. A
          #    memory import carrying a MAXIMUM encodes three bytes, so the walk
          #    resumed one byte early and read the next import's name length out
          #    of the limits. Measured on `cap/imports/imp_mem_then_fn.wasm`
          #    (`(memory 1 2)`, then a real `fd_write` import): the field length
          #    decoded as 115 and the kind byte was read past the end of the
          #    image, so 200 runs of ONE unchanged binary over ONE unchanged
          #    module split 178 `result=95` / 22 `unknown import`. A
          #    nondeterministic answer to a fixed question is an unowned read,
          #    and `(memory N M)` is what emscripten emits by default.
          #
          # COST OF REFUSING, measured before choosing it: across 2435 wasm
          # modules in this checkout and the gates' there are 2178 imports, of
          # which 2172 are functions and 6 are not — and all 6 are fixtures
          # written to ask this question. No module anyone runs is refused by
          # this line. Pinned in both directions by `gate/import.sh`, whose
          # negative control rebuilds the skip from this file and requires it to
          # keep running `imp_memory` under grant `none`.
          return bailimport(bytes_str(img, ms, la), bytes_str(img, fs, flen), kd)
        ik += 1
    si += ssz
  if cd_off <= 0
    return bailshape("no code section")

  code = mem.alloc(cd_len + 16)
  st   = mem.alloc(4096 * 8)
  # Locals are a STACK now: 64 slots per frame, 64 frames deep. `call` moves
  # lbase rather than reusing one flat window.
  lo   = mem.alloc(64 * 64 * 8)
  fr   = mem.alloc(64 * 8 * 8)
  ftab = mem.alloc(4096 * 4 * 8)
  # Declared TYPE INDEX per defined function, which `ftab` never kept because
  # nothing asked: a direct `call` names its callee and the validator has
  # already agreed about the signature. `call_indirect` names a TABLE SLOT,
  # and wasm requires the runtime to compare the slot's actual signature
  # against the one written at the call site and TRAP when they differ. The engine
  # did not compare, so a mismatched slot silently entered the wrong function
  # with the wrong argument shape # a wrong answer, not a refusal.
  fty  = mem.alloc(4096 * 8)
  tpar = mem.alloc(4096 * 2 * 8)
  # THE PARAMETER TYPES THEMSELVES, up to eight per signature. The type walk
  # counted parameters and then SKIPPED their value-type bytes, which was
  # enough while nothing could pass an argument to an export. The argument
  # channel below needs them: `1` means one thing in an `i32` slot and another
  # in an `f64` one, and guessing from the literal's spelling would silently
  # hand `1` to an f64 parameter as the integer 1 rather than as 1.0.
  tpty = mem.alloc(4096 * 8 * 8)
  # LABEL STACK. One shared buffer across every frame, because `lsp` is not
  # reset on a call: a callee's labels sit above its caller's. That made 64
  # entries a GLOBAL ceiling rather than a per-frame one, so a recursion only
  # 32 frames deep exhausted it and `fib(34)` exited 70 on the interpreter
  # while the jit answered it correctly. Sized to the frame cap instead:
  # 64 frames x 64 labels.
  ltgt = mem.alloc(64 * 64 * 8)
  lelse = mem.alloc(64 * 64 * 8)
  gl   = mem.alloc(64 * 8)
  # A declared minimum is what a runtime must actually provide, but this one
  # allocates eagerly, so an absurd minimum has to be refused rather than
  # attempted. 4096 pages is 256 MiB; nothing in any corpus here is close.
  if mempages > 4096
    return bailshape("declared linear memory above 4096 pages")
  linsz: i64 = mempages * 65536
  lin  = mem.alloc(linsz)
  himm = mem.alloc(256)
  fb   = mem.alloc(16)
  dseg = mem.alloc(64 * 2 * 8)
  tbl  = mem.alloc(4096 * 8)
  # Slot occupancy, tracked separately: funcidx 0 is a real function, so a zeroed table cannot
  # say "empty" by value # without this, every slot an element segment did
  # not reach would dispatch to function 0 instead of trapping, which wasm
  # requires. The jit carries the identical array so the two engines cannot
  # disagree about an uninitialised element.
  toc  = mem.alloc(4096 * 8)
  vstk = mem.alloc(1024 * 16)
  eseg = mem.alloc(64 * 2 * 8)
  vwid = mem.alloc(256)
  vker = mem.alloc(256)
  extw = mem.alloc(256)
  exts = mem.alloc(256)
  mem.zero(code, cd_len + 16)
  mem.zero(st, 4096 * 8)
  mem.zero(lo, 64 * 64 * 8)
  mem.zero(fr, 64 * 8 * 8)
  mem.zero(ftab, 4096 * 4 * 8)
  mem.zero(fty, 4096 * 8)
  mem.zero(tpar, 4096 * 2 * 8)
  # NOT zeroed here. 4096 x 8 slots is 256 KiB and this runs on the startup
  # path, which is this engine's one measured win over wasmtime; the type walk
  # below writes all eight slots for every type it reads instead, and a type
  # index the walk never reached is never read (`fty` answers -1 for it).
  mem.zero(ltgt, 64 * 64 * 8)
  mem.zero(lelse, 64 * 64 * 8)
  mem.zero(gl, 64 * 8)
  mem.zero(lin, linsz)
  mem.zero(himm, 256)
  mem.zero(fb, 16)
  mem.zero(dseg, 64 * 2 * 8)
  mem.zero(tbl, 4096 * 8)
  mem.zero(toc, 4096 * 8)
  mem.zero(vstk, 1024 * 16)
  mem.zero(eseg, 64 * 2 * 8)
  mem.zero(vwid, 256)
  mem.zero(vker, 256)
  mem.zero(extw, 256)
  mem.zero(exts, 256)
  # extract_lane descriptors: (lane width, signed?). Reading `w` bytes at the
  # lane covers EVERY variant # float lanes need no special case because the engine
  # keeps floats on the operand stack as their bit pattern, so extracting an
  # f32 lane and an i32 lane are the same four bytes.
  mem.write_byte(extw, 21, 1)  mem.write_byte(exts, 21, 1)  # i8x16.extract_lane_s
  mem.write_byte(extw, 22, 1)                               # i8x16.extract_lane_u
  mem.write_byte(extw, 24, 2)  mem.write_byte(exts, 24, 1)  # i16x8.extract_lane_s
  mem.write_byte(extw, 25, 2)                               # i16x8.extract_lane_u
  mem.write_byte(extw, 27, 4)                               # i32x4.extract_lane
  mem.write_byte(extw, 29, 8)                               # i64x2.extract_lane
  mem.write_byte(extw, 31, 4)                               # f32x4.extract_lane
  mem.write_byte(extw, 33, 8)                               # f64x2.extract_lane
  # ── SIMD descriptor table ────────────────────────────────────────────
  # Every v128 lane op has ONE shape: walk the lanes, apply a kernel,
  # reassemble. So a row is (sub-opcode -> lane width in bytes, kernel) and
  # there is a single executor below; adding an opcode is a row, not a branch.
  # Indexed by sub-opcode so the lookup is O(1) and stays a native scalar #
  # a width of 0 means "no arm", which is what the executor tests.
  # Every number here was read out of wasm-tools, not derived: i64x2.add is
  # 206, not the 190 a +16 stride would predict (the real stride is +32).
  # kernels: 1 and  2 or  3 xor  4 add  5 sub  6 mul  7 fadd  8 fsub  9 fmul  10 fdiv
  # Written as direct stores, not a table literal: a table in `run_body`
  # disqualifies the whole function from native lowering, and this is the
  # interpreter's hot loop. The rows below ARE the descriptor table.
  mem.write_byte(vwid, 78, 8)    mem.write_byte(vker, 78, 1)    # v128.and
  mem.write_byte(vwid, 80, 8)    mem.write_byte(vker, 80, 2)    # v128.or
  mem.write_byte(vwid, 81, 8)    mem.write_byte(vker, 81, 3)    # v128.xor
  mem.write_byte(vwid, 110, 1)   mem.write_byte(vker, 110, 4)   # i8x16.add
  mem.write_byte(vwid, 142, 2)   mem.write_byte(vker, 142, 4)   # i16x8.add
  mem.write_byte(vwid, 174, 4)   mem.write_byte(vker, 174, 4)   # i32x4.add
  mem.write_byte(vwid, 206, 8)   mem.write_byte(vker, 206, 4)   # i64x2.add
  mem.write_byte(vwid, 113, 1)   mem.write_byte(vker, 113, 5)   # i8x16.sub
  mem.write_byte(vwid, 145, 2)   mem.write_byte(vker, 145, 5)   # i16x8.sub
  mem.write_byte(vwid, 177, 4)   mem.write_byte(vker, 177, 5)   # i32x4.sub
  mem.write_byte(vwid, 209, 8)   mem.write_byte(vker, 209, 5)   # i64x2.sub
  mem.write_byte(vwid, 149, 2)   mem.write_byte(vker, 149, 6)   # i16x8.mul
  mem.write_byte(vwid, 181, 4)   mem.write_byte(vker, 181, 6)   # i32x4.mul
  mem.write_byte(vwid, 213, 8)   mem.write_byte(vker, 213, 6)   # i64x2.mul
  mem.write_byte(vwid, 228, 4)   mem.write_byte(vker, 228, 7)   # f32x4.add
  mem.write_byte(vwid, 240, 8)   mem.write_byte(vker, 240, 7)   # f64x2.add
  mem.write_byte(vwid, 229, 4)   mem.write_byte(vker, 229, 8)   # f32x4.sub
  mem.write_byte(vwid, 241, 8)   mem.write_byte(vker, 241, 8)   # f64x2.sub
  mem.write_byte(vwid, 230, 4)   mem.write_byte(vker, 230, 9)   # f32x4.mul
  mem.write_byte(vwid, 242, 8)   mem.write_byte(vker, 242, 9)   # f64x2.mul
  mem.write_byte(vwid, 231, 4)   mem.write_byte(vker, 231, 10)  # f32x4.div
  mem.write_byte(vwid, 243, 8)   mem.write_byte(vker, 243, 10)  # f64x2.div
  # Initialise globals from the module's OWN global section. it used to
  # hardcode gl[0] = 65536 unconditionally, so every module that declares its
  # own globals started 65536 too high: `wart_simple_opcode_bench` reported
  # 135536 for an expected 70000 # exactly 70000 + 65536.
  if gb_off > 0
    ngv: i64 = uleb_val(img, gb_off, n)
    gq2: i64 = uleb_end(img, gb_off, n)
    gv2: i64 = 0
    while gv2 < ngv and gq2 <= n and gv2 < 64
      gq2 += 2                      # valtype byte, mutability byte
      iop: i64 = img:byte(gq2)
      gq2 += 1
      gval: i64 = 0
      if iop == OP_i32_const or iop == OP_i64_const
        gval = uleb_val(img, gq2, n)
        gq2 = uleb_end(img, gq2, n)
      elseif iop == OP_f32_const
        gq2 += 4
      elseif iop == OP_f64_const
        gq2 += 8
      gq2 += 1                      # 0x0B end-of-init-expr
      mem.write_i64(gl, gv2 * 8, gval)
      gv2 += 1
  else
    # No global section: assume wasi-libc, which expects a usable shadow
    # stack pointer in global 0.
    mem.write_i64(gl, 0, 65536)
  # Opcodes carrying a LEB128 immediate that the cold path must consume.
  # Missing an entry desyncs `pc` and decodes garbage, so this must cover
  # every immediate-carrying opcode not handled inline in the hot path.
  mem.write_byte(himm, 33, 1)   # local.set
  mem.write_byte(himm, 35, 1)   # global.get
  mem.write_byte(himm, 36, 1)   # global.set
  mem.write_byte(himm, 12, 1)   # br
  mem.write_byte(himm, 13, 1)   # br_if
  mem.write_byte(himm, 16, 1)   # call
  mem.write_byte(himm, 17, 1)   # call_indirect (typeidx; the arm eats tableidx)

  # ── type table: param count per type index ───────────────────────────
  # `call` must know how many operands to move from the caller's stack into
  # the callee's locals, and that count lives only in the type section.
  if ty_off > 0
    ntv: i64 = uleb_val(img, ty_off, n)
    tq: i64 = uleb_end(img, ty_off, n)
    tv: i64 = 0
    while tv < ntv and tq <= n
      tq += 1                       # 0x60 form byte
      npv: i64 = uleb_val(img, tq, n)
      tps: i64 = uleb_end(img, tq, n)  # first param value-type byte
      # Keep the first eight, which is the arity the argument channel accepts.
      pk: i64 = 0
      while pk < 8
        pvt: i64 = 0
        if pk < npv
          pvt = img:byte(tps + pk)
        mem.write_i64(tpty, (tv * 8 + pk) * 8, pvt)
        pk += 1
      tq = tps + npv
      nrv: i64 = uleb_val(img, tq, n)
      tq = uleb_end(img, tq, n) + nrv  # skip the result value types
      # two slots per type: params, then results. `call` needs the param
      # count; an IMPORTED call needs the result count too, to know how many
      # values to leave behind for a function it cannot execute.
      mem.write_i64(tpar, (tv * 2) * 8, npv)
      mem.write_i64(tpar, (tv * 2 + 1) * 8, nrv)
      tv += 1

  # ── function table: body span, local count, param count ──────────────
  nfn: i64 = uleb_val(img, cd_off, n)
  fq: i64 = uleb_end(img, cd_off, n)
  gq: i64 = 0
  if fn_off > 0
    gq = uleb_end(img, fn_off, n)      # past the function-section count
  fv: i64 = 0
  while fv < nfn and fq <= n
    bsz2: i64 = uleb_val(img, fq, n)
    bst: i64 = uleb_end(img, fq, n)
    nld: i64 = uleb_val(img, bst, n)
    rq: i64 = uleb_end(img, bst, n)
    nlc: i64 = 0
    gv: i64 = 0
    while gv < nld
      cl: i64 = uleb_val(img, rq, n)
      rq = uleb_end(img, rq, n) + 1     # count LEB, then one value-type byte
      nlc += cl
      gv += 1
    npf: i64 = 0
    # -1, not 0: a function whose type the walk could not read must not read
    # as "type 0", because type 0 is a real signature and the call_indirect
    # check would then wave it through.
    mem.write_i64(fty, fv * 8, -1)
    if gq > 0
      tix: i64 = uleb_val(img, gq, n)
      gq = uleb_end(img, gq, n)
      npf = mem.read_i64(tpar, (tix * 2) * 8)
      mem.write_i64(fty, fv * 8, tix)
    # offsets are relative to the copied code section
    mem.write_i64(ftab, (fv * 4) * 8, rq - cd_off)
    mem.write_i64(ftab, (fv * 4 + 1) * 8, bst + bsz2 - cd_off)
    mem.write_i64(ftab, (fv * 4 + 2) * 8, nlc)
    mem.write_i64(ftab, (fv * 4 + 3) * 8, npf)
    fq = bst + bsz2
    fv += 1

  # ── data segments -> linear memory ───────────────────────────────────
  # Without this every string constant reads as NUL: fd_write emitted blanks
  # instead of the module's actual output.
  if da_off > 0
    nds: i64 = uleb_val(img, da_off, n)
    dq: i64 = uleb_end(img, da_off, n)
    dv: i64 = 0
    while dv < nds and dq <= n
      dmode: i64 = uleb_val(img, dq, n)
      dq = uleb_end(img, dq, n)
      doff: i64 = 0
      if dmode == 2
        dq = uleb_end(img, dq, n)      # explicit memidx
      if dmode != 1
        # active: offset is a const init expr terminated by 0x0B
        dq += 1                        # the i32.const opcode
        doff = uleb_val(img, dq, n)
        dq = uleb_end(img, dq, n) + 1  # + the 0x0B end byte
      dlen: i64 = uleb_val(img, dq, n)
      dq = uleb_end(img, dq, n)
      # Record where the segment's bytes live so `memory.init` can copy them
      # later; a PASSIVE segment (mode 1) has no offset and must NOT be
      # copied now — doing so wrote it over address 0.
      if dv < 64
        mem.write_i64(dseg, (dv * 2) * 8, dq)
        mem.write_i64(dseg, (dv * 2 + 1) * 8, dlen)
      if dmode != 1
        dk: i64 = 0
        while dk < dlen and doff + dk < linsz
          mem.write_byte(lin, doff + dk, img:byte(dq + dk))
          dk += 1
      dq += dlen
      dv += 1

  # ── table + element segments ─────────────────────────────────────────
  # the engine's table holds function indices. Only what `call_indirect` and the
  # 0xFC table ops need: a flat i64 array plus a size.
  if tb_off > 0
    ntb: i64 = uleb_val(img, tb_off, n)
    tq2: i64 = uleb_end(img, tb_off, n)
    if ntb > 0
      tq2 += 1                          # reftype byte
      tfl: i64 = img:byte(tq2)
      tq2 += 1
      tbsize = uleb_val(img, tq2, n)
      tq2 = uleb_end(img, tq2, n)
      if tfl == 1
        tq2 = uleb_end(img, tq2, n)     # max
  if tbsize > 4096
    tbsize = 4096
  if el_off > 0
    nel: i64 = uleb_val(img, el_off, n)
    eq2: i64 = uleb_end(img, el_off, n)
    ev: i64 = 0
    while ev < nel and eq2 <= n
      emode: i64 = uleb_val(img, eq2, n)
      eq2 = uleb_end(img, eq2, n)
      eoff: i64 = 0
      if emode == 0
        eq2 += 1                        # i32.const
        eoff = uleb_val(img, eq2, n)
        eq2 = uleb_end(img, eq2, n) + 1 # + 0x0B
      elseif emode == 1 or emode == 3
        eq2 += 1                        # elemkind byte
      ecnt: i64 = uleb_val(img, eq2, n)
      eq2 = uleb_end(img, eq2, n)
      if ev < 64
        mem.write_i64(eseg, (ev * 2) * 8, eq2)
        mem.write_i64(eseg, (ev * 2 + 1) * 8, ecnt)
      ek: i64 = 0
      while ek < ecnt and eq2 <= n
        efn: i64 = uleb_val(img, eq2, n)
        eq2 = uleb_end(img, eq2, n)
        if emode == 0 and eoff + ek < 4096
          mem.write_i64(tbl, (eoff + ek) * 8, efn)
          mem.write_i64(toc, (eoff + ek) * 8, 1)
        ek += 1
      ev += 1

  ci: i64 = 0
  while ci < cd_len
    mem.write_byte(code, ci, img:byte(cd_off + ci))
    ci += 1

  if target < 0 or target >= nfn
    return bailshape("target function index out of range")
  sp: i64 = 0
  lsp: i64 = 0
  depth: i64 = 0
  vtop: i64 = 0
  lbase: i64 = 0
  # Label-stack base for the CURRENT frame. `ltgt` is one shared buffer, so
  # `end` cannot use `lsp > 0` to tell a block end from a function end once a
  # callee's labels sit above the caller's — it would decrement instead of
  # returning. Everything at or below lsp_base belongs to an outer frame.
  lsp_base: i64 = 0
  pc: i64 = mem.read_i64(ftab, (target * 4) * 8)
  cur_end: i64 = mem.read_i64(ftab, (target * 4 + 1) * 8)
  nl0: i64 = mem.read_i64(ftab, (target * 4 + 2) * 8)
  mem.zero(lo, 64 * 8)

  # ── THE ARGUMENT CHANNEL ─────────────────────────────────────────────
  # `DUO_WASM_ARGS=<v>,<v>,...` seeds the entry frame's parameter locals.
  #
  # Until this existed the engine had NO WAY TO PASS AN ARGUMENT TO AN EXPORT
  # at all: the only call site was `run_body(bytes, nbytes, tgt, 0)`, which
  # passes no operands, so a parameterised export ran with its parameters
  # ZEROED and printed a confident answer for `f(0, 0)`. That is the single
  # capability that capped spec conformance at 4.45%: every `assert_return`
  # whose invoke takes operands — which is most of the suite — was unrunnable,
  # and the ones that "ran" were answering a different question.
  #
  # A parameterised export with no arguments supplied is now a REFUSAL, not a
  # zero-fill, and so is an arity mismatch in either direction. Zero-filling is
  # what made the gap invisible.
  #
  # The VALUE TYPE decides the encoding, not the literal's spelling: an `f64`
  # parameter given `1` gets the bit pattern of 1.0, and an `i32` given `-1`
  # gets 0xFFFFFFFF. Decimal only; a float literal may carry `.`/`e`/`nan`/
  # `inf`. Eight parameters, which is what `tpty` retains.
  npar0: i64 = mem.read_i64(ftab, (target * 4 + 3) * 8)
  tix0: i64 = mem.read_i64(fty, target * 8)
  argstr = env("DUO_WASM_ARGS")
  aidx: i64 = 0
  if argstr != nil
    asx: str = argstr
    alen: i64 = string.len(asx)
    if alen > 0
      ai: i64 = 1
      acur: str = ""
      while ai <= alen + 1
        ach: i64 = 44
        if ai <= alen
          ach = string.byte(asx, ai)
        if ach == 44
          if aidx >= npar0 or aidx >= 8
            return bailshape("DUO_WASM_ARGS supplies more values than the export declares")
          avt: i64 = 0x7F
          if tix0 >= 0
            avt = mem.read_i64(tpty, (tix0 * 8 + aidx) * 8)
          # `#<hex>` IS THE RAW 64-BIT PATTERN for the slot, whatever the
          # declared type says. Decimal cannot spell every wasm value: an f64
          # NaN has a PAYLOAD (canonical and arithmetic NaNs are different bit
          # patterns and the spec suite distinguishes them), subnormals do not
          # survive a decimal round trip, and wast2json writes i64 operands as
          # UNSIGNED decimal, which no i64 parser accepts. A bit pattern has
          # none of those problems and needs no float parsing at all, so the
          # spec harness passes every operand this way.
          ishex: i64 = 0
          if string.len(acur) > 1
            if string.byte(acur, 1) == 35
              ishex = 1
          isf: i64 = 0
          if ishex == 0
            q: i64 = 1
            while q <= string.len(acur)
              cb: i64 = string.byte(acur, q)
              # '.', 'e', 'E', 'n' (nan), 'i' (inf)
              if cb == 46 or cb == 101 or cb == 69 or cb == 110 or cb == 105
                isf = 1
              q += 1
          av: i64 = 0
          if ishex == 1
            hq: i64 = 2
            while hq <= string.len(acur)
              hb: i64 = string.byte(acur, hq)
              hd: i64 = -1
              if hb >= 48 and hb <= 57
                hd = hb - 48
              elseif hb >= 97 and hb <= 102
                hd = hb - 87
              elseif hb >= 65 and hb <= 70
                hd = hb - 55
              if hd < 0
                return bailshape("DUO_WASM_ARGS: `#` must be followed by hexadecimal digits")
              av = av * 16 + hd
              hq += 1
          elseif avt == 0x7C or avt == 0x7D or isf == 1
            fvv: f64 = to(f64)(acur)
            mem.write_i64(fb, 0, 0)
            if avt == 0x7D
              f32v: f32 = fvv
              mem.store(f32)(fb, f32v)
            else
              mem.store(f64)(fb, fvv)
            av = mem.read_i64(fb, 0)
          else
            av = to(i64)(acur)
            if avt == 0x7F
              av = av & M32
          mem.write_i64(lo, aidx * 8, av)
          aidx += 1
          acur = ""
        else
          acur = acur .. string.char(ach)
        ai += 1
  if aidx != npar0
    if npar0 > 0
      return bailshape("the export declares parameters and DUO_WASM_ARGS does not supply that many (set DUO_WASM_ARGS=v1,v2,...)")
    return bailshape("DUO_WASM_ARGS supplies values to an export that declares no parameters")

  while pc < cur_end
    op: i64 = mem.read_byte(code, pc)
    pc += 1

    if op == OP_i32_const
      sh: i64 = 0
      cont: i64 = 1
      imm: i64 = 0
      ib: i64 = 0
      while cont == 1
        ib = mem.read_byte(code, pc)
        pc += 1
        imm |= ((ib & 0x7F) << sh)
        sh += 7
        if ib < 0x80
          cont = 0
      # i32.const is SIGNED LEB128: sign-extend when the last byte's 0x40 bit
      # is set. `i32.const -1` is the single byte 0x7F and decodes as 127
      # without this. Requires a correct 64-bit variable shift, which the
      # compiler now performs.
      if sh < 64 and (ib & 0x40) != 0
        imm |= (0 - (1 << sh))
      imm = imm & M32
      sp += 1
      mem.write_i64(st, sp * 8, imm)
      sp = sp

    elseif op == OP_local_get
      sh: i64 = 0
      cont: i64 = 1
      imm: i64 = 0
      while cont == 1
        ib: i64 = mem.read_byte(code, pc)
        pc += 1
        imm |= ((ib & 0x7F) << sh)
        sh += 7
        if ib < 0x80
          cont = 0
      imm = imm & M32
      if imm < 0 or imm >= 64
        return bail(op, pc)
      sp += 1
      mem.write_i64(st, sp * 8, mem.read_i64(lo, (lbase + imm) * 8))
      sp = sp

    elseif (op >= OP_i32_add and op <= OP_i32_mul) or (op >= OP_i32_and and op <= OP_i32_shr_u)
      # i32 binary ALU: operand fetch and stack adjust shared by all arms.
      # The range deliberately EXCLUDES 109-112 (div_s/div_u/rem_s/rem_u).
      # It used to span 106-118 and swallow them, and because the inner chain
      # has no arm for them they fell through to the `r = 0` initializer #
      # so `45 / 2` silently returned 0 instead of 22 and every module using
      # integer division was quietly wrong. They have a dedicated arm below.
      if sp < 2
        return bail(op, pc)
      b: i64 = mem.read_i64(st, sp * 8)
      a: i64 = mem.read_i64(st, (sp - 1) * 8)
      sp -= 1
      r: i64 = 0
      if op == OP_i32_mul
        # split multiply: a*b with 32-bit operands overflows signed i64
        r = (((a & 0xFFFF) * b) + (((((a >> 16) & 0xFFFF) * b) & 0xFFFF) << 16)) & M32
      elseif op == OP_i32_xor
        r = a ~ b
      elseif op == OP_i32_or
        r = a | b
      elseif op == OP_i32_shr_u
        r = (a & M32) >> (b & 31)
      elseif op == OP_i32_add
        r = (a + b) & M32
      elseif op == OP_i32_sub
        r = (a - b) & M32
      elseif op == OP_i32_and
        r = a & b
      elseif op == OP_i32_shl
        r = ((a & (M32 >> (b & 31))) << (b & 31)) & M32
      elseif op == OP_i32_shr_s
        # i32.shr_s: arithmetic shift of the SIGN-EXTENDED 32-bit value. Also
        # previously unhandled inside this range, i.e. silently 0.
        sa: i64 = a & M32
        if sa >= 0x80000000
          sa -= 0x100000000
        r = (sa >> (b & 31)) & M32
      else
        # An opcode inside the range with no arm must NOT quietly yield 0.
        return bail(op, pc)
      mem.write_i64(st, sp * 8, r)
      sp = sp

    elseif op == OP_local_tee
      sh: i64 = 0
      cont: i64 = 1
      imm: i64 = 0
      while cont == 1
        ib: i64 = mem.read_byte(code, pc)
        pc += 1
        imm |= ((ib & 0x7F) << sh)
        sh += 7
        if ib < 0x80
          cont = 0
      imm = imm & M32
      mem.write_i64(lo, (lbase + imm) * 8, mem.read_i64(st, sp * 8))
      sp = sp

    else
      # Cold path: one table-guarded decode shared by every remaining opcode.
      imm2: i64 = 0
      if mem.read_byte(himm, op) != 0
        sh2: i64 = 0
        c2: i64 = 1
        while c2 == 1
          jb: i64 = mem.read_byte(code, pc)
          pc += 1
          imm2 |= ((jb & 0x7F) << sh2)
          sh2 += 7
          if jb < 0x80
            c2 = 0
        imm2 = imm2 & M32

      if op == OP_br_if
        cv: i64 = mem.read_i64(st, sp * 8)
        sp -= 1
        if cv != 0
          lbi: i64 = lsp - 1 - imm2
          if lbi < 0 or lbi >= 64
            return bail(op, pc)
          tgt2: i64 = mem.read_i64(ltgt, lbi * 8)
          # A BACKWARD target is a `loop` (re-entered, so its label stays);
          # a FORWARD target is a `block`/`if` end, which EXITS that construct,
          # so every label from lbi up must go. `lsp -= imm2` left one behind:
          # harmless in a single frame (the function's own `end` absorbed it)
          # but across a call it made the callee's `end` decrement instead of
          # popping the frame, so the interpreter returned early # a caller
          # loop calling a callee loop yielded 1 instead of 10.
          if tgt2 <= pc
            lsp = lbi + 1
          else
            lsp = lbi
          pc = tgt2
      elseif op == OP_local_set
        if sp < 1 or imm2 < 0 or imm2 >= 64
          return bail(op, pc)
        mem.write_i64(lo, (lbase + imm2) * 8, mem.read_i64(st, sp * 8))
        sp -= 1
      elseif op >= OP_i32_eqz and op <= OP_i32_lt_u
        if op == OP_i32_eqz
          av: i64 = mem.read_i64(st, sp * 8)
          rv: i64 = 0
          if (av & M32) == 0
            rv = 1
          mem.write_i64(st, sp * 8, rv)
          sp = sp
        else
          b2: i64 = mem.read_i64(st, sp * 8)
          a2: i64 = mem.read_i64(st, (sp - 1) * 8)
          sp -= 1
          r2: i64 = 0
          if op == OP_i32_ne
            if a2 != b2
              r2 = 1
          elseif op == OP_i32_lt_u
            if (a2 & M32) < (b2 & M32)
              r2 = 1
          elseif op == OP_i32_eq
            # i32.eq. This range (69..73) SWALLOWED it: the inner chain had no
            # arm, so it fell through to `r2 = 0` and every `x == y` was false.
            # Same silent-zero shape as the div/rem range bug.
            if (a2 & M32) == (b2 & M32)
              r2 = 1
          elseif op == OP_i32_lt_s
            # i32.lt_s. Also swallowed here, before its own arm further down.
            as2: i64 = a2 & M32
            bs2: i64 = b2 & M32
            if as2 >= 2147483648
              as2 -= 4294967296
            if bs2 >= 2147483648
              bs2 -= 4294967296
            if as2 < bs2
              r2 = 1
          else
            # An opcode inside the range with no arm must NOT quietly yield 0.
            return bail(op, pc)
          mem.write_i64(st, sp * 8, r2)
          sp = sp
      elseif op == OP_loop
        if lsp >= 64 * 64 - 1
          return bail(op, pc)
        pc += 1
        mem.write_i64(ltgt, lsp * 8, pc)
        lsp += 1
      elseif op == OP_end_
        # lsp == 0 means this `end` closes the *function*, not a block. With
        # frames on the stack that is a return to the caller; at depth 0 it
        # falls through and `pc >= cur_end` ends the loop.
        if lsp > lsp_base
          lsp -= 1
        elseif depth > 0
          depth -= 1
          pc       = mem.read_i64(fr, (depth * 8) * 8)
          cur_end  = mem.read_i64(fr, (depth * 8 + 1) * 8)
          lbase    = mem.read_i64(fr, (depth * 8 + 2) * 8)
          lsp      = mem.read_i64(fr, (depth * 8 + 3) * 8)
          lsp_base = mem.read_i64(fr, (depth * 8 + 4) * 8)
      elseif op == OP_br
        lb: i64 = lsp - 1 - imm2
        if lb < 0 or lb >= 64
          return bail(op, pc)
        tgt3: i64 = mem.read_i64(ltgt, lb * 8)
        if tgt3 <= pc
          lsp = lb + 1
        else
          lsp = lb
        pc = tgt3
      elseif op == OP_return_
        if depth > 0
          depth -= 1
          pc       = mem.read_i64(fr, (depth * 8) * 8)
          cur_end  = mem.read_i64(fr, (depth * 8 + 1) * 8)
          lbase    = mem.read_i64(fr, (depth * 8 + 2) * 8)
          lsp      = mem.read_i64(fr, (depth * 8 + 3) * 8)
          lsp_base = mem.read_i64(fr, (depth * 8 + 4) * 8)
        else
          pc = cur_end

      elseif op == OP_call
        # call: `imm2` already holds the decoded function index (opcode 16 is
        # registered in `himm`). Imported/WASI functions are not executable
        # here yet, so bail rather than jumping into a body that isn't ours.
        if imm2 < nimp
          # A wasi_snapshot_preview1 import, PERFORMED. It used to be a blanket
          # stub: consume the declared parameters, push zeros, report success.
          # Every one of the 45 functions that was not `fd_write` therefore
          # answered `success` while doing nothing — `proc_exit(42)` returned
          # and execution continued, `random_get` left the buffer zeroed and
          # said it had filled it, `clock_time_get` never moved a clock. A
          # stub that reports success is a wrong program; a stub that reports
          # an errno is a program that fails where it should.
          #
          # `hid` is the roster index resolved at load time from BOTH names.
          # The errno policy comes from `wasm/wasi_abi.id`, shared with
          # `wasm/wasi.id`; -1 there means "the answer depends on an argument
          # or the call has an effect", and only those arms are written out
          # below.
          hid: i64 = mem.read_i64(imfn, imm2 * 8)
          itx: i64 = mem.read_i64(imtab, imm2 * 8)
          ipn: i64 = mem.read_i64(tpar, (itx * 2) * 8)
          irn: i64 = mem.read_i64(tpar, (itx * 2 + 1) * 8)
          if ipn > sp
            return bail(op, pc)
          # arg k, 1-based, is st[ab + k]
          ab: i64 = sp - ipn
          hrv: i64 = wabi.static_errno(hid)
          # WITHHELD, AND THE GUEST IS TOLD SO. `imgd` is set only in `errno`
          # mode and only for an import the grant denied, so under the default
          # grant this reads zero for every import and `hrv` is untouched —
          # which is what makes the total-grant path identical to the path that
          # existed before the grant did.
          #
          # `notcapable` (76) and NOT `badf` (8): `badf` is already this host's
          # answer for a descriptor the sandbox does not hold, so reusing it
          # would make "you may not write" indistinguishable from "there is
          # nothing to write to", and a guest that retries on `badf` would
          # retry a denial forever. See the note on ERRNO_notcapable in
          # src/wasm/wasi_abi.id for why 76 is the ordinal.
          if mem.read_i64(imgd, imm2 * 8) == 1
            hrv = wabi.ERRNO_notcapable
          if hrv < 0
            if hid == wabi.i_fd_write
              # fd_write(fd, iovs, iovs_len, nwritten) -> errno.
              # THE FD IS RESPECTED. It was ignored: fd 2 went to stdout and fd
              # 999 emitted the payload and reported success where wasmtime
              # answers badf and emits nothing.
              wfd: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              hrv = wabi.ERRNO_badf
              if wfd == 1 or wfd == 2
                iop: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
                nio: i64 = mem.read_i64(st, (ab + 3) * 8) & M32
                npw: i64 = mem.read_i64(st, (ab + 4) * 8) & M32
                tot: i64 = 0
                q3: i64 = 0
                while q3 < nio
                  vb: i64 = iop + q3 * 8
                  bp: i64 = mem.read_byte(lin, vb) | (mem.read_byte(lin, vb + 1) << 8) | (mem.read_byte(lin, vb + 2) << 16) | (mem.read_byte(lin, vb + 3) << 24)
                  bl: i64 = mem.read_byte(lin, vb + 4) | (mem.read_byte(lin, vb + 5) << 8) | (mem.read_byte(lin, vb + 6) << 16) | (mem.read_byte(lin, vb + 7) << 24)
                  k3: i64 = 0
                  while k3 < bl and bp + k3 < linsz
                    if wfd == 1
                      io.stdout:write(string.char(mem.read_byte(lin, bp + k3)))
                    else
                      io.stderr:write(string.char(mem.read_byte(lin, bp + k3)))
                    k3 += 1
                  tot += bl
                  q3 += 1
                if npw + 4 <= linsz
                  mem.write_byte(lin, npw, tot & 255)
                  mem.write_byte(lin, npw + 1, (tot >> 8) & 255)
                  mem.write_byte(lin, npw + 2, (tot >> 16) & 255)
                  mem.write_byte(lin, npw + 3, (tot >> 24) & 255)
                hrv = wabi.ERRNO_success
            elseif hid == wabi.i_fd_read
              # fd_read(fd, iovs, iovs_len, nread) -> errno. Only stdin.
              rfd: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              hrv = wabi.ERRNO_badf
              if rfd == 0
                riop: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
                rnio: i64 = mem.read_i64(st, (ab + 3) * 8) & M32
                rnp: i64 = mem.read_i64(st, (ab + 4) * 8) & M32
                rtot: i64 = 0
                rq: i64 = 0
                while rq < rnio
                  rvb: i64 = riop + rq * 8
                  rbp: i64 = mem.read_byte(lin, rvb) | (mem.read_byte(lin, rvb + 1) << 8) | (mem.read_byte(lin, rvb + 2) << 16) | (mem.read_byte(lin, rvb + 3) << 24)
                  rbl: i64 = mem.read_byte(lin, rvb + 4) | (mem.read_byte(lin, rvb + 5) << 8) | (mem.read_byte(lin, rvb + 6) << 16) | (mem.read_byte(lin, rvb + 7) << 24)
                  chunk = io.stdin:read(rbl)
                  if chunk
                    ck: i64 = 1
                    while ck <= string.len(chunk) and rbp + ck - 1 < linsz
                      mem.write_byte(lin, rbp + ck - 1, string.byte(chunk, ck))
                      ck += 1
                    rtot += string.len(chunk)
                  rq += 1
                if rnp + 4 <= linsz
                  mem.write_byte(lin, rnp, rtot & 255)
                  mem.write_byte(lin, rnp + 1, (rtot >> 8) & 255)
                  mem.write_byte(lin, rnp + 2, (rtot >> 16) & 255)
                  mem.write_byte(lin, rnp + 3, (rtot >> 24) & 255)
                hrv = wabi.ERRNO_success
            elseif hid == wabi.i_proc_exit
              # proc_exit(code) TERMINATES. It was a no-op, so a guest's exit
              # code was unobservable and everything after the call still ran.
              #
              # The STATUS is not the argument. preview1 permits 0..125 and
              # wasmtime refuses anything above that with exit 1 — measured,
              # boundary included, in `wasm/wasi_abi.id`. Passing the raw code
              # through let a guest fabricate a status the oracle never emits:
              # `proc_exit(255)` exited 255 here and 1 under wasmtime.
              pxc: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              if wabi.proc_exit_refused(pxc) == 1
                io.stderr:write("wasm: proc_exit(" .. pxc:to(str) .. ") is outside the range wasi_snapshot_preview1 permits (0-" .. wabi.PROC_EXIT_MAX:to(str) .. ")\n")
              os.exit(wabi.proc_exit_status(pxc))
              hrv = wabi.ERRNO_success
            elseif hid == wabi.i_random_get
              # random_get(buf, len). It filled nothing and reported success.
              rgp: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              rgl: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
              if rngseeded == 0
                math.randomseed(os.time() + math.floor(os.clock() * 1000000.0))
                rngseeded = 1
              rgi: i64 = 0
              while rgi < rgl and rgp + rgi < linsz
                mem.write_byte(lin, rgp + rgi, math.random(0, 255))
                rgi += 1
              hrv = wabi.ERRNO_success
            elseif hid == wabi.i_clock_time_get
              # clock_time_get(id, precision, ptr). It wrote nothing, so a
              # clock never advanced. An INVALID clock id TRAPS — measured:
              # wasmtime exits 1 with "Invalid enum value Clockid", it does
              # not return an errno.
              cid: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              if cid > 3
                return bail(op, pc)
              ctv: i64 = os.time() * 1000000000 + math.floor(os.clock() * 1000000000.0)
              ctp: i64 = mem.read_i64(st, (ab + 3) * 8) & M32
              cbi: i64 = 0
              while cbi < 8 and ctp + cbi < linsz
                mem.write_byte(lin, ctp + cbi, (ctv >> (cbi * 8)) & 255)
                cbi += 1
              hrv = wabi.ERRNO_success
            elseif hid == wabi.i_clock_res_get
              crid: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              if crid > 3
                return bail(op, pc)
              crv: i64 = 1000
              if crid == 0
                # os.time() moves in whole seconds; saying "1 ns" would be a
                # measurement claim the source cannot support.
                crv = 1000000000
              crp: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
              cri: i64 = 0
              while cri < 8 and crp + cri < linsz
                mem.write_byte(lin, crp + cri, (crv >> (cri * 8)) & 255)
                cri += 1
              hrv = wabi.ERRNO_success
            elseif hid == wabi.i_args_sizes_get
              # One argument, the module path — the same convention wasmtime
              # uses for argv[0].
              av0: str = wabi.argv0_of(env("DUO_WASM_MODULE") or "module.wasm")
              avl: i64 = string.len(av0) + 1
              asp: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              abp: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
              asi: i64 = 0
              while asi < 4 and asp + asi < linsz
                mem.write_byte(lin, asp + asi, (1 >> (asi * 8)) & 255)
                asi += 1
              asj: i64 = 0
              while asj < 4 and abp + asj < linsz
                mem.write_byte(lin, abp + asj, (avl >> (asj * 8)) & 255)
                asj += 1
              hrv = wabi.ERRNO_success
            elseif hid == wabi.i_args_get
              ag0: str = wabi.argv0_of(env("DUO_WASM_MODULE") or "module.wasm")
              agp: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              agb: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
              agi: i64 = 0
              while agi < 4 and agp + agi < linsz
                mem.write_byte(lin, agp + agi, (agb >> (agi * 8)) & 255)
                agi += 1
              agj: i64 = 1
              while agj <= string.len(ag0) and agb + agj - 1 < linsz
                mem.write_byte(lin, agb + agj - 1, string.byte(ag0, agj))
                agj += 1
              if agb + string.len(ag0) < linsz
                mem.write_byte(lin, agb + string.len(ag0), 0)
              hrv = wabi.ERRNO_success
            elseif hid == wabi.i_environ_sizes_get
              # The environment world is empty by policy. Both counts are zero,
              # and zero is a fact the guest can act on, not a stub.
              esp: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              esb: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
              esi: i64 = 0
              while esi < 4 and esp + esi < linsz
                mem.write_byte(lin, esp + esi, 0)
                esi += 1
              esj: i64 = 0
              while esj < 4 and esb + esj < linsz
                mem.write_byte(lin, esb + esj, 0)
                esj += 1
              hrv = wabi.ERRNO_success
            elseif hid == wabi.i_fd_close
              hrv = wabi.ERRNO_badf
              if wabi.fd_kind(mem.read_i64(st, (ab + 1) * 8) & M32) == 1
                hrv = wabi.ERRNO_success
            elseif hid == wabi.i_fd_seek or hid == wabi.i_fd_tell
              # Seeking a stream is `spipe`, which is what a guest's ftell on a
              # pipe must see. `success` told every buffered-IO guest that
              # stdout was a seekable file.
              hrv = wabi.ERRNO_badf
              if wabi.fd_kind(mem.read_i64(st, (ab + 1) * 8) & M32) == 1
                hrv = wabi.ERRNO_spipe
            elseif hid == wabi.i_fd_pwrite
              # MEASURED: spipe on fd 1 and 2 (a positional write to a stream
              # is refused for being unseekable), badf on fd 0 and on 999.
              pwf: i64 = mem.read_i64(st, (ab + 1) * 8) & M32
              hrv = wabi.ERRNO_badf
              if pwf == 1 or pwf == 2
                hrv = wabi.ERRNO_spipe
            elseif hid == wabi.i_fd_fdstat_get
              hrv = wabi.ERRNO_badf
              if wabi.fd_kind(mem.read_i64(st, (ab + 1) * 8) & M32) == 1
                fsp: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
                fsi: i64 = 0
                while fsi < 24 and fsp + fsi < linsz
                  mem.write_byte(lin, fsp + fsi, 0)
                  fsi += 1
                if fsp < linsz
                  mem.write_byte(lin, fsp, wabi.stdio_filetype)
                # rights_base / rights_inheriting: grant everything, so
                # wasi-libc's read()/write() rights checks never reject stdio.
                fsr: i64 = 8
                while fsr < 24 and fsp + fsr < linsz
                  mem.write_byte(lin, fsp + fsr, 255)
                  fsr += 1
                hrv = wabi.ERRNO_success
            elseif hid == wabi.i_fd_filestat_get
              hrv = wabi.ERRNO_badf
              if wabi.fd_kind(mem.read_i64(st, (ab + 1) * 8) & M32) == 1
                flp: i64 = mem.read_i64(st, (ab + 2) * 8) & M32
                fli: i64 = 0
                while fli < 64 and flp + fli < linsz
                  mem.write_byte(lin, flp + fli, 0)
                  fli += 1
                if flp + 16 < linsz
                  mem.write_byte(lin, flp + 16, wabi.stdio_filetype)
                hrv = wabi.ERRNO_success
            elseif hid == wabi.i_poll_oneoff
              # MEASURED: inval for nsubscriptions = 0. For a non-empty
              # subscription set a real wait is required and this toolchain
              # exposes no sleep or select primitive, so the answer is a
              # refusal. A fabricated ready-event would make a guest spin or
              # mis-time silently; `nosys` makes it fail visibly.
              hrv = wabi.ERRNO_nosys
              if (mem.read_i64(st, (ab + 3) * 8) & M32) == 0
                hrv = wabi.ERRNO_inval
            else
              return bail(op, pc)
          sp = ab
          if irn > 0
            sp += 1
            mem.write_i64(st, sp * 8, hrv & M32)
        else
        fx: i64 = imm2 - nimp
        if fx < 0 or fx >= nfn or depth >= 63
          return bail(op, pc)
        mem.write_i64(fr, (depth * 8) * 8, pc)
        mem.write_i64(fr, (depth * 8 + 1) * 8, cur_end)
        mem.write_i64(fr, (depth * 8 + 2) * 8, lbase)
        mem.write_i64(fr, (depth * 8 + 3) * 8, lsp)
        mem.write_i64(fr, (depth * 8 + 4) * 8, lsp_base)
        depth += 1
        nb: i64 = lbase + 64
        npc: i64 = mem.read_i64(ftab, (fx * 4 + 3) * 8)
        nlc2: i64 = mem.read_i64(ftab, (fx * 4 + 2) * 8)
        if nb + 64 > 64 * 64 or npc > sp
          return bail(op, pc)
        # Arguments sit on the operand stack with the LAST param on top, so
        # fill the callee's locals downwards as they pop.
        ka: i64 = npc - 1
        while ka >= 0
          mem.write_i64(lo, (nb + ka) * 8, mem.read_i64(st, sp * 8))
          sp -= 1
          ka -= 1
        za: i64 = npc
        while za < npc + nlc2
          mem.write_i64(lo, (nb + za) * 8, 0)
          za += 1
        lbase = nb
        lsp_base = lsp
        # Do NOT reset lsp. `ltgt` is ONE shared label buffer, so starting the
        # callee at 0 made its labels overwrite the caller's: a call inside a
        # loop, to a callee that also loops, returned the caller's first
        # iteration value and exited (1 instead of 10). Branch depths are
        # relative to the top of the stack, so letting the callee's labels
        # stack ABOVE the caller's is correct; the frame pop restores lsp.
        pc = mem.read_i64(ftab, (fx * 4) * 8)
        cur_end = mem.read_i64(ftab, (fx * 4 + 1) * 8)

      elseif op == OP_global_get
        # global.get (immediate already decoded into imm2 via himm)
        if imm2 < 0 or imm2 >= 64
          return bail(op, pc)
        sp += 1
        mem.write_i64(st, sp * 8, mem.read_i64(gl, imm2 * 8))

      elseif op == OP_global_set
        # global.set
        if sp < 1 or imm2 < 0 or imm2 >= 64
          return bail(op, pc)
        mem.write_i64(gl, imm2 * 8, mem.read_i64(st, sp * 8))
        sp -= 1

      elseif op == OP_block or op == OP_if_
        # block (0x02) / if (0x04): branch target is just past the matching
        # `end`. Scan forward tracking nesting; also record the `else` for `if`.
        if lsp >= 64 * 64 - 1
          return bail(op, pc)
        pc += 1                       # blocktype
        d: i64 = 1
        sc: i64 = pc
        epc: i64 = 0
        # Skip immediates by opcode. This must cover EVERY immediate-carrying
        # opcode, not just the ones the cold path decodes: an unskipped operand
        # byte is read as an opcode and the scan desyncs, so the block gets a
        # wrong branch target. (`himm` is not usable here # it deliberately
        # omits local.get/local.tee, which the hot path decodes inline.)
        while sc < cur_end and d > 0
          sb: i64 = mem.read_byte(code, sc)
          sc += 1
          if sb == 2 or sb == 3 or sb == 4
            d += 1
            sc += 1                       # blocktype byte
          elseif sb == 11
            d -= 1
          elseif sb == 5 and d == 1
            epc = sc
          elseif sb == 14
            # br_table: count, then count+1 depths
            ncase: i64 = 0
            shc: i64 = 0
            cc2: i64 = 1
            while cc2 == 1 and sc < cur_end
              cb: i64 = mem.read_byte(code, sc)
              sc += 1
              ncase |= ((cb & 0x7F) << shc)
              shc += 7
              if cb < 0x80
                cc2 = 0
            kc: i64 = 0
            while kc <= ncase and sc < cur_end
              while sc < cur_end and mem.read_byte(code, sc) >= 0x80
                sc += 1
              sc += 1
              kc += 1
          elseif sb == 63 or sb == 64
            sc += 1                       # memory.size / memory.grow: memidx
          elseif sb == 67
            sc += 4                       # f32.const
          elseif sb == 68
            sc += 8                       # f64.const
          elseif (sb >= 40 and sb <= 62) or sb == 17
            # loads/stores carry align+offset; call_indirect type+table
            while sc < cur_end and mem.read_byte(code, sc) >= 0x80
              sc += 1
            sc += 1
            while sc < cur_end and mem.read_byte(code, sc) >= 0x80
              sc += 1
            sc += 1
          elseif sb == 252
            # 0xFC prefix: sub-opcode LEB, then its own immediates. Without
            # this the scan reads a memidx byte as an opcode and the block's
            # computed end lands MID-INSTRUCTION — a branch then jumps into
            # the middle of `memory.fill` and reads its 0x00 memidx as
            # `unreachable`.
            fsub: i64 = 0
            fsh: i64 = 0
            fc2: i64 = 1
            while fc2 == 1 and sc < cur_end
              fb2: i64 = mem.read_byte(code, sc)
              sc += 1
              fsub |= ((fb2 & 0x7F) << fsh)
              fsh += 7
              if fb2 < 0x80
                fc2 = 0
            if fsub == 10 or fsub == 14
              sc += 2                    # two memidx/tableidx bytes
            elseif fsub == 11
              sc += 1
            elseif fsub == 8 or fsub == 12
              while sc < cur_end and mem.read_byte(code, sc) >= 0x80
                sc += 1
              sc += 2                    # segment idx LEB + mem/table byte
            elseif fsub == 9 or fsub == 13 or fsub == 15 or fsub == 16 or fsub == 17
              while sc < cur_end and mem.read_byte(code, sc) >= 0x80
                sc += 1
              sc += 1
          elseif sb == 253
            # SIMD: sub-opcode LEB, and v128.const carries 16 bytes
            vs2: i64 = 0
            vh2: i64 = 0
            vq: i64 = 1
            while vq == 1 and sc < cur_end
              vy: i64 = mem.read_byte(code, sc)
              sc += 1
              vs2 |= ((vy & 0x7F) << vh2)
              vh2 += 7
              if vy < 0x80
                vq = 0
            if vs2 == 12
              sc += 16
          elseif sb == 208
            sc += 1                      # ref.null reftype byte
          elseif sb == 210 or sb == 37 or sb == 38
            # ref.func funcidx / table.get / table.set: one LEB
            while sc < cur_end and mem.read_byte(code, sc) >= 0x80
              sc += 1
            sc += 1
          elseif sb == 12 or sb == 13 or sb == 16 or (sb >= 32 and sb <= 36) or sb == 65 or sb == 66
            # br, br_if, call, local.*/global.*, i32.const, i64.const
            while sc < cur_end and mem.read_byte(code, sc) >= 0x80
              sc += 1
            sc += 1
        mem.write_i64(ltgt, lsp * 8, sc)
        mem.write_i64(lelse, lsp * 8, epc)
        lsp += 1
        if op == OP_if_
          if sp < 1
            return bail(op, pc)
          cv2: i64 = mem.read_i64(st, sp * 8)
          sp -= 1
          if cv2 == 0
            if epc != 0
              pc = epc
            else
              pc = sc
              lsp -= 1

      elseif op == OP_else_
        # else: reached only by falling out of the taken `if` arm; skip to end
        if lsp < 1
          return bail(op, pc)
        pc = mem.read_i64(ltgt, (lsp - 1) * 8)
        lsp -= 1

      elseif op == OP_br_table
        # br_table: count, then count+1 target depths; index from the stack
        if sp < 1
          return bail(op, pc)
        nt: i64 = 0
        shn: i64 = 0
        cn: i64 = 1
        while cn == 1
          nb: i64 = mem.read_byte(code, pc)
          pc += 1
          nt |= ((nb & 0x7F) << shn)
          shn += 7
          if nb < 0x80
            cn = 0
        idxv: i64 = mem.read_i64(st, sp * 8) & M32
        sp -= 1
        chosen: i64 = 0
        ti: i64 = 0
        while ti <= nt
          dv: i64 = 0
          shd2: i64 = 0
          cd2: i64 = 1
          while cd2 == 1
            db: i64 = mem.read_byte(code, pc)
            pc += 1
            dv |= ((db & 0x7F) << shd2)
            shd2 += 7
            if db < 0x80
              cd2 = 0
          if ti == idxv or (idxv >= nt and ti == nt)
            chosen = dv
          ti += 1
        lt2: i64 = lsp - 1 - chosen
        if lt2 < 0 or lt2 >= 64
          return bail(op, pc)
        # Pop the label stack exactly as `br` does. This used to be
        # `lsp = lsp - chosen`, one level too high, so any branch taken AFTER a
        # br_table resolved to the wrong label. No corpus module exercised that
        # shape; a test written for the JIT caught it, with the JIT returning
        # 100 and the interpreter 200.
        tgt4: i64 = mem.read_i64(ltgt, lt2 * 8)
        if tgt4 <= pc
          lsp = lt2 + 1
        else
          lsp = lt2
        pc = tgt4

      elseif op >= OP_i32_clz and op <= OP_i32_popcnt
        # i32.clz / ctz / popcnt
        if sp < 1
          return bail(op, pc)
        xv: i64 = mem.read_i64(st, sp * 8) & M32
        rr: i64 = 0
        if op == OP_i32_clz
          if xv == 0
            rr = 32
          else
            bi: i64 = 31
            while bi >= 0 and ((xv >> bi) & 1) == 0
              rr += 1
              bi -= 1
        elseif op == OP_i32_ctz
          if xv == 0
            rr = 32
          else
            bj: i64 = 0
            while bj < 32 and ((xv >> bj) & 1) == 0
              rr += 1
              bj += 1
        else
          bk: i64 = 0
          while bk < 32
            rr += ((xv >> bk) & 1)
            bk += 1
        mem.write_i64(st, sp * 8, rr)
        sp = sp

      elseif (op >= OP_i32_load and op <= OP_f64_load) or (op >= OP_i32_load8_s and op <= OP_i64_load32_u)
        # i32.load (0x28) + sub-width loads 8_s/8_u/16_s/16_u (0x2C..0x2F).
        # Width and sign are descriptor data, not separate arms: one byte loop
        # serves all five, so a new width is a table edit rather than a branch.
        if sp < 1
          return bail(op, pc)
        while pc < cur_end and mem.read_byte(code, pc) >= 0x80
          pc += 1
        pc += 1
        offv: i64 = 0
        sho: i64 = 0
        co: i64 = 1
        while co == 1
          ob: i64 = mem.read_byte(code, pc)
          pc += 1
          offv |= ((ob & 0x7F) << sho)
          sho += 7
          if ob < 0x80
            co = 0
        av2: i64 = mem.read_i64(st, sp * 8) + offv
        # Width and signedness are DATA, one byte loop serves all 14 loads:
        #   1B 44/45 (i32 s/u) 48/49 (i64 s/u)
        #   2B 46/47           50/51
        #   4B 40 (i32) 42 (f32) 52/53 (i64 s/u)
        #   8B 41 (i64) 43 (f64)
        wl: i64 = 4
        if op == OP_i32_load8_s or op == OP_i32_load8_u or op == OP_i64_load8_s or op == OP_i64_load8_u
          wl = 1
        elseif op == OP_i32_load16_s or op == OP_i32_load16_u or op == OP_i64_load16_s or op == OP_i64_load16_u
          wl = 2
        elseif op == OP_i64_load or op == OP_f64_load
          wl = 8
        if av2 + wl > linsz or av2 < 0
          return bail(op, pc)
        # Assemble through the scratch buffer, never `| (byte << (k * 8))`:
        # that form loses the low byte once the value exceeds 2^53.
        mem.write_i64(fb, 0, 0)
        kl: i64 = 0
        while kl < wl
          mem.write_byte(fb, kl, mem.read_byte(lin, av2 + kl))
          kl += 1
        lv: i64 = mem.read_i64(fb, 0)
        if op == OP_i32_load8_s or op == OP_i32_load16_s or op == OP_i64_load8_s or op == OP_i64_load16_s or op == OP_i64_load32_s
          # signed sub-width: sign-extend from the loaded width
          if wl == 1 and lv >= 128
            lv -= 256
          if wl == 2 and lv >= 32768
            lv -= 65536
          if wl == 4 and lv >= 2147483648
            lv -= 4294967296
        # i32-typed results occupy 32 bits; i64/f64 keep the full slot.
        if op == OP_i32_load or (op >= OP_i32_load8_s and op <= OP_i32_load16_u)
          lv = lv & M32
        mem.write_i64(st, sp * 8, lv)
        sp = sp                        # BUG A: arm must not end on a void call

      elseif (op >= OP_i32_store and op <= OP_i64_store32)
        # All 9 stores; width is data:
        #   1B 58 (i32.store8)  60 (i64.store8)
        #   2B 59               61
        #   4B 54 (i32.store) 56 (f32.store) 62 (i64.store32)
        #   8B 55 (i64.store) 57 (f64.store)
        if sp < 2
          return bail(op, pc)
        while pc < cur_end and mem.read_byte(code, pc) >= 0x80
          pc += 1
        pc += 1
        offs: i64 = 0
        shs: i64 = 0
        cs2: i64 = 1
        while cs2 == 1
          sb2: i64 = mem.read_byte(code, pc)
          pc += 1
          offs |= ((sb2 & 0x7F) << shs)
          shs += 7
          if sb2 < 0x80
            cs2 = 0
        sv2: i64 = mem.read_i64(st, sp * 8)
        ad2: i64 = mem.read_i64(st, (sp - 1) * 8) + offs
        ws: i64 = 4
        if op == OP_i32_store8 or op == OP_i64_store8
          ws = 1
        elseif op == OP_i32_store16 or op == OP_i64_store16
          ws = 2
        elseif op == OP_i64_store or op == OP_f64_store
          ws = 8
        if ad2 + ws > linsz or ad2 < 0
          return bail(op, pc)
        # Spill through the scratch buffer so the 8-byte case never needs a
        # `>> 56`, which is where the shift/or form loses precision.
        mem.write_i64(fb, 0, sv2)
        ks: i64 = 0
        while ks < ws
          mem.write_byte(lin, ad2 + ks, mem.read_byte(fb, ks))
          ks += 1
        sp = sp
        sp -= 2

      elseif op == OP_call_indirect
        # call_indirect: `imm2` holds the type index (op 17 is registered in
        # `himm`); a table index LEB follows and must be consumed here or `pc`
        # desyncs. The callee comes off the operand stack and is resolved
        # through the element-initialised table.
        tb2: i64 = mem.read_byte(code, pc)
        pc += 1
        while tb2 >= 0x80
          tb2 = mem.read_byte(code, pc)
          pc += 1
        if sp < 1
          return bail(op, pc)
        tsl: i64 = mem.read_i64(st, sp * 8) & M32
        sp -= 1
        # An index past the table is a wasm TRAP, not an interpreter limit.
        # It used to `bail` (exit 70, "unsupported operand shape"), which reads
        # as the engine's gap when it is the module's own out-of-range call, and it
        # put the two engines on different exit statuses for the same program.
        if tsl >= tbsize
          return bailtrap(pc)
        # An element no segment and no table op ever wrote is a null funcref,
        # and calling one traps. It used to read as funcidx 0, i.e. a real
        # function # the same class of silent wrong call as a missing
        # signature check, one level further out.
        if mem.read_i64(toc, tsl * 8) != 1
          return bailtrap(pc)
        gx: i64 = mem.read_i64(tbl, tsl * 8) - nimp
        if gx < 0 or gx >= nfn
          return bailtrap(pc)
        # Signature check: `imm2` is the type the call site was validated
        # against; `fty[gx]` is the type the callee actually declares. wasm
        # requires a trap when they differ, and skipping it is not a missing
        # feature # it is a silent call into the wrong function with the
        # wrong argument shape, which is the failure class this file has spent
        # a week removing. Compared by INDEX, which is exact here because a
        # module's type section is deduplicated by construction.
        if mem.read_i64(fty, gx * 8) != imm2
          return bailtrap(pc)
        if depth >= 63
          return bail(op, pc)
        mem.write_i64(fr, (depth * 8) * 8, pc)
        mem.write_i64(fr, (depth * 8 + 1) * 8, cur_end)
        mem.write_i64(fr, (depth * 8 + 2) * 8, lbase)
        mem.write_i64(fr, (depth * 8 + 3) * 8, lsp)
        mem.write_i64(fr, (depth * 8 + 4) * 8, lsp_base)
        depth += 1
        gb2: i64 = lbase + 64
        gpc: i64 = mem.read_i64(ftab, (gx * 4 + 3) * 8)
        glc: i64 = mem.read_i64(ftab, (gx * 4 + 2) * 8)
        if gb2 + 64 > 64 * 64 or gpc > sp
          return bail(op, pc)
        kg: i64 = gpc - 1
        while kg >= 0
          mem.write_i64(lo, (gb2 + kg) * 8, mem.read_i64(st, sp * 8))
          sp -= 1
          kg -= 1
        zg: i64 = gpc
        while zg < gpc + glc
          mem.write_i64(lo, (gb2 + zg) * 8, 0)
          zg += 1
        lbase = gb2
        lsp_base = lsp
        pc = mem.read_i64(ftab, (gx * 4) * 8)
        cur_end = mem.read_i64(ftab, (gx * 4 + 1) * 8)

      elseif op == OP_drop
        # drop
        if sp < 1
          return bail(op, pc)
        sp -= 1

      elseif op == OP_i64_const
        # i64.const: signed LEB128, up to 10 bytes, NO 32-bit mask (an i64
        # fills the whole stack slot).
        shq: i64 = 0
        cq: i64 = 1
        vq: i64 = 0
        qb: i64 = 0
        while cq == 1
          qb = mem.read_byte(code, pc)
          pc += 1
          vq |= ((qb & 0x7F) << shq)
          shq += 7
          if qb < 0x80
            cq = 0
        if shq < 64 and (qb & 0x40) != 0
          vq |= (0 - (1 << shq))
        sp += 1
        mem.write_i64(st, sp * 8, vq)
        sp = sp

      elseif op == OP_i64_add or op == OP_i64_sub or op == OP_i64_mul or op == OP_i64_and or op == OP_i64_or or op == OP_i64_xor or op == OP_i64_shl or op == OP_i64_shr_s or op == OP_i64_shr_u
        # i64 ALU: add sub mul and or xor shl shr_s shr_u.
        # No masking: i64 results already occupy the full slot. Shifts use 63.
        if sp < 2
          return bail(op, pc)
        bq: i64 = mem.read_i64(st, sp * 8)
        aq: i64 = mem.read_i64(st, (sp - 1) * 8)
        sp -= 1
        rq: i64 = 0
        if op == OP_i64_add
          rq = aq + bq
        elseif op == OP_i64_sub
          rq = aq - bq
        elseif op == OP_i64_mul
          rq = aq * bq
        elseif op == OP_i64_and
          rq = aq & bq
        elseif op == OP_i64_or
          rq = aq | bq
        elseif op == OP_i64_xor
          rq = aq ~ bq
        elseif op == OP_i64_shl
          rq = aq << (bq & 63)
        elseif op == OP_i64_shr_s
          rq = aq >> (bq & 63)
        else
          # shr_u: logical shift. Duo i64 is signed, so a negative value must
          # not sign-extend; clear the bits shifted in from the top.
          sq: i64 = bq & 63
          if sq == 0
            rq = aq
          else
            # Keep only the 64-sq low bits. For sq >= 1 this is exact:
            # (1 << 63) is i64 min, so (1 << 63) - 1 is i64 max, the right
            # mask for a shift of 1. A shift of 0 is handled above because
            # 1 << 64 would overflow.
            rq = (aq >> sq) & ((1 << (64 - sq)) - 1)
        # `sp` was ALREADY decremented above, so the result slot is `sp`.
        mem.write_i64(st, sp * 8, rq)
        sp = sp

      elseif op == OP_i64_eqz
        # i64.eqz
        if sp < 1
          return bail(op, pc)
        zq: i64 = 0
        if mem.read_i64(st, sp * 8) == 0
          zq = 1
        mem.write_i64(st, sp * 8, zq)
        sp = sp

      elseif op >= OP_i64_eq and op <= OP_i64_ge_u
        # i64 comparisons: eq ne lt_s lt_u gt_s gt_u le_s le_u ge_s ge_u.
        # Unsigned forms cannot use the signed operators directly: when the two
        # operands differ in sign bit, the one with the bit set is the larger
        # unsigned value.
        if sp < 2
          return bail(op, pc)
        bw: i64 = mem.read_i64(st, sp * 8)
        aw: i64 = mem.read_i64(st, (sp - 1) * 8)
        sp -= 1
        lt_signed: i64 = 0
        if aw < bw
          lt_signed = 1
        lt_unsigned: i64 = lt_signed
        if (aw < 0) != (bw < 0)
          lt_unsigned = 0
          if aw >= 0
            lt_unsigned = 1
        rw: i64 = 0
        if op == OP_i64_eq and aw == bw
          rw = 1
        elseif op == OP_i64_ne and aw != bw
          rw = 1
        elseif op == OP_i64_lt_s and lt_signed == 1
          rw = 1
        elseif op == OP_i64_lt_u and lt_unsigned == 1
          rw = 1
        elseif op == OP_i64_gt_s and lt_signed == 0 and aw != bw
          rw = 1
        elseif op == OP_i64_gt_u and lt_unsigned == 0 and aw != bw
          rw = 1
        elseif op == OP_i64_le_s and (lt_signed == 1 or aw == bw)
          rw = 1
        elseif op == OP_i64_le_u and (lt_unsigned == 1 or aw == bw)
          rw = 1
        elseif op == OP_i64_ge_s and lt_signed == 0
          rw = 1
        elseif op == OP_i64_ge_u and lt_unsigned == 0
          rw = 1
        # `sp` was ALREADY decremented above, so the result slot is `sp`, not
        # `sp - 1`. Writing to `sp - 1` put the answer one slot too low and
        # left the old operand on top: every i64 comparison returned its first
        # operand instead of 0/1, so `i64_bench`'s loop never terminated.
        mem.write_i64(st, sp * 8, rw)
        sp = sp

      elseif op == OP_i32_wrap_i64 or op == OP_i64_extend_i32_s or op == OP_i64_extend_i32_u
        # i32.wrap_i64 / i64.extend_i32_s / i64.extend_i32_u
        if sp < 1
          return bail(op, pc)
        xw: i64 = mem.read_i64(st, sp * 8)
        yw: i64 = xw & M32
        if op == OP_i64_extend_i32_s and yw >= 0x80000000
          yw -= 0x100000000
        mem.write_i64(st, sp * 8, yw)
        sp = sp

      elseif op >= OP_i32_reinterpret_f32 and op <= OP_f64_reinterpret_i64
        # i32.reinterpret_f32 / i64.reinterpret_f64 / f32.reinterpret_i32 /
        # f64.reinterpret_i64. Floats already sit on the operand stack as
        # their raw bit pattern, so reinterpreting is the identity; only the
        # 32-bit forms have to clear the high half.
        if sp < 1
          return bail(op, pc)
        if op == OP_i32_reinterpret_f32 or op == OP_f32_reinterpret_i32
          rb: i64 = mem.read_i64(st, sp * 8) & M32
          mem.write_i64(st, sp * 8, rb)
        sp = sp

      elseif op == OP_select
        # select: c = top, then b, then a; result = c != 0 ? a : b
        if sp < 3
          return bail(op, pc)
        csel: i64 = mem.read_i64(st, sp * 8)
        bsel: i64 = mem.read_i64(st, (sp - 1) * 8)
        asel: i64 = mem.read_i64(st, (sp - 2) * 8)
        rsel: i64 = bsel
        if csel != 0
          rsel = asel
        mem.write_i64(st, (sp - 2) * 8, rsel)
        sp -= 2

      elseif op == OP_i32_rotl or op == OP_i32_rotr
        # i32.rotl / i32.rotr
        if sp < 2
          return bail(op, pc)
        brot: i64 = mem.read_i64(st, sp * 8) & 31
        arot: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
        lsh: i64 = brot
        if op == OP_i32_rotr
          lsh = (32 - brot) & 31
        rsh: i64 = (32 - lsh) & 31
        vrot: i64 = arot
        if lsh != 0
          vrot = ((arot << lsh) | (arot >> rsh)) & M32
        mem.write_i64(st, (sp - 1) * 8, vrot)
        sp -= 1

      elseif (op >= OP_i32_div_s and op <= OP_i32_rem_u) or (op >= OP_i64_div_s and op <= OP_i64_rem_u)
        # div_s / div_u / rem_s / rem_u for BOTH widths in one arm: the only
        # difference is the 32-bit mask, so width is data, not a second copy.
        #   109-112 i32    127-130 i64
        if sp < 2
          return bail(op, pc)
        n32: i64 = 0
        if op <= OP_i32_rem_u
          n32 = 1
        bd: i64 = mem.read_i64(st, sp * 8)
        ad: i64 = mem.read_i64(st, (sp - 1) * 8)
        if n32 == 1
          bd = bd & M32
          ad = ad & M32
        if bd == 0
          return bail(op, pc)
        asi: i64 = ad
        bsi: i64 = bd
        if n32 == 1
          if ad >= 0x80000000
            asi = ad - 0x100000000
          if bd >= 0x80000000
            bsi = bd - 0x100000000
        # wasm div_s TRUNCATES toward zero; Duo `//` FLOORS. They differ
        # whenever the operands have opposite signs and the division is
        # inexact: -7/2 is -3 in wasm but -4 floored, and -7%2 is -1 (sign of
        # the dividend) but 1 floored. Correct the quotient once, then derive
        # the remainder from it so both stay consistent.
        qs: i64 = asi // bsi
        if qs * bsi != asi
          if (asi < 0) != (bsi < 0)
            qs += 1
        sgn: i64 = op
        rd: i64 = 0
        if sgn == 109 or sgn == 127
          rd = qs
        elseif sgn == 110 or sgn == 128
          rd = ad // bd
        elseif sgn == 111 or sgn == 129
          rd = asi - qs * bsi
        else
          rd = ad - (ad // bd) * bd
        if n32 == 1
          rd = rd & M32
        mem.write_i64(st, (sp - 1) * 8, rd)
        sp -= 1

      elseif op == OP_i32_lt_s or op == OP_i32_gt_s or op == OP_i32_le_s or op == OP_i32_ge_s
        # signed i32 comparisons: lt_s gt_s le_s ge_s
        if sp < 2
          return bail(op, pc)
        bc: i64 = mem.read_i64(st, sp * 8) & M32
        ac: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
        if ac >= 0x80000000
          ac -= 0x100000000
        if bc >= 0x80000000
          bc -= 0x100000000
        rc: i64 = 0
        if op == OP_i32_lt_s and ac < bc
          rc = 1
        elseif op == OP_i32_gt_s and ac > bc
          rc = 1
        elseif op == OP_i32_le_s and ac <= bc
          rc = 1
        elseif op == OP_i32_ge_s and ac >= bc
          rc = 1
        mem.write_i64(st, (sp - 1) * 8, rc)
        sp -= 1

      elseif op == OP_f64_const
        # f64.const: 8 raw little-endian bytes. Floats live on the operand
        # stack as their BIT PATTERN in the existing i64 slot, so nothing
        # about the stack representation changes # `fb` is the bitcast.
        # Assemble through MEMORY, not arithmetic. Building the 64-bit value
        # with `bq | (byte << (kq * 8))` silently drops the low byte once a
        # high-byte shift makes the operand large: f64.const 1.0001 decoded as
        # 0x3ff00068db8bac00 instead of ...ac71. That is a ~2.7e-14 error #
        # small enough to pass for float noise and corrupt a whole benchmark.
        kq: i64 = 0
        while kq < 8
          mem.write_byte(fb, kq, mem.read_byte(code, pc + kq))
          kq += 1
        bq: i64 = mem.read_i64(fb, 0)
        pc += 8
        sp += 1
        mem.write_i64(st, sp * 8, bq)

      elseif op == OP_f32_const
        # f32.const: 4 raw little-endian bytes
        mem.write_i64(fb, 0, 0)
        kw: i64 = 0
        while kw < 4
          mem.write_byte(fb, kw, mem.read_byte(code, pc + kw))
          kw += 1
        bw: i64 = mem.read_i64(fb, 0)
        pc += 4
        sp += 1
        mem.write_i64(st, sp * 8, bw)

      elseif op >= OP_f64_abs and op <= OP_f64_copysign
        # f64 unary (153-159) and binary (160-166) in ONE arm: they share the
        # bitcast in/out, so only the operator itself differs.
        ar: i64 = 2
        if op <= OP_f64_sqrt
          ar = 1
        if sp < ar
          return bail(op, pc)
        mem.write_i64(fb, 0, mem.read_i64(st, sp * 8))
        db: f64 = mem.load(f64)(fb)
        da: f64 = db
        if ar == 2
          mem.write_i64(fb, 0, mem.read_i64(st, (sp - 1) * 8))
          da = mem.load(f64)(fb)
        dr: f64 = 0.0
        ok: i64 = 1
        if op == OP_f64_add
          dr = da + db
        elseif op == OP_f64_sub
          dr = da - db
        elseif op == OP_f64_mul
          dr = da * db
        elseif op == OP_f64_div
          dr = da / db
        elseif op == OP_f64_min
          dr = da
          if db < da
            dr = db
        elseif op == OP_f64_max
          dr = da
          if db > da
            dr = db
        elseif op == OP_f64_abs
          dr = db
          if db < 0.0
            dr = 0.0 - db
        elseif op == OP_f64_neg
          dr = 0.0 - db
        elseif op == OP_f64_floor
          dr = math.floor(db)
        elseif op == OP_f64_ceil
          dr = math.ceil(db)
        elseif op == OP_f64_sqrt
          dr = math.sqrt(db)
        elseif op == OP_f64_trunc
          # f64.trunc: toward ZERO, so floor for positives, ceil for negatives.
          dr = math.floor(db)
          if db < 0.0
            dr = math.ceil(db)
        elseif op == OP_f64_nearest
          # f64.nearest: IEEE roundTiesToEven, NOT floor(x + 0.5). The tie case
          # must land on the even integer (2.5 -> 2, 3.5 -> 4).
          dfl: f64 = math.floor(db)
          dfr: f64 = db - dfl
          dr = dfl
          if dfr > 0.5
            dr = dfl + 1.0
          elseif dfr == 0.5
            dr = dfl
            if dfl - math.floor(dfl / 2.0) * 2.0 != 0.0
              dr = dfl + 1.0
        elseif op == OP_f64_copysign
          # f64.copysign: magnitude of a, sign of b
          dr = da
          if da < 0.0
            dr = 0.0 - da
          if db < 0.0
            dr = 0.0 - dr
        else
          ok = 0
        if ok == 0
          return bail(op, pc)
        mem.store(f64)(fb, dr)
        mem.write_i64(st, (sp - ar + 1) * 8, mem.read_i64(fb, 0))
        # THE RESULT IS ALREADY ON THE STACK: it was just written at
        # `sp - ar + 1`, so the arity `ar` has been consumed and ONE value
        # produced, i.e. the depth falls by `ar - 1` — by one for a binary op
        # and by nothing for a unary one.
        #
        # This said `sp -= ar + 1`, which is off by TWO in the wrong direction:
        # every f64 binary op dropped THREE slots for two operands and every
        # unary op dropped two for one. The stack went negative on the first
        # float operation and the NEXT float op then failed its `sp < ar`
        # guard, so the engine refused a body it had already half-executed and
        # blamed the wrong opcode. Measured: `bench/jit_f64.wasm` (const,
        # const, add, const, mul, ...) reported "cannot execute opcode 162
        # (f64.mul) at body offset 32" while the fault was in `f64.add` at
        # offset 24. Fifteen of the sixty-five fixtures in `test/conform.id`
        # bailed this way — every one of them a float module.
        sp -= ar - 1

      elseif op >= OP_f32_abs and op <= OP_f32_copysign
        # f32 unary (139-145) and binary (146-152), mirroring the f64 arm.
        # The slot holds the 32-bit pattern; mem.load(f32)(fb) reads the low
        # 4 bytes, so the same scratch buffer serves both widths.
        sr: i64 = 2
        if op <= OP_f32_sqrt
          sr = 1
        if sp < sr
          return bail(op, pc)
        mem.write_i64(fb, 0, mem.read_i64(st, sp * 8))
        eb: f32 = mem.load(f32)(fb)
        ea: f32 = eb
        if sr == 2
          mem.write_i64(fb, 0, mem.read_i64(st, (sp - 1) * 8))
          ea = mem.load(f32)(fb)
        er: f32 = 0.0
        eok: i64 = 1
        if op == OP_f32_add
          er = ea + eb
        elseif op == OP_f32_sub
          er = ea - eb
        elseif op == OP_f32_mul
          er = ea * eb
        elseif op == OP_f32_div
          er = ea / eb
        elseif op == OP_f32_min
          er = ea
          if eb < ea
            er = eb
        elseif op == OP_f32_max
          er = ea
          if eb > ea
            er = eb
        elseif op == OP_f32_abs
          er = eb
          if eb < 0.0
            er = 0.0 - eb
        elseif op == OP_f32_neg
          er = 0.0 - eb
        elseif op == OP_f32_sqrt
          er = math.sqrt(eb)
        elseif op == OP_f32_ceil
          er = math.ceil(eb)
        elseif op == OP_f32_floor
          er = math.floor(eb)
        elseif op == OP_f32_trunc
          er = math.floor(eb)
          if eb < 0.0
            er = math.ceil(eb)
        elseif op == OP_f32_nearest
          efl: f32 = math.floor(eb)
          efr: f32 = eb - efl
          er = efl
          if efr > 0.5
            er = efl + 1.0
          elseif efr == 0.5
            er = efl
            if efl - math.floor(efl / 2.0) * 2.0 != 0.0
              er = efl + 1.0
        elseif op == OP_f32_copysign
          er = ea
          if ea < 0.0
            er = 0.0 - ea
          if eb < 0.0
            er = 0.0 - er
        else
          eok = 0
        if eok == 0
          return bail(op, pc)
        mem.write_i64(fb, 0, 0)
        mem.store(f32)(fb, er)
        mem.write_i64(st, (sp - sr + 1) * 8, mem.read_i64(fb, 0))
        # Same correction as the f64 arm above, and the same bug byte for byte:
        # one value is produced where `sr` were consumed, so the depth falls by
        # `sr - 1`, not rises past the floor by `sr + 1`.
        sp -= sr - 1

      elseif op >= OP_f32_eq and op <= OP_f32_ge
        # f32 comparisons -> i32 0/1
        if sp < 2
          return bail(op, pc)
        mem.write_i64(fb, 0, mem.read_i64(st, sp * 8))
        gb: f32 = mem.load(f32)(fb)
        mem.write_i64(fb, 0, mem.read_i64(st, (sp - 1) * 8))
        ga: f32 = mem.load(f32)(fb)
        gr: i64 = 0
        if op == OP_f32_eq and ga == gb
          gr = 1
        elseif op == OP_f32_ne and ga != gb
          gr = 1
        elseif op == OP_f32_lt and ga < gb
          gr = 1
        elseif op == OP_f32_gt and ga > gb
          gr = 1
        elseif op == OP_f32_le and ga <= gb
          gr = 1
        elseif op == OP_f32_ge and ga >= gb
          gr = 1
        mem.write_i64(st, (sp - 1) * 8, gr)
        sp -= 1

      elseif op >= OP_f64_eq and op <= OP_f64_ge
        # f64 comparisons -> i32 0/1
        if sp < 2
          return bail(op, pc)
        mem.write_i64(fb, 0, mem.read_i64(st, sp * 8))
        cb: f64 = mem.load(f64)(fb)
        mem.write_i64(fb, 0, mem.read_i64(st, (sp - 1) * 8))
        ca: f64 = mem.load(f64)(fb)
        cr: i64 = 0
        if op == OP_f64_eq and ca == cb
          cr = 1
        elseif op == OP_f64_ne and ca != cb
          cr = 1
        elseif op == OP_f64_lt and ca < cb
          cr = 1
        elseif op == OP_f64_gt and ca > cb
          cr = 1
        elseif op == OP_f64_le and ca <= cb
          cr = 1
        elseif op == OP_f64_ge and ca >= cb
          cr = 1
        mem.write_i64(st, (sp - 1) * 8, cr)
        sp -= 1

      elseif op == OP_f64_convert_i32_s
        # f64.convert_i32_s: reinterpret the top slot from a signed i32 to
        # f64 bits. (i32.trunc_f64_* needs an f64->i64 narrowing Duo has no
        # operator for, so it stays unimplemented rather than guessed at.)
        if sp < 1
          return bail(op, pc)
        iv: i64 = mem.read_i64(st, sp * 8) & M32
        if iv >= 2147483648
          iv -= 4294967296
        mem.store(f64)(fb, iv * 1.0)
        mem.write_i64(st, sp * 8, mem.read_i64(fb, 0))

      elseif op == OP_i32_eq or op == OP_i32_gt_u or op == OP_i32_le_u or op == OP_i32_ge_u
        # i32 eq / gt_u / le_u / ge_u # the unsigned comparisons the original
        # chain skipped. i32.ge_u alone appears 15x in the corpus.
        if sp < 2
          return bail(op, pc)
        ub: i64 = mem.read_i64(st, sp * 8) & M32
        ua: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
        ur: i64 = 0
        if op == OP_i32_eq and ua == ub
          ur = 1
        elseif op == OP_i32_gt_u and ua > ub
          ur = 1
        elseif op == OP_i32_le_u and ua <= ub
          ur = 1
        elseif op == OP_i32_ge_u and ua >= ub
          ur = 1
        mem.write_i64(st, (sp - 1) * 8, ur)
        sp -= 1

      elseif op >= OP_i32_trunc_f32_s and op <= OP_f64_promote_f32
        # Numeric conversions. 167/172/173 (wrap, extend_i32_s/u) are handled
        # by their own arm earlier in this chain, so this covers the rest:
        #   168-171 i32.trunc_f32/f64_s/u     174-177 i64.trunc_f32/f64_s/u
        #   178-181 f32.convert_i32/i64_s/u   183-186 f64.convert_i32/i64_s/u
        #   182 f32.demote_f64                187 f64.promote_f32
        if sp < 1
          return bail(op, pc)
        raw: i64 = mem.read_i64(st, sp * 8)
        if op == OP_f32_demote_f64
          mem.write_i64(fb, 0, raw)
          dv2: f64 = mem.load(f64)(fb)
          mem.write_i64(fb, 0, 0)
          mem.store(f32)(fb, dv2)
          mem.write_i64(st, sp * 8, mem.read_i64(fb, 0))
        elseif op == OP_f64_promote_f32
          mem.write_i64(fb, 0, raw)
          ev2: f32 = mem.load(f32)(fb)
          mem.store(f64)(fb, ev2)
          mem.write_i64(st, sp * 8, mem.read_i64(fb, 0))
        elseif op >= OP_f32_convert_i32_s
          # integer -> float
          iv2: i64 = raw
          if op == OP_f32_convert_i32_s or op == OP_f32_convert_i32_u or op == OP_f64_convert_i32_s or op == OP_f64_convert_i32_u
            iv2 = raw & M32
            if op == OP_f32_convert_i32_s or op == OP_f64_convert_i32_s
              if iv2 >= 0x80000000
                iv2 -= 0x100000000
          fv2: f64 = iv2 * 1.0
          mem.write_i64(fb, 0, 0)
          if op <= OP_f32_convert_i64_u
            mem.store(f32)(fb, fv2)
          else
            mem.store(f64)(fb, fv2)
          mem.write_i64(st, sp * 8, mem.read_i64(fb, 0))
        else
          # float -> integer, truncating TOWARD ZERO (not floor: -2.7 -> -2)
          mem.write_i64(fb, 0, raw)
          src: f64 = 0.0
          if op == OP_i32_trunc_f32_s or op == OP_i32_trunc_f32_u or op == OP_i64_trunc_f32_s or op == OP_i64_trunc_f32_u
            sf: f32 = mem.load(f32)(fb)
            src = sf
          else
            src = mem.load(f64)(fb)
          # Truncation toward zero IS the C double->int64_t conversion, so a
          # typed store performs it directly. This replaces
          # `math.tointeger(x:floor())` plus a `ceil` branch for negatives:
          # fewer tokens, no boxed `lua_math_tointeger` call, and -2.7 -> -2
          # falls out for free. `tointeger` is also the third category that
          # spec 2.10 G3 forbids # the canonical surface is `to(int)`, which
          # is not yet spellable (see the filed P0).
          mem.store(i64)(fb, src)
          ti: i64 = mem.read_i64(fb, 0)
          if op <= OP_i32_trunc_f64_u
            ti = ti & M32
          mem.write_i64(st, sp * 8, ti)

      elseif op >= OP_i64_clz and op <= OP_i64_popcnt
        # i64.clz / ctz / popcnt. Same shape as the i32 arm with width 64;
        # kept separate only because the i32 arm masks with M32.
        if sp < 1
          return bail(op, pc)
        yv: i64 = mem.read_i64(st, sp * 8)
        cr2: i64 = 0
        bq2: i64 = 0
        if op == OP_i64_clz
          bq2 = 63
          while bq2 >= 0 and ((yv >> bq2) & 1) == 0
            cr2 += 1
            bq2 -= 1
        elseif op == OP_i64_ctz
          while bq2 < 64 and ((yv >> bq2) & 1) == 0
            cr2 += 1
            bq2 += 1
        else
          while bq2 < 64
            cr2 += ((yv >> bq2) & 1)
            bq2 += 1
        mem.write_i64(st, sp * 8, cr2)
        sp = sp

      elseif op == OP_i64_rotl or op == OP_i64_rotr
        # i64.rotl / rotr
        if sp < 2
          return bail(op, pc)
        br2: i64 = mem.read_i64(st, sp * 8) & 63
        ar2: i64 = mem.read_i64(st, (sp - 1) * 8)
        ls2: i64 = br2
        if op == OP_i64_rotr
          ls2 = (64 - br2) & 63
        vr2: i64 = ar2
        if ls2 != 0
          rs2: i64 = 64 - ls2
          vr2 = (ar2 << ls2) | ((ar2 >> rs2) & ((1 << ls2) - 1))
        mem.write_i64(st, (sp - 1) * 8, vr2)
        sp -= 1

      elseif op >= OP_i32_extend8_s and op <= OP_i64_extend32_s
        # sign-extension ops; the source WIDTH is data:
        #   192 i32.extend8_s  193 i32.extend16_s
        #   194 i64.extend8_s  195 i64.extend16_s  196 i64.extend32_s
        if sp < 1
          return bail(op, pc)
        we: i64 = 1
        if op == OP_i32_extend16_s or op == OP_i64_extend16_s
          we = 2
        elseif op == OP_i64_extend32_s
          we = 4
        ev3: i64 = mem.read_i64(st, sp * 8)
        if we == 1
          ev3 = ev3 & 255
          if ev3 >= 128
            ev3 -= 256
        elseif we == 2
          ev3 = ev3 & 65535
          if ev3 >= 32768
            ev3 -= 65536
        else
          ev3 = ev3 & M32
          if ev3 >= 2147483648
            ev3 -= 4294967296
        if op <= OP_i32_extend16_s
          ev3 = ev3 & M32
        mem.write_i64(st, sp * 8, ev3)
        sp = sp

      elseif op == OP_memory_size or op == OP_memory_grow
        # memory.size / memory.grow. the engine's linear memory is the module's
        # DECLARED page count and never grows, so size is that count (it used
        # to be the literal 1, which is wrong for every module above one page)
        # and grow always refuses (-1), which is a legal wasm answer rather
        # than a bail.
        pc += 1                        # memidx byte
        if op == OP_memory_size
          sp += 1
          mem.write_i64(st, sp * 8, mempages)
        else
          if sp < 1
            return bail(op, pc)
          # -1 as an unsigned i32. Bound to a typed local first: passing the
          # `M32` const straight as an argument makes codegen box it.
          gf: i64 = M32
          mem.write_i64(st, sp * 8, gf)

      elseif op == OP_table_get or op == OP_table_set
        # table.get (37) / table.set (38); tableidx immediate is in imm2's
        # position but these are not in himm, so consume it here.
        while pc < cur_end and mem.read_byte(code, pc) >= 0x80
          pc += 1
        pc += 1
        if op == OP_table_get
          if sp < 1
            return bail(op, pc)
          ti2: i64 = mem.read_i64(st, sp * 8) & M32
          if ti2 >= 4096
            return bail(op, pc)
          mem.write_i64(st, sp * 8, mem.read_i64(tbl, ti2 * 8))
        else
          if sp < 2
            return bail(op, pc)
          tv2: i64 = mem.read_i64(st, sp * 8)
          ti3: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
          if ti3 < 4096
            mem.write_i64(tbl, ti3 * 8, tv2)
            mem.write_i64(toc, ti3 * 8, 1)
          sp -= 2

      elseif op == OP_prefix_fc
        # 0xFC prefix: bulk memory and table ops. Sub-opcode is a LEB.
        # Immediates here are single-byte LEBs in practice: sub-opcodes are
        # 8..17, memidx is 0, and segment indices are small. A multi-byte
        # index would need the full decode.
        sub: i64 = mem.read_byte(code, pc)
        pc += 1
        if sub == 10
          # memory.copy: two memidx bytes; stack dst, src, len
          pc += 2
          if sp < 3
            return bail(op, pc)
          cln: i64 = mem.read_i64(st, sp * 8) & M32
          csr: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
          cds: i64 = mem.read_i64(st, (sp - 2) * 8) & M32
          if cds + cln > linsz or csr + cln > linsz
            return bail(op, pc)
          # copy direction matters when the ranges overlap
          if cds <= csr
            ck: i64 = 0
            while ck < cln
              mem.write_byte(lin, cds + ck, mem.read_byte(lin, csr + ck))
              ck += 1
          else
            ck2: i64 = cln - 1
            while ck2 >= 0
              mem.write_byte(lin, cds + ck2, mem.read_byte(lin, csr + ck2))
              ck2 -= 1
          sp -= 3
        elseif sub == 11
          # memory.fill: one memidx byte; stack dst, val, len
          pc += 1
          if sp < 3
            return bail(op, pc)
          fln: i64 = mem.read_i64(st, sp * 8) & M32
          fvl: i64 = mem.read_i64(st, (sp - 1) * 8) & 255
          fds: i64 = mem.read_i64(st, (sp - 2) * 8) & M32
          if fds + fln > linsz
            return bail(op, pc)
          fk: i64 = 0
          while fk < fln
            mem.write_byte(lin, fds + fk, fvl)
            fk += 1
          sp -= 3
        elseif sub == 8
          # memory.init: dataidx LEB then a memidx byte; stack dst, off, len
          dix: i64 = mem.read_byte(code, pc)
          pc += 2
          if sp < 3 or dix >= 64
            return bail(op, pc)
          iln: i64 = mem.read_i64(st, sp * 8) & M32
          iso: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
          ids: i64 = mem.read_i64(st, (sp - 2) * 8) & M32
          sbase: i64 = mem.read_i64(dseg, (dix * 2) * 8)
          ik: i64 = 0
          while ik < iln and ids + ik < linsz
            mem.write_byte(lin, ids + ik, img:byte(sbase + iso + ik))
            ik += 1
          sp -= 3
        elseif sub == 9 or sub == 13
          # data.drop / elem.drop: the engine keeps segments for the whole run, so
          # dropping is a no-op. Consume the segment index.
          pc += 1
          sp = sp
        elseif sub == 12
          # table.init: elemidx then tableidx; stack dst, off, len
          eix: i64 = mem.read_byte(code, pc)
          pc += 2
          if sp < 3 or eix >= 64
            return bail(op, pc)
          tln: i64 = mem.read_i64(st, sp * 8) & M32
          tso: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
          tds: i64 = mem.read_i64(st, (sp - 2) * 8) & M32
          ebase: i64 = mem.read_i64(eseg, (eix * 2) * 8)
          eb2: i64 = ebase
          esk: i64 = 0
          while esk < tso and eb2 <= n
            eb2 = uleb_end(img, eb2, n)
            esk += 1
          tk: i64 = 0
          while tk < tln and tds + tk < 4096
            mem.write_i64(tbl, (tds + tk) * 8, uleb_val(img, eb2, n))
            mem.write_i64(toc, (tds + tk) * 8, 1)
            eb2 = uleb_end(img, eb2, n)
            tk += 1
          sp -= 3
        elseif sub == 14
          # table.copy: two tableidx bytes; stack dst, src, len
          pc += 2
          if sp < 3
            return bail(op, pc)
          yln: i64 = mem.read_i64(st, sp * 8) & M32
          ysr: i64 = mem.read_i64(st, (sp - 1) * 8) & M32
          yds: i64 = mem.read_i64(st, (sp - 2) * 8) & M32
          if yds <= ysr
            yk: i64 = 0
            while yk < yln and yds + yk < 4096 and ysr + yk < 4096
              mem.write_i64(tbl, (yds + yk) * 8, mem.read_i64(tbl, (ysr + yk) * 8))
              mem.write_i64(toc, (yds + yk) * 8, mem.read_i64(toc, (ysr + yk) * 8))
              yk += 1
          else
            yk2: i64 = yln - 1
            while yk2 >= 0
              if yds + yk2 < 4096 and ysr + yk2 < 4096
                mem.write_i64(tbl, (yds + yk2) * 8, mem.read_i64(tbl, (ysr + yk2) * 8))
                mem.write_i64(toc, (yds + yk2) * 8, mem.read_i64(toc, (ysr + yk2) * 8))
              yk2 -= 1
          sp -= 3
        elseif sub == 15
          # table.grow: tableidx; stack init, delta -> old size
          pc += 1
          if sp < 2
            return bail(op, pc)
          gdl: i64 = mem.read_i64(st, sp * 8) & M32
          sp -= 2
          sp += 1
          mem.write_i64(st, sp * 8, tbsize)
          if tbsize + gdl <= 4096
            tbsize += gdl
        elseif sub == 16
          # table.size: tableidx
          pc += 1
          sp += 1
          mem.write_i64(st, sp * 8, tbsize)
        elseif sub == 17
          # table.fill: tableidx; stack dst, val, len
          pc += 1
          if sp < 3
            return bail(op, pc)
          hln: i64 = mem.read_i64(st, sp * 8) & M32
          hvl: i64 = mem.read_i64(st, (sp - 1) * 8)
          hds: i64 = mem.read_i64(st, (sp - 2) * 8) & M32
          hk: i64 = 0
          while hk < hln and hds + hk < 4096
            mem.write_i64(tbl, (hds + hk) * 8, hvl)
            mem.write_i64(toc, (hds + hk) * 8, 1)
            hk += 1
          sp -= 3
        elseif sub <= 3
          # 0..3: i32.trunc_sat_f32/f64_s/u. SATURATING, which is the whole
          # difference from the 168..171 family: NaN answers 0 and an
          # out-of-range magnitude clamps to the end of the target range where
          # the trapping form would trap. `benchmarks/wasm_rt/loop_f64` is one
          # `i32.trunc_sat_f64_s`, and without it the engine could not run that
          # module on EITHER engine.
          #
          # 4..7, the i64 family, are deliberately NOT here: the u64 upper half
          # has no Duo value to clamp against, so the bound itself would be
          # wrong. They keep falling to `bail`, which names them.
          if sp < 1
            return bail(op, pc)
          qraw: i64 = mem.read_i64(st, sp * 8)
          mem.write_i64(fb, 0, qraw)
          qsrc: f64 = 0.0
          if sub <= 1
            qf: f32 = mem.load(f32)(fb)
            qsrc = qf
          else
            qsrc = mem.load(f64)(fb)
          qv: i64 = 0
          if qsrc == qsrc
            if sub == 0 or sub == 2
              if qsrc <= -2147483648.0
                qv = -2147483648
              elseif qsrc >= 2147483647.0
                qv = 2147483647
              else
                mem.store(i64)(fb, qsrc)
                qv = mem.read_i64(fb, 0)
            else
              if qsrc <= 0.0
                qv = 0
              elseif qsrc >= 4294967295.0
                qv = 4294967295
              else
                mem.store(i64)(fb, qsrc)
                qv = mem.read_i64(fb, 0)
          mem.write_i64(st, sp * 8, qv & M32)
        else
          return bail(op, pc)

      elseif op == OP_prefix_simd
        # 0xFD SIMD with FULL 128-bit values. the engine's operand stack is 64-bit,
        # so a v128 lives in a side store (`vstk`, 16 bytes per entry) and the
        # stack slot holds its INDEX. That keeps one-slot stack discipline —
        # `drop` still pops exactly one — while every lane is real. A
        # low-64-bits-only shortcut would answer wrongly instead of bailing.
        vsub: i64 = 0
        vsh: i64 = 0
        vc: i64 = 1
        while vc == 1
          vb: i64 = mem.read_byte(code, pc)
          pc += 1
          vsub |= ((vb & 0x7F) << vsh)
          vsh += 7
          if vb < 0x80
            vc = 0
        if vsub == 12
          vi: i64 = vtop
          vtop = (vtop + 1) & 1023
          vk: i64 = 0
          while vk < 16
            mem.write_byte(vstk, vi * 16 + vk, mem.read_byte(code, pc + vk))
            vk += 1
          pc += 16
          sp += 1
          mem.write_i64(st, sp * 8, vi)
        elseif mem.read_byte(extw, vsub) != 0
          # extract_lane: unary, with ONE immediate lane index. The descriptor
          # gives width and signedness; the lane replaces the vector on the
          # stack, so `sp` is unchanged.
          if sp < 1
            return bail(op, pc)
          ew: i64 = mem.read_byte(extw, vsub)
          es: i64 = mem.read_byte(exts, vsub)
          eln: i64 = mem.read_byte(code, pc)
          pc += 1
          evi: i64 = mem.read_i64(st, sp * 8) & 1023
          mem.write_i64(fb, 0, 0)
          ek: i64 = 0
          while ek < ew
            mem.write_byte(fb, ek, mem.read_byte(vstk, evi * 16 + eln * ew + ek))
            ek += 1
          ev: i64 = mem.read_i64(fb, 0)
          if es == 1
            eone: i64 = 1
            esb: i64 = eone << (ew * 8 - 1)
            if (ev & esb) != 0
              ev -= (eone << (ew * 8))
          mem.write_i64(st, sp * 8, ev)

        elseif mem.read_byte(vwid, vsub) != 0
          # ONE executor for every v128 lane op. They all share a single shape:
          # read lane i from each operand, apply a kernel, write lane i. The
          # descriptor above supplies the lane width and the kernel, so a new
          # opcode is a ROW, not another branch # 22 opcodes, one loop.
          if sp < 2
            return bail(op, pc)
          vwd: i64 = mem.read_byte(vwid, vsub)
          vkr: i64 = mem.read_byte(vker, vsub)
          vbi: i64 = mem.read_i64(st, sp * 8) & 1023
          vai: i64 = mem.read_i64(st, (sp - 1) * 8) & 1023
          vri: i64 = vtop
          vtop = (vtop + 1) & 1023
          nl: i64 = 16 // vwd
          ll: i64 = 0
          while ll < nl
            # Assemble each lane through `fb` rather than shifting into an i64:
            # a value above 2^53 built with shift/or loses its low byte.
            mem.write_i64(fb, 0, 0)
            ck: i64 = 0
            while ck < vwd
              mem.write_byte(fb, ck, mem.read_byte(vstk, vai * 16 + ll * vwd + ck))
              ck += 1
            av2: i64 = mem.read_i64(fb, 0)
            af: f64 = mem.load("f64", fb)
            a32: f32 = mem.load("f32", fb)
            mem.write_i64(fb, 0, 0)
            ck2: i64 = 0
            while ck2 < vwd
              mem.write_byte(fb, ck2, mem.read_byte(vstk, vbi * 16 + ll * vwd + ck2))
              ck2 += 1
            bv2: i64 = mem.read_i64(fb, 0)
            bf: f64 = mem.load("f64", fb)
            b32: f32 = mem.load("f32", fb)
            mem.write_i64(fb, 0, 0)
            # Integer kernels need no masking: only `vwd` bytes are written
            # back, so a lane truncates to its own width by construction.
            if vkr == 1
              mem.write_i64(fb, 0, av2 & bv2)
            elseif vkr == 2
              mem.write_i64(fb, 0, av2 | bv2)
            elseif vkr == 3
              mem.write_i64(fb, 0, av2 ~ bv2)
            elseif vkr == 4
              mem.write_i64(fb, 0, av2 + bv2)
            elseif vkr == 5
              mem.write_i64(fb, 0, av2 - bv2)
            elseif vkr == 6
              mem.write_i64(fb, 0, av2 * bv2)
            elseif vkr == 7
              if vwd == 4
                mem.store("f32", fb, a32 + b32)
              else
                mem.store("f64", fb, af + bf)
            elseif vkr == 8
              if vwd == 4
                mem.store("f32", fb, a32 - b32)
              else
                mem.store("f64", fb, af - bf)
            elseif vkr == 9
              if vwd == 4
                mem.store("f32", fb, a32 * b32)
              else
                mem.store("f64", fb, af * bf)
            else
              if vwd == 4
                mem.store("f32", fb, a32 / b32)
              else
                mem.store("f64", fb, af / bf)
            ck3: i64 = 0
            while ck3 < vwd
              mem.write_byte(vstk, vri * 16 + ll * vwd + ck3, mem.read_byte(fb, ck3))
              ck3 += 1
            ll += 1

          mem.write_i64(st, (sp - 1) * 8, vri)
          sp -= 1
        else
          return bail(op, pc)

      elseif op >= OP_ref_null and op <= OP_ref_func
        # reference types. A null ref is -1: the table stores FUNCTION INDICES
        # and 0 is a valid one, so 0 cannot double as null.
        if op == OP_ref_null
          pc += 1                       # reftype byte
          sp += 1
          mem.write_i64(st, sp * 8, 0 - 1)
        elseif op == OP_ref_is_null
          if sp < 1
            return bail(op, pc)
          rn: i64 = 0
          if mem.read_i64(st, sp * 8) == 0 - 1
            rn = 1
          mem.write_i64(st, sp * 8, rn)
        else
          rf: i64 = mem.read_byte(code, pc)
          pc += 1
          sp += 1
          mem.write_i64(st, sp * 8, rf)

      elseif op == OP_nop
        # nop. Never reached the dispatch before, so any module containing a
        # single `nop` bailed with -1 no matter what else it used.
        sp = sp

      elseif op == OP_unreachable
        # unreachable: a genuine trap, not an unimplemented opcode.
        return bailtrap(pc)

      else
        # Unimplemented opcode: its stack effect is unknown, so continuing
        # would silently unbalance sp and eventually fault. Refuse instead.
        #
        # Name the opcode on stderr. A bare -1 turned every gap into the same
        # opaque result and made prioritising coverage work guesswork; this
        # turns a corpus sweep directly into a ranked opcode worklist.
        return bailop(op, pc)

  # Return the top slot's RAW BITS. Masking with M32 here silently destroyed
  # every f64 and i64 result (wart_f64_bench read 1929046707 instead of
  # 1000100048462729.9). i32 arms already mask their own results, so the
  # unsigned 32-bit value is unaffected; the entry formats by result type.
  last: i64 = 0
  if sp > 0
    last = mem.read_i64(st, sp * 8)
  mem.free(code)
  mem.free(st)
  mem.free(lo)
  mem.free(ltgt)
  mem.free(lelse)
  mem.free(lin)
  mem.free(gl)
  mem.free(himm)
  last


# ALU ops are one code path driven by a table: opcode -> ARM64 base word.
# Adding an op is one row in tools/opcodes.id, not a new branch here # and
# the opcode number is the SAME binding the interpreter dispatches on, so the
# two can no longer drift the way they did while both were typed by hand.
#
# i64 forms are the same ARM64 instructions with sf=1 (bit 31).
# derived(wasm.opcodes.aluword) begin # regenerate: duo run tools/opcodes.id
ALU_OPS = {
  {OP_i32_add,            0x0B000000},
  {OP_i32_sub,            0x4B000000},
  {OP_i32_mul,            0x1B007C00},
  {OP_i32_div_s,          0x1AC00C00},
  {OP_i32_div_u,          0x1AC00800},
  {OP_i32_and,            0x0A000000},
  {OP_i32_or,             0x2A000000},
  {OP_i32_xor,            0x4A000000},
  {OP_i32_shl,            0x1AC02000},
  {OP_i32_shr_s,          0x1AC02800},
  {OP_i32_shr_u,          0x1AC02400},
  {OP_i32_rotr,           0x1AC02C00},
  {OP_i64_add,            0x8B000000},
  {OP_i64_sub,            0xCB000000},
  {OP_i64_mul,            0x9B007C00},
  {OP_i64_div_s,          0x9AC00C00},
  {OP_i64_div_u,          0x9AC00800},
  {OP_i64_and,            0x8A000000},
  {OP_i64_or,             0xAA000000},
  {OP_i64_xor,            0xCA000000},
  {OP_i64_shl,            0x9AC02000},
  {OP_i64_shr_s,          0x9AC02800},
  {OP_i64_shr_u,          0x9AC02400},
  {OP_i64_rotr,           0x9AC02C00},
}
# derived end

# Comparisons: opcode -> ARM64 condition code used by CSET. i64 rows reuse the
# i32 conditions on a 64-bit CMP; the CSET stays 32-bit because a wasm compare
# yields i32 whatever its operands were.
# derived(wasm.opcodes.cmpcond) begin # regenerate: duo run tools/opcodes.id
CMP_OPS = {
  {OP_i32_eq,       0},
  {OP_i32_ne,       1},
  {OP_i32_lt_s,     11},
  {OP_i32_lt_u,     3},
  {OP_i32_gt_s,     12},
  {OP_i32_gt_u,     8},
  {OP_i32_le_s,     13},
  {OP_i32_le_u,     9},
  {OP_i32_ge_s,     10},
  {OP_i32_ge_u,     2},
  {OP_i64_eq,       0},
  {OP_i64_ne,       1},
  {OP_i64_lt_s,     11},
  {OP_i64_lt_u,     3},
  {OP_i64_gt_s,     12},
  {OP_i64_gt_u,     8},
  {OP_i64_le_s,     13},
  {OP_i64_le_u,     9},
  {OP_i64_ge_s,     10},
  {OP_i64_ge_u,     2},
}
# derived end

alu_word: i64 = (op: i64)
  i: i64 = 1
  # `T:len()` on a table answers 0 here, so this table was never consulted.
  while ALU_OPS[i] != nil
    row = ALU_OPS[i]
    if row[1] == op
      return row[2]
    i += 1
  0

cmp_cond: i64 = (op: i64)
  i: i64 = 1
  # `T:len()` on a table answers 0 here, so this table was never consulted.
  while CMP_OPS[i] != nil
    row = CMP_OPS[i]
    if row[1] == op
      return row[2]
    i += 1
  NOCOND

# Local slot -> ARM64 register, and it depends on whether the body CALLS.
#
# A leaf body has nothing that can clobber the caller-saved window, so it puts
# its locals in w9..w17 first and only spills into the callee-saved x19..x26
# past nine of them # which is what the JIT always did.
#
# A body that emits a `BL` wants the opposite. Its locals have to survive the
# call, so they start in x19..x26 (the callee saves them once, in ITS prologue)
# and only the ninth and beyond land in w9..w17, where the call site has to
# spill them by hand. For the shapes that matter # a recursive function with a
# few locals # this makes the register save/restore happen once per callee
# instead of once per call site, and leaves the call site with no spills at all.
#
# x18 is the reserved platform register on Darwin and is skipped in both maps;
# x27/x28 hold the globals and linear-memory bases and are never locals.
locreg: i64 = (idx: i64, cf: i64)
  if cf == 1
    if idx < 8
      return 19 + idx
    return idx + 1
  if idx < 9
    return 9 + idx
  10 + idx

# Materialize a 64-bit absolute value into register `rd`: MOVZ then three
# MOVKs. Returns the new word cursor.
#
# ALWAYS four words, even for a small value, and that is the point: the
# host-call sequence below computes its own branch offsets arithmetically, so
# every piece of it has to have a length that does not depend on the address
# being materialized. A "smart" version that skipped zero halfwords would make
# those offsets wrong for exactly the addresses that happen to be small.
movabs: i64 = (code: any, n: i64, rd: i64, v: i64)
  jitm.w32(code, n, 0xD2800000 | ((v & 0xFFFF) << 5) | rd)
  jitm.w32(code, n + 1, 0xF2800000 | (1 << 21) | (((v >> 16) & 0xFFFF) << 5) | rd)
  jitm.w32(code, n + 2, 0xF2800000 | (2 << 21) | (((v >> 32) & 0xFFFF) << 5) | rd)
  jitm.w32(code, n + 3, 0xF2800000 | (3 << 21) | (((v >> 48) & 0xFFFF) << 5) | rd)
  n + 4

# Emit a wasm trap, the same body the `unreachable` arm emits: exit with the
# status the interpreter's `bailtrap` uses, so a trap looks identical on both
# engines, falling back to `BRK #0` only when the host exports no `exit`.
#
# FIXED LENGTH by construction # 6 words with `exit`, 1 without # because
# every branch that skips a trap block computes its offset arithmetically.
# `movabs` is four words for the same reason and for the same caller.
jittrap: i64 = (code: any, n: i64, jex: i64)
  if jex == 0
    jitm.w32(code, n, 0xD4200000)
    return n + 1
  jitm.w32(code, n, 0x52800000 | (71 << 5))
  m: i64 = movabs(code, n + 1, 17, jex)
  jitm.w32(code, m, 0xD63F0000 | (17 << 5))
  m + 1

# Compile the module's entry body and every function it can reach into `code`;
# returns word count, or -1 if an unsupported opcode is hit (caller falls back
# to the interpreter).
#
# Functions are compiled into ONE buffer, each at its own word offset, and a
# `call` that is not worth inlining becomes a real `BL` patched once every body
# has an address. That is the whole reason this is a work queue rather than the
# single-body compiler it used to be: inlining alone can never express
# recursion, so a recursive body used to dump the ENTIRE function back to the
# interpreter (bench/fib.wasm lost 36x to wasmtime that way).
jit_compile: i64 = (s: str, off: i64, blen: i64, code: any, mlen: i64)
  # The one module name whose functions this host provides, bound to a `str`
  # local so `:byte()` indexes it. Same source as the interpreter's.
  jwmod: str = wabi.module_name
  # The grant as written by the launcher. This legacy private engine does not
  # yet consume a graph-owned world/authority value, so each site re-materializes
  # the policy from the `str` where it is stated. That duplication is migration
  # debt, not a pointer-transport constraint.
  jgspec: str = grant_spec()
  n: i64 = 0                       # emitted instruction words
  sp: i64 = 0                      # compile-time operand-stack depth
  pc: i64 = 1                      # 1-based cursor into the body
  # Control-flow label stack. `loop` labels branch BACKWARD to a head whose
  # offset is already known; `block` labels branch FORWARD to an `end` that has
  # not been emitted yet, so those branches go out with a placeholder offset and
  # are patched when the matching `end` fixes the target.
  lkind = mem.alloc(32 * 8)
  lhead = mem.alloc(32 * 8)
  lpn   = mem.alloc(32 * 8)
  lpat  = mem.alloc(32 * 8 * 8)
  # word index of an `if`'s conditional branch, awaiting its `else`/`end`
  lelsw = mem.alloc(32 * 8)
  # operand-stack depth at an `if`, so the else-arm starts where the then-arm
  # did rather than on top of its result
  lsps  = mem.alloc(32 * 8)
  mem.zero(lkind, 32 * 8)
  mem.zero(lhead, 32 * 8)
  mem.zero(lpn, 32 * 8)
  mem.zero(lpat, 32 * 8 * 8)
  mem.zero(lelsw, 32 * 8)
  mem.zero(lsps, 32 * 8)
  ldep: i64 = 0
  # Pending local alias: `local.get` records slot -> local register instead of
  # emitting a MOV, so the consuming ALU op reads the local directly.
  # -1 = nothing pending.
  ali_slot: i64 = -1
  ali_reg: i64 = 0
  # SECOND alias channel. Consecutive `local.get`s are the common shape
  # (`local.get 0; local.get 1; xor`) and with only one tracked the second
  # spills `mov w4, w9` — a MOV that feeds the very next `eor`/`madd`, i.e.
  # ON the dependency chain, which is what actually costs time here.
  ali2_slot: i64 = -1
  ali2_reg: i64 = 0
  # Index of the last emitted ALU word and the stack slot it wrote. A following
  # `local.set`/`local.tee` retargets that instruction's Rd straight at the
  # local register instead of emitting a MOV. `last_alu == n - 1` is the whole
  # validity test: any other emission advances `n` past it.
  last_alu: i64 = -1
  last_slot: i64 = -1
  # Last emitted CSET (word index + the SEMANTIC condition it materializes).
  # A `br_if` that immediately follows can drop the CSET entirely and branch on
  # the flags the CMP already set. Same `== n - 1` validity trick as last_alu.
  last_cset: i64 = -1
  last_cc: i64 = -1
  # Inline-call state. `lbase` shifts this body's locals up the register file
  # so an inlined callee's locals sit ABOVE the caller's rather than aliasing
  # them. Depth is capped at one: nesting would exhaust w9..w16 immediately.
  lbase: i64 = 0
  # FLOAT ACCUMULATOR CACHE. `fcl` is the local register whose authoritative
  # value currently lives in FP register d2; its GP register is STALE until
  # flushed. This exists because every float op otherwise round-trips
  # GP->FP->GP around its local, and that round trip — not the moves around it
  # — is what puts wart_f64_bench at half wasmtime's speed.
  fcl: i64 = -1
  # Inline STACK, so a callee may itself contain calls. Depth is capped and
  # the register budget is rechecked at every level; a recursive callee simply
  # inlines until the cap and then bails to the interpreter, which is safe.
  inl_d: i64 = 0
  inl_pcs = mem.alloc(8 * 8)
  inl_offs = mem.alloc(8 * 8)
  inl_bls = mem.alloc(8 * 8)
  inl_lbs = mem.alloc(8 * 8)
  inl_lds = mem.alloc(8 * 8)
  inl_lcs = mem.alloc(8 * 8)
  mem.zero(inl_pcs, 8 * 8)
  mem.zero(inl_offs, 8 * 8)
  mem.zero(inl_bls, 8 * 8)
  mem.zero(inl_lbs, 8 * 8)
  mem.zero(inl_lds, 8 * 8)
  mem.zero(inl_lcs, 8 * 8)
  # locals used by the frame currently being compiled
  curloc: i64 = 0
  # ── function table, for inlining `call` ──────────────────────────────
  # `s` is the whole module but `off`/`blen` delimit only THIS body, so a
  # callee must be located here. This table is still built in-function as
  # migration debt; pointer transport no longer requires the locality.
  jtp = mem.alloc(256 * 8)
  jtr = mem.alloc(256 * 8)
  jft = mem.alloc(256 * 6 * 8)
  mem.zero(jtp, 256 * 8)
  mem.zero(jtr, 256 * 8)
  mem.zero(jft, 256 * 6 * 8)
  # Work queue of functions still to compile, their entry word once compiled,
  # and the call sites whose BL offset is not resolvable until then.
  jq   = mem.alloc(256 * 8)
  jqa  = mem.alloc(256 * 8)
  jqs  = mem.alloc(256 * 8)
  jcw  = mem.alloc(1024 * 8)
  jct  = mem.alloc(1024 * 8)
  jrw  = mem.alloc(64 * 8)
  jspr = mem.alloc(64 * 8)
  mem.zero(jq, 256 * 8)
  mem.zero(jqa, 256 * 8)
  mem.zero(jqs, 256 * 8)
  mem.zero(jcw, 1024 * 8)
  mem.zero(jct, 1024 * 8)
  mem.zero(jrw, 64 * 8)
  mem.zero(jspr, 64 * 8)
  # ── imported functions ───────────────────────────────────────────────
  # Per FUNCTION import, in import order: whether the field name is one the
  # host can actually perform, and the type index that fixes its arity. The
  # interpreter has kept both since it learned to emit a module's real output;
  # the JIT had neither, which is why every `call` below `jimp` bailed the
  # WHOLE module and every wasi-libc `_start` ran interpreted.
  jimk = mem.alloc(256 * 8)
  jimx = mem.alloc(256 * 8)
  mem.zero(jimk, 256 * 8)
  mem.zero(jimx, 256 * 8)
  # Scratch for the emitted host-call sequence. `write` clobbers x0..x17, so
  # the loop state cannot live in registers; it lives here and the sequence
  # re-materializes this address after every call. Cold path # executed once
  # per `fd_write`, never inside a kernel.
  jsc = mem.alloc(64)
  mem.zero(jsc, 64)
  jsca: i64 = mem.addr(jsc)
  # The host addresses emitted code branches to. `std.jit.sym` answers 0 for a
  # name this host has not linked, and every use below checks: an absent
  # symbol declines the body to the interpreter, it does not emit a branch to
  # address zero.
  jwr: i64 = jitm.sym("write")
  jex: i64 = jitm.sym("exit")
  # ── call_indirect ────────────────────────────────────────────────────
  # `jtbl` is the module's function table (slot -> funcidx), read from the
  # table + element sections exactly as `run_body` reads them. `jfty` is the
  # declared TYPE INDEX per defined function, which is what the signature
  # check compares against.
  #
  # `jidt` is the DISPATCH TABLE the emitted code actually reads: two i64 per
  # slot, the absolute code address of the compiled callee and its type index.
  # It is a separate allocation because its address has to be a CONSTANT the
  # emitter can bake in, while its CONTENTS cannot be known until every body
  # has been compiled and the call-patch phase has run. That ordering is the
  # whole reason this could not be done at emit time.
  #
  # `jtoc` marks a slot as occupied, and is needed because funcidx 0 is a real
  # function, so a zeroed table cannot say "empty" by value: without it, an
  # element segment that leaves slots untouched would dispatch them to
  # function 0. wasm requires an uninitialised element to trap, and the
  # interpreter carries the same array for the same reason.
  jtbl = mem.alloc(4096 * 8)
  jtoc = mem.alloc(4096 * 8)
  jfty = mem.alloc(256 * 8)
  jidt = mem.alloc(4096 * 2 * 8)
  mem.zero(jtbl, 4096 * 8)
  mem.zero(jtoc, 4096 * 8)
  mem.zero(jfty, 256 * 8)
  mem.zero(jidt, 4096 * 2 * 8)
  jidta: i64 = mem.addr(jidt)
  jtbz: i64 = 0
  jtbo: i64 = 0
  jelo: i64 = 0
  # 1 once the table-reachable functions have been queued. They are queued on
  # the FIRST `call_indirect` rather than up front: a module that owns a table
  # but never dispatches through it must not be dragged to the interpreter
  # because some function nothing calls has an opcode with no arm.
  jtbq: i64 = 0
  jqn: i64 = 0
  jqh: i64 = 0
  jcn: i64 = 0
  jrn: i64 = 0
  jty: i64 = 0
  jfo: i64 = 0
  jco: i64 = 0
  jimp: i64 = 0
  # Declared linear-memory size in 64 KiB pages. `main` allocates exactly this
  # much and seeds it from the data segments, so `memory.size` reports it and
  # the emitted loads address a real image rather than a zeroed page.
  jpages: i64 = 1
  jglz: i64 = 1
  jsi: i64 = 9
  while jsi <= mlen
    jsid: i64 = s:byte(jsi)
    jsi += 1
    jssz: i64 = uleb_val(s, jsi, mlen)
    jsi = uleb_end(s, jsi, mlen)
    if jsid == 1
      jty = jsi
    elseif jsid == 3
      jfo = jsi
    elseif jsid == 10
      jco = jsi
    elseif jsid == 4
      jtbo = jsi
    elseif jsid == 9
      jelo = jsi
    elseif jsid == 5
      # memory section: count, then per-memory limits (flags byte, min uleb,
      # optional max). Only the first memory exists in MVP wasm.
      jmc: i64 = uleb_val(s, jsi, mlen)
      jmj: i64 = uleb_end(s, jsi, mlen)
      if jmc > 0
        jmj += 1
        jpages = uleb_val(s, jmj, mlen)
        if jpages < 1
          jpages = 1
    elseif jsid == 6
      jgc: i64 = uleb_val(s, jsi, mlen)
      jgj: i64 = uleb_end(s, jsi, mlen)
      jgk: i64 = 0
      while jgk < jgc and jgj <= mlen
        jgj += 2
        jgv2: i64 = uleb_val(s, jgj + 1, mlen)
        if jgv2 != 0
          jglz = 0
        jgj = uleb_end(s, jgj + 1, mlen) + 1
        jgk += 1
    elseif jsid == 2
      jic: i64 = uleb_val(s, jsi, mlen)
      jij: i64 = uleb_end(s, jsi, mlen)
      jik: i64 = 0
      while jik < jic and jij <= mlen
        jla: i64 = uleb_val(s, jij, mlen)
        jms: i64 = uleb_end(s, jij, mlen)
        jij = jms + jla
        jfl: i64 = uleb_val(s, jij, mlen)
        jfs: i64 = uleb_end(s, jij, mlen)
        jij = jfs + jfl
        jkd: i64 = s:byte(jij)
        jij += 1
        if jkd == 0
          # Resolution is by (MODULE NAME, FIELD NAME), both exact, and it is
          # the same roster the interpreter resolves against — one table in
          # `wasm/wasi_abi.id`, read by both — so the two engines cannot
          # disagree about which import is which. This carried a byte-identical
          # copy of the interpreter's old FIELD-NAME MASK: length 8 with
          # name[0]='f', name[1]='d', name[3]='w', module name unread. Both
          # copies executed `fd_write` for `"totally_not_wasi" "fdxwrite"`.
          jhid: i64 = 0
          jmok: i64 = 0
          if jla == string.len(jwmod)
            jmok = 1
            jmq: i64 = 0
            while jmq < jla
              if s:byte(jms + jmq) != jwmod:byte(jmq + 1)
                jmok = 0
              jmq += 1
          if jmok == 1
            jwk: i64 = 1
            while jwk <= wabi.count and jhid == 0
              jwn: str = wabi.name(jwk)
              if jfl == string.len(jwn)
                jws: i64 = 1
                jwq: i64 = 0
                while jwq < jfl
                  if s:byte(jfs + jwq) != jwn:byte(jwq + 1)
                    jws = 0
                  jwq += 1
                if jws == 1
                  jhid = jwk
              jwk += 1
          if jhid == 0
            return jitbail("unknown import (not a wasi_snapshot_preview1 function this host provides)", -1, 0)
          # The capability check, second copy, and independent of `jhid` for
          # the same reason the interpreter's is independent of `hid`. It only
          # ever fires under a TOTAL grant here, because a partial grant has
          # already declined the whole jit (see the `grant_is_total` arm in
          # `engine_main`) — so what this catches is the hijack shape, not a
          # policy denial: a (module, field) pair that no grant contains.
          jgad: i64 = 0
          jgmk: i64 = 0
          if jla == string.len(jwmod)
            jgmk = 1
            jgz: i64 = 0
            while jgz < jla
              if s:byte(jms + jgz) != jwmod:byte(jgz + 1)
                jgmk = 0
              jgz += 1
          if jgmk == 1
            jgj: i64 = 1
            while jgj <= wabi.count and jgad == 0
              if wabi.grant_admits(jgspec, jgj) == 1
                jgn: str = wabi.name(jgj)
                if jfl == string.len(jgn)
                  jgs: i64 = 1
                  jgp: i64 = 0
                  while jgp < jfl
                    if s:byte(jfs + jgp) != jgn:byte(jgp + 1)
                      jgs = 0
                    jgp += 1
                  if jgs == 1
                    jgad = jgj
              jgj += 1
          if jgad == 0
            return jitbail("import is outside this guest's grant", -1, 0)
          # The interpreter's 256-slot cap, on the emitter's copy of the same
          # table. `jimk`/`jimx` are 256 entries and a body reaching import 257
          # would dispatch on a zero the walk never wrote. Decline; `run_body`
          # then refuses the module by shape, so the two engines agree that a
          # module they cannot index is not a module they answer for.
          if jimp >= 256
            return jitbail("more than 256 function imports", -1, 0)
          if jimp < 256
            mem.write_i64(jimk, jimp * 8, jhid)
            mem.write_i64(jimx, jimp * 8, uleb_val(s, jij, mlen))
          jimp += 1
          jij = uleb_end(s, jij, mlen)
        elseif jkd == 1
          jij = uleb_end(s, jij + 1, mlen)
          jij = uleb_end(s, jij, mlen)
        elseif jkd == 2
          jfg: i64 = s:byte(jij)
          jij = uleb_end(s, jij + 1, mlen)
          if jfg == 1
            jij = uleb_end(s, jij, mlen)
        else
          jij += 2
        jik += 1
    jsi += jssz
  if jty > 0
    jnt: i64 = uleb_val(s, jty, mlen)
    jtq: i64 = uleb_end(s, jty, mlen)
    jtv: i64 = 0
    while jtv < jnt and jtv < 256 and jtq <= mlen
      jtq += 1
      jnp: i64 = uleb_val(s, jtq, mlen)
      jtq = uleb_end(s, jtq, mlen) + jnp
      mem.write_i64(jtp, jtv * 8, jnp)
      jnr: i64 = uleb_val(s, jtq, mlen)
      jtq = uleb_end(s, jtq, mlen) + jnr
      # result count too: a real call has to know whether the BL leaves a value
      # in x0 to push, and the inline path never needed to ask.
      mem.write_i64(jtr, jtv * 8, jnr)
      jtv += 1
  jnf: i64 = 0
  if jco > 0
    jnf = uleb_val(s, jco, mlen)
    jcq: i64 = uleb_end(s, jco, mlen)
    jgq: i64 = 0
    if jfo > 0
      jgq = uleb_end(s, jfo, mlen)
    jfv: i64 = 0
    while jfv < jnf and jfv < 256 and jcq <= mlen
      jbs: i64 = uleb_val(s, jcq, mlen)
      jbt: i64 = uleb_end(s, jcq, mlen)
      jnd: i64 = uleb_val(s, jbt, mlen)
      jrq: i64 = uleb_end(s, jbt, mlen)
      jlc: i64 = 0
      jgv: i64 = 0
      while jgv < jnd
        jcl: i64 = uleb_val(s, jrq, mlen)
        jrq = uleb_end(s, jrq, mlen) + 1
        jlc += jcl
        jgv += 1
      jpf: i64 = 0
      jpr: i64 = 0
      # Type INDEX, kept for the call_indirect signature check. -1 when the
      # function section did not name one, so an unreadable entry can never be
      # mistaken for type 0, which is a real signature.
      mem.write_i64(jfty, jfv * 8, -1)
      if jgq > 0
        jtix: i64 = uleb_val(s, jgq, mlen)
        jgq = uleb_end(s, jgq, mlen)
        jpf = mem.read_i64(jtp, jtix * 8)
        jpr = mem.read_i64(jtr, jtix * 8)
        mem.write_i64(jfty, jfv * 8, jtix)
      # Leafness by byte scan. An immediate that happens to equal 0x10 can read
      # as a call, which only ever makes a body look NON-leaf: that costs
      # coverage, never correctness.
      jlf: i64 = 1
      jzz: i64 = jrq
      while jzz < jbt + jbs
        jb2: i64 = s:byte(jzz)
        if jb2 == 16 or jb2 == 17
          jlf = 0
          jzz = jbt + jbs
        jzz += 1
      mem.write_i64(jft, (jfv * 6) * 8, jrq - 1)
      mem.write_i64(jft, (jfv * 6 + 1) * 8, jbt + jbs - jrq)
      mem.write_i64(jft, (jfv * 6 + 2) * 8, jlc)
      mem.write_i64(jft, (jfv * 6 + 3) * 8, jpf)
      mem.write_i64(jft, (jfv * 6 + 4) * 8, jlf)
      mem.write_i64(jft, (jfv * 6 + 5) * 8, jpr)
      jcq = jbt + jbs
      jfv += 1

  # ── table + element segments ─────────────────────────────────────────
  # Read exactly as `run_body` reads them. The inline walk is legacy structure,
  # not a remaining pointer-boundary requirement.
  if jtbo > 0
    jntb: i64 = uleb_val(s, jtbo, mlen)
    jtq3: i64 = uleb_end(s, jtbo, mlen)
    if jntb > 0
      jtq3 += 1                        # reftype byte
      jtfl: i64 = s:byte(jtq3)
      jtq3 += 1
      jtbz = uleb_val(s, jtq3, mlen)
      jtq3 = uleb_end(s, jtq3, mlen)
      if jtfl == 1
        jtq3 = uleb_end(s, jtq3, mlen) # max
  if jtbz > 4096
    jtbz = 4096
  if jelo > 0
    jnel: i64 = uleb_val(s, jelo, mlen)
    jeq3: i64 = uleb_end(s, jelo, mlen)
    jev: i64 = 0
    while jev < jnel and jeq3 <= mlen
      jemd: i64 = uleb_val(s, jeq3, mlen)
      jeq3 = uleb_end(s, jeq3, mlen)
      jeof: i64 = 0
      if jemd == 0
        jeq3 += 1                      # i32.const
        jeof = uleb_val(s, jeq3, mlen)
        jeq3 = uleb_end(s, jeq3, mlen) + 1   # + 0x0B
      elseif jemd == 1 or jemd == 3
        jeq3 += 1                      # elemkind byte
      jecn: i64 = uleb_val(s, jeq3, mlen)
      jeq3 = uleb_end(s, jeq3, mlen)
      jek: i64 = 0
      while jek < jecn and jeq3 <= mlen
        jefn: i64 = uleb_val(s, jeq3, mlen)
        jeq3 = uleb_end(s, jeq3, mlen)
        if jemd == 0 and jeof + jek < 4096
          mem.write_i64(jtbl, (jeof + jek) * 8, jefn)
          mem.write_i64(jtoc, (jeof + jek) * 8, 1)
        jek += 1
      jev += 1

  # Which function is THIS body? The work queue is seeded with it, and an
  # inlined callee's locals start above its caller's, so its local count has to
  # be known. Without a match there is no queue to seed: bail to the
  # interpreter rather than compile a body no `call` can name.
  jself: i64 = -1
  jsv: i64 = 0
  while jsv < jnf
    if mem.read_i64(jft, (jsv * 6) * 8) == off
      jself = jsv
      jsv = jnf
    jsv += 1
  if jself < 0
    # THE OFFSETS ARE IN THE MESSAGE, and they have to be. This refusal fired
    # for every module in both corpora the first time the gate was ever opened,
    # and "entry body is not in the code section" is not a claim anyone can
    # check: the two walks that must agree are 300 lines apart and each computes
    # its own offset. With the numbers printed it took one run to see `0 code
    # bodies` — i.e. this walk had not found a code section at all — and one
    # more to see that every `s:byte()` in this function was answering 0.
    jdbg: str = ""
    jdv: i64 = 0
    while jdv < jnf and jdv < 8
      jdbg = jdbg .. " " .. to(str)(mem.read_i64(jft, (jdv * 6) * 8))
      jdv += 1
    return jitbail("entry body is not in the code section (entry offset " .. off:to(str) .. ", " .. jnf:to(str) .. " code bodies at:" .. jdbg .. ")", -1, pc)

  # ── ENTRY TRAMPOLINE ────────────────────────────────────────────────────
  # jitm.call2 enters at word 0 under the C ABI, so this is the one place that
  # has to preserve the FULL callee-saved window for the engine's own compiled C.
  # x19..x28 are CALLEE-SAVED on AArch64 and this JIT uses them for locals and
  # for the two bases, so clobbering them corrupts the caller: it once made
  # `rtype` read back wrong and every f32/f64 module print its raw bit pattern.
  # Compiled wasm functions below save only the pairs they touch, because they
  # are entered by BL from code that already respects the same convention.
  jitm.w32(code, n, 0xA9800000 | (0x7E << 15) | (30 << 10) | (31 << 5) | 29)
  n += 1
  jitm.w32(code, n, 0xA9800000 | (0x7E << 15) | (20 << 10) | (31 << 5) | 19)
  n += 1
  jitm.w32(code, n, 0xA9800000 | (0x7E << 15) | (22 << 10) | (31 << 5) | 21)
  n += 1
  jitm.w32(code, n, 0xA9800000 | (0x7E << 15) | (24 << 10) | (31 << 5) | 23)
  n += 1
  jitm.w32(code, n, 0xA9800000 | (0x7E << 15) | (26 << 10) | (31 << 5) | 25)
  n += 1
  jitm.w32(code, n, 0xA9800000 | (0x7E << 15) | (28 << 10) | (31 << 5) | 27)
  n += 1
  # the linear-memory base arrives in x0 and the globals base in x1; both stay
  # resident for the whole run, in registers no compiled body ever writes
  jitm.w32(code, n, 0xAA0003E0 | (0 << 16) | 28)
  n += 1
  jitm.w32(code, n, 0xAA0003E0 | (1 << 16) | 27)
  n += 1
  jitm.w32(code, n, 0x94000000)
  mem.write_i64(jcw, jcn * 8, n)
  mem.write_i64(jct, jcn * 8, jself)
  jcn += 1
  n += 1
  jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (28 << 10) | (31 << 5) | 27)
  n += 1
  jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (26 << 10) | (31 << 5) | 25)
  n += 1
  jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (24 << 10) | (31 << 5) | 23)
  n += 1
  jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (22 << 10) | (31 << 5) | 21)
  n += 1
  jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (20 << 10) | (31 << 5) | 19)
  n += 1
  jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (30 << 10) | (31 << 5) | 29)
  n += 1
  jitm.w32(code, n, 0xD65F03C0)
  n += 1

  mem.write_i64(jq, 0, jself)
  mem.write_i64(jqs, jself * 8, 1)
  jqn = 1

  # Per-function compile state, declared out here because the opcode arms in
  # the inner loop read it.
  selfloc: i64 = 0
  cf: i64 = 0
  hwm: i64 = 0
  curfn: i64 = 0
  # TERMINATION GUARD for the opcode walk below, counted across every queued
  # body. The walk advances `pc` on every pass, so it cannot spin on a
  # well-formed body — but it re-seats `pc`, `off` and `blen` from the inline
  # stack and from ULEB immediates, and the first time it ever executed it did
  # not come back. `n > 260000` above only catches a spin that EMITS; a decode
  # loop that emits nothing is invisible to it and the process simply hangs,
  # which for a runtime is worse than any wrong answer: there is nothing to
  # difference and nothing to report. A refusal costs a fallback to the
  # interpreter; a hang costs the run.
  jspin: i64 = 0

  while jqh < jqn
    curfn = mem.read_i64(jq, jqh * 8)
    jqh += 1
    off = mem.read_i64(jft, (curfn * 6) * 8)
    blen = mem.read_i64(jft, (curfn * 6 + 1) * 8)
    fnprm: i64 = mem.read_i64(jft, (curfn * 6 + 3) * 8)
    selfloc = mem.read_i64(jft, (curfn * 6 + 2) * 8) + fnprm
    # `jlf` is a byte scan for 0x10/0x11 and can only ever over-report a call,
    # so `cf == 0` genuinely means no BL will be emitted from this body.
    cf = 1 - mem.read_i64(jft, (curfn * 6 + 4) * 8)
    # One line per body under DUO_WASM_JIT_TRACE. The refusal trace names why a
    # body was declined; nothing said what the emitter was DOING when it did
    # not decline, which is how "engine=interp, no reason given" happened.
    if env("DUO_WASM_JIT_TRACE")
      io.stderr:write("wasm: jit body fn=" .. curfn:to(str) .. " off=" .. off:to(str) .. " blen=" .. blen:to(str) .. " params=" .. fnprm:to(str) .. " locals=" .. selfloc:to(str) .. " words-so-far=" .. n:to(str) .. " queue=" .. jqh:to(str) .. "/" .. jqn:to(str) .. "\n")
    # eight argument registers, seventeen local registers
    if selfloc > 17 or fnprm > 8 or n > 260000
      return jitbail("body needs more locals or params than the register file has", -1, pc)

    # Five reserved words for the prologue. Which pairs actually need saving is
    # not known until the body has been walked (inlining raises the local
    # high-water mark), so the words are filled in at the epilogue and the
    # function's ENTRY ADDRESS is the first one used -- unused slots sit above
    # it as NOPs and are never executed.
    pstart: i64 = n
    n += 5

    fpk: i64 = 0
    while fpk < fnprm
      jitm.w32(code, n, 0xAA0003E0 | (fpk << 16) | locreg(fpk, cf))
      n += 1
      fpk += 1
    # Wasm guarantees declared locals start at ZERO.
    fsz: i64 = fnprm
    while fsz < selfloc
      jitm.w32(code, n, 0x2A1F03E0 | locreg(fsz, cf))
      n += 1
      fsz += 1

    hwm = selfloc - 1
    curloc = selfloc
    lbase = 0
    sp = 0
    pc = 1
    ldep = 0
    inl_d = 0
    ali_slot = -1
    ali2_slot = -1
    last_alu = -1
    last_slot = -1
    last_cset = -1
    last_cc = -1
    fcl = -1
    jrn = 0

    while pc <= blen or inl_d > 0
      # An inlined body is done when its cursor runs past its own length:
      # restore the caller's cursor and register window and carry on.
      if pc > blen and inl_d > 0
        inl_d -= 1
        pc = mem.read_i64(inl_pcs, inl_d * 8)
        off = mem.read_i64(inl_offs, inl_d * 8)
        blen = mem.read_i64(inl_bls, inl_d * 8)
        lbase = mem.read_i64(inl_lbs, inl_d * 8)
        curloc = mem.read_i64(inl_lcs, inl_d * 8)
        # Restore the caller's label depth. A callee body ends with its OWN
        # function-level `end`, so it emits one more `end` than it pushed labels
        # and that surplus pops a label belonging to the CALLER. Left unrestored,
        # the caller's later br_if resolved to the wrong target (a nested
        # factorial sum returned 1 instead of 9).
        ldep = mem.read_i64(inl_lds, inl_d * 8)
      op: i64 = s:byte(off + pc)
      pc += 1

      jspin += 1
      if jspin > 4000000
        return jitbail("the emitter did not terminate (off=" .. off:to(str) .. " blen=" .. blen:to(str) .. " pc=" .. pc:to(str) .. " n=" .. n:to(str) .. " sp=" .. sp:to(str) .. " ldep=" .. ldep:to(str) .. " inl_d=" .. inl_d:to(str) .. " queue " .. jqh:to(str) .. "/" .. jqn:to(str) .. ")", op, pc)

      # Register budget: stack slots occupy w0..w8, locals w9..w16. Emitting
      # past either would silently alias a local, so refuse and let the caller
      # fall back to the interpreter. Correctness before speed:
      # a fast path that changes semantics is not proof.
      if sp > 8 or sp < 0 or n > 260000
        return jitbail("operand stack deeper than 8 slots, or code buffer full", op, pc)

      aw: i64 = alu_word(op)
      cc: i64 = cmp_cond(op)

      # Materialize a pending local alias unless this op can't disturb it.
      # Survives: `i32.const` (normally writes slot `sp` only) and any binop (it
      # either consumes the alias as Rn/Rm, or sits above it on the stack).
      # Everything else # local.set/tee, branches, compares, ends # needs the
      # value in its own stack register.
      # `i32.const` is safe even when it folds into slot `sp - 1`: every fold
      # branch reads `ali_reg` as Rn when that slot is aliased.
      # Float consts write only slot `sp`, and float binops consume their
      # operands as Rn/Rm, so both can leave a pending local alias standing —
      # exactly like i32.const and the integer ALU. Materialising it emitted a
      # MOV that sat ON the float dependency chain.
      fkeep: i64 = 0
      if op == OP_f32_const or op == OP_f64_const or (op >= OP_f32_add and op <= OP_f32_max) or (op >= OP_f64_add and op <= OP_f64_max)
        fkeep = 1
      # Flush the float cache before ANY opcode that could read the stale GP
      # register. Only local.get, float consts and float binops are known safe;
      # everything else materialises first. Conservative on purpose — a stale
      # local read as an integer is a silent wrong answer.
      if fcl >= 0 and not (op == OP_local_get or fkeep == 1)
        jitm.w32(code, n, 0x9E660000 | (2 << 5) | fcl)
        n += 1
        fcl = -1
      if ali_slot >= 0 and not (op == OP_i32_const or op == OP_local_get or fkeep == 1 or (aw != 0 and sp >= 2))
        jitm.w32(code, n, 0xAA0003E0 | (ali_reg << 16) | ali_slot)
        n += 1
        ali_slot = -1
      if ali2_slot >= 0 and not (op == OP_i32_const or op == OP_local_get or fkeep == 1 or (aw != 0 and sp >= 2))
        jitm.w32(code, n, 0xAA0003E0 | (ali2_reg << 16) | ali2_slot)
        n += 1
        ali2_slot = -1

      if op == OP_i32_const
        # i32.const -> MOVZ/MOVK into the next stack register, UNLESS the very
        # next opcode has an ARM64 immediate form. ARM64 encodes the shift/add
        # amount in the instruction, so a folded constant needs no register and
        # no MOVZ at all. In the FNV kernel this removes 8 instructions per
        # iteration (4x `const 19; shr_u`, 4x `const {1,2,3,4}; add`).
        #
        # i32.const is a SIGNED LEB. Decoding it with `uleb_val` was wrong for
        # small negatives: -7 is the single byte 0x79, which reads back as 121
        # and was emitted as the constant 121. (Large negatives do span five
        # bytes and did fail the fold range tests, which is why this survived.)
        # Decode signed, then fold to the unsigned 32-bit pattern so MOVZ/MOVK
        # emit the right bits and every range test below still rejects it.
        v: i64 = 0
        vsh: i64 = 0
        vb: i64 = 0
        vmore: i64 = 1
        while vmore == 1
          vb = s:byte(off + pc)
          pc += 1
          v |= ((vb & 0x7F) << vsh)
          vsh += 7
          if vb < 0x80
            vmore = 0
        if vsh < 64 and (vb & 0x40) != 0
          vone: i64 = 1
          v -= (vone << vsh)
        v = v & 0xFFFFFFFF
        nx: i64 = s:byte(off + pc)
        if sp >= 1 and nx == 118 and v >= 1 and v <= 31
          # LSR Wt, Wt, #v   (UBFM Wt, Wt, #v, #31).
          # MEASURED: do NOT instead fold this shift into the consuming
          # add/or/xor as a shifted-register operand. That form costs an extra
          # cycle on Apple silicon, and doing it here was a 13% REGRESSION
          # (0.468 s -> 0.529 s on bench/hash.wasm) even though it removed 4
          # instructions per iteration.
          # Each fold reads slot sp-1 and writes it. When that slot is an
          # un-materialized local alias, read the local's register as Rn instead
          # and let Rd stay the real stack register — that folds the `local.get`
          # MOV away too, and those MOVs are ON the dependency chain (measured
          # 3.8% for removing a single one).
          # BOTH alias channels, and the second one is not decoration. A fold
          # that consulted only `ali_slot` read the STALE stack register for a
          # slot aliased on the second channel, and then the pending alias
          # overwrote the folded result at the next materialization # so
          # `local.get 3; i32.const 8; i32.add` produced local 3, not local 3 + 8.
          # That is wasi-libc's `write` building its iovec pointer, and it was
          # invisible for as long as an imported call bailed the whole module.
          fs: i64 = sp - 1
          if ali_slot == sp - 1 fs = ali_reg
          if ali2_slot == sp - 1
            fs = ali2_reg
          jitm.w32(code, n, 0x53000000 | (v << 16) | (31 << 10) | (fs << 5) | (sp - 1))
          if ali_slot == sp - 1 ali_slot = -1
          if ali2_slot == sp - 1
            ali2_slot = -1
          n += 1
          pc += 1
        elseif sp >= 1 and nx == 116 and v >= 1 and v <= 31
          # LSL Wt, Wt, #v   (UBFM Wt, Wt, #(-v mod 32), #(31-v))
          fs2: i64 = sp - 1
          if ali_slot == sp - 1 fs2 = ali_reg
          if ali2_slot == sp - 1
            fs2 = ali2_reg
          jitm.w32(code, n, 0x53000000 | (((32 - v) & 31) << 16) | ((31 - v) << 10) | (fs2 << 5) | (sp - 1))
          if ali_slot == sp - 1 ali_slot = -1
          if ali2_slot == sp - 1
            ali2_slot = -1
          n += 1
          pc += 1
        elseif sp >= 1 and nx == 106 and v <= 4095
          # ADD Wt, Wt, #v
          fs3: i64 = sp - 1
          if ali_slot == sp - 1 fs3 = ali_reg
          if ali2_slot == sp - 1
            fs3 = ali2_reg
          jitm.w32(code, n, 0x11000000 | (v << 10) | (fs3 << 5) | (sp - 1))
          if ali_slot == sp - 1 ali_slot = -1
          if ali2_slot == sp - 1
            ali2_slot = -1
          n += 1
          pc += 1
        elseif sp >= 1 and nx == 107 and v <= 4095
          # SUB Wt, Wt, #v
          fs4: i64 = sp - 1
          if ali_slot == sp - 1 fs4 = ali_reg
          if ali2_slot == sp - 1
            fs4 = ali2_reg
          jitm.w32(code, n, 0x51000000 | (v << 10) | (fs4 << 5) | (sp - 1))
          if ali_slot == sp - 1 ali_slot = -1
          if ali2_slot == sp - 1
            ali2_slot = -1
          n += 1
          pc += 1
        else
          d: i64 = sp
          lo: i64 = v & 0xFFFF
          hi: i64 = (v >> 16) & 0xFFFF
          jitm.w32(code, n, 0x52800000 | (lo << 5) | d)
          n += 1
          if hi != 0
            jitm.w32(code, n, 0x72A00000 | (hi << 5) | d)
            n += 1
          sp += 1

      elseif op == OP_i32_rem_s or op == OP_i32_rem_u or op == OP_i64_rem_s or op == OP_i64_rem_u
        # rem_s / rem_u, both widths. ARM64 has no remainder instruction, so
        # divide into a scratch register and multiply back:
        #   t = a / b ;  a = a - t * b   (MSUB)
        # Slot `sp` is free here (it is where a push would land), which is why
        # this needs sp <= 7 rather than the usual 8.
        if sp < 2 or sp > 7
          return jitbail("operand stack shape", op, pc)
        a4: i64 = sp - 2
        b4: i64 = sp - 1
        t4: i64 = sp
        dvw: i64 = 0x1AC00800
        msw: i64 = 0x1B008000
        if op == OP_i64_rem_s or op == OP_i64_rem_u
          dvw = 0x9AC00800
          msw = 0x9B008000
        if op == OP_i32_rem_s or op == OP_i64_rem_s
          dvw |= 0x00000400          # SDIV rather than UDIV
        jitm.w32(code, n, dvw | (b4 << 16) | (a4 << 5) | t4)
        n += 1
        jitm.w32(code, n, msw | (b4 << 16) | (a4 << 10) | (t4 << 5) | a4)
        n += 1
        sp -= 1
        last_alu = -1

      elseif op == OP_f32_const or op == OP_f64_const
        # f32.const / f64.const. The immediate is RAW little-endian IEEE754, not
        # a LEB. the engine keeps floats on the operand stack as their BIT PATTERN, so
        # a float constant is just an integer constant — no FP register needed.
        fw: i64 = 4
        if op == OP_f64_const
          fw = 8
        fv: i64 = 0
        fk: i64 = 0
        while fk < fw
          fv |= (s:byte(off + pc) << (fk * 8))
          pc += 1
          fk += 1
        dfq: i64 = sp
        if fw == 4
          jitm.w32(code, n, 0x52800000 | ((fv & 0xFFFF) << 5) | dfq)
          n += 1
          if ((fv >> 16) & 0xFFFF) != 0
            jitm.w32(code, n, 0x72A00000 | (((fv >> 16) & 0xFFFF) << 5) | dfq)
            n += 1
        else
          jitm.w32(code, n, 0xD2800000 | ((fv & 0xFFFF) << 5) | dfq)
          n += 1
          fj: i64 = 1
          while fj < 4
            fc: i64 = (fv >> (fj * 16)) & 0xFFFF
            if fc != 0
              jitm.w32(code, n, 0xF2800000 | (fj << 21) | (fc << 5) | dfq)
              n += 1
            fj += 1
        sp += 1

      elseif (op >= OP_f32_add and op <= OP_f32_max) or (op >= OP_f64_add and op <= OP_f64_max)
        # f32/f64 add/sub/mul/div. Floats live in GP registers as bit patterns,
        # so the value is moved into an FP scratch register, operated on, and
        # moved back. That costs two FMOVs per op but needs NO second register
        # allocator # the operand stack and locals stay entirely integer, which
        # is what lets floats coexist with the w0..w8 / w9..w16 split.
        if sp < 2
          return jitbail("operand stack shape", op, pc)
        af: i64 = sp - 2
        bf2: i64 = sp - 1
        # read an un-materialised alias straight out of the local's register
        fsa: i64 = af
        fsb: i64 = bf2
        if ali_slot == af
          fsa = ali_reg
          ali_slot = -1
        elseif ali2_slot == af
          fsa = ali2_reg
          ali2_slot = -1
        if ali_slot == bf2
          fsb = ali_reg
          ali_slot = -1
        elseif ali2_slot == bf2
          fsb = ali2_reg
          ali2_slot = -1
        # Accumulate-in-place: `local.get N; <k>; f64.op; local.set N`. Keeping N
        # resident in d2 removes BOTH the FMOV-out and the next iteration's
        # FMOV-in from the dependency chain.
        accreg: i64 = -1
        if s:byte(off + pc) == 33
          pidx: i64 = uleb_val(s, off + pc + 1, off + blen) + lbase
          if pidx <= 16
            prg: i64 = locreg(pidx, cf)
            if fsa == prg
              accreg = prg
        f64op: i64 = 0
        if op >= OP_f64_add
          f64op = 1
        vix: i64 = op - 146
        if f64op == 1
          vix = op - 160
        fop: i64 = 0x2800
        if vix == 1
          fop = 0x3800
        elseif vix == 2
          fop = 0x0800
        elseif vix == 3
          fop = 0x1800
        elseif vix == 4
          fop = 0x5800
        elseif vix == 5
          fop = 0x4800
        # The cached local's GP register is STALE, so any operand that would read
        # it must either come from d2 (only operand `a` on the accumulate path
        # can) or force a flush first. Without this, `b` read the stale register
        # and wart_f64_bench drifted to 1000100036477765.6.
        if fcl >= 0 and not (accreg == fcl and fsb != fcl)
          jitm.w32(code, n, 0x9E660000 | (2 << 5) | fcl)
          n += 1
          fcl = -1
        if accreg >= 0
          # operand a: already in d2 when cached, otherwise move it in once
          if f64op == 1
            if fcl != accreg
              jitm.w32(code, n, 0x9E670000 | (fsa << 5) | 2)
              n += 1
            jitm.w32(code, n, 0x9E670000 | (fsb << 5) | 1)
            n += 1
            jitm.w32(code, n, 0x1E600000 | fop | (1 << 16) | (2 << 5) | 2)
            n += 1
          else
            if fcl != accreg
              jitm.w32(code, n, 0x1E270000 | (fsa << 5) | 2)
              n += 1
            jitm.w32(code, n, 0x1E270000 | (fsb << 5) | 1)
            n += 1
            jitm.w32(code, n, 0x1E200000 | fop | (1 << 16) | (2 << 5) | 2)
            n += 1
          fcl = accreg
          # consume the fused local.set
          pc = uleb_end(s, off + pc + 1, off + blen) - off
        elseif f64op == 1
          jitm.w32(code, n, 0x9E670000 | (fsa << 5))
          n += 1
          jitm.w32(code, n, 0x9E670000 | (fsb << 5) | 1)
          n += 1
          jitm.w32(code, n, 0x1E600000 | fop | (1 << 16))
          n += 1
          jitm.w32(code, n, 0x9E660000 | af)
          n += 1
        else
          jitm.w32(code, n, 0x1E270000 | (fsa << 5))
          n += 1
          jitm.w32(code, n, 0x1E270000 | (fsb << 5) | 1)
          n += 1
          jitm.w32(code, n, 0x1E200000 | fop | (1 << 16))
          n += 1
          jitm.w32(code, n, 0x1E260000 | af)
          n += 1
        # The fused form consumed the local.set itself, so it pops BOTH operands
        # and leaves nothing to retarget.
        if accreg >= 0
          sp -= 2
          last_alu = -1
          last_cset = -1
        else
          sp -= 1
          # The FMOV-out writes slot `af`, and its Rd sits in bits 0..4 like any
          # ALU word, so a following local.set/tee can retarget it at the local
          # register directly instead of emitting its own MOV — the same trick
          # the integer path uses, and that MOV was on the chain too.
          last_alu = n - 1
          last_slot = af
          last_cset = -1

      elseif op == OP_i64_const
        # i64.const -> up to four MOVZ/MOVK into the next stack register, in the
        # 64-bit forms (0xD2.. / 0xF2..). The value is a SIGNED LEB of up to ten
        # bytes, so it is decoded here rather than through `uleb_val`.
        q: i64 = 0
        qsh: i64 = 0
        qb: i64 = 0
        qmore: i64 = 1
        while qmore == 1
          qb = s:byte(off + pc)
          pc += 1
          q |= ((qb & 0x7F) << qsh)
          qsh += 7
          if qb < 0x80
            qmore = 0
        if qsh < 64 and (qb & 0x40) != 0
          qone: i64 = 1
          q -= (qone << qsh)
        dq: i64 = sp
        jitm.w32(code, n, 0xD2800000 | ((q & 0xFFFF) << 5) | dq)
        n += 1
        qk: i64 = 1
        while qk < 4
          qc: i64 = (q >> (qk * 16)) & 0xFFFF
          if qc != 0
            jitm.w32(code, n, 0xF2800000 | (qk << 21) | (qc << 5) | dq)
            n += 1
          qk += 1
        sp += 1

      elseif op == OP_local_get
        # local.get: do NOT copy the local into a stack register. Record that the
        # pushed slot IS the local's register and let the consuming ALU op read it
        # directly. Unlike the constant/shift folds, the MOV removed here sits ON
        # the dependency chain (`mov w4,w9` feeding the very next `eor`/`madd`).
        # Only one alias is tracked; a second local.get materializes the first.
        idx: i64 = uleb_val(s, off + pc, off + blen) + lbase
        pc = uleb_end(s, off + pc, off + blen) - off
        # Locals occupy w9..w17 then w19..w27: EIGHTEEN of them. x18 is skipped
        # because it is the reserved platform register on Darwin, and x29/x30 are
        # the frame pointer and link register. The old cap of 8 was what blocked
        # wart_mixed_type_bench and wart_complete_opcode_bench.
        if idx > 16
          return jitbail("local index above 16", op, pc)
        rgi: i64 = locreg(idx, cf)
        # Two alias registers, because consecutive `local.get`s are the common
        # shape (`local.get 1; local.get 0; xor`) and with only one tracked the
        # second spills a chain MOV.
        if ali_slot < 0
          ali_slot = sp
          ali_reg = rgi
        elseif ali2_slot < 0
          ali2_slot = sp
          ali2_reg = rgi
        else
          jitm.w32(code, n, 0xAA0003E0 | (rgi << 16) | sp)
          n += 1
        sp += 1

      elseif op == OP_local_set or op == OP_local_tee
        # local.set / local.tee -> MOV Wlocal, Wtop
        idx2: i64 = uleb_val(s, off + pc, off + blen) + lbase
        pc = uleb_end(s, off + pc, off + blen) - off
        if idx2 > 16 or sp < 1
          return jitbail("local index above 16", op, pc)
        rgo: i64 = locreg(idx2, cf)
        # If the value was just produced by an ALU op into this very slot,
        # retarget that instruction's Rd at the local register instead of copying.
        # These MOVs are on the dependency chain: one round's `local.tee` feeds
        # the next round's read.
        if last_alu == n - 1 and last_slot == sp - 1
          jitm.w32(code, last_alu, (jitm.r32(code, last_alu) & 0xFFFFFFE0) | rgo)
          last_alu = -1
          # `tee` leaves the value on the stack too — it now lives in the local
          # register, so record that as the slot's alias rather than copying back.
          if op == OP_local_tee
            ali_slot = sp - 1
            ali_reg = rgo
        else
          jitm.w32(code, n, 0xAA0003E0 | ((sp - 1) << 16) | rgo)
          n += 1
        if op == OP_local_set
          sp -= 1

      elseif aw != 0
        # binary ALU: Wd = W(sp-2) op W(sp-1)
        if sp < 2
          return jitbail("operand stack shape", op, pc)
        a: i64 = sp - 2
        b: i64 = sp - 1
        # An aliased operand is read straight out of the local's register. The
        # destination stays the real stack register `a`, so no alias escapes.
        # Works in either position: the form is Rd = Rn op Rm with Rn = a, Rm = b,
        # so no commutativity is required. BOTH operands may be aliased at once
        # (`local.get 1; local.get 0; xor`), hence resolving each independently
        # rather than an either/or chain.
        ra: i64 = a
        rb: i64 = b
        if ali_slot == a ra = ali_reg
        if ali_slot == b rb = ali_reg
        if ali2_slot == a ra = ali2_reg
        if ali2_slot == b rb = ali2_reg
        jitm.w32(code, n, aw | (rb << 16) | (ra << 5) | a)
        if ali_slot == a or ali_slot == b ali_slot = -1
        if ali2_slot == a or ali2_slot == b ali2_slot = -1
        n += 1
        last_alu = n - 1
        last_slot = a
        sp -= 1

      elseif cc >= 0
        # comparison: CMP W(sp-2), W(sp-1) then CSET W(sp-2), cond
        if sp < 2
          return jitbail("operand stack shape", op, pc)
        a2: i64 = sp - 2
        b2: i64 = sp - 1
        cmpw: i64 = 0x6B00001F
        if op >= OP_i64_eqz and op <= OP_i64_ge_u
          cmpw = 0xEB00001F
        jitm.w32(code, n, cmpw | (b2 << 16) | (a2 << 5))
        n += 1
        jitm.w32(code, n, 0x1A9F07E0 | ((cc ~ 1) << 12) | a2)
        n += 1
        last_cset = n - 1
        last_cc = cc
        sp -= 1

      elseif op == OP_i32_eqz
        # i32.eqz -> CMP Wt, #0 ; CSET Wt, EQ
        t: i64 = sp - 1
        jitm.w32(code, n, 0x7100001F | (t << 5))
        n += 1
        jitm.w32(code, n, 0x1A9F07E0 | (1 << 12) | t)
        n += 1
        last_cset = n - 1
        last_cc = 0

      elseif op >= OP_i32_wrap_i64 and op <= OP_f64_reinterpret_i64
        # the conversion block. Unary throughout: the operand slot is reused for
        # the result. int<->int is one instruction; int->float and float->int are
        # two (the FP unit reads/writes a GP register directly for SCVTF/FCVTZS,
        # so only one FMOV is needed); demote/promote need three.
        if sp < 1
          return jitbail("operand stack shape", op, pc)
        cv: i64 = sp - 1
        if op == OP_i32_wrap_i64 or op == OP_i64_extend_i32_u
          # i32.wrap_i64 / i64.extend_i32_u: a 32-bit MOV truncates and
          # zero-extends in the same instruction
          jitm.w32(code, n, 0x2A0003E0 | (cv << 16) | cv)
          n += 1
        elseif op == OP_i64_extend_i32_s
          jitm.w32(code, n, 0x93407C00 | (cv << 5) | cv)   # SXTW
          n += 1
        elseif op >= OP_i32_reinterpret_f32
          # reinterpret is FREE here: the engine keeps floats in GP registers as bit
          # patterns, so this is the identity. Only the 32-bit forms clear the
          # high half.
          if op == OP_i32_reinterpret_f32 or op == OP_f32_reinterpret_i32
            jitm.w32(code, n, 0x2A0003E0 | (cv << 16) | cv)
            n += 1
        elseif op == OP_f32_demote_f64
          # f32.demote_f64
          jitm.w32(code, n, 0x9E670000 | (cv << 5))
          n += 1
          jitm.w32(code, n, 0x1E624000)
          n += 1
          jitm.w32(code, n, 0x1E260000 | cv)
          n += 1
        elseif op == OP_f64_promote_f32
          # f64.promote_f32
          jitm.w32(code, n, 0x1E270000 | (cv << 5))
          n += 1
          jitm.w32(code, n, 0x1E22C000)
          n += 1
          jitm.w32(code, n, 0x9E660000 | cv)
          n += 1
        elseif op >= OP_f32_convert_i32_s and op <= OP_f64_convert_i64_u
          # int -> float: SCVTF/UCVTF reads the GP register directly
          cw: i64 = 0x1E220000                       # f32 <- i32, signed
          if op == OP_f32_convert_i32_u
            cw = 0x1E230000
          elseif op == OP_f32_convert_i64_s
            cw = 0x9E220000
          elseif op == OP_f32_convert_i64_u
            cw = 0x9E230000
          elseif op == OP_f64_convert_i32_s
            cw = 0x1E620000
          elseif op == OP_f64_convert_i32_u
            cw = 0x1E630000
          elseif op == OP_f64_convert_i64_s
            cw = 0x9E620000
          elseif op == OP_f64_convert_i64_u
            cw = 0x9E630000
          jitm.w32(code, n, cw | (cv << 5))
          n += 1
          if op >= OP_f64_convert_i32_s
            jitm.w32(code, n, 0x9E660000 | cv)
            n += 1
          else
            jitm.w32(code, n, 0x1E260000 | cv)
            n += 1
        else
          # float -> int, truncating toward zero
          srcf32: i64 = 0
          if op == OP_i32_trunc_f32_s or op == OP_i32_trunc_f32_u or op == OP_i64_trunc_f32_s or op == OP_i64_trunc_f32_u
            srcf32 = 1
          if srcf32 == 1
            jitm.w32(code, n, 0x1E270000 | (cv << 5))
          else
            jitm.w32(code, n, 0x9E670000 | (cv << 5))
          n += 1
          tw: i64 = 0x1E380000
          if op == OP_i32_trunc_f32_u
            tw = 0x1E390000
          elseif op == OP_i32_trunc_f64_s
            tw = 0x1E780000
          elseif op == OP_i32_trunc_f64_u
            tw = 0x1E790000
          elseif op == OP_i64_trunc_f32_s
            tw = 0x9E380000
          elseif op == OP_i64_trunc_f32_u
            tw = 0x9E390000
          elseif op == OP_i64_trunc_f64_s
            tw = 0x9E780000
          elseif op == OP_i64_trunc_f64_u
            tw = 0x9E790000
          jitm.w32(code, n, tw | cv)
          n += 1
        last_alu = -1
        last_cset = -1

      elseif (op >= OP_f32_eq and op <= OP_f64_ge)
        # f32/f64 compares: FCMP then CSET. The conditions are the IEEE ones, so
        # an unordered (NaN) operand yields false for lt/gt/le/ge and true for
        # ne, matching wasm: eq=EQ, ne=NE, lt=MI, gt=GT, le=LS, ge=GE.
        if sp < 2
          return jitbail("operand stack shape", op, pc)
        ca: i64 = sp - 2
        cb: i64 = sp - 1
        c64: i64 = 0
        if op >= OP_f64_eq
          c64 = 1
        cix: i64 = op - 91
        if c64 == 1
          cix = op - 97
        fcc: i64 = 0
        if cix == 1
          fcc = 1
        elseif cix == 2
          fcc = 4
        elseif cix == 3
          fcc = 12
        elseif cix == 4
          fcc = 9
        elseif cix == 5
          fcc = 10
        if c64 == 1
          jitm.w32(code, n, 0x9E670000 | (ca << 5))
          n += 1
          jitm.w32(code, n, 0x9E670000 | (cb << 5) | 1)
          n += 1
          jitm.w32(code, n, 0x1E602000 | (1 << 16))
          n += 1
        else
          jitm.w32(code, n, 0x1E270000 | (ca << 5))
          n += 1
          jitm.w32(code, n, 0x1E270000 | (cb << 5) | 1)
          n += 1
          jitm.w32(code, n, 0x1E202000 | (1 << 16))
          n += 1
        jitm.w32(code, n, 0x1A9F07E0 | ((fcc ~ 1) << 12) | ca)
        n += 1
        sp -= 1
        last_cset = n - 1
        last_cc = fcc
        last_alu = -1

      elseif op == OP_f32_abs or op == OP_f32_neg or op == OP_f64_abs or op == OP_f64_neg
        # f32/f64 abs and neg are SIGN-BIT operations, so in the bit-pattern
        # representation they are integer masking with NO FP register at all:
        # abs clears the sign bit, neg flips it. That removes two shuttle moves
        # each, both of which sat on the dependency chain.
        if sp < 1 or sp > 8
          return jitbail("operand stack shape", op, pc)
        na: i64 = sp - 1
        nt: i64 = sp
        if op == OP_f64_abs or op == OP_f64_neg
          jitm.w32(code, n, 0xD2800000 | nt)
          n += 1
          jitm.w32(code, n, 0xF2E00000 | (0x8000 << 5) | nt)
          n += 1
          if op == OP_f64_abs
            jitm.w32(code, n, 0x8A200000 | (nt << 16) | (na << 5) | na)
          else
            jitm.w32(code, n, 0xCA000000 | (nt << 16) | (na << 5) | na)
          n += 1
        else
          jitm.w32(code, n, 0x52800000 | nt)
          n += 1
          jitm.w32(code, n, 0x72A00000 | (0x8000 << 5) | nt)
          n += 1
          if op == OP_f32_abs
            jitm.w32(code, n, 0x0A200000 | (nt << 16) | (na << 5) | na)
          else
            jitm.w32(code, n, 0x4A000000 | (nt << 16) | (na << 5) | na)
          n += 1
        last_alu = -1
        last_cset = -1

      elseif (op >= OP_f32_ceil and op <= OP_f32_sqrt) or (op >= OP_f64_ceil and op <= OP_f64_sqrt)
        # f32/f64 abs/neg/ceil/floor/trunc/nearest/sqrt: one FP-source op, using
        # the same GP<->FP shuttle as the binops. Offsets are the ARM64 opcode
        # field, identical for single and double; only the type base differs.
        if sp < 1
          return jitbail("operand stack shape", op, pc)
        uf: i64 = sp - 1
        ubase: i64 = 0x1E200000
        uix: i64 = op - 139
        if op >= OP_f64_abs
          ubase = 0x1E600000
          uix = op - 153
        uw: i64 = 0xC000
        if uix == 1
          uw = 0x14000
        elseif uix == 2
          uw = 0x4C000
        elseif uix == 3
          uw = 0x54000
        elseif uix == 4
          uw = 0x5C000
        elseif uix == 5
          uw = 0x44000
        elseif uix == 6
          uw = 0x1C000
        if ubase == 0x1E600000
          jitm.w32(code, n, 0x9E670000 | (uf << 5))
          n += 1
          jitm.w32(code, n, ubase | uw)
          n += 1
          jitm.w32(code, n, 0x9E660000 | uf)
          n += 1
        else
          jitm.w32(code, n, 0x1E270000 | (uf << 5))
          n += 1
          jitm.w32(code, n, ubase | uw)
          n += 1
          jitm.w32(code, n, 0x1E260000 | uf)
          n += 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_i32_eqz or op == OP_i64_eqz
        # i32.eqz / i64.eqz: compare against zero, then CSET EQ. Unary, so the
        # operand slot is reused for the result.
        if sp < 1
          return jitbail("operand stack shape", op, pc)
        ez: i64 = sp - 1
        ezw: i64 = 0x7100001F
        if op == OP_i64_eqz
          ezw = 0xF100001F
        jitm.w32(code, n, ezw | (ez << 5))
        n += 1
        jitm.w32(code, n, 0x1A9F07E0 | (1 << 12) | ez)
        n += 1
        last_cset = n - 1
        last_cc = 0
        last_alu = -1

      elseif (op >= OP_i32_load8_s and op <= OP_i64_load32_u) or (op >= OP_i32_store8 and op <= OP_i64_store32)
        # sub-width loads and stores. Same effective-address form as the full
        # width ops; only the size, signedness and offset scale differ.
        salign: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        soff: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        # size in bytes, and whether the load sign-extends
        ssz: i64 = 1
        ssg: i64 = 0
        sx64: i64 = 0
        if op == OP_i32_load8_s or op == OP_i32_load16_s or op == OP_i64_load8_s or op == OP_i64_load16_s or op == OP_i64_load32_s
          ssg = 1
        if op == OP_i32_load16_s or op == OP_i32_load16_u or op == OP_i64_load16_s or op == OP_i64_load16_u or op == OP_i32_store16 or op == OP_i64_store16
          ssz = 2
        if op == OP_i64_load32_s or op == OP_i64_load32_u or op == OP_i64_store32
          ssz = 4
        if op >= OP_i64_load8_s and op <= OP_i64_load32_u
          sx64 = 1
        # The scaled 12-bit immediate reaches 4095 slots and demands natural
        # alignment. Everything else FOLDS INTO THE ADDRESS REGISTER as one or
        # two ADD immediates (imm12, the first optionally shifted left 12), which
        # covers every offset below 16 MiB. This used to be a refusal, and it is
        # why every wasi-libc `_start` in the corpus ran on the interpreter:
        # wasi-libc addresses its data through offsets at 65540 and up, which is
        # precisely the range the scaled immediate cannot encode.
        sfold: i64 = 0
        if soff - (soff // ssz) * ssz != 0 or soff // ssz > 4095
          if soff > 16777215
            return jitbail("memory offset above 16 MiB, past two ADD immediates", op, pc)
          sfold = 1
        simm: i64 = soff // ssz
        if sfold == 1
          simm = 0
        sbase: i64 = 0x39000000
        if ssz == 2
          sbase = 0x79000000
        elseif ssz == 4
          sbase = 0xB9000000
        if op >= OP_i32_store8
          if sp < 2
            return jitbail("operand stack shape", op, pc)
          za: i64 = sp - 2
          zv: i64 = sp - 1
          jitm.w32(code, n, 0x8B000000 | (za << 16) | (28 << 5) | za)
          n += 1
          if sfold == 1
            if soff >= 4096
              jitm.w32(code, n, 0x91400000 | ((soff >> 12) << 10) | (za << 5) | za)
              n += 1
            if (soff & 0xFFF) > 0
              jitm.w32(code, n, 0x91000000 | ((soff & 0xFFF) << 10) | (za << 5) | za)
              n += 1
          jitm.w32(code, n, sbase | (simm << 10) | (za << 5) | zv)
          n += 1
          sp -= 2
        else
          if sp < 1
            return jitbail("operand stack shape", op, pc)
          zl: i64 = sp - 1
          jitm.w32(code, n, 0x8B000000 | (zl << 16) | (28 << 5) | zl)
          n += 1
          if sfold == 1
            if soff >= 4096
              jitm.w32(code, n, 0x91400000 | ((soff >> 12) << 10) | (zl << 5) | zl)
              n += 1
            if (soff & 0xFFF) > 0
              jitm.w32(code, n, 0x91000000 | ((soff & 0xFFF) << 10) | (zl << 5) | zl)
              n += 1
          lw: i64 = sbase | 0x00400000
          if ssg == 1
            if sx64 == 1
              lw = sbase | 0x00800000
            else
              lw = sbase | 0x00C00000
          jitm.w32(code, n, lw | (simm << 10) | (zl << 5) | zl)
          n += 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_i32_load or op == OP_i64_load or op == OP_f32_load or op == OP_f64_load or op == OP_i32_store or op == OP_i64_store or op == OP_f32_store or op == OP_f64_store
        # i32/i64/f32/f64 load and store. Both immediates (align, then offset)
        # are LEBs. The dynamic address is an UNSIGNED i32 already zero-extended
        # in its register, because every 32-bit ARM64 op clears the top half, so
        # `ADD Xa, x28, Xa` forms the effective address without a separate UXTW.
        malign: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        moff: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        wide: i64 = 0
        if op == OP_i64_load or op == OP_f64_load or op == OP_i64_store or op == OP_f64_store
          wide = 1
        # the scaled immediate form needs a naturally aligned offset in range
        sc: i64 = 4
        if wide == 1
          sc = 8
        # same fold as the sub-width arm: an offset the scaled immediate cannot
        # encode goes into the address register instead of being a refusal
        mfold: i64 = 0
        if moff - (moff // sc) * sc != 0 or moff // sc > 4095
          if moff > 16777215
            return jitbail("memory offset above 16 MiB, past two ADD immediates", op, pc)
          mfold = 1
        mimm: i64 = moff // sc
        if mfold == 1
          mimm = 0
        if op >= OP_i32_store
          # store: [addr, value]
          if sp < 2
            return jitbail("operand stack shape", op, pc)
          ma: i64 = sp - 2
          mv: i64 = sp - 1
          jitm.w32(code, n, 0x8B000000 | (ma << 16) | (28 << 5) | ma)
          n += 1
          if mfold == 1
            if moff >= 4096
              jitm.w32(code, n, 0x91400000 | ((moff >> 12) << 10) | (ma << 5) | ma)
              n += 1
            if (moff & 0xFFF) > 0
              jitm.w32(code, n, 0x91000000 | ((moff & 0xFFF) << 10) | (ma << 5) | ma)
              n += 1
          if wide == 1
            jitm.w32(code, n, 0xF9000000 | (mimm << 10) | (ma << 5) | mv)
          else
            jitm.w32(code, n, 0xB9000000 | (mimm << 10) | (ma << 5) | mv)
          n += 1
          sp -= 2
        else
          if sp < 1
            return jitbail("operand stack shape", op, pc)
          ma2: i64 = sp - 1
          jitm.w32(code, n, 0x8B000000 | (ma2 << 16) | (28 << 5) | ma2)
          n += 1
          if mfold == 1
            if moff >= 4096
              jitm.w32(code, n, 0x91400000 | ((moff >> 12) << 10) | (ma2 << 5) | ma2)
              n += 1
            if (moff & 0xFFF) > 0
              jitm.w32(code, n, 0x91000000 | ((moff & 0xFFF) << 10) | (ma2 << 5) | ma2)
              n += 1
          if wide == 1
            jitm.w32(code, n, 0xF9400000 | (mimm << 10) | (ma2 << 5) | ma2)
          else
            jitm.w32(code, n, 0xB9400000 | (mimm << 10) | (ma2 << 5) | ma2)
          n += 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_select
        # select: [a, b, c] -> c != 0 ? a : b. CMP against zero then CSEL, so no
        # branch is emitted at all.
        if sp < 3
          return jitbail("operand stack shape", op, pc)
        sa: i64 = sp - 3
        sb: i64 = sp - 2
        sc: i64 = sp - 1
        jitm.w32(code, n, 0x7100001F | (sc << 5))
        n += 1
        jitm.w32(code, n, 0x1A800000 | (sb << 16) | (1 << 12) | (sa << 5) | sa)
        n += 1
        sp -= 2
        last_alu = -1
        last_cset = -1

      elseif op == OP_global_get or op == OP_global_set
        gidx: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        if gidx > 4095
          return jitbail("global index above 4095", op, pc)
        if op == OP_global_get
          if sp > 8
            return jitbail("operand stack shape", op, pc)
          jitm.w32(code, n, 0xF9400000 | (gidx << 10) | (27 << 5) | sp)
          n += 1
          sp += 1
        else
          if sp < 1
            return jitbail("operand stack shape", op, pc)
          jitm.w32(code, n, 0xF9000000 | (gidx << 10) | (27 << 5) | (sp - 1))
          n += 1
          sp -= 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_memory_size
        # memory.size: `main` allocates exactly the declared page count and the
        # image never grows, so this is the constant `jpages`. It used to emit a
        # hardcoded 1, which is wrong for every module declaring more than one
        # page. memory.grow (64) has no arm and still bails — growing would need
        # a real allocator behind the base pointer.
        pc += 1
        if sp > 8
          return jitbail("operand stack shape", op, pc)
        jitm.w32(code, n, 0x52800000 | ((jpages & 0xFFFF) << 5) | sp)
        n += 1
        sp += 1

      elseif op == OP_i32_clz or op == OP_i32_ctz or op == OP_i32_popcnt or op == OP_i64_clz or op == OP_i64_ctz or op == OP_i64_popcnt
        # clz / ctz / popcnt, both widths. ARM64 has CLZ but no count-trailing,
        # so ctz is RBIT+CLZ. popcnt has no integer form at all: it goes through
        # the vector unit as CNT over bytes then ADDV to sum the lanes, reusing
        # the same GP<->FP shuttle the float ops use.
        if sp < 1
          return jitbail("operand stack shape", op, pc)
        bq: i64 = sp - 1
        b64: i64 = 0
        if op >= OP_i64_clz
          b64 = 1
        bk2: i64 = op - 103
        if b64 == 1
          bk2 = op - 121
        if bk2 == 2
          if b64 == 1
            jitm.w32(code, n, 0x9E670000 | (bq << 5))
          else
            jitm.w32(code, n, 0x1E270000 | (bq << 5))
          n += 1
          jitm.w32(code, n, 0x0E205800)
          n += 1
          jitm.w32(code, n, 0x0E31B800)
          n += 1
          jitm.w32(code, n, 0x1E260000 | bq)
          n += 1
        else
          if bk2 == 1
            if b64 == 1
              jitm.w32(code, n, 0xDAC00000 | (bq << 5) | bq)
            else
              jitm.w32(code, n, 0x5AC00000 | (bq << 5) | bq)
            n += 1
          if b64 == 1
            jitm.w32(code, n, 0xDAC01000 | (bq << 5) | bq)
          else
            jitm.w32(code, n, 0x5AC01000 | (bq << 5) | bq)
          n += 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_i32_rotl or op == OP_i64_rotl
        # rotl. ARM64 rotates RIGHT only, and RORV takes the shift amount modulo
        # the width from the low bits of its register, so negating the amount
        # turns a right rotate into a left one with no explicit `width - n`.
        if sp < 2
          return jitbail("operand stack shape", op, pc)
        ra: i64 = sp - 2
        rb: i64 = sp - 1
        if op == OP_i64_rotl
          jitm.w32(code, n, 0xCB0003E0 | (rb << 16) | rb)
          n += 1
          jitm.w32(code, n, 0x9AC02C00 | (rb << 16) | (ra << 5) | ra)
          n += 1
        else
          jitm.w32(code, n, 0x4B0003E0 | (rb << 16) | rb)
          n += 1
          jitm.w32(code, n, 0x1AC02C00 | (rb << 16) | (ra << 5) | ra)
          n += 1
        sp -= 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_f32_copysign or op == OP_f64_copysign
        # copysign. the engine keeps floats as BIT PATTERNS in GP registers, so this is
        # pure integer masking: clear the sign bit of a, take b's, OR them. No FP
        # register is touched # another dividend of the representation.
        if sp < 2 or sp > 8
          return jitbail("operand stack shape", op, pc)
        pa: i64 = sp - 2
        pb: i64 = sp - 1
        pt: i64 = sp
        if op == OP_f64_copysign
          jitm.w32(code, n, 0xD2800000 | pt)
          n += 1
          jitm.w32(code, n, 0xF2E00000 | (0x8000 << 5) | pt)
          n += 1
          jitm.w32(code, n, 0x8A200000 | (pt << 16) | (pa << 5) | pa)
          n += 1
          jitm.w32(code, n, 0x8A000000 | (pt << 16) | (pb << 5) | pb)
          n += 1
          jitm.w32(code, n, 0xAA000000 | (pb << 16) | (pa << 5) | pa)
          n += 1
        else
          jitm.w32(code, n, 0x52800000 | pt)
          n += 1
          jitm.w32(code, n, 0x72A00000 | (0x8000 << 5) | pt)
          n += 1
          jitm.w32(code, n, 0x0A200000 | (pt << 16) | (pa << 5) | pa)
          n += 1
          jitm.w32(code, n, 0x0A000000 | (pt << 16) | (pb << 5) | pb)
          n += 1
          jitm.w32(code, n, 0x2A000000 | (pb << 16) | (pa << 5) | pa)
          n += 1
        sp -= 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_nop
        # nop: emits nothing

      elseif op == OP_unreachable
        # unreachable: the module traps. BRK #0 is the only trap this JIT can
        # express # there is no way to call back into the engine from emitted code #
        # so a jit trap raises SIGTRAP where an interpreter trap exits 71. That
        # divergence is REAL and `test/conform.id` reports it rather than
        # hiding it; what is not acceptable is inventing a return value here.
        #
        # Like `br`, everything after this is unreachable and wasm makes the
        # operand stack polymorphic there while this JIT tracks `sp` concretely.
        # Accept it only where that region is empty. Without this guard, the
        # wasi-libc `_start` prologue compiles its post-trap tail against a stale
        # `sp` # the same defect that made wart_simple_bench return 1.
        nxu: i64 = s:byte(off + pc)
        if nxu != 11 and nxu != 5
          return jitbail("reachable code after unreachable", op, pc)
        # A trap must LOOK THE SAME on both engines. This used to emit `BRK #0`,
        # which raises SIGTRAP and leaves the shell reporting 133, where the
        # interpreter's `bailtrap` exits 71. Nothing in the corpus reached it, so
        # the divergence was invisible # and it stopped being unreachable the
        # moment imported calls started compiling, because wasi-libc's
        # `__wasi_proc_exit` ends on exactly this opcode. Call the host's `exit`
        # with the interpreter's status instead; fall back to BRK only if the
        # host has no such symbol, which is a stall, never a wrong answer.
        if jex != 0
          jitm.w32(code, n, 0x52800000 | (71 << 5))
          n += 1
          n = movabs(code, n, 17, jex)
          jitm.w32(code, n, 0xD63F0000 | (17 << 5))
          n += 1
        else
          jitm.w32(code, n, 0xD4200000)
          n += 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_drop
        # drop: the value simply stops being referenced
        if sp < 1
          return jitbail("operand stack shape", op, pc)
        sp -= 1

      elseif op == OP_if_
        # if: pop the condition and branch PAST the then-arm when it is zero.
        # The target is the matching `else` or `end`, neither emitted yet, so the
        # branch word is remembered in `lelsw` and patched there. The label is a
        # block, so `br` out of an `if` uses the same forward machinery.
        pc += 1
        if ldep >= 32 or sp < 1
          return jitbail("label stack deeper than 32", op, pc)
        sp -= 1
        mem.write_i64(lkind, ldep * 8, 0)
        mem.write_i64(lpn, ldep * 8, 0)
        mem.write_i64(lelsw, ldep * 8, n)
        mem.write_i64(lsps, ldep * 8, sp)
        jitm.w32(code, n, 0x34000000 | sp)
        n += 1
        ldep += 1
        last_alu = -1
        last_cset = -1

      elseif op == OP_else_
        # else: end of the then-arm. Jump over the else-arm (patched at `end`),
        # then point the `if`'s conditional branch here.
        if ldep < 1
          return jitbail("else with no open if", op, pc)
        lte: i64 = ldep - 1
        pke: i64 = mem.read_i64(lpn, lte * 8)
        if pke >= 8
          return jitbail("more than 8 forward branches to one label", op, pc)
        jitm.w32(code, n, 0x14000000)
        mem.write_i64(lpat, (lte * 8 + pke) * 8, n * 2 + 1)
        mem.write_i64(lpn, lte * 8, pke + 1)
        n += 1
        # both arms must start at the same operand-stack depth; without this the
        # else-arm pushed on top of the then-arm's result and the epilogue read
        # the wrong register (a plain if/else returned 5 instead of 100)
        sp = mem.read_i64(lsps, lte * 8)
        ew: i64 = mem.read_i64(lelsw, lte * 8)
        if ew > 0
          dle: i64 = n - ew
          jitm.w32(code, ew, (jitm.r32(code, ew) & 0xFF00001F) | ((dle & 0x7FFFF) << 5))
          mem.write_i64(lelsw, lte * 8, 0)
        last_alu = -1
        last_cset = -1

      elseif op == OP_block
        # block: a FORWARD label. Its target is the matching `end`, so branches
        # to it are recorded and patched there.
        pc += 1
        if ldep >= 32
          return jitbail("label stack deeper than 32", op, pc)
        mem.write_i64(lkind, ldep * 8, 0)
        mem.write_i64(lpn, ldep * 8, 0)
        mem.write_i64(lelsw, ldep * 8, 0)
        ldep += 1

      elseif op == OP_loop
        # loop: header is here, so branches to it resolve immediately
        pc += 1
        if ldep >= 32
          return jitbail("label stack deeper than 32", op, pc)
        mem.write_i64(lkind, ldep * 8, 1)
        mem.write_i64(lhead, ldep * 8, n)
        mem.write_i64(lpn, ldep * 8, 0)
        mem.write_i64(lelsw, ldep * 8, 0)
        ldep += 1

      elseif op == OP_br_if
        # br_if 0 -> CBNZ Wtop, <loop head>  (backward, offset known now)
        d3: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        sp -= 1
        lt: i64 = ldep - 1 - d3
        if lt < 0
          return jitbail("branch target above the label stack", op, pc)
        # If a CSET produced this condition immediately before, discard it and
        # branch on the flags the CMP already set: `cmp; cset; cbnz` (3 insns,
        # with the CSET on the loop-carried control path) becomes `cmp; b.cond`.
        if mem.read_i64(lkind, lt * 8) == 1
          lh: i64 = mem.read_i64(lhead, lt * 8)
          if last_cset == n - 1
            n -= 1
            last_cset = -1
            dl2: i64 = lh - n
            jitm.w32(code, n, 0x54000000 | ((dl2 & 0x7FFFF) << 5) | last_cc)
            n += 1
          else
            delta: i64 = lh - n
            jitm.w32(code, n, 0x35000000 | ((delta & 0x7FFFF) << 5) | sp)
            n += 1
        else
          # forward: emit with a zero offset and record the word for patching
          pk2: i64 = mem.read_i64(lpn, lt * 8)
          if pk2 >= 8
            return jitbail("more than 8 forward branches to one label", op, pc)
          if last_cset == n - 1
            n -= 1
            last_cset = -1
            jitm.w32(code, n, 0x54000000 | last_cc)
          else
            jitm.w32(code, n, 0x35000000 | sp)
          mem.write_i64(lpat, (lt * 8 + pk2) * 8, n * 2)
          mem.write_i64(lpn, lt * 8, pk2 + 1)
          n += 1

      elseif op == OP_end_
        # end: closes a label. Every forward branch that targeted this block is
        # now resolvable, so patch the placeholders to land here. imm19 sits in
        # bits 5..23 of both B.cond and CBNZ, so one mask serves both.
        # An inlined callee's own function-level `end` must not touch the
        # CALLER's labels. Restoring `ldep` on return handles the pop, but this
        # arm also PATCHES forward branches, and a patch cannot be undone: an
        # `end` from an inlined body retargeted the caller's `if` into the middle
        # of that body, hanging wart_simple_opcode_bench. Below the current
        # inline frame's base, `end` does nothing.
        ebase: i64 = 0
        if inl_d > 0
          ebase = mem.read_i64(inl_lds, (inl_d - 1) * 8)
        if ldep > ebase
          ldep -= 1
          # an `if` with no `else`: its conditional branch lands here
          ewd: i64 = mem.read_i64(lelsw, ldep * 8)
          if ewd > 0
            dlw: i64 = n - ewd
            jitm.w32(code, ewd, (jitm.r32(code, ewd) & 0xFF00001F) | ((dlw & 0x7FFFF) << 5))
            mem.write_i64(lelsw, ldep * 8, 0)
          if mem.read_i64(lkind, ldep * 8) == 0
            pq: i64 = 0
            pk3: i64 = mem.read_i64(lpn, ldep * 8)
            while pq < pk3
              pe: i64 = mem.read_i64(lpat, (ldep * 8 + pq) * 8)
              pw: i64 = pe // 2
              dl3: i64 = n - pw
              if pe - pw * 2 == 1
                # unconditional B: imm26 in bits 0..25
                jitm.w32(code, pw, 0x14000000 | (dl3 & 0x03FFFFFF))
              else
                # B.cond / CBNZ: imm19 in bits 5..23
                jitm.w32(code, pw, (jitm.r32(code, pw) & 0xFF00001F) | ((dl3 & 0x7FFFF) << 5))
              pq += 1

      elseif op == OP_br
        # br: unconditional. Backward to a loop head resolves now; forward to a
        # block end is a placeholder patched at `end`, exactly like br_if, but the
        # offset lives in imm26 rather than imm19 so the patch records the form.
        d4: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        lt2: i64 = ldep - 1 - d4
        if lt2 < 0
          return jitbail("branch target above the label stack", op, pc)
        if mem.read_i64(lkind, lt2 * 8) == 1
          dlb: i64 = mem.read_i64(lhead, lt2 * 8) - n
          jitm.w32(code, n, 0x14000000 | (dlb & 0x03FFFFFF))
          n += 1
        else
          pk4: i64 = mem.read_i64(lpn, lt2 * 8)
          if pk4 >= 8
            return jitbail("more than 8 forward branches to one label", op, pc)
          jitm.w32(code, n, 0x14000000)
          mem.write_i64(lpat, (lt2 * 8 + pk4) * 8, n * 2 + 1)
          mem.write_i64(lpn, lt2 * 8, pk4 + 1)
          n += 1
        # Code after an unconditional branch is UNREACHABLE, and wasm makes the
        # operand stack polymorphic there. This JIT tracks `sp` concretely, so
        # compiling that region emits wrong code: wart_simple_bench returned 1
        # instead of 4037913 until this guard was added. Accept `br` only where
        # the unreachable region is empty # immediately before `end` or `else`.
        nxb: i64 = s:byte(off + pc)
        if nxb != 11 and nxb != 5
          return jitbail("reachable code after an unconditional branch", op, pc)

      elseif op == OP_br_table
        # br_table: a small dense switch. Emitted as a compare chain rather than
        # a jump table # these tables are tiny (the corpus one has three
        # targets), and a chain reuses the existing label resolution instead of
        # needing an addressable constant pool.
        bt_n: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        if sp < 1 or bt_n > 32
          return jitbail("br_table with more than 32 targets", op, pc)
        sp -= 1
        bti: i64 = sp
        btk: i64 = 0
        while btk < bt_n
          btd: i64 = uleb_val(s, off + pc, off + blen)
          pc = uleb_end(s, off + pc, off + blen) - off
          btt: i64 = ldep - 1 - btd
          if btt < 0
            return jitbail("branch target above the label stack", op, pc)
          jitm.w32(code, n, 0x7100001F | (btk << 10) | (bti << 5))
          n += 1
          if mem.read_i64(lkind, btt * 8) == 1
            bth: i64 = mem.read_i64(lhead, btt * 8) - n
            jitm.w32(code, n, 0x54000000 | ((bth & 0x7FFFF) << 5))
            n += 1
          else
            btp: i64 = mem.read_i64(lpn, btt * 8)
            if btp >= 8
              return jitbail("more than 8 forward branches to one label", op, pc)
            jitm.w32(code, n, 0x54000000)
            mem.write_i64(lpat, (btt * 8 + btp) * 8, n * 2)
            mem.write_i64(lpn, btt * 8, btp + 1)
            n += 1
          btk += 1
        # the default label
        btdf: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        btt2: i64 = ldep - 1 - btdf
        if btt2 < 0
          return jitbail("branch target above the label stack", op, pc)
        if mem.read_i64(lkind, btt2 * 8) == 1
          btl: i64 = mem.read_i64(lhead, btt2 * 8) - n
          jitm.w32(code, n, 0x14000000 | (btl & 0x03FFFFFF))
          n += 1
        else
          btp2: i64 = mem.read_i64(lpn, btt2 * 8)
          if btp2 >= 8
            return jitbail("more than 8 forward branches to one label", op, pc)
          jitm.w32(code, n, 0x14000000)
          mem.write_i64(lpat, (btt2 * 8 + btp2) * 8, n * 2 + 1)
          mem.write_i64(lpn, btt2 * 8, btp2 + 1)
          n += 1
        # like `br`, everything after this is unreachable and the concrete `sp`
        # model cannot compile it
        nxt2: i64 = s:byte(off + pc)
        if nxt2 != 11 and nxt2 != 5
          return jitbail("reachable code after an unconditional branch", op, pc)
        last_alu = -1
        last_cset = -1

      elseif op == OP_return_
        # return. At label depth zero it is simply "stop compiling this body".
        # Deeper in, the rest of the function still has to be emitted (silently
        # dropping it made wart_compute_bench hang once `if` stopped bailing), so
        # the result moves to x0 here and an unconditional B jumps to the
        # epilogue # whose address is not known yet, hence the patch list. A
        # return from an INLINED body would exit the wrong function, so that
        # shape still bails.
        if ldep == 0
          pc = blen + 1
        elseif inl_d > 0 or jrn >= 64
          return jitbail("return inside an inlined body, or more than 64 returns", op, pc)
        else
          if sp > 0
            jitm.w32(code, n, 0xAA0003E0 | ((sp - 1) << 16) | 0)
            n += 1
          jitm.w32(code, n, 0x14000000)
          mem.write_i64(jrw, jrn * 8, n)
          jrn += 1
          n += 1
          # Like `br`, everything after this is unreachable, and wasm makes the
          # operand stack polymorphic there while this JIT tracks `sp`
          # concretely. Accept it only where that region is empty.
          nxr: i64 = s:byte(off + pc)
          if nxr != 11 and nxr != 5
            return jitbail("reachable code after an unconditional branch", op, pc)
          last_alu = -1
          last_cset = -1

      elseif op == OP_call
        # call: INLINE a leaf callee. A real call needs a frame and spill
        # machinery this template JIT does not have, but splicing a leaf body
        # costs nothing at run time # and `call` is what four of the six
        # compute-heavy modules bail on, the ones losing 5-26x to wasmtime.
        cidx: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        cfx: i64 = cidx - jimp
        if cfx >= jnf
          return jitbail("call target is above the function section", op, pc)
        if cfx < 0
        # ── IMPORTED FUNCTION ────────────────────────────────────────────────
        # This was the architectural blocker, and it was in `jit`, not here:
        # alloc/w32/seal/call* let Duo emit code and ENTER it, and nothing let
        # emitted code LEAVE it. So a body that reached an import took the WHOLE
        # module to the interpreter # which is every wasi-libc `_start`, because
        # `_start` reaches `fd_write` to print its answer. `hot`, `hot_big` and
        # `brtable` all bailed here, at body offset 9, on the first `call`.
        #
        # `jit.sym` now answers with a host function address, so the effect
        # is emitted: materialize the address into x17 and `BLR` it. Dispatch is
        # on the import's FIELD NAME -- the same byte test the interpreter
        # applies # and every import that is not one engine can perform keeps the
        # interpreter's stub shape, so the two engines cannot disagree about a
        # module. Nothing here reads a module name, a function index or an input
        # size.
        imk: i64 = 0
        imy: i64 = 0
        if cidx < 256
          imk = mem.read_i64(jimk, cidx * 8)
          imy = mem.read_i64(jimx, cidx * 8)
        imnp: i64 = mem.read_i64(jtp, imy * 8)
        imnr: i64 = mem.read_i64(jtr, imy * 8)
        # `imk` is the ROSTER INDEX from `wasi_abi.id` (1-based, alphabetical),
        # the same identity the interpreter dispatches on at `hid ==
        # wabi.i_fd_write`. This test read `imk == 1`, left over from when
        # `jimk` held a BOOLEAN "the field name matched the fd_write mask".
        # When the mask became the shared roster lookup the flag became an
        # index and the 1 stayed, so the arm now named `args_get` — which no
        # module in either corpus imports — and EVERY `fd_write` fell through
        # to the zero-filling stub below. Both wasi fixtures therefore emitted
        # nothing under the jit and returned 0 while the interpreter printed
        # their line. It is spelled as the constant, not the literal, so a
        # roster edit cannot silently repoint it again.
        if imk == wabi.i_fd_write and imnp == 4 and imnr == 1 and sp >= 4 and jwr != 0
          # fd_write(fd, iovs, iovslen, nwritten) -> errno.
          #
          # Everything the caller holds in a caller-saved register has to survive
          # the BL by hand, exactly as the real-call path does it: the operand
          # slots below the four arguments, plus any local that landed in
          # x0..x17. Locals in x19..x26 and the two bases in x27/x28 are
          # callee-saved and libc preserves them.
          isp: i64 = 0
          iv: i64 = 0
          while iv < lbase + curloc
            ir: i64 = locreg(iv, cf)
            if ir <= 17
              mem.write_i64(jspr, isp * 8, ir)
              isp += 1
            iv += 1
          iov: i64 = 0
          while iov < sp - 4
            mem.write_i64(jspr, isp * 8, iov)
            isp += 1
            iov += 1
          if isp > 64
            return jitbail("more than 64 registers to spill across an imported call", op, pc)
          isq: i64 = 0
          while isq < isp
            jitm.w32(code, n, 0xF81F0FE0 | mem.read_i64(jspr, isq * 8))
            n += 1
            isq += 1
          # `write` clobbers x0..x17, so NONE of the loop state can live in a
          # register across it. It lives in a 64-byte scratch block whose address
          # is baked in, and the sequence re-materializes that address after every
          # call. Slots: 0 fd, 8 iovec base, 16 count, 24 index, 32 total,
          # 40 nwritten, 48 cursor, 56 remaining.
          #
          # Fixed shape, so every branch offset below is arithmetic rather than a
          # patch: prologue 16 words at +0, outer head 20 at +16, inner
          # write-until-drained loop 27 at +36, epilogue 8 at +63.
          ib: i64 = n
          ia: i64 = sp - 4
          n = movabs(code, n, 16, jsca)
          jitm.w32(code, n, 0x2A0003E0 | (ia << 16))
          jitm.w32(code, n + 1, 0xF9000000 | (16 << 5))
          jitm.w32(code, n + 2, 0x2A0003E0 | ((ia + 1) << 16))
          jitm.w32(code, n + 3, 0x8B000000 | (0 << 16) | (28 << 5))
          jitm.w32(code, n + 4, 0xF9000000 | (1 << 10) | (16 << 5))
          jitm.w32(code, n + 5, 0x2A0003E0 | ((ia + 2) << 16))
          jitm.w32(code, n + 6, 0xF9000000 | (2 << 10) | (16 << 5))
          jitm.w32(code, n + 7, 0x2A0003E0 | ((ia + 3) << 16))
          jitm.w32(code, n + 8, 0x8B000000 | (0 << 16) | (28 << 5))
          jitm.w32(code, n + 9, 0xF9000000 | (5 << 10) | (16 << 5))
          jitm.w32(code, n + 10, 0xF9000000 | (3 << 10) | (16 << 5) | 31)
          jitm.w32(code, n + 11, 0xF9000000 | (4 << 10) | (16 << 5) | 31)
          n += 12
          # outer: for each iovec, take its (offset, length) pair
          n = movabs(code, n, 16, jsca)
          jitm.w32(code, n, 0xF9400000 | (3 << 10) | (16 << 5))
          jitm.w32(code, n + 1, 0xF9400000 | (2 << 10) | (16 << 5) | 1)
          jitm.w32(code, n + 2, 0xEB00001F | (1 << 16))
          jitm.w32(code, n + 3, 0x54000000 | (40 << 5) | 10)
          jitm.w32(code, n + 4, 0xF9400000 | (1 << 10) | (16 << 5) | 2)
          jitm.w32(code, n + 5, 0x8B000000 | (0 << 16) | (3 << 10) | (2 << 5) | 2)
          jitm.w32(code, n + 6, 0xB9400000 | (2 << 5) | 3)
          jitm.w32(code, n + 7, 0xB9400000 | (1 << 10) | (2 << 5) | 4)
          jitm.w32(code, n + 8, 0x8B000000 | (3 << 16) | (28 << 5) | 3)
          jitm.w32(code, n + 9, 0xF9000000 | (6 << 10) | (16 << 5) | 3)
          jitm.w32(code, n + 10, 0xF9000000 | (7 << 10) | (16 << 5) | 4)
          jitm.w32(code, n + 11, 0xF9400000 | (4 << 10) | (16 << 5) | 5)
          jitm.w32(code, n + 12, 0x8B000000 | (4 << 16) | (5 << 5) | 5)
          jitm.w32(code, n + 13, 0xF9000000 | (4 << 10) | (16 << 5) | 5)
          jitm.w32(code, n + 14, 0x91000000 | (1 << 10))
          jitm.w32(code, n + 15, 0xF9000000 | (3 << 10) | (16 << 5))
          n += 16
          # inner: a short write is a REAL outcome on a pipe, so drain the iovec
          # rather than assuming one call moved all of it. Zero or negative ends
          # the whole sequence with what has been counted so far.
          n = movabs(code, n, 16, jsca)
          jitm.w32(code, n, 0xF9400000 | (7 << 10) | (16 << 5) | 2)
          jitm.w32(code, n + 1, 0xF100001F | (2 << 5))
          jitm.w32(code, n + 2, 0x54000000 | ((-26 & 0x7FFFF) << 5) | 13)
          jitm.w32(code, n + 3, 0xF9400000 | (16 << 5))
          jitm.w32(code, n + 4, 0xF9400000 | (6 << 10) | (16 << 5) | 1)
          n += 5
          n = movabs(code, n, 17, jwr)
          jitm.w32(code, n, 0xD63F0000 | (17 << 5))
          n += 1
          n = movabs(code, n, 16, jsca)
          jitm.w32(code, n, 0xF100001F)
          jitm.w32(code, n + 1, 0x54000000 | (8 << 5) | 13)
          jitm.w32(code, n + 2, 0xF9400000 | (6 << 10) | (16 << 5) | 1)
          jitm.w32(code, n + 3, 0x8B000000 | (0 << 16) | (1 << 5) | 1)
          jitm.w32(code, n + 4, 0xF9000000 | (6 << 10) | (16 << 5) | 1)
          jitm.w32(code, n + 5, 0xF9400000 | (7 << 10) | (16 << 5) | 2)
          jitm.w32(code, n + 6, 0xCB000000 | (0 << 16) | (2 << 5) | 2)
          jitm.w32(code, n + 7, 0xF9000000 | (7 << 10) | (16 << 5) | 2)
          jitm.w32(code, n + 8, 0x14000000 | (-26 & 0x3FFFFFF))
          n += 9
          # epilogue: report the byte count and answer errno 0, which is what the
          # interpreter's arm answers too
          n = movabs(code, n, 16, jsca)
          jitm.w32(code, n, 0xF9400000 | (4 << 10) | (16 << 5))
          jitm.w32(code, n + 1, 0xF9400000 | (5 << 10) | (16 << 5) | 1)
          jitm.w32(code, n + 2, 0xB9000000 | (1 << 5))
          jitm.w32(code, n + 3, 0x2A1F03E0 | ia)
          n += 4
          if n - ib != 71
            return jitbail("host-call sequence is not the length its branch offsets assume", op, pc)
          isr: i64 = isp - 1
          while isr >= 0
            jitm.w32(code, n, 0xF84107E0 | mem.read_i64(jspr, isr * 8))
            n += 1
            isr -= 1
          sp -= 3
        elseif imk == wabi.i_proc_exit and imnp == 1 and imnr == 0 and sp >= 1 and jex != 0
          # proc_exit(code) TERMINATES, and it did not: `proc_exit` used to fall
          # into the zero-filling stub below, which emits NO instruction at all.
          # So under the jit the call was a no-op, everything after it still ran
          # and the guest's status was unobservable. Measured against a probe
          # that writes, calls `proc_exit(42)`, and writes again: interpreter and
          # wasmtime print once and exit 42, the jit printed TWICE and exited 0.
          # Same class as the three disagreements this arm was written beside,
          # and invisible in the corpus only because both wasi fixtures call
          # `proc_exit(0)` as their last instruction.
          #
          # THE STATUS IS NOT THE ARGUMENT. preview1 permits 0..125 and anything
          # above is exit 1 — measured in `wasm/wasi_abi.id`, boundary included —
          # so the clamp is emitted rather than passing the raw code through:
          #
          #   MOV  w17, w<code>     zero-extend the u32 argument
          #   CMP  w17, #PROC_EXIT_MAX
          #   MOV  w0, #1           the refused status
          #   CSEL w0, w17, w0, LS  unsigned <= max keeps the code
          #   BLR  x17 = exit
          #
          # STATED DIFFERENCE: the interpreter also writes one `wasm: ...` line
          # to stderr naming a refused code. Emitting a formatted decimal from
          # this template emitter is not worth its instruction budget, so the
          # jit exits with the identical status and says nothing. The status is
          # the observable; the line is engine chatter, and the harness strips
          # every `wasm: ` line from both arms before comparing.
          if wabi.PROC_EXIT_MAX < 0 or wabi.PROC_EXIT_MAX > 4095
            return jitbail("proc_exit ceiling is outside the CMP immediate", op, pc)
          jitm.w32(code, n, 0x2A0003E0 | ((sp - 1) << 16) | 17)
          n += 1
          jitm.w32(code, n, 0x7100001F | (wabi.PROC_EXIT_MAX << 10) | (17 << 5))
          n += 1
          jitm.w32(code, n, 0x52800000 | (1 << 5))
          n += 1
          jitm.w32(code, n, 0x1A800000 | (0 << 16) | (9 << 12) | (17 << 5))
          n += 1
          n = movabs(code, n, 17, jex)
          jitm.w32(code, n, 0xD63F0000 | (17 << 5))
          n += 1
          sp -= 1
        else
          # Every other import: consume the declared parameters and leave the
          # declared results as zero. Byte for byte the interpreter's stub, so a
          # module calling an import the engine cannot perform still runs, and runs the
          # same way on both engines.
          if imnp > sp
            return jitbail("imported call passes more arguments than are on the stack", op, pc)
          sp -= imnp
          imz: i64 = 0
          while imz < imnr
            if sp > 8
              return jitbail("operand stack shape", op, pc)
            jitm.w32(code, n, 0x2A1F03E0 | sp)
            n += 1
            sp += 1
            imz += 1
        last_alu = -1
        last_cset = -1

        else
        cnl: i64 = mem.read_i64(jft, (cfx * 6 + 2) * 8)
        cnp: i64 = mem.read_i64(jft, (cfx * 6 + 3) * 8)
        cnr: i64 = mem.read_i64(jft, (cfx * 6 + 5) * 8)
        clf: i64 = mem.read_i64(jft, (cfx * 6 + 4) * 8)
        # the callee's locals start above every enclosing frame's
        nlb2: i64 = lbase + curloc
        if cnp > sp or cnr > 1
          return jitbail("call passes more arguments than are on the stack, or returns more than one value", op, pc)
        # INLINE only a LEAF callee. Leafness is what makes this terminate: a
        # body containing no call cannot recurse, so the splice is always finite
        # and the depth cap is belt and braces. It used to inline non-leaves too,
        # and a recursive callee simply ran the cap out and then bailed the WHOLE
        # function to the interpreter. Everything else is a real call now, which
        # is both cheaper to compile and unbounded in what it can express.
        doinl: i64 = 0
        if clf == 1 and inl_d < 6 and nlb2 + cnp + cnl <= 17
          doinl = 1

        if doinl == 1
        # arguments move from the operand stack into the callee's params, which
        # are its locals 0..cnp-1 and therefore registers locreg(nlb2)..
        ck4: i64 = 0
        while ck4 < cnp
          jitm.w32(code, n, 0xAA0003E0 | ((sp - cnp + ck4) << 16) | locreg(nlb2 + ck4, cf))
          n += 1
          ck4 += 1
        # Wasm guarantees declared locals start at ZERO. Only the params were
        # being written, so the callee's remaining locals held whatever the
        # previous frame left in those registers: a loop counter came in at 2
        # instead of 0 and wart_simple_opcode_bench ran 9998 iterations, giving
        # 69986 instead of 70000.
        cz: i64 = cnp
        while cz < cnp + cnl
          jitm.w32(code, n, 0x2A1F03E0 | locreg(nlb2 + cz, cf))
          n += 1
          cz += 1
        sp -= cnp
        mem.write_i64(inl_pcs, inl_d * 8, pc)
        mem.write_i64(inl_offs, inl_d * 8, off)
        mem.write_i64(inl_bls, inl_d * 8, blen)
        mem.write_i64(inl_lbs, inl_d * 8, lbase)
        mem.write_i64(inl_lds, inl_d * 8, ldep)
        mem.write_i64(inl_lcs, inl_d * 8, curloc)
        inl_d += 1
        off = mem.read_i64(jft, (cfx * 6) * 8)
        blen = mem.read_i64(jft, (cfx * 6 + 1) * 8)
        lbase = nlb2
        curloc = cnp + cnl
        if nlb2 + cnp + cnl - 1 > hwm
          hwm = nlb2 + cnp + cnl - 1
        pc = 1
        last_alu = -1
        last_cset = -1

        else
        # ── REAL CALL ──────────────────────────────────────────────────────
        # AAPCS-shaped, with the two module-wide bases riding along: args in
        # x0..x7, result in x0, x27 = globals base, x28 = linear-memory base,
        # and the callee saves whatever of x19..x26 and x29/x30 it touches.
        #
        # Everything the caller holds in a CALLER-saved register has to survive
        # the BL by hand. That is the operand-stack slots below the arguments
        # (w0..w8 are the argument registers) plus any local that landed above
        # the callee-saved window. The local map is chosen so a body that calls
        # puts its first eight locals in x19..x26, which usually leaves this
        # spill list EMPTY # a recursive `fib` spills nothing at all.
        if jcn >= 1024 or cnp > 8
          return jitbail("call passes more than 8 arguments, or the call-patch table is full", op, pc)
        nsp: i64 = 0
        lv: i64 = 0
        while lv < lbase + curloc
          lr: i64 = locreg(lv, cf)
          if lr <= 17
            mem.write_i64(jspr, nsp * 8, lr)
            nsp += 1
          lv += 1
        ov: i64 = 0
        while ov < sp - cnp
          mem.write_i64(jspr, nsp * 8, ov)
          nsp += 1
          ov += 1
        if nsp > 64
          return jitbail("more than 64 registers to spill across a call", op, pc)
        spi: i64 = 0
        while spi < nsp
          jitm.w32(code, n, 0xF81F0FE0 | mem.read_i64(jspr, spi * 8))
          n += 1
          spi += 1
        # Arguments slide down to x0..x{cnp-1}. Ascending is safe: at step i the
        # destination is x{i} and every remaining source is x{sp-cnp+j} with
        # j > i, hence strictly above i.
        ag: i64 = 0
        while ag < cnp
          if sp - cnp + ag != ag
            jitm.w32(code, n, 0xAA0003E0 | ((sp - cnp + ag) << 16) | ag)
            n += 1
          ag += 1
        jitm.w32(code, n, 0x94000000)
        mem.write_i64(jcw, jcn * 8, n)
        mem.write_i64(jct, jcn * 8, cfx)
        jcn += 1
        n += 1
        # Move the result out of x0 BEFORE restoring, or the first pop lands on
        # top of it. Its slot is sp-cnp, which is never in the restored range
        # 0..sp-cnp-1.
        if cnr == 1 and sp - cnp != 0
          jitm.w32(code, n, 0xAA0003E0 | (0 << 16) | (sp - cnp))
          n += 1
        spj: i64 = nsp - 1
        while spj >= 0
          jitm.w32(code, n, 0xF84107E0 | mem.read_i64(jspr, spj * 8))
          n += 1
          spj -= 1
        # The call consumed cnp arguments and left cnr results, so the new depth
        # is `sp - cnp + cnr` # the slot the result was just moved into, plus
        # cnr.
        #
        # This said `sp -= cnp + cnr`, which SUBTRACTS the result instead of
        # adding it: TWO slots low after every non-inlined call that returns a
        # value. It survived because a body whose call is its last act reads x0
        # directly (`if sp > 0` is false at sp == -1, so the fallthrough move is
        # skipped and the callee's x0 is already the answer) — jit_nonleaf is
        # exactly that shape and passed. Anything that USES the result declines
        # (`operand stack shape`, which is why jit_nonleaf's sibling shapes were
        # all JIT-DECLINED), and when the stack is deep enough to absorb the
        # deficit it silently reads the WRONG REGISTERS: measured, a body that
        # pushes 1000/200/30/5, calls, adds and returns answered 1200 under the
        # jit against 46 from both the interpreter and wasmtime.
        #
        # Un-folded on purpose, for the reason given at `call_indirect`: the
        # compound spelling is the one that was wrong at both call sites.
        sp = sp - cnp + cnr
        # Queue the callee. A function is compiled once however many call it,
        # and the entry was queued before this loop began.
        if mem.read_i64(jqs, cfx * 8) == 0
          if jqn >= 256
            return jitbail("more than 256 functions queued for compilation", op, pc)
          mem.write_i64(jqs, cfx * 8, 1)
          mem.write_i64(jq, jqn * 8, cfx)
          jqn += 1
        last_alu = -1
        last_cset = -1
        end
        end

      elseif op == OP_call_indirect
        # ── call_indirect ──────────────────────────────────────────────────
        # The largest coverage gap left in this JIT: 10 of the 18 refusals
        # across both fixture corpora, and every wasi-libc `_start` that routes
        # a call through a function pointer.
        #
        # A direct `call` becomes a `BL` whose displacement is patched once the
        # callee has an address. Here the target is not a constant at all # it
        # is `table[i]`, chosen at run time # so there is nothing a
        # displacement could name. The shape is instead:
        #
        #   `jidt` (a DISPATCH TABLE, 16 bytes per slot: code address, then the
        #   callee's declared type index) is allocated BEFORE compiling, so its
        #   address is a constant this emitter can bake in. It is FILLED after
        #   the call-patch phase, which is the earliest point at which every
        #   body has an address. Emitted code loads the pair, checks it, and
        #   `BLR`s the address.
        #
        # Three checks, every one of them trapping, emitted inline with the condition
        # inverted to skip over the trap:
        #
        #   1. index >= table size            # wasm: trap
        #   2. slot type != the call site's   -- wasm: trap
        #   3. slot address == 0              # the callee was not compiled
        #
        # Check 2 is the one that must not be skipped. Without it a slot holding
        # a function of a DIFFERENT signature is entered with the wrong argument
        # shape and the wrong return width, and the result is a plausible wrong
        # number rather than a refusal # the exact failure mode this runtime
        # has spent the week removing. It compares type INDICES, which is exact
        # because a module's type section is deduplicated by construction, and
        # it is the same comparison the interpreter now makes.
        cti: i64 = uleb_val(s, off + pc, off + blen)
        pc = uleb_end(s, off + pc, off + blen) - off
        pc = uleb_end(s, off + pc, off + blen) - off     # tableidx, unused
        if cti < 0 or cti > 4095
          return jitbail("call_indirect type index above the CMP immediate", op, pc)
        if jtbz < 1
          return jitbail("call_indirect on a module with no table", op, pc)
        if jtbz > 65535
          return jitbail("table larger than one MOVZ immediate", op, pc)
        xnp: i64 = mem.read_i64(jtp, cti * 8)
        xnr: i64 = mem.read_i64(jtr, cti * 8)
        if sp < xnp + 1 or xnp > 8
          return jitbail("call_indirect passes more than 8 arguments, or the operand stack is short", op, pc)
        if jcn >= 1024
          return jitbail("the call-patch table is full", op, pc)
        # Queue every function the table can reach, ONCE, on the first
        # call_indirect in the module. Doing it up front would drag a module
        # that merely owns a table to the interpreter whenever some function
        # nothing dispatches to has an opcode with no arm.
        if jtbq == 0
          jtbq = 1
          xti: i64 = 0
          while xti < jtbz
            xfn: i64 = mem.read_i64(jtbl, xti * 8) - jimp
            if mem.read_i64(jtoc, xti * 8) == 1 and xfn < 0
              # An imported function reachable through the table would have to
              # be dispatched by field name at run time, which this emitter
              # cannot do. Decline the module rather than emit a branch that
              # would enter the wrong code.
              return jitbail("a table slot names an imported function", op, pc)
            if mem.read_i64(jtoc, xti * 8) == 1 and xfn >= 0 and xfn < jnf and mem.read_i64(jqs, xfn * 8) == 0
              if jqn >= 256
                return jitbail("more than 256 functions queued for compilation", op, pc)
              mem.write_i64(jqs, xfn * 8, 1)
              mem.write_i64(jq, jqn * 8, xfn)
              jqn += 1
            xti += 1
        # Spill everything caller-saved, exactly as the direct-call path does.
        # The operand slots below the ARGUMENTS are spilled; the index slot on
        # top (sp-1) is not, and must be read into scratch before the argument
        # slide overwrites x0..
        xsp: i64 = 0
        xlv: i64 = 0
        while xlv < lbase + curloc
          xlr: i64 = locreg(xlv, cf)
          if xlr <= 17
            mem.write_i64(jspr, xsp * 8, xlr)
            xsp += 1
          xlv += 1
        xov: i64 = 0
        while xov < sp - 1 - xnp
          mem.write_i64(jspr, xsp * 8, xov)
          xsp += 1
          xov += 1
        if xsp > 64
          return jitbail("more than 64 registers to spill across a call", op, pc)
        xsi: i64 = 0
        while xsi < xsp
          jitm.w32(code, n, 0xF81F0FE0 | mem.read_i64(jspr, xsi * 8))
          n += 1
          xsi += 1
        # The trap block is a fixed-length sequence, so every branch that skips
        # it is arithmetic rather than a patch. Same body as `unreachable`:
        # exit with the interpreter's trap status, or BRK if the host has no
        # `exit` symbol.
        xtl: i64 = 1
        if jex != 0
          xtl = 6
        # 1. index (u32, so a 32-bit MOV zero-extends it) against the table size
        jitm.w32(code, n, 0x2A0003E0 | ((sp - 1) << 16) | 17)
        n += 1
        jitm.w32(code, n, 0xD2800000 | (jtbz << 5) | 16)
        n += 1
        jitm.w32(code, n, 0xEB000000 | (16 << 16) | (17 << 5) | 31)
        n += 1
        jitm.w32(code, n, 0x54000000 | ((1 + xtl) << 5) | 3)          # B.LO
        n += 1
        n = jittrap(code, n, jex)
        # 2. address of the slot, then its declared type against this call site
        n = movabs(code, n, 16, jidta)
        jitm.w32(code, n, 0x8B000000 | (17 << 16) | (4 << 10) | (16 << 5) | 17)
        n += 1
        jitm.w32(code, n, 0xF9400000 | (1 << 10) | (17 << 5) | 16)
        n += 1
        jitm.w32(code, n, 0xF1000000 | (cti << 10) | (16 << 5) | 31)
        n += 1
        jitm.w32(code, n, 0x54000000 | ((1 + xtl) << 5) | 0)          # B.EQ
        n += 1
        n = jittrap(code, n, jex)
        # 3. the compiled address; zero means the slot names nothing this
        # compilation produced, which must trap rather than branch to 0
        jitm.w32(code, n, 0xF9400000 | (17 << 5) | 16)
        n += 1
        jitm.w32(code, n, 0xB5000000 | ((1 + xtl) << 5) | 16)         # CBNZ
        n += 1
        n = jittrap(code, n, jex)
        # Arguments slide down to x0..x{xnp-1}. Ascending is safe for the same
        # reason it is on the direct path: at step i the destination is x{i} and
        # every remaining source is strictly above it.
        xag: i64 = 0
        while xag < xnp
          if sp - 1 - xnp + xag != xag
            jitm.w32(code, n, 0xAA0003E0 | ((sp - 1 - xnp + xag) << 16) | xag)
            n += 1
          xag += 1
        jitm.w32(code, n, 0xD63F0000 | (16 << 5))                     # BLR x16
        n += 1
        # Result out of x0 before the restores, or the first pop lands on it.
        if xnr == 1 and sp - 1 - xnp != 0
          jitm.w32(code, n, 0xAA0003E0 | (0 << 16) | (sp - 1 - xnp))
          n += 1
        xsj: i64 = xsp - 1
        while xsj >= 0
          jitm.w32(code, n, 0xF84107E0 | mem.read_i64(jspr, xsj * 8))
          n += 1
          xsj -= 1
        # The call consumed the INDEX (1) and the ARGUMENTS (xnp) and left the
        # RESULTS (xnr), so the new depth is `sp - 1 - xnp + xnr` # which is
        # exactly the slot the result was just moved into, plus xnr.
        #
        # This said `sp -= 1 - xnp + xnr`, i.e. `sp - 1 + xnp - xnr`, which has
        # the sign of BOTH operand counts inverted. At xnp == 1, xnr == 1 the
        # two expressions coincide (1 - 1 + 1 == 1 + 1 - 1), so every one-
        # argument `call_indirect` was right and the arm looked correct; at
        # xnp == 2 it leaves sp TWO SLOTS HIGH and the value read back is the
        # table index that was never popped. `call_indirect_typed` answered 3 #
        # its second dispatch's index # instead of 1034562941.
        #
        # Written UN-FOLDED on purpose. `sp -= 1 + xnp - xnr` is the same
        # number and is the spelling that was wrong here, and wrong again at
        # the direct call below: folding the stack effect into one signed
        # constant hides which term is a pop and which is a push. This form
        # reads in the order the machine does it.
        sp = sp - 1 - xnp + xnr
        last_alu = -1
        last_cset = -1

      elseif op == OP_prefix_fc
        # 0xFC prefix, sub-opcode LEB. Only 0..3 # the i32 trunc_sat family #
        # have an arm, and they are one instruction each: ARM64's FCVTZS/FCVTZU
        # ARE saturating, with exactly wasm's NaN-to-zero and clamp-to-range
        # behaviour, so no range test is emitted at all. Every other sub-opcode
        # declines and the interpreter runs the body.
        fsub: i64 = s:byte(off + pc)
        pc += 1
        if fsub > 3 or sp < 1
          return jitbail("no jit arm for this 0xFC sub-opcode", op, pc)
        fsq: i64 = sp - 1
        if fsub <= 1
          jitm.w32(code, n, 0x1E270000 | (fsq << 5) | 1)
        else
          jitm.w32(code, n, 0x9E670000 | (fsq << 5) | 1)
        n += 1
        fcv: i64 = 0x1E780000
        if fsub == 0
          fcv = 0x1E380000
        elseif fsub == 1
          fcv = 0x1E390000
        elseif fsub == 3
          fcv = 0x1E790000
        jitm.w32(code, n, fcv | (1 << 5) | fsq)
        n += 1
        last_alu = -1
        last_cset = -1

      else
        return jitbail("no jit arm for this opcode", op, pc)

    if fcl >= 0
      jitm.w32(code, n, 0x9E660000 | (2 << 5) | fcl)
      n += 1
      fcl = -1

    # result in x0, then RET. This MOV must be 64-BIT: a 32-bit one truncates
    # every i64 and f64 return. It went unnoticed because the i64 regression
    # value happened to fit in 32 bits.
    if sp > 0
      jitm.w32(code, n, 0xAA0003E0 | ((sp - 1) << 16) | 0)
      n += 1
    # An early `return` moved its own result into x0 and branched HERE, past
    # the fallthrough move, because its operand-stack depth is its own.
    eprst: i64 = n

    # How many callee-saved pairs this body actually touched. `hwm` is the
    # highest local index reached, inlined callees included.
    need: i64 = 0
    if cf == 1
      need = hwm + 1
      if need > 8
        need = 8
    else
      need = hwm - 8
    if need < 0
      need = 0
    if need > 6
      jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (26 << 10) | (31 << 5) | 25)
      n += 1
    if need > 4
      jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (24 << 10) | (31 << 5) | 23)
      n += 1
    if need > 2
      jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (22 << 10) | (31 << 5) | 21)
      n += 1
    if need > 0
      jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (20 << 10) | (31 << 5) | 19)
      n += 1
    if cf == 1
      jitm.w32(code, n, 0xA8C00000 | (2 << 15) | (30 << 10) | (31 << 5) | 29)
      n += 1
    jitm.w32(code, n, 0xD65F03C0)
    n += 1

    # Fill the reserved prologue BACKWARDS from its last word, so the pushes
    # land in the exact reverse order of the pops above and the entry address
    # is the first word used. x30 is saved only when the body emits a BL #
    # a leaf body would otherwise pay a store and a load per invocation for a
    # link register nothing overwrites.
    pw: i64 = pstart + 5
    if need > 6
      pw -= 1
      jitm.w32(code, pw, 0xA9800000 | (0x7E << 15) | (26 << 10) | (31 << 5) | 25)
    if need > 4
      pw -= 1
      jitm.w32(code, pw, 0xA9800000 | (0x7E << 15) | (24 << 10) | (31 << 5) | 23)
    if need > 2
      pw -= 1
      jitm.w32(code, pw, 0xA9800000 | (0x7E << 15) | (22 << 10) | (31 << 5) | 21)
    if need > 0
      pw -= 1
      jitm.w32(code, pw, 0xA9800000 | (0x7E << 15) | (20 << 10) | (31 << 5) | 19)
    if cf == 1
      pw -= 1
      jitm.w32(code, pw, 0xA9800000 | (0x7E << 15) | (30 << 10) | (31 << 5) | 29)
    pnop: i64 = pstart
    while pnop < pw
      jitm.w32(code, pnop, 0xD503201F)
      pnop += 1
    mem.write_i64(jqa, curfn * 8, pw)

    prt: i64 = 0
    while prt < jrn
      rw: i64 = mem.read_i64(jrw, prt * 8)
      jitm.w32(code, rw, 0x14000000 | ((eprst - rw) & 0x03FFFFFF))
      prt += 1

  # Every body now has an address, so the BLs can be resolved. imm26 is a
  # SIGNED word displacement from the branch itself, which is why this cannot
  # happen at emit time for a forward or recursive target.
  jci: i64 = 0
  while jci < jcn
    cw: i64 = mem.read_i64(jcw, jci * 8)
    ct: i64 = mem.read_i64(jct, jci * 8)
    ca: i64 = mem.read_i64(jqa, ct * 8)
    if ca <= 0
      return jitbail("a queued callee was never compiled", -1, pc)
    jitm.w32(code, cw, 0x94000000 | ((ca - cw) & 0x03FFFFFF))
    jci += 1

  # ── fill the call_indirect dispatch table ────────────────────────────
  # This is the phase that could not be an emit-time fold: only now does
  # every body have an address. `jqa` holds a WORD offset into the code
  # buffer, so the absolute address is the buffer's base plus four times it.
  #
  # A slot no element segment initialised keeps address 0 and type -1, and the
  # emitted checks trap on both. So does a slot naming an imported function,
  # which the queue pass above has already declined the module over.
  if jtbq == 1
    jcba: i64 = jitm.addr(code)
    if jcba == 0
      return jitbail("the code buffer has no address to build a dispatch table from", -1, pc)
    jdi: i64 = 0
    while jdi < jtbz
      mem.write_i64(jidt, (jdi * 2 + 1) * 8, -1)
      if mem.read_i64(jtoc, jdi * 8) == 1
        jdf: i64 = mem.read_i64(jtbl, jdi * 8) - jimp
        if jdf >= 0 and jdf < jnf
          jda: i64 = mem.read_i64(jqa, jdf * 8)
          if jda <= 0
            # Unreachable by construction: every occupied slot was queued
            # above and every queued body writes `jqa`. Kept as a control #
            # a zero here would otherwise become a branch to address 0.
            return jitbail("a table-reachable function was never compiled", -1, pc)
          mem.write_i64(jidt, (jdi * 2) * 8, jcba + jda * 4)
          mem.write_i64(jidt, (jdi * 2 + 1) * 8, mem.read_i64(jfty, jdf * 8))
      jdi += 1
  # EXPLICIT `return`. As a bare tail expression `n` was emitted by the C
  # backend as a dead `n;` statement nested two blocks deep, followed by the
  # function's fallthrough `return 0` — so the emitted word COUNT never reached
  # the caller and `words` was whatever the boxed call left behind (measured:
  # 2847898621, which is an ARM64 instruction word, not a count). `engine_main`
  # then asked mprotect to publish 2.8 billion words, was refused, and fell
  # back to the interpreter without a word. Every other exit from this function
  # is already an explicit `return`; this was the one that was not.
  if env("DUO_WASM_JIT_TRACE")
    io.stderr:write("wasm: jit emitted " .. n:to(str) .. " words for " .. jqn:to(str) .. " bod(y/ies)\n")
  return n
end


# ── entry ────────────────────────────────────────────────────────────────
# Compiled binaries do not populate Lua's `arg`, so selection comes from the
# environment: DUO_WASM_MODULE picks the module, DUO_WASM_ENGINE=interp forces the
# architecture-independent path (used to check JIT/interpreter parity).
# No default module: a hardcoded fallback made every mis-invocation print a
# plausible result for a *different* module, which faked two whole benchmark
# sweeps. Absent DUO_WASM_MODULE is now an error, not a silent substitution.
# Wrapped in a function: a bare module tail makes
# can_emit_native_scalar_module reject the WHOLE file (native-diag reports
# "first fail: mod-tail"), and with native_scalar_mode=false every value
# transits a boxed lua_Value whose numeric payload is a DOUBLE. That is what
# rounded f64.const bit patterns above 2^53 and cost the low byte.
# Named `engine_main`, not `main`: a user function called `main` is DEFINED as
# `duo_entry_main__lua` by the C backend but CALLED as `main__lua`, so the
# translation unit does not link. Any other name mangles consistently.
engine_main = ()
  path = env("DUO_WASM_MODULE")
  invoke = env("DUO_WASM_INVOKE") or "run"
  # Every failure below goes to STDERR and exits nonzero. It used to `print`
  # to stdout and fall off the end of main, i.e. exit 0 # so a harness that
  # ran the engine on the wrong path got a clean exit status and no `result=` line,
  # and only noticed if it happened to be checking for one.
  if not path
    io.stderr:write("wasm: set DUO_WASM_MODULE=<module.wasm> (DUO_WASM_INVOKE=<export>, default \"run\")\n")
    io.stderr:write("      DUO_WASM_ARGS=<v1>,<v2>,... supplies the export's parameters;\n")
    io.stderr:write("      a value is decimal, or `#<hex>` for the raw 64-bit pattern.\n")
    io.stderr:write("      DUO_WASM_ENGINE=interp forces the interpreter; =jit REQUIRES the jit\n")
    io.stderr:write("      and refuses (exit 4) if it cannot run. DUO_WASM_JIT_TRACE=1 names every refusal.\n")
    os.exit(1)
  force_interp: i64 = 0
  # `or ""` per the note on `grant_errno_mode`: `env(k) == "<literal>"` on an
  # unset key exits 139. Do not remove it.
  if (env("DUO_WASM_ENGINE") or "") == "interp"
    force_interp = 1
  # DUO_WASM_ENGINE=jit is a REQUIREMENT, not a preference. It used to be
  # ignored entirely — only "interp" was tested — so `DUO_WASM_ENGINE=jit
  # duo run bench/verify.id`, the documented way to check the two engines
  # against each other, ran the INTERPRETER TWICE and reported perfect
  # agreement. A differential whose two arms are the same program cannot fail,
  # and that is what has been hiding a JIT that never ran. Asking for the jit
  # and not getting it is now a refusal that names its reason.
  require_jit: i64 = 0
  # `or ""` per the note on `grant_errno_mode`: `env(k) == "<literal>"` on an
  # unset key exits 139. Do not remove it.
  if (env("DUO_WASM_ENGINE") or "") == "jit"
    require_jit = 1

  f = io.open(path, "rb")
  if not f
    io.stderr:write("wasm: cannot open " .. path .. "\n")
    os.exit(1)
  tRD0 = os.clock()
  # `bytes` MUST carry the `str` annotation. On an UNTYPED local holding a
  # string, `x:len()` lowers to the string-BUFFER length accessor and answers
  # 0 (and `x:byte(i)` lowers to a boxed value the C backend cannot compare
  # against an integer), so the magic check below read `0 < 8` and refused
  # every well-formed module. Measured: an untyped local answers 0 for a
  # 297-byte string where the same value bound to a `str` local answers 297.
  raw = f:read("*a")
  bytes: str = raw
  # LENGTH IS TAKEN FROM THE UNTYPED BINDING ON PURPOSE. A `str`-ANNOTATED
  # local lowers to a NUL-terminated C string, so BOTH `bytes:len()` and
  # `nbytes` answer 0 for a wasm image (its first byte is 0x00) —
  # measured: 0 against 138 for the same 138-byte module. The same value read
  # through the UNTYPED binding answers 138. Indexing (`bytes:byte(i)`) is
  # correct on the typed local and mis-typed on the untyped one, so each
  # binding is used for exactly the operation it gets right.
  nbytes: i64 = string.len(raw)
  f:close()
  tRD1 = os.clock()

  # HEADER CHECK. Every walker in this file starts at byte 9, i.e. it ASSUMED
  # the 8-byte header rather than reading it, so the engine would run a file whose
  # magic number had been overwritten and print a confident answer for it.
  # `test/conform.id` perturbs byte 4 of a fixture and requires a refusal;
  # without this the perturbation is invisible, and a control that cannot fail
  # is not evidence.
  if nbytes < 8 or bytes:byte(1) != 0 or bytes:byte(2) != 97 or bytes:byte(3) != 115 or bytes:byte(4) != 109
    io.stderr:write("wasm: " .. path .. " is not a wasm module (bad magic)\n")
    os.exit(1)
  if bytes:byte(5) != 1 or bytes:byte(6) != 0 or bytes:byte(7) != 0 or bytes:byte(8) != 0
    io.stderr:write("wasm: " .. path .. " is not wasm version 1\n")
    os.exit(1)

  packed: i64 = find_run_body(bytes, nbytes, invoke, string.len(invoke), 0)
  tRD2 = os.clock()
  tgt: i64 = find_run_body(bytes, nbytes, invoke, string.len(invoke), 1)
  tRD3 = os.clock()
  if env("DUO_WASM_PHASES")
    print("phase read=" .. to(str)(tRD1 - tRD0) .. " walk0=" .. to(str)(tRD2 - tRD1) .. " walk1=" .. to(str)(tRD3 - tRD2))
  boff: i64 = packed // 65536
  blen: i64 = packed - boff * 65536

  # The decoder is a minimal section walker; on a module shape it does not
  # handle it can desync. Validate before anything indexes the image, so a
  # desync is a clean diagnostic rather than an out-of-bounds read.
  if blen <= 0 or boff < 0 or boff + blen > nbytes
    io.stderr:write("wasm: could not locate an exported `" .. invoke .. "` body in " .. path .. "\n")
    io.stderr:write("      (decoded offset=" .. boff:to(str) .. " len=" .. blen:to(str) .. " of " .. to(str)(nbytes) .. " bytes)\n")
    os.exit(1)

  engine = "interp"
  result: i64 = 0
  t0 = os.clock()

  # Why the jit is or is not eligible, decided ONCE and stated. See
  # `jit_is_arm64` / `jit_substrate_gap` above for what each half is, and why
  # the old single `jitm.arch() == "arm64"` test could neither pass nor
  # explain itself.
  jit_ok: i64 = 0
  jit_why: str = ""
  if force_interp == 1
    jit_why = "DUO_WASM_ENGINE=interp"
  elseif require_jit == 0
    # ── THE JIT IS OFF BY DEFAULT, AND HERE IS THE MEASUREMENT THAT DECIDED IT ─
    #
    # 2026-08-14. The ARM64 emitter in this file executed for the first time,
    # and `test/conform.id` — 65 (module, entry) pairs, both columns live, every
    # row's `RAN` recorded, differenced against wasmtime BY VALUE — reported
    # COMPILED 36, DECLINED 29, AGREE 33, DIFFER 3. All three were WRONG
    # ANSWERS: `call_indirect_typed` answered 3 for 1034562941, and the two wasi
    # `_start` bodies printed NOTHING where the interpreter printed their line.
    #
    # 2026-08-15. FIVE faults, not three, all in the emitter's operand-stack
    # arithmetic and its import dispatch, every one of them a plausible number
    # and exit 0:
    #
    #   1. `call_indirect`, 2+ args   sp adjusted by `1 - xnp + xnr`, which
    #                                 inverts the sign of both counts. Correct
    #                                 at ONE argument by coincidence, so the arm
    #                                 looked right. -> call_indirect_typed = 3.
    #   2. `fd_write` dispatch        tested `imk == 1` against a slot that had
    #                                 become the preview1 ROSTER INDEX; 1 is
    #                                 `args_get`. Every fd_write took the
    #                                 zero-filling stub. -> both wasi fixtures
    #                                 printed nothing.
    #   3. `proc_exit`                took the same stub, which emits NO
    #                                 instruction: a no-op. Measured against a
    #                                 probe that writes, exits 42 and writes
    #                                 again — interpreter and wasmtime print
    #                                 once and exit 42; the jit printed TWICE
    #                                 and exited 0.
    #   4. non-inlined `call`         sp adjusted by `cnp + cnr`, SUBTRACTING
    #                                 the result: two slots low after every real
    #                                 call that returns a value. Hidden because a
    #                                 body whose call is its last act reads x0
    #                                 anyway, and a shallow stack merely
    #                                 DECLINES. On a deep enough stack it reads
    #                                 the wrong registers: 1200 for 46.
    #   5. (consequence of 4)         29 DECLINED bodies were mostly this bug
    #                                 refusing itself. Fixing it took DECLINED
    #                                 29 -> 14 and COMPILED 36 -> 51.
    #
    # 3 AND 4 WERE NOT IN THE CORPUS. They were found by hand-writing the shapes
    # the corpus lacked, AFTER the corpus had already gone green — that is, the
    # criterion the previous version of this comment set ("delete this arm when
    # the differential reads DIFFER 0") was satisfied at a moment when the
    # emitter was still answering 1200 for 46. That is the fact this decision
    # turns on: DIFFER 0 is a statement about a SAMPLE, and this sample has been
    # wrong about this exact question three times in two days.
    #
    # So the sample was fixed, not just the emitter. 21 fixtures were added:
    # three targeted (`bench/jit_indirect2`, `jit_call_result`, `jit_proc_exit`)
    # and an 18-point GRID over the axis all of 1..4 lie on — call arity x
    # operand-stack depth beneath the call x call kind (inlined leaf / real
    # non-leaf / indirect) x result arity. Every one is NEGATIVE-CONTROLLED:
    # rebuilt against the pre-fix emitter, the three targeted fixtures answer
    # 21, 1200 and nothing, and 7 of the 18 grid points answer wrongly. The same
    # grid generator at full size (150 points, arity 0..4 x depth 0..4 x 3 kinds
    # x 2 result arities) finds 21 wrong answers on the pre-fix emitter and ZERO
    # on this one, with the interpreter correct on all 150 in both runs.
    #
    # TODAY'S RUN, 86 pairs x 3 columns:
    #
    #   rows 244  PASS 238  DIFF 0  UNSUPPORTED 0  BAIL 0  NORESULT 0
    #   jit asked 86, COMPILED 69, DECLINED 14, AGREE 72, DIFFER 0
    #   default path: interp=83 (this arm), interp-vs-default DIFFER 0
    #
    # ...and with this arm temporarily removed, MEASURED, not predicted:
    #
    #   default path: jit-arm64=69, interp=14 (the silent fallback, working),
    #   interp-vs-default AGREE 86, DIFFER 0
    #
    # SO WHY IS IT STILL OFF. Because the grid covers the CALL axis, which is
    # now the best-tested thing in this emitter — and every other axis is still
    # at exactly the coverage level that let this morning's five faults through:
    # one purpose-built fixture per family for memory widths and offsets,
    # br_table, globals, float compare/convert, select. The axis that was swept
    # is clean; the axes that were not are unmeasured, and the emitter they
    # belong to was returning plausible wrong numbers eight hours ago. The cost
    # of keeping this arm is speed on a path anyone can opt into with one
    # environment variable. The cost of removing it wrongly is a WASM runtime
    # that answers 1200 for 46 and exits 0.
    #
    # WHAT LICENSES DELETING IT — and the first two conditions ALREADY HOLD, so
    # this is a short list, not a wall:
    #
    #   1. `zig build wasm-test` prints DIFFER 0 in BOTH cross-checks.  HOLDS.
    #   2. With this arm deleted, the same run prints `default path:
    #      jit-arm64=<n>` with n equal to the COMPILED count.            HOLDS.
    #   3. The corpus sweeps memory (width x offset x alignment), br_table
    #      (arity x default), globals, and the float compare/convert families
    #      the same way `bench/jit_grid_*` sweeps calls, and that grid is
    #      negative-controlled against a deliberately broken emitter.  DOES NOT
    #      HOLD — nothing sweeps those axes.
    #
    # `DUO_WASM_ENGINE=jit` still compiles, still refuses (exit 4) rather than
    # answering under the interpreter's name, and is what `test/conform.id`
    # drives.
    jit_why = "the jit is gated off by default (5 wrong-answer faults were fixed in it on 2026-08-15 and 2 of the 5 were outside the differential corpus -- ask for it with DUO_WASM_ENGINE=jit)"
  elseif wabi.grant_is_total(grant_spec()) == 0
    # A PARTIAL GRANT DECLINES THE JIT, by name, rather than being enforced
    # twice in two emitters.
    #
    # The emitted import sequence dispatches on the roster index and calls the
    # host directly; there is no point in it at which a per-import denial could
    # be observed, and adding one would mean a second copy of the policy inside
    # ~1,700 lines of ARM64 emission whose last five faults were all in exactly
    # that code. A capability enforced in two places that can disagree is worse
    # than one enforced in the slower place: the interpreter answers, and it
    # answers the same on every host.
    #
    # This arm is UNREACHABLE under the default grant (`all` is total), so it
    # cannot move the differential — verified, DIFF 0 unchanged, and the
    # `jit COMPILED` count is unchanged too.
    jit_why = "DUO_WASM_GRANT is not total, and a partial grant is enforced only by the interpreter"
  elseif env("DUO_WASM_ARGS") != nil
    # THE JIT HAS NO ARGUMENT CHANNEL. `jitm.call2(code, memory, globals)`
    # passes linear memory and the globals block and nothing else, so a
    # compiled body would read its parameters as whatever the emitted prologue
    # left in those registers. The interpreter seeds them from DUO_WASM_ARGS.
    # Until the emitted entry sequence takes operands too, a module invoked
    # WITH arguments must not be compiled: a jit that runs and answers the
    # wrong question is worse than an interpreter that answers the right one
    # slowly, and this is the exact shape that failure would take.
    jit_why = "DUO_WASM_ARGS is set and the emitted entry sequence takes no operands"
  elseif jit_is_arm64() == 0
    jit_why = "the host is not arm64 (jit.arch = " .. jit_arch_name() .. ")"
  else
    # ONE call. The self-test maps, writes, seals and ENTERS a page, so calling
    # it twice (once for the test, once to build the message) would pay for it
    # twice on the failing path.
    jit_gap: str = jit_substrate_gap()
    if jit_gap != ""
      jit_why = "the jit substrate does not work: " .. jit_gap
    else
      jit_ok = 1
  if jit_ok == 0
    jitbail(jit_why, -1, 0)
    if require_jit == 1
      io.stderr:write("wasm: DUO_WASM_ENGINE=jit was requested and the jit cannot run: " .. jit_why .. "\n")
      io.stderr:write("      refusing rather than running the interpreter under the jit's name -- a differential whose two arms are the same engine cannot fail\n")
      os.exit(4)

  if jit_ok == 1
    tJ0 = os.clock()
    code = jitm.alloc(1 << 20)
    tJ1 = os.clock()
    if code
      # `raw`, NOT `bytes`, AND THE DIFFERENCE IS THE WHOLE MODULE.
      #
      # `jit_compile` takes the code buffer as an `any` parameter, and one
      # non-scalar parameter is enough to make this toolchain route the call
      # through `lua_invoke` instead of calling the C function directly. The
      # boxing step is `lua_val_from_str(bytes)`, and `lua_val_from_str` sizes
      # its argument with `strlen` — so a wasm image, whose FIRST BYTE IS 0x00,
      # arrives at the callee as the EMPTY STRING. Measured: inside
      # `jit_compile`, `s:byte(9)` answered 0 for a 70-byte module, the section
      # walk found no code section, and every module in both corpora declined
      # with "entry body is not in the code section" — the JIT's first act on
      # being switched on for the first time was to read a module that was not
      # there. Nothing said so; a truncated string has no error.
      #
      # `raw` is the UNTYPED binding `f:read("*a")` returned. It is already a
      # length-carrying string value, so boxing it is the identity and the
      # callee sees all `nbytes`. `bytes` is the same value re-annotated `str`,
      # which is correct for `:byte()` here and fatal across a boxed call.
      # `nbytes` is taken off `raw` for the mirror-image reason, ~60 lines up.
      # Verified by value: `s:byte(9)`/`s:byte(10)` answer 1/5 through `raw`
      # and 0/0 through `bytes`.
      #
      # `find_run_body` and `run_body` are handed `bytes` and are correct: their
      # parameters are all native scalars, so those calls are direct and no
      # re-interning happens. The trap is the boxed call, not the annotation.
      words: i64 = jit_compile(raw, boff, blen, code, nbytes)
      # DUO_WASM_DUMP=<path>: write the emitted words as hex, one per line, for
      # disassembly. Diagnostic only; off unless the env var is set.
      dmp = env("DUO_WASM_DUMP")
      if dmp
        df = io.open(dmp, "w")
        if df
          dw: i64 = 0
          while dw < words
            df:write(to(str)(jitm.r32(code, dw)) .. "\n")
            dw += 1
          df:close()
        print("jit_words=" .. words:to(str))
      tJ2 = os.clock()
      if env("DUO_WASM_PHASES")
        print("phase alloc=" .. to(str)(tJ1 - tJ0) .. " compile=" .. to(str)(tJ2 - tJ1))
      # SEALING IS A REFUSAL SITE TOO. `words <= 0` is a decline the emitter has
      # already explained on stderr; a failed `seal` is the host refusing to
      # publish code that WAS emitted, and it used to be indistinguishable from
      # the first — both fell through to `engine=interp` with nothing written.
      jseal: i64 = 0
      if words > 0
        if jitm.seal(code, words * 4)
          jseal = 1
        else
          jitbail("mprotect refused to publish " .. words:to(str) .. " emitted words", -1, 0)
      if jseal == 1
        engine = "jit-arm64"
        # Mask to 32 bits ONLY for an i32 result. The unconditional mask here
        # truncated every i64 and f64 the JIT returned (an f64 3.5+1.25 chain
        # came back as 0), and it was invisible while the JIT could only
        # compile i32 bodies.
        rt0: i64 = find_run_body(bytes, nbytes, invoke, string.len(invoke), 2)
        # LINEAR MEMORY for compiled code. Two things used to be wrong here and
        # they compounded: the buffer was a hardcoded 65536 bytes regardless of
        # the module's declared page count, and it was never seeded from the
        # data segments. The second was "fixed" by making every load and store
        # REFUSE when a data section was present, which is why every wasi-libc
        # `_start` in the corpus ran on the interpreter — the refusal fired on
        # the first `i32.load`, eight bytes into the body, and said nothing.
        # Emitted loads carry no bounds check, so under-allocating here is heap
        # corruption, not a wrong answer: size from the memory section.
        jpg: i64 = 1
        jdb: i64 = 0
        jmx: i64 = 9
        while jmx <= nbytes
          jmd: i64 = bytes:byte(jmx)
          jmx += 1
          jmz: i64 = uleb_val(bytes, jmx, nbytes)
          jmx = uleb_end(bytes, jmx, nbytes)
          if jmd == 5
            jmn: i64 = uleb_val(bytes, jmx, nbytes)
            jmq: i64 = uleb_end(bytes, jmx, nbytes)
            if jmn > 0
              jmq += 1
              jpg = uleb_val(bytes, jmq, nbytes)
              if jpg < 1
                jpg = 1
          elseif jmd == 11
            jdb = jmx
          jmx += jmz
        # Same refusal as `run_body`: emitted loads carry no bounds check, so
        # quietly shrinking an absurd declared minimum here would be heap
        # corruption rather than a wrong answer.
        if jpg > 4096
          io.stderr:write("wasm: declared linear memory above 4096 pages\n")
          os.exit(1)
        jlinsz: i64 = jpg * 65536
        jlin = mem.alloc(jlinsz)
        mem.zero(jlin, jlinsz)
        # Active data segments, exactly as `run_body` seeds `lin`. A PASSIVE
        # segment (mode 1) carries no offset and must NOT be copied now; the
        # `memory.init` that would place it has no jit arm and bails anyway.
        if jdb > 0
          jdn: i64 = uleb_val(bytes, jdb, nbytes)
          jdq: i64 = uleb_end(bytes, jdb, nbytes)
          jdv: i64 = 0
          while jdv < jdn and jdq <= nbytes
            jdm: i64 = uleb_val(bytes, jdq, nbytes)
            jdq = uleb_end(bytes, jdq, nbytes)
            jdo: i64 = 0
            if jdm == 2
              jdq = uleb_end(bytes, jdq, nbytes)
            if jdm != 1
              jdq += 1
              jdo = uleb_val(bytes, jdq, nbytes)
              jdq = uleb_end(bytes, jdq, nbytes) + 1
            jdl: i64 = uleb_val(bytes, jdq, nbytes)
            jdq = uleb_end(bytes, jdq, nbytes)
            if jdm != 1
              jdk: i64 = 0
              while jdk < jdl and jdo + jdk < jlinsz
                mem.write_byte(jlin, jdo + jdk, bytes:byte(jdq + jdk))
                jdk += 1
            jdq += jdl
            jdv += 1
        jgl = mem.alloc(4096 * 8)
        mem.zero(jgl, 4096 * 8)
        # Seed globals from the module's OWN section 6, mirroring `run_body`,
        # so the JIT no longer has to refuse non-zero initialisers. Without a
        # global section, assume wasi-libc and give global 0 a usable shadow
        # stack pointer # the same default the interpreter uses.
        jgb: i64 = 0
        jsx: i64 = 9
        while jsx <= nbytes
          jsd: i64 = bytes:byte(jsx)
          jsx += 1
          jsz: i64 = uleb_val(bytes, jsx, nbytes)
          jsx = uleb_end(bytes, jsx, nbytes)
          if jsd == 6
            jgb = jsx
          jsx += jsz
        if jgb > 0
          ngj: i64 = uleb_val(bytes, jgb, nbytes)
          gqj: i64 = uleb_end(bytes, jgb, nbytes)
          gvj: i64 = 0
          while gvj < ngj and gqj <= nbytes and gvj < 4096
            gqj += 2
            iopj: i64 = bytes:byte(gqj)
            gqj += 1
            gvalj: i64 = 0
            if iopj == 65 or iopj == 66
              gvalj = uleb_val(bytes, gqj, nbytes)
              gqj = uleb_end(bytes, gqj, nbytes)
            elseif iopj == 67
              gqj += 4
            elseif iopj == 68
              gqj += 8
            gqj += 1
            mem.write_i64(jgl, gvj * 8, gvalj)
            gvj += 1
        else
          mem.write_i64(jgl, 0, 65536)
        result = jitm.call2(code, mem.addr(jlin), mem.addr(jgl))
        if rt0 == 0x7F
          result = result & M32

  # The jit was eligible but declined THIS body (an opcode it cannot emit, a
  # register budget, an imported call). That is legal and the interpreter runs
  # it — but under DUO_WASM_ENGINE=jit it is still not the jit, so the run is
  # refused rather than reported as a jit run. `DUO_WASM_JIT_TRACE=1` names the
  # opcode and body offset.
  if engine == "interp" and require_jit == 1 and jit_ok == 1
    io.stderr:write("wasm: DUO_WASM_ENGINE=jit was requested and the jit declined this body\n")
    io.stderr:write("      set DUO_WASM_JIT_TRACE=1 for the opcode and body offset\n")
    os.exit(4)

  if engine == "interp"
    result = run_body(bytes, nbytes, tgt, 0)

  t1 = os.clock()
  print("engine=" .. engine)

  # Format by the function's declared RESULT TYPE. `result` carries raw bits, so
  # an f64 has to be bitcast back before printing; an i32 has to be folded to
  # unsigned 32-bit (the JIT path already masks, the interpreter no longer does).
  rtype: i64 = find_run_body(bytes, nbytes, invoke, string.len(invoke), 2)
  if rtype == 0x7C
    rbuf = mem.alloc(16)
    mem.write_i64(rbuf, 0, result)
    # Bind to a typed local FIRST. `to(str)(mem.load(f64)(buf))` inline in a
    # concat loses low mantissa bits (f64.const 1.0001 printed as
    # 1.0000999999999749); the same load bound to an f64 local is exact.
    rf: f64 = mem.load(f64)(rbuf)
    print("result=" .. rf:to(str))
    mem.free(rbuf)
  elseif rtype == 0x7D
    rbuf2 = mem.alloc(16)
    mem.write_i64(rbuf2, 0, result)
    rf2: f32 = mem.load(f32)(rbuf2)
    print("result=" .. rf2:to(str))
    mem.free(rbuf2)
  elseif rtype == 0x7E
    print("result=" .. result:to(str))
  else
    # i32 arms already mask their own results, so the slot is already a correct
    # unsigned 32-bit value; masking again here only forces a boxed lua_band.
    print("result=" .. result:to(str))
  print("seconds=" .. to(str)(t1 - t0))

engine_main()
