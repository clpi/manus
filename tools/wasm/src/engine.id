M32 = 0xFFFFFFFF


# ── Minimal WASM module decoder (pure Duo) ───────────────────────────────
# Operates on the immutable module image as text and returns byte offsets. This
# shape remains useful independently of pointer transport.

# unsigned LEB128 at 1-based offset `i`. Two scanning helpers instead of an
# out-parameter: mem.* cannot take an `any`-typed buffer param, and decoding
# is one-time (not on the hot path), so scanning twice costs nothing.
uleb_val: i64 = (s: str, i: i64, n: i64)
  v: i64 = 0
  sh: i64 = 0
  p: i64 = i
  cont: i64 = 1

  while cont == 1 and p <= n
    b: i64 = s:byte(p)
    p += 1
    v |= ((b & 0x7F) << sh)
    sh += 7
    if b < 0x80
      cont = 0
  v

uleb_end: i64 = (s: str, i: i64, n: i64)
  p: i64 = i
  cont: i64 = 1

  while cont == 1 and p <= n
    b: i64 = s:byte(p)
    p += 1
    if b < 0x80
      cont = 0
  p

# Locate the body of the function exported as `run` (falls back to the
# largest body). Returns offset packed as off * 65536 + len. `which` selects
# what the walk reports: 0 = the packed body offset/len the JIT path wants,
# 1 = the function index the interpreter wants.
find_run_body: i64 = (s: str, n: i64, want: str, wlen: i64, which: i64)
  i: i64 = 9                       # skip 8-byte header (1-based)
  code_off: i64 = 0
  code_len: i64 = 0
  exp_off: i64 = 0
  typ_off: i64 = 0
  fun_off: i64 = 0
  nimp: i64 = 0
  while i <= n
    sid: i64 = s:byte(i)
    i += 1
    sz: i64 = uleb_val(s, i, n)

    i = uleb_end(s, i, n)
    if sid == 10
      code_off = i
      code_len = sz
    elseif sid == 7
      exp_off = i
    elseif sid == 1
      typ_off = i
    elseif sid == 3
      fun_off = i
    elseif sid == 2
      cnt: i64 = uleb_val(s, i, n)
      j: i64 = uleb_end(s, i, n)
      k: i64 = 0
      while k < cnt and j <= n
        l1: i64 = uleb_val(s, j, n)

        j = uleb_end(s, j, n) + l1
        l2: i64 = uleb_val(s, j, n)

        j = uleb_end(s, j, n) + l2
        kind: i64 = s:byte(j)
        j += 1
        if kind == 0
          nimp += 1
          _d: i64 = uleb_val(s, j, n)

          j = uleb_end(s, j, n)
        elseif kind == 1
          j += 1
          fl: i64 = s:byte(j)
          j += 1
          _a: i64 = uleb_val(s, j, n)

          j = uleb_end(s, j, n)
          if fl == 1
            _b: i64 = uleb_val(s, j, n)

            j = uleb_end(s, j, n)
        else
          j += 2
        k += 1
    i += sz

  # export section: find the export named `want` (DUO_WASM_INVOKE, default "run")
  target: i64 = -1
  if exp_off > 0
    cnt2: i64 = uleb_val(s, exp_off, n)
    q: i64 = uleb_end(s, exp_off, n)
    e: i64 = 0
    while e < cnt2 and q <= n
      ln: i64 = uleb_val(s, q, n)

      q = uleb_end(s, q, n)
      is_run: i64 = 0
      if ln == wlen
        is_run = 1
        m: i64 = 0
        while m < wlen
          if s:byte(q + m) != want:byte(m + 1)
            is_run = 0
          m += 1
      q += ln
      kind2: i64 = s:byte(q)
      q += 1
      idx2: i64 = uleb_val(s, q, n)

      q = uleb_end(s, q, n)
      if is_run == 1 and kind2 == 0
        target = idx2 - nimp
      e += 1

  if which == 1
    return target

  # which == 2: the RESULT value type of the target function (0 = void,
  # 0x7F i32, 0x7E i64, 0x7D f32, 0x7C f64). The entry needs it because a
  # result is returned as raw bits and an f64 must not be printed as an int.
  if which == 2
    if target < 0 or fun_off <= 0 or typ_off <= 0
      return 0
    fq2: i64 = uleb_end(s, fun_off, n)
    tix: i64 = -1
    fz: i64 = 0
    while fz <= target and fq2 <= n
      if fz == target
        tix = uleb_val(s, fq2, n)
      fq2 = uleb_end(s, fq2, n)
      fz += 1
    if tix < 0
      return 0
    ntv2: i64 = uleb_val(s, typ_off, n)
    tq2: i64 = uleb_end(s, typ_off, n)
    tz: i64 = 0
    rty: i64 = 0
    while tz < ntv2 and tq2 <= n
      tq2 += 1                        # 0x60 form byte
      np2: i64 = uleb_val(s, tq2, n)
      tq2 = uleb_end(s, tq2, n) + np2
      nr2: i64 = uleb_val(s, tq2, n)
      tq2 = uleb_end(s, tq2, n)
      if tz == tix and nr2 >= 1
        rty = s:byte(tq2)
      tq2 += nr2
      tz += 1
    return rty

  # code section: walk to the target body, skip its locals prefix
  best_off: i64 = 0
  best_len: i64 = 0
  nfn: i64 = uleb_val(s, code_off, n)
  p2: i64 = uleb_end(s, code_off, n)
  fi: i64 = 0
  while fi < nfn and p2 <= n
    bsz: i64 = uleb_val(s, p2, n)
    bstart: i64 = uleb_end(s, p2, n)
    # Only ever run the body the export actually names. The old "largest body"
    # fallback made a module with no matching export execute an arbitrary
    # function and report a plausible number (wart_core_i32_compute burned
    # 0.127 s on garbage that way). No match must be a clean diagnostic.
    take: i64 = 0
    if target >= 0 and fi == target
      take = 1
    if take == 1
      nl: i64 = uleb_val(s, bstart, n)
      r2: i64 = uleb_end(s, bstart, n)
      g: i64 = 0
      while g < nl
        _c: i64 = uleb_val(s, r2, n)

        r2 = uleb_end(s, r2, n) + 1
        g += 1
      best_off = r2 - 1
      best_len = bsz - (r2 - bstart)
    p2 = bstart + bsz
    fi += 1
  best_off * 65536 + best_len


# ── THE BAIL CONTRACT ────────────────────────────────────────────────────
# A refusal to execute must not look like a result.
#
# `run_body` used to answer -1 for every opcode it could not execute, `main`
# printed `result=-1`, and the process EXITED 0. The source comment claimed the
# opcode was named on stderr; that diagnostic was never written, and there was
# no stderr surface in the Duo stdlib to write it with. So the only thing
# separating "the engine computed this" from "the engine gave up" was a caller remembering
# to grep stdout for a sentinel # and -1 is a perfectly legal i64 result, so
# even that grep is wrong. bench/fib.wasm at fib(34) reaches this today.
#
# -1 cannot be made unambiguous in band. Pointer transport and fixed ordered GP
# result packs are no longer blockers; the missing fact is the outcome
# alternative that correlates a value pack with an error/trap pack. Until that
# crosses applications, the bail ends the process at the detecting site, where
# the opcode and body offset are in scope.
#
# The contract, at the process boundary:
#   exit 0   a result was computed; stdout carries `result=<v>`
#   exit 1   usage, or the module could not be read or decoded
#   exit 70  the engine met an opcode or a shape it cannot execute
#   exit 71  the module itself trapped (`unreachable`)
# Every nonzero exit writes one line to STDERR naming why. Nothing is printed
# to stdout on a failure, so `result=` on stdout now means a result.
#
# Three helpers, not one, because the three are not the same claim and a
# diagnostic that guesses is worse than none. The first version of this said
# "unimplemented opcode 3" for fib(34) # and opcode 3 is `loop`, which IS
# implemented; what actually happened was the shared label stack hitting its
# 63-entry ceiling at recursion depth 34. Naming the wrong cause would have
# sent the next reader to write an arm that already exists.

# opcode -> canonical wasm text name, for the bail diagnostics only. Off every
# hot path: a linear scan is reached exactly once, immediately before exit.
#
# This is what turns a corpus sweep into a ranked worklist. `unimplemented
# opcode 158` sends the reader to a table; `unimplemented opcode 158
# (f64.nearest)` names the arm to write, and f64.nearest is precisely the gap
# that cost this project a session when it presented as `result=nan`.
# derived(wasm.opcodes.names) begin # regenerate: duo run tools/opcodes.id
OP_NAMES = {
  {0,    "unreachable"},
  {1,    "nop"},
  {2,    "block"},
