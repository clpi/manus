          pk2: i64 = mem.read_i64(lpn, lt * 8)
          if pk2 >= 8
            return jitbail("more than 8 forward branches to one label", op, pc)
          if last_cset == n - 1
            n -= 1
            last_cset = -1
            jitm.w32(code, n, 0x54000000 | last_cc)
          else
            jitm.w32(code, n, 0x35000000 | sp)
          mem.write_i64(lpat, (lt * 8 + pk2) * 8, n * 2)
          mem.write_i64(lpn, lt * 8, pk2 + 1)
