# Prove the jit substrate: emit ARM64 `MOVZ W0,#42; RET`, seal, call.

emit42: i64 = (unused: i64)
  buf = jit.alloc(4096)
  if not buf
    print("jit: mmap refused")
    return -1
  # MOVZ W0, #42   => 0x52800000 | (imm16 << 5) | Rd
  jit.w32(buf, 0, 1384120320 | 42 << 5 | 0)
  # RET
  jit.w32(buf, 1, 3596551104)
  ok = jit.seal(buf, 8)
  if not ok
    print("jit: seal failed")
    return -1
  r: i64 = jit.call0(buf)
  jit.release(buf, 4096)
  r

print("arch=" .. jit.arch())
print("jit result=" .. tostring(emit42(0)) .. "  expect 42")
