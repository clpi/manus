-- Example: AI inference at the edge with ward
-- Shows how @device(.auto) + nn{} + Tensor types make ML trivial

req "std.ml.tensor"
req "std.ml.nn"
req "std.ml.device"
req "std.fmt"
req "std.os"

ward = req "src.lib"

-- ═══════════════════════════════════════════════════════════════
-- Example 1: Load and run a GGUF model (LLM inference)
-- ═══════════════════════════════════════════════════════════════
fun example_llm_inference()
  fmt.println("=== LLM Inference ===")

  -- Load model (auto-detects GGUF from magic bytes)
  model_data = os.read_file("model.gguf")
  reg = ward.load_model("llama-7b", model_data, nn.TARGET.cpu)

  -- Run inference — one line!
  tokens = { 1, 15043, 29892 }  -- "Hello,"
  logits = ward.infer(reg, "llama-7b", { tokens })

  fmt.println("next token logits: {} dims", #logits[1])
end

-- ═══════════════════════════════════════════════════════════════
-- Example 2: Serverless WASM functions at the edge
-- ═══════════════════════════════════════════════════════════════
fun example_serverless()
  fmt.println("=== Edge Serverless ===")

  -- Create serverless runtime (1024 isolate pool)
  srv = ward.edge.serverless.new({
    max_isolates = 1024,
    fuel_per_step = 100000,
    max_reuse = 50,
  })

  -- Register a WASM module
  bytes = os.read_file("handler.wasm")
  hash = srv.register(bytes)

  -- Handle HTTP requests (each gets its own sandbox)
  response = srv.handle({
    method = "GET",
    path = "/api/predict",
    module_hash = hash,
    body = '{"input": [1.0, 2.0, 3.0]}',
  })

  fmt.println("status: {}", response.status)
end

-- ═══════════════════════════════════════════════════════════════
-- Example 3: Neural network defined in Duo nn{} syntax
-- ═══════════════════════════════════════════════════════════════
fun example_nn_model()
  fmt.println("=== Neural Network ===")

  -- Define model with nn{} block — compiles to fused kernels
  model = nn {
    linear(784, 256)
    relu
    linear(256, 128)
    relu
    linear(128, 10)
    softmax
  }

  -- Run inference with @device dispatch
  @device(.auto)
  fun predict(input: Tensor[1, 784, f32]): Tensor[1, 10, f32]
    model(input)
  end

  -- Create input
  x = tensor.rand(1, 784)
  probs = predict(x)
  fmt.println("prediction: {} classes", #probs)
end

-- ═══════════════════════════════════════════════════════════════
-- Example 4: Embed ward in your application
-- ═══════════════════════════════════════════════════════════════
fun example_embedding()
  fmt.println("=== Embedding API ===")

  -- Create engine
  eng = ward.engine({ max_isolates = 100 })

  -- Compile module (content-addressed cache)
  bytes = os.read_file("compute.wasm")
  mod = ward.compile(eng, bytes)

  -- Create sandboxed isolate with limited capabilities
  iso = ward.isolate(eng, mod, edge.cap_set({"io", "clocks"}))

  -- Call function
  result = ward.call(iso, "fibonacci", { 40 })
  fmt.println("fib(40) = {}", result)

  -- Step-based execution for cooperative multitasking
  status = ward.step(iso, 10000)  -- 10K fuel budget
  fmt.println("step result: {}", status)
end

-- ═══════════════════════════════════════════════════════════════
-- Run all examples
-- ═══════════════════════════════════════════════════════════════
fmt.println("ward — AI-native WASM runtime in Duo")
fmt.println("~1500 lines replacing ~1.3M lines of Zig\n")

-- example_llm_inference()   -- needs model.gguf
-- example_serverless()      -- needs handler.wasm
example_nn_model()
example_embedding()
