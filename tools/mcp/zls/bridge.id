-- tools/mcp/zls_bridge.id  -  the zls subprocess bridge, as a MODULE.
--
-- This exists because of a Duo lowering constraint, not for tidiness. A named
-- file-scope `fun` called from inside an MCP tool handler lowers to an upvalue
-- call  -  `cl->up0()`  -  and the C stage rejects it with "called object type
-- 'lua_Value' is not a function or function pointer". `zls.id` had exactly
-- that shape: `ensure_zls()` and `zls_request()` were file-scope functions
-- called from three handlers, so the server had NEVER been able to build.
-- Measured at HEAD 2026-08-08, before any change in this commit, with the
-- identical error.
--
-- A function reached through a `req`'d module table is a plain global and
-- works from a handler. So the helpers move here and the handlers call
-- `bridge.request(...)`.

m = {}

available: bool = ()
    std.proc.exec("which zls >/dev/null 2>&1") == 0
end

-- One LSP round trip through `zls --stdio` via temp files. Returns a decoded
-- table, or a table carrying `error`  -  never nil, so callers do not have to
-- distinguish "no answer" from "no zls".
request: any = (method: str, params: any)
    if not available()
        return { error = "zls not installed or not on PATH" }
    end
    tmpdir = string.gsub(std.proc.capture("mktemp -d 2>/dev/null"), "%s+", "")
    if tmpdir == ""
        return { error = "cannot create temp dir" }
    end
    reqf = "{tmpdir}/request.json"
    respf = "{tmpdir}/response.json"
    obj = { jsonrpc = "2.0", id = 1, method = method }
    if params != nil then obj.params = params end
    std.fs.write_file(reqf, std.json.encode(obj))
    std.proc.exec("zls --stdio < '" .. reqf .. "' > '" .. respf .. "' 2>/dev/null")
    resp = std.fs.read_file(respf) or ""
    std.proc.exec("rm -rf '" .. tmpdir .. "' 2>/dev/null")
    if resp == ""
        return { error = "no response from zls" }
    end
    std.json.decode(resp)
end

read_source: str = (path: str)
    std.fs.read_file(path) or ""
end

fmt: str = (path: str)
    rc = "{std.proc.exec(\"zig fmt \"}{path}{\" 2>&1\")}"
    if rc == 0
        return "formatted: {path}"
    end
    "fmt failed (exit " .. rc .. "): " .. path
end

m.available = available
m.request = request
m.read_source = read_source
m.fmt = fmt
m
