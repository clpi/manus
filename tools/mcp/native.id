
env("IDOL_SERVER_INCARNATION") = incarnation()
line = stdin:line()
while true
    position: i64 = line:find("\"id\":", 1, 1)
    offset: i64 = position + 5
    length: i64 = line:len()
    tail: str = if line:has("\"id\":")
        line:sub(offset, length)
    else
        ""
    comma: i64 = tail:find(",", 1, 1)
    size: i64 = tail:len()
    id: str = if tail:has(",")
        tail:sub(1, comma - 1)
    else
        tail:sub(1, size - 1)

    field: i64 = line:find("\"arguments\":\{\"file\":\"", 1, 1)
    start: i64 = if line:has("\"arguments\":\{\"file\":\"")
        field + "\"arguments\":\{\"file\":\"":len()
    else
        0
    finish: i64 = if start > 0
        line:find("\"", start, 1) - 1
    else
        0
    file: str = if start > 0
        line:sub(start, finish)
    else
        ""
    argument: str = "'"
    index: i64 = 1
    while index <= file:len()
        part: str = file:sub(index, index)
        if part:has("'")
            argument = "{argument}'\\''"
        else
            argument = "{argument}{part}"
        index += 1
    argument = "{argument}'"
    isworld: i64 = if line:has("\"method\":\"tools/call\"") and line:has("\"name\":\"world\"")
        1
    else
        0
    isfrontier: i64 = if line:has("\"method\":\"tools/call\"") and line:has("\"name\":\"frontier\"")
        1
    else
        0
    iscontrast: i64 = if line:has("\"method\":\"tools/call\"") and line:has("\"name\":\"contrast\"")
        1
    else
        0
    ispreview: i64 = if line:has("\"method\":\"tools/call\"") and line:has("\"name\":\"preview\"")
        1
    else
        0
    ispartial: i64 = if line:has("\"method\":\"tools/call\"") and line:has("\"name\":\"partial\"")
        1
    else
        0
    isrecover: i64 = if line:has("\"method\":\"tools/call\"") and line:has("\"name\":\"recover\"")
        1
    else
        0
    argsep: str = string.char(31)
    toolname: str = if isworld == 1
        "world"
    else
        if isfrontier == 1
            "frontier"
        else
            if iscontrast == 1
                "contrast"
            else
                if ispreview == 1
                    "preview"
                else
                    if ispartial == 1
                        "partial"
                    else
                        if isrecover == 1
                            "recover"
                        else
                            ""
    toolargs: str = "run" .. argsep .. "--backend=native" .. argsep .. "tools/mcp/" .. toolname .. ".id"

    command: str = if line:has("\"name\":\"status\"")
        "./tools/node/dev/orient --mcp status"
    else
        if line:has("\"name\":\"head\"")
            "./tools/node/dev/orient --mcp head"
        else
            if line:has("\"name\":\"orient\"")
                "./tools/node/dev/orient --mcp orient"
            else
                "./tools/node/dev/orient --mcp unknown"

    action: str = if line:has("\"name\":\"concept\"")
        "if test -n \"$\{IDOL_MODE-\}\"; then printf \"%s\" \"doc: FAIL connection mode forbids execution\"; else ./tools/concept/doc.sh {argument}; fi"
    else
        "true"

    output: str = gatecap("printf %s \"$( ( {action} ) 2>&1 | jq -Rs . )\"")
    failed: i64 = if line:has("\"name\":\"concept\"") and line:has("\"arguments\":\{\"file\":\"")
        if output:has("doc: FAIL")
            1
        else
            0
    else
        0

    called: i64 = if line:has("\"name\":\"concept\"") and line:has("\"arguments\":\{\"file\":\"") and line:has("\"id\":")
        1
    else
        0

    resp: str = if toolname != ""
        execap("./zig-out/bin/idol", toolargs, line .. "\n")
    else
        if called
        if failed
            "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"error\":\{\"code\":-32000,\"message\":{output}\}\}"
        else
            "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":\{\"content\":[\{\"type\":\"text\",\"text\":{output}\}]\}\}"
    else
        if line:has("\"name\":\"concept\"") and line:has("\"id\":")
            "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"error\":\{\"code\":-32602,\"message\":\"tool: invalid params: arguments.file is required\"\}\}"
        else
            if line:has("\"method\":\"tools/call\"") and line:has("\"id\":")
                "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":{gatecap(command)}\}"
            else
                if line:has("\"method\":\"tools/list\"")
                    "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":\{\"tools\":[\{\"name\":\"status\",\"description\":\"git status --short --branch\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\}\}\},\{\"name\":\"head\",\"description\":\"current HEAD commit id\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\}\}\},\{\"name\":\"orient\",\"description\":\"Idol orientation snapshot\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\}\}\},\{\"name\":\"concept\",\"description\":\"render the produced concept verdict (REFUSED or HELD) for a subject .id file\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"file\":\{\"type\":\"string\"\}\}\}},\{\"name\":\"world\",\"description\":\"bind one request to its actual execution world: world-bound concept verdict or structured refusal\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"subject\":\{\"type\":\"string\"\},\"file\":\{\"type\":\"string\"\}\}\}\},\{\"name\":\"frontier\",\"description\":\"query the semantic frontier: known/unknown facts, blockers, and highest value-of-information\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"file\":\{\"type\":\"string\"\},\"region\":\{\"type\":\"string\"\}\}\}\},\{\"name\":\"contrast\",\"description\":\"ask the minimal behavioral question for unresolved intent\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"file\":\{\"type\":\"string\"\},\"ambiguity\":\{\"type\":\"object\"\},\"answer\":\{\"type\":\"object\"\}\}\}\},\{\"name\":\"preview\",\"description\":\"produce a checked semantic-change proposal for a projection edit\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"file\":\{\"type\":\"string\"\},\"projection\":\{\"type\":\"string\"\},\"edit\":\{\"type\":\"object\"\}\}\}\},\{\"name\":\"partial\",\"description\":\"retain useful partial results with explicit outstanding obligations; never admits completion\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"file\":\{\"type\":\"string\"\},\"action\":\{\"type\":\"string\"\},\"owner\":\{\"type\":\"string\"\},\"budget\":\{\"type\":\"integer\"\},\"context\":\{\"type\":\"string\"\},\"capability\":\{\"type\":\"string\"\},\"region\":\{\"type\":\"string\"\},\"unknown\":\{\"type\":\"string\"\}\}\}\},\{\"name\":\"recover\",\"description\":\"classify recoverability of an intermediate value or optimization decision with evidence\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"file\":\{\"type\":\"string\"\},\"subject_hash\":\{\"type\":\"string\"\},\"query\":\{\"type\":\"object\"\}\}\}\}]\}\}"
                else
                    if line:has("\"method\":\"initialize\"")
                        "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":\{\"protocolVersion\":\"2024-11-05\",\"capabilities\":\{\"tools\":\{\"listChanged\":false\}\},\"serverInfo\":\{\"name\":\"idol\",\"version\":\"0.0.0\"\}\}\}"
                    else
                        if line:has("\"method\":\"ping\"")
                            "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":\{\}\}"
                        else
                            if line:has("\"id\":")
                                "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"error\":\{\"code\":-32601,\"message\":\"method not found\"\}\}"
                            else
                                "\{\"jsonrpc\":\"2.0\",\"method\":\"notifications/message\",\"params\":\{\"level\":\"debug\",\"logger\":\"idol\",\"data\":\"ack\"\}\}"

    stdout:write(resp .. "\n")
    line = stdin:line()
