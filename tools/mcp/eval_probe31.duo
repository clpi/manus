-- 6 short lines
src = "AAAA\nBBBB\nCCCC\nDDDD\nEEEE\nFFFF\n"
count = 0
for ln in string.gmatch(src, "([^\n]*)\n") do
    count = count + 1
end
print("short_lines=" .. count)

-- 6 long lines (42 chars each)
l = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
src2 = l .. "\n" .. l .. "\n" .. l .. "\n" .. l .. "\n" .. l .. "\n" .. l .. "\n"
print("len2=" .. string.len(src2))
count2 = 0
for ln in string.gmatch(src2, "([^\n]*)\n") do
    count2 = count2 + 1
end
print("long_lines=" .. count2)
