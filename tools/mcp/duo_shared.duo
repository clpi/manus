-- duo-mcp/duo_shared.duo — shared MCP tool implementations for Duo MCP servers.
-- Pure Duo, replaces Python duo_mcp_shared.py.
-- Import as `shared = req "tools.mcp.duo_shared"` — ROOTED, not bare: `req`
-- resolves at compile time against the tree above the source file, so a bare
-- name only resolved when the process was started with cwd = tools/mcp.

m = {}

-- `std.script` is gone: the denied activity junk drawer (Pass 100 §15). Its
-- 52 uses here were exactly six operations — capture, run, fs_exists, fs_read,
-- fs_write, lock_cmd — and the first five are std.proc and std.fs, referenced
-- directly under Pass 118 §0h (std is the prelude graph: no import). The
-- sixth is lockprefix, four lines of string concatenation, below.

-- `os.getenv(name, default)` SILENTLY DROPS its second argument under the Lua
-- 5.1 runtime — this line used to read
--   root = os.getenv("DUO_ROOT", os.getenv("PWD", "."))
-- and neither fallback ever ran. With DUO_ROOT unset, root was nil and the
-- four path constants below concatenated against nil at module load, taking
-- the whole server down before it could answer anything.
-- `std.os.getenv` is the single-argument form, and it answers "" — never nil —
-- for an unset name, so every read is guarded against "" as well as nil.
root = std.os.getenv("DUO_ROOT")
if root == nil or root == ""
    root = std.os.getenv("PWD")
end
if root == nil or root == ""
    root = "."
end
-- Session state, NOT repository truth. These tools APPEND — five write sites
-- below — which is how .agents/AGENT_COORDINATION.md grew to 4619 tracked
-- lines and became a control plane. .agents/session/ is gitignored; the
-- durable document it replaced stays hand-maintained and small.
coordpath = root .. "/.agents/session/coordination.md"
perfpath = root .. "/docs/performance.md"
canonpath = root .. "/.agents/AGENT_CANONICAL.md"
duobin = std.os.getenv("duobin")
if duobin == nil or duobin == ""
    duobin = root .. "/zig-out/bin/duo"
end

-- The build lock, spelled here so std.script is not needed for the one thing
-- it was actually load-bearing for. `duo run x.duo -- cmd` consumes the first
-- `--` itself, so the wrapper never sees a separator it did not ask for.
lockprefix = duobin .. " run " .. root .. "/scripts/duo_lock.duo -- "

-- Section heading that marks the open-gaps/findings table in the
-- coordination buffer. Kept as a constant so callers that search for it
-- (plain/literal find) and callers that emit it stay in sync.
gapsmarker = "## Open Gaps & Findings"

-- Per-process counter for unique finding IDs (same-second collisions).
finding_seq = 0

-- === Coordination ===

fun coordination_read(): str
    if std.fs.exists(coordpath)
        std.fs.read_file(coordpath)
    else
        "Coordination buffer not yet initialized."
    end
end

fun coordination_update(action: str, agent_id: str, detail: str, files: str)
    timestamp = os.date("%Y-%m-%d %H:%m:%S")
    entry = "\n### [" .. timestamp .. "] " .. agent_id .. " — " .. string.upper(action) .. "\n"
    entry = entry .. "Detail: " .. detail .. "\n"
    if files ~= ""
        entry = entry .. "Files: " .. files .. "\n"
    end
    status = "ACTIVE"
    if action == "claim" then status = "LOCKED"
    elseif action == "release" then status = "UNLOCKED" end
    entry = entry .. "Status: " .. status .. "\n"
    std.fs.write_file(coordpath, std.fs.read_file(coordpath) .. entry)
    -- Structured, not "ok: …". A prose acknowledgement is an H-8 finding and
    -- it also told the caller nothing it could act on — not which buffer was
    -- written, not what status the entry landed with.
    { kind = "coordination.update", action = action, agent = agent_id,
             status = status, path = coordpath, files = files }
end

fun session_log(agent_id: str, summary: str, detail: str)
    timestamp = os.date("!%Y-%m-%dT%H:%m:%SZ")
    entry = "\n| " .. timestamp .. " | " .. agent_id .. " | " .. summary .. " |"
    if detail ~= "" then entry = entry .. " " .. detail .. " |" else entry = entry .. " |" end
    content = std.fs.read_file(coordpath)
    marker = "## Session log (newest first)"
    pos = string.find(content, marker)
    if pos
        before = string.sub(content, 1, pos + #marker - 1)
        after = string.sub(content, pos + #marker)
        -- find the table header
        table_pos = string.find(after, "| --- | --- | --- |")
        if table_pos
            after = string.sub(after, table_pos + 18)
        end
        content = before .. "\n\n| UTC date | Agent | Summary |\n| --- | --- | --- |\n" .. entry .. after
    else
        content = content .. "\n\n## Session log (newest first)\n\n| UTC date | Agent | Summary |\n| --- | --- | --- |\n" .. entry .. "\n"
    end
    std.fs.write_file(coordpath, content)
    { kind = "session.log", agent = agent_id, summary = summary, path = coordpath }
end

fun open_p0_gaps(): any
    content = coordination_read()
    gaps = {}
    for line in string.gmatch(content, "| G-[^|]+ |[^|]+ | P0 |[^|]+ |[^|]+ |")
        gaps[#gaps + 1] = line
    end
    gaps
end

-- === Build gates ===

fun agent_smoke(timeout: int): any
    smoke_cmd = duobin .. " run scripts/agent_smoke.duo"
    locked = lockprefix .. smoke_cmd
    rc = 0
    if os.getenv("DUO_LOCK_HELD") == "1"
        rc = std.proc.exec(smoke_cmd)
    else
        rc = std.proc.exec(locked)
    end
    { exit_code = rc, passed = rc == 0, gate = "agent-smoke" }
end

fun build_run(gate: str, timeout: int): any
    gates = {
        build = "zig build",
        test = "zig build test",
        ["unit-test"] = "zig build unit-test --summary all",
        ["fmt-check"] = "zig fmt src --check",
        ["agent-smoke"] = duobin .. " run scripts/agent_smoke.duo",
    }
    cmd = gates[gate]
    if cmd == nil then return { error = "unknown gate: " .. gate } end
    rc = 0
    if os.getenv("DUO_LOCK_HELD") == "1"
        rc = std.proc.exec(cmd)
    else
        rc = std.proc.exec(lockprefix .. cmd)
    end
    { exit_code = rc, passed = rc == 0, gate = gate }
end

-- Benchmark suites. An ALLOWLIST, not string interpolation: `suite`
-- arrives from an MCP client, and the old duo_bench.duo handler pasted it
-- straight into a shell command line under the build lock.
fun bench_run(suite: str, timeout: int): any
    suites = {
        bench = "zig build bench",
        ["ml-bench"] = "zig build ml-bench",
        ["honest-bench"] = "zig build honest-bench",
        ["cross-bench"] = "zig build cross-bench",
        ["wasm-bench"] = "zig build wasm-bench",
    }
    cmd = suites[suite]
    if cmd == nil then return { error = "unknown bench suite: " .. suite } end
    rc = 0
    if os.getenv("DUO_LOCK_HELD") == "1"
        rc = std.proc.exec(cmd)
    else
        rc = std.proc.exec(lockprefix .. cmd)
    end
    { exit_code = rc, passed = rc == 0, suite = suite }
end

-- Run a command under the build lock and hand back BOTH its status and its
-- output. Callers used to reach for std.script directly for this; keeping it
-- here means the lock discipline lives in one place.
fun locked_capture(cmd: str): any
    full = cmd
    if os.getenv("DUO_LOCK_HELD") ~= "1"
        full = lockprefix .. cmd
    end
    out = std.proc.capture(full .. " 2>&1; echo \"duoexit:$?\"")
    rc = 0
    mpos = string.find(out, "duoexit:", 1, true)
    if mpos ~= nil
        rc = tonumber(string.gsub(string.sub(out, mpos + 8), "%s+", "")) or 0
        out = string.sub(out, 1, mpos - 1)
    end
    { exit_code = rc, passed = rc == 0, output = out }
end

-- === DOCUMENT ENVELOPE (Pass 117 §0g / H-8 partial repair) ===
--
-- G-TOTAL gates every rendered artifact and front-end, docs included, and says
-- MCP responses are `(span, role, why, dnir)` tuples — plain-string output is
-- an H-8 finding. Ten tools here answered by handing back the raw bytes of a
-- markdown file, which is the plainest possible plain text.
--
-- This is a PARTIAL repair and is labelled as one. What it fixes honestly:
-- the response now carries the document's PROVENANCE as checkable facts —
-- which path was read, whether it existed, how many bytes and lines it has,
-- and whether the client is holding all of them. Before this, a caller could
-- not distinguish "the ledger is empty" from "the path was wrong" from "the
-- reply was truncated at 10000 bytes"; all three arrived as a short string.
--
-- What it does NOT do, deliberately: it does not emit a `role`. The 18-role
-- taxonomy H-2 calls CLOSED is not enumerated anywhere in the tree —
-- docs/spec/roles.md §4 counts 17 named, says role 18 "is unnamed anywhere",
-- and refuses to guess it; gaps/GAP-071 records that G-TOTAL cannot yet be
-- measured. Emitting a guessed role would satisfy a scan while making the
-- number unfalsifiable, which is worse than the plain text it replaced. The
-- `role` and `dnir` legs stay UNWRITTEN until the taxonomy lands, and this
-- envelope never claims compliance.
fun document(path: str, label: str, limit: int): any
    if not std.fs.exists(path)
        return { kind = "document", label = label, path = path, exists = false,
                 bytes = 0, lines = 0, truncated = false, text = "" }
    end
    raw = std.fs.read_file(path) or ""
    n = string.len(raw)
    body = raw
    cut = false
    if limit > 0 and n > limit
        body = string.sub(raw, 1, limit)
        cut = true
    end
    -- Line count by VALUE, not by a running counter: count the newlines that
    -- are actually there.
    nl = string.len(raw) - string.len(string.gsub(raw, "\n", ""))
    { kind = "document", label = label, path = path, exists = true,
             bytes = n, lines = nl + 1, truncated = cut, text = body }
end

-- === Repo tooling ===

fun repo_tooling(script_name: str, args: str): any
    full = ""
    if std.fs.exists("scripts/" .. script_name)
        full = duobin .. " run scripts/" .. script_name
    elseif std.fs.exists(script_name)
        full = duobin .. " run " .. script_name
    elseif std.fs.exists(root .. "/scripts/" .. script_name)
        full = duobin .. " run " .. root .. "/scripts/" .. script_name
    else
        return { error = "script not found: " .. script_name }
    end
    if args ~= "" then full = full .. " " .. args end
    rc = std.proc.exec(full)
    { exit_code = rc, passed = rc == 0, script = script_name }
end

-- === Pass 13 dev control plane (machine-readable claims) ===

fun dev_session_start(owner: str, work_item: str, client: str): str
    cmd = duobin .. " dev session start --owner " .. owner
    if client ~= "" then cmd = cmd .. " --client " .. client end
    if work_item ~= "" then cmd = cmd .. " --work-item " .. work_item end
    std.proc.capture(cmd .. " 2>&1")
end

-- The compiler-side lease. It reports a claim; it does NOT arbitrate one —
-- two callers both get an "acquired" line back. The arbitrating claim is
-- `dev_claim_acquire` further down, which holds a mkdir(2) lock. This one is
-- kept for its side effect on the dev control plane and is called BY that
-- function once the real lock is held.
fun dev_claim_note(owner: str, file: str, client: str, work_item: str): str
    cmd = duobin .. " dev claim acquire --owner " .. owner .. " --file " .. file
    if client ~= "" then cmd = cmd .. " --client " .. client end
    if work_item ~= "" then cmd = cmd .. " --work-item " .. work_item end
    std.proc.capture(cmd .. " 2>&1")
end

fun dev_claim_list(): str
    std.proc.capture(duobin .. " dev claim list 2>&1")
end

fun dev_coordination_export(): str
    std.proc.capture(duobin .. " dev coordination export 2>&1")
end

fun dev_validate_plan(file: str, work_item: str): str
    cmd = duobin .. " dev validate plan"
    if file ~= "" then cmd = cmd .. " --file " .. file
    elseif work_item ~= "" then cmd = cmd .. " --work-item " .. work_item end
    std.proc.capture(cmd .. " 2>&1")
end

fun semantic_claims(): str
    std.proc.capture(duobin .. " semantic claims 2>&1")
end

fun semantic_transaction_preview(classifier: str): str
    c = classifier
    if c == nil or c == "" then c = "classifier.sorted_lookup" end
    std.proc.capture(duobin .. " semantic preview " .. c .. " 2>&1")
end

fun semantic_transaction_validate(classifier: str): str
    c = classifier
    if c == nil or c == "" then c = "classifier.sorted_lookup" end
    std.proc.capture(duobin .. " semantic validate " .. c .. " 2>&1")
end

fun dev_integration_list(): str
    std.proc.capture(duobin .. " dev integration list 2>&1")
end

fun dev_integration_submit(owner: str, work_item: str, claim_id: str): str
    cmd = duobin .. " dev integration submit --owner " .. owner .. " --work-item " .. work_item
    if claim_id ~= nil and claim_id ~= "" then cmd = cmd .. " --claim-id " .. claim_id end
    std.proc.capture(cmd .. " 2>&1")
end

fun dev_validate_run(file: str, work_item: str, execute: bool): str
    cmd = duobin .. " dev validate run"
    if file ~= nil and file ~= "" then cmd = cmd .. " --file " .. file
    elseif work_item ~= nil and work_item ~= "" then cmd = cmd .. " --work-item " .. work_item end
    if execute then cmd = cmd .. " --execute" end
    std.proc.capture(cmd .. " 2>&1")
end

-- === Native boxing audit ===

fun dump_c(file_path: str): str
    std.proc.capture(duobin .. " dump-c " .. file_path .. " 2>&1")
end

fun audit_native_boxing(file_path: str): any
    c_code = dump_c(file_path)
    hits = {}
    for _, needle in {"lua_invoke(", "lua_table_get_str_lit(", "lua_Value ", "lua_table_new(", "lua_val_from_"}
        if string.find(c_code, needle)
            hits[#hits + 1] = needle
        end
    end
    -- Check comptime violations in main()
    main_pos = 0
    for i = #c_code, 1, -1
        if string.sub(c_code, i, i + 7) == "int main"
            main_pos = i
            break
        end
    end
    user = ""
    if main_pos > 0 then user = string.sub(c_code, main_pos) else user = string.sub(c_code, -4000) end
    comptime_violations = {}
    for ident, rhs in string.gmatch(user, "const char%* (%w+) = ([^;]+);")
        if string.find(rhs, "lua_")
            comptime_violations[#comptime_violations + 1] = { binding = ident, rhs = string.sub(rhs, 1, 120) }
        end
    end
    const_count = 0
    for _ in string.gmatch(c_code, "const char%*")
        const_count = const_count + 1
    end
    {
        file = file_path,
        boxing_hits = hits,
        boxing_hit_count = #hits,
        comptime_violations = comptime_violations,
        comptime_violation_count = #comptime_violations,
        const_char_ptr_bindings = const_count,
        pass = #comptime_violations == 0,
    }
end

-- === Pass 5 semantic interchange (SIM) ===

fun semantic_snapshot(file_path: str): any
    output = std.proc.capture(duobin .. " sim " .. file_path .. " 2>&1")
    if string.find(output, ": error:") or string.find(output, "sema error") or string.find(output, "parse failed") then
        return { ok = false, error = string.sub(output, 1, 4000), schema = "sim-v0" }
    end
    parsed = std.json.decode(output)
    if parsed == nil then
        return { ok = false, error = "failed to parse SIM JSON", raw_output = string.sub(output, 1, 2000) }
    end
    {
        ok = true,
        schema = parsed.schema or "sim-v0",
        file = parsed.file,
        entity_count = parsed.entity_count or 0,
        entities = parsed.entities or {},
        snapshot = parsed,
    }
end

fun semantic_snapshot_raw(file_path: str): str
    output = std.proc.capture(duobin .. " sim " .. file_path .. " 2>&1")
    -- Find the JSON start (skip any diagnostic lines)
    i = string.find(output, "{")
    if i == nil then
        return "{\"ok\":false,\"error\":\"no JSON in output\",\"raw\":\"" .. string.sub(output, 1, 200) .. "\"}"
    end
    string.sub(output, i)
end

fun foreign_import_preview(header_path: str, source_dir: str): any
    resolved = header_path
    if source_dir ~= "" and string.sub(header_path, 1, 1) ~= "/" then
        resolved = source_dir .. "/" .. header_path
    end
    output = std.proc.capture(duobin .. " sim --import-c " .. resolved .. " 2>&1")
    if string.find(output, ": error:") or string.find(output, "failed") then
        return { ok = false, error = string.sub(output, 1, 4000), header = resolved }
    end
    parsed = std.json.decode(output)
    if parsed == nil then
        return { ok = false, error = "failed to parse SIM JSON", header = resolved, raw_output = string.sub(output, 1, 2000) }
    end
    records = {}
    functions = {}
    for _, ent in parsed.entities or {}
        if ent.kind == "record" then records[#records + 1] = ent
        elseif ent.kind == "function" then functions[#functions + 1] = ent end
    end
    {
        ok = true,
        schema = parsed.schema or "sim-v0",
        header = resolved,
        entity_count = parsed.entity_count or 0,
        records = records,
        functions = functions,
        entities = parsed.entities or {},
        snapshot = parsed,
    }
end

fun pass6_catalog(): any
    output = std.proc.capture(duobin .. " catalog 2>&1")
    parsed = std.json.decode(output)
    if parsed == nil then
        return { ok = false, error = "failed to parse catalog JSON", raw_output = string.sub(output, 1, 2000) }
    end
    p6 = parsed.pass6
    if p6 == nil then
        return { ok = false, error = "catalog missing pass6 section" }
    end
    { ok = true, pass6 = p6 }
end

fun pass5_catalog(): any
    output = std.proc.capture(duobin .. " catalog 2>&1")
    parsed = std.json.decode(output)
    if parsed == nil then
        return { ok = false, error = "failed to parse catalog JSON", raw_output = string.sub(output, 1, 2000) }
    end
    p5 = parsed.pass5
    if p5 == nil then
        return { ok = false, error = "catalog missing pass5 section" }
    end
    { ok = true, pass5 = p5 }
end

fun foreign_entity_lookup(file_path: str, symbol: str): any
    content = ""
    if std.fs.exists(file_path) then content = std.fs.read_file(file_path) end
    source_dir = file_path
    dir = string.match(file_path, "^(.*)/[^/]+$")
    if dir then source_dir = dir end
    for header in string.gmatch(content, '@c%.import%("([^"]+)"%)')
        preview = foreign_import_preview(header, source_dir)
        if preview.ok then
            for _, ent in preview.entities
                if ent.name == symbol then
                    return { ok = true, symbol = symbol, entity = ent, header = header, source_file = file_path }
                end
            end
        end
    end
    for header in string.gmatch(content, "@c%.import%('([^']+)'%)")
        preview = foreign_import_preview(header, source_dir)
        if preview.ok then
            for _, ent in preview.entities
                if ent.name == symbol then
                    return { ok = true, symbol = symbol, entity = ent, header = header, source_file = file_path }
                end
            end
        end
    end
    { ok = false, symbol = symbol, source_file = file_path, error = "foreign entity not found in @c.import headers" }
end

-- === Canonical index ===

fun canonical_index(): str
    if std.fs.exists(canonpath)
        return std.fs.read_file(canonpath)
    end
    "Canonical index not found at " .. canonpath
end

fun perf_ledger(): str
    if std.fs.exists(perfpath)
        return string.sub(std.fs.read_file(perfpath), 1, 10000)
    end
    "Performance ledger not found at " .. perfpath
end
-- === Benchmark regression analysis ===
-- Interpret a benchmark run's own verdict (the bench script already compares Duo
-- RESULT lines against reference C and prints a pass marker). We extract RESULT
-- rows, detect failure/timing-regression lines, and return a structured verdict.
-- If bench_output is empty, run `zig build <suite>` under the build lock and
-- capture stdout. Pattern-free: literal find/sub only (the pattern engine mis-handles
-- checkmarks, ">=", and the "-" in RESULT names).
fun bench_regressions(bench_output: str, suite: str): any
    out = bench_output
    bt = suite
    if bt == nil then bt = "bench" end
    if bt == "" then bt = "bench" end
    if out == nil then out = "" end
    if out == "" then
        out = std.proc.capture("duo run scripts/duo_lock.duo -- zig build " .. bt .. " 2>&1")
    end
    pass_full = "All benchmarks: results match"
    pass_correct = "benchmark results match reference C"
    passed = false
    if string.find(out, pass_full, 1, true) ~= nil then passed = true end
    if string.find(out, pass_correct, 1, true) ~= nil then passed = true end
    results = {}
    failures = {}
    timing_notes = {}
    lines = string.split(out, "\n")
    i = 1
    while i <= #lines
        ln = lines[i]
        if string.sub(ln, 1, 7) == "RESULT " then
            rest = string.sub(ln, 8)
            sp = string.find(rest, " ", 1, true)
            nm = rest
            val = ""
            if sp ~= nil then
                nm = string.sub(rest, 1, sp - 1)
                val = string.sub(rest, sp + 1)
            end
            _ = table.insert(results, { name = nm, value = val })
        end
        is_fail = false
        if string.find(ln, "mismatch", 1, true) ~= nil then is_fail = true end
        if string.find(ln, "FAIL", 1, true) ~= nil then is_fail = true end
        if string.find(ln, "error:", 1, true) ~= nil then is_fail = true end
        if is_fail then _ = table.insert(failures, ln) end
        if string.find(ln, "regress", 1, true) ~= nil then _ = table.insert(timing_notes, ln) end
        i = i + 1
    end
    summary = ""
    if passed then
        summary = "PASS: " .. #results .. " RESULT lines verified; Duo .lua/.duo <= C gate met."
    else
        summary = "CHECK: pass marker absent; " .. #results .. " RESULT lines; " .. #failures .. " failure line(s); " .. #timing_notes .. " timing note(s)."
    end
    {
        passed = passed,
        suite = bt,
        result_count = #results,
        results = results,
        failure_count = #failures,
        failures = failures,
        timing_notes = timing_notes,
        summary = summary,
    }
end

-- === Open performance gaps ===
-- Surface perf / native-lowering / codegen gaps that are still open in the
-- cross-agent gap buffer, plus a performance.md excerpt for context.
fun perf_gaps(): any
    content = coordination_read()
    lines = string.split(content, "\n")
    gaps = {}
    i = 1
    while i <= #lines
        ln = lines[i]
        if string.sub(ln, 1, 4) == "| F-" then
            kind_match = false
            if string.find(ln, "perf_gap", 1, true) ~= nil then kind_match = true end
            if string.find(ln, "native_lowering", 1, true) ~= nil then kind_match = true end
            if string.find(ln, "codegen_gap", 1, true) ~= nil then kind_match = true end
            status_open = false
            if string.find(ln, "| open |", 1, true) ~= nil then status_open = true end
            if kind_match
                if status_open then _ = table.insert(gaps, ln) end
            end
        end
        i = i + 1
    end
    perf = ""
    if std.fs.exists(perfpath) then
        perf = string.sub(std.fs.read_file(perfpath), 1, 4000)
    end
    {
        open_perf_gap_count = #gaps,
        gaps = gaps,
        perf_ledger_excerpt = perf,
    }
end
-- === Codegen-pitfall audit ===
-- Detect the known silent-correctness codegen bugs (F-13813-2 call-as-tail
-- premature return; F-13813-3 nil-init void* inference) in a .duo source file,
-- with the verified workaround for each. Protects every duo developer from
-- spending hours on these. Literal scans only (pattern engine is unreliable).
fun audit_codegen_pitfalls(file_path: str): any
    if not std.fs.exists(file_path) then
        return { error = "file not found: " .. file_path }
    end
    src = std.fs.read_file(file_path)
    lines = string.split(src, "\n")
    findings = {}
    i = 1
    while i <= #lines
        ln = lines[i]
        tr = str_trim(ln)
        -- F-13813-3: `= nil` init risks void* type inference
        if string.find(tr, "= nil", 1, true) ~= nil then
            _ = table.insert(findings, {
                line = i,
                rule = "F-13813-3 nil-init",
                risk = "sema infers void*; later typed assignment fails to compile or mis-codes",
                fix = "initialize with a typed sentinel (\"\" / 0 / {} / false)",
            })
        end
        -- F-13813-2: a bare call statement as the LAST statement of an if/for/while
        -- block emits `return call(...)`, exiting the enclosing function early.
        is_tail = false
        if i < #lines then
            j = i + 1
            nxt = ""
            while j <= #lines
                nxt = str_trim(lines[j])
                if #nxt > 0 then break end
                j = j + 1
            end
            -- Prefix checks via string.find (NUMBER result); string == is
            -- unreliable inside while loops (duo codegen bug).
            if string.find(nxt, "end", 1, true) == 1 then is_tail = true end
            if string.find(nxt, "else", 1, true) == 1 then is_tail = true end
            if string.find(nxt, "elseif", 1, true) == 1 then is_tail = true end
        end
        if is_tail then
            bare_call = false
            has_assign = string.find(tr, " = ", 1, true) ~= nil
            starts_return = string.find(tr, "return ", 1, true) == 1
            if (not has_assign) and (not starts_return) then
                paren = string.find(tr, "(", 1, true)
                if paren ~= nil and paren > 1 then
                    head = string.sub(tr, 1, paren - 1)
                    -- head must be a bare identifier/path; validate via string.byte
                    -- (number comparison — string == fails inside loops).
                    head_ok = true
                    k = 1
                    while k <= #head
                        code = string.byte(head, k)
                        ok_c = false
                        if code >= 48 and code <= 57 then ok_c = true end
                        if code >= 65 and code <= 90 then ok_c = true end
                        if code >= 97 and code <= 122 then ok_c = true end
                        if code == 46 then ok_c = true end
                        if code == 95 then ok_c = true end
                        if not ok_c then head_ok = false end
                        k = k + 1
                    end
                    if head_ok then bare_call = true end
                end
            end
            if bare_call then
                _ = table.insert(findings, {
                    line = i,
                    rule = "F-13813-2 call-as-tail",
                    risk = "codegen emits premature return; enclosing function exits here",
                    fix = "prefix with `_ = `  (e.g.  `_ = table.insert(t, v)`)",
                })
            end
        end
        i = i + 1
    end
    {
        file = file_path,
        finding_count = #findings,
        findings = findings,
        summary = "Scanned " .. #lines .. " lines; " .. #findings .. " codegen-pitfall(s).",
    }
end
-- === Exponential evaluator ===
-- Analyze Duo source for metaprogramming opportunities and emit @comp.* suggestions.
-- Pure-pattern detection; no lua_Value ever produced. Optionally audits native
-- boxing when file_path points at a real .duo file.
TYPE_SUFFIXES = { "i64", "f64", "i32", "f32", "str", "bool", "u64", "u32" }

fun str_trim(s: str): str
    -- Uses string.byte + NUMBER comparison, not string == / ~=. Duo codegen
    -- mis-compares string.sub results inside while loops (c == " " is false for
    -- a space). Number comparison (byte ~= 32) is reliable. Space=32, tab=9.
    a = 1
    b = #s
    while a <= b
        code = string.byte(s, a)
        if code ~= 32 and code ~= 9 then break end
        a = a + 1
    end
    while b >= a
        code = string.byte(s, b)
        if code ~= 32 and code ~= 9 then break end
        b = b - 1
    end
    string.sub(s, a, b)
end

fun exponential_evaluate(code: str, file_path: str): any
    suggestions = {}
    lines = string.split(code, "\n")

    -- Detector A: manually monomorphized functions (fun name_SUFFIX(...))
    -- Pattern-free: duo's %s+ and [..] classes are unreliable, so we use find+sub.
    bases = {}
    for i = 1, #lines
        t = str_trim(lines[i])
        nm = ""
        if string.sub(t, 1, 4) == "fun "
            pp = string.find(t, "%(")
            if pp and pp > 5
                nm = str_trim(string.sub(t, 5, pp - 1))
            end
        end
        if #nm > 0
            for si = 1, #TYPE_SUFFIXES
                suf = TYPE_SUFFIXES[si]
                slen = #suf + 1
                if #nm > slen and string.sub(nm, -slen) == "_" .. suf
                    base = string.sub(nm, 1, #nm - slen)
                    bases[base] = bases[base] or {}
                    bases[base][suf] = i
                end
            end
        end
    end
    for base, tys in bases
        cnt = 0
        first = 0
        for ty, ln in tys
            cnt = cnt + 1
            if first == 0 or ln < first then first = ln end
        end
        if cnt >= 2
            _ = table.insert(suggestions, {
                kind = "exponential_opportunity",
                line = first,
                construct = "@comp.map / @comp.derive",
                rationale = "'" .. base .. "' is hand-monomorphized across " .. tostring(cnt) .. " types; one @comp.map emits all variants with zero lua_Value.",
                multiplier = "O(" .. tostring(cnt) .. " decls <= 1 call)",
            })
        end
    end

    -- Detector B: runtime type-string dispatch (if t == "i64" ... elseif "f64")
    dispatch_hits = 0
    dispatch_line = 0
    for i = 1, #lines
        if string.find(lines[i], '== "i64"') or string.find(lines[i], '== "f64"') or string.find(lines[i], '== "i32"') or string.find(lines[i], '== "f32"')
            dispatch_hits = dispatch_hits + 1
            if dispatch_line == 0 then dispatch_line = i end
        end
    end
    if dispatch_hits >= 2
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = dispatch_line,
            construct = "@comp.select / @comp.product",
            rationale = "Runtime type-string branching (" .. tostring(dispatch_hits) .. " arms) collapses to a compile-time type dispatch.",
            multiplier = "O(branches -> 0 runtime cost)",
        })
    end

    -- Detector C: >=3 consecutive incrementing indexed writes (arr[1]=, arr[2]=, ...)
    run_len = 0
    run_prev = -1
    run_start = 0
    c_line = 0
    for i = 1, #lines
        t = str_trim(lines[i])
        b1 = string.find(t, "%[")
        b2 = string.find(t, "%]")
        eq = string.find(t, "=")
        if b1 and b2 and b2 > b1 and eq and eq > b2
            idx_s = str_trim(string.sub(t, b1 + 1, b2 - 1))
            idx = tonumber(idx_s)
            if idx
                if run_len > 0 and idx == run_prev + 1
                    run_len = run_len + 1
                else
                    run_len = 1
                    run_start = i
                end
                run_prev = idx
                if run_len >= 3 and c_line == 0 then c_line = run_start end
            else
                run_len = 0
            end
        else
            run_len = 0
        end
    end
    if c_line > 0
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = c_line,
            construct = "@comp.compile.unroll",
            rationale = "Sequential indexed writes form a bounded loop; @comp.compile.unroll expands it at compile time.",
            multiplier = "O(n statements -> 1 loop)",
        })
    end

    -- Detector D: repeated record-type boilerplate (>=3 'type X = {')
    type_defs = 0
    type_line = 0
    for i = 1, #lines
        t = str_trim(lines[i])
        if string.sub(t, 1, 5) == "type " and string.find(t, "{") and string.find(t, "=")
            type_defs = type_defs + 1
            if type_line == 0 then type_line = i end
        end
    end
    if type_defs >= 3
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = type_line,
            construct = "@comp.derive.bundle",
            rationale = tostring(type_defs) .. " record types; @comp.derive.bundle generates shared trait impls for all in one annotation.",
            multiplier = "O(types x traits <= 1 annotation)",
        })
    end

    -- Detector E: comptime-foldable literal arithmetic (var = digits op digits, no vars)
    for i = 1, #lines
        t = str_trim(lines[i])
        eq = string.find(t, "=")
        if eq and eq > 1 and string.sub(t, eq, eq + 1) ~= "=="
            rhs = str_trim(string.sub(t, eq + 1))
            if not string.find(rhs, "[%a]") and (string.find(rhs, "[%*]") or string.find(rhs, "[%+]") or string.find(rhs, "[/]"))
                _ = table.insert(suggestions, {
                    kind = "ergonomic_gap",
                    line = i,
                    construct = "@(expr)",
                    rationale = "Constant arithmetic '" .. rhs .. "' folds at compile time with @( ... ).",
                    multiplier = "O(1 runtime -> 0)",
                })
            end
        end
    end

    -- Annotated preview: prepend a discovery header listing every opportunity.
    optimized = code
    if #suggestions > 0
        optimized = "-- @comp exponential-eval: " .. tostring(#suggestions) .. " opportunity(s)\n"
        for _, s in suggestions
            optimized = optimized .. "-- [L" .. tostring(s.line) .. "] " .. s.construct .. ": " .. s.rationale .. "\n"
        end
        optimized = optimized .. code
    end

    result = {
        file = file_path or "<inline>",
        suggestion_count = #suggestions,
        suggestions = suggestions,
        optimized_preview = optimized,
    }
    if file_path and file_path ~= "" and std.fs.exists(file_path)
        result.boxing = audit_native_boxing(file_path)
    end
    result
end

-- === Exponential mentoring: Onboarding guidance for metaprogramming ===

fun exponential_onboard(question: str, code: str): any
    -- Step-by-step guidance for leveraging Duo's exponential metaprogramming
    questions = {
        "what is exponential metaprogramming" = [[
EXPOTENTIAL METAPROGRAMMING IN DUO
=====================================

The goal: Write LESS code, get MORE optimized native output.

Key @comp.* combinators (no underscores!):

1. @comp.map(type, callback) — Transform all types
   - One callback handles N types
   - Native fold → no lua_Value
   - Example: @comp.map(i32, f32, f64, my_func) generates specialized versions

2. @comp.derive.all(Type) — Auto-generate boilerplate
   - One declarative type → all getters/setters/methods
   - Native C emission
   - Example: @comp.derive.all(MyStruct) gives you .id(), .set_id(), etc.

3. @comp.burst(pattern) — Pattern expansion
   - One template → N concrete programs
   - For SIMD, unrolled loops, etc.

4. @comp.tensor(shape, dtype) — Tensor operations
   - Compile-time shape checking
   - @device(.auto) for CPU/CUDA/Metal

When to use: When you write nearly-identical code with minor variations
Never use: Single instance code, or when you need runtime flexibility
]],
        "when to use derive" = [[
USE @comp.derive.* WHEN:
- You have regular data structures with repeating patterns
- You need type-safe accessors without typing them all
- The structure is stable (fields don't change often)

EXAMPLE:
Before (manual):
```duo
fun user_get_id(u: User): i64
    u.id
end
fun user_get_name(u: User): str
    u.name
end
-- repeat for all types and fields...
```

After (exponential):
```duo
@comp.derive.all(User, Post, Comment)
-- ONE LINE generates all getters/setters for 3 types
```
]],
        "how map differs from regular function" = [[
@comp.MAP IS DIFFERENT FROM A REGULAR FUNCTION:

Regular function:
- One compile-time → one runtime call
- Must be called N times for N types

@comp.map:
- One declaration → N specialized native functions
- Each type gets optimized native code
- No runtime dispatch, no lua_Value

Example:
@comp.map(i32, i64, f32, f64, abs)
→ 4 native functions tailored for each type
→ No branching, no boxing, full optimization
]],
    }
    
    if question == "" or question == nil
        return { guidance = questions["what is exponential metaprogramming"], question = question }
    end
    
    q_lower = string.lower(question)
    for key, val in questions
        if string.find(q_lower, string.lower(key), 1, true) ~= nil
            return { guidance = val, question = question, matched = key }
        end
    end
    
    { error = "Question not recognized. Try: " .. table.concat({k for k in questions}, ", ") }
end

fun combinator_info(path: str): any
    result = {
        map = {
            name = "@comp.map",
            complexity = "O(n types × fields per type)",
            description = "Transform all types in a collection with a single callback",
            native_fold = true,
            example = [[
                fun add_one(x: i64): i64
                    x + 1
                end
                
                -- Generates specialized add_one for i32, i64, f32, f64
                @comp.map(i32, i64, f32, f64, add_one)
            ]],
        },
        ["derive.all"] = {
            name = "@comp.derive.all",
            complexity = "O(n types × fields per type)",
            description = "Auto-generate getters, setters, and methods for all fields",
            native_fold = true,
            example = [[
                concept User
                    id: i64
                    name: str
                end
                
                -- Generates: get_id, get_name, set_id, set_name for User
                @comp.derive.all(User)
            ]],
        },
        tensor = {
            name = "@comp.tensor",
            complexity = "O(n dimensions)",
            description = "Tensor operations with compile-time shape checking",
            native_fold = true,
            device_dispatch = true,
            example = [[
                T = @comp.tensor([256, 256], f32)
                result = @comp.tensor.matmul(T, T)  -- Native BLAS
            ]],
        },
        ladder = {
            name = "@comp.ladder",
            complexity = "O(1) string output",
            description = "Returns the exponential metaprogramming hierarchy",
            example = [[
                print(@comp.ladder())
                -- Output: map:O(n) derive:O(n×f) tensor:O(n³) ...
            ]],
        },
    }
    
    if path == "" or path == nil
        return { combinators = table.keys(result), info = "Available combinators: " .. table.concat(table.keys(result), ", ") }
    end
    
    if result[path]
        return result[path]
    end
    
    { error = "Unknown combinator: " .. path .. ". Available: " .. table.concat(table.keys(result), ", ") }
end

-- ====================================

fun file_finding(kind: str, title: str, detail: str, priority: str, files: str): str
    -- IDs must be unique within a second (batch calls share os.time()); use a
    -- per-process counter so same-second filings never collide.
    finding_seq = finding_seq + 1
    ts = os.date("!%Y-%m-%dT%H:%m:%SZ")
    id = "F-" .. tostring(os.time() % 100000) .. "-" .. tostring(finding_seq)
    pr = priority
    if pr == "" or pr == nil then pr = "P1" end
    row = "| " .. id .. " | " .. title .. " | " .. pr .. " | " .. kind .. " | " .. ts .. " | open | " .. detail .. " |"
    if files ~= "" then row = row .. " Files: " .. files .. " |" end
    content = coordination_read()
    hdr = "| ID | Title | Priority | Kind | Logged | Status | Detail |"
    -- Use plain=true (literal) finds: the marker contains '-', the detail may
    -- contain '%', both of which are Lua-pattern metacharacters and would
    -- corrupt a pattern-based find/gsub.
    mpos = string.find(content, gapsmarker, 1, true)
    if mpos ~= nil then
        hpos = string.find(content, hdr, mpos, true)
        if hpos ~= nil then
            hlen = string.len(hdr)
            content = string.sub(content, 1, hpos + hlen - 1) .. "\n" .. row .. string.sub(content, hpos + hlen)
        else
            content = content .. "\n" .. row .. "\n"
        end
    else
        content = content .. "\n\n" .. gapsmarker .. "\n\n" .. hdr .. "\n| --- | --- | --- | --- | --- | --- | --- |\n" .. row .. "\n"
    end
    std.fs.write_file(coordpath, content)
    "ok: filed " .. id .. " (" .. kind .. ")"
end

-- === GAP NUMBER ALLOCATION ============================================
--
-- `gaps/` is a shared numeric registry with no allocator. Every session read
-- the directory, picked "the next one", and wrote it — so two sessions that
-- read before either wrote both picked the same number. That is not
-- hypothetical: GAP-065 was filed, overwritten by another session, and had to
-- be refiled as GAP-067; three collisions landed in a single night.
--
-- The fix is to stop ASKING for a number and start being HANDED one. The
-- atomic primitive is mkdir(2): POSIX guarantees that when two processes
-- mkdir the same path, exactly one returns 0 and the other gets EEXIST.
-- Winning the mkdir IS the allocation. No lock is taken, so there is no lock
-- to race, no lock to leak, and no stale-lock heuristic to get wrong.
--
-- A reservation directory is never removed. Leaking a number costs nothing;
-- reusing one is the bug this exists to prevent.

gapsdir = root .. "/gaps"
gapledger = root .. "/.agents/session/gapalloc"

fun gap_pad(n: int): str
    s = n:to(str)
    while string.len(s) < 3
        s = "0" .. s
    end
    s
end

-- Highest number VISIBLE anywhere: filed gaps and prior reservations both
-- count. Seeding from the union is what stops the allocator from walking up
-- from 1 and colliding with a gap somebody filed by hand.
fun gap_high(): int
    hi = 0
    for _, name in std.fs.read_dir(gapsdir) or {}
        d = string.match(name, "^GAP%-(%d+)")
        if d ~= nil
            v = tonumber(d) or 0
            if v > hi then hi = v end
        end
    end
    for _, name in std.fs.read_dir(gapledger) or {}
        d = string.match(name, "^GAP%-(%d+)")
        if d ~= nil
            v = tonumber(d) or 0
            if v > hi then hi = v end
        end
    end
    hi
end

-- Hand back a number nobody else can be holding. Returns -1 only if 512
-- consecutive numbers are all taken, which means something is very wrong.
fun gap_allocate(): int
    std.fs.mkdirall(gapledger)
    n = gap_high() + 1
    tries = 0
    while tries < 512
        -- THE ATOMIC STEP. Exactly one concurrent caller sees true here.
        if std.os.mkdir(gapledger .. "/GAP-" .. gap_pad(n))
            -- Won the reservation. If a gap file already occupies the number
            -- (filed by hand, before this allocator existed), keep the
            -- reservation so it is never handed out, and take the next.
            if not std.fs.exists(gapsdir .. "/GAP-" .. gap_pad(n) .. ".md")
                return n
            end
        end
        n = n + 1
        tries = tries + 1
    end
    -1
end

fun gap_open(agent_id: str, kind: str, title: str, detail: str, priority: str, files: str): str
    n = gap_allocate()
    if n < 0
        return std.json.encode({ allocated = false, error = "no free gap number in 512 tries" })
    end
    id = "GAP-" .. gap_pad(n)
    ts = os.date("!%Y-%m-%dT%H:%m:%SZ")
    pr = priority
    if pr == nil or pr == "" then pr = "P1" end
    body = "# " .. id .. " — " .. title .. "\n\n"
        .. "**Status:** OPEN · **Filed:** " .. ts .. "\n"
        .. "**Priority:** " .. pr .. " · **Kind:** " .. kind .. "\n"
        .. "**Filed by:** " .. agent_id .. "\n"
    if files ~= nil and files ~= ""
        body = body .. "**Files:** " .. files .. "\n"
    end
    body = body .. "\n" .. detail .. "\n"
    std.fs.write_file(gapsdir .. "/" .. id .. ".md", body)
    file_finding(kind, id .. " — " .. title, detail, pr, files)
    std.json.encode({ allocated = true, gap_id = id, number = n, path = "gaps/" .. id .. ".md", priority = pr })
end

-- === FILE-PATH CLAIMS =================================================
--
-- Claims used to be per-FEATURE, which is why one session's bare `git commit`
-- kept swallowing another's in-flight edits: two agents "working on different
-- features" were writing the same files. Partition by FILE.
--
-- Same primitive as gap allocation: the claim directory IS the lock, created
-- with mkdir(2), so the exact-path case admits exactly one holder with no
-- read-then-write window.
--
-- Overlap (a claim on `tools/` vs a claim on `tools/mcp/x.duo`) cannot be
-- decided by one mkdir, so it is handled by ACQUIRE-THEN-VERIFY: take the
-- exact lock, then look for a live overlapping claim, and if one is there,
-- release and report a conflict. Whoever observes the overlap backs off
-- UNCONDITIONALLY. That can never double-grant — for both callers to see a
-- clear scan, both scans would have to precede both mkdirs, and each caller
-- scans strictly after its own mkdir. It can conservatively refuse both,
-- which a retry resolves; refusing twice is safe, granting twice is not.

claimsdir = root .. "/.agents/session/claims"
claimttl = 14400

-- Repo-relative, no leading "./", no trailing "/". Two spellings of one file
-- must produce one key or the lock protects nothing.
fun claim_norm(p: str): str
    s = p or ""
    if string.sub(s, 1, string.len(root)) == root
        s = string.sub(s, string.len(root) + 1)
    end
    while string.sub(s, 1, 1) == "/" or string.sub(s, 1, 2) == "./"
        if string.sub(s, 1, 1) == "/"
            s = string.sub(s, 2)
        else
            s = string.sub(s, 3)
        end
    end
    while string.len(s) > 1 and string.sub(s, string.len(s)) == "/"
        s = string.sub(s, 1, string.len(s) - 1)
    end
    s
end

-- "/" is not legal in a directory name; "~" is not legal in a repo path here.
fun claim_key(p: str): str
    string.gsub(p, "/", "~")
end

fun claim_unkey(k: str): str
    string.gsub(k, "~", "/")
end

-- Does one claim cover the other? Prefix comparison at a SEGMENT boundary:
-- "tools/mcp" covers "tools/mcp/x.duo" but must not cover "tools/mcpx.duo".
fun claim_overlaps(a: str, b: str): bool
    if a == b then return true end
    if string.sub(b, 1, string.len(a) + 1) == a .. "/" then return true end
    if string.sub(a, 1, string.len(b) + 1) == b .. "/" then return true end
    false
end

fun claim_meta(key: str): any
    raw = std.fs.read_file(claimsdir .. "/" .. key .. "/owner")
    if raw == nil or raw == "" then return nil end
    owner = string.match(raw, "^([^\t]*)")
    tsv = string.match(raw, "^[^\t]*\t([^\t\n]*)")
    wi = string.match(raw, "^[^\t]*\t[^\t]*\t([^\t\n]*)")
    { owner = owner or "", at = tonumber(tsv) or 0, work = wi or "" }
end

fun claim_live(key: str): bool
    m = claim_meta(key)
    if m == nil then return false end
    (os.time() - m.at) < claimttl
end

fun claim_write(key: str, owner: str, work: str): void
    std.fs.write_file(claimsdir .. "/" .. key .. "/owner",
        owner .. "\t" .. to(str)(os.time()) .. "\t" .. work .. "\n")
end

-- NOT `std.fs.remove` + `std.fs.rmdir`. `std.fs.remove` is written
-- `os.remove(path) ~= nil`, and `false ~= nil` is TRUE, so it reports success
-- unconditionally — measured 2026-08-08: it returned true on a file that was
-- still on disk and still read back its old contents afterwards. A release
-- that lies leaves a lock nobody can clear, which is worse than no lock at
-- all. Drop the whole claim directory in one shot and VERIFY BY VALUE that
-- the metadata is gone before reporting anything.
fun claim_drop(key: str): bool
    dir = claimsdir .. "/" .. key
    os.execute("rm -rf '" .. string.gsub(dir, "'", "'\\''") .. "'")
    claim_meta(key) == nil
end

fun dev_claim_acquire(owner: str, file: str, client: str, work_item: str): str
    std.fs.mkdirall(claimsdir)
    path = claim_norm(file)
    if path == ""
        return std.json.encode({ granted = false, reason = "empty file path" })
    end
    key = claim_key(path)
    wi = work_item or ""
    own = owner or "agent"

    -- THE ATOMIC STEP for the exact path.
    got = std.os.mkdir(claimsdir .. "/" .. key)
    if not got
        m = claim_meta(key)
        if m ~= nil and m.owner == own
            -- Re-entrant: same owner, refresh the lease rather than deadlock
            -- against itself.
            claim_write(key, own, wi)
            return std.json.encode({ granted = true, path = path, owner = own, reentrant = true })
        end
        if m ~= nil and (os.time() - m.at) >= claimttl
            claim_drop(key)
            got = std.os.mkdir(claimsdir .. "/" .. key)
        end
        if not got
            holder = "unknown"
            if m ~= nil then holder = m.owner end
            return std.json.encode({ granted = false, path = path, held_by = holder, reason = "file already claimed" })
        end
    end
    claim_write(key, own, wi)

    -- ACQUIRE-THEN-VERIFY: now look for a live claim that covers, or is
    -- covered by, this path.
    for _, other in std.fs.read_dir(claimsdir) or {}
        if other ~= key
            op = claim_unkey(other)
            if claim_overlaps(path, op) and claim_live(other)
                om = claim_meta(other)
                oo = "unknown"
                if om ~= nil then oo = om.owner end
                claim_drop(key)
                return std.json.encode({ granted = false, path = path, overlaps = op, held_by = oo, reason = "overlapping claim" })
            end
        end
    end
    std.json.encode({ granted = true, path = path, owner = own, work_item = wi, ttl = claimttl })
end

fun dev_claim_release(owner: str, file: str): str
    path = claim_norm(file)
    key = claim_key(path)
    m = claim_meta(key)
    if m == nil
        return std.json.encode({ released = false, path = path, reason = "no such claim" })
    end
    if m.owner ~= owner
        return std.json.encode({ released = false, path = path, held_by = m.owner, reason = "not the holder" })
    end
    -- NOT `gone = claim_drop(key)` then encode: binding a bool-returning call
    -- to a local inside a `: str` function makes the compiler report
    -- "return type mismatch: expected 'str', got 'bool'" and emit a module
    -- that dies on first call. Branch on the call instead.
    if claim_drop(key)
        return std.json.encode({ released = true, path = path })
    end
    std.json.encode({ released = false, path = path, reason = "release did not clear the claim" })
end

fun dev_claim_files(): str
    rows = {}
    for _, key in std.fs.read_dir(claimsdir) or {}
        m = claim_meta(key)
        if m ~= nil
            rows[#rows + 1] = {
                path = claim_unkey(key),
                owner = m.owner,
                work_item = m.work,
                age = os.time() - m.at,
                live = (os.time() - m.at) < claimttl,
            }
        end
    end
    std.json.encode({ claims = rows, count = #rows, ttl = claimttl })
end

fun agent_gaps_update(action: str, agent_id: str, gap_id: str, kind: str, title: str, detail: str, priority: str, files: str): str
    act = action
    if act == nil or act == "" then act = "open" end
    if act == "open"
        -- `open` ALLOCATES. The caller does not supply gap_id and cannot;
        -- that is the whole point.
        return gap_open(agent_id, kind, title, detail, priority, files)
    end
    ts = os.date("!%Y-%m-%dT%H:%m:%SZ")
    entry = "\n| " .. ts .. " | " .. agent_id .. " | gap-" .. act .. " | " .. gap_id .. ": " .. detail .. " |"
    content = coordination_read()
    marker = "### Findings log (append-only, newest first)"
    table_marker = "| UTC | Agent | Action | Detail |\n| --- | --- | --- | --- |"
    mpos = string.find(content, marker, 1, true)
    if mpos ~= nil
        hpos = string.find(content, table_marker, mpos, true)
        if hpos ~= nil
            content = string.sub(content, 1, hpos + string.len(table_marker) - 1) .. entry .. string.sub(content, hpos + string.len(table_marker))
        else
            content = content .. entry .. "\n"
        end
    else
        content = content .. "\n\n" .. marker .. "\n\n" .. table_marker .. entry .. "\n"
    end
    std.fs.write_file(coordpath, content)
    "ok: gap " .. act .. " " .. gap_id
end


