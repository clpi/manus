src = "fun add_i32(a: i32, b: i32): i32 a + b end\nfun add_i64(a: i64, b: i64): i64 a + b end"
src2 = src .. "\n"
print("total_len=" .. string.len(src2))

-- Print bytes around position 42-44
for i = 41, 46 do
    print("byte[" .. i .. "]=" .. string.byte(src2, i) .. " char=" .. string.sub(src2, i, i))
end

-- Find first \n
p1, p2 = string.find(src2, "\n", 1, true)
print("first_nl at " .. tostring(p1) .. "-" .. tostring(p2))

-- Find second \n
p3, p4 = string.find(src2, "\n", p2 + 1, true)
print("second_nl at " .. tostring(p3) .. "-" .. tostring(p4))

-- Find third \n
p5, p6 = string.find(src2, "\n", p4 + 1, true)
print("third_nl at " .. tostring(p5) .. "-" .. tostring(p6))

-- Direct gmatch with pattern ([^\n]*)
count = 0
for ln in string.gmatch(src2, "([^\n]*)") do
    count = count + 1
    if count <= 5 then print("split[" .. count .. "]=[" .. ln .. "]") end
end
print("split_total=" .. count)
