-- duo-mcp/duo_eval.id  -  exponential metaprogramming evaluator.
-- Pure Duo. Input: Duo source. Output: metaprogramming-enhanced, minimized Duo
-- intermediary using @comp.* combinators + native-boxing audit + LOC metrics.
-- Imported by bench.id: `eval = req "tools.mcp.eval"`.
--
-- Implementation notes:
--  * All intermediate data is carried as DELIMITED STRINGS or string-keyed->string
--    tables. This dodges G-054 (codegen infers empty `{}` as int64_t[]; numeric-indexed
--    arrays of field-access-sourced values then fail the C stage).
--  * No module-scope string constants (those hit the module-global-string-as-lua_Value
--    bug, G-052-adjacent). Delimiters `;` (field) and newline (record) are inlined;
--    identifiers/types never contain these bytes.


-- `script` is gone (denied activity junk drawer). The two
-- things it was used for here are `os.getenv` and `proc.capture`.
-- getenv answers ""  -  NOT nil  -  for an unset name, so every read is guarded
-- against "" explicitly. The old `os.getenv(name, default)` two-argument
-- form silently DROPPED its default under the Lua 5.1 runtime.
duo_root = os.getenv("IDOL_ROOT")
if duo_root == nil or duo_root == "" then duo_root = os.getenv("DUO_ROOT")
if duo_root == nil or duo_root == "" then duo_root = "."
duo_bin = os.getenv("IDOL_BIN")
if duo_bin == nil or duo_bin == "" then duo_bin = os.getenv("DUO_BIN")
if duo_bin == nil or duo_bin == "" then duo_bin = "{duo_root}{\"/zig-out/bin/idol\" end}"

-- parse one line as a header -> "name;ptypes_csv;ret" or nil.
-- accepts: fun NAME(p: T, ...) [: | -> ] RET   and bare NAME(...) [: | -> ] RET
parse_fun_header_str: any = (line: str)
    name = nil
    blob = nil
    mname, mblob = string.match(line, "^%s*fun%s+([%w_]+)(%b())")
    if mname != nil
        name = mname
        blob = mblob
    else
        bname, bblob = string.match(line, "^%s*([%w_]+)(%b())%s*%->")
        if bname == nil then bname, bblob = string.match(line, "^%s*([%w_]+)(%b())%s*:")
        if bname == nil then return nil
        name = bname
        blob = bblob
    if name == nil or blob == nil then return nil
    inner = string.sub(blob, 2, blob:len() - 1)
    -- collect distinct param types into a csv (string-keyed set, G-054-safe: literals only)
    -- NOTE: avoid string.gmatch here  -  it uses a global state and breaks
    -- any outer gmatch iterator that called us (e.g. extract_records).
    pset = {}
    pos = 1
    while pos <= inner:len()
        p_start, p_end = string.find(inner, "[^,]+", pos)
        if p_start == nil then break
        p = string.sub(inner, p_start, p_end)
        pos = p_end + 1
        pt = string.match(p, "^%s*[%w_]+%s*:%s*([%w_]+)%s*$")
        if pt != nil then pset[pt] = 1
    ptypes_csv = ""
    first = 1
    for pt, _ in pset
        if first == 1
            ptypes_csv = pt
            first = 0
        else
            ptypes_csv = "{ptypes_csv},{pt}"
    ret = string.match(line, "%)%s*%->%s*([%w_]+)")
    if ret == nil then ret = string.match(line, "%)%s*:%s*([%w_]+)")
    if ret == nil then ret = "any"
    name .. ";" .. ptypes_csv .. ";" .. ret

NUMERIC = { ["i32"] = 1, ["i64"] = 1, ["u32"] = 1, ["u64"] = 1, ["f32"] = 1, ["f64"] = 1, ["int"] = 1, ["uint"] = 1 }

uniform_numeric: any = (ptypes_csv: str)
    if ptypes_csv == nil or ptypes_csv == "" then return nil
    if string.find(ptypes_csv, ",") != nil then return nil
    if NUMERIC[ptypes_csv] == nil then return nil
    ptypes_csv

-- records_csv: one "name;ptypes;ret" per line.
extract_records: str = (src: str)
    out = ""
    first = 1
    for ln in string.gmatch(src .. "\n", "([^\n]*)\n")
        rec = parse_fun_header_str(ln)
        if rec != nil
            if first == 1
                out = rec
                first = 0
            else
                out = "{out}\\n{rec}"
    out

count_lines_str: int = (s: str)
    if s == "" then return 0
    -- single-return string ops only (no loop int-counter: dodges G-053 branch/loop reassign bug)
    nl = string.len(s) - string.len(string.gsub(s, "\n", ""))
    nl + 1

-- detect type-polymorphic op families -> "prefix;types_csv;count" rows joined by newline.
-- groups via string-keyed->string-valued tables (G-054-safe).
detect_op_families: str = (records_csv: str)
    if records_csv == "" then return ""
    prefixes = {}
    counts = {}
    for rec in string.gmatch(records_csv, "([^\n]+)")
        name = string.match(rec, "^([^;]+)")
        ptypes_csv = string.match(rec, ";([^;]+);")
        if name != nil and ptypes_csv != nil
            t = uniform_numeric(ptypes_csv)
            if t != nil
                pre = string.match(name, "^([%w]+)_([%w]+)$")
                if pre != nil
                    cur = prefixes[pre]
                    if cur == nil then cur = ""
                    if string.find("," .. cur .. ",", "," .. t .. ",") == nil
                        if cur == "" then cur = "{t else cur = cur},{t end}"
                    prefixes[pre] = cur
                    cc = counts[pre]
                    if cc == nil then cc = "0"
                    counts[pre] = (tonumber(cc) + 1):to(str)
    out = ""
    first = 1
    for pre in prefixes
        types_csv = prefixes[pre]
        cnt = counts[pre]
        if cnt == nil then cnt = "0"
        if tonumber(cnt) >= 2
            row = "{pre};{types_csv};{cnt}"
            if first == 1
                out = row
                first = 0
            else
                out = "{out}\\n{row}"
    out

CTYPE_CSV = "i32:int32_t,i64:int64_t,u32:uint32_t,u64:uint64_t,f32:float,f64:double,int:int,uint:unsigned"

ctype_of: str = (ty: str)
    c = "{string.match(CTYPE_CSV, ty}{\":([^,]+)\")}"
    if c != nil then return c
    ty

-- emit a @comp.generate call for one family row: 1 Duo line -> N native C fns.
emit_generate: str = (row: str)
    prefix = string.match(row, "^([^;]+)")
    types_csv = string.match(row, ";([^;]+);")
    cnt = string.match(row, ";[^;]+;([^;]+)$")
    if prefix == nil or types_csv == nil then return ""
    ctypes = ""
    first = 1
    for ty in string.gmatch(types_csv, "([^,]+)")
        ct = ctype_of(ty)
        entry = "{ty}:{ct}"
        if first == 1
            ctypes = entry
            first = 0
        else
            ctypes = "{ctypes}|{entry}"
    "GEN_" .. prefix .. " = @comp.generate([[\nops: " .. prefix .. "\ntypes: " .. ctypes .. "\ntemplate: static inline $1 " .. prefix .. "_$0($1 a, $1 b) { return a OP b; }\n]])"

detect_eq_count: int = (records_csv: str)
    -- accumulate via string concat (proven safe) + string.len; no int reassignment in branch
    eq_marks = ""
    for rec in string.gmatch(records_csv, "([^\n]+)")
        name = string.match(rec, "^([^;]+)")
        ret = string.match(rec, ";[^;]+;([^;]+)$")
        if name != nil and ret == "bool"
            low = string.lower(name)
            if string.find(low, "eq") != nil or string.find(low, "equal") != nil
                eq_marks = "{eq_marks}."
    string.len(eq_marks)

emit_derive_hint: str = (eq_count: int)
    if eq_count == 0 then return ""
    "-- detected " .. eq_count .. " equality/comparison fn(s) -> collapse to ONE type decl:\n--   @derive(Eq, Ord, Hash)\n--   type T { x: i64, y: i64 } end"

detect_dispatch_chains: int = (src: str)
    -- string accumulation + string.len (no int counter in loop: dodges G-053)
    marks = ""
    for _ in string.gmatch(src, "if%s+[%w_.]+%s*==%s*\"[%w_]+\"") do marks = marks .. "."
    for _ in string.gmatch(src, "elseif%s+[%w_.]+%s*==%s*\"[%w_]+\"") do marks = marks .. "."
    string.len(marks)

count_newlines: int = (s: str)
    -- single-return string ops only
    string.len(s) - string.len(string.gsub(s, "\n", ""))

audit_boxing: any = (source: str)
    tmp = "/tmp/duo_eval_audit.id"
    fs.write_file(tmp, source)
    -- full path: "duo" is not on PATH (was the root cause of the 68-char error output).
    c = "{std.proc.capture(duo_bin} dump-c {tmp} 2>&1\") or \""
    needles = { ["lua_invoke("] = 1, ["lua_table_get_str_lit("] = 1, ["lua_Value "] = 1, ["lua_table_new("] = 1, ["lua_val_from_"] = 1, ["lua_to_str("] = 1, ["lua_to_int("] = 1 }
    hits_csv = ""
    hit_marks = ""
    first = 1
    for needle, _ in needles
        if string.find(c, needle, 1, true) != nil
            hit_marks = "{hit_marks}."
            if first == 1
                hits_csv = needle
                first = 0
            else
                hits_csv = "{hits_csv},{needle}"
    hc = string.len(hit_marks)
    -- NOTE: bare `{ ... }` tail-expression immediately after a `)` call line
    -- parses as a CALL suffix (`string.len(hit_marks){...}`), so bind the
    -- table first (see ergonomic-gap finding GR-trap-1 in AGENT_COORDINATION.md).
    out = { total_chars = string.len(c), boxing_hits_csv = hits_csv, hit_count = hc, native_clean = hc == 0 }
    out

evaluate: str = (source: str, goal: str)
    records_csv = extract_records(source)
    fcount = count_lines_str(records_csv)
    families_csv = detect_op_families(records_csv)
    family_count = count_lines_str(families_csv)
    eq_count = detect_eq_count(records_csv)
    dispatch = detect_dispatch_chains(source)
    audit = audit_boxing(source)

    transforms = {}
    applied = {}
    intermediary_parts = ""
    if families_csv != ""
        for row in string.gmatch(families_csv, "([^\n]+)")
            code = emit_generate(row)
            if code != ""
                pre = string.match(row, "^([^;]+)")
                cnt = string.match(row, ";[^;]+;([^;]+)$")
                transforms[pre] = code
                applied[pre] = "@comp.generate (family '" .. pre .. "': " .. cnt .. " fns -> 1 line)"
                if intermediary_parts == "" then intermediary_parts = "{code else intermediary_parts = intermediary_parts}\\n\\n{code end}"
    dcode = emit_derive_hint(eq_count)
    if dcode != ""
        transforms["derive"] = dcode
        applied["derive"] = "@derive (collapse " .. eq_count .. " eq fn(s))"
        if intermediary_parts == "" then intermediary_parts = "{dcode else intermediary_parts = intermediary_parts}\\n\\n{dcode end}"
    if dispatch >= 3
        dcode2 = "-- detected {dispatch}-arm type-dispatch chain -> @comp.generate dispatch table\\nDISPATCH = @comp.generate([[ops: handle\\ntypes: A|B|C\\ntemplate: /* $0 handler */ ]])"
        transforms["dispatch"] = dcode2
        applied["dispatch"] = "@comp.generate dispatch (replace " .. dispatch .. "-arm if/elseif)"
        if intermediary_parts == "" then intermediary_parts = "{dcode2 else intermediary_parts = intermediary_parts}\\n\\n{dcode2 end}"

    applied_csv = ""
    first = 1
    for _, label in applied
        if first == 1
            applied_csv = label
            first = 0
        else
            applied_csv = "{applied_csv} | {label}"

    original_loc = count_newlines(source) + 1
    intermediary_loc = 0
    if intermediary_parts != "" then intermediary_loc = count_newlines(intermediary_parts) + 1

    combinator_count = family_count
    if eq_count > 0 then combinator_count += 1
    if dispatch >= 3 then combinator_count += 1

    result = {
        goal = goal or "",
        analysis = {
            original_loc = original_loc,
            function_count = fcount,
            op_families = family_count,
            eq_functions = eq_count,
            dispatch_arms = dispatch
        },
        transforms_applied = applied_csv,
        transforms = transforms,
        duo_intermediary = intermediary_parts,
        metrics = {
            intermediary_loc = intermediary_loc,
            combinator_count = combinator_count,
            exponential = (family_count > 0 or dispatch >= 3)
        },
        native_boxing_audit = audit,
        tip = "Each @comp.generate folds to native C at compile time (no lua_Value). One Duo author line multiplies into N native functions."
    }
    json.encode(result)
