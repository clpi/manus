-- tools/mcp/mcp_audit.id — standalone native-boxing audit over the
-- metaprogramming showcases. Run from the repo root:
--   duo run tools/mcp/mcp_audit.id
--
-- This duplicates duo_bench.id's `duo_audit_metaprogramming_smokes` tool and
-- nothing in the repo references it. It is kept only as a way to run that
-- audit without an MCP client; it is a fair deletion candidate.
--
-- It carried three defects until 2026-08-08 and could not have run at all:
-- `req "duo_shared"` (bare, so it resolved only with cwd = tools/mcp), plus
-- unused `std.mcp` and `std.script` imports.
shared = req "tools.mcp.id_shared"

paths = {
    "examples/meta_template_showcase.id",
    "examples/meta_generate_showcase.id",
    "examples/meta_scheme_showcase.id",
    "examples/meta_grammar_showcase.id",
    "examples/meta_weave_showcase.id",
    "examples/meta_power_permute_showcase.id",
    "examples/meta_choose_showcase.id",
}
passed = 0
failed = 0
for i = 1, #paths
    r = shared.audit_native_boxing(paths[i])
    if r.pass then passed = passed + 1 else failed = failed + 1 end
    print(paths[i] .. ": pass=" .. tostring(r.pass) .. " violations=" .. tostring(r.comptime_violation_count))
end
print("Passed: " .. tostring(passed) .. ", Failed: " .. tostring(failed))
