s = "fun add_i32(a: i32, b: i32): i32 a + b end\nfun add_i64(a: i64, b: i64): i64 a + b end"
print("len=" .. string.len(s))

-- Check bytes around the newline
for i = 42, 44 do
    print("byte[" .. i .. "]=" .. string.byte(s, i))
end

-- gmatch with simple pattern
count = 0
for ln in string.gmatch(s, "([^\n]+)\n") do
    count = count + 1
    print("got[" .. count .. "]=[" .. ln .. "]")
end
print("count=" .. count)

-- Also try: explicit match calls
m1 = string.match(s, "([^\n]+)\n")
print("match1=[" .. tostring(m1) .. "]")
s2 = string.sub(s, #m1 + 2)
m2 = string.match(s2, "([^\n]+)\n")
print("match2=[" .. tostring(m2) .. "]")
