#!/usr/bin/env duo
-- duo-mcp/duo_lsp.id — MCP server: language intelligence, @comp.* catalog, diagnostics.
-- Pure Duo (replaces duo_lsp_mcp.py). Run from the Duo repo root:
--   duo run <DUO_ROOT>/tools/mcp/duo_lsp.id

-- EVERY `req` LIVES HERE, AT FILE SCOPE, AND MUST STAY HERE — a `req` in a
-- tool handler binds a local its nested closures try to capture, and Duo has
-- no closure capture, so lowering emits an undeclared C identifier and the
-- server never builds. Sibling modules are spelled from the PROJECT root
-- (`tools.mcp.x`): `req` resolves at compile time against the tree above the
-- source file, so a bare name only worked with cwd = tools/std.mcp.
--
-- `std.script` is gone: it is the denied activity junk drawer (Pass 100 §15).
-- Its uses here were fs reads/writes and popen captures, which are std.fs and
-- std.proc; lock-taking work belongs to duo_shared.
--
-- STD IS THE PRELUDE GRAPH (Pass 118 §0h): no module tree, no import. std
-- descriptors are referenced DIRECTLY — `std.mcp.register_tool`,
-- `std.fs.exists`, `std.json.encode`, `std.os.getenv` — which was verified to
-- work from inside a tool handler before this file stopped importing them.
-- `req "std.x"` is migration debt against that rule; the `req` left here
-- names a PROJECT module, which is not std and does still need one.
shared = req "tools.mcp.shared"
clock = req "lib.clock"

-- DUO_ROOT as a VALUE at file scope, not a helper function: a named
-- file-scope function called from a handler lowers to an upvalue call Duo
-- cannot make. `std.os.getenv` answers "" — never nil — for an unset name.
root = std.os.getenv("DUO_ROOT")
if root == nil or root == ""
    root = std.os.getenv("PWD")
end
if root == nil or root == ""
    root = "."
end

-- Static @comp.* catalog (from meta_module.zig, should be auto-generated).
--
-- KNOWN BROKEN, and NOT a regression from the std.script removal: the only
-- two handlers that read this table — `duo_meta_catalog` and
-- `duo_complexity` — send NO response at all and the server then exits 0.
-- They are registered, they appear in tools/list, and calling either one
-- silently ends the session. Moving the table into duo_shared as a module
-- export was tried and did not change the behaviour, so the fault is in the
-- two handlers, not in where the table lives. `zig build mcp-gate` asserts
-- the 30 tools that DO answer; these two are the outstanding work.
META_CATALOG = {
    map =              { kind = "expression", internal = "__comptimemap",    scaling = "O(types)" },
    sweep =            { kind = "expression", internal = "__comptimemap",    scaling = "O(types)" },
    expand =           { kind = "expression", internal = "__metaexpand",     scaling = "O(n×f)" },
    ceiling =          { kind = "expression", internal = "__metaceiling",    scaling = "O(n×f)+O(n²×f)" },
    omni =             { kind = "expression", internal = "__metaomni",       scaling = "ceiling + sweep" },
    burst =            { kind = "expression", internal = "__metaburst",      scaling = "O(n²×f)" },
    tensor =           { kind = "expression", internal = "__comptimetensor", scaling = "O(n³)" },
    derive =           { kind = "expression", internal = "__derivemap",      scaling = "O(types × fields)" },
    nfold =            { kind = "expression", internal = "__comptimenfold",  scaling = "O(types^k)" },
    transcend =        { kind = "expression", internal = "__metatranscend",  scaling = "O(n³×f)" },
    infinity =         { kind = "expression", internal = "__metainfinity",   scaling = "O(n⁴×f)" },
    hyper =            { kind = "expression", internal = "__metahyper",      scaling = "O(n⁵×f)" },
    tower =            { kind = "expression", internal = "__derivetower",    scaling = "O(n^k×f), k≤16" },
    product =          { kind = "expression", internal = "__comptimeproduct",scaling = "O(n²)" },
    ["derive.product"] ={ kind = "expression", internal = "__deriveproduct",scaling = "O(n²×f)" },
    power =            { kind = "expression", internal = "__comptimepower",  scaling = "O(2^n)" },
    permute =          { kind = "expression", internal = "__comptimepermute",scaling = "O(n!)" },
    choose =           { kind = "expression", internal = "__comptimechoose", scaling = "O(n choose k)" },
    ["derive.choose"] ={ kind = "expression", internal = "__derivechoose",   scaling = "O(n choose k × fields)" },
    grammar =          { kind = "expression", internal = "__metagrammar",    scaling = "O(b^d)" },
    weave =            { kind = "expression", internal = "__metaweave",      scaling = "O(N×M)" },
    template =         { kind = "expression", internal = "__metatemplate",   scaling = "O(instances)" },
    generate =         { kind = "expression", internal = "__metagenerate",   scaling = "O(ops×types)" },
    scheme =           { kind = "expression", internal = "__metascheme",     scaling = "O(declarations)" },
    each =             { kind = "expression", internal = "__comptimeeach",   scaling = "composition glue" },
    chain =            { kind = "expression", internal = "__comptimeeach",   scaling = "alias of each" },
    ["str.len"] =       { kind = "expression", internal = "__strlen" },
    ["str.eq"] =        { kind = "expression", internal = "__streq" },
    ["str.join"] =      { kind = "expression", internal = "__strjoin" },
    ["str.contains"] =  { kind = "expression", internal = "__strcontains" },
    ["str.countlines"] ={ kind = "expression", internal = "__strcountlines" },
    ["concepts.count"] ={ kind = "expression", internal = "__conceptscount" },
    ["rewrite.describe"]={ kind = "expression", internal = "__rewritedescribe" },
    ["rewrite.rulecount"]={ kind = "expression", internal = "__rewriterulecount" },
    ["agent.catalog"] = { kind = "expression", internal = "__agentcatalog" },
    ["agent.ladder"] =  { kind = "expression", internal = "__agentladder" },
    ["agent.hooks"] =   { kind = "expression", internal = "__agenthooks" },
    ["agent.dedupe"] =  { kind = "expression", internal = "__agentdedupe" },
    ["agent.gaps"] =    { kind = "expression", internal = "__agentgaps" },
    ["agent.grammar"] = { kind = "expression", internal = "__agentgrammar" },
}

-- Tool: duo_diagnostics — run duo check on a file
std.mcp.register_tool("duo_diagnostics", "Get compiler diagnostics for a Duo source file", {
    type = "object",
    properties = {
        file_path = { type = "string", description = "Path to .id file" },
    },
    required = { "file_path" },
}, fun(args)
    output = "{std.proc.capture(shared.idbin} check {args.file_path}{\" 2>&1\")}"
    diags = {}
    for line in string.gmatch(output, "[^\n]+")
        if string.find(line, ": error:") or string.find(line, ": warning:")
            parts = {}
            for p in string.gmatch(line, "[^:]+")
                parts[parts:len() + 1] = p
            end
            severity = "warning"
            if string.find(line, ": error:") then severity = "error" end
            diag = {
                file = parts[1] or "",
                line = tonumber(parts[2]) or 0,
                col = tonumber(parts[3]) or 0,
                severity = severity,
                message = "",
            }
            if parts:len() >= 4 then diag.message = parts[4] else diag.message = line end
            diags[diags:len() + 1] = diag
        end
    end
    std.json.encode({ diagnostics = diags, raw_output = string.sub(output, 1, 5000) })
end)

-- Tool: duo_compile_check — same as diagnostics
std.mcp.register_tool("duo_compile_check", "Run duo check and return parsed diagnostics", {
    type = "object",
    properties = {
        file_path = { type = "string", description = "Path to .id file" },
    },
    required = { "file_path" },
}, fun(args)
    output = "{std.proc.capture(shared.idbin} check {args.file_path}{\" 2>&1\")}"
    diags = {}
    for line in string.gmatch(output, "[^\n]+")
        if string.find(line, ": error:") or string.find(line, ": warning:")
            parts = {}
            for p in string.gmatch(line, "[^:]+")
                parts[parts:len() + 1] = p
            end
            severity = "warning"
            if string.find(line, ": error:") then severity = "error" end
            diags[diags:len() + 1] = {
                file = parts[1] or "",
                line = tonumber(parts[2]) or 0,
                col = tonumber(parts[3]) or 0,
                severity = severity,
                message = parts:len() >= 4 and parts[4] or line,
            }
        end
    end
    std.json.encode({ diagnostics = diags, raw_output = string.sub(output, 1, 5000) })
end)

-- Tool: duo_table_shapes — semantic graph table/enum shape export for agents
std.mcp.register_tool("duo_table_shapes", "Export table_shapes and enum_shapes from duo graph JSON", {
    type = "object",
    properties = {
        file_path = { type = "string", description = "Path to .id file" },
    },
    required = { "file_path" },
}, fun(args)
    -- EXPLICIT `return` in every branch. A handler whose tail expression is a
    -- bare `if … else … end` sends NO RESPONSE AT ALL and ends the session —
    -- measured 2026-08-08 across 7 handlers, all of which were listed by
    -- tools/list and all of which were dead.
    output = "{std.proc.capture(shared.idbin} graph {args.file_path}{\" 2>&1\")}"
    if string.find(output, ": error:") or string.find(output, "sema error") or string.find(output, "parse failed")
        return std.json.encode({ ok = false, error = string.sub(output, 1, 4000), table_shapes = {}, enum_shapes = {} })
    end
    parsed = std.json.decode(output)
    if parsed == nil
        return std.json.encode({ ok = false, error = "failed to parse duo graph JSON", raw_output = string.sub(output, 1, 2000) })
    end
    std.json.encode({
        ok = true,
        file = parsed.file,
        table_shapes = parsed.table_shapes or {},
        enum_shapes = parsed.enum_shapes or {},
        node_count = parsed.nodes and rawlen(parsed.nodes) or 0,
    })
end)

-- Tool: duo_meta_catalog — list all @comp.* constructs
std.mcp.register_tool("duo_meta_catalog", "List all @comp.* / @meta.* constructs", {
    type = "object",
    properties = {
        grouped = { type = "boolean", description = "Group by category" },
    },
}, fun(args)
    if args.grouped
        groups = {
            exponential_combinators = {},
            type_introspection = {},
            bit_intrinsics = {},
            optimization_hints = {},
            string_ops = {},
            agent_hooks = {},
        }
        exp_keys = { map = true, sweep = true, derive = true, product = true, ["derive.product"] = true, tensor = true, nfold = true, ceiling = true, omni = true, burst = true, transcend = true, infinity = true, hyper = true, tower = true, power = true, permute = true, choose = true, ["derive.choose"] = true, grammar = true, weave = true, template = true, generate = true, scheme = true, each = true, chain = true }
        str_keys = { ["str.len"] = true, ["str.eq"] = true, ["str.join"] = true, ["str.contains"] = true, ["str.countlines"] = true }
        agent_keys = { ["agent.catalog"] = true, ["agent.ladder"] = true, ["agent.hooks"] = true, ["agent.dedupe"] = true, ["agent.gaps"] = true, ["agent.grammar"] = true }
        for k, v in META_CATALOG
            if exp_keys[k] then groups.exponential_combinators[k] = v
            elseif str_keys[k] then groups.string_ops[k] = v
            elseif agent_keys[k] then groups.agent_hooks[k] = v
            else groups.type_introspection[k] = v end
        end
        return std.json.encode(groups)
    end
    std.json.encode(META_CATALOG)
end)

-- Tool: duo_meta_ladder — show scaling ladder
std.mcp.register_tool("duo_meta_ladder", "Show the @comp.* scaling ladder O(types) → O(n!)", {
    type = "object",
    properties = {},
}, fun(_args)
    ladder = {
        { name = "map/sweep", scaling = "O(types)", description = "Sweep over types matching a concept" },
        { name = "derive", scaling = "O(types × fields)", description = "Apply derive macro to matching types" },
        { name = "product", scaling = "O(n²)", description = "Cartesian product of type sets" },
        { name = "tensor", scaling = "O(n³)", description = "3D type tensor sweep" },
        { name = "nfold", scaling = "O(types^k)", description = "General n-fold type sweep" },
        { name = "ceiling", scaling = "O(n×f)+O(n²×f)", description = "Derive sweep + cartesian derive product" },
        { name = "omni/stack", scaling = "ceiling + sweep", description = "Ceiling + optional sweep" },
        { name = "burst", scaling = "O(n²×f)", description = "Module: derive.all + quadratic emit" },
        { name = "transcend", scaling = "O(n³×f)", description = "Module: burst + cubic emit" },
        { name = "infinity", scaling = "O(n⁴×f)", description = "Module: transcend + quartic emit" },
        { name = "hyper", scaling = "O(n⁵×f)", description = "Module: infinity + quintic emit" },
        { name = "tower", scaling = "O(n^k×f), k≤16", description = "Generalized derive tower" },
        { name = "power/powerset", scaling = "O(2^n)", description = "Power set sweep" },
        { name = "choose", scaling = "O(n choose k)", description = "Fixed-size subset generation" },
        { name = "permute", scaling = "O(n!)", description = "Permutation sweep" },
        { name = "grammar", scaling = "O(b^d)", description = "Generative: EBNF grammar → code fragments" },
        { name = "weave", scaling = "O(N×M)", description = "Generative: cross-module concept sweep" },
        { name = "template", scaling = "O(instances)", description = "Generative: parametric template expansion" },
        { name = "generate", scaling = "O(ops×types)", description = "Generative: constraint cartesian" },
        { name = "scheme", scaling = "O(declarations)", description = "Generative: declarative scheme" },
        { name = "each", scaling = "composition glue", description = "Split combinator output; chain stages" },
    }
    std.json.encode(ladder)
end)

