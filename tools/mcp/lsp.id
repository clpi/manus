-- Tool: duo_foreign_import_preview — C header → SIM preview (Pass 5 P5-08)
std.mcp.register_tool("duo_foreign_import_preview", "Preview C header import as SIM v0 entities with abi.specialize applied", {
    type = "object",
    properties = {
        header_path = { type = "string", description = "Path to C header (.h)" },
        source_dir = { type = "string", description = "Optional directory for resolving relative includes (defaults to header dirname)" },
    },
    required = { "header_path" },
}, fun(args)
    src_dir = args.source_dir or ""
    if src_dir == "" then
        dir = string.match(args.header_path, "^(.*)/[^/]+$")
        if dir then src_dir = dir end
    end
    std.json.encode(shared.foreign_import_preview(args.header_path, src_dir))
end)

