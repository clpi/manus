end)

-- Tool: duo_audit_metaprogramming_smokes — batch native audit
std.mcp.register_tool("duo_audit_metaprogramming_smokes", "Batch native-boxing audit on generative showcases", {
    type = "object",
    properties = {},
}, fun(_args)
    paths = {
        "examples/meta_template_showcase.id",
        "examples/meta_generate_showcase.id",
        "examples/meta_scheme_showcase.id",
        "examples/meta_grammar_showcase.id",
        "examples/meta_weave_showcase.id",
        "examples/meta_power_permute_showcase.id",
        "examples/meta_choose_showcase.id",
    }
    passed = 0
    failed = 0
    results = {}
    for _, p in paths
        r = shared.audit_native_boxing(p)
        results[results:len() + 1] = r
        if r.pass then passed += 1 else failed += 1 end
    end
    std.json.encode({ total = paths:len(), passed = passed, failed = failed, results = results })
end)

