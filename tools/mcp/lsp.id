-- Tool: duo_complexity — query complexity for any @comp.* path
std.mcp.register_tool("duo_complexity", "Query complexity information for any @comp.* path (e.g., 'comp.map', 'comp.derive.product')", {
    type = "object",
    properties = {
        path = { type = "string", description = "Path to query: comp.map, comp.derive.product, comp.burst, etc." },
    },
    required = { "path" },
}, fun(args)
    -- Static catalog with complexity info
    catalog = META_CATALOG
    
    -- Normalize path
    path = args.path
    if string.find(path, "^comp.") or string.find(path, "^meta.") or string.find(path, "^compiler.")
        -- Strip prefix
        core = path
        if string.find(path, "^comp.") then core = string.sub(path, 5)
        elseif string.find(path, "^meta.") then core = string.sub(path, 5)
        elseif string.find(path, "^compiler.") then core = string.sub(path, 10)
        end
        
        -- Look up in catalog
        entry = catalog[core] or catalog[path]
        if entry
            std.json.encode({
                path = path,
                core = core,
                complexity = entry.scaling or "unknown",
                kind = entry.kind or "unknown",
                category = entry.category or "unknown",
                internal = entry.internal or "",
                suggestions = {
                    next = string.sub(core, 1, 1) == "d" and { "@comp.product", "@comp.derive.product", "@comp.burst" }
                        or string.sub(core, 1, 1) == "p" and { "@comp.tensor", "@comp.derive.product", "@comp.ceiling" }
                        or string.sub(core, 1, 1) == "t" and { "@comp.nfold", "@comp.derive.tensor", "@comp.transcend" }
                        or "@comp.ladder() for full scaling hierarchy"
                }
            })
        end
        return "{std.json.encode({ error = \"Path not found in catalog: \"}{path, suggestion = \"Use duo_meta_catalog() to see all available paths\" })}"
    end
    std.json.encode({ error = "Path must start with comp., meta., or compiler.: " .. path })
end)

-- Tool: duo_next_combinators — suggest next-level combinators
std.mcp.register_tool("duo_next_combinators", "Suggest next-level combinators for a given @comp.* path", {
    type = "object",
    properties = {
        path = { type = "string", description = "Current @comp.* path: comp.map, comp.product, etc." },
    },
    required = { "path" },
}, fun(args)
    path = args.path
    
    -- Normalize
    core = path
    if string.find(path, "^comp.") then core = string.sub(path, 5)
    elseif string.find(path, "^meta.") then core = string.sub(path, 5)
    elseif string.find(path, "^compiler.") then core = string.sub(path, 10)
    end
    
    -- Next-level suggestions based on scaling ladder
    suggestions_map = {
        ["map"] = {
            suggestions = { "@comp.product", "@comp.burst", "@comp.derive.all" },
            explanation = "O(n) → O(n²) or O(n²xf): sweep over pairs of types",
        },
        ["derive"] = {
            suggestions = { "@comp.derive.product", "@comp.product", "@comp.burst" },
            explanation = "O(nxf) → O(n²xf): apply derive to type pairs",
        },
        ["derive.product"] = {
            suggestions = { "@comp.tensor", "@comp.derive.tensor", "@comp.ceiling" },
            explanation = "O(n²xf) → O(n³xf): product of derives with sweep",
        },
        ["product"] = {
            suggestions = { "@comp.tensor", "@comp.nfold", "@comp.ceiling" },
            explanation = "O(n²) → O(n³): extend to 3D type sweep",
        },
        ["tensor"] = {
            suggestions = { "@comp.nfold", "@comp.derive.tensor", "@comp.transcend" },
            explanation = "O(n³) → O(n^k) or O(n³xf): n-fold sweep or derive with emit",
        },
        ["nfold"] = {
            suggestions = { "@comp.tower", "@comp.infinity", "@comp.hyper" },
            explanation = "O(n^k) → O(n^(k+1)) or O(n^(k+1)f): tower or module emit",
        },
        ["burst"] = {
            suggestions = { "@comp.transcend", "@comp.infinity", "@comp.hyper" },
            explanation = "O(n²xf) → O(n³xf) or higher: module-level generative emit",
        },
        ["transcend"] = {
            suggestions = { "@comp.infinity", "@comp.hyper", "@comp.tower" },
            explanation = "O(n³xf) → O(n⁴xf) or O(n⁵xf): higher-order module emit",
        },
        ["power"] = {
            suggestions = { "@comp.choose", "@comp.permute", "@comp.derive.power" },
            explanation = "O(2ⁿ) → combinations or permutations",
        },
        ["grammar"] = {
            suggestions = { "@comp.weave", "@comp.each" },
            explanation = "O(b^d) → cross-module or composition",
        },
    }
    
    entry = suggestions_map[core] or suggestions_map["map"]
    std.json.encode({
        path = path,
        next_level = entry.suggestions,
        explanation = entry.explanation,
        ladder = "map:O(n) → derive:O(nxf) → product:O(n²) → tensor:O(n³) → nfold:O(n^kf) → power:O(2ⁿ) → permute:O(n!)",
    })
end)

-- Tool: duo_multiplier_opportunities — find metaprogramming opportunities in code
std.mcp.register_tool("duo_multiplier_opportunities", "Analyze a .id file for places where metaprogramming exponentials could be applied", {
    type = "object",
    properties = {
        file_path = { type = "string", description = "Path to .id file to analyze" },
    },
    required = { "file_path" },
}, fun(args)
    if not std.fs.exists(args.file_path)
        std.json.encode({ error = "File not found: " .. args.file_path })
    else
        content = std.fs.read_file(args.file_path)
        
        opportunities = {}
        
        -- Check for multiple similar patterns
        fun_count = 0
        for _ in string.gmatch(content, "fun[^(]*%([^)]*%)[^{]*%{") do fun_count += 1 end
        if fun_count > 3
            table.insert(opportunities, {
                type = "multiple_similar_functions",
                count = fun_count,
                severity = "high",
                suggestion = "Use @comp.derive.bundle or @comp.derive.all to generate boilerplate functions",
                example = "@comp.derive.bundle(\"Numeric\"){\" would generate add, sub, mul, etc. for all numeric types\",}"
            })
        end
        
        -- Check for type pairs
        type_pairs = 0
        for _ in string.gmatch(content, "for[^;]*in[^;]*pairs?") do type_pairs += 1 end
        if type_pairs > 1
            table.insert(opportunities, {
                type = "multiple_type_pairs",
                count = type_pairs,
                severity = "medium",
                suggestion = "Use @comp.product for cartesian product of type sets",
                example = "@comp.product({A, B}, {X, Y}, fun(a, b) ... end)",
            })
        end
        
        -- Check for repeated table structures
        table_count = 0
        for _ in string.gmatch(content, "{[^}]+=[^}]+}") do table_count += 1 end
        if table_count > 3
            table.insert(opportunities, {
                type = "repeated_table_structures",
                count = table_count,
                severity = "medium",
                suggestion = "Use @comp.generate or @comp.expand for table generation",
            })
        end
        
        -- Check for string concatenation in loops
        if string.find(content, "for") and string.find(content, "..")
            table.insert(opportunities, {
                type = "loop_concat",
                severity = "low",
                suggestion = "Consider @comp.template for compile-time string generation",
            })
        end
        
    std.json.encode({
        file = args.file_path,
        opportunities = opportunities,
        count = opportunities:len(),
        ladder_link = "@comp.ladder() for full complexity reference",
    })
end)

-- Tool: duo_agent_session_start — session bootstrap
std.mcp.register_tool("duo_agent_session_start", "Session bootstrap: coordination, gaps, canonical index, INFER-ONE, seam audit (law.gate.convergence)", {
    type = "object",
    properties = {
        agent_id = { type = "string", description = "Agent identifier" },
    },
}, fun(args)
    coord = shared.coordination_read()
    p0 = shared.open_p0_gaps()
    canon = shared.canonical_index()
    std.json.encode({
        agent_id = args.agent_id or "agent",
        infer_one = shared.infer_one_context(),
        harness_seams = shared.harness_seams_context(),
        harness_context = shared.harness_context(),
        coordination_path = shared.coordpath,
        canonical_index_path = shared.canonpath,
        open_p0_count = p0:len(),
        next_steps = {
            "duo_coordination_update(action='claim', ...) before shared edits",
            "duo_complexity(path='comp.map') to query complexity",
            "duo_next_combinators(path='comp.map') to get suggestions",
            "duo_multiplier_opportunities(file_path='file.id') to find opportunities",
            "cd " .. root .. " && " .. shared.idbin .. " run --backend=c scripts/agent_smoke.id (or the duo_agent_smoke tool, which takes the build lock)",
        },
        coordination_excerpt = string.sub(coord, 1, 4000),
        canonical_excerpt = string.sub(canon, 1, 2000),
    })
end)

