end)

-- Tool: duo_grammar_spec_update — append grammar rule change
std.mcp.register_tool("duo_grammar_spec_update", "Append a grammar rule changelog entry", {
    type = "object",
    properties = {
        rule_id = { type = "string", description = "e.g. GR-001" },
        status = { type = "string", description = "preferred|accepted|deprecated|removed" },
        detail = { type = "string", description = "Description of change" },
    },
    required = { "rule_id", "status", "detail" },
}, fun(args)
    gpath = "docs/GRAMMAR_SPEC.md"
    if not std.fs.exists(gpath)
        return std.json.encode({ kind = "grammar.update", ok = false, path = gpath, reason = "grammar spec missing; create docs/GRAMMAR_SPEC.md first" })
    end
    content = std.fs.read_file(gpath)
    date = clock.utc():sub(1, 10)
    entry = "| {date} | {args.rule_id} | {args.status}: {args.detail} |\n"
    marker = "## Changelog\n\n| Date | Rule | Change |\n| --- | --- | --- |\n"
    if string.find(content, marker)
        content = "{string.gsub(content, marker, marker}{entry, 1)}"
    else
        content = "{content}\\n## Changelog\\n\\n| Date | Rule | Change |\\n| --- | --- | --- |\\n{entry}"
    end
    std.fs.write_file(gpath, content)
    std.json.encode({ kind = "grammar.update", ok = true, path = gpath, rule = args.rule_id, status = args.status })
end)

