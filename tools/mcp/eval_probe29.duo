src = "AAA\nBBB\nCCC\n"
print("len=" .. string.len(src))
count = 0
for ln in string.gmatch(src, "([^\n]*)\n") do
    count = count + 1
    print("got[" .. count .. "]=[" .. ln .. "]")
end
print("count=" .. count)

-- now 4 lines
src2 = "AAA\nBBB\nCCC\nDDD\n"
print("len2=" .. string.len(src2))
count2 = 0
for ln in string.gmatch(src2, "([^\n]*)\n") do
    count2 = count2 + 1
end
print("count2=" .. count2)
