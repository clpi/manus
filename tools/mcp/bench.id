  type = "object",
  properties = {
    query = { type = "string", description = "Natural language or code query" },
    top_k = { type = "number", description = "Number of results (default 10)" },
    scope = { type = "string", description = "compiler|library|all (default all)" },
    force_rebuild = { type = "boolean", description = "Rebuild symbol index from source" }
  },
  required = { "query" }
}, fun(args)
  embed_symbols_tool(args)
end)

tool("duo_cross_lang_meta", {
  description = "Guide for injecting Duo @comp.* exponential metaprogramming into any host language project.",
  type = "object",
  properties = {
    host_lang = { type = "string", description = "python|rust|zig|c|js|ts|go|any" },
    goal = { type = "string", description = "What to achieve (e.g. derive, pipeline, embed-json)" }
  }
}, fun(args)
  lang = args.host_lang or "any"
  goal = args.goal or ""
  hdr = "# Using Duo metaprogramming from {lang}\n\n"
  body = "## Drop-in: a standalone meta.id in your project\n\n  @comp.derive(Serialize, Hash, Eq)\n  MyType = { x: i64, y: i64 }\n\n  @comp.pipeline(\"load -> validate -> transform -> emit\")\n  process(item: Item): Result\n\nDuo build step emits C/asm/object your toolchain links directly.\n\n## Via duo_exponential_eval MCP tool\n\nPass any code snippet; Duo returns native C + @comp.* expansion.\n\n## Scaling ladder\n\n  @comp.map      1 type  -> N\n  @comp.product  2 types -> N^2\n  @comp.burst    N types -> derives x product\n  @comp.transcend 3      -> N^3\n  @comp.power    N       -> 2^N specializations\n  @comp.permute  N       -> N! orderings\n\n## Agent workflow\n\n1. duo_exponential_eval(source=...) -> optimized Duo\n2. duo_meta_catalog() -> browse @comp.* constructs\n3. duo_meta_ladder() -> understand scaling\n4. duo_file_finding(kind=\"ergonomic_gap\", ...) -> file gaps\n"
  std.json.encode({ guide = "{hdr}{body}", host_lang = lang, goal = goal })
end)

tool("duo_semantic_snapshot", {
  description = "Export SIM v0 semantic snapshot JSON for a .id file",
  type = "object",
  properties = {
    file_path = { type = "string" }
  },
  required = { "file_path" }
}, fun(args)
  -- `sx` was NEVER BOUND in this handler  -  the only two `sx = req` sites in
  -- the file were inside two OTHER handlers. That is what lowered to
  -- `make_closure_29(sx)` and made the whole server unbuildable.
  output = shared.semantic_snapshot_raw(args.file_path or "")
  if output == nil or string.len(output) == 0
    return "{\"error\":\"empty output\"}"
  i = string.find(output, "{", 1, true)
  -- EXPLICIT `return`s, not a trailing `if … else … end` used as the value.
  -- A handler whose tail expression is a bare if/else sends NO RESPONSE AT
  -- ALL and ends the session; measured 2026-08-08 on this exact tool. Every
  -- handler still shaped that way is in the dead list in tools/mcp/CLAUDE.md.
  if i
    return string.sub(output, i)
  "{\"error\":\"no JSON in output\"}"
end)

tool("duo_foreign_import_preview", {
  description = "Preview C header import as SIM v0 entities",
  type = "object",
  properties = {
    header_path = { type = "string" },
    source_dir = { type = "string" }
  },
  required = { "header_path" }
}, fun(args)
  src_dir = args.source_dir or ""
  if src_dir == ""
    dir = string.match(args.header_path, "^(.*)/[^/]+$")
    if dir
      src_dir = dir
  std.json.encode(shared.foreign_import_preview(args.header_path, src_dir))
end)

