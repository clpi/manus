mcp:register_tool("duo_grammar_spec_update", {
    description = "Append a grammar rule to the canonical Duo grammar spec",
    type = "object",
    properties = {
        rule_id = { type = "string" },
        status = { type = "string", description = "preferred|accepted|deprecated|removed" },
        title = { type = "string" },
        content = { type = "string" },
    },
    required = { "rule_id", "status", "title", "content" },
}, fun(args)
    spec_path = "{shared.root}/docs/GRAMMAR_SPEC.md"
    existing = fs:read_file(spec_path) or ""
    ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
    entry = "\\n\\n## Rule: {(args.rule_id or \"\")} [{(args.status or \"accepted\")}]\\n### {(args.title or \"\")}\\n_Updated: {ts}_\\n\\n{(args.content or \"\")}\\n"
    fs:write_file(spec_path, "{existing}{entry}")
    json:encode({ appended = true, rule_id = args.rule_id, status = args.status })
end)

