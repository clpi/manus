-- tools/mcp/bench.id  -  MCP server: benchmarks, build gates, perf audit, coordination.
-- Run: idol run tools/mcp/bench.id
-- Bootstrap Lua/Duo faces remain until MCP migrates to Idol. Run from repo root:
--   idol run tools/mcp/bench.id
--
-- Each tool registers as idol_* only.

-- `script` is deliberately absent: it is the denied activity junk drawer.
-- Environment reads go through `os.getenv`; process work
-- routes through `tools.mcp.shared`, which owns the build lock.
--
-- DUO_ROOT is resolved ONCE, at file scope, as a VALUE  -  not as a helper
-- function. A named file-scope function called from inside a tool handler
-- lowers to `cl->up0()`, an upvalue call Idol has no capture machinery for
-- ("called object type 'lua_Value' is not a function"). Module tables and
-- plain values reached from a handler are fine; a call is not.
--
-- `os.getenv` answers "" and NOT nil for an unset name, so `getenv(x) or
-- default` hands back "" and every path built from it resolves against the
-- filesystem root. The `== ""` test is the whole point of this binding.
root = os.env["IDOL_ROOT"] or ""
if root:len() == 0
  root = os.env["DUO_ROOT"] or ""
if root:len() == 0
  root = os.env["PWD"] or ""
if root:len() == 0
  root = "."

-- EVERY `req` LIVES HERE, AT FILE SCOPE, AND MUST STAY HERE.
--
-- A `req` inside a tool handler binds a local that the handler's own nested
-- closures then try to capture; Duo has no closure capture, so lowering emits
-- `duo_make_closure_29(sx)` naming a C identifier that was never declared and
-- the whole server fails to build with "use of undeclared identifier 'sx'".
-- `duo check` reports no errors on that file. The server was dead and looked
-- healthy  -  which is how both MCP servers stayed dead with nothing noticing.
-- See `zig build mcp-gate`.
--
-- Sibling modules are spelled from the PROJECT root (`tools.mcp.x`), never
-- bare (`x`). `req` is resolved at COMPILE time against the directory tree
-- above the source file  -  the compiler walks up from the .id file looking
-- for a sibling `src/`  -  so a bare `req "duo_shared"` only resolved when the
-- process happened to be started with cwd = tools/mcp, and died with
-- `module not found: shared` from anywhere else. An MCP client starts its
-- servers from wherever it likes. The rooted spelling is cwd-independent.
--
-- STD IS THE PRELUDE GRAPH: no module tree, no import. std
-- descriptors are referenced DIRECTLY  -  `dual_tool`,
-- `std.fs.exists`, `std.json.encode`, `std.os.getenv`  -  which was verified to
-- work from inside a tool handler before this file stopped importing them.
-- `req "std.x"` is migration debt against that rule; both `req`s left here
-- name PROJECT modules, which are not std and do still need one.
shared = req("tools.mcp.shared")
eval = req("tools.mcp.eval")
vector = req("lib.std.vector")

tool: void = (name: str, schema: any, handler: any)
  std.mcp.register_tool(string.gsub(name, "^duo_", "idol_"), schema, handler)

audit_tally: any = (results: any)
  wins = 0
  losses = 0
  for _, r in results
    if r.pass
      wins = wins + 1
    if not r.pass
      losses = losses + 1
  { passed = wins, failed = losses }

audit_smokes: str = ()
  paths = {
    "examples/json/iteration.id",
    "examples/boring/anagram.id",
    "examples/boring/fizzbuzz.id",
    "examples/boring/fib.id",
    "examples/boring/primes.id",
    "examples/boring/sort/quick.id",
    "examples/boring/search/binary.id",
    "examples/boring/mat/mul.id",
    "examples/layout/guard.id",
    "examples/layout/loop/body.id",
    "examples/demand/result.id",
    "examples/demand/swap.id",
    "examples/demand/tail.id",
    "examples/pack/consume.id",
    "examples/projection/descriptor.id",
    "examples/read/stream.id",
    "examples/native/record.id",
    "examples/hash/agreement.id",
    "examples/control/default.id",
    "examples/conversion/level.id",
    "examples/table/str/split.id",
    "examples/table/float/render.id"
  }
  results = {}
  i = 1
  while i <= paths:len()
    results:push(shared.audit_native_boxing(paths[i]))
    i = i + 1
  tallies = audit_tally(results)
  total = paths:len()
  std.json.encode({ total = total, passed = tallies.passed, failed = tallies.failed, results = results })

embed_symbols_tool: str = (args: any)
  rd = shared.root
  ipath = "{rd}/docs/symbol_index.json"
  k = args.top_k or 10
  sc = args.scope or "all"
  if args.force_rebuild
    return std.json.encode({
      error = "symbol index rebuild blocked",
      reason = "scripts/build_symbol_index.id absent  -  IMPLEMENTATION-BLOCKED"
    })
  raw = std.fs.read_file(ipath)
  if not raw
    return std.json.encode({ error = "symbol index not found at {ipath}" })
  idx = std.json.decode(raw)
  dim = idx.dim or 256
  decoded = 0
  for _ in idx.symbols or {}
    decoded = decoded + 1
  indexed = idx.count or decoded
  qvec = vector.embed(args.query or "", dim)
  records = {}
  for _, sym in idx.symbols or {}
    f = sym.file or ""
    if sc == "all"
      records:push(sym)
    elseif sc == "compiler" and string.find(f, "src", 1, true) == 1
      records:push(sym)
    elseif sc == "library" and string.find(f, "lib/std", 1, true) == 1
      records:push(sym)
  results = vector.rank(qvec, records, k)
  note = nil
  if decoded < indexed
    note = "partial decode: {decoded}/{indexed} symbols visible  -  runtime tonumber heap-corruption bug (see findings 2026-08-02T23:10) reduces recall until codegen.zig fix lands"
  std.json.encode({ results = results, decoded = decoded, indexed = indexed, note = note, query = args.query, dim = dim })

tool("duo_bench_run", {
  description = "Run a benchmark suite under build lock",
  type = "object",
  properties = {
    suite = { type = "string", description = "bench|ml-bench|honest-bench|cross-bench" },
    timeout = { type = "number" }
  },
  required = { "suite" }
}, fun(args)
  if args.suite == nil or args.suite == ""
    return std.json.encode({ error = "no bench type given" })
  std.json.encode(shared.bench_run(args.suite, args.timeout or 900))
end)

