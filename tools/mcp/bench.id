tool("duo_agent_session_start", {
  description = "Session bootstrap: dev control plane + INFER-ONE + seam audit + coordination + gaps",
  type = "object",
  properties = {
    agent_id = { type = "string" },
    work_item = { type = "string", description = "Optional P13-WSn work item for context bundle" }
  }
}, fun(args)
  agent = args.agent_id or "agent"
  wi = args.work_item or ""
  dev_json = shared.dev_session_start(agent, wi, agent)
  coord = shared.coordination_read()
  p0 = shared.open_p0_gaps()
  canon = shared.canonical_index()
  open_count = p0:len()
  std.json.encode({
    agent_id = agent,
    dev_control_plane = dev_json,
    infer_one = shared.infer_one_context(),
    harness_seams = shared.harness_seams_context(),
    harness_context = shared.harness_context(),
    coordination_path = shared.coordpath,
    canonical_index_path = shared.canonpath,
    open_p0_count = open_count,
    open_p0_gaps = p0,
    open_p0_census_source = "gaps/GAP-*.md",
    open_p0_census_complete = open_count > 0,
    next_steps = {},
    coordination_excerpt = string.sub(coord, 1, 2000),
    canonical_excerpt = string.sub(canon, 1, 2000)
  })
end)

