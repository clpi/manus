mcp:register_tool("duo_embed_symbols", {
    description = "Symbol-level VECTOR embedding search over compiler and library sources (vector: hashed bag-of-n-grams + cosine similarity, NOT keyword matching). Builds docs/symbol_index.json on first call or when force_rebuild=true.",
    type = "object",
    properties = {
        query         = { type = "string",  description = "Natural language or code query" },
        top_k         = { type = "number",  description = "Number of results (default 10)" },
        scope         = { type = "string",  description = "compiler|library|all (default all)" },
        force_rebuild = { type = "boolean", description = "Rebuild symbol index from source" },
    },
    required = { "query" },
}, fun(args)
    rd    = root
    ipath = "{rd}/docs/symbol_index.json"
    k     = args.top_k or 10
    sc    = args.scope or "all"

    if args.force_rebuild or not fs:exists(ipath)
        -- the literal "<DUO_ROOT>" that used to lead this command was a
        -- never-substituted template placeholder: `cd <DUO_ROOT>` is a shell
        -- redirect from a file named DUO_ROOT, so the rebuild always ran in
        -- the wrong directory or not at all.
        r = shared.capture("cd {rd} && {shared.idbin} run --backend=c scripts/build_symbol_index.id -- {ipath}")
        if r.status ~= 0
            return json:encode({ error = "symbol index build failed", status = r.status })
        end
    end

    raw = fs:read_file(ipath)
    if not raw
        return json:encode({ error = "symbol index not found at {ipath}" })
    end

    idx = json:decode(raw)
    dim = idx.dim or 256
    decoded = #(idx.symbols or {})
    indexed = idx.count or decoded
    qvec = vector.embed(args.query or "", dim)

    -- scope filter (derived from file path), then vector cosine rank
    records = {}
    for _, sym in idx.symbols or {}
        f = sym.file or ""
        if sc == "all"
            records[#records+1] = sym
        elseif sc == "compiler" and string.find(f, "src", 1, true) == 1
            records[#records+1] = sym
        elseif sc == "stdlib" and string.find(f, "lib/std", 1, true) == 1
            records[#records+1] = sym
        end
    end

    results = vector.rank(qvec, records, k)
    note = nil
    if decoded < indexed
        note = "partial decode: {decoded}/{indexed} symbols visible — runtime tonumber heap-corruption bug (see findings 2026-08-02T23:10) reduces recall until codegen.zig fix lands"
    end
    json:encode({ results = results, decoded = decoded, indexed = indexed, note = note, query = args.query, dim = dim })
end)



mcp:register_tool("duo_cross_lang_meta", {
    description = "Guide for injecting Duo @comp.* exponential metaprogramming into any host language project.",
    type = "object",
    properties = {
        host_lang = { type = "string", description = "python|rust|zig|c|js|ts|go|any" },
        goal      = { type = "string", description = "What to achieve (e.g. derive, pipeline, embed-json)" },
    },
}, fun(args)
    lang = args.host_lang or "any"
    goal = args.goal or ""
    hdr = "# Using Duo metaprogramming from {lang}\\n\\n"
    body = "## Drop-in: a standalone meta.id in your project\n\n"
        "  @comp.derive(Serialize, Hash, Eq)\n"
        "  MyType = { x: i64, y: i64 }\n\n"
        "  @comp.pipeline(\"load -> validate -> transform -> emit\")\n"
        "  process(item: Item): Result\n\n"
        "Duo build step emits C/asm/object your toolchain links directly.\n\n"
        "## Via duo_exponential_eval MCP tool\n\n"
        "Pass any code snippet; Duo returns native C + @comp.* expansion.\n\n"
        "## Scaling ladder\n\n"
        "  @comp.map      1 type  -> N\n"
        "  @comp.product  2 types -> N^2\n"
        "  @comp.burst    N types -> derives x product\n"
        "  @comp.transcend 3      -> N^3\n"
        "  @comp.power    N       -> 2^N specializations\n"
        "  @comp.permute  N       -> N! orderings\n\n"
        "## Agent workflow\n\n"
        "1. duo_exponential_eval(source=...) -> optimized Duo\n"
        "2. duo_meta_catalog() -> browse @comp.* constructs\n"
        "3. duo_meta_ladder() -> understand scaling\n"
        "4. duo_file_finding(kind=\"ergonomic_gap\", ...) -> file gaps\n"
    json:encode({ guide = "{hdr}{body}", host_lang = lang, goal = goal })
end)

mcp:register_tool("duo_semantic_snapshot", {
    description = "Export SIM v0 semantic snapshot JSON for a .id file (Pass 5)",
    type = "object",
    properties = {
        file_path = { type = "string" },
    },
    required = { "file_path" },
}, fun(args)
    -- `sx` was NEVER BOUND in this handler — the only two `sx = req` sites in
    -- the file were inside two OTHER handlers. That is what lowered to
    -- `duo_make_closure_29(sx)` and made the whole server unbuildable.
    output = shared.semantic_snapshot_raw(args.file_path or "")
    if output == nil or string.len(output) == 0 then return "{\"error\":\"empty output\"}" end
    i = string.find(output, "{", 1, true)
    -- EXPLICIT `return`s, not a trailing `if … else … end` used as the value.
    -- A handler whose tail expression is a bare if/else sends NO RESPONSE AT
    -- ALL and ends the session; measured 2026-08-08 on this exact tool. Every
    -- handler still shaped that way is in the dead list in tools/mcp/CLAUDE.md.
    if i
        return string.sub(output, i)
    end
    "{\"error\":\"no JSON in output\"}"
end)

mcp:register_tool("duo_foreign_import_preview", {
    description = "Preview C header import as SIM v0 entities (Pass 5)",
    type = "object",
    properties = {
        header_path = { type = "string" },
        source_dir = { type = "string" },
    },
    required = { "header_path" },
}, fun(args)
    src_dir = args.source_dir or ""
    if src_dir == "" then
        dir = string.match(args.header_path, "^(.*)/[^/]+$")
        if dir then src_dir = dir end
    end
    json:encode(shared.foreign_import_preview(args.header_path, src_dir))
end)

