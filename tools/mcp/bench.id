mcp:register_tool("duo_file_finding", {
    description = "File a finding (bug/exponential_opportunity/ergonomic_gap/regression) to the coordination buffer",
    type = "object",
    properties = {
        kind = { type = "string", description = "bug|exponential_opportunity|ergonomic_gap|regression" },
        title = { type = "string" },
        detail = { type = "string" },
        priority = { type = "string", description = "P0|P1|P2" },
        file_path = { type = "string" },
    },
    required = { "kind", "title", "detail", "priority" },
}, fun(args)
    coord_path = shared.coordpath
    ts = os.date("!%Y-%m-%dT%H:%M:%SZ")
    fp_line = ""
    if args.file_path and args.file_path ~= ""
        fp_line = "\\n  file: {args.file_path}"
    end
    entry = "\\n\\n### [{(args.priority or \"P1\")}] [{(args.kind or \"bug\")}] {(args.title or \"\")}\\n- filed: {ts}{fp_line}\\n- detail: {(args.detail or \"\")}\\n"
    existing = fs:read_file(coord_path) or ""
    marker = "## Cross-Agent Gap Buffer"
    idx = string.find(existing, marker, 1, true)
    if idx
        before = string.sub(existing, 1, idx + #marker - 1)
        after = string.sub(existing, idx + #marker)
        fs:write_file(coord_path, "{before}{entry}{after}")
    else
        fs:write_file(coord_path, "{existing}\n{marker}{entry}")
    end
    json:encode({ filed = true, kind = args.kind, title = args.title, priority = args.priority })
end)

mcp:register_tool("duo_exponential_eval", {
    description = "Exponential evaluator: input Duo source -> metaprogramming-enhanced, minimized Duo intermediary using @comp.* combinators (collapses type-polymorphic fn families into @comp.generate, equality boilerplate into @derive, dispatch chains into tables), plus a native-boxing (lua_Value) audit and LOC metrics. Returns JSON.",
    type = "object",
    properties = {
        source = { type = "string", description = "Duo source code to analyze" },
        goal = { type = "string", description = "Optional description of what the code does" },
    },
    required = { "source" },
}, fun(args)
    res = eval.evaluate(args.source or "", args.goal or "")
    if res ~= nil and res ~= "" then return res end
    -- fallback only if the evaluator module is unavailable
    json:encode({ error = "duo_eval.evaluate returned no result", fallback = true, goal = args.goal or "" })
end)

