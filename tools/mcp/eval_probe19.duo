needles = { ["lua_invoke("] = 1, ["lua_table_get_str_lit("] = 1, ["lua_Value "] = 1 }
print("needles type: " .. tostring(type(needles)))

count = 0
for needle, _ in needles do
    count = count + 1
    print("needle=[" .. tostring(needle) .. "] val=" .. tostring(_))
end
print("count=" .. count)

-- also test: what does string.find return?
s = "abc lua_invoke( def"
p1, p2 = string.find(s, "lua_invoke(", 1, true)
print("find p1=" .. tostring(p1) .. " p2=" .. tostring(p2))

-- test count_lines_str
eval = req "duo_eval"
print("count_lines_str(nil)=" .. tostring(eval.count_lines_str(nil)))
print("count_lines_str(\"\")=" .. tostring(eval.count_lines_str("")))
print("count_lines_str(\"a\\nb\")=" .. tostring(eval.count_lines_str("a\nb")))
