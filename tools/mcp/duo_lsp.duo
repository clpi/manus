-- Tool: duo_grammar_spec_read — read grammar spec
mcp.register_tool("duo_grammar_spec_read", "Read canonical surface-syntax rules", {
    type = "object",
    properties = {},
}, fun(_args)
    gpath = "docs/GRAMMAR_SPEC.md"
    if script.fs_exists(gpath)
        script.fs_read(gpath)
    else
        "Grammar spec not initialized. See docs/GRAMMAR_SPEC.md"
    end
end)

-- Tool: duo_grammar_spec_update — append grammar rule change
mcp.register_tool("duo_grammar_spec_update", "Append a grammar rule changelog entry", {
    type = "object",
    properties = {
        rule_id = { type = "string", description = "e.g. GR-001" },
        status = { type = "string", description = "preferred|accepted|deprecated|removed" },
        detail = { type = "string", description = "Description of change" },
    },
    required = { "rule_id", "status", "detail" },
}, fun(args)
    gpath = "docs/GRAMMAR_SPEC.md"
    if not script.fs_exists(gpath)
        "Grammar spec missing — create docs/GRAMMAR_SPEC.md first"
    else
        content = script.fs_read(gpath)
        date = os.date("%Y-%m-%d")
        entry = "| " .. date .. " | " .. args.rule_id .. " | " .. args.status .. ": " .. args.detail .. " |\n"
        marker = "## Changelog\n\n| Date | Rule | Change |\n| --- | --- | --- |\n"
        if string.find(content, marker)
            content = string.gsub(content, marker, marker .. entry, 1)
        else
            content = content .. "\n## Changelog\n\n| Date | Rule | Change |\n| --- | --- | --- |\n" .. entry
        end
        script.fs_write(gpath, content)
        "Appended " .. args.rule_id .. " to grammar spec changelog"
    end
end)

