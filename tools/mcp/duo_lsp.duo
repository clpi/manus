mcp.register_tool("duo_audit_native_boxing", "Dump C for a .duo file and flag boxing patterns", {
    type = "object",
    properties = {
        file_path = { type = "string", description = "Path to .duo file" },
    },
    required = { "file_path" },
}, fun(args)
    result = shared.audit_native_boxing(args.file_path)
    json_mod.encode(result)
end)

-- Tool: duo_audit_metaprogramming_smokes — batch native audit
mcp.register_tool("duo_audit_metaprogramming_smokes", "Batch native-boxing audit on generative showcases", {
    type = "object",
    properties = {},
}, fun(_args)
    paths = {
        "examples/meta_template_showcase.duo",
        "examples/meta_generate_showcase.duo",
        "examples/meta_scheme_showcase.duo",
        "examples/meta_grammar_showcase.duo",
        "examples/meta_weave_showcase.duo",
        "examples/meta_power_permute_showcase.duo",
        "examples/meta_choose_showcase.duo",
    }
    passed = 0
    failed = 0
    results = {}
    for _, p in paths
        r = shared.audit_native_boxing(p)
        results[#results + 1] = r
        if r.pass then passed = passed + 1 else failed = failed + 1 end
    end
    json_mod.encode({ total = #paths, passed = passed, failed = failed, results = results })
end)

