end)

-- Tool: duo_audit_codegen_pitfalls — static scan for the two most common Duo codegen pitfalls:
-- F-13813-2 (bare call as last stmt of a block → premature return) and
-- F-13813-3 (`= nil` init → void* type inference). Pure string.find/string.byte — no lua_Value.
mcp.register_tool("duo_audit_codegen_pitfalls", "Static-scan a .duo file for known Duo codegen pitfalls (call-as-tail premature return, nil-init void* inference).", {
    type = "object",
    properties = {
        file_path = { type = "string", description = "Path to .duo file" },
    },
    required = { "file_path" },
}, fun(args)
    result = shared.audit_codegen_pitfalls(args.file_path)
    json_mod.encode(result)
end)

-- Tool: duo_exponential_evaluate — analyze Duo code for metaprogramming opportunities
-- This is the PRIMARY ONBOARDING tool for new agents to find exponential multipliers.
-- Also returns a native-boxing audit of generated C when file_path is a real .duo file.
mcp.register_tool("duo_exponential_evaluate", "Analyze Duo source code for metaprogramming opportunities and suggest @comp.* combinators that create exponential gains with minimal code. When file_path is a real .duo file it also returns a native-boxing audit of the generated C (lua_invoke/lua_Value/lua_table_* hits).", {
    type = "object",
    properties = {
        code = { type = "string", description = "Duo source code to analyze" },
        file_path = { type = "string", description = "Optional file path for context" },
        detail = { type = "integer", description = "Result depth: 0=summary, 1=detailed, 2=explanations" },
    },
    required = { "code" },
}, fun(args)
    -- `exponential_evaluate` takes (code, file_path) only — duo_shared.duo:583.
    -- Lua silently drops the extra `detail` arg, but Duo lowers this to a direct
    -- C call, where a third argument is a hard compile error. Dropping it here
    -- preserves the behaviour the extra arg already had: none.
    result = shared.exponential_evaluate(args.code, args.file_path)
    json_mod.encode(result)
end)

-- Tool: duo_onboard_exponential — guided onboarding for leveraging Duo's metaprogramming
-- Helps new agents understand how to write code that creates exponential productivity gains
mcp.register_tool("duo_onboard_exponential", "Step-by-step guide for writing exponential metaprogramming in Duo. Answers common questions about when to use @comp.* combinators.", {
    type = "object",
    properties = {
        question = { type = "string", description = "Question about exponential metaprogramming" },
        code = { type = "string", description = "Optional code snippet to analyze" },
    },
    required = {},
}, fun(args)
    result = shared.exponential_onboard(args.question or "", args.code or "")
    json_mod.encode(result)
end)

