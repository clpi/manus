}, fun(_args)
    json_mod.encode({
        syntax = {
            ["fun"] = "Function declaration (replaces function)",
            ["req"] = "Module import (replaces require)",
            ["implicit_local"] = "Omit local keyword — bindings default to local scope",
            ["omit_then"] = "Omit then — deprecated in .duo",
            ["string_literal_calls"] = "print 'hi' — call sugar without parens",
            ["underscore_private"] = "_prefix names are file-private",
        },
        types = {
            ["i64"] = "64-bit signed integer", ["f64"] = "64-bit float", ["str"] = "String",
            ["bool"] = "Boolean", ["any"] = "Any type", ["void"] = "Void",
            ["Tensor[dims, dtype]"] = "Compile-time shape-checked tensor",
        },
        metaprogramming = {
            ["@(expr)"] = "Compile-time evaluation",
            ["@comp.*"] = "Full metaprogramming framework",
            ["@comp.catalog()"] = "Self-documenting: list all metaprogramming constructs",
            ["@comp.ladder()"] = "Show scaling ladder of metaprogramming constructs",
        },
    })
end)

