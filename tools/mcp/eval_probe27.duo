-- Construct the same string but using concat to avoid any string literal issues
line1 = "fun add_i32(a: i32, b: i32): i32 a + b end"
line2 = "fun add_i64(a: i64, b: i64): i64 a + b end"
src = line1 .. "\n" .. line2 .. "\n"
print("len=" .. string.len(src))

p1, p2 = string.find(src, "\n", 1, true)
print("nl1 at " .. tostring(p1))

count = 0
for ln in string.gmatch(src, "([^\n]*)\n") do
    count = count + 1
    print("got[" .. count .. "]=[" .. ln .. "]")
end
print("count=" .. count)
