jws: i64 = (text: str, pos: i64)
  n = text:len()
  i = pos
  while i <= n
    c = text:byte(i)
    if c == 32 or c == 9 or c == 10 or c == 13
      i = i + 1
    else
      return i
  i

jstrend: i64 = (text: str, pos: i64)
  n = text:len()
  i = pos + 1
  while i <= n
    c = text:byte(i)
    if c == 92
      i = i + 2
    else
      if c == 34
        return i + 1
      i = i + 1
  0

jclose: i64 = (text: str, pos: i64, open: i64, close: i64)
  n = text:len()
  depth = 1
  i = pos + 1
  while i <= n
    d = text:byte(i)
    if d == 34
      e = jstrend(text, i)
      if e == 0
        return 0
      i = e
    else
      if d == open
        depth = depth + 1
        i = i + 1
      else
        if d == close
          depth = depth - 1
          if depth == 0
            return i + 1
          i = i + 1
        else
          i = i + 1
  0

jskip: i64 = (text: str, pos: i64)
  i = jws(text, pos)
  n = text:len()
  if i > n
    return 0
  c = text:byte(i)
  if c == 34
    return jstrend(text, i)
  if c == 123
    return jclose(text, i, 123, 125)
  if c == 91
    return jclose(text, i, 91, 93)
  i = i + 1
  while i <= n
    d = text:byte(i)
    if d == 44 or d == 125 or d == 93 or d == 32 or d == 9 or d == 10 or d == 13
      return i
    i = i + 1
  i

jhexdig: i64 = (c: i64)
  if c >= 48 and c <= 57
    return c - 48
  if c >= 97 and c <= 102
    return c - 87
  if c >= 65 and c <= 70
    return c - 55
  -1

jhex4: i64 = (raw: str, pos: i64)
  v = 0
  k = 0
  while k < 4
    d = jhexdig(raw:byte(pos + k))
    if d < 0
      return -1
    v = v * 16 + d
    k = k + 1
  v

jdec: str = (raw: str)
  asc = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|\}~"
  n = raw:len()
  if n < 2
    return raw
  if raw:byte(1) != 34
    return raw
  if raw:byte(n) != 34
    return raw
  out = ""
  i = 2
  while i < n
    c = raw:byte(i)
    if c == 92
      i = i + 1
      e = raw:byte(i)
      if e == 110
        out = out .. "\n"
      else
        if e == 116
          out = out .. "\t"
        else
          if e == 114
            out = out .. "\r"
          else
            if e == 117
              v = jhex4(raw, i + 1)
              if v >= 32 and v <= 126
                out = out .. asc:sub(v - 31, v - 31)
              else
                out = out .. "?"
              i = i + 4
            else
              if e >= 32 and e <= 126
                out = out .. asc:sub(e - 31, e - 31)
              else
                out = out .. "?"
    else
      out = out .. raw:sub(i, i)
    i = i + 1
  out

jesc: str = (s: str)
  hex = "0123456789abcdef"
  out = "\""
  i = 1
  n = s:len()
  while i <= n
    c = s:byte(i)
    if c == 34
      out = out .. "\\\""
    else
      if c == 92
        out = out .. "\\\\"
      else
        if c == 10
          out = out .. "\\n"
        else
          if c == 13
            out = out .. "\\r"
          else
            if c == 9
              out = out .. "\\t"
            else
              if c < 32
                out = out .. "\\u00" .. hex:sub(c / 16 + 1, c / 16 + 1) .. hex:sub(c % 16 + 1, c % 16 + 1)
              else
                out = out .. s:sub(i, i)
    i = i + 1
  out .. "\""

jget: str = (text: str, path: str)
  dot = path:find(".", 1, 1)
  head = path
  rest = ""
  if dot > 0
    head = path:sub(1, dot - 1)
    rest = path:sub(dot + 1, path:len())
  n = text:len()
  i = jws(text, 1)
  if i > n
    return ""
  if text:byte(i) != 123
    return ""
  i = i + 1
  while true
    i = jws(text, i)
    if i > n
      return ""
    b = text:byte(i)
    if b == 125
      return ""
    if b != 34
      return ""
    e = jstrend(text, i)
    if e == 0
      return ""
    k = jdec(text:sub(i, e - 1))
    i = jws(text, e)
    if i > n
      return ""
    if text:byte(i) != 58
      return ""
    vs = jws(text, i + 1)
    ve = jskip(text, vs)
    if ve == 0
      return ""
    if k == head
      if rest == ""
        return text:sub(vs, ve - 1)
      return jget(text:sub(vs, ve - 1), rest)
    i = jws(text, ve)
    if i > n
      return ""
    b2 = text:byte(i)
    if b2 == 44
      i = i + 1
    else
      return ""
  ""

jhas: i64 = (text: str, path: str)
  if jget(text, path) == ""
    0
  else
    1

jcount: i64 = (text: str, path: str)
  raw = jget(text, path)
  if raw == ""
    return -1
  n = raw:len()
  i = jws(raw, 1)
  if i > n
    return -1
  if raw:byte(i) != 91
    return -1
  i = jws(raw, i + 1)
  if i > n
    return -1
  if raw:byte(i) == 93
    return 0
  count = 0
  while true
    ve = jskip(raw, i)
    if ve == 0
      return -1
    count = count + 1
    i = jws(raw, ve)
    if i > n
      return -1
    b = raw:byte(i)
    if b == 44
      i = jws(raw, i + 1)
    else
      if b == 93
        return count
      return -1
  -1

jitem: str = (text: str, path: str, idx: i64)
  raw = jget(text, path)
  if raw == ""
    return ""
  n = raw:len()
  i = jws(raw, 1)
  if i > n
    return ""
  if raw:byte(i) != 91
    return ""
  i = jws(raw, i + 1)
  if i > n
    return ""
  k = 1
  while true
    ve = jskip(raw, i)
    if ve == 0
      return ""
    if k == idx
      return raw:sub(i, ve - 1)
    k = k + 1
    i = jws(raw, ve)
    if i > n
      return ""
    b = raw:byte(i)
    if b == 44
      i = jws(raw, i + 1)
      if i > n
        return ""
    else
      return ""
  ""

jcountkey: i64 = (text: str, key: str)
  n = text:len()
  i = jws(text, 1)
  if i > n
    return -1
  if text:byte(i) != 123
    return -1
  i = i + 1
  found = 0
  while true
    i = jws(text, i)
    if i > n
      return -1
    b = text:byte(i)
    if b == 125
      return found
    if b != 34
      return -1
    e = jstrend(text, i)
    if e == 0
      return -1
    if jdec(text:sub(i, e - 1)) == key
      found = found + 1
    i = jws(text, e)
    if i > n
      return -1
    if text:byte(i) != 58
      return -1
    ve = jskip(text, jws(text, i + 1))
    if ve == 0
      return -1
    i = jws(text, ve)
    if i > n
      return -1
    b2 = text:byte(i)
    if b2 == 44
      i = i + 1
    else
      if b2 == 125
        return found
      return -1
  -1

shq: str = (s: str)
  out = "'"
  i = 1
  n = s:len()
  while i <= n
    c = s:sub(i, i)
    if c == "'"
      out = out .. "'\\''"
    else
      out = out .. c
    i = i + 1
  out .. "'"

wvalidline: i64 = (line: str)
  n = line:len()
  i = jws(line, 1)
  if i > n
    return 0
  if line:byte(i) != 123
    return 0
  e = jskip(line, i)
  if e == 0
    return 0
  if jws(line, e) <= n
    return 0
  1

werr: str = (idraw: str, code: i64, reason: str, next: str, producer: str, notdone: str)
  msg = "\{\"reason\":" .. jesc(reason) .. ",\"next\":" .. jesc(next) .. ",\"producer\":" .. jesc(producer) .. ",\"not-performed\":" .. notdone .. "\}"
  "\{\"jsonrpc\":\"2.0\",\"id\":" .. idraw .. ",\"error\":\{\"code\":" .. "{code}" .. ",\"message\":" .. jesc(msg) .. "\}\}"

wob: str = (oid: str, status: str, producer: str, evidence: str)
  "\{\"id\":" .. jesc(oid) .. ",\"status\":" .. jesc(status) .. ",\"producer\":" .. jesc(producer) .. ",\"evidence\":" .. jesc(evidence) .. "\}"

wrowkey: str = (row: str)
  jget(row, "module") .. "|" .. jdec(jget(row, "home")) .. "|" .. jget(row, "relations") .. "|" .. jget(row, "shapes") .. "|" .. jget(row, "applications") .. "|" .. jget(row, "shared_demand")

wrefkey: str = (row: str)
  jget(row, "module") .. "|" .. jdec(jget(row, "reason")) .. "|" .. jget(row, "split")

wdigits: i64 = (text: str)
  if text == ""
    return -1
  v = 0
  i = 1
  n = text:len()
  while i <= n
    c = text:byte(i)
    if c < 48 or c > 57
      return -1
    v = v * 10 + c - 48
    i = i + 1
  v

wtexit: i64 = (out: str)
  pos = 0
  i = 1
  while true
    f = out:find("__exit:", i, 1)
    if f == 0
      break
    pos = f
    i = f + 1
  if pos == 0
    return -1
  wdigits(out:sub(pos + 7, out:len()))

wchomp: str = (text: str)
  n = text:len()
  while n > 0
    c = text:byte(n)
    if c == 10 or c == 13
      n = n - 1
    else
      break
  if n <= 0
    return ""
  text:sub(1, n)

wtbody: str = (out: str)
  pos = 0
  i = 1
  while true
    f = out:find("__exit:", i, 1)
    if f == 0
      break
    pos = f
    i = f + 1
  if pos <= 2
    return ""
  wchomp(out:sub(1, pos - 2))

pfacet: str = (text: str, idx: i64)
  n = text:len()
  start = 1
  k = 1
  i = 1
  while i <= n
    if text:byte(i) == 124
      if k == idx
        return text:sub(start, i - 1)
      k = k + 1
      start = i + 1
    i = i + 1
  if k == idx
    return text:sub(start, n)
  ""

pnfacets: i64 = (text: str)
  if text == ""
    return 0
  n = 1
  i = 1
  while i <= text:len()
    if text:byte(i) == 124
      n = n + 1
    i = i + 1
  n

pfname: str = (idx: i64)
  if idx == 1
    return "module"
  if idx == 2
    return "home"
  if idx == 3
    return "relations"
  if idx == 4
    return "shapes"
  if idx == 5
    return "applications"
  "shared_demand"

pnodefor: str = (body: str, idstr: str)
  n = jcount(body, "nodes")
  i = 1
  while i <= n
    row = jitem(body, "nodes", i)
    if jget(row, "id") == idstr
      return row
    i = i + 1
  ""

puid: str = (node: str)
  ck = jdec(jget(node, "callee_kind"))
  ac = jget(node, "arg_count")
  ln = jget(node, "line")
  co = jget(node, "col")
  if ck == ""
    return ""
  if ac == ""
    return ""
  if ln == ""
    return ""
  if co == ""
    return ""
  "call|" .. ck .. "|" .. ac .. "|" .. ln .. "|" .. co

plisted: i64 = (body: str, path: str, uid: str)
  n = jcount(body, path)
  if n < 0
    return 0
  i = 1
  while i <= n
    idstr = jdec(jitem(body, path, i))
    node = pnodefor(body, idstr)
    if node != ""
      if puid(node) == uid
        return 1
    i = i + 1
  0

pblockedjson: str = (body: str)
  out = "["
  first = 1
  nb = jcount(body, "blocking_applications")
  i = 1
  while i <= nb
    idstr = jdec(jitem(body, "blocking_applications", i))
    node = pnodefor(body, idstr)
    if node != ""
      u = puid(node)
      if u != ""
        if first == 0
          out = out .. ","
        first = 0
        out = out .. jesc(u)
    i = i + 1
  out .. "]"

pgraphraw: str = (bin: str, file: str)
  qf = shq(file)
  gatecap("timeout 60 \"" .. bin .. "\" graph " .. qf .. " 2>/dev/null; printf '\\n__exit:%d' \"$?\"")

pexplainraw: str = (bin: str, file: str)
  qf = shq(file)
  gatecap("timeout 60 \"" .. bin .. "\" explain " .. qf .. " 2>/dev/null; printf '\\n__exit:%d' \"$?\"")

phash: str = (file: str)
  qf = shq(file)
  line = gatecap("sha256sum -- " .. qf .. " 2>/dev/null")
  if line:len() >= 64
    return line:sub(1, 64)
  ""

pok: str = (idraw: str, payload: str)
  "\{\"jsonrpc\":\"2.0\",\"id\":" .. idraw .. ",\"result\":\{\"content\":[\{\"type\":\"text\",\"text\":" .. jesc(payload) .. "\}]\}\}"

pagree: str = (expbody: str, grbody: str)
  ne = jcount(expbody, "concept.concepts")
  ng = jcount(grbody, "concepts")
  if ne < 1
    return "re-run derivation: the produced faces disagree on concept rows"
  if ne != ng
    return "re-run derivation: the produced faces disagree on concept rows"
  i = 1
  while i <= ne
    if wrowkey(jitem(expbody, "concept.concepts", i)) != wrowkey(jitem(grbody, "concepts", i))
      return "re-run derivation: the produced faces disagree on concept rows"
    i = i + 1
  re = jcount(expbody, "concept.refusals")
  rg = jcount(grbody, "refusals")
  if re < 0
    return "re-run derivation: the produced faces disagree on refusal rows"
  if re != rg
    return "re-run derivation: the produced faces disagree on refusal rows"
  i = 1
  while i <= re
    if wrefkey(jitem(expbody, "concept.refusals", i)) != wrefkey(jitem(grbody, "refusals", i))
      return "re-run derivation: the produced faces disagree on refusal rows"
    i = i + 1
  ""

prowfor: str = (grbody: str, key: str)
  n = jcount(grbody, "concepts")
  i = 1
  while i <= n
    row = jitem(grbody, "concepts", i)
    if wrowkey(row) == key
      return row
    i = i + 1
  ""

preffof: str = (grbody: str, key: str)
  n = jcount(grbody, "refusals")
  i = 1
  while i <= n
    row = jitem(grbody, "refusals", i)
    if wrefkey(row) == key
      return row
    i = i + 1
  ""

pacquire: str = (idraw: str, edit: str, file: str, bin: str)
  unknown = jdec(jget(edit, "unknown"))
  if unknown == ""
    return werr(idraw, -32602, "invalid-params", "supply edit.unknown as a stable unknown id", "caller", "[\"preview\"]")
  if pnfacets(unknown) != 5
    return werr(idraw, -32602, "invalid-params", "edit.unknown is not a well-formed unknown id", "caller", "[\"preview\"]")
  if pfacet(unknown, 1) != "call"
    return werr(idraw, -32602, "invalid-params", "edit.unknown is not a well-formed unknown id", "caller", "[\"preview\"]")
  if pfacet(unknown, 2) == ""
    return werr(idraw, -32602, "invalid-params", "edit.unknown is not a well-formed unknown id", "caller", "[\"preview\"]")
  if wdigits(pfacet(unknown, 3)) < 0
    return werr(idraw, -32602, "invalid-params", "edit.unknown is not a well-formed unknown id", "caller", "[\"preview\"]")
  if wdigits(pfacet(unknown, 4)) < 0
    return werr(idraw, -32602, "invalid-params", "edit.unknown is not a well-formed unknown id", "caller", "[\"preview\"]")
  if wdigits(pfacet(unknown, 5)) < 0
    return werr(idraw, -32602, "invalid-params", "edit.unknown is not a well-formed unknown id", "caller", "[\"preview\"]")
  decision = jdec(jget(edit, "decision"))
  if decision != "acquire"
    if decision != "decline"
      return werr(idraw, -32602, "invalid-params", "supply edit.decision as acquire or decline", "caller", "[\"preview\"]")
  orc = os.execute("test -r " .. shq(file))
  if orc != 0
    return werr(idraw, -32000, "unreadable-subject", "supply a readable subject file", "caller", "[\"preview\"]")
  raw = pgraphraw(bin, file)
  if wtexit(raw) != 0
    return werr(idraw, -32000, "derivation-failed", "inspect the world binary at " .. bin .. ": graph did not complete for this subject", "world-binary", "[\"preview\"]")
  body = wtbody(raw)
  inu = plisted(body, "unresolved_applications", unknown)
  inb = plisted(body, "blocking_applications", unknown)
  if inu == 0
    if inb == 0
      return werr(idraw, -32000, "projection-stale", "re-derive the frontier: the unknown is no longer listed", "preview", "[\"preview\"]")
  nu = jcount(body, "unresolved_applications")
  nb = jcount(body, "blocking_applications")
  if nu < 0
    nu = 0
  if nb < 0
    nb = 0
  payoff = inu * 50 + inb * 100
  vg = payoff - 50
  vp = payoff - 90
  how = "runtime-guard"
  best = vg
  if vp > best
    best = vp
    how = "static-proof"
  rec = "decline"
  if best > 0
    rec = "acquire-via-" .. how
  prop = "\{\"action\":" .. jesc(decision) .. ",\"target\":" .. jesc(unknown) .. ",\"affected_region\":\{\"blocked_applications\":" .. pblockedjson(body) .. "\}"
  if decision == "acquire"
    checks = "[\"unknown-present-in-current-frontier\",\"stable-identity-verified\",\"voi-recomputed-from-current-frontier\"]"
    voi = "\{\"payoff_cents\":" .. "{payoff}" .. ",\"cost_guard_cents\":50,\"cost_proof_cents\":90,\"recommendation\":\"" .. rec .. "\"\}"
    prop = prop .. ",\"checks\":" .. checks .. ",\"voi_basis\":" .. voi .. "\}"
  else
    req = "decline recorded against " .. unknown .. ": the subject must resolve this unknown by other means or justify the refusal"
    dchecks = "[\"unknown-present-in-current-frontier\",\"decline-recorded-as-subject-requirement\"]"
    prop = prop .. ",\"checks\":" .. dchecks .. ",\"requirement\":" .. jesc(req) .. "\}"
  prov = "\{\"subject\":" .. jesc(file) .. ",\"subject_hash\":\"" .. phash(file) .. "\",\"derivation\":\"idol graph\",\"frontier\":\{\"unresolved\":" .. "{nu}" .. ",\"blocking\":" .. "{nb}" .. "\}\}"
  payload = "\{\"status\":\"proposal\",\"proposal\":" .. prop .. ",\"provenance\":" .. prov .. "\}"
  pok(idraw, payload)

pidentify: str = (idraw: str, edit: str, file: str, bin: str)
  a = jdec(jget(edit, "a"))
  b = jdec(jget(edit, "b"))
  if a == ""
    return werr(idraw, -32602, "invalid-params", "supply edit.a and edit.b as concept rowkeys", "caller", "[\"preview\"]")
  if b == ""
    return werr(idraw, -32602, "invalid-params", "supply edit.a and edit.b as concept rowkeys", "caller", "[\"preview\"]")
  orc = os.execute("test -r " .. shq(file))
  if orc != 0
    return werr(idraw, -32000, "unreadable-subject", "supply a readable subject file", "caller", "[\"preview\"]")
  expraw = pexplainraw(bin, file)
  if wtexit(expraw) != 0
    return werr(idraw, -32000, "derivation-failed", "inspect the world binary at " .. bin .. ": explain did not complete for this subject", "world-binary", "[\"preview\"]")
  graraw = pgraphraw(bin, file)
  if wtexit(graraw) != 0
    return werr(idraw, -32000, "derivation-failed", "inspect the world binary at " .. bin .. ": graph did not complete for this subject", "world-binary", "[\"preview\"]")
  expbody = wtbody(expraw)
  grbody = wtbody(graraw)
  agree = pagree(expbody, grbody)
  if agree != ""
    return werr(idraw, -32000, "face-disagreement", agree, "world-binary", "[\"preview\"]")
  fa = preffof(grbody, a)
  fb = preffof(grbody, b)
  if fa != ""
    return werr(idraw, -32000, "contradictory", "side a is a refusal row, not a concept: supply a concept rowkey from the current concept projection", "preview", "[\"preview\"]")
  if fb != ""
    return werr(idraw, -32000, "contradictory", "side b is a refusal row, not a concept: supply a concept rowkey from the current concept projection", "preview", "[\"preview\"]")
  ra = prowfor(grbody, a)
  rb = prowfor(grbody, b)
  if ra == ""
    return werr(idraw, -32000, "unknown-concept", "supply rowkeys from the current concept projection", "preview", "[\"preview\"]")
  if rb == ""
    return werr(idraw, -32000, "unknown-concept", "supply rowkeys from the current concept projection", "preview", "[\"preview\"]")
  diff = "["
  opts = "["
  first = 1
  on = 0
  i = 1
  while i <= 6
    va = pfacet(a, i)
    vb = pfacet(b, i)
    if va != vb
      if first == 0
        diff = diff .. ","
      first = 0
      diff = diff .. jesc(pfname(i))
      o1 = "\{\"change\":" .. jesc("adopt facet " .. pfname(i) .. " = " .. va .. " from side a for the unified subject") .. ",\"requires\":\"re-derivation of the concept projection after the subject edit\"\}"
      o2 = "\{\"change\":" .. jesc("adopt facet " .. pfname(i) .. " = " .. vb .. " from side b for the unified subject") .. ",\"requires\":\"re-derivation of the concept projection after the subject edit\"\}"
      if on > 0
        opts = opts .. ","
      opts = opts .. o1 .. "," .. o2
      on = on + 2
    i = i + 1
  diff = diff .. "]"
  opts = opts .. "]"
  prov = "\{\"subject\":" .. jesc(file) .. ",\"subject_hash\":\"" .. phash(file) .. "\",\"derivation\":\"idol explain + idol graph\",\"faces\":\"agree\"\}"
  if first == 1
    iprop = "\{\"fact\":\"identity\",\"subjects\":[" .. jesc(a) .. "," .. jesc(b) .. "],\"affected_region\":\{\"concepts\":[" .. jesc(a) .. "," .. jesc(b) .. "]\},\"checks\":[\"row-keys-identical\"]\}"
    return pok(idraw, "\{\"status\":\"proposal\",\"proposal\":" .. iprop .. ",\"provenance\":" .. prov .. "\}")
  pok(idraw, "\{\"status\":\"ambiguous\",\"subjects\":[" .. jesc(a) .. "," .. jesc(b) .. "],\"differing_facets\":" .. diff .. ",\"options\":" .. opts .. ",\"provenance\":" .. prov .. "\}")

qt: str = "\""
lbr: str = "{"
rbr: str = "}"
jstr: str = (s: str)
  jesc(s)
jkv: str = (k: str, v: str)
  qt .. k .. qt .. ":" .. jstr(v)
jarr2: str = (a: str, b: str)
  "[" .. jstr(a) .. "," .. jstr(b) .. "]"

cknown: i64 = (name: str)
  if name == "no-alloc" 1
  if name == "no-effect" 1
  if name == "keep-first" 1
  if name == "keep-last" 1
  if name == "report-conflict" 1
  if name == "merge-identical" 1
  0

cvalid: i64 = (demand: str)
  if demand == "" 0
  if jcountkey(demand, " ") == 1 0
  cknown(demand)

cregion: i64 = (r: str)
  if r == "" 0
  if jcountkey(r, " ") == 1 0
  if r:find("..", 1, 1) != 0 0
  1

cregionv: i64 = (r: str)
  i = 1
  n = r:len()
  while i <= n
    c = r:sub(i, i)
    ok = 0
    if c >= "a" and c <= "z" ok = 1
    if c >= "A" and c <= "Z" ok = 1
    if c >= "0" and c <= "9" ok = 1
    if c == "." ok = 1
    if c == "_" ok = 1
    if c == "-" ok = 1
    if c == "/" ok = 1
    if ok == 0 return 0
    i = i + 1
  1

candsok: i64 = (cand: str)
  if cand == "keep-first" 1
  if cand == "keep-last" 1
  if cand == "report-conflict" 1
  if cand == "merge-identical" 1
  0

ckinds: i64 = (kinds: str)
  rem = kinds
  while true
    c = rem:find(",", 1, 1)
    if c == 0 break
    k = rem:sub(1, c - 1)
    if candsok(k) == 0 return 0
    rem = rem:sub(c + 1, rem:len())
  if rem == "" 0
  candsok(rem)

cshapes: i64 = (a: str, b: str)
  if candsok(a) == 0 or candsok(b) == 0 return 0
  1

pbininfo: str = (bin: str)
  qb = shq(bin)
  hraw = gatecap("sha256sum -- " .. qb)
  h = hraw:sub(1, 64)
  if h == "" h = "unknown"
  scar = gatecap("cat -- " .. qb .. ".buildid")
  rev = "unknown"
  if jcountkey(scar, "revision") == 1
    r = jdec(jget(scar, "revision"))
    if r != "" rev = r
  h .. "|" .. rev

pprov: str = (file: str, bin: str, tail: str)
  bi = pbininfo(bin)
  bar = bi:find("|", 1, 1)
  h = bi:sub(1, bar - 1)
  rev = bi:sub(bar + 1, bi:len())
  lbr .. jkv("subject", file) .. "," .. jkv("subject_hash", phash(file)) .. "," .. jkv("world_bin", bin) .. "," .. jkv("world_binhash", h) .. "," .. jkv("revision", rev) .. tail .. rbr

pfuncid: i64 = (body: str, region: str)
  n = jcount(body, "applications")
  i = 1
  while i <= n
    it = jitem(body, "applications", i)
    id = jget(it, "application")
    if id == region return 1
    i = i + 1
  0

papps: str = (body: str, region: str)
  out = ""
  sep = ""
  n = jcount(body, "applications")
  i = 1
  while i <= n
    it = jitem(body, "applications", i)
    id = jget(it, "application")
    if id == region or region == "all"
      out = out .. sep .. "app:" .. id
      sep = ","
    i = i + 1
  out

pappuid: str = (body: str, region: str)
  n = jcount(body, "applications")
  i = 1
  while i <= n
    it = jitem(body, "applications", i)
    id = jget(it, "application")
    if id == region return jget(it, "uid")
    i = i + 1
  ""

pconok: i64 = (body: str, region: str, demand: str)
  n = jcount(body, "applications")
  i = 1
  while i <= n
    it = jitem(body, "applications", i)
    id = jget(it, "application")
    if id == region or region == "all"
      ec = jget(jget(it, "effect"), "card")
      rc = jget(jget(it, "realization"), "card")
      if demand == "no-effect" and ec != "none" return 0
      if demand == "no-alloc" and rc == "many" return 0
    i = i + 1
  1

pconstrain: str = (idraw: str, edit: str, file: str, bin: str)
  demand = jdec(jget(edit, "demand"))
  if cvalid(demand) == 0
    return prefuse("unknown-concept", "demand '" .. demand .. "' is not a known demand concept", "identify")
  region = jdec(jget(edit, "region"))
  if region == "" region = "all"
  if cregion(region) == 0
    return prefuse("unknown-concept", "region '" .. region .. "' is not a valid region", "identify")
  if region != "all" and cregionv(region) == 0
    return prefuse("unknown-concept", "region '" .. region .. "' contains invalid characters", "identify")
  graw = pgraphraw(bin, file)
  if wtexit(graw) != 0
    return prefuse("projection-stale", "graph derivation failed for demand projection", "identify")
  gbody = wtbody(graw)
  if region != "all" and pfuncid(gbody, region) == 0
    return prefuse("unknown-concept", "region '" .. region .. "' matches no application", "identify")
  if pconok(gbody, region, demand) == 0
    return prefuse("contradictory", "application " .. pappuid(gbody, region) .. " carries a required demand realization that '" .. demand .. "' forbids", "identify")
  checks = "[" .. lbr .. jkv("id", "demand-realization") .. "," .. jkv("status", "pass") .. rbr .. "," .. lbr .. jkv("id", "demand-region") .. "," .. jkv("status", "pass") .. rbr .. "," .. lbr .. jkv("id", "demand-known") .. "," .. jkv("status", "pass") .. rbr .. "]"
  applist = papps(gbody, region)
  n = jcount(gbody, "applications")
  voib = lbr .. jkv("basis", "demand-realization") .. rbr
  prop = lbr .. jkv("kind", "proposal") .. "," .. jkv("operation", "impose-requirement") .. "," .. jkv("projection", "demand") .. "," .. jkv("demand", demand) .. "," .. jkv("region", region) .. "," .. jkv("applications", applist) .. "," .. qt .. "voi_basis" .. qt .. ":" .. voib .. "," .. qt .. "checks" .. qt .. ":" .. checks .. "," .. qt .. "provenance" .. qt .. ":" .. pprov(file, bin, "") .. rbr
  lbr .. jkv("kind", "proposal") .. "," .. qt .. "proposal" .. qt .. ":" .. prop .. rbr

cqid: str = (sha: str, region: str, kind: str, clist: str)
  qs = shq(sha .. "|" .. region .. "|" .. kind .. "|" .. clist)
  qraw = gatecap("printf '%s' " .. qs .. " | sha256sum 2>/dev/null")
  qraw:sub(1, 64)

cobs: str = (name: str)
  if name == "keep-first"
    return lbr .. qt .. "d1" .. qt .. ":" .. lbr .. qt .. "ts" .. qt .. ":100," .. qt .. "payload" .. qt .. ":" .. jstr("a") .. rbr .. rbr
  if name == "keep-last"
    return lbr .. qt .. "d1" .. qt .. ":" .. lbr .. qt .. "ts" .. qt .. ":100," .. qt .. "payload" .. qt .. ":" .. jstr("b") .. rbr .. rbr
  lbr .. qt .. "conflict" .. qt .. ":" .. lbr .. qt .. "key" .. qt .. ":" .. jstr("d1") .. "," .. qt .. "ts" .. qt .. ":100," .. qt .. "payloads" .. qt .. ":" .. jarr2("a", "b") .. rbr .. rbr

panswer: str = (idraw: str, edit: str, file: str, bin: str)
  qid = jdec(jget(edit, "question_id"))
  if qid == ""
    return prefuse("unknown-concept", "contrast answer needs question_id", "identify")
  kind = jdec(jget(edit, "merge_kind"))
  if kind == "" kind = "tiebreak"
  cands = jdec(jget(edit, "candidates"))
  if cands == ""
    return prefuse("unknown-concept", "contrast answer needs candidates", "identify")
  if ckinds(cands) == 0
    return prefuse("unknown-concept", "candidates contain unknown merge kinds", "identify")
  region = jdec(jget(edit, "region"))
  if region == "" region = "all"
  sha = phash(file)
  if sha == ""
    return prefuse("projection-stale", "subject hash unavailable", "identify")
  expect = cqid(sha, region, kind, cands)
  if qid != expect
    return prefuse("subject-changed", "question_id does not match current subject; recompute contrast", "identify")
  checks = "[" .. lbr .. jkv("id", "contrast-question") .. "," .. jkv("status", "pass") .. rbr .. "," .. lbr .. jkv("id", "contrast-candidates") .. "," .. jkv("status", "pass") .. rbr .. "]"
  prop = lbr .. jkv("kind", "proposal") .. "," .. jkv("operation", "impose-requirement") .. "," .. jkv("projection", "contrast") .. "," .. jkv("question_id", qid) .. "," .. jkv("merge_kind", kind) .. "," .. jkv("candidates", cands) .. "," .. jkv("region", region) .. "," .. qt .. "checks" .. qt .. ":" .. checks .. "," .. qt .. "provenance" .. qt .. ":" .. pprov(file, bin, "") .. rbr
  lbr .. jkv("kind", "proposal") .. "," .. qt .. "proposal" .. qt .. ":" .. prop .. rbr

pmerge: str = (idraw: str, edit: str, file: str, bin: str)
  qid = jdec(jget(edit, "question_id"))
  if qid == ""
    return prefuse("unknown-concept", "contrast merge needs question_id", "identify")
  a = jdec(jget(edit, "candidate_a"))
  b = jdec(jget(edit, "candidate_b"))
  if candsok(a) == 0 or candsok(b) == 0
    return prefuse("unknown-concept", "merge candidates must be known merge kinds", "identify")
  region = jdec(jget(edit, "region"))
  if region == "" region = "all"
  sha = phash(file)
  if sha == ""
    return prefuse("projection-stale", "subject hash unavailable", "identify")
  clist = a .. "," .. b
  expect = cqid(sha, region, "merge", clist)
  if qid != expect
    return prefuse("subject-changed", "question_id does not match current subject; recompute contrast", "identify")
  oa = cobs(a)
  ob = cobs(b)
  if jget(oa, "d1") != "" and jget(ob, "conflict") != ""
    return prefuse("face-disagreement", "merge candidate faces disagree on observation shape", "identify")
  if jget(oa, "conflict") != "" and jget(ob, "d1") != ""
    return prefuse("face-disagreement", "merge candidate faces disagree on observation shape", "identify")
  checks = "[" .. lbr .. jkv("id", "contrast-question") .. "," .. jkv("status", "pass") .. rbr .. "," .. lbr .. jkv("id", "contrast-shapes") .. "," .. jkv("status", "pass") .. rbr .. "]"
  if oa == ob
    prop = lbr .. jkv("kind", "proposal") .. "," .. jkv("operation", "impose-requirement") .. "," .. jkv("projection", "contrast") .. "," .. jkv("question_id", qid) .. "," .. jkv("candidates", clist) .. "," .. jkv("region", region) .. "," .. qt .. "merged" .. qt .. ":" .. jstr(oa) .. "," .. qt .. "checks" .. qt .. ":" .. checks .. "," .. qt .. "provenance" .. qt .. ":" .. pprov(file, bin, "") .. rbr
    return lbr .. jkv("kind", "proposal") .. "," .. qt .. "proposal" .. qt .. ":" .. prop .. rbr
  opts = "[" .. lbr .. jkv("kind", "realization") .. "," .. jkv("candidate", a) .. "," .. qt .. "observation" .. qt .. ":" .. jstr(oa) .. rbr .. "," .. lbr .. jkv("kind", "realization") .. "," .. jkv("candidate", b) .. "," .. qt .. "observation" .. qt .. ":" .. jstr(ob) .. rbr .. "," .. lbr .. jkv("kind", "decline") .. rbr .. "]"
  amb = lbr .. jkv("kind", "ambiguous") .. "," .. jkv("question_id", qid) .. "," .. qt .. "options" .. qt .. ":" .. opts .. "," .. qt .. "checks" .. qt .. ":" .. checks .. "," .. qt .. "provenance" .. qt .. ":" .. pprov(file, bin, "") .. rbr
  lbr .. jkv("kind", "ambiguous") .. "," .. qt .. "proposal" .. qt .. ":" .. amb .. rbr

prefuse: str = (code: str, msg: str, producer: str)
  lbr .. jkv("kind", "refusal") .. "," .. jkv("reason", code) .. "," .. jkv("message", msg) .. "," .. jkv("next", "identify") .. "," .. jkv("producer", producer) .. "," .. qt .. "not-performed" .. qt .. ":true" .. rbr

presp: str = (line: str, idraw: str)
  args = jget(line, "params.arguments")
  if args == ""
    return werr(idraw, -32602, "invalid-params", "supply params.arguments as an object", "caller", "[\"preview\"]")
  file = jdec(jget(args, "file"))
  if file == ""
    return werr(idraw, -32602, "invalid-params", "supply arguments.file as a subject path string", "caller", "[\"preview\"]")
  projection = jdec(jget(args, "projection"))
  if projection != "frontier"
    if projection != "concept"
      if projection != "demand"
        if projection != "contrast"
          return werr(idraw, -32602, "invalid-params", "supply arguments.projection as frontier, concept, demand, or contrast", "caller", "[\"preview\"]")
  edit = jget(args, "edit")
  if edit == ""
    return werr(idraw, -32602, "invalid-params", "supply arguments.edit as an object", "caller", "[\"preview\"]")
  kind = jdec(jget(edit, "kind"))
  if kind != "acquire"
    if kind != "identify"
      if kind != "constrain"
        if kind != "answer"
          if kind != "merge"
            return werr(idraw, -32602, "invalid-params", "supply edit.kind as acquire, identify, constrain, answer, or merge", "caller", "[\"preview\"]")
  if kind == "acquire" and projection != "frontier"
    return werr(idraw, -32602, "invalid-params", "acquire edits apply to the frontier projection", "caller", "[\"preview\"]")
  if kind == "identify" and projection != "concept"
    return werr(idraw, -32602, "invalid-params", "identify edits apply to the concept projection", "caller", "[\"preview\"]")
  if kind == "constrain" and projection != "demand"
    return werr(idraw, -32602, "invalid-params", "constrain edits apply to the demand projection", "caller", "[\"preview\"]")
  if kind == "answer" and projection != "contrast"
    return werr(idraw, -32602, "invalid-params", "answer edits apply to the contrast projection", "caller", "[\"preview\"]")
  if kind == "merge" and projection != "contrast"
    return werr(idraw, -32602, "invalid-params", "merge edits apply to the contrast projection", "caller", "[\"preview\"]")
  bin = env("IDOL_WORLD_BIN") or ""
  if bin == ""
    bin = "./zig-out/bin/idol"
  if kind == "acquire"
    return pacquire(idraw, edit, file, bin)
  if kind == "identify"
    return pidentify(idraw, edit, file, bin)
  if kind == "constrain"
    return pok(idraw, pconstrain(idraw, edit, file, bin))
  if kind == "answer"
    return pok(idraw, panswer(idraw, edit, file, bin))
  pok(idraw, pmerge(idraw, edit, file, bin))

main: i64 = ()
  line = stdin:line()
  idraw = jget(line, "id")
  stdout:write(presp(line, idraw))
  0
main()
