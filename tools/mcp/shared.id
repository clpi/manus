        return fs:read_file(canonpath)
    end
    "Canonical index not found at {canonpath}"
end

fun perf_ledger(): str
    if fs:exists(perfpath)
        return string.sub(fs:read_file(perfpath), 1, 10000)
    end
    "Performance ledger not found at {perfpath}"
end
# Gate-private bootstrap projection for GAP-119. The harness owns these
# witnesses; this relation only projects its retained artifact into fields.
observe: any = (proof: any, line: str)
    if line:find("All 40 benchmark results match reference C for .lua and .id.", 1, true) > 0
        proof.correct = true
    if line:find("fold classifier control: 11/11 agree", 1, true) > 0
        proof.fold = true
    if line:find("REMOVED from the speed table (gap[096]), 3 of 40 rows", 1, true) > 0
        proof.removal = true
    if line:find("negative control on real data: the rule fires on 0 rows", 1, true) > 0
        proof.negative = true
    if line:find("All benchmarks: results match and Duo .lua/.id >= C on measured time", 1, true) > 0
        proof.speed = true
    if line:find("mismatch", 1, true) > 0
        proof.failures:push("mismatch")
    if line:find("FAIL:", 1, true) > 0
        proof.failures:push("FAIL:")
    if line:find("error:", 1, true) > 0
        proof.failures:push("error:")
    proof

prove: any = (suite: str)
    if suite != "bench"
        return {
            passed = false
            suite = suite
            status = -1
            error = "benchmark proof supports only the release bench suite"
        }
    path = os.tmpname()
    command = "zig build bench"
    run = runcapture("{command} > '{path}' 2>&1")
    status = run.status
    proof = {
        correct = false
        fold = false
        removal = false
        negative = false
        speed = false
        failures = {}
        observe = observe
    }
    artifact = document(path, "benchmark", 0)
    if not artifact.exists
        proof.failures:push("artifact")
    else
        for line in artifact.text:split("\n")
            proof = proof:observe(line)
    positive = { correct = false, fold = false, removal = false, negative = false, speed = false, failures = {}, observe = observe }
    positive = positive:observe("All 40 benchmark results match reference C for .lua and .id.")
    positive = positive:observe("fold classifier control: 11/11 agree")
    positive = positive:observe("REMOVED from the speed table (gap[096]), 3 of 40 rows")
    positive = positive:observe("negative control on real data: the rule fires on 0 rows")
    positive = positive:observe("All benchmarks: results match and Duo .lua/.id >= C on measured time")
    reject = { correct = false, fold = false, removal = false, negative = false, speed = false, failures = {}, observe = observe }
    reject = reject:observe("FAIL: synthetic control")
    controls = positive.correct and positive.fold and positive.removal
        and positive.negative and positive.speed and positive.failures:len() == 0
        and reject.failures:len() == 1
    {
        passed = status == 0 and proof.correct and proof.fold and proof.removal
            and proof.negative and proof.speed and proof.failures:len() == 0 and controls
        correct = proof.correct
        fold = proof.fold
        removal = proof.removal
        negative = proof.negative
        speed = proof.speed
        failures = proof.failures
        suite = suite
        status = status
        artifact = path
        gate = "zig build bench"
        controls = controls
    }

# === Open performance gaps ===
# Surface perf / native-lowering / codegen gaps that are still open in the
# cross-agent gap buffer, plus a performance.md excerpt for context.
fun perf_gaps(): any
    content = coordination_read()
    lines = string.split(content, "\n")
    gaps = {}
    i = 1
    while i <= lines:len()
        ln = lines[i]
        if string.sub(ln, 1, 4) == "| F-" then
            kind_match = false
            if string.find(ln, "perf_gap", 1, true) ~= nil then kind_match = true end
            if string.find(ln, "native_lowering", 1, true) ~= nil then kind_match = true end
            if string.find(ln, "codegen_gap", 1, true) ~= nil then kind_match = true end
            status_open = false
            if string.find(ln, "| open |", 1, true) ~= nil then status_open = true end
            if kind_match
                if status_open then _ = table.insert(gaps, ln) end
            end
        end
        i += 1
    end
    perf = ""
    if fs:exists(perfpath) then
        perf = string.sub(fs:read_file(perfpath), 1, 4000)
    end
    {
        open_perf_gap_count = gaps:len(),
        gaps = gaps,
        perf_ledger_excerpt = perf,
    }
end
# === Codegen-pitfall audit ===
# Detect the known silent-correctness codegen bugs (F-13813-2 call-as-tail
# premature return; F-13813-3 nil-init void* inference) in a .id source file,
# with the verified workaround for each. Protects every duo developer from
# spending hours on these. Literal scans only (pattern engine is unreliable).
fun audit_codegen_pitfalls(file_path: str): any
    if not fs:exists(file_path) then
        return { error = "file not found: {file_path}" }
    end
    src = fs:read_file(file_path)
    lines = string.split(src, "\n")
    findings = {}
    i = 1
    while i <= lines:len()
        ln = lines[i]
        tr = str_trim(ln)
        -- F-13813-3: `= nil` init risks void* type inference
        if string.find(tr, "= nil", 1, true) ~= nil then
            _ = table.insert(findings, {
                line = i,
                rule = "F-13813-3 nil-init",
                risk = "sema infers void*; later typed assignment fails to compile or mis-codes",
                fix = "initialize with a typed sentinel (\"\" / 0 / {} / false)",
            })
        end
        -- F-13813-2: a bare call statement as the LAST statement of an if/for/while
        -- block emits `return call(...)`, exiting the enclosing function early.
        is_tail = false
        if i < lines:len() then
            j = i + 1
            nxt = ""
            while j <= lines:len()
                nxt = str_trim(lines[j])
                if nxt:len() > 0 then break end
                j += 1
            end
            -- Prefix checks via string.find (NUMBER result); string == is
            -- unreliable inside while loops (duo codegen bug).
            if string.find(nxt, "end", 1, true) == 1 then is_tail = true end
            if string.find(nxt, "else", 1, true) == 1 then is_tail = true end
            if string.find(nxt, "elseif", 1, true) == 1 then is_tail = true end
        end
        if is_tail then
            bare_call = false
            has_assign = string.find(tr, " = ", 1, true) ~= nil
            starts_return = string.find(tr, "return ", 1, true) == 1
            if (not has_assign) and (not starts_return) then
                paren = string.find(tr, "(", 1, true)
                if paren ~= nil and paren > 1 then
                    head = string.sub(tr, 1, paren - 1)
                    -- head must be a bare identifier/path; validate via string.byte
                    -- (number comparison — string == fails inside loops).
                    head_ok = true
                    k = 1
                    while k <= head:len()
                        code = string.byte(head, k)
                        ok_c = false
                        if code >= 48 and code <= 57 then ok_c = true end
                        if code >= 65 and code <= 90 then ok_c = true end
                        if code >= 97 and code <= 122 then ok_c = true end
                        if code == 46 then ok_c = true end
                        if code == 95 then ok_c = true end
                        if not ok_c then head_ok = false end
                        k += 1
                    end
                    if head_ok then bare_call = true end
                end
            end
            if bare_call then
                _ = table.insert(findings, {
                    line = i,
                    rule = "F-13813-2 call-as-tail",
                    risk = "codegen emits premature return; enclosing function exits here",
                    fix = "prefix with `_ = `  (e.g.  `_ = table.insert(t, v)`)",
                })
            end
        end
        i += 1
    end
    {
        file = file_path,
        finding_count = findings:len(),
        findings = findings,
        summary = "Scanned {lines:len()} lines; {findings:len()} codegen-pitfall(s)."
    }
end
# === Exponential evaluator ===
# Analyze Duo source for metaprogramming opportunities and emit @comp.* suggestions.
# Pure-pattern detection; no lua_Value ever produced. Optionally audits native
# boxing when file_path points at a real .id file.
TYPE_SUFFIXES = { "i64", "f64", "i32", "f32", "str", "bool", "u64", "u32" }

fun str_trim(s: str): str
    -- Uses string.byte + NUMBER comparison, not string == / ~=. Duo codegen
    -- mis-compares string.sub results inside while loops (c == " " is false for
    -- a space). Number comparison (byte ~= 32) is reliable. Space=32, tab=9.
    a = 1
    b = s:len()
    while a <= b
        code = string.byte(s, a)
        if code ~= 32 and code ~= 9 then break end
        a += 1
    end
    while b >= a
        code = string.byte(s, b)
        if code ~= 32 and code ~= 9 then break end
        b -= 1
    end
    string.sub(s, a, b)
end

fun exponential_evaluate(code: str, file_path: str): any
    suggestions = {}
    lines = string.split(code, "\n")

    -- Detector A: manually monomorphized functions (fun name_SUFFIX(...))
    -- Pattern-free: duo's %s+ and [..] classes are unreliable, so we use find+sub.
    bases = {}
    for i = 1, lines:len()
        t = str_trim(lines[i])
        nm = ""
        if string.sub(t, 1, 4) == "fun "
            pp = string.find(t, "%(")
            if pp and pp > 5
                nm = str_trim(string.sub(t, 5, pp - 1))
            end
        end
        if nm:len() > 0
            for si = 1, TYPE_SUFFIXES:len()
                suf = TYPE_SUFFIXES[si]
                slen = suf:len() + 1
                if nm:len() > slen and string.sub(nm, -slen) == "_{suf}"
                    base = string.sub(nm, 1, nm:len() - slen)
                    bases[base] = bases[base] or {}
                    bases[base][suf] = i
                end
            end
        end
    end
    for base, tys in bases
        cnt = 0
        first = 0
        for ty, ln in tys
            cnt += 1
            if first == 0 or ln < first then first = ln end
        end
        if cnt >= 2
            _ = table.insert(suggestions, {
                kind = "exponential_opportunity",
                line = first,
                construct = "@comp.map / @comp.derive",
                rationale = "'{base}' is hand-monomorphized across {cnt:to(str)} types; one @comp.map emits all variants with zero lua_Value."
                multiplier = "O({cnt:to(str)} decls <= 1 call)"
            })
        end
    end

    -- Detector B: runtime type-string dispatch (if t == "i64" ... elseif "f64")
    dispatch_hits = 0
    dispatch_line = 0
    for i = 1, lines:len()
        if string.find(lines[i], '== "i64"') or string.find(lines[i], '== "f64"') or string.find(lines[i], '== "i32"') or string.find(lines[i], '== "f32"')
            dispatch_hits += 1
            if dispatch_line == 0 then dispatch_line = i end
        end
    end
    if dispatch_hits >= 2
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = dispatch_line,
            construct = "@comp.select / @comp.product",
            rationale = "Runtime type-string branching ({dispatch_hits:to(str)} arms) collapses to a compile-time type dispatch."
            multiplier = "O(branches -> 0 runtime cost)",
        })
    end

    -- Detector C: >=3 consecutive incrementing indexed writes (arr[1]=, arr[2]=, ...)
    run_len = 0
    run_prev = -1
    run_start = 0
    c_line = 0
    for i = 1, lines:len()
        t = str_trim(lines[i])
        b1 = string.find(t, "%[")
        b2 = string.find(t, "%]")
        eq = string.find(t, "=")
        if b1 and b2 and b2 > b1 and eq and eq > b2
            idx_s = str_trim(string.sub(t, b1 + 1, b2 - 1))
            idx = tonumber(idx_s)
            if idx
                if run_len > 0 and idx == run_prev + 1
                    run_len += 1
                else
                    run_len = 1
                    run_start = i
                end
                run_prev = idx
                if run_len >= 3 and c_line == 0 then c_line = run_start end
            else
                run_len = 0
            end
        else
            run_len = 0
        end
    end
    if c_line > 0
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = c_line,
            construct = "@comp.compile.unroll",
            rationale = "Sequential indexed writes form a bounded loop; @comp.compile.unroll expands it at compile time.",
            multiplier = "O(n statements -> 1 loop)",
        })
    end

    -- Detector D: repeated record-type boilerplate (>=3 'type X = {')
    type_defs = 0
    type_line = 0
    for i = 1, lines:len()
        t = str_trim(lines[i])
        if string.sub(t, 1, 5) == "type " and string.find(t, "{") and string.find(t, "=")
            type_defs += 1
            if type_line == 0 then type_line = i end
        end
    end
    if type_defs >= 3
        _ = table.insert(suggestions, {
            kind = "exponential_opportunity",
            line = type_line,
            construct = "@comp.derive.bundle",
            rationale = "{type_defs:to(str)} record types; @comp.derive.bundle generates shared trait impls for all in one annotation."
            multiplier = "O(types x traits <= 1 annotation)",
        })
    end

    -- Detector E: comptime-foldable literal arithmetic (var = digits op digits, no vars)
    for i = 1, lines:len()
        t = str_trim(lines[i])
        eq = string.find(t, "=")
        if eq and eq > 1 and string.sub(t, eq, eq + 1) ~= "=="
            rhs = str_trim(string.sub(t, eq + 1))
            if not string.find(rhs, "[%a]") and (string.find(rhs, "[%*]") or string.find(rhs, "[%+]") or string.find(rhs, "[/]"))
                _ = table.insert(suggestions, {
                    kind = "ergonomic_gap",
                    line = i,
                    construct = "@(expr)",
                    rationale = "Constant arithmetic '{rhs}{\"' folds at compile time with @( ... ).\",}"
                    multiplier = "O(1 runtime -> 0)",
                })
            end
        end
    end

    -- Annotated preview: prepend a discovery header listing every opportunity.
    optimized = code
    if suggestions:len() > 0
        scount = suggestions:len()
        optimized = "# @comp exponential-eval: {scount:to(str)} opportunity(s)\n"
        for _, s in suggestions
            optimized = "{optimized}# [L{s.line:to(str)}] {s.construct}: {s.rationale}\n"
        end
        optimized = "{optimized}{code}"
    end

    result = {
        file = file_path or "<inline>",
        suggestion_count = suggestions:len(),
        suggestions = suggestions,
        optimized_preview = optimized,
    }
    if file_path and file_path ~= "" and fs:exists(file_path)
        result.boxing = audit_native_boxing(file_path)
    end
    result
end

# === Exponential mentoring: Onboarding guidance for metaprogramming ===

fun exponential_onboard(question: str, code: str): any
    default = "Exponential metaprogramming: write less source, get more native specialization via @comp.map, @comp.derive.all, @comp.burst, and @comp.tensor."
    derive = "Use @comp.derive.all when structures repeat getters/setters across stable fields."
    mapnote = "@comp.map emits one specialized native function per type with no runtime dispatch."
    questions = {
        ["what is exponential metaprogramming"] = default,
        ["when to use derive"] = derive,
        ["how map differs from regular function"] = mapnote,
    }
    if question == "" or question == nil
        return { guidance = default, question = question }
    end
    q_lower = string.lower(question)
    for key, val in questions
        if string.find(q_lower, string.lower(key), 1, true) ~= nil
            return { guidance = val, question = question, matched = key }
        end
    end
    { error = "Question not recognized. Try: what is exponential metaprogramming, when to use derive, how map differs from regular function" }
end

fun combinator_info(path: str): any
    result = {
        map = {
            name = "@comp.map",
            complexity = "O(n types × fields per type)",
            description = "Transform all types in a collection with a single callback",
            native_fold = true,
            example = "\n                fun add_one(x: i64): i64\n                    x + 1\n                end\n                \n                -- Generates specialized add_one for i32, i64, f32, f64\n                @comp.map(i32, i64, f32, f64, add_one)\n            ",
        },
        ["derive.all"] = {
            name = "@comp.derive.all",
            complexity = "O(n types × fields per type)",
            description = "Auto-generate getters, setters, and methods for all fields",
            native_fold = true,
            example = "\n                concept User\n                    id: i64\n                    name: str\n                end\n                \n                -- Generates: get_id, get_name, set_id, set_name for User\n                @comp.derive.all(User)\n            ",
        },
        tensor = {
            name = "@comp.tensor",
            complexity = "O(n dimensions)",
            description = "Tensor operations with compile-time shape checking",
            native_fold = true,
            device_dispatch = true,
            example = "\n                T = @comp.tensor([256, 256], f32)\n                result = @comp.tensor.matmul(T, T)  -- Native BLAS\n            ",
        },
        ladder = {
            name = "@comp.ladder",
            complexity = "O(1) string output",
            description = "Returns the exponential metaprogramming hierarchy",
            example = "\n                print(@comp.ladder())\n                -- Output: map:O(n) derive:O(n×f) tensor:O(n³) ...\n            ",
        },
    }
    
    if path == "" or path == nil
        return { combinators = table.keys(result), info = "Available combinators: {table.concat(table.keys(result), ", ")}" }
    end
    
    if result[path]
        return result[path]
    end
    
    { error = "Unknown combinator: {path}. Available: {table.concat(table.keys(result), \", \")}" }
end

# ====================================

fun file_finding(kind: str, title: str, detail: str, priority: str, files: str): str
    # IDs must be unique within a second (batch calls share clock.now()); use a
    # per-process counter so same-second filings never collide.
    finding_seq += 1
    ts = clock.utc()
    slot = clock.now() % 100000
    id = "F-{slot:to(str)}-{finding_seq:to(str)}"
    pr = priority
    if pr == "" or pr == nil then pr = "P1" end
    row = "| {id} | {title} | {pr} | {kind} | {ts} | open | {detail} |"
    if files ~= "" then row = "{row} Files: {files} |" end
    content = coordination_read()
    hdr = "| ID | Title | Priority | Kind | Logged | Status | Detail |"
    -- Use plain=true (literal) finds: the marker contains '-', the detail may
    -- contain '%', both of which are Lua-pattern metacharacters and would
    -- corrupt a pattern-based find/gsub.
    mpos = string.find(content, gapsmarker, 1, true)
    if mpos ~= nil then
        hpos = string.find(content, hdr, mpos, true)
        if hpos ~= nil then
            hlen = string.len(hdr)
            content = "{string.sub(content, 1, hpos + hlen - 1)}\n{row}{string.sub(content, hpos + hlen)}"
        else
            content = "{content}\n{row}\n"
        end
    else
        content = "{content}\n\n{gapsmarker}\n\n{hdr}\n| --- | --- | --- | --- | --- | --- | --- |\n{row}\n"
    end
    fs:write_file(coordpath, content)
    "ok: filed {id} ({kind})"
end

# === GAP NUMBER ALLOCATION ============================================
#
# `gaps/` is a shared numeric registry with no allocator. Every session read
# the directory, picked "the next one", and wrote it — so two sessions that
# read before either wrote both picked the same number. That is not
# hypothetical: GAP-065 was filed, overwritten by another session, and had to
# be refiled as GAP-067; three collisions landed in a single night.
#
# The fix is to stop ASKING for a number and start being HANDED one. The
# atomic primitive is mkdir(2): POSIX guarantees that when two processes
# mkdir the same path, exactly one returns 0 and the other gets EEXIST.
# Winning the mkdir IS the allocation. No lock is taken, so there is no lock
# to race, no lock to leak, and no stale-lock heuristic to get wrong.
#
# A reservation directory is never removed. Leaking a number costs nothing;
# reusing one is the bug this exists to prevent.
#
# === gap[076]: mkdir(2) IS ATOMIC ONLY WITHIN ONE FILESYSTEM VIEW ==========
#
# The allocator above was correct and still collided FOUR times in two days,
# because both of its inputs were WORKTREE-LOCAL:
#
#   gaps/                         the working tree's gap files — one branch
#   .agents/session/gapalloc      gitignored, so every worktree has its OWN
#
# Parallel agents in this repo work in `git worktree`s by design (it is the
# mitigation for a bare `git commit` sweeping another session's staged work).
# Two agents in two worktrees therefore mkdir'd two DIFFERENT paths. Both
# won. The POSIX guarantee held perfectly and protected nothing — measured:
# this worktree had no ledger directory at all, while the main checkout's
# held GAP-074, so both would have been handed the same next number.
#
# THE FIX IS TO RESTORE ONE FILESYSTEM VIEW without giving up worktrees.
# `git rev-parse --git-common-dir` names the ONE directory every worktree of
# a repository shares — linked worktrees keep private `.git/worktrees/<name>`
# state but resolve --git-common-dir to the same parent. Putting the
# reservation there makes the mkdir atomicity mean across worktrees exactly
# what it already meant across processes. The 12-process property is
# preserved, not weakened: the primitive is unchanged, only its LOCATION.
#
# Not repo-private state, so it is not gitignored — it is outside the work
# tree entirely, which is why it survives branch switches and worktree
# deletion, and why no `git status` ever shows it.

gapsdir = "{root}/gaps"
# `--path-format=absolute` because a BARE --git-common-dir answers a relative
# ".git" from the main checkout and an absolute path from a linked worktree.
# The two must resolve to one string or the shared view silently splits back
# into the two views this is fixing.
#
# `printf %s "$(…)"` rather than a trailing-newline strip: command
# substitution already drops trailing newlines, and a path may contain
# spaces, so a whitespace-squeeze would corrupt it.
#
# `${g:-…}` covers BOTH failure modes together — git absent (non-zero exit)
# and git answering empty. Without the empty arm a blank answer would build
# the ledger path "/duon-gapalloc" at the filesystem root. Degrading to the
# old worktree-local ledger beats refusing to allocate: with no git there are
# no sibling worktrees to collide with anyway.
#
# Line-oriented process.capture re-appends "\n" to each read line, so trim trailing newline before path use.
# result always carries exactly one trailing newline even against `printf %s`
# — the shell cannot hand back a bare string. Trimming it is not optional:
# the un-trimmed value builds ".git\n/duon-gapalloc", a path with a newline
# in the MIDDLE, and every worktree would still agree on it, so the allocator
# would keep working and stay wrong. Caught only by dumping the bytes; a
# line-oriented grep over the gate's own output hides it perfectly.
#
# THE `: str` IS LOAD-BEARING — do not drop it to match the bindings above.
# Without the annotation the process.capture result stays a BOXED value, and codegen
# emits `lua_str_buf_len_i64` against the box, which answers 0. `:len() - 1`
# is then -1, and `sub(1, -1)` is Lua for "the whole string" — so the trim
# silently returns its input and there is no error anywhere. `str_trim` below
# survives the same hazard for the same reason: its parameter is typed.
gapraw: str = process.capture("g=$(git -C '{root}' rev-parse --path-format=absolute --git-common-dir 2>/dev/null); printf %s \"${g:-{root}/.agents/session}\"")
gapledger = "{gapraw:sub(1, gapraw:len() - 1)}/duon-gapalloc"

fun gappad(n: int): str
    s = n:to(str)
    while string.len(s) < 3
        s = "0{s}"
    end
    s
end

# Highest number VISIBLE anywhere: filed gaps and prior reservations both
# count. Seeding from the union is what stops the allocator from walking up
# from 1 and colliding with a gap somebody filed by hand.
fun gaphigh(): int
    -- SEEDED FROM EVERY REF, not just the checked-out branch. A gap filed and
    -- COMMITTED on a branch that has not merged is invisible to both scans
    -- below, and that is the half of gap[076] the shared ledger cannot cover
    -- — a number filed by hand, or before the allocator existed, leaves no
    -- reservation directory behind. The shared ledger covers the mirror case,
    -- a file reserved but not yet committed. Both run because neither
    -- subsumes the other. Measured at 0.06s on this repo.
    --
    -- This is a SEED rather than a fourth loop on purpose: the two scans
    -- below can only raise it, so if the pipeline answers empty or garbage
    -- (`tonumber` yields 0 here, it does not fail) the allocator degrades to
    -- exactly its previous behaviour instead of handing out a low number.
    hi = tonumber(process.capture("printf %s \"$(git -C '{root}' log --all --name-only --pretty=format: -- gaps/ 2>/dev/null | grep -oE 'GAP-[0-9]+' | grep -oE '[0-9]+' | sort -n | tail -1)\"")) or 0
    for _, name in fs:read_dir(gapsdir) or {}
        d = string.match(name, "^GAP%-(%d+)")
        if d ~= nil
            v = tonumber(d) or 0
            if v > hi then hi = v end
        end
    end
    for _, name in fs:read_dir(gapledger) or {}
        d = string.match(name, "^GAP%-(%d+)")
        if d ~= nil
            v = tonumber(d) or 0
            if v > hi then hi = v end
        end
    end
    hi
end

# Hand back a number nobody else can be holding. Returns -1 only if 512
# consecutive numbers are all taken, which means something is very wrong.
fun gapallocate(): int
    process.run("mkdir -p {gapledger}")
    n = gaphigh() + 1
    tries = 0
    while tries < 512
        -- THE ATOMIC STEP. Exactly one concurrent caller sees true here.
        if process.run("mkdir -p {gapledger}/GAP-{gappad(n)}")
            -- Won the reservation. If a gap file already occupies the number
            -- (filed by hand, before this allocator existed), keep the
            -- reservation so it is never handed out, and take the next.
            if not fs:exists("{gapsdir}/GAP-{gappad(n)}.md")
                return n
            end
        end
        n += 1
        tries += 1
    end
    -1
end

fun gap_open(agent_id: str, kind: str, title: str, detail: str, priority: str, files: str): str
    n = gapallocate()
    if n < 0
        return json:encode({ allocated = false, error = "no free gap number in 512 tries" })
    end
    id = "GAP-{gappad(n)}"
    ts = clock.utc()
    pr = priority
    if pr == nil or pr == "" then pr = "P1" end
    body = "# {id} — {title}\n\n**Status:** OPEN · **Filed:** {ts}\n**Priority:** {pr} · **Kind:** {kind}\n**Filed by:** {agent_id}\n"
    if files ~= nil and files ~= ""
        body = "{body}**Files:** {files}\n"
    end
    body = "{body}\n{detail}\n"
    fs:write_file("{gapsdir}/{id}.md", body)
    file_finding(kind, "{id} — {title}", detail, pr, files)
    json:encode({ allocated = true, gap_id = id, number = n, path = "gaps/{id}.md", priority = pr })
end

# === FILE-PATH CLAIMS =================================================
#
# Claims used to be per-FEATURE, which is why one session's bare `git commit`
# kept swallowing another's in-flight edits: two agents "working on different
# features" were writing the same files. Partition by FILE.
#
# Same primitive as gap allocation: the claim directory IS the lock, created
# with mkdir(2), so the exact-path case admits exactly one holder with no
# read-then-write window.
#
# Overlap (a claim on `tools/` vs a claim on `tools/mcp/x.id`) cannot be
# decided by one mkdir, so it is handled by ACQUIRE-THEN-VERIFY: take the
# exact lock, then look for a live overlapping claim, and if one is there,
# release and report a conflict. Whoever observes the overlap backs off
# UNCONDITIONALLY. That can never double-grant — for both callers to see a
# clear scan, both scans would have to precede both mkdirs, and each caller
# scans strictly after its own mkdir. It can conservatively refuse both,
# which a retry resolves; refusing twice is safe, granting twice is not.

claimsdir = "{root}/.agents/session/claims"
claimttl = 14400

# Repo-relative, no leading "./", no trailing "/". Two spellings of one file
# must produce one key or the lock protects nothing.
fun claim_norm(p: str): str
    s = p or ""
    if string.sub(s, 1, string.len(root)) == root
        s = string.sub(s, string.len(root) + 1)
    end
    while string.sub(s, 1, 1) == "/" or string.sub(s, 1, 2) == "./"
        if string.sub(s, 1, 1) == "/"
            s = string.sub(s, 2)
        else
            s = string.sub(s, 3)
        end
    end
    while string.len(s) > 1 and string.sub(s, string.len(s)) == "/"
        s = string.sub(s, 1, string.len(s) - 1)
    end
    s
end

# "/" is not legal in a directory name; "~" is not legal in a repo path here.
fun claim_key(p: str): str
    string.gsub(p, "/", "~")
end

fun claim_unkey(k: str): str
    string.gsub(k, "~", "/")
end

# Does one claim cover the other? Prefix comparison at a SEGMENT boundary:
# "tools/mcp" covers "tools/mcp/x.id" but must not cover "tools/mcpx.id".
fun claim_overlaps(a: str, b: str): bool
    if a == b then return true end
    if string.sub(b, 1, string.len(a) + 1) == "{a}/" then return true end
    if string.sub(a, 1, string.len(b) + 1) == "{b}/" then return true end
    false
end

fun claim_meta(key: str): any
    raw = fs:read_file("{claimsdir}/{key}/owner")
    if raw == nil or raw == "" then return nil end
    owner = string.match(raw, "^([^\t]*)")
    tsv = string.match(raw, "^[^\t]*\t([^\t\n]*)")
    wi = string.match(raw, "^[^\t]*\t[^\t]*\t([^\t\n]*)")
    { owner = owner or "", at = tonumber(tsv) or 0, work = wi or "" }
end

fun claim_live(key: str): bool
    m = claim_meta(key)
    if m == nil then return false end
    now = clock.now()
    (now - m.at) < claimttl
end

fun claim_write(key: str, owner: str, work: str): void
    now = clock.now()
    fs:write_file("{claimsdir}/{key}/owner",
        "{owner}\t{now:to(str)}\t{work}\n")
end

# Remove claim directories with shell rm and verify metadata is gone — host remove lied on success.
# `os.remove(path) ~= nil`, and `false ~= nil` is TRUE, so it reports success
# unconditionally — measured 2026-08-08: it returned true on a file that was
# still on disk and still read back its old contents afterwards. A release
# that lies leaves a lock nobody can clear, which is worse than no lock at
# all. Drop the whole claim directory in one shot and VERIFY BY VALUE that
# the metadata is gone before reporting anything.
fun claim_drop(key: str): bool
    dir = "{claimsdir}/{key}"
    process.run("rm -rf '{dir}'")
    claim_meta(key) == nil
end

fun dev_claim_acquire(owner: str, file: str, client: str, work_item: str): str
    process.run("mkdir -p {claimsdir}")
    path = claim_norm(file)
    if path == ""
        return json:encode({ granted = false, reason = "empty file path" })
    end
    key = claim_key(path)
    wi = work_item or ""
    own = owner or "agent"

    -- THE ATOMIC STEP for the exact path.
    got = process.run("mkdir -p {claimsdir}/{key}")
    if not got
        m = claim_meta(key)
        if m ~= nil and m.owner == own
            -- Re-entrant: same owner, refresh the lease rather than deadlock
            -- against itself.
            claim_write(key, own, wi)
            return json:encode({ granted = true, path = path, owner = own, reentrant = true })
        end
        if m ~= nil and (clock.now() - m.at) >= claimttl
            claim_drop(key)
            got = process.run("mkdir -p {claimsdir}/{key}")
        end
        if not got
            holder = "unknown"
            if m ~= nil then holder = m.owner end
            return json:encode({ granted = false, path = path, held_by = holder, reason = "file already claimed" })
        end
    end
    claim_write(key, own, wi)

    -- ACQUIRE-THEN-VERIFY: now look for a live claim that covers, or is
    -- covered by, this path.
    for _, other in fs:read_dir(claimsdir) or {}
        if other ~= key
            op = claim_unkey(other)
            if claim_overlaps(path, op) and claim_live(other)
                om = claim_meta(other)
                oo = "unknown"
                if om ~= nil then oo = om.owner end
                claim_drop(key)
                return json:encode({ granted = false, path = path, overlaps = op, held_by = oo, reason = "overlapping claim" })
            end
        end
    end
    json:encode({ granted = true, path = path, owner = own, work_item = wi, ttl = claimttl })
end

fun dev_claim_release(owner: str, file: str): str
    path = claim_norm(file)
    key = claim_key(path)
    m = claim_meta(key)
    if m == nil
        return json:encode({ released = false, path = path, reason = "no such claim" })
    end
    if m.owner ~= owner
        return json:encode({ released = false, path = path, held_by = m.owner, reason = "not the holder" })
    end
    -- NOT `gone = claim_drop(key)` then encode: binding a bool-returning call
    -- to a local inside a `: str` function makes the compiler report
    -- "return type mismatch: expected 'str', got 'bool'" and emit a module
    -- that dies on first call. Branch on the call instead.
    if claim_drop(key)
        return json:encode({ released = true, path = path })
    end
    json:encode({ released = false, path = path, reason = "release did not clear the claim" })
end

fun dev_claim_files(): str
    rows = {}
    now = clock.now()
    for _, key in fs:read_dir(claimsdir) or {}
        m = claim_meta(key)
        if m ~= nil
            age = now - m.at
            rows[rows:len() + 1] = {
                path = claim_unkey(key),
                owner = m.owner,
                work_item = m.work,
                age = age,
                live = age < claimttl,
            }
        end
    end
    json:encode({ claims = rows, count = rows:len(), ttl = claimttl })
end

fun agent_gaps_update(action: str, agent_id: str, gap_id: str, kind: str, title: str, detail: str, priority: str, files: str): str
    act = action
    if act == nil or act == "" then act = "open" end
    if act == "open"
        -- `open` ALLOCATES. The caller does not supply gap_id and cannot;
        -- that is the whole point.
        return gap_open(agent_id, kind, title, detail, priority, files)
    end
    ts = clock.utc()
    entry = "\n| {ts} | {agent_id} | gap-{act} | {gap_id}: {detail} |"
    content = coordination_read()
    marker = "### Findings log (append-only, newest first)"
    table_marker = "| UTC | Agent | Action | Detail |\n| --- | --- | --- | --- |"
    mpos = string.find(content, marker, 1, true)
    if mpos ~= nil
        hpos = string.find(content, table_marker, mpos, true)
        if hpos ~= nil
            content = "{string.sub(content, 1, hpos + string.len(table_marker) - 1)}{entry}{string.sub(content, hpos + string.len(table_marker))}"
        else
            content = "{content}{entry}\n"
        end
    else
        content = "{content}\n\n{marker}\n\n{table_marker}{entry}\n"
    end
    fs:write_file(coordpath, content)
    "ok: gap {act} {gap_id}"
end


