@packed local P: { x: i32, y: i32 } = { x = 1, y = 2 }
@align(16) @ffi("my_struct_t") local ExtP: { a: f64 } = { a = 3.14 }
@packed enum E
  A
  B(value: i32)
end
function add(a: i64, b: i64) -> i64
  return a + b
end
function main() -> void
  local z = add(P.x, P.y)
  local e = E.B({ value = z })
end
