#!/bin/sh
# Canonical duon, enforced on the staged diff, for EVERY agent — codex,
# opencode, claude, human. This is the one chokepoint they all pass through;
# an editor-specific hook disciplines only its own editor.
#
# The logic is duon (scripts/idiomgate.duo). This shim exists solely because
# git execs a file and does not know how to run .duo. Keep it this small.
root=$(git rev-parse --show-toplevel) || exit 0
duo="$root/zig-out/bin/duo"
[ -x "$duo" ] || { echo "idiomgate: duo not built — gate SKIPPED, not passed."; exit 0; }
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.duo')
[ -n "$files" ] || exit 0
DUOGATEFILES="$files" "$duo" run "$root/scripts/idiomgate.duo" || {
  echo ""
  echo "COMMIT BLOCKED. Fix the findings above, or if a line is genuinely"
  echo "canonical and the gate is wrong, that is a gate bug — report it."
  exit 1
}
