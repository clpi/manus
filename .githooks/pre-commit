#!/bin/sh
# Canonical Idsem, enforced on the ADDED LINES of the staged diff, for EVERY
# agent — codex, opencode, claude, human. This is the one chokepoint they all
# pass through; an editor-specific hook disciplines only its own editor.
#
# Semantic canonicality remains in Idsem. The source-family check below is an
# authority-free physical projection of C0 law.corpus.zero. Delete it only when
# an executed Idsem admission gate fails closed over staged additions, the
# anchored committed range, and untracked worktree candidates.
root=$(git rev-parse --show-toplevel) || exit 1
tmp=$(mktemp -t idiomgate) || exit 1

# Git invokes pre-commit without arguments. Only the build graph may request
# the source-family-only aggregate mode, and it must supply the immutable
# law-adoption base. Environment inheritance can never skip semantic gates.
mode=commit
sourcezero_base=
sourcezero_worktree=0
if [ "$#" -ne 0 ]; then
  if [ "$#" -eq 2 ] && [ "$1" = source-zero ]; then
    mode=sourcezero
    sourcezero_base=$2
    sourcezero_worktree=1
  else
    echo "SOURCE-ZERO: invalid admission invocation — blocked."
    rm -f "$tmp"
    exit 1
  fi
fi

# Disable rename/copy detection so every path newly ending in the historical
# suffix is an addition, independent of file contents or Git's similarity
# heuristic. Modified tracked debt and migrations away from .duo remain legal.
git diff --cached --no-renames --name-only --diff-filter=A -- \
  ':(icase,glob)**/*.duo' > "$tmp" || {
  echo "SOURCE-ZERO: staged source-family evidence unavailable — admission blocked."
  rm -f "$tmp"
  exit 1
}
if [ -s "$tmp" ]; then
  echo "SOURCE-ZERO: new .duo paths are forbidden; canonical source is .id:"
  sed 's/^/  /' "$tmp"
  rm -f "$tmp"
  exit 1
fi

# Serialized admission supplies a base revision and asks for the full untracked
# census. Local pre-commit deliberately omits the latter so another live
# session's untracked work cannot block an otherwise disjoint commit.
if [ -n "$sourcezero_base" ]; then
  git rev-parse --verify "${sourcezero_base}^{commit}" >/dev/null || {
    echo "SOURCE-ZERO: base revision unavailable — admission blocked."
    rm -f "$tmp"
    exit 1
  }
  git diff "$sourcezero_base" HEAD --no-renames --name-only --diff-filter=A -- \
    ':(icase,glob)**/*.duo' > "$tmp" || {
    echo "SOURCE-ZERO: committed source-family evidence unavailable — admission blocked."
    rm -f "$tmp"
    exit 1
  }
  if [ -s "$tmp" ]; then
    echo "SOURCE-ZERO: this revision range adds forbidden .duo paths:"
    sed 's/^/  /' "$tmp"
    rm -f "$tmp"
    exit 1
  fi
fi

if [ "$sourcezero_worktree" = 1 ]; then
  # Intent-to-add entries live in the index but have no cached content and are
  # excluded from the untracked census. Observe worktree-versus-index additions
  # separately so `git add -N` cannot make a candidate disappear.
  git diff --no-renames --name-only --diff-filter=A -- \
    ':(icase,glob)**/*.duo' > "$tmp" || {
    echo "SOURCE-ZERO: worktree source-family evidence unavailable — admission blocked."
    rm -f "$tmp"
    exit 1
  }
  if [ -s "$tmp" ]; then
    echo "SOURCE-ZERO: worktree .duo additions are admission failures:"
    sed 's/^/  /' "$tmp"
    rm -f "$tmp"
    exit 1
  fi

  # Ignored generator/scratch output is still searchable source and therefore
  # part of the aggregate current-tree census. Git's own metadata remains out
  # of scope; every other untracked historical-source path is evidence.
  git ls-files --others -- \
    ':(icase,glob)**/*.duo' > "$tmp" || {
    echo "SOURCE-ZERO: untracked source-family evidence unavailable — admission blocked."
    rm -f "$tmp"
    exit 1
  }
  if [ -s "$tmp" ]; then
    echo "SOURCE-ZERO: untracked .duo paths are admission failures:"
    sed 's/^/  /' "$tmp"
    rm -f "$tmp"
    exit 1
  fi
fi

if [ "$mode" = sourcezero ]; then
  rm -f "$tmp"
  exit 0
fi

duo="$root/zig-out/bin/duo"
[ -x "$duo" ] || { echo "canonical preflight: duo not built — commit blocked."; rm -f "$tmp"; exit 1; }
git diff --cached -U0 --diff-filter=ACM -- '*.id' '*.duo' > "$tmp"
rc=0
if [ -s "$tmp" ]; then
  DUOGATEDIFF="$tmp" "$duo" run "$root/scripts/idiomgate.duo"
  rc=$?
fi
rm -f "$tmp"
[ $rc -eq 0 ] || {
  echo ""
  echo "COMMIT BLOCKED — every finding above is on a line THIS DIFF ADDS."
  echo "Inherited debt in the same file is not gated; only what you write is."
  exit 1
}

"$duo" run --backend=c "$root/scripts/semanticgate.duo" || {
  echo ""
  echo "COMMIT BLOCKED — semantic canonicality is part of correctness."
  echo "Repair or explicitly classify the semantic debt; do not suppress it."
  exit 1
}
