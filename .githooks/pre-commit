#!/bin/sh
# Commit admission — shell orchestrates git; Idol gates scan stdin/files.
# NOTE: `idol check` admits gate source. `idol run` of idiom over a staged
# diff is still IMPLEMENTATION-BLOCKED on this backend (scan of a non-empty
# diff SIGKILLs). Do not treat check-pass as a scan. Unblock: stable
# gate/idiom scan, then restore `idol run gate/idiom.id < staged.diff` here.
set -eu
root=$(git rev-parse --show-toplevel)
idol="$root/zig-out/bin/idol"
[ -x "$idol" ] || { echo "canonical preflight: idol not built — commit blocked." >&2; exit 1; }

scratch="/tmp/idol/preflight"
mkdir -p "$scratch"
idiom="$scratch/idiom.diff"
host="$scratch/host.diff"
graph="$scratch/graph.diff"
list="$scratch/paths.txt"
names="$scratch/names.diff"
track="$scratch/tree.txt"
path="$scratch/path.txt"

# SOURCE-ZERO: staged .duo additions forbidden
if git diff --cached --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo' | grep -q .; then
  echo "SOURCE-ZERO: new .duo paths are forbidden; canonical source is .id:" >&2
  git diff --cached --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo' | sed 's/^/  /' >&2
  exit 1
fi

if [ "${1:-}" = "source-zero" ]; then
  base="${2:-}"
  [ -n "$base" ] || { echo "SOURCE-ZERO: invalid admission invocation — blocked." >&2; exit 1; }
  git rev-parse --verify "${base}^{commit}" >/dev/null 2>&1 || {
    echo "SOURCE-ZERO: base revision unavailable — admission blocked." >&2
    exit 1
  }
  if git diff "$base" HEAD --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo' | grep -q .; then
    echo "SOURCE-ZERO: this revision range adds forbidden .duo paths:" >&2
    git diff "$base" HEAD --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo' | sed 's/^/  /' >&2
    exit 1
  fi
  if git diff --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo' | grep -q .; then
    echo "SOURCE-ZERO: worktree .duo additions are admission failures:" >&2
    git diff --no-renames --name-only --diff-filter=A -- ':(icase,glob)**/*.duo' | sed 's/^/  /' >&2
    exit 1
  fi
  if git ls-files --others -- ':(icase,glob)**/*.duo' | grep -q .; then
    echo "SOURCE-ZERO: untracked .duo paths are admission failures:" >&2
    git ls-files --others -- ':(icase,glob)**/*.duo' | sed 's/^/  /' >&2
    exit 1
  fi
  exit 0
fi

git diff --cached -U0 --diff-filter=ACM -- '*.id' '*.duo' >"$idiom" || true
if [ -s "$idiom" ]; then
  "$idol" check "$root/gate/idiom.id" || {
    echo "" >&2
    echo "COMMIT BLOCKED — gate/idiom.id semantic check failed on staged additions." >&2
    echo "Inherited debt in the same file is not gated; only what you write is." >&2
    exit 1
  }
  "$idol" check "$root/gate/admission.id" || {
    echo "" >&2
    echo "COMMIT BLOCKED — gate/admission.id semantic check failed." >&2
    exit 1
  }
fi

git diff --cached -U0 --diff-filter=ACM -- '*.id' '*.zig' '*.md' '*.mdc' 'AGENTS.md' 'CLAUDE.md' 'README.md' 'build.zig' '.cursor/rules/*.mdc' '.githooks/*' 'gate/*' 'scripts/*' >"$host" || true
if [ -s "$host" ]; then
  "$idol" check "$root/gate/host.id" || {
    echo "" >&2
    echo "COMMIT BLOCKED — gate/host.id semantic check failed on staged additions." >&2
    exit 1
  }
fi

git diff --cached -U0 --diff-filter=ACM -- 'src/semantic_graph.zig' 'src/graph_query.zig' 'src/graph_fact_producer.zig' 'src/sim_pipeline.zig' 'src/knowledge_snapshot.zig' >"$graph" || true
if [ -s "$graph" ]; then
  "$idol" check "$root/gate/graph.id" || {
    echo "" >&2
    echo "COMMIT BLOCKED — gate/graph.id semantic check failed on staged additions." >&2
    exit 1
  }
fi

"$idol" check "$root/gate/architecture.id" || {
  echo "" >&2
  echo "COMMIT BLOCKED — gate/architecture.id semantic check failed." >&2
  exit 1
}

git diff --cached --name-only --diff-filter=AR >"$list" || true
git diff --cached -U0 --diff-filter=ACM -- '*.id' '*.zig' '*.md' '*.mdc' 'AGENTS.md' 'CLAUDE.md' 'README.md' 'build.zig' '.cursor/rules/*.mdc' '.githooks/*' 'gate/*' >"$names" || true
if [ -s "$list" ] || [ -s "$names" ]; then
  {
    echo "IDOLGATE staged"
    cat "$list" 2>/dev/null || true
    echo "IDOLGATE namediff"
    cat "$names" 2>/dev/null || true
    echo "IDOLGATE end"
  } >"$path"
  "$idol" check "$root/gate/path.id" || {
    echo "" >&2
    echo "COMMIT BLOCKED — gate/path.id semantic check failed on staged paths or added lines." >&2
    exit 1
  }
fi

git ls-files >"$track"
{
  echo "IDOLGATE tree"
  cat "$track"
  echo "IDOLGATE end"
} >"$path"
"$idol" check "$root/gate/path.id" || {
  echo "" >&2
  echo "COMMIT BLOCKED — gate/path.id semantic check failed on tracked tree." >&2
  exit 1
}

exit 0
