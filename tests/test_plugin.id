# test_plugin.id — verify the Neovim plugin files are structurally valid.
#
# Duo replacement for tests/test_plugin.sh (monoglot census).
#
# Checks the required files exist and that Neovim can load the ftdetect script
# headless. Does NOT require Neovim: a missing nvim skips the live test and
# still reports the file-existence results.
#
# The plugin's own .vim and lua/duo/init.lua stay as they are -- Neovim's
# runtime reads vimscript and Lua, so those are a HOST requirement, the same
# class as examples/metal_compute.m. A Duo file there would simply not load.

_ROOT = "tests"

_pass = 0
_fail = 0

_ok = (msg: str)
  print("OK:   " .. msg)
  _pass = _pass + 1

_bad = (msg: str)
  print("FAIL: " .. msg)
  _fail = _fail + 1

# grep -c exits nonzero on no match, so the COUNT is what is read, not the
# status: capture keeps stdout either way and "" means no match.
_grep: bool = (pattern: str, path: str)
  n = script.chomp(script.capture("grep -cE \"" .. pattern .. "\" " .. path .. " 2>/dev/null"))
  n != "" and n != "0"

main: i64 = ()
  for _i, f in { "ftdetect/duo.vim", "syntax/duo.vim", "plugin/duo.vim", "lua/duo/init.lua" }
    path = _ROOT .. "/" .. f
    if script.fs_exists(path)
      _ok(f .. " exists")
    else
      _bad(f .. " is missing")

  syn = _ROOT .. "/syntax/duo.vim"
  if _grep("syntax keyword|syn keyword", syn)
    _ok("syntax/duo.vim defines keywords")
  else
    _bad("syntax/duo.vim has no 'syntax keyword' definitions")

  ftd = _ROOT .. "/ftdetect/duo.vim"
  if _grep("\\.id", ftd)
    _ok("ftdetect/duo.vim references .id extension")
  else
    _bad("ftdetect/duo.vim does not reference .id extension")

  if script.chomp(script.capture("command -v nvim 2>/dev/null")) != ""
    cmd = "nvim --headless -c \"set rtp+=" .. _ROOT .. "\" -c \"source " .. ftd .. "\" -c \"qa\" 2>/dev/null"
    if script.run(cmd) == 0
      _ok("nvim loads ftdetect without errors")
    else
      _bad("nvim exited non-zero loading ftdetect")
  else
    print("SKIP: nvim not found — skipping live Neovim test")

  print("")
  print("Results: " .. _pass:to(str) .. " passed, " .. _fail:to(str) .. " failed")
  if _fail > 0
    return 1
  0
