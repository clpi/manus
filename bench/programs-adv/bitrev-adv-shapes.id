single: i64 = ()
  x = 1
  r = 0
  i = 0
  while i < 1
    r = r * 2 + (x & 1)
    x = x / 2
    i = i + 1
  r

full: i64 = ()
  x = 1234567890123456789
  r = 0
  i = 0
  while i < 64
    r = r * 2 + (x & 1)
    x = x / 2
    i = i + 1
  r

bound: i64 = ()
  x = 255
  r = 0
  i = 0
  while i <= 7
    r = r * 2 + (x & 1)
    x = x / 2
    i = i + 1
  r

veil: i64 = ()
  x = 123456789 & 2147483647
  r = 0
  i = 0
  while i < 31
    r = r * 2 + (x & 1)
    x = x / 2
    i = i + 1
  r

twin: i64 = ()
  w = 200
  x = w
  r = 0
  i = 0
  while i < 8
    r = r * 2 + (x & 1)
    x = x / 2
    i = i + 1
  r

slide: i64 = ()
  x = 255
  r = 0
  i = 0
  while i < 8
    r = r * 2 + (x & 1)
    x = x >> 1
    i = i + 1
  r

swap: i64 = ()
  x = 255
  r = 0
  i = 0
  while i < 8
    r = (x & 1) + r * 2
    x = x / 2
    i = i + 1
  r

main: i64 = ()
  print(single())
  print(full())
  print(bound())
  print(veil())
  print(twin())
  print(slide())
  print(swap())
  0
