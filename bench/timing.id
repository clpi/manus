argn: i64 = ()
  n = 1
  while arg(n) != nil
    n = n + 1
  n - 1

args: str = (i: i64)
  arg(i + 1)

digitstr: str = (d: i64)
  if d == 0
    "0"
  else if d == 1
    "1"
  else if d == 2
    "2"
  else if d == 3
    "3"
  else if d == 4
    "4"
  else if d == 5
    "5"
  else if d == 6
    "6"
  else if d == 7
    "7"
  else if d == 8
    "8"
  else if d == 9
    "9"
  else
    "?"

tostr: str = (v: i64)
  if v == 0
    "0"
  else
    neg = false
    n = v
    if n < 0
      neg = true
      n = 0 - n
    s = ""
    while n > 0
      d = n % 10
      s = "{digitstr(d)}{s}"
      n = n / 10
    if neg
      s = "-{s}"
    s

parseint: i64 = (s: str, from: i64, to: i64)
  v = 0
  neg = false
  i = from
  if i <= to
    if s:byte(i) == 45
      neg = true
      i = i + 1
  while i <= to
    b = s:byte(i)
    if b >= 48
      if b <= 57
        v = v * 10 + (b - 48)
    i = i + 1
  if neg
    v = 0 - v
  v

pad20: str = (s: str)
  out = s
  while out:len() < 20
    out = "0{out}"
  out

hexval: i64 = (c: i64)
  if c >= 48
    if c <= 57
      c - 48
    else if c >= 65
      if c <= 70
        c - 55
      else if c >= 97
        if c <= 102
          c - 87
        else
          0
      else
        0
    else
      0
  else
    0

sampat: i64 = (buf: str, idx: i64)
  pos = 1
  bl = buf:len()
  cur = 1
  while cur < idx
    if pos > bl
      cur = idx
      pos = bl + 1
    else
      if buf:byte(pos) == 59
        cur = cur + 1
      pos = pos + 1
  if pos > bl
    0 - 1
  else
    send = bl
    epos = pos
    while epos <= bl
      if buf:byte(epos) == 59
        send = epos - 1
        epos = bl + 1
      else
        epos = epos + 1
    parseint(buf, pos, send)

nsamp: i64 = (buf: str)
  n = 0
  i = 1
  bl = buf:len()
  while i <= bl
    if buf:byte(i) == 59
      n = n + 1
    i = i + 1
  if bl > 0
    if buf:byte(bl) != 59
      n = n + 1
  n

sortsampstr: str = (buf: str, n: i64)
  sbuf = ""
  i = 1
  while i <= n
    vs = sampat(buf, i)
    sv = tostr(vs)
    ps = pad20(sv)
    sbuf = "{sbuf}{ps}"
    i = i + 1
  ii = 1
  while ii <= n
    jj = 1
    while jj <= n - ii
      p1 = (jj - 1) * 20 + 1
      p2 = jj * 20 + 1
      a = sbuf:sub(p1, p1 + 19)
      b = sbuf:sub(p2, p2 + 19)
      swap = false
      k = 1
      while k <= 20
        ca = a:byte(k)
        cb = b:byte(k)
        if ca > cb
          swap = true
          k = 21
        else if ca < cb
          k = 21
        else
          k = k + 1
      if swap
        pre = ""
        if p1 > 1
          pre = sbuf:sub(1, p1 - 1)
        post = ""
        pe = p2 + 19
        if pe < sbuf:len()
          post = sbuf:sub(pe + 1, sbuf:len())
        sbuf = "{pre}{b}{a}{post}"
      jj = jj + 1
    ii = ii + 1
  sbuf

medianstr: i64 = (buf: str, n: i64)
  sbuf = sortsampstr(buf, n)
  if n % 2 == 1
    mp = ((n + 1) / 2 - 1) * 20 + 1
    ms = sbuf:sub(mp, mp + 19)
    parseint(ms, 1, 20)
  else
    mp1 = (n / 2 - 1) * 20 + 1
    mp2 = (n / 2) * 20 + 1
    m1s = sbuf:sub(mp1, mp1 + 19)
    m2s = sbuf:sub(mp2, mp2 + 19)
    v1 = parseint(m1s, 1, 20)
    v2 = parseint(m2s, 1, 20)
    v1 + (v2 - v1) / 2

pctlstr: i64 = (buf: str, n: i64, which: i64)
  k = 1
  if which == 2
    k = n
  else if which == 3
    k = (95 * n + 99) / 100
  else if which == 4
    k = n / 4 + 1
  else if which == 5
    k = 3 * n / 4 + 1
  sbuf = sortsampstr(buf, n)
  mp = (k - 1) * 20 + 1
  ms = sbuf:sub(mp, mp + 19)
  parseint(ms, 1, 20)

meanstr: f64 = (buf: str, n: i64)
  mean = 0.0
  i = 1
  while i <= n
    sv = sampat(buf, i)
    x = sv:to(f64) / 1000.0
    fi = i:to(f64)
    mean = mean + (x - mean) / fi
    i = i + 1
  mean

varstr: f64 = (buf: str, n: i64)
  mean = 0.0
  m2 = 0.0
  i = 1
  while i <= n
    sv = sampat(buf, i)
    x = sv:to(f64) / 1000.0
    fi = i:to(f64)
    delta = x - mean
    mean = mean + delta / fi
    m2 = m2 + delta * (x - mean)
    i = i + 1
  if n < 2
    0.0
  else
    m2 / (n:to(f64) - 1.0)

outlierstr: i64 = (buf: str, n: i64)
  q1 = pctlstr(buf, n, 4)
  q3 = pctlstr(buf, n, 5)
  iqr = q3 - q1
  fence = q3 + 3 * iqr
  c = 0
  i = 1
  while i <= n
    if sampat(buf, i) > fence
      c = c + 1
    i = i + 1
  c

verdictstr: str = (buf1: str, buf2: str, n: i64)
  m1 = meanstr(buf1, n)
  m2 = meanstr(buf2, n)
  v1 = varstr(buf1, n)
  v2 = varstr(buf2, n)
  med1 = medianstr(buf1, n)
  med2 = medianstr(buf2, n)
  n1 = n:to(f64)
  se2t = v1 / n1 + v2 / n1
  verdict = "degenerate"
  if se2t > 0.0
    dt = m1 - m2
    tstat = dt / math.sqrt(se2t)
    sig = false
    if tstat > 1.96
      sig = true
    if tstat < 0.0 - 1.96
      sig = true
    verdict = "inconclusive"
    if sig
      if med1 < med2
        verdict = "win"
      else if med1 > med2
        verdict = "loss"
  verdict

runone: i64 = (path: str, exitexp: i64, outhex: str, outlen: i64, phase: str, round: i64)
  t0 = monotime()
  raw = procrun(path, "", "")
  t1 = monotime()
  rn = raw:len()
  if rn == 0
    print("status: mismatch")
    print("binary: {path}")
    print("phase: {phase}")
    print("round: {round}")
    print("detail: empty procrun result")
    0 - 1
  else
    nl = 0
    i = 1
    while i <= rn
      if raw:byte(i) == 10
        nl = i
        i = rn + 1
      else
        i = i + 1
    code = parseint(raw, 1, nl - 1)
    outstart = nl + 1
    allen = rn - nl
    if code != exitexp
      print("status: mismatch")
      print("binary: {path}")
      print("phase: {phase}")
      print("round: {round}")
      print("expected_exit: {exitexp}")
      print("actual_exit: {code}")
      if code < 0
        if code == 0 - 999
          print("detail: spawn failed")
        else
          sig = 0 - code
          print("detail: died from signal {sig}")
      0 - 1
    else if allen != outlen
      print("status: mismatch")
      print("binary: {path}")
      print("phase: {phase}")
      print("round: {round}")
      print("expected_exit: {exitexp}")
      print("actual_exit: {code}")
      print("detail: stdout length mismatch")
      print("expected_len: {outlen}")
      print("actual_len: {allen}")
      0 - 1
    else
      oi = 0
      ok = true
      while oi < outlen
        if ok
          eb = hexval(outhex:byte(oi * 2 + 1)) * 16 + hexval(outhex:byte(oi * 2 + 2))
          if raw:byte(nl + 1 + oi) != eb
            print("status: mismatch")
            print("binary: {path}")
            print("phase: {phase}")
            print("round: {round}")
            print("expected_exit: {exitexp}")
            print("actual_exit: {code}")
            print("detail: stdout byte mismatch")
            print("offset: {oi}")
            ok = false
        oi = oi + 1
      if ok
        t1 - t0
      else
        0 - 1

statsjson: str = (buf: str, n: i64)
  med = medianstr(buf, n)
  mn = pctlstr(buf, n, 1)
  mx = pctlstr(buf, n, 2)
  p95 = pctlstr(buf, n, 3)
  q1 = pctlstr(buf, n, 4)
  q3 = pctlstr(buf, n, 5)
  oc = outlierstr(buf, n)
  js = "\{"
  js = "{js}\"rounds\": {n}, "
  js = "{js}\"median_ns\": {med}, "
  js = "{js}\"min_ns\": {mn}, "
  js = "{js}\"max_ns\": {mx}, "
  js = "{js}\"p95_ns\": {p95}, "
  js = "{js}\"q1_ns\": {q1}, "
  js = "{js}\"q3_ns\": {q3}, "
  js = "{js}\"outliers\": {oc}, "
  js = "{js}\"samples_ns\": ["
  i = 1
  while i <= n
    if i > 1
      js = "{js}, "
    sv = sampat(buf, i)
    js = "{js}{sv}"
    i = i + 1
  js = "{js}]"
  js = "{js}\}"
  js
main: i64 = ()
  if argn() < 10
    print("usage: timing.id rounds warmup exitexp outhex compiler config revision nbin name0 path0 [name1 path1] [name2 path2]")
    1
  else
    arg0 = args(0)
    rounds = parseint(arg0, 1, arg0:len())
    arg1 = args(1)
    warmups = parseint(arg1, 1, arg1:len())
    arg2 = args(2)
    exitexp = parseint(arg2, 1, arg2:len())
    outhex = args(3)
    outlen = outhex:len() / 2
    compiler = args(4)
    config = args(5)
    revision = args(6)
    arg7 = args(7)
    nbin = parseint(arg7, 1, arg7:len())
    if rounds < 2
      print("status: error")
      print("detail: rounds < 2")
      1
    else if warmups < 0
      print("status: error")
      print("detail: warmups < 0")
      1
    else if nbin < 1
      print("status: error")
      print("detail: nbin < 1")
      1
    else if nbin > 3
      print("status: error")
      print("detail: nbin > 3")
      1
    else if argn() != 8 + nbin * 2
      print("status: error")
      print("detail: arg count mismatch")
      1
    else
      name0 = args(8)
      path0 = args(9)
      name1 = ""
      path1 = ""
      name2 = ""
      path2 = ""
      if nbin >= 2
        name1 = args(10)
        path1 = args(11)
      if nbin >= 3
        name2 = args(12)
        path2 = args(13)
      failed = false
      w = 0
      while w < warmups
        if ! failed
          bi = 0
          while bi < nbin
            if ! failed
              if bi == 0
                rw = runone(path0, exitexp, outhex, outlen, "warmup", w)
              else if bi == 1
                rw = runone(path1, exitexp, outhex, outlen, "warmup", w)
              else
                rw = runone(path2, exitexp, outhex, outlen, "warmup", w)
              if rw < 0
                failed = true
            bi = bi + 1
        w = w + 1
      b0 = ""
      b1 = ""
      b2 = ""
      r = 0
      while r < rounds
        if ! failed
          bi = 0
          while bi < nbin
            if ! failed
              if bi == 0
                s = runone(path0, exitexp, outhex, outlen, "timed", r)
              else if bi == 1
                s = runone(path1, exitexp, outhex, outlen, "timed", r)
              else
                s = runone(path2, exitexp, outhex, outlen, "timed", r)
              if s < 0
                failed = true
              else
                if bi == 0
                  b0 = "{b0}{s};"
                else if bi == 1
                  b1 = "{b1}{s};"
                else
                  b2 = "{b2}{s};"
            bi = bi + 1
        r = r + 1
      if failed
        1
      else
        ok = true
        if nsamp(b0) != rounds
          print("status: error")
          print("detail: binary 0 sample count mismatch")
          ok = false
        if nbin >= 2
          if nsamp(b1) != rounds
            print("status: error")
            print("detail: binary 1 sample count mismatch")
            ok = false
        if nbin >= 3
          if nsamp(b2) != rounds
            print("status: error")
            print("detail: binary 2 sample count mismatch")
            ok = false
        if ! ok
          1
        else
          js = "\{"
          js = "{js}\"timer\": \"idol-bench-timer\", "
          js = "{js}\"version\": 2, "
          js = "{js}\"rounds\": {rounds}, "
          js = "{js}\"warmup\": {warmups}, "
          js = "{js}\"alpha\": \"0.05\", "
          js = "{js}\"decision_rule\": \"welch t-test normal approximation: significant when |t|>1.96; degenerate when both sample variances are zero; win/loss only when significant and candidate median orders\", "
          js = "{js}\"timing_boundary\": \"t1 captured immediately after procrun returns; procrun drains child stdout to EOF then waits for child; per-invocation validation cost excluded from samples; rounds interleaved across binaries\", "
          js = "{js}\"compiler\": \"{compiler}\", "
          js = "{js}\"config\": \"{config}\", "
          js = "{js}\"revision\": \"{revision}\", "
          js = "{js}\"expected_exit\": {exitexp}, "
          js = "{js}\"expected_stdout_len\": {outlen}, "
          js = "{js}\"binaries\": \{"
          js = "{js}\"{name0}\": {statsjson(b0, rounds)}"
          if nbin >= 2
            js = "{js}, \"{name1}\": {statsjson(b1, rounds)}"
          if nbin >= 3
            js = "{js}, \"{name2}\": {statsjson(b2, rounds)}"
          js = "{js}\}\}"
          print(js)
          0

main()
